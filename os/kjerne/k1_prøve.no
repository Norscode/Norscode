// os/kjerne/k1_prøve.no — K1-prøvekjerne for Norscode OS.
//
// Same ELF blir køyrt på Linux (Docker) og i ring 0 under trampolinen (QEMU -m 256M);
// utdata skal vere identiske. Programmet øver strengar, lister, kart, prøv/fang,
// rekursjon ~1000 djup og >100 MiB søppel slik at GC-en samlar fleire gonger (talt
// ved at allokeringsteljaren [HEAP+32] fell tilbake til 0 etter kvar innsamling).
// Tid og tilfeldigheit blir berre prøvde, ikkje skrivne ut (dei skil seg per køyring).

bruk std.native_gap som native_gap   // rute for builtin.random_hex (getrandom) i AOT

funksjon djup(n: heiltall) -> heiltall {
    hvis n == 0 { returner 0 }
    returner 1 + djup(n - 1)
}

funksjon fib(n: heiltall) -> heiltall {
    hvis n < 2 { returner n }
    returner fib(n - 1) + fib(n - 2)
}

funksjon kast_djupt(n: heiltall) -> heiltall {
    hvis n == 0 { kast "botn nådd" }
    returner kast_djupt(n - 1) + 1
}

funksjon strengar() -> heiltall {
    la s = "Norscode"
    la t = s + " OS " + tekst(2026)
    skriv("streng: " + t + " lengd=" + tekst(lengde(t)) + "\n")
    skriv("streng: slice=" + builtin.slice(t, 0, 4) + " index=" + tekst(builtin.index_of(t, "OS")) + "\n")
    la samla = ""
    la i = 0
    mens i < 50 {
        samla = samla + tekst(i % 10)
        i = i + 1
    }
    skriv("streng: samla=" + samla + "\n")
    skriv("streng: æøå=" + "blåbærsyltetøy" + " " + tekst(lengde("blåbærsyltetøy")) + "\n")
    returner 0
}

funksjon lister() -> heiltall {
    la l: liste_heiltall = []
    la i = 0
    mens i < 2000 {
        legg_til(l, (i * 7919) % 1009)
        i = i + 1
    }
    la sum = 0
    la maks = 0
    i = 0
    mens i < lengde(l) {
        sum = sum + l[i]
        hvis l[i] > maks { maks = l[i] }
        i = i + 1
    }
    l[0] = 123456
    skriv("liste: n=" + tekst(lengde(l)) + " sum=" + tekst(sum) + " maks=" + tekst(maks) + " l0=" + tekst(l[0]) + "\n")
    la ord: liste_tekst = ["eple", "banan", "kirsebær"]
    legg_til(ord, "drue")
    la samla = ""
    for o i ord { samla = samla + o + ";" }
    skriv("liste: ord=" + samla + "\n")
    returner 0
}

funksjon kart() -> heiltall {
    la m: ordbok_heltall = {}
    la i = 0
    mens i < 500 {
        m["k" + tekst(i)] = i * i
        i = i + 1
    }
    m["k7"] = -7
    la sum = 0
    for k i nøkler(m) { sum = sum + m[k] }
    skriv("kart: n=" + tekst(lengde(m)) + " k499=" + tekst(m["k499"]) + " k7=" + tekst(m["k7"]) + " sum=" + tekst(sum) + "\n")
    skriv("kart: finst k3=" + tekst(finnes_nøkkel(m, "k3")) + " finst x=" + tekst(finnes_nøkkel(m, "x")) + "\n")
    returner 0
}

funksjon unnatak() -> heiltall {
    prøv {
        kast "bom"
    } fang e {
        skriv("fang: " + e + "\n")
    }
    prøv {
        kast_djupt(200)
        skriv("fang: FEIL, ingen kast\n")
    } fang e2 {
        skriv("fang: djupt " + e2 + "\n")
    }
    la n = 0
    la i = 0
    mens i < 100 {
        prøv {
            hvis i % 3 == 0 { kast "tre" }
            n = n + 1
        } fang e3 {
            n = n + 100
        }
        i = i + 1
    }
    skriv("fang: n=" + tekst(n) + "\n")
    returner 0
}

// Byggjer og kastar rundt 40 KiB per runde; teller GC-innsamlingar via [HEAP+32].
funksjon søppel(runder: heiltall) -> heiltall {
    la heap = 0x780000
    la forrige = builtin.raw_load64(heap + 32)
    la samlingar = 0
    la tot = 0
    la r = 0
    mens r < runder {
        la l: liste_heiltall = []
        la i = 0
        mens i < 1000 {
            legg_til(l, i * r + 40000)
            i = i + 1
        }
        la s = "x" + tekst(r) + "-" + tekst(lengde(l))
        tot = tot + lengde(s) + l[999] % 7
        la no = builtin.raw_load64(heap + 32)
        hvis no < forrige { samlingar = samlingar + 1 }
        forrige = no
        r = r + 1
    }
    skriv("søppel: runder=" + tekst(runder) + " tot=" + tekst(tot) + "\n")
    returner samlingar
}

funksjon start() -> heiltall {
    skriv("K1-prøve: Norscode OS\n")
    strengar()
    lister()
    kart()
    unnatak()
    skriv("rekursjon: djup(1000)=" + tekst(djup(1000)) + " fib(22)=" + tekst(fib(22)) + "\n")
    la t0 = builtin.tid_ms()
    la n = søppel(8000)
    la t1 = builtin.tid_ms()
    skriv("gc: samlingar=" + tekst(n) + "\n")
    hvis n >= 3 {
        skriv("gc: minst 3 innsamlingar\n")
    } ellers {
        skriv("gc: FEIL, berre " + tekst(n) + " innsamlingar\n")
    }
    hvis t0 > 0 og t1 >= t0 { skriv("tid: ok\n") } ellers { skriv("tid: FEIL\n") }
    la tilf = builtin.random_hex(8)
    hvis lengde(tilf) == 16 { skriv("tilfeldig: ok\n") } ellers { skriv("tilfeldig: FEIL\n") }
    skriv("K1-prøve: ferdig\n")
    returner 0
}
