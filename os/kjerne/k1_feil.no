// os/kjerne/k1_feil.no — K1: ein kjerne som med vilje les frå side 0 (null-peikar).
//
// Side 0 er umappa i Norscode OS (som på Linux), og adressa ligg utanfor heap-/stakk-
// vindauget, så #PF-stubben skal skrive diagnose (vektor 0x0e, feilkode, RIP, CR2) over
// COM1 og avslutte med debug-exit-kode 125 (QEMU-status 251) — ikkje trippelfeil.
// På Linux gjev same ELF SIGSEGV.

funksjon start() -> heiltall {
    skriv("før feil\n")
    la v = builtin.raw_load64(8)
    skriv("etter feil: " + tekst(v) + "\n")
    returner 0
}
