// os/kjerne/k3_prøve.no — K3-prøvekjerne: brukarprosessar i ring 3.
//
// Lastar alle Multiboot-modulane (uendra Norscode linux-x86_64-ELF-ar) som prosessar med
// eige CR3, køyrer dei round-robin med føregriping (PIT 100 Hz) og Linux-syscall nivå 1,
// og rapporterer exit-kodane. Ein prosess som feilar blir drepen; kjernen held fram.

bruk os.x86.info som info
bruk os.x86.maskin som maskin
bruk os.drivarar.tidtakar som tidtakar
bruk os.minne.rammer som rammer
bruk os.prosess.prosess som prosess

funksjon basenamn(sti: tekst) -> tekst {
    la i = lengde(sti) - 1
    mens i >= 0 {
        la c = builtin.slice(sti, i, i + 1)
        hvis c == "/" { returner builtin.slice(sti, i + 1, lengde(sti)) }
        i = i - 1
    }
    returner sti
}

funksjon start() -> heiltall {
    skriv("K3-prøve: Norscode OS\n")
    maskin.init()
    tidtakar.start(100)
    maskin.sti()
    la frie = rammer.init(134217728)
    skriv("[k3] rammer til prosessar: " + tekst(frie / 256) + " MiB\n")
    la modular = maskin.modular()
    skriv("[k3] modular: " + tekst(lengde(modular)) + "\n")
    for m i modular {
        la namn = basenamn(maskin.c_streng(m[2]))
        hvis builtin.ends_with(namn, ".elf") { namn = builtin.slice(namn, 0, lengde(namn) - 4) }
        la pid = prosess.lag(namn, m[0], m[1])
        skriv("[k3] prosess " + tekst(pid) + ": " + namn + " (" + tekst(m[1] - m[0]) + " B)\n")
    }
    la t0 = tidtakar.tikk()
    prosess.køyr_alle()
    la dt = tidtakar.tikk() - t0
    la pid = 1
    mens pid <= prosess.tal() {
        skriv("[k3] prosess " + tekst(pid) + " (" + prosess.namn(pid) + ") exit=" + tekst(prosess.kode(pid)) +
            " syscalls=" + tekst(prosess.syscalls(pid)) + " sidefeil=" + tekst(prosess.sidefeil(pid)) + "\n")
        pid = pid + 1
    }
    skriv("[k3] føregripingar=" + tekst(prosess.tal_føregripingar()) + " syscalls=" + tekst(prosess.tal_syscalls()) +
        " sidefeil=" + tekst(prosess.tal_sidefeil()) + " tikk=" + tekst(dt) + "\n")
    skriv("[k3] ukjende syscalls: " + tekst(lengde(prosess.ukjende_syscalls())) + "\n")
    skriv("[k3] rammer frie etter: " + tekst(rammer.frie()) + " av " + tekst(frie) + "\n")
    skriv("K3-prøve: ferdig\n")
    returner 0
}
