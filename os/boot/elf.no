// os/boot/elf.no — les programhovuda i ein Norscode linux-x86_64 AOT-ELF (ELF64 ET_EXEC).
//
// Kjerne-biletet i Norscode OS er ein UENDRA AOT-ELF frå native_codegen_v2. Codegen-en
// skriv segmenta tett i fila med side-justerte offsetar (tekst @0 → 0x400000,
// .data → 0x700000, host-ABI-side → 0x770000, heap-kontrollblokk → 0x780000 med
// memsz 0x6AA80000 i GC-modus). Pakkaren legg heile fila inn i biletet og lagar
// sidetabellar VA → fysisk; difor treng me berre programhovuda, ikkje seksjonar.

funksjon les_u16(b: liste_heiltall, o: heiltall) -> heiltall {
    returner b[o] | (b[o + 1] << 8)
}

funksjon les_u32(b: liste_heiltall, o: heiltall) -> heiltall {
    returner b[o] | (b[o + 1] << 8) | (b[o + 2] << 16) | (b[o + 3] << 24)
}

funksjon les_u64(b: liste_heiltall, o: heiltall) -> heiltall {
    returner les_u32(b, o) | (les_u32(b, o + 4) << 32)
}

// Kontrollerer ELF-identiteten og kastar med ei tydeleg melding om noko ikkje stemmer.
funksjon sjekk(b: liste_heiltall) -> heiltall {
    hvis lengde(b) < 64 { kast "elf: fila er for kort" }
    hvis b[0] != 127 eller b[1] != 69 eller b[2] != 76 eller b[3] != 70 { kast "elf: manglar ELF-magi" }
    hvis b[4] != 2 { kast "elf: ikkje ELFCLASS64" }
    hvis b[5] != 1 { kast "elf: ikkje little-endian" }
    hvis les_u16(b, 16) != 2 { kast "elf: ikkje ET_EXEC" }
    hvis les_u16(b, 18) != 62 { kast "elf: ikkje EM_X86_64" }
    hvis les_u16(b, 54) != 56 { kast "elf: uventa e_phentsize" }
    returner 0
}

funksjon inngang(b: liste_heiltall) -> heiltall { returner les_u64(b, 24) }

// PT_LOAD-segmenta som liste av kart {type, flagg, offset, vaddr, filesz, memsz}.
funksjon last_segment(b: liste_heiltall) -> liste<ordbok_heltall> {
    sjekk(b)
    la phoff = les_u64(b, 32)
    la phnum = les_u16(b, 56)
    la ut: liste<ordbok_heltall> = []
    la i = 0
    mens i < phnum {
        la o = phoff + i * 56
        hvis les_u32(b, o) == 1 {
            la s: ordbok_heltall = {}
            s["flagg"] = les_u32(b, o + 4)
            s["offset"] = les_u64(b, o + 8)
            s["vaddr"] = les_u64(b, o + 16)
            s["filesz"] = les_u64(b, o + 32)
            s["memsz"] = les_u64(b, o + 40)
            hvis (s["vaddr"] % 4096) != 0 eller (s["offset"] % 4096) != 0 {
                kast "elf: PT_LOAD er ikkje side-justert (vaddr/offset)"
            }
            hvis s["offset"] + s["filesz"] > lengde(b) { kast "elf: PT_LOAD går forbi slutten av fila" }
            legg_til(ut, s)
        }
        i = i + 1
    }
    hvis lengde(ut) == 0 { kast "elf: ingen PT_LOAD" }
    returner ut
}
