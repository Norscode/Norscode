// os/x86/info.no — felles kontrakt mellom trampolinen (os/boot) og Norscode-kjernen:
// layouten til boot-info-blokka, stubb-indeksane og hendingsringen.
//
// Trampolinen emitterer blokka i sitt eige (identitetskarta) dataområde og gjev adressa
// til kjernen i miljøet: NORSCODE_OS_INFO=<desimal adresse>. Alle felt er u64.
// Same modul blir brukt ved byggjetid (trampolinen, i VM-en) og ved køyretid (kjernen,
// AOT), så offset-tala finst berre her.

funksjon MAGI() -> heiltall { returner 0x4E43534F53 }          // «NCSOS»
funksjon VERSJON() -> heiltall { returner 3 }

// ─── Felt i info-blokka (offset i byte) ──────────────────────────────────────
funksjon F_MAGI() -> heiltall { returner 0 }
funksjon F_VERSJON() -> heiltall { returner 8 }
funksjon F_STUBBTABELL() -> heiltall { returner 16 }   // adresse til u64[TAL_STUBBAR]
funksjon F_TAL_STUBBAR() -> heiltall { returner 24 }
funksjon F_RING() -> heiltall { returner 32 }          // adresse til hendingsringen
funksjon F_TIKK() -> heiltall { returner 40 }          // teljar, auka av IRQ0-stubben
funksjon F_TIKK_HZ() -> heiltall { returner 48 }       // 0 = ingen tidtakar (sett av PIT-drivaren)
funksjon F_MMAP_TAL() -> heiltall { returner 56 }
funksjon F_MMAP() -> heiltall { returner 64 }          // adresse til {base, lengd, type} × MMAP_TAL
funksjon F_POOL_FØRSTE() -> heiltall { returner 72 }   // første ramme i #PF-poolen
funksjon F_POOL_NESTE() -> heiltall { returner 80 }    // #PF-poolen sin bump-peikar (eigd av #PF)
funksjon F_POOL_SLUTT() -> heiltall { returner 88 }    // slutt på #PF-poolen (senkast av pool_avgrens)
funksjon F_DIREKTEKART() -> heiltall { returner 96 }   // VA-base for fysisk minne (0–4 GiB)
funksjon F_SERIE_PORT() -> heiltall { returner 104 }
funksjon F_FRAMEBUFFER() -> heiltall { returner 112 }  // 0 = ingen (berre seriell i K2)
funksjon F_ARGBLOKK() -> heiltall { returner 120 }     // 8 × u64 skrapeblokk for stubbar med fleire argument
funksjon F_MBI_FLAGG() -> heiltall { returner 128 }
funksjon F_MEM_LÅG() -> heiltall { returner 136 }      // KiB under 1 MiB
funksjon F_MEM_HØG() -> heiltall { returner 144 }      // KiB over 1 MiB
funksjon F_HEAP_LÅG() -> heiltall { returner 152 }
funksjon F_HEAP_HØG() -> heiltall { returner 160 }
funksjon F_STAKK_LÅG() -> heiltall { returner 168 }
funksjon F_STAKK_TOPP() -> heiltall { returner 176 }
funksjon F_SIDEFEIL() -> heiltall { returner 184 }     // teljar for demand-zero-sidefeil
funksjon F_HPET_PERIODE() -> heiltall { returner 192 } // femtosekund per HPET-tikk (0 = ingen HPET)
funksjon F_BILETE_SLUTT() -> heiltall { returner 200 } // fysisk slutt på trampoline+ELF+bss
funksjon F_MBI_SLUTT() -> heiltall { returner 208 }    // høgaste fysiske slutt på Multiboot-data
funksjon F_MODULAR_TAL() -> heiltall { returner 216 }  // Multiboot-modular (K3: brukarprogram)
funksjon F_MODULAR() -> heiltall { returner 224 }      // adresse til {start, slutt, streng} × MODULAR_TAL (fysiske)
funksjon STORLEIK() -> heiltall { returner 256 }

funksjon MMAP_MAKS() -> heiltall { returner 32 }
funksjon MMAP_POST() -> heiltall { returner 24 }       // {base, lengd, type}
funksjon MODUL_MAKS() -> heiltall { returner 8 }
funksjon MODUL_POST() -> heiltall { returner 24 }      // {start, slutt, streng} (fysiske adresser)

// ─── Hendingsringen (éin produsent = IRQ-stubbane, éin konsument = kjernen) ──
// Hovud: +0 skrive-indeks (monoton, eigd av stubbane), +8 lese-indeks (monoton, eigd av
// kjernen), +16 tapte hendingar (full ring), +24 kapasitet. Postar frå +64, 32 byte kvar:
// {vektor, data, tsc, sekvens}. Post i = RING_POSTAR + (indeks % kapasitet) * 32.
funksjon R_HOVUD() -> heiltall { returner 0 }
funksjon R_HALE() -> heiltall { returner 8 }
funksjon R_TAPTE() -> heiltall { returner 16 }
funksjon R_KAPASITET() -> heiltall { returner 24 }
funksjon R_POSTAR() -> heiltall { returner 64 }
funksjon RING_KAPASITET() -> heiltall { returner 256 }
funksjon RING_POST() -> heiltall { returner 32 }

// ─── Stubbar (raw_call(adresse, arg)) ────────────────────────────────────────
// «blk» = arg er adressa til argumentblokka (F_ARGBLOKK); elles er arg sjølve verdien.
funksjon S_INB() -> heiltall { returner 0 }            // (port) → byte
funksjon S_INW() -> heiltall { returner 1 }
funksjon S_INL() -> heiltall { returner 2 }
funksjon S_OUTB() -> heiltall { returner 3 }           // blk: [port, verdi]
funksjon S_OUTW() -> heiltall { returner 4 }
funksjon S_OUTL() -> heiltall { returner 5 }
funksjon S_MMIO_LES16() -> heiltall { returner 6 }     // (va) → u16
funksjon S_MMIO_LES32() -> heiltall { returner 7 }     // (va) → u32
funksjon S_MMIO_SKRIV16() -> heiltall { returner 8 }   // blk: [va, verdi]
funksjon S_MMIO_SKRIV32() -> heiltall { returner 9 }
funksjon S_CLI() -> heiltall { returner 10 }
funksjon S_STI() -> heiltall { returner 11 }
funksjon S_HLT() -> heiltall { returner 12 }
funksjon S_VENT_HENDING() -> heiltall { returner 13 }  // cli; tom ring → sti;hlt; → 1 om ringen ikkje var tom
funksjon S_LES_CR0() -> heiltall { returner 14 }
funksjon S_LES_CR2() -> heiltall { returner 15 }
funksjon S_LES_CR3() -> heiltall { returner 16 }
funksjon S_LES_CR4() -> heiltall { returner 17 }
funksjon S_SKRIV_CR0() -> heiltall { returner 18 }     // (verdi)
funksjon S_SKRIV_CR3() -> heiltall { returner 19 }
funksjon S_SKRIV_CR4() -> heiltall { returner 20 }
funksjon S_RDMSR() -> heiltall { returner 21 }         // (msr) → edx:eax
funksjon S_WRMSR() -> heiltall { returner 22 }         // blk: [msr, verdi]
funksjon S_INVLPG() -> heiltall { returner 23 }        // (va)
funksjon S_RDTSC() -> heiltall { returner 24 }
funksjon S_CPUID() -> heiltall { returner 25 }         // blk: [blad, underblad] → blk[2..5] = eax, ebx, ecx, edx
funksjon S_RDRAND() -> heiltall { returner 26 }        // blk → blk[0] = verdi; 1 = ok, 0 = svikta
funksjon S_NULLSTILL_SIDE() -> heiltall { returner 27 } // (va, 4 KiB-justert)
funksjon S_POOL_AVGRENS() -> heiltall { returner 28 }  // (ny_slutt) → ny slutt, 0 = avslått
funksjon S_LES_RFLAGS() -> heiltall { returner 29 }
funksjon S_KOPIER() -> heiltall { returner 30 }        // blk: [dst_va, src_va, n] (rep movsb)
funksjon S_SKRIV_VA() -> heiltall { returner 31 }      // blk: [va, n] → COM1
funksjon S_KLOKKE_NS() -> heiltall { returner 32 }     // (0 = sanntid, 1 = monoton) → ns
funksjon S_KJØR_BRUKAR() -> heiltall { returner 33 }   // (pcb_va) → grunn (P_GRUNN)
funksjon TAL_STUBBAR() -> heiltall { returner 34 }

funksjon STUBB_NAMN() -> liste_tekst {
    returner ["inb", "inw", "inl", "outb", "outw", "outl", "mmio_les16", "mmio_les32",
        "mmio_skriv16", "mmio_skriv32", "cli", "sti", "hlt", "vent_hending",
        "les_cr0", "les_cr2", "les_cr3", "les_cr4", "skriv_cr0", "skriv_cr3", "skriv_cr4",
        "rdmsr", "wrmsr", "invlpg", "rdtsc", "cpuid", "rdrand", "nullstill_side",
        "pool_avgrens", "les_rflags", "kopier", "skriv_va", "klokke_ns", "kjor_brukar"]
}

// Avbrotsvektorar: 8259-PIC-en er remappa til 32–47 (IRQ n → 32 + n).
funksjon IRQ_BASE() -> heiltall { returner 32 }
funksjon V_TIDTAKAR() -> heiltall { returner 32 }  // IRQ0: aukar F_TIKK, postar ikkje
funksjon V_TASTATUR() -> heiltall { returner 33 }  // IRQ1: data = scancode frå port 0x60
funksjon V_SERIE() -> heiltall { returner 36 }     // IRQ4: éin post per mottatt byte

// ─── Prosesskontrollblokk (PCB, K3) ──────────────────────────────────────────
// Éi 4 KiB-ramme per prosess, nådd via direktekartet (mappa i alle CR3). kjor_brukar
// lastar registra herifrå og går til ring 3; fellene (syscall frå CPL3, unnatak, IRQ0)
// lagrar dei hit og «returnerer» til kjernen med P_GRUNN.
funksjon P_RAX() -> heiltall { returner 0 }
funksjon P_RBX() -> heiltall { returner 8 }
funksjon P_RCX() -> heiltall { returner 16 }
funksjon P_RDX() -> heiltall { returner 24 }
funksjon P_RSI() -> heiltall { returner 32 }
funksjon P_RDI() -> heiltall { returner 40 }
funksjon P_RBP() -> heiltall { returner 48 }
funksjon P_R8() -> heiltall { returner 56 }
funksjon P_R9() -> heiltall { returner 64 }
funksjon P_R10() -> heiltall { returner 72 }
funksjon P_R11() -> heiltall { returner 80 }
funksjon P_R12() -> heiltall { returner 88 }
funksjon P_R13() -> heiltall { returner 96 }
funksjon P_R14() -> heiltall { returner 104 }
funksjon P_R15() -> heiltall { returner 112 }
funksjon P_RSP() -> heiltall { returner 120 }
funksjon P_RIP() -> heiltall { returner 128 }
funksjon P_RFLAGS() -> heiltall { returner 136 }
funksjon P_CR3() -> heiltall { returner 144 }
funksjon P_GRUNN() -> heiltall { returner 152 }
funksjon P_VEKTOR() -> heiltall { returner 160 }
funksjon P_FEIL() -> heiltall { returner 168 }
funksjon P_CR2() -> heiltall { returner 176 }
funksjon P_FX() -> heiltall { returner 256 }           // FXSAVE64-område (512 B, 16-justert)
funksjon PCB_STORLEIK() -> heiltall { returner 768 }

// Offset i PCB-en for register nr. r (x86-koding: RAX=0 … R15=15; RSP har eige felt).
funksjon P_REG(r: heiltall) -> heiltall {
    la tab: liste_heiltall = [0, 16, 24, 8, 120, 48, 32, 40, 56, 64, 72, 80, 88, 96, 104, 112]
    returner tab[r]
}

funksjon GRUNN_SYSCALL() -> heiltall { returner 1 }    // syscall frå ring 3 (nr i P_RAX)
funksjon GRUNN_FELLE() -> heiltall { returner 2 }      // unnatak eller IRQ0-føregriping (P_VEKTOR)

// Segmentveljarar for ring 3 (GDT: 0x28 brukardata, 0x30 brukarkode64).
funksjon SEL_BRUKAR_DATA() -> heiltall { returner 43 }  // 0x2B
funksjon SEL_BRUKAR_KODE() -> heiltall { returner 51 }  // 0x33
