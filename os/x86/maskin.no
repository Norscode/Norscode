// os/x86/maskin.no — maskinvareprimitiv for Norscode OS-kjernen (K2).
//
// Kvar primitiv er eit raw_call til ein maskinkode-stubb som trampolinen har lagt i
// identitetskarta kodeminne (os/boot/stubbar.no); adressene står i stubbtabellen i
// info-blokka (os/x86/info.no), som kjernen finn via NORSCODE_OS_INFO i miljøet.
// Stubbar med fleire argument les dei frå argumentblokka i info-området.
//
// Alt her er vanleg, synkron Norscode: det må ALDRI kallast frå avbrotskontekst.

bruk os.x86.info som info

la _info = 0
la _blk = 0
la _stubbar: liste_heiltall = []

// Les NORSCODE_OS_INFO, kontrollerer magi/versjon og hentar stubbadressene.
funksjon init() -> heiltall {
    hvis _info != 0 { returner _info }
    la t = ""
    prøv { t = tekst(miljo_hent("NORSCODE_OS_INFO")) } fang e { t = "" }
    hvis t == "" { kast "maskin: NORSCODE_OS_INFO manglar (køyrer ikkje under Norscode OS-trampolinen)" }
    la a = heltall_fra_tekst(t)
    hvis builtin.raw_load64(a + info.F_MAGI()) != info.MAGI() { kast "maskin: feil magi i info-blokka" }
    hvis builtin.raw_load64(a + info.F_VERSJON()) != info.VERSJON() { kast "maskin: ukjend info-versjon" }
    la n = builtin.raw_load64(a + info.F_TAL_STUBBAR())
    hvis n != info.TAL_STUBBAR() { kast "maskin: stubbtabellen har " + tekst(n) + " postar, venta " + tekst(info.TAL_STUBBAR()) }
    la tab = builtin.raw_load64(a + info.F_STUBBTABELL())
    la l: liste_heiltall = []
    la i = 0
    mens i < n {
        legg_til(l, builtin.raw_load64(tab + i * 8))
        i = i + 1
    }
    _stubbar = l
    _blk = builtin.raw_load64(a + info.F_ARGBLOKK())
    _info = a
    returner a
}

funksjon info_adr() -> heiltall { returner _info }
funksjon felt(off: heiltall) -> heiltall { returner builtin.raw_load64(_info + off) }
funksjon sett_felt(off: heiltall, v: heiltall) -> heiltall {
    builtin.raw_store64(_info + off, v)
    returner v
}
funksjon direktekart() -> heiltall { returner felt(info.F_DIREKTEKART()) }
funksjon fys_til_va(fys: heiltall) -> heiltall { returner felt(info.F_DIREKTEKART()) + fys }

funksjon _kall(idx: heiltall, arg: heiltall) -> heiltall {
    returner builtin.raw_call(_stubbar[idx], arg)
}

funksjon _kall2(idx: heiltall, a: heiltall, b: heiltall) -> heiltall {
    builtin.raw_store64(_blk, a)
    builtin.raw_store64(_blk + 8, b)
    returner builtin.raw_call(_stubbar[idx], _blk)
}

// ─── Port-I/O ────────────────────────────────────────────────────────────────
funksjon inb(port: heiltall) -> heiltall { returner _kall(info.S_INB(), port) }
funksjon inw(port: heiltall) -> heiltall { returner _kall(info.S_INW(), port) }
funksjon inl(port: heiltall) -> heiltall { returner _kall(info.S_INL(), port) }
funksjon outb(port: heiltall, v: heiltall) -> heiltall { returner _kall2(info.S_OUTB(), port, v & 255) }
funksjon outw(port: heiltall, v: heiltall) -> heiltall { returner _kall2(info.S_OUTW(), port, v & 65535) }
funksjon outl(port: heiltall, v: heiltall) -> heiltall { returner _kall2(info.S_OUTL(), port, v & 0xFFFFFFFF) }

// ─── MMIO (va = direktekart + fysisk) ────────────────────────────────────────
funksjon mmio_les16(va: heiltall) -> heiltall { returner _kall(info.S_MMIO_LES16(), va) }
funksjon mmio_les32(va: heiltall) -> heiltall { returner _kall(info.S_MMIO_LES32(), va) }
funksjon mmio_skriv16(va: heiltall, v: heiltall) -> heiltall { returner _kall2(info.S_MMIO_SKRIV16(), va, v) }
funksjon mmio_skriv32(va: heiltall, v: heiltall) -> heiltall { returner _kall2(info.S_MMIO_SKRIV32(), va, v) }

// ─── CPU ─────────────────────────────────────────────────────────────────────
funksjon cli() -> heiltall { returner _kall(info.S_CLI(), 0) }
funksjon sti() -> heiltall { returner _kall(info.S_STI(), 0) }
funksjon hlt() -> heiltall { returner _kall(info.S_HLT(), 0) }
// Søv til neste avbrot om hendingsringen er tom (atomisk sti;hlt). Slår på IF.
funksjon vent_hending() -> heiltall { returner _kall(info.S_VENT_HENDING(), 0) }
funksjon les_cr0() -> heiltall { returner _kall(info.S_LES_CR0(), 0) }
funksjon les_cr2() -> heiltall { returner _kall(info.S_LES_CR2(), 0) }
funksjon les_cr3() -> heiltall { returner _kall(info.S_LES_CR3(), 0) }
funksjon les_cr4() -> heiltall { returner _kall(info.S_LES_CR4(), 0) }
funksjon skriv_cr0(v: heiltall) -> heiltall { returner _kall(info.S_SKRIV_CR0(), v) }
funksjon skriv_cr3(v: heiltall) -> heiltall { returner _kall(info.S_SKRIV_CR3(), v) }
funksjon skriv_cr4(v: heiltall) -> heiltall { returner _kall(info.S_SKRIV_CR4(), v) }
funksjon rdmsr(msr: heiltall) -> heiltall { returner _kall(info.S_RDMSR(), msr) }
funksjon wrmsr(msr: heiltall, v: heiltall) -> heiltall { returner _kall2(info.S_WRMSR(), msr, v) }
funksjon invlpg(va: heiltall) -> heiltall { returner _kall(info.S_INVLPG(), va) }
funksjon rdtsc() -> heiltall { returner _kall(info.S_RDTSC(), 0) }
funksjon les_rflags() -> heiltall { returner _kall(info.S_LES_RFLAGS(), 0) }
funksjon avbrot_på() -> boolsk { returner (les_rflags() & 512) != 0 }

// cpuid(blad, underblad) → [eax, ebx, ecx, edx]
funksjon cpuid(blad: heiltall, underblad: heiltall) -> liste_heiltall {
    _kall2(info.S_CPUID(), blad, underblad)
    returner [builtin.raw_load64(_blk + 16), builtin.raw_load64(_blk + 24),
              builtin.raw_load64(_blk + 32), builtin.raw_load64(_blk + 40)]
}

// rdrand → [1, verdi] eller [0, 0] når RDRAND sviktar/manglar.
funksjon rdrand() -> liste_heiltall {
    la ok = _kall(info.S_RDRAND(), _blk)
    hvis ok == 1 { returner [1, builtin.raw_load64(_blk)] }
    returner [0, 0]
}

// Nullstiller 4 KiB på VA-en (t.d. fys_til_va(ramme)).
funksjon nullstill_side(va: heiltall) -> heiltall { returner _kall(info.S_NULLSTILL_SIDE(), va) }

// Senkar slutten på trampolinen sin #PF-pool til `ny_slutt`; 0 = avslått.
funksjon pool_avgrens(ny_slutt: heiltall) -> heiltall { returner _kall(info.S_POOL_AVGRENS(), ny_slutt) }

// Minnekartet frå Multiboot (kopiert av trampolinen): liste av [base, lengd, type].
funksjon minnekart() -> liste<liste_heiltall> {
    la ut: liste<liste_heiltall> = []
    la n = felt(info.F_MMAP_TAL())
    la a = felt(info.F_MMAP())
    la i = 0
    mens i < n {
        la p = a + i * info.MMAP_POST()
        legg_til(ut, [builtin.raw_load64(p), builtin.raw_load64(p + 8), builtin.raw_load64(p + 16)])
        i = i + 1
    }
    returner ut
}

// ─── K3 ──────────────────────────────────────────────────────────────────────

funksjon _kall3(idx: heiltall, a: heiltall, b: heiltall, c: heiltall) -> heiltall {
    builtin.raw_store64(_blk, a)
    builtin.raw_store64(_blk + 8, b)
    builtin.raw_store64(_blk + 16, c)
    returner builtin.raw_call(_stubbar[idx], _blk)
}

// Kopierer n byte mellom to VA-ar (typisk direktekart-adresser).
funksjon kopier(dst_va: heiltall, src_va: heiltall, n: heiltall) -> heiltall {
    returner _kall3(info.S_KOPIER(), dst_va, src_va, n)
}

// Skriv n byte frå VA-en rett til konsollen (COM1).
funksjon skriv_va(va: heiltall, n: heiltall) -> heiltall { returner _kall2(info.S_SKRIV_VA(), va, n) }

// Nanosekund: monoton (sann) eller sanntid (usann), same kjelde som clock_gettime-shimmen.
funksjon klokke_ns(monoton: boolsk) -> heiltall {
    hvis monoton { returner _kall(info.S_KLOKKE_NS(), 1) }
    returner _kall(info.S_KLOKKE_NS(), 0)
}

// Køyrer prosessen (PCB på direktekart-VA) i ring 3 til han fell tilbake; grunn frå os.x86.info.
funksjon kjør_brukar(pcb_va: heiltall) -> heiltall { returner _kall(info.S_KJØR_BRUKAR(), pcb_va) }

// NUL-terminert streng på fysisk adresse (ASCII; andre byte → «?»).
funksjon c_streng(fys: heiltall) -> tekst {
    la va = fys_til_va(fys)
    la t = ""
    la i = 0
    mens i < 4096 {
        la b = builtin.raw_load8(va + i)
        hvis b == 0 { returner t }
        hvis b >= 32 og b < 127 { t = t + builtin.chr(b) } ellers { t = t + "?" }
        i = i + 1
    }
    returner t
}

// Multiboot-modular: liste av [start, slutt, streng_fys].
funksjon modular() -> liste<liste_heiltall> {
    la ut: liste<liste_heiltall> = []
    la n = felt(info.F_MODULAR_TAL())
    la a = felt(info.F_MODULAR())
    la i = 0
    mens i < n {
        la p = a + i * info.MODUL_POST()
        legg_til(ut, [builtin.raw_load64(p), builtin.raw_load64(p + 8), builtin.raw_load64(p + 16)])
        i = i + 1
    }
    returner ut
}
