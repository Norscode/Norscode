// os/drivarar/serie.no — 16550 COM1 mottak via IRQ4 (K2).
//
// Utdata går framleis gjennom write(1) → shimmen (polla THRE). Mottak: IER.RDA på,
// MCR.OUT2 på (trampolinen), IRQ4 opna i PIC-en. IRQ4-stubben les alle ventande bytar
// (LSR.DR) og postar éin hending per byte (vektor 36). Denne drivaren samlar linjer.
// Linjer er ASCII: andre bytar blir «?» (ingen UTF-8-avkoding i K2). CR blir ignorert.

bruk os.x86.maskin som maskin
bruk os.drivarar.pic som pic

la _linje: liste_tekst = []
la _ferdige: liste_tekst = []

funksjon start() -> heiltall {
    maskin.outb(1017, 1)       // 0x3F9 IER = mottaksdata tilgjengeleg
    maskin.outb(1020, 11)      // 0x3FC MCR = DTR|RTS|OUT2
    pic.opne(4)
    returner 0
}

// Handsamar éin mottatt byte. Returnerer 1 når ei linje vart ferdig.
funksjon mottak(b: heiltall) -> heiltall {
    hvis b == 13 { returner 0 }
    hvis b == 10 {
        la t = ""
        for c i _linje { t = t + c }
        legg_til(_ferdige, t)
        _linje = []
        returner 1
    }
    hvis b == 8 eller b == 127 {
        _linje = _utan_siste(_linje)
        returner 0
    }
    hvis b >= 32 og b < 127 { legg_til(_linje, builtin.chr(b)) } ellers { legg_til(_linje, "?") }
    returner 0
}

funksjon har_linje() -> boolsk { returner lengde(_ferdige) > 0 }

funksjon ta_linje() -> tekst {
    hvis lengde(_ferdige) == 0 { returner "" }
    la t = _ferdige[0]
    la rest: liste_tekst = []
    la i = 1
    mens i < lengde(_ferdige) {
        legg_til(rest, _ferdige[i])
        i = i + 1
    }
    _ferdige = rest
    returner t
}

funksjon _utan_siste(l: liste_tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i + 1 < lengde(l) {
        legg_til(ut, l[i])
        i = i + 1
    }
    returner ut
}
