// os/drivarar/hendingar.no — konsumenten av hendingsringen (K2).
//
// IRQ-stubbane (maskinkode, os/boot/stubbar.no) er einaste produsent og skriv berre
// skrive-indeksen; kjernen er einaste konsument og skriv berre lese-indeksen. Indeksane
// er monotone u64, så «tom» = hovud == hale og «full» = hovud − hale == kapasitet.
// x86 har TSO: stubben skriv posten før hovudet, så ein lesar som ser nytt hovud ser
// òg posten.

bruk os.x86.info som info
bruk os.x86.maskin som maskin

funksjon _ring() -> heiltall { returner maskin.felt(info.F_RING()) }

funksjon ventande() -> heiltall {
    la r = _ring()
    returner builtin.raw_load64(r + info.R_HOVUD()) - builtin.raw_load64(r + info.R_HALE())
}

funksjon tapte() -> heiltall { returner builtin.raw_load64(_ring() + info.R_TAPTE()) }

// Neste hending som [vektor, data, tsc, sekvens], eller [] når ringen er tom.
funksjon neste() -> liste_heiltall {
    la r = _ring()
    la hale = builtin.raw_load64(r + info.R_HALE())
    la hovud = builtin.raw_load64(r + info.R_HOVUD())
    hvis hale == hovud { returner [] }
    la kap = builtin.raw_load64(r + info.R_KAPASITET())
    la p = r + info.R_POSTAR() + (hale % kap) * info.RING_POST()
    la h: liste_heiltall = [builtin.raw_load64(p), builtin.raw_load64(p + 8),
                            builtin.raw_load64(p + 16), builtin.raw_load64(p + 24)]
    builtin.raw_store64(r + info.R_HALE(), hale + 1)
    returner h
}

// Blokker (hlt) til ringen har minst éi hending eller neste avbrot (t.d. tidtakar-tikk).
funksjon vent() -> heiltall { returner maskin.vent_hending() }
