// os/drivarar/pic.no — 8259-PIC (remappa til vektor 32–47 av trampolinen, alt maskert).

bruk os.x86.maskin som maskin

funksjon _port(irq: heiltall) -> heiltall {
    hvis irq >= 8 { returner 161 }   // 0xA1
    returner 33                      // 0x21
}

funksjon opne(irq: heiltall) -> heiltall {
    la p = _port(irq)
    la bit = 1 << (irq % 8)
    la m = maskin.inb(p)
    hvis (m & bit) != 0 { maskin.outb(p, m - bit) }
    hvis irq >= 8 { opne(2) }
    returner 0
}

funksjon lukk(irq: heiltall) -> heiltall {
    la p = _port(irq)
    maskin.outb(p, maskin.inb(p) | (1 << (irq % 8)))
    returner 0
}

funksjon maske() -> heiltall { returner maskin.inb(33) | (maskin.inb(161) << 8) }
