// os/drivarar/rtc.no — CMOS-sanntidsklokka (MC146818) via port 0x70/0x71 (K2).

bruk os.x86.maskin som maskin

funksjon _les(reg: heiltall) -> heiltall {
    maskin.outb(112, reg)
    returner maskin.inb(113)
}

funksjon _bcd(v: heiltall) -> heiltall { returner (v >> 4) * 10 + (v & 15) }

funksjon _rå() -> liste_heiltall {
    // Vent til oppdateringa (reg 0x0A bit 7) er ferdig.
    la n = 0
    mens (_les(10) & 128) != 0 og n < 100000 { n = n + 1 }
    returner [_les(0), _les(2), _les(4), _les(7), _les(8), _les(9), _les(50)]
}

// [år, månad, dag, time, minutt, sekund] (UTC slik QEMU/BIOS har sett klokka).
funksjon les() -> liste_heiltall {
    // Les til to like avlesingar på rad (unngår riving midt i ei oppdatering).
    la a = _rå()
    la b = _rå()
    la n = 0
    mens n < 10 og (a[0] != b[0] eller a[1] != b[1] eller a[2] != b[2] eller a[3] != b[3] eller a[4] != b[4] eller a[5] != b[5]) {
        a = b
        b = _rå()
        n = n + 1
    }
    la status_b = _les(11)
    la sek = b[0]
    la min = b[1]
    la time = b[2]
    la dag = b[3]
    la mnd = b[4]
    la år = b[5]
    la hundre = b[6]
    la pm = (time & 128) != 0
    time = time & 127
    hvis (status_b & 4) == 0 {
        sek = _bcd(sek)
        min = _bcd(min)
        time = _bcd(time)
        dag = _bcd(dag)
        mnd = _bcd(mnd)
        år = _bcd(år)
        hundre = _bcd(hundre)
    }
    hvis (status_b & 2) == 0 og pm { time = (time % 12) + 12 }
    hvis hundre < 19 eller hundre > 21 { hundre = 20 }
    returner [hundre * 100 + år, mnd, dag, time, min, sek]
}

funksjon _to(v: heiltall) -> tekst {
    hvis v < 10 { returner "0" + tekst(v) }
    returner tekst(v)
}

funksjon som_tekst(t: liste_heiltall) -> tekst {
    returner tekst(t[0]) + "-" + _to(t[1]) + "-" + _to(t[2]) + " " + _to(t[3]) + ":" + _to(t[4]) + ":" + _to(t[5])
}
