// os/drivarar/tastatur.no — PS/2-tastatur via IRQ1 (K2).
//
// IRQ1-stubben les scancoden frå port 0x60 og postar han (vektor 33). i8042 står i
// omsetjingsmodus (BIOS), så kodane er sett 1: slepp = kode | 0x80, 0xE0 = prefiks.
// Drivaren held shift-/caps-tilstand og omset til ASCII (amerikansk oppsett).

bruk os.x86.maskin som maskin
bruk os.drivarar.pic som pic

la _shift = usann
la _caps = usann
la _e0 = usann
la _linje: liste_tekst = []
la _ferdige: liste_tekst = []

funksjon _normal() -> tekst { returner "..1234567890-=..qwertyuiop[]..asdfghjkl;'`.\\zxcvbnm,./" }
funksjon _skift() -> tekst { returner "..!@#$%^&*()_+..QWERTYUIOP{}..ASDFGHJKL:" + builtin.chr(34) + "~.|ZXCVBNM<>?" }

funksjon start() -> heiltall {
    // Tøm ein eventuell gamal byte i utbufferet (status 0x64 bit 0).
    la n = 0
    mens n < 16 og (maskin.inb(100) & 1) != 0 {
        maskin.inb(96)
        n = n + 1
    }
    pic.opne(1)
    returner 0
}

// Omset éin scancode. Returnerer teiknet ("" for ingenting, "\n" for Enter, chr(8) for
// Backspace) og byggjer samstundes linjer.
funksjon scancode(k: heiltall) -> tekst {
    hvis k == 224 {
        _e0 = sann
        returner ""
    }
    hvis _e0 {
        _e0 = usann
        returner ""
    }
    hvis k == 42 eller k == 54 { _shift = sann returner "" }
    hvis k == 170 eller k == 182 { _shift = usann returner "" }
    hvis k == 58 { _caps = ikkje _caps returner "" }
    hvis k >= 128 { returner "" }
    hvis k == 28 {
        la t = ""
        for c i _linje { t = t + c }
        legg_til(_ferdige, t)
        _linje = []
        returner "\n"
    }
    hvis k == 14 {
        _linje = _utan_siste(_linje)
        returner builtin.chr(8)
    }
    la c = ""
    hvis k == 57 {
        c = " "
    } ellers hvis k == 15 {
        c = builtin.chr(9)
    } ellers hvis k < lengde(_normal()) {
        la n = builtin.slice(_normal(), k, k + 1)
        la s = builtin.slice(_skift(), k, k + 1)
        hvis n == "." og k != 52 { returner "" }
        la stor = _shift
        la kode = builtin.char_code(n)
        hvis _caps og kode >= 97 og kode <= 122 { stor = ikkje stor }
        hvis stor { c = s } ellers { c = n }
    }
    hvis c != "" { legg_til(_linje, c) }
    returner c
}

funksjon har_linje() -> boolsk { returner lengde(_ferdige) > 0 }

funksjon ta_linje() -> tekst {
    hvis lengde(_ferdige) == 0 { returner "" }
    la t = _ferdige[0]
    la rest: liste_tekst = []
    la i = 1
    mens i < lengde(_ferdige) {
        legg_til(rest, _ferdige[i])
        i = i + 1
    }
    _ferdige = rest
    returner t
}

funksjon _utan_siste(l: liste_tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i + 1 < lengde(l) {
        legg_til(ut, l[i])
        i = i + 1
    }
    returner ut
}
