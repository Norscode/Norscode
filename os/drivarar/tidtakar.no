// os/drivarar/tidtakar.no — PIT (8253/8254) kanal 0 som periodisk tidtakar (K2).
//
// IRQ0-stubben aukar tikk-teljaren i info-blokka; han postar ikkje i hendingsringen
// (100 postar/s ville fylt ringen når kjernen reknar). Når tikk_hz er sett, søv
// nanosleep-shimmen med hlt til tikk-fristen, og monoton klokke kan falle tilbake på tikk.

bruk os.x86.info som info
bruk os.x86.maskin som maskin
bruk os.drivarar.pic som pic

funksjon PIT_HZ() -> heiltall { returner 1193182 }

funksjon start(hz: heiltall) -> heiltall {
    hvis hz < 19 eller hz > 10000 { kast "tidtakar: hz utanfor 19–10000" }
    la deling = (PIT_HZ() + hz / 2) / hz
    maskin.outb(67, 54)                    // 0x43 ← kanal 0, lo/hi, modus 3 (firkantbølgje)
    maskin.outb(64, deling & 255)          // 0x40
    maskin.outb(64, (deling >> 8) & 255)
    maskin.sett_felt(info.F_TIKK_HZ(), hz)
    pic.opne(0)
    returner deling
}

funksjon tikk() -> heiltall { returner maskin.felt(info.F_TIKK()) }
funksjon hz() -> heiltall { returner maskin.felt(info.F_TIKK_HZ()) }

// Ventar (hlt) til `n` nye tikk har gått. Krev at avbrot er på.
funksjon vent_tikk(n: heiltall) -> heiltall {
    la mål = tikk() + n
    mens tikk() < mål { maskin.vent_hending() }
    returner tikk()
}
