// os/brukar/vern.no — brukarprogram for K3: peikarvalidering og W^X.
//   1. write(1, <kjerneadresse 0x101000>, 16) skal gje -EFAULT (-14), ikkje lekke kjerneminne.
//   2. Skriving til eiga kode (0x401000, RX) skal drepe prosessen (#PF, vernebrot).
// Linux gjev same resultat (adressa er ikkje mappa → -14; skriving til tekst → SIGSEGV).
funksjon start() -> heiltall {
    skriv("vern: start\n")
    la r = builtin.sys6(1, 1, 0x101000, 16, 0, 0, 0)
    skriv("vern: write(kjerneadresse)=" + tekst(r) + "\n")
    builtin.raw_store8(0x401000, 144)
    skriv("vern: etter (skulle ikkje skje)\n")
    returner 0
}
