// os/brukar/nullpeikar.no — brukarprogram for K3: skriv til adresse 8 (null-peikar).
// Kjernen skal drepe prosessen med diagnose (#PF, cr2=0x8) medan dei andre held fram.
funksjon start() -> heiltall {
    skriv("nullpeikar: før\n")
    builtin.vent.sov(100)
    builtin.raw_store64(8, 1)
    skriv("nullpeikar: etter (skulle ikkje skje)\n")
    returner 0
}
