// os/brukar/kjerneles.no — brukarprogram for K3: les trampoline-/kjerneområdet (0x101000)
// frå ring 3. Sida finst i CR3-en (supervisor, U=0), så prosessen skal bli drepen.
funksjon start() -> heiltall {
    skriv("kjerneles: start\n")
    la v = builtin.raw_load64(0x101000)
    skriv("kjerneles: las " + tekst(v) + " (skulle ikkje skje)\n")
    returner 0
}
