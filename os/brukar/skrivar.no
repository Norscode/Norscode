// os/brukar/skrivar.no — brukarprogram (ikkje-GC) for K3: skriv linjer med nanosleep imellom.
funksjon start() -> heiltall {
    la i = 1
    mens i <= 12 {
        skriv("skrivar: linje " + tekst(i) + "\n")
        builtin.vent.sov(300)
        i = i + 1
    }
    skriv("skrivar: ferdig\n")
    returner 3
}
