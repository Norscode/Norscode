// os/brukar/nx.no — brukarprogram for K3: W^X i heap-vindauget. Skriv ein `ret` (0xC3) til
// ei heap-side (RW, NX) og hopp dit med raw_call: instruksjonshentinga skal gje #PF med
// I/D-biten og drepe prosessen. (0x60000000 ligg i GC-merkestakken, som er ubrukt her.)
funksjon start() -> heiltall {
    skriv("nx: start\n")
    builtin.raw_store8(0x60000000, 195)
    skriv("nx: skreiv ret til heapen\n")
    la r = builtin.raw_call(0x60000000, 0)
    skriv("nx: køyrde heap-kode (skulle ikkje skje) " + tekst(r) + "\n")
    returner 0
}
