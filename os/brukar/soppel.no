// os/brukar/soppel.no — brukarprogram (GC-modus) for K3: K1-søppellasta (~40 KiB per runde,
// >300 MiB totalt) med framdriftslinjer. Utdata er deterministiske og skal vere like på
// Linux og i Norscode OS.
funksjon start() -> heiltall {
    skriv("soppel: start\n")
    la heap = 0x780000
    la forrige = builtin.raw_load64(heap + 32)
    la samlingar = 0
    la tot = 0
    la r = 0
    mens r < 8000 {
        la l: liste_heiltall = []
        la i = 0
        mens i < 1000 {
            legg_til(l, i * r + 40000)
            i = i + 1
        }
        la s = "x" + tekst(r) + "-" + tekst(lengde(l))
        tot = tot + lengde(s) + l[999] % 7
        la no = builtin.raw_load64(heap + 32)
        hvis no < forrige { samlingar = samlingar + 1 }
        forrige = no
        r = r + 1
        hvis r % 1000 == 0 { skriv("soppel: runde " + tekst(r) + " tot=" + tekst(tot) + "\n") }
    }
    skriv("soppel: tot=" + tekst(tot) + " samlingar=" + tekst(samlingar) + "\n")
    returner 5
}
