// Fase 7e: DISTINCT + UNION/UNION ALL/INTERSECT/EXCEPT.
// Golden = ekte sqlite3 3.51.0. Dedup-variantar sorterast stigande (som SQLite).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE a (x INTEGER, y TEXT)")
    sql.exec(db, "INSERT INTO a (x, y) VALUES (1, 'p')")
    sql.exec(db, "INSERT INTO a (x, y) VALUES (2, 'q')")
    sql.exec(db, "INSERT INTO a (x, y) VALUES (2, 'q')")
    sql.exec(db, "INSERT INTO a (x, y) VALUES (3, 'r')")
    sql.exec(db, "CREATE TABLE b (x INTEGER, y TEXT)")
    sql.exec(db, "INSERT INTO b (x, y) VALUES (2, 'q')")
    sql.exec(db, "INSERT INTO b (x, y) VALUES (3, 'r')")
    sql.exec(db, "INSERT INTO b (x, y) VALUES (4, 's')")

    // DISTINCT (éin + fleire kolonnar)
    assert_eq(sql.query_rader(db, "SELECT DISTINCT y FROM a ORDER BY y"), "p\nq\nr")
    assert_eq(sql.query_rader(db, "SELECT DISTINCT x, y FROM a ORDER BY x"), "1|p\n2|q\n3|r")

    // UNION (dedup + sortert)
    assert_eq(sql.query_rader(db, "SELECT x FROM a UNION SELECT x FROM b"), "1\n2\n3\n4")
    // UNION ALL (bevar orden, ingen dedup)
    assert_eq(sql.query_rader(db, "SELECT x FROM a UNION ALL SELECT x FROM b"), "1\n2\n2\n3\n2\n3\n4")
    // INTERSECT
    assert_eq(sql.query_rader(db, "SELECT x FROM a INTERSECT SELECT x FROM b"), "2\n3")
    // EXCEPT
    assert_eq(sql.query_rader(db, "SELECT x FROM a EXCEPT SELECT x FROM b"), "1")
    // UNION m/ ORDER BY DESC (overstyrer standard-sortering)
    assert_eq(sql.query_rader(db, "SELECT x FROM a UNION SELECT x FROM b ORDER BY x DESC"), "4\n3\n2\n1")

    returner 0
}
