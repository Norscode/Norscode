bruk tools.verify_selvstendighet som selv
bruk std.filops som filops

funksjon les_hvis_finst(sti: tekst) -> tekst {
    hvis builtin.fil_finnes(sti) { returner builtin.fil_les(sti) }
    returner ""
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la fixture = "tests/fixtures/selvstendighet_child_dispatch.no"
    la unik = tekst_fra_heltall(builtin.tid_ms()) + "-" + builtin.random_hex(8)
    la markør_ok = root + "/build/strict-dispatch-" + unik + "-ok.txt"
    la markør_feil = root + "/build/strict-dispatch-" + unik + "-feil.txt"
    assert(filops.lag_katalogar(root + "/build"))
    assert(ikkje builtin.fil_finnes(markør_ok))
    assert(ikkje builtin.fil_finnes(markør_feil))

    la gammal_cmd = selv.env("NORSCODE_CMD")
    la gammal_fil = selv.env("NORSCODE_FILE")
    la gammal_verdi = selv.env("NORSCODE_STRICT_DISPATCH_VALUE")
    la ok = usann
    la feil_barn_ok = sann
    la ok_innhald = ""
    la feil_innhald = ""
    la unntak = ""
    // Dersom request-miljøet går tapt, køyrer barnet berre selftest. Det
    // kan ikkje starte foreldertesten/strict-porten rekursivt, og manglande
    // markør avslører feilen sjølv om selftest returnerer null.
    prøv {
        miljo_sett("NORSCODE_CMD", "selftest")
        miljo_sett("NORSCODE_FILE", "")
        miljo_sett("NORSCODE_STRICT_DISPATCH_VALUE", "forelder")
        ok = selv.run_step(root, "strict-dispatch: eksplisitt eigar og miljø",
            ["run-pure", fixture],
            {"NORSCODE_STRICT_DISPATCH_MARKER": markør_ok,
             "NORSCODE_STRICT_DISPATCH_VALUE": "barn med mellomrom og æøå",
             "NORSCODE_STRICT_DISPATCH_EXIT": "0"})
        ok_innhald = les_hvis_finst(markør_ok)
        feil_barn_ok = selv.run_step(root, "strict-dispatch: venta exit 7",
            ["run-pure", fixture],
            {"NORSCODE_STRICT_DISPATCH_MARKER": markør_feil,
             "NORSCODE_STRICT_DISPATCH_VALUE": "feilbarn",
             "NORSCODE_STRICT_DISPATCH_EXIT": "7"})
        feil_innhald = les_hvis_finst(markør_feil)
    } fang (e) { unntak = tekst(e) }
    // Gjenopprett før assertions, også dersom prosess-ABI-en kastar.
    miljo_sett("NORSCODE_CMD", gammal_cmd)
    miljo_sett("NORSCODE_FILE", gammal_fil)
    miljo_sett("NORSCODE_STRICT_DISPATCH_VALUE", gammal_verdi)
    la rydda_ok = filops.slett_fil(markør_ok)
    la rydda_feil = filops.slett_fil(markør_feil)

    assert_eq(unntak, "")
    assert(rydda_ok og rydda_feil)
    assert(ok)
    assert_eq(ok_innhald, "run\n" + root + "/" + fixture + "\nbarn med mellomrom og æøå\n0\n")
    assert(ikkje feil_barn_ok)
    assert_eq(feil_innhald, "run\n" + root + "/" + fixture + "\nfeilbarn\n7\n")
    assert_eq(selv.env("NORSCODE_CMD"), gammal_cmd)
    assert_eq(selv.env("NORSCODE_FILE"), gammal_fil)
    assert_eq(selv.env("NORSCODE_STRICT_DISPATCH_VALUE"), gammal_verdi)
    skriv("test_verify_selvstendighet_child_dispatch OK\n")
    returner 0
}
