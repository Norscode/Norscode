bruk tools.no_c_python_active_surface som flate
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.tekst som t

// F0.1 på eit lite tre: kvar kategori får positive og negative fiksturar, både
// via filsystem-fallback og via ein syntetisk git-indeks (berre sporte filer,
// òg i build/ og bootstrap/). Fiksturane blir laga i eit mellombels område.

funksjon nul(n: heiltall) -> tekst {
    la ut = ""
    la i = 0
    mens i < n {
        ut = ut + builtin.chr(0)
        i = i + 1
    }
    returner ut
}

funksjon be32(v: heiltall) -> tekst {
    returner builtin.chr((v / 16777216) % 256) + builtin.chr((v / 65536) % 256) +
        builtin.chr((v / 256) % 256) + builtin.chr(v % 256)
}

funksjon indeks_oppføring(sti: tekst, modus: heiltall) -> tekst {
    la e = nul(24) + be32(modus) + nul(32) + builtin.chr((lengde(sti) / 256) % 16) +
        builtin.chr(lengde(sti) % 256) + sti
    la total = ((62 + lengde(sti) + 8) / 8) * 8
    returner e + nul(total - 62 - lengde(sti))
}

funksjon skriv_fil(base: tekst, rel: tekst, innhald: tekst) -> heiltall {
    la delar = builtin.split(rel, "/")
    hvis lengde(delar) > 1 {
        la katalog = base
        la i = 0
        mens i + 1 < lengde(delar) {
            katalog = katalog + "/" + delar[i]
            i = i + 1
        }
        assert(filops.lag_katalogar(katalog))
    }
    fil_skriv(base + "/" + rel, innhald)
    returner 0
}

funksjon har(treff: liste_tekst, prefiks: tekst) -> bool {
    la i = 0
    mens i < lengde(treff) {
        hvis builtin.starts_with(treff[i], prefiks) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon tal_i(treff: liste_tekst, kategori: tekst) -> heiltall {
    returner lengde(flate.treff_i_kategori(treff, kategori))
}

funksjon hex_blob() -> tekst {
    la h = ""
    mens lengde(h) < 128 { h = h + "deadbeef" }
    returner h
}

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "f0flate-")
    assert(temp["status"] == "created")
    la ytre = "build/" + temp["relative"]
    la base = ytre + "/repo"
    assert(filops.lag_katalogar(base))

    // Positive fiksturar.
    skriv_fil(base, "web/app.js", "console.log(1)\n")
    skriv_fil(base, "Makefile", "all:\n\tnc build\n")
    skriv_fil(base, "platform/Main.swift", "import Cocoa\n")
    skriv_fil(base, "bin/verktøy", "#!/usr/bin/env python3\nprint(1)\n")
    skriv_fil(base, "tests/test_kompilat", builtin.chr(127) + "ELF" + builtin.chr(2) + "statisk\n")
    skriv_fil(base, "bootstrap/stage0/norscode-linux-arm64", builtin.chr(127) + "ELF" + builtin.chr(2) + "..../lib/ld-linux-aarch64.so.1\n")
    skriv_fil(base, "selfhost/native_execution/blob.no",
        "funksjon rt_hex_x() { returner \"" + hex_blob() + "\" }\nfunksjon bruk() { la b = hex_to_bytes(rt_hex_x()) }\n")
    skriv_fil(base, "a/modul.ncb.json", "{}")
    skriv_fil(base, "data/konfig.json", "{\"namn\":\"x\"}")
    // Negative fiksturar.
    skriv_fil(base, "std/ok.no", "funksjon start() -> heiltall { returner 0 }\n")
    skriv_fil(base, "bin/ok", "#!/usr/bin/env nc\n")
    skriv_fil(base, "README.md", "Tekst\n#!/bin/bash står ikkje fyrst\n")
    skriv_fil(base, "tests/tekst_utan_ending", "ELF er ikkje magic\n")
    skriv_fil(base, "docs/MZ.txt", "MZ utan PE-signatur\n")
    skriv_fil(base, "bootstrap/stage0/norscode-linux-x86_64", builtin.chr(127) + "ELF" + builtin.chr(2) + "statisk sjølvhosta\n")
    skriv_fil(base, "selfhost/kort_hex.no", "funksjon x() { returner \"" + hex_blob() + "\" }\n")
    skriv_fil(base, "selfhost/native_execution/rein.no", "funksjon y() { returner \"abc\" }\n")
    skriv_fil(base, "archive/gammal.js", "arkiv\n")
    skriv_fil(base, "archive/gammal.json", "{}")
    // Symlenker: godkjend (rett mål), godkjend med feil mål, intern utan godkjenning,
    // og ei som går ut av repoet (laga med ytre som rot, sidan ABI-en nektar flukt).
    skriv_fil(ytre, "utanfor.txt", "utanfor repoet\n")
    assert(runtime_fs.native_erstatt_symbolsk_lenke(base, "nc", "std/ok.no")["status"] == "ok")
    assert(runtime_fs.native_erstatt_symbolsk_lenke(base, "nl", "std/ok.no")["status"] == "ok")
    assert(runtime_fs.native_erstatt_symbolsk_lenke(base, "intern", "README.md")["status"] == "ok")
    assert(runtime_fs.native_erstatt_symbolsk_lenke(ytre, "repo/ut", "../utanfor.txt")["status"] == "ok")
    assert(runtime_fs.native_erstatt_symbolsk_lenke(ytre, "repo/brote", "../finst_ikkje")["status"] == "ok")

    la allow = flate.les_allowlist(
        "tak framandspråk 3\nunntak framandspråk platform/Main.swift\n" +
        "godkjend binær bootstrap/stage0/norscode-linux-x86_64\n" +
        "godkjend symlenke nc -> std/ok.no\n" +
        "godkjend symlenke nl -> ../std/ok.no\n")

    la treff = flate.f0_treff(base, allow)
    la modus = flate.flate_modus(base)
    assert(modus == "filsystem" eller modus == "filsystem-utan-symlenker")

    // (a) framandspråk: tre treff, ingen frå archive/ eller .no/.md.
    assert_eq(tal_i(treff, "framandspråk"), 3)
    assert(har(treff, "framandspråk\tweb/app.js\t"))
    assert(har(treff, "framandspråk\tMakefile\t"))
    assert(har(treff, "framandspråk\tplatform/Main.swift\t"))
    assert(ikkje har(treff, "framandspråk\tarchive/"))
    // (c) shebang: python3-skriptet, ikkje nc-skriptet eller README.
    assert_eq(tal_i(treff, "shebang"), 1)
    assert(har(treff, "shebang\tbin/verktøy\t#!python3"))
    // (d) binær: kompilatet og C-æra-seeden, ikkje den godkjende seeden eller tekstfilene.
    assert_eq(tal_i(treff, "binær"), 2)
    assert(har(treff, "binær\ttests/test_kompilat\telf"))
    assert(har(treff, "binær\tbootstrap/stage0/norscode-linux-arm64\telf"))
    assert(ikkje har(treff, "binær\tbootstrap/stage0/norscode-linux-x86_64"))
    assert_eq(tal_i(treff, "c_æra"), 1)
    assert(har(treff, "c_æra\tbootstrap/stage0/norscode-linux-arm64\telf"))
    // (f) hex: berre i selfhost/native_execution/*.no.
    assert_eq(tal_i(treff, "hex"), 2)
    assert(har(treff, "hex\tselfhost/native_execution/blob.no@rt_hex_x:hexlitteral\t"))
    assert(har(treff, "hex\tselfhost/native_execution/blob.no@bruk:hex_to_bytes\t"))
    // (g) bytekode via J6-innhaldsporten, (h) JSON utan archive/.
    assert_eq(tal_i(treff, "bytekode"), 1)
    assert(har(treff, "bytekode\ta/modul.ncb.json\t"))
    assert_eq(tal_i(treff, "json"), 2)
    assert(ikkje har(treff, "json\tarchive/"))
    // (e) symlenker: godkjend med rett mål tel ikkje; feil mål, ukjend og flukt tel.
    hvis modus == "filsystem" {
        assert_eq(tal_i(treff, "symlenke"), 4)
        assert(ikkje har(treff, "symlenke\tnc\t"))
        assert(har(treff, "symlenke\tnl\tgodkjent mål"))
        assert(har(treff, "symlenke\tintern\t"))
        assert(har(treff, "symlenke\tut\t"))
        assert(har(treff, "symlenke\tbrote\tbrote"))
    } ellers {
        skriv("MERK: stage0 manglar list_typed; symlenkedelen vart hoppa over\n")
    }
    // Ratchet: rapport feilar aldri; ratchet- og hard-modus seier nei.
    assert_eq(flate.f0_brot(treff, allow, "rapport"), 0)
    assert(flate.f0_brot(treff, allow, "ratchet") > 0)
    assert(flate.f0_brot(treff, allow, "hard") >= flate.f0_brot(treff, allow, "ratchet"))
    la r = builtin.join(flate.f0_rapport(treff, allow, "rapport"), "\n")
    assert(t.inneholder(r, "  [unntak] platform/Main.swift"))
    assert(t.inneholder(r, "  [ny] web/app.js"))

    // Sporte filer via syntetisk git-indeks: berre indekserte filer tel, òg i
    // build/ og bootstrap/ (F0.1b), og dei harde sjekkane ser sporte build/-filer.
    la c = builtin.chr(160)
    la byte_eksakt = lengde(c) == 1 og builtin.char_code(builtin.slice(c, 0, 1)) == 160
    la base2 = ytre + "/repo2"
    skriv_fil(base2, "tools/spora.js", "x\n")
    skriv_fil(base2, "tools/utsporta.js", "x\n")
    skriv_fil(base2, "build/spora.inc", "if (x) {}\n")
    skriv_fil(base2, "build/spora.c", "int main(void) { return 0; }\n")
    skriv_fil(base2, "build/generert.c", "int x;\n")
    skriv_fil(base2, "bootstrap/verktøy.sh", "echo spora\n")
    skriv_fil(base2, "bootstrap/lokal.sh", "echo utsporta\n")
    skriv_fil(base2, "std/ok.no", "funksjon start() -> heiltall { returner 0 }\n")
    la oppf = indeks_oppføring("bootstrap/verktøy.sh", 33188) + indeks_oppføring("build/spora.c", 33188) +
        indeks_oppføring("build/spora.inc", 33188) + indeks_oppføring("std/ok.no", 33188) +
        indeks_oppføring("tools/spora.js", 33188)
    la indeks = "DIRC" + be32(2) + be32(5) + oppf
    assert(filops.lag_katalogar(base2 + "/.git"))
    fil_skriv(base2 + "/.git/index", indeks)
    la lest = ""
    prøv { lest = fil_les(base2 + "/.git/index") } fang (e) { lest = "" }
    hvis byte_eksakt og lengde(lest) == lengde(indeks) {
        la treff2 = flate.f0_treff(base2, flate.les_allowlist(""))
        assert_eq(flate.flate_modus(base2), "git-indeks")
        assert_eq(tal_i(treff2, "framandspråk"), 4)
        assert(har(treff2, "framandspråk\ttools/spora.js\t"))
        assert(har(treff2, "framandspråk\tbuild/spora.inc\t"))
        assert(har(treff2, "framandspråk\tbuild/spora.c\t"))
        assert(har(treff2, "framandspråk\tbootstrap/verktøy.sh\t"))
        assert(ikkje har(treff2, "framandspråk\ttools/utsporta.js"))
        assert(ikkje har(treff2, "framandspråk\tbuild/generert.c"))
        assert(ikkje har(treff2, "framandspråk\tbootstrap/lokal.sh"))
        // (b) Harde sjekkar: sporte build/-.c og bootstrap/-.sh blir sett, utsporte ikkje.
        la c_treff = builtin.join(flate.collect_c_hits(base2), "|")
        assert(t.inneholder(c_treff, "/build/spora.c"))
        assert(ikkje t.inneholder(c_treff, "generert.c"))
        la sh_treff = builtin.join(flate.collect_active_shell(base2), "|")
        assert(t.inneholder(sh_treff, "/bootstrap/verktøy.sh"))
        assert(ikkje t.inneholder(sh_treff, "lokal.sh"))
        la sporte = flate.sporte_filer_under(base2, ["build/"], ".c,.h")
        assert_eq(lengde(sporte), 1)
    } ellers {
        skriv("MERK: runtime er ikkje byte-eksakt; git-indeks-delen vart hoppa over\n")
    }

    // Rydd: symlenkene først (slett_tre skal ikkje følgje dei).
    runtime_fs.native_slett(base, "nc")
    runtime_fs.native_slett(base, "nl")
    runtime_fs.native_slett(base, "intern")
    runtime_fs.native_slett(base, "ut")
    runtime_fs.native_slett(base, "brote")
    assert(filops.slett_tre(ytre))
    skriv("test_active_surface_f0_tre OK\n")
    returner 0
}
