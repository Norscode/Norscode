// NorsDB konformanssuite mot SQLite.
// Golden-verdiane er henta ved å køyre NØYAKTIG same SQL mot ekte sqlite3 3.51.0.
// Kvar assert er difor ein plass der NorsDB er verifisert mot SQLite-semantikk.
// Kjende divergensar er merka KONFORMANS-GAP her og spora i
// docs/NORSDB_KONFORMANS_GAP.md — dei asserterer NorsDB si NOVERANDE åtferd slik
// at suiten er grøn; når gapet lukkast vil asserten bryte og minne oss på å
// oppdatere golden til SQLite-verdien.

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")

    // Skjema + data (eksplisitt id, som i sqlite3-fasiten)
    assert_eq(db.execute(h, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')"), 1)

    // ── COUNT / WHERE ────────────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk"), 4)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo'"), 3)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by != 'Oslo'"), 1)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE alder >= 41"), 2)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE id = 99"), 0)

    // ── Aggregat ─────────────────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT SUM(alder) FROM folk"), 162)
    assert_eq(db.query_int(h, "SELECT MIN(alder) FROM folk"), 29)
    assert_eq(db.query_int(h, "SELECT MAX(alder) FROM folk"), 55)
    // KONFORMANS-GAP: sqlite3 gjev 40.5 (REAL); NorsDB gjer heiltalsdivisjon → 40.
    // Fase 1/2 (typer/REAL). Når fiksa: oppdater golden til 40.5 (krev tekst-retur).
    assert_eq(db.query_int(h, "SELECT AVG(alder) FROM folk"), 40)

    // ── ORDER BY + LIMIT/OFFSET ──────────────────────────────────────
    assert_eq(db.query_text(h, "SELECT navn FROM folk ORDER BY alder ASC LIMIT 1"), "Bjørn")
    assert_eq(db.query_text(h, "SELECT navn FROM folk ORDER BY alder DESC LIMIT 1"), "Linus")
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE alder > 40 ORDER BY alder ASC LIMIT 1 OFFSET 1"), "Linus")

    // ── Tekst-likskap / tom mengde ───────────────────────────────────
    assert_eq(db.query_text(h, "SELECT alder FROM folk WHERE navn = 'Alan'"), "41")
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE id = 99"), "")

    // ── Subquery i FROM ──────────────────────────────────────────────
    // sqlite3: rader = Linus, Alan (lagringsrekkjefølgje) → første = Linus
    assert_eq(db.query_text(h, "SELECT navn FROM (SELECT navn, alder, by FROM folk WHERE by = 'Oslo') WHERE alder > 40"), "Linus")

    assert(db.close(h))
    returner 0
}
