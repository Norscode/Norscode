# Regresjon for std/multipart.no (FA-053):
#   - finn tom linje (CRLF CRLF) korrekt mellom part-header og innhald
#     (var broten: leiande CRLF gav header_end=0 → 0 deler)
#   - fleire verdiar per feltnamn (lister)
#   - filopplasting: filnamn, content-type, byte-innhald byte-eksakt (0x00/0xFF)
bruk std.multipart som mp
bruk std.web som web

funksjon start() -> heltall {
    la boundary = "----NorscodeMPTest"
    # Binært filinnhald: A B 0x00 0xFF C D  (6 bytes)
    la binaer = "AB" + builtin.chr(0) + builtin.chr(255) + "CD"
    la body =
        "--" + boundary + "\r\n" +
        "Content-Disposition: form-data; name=\"felt\"\r\n\r\n" +
        "verdi1\r\n" +
        "--" + boundary + "\r\n" +
        "Content-Disposition: form-data; name=\"felt\"\r\n\r\n" +
        "verdi2\r\n" +
        "--" + boundary + "\r\n" +
        "Content-Disposition: form-data; name=\"enkelt\"\r\n\r\n" +
        "berre ein\r\n" +
        "--" + boundary + "\r\n" +
        "Content-Disposition: form-data; name=\"fil\"; filename=\"a.bin\"\r\n" +
        "Content-Type: application/octet-stream\r\n\r\n" +
        binaer + "\r\n" +
        "--" + boundary + "--\r\n"

    la ctx = web.request_context("post", "/u", {}, {"content-type": "multipart/form-data; boundary=" + boundary}, body)
    la parts = mp.parse_form_data(ctx)

    # Alle fire delar skal parsast (tom-linje/CRLF CRLF korrekt)
    assert_eq(lengde(parts), 4)

    # Fleire verdiar per feltnamn (liste)
    la vals = mp.get_values(parts, "felt")
    assert_eq(lengde(vals), 2)
    assert_eq(vals[0], "verdi1")
    assert_eq(vals[1], "verdi2")

    # get_form_fields_multi gjev liste per namn
    la multi = mp.get_form_fields_multi(parts)
    assert_eq(lengde(multi["felt"]), 2)
    assert_eq(lengde(multi["enkelt"]), 1)
    assert_eq(multi["enkelt"][0], "berre ein")

    # Filopplasting: filnamn + content-type
    la f = mp.get_upload_file(parts, "fil")
    assert_eq(f["filename"], "a.bin")
    assert_eq(f["content_type"], "application/octet-stream")

    # Byte-eksakt innhald: lengde 6, byte 2 = 0x00, byte 3 = 0xFF, resten urørt
    la c = f["content"]
    assert_eq(lengde(c), 6)
    assert_eq(builtin.char_code(builtin.slice(c, 0, 1)), 65)   # 'A'
    assert_eq(builtin.char_code(builtin.slice(c, 1, 2)), 66)   # 'B'
    assert_eq(builtin.char_code(builtin.slice(c, 2, 3)), 0)    # 0x00
    assert_eq(builtin.char_code(builtin.slice(c, 3, 4)), 255)  # 0xFF
    assert_eq(builtin.char_code(builtin.slice(c, 4, 5)), 67)   # 'C'
    assert_eq(builtin.char_code(builtin.slice(c, 5, 6)), 68)   # 'D'

    skriv("test_multipart_parse OK\n")
    returner 0
}
