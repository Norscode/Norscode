# M11 — iterator/generator-protokoll. Akseptkriterium: uendeleg generator +
# ta(n). Data-driven, køyrer på seed-runtimen (ingen førsteklasses funksjonar).

bruk std.iterator som it

funksjon sum(xs: liste) -> heiltall {
    la s = 0
    la i = 0
    mens i < lengde(xs) {
        s = s + xs[i]
        i = i + 1
    }
    returner s
}

funksjon start() -> heiltall {
    # Uendeleg generator (0,1,2,...) + ta(5)
    la g = it.teljar(0, 1)
    la fem = it.ta(g, 5)
    assert(lengde(fem) == 5)
    assert(fem[0] == 0)
    assert(fem[4] == 4)
    # ta held fram frå der generatoren stoppa (state varer)
    la neste_tre = it.ta(g, 3)
    assert(neste_tre[0] == 5)
    assert(neste_tre[2] == 7)

    # Uendeleg partals-generator med steg=2, ta(4) → 10,12,14,16
    la p = it.teljar(10, 2)
    la partal = it.ta(p, 4)
    assert(sum(partal) == 52)

    # Endeleg område [0,10) steg 3 → 0,3,6,9
    la r = it.område(0, 10, 3)
    la alle = it.saml(r)
    assert(lengde(alle) == 4)
    assert(alle[3] == 9)

    # Iterator over liste
    la li = it.frå_liste([100, 200, 300])
    assert(it.tel(li) == 3)

    # Iterator over tekst
    la ti = it.frå_tekst("abc")
    la teikn = it.saml(ti)
    assert(lengde(teikn) == 3)
    assert(teikn[0] == "a")

    # ta(n) på ein iterator med færre element enn n stoppar trygt
    la kort = it.frå_liste([1, 2])
    la bad = it.ta(kort, 99)
    assert(lengde(bad) == 2)

    skriv("test_generator OK\n")
    returner 0
}
