bruk std.tekst som t

funksjon start() -> heiltall {
    la main = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(main, "funksjon nc_bygg_native_cli(argv: liste_tekst)"))
    assert(t.inneholder(main, "funksjon nc_bygg_native_køyr_codegen(src_sti: tekst)"))
    assert(t.inneholder(main, "returner host_exec_ncb_json(normaliser_json_kontrollteikn(ncb_json))"))
    assert(t.inneholder(main, "returner nc_bygg_native_cli(argv)"))
    assert(t.inneholder(main, "selfhost/native_execution/macho_arm64_codegen.no"))
    assert(t.inneholder(main, "selfhost/native_execution/native_codegen_v2.no"))
    assert(t.inneholder(main, "selfhost/native_execution/elf_arm64_codegen.no"))
    assert(t.inneholder(main, "native_fs.native_sett_modus_sti(output, 493)"))

    la filer = [
        "tests/test_macho_arm64_aot_cli.no",
        "tests/test_macho_arm64_aot_function_cli.no",
        "tests/test_macho_arm64_aot_stdlib_cli.no",
        "tests/test_macho_arm64_aot_common_runtime.no",
        "tests/test_linux_x86_64_aot_cli.no",
        "tests/test_linux_arm64_aot_cli.no"
    ]
    la i = 0
    mens i < lengde(filer) {
        la src = fil_les(filer[i])
        assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
        assert(ikkje t.inneholder(src, "exec_prosess("))
        assert(ikkje t.inneholder(src, "bin/nc"))
        assert(ikkje t.inneholder(src, "funksjon shell("))
        i = i + 1
    }
    skriv("test_native_build_dispatch_shellfree_contract OK")
    returner 0
}
