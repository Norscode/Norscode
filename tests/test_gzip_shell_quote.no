bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/gzip.no")
    la zip = fil_les("std/zip.no")
    assert(t.inneholder(src, "bruk std.zip som arkiv"))
    assert(t.inneholder(src, "arkiv.gzip_skriv_bytes"))
    assert(t.inneholder(src, "arkiv.gzip_dekomprimer_bytes"))
    assert(t.inneholder(zip, "_tar_crc32"))
    assert(t.inneholder(zip, "kontrollerer både CRC32 og ISIZE"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "gzip -c"))
    assert(ikkje t.inneholder(src, "gzip -dc"))
    assert(ikkje t.inneholder(src, "base64 -d"))
    skriv("test_gzip_shell_quote OK")
    returner 0
}
