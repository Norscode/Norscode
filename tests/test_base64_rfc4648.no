bruk std.base64 som base64
bruk std.krypto som krypto

// Kjent-svar-test: base64 mot RFC 4648 §10-vektorane, pluss round-trip.
//
// std.base64 er den kanoniske reine RFC 4648-implementasjonen (kod/dekod).
// std.krypto.base64_encode/decode prøver den native builtin-base64 og fell
// tilbake på std.base64 når builtin ikkje finst (t.d. i pure VM). Tidlegare
// returnerte krypto-fallbacken inndata UENDRA — altså ukoda/udekoda data
// stille. Denne testen bind både den kanoniske modulen og krypto-fasaden til
// RFC 4648, så fallbacken aldri kan regressere til passthrough igjen.

funksjon _rt_std(klartekst: tekst) {
    assert(base64.dekod(base64.kod(klartekst)) == klartekst)
}

funksjon _rt_krypto(klartekst: tekst) {
    assert(krypto.base64_decode(krypto.base64_encode(klartekst)) == klartekst)
}

funksjon start() -> heiltall {
    // ── Kanonisk std.base64 mot RFC 4648 §10 ──
    assert(base64.kod("") == "")
    assert(base64.kod("f") == "Zg==")
    assert(base64.kod("fo") == "Zm8=")
    assert(base64.kod("foo") == "Zm9v")
    assert(base64.kod("foob") == "Zm9vYg==")
    assert(base64.kod("fooba") == "Zm9vYmE=")
    assert(base64.kod("foobar") == "Zm9vYmFy")

    // Byte-nøyaktig for ikkje-ASCII (UTF-8): "Æ" = 0xC3 0x86 → "w4Y=".
    // Dette er tilfellet e-post MIME encoded-word (std.epost) treng.
    assert(base64.kod("Æ") == "w4Y=")

    // Round-trip (ASCII) via den kanoniske modulen.
    _rt_std("")
    _rt_std("foobar")
    _rt_std("Hello, Norscode 123!")
    _rt_std("a=b&c=d/e+f")

    // ── krypto-fasaden (delegerer til std.base64 utan native builtin) ──
    assert(krypto.base64_encode("foobar") == "Zm9vYmFy")
    // Regresjonsvakt: koding skal ALDRI returnere inndata uendra (passthrough).
    assert(krypto.base64_encode("foobar") != "foobar")

    _rt_krypto("foobar")
    _rt_krypto("Hello, Norscode 123!")
    _rt_krypto("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")

    skriv("test_base64_rfc4648: OK\n")
    returner 0
}
