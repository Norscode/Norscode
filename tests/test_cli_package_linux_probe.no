bruk std.tekst som t

funksjon start() -> heiltall {
    la cli = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(cli, "docker-build-linux"))
    assert(t.inneholder(cli, "bruk: nc docker-build-linux [--output FIL]"))
    assert(t.inneholder(cli, "miljo_sett(\"NORSCODE_DOCKER_BUILD_LINUX_OUTPUT\""))
    assert(t.inneholder(cli, "returner \"tools/docker-build-linux.no\""))
    assert(ikkje t.inneholder(cli, "exec sh"))
    skriv("test_cli_package_linux_probe OK")
    returner 0
}
