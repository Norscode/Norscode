bruk selfhost.native_execution.macho_arm64_codegen som cg
bruk selfhost.native_execution.macho_arm64_emitter som macho
bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon program() {
    returner {"entry": "test.start", "functions": {"test.start": {"params": [], "code": [
        ["PUSH_CONST", 1], ["PUSH_CONST", 1], ["CALL", "builtin.assert_eq", 2], ["RETURN"]
    ]}}}
}
funksjon ulikt_program() {
    la p = program()
    p["functions"]["test.start"]["code"][1] = ["PUSH_CONST", sann]
    returner p
}
funksjon køyr(image, venta: heiltall) -> heiltall {
    la sti = "/tmp/norscode_assert_eq_lowering_" + builtin.random_hex(8)
    macho.skriv_program(sti, image)
    assert_eq(native_fs.native_sett_modus_sti(sti, 493)["status"], "ok")
    la res = prosess.køyr(sti, [], tekst(builtin.system_info()["cwd"]), {}, 30000)
    assert_eq(tekst(res["exit_code"]), tekst(venta))
    hvis venta == 1 { assert(builtin.contains(tekst(res["stdout"]) + tekst(res["stderr"]), "assert_eq feilet:")) }
    builtin.fil_slett(sti)
    returner 0
}
funksjon start() -> heiltall {
    la p = program()
    assert_eq(cg.ncval_normaliser_assert_eq(p)["ok"], "sann")
    assert_eq(p["functions"]["test.start"]["code"][2], ["CALL", "__norscode_assert_eq__", 2])
    la antal = lengde(nøkler(p["functions"]))
    assert_eq(cg.ncval_normaliser_assert_eq(p)["ok"], "sann")
    assert_eq(lengde(nøkler(p["functions"])), antal)
    la kollisjon = program()
    kollisjon["functions"]["__norscode_assert_eq__"] = {"params": [], "code": [["PUSH_CONST", 99], ["RETURN"]]}
    assert_eq(cg.ncval_normaliser_assert_eq(kollisjon)["ok"], "usann")
    assert_eq(kollisjon["functions"]["test.start"]["code"][2][1], "builtin.assert_eq")
    assert_eq(kollisjon["functions"]["__norscode_assert_eq__"]["code"][0][1], 99)
    la heil = cg.ncval_compile_program(program(), "macos")
    assert_eq(heil["ok"], "sann")
    la delar = cg.ncval_compile_program_delar(program(), "macos")
    assert_eq(delar["ok"], "sann")
    la samla = []
    for del i delar["delar"] { for b i del { legg_til(samla, b) } }
    assert_eq(samla, heil["image"])
    la plan = cg.ncval_plan(program())
    assert_eq(plan["ok"], "sann")
    la frags = []
    la flat = []
    la meta = []
    la i = 0
    mens i < lengde(plan["order"]) {
        // Kvar batch les ein fersk graf, slik dei separate arbeidarane gjer.
        la res = cg.ncval_compile_range(program(), "macos", plan["order"], plan["globals"], i, 1)
        assert_eq(res["ok"], "sann")
        for f i res["frags"] {
            legg_til(frags, f)
            legg_til(meta, {"name": f["name"], "base": lengde(flat), "patches": f["patches"]})
            for b i f["words"] { legg_til(flat, b) }
        }
        i = i + 1
    }
    la lenka = cg.ncval_link("macos", frags, plan["globals"])
    assert_eq(lenka["ok"], "sann")
    la flatlenka = cg.ncval_link_flat("macos", flat, meta, plan["globals"])
    assert_eq(flatlenka["ok"], "sann")
    assert_eq(flatlenka["image"], lenka["image"])
    // Fullbygg internerer strengkonstantar; batchplanen bruker direkte konstantar.
    // Køyr begge faktiske image i staden for å krevje identiske byte mellom desse.
    la info = builtin.system_info()
    hvis tekst(info["system"]) == "Darwin" og tekst(info["machine"]) == "arm64" {
        køyr(heil["image"], 0)
        køyr(lenka["image"], 0)
        køyr(flatlenka["image"], 0)
    }
    la negativ = ulikt_program()
    la negativ_heil = cg.ncval_compile_program(negativ, "macos")
    assert_eq(negativ_heil["ok"], "sann")
    la np = cg.ncval_plan(ulikt_program())
    assert_eq(np["ok"], "sann")
    la nr = cg.ncval_compile_range(ulikt_program(), "macos", np["order"], np["globals"], 0, lengde(np["order"]))
    assert_eq(nr["ok"], "sann")
    la nl = cg.ncval_link("macos", nr["frags"], np["globals"])
    assert_eq(nl["ok"], "sann")
    hvis tekst(info["system"]) == "Darwin" og tekst(info["machine"]) == "arm64" {
        køyr(negativ_heil["image"], 1)
        køyr(nl["image"], 1)
    }
    skriv("test_macos_assert_eq_lowering OK\n")
    returner 0
}
