bruk std.wasm_cdp som cdp
bruk std.wasm_nettlesar som benk

funksjon avviser_ramme(data: tekst) -> bool {
    prøv { cdp.ta_ramme({"buffer": data}) } fang (e) { returner builtin.starts_with(tekst(e), "CDP:") }
    returner usann
}
funksjon start() -> heiltall {
    // RFC 6455 sitt konkrete maskeringsdøme, ikkje ein sjølvprodusert fasit.
    assert_eq(cdp.ramme(cdp.teksthex("Hello"), 1, "37fa213d"), "818537fa213d7f9f4d5158")
    assert_eq(cdp.hextekst(cdp.teksthex("blåbær")), "blåbær")
    la c = {"buffer": "81027b"}
    assert(cdp.ta_ramme(c) == null)
    assert_eq(c["buffer"], "81027b")
    c["buffer"] = c["buffer"] + "7d81025b5d"
    la r = cdp.ta_ramme(c)
    assert_eq(r["op"], 1)
    assert(r["fin"])
    assert_eq(cdp.hextekst(r["data"]), "{}")
    assert_eq(cdp.hextekst(cdp.ta_ramme(c)["data"]), "[]")
    assert_eq(c["buffer"], "")
    la data = ""
    la i = 0
    mens i < 126 { data = data + "61" i = i + 1 }
    assert_eq(lengde(cdp.ta_ramme({"buffer": "817e007e" + data})["data"]), 252)
    assert(avviser_ramme("8182")) // Serveren skal ikkje maskere.
    assert(avviser_ramme("c100")) // Ingen forhandla RSV-utviding.
    assert(avviser_ramme("817e007d")) // Ikkje-minimal lengd.
    assert(avviser_ramme("817f0000000100000000")) // Over grensa før payload-allokering.
    assert(avviser_ramme("0900")) // Kontrollrammer kan ikkje fragmenterast.
    la felt = cdp.hovudfelt("HTTP/1.1 101 Switching Protocols\r\nSec-WebSocket-Accept: AbCd\r\nUpgrade: websocket", "101")
    assert_eq(felt["sec-websocket-accept"], "AbCd")
    la handtrykk = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
    assert_eq(cdp.oppgradering(handtrykk, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="), 0)
    la feil_aksept = usann
    prøv { cdp.oppgradering(handtrykk, "S3pPLMBiTxaQ9kYGzzhZRbK+xOo=") }
    fang (e) { feil_aksept = builtin.contains(tekst(e), "ugyldig WebSocket-handtrykk") }
    assert(feil_aksept)
    la duplikat = usann
    prøv { cdp.hovudfelt("HTTP/1.1 200 OK\r\nContent-Length: 2\r\ncontent-length: 3", "200") }
    fang (e) { duplikat = builtin.contains(tekst(e), "tvitydig") }
    assert(duplikat)
    assert(benk.logg_ferdig("ferdig\n", "ferdig"))
    assert(benk.logg_ferdig("lasta\nferdig\n", "ferdig"))
    assert(ikkje benk.logg_ferdig("ikkje ferdig\n", "ferdig"))
    assert(ikkje benk.logg_ferdig("ferdig\netter\n", "ferdig"))
    assert(ikkje benk.logg_ferdig("ferdig", "ferdig"))
    assert(ikkje benk.logg_ferdig("\n", ""))
    skriv("test_wasm_cdp_transport OK\n")
    returner 0
}
