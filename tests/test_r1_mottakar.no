# R1 / F04: metodekall på vilkårlege mottakaruttrykk (self.felt.m(), f().m(),
# l[i].m(), kjeder), for-/fang-variablar og fanga namn i lambda som lokale,
# og CALL_VALUE for kall på eit uttrykksresultat (m["f"](x), f()(x)).
# Køyrer gjennom KJELDE-kompilator + VM. Programmet ligg i
# tests/fixtures/r1_mottakar.no.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/fixtures/r1_mottakar.no")
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "A=100,B=100,C=14,D=4,fluent=12,for=6,lambda=2,fang=MinFeil(m1),indeks=42,kall=15")
    returner 0
}
