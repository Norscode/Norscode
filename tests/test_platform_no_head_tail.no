bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/platform.no")

    assert(t.inneholder(src, "norscode-system-info-v1"))
    assert(t.inneholder(src, "returner builtin.system_info()"))
    assert(t.inneholder(src, "_system_info()[\"total_memory_bytes\"]"))
    assert(t.inneholder(src, "_system_info()[\"cpu_count\"]"))
    assert(t.inneholder(src, "_system_info()[\"executable\"]"))
    assert(t.inneholder(src, "la heim = builtin.miljo_hent(\"HOME\")"))

    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "uname "))
    assert(ikkje t.inneholder(src, "nproc"))
    assert(ikkje t.inneholder(src, "free -m"))

    skriv("test_platform_system_info_abi OK")
    returner 0
}
