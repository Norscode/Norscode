bruk std.tekst som t

funksjon sjekk(sti: tekst) {
    la src = fil_les(sti)
    assert(ikkje builtin.contains(src, "exec_prosess"))
    assert(ikkje builtin.contains(src, "sh -c"))
    assert(ikkje builtin.contains(src, "curl "))
    assert(ikkje builtin.contains(src, "mkdir -p"))
    assert(ikkje builtin.contains(src, "rm -f"))
}

funksjon start() -> heiltall {
    sjekk("tools/cleanup_repo.no")
    sjekk("tools/repository_cleanup.no")
    sjekk("tools/run_bootstrap_literal_probes_v5600.no")
    sjekk("tools/smoke_helpdesk_api.no")
    sjekk("tools/nc_repl.no")
    sjekk("tools/symbol_table_serializer.no")
    sjekk("tools/update_stage0_manifest.no")
    sjekk("tools/test_v795_runtime_gap.no")

    sjekk("tools/process_runner.no")
    sjekk("tools/test_v795_runtime_gap.no")
    assert(ikkje builtin.contains(fil_les("tools/compare_compilers.no"), "exec_prosess"))
    assert(ikkje builtin.contains(fil_les("tools/bootstrap_diff_analyzer.no"), "exec_prosess"))
    assert(ikkje builtin.contains(fil_les("tools/unified_bootstrap_verifier.no"), "exec_prosess"))

    skriv("test_tools_direct_env_process_bindings OK")
    returner 0
}
