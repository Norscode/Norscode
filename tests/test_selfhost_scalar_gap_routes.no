// Native scalar-ruter må ha ekte kjeldefunksjonar i compiler-fragmentmanifestet.
bruk tools.omgang6b_modules som modular
bruk selfhost.native_execution.gap_ruter som gap
bruk selfhost.kompiler som kompiler

funksjon start() -> heiltall {
    la fns = {}
    for spec i modular.spesifikasjonar() {
        la felt = builtin.split(spec, "|")
        hvis felt[1] == "std.sha256" eller felt[1] == "std.desimaltall_tekst" {
            la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(builtin.fil_les(felt[0]), felt[1]))
            for namn i nøkler(ncb["functions"]) { fns[namn] = ncb["functions"][namn] }
        }
    }
    for builtin_namn i ["builtin.sha256", "builtin.sha256_bytes", "builtin.desimaltall"] {
        la funnen = usann
        for mål i gap.gap_rute(builtin_namn) {
            hvis har_nokkel(fns, mål) { funnen = sann }
        }
        hvis ikkje funnen {
            skriv("Manglande kjeldefunksjon for " + builtin_namn + " i compiler-bundlet\n")
            returner 1
        }
    }
    skriv("test_selfhost_scalar_gap_routes OK\n")
    returner 0
}
