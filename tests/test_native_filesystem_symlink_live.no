bruk std.runtime_filesystem som runtime_fs

funksjon start() -> heiltall {
    la rot = runtime_fs.native_tempområde("build", "norscode-symlink-live-")
    assert(rot["status"] == "created")
    la rotrelativ = rot["relative"]
    la rotsti = "build/" + rotrelativ

    assert(runtime_fs.native_lag_mappe(rotsti, "versions/v1")["status"] == "ok")
    assert(runtime_fs.native_lag_mappe(rotsti, "versions/v2")["status"] == "ok")
    builtin.fil_skriv(rotsti + "/versions/v1/value.txt", "generation-one")
    builtin.fil_skriv(rotsti + "/versions/v2/value.txt", "generation-two")

    la første = runtime_fs.native_erstatt_symbolsk_lenke(rotsti, "current", "versions/v1")
    assert(første["status"] == "ok")
    assert(builtin.fil_les(rotsti + "/current/value.txt") == "generation-one")

    la andre = runtime_fs.native_erstatt_symbolsk_lenke(rotsti, "current", "versions/v2")
    assert(andre["status"] == "ok")
    assert(builtin.fil_les(rotsti + "/current/value.txt") == "generation-two")

    assert(runtime_fs.native_lag_mappe(rotsti, "bin")["status"] == "ok")
    la intern = runtime_fs.native_erstatt_symbolsk_lenke(rotsti, "bin/norscode-app", "../current/value.txt")
    assert(intern["status"] == "ok")
    assert(builtin.fil_les(rotsti + "/bin/norscode-app") == "generation-two")

    la flukt = runtime_fs.native_erstatt_symbolsk_lenke(rotsti, "escape", "../outside")
    assert(flukt["status"] == "feil")

    runtime_fs.native_slett(rotsti, "bin/norscode-app")
    runtime_fs.native_slett_mappe(rotsti, "bin")
    runtime_fs.native_slett(rotsti, "current")
    runtime_fs.native_slett(rotsti, "versions/v1/value.txt")
    runtime_fs.native_slett(rotsti, "versions/v2/value.txt")
    runtime_fs.native_slett_mappe(rotsti, "versions/v1")
    runtime_fs.native_slett_mappe(rotsti, "versions/v2")
    runtime_fs.native_slett_mappe(rotsti, "versions")
    runtime_fs.native_slett_mappe("build", rotrelativ)
    skriv("test_native_filesystem_symlink_live OK")
    returner 0
}
