bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la request = {
        "abi": "norscode-native-filesystem-v1",
        "operation": "symlink_replace",
        "root": "/safe/root",
        "relative": "bin/nc",
        "target": "../runtime/nc"
    }
    assert(vm.vm_disk_scope_sti("builtin.filesystem_write_operation", [request]) == "/safe/root")
    assert(vm.vm_disk_scope_sti("builtin.filesystem_read_operation", [request]) == "/safe/root")
    assert(vm.vm_disk_scope_sti("builtin.fil_les", ["/safe/root/file.no"]) == "/safe/root/file.no")
    assert(vm.vm_disk_scope_sti("builtin.filesystem_write_operation", []) == "")
    skriv("test_vm_filesystem_request_scope OK\n")
    returner 0
}
