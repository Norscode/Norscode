// R3 trinn 8 (3.3): returtypen som responsmodell (FastAPI response_model). Eit data-
// svar frå ein handlar med strukturreturtype blir filtrert til felta i strukturen
// (std.modell.filtrer): ukjende felt går ikkje ut, manglande felt med standardverdi
// får han, og «liste<Struktur>» blir filtrert element for element. Respons-ordbøker
// ({status, body, ...}) og handlarar utan strukturreturtype blir ikkje rørte.
bruk std.apptest som t
bruk std.rutebinding som rb
bruk tests.fixtures.r3_signatur_app som fx
bruk tests.fixtures.r3_signatur_meta som m

funksjon test_struktur_retur() -> heltall {
    la kl = m.klient()
    // passord og detaljar er ikkje felt i PersonUt; aktiv får standardverdien.
    assert_eq(t.body_tekst(t.get(kl, "/personar/41", {})), "{\"id\":42,\"namn\":\"Ada\",\"aktiv\":true}")
    // Utan returtype: alt går ut.
    assert_eq(t.body_tekst(t.get(kl, "/ekko/1", {})), "{\"id\":2,\"detaljar\":false}")
    returner 0
}

funksjon test_liste_retur() -> heltall {
    la kl = m.klient()
    la r = t.get(kl, "/personliste?t=1&t=2", {})
    assert_eq(t.body_tekst(r), "[{\"id\":10,\"namn\":\"P\",\"aktiv\":true},{\"id\":20,\"namn\":\"P\",\"aktiv\":true},{\"id\":0,\"namn\":\"utan-merke\",\"aktiv\":true}]")
    returner 0
}

// Det nc serve kallar inne i app-VM-en (std.rutebinding.filtrer_serve).
funksjon test_serve_filter() -> heltall {
    la hent = m.rute("hent_person")
    la ut = rb.filtrer_serve(hent, {"id": 1, "namn": "A", "hemmeleg": "x"})
    assert_eq(lengde(nøkler(ut)), 3)
    assert(ikkje finnes_nøkkel(ut, "hemmeleg"))
    assert(ut["aktiv"] == sann)
    // Ruta utan strukturreturtype: uendra.
    la ek = m.rute("ekko")
    la same = rb.filtrer_serve(ek, {"a": 1})
    assert_eq(same["a"], 1)
    returner 0
}

funksjon start() -> heltall {
    test_struktur_retur()
    test_liste_retur()
    test_serve_filter()
    skriv("test_r3_responsmodell OK\n")
    returner 0
}
