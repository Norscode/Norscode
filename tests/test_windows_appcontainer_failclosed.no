// Negativ regresjon for CRT-fri Windows-runtime.
// Avvis ALLE sandboxprofilar foer CreateProcessW til isolasjon er implementert.
// Dette beviser fail-closed, ikkje fungerande AppContainer.
bruk std.runtime.process_abi som abi

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    la native = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis root == "" eller native == "" {
        skriv("MANGEL: NORSCODE_ROOT/NORSCODE_NATIVE_BIN")
        returner 1
    }
    la profiler: liste_tekst = ["restricted", "no-network", "no-write", "pure"]
    la i: heiltall = 0
    mens i < lengde(profiler) {
        la req = abi.request(native, ["--version"], root, "", 10000, 65536)
        req = abi.sett_sandbox(req, profiler[i], 268435456, 8, usann)
        la resultat = builtin.process_spawn_argv(req)
        assert_eq(tekst(resultat["status"]), "feil")
        assert_eq(builtin.contains(tekst(resultat["error_detail"]), "AppContainer"), sann)
        i = i + 1
    }
    la manglande = abi.request(native, ["--version"], root, "", 10000, 65536)
    fjern_nokkel(manglande, "sandbox")
    la avvist = builtin.process_spawn_argv(manglande)
    assert_eq(tekst(avvist["status"]), "feil")
    assert_eq(builtin.contains(tekst(avvist["error_detail"]), "sandbox"), sann)
    skriv("test_windows_appcontainer_failclosed OK")
    returner 0
}
