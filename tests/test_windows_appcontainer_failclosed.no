// Negativ regresjon for CRT-fri Windows-runtime.
// Avvis ustotta profilar og ugyldige oppsett foer CreateProcessW.
// Fungerande AppContainer/Job Object blir prova i den separate positive testen.
bruk std.runtime.process_abi som abi

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    la native = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis root == "" eller native == "" {
        skriv("MANGEL: NORSCODE_ROOT/NORSCODE_NATIVE_BIN")
        returner 1
    }
    la profiler: liste_tekst = ["no-write", "pure"]
    la i: heiltall = 0
    mens i < lengde(profiler) {
        la req = abi.request(native, ["--version"], root, "", 10000, 65536)
        req = abi.sett_sandbox(req, profiler[i], 268435456, 8, usann)
        la resultat = builtin.process_spawn_argv(req)
        assert_eq(tekst(resultat["status"]), "feil")
        assert_eq(builtin.contains(tekst(resultat["error_detail"]), "AppContainer"), sann)
        i = i + 1
    }
    // Stotta profilar krev eksplisitt arbeidsrot og maa ikkje falle tilbake
    // til usikra spawn naar sikkerheitsoppsettet er ufullstendig.
    for profil i ["restricted", "no-network"] {
        la req = abi.request(native, ["--version"], "", "", 10000, 65536)
        req = abi.sett_sandbox(req, profil, 268435456, 8, usann)
        la resultat = builtin.process_spawn_argv(req)
        assert_eq(tekst(resultat["status"]), "feil")
        assert(builtin.contains(tekst(resultat["error_detail"]), "arbeidsrot"))
    }
    la ukjend = abi.request(native, ["--version"], root, "", 10000, 65536)
    ukjend["sandbox"] = "unknown-policy"
    la ukjend_svar = builtin.process_spawn_argv(ukjend)
    assert_eq(tekst(ukjend_svar["status"]), "feil")
    assert(builtin.contains(tekst(ukjend_svar["error_detail"]), "sandbox"))
    la manglande = abi.request(native, ["--version"], root, "", 10000, 65536)
    fjern_nokkel(manglande, "sandbox")
    la avvist = builtin.process_spawn_argv(manglande)
    assert_eq(tekst(avvist["status"]), "feil")
    assert_eq(builtin.contains(tekst(avvist["error_detail"]), "sandbox"), sann)
    skriv("test_windows_appcontainer_failclosed OK")
    returner 0
}
