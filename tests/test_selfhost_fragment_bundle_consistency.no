// Dei to byggjarane og chunk-vegen skal bevare alle manifestmodulane byte-likt.
bruk tools.omgang6b_modules som modular
bruk tools.build_omgang6b_compiler_ncb som byggjar
bruk selfhost.elf_compile_driver som drivar
bruk std.runtime.process_abi som abi

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/fragment_bundle_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(base + "/fragments")
    builtin.mkdir_p(base + "/chunks")
    la specs = modular.spesifikasjonar()
    la indeks = 0
    for spec i specs {
        la felt = builtin.split(spec, "|")
        la fns = {}
        fns[felt[1] + ".fragment_probe"] = {"name": "fragment_probe", "module": felt[1],
            "params": [], "code": [["PUSH_CONST", indeks], ["RETURN"]]}
        la json = builtin.json_skriv(fns)
        builtin.fil_skriv(base + "/fragments/" + felt[2] + ".functions.json",
            builtin.slice(json, 1, lengde(json) - 1))
        builtin.fil_skriv(base + "/fragments/" + felt[2] + ".metadata.json",
            "{\"module_initializers\":[],\"global_names\":{}}")
        indeks = indeks + 1
    }
    assert(byggjar.bygg_frå_fragment(base + "/fragments", base + "/tools.ncb.json"))
    la før = miljo_hent("NORSCODE_OMGANG6B_FRAGMENT_DIR")
    miljo_sett("NORSCODE_OMGANG6B_FRAGMENT_DIR", base + "/fragments")
    drivar.bygg_omgang6b_bundle(base + "/driver.ncb.json")
    miljo_sett("NORSCODE_OMGANG6B_FRAGMENT_DIR", før)
    la venta = builtin.fil_les(base + "/tools.ncb.json")
    assert_eq(builtin.fil_les(base + "/driver.ncb.json"), venta)
    la ncb = builtin.json_parse_raw(venta)
    assert_eq(lengde(nøkler(ncb["functions"])), lengde(specs))
    indeks = 0
    for spec i specs {
        la felt = builtin.split(spec, "|")
        assert_eq(ncb["functions"][felt[1] + ".fragment_probe"]["code"][0][1], indeks)
        indeks = indeks + 1
    }

    la req = abi.request(root + "/dist/norscode_native", [], root, "", 180000, 65536)
    abi.sett_sandbox(req, "none", 0, 64, usann)
    abi.sett_environment(req, {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/selfhost/elf_compile_driver.no",
        "NORSCODE_BUNDLE_ARGS": "manifest", "NORSCODE_BUNDLE_OUTPUT_DIR": base + "/chunks",
        "NORSCODE_OMGANG6B_FRAGMENT_DIR": base + "/fragments",
        "NORSCODE_VM_FAST": "1", "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    })
    la res = builtin.process_spawn_argv(req)
    skriv(tekst(res["stdout"]))
    skriv(tekst(res["stderr"]))
    assert_eq(res["status"], "ferdig")
    assert_eq(heltall_fra_tekst(res["exit_code"]), 0)
    la samla = ""
    indeks = 0
    mens indeks < lengde(specs) + 2 {
        samla = samla + builtin.fil_les(base + "/chunks/part_" + drivar.tekst_med_nuller(indeks, 3) + ".json")
        indeks = indeks + 1
    }
    assert_eq(samla, venta)
    skriv("test_selfhost_fragment_bundle_consistency OK\n")
    returner 0
}
