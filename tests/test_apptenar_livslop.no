# apptenar-livsløp i ein barne-`nc run` (same oppsett som test_apptenar_integrasjon):
# oppstartkrok før lyttinga, og app.stopp() drenerer i staden for å kutte:
#   - ein påbyrja førespurnad (berre halve hovudet sendt før stopp) får svar,
#   - nye tilkoplingar blir avviste (lytte-socketen er lukka),
#   - avslutningskroken køyrer, og prosessen avsluttar med 0.
# Før: ingen krokar i apptenar, og stopp() lukka alle tilkoplingar med ein gong.
# SIGTERM (exit 143) er ikkje dekt: VM-en kan ikkje sjå ventande signal (seed).
bruk tests.fixtures.apptenar_hjelp som ah
bruk std.socket som socket

funksjon start() -> heltall {
    la data = ah.ny_datamappe("livslop")
    la app = ah.start_app("tests/fixtures/apptenar_livslop_app.no", data, {})
    hvis app["status"] != "kjorer" {
        skriv("apptenaren starta ikkje:\n" + tekst(app["ut"]) + "\n")
        assert(usann)
    }
    la h = app["h"]
    la port = app["port"]
    assert(builtin.index_of(app["ut"], "KROK oppstart") >= 0)

    # B: halv førespurnad før stopp.
    la b = ah.koble(port)
    ah.send(b, "GET /hei HTTP/1.1\r\nHost: 127.0.0.1\r\n")
    socket.native_poll_vent(b, 1, 200)

    # A: stopp.
    la r = ah.kall(port, "POST", "/stopp", {}, "")
    assert_eq(r["status"], 200)
    assert_eq(r["body"], "stoppar")
    socket.native_poll_vent(b, 1, 300)

    # Nye tilkoplingar blir avviste under drenering.
    la c = socket.native_tilkoble("127.0.0.1", port)
    la avvist = c["status"] != "connected"
    hvis ikkje avvist {
        ah.send(c, "GET /hei HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
        la rc = ah.les_svar(c, "", usann, 1500)
        avvist = ikkje rc["ok"]
        socket.native_lukk(c)
    }
    assert(avvist)

    # B fullfører førespurnaden og får svar, deretter blir tilkoplinga lukka.
    ah.send(b, "\r\n")
    la rb = ah.les_svar(b, "", usann, 5000)
    assert_eq(rb["status"], 200)
    assert_eq(rb["body"], "hei")
    assert(ah.lukka_innan(b, 3000))
    socket.native_lukk(b)

    # Prosessen avsluttar sjølv med 0 etter avslutningskroken.
    assert_eq(ah.vent_slutt(h, 10000), 0)
    la logg = app["ut"] + ah.les_ut(h)
    assert(builtin.index_of(logg, "APPTENAR stoppar") >= 0)
    assert(builtin.index_of(logg, "KROK avslutning") >= 0)
    assert(builtin.index_of(logg, "APPTENAR stoppa") >= 0)
    ah.stopp(h)
    skriv("test_apptenar_livslop OK\n")
    returner 0
}
