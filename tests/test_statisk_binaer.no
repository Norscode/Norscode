// std.statisk skal levere binære filer (PNG, woff2) byte for byte.
// Tidlegare kalla statisk.serve den uregistrerte funksjonen fil_les_bytes og feila ved køyring.
bruk std.statisk som statisk
bruk selfhost.http_response som http

funksjon start() -> heiltall {
    la mappe = "build/test-statisk-binaer"
    // Testmappa finst ikkje på ein rein runner (berre build/ finst); lag ho før skriv.
    prøv { builtin.mkdir(mappe) } fang (e) {}
    la venta = builtin.bytes_from_list([137, 80, 78, 71, 13, 10, 26, 10])
    builtin.fil_skriv_binær(mappe + "/bilde.png", venta)

    // Vanleg GET på ei binær fil.
    la ctx = {"__path__": "/assets/bilde.png", "__headers__": {}, "__query__": {}, "__method__": "get"}
    la svar = statisk.serve(ctx, mappe, "/assets/")
    assert(tekst(svar["status"]) == "200")
    la body = svar["body"]
    assert(type(body) == "bytes")
    assert(lengde(body) == 8)
    assert(builtin.bytes_to_list(body)[0] == 137)
    la h = svar["headers"]
    assert(h["content-type"] == "image/png")
    assert(builtin.starts_with(h["cache-control"], "public, max-age="))
    assert(h["etag"] != "")

    // Gjennom HTTP-serialiseringa: rett Content-Length og bytane uendra.
    la hovud = http.response_to_http(svar)
    assert(builtin.contains(hovud, "Content-Length: 8\r\n"))
    assert(builtin.contains(hovud, "content-type: image/png\r\n"))
    la ut = http.response_body_bytes(svar)
    assert(ut != null og lengde(ut) == 8)

    // ETag-treff gjev 304 utan body.
    la ctx304 = {"__path__": "/assets/bilde.png", "__headers__": {"if-none-match": h["etag"]}, "__query__": {}, "__method__": "get"}
    la svar304 = statisk.serve(ctx304, mappe, "/assets/")
    assert(tekst(svar304["status"]) == "304")
    assert(http.response_body_bytes(svar304) == null)

    // Utanfor prefiks og path traversal.
    la ikkje_statisk = statisk.serve({"__path__": "/api/x", "__headers__": {}, "__query__": {}, "__method__": "get"}, mappe, "/assets/")
    assert(tekst(ikkje_statisk["status"]) != "200")
    la traversal = statisk.serve({"__path__": "/assets/../bilde.png", "__headers__": {}, "__query__": {}, "__method__": "get"}, mappe, "/assets/")
    assert(tekst(traversal["status"]) == "403")

    skriv("test_statisk_binaer OK\n")
    returner 0
}
