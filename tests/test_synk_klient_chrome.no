# W9: synk-klienten i Chrome ende til ende (examples/wasm_synk/klient.no via testklienten
# tests/fixtures/synk_klient_testklient.no) mot ein barne-apptenar med NSP/1 (testappen
# tests/fixtures/synk_klient_testapp.no). Chrome-stega er VALFRIE (SKIP utan Chrome; NC_CHROME=<sti>).
#
# Alltid: testklienten blir bygd og validert med synk-gruppa, nett og lagring.
# Med Chrome (same profil «a» med mindre anna står):
#   steg=1   fersk profil: optimistisk skriving vist før tenaren svarar, synka; ei endring frå
#            ei anna eining kjem via SSE; «Hugs denne eininga» (IndexedDB); ny oppgåve og
#            «ferdig» synka
#   steg=2   omlasting: kopien frå IndexedDB og tenaren; sida stoppar tenaren; ei skriving utan
#            nett blir vist og står i køa (offline, 1 ventar)
#   — testen startar tenaren att (same data og port) —
#   steg=3   køa blir send: alle fire oppgåvene synka
#   steg=3b  fersk profil «b» (ei anna eining): same fire oppgåver (konvergens)
# Ingen lasting har «Uncaught». Loggen blir samanlikna med fasiten linje for linje.
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.apptenar_hjelp som ah
bruk tests.fixtures.synk_klient_chrome_hjelp som ch

funksjon utmappe() -> tekst { returner "build/wasm/test_synk_chrome/testbygg" }

funksjon port() -> tekst { returner "48631" }

funksjon fasit_1() -> tekst {
    returner ch.linjer(["steg 1",
        "start: Alt er synka. | – | []",
        "optimistisk: 1 endring ventar på tenaren. | 1 oppgåve | [Kjøp mjølk*]",
        "synka: Alt er synka. | 1 oppgåve | [Kjøp mjølk]",
        "sse (sann): Alt er synka. | 2 oppgåver | [Anna-eining, Kjøp mjølk]",
        "hugs: Oppgåvene er lagra på eininga. aria-pressed=sann",
        "veksla: Alt er synka og lagra på eininga. | 3 oppgåver | [Anna-eining✓, Kjøp mjølk, Ring Åse]",
        "ferdig"])
}

funksjon fasit_2() -> tekst {
    returner ch.linjer(["steg 2",
        "omlasta: Alt er synka og lagra på eininga. | 3 oppgåver | [Anna-eining✓, Kjøp mjølk, Ring Åse]",
        "optimistisk: 1 endring ventar på tenaren. | 4 oppgåver | [Anna-eining✓, Kjøp mjølk, Ring Åse, Utan nett*]",
        "offline: Utan nett: 1 endring ventar og blir sende når nettet er tilbake. | 4 oppgåver | [Anna-eining✓, Kjøp mjølk, Ring Åse, Utan nett*]",
        "ferdig"])
}

funksjon fasit_3(namn: tekst, lagra: bool) -> tekst {
    la status = "Alt er synka."
    hvis lagra { status = "Alt er synka og lagra på eininga." }
    returner ch.linjer(["steg " + namn,
        "tilbake: " + status + " | 4 oppgåver | [Anna-eining✓, Kjøp mjølk, Ring Åse, Utan nett]",
        "ferdig"])
}

funksjon start() -> heltall {
    ch.bygg(utmappe())
    hvis benk.finn_chrome() == "" {
        skriv("test_synk_klient_chrome OK (bygg; SKIP Chrome: fann ikkje Chrome/Chromium, set NC_CHROME=<sti>)\n")
        returner 0
    }
    la økt = benk.ny_økt("test_synk_chrome")
    la data = ah.ny_datamappe("synk-chrome")
    la app = ch.start_tenar(utmappe(), data, port())
    utsett {
        ah.stopp(app["h"])
        benk.rydd(økt)
    }
    la r1 = ch.last(økt, port(), "/test?steg=1&u=u1", "a")
    ch.krev_logg("steg 1 (fersk profil, SSE, hugs)", r1, fasit_1())
    la r2 = ch.last(økt, port(), "/test?steg=2", "a")
    ch.krev_logg("steg 2 (omlasting og offline)", r2, fasit_2())
    # Sida stoppa tenaren i steg 2
    assert(ikkje ah.køyrer(app["h"]))
    skriv("steg 1–2: optimistisk skriving, SSE frå ei anna eining, hugs; omlasting frå IndexedDB og skriving utan nett i køa (" +
        tekst(r1["ms"]) + " + " + tekst(r2["ms"]) + " ms)\n")
    app = ch.start_tenar(utmappe(), data, port())
    la r3 = ch.last(økt, port(), "/test?steg=3&u=u1", "a")
    ch.krev_logg("steg 3 (tenaren er tilbake)", r3, fasit_3("3", sann))
    la r3b = ch.last(økt, port(), "/test?steg=3b&u=u1", "b")
    ch.krev_logg("steg 3b (ei anna eining)", r3b, fasit_3("3b", usann))
    skriv("steg 3: køa frå eininga vart send etter omstarten, og ei anna eining såg same fire oppgåver\n")
    skriv("test_synk_klient_chrome OK\n")
    returner 0
}
