bruk tools.install_linux_desktop_entry_core som installer
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la temp = runtime_fs.native_tempområde("build", "desktop-install-")
    assert(temp["status"] == "created")
    la base = root + "/build/" + temp["relative"]
    la appdir = base + "/Norscode.AppDir"
    la prefix = base + "/share"
    la desktop_dir = appdir + "/usr/share/applications"
    la icon_dir = appdir + "/usr/share/icons/hicolor/256x256/apps"
    assert(filops.lag_katalogar(desktop_dir))
    assert(filops.lag_katalogar(icon_dir))
    builtin.fil_skriv(desktop_dir + "/Norscode.desktop",
        "[Desktop Entry]\nType=Application\nName=Norscode\nExec=old\nIcon=norscode\n")
    builtin.fil_skriv_binær(icon_dir + "/norscode.png", builtin.bytes_from_list([137, 80, 78, 71]))

    assert(installer.installer(appdir, prefix, root) == 0)
    la desktop = builtin.fil_les(prefix + "/applications/Norscode.desktop")
    assert(builtin.index_of(desktop, "Exec=" + appdir + "/AppRun") >= 0)
    assert(builtin.fil_les_binær(prefix + "/icons/hicolor/256x256/apps/norscode.png") ==
           builtin.bytes_from_list([137, 80, 78, 71]))
    assert(filops.slett_tre(base))
    skriv("test_install_linux_desktop_entry_native_live OK")
    returner 0
}
