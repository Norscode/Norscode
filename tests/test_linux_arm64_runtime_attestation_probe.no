// Avgrensa, men levande ARM64-probe for den historiske committed stage0-VM-en.

bruk std.runtime_filesystem som fs
bruk std.runtime.process_abi som process_abi
bruk std.socket som socket
bruk std.sched som sched
bruk std.tls_http som tls

funksjon start() -> heiltall {
    la fil = fs.opne_native("build", "linux-arm64-attestation.txt", "write")
    assert_eq(fil["status"], "open")
    assert_eq(fs.native_skriv(fil, "arm64")["status"], "ok")
    assert_eq(fs.native_lukk(fil)["status"], "closed")
    assert_eq(fs.native_slett("build", "linux-arm64-attestation.txt")["status"], "deleted")

    la req = process_abi.request("/usr/bin/printf", ["arm64-process"], "", "", 5000, 4096)
    process_abi.sett_sandbox(req, "no-network", 268435456, 32, usann)
    la prosess = builtin.process_spawn_argv(req)
    assert_eq(prosess["status"], "ferdig")
    assert_eq(heltall_fra_tekst(prosess["exit_code"]), 0)
    assert_eq(prosess["stdout"], "arm64-process")
    assert_eq(prosess["sandbox_backend"], "seccomp")

    la tråd = builtin.thread_spawn({"abi": "norscode-native-thread-v1", "operation": "spawn",
        "fn": "thread.noop", "args": {}, "name": "arm64-attestation", "stack_bytes": "65536"})
    assert_eq(tråd["status"], "started")
    la ferdig = builtin.thread_join({"abi": "norscode-native-thread-v1", "operation": "join",
        "handle": tråd["handle"], "thread_id": tråd["thread_id"], "timeout_ms": "5000"})
    assert_eq(ferdig["status"], "finished")

    assert_eq(builtin.argon2id("password", "somesalt", 65536, 2, 1, 32),
        "09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7")

    la server = tls.ny_secure_server(0, tls.load_cert_file("tests/fixtures/tls/localhost.crt"),
        tls.load_key_file("tests/fixtures/tls/localhost.key"))
    assert_eq(tls.lytt_secure(server), 0)
    la listener = server["listener"]
    assert_eq(listener["event_backend"], "epoll")
    la client = socket.native_tls_tilkoble("127.0.0.1", heltall_fra_tekst(listener["port"]),
        "localhost", "tests/fixtures/tls/localhost.crt")
    assert(client["status"] != "feil")
    la accept_loop = sched.ny()
    la accept_future = socket.native_accept_async(accept_loop, listener, 30000)
    assert(sched.run(accept_loop, 30000) >= 1)
    la peer = sched.future_resultat(accept_loop, accept_future)
    la hs = sched.ny()
    la client_future = socket.native_tls_handshake_async(hs, client, 30000)
    la server_future = socket.native_tls_handshake_async(hs, peer, 30000)
    assert(sched.run(hs, 30000) >= 2)
    assert_eq(sched.future_status(hs, client_future), "ferdig")
    assert_eq(sched.future_status(hs, server_future), "ferdig")
    assert_eq(sched.future_resultat(hs, client_future)["tls_version"], "TLSv1.3")
    assert_eq(sched.future_resultat(hs, client_future)["peer_verified"], sann)
    socket.native_lukk(client)
    socket.native_lukk(peer)
    assert(tls.lukk_secure(server))
    skriv("test_linux_arm64_runtime_attestation_probe OK\n")
    returner 0
}
