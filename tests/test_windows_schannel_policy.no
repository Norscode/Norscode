// Denne policygrensa er portabel; sjølve SSPI-handtrykket blir attestert av
// test_windows_schannel_client på ein ekte Windows-runner.
bruk std.windows_schannel som schannel
bruk std.windows_network som network

funksjon start() -> heiltall {
    assert_eq(schannel.request_error({"hostname": "example.com", "ca_file": ""}), "")
    assert_eq(schannel.request_error({"hostname": "example.com", "verify_peer": sann,
        "verify_hostname": sann}), "")
    assert(schannel.request_error({"hostname": ""}) != "")
    assert(schannel.request_error({"hostname": "example.com\u0000other.example"}) != "")
    assert(schannel.request_error({"hostname": "example.com", "verify_peer": usann}) != "")
    assert(schannel.request_error({"hostname": "example.com", "verify_hostname": "0"}) != "")
    assert(schannel.request_error({"hostname": "example.com", "require_ocsp": "1"}) != "")
    assert(schannel.request_error({"hostname": "example.com", "require_client_cert": sann}) != "")
    la requested = ["ca_file", "ca_path", "crl_file", "client_crl_file", "client_ca_file",
        "cert_file", "key_file", "client_cert_file", "client_key_file",
        "client_certificate_subject", "certificate_subject", "ocsp_response_file"]
    la i: heiltall = 0
    mens i < lengde(requested) {
        la req = {"hostname": "example.com"}
        req[requested[i]] = "requested-policy"
        assert(schannel.request_error(req) != "")
        i = i + 1
    }
    assert_eq(network.operation(null)["status"], "feil")
    assert_eq(network.operation({"abi": "unrecognized-network-abi"})["status"], "feil")
    skriv("test_windows_schannel_policy OK")
    returner 0
}
