bruk std.tekst som t

funksjon start() -> heiltall {
    la pure = fil_les("std/argon2id_pure.no")
    la api = fil_les("std/argon2id.no")
    assert(t.inneholder(pure, "bruk std.blake2b som blake"))
    assert(t.inneholder(pure, "funksjon konstanttid_lik"))
    assert(t.inneholder(pure, "mens i < maks"))
    assert(t.inneholder(pure, "diff = diff | (ca ^ cb)"))
    assert(t.inneholder(api, "returner pure.hash_pure"))
    assert(t.inneholder(api, "returner pure.konstanttid_lik"))
    assert(t.inneholder(api, "funksjon hash_native_adapter"))
    skriv("test_argon2id_pure_contract OK")
    returner 0
}
