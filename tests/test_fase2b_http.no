# Fase 2 bølgje (b) / 2.8: chunked-dekoding + header-oppslag.
#
# RESEED-GATED: importerer selfhost.nc_main og kallar dekod_chunked /
# serve_header_verdi direkte. Logikken er lokalt stadfesta via eit frittståande
# utdrag (scratchpad/t28.no, grøn på committa seed).

bruk selfhost.nc_main

funksjon sjekk(n: tekst, a: tekst, b: tekst) {
    hvis a != b { kast "FEIL " + n + ": '" + a + "' != '" + b + "'" }
}

funksjon start() -> heltall {
    # Klassisk chunked-eksempel.
    la r = dekod_chunked("4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")
    sjekk("ok", tekst(r["status"]), "ok")
    sjekk("data", tekst(r["data"]), "Wikipedia")

    # Chunk-extensions etter ';'.
    sjekk("ext", tekst(dekod_chunked("3;a=b\r\nabc\r\n0\r\n\r\n")["data"]), "abc")
    # Ufullstendig → kallaren må lese meir.
    sjekk("incomplete", tekst(dekod_chunked("4\r\nWik")["status"]), "ufullstendig")
    # Ugyldig storleik → avvis (400).
    sjekk("bad", tekst(dekod_chunked("zz\r\nabc\r\n")["status"]), "ugyldig")

    # Header-oppslag (case-insensitiv).
    la raw = "POST /x HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\nbody"
    sjekk("te", builtin.lower(serve_header_verdi(raw, "transfer-encoding")), "chunked")
    sjekk("cl", serve_header_verdi(raw, "content-length"), "5")
    sjekk("absent", serve_header_verdi(raw, "x-mangler"), "")

    skriv("test_fase2b_http OK\n")
    returner 0
}
