// test_tensor_handtak.no — vedvarande vekter i norscode-tensor-v1 (last_opp /
// matmul_i32 med left_handle / frigjer). Ei venstre-matrise blir validert og pakka éin
// gong; seinare kall pakkar berre høgre-sida. Resultatet skal vere bit-likt vanleg
// matmul_i32 og skalar referanse. På ein seed utan funksjonen (status utan
// persistent_weights) hoppar testen over seg sjølv; seed-porten køyrer han på kandidaten.

funksjon like(a, b) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i: heiltall = 0
    mens i < lengde(a) { hvis a[i] != b[i] { returner usann } i = i + 1 }
    returner sann
}

funksjon referanse(l, r, rader: heiltall, inner: heiltall, kolonner: heiltall) {
    la ut = []
    la i: heiltall = 0
    mens i < rader {
        la c: heiltall = 0
        mens c < kolonner {
            la sum: heiltall = 0
            la k: heiltall = 0
            mens k < inner { sum = sum + l[i * inner + k] * r[k * kolonner + c] k = k + 1 }
            legg_til(ut, sum)
            c = c + 1
        }
        i = i + 1
    }
    returner ut
}

funksjon lcg_liste(n: heiltall, frø: heiltall, spenn: heiltall) {
    la ut = []
    la x: heiltall = frø
    la i: heiltall = 0
    mens i < n {
        x = (x * 1103515245 + 12345) % 2147483648
        legg_til(ut, x % (2 * spenn + 1) - spenn)
        i = i + 1
    }
    returner ut
}

funksjon op(o: tekst) {
    returner {"abi": "norscode-tensor-v1", "operation": o}
}

funksjon start() -> heiltall {
    la st = builtin.tensor_operation(op("status"))
    hvis ikkje finnes_nøkkel(st, "persistent_weights") {
        skriv("test_tensor_handtak: hoppa over (kjernen i denne seeden har ikkje vedvarande vekter)\n")
        returner 0
    }
    assert(st["persistent_weights"] == sann)
    la start_tal = st["handles"]

    // 1. Same svar som vanleg matmul og skalar referanse, med odde inner (padding) og int16-endepunkt.
    la rader: heiltall = 37
    la inner: heiltall = 29
    la l = lcg_liste(rader * inner, 7, 32767)
    l[0] = 0 - 32768
    l[1] = 32767
    la req = op("last_opp")
    req["left"] = l
    req["rows"] = rader
    req["inner"] = inner
    la h = builtin.tensor_operation(req)
    assert_eq(h["status"], "ferdig")
    la handtak = h["handle"]
    la k: heiltall = 1
    mens k <= 3 {
        la r = lcg_liste(inner * k, 100 + k, 32767)
        la m = op("matmul_i32")
        m["left_handle"] = handtak
        m["right"] = r
        m["columns"] = k
        la a = builtin.tensor_operation(m)
        assert_eq(a["status"], "ferdig")
        la v = op("matmul_i32")
        v["left"] = l
        v["right"] = r
        v["rows"] = rader
        v["inner"] = inner
        v["columns"] = k
        la b = builtin.tensor_operation(v)
        assert(like(a["data"], b["data"]))
        assert(like(a["data"], referanse(l, r, rader, inner, k)))
        k = k + 1
    }

    // 2. Over den gamle grensa på 4096 rader (t.d. lm_head med 32 000 token).
    la stor_r: heiltall = 10000
    la stor_i: heiltall = 16
    la ls = lcg_liste(stor_r * stor_i, 11, 20000)
    la rq = op("last_opp")
    rq["left"] = ls
    rq["rows"] = stor_r
    rq["inner"] = stor_i
    la hs = builtin.tensor_operation(rq)
    assert_eq(hs["status"], "ferdig")
    la x = lcg_liste(stor_i * 2, 5, 32767)
    la ms = op("matmul_i32")
    ms["left_handle"] = hs["handle"]
    ms["right"] = x
    ms["columns"] = 2
    la svar = builtin.tensor_operation(ms)
    assert_eq(svar["status"], "ferdig")
    assert_eq(svar["rows"], stor_r)
    assert(like(svar["data"], referanse(ls, x, stor_r, stor_i, 2)))

    // 3. Feil: ukjent handtak, feil form, grenser, int16, og frigjort handtak.
    la f = op("matmul_i32")
    f["left_handle"] = "tensor-finst-ikkje"
    f["right"] = [1]
    f["columns"] = 1
    assert_eq(builtin.tensor_operation(f)["error"], "unknown or freed tensor handle")
    la g = op("matmul_i32")
    g["left_handle"] = handtak
    g["right"] = [1, 2, 3]
    g["columns"] = 1
    assert_eq(builtin.tensor_operation(g)["error"], "tensor shape mismatch")
    g["right"] = lcg_liste(inner, 1, 10)
    g["rows"] = rader + 1
    assert_eq(builtin.tensor_operation(g)["error"], "tensor shape mismatch")
    la gr = op("matmul_i32")
    gr["left_handle"] = handtak
    gr["right"] = [1]
    gr["columns"] = 5000
    assert_eq(builtin.tensor_operation(gr)["error"], "tensor limits exceeded")
    la ug = op("last_opp")
    ug["left"] = [40000]
    ug["rows"] = 1
    ug["inner"] = 1
    assert_eq(builtin.tensor_operation(ug)["error"], "left value outside int16 range")
    la fm = op("last_opp")
    fm["left"] = [1, 2, 3]
    fm["rows"] = 2
    fm["inner"] = 2
    assert_eq(builtin.tensor_operation(fm)["error"], "tensor shape mismatch")
    la fr = op("frigjer")
    fr["handle"] = handtak
    assert_eq(builtin.tensor_operation(fr)["status"], "ferdig")
    la etter = op("matmul_i32")
    etter["left_handle"] = handtak
    etter["right"] = lcg_liste(inner, 2, 10)
    etter["columns"] = 1
    assert_eq(builtin.tensor_operation(etter)["error"], "unknown or freed tensor handle")
    assert_eq(builtin.tensor_operation(fr)["error"], "unknown or freed tensor handle")
    la fs = op("frigjer")
    fs["handle"] = hs["handle"]
    builtin.tensor_operation(fs)
    assert_eq(builtin.tensor_operation(op("status"))["handles"], start_tal)

    skriv("test_tensor_handtak OK\n")
    returner 0
}
