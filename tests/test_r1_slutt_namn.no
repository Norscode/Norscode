# R1: `slutt` som vanleg variabelnamn i klammesyntaks. `returner slutt + 4`
# returnerte tidlegare ingenting fordi parse_returner tolka `slutt` som
# blokkslutt (gammal syntaks). I slutt-blokker er åtferda uendra.
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    la p_klamme = "funksjon h2(s: tekst) -> heiltall {\n" +
        "    la slutt = builtin.index_of(s, \"K\")\n" +
        "    returner slutt + 4\n" +
        "}\n" +
        "funksjon h3(s: tekst) -> heiltall {\n" +
        "    la slutt = lengde(s)\n" +
        "    hvis slutt > 2 { returner slutt }\n" +
        "    returner 0\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    returner tekst(h2(\"abcK\")) + \",\" + tekst(h3(\"abcd\"))\n" +
        "}\n"
    assert_eq(utfor(p_klamme), "7,4")

    # Gammal syntaks: `returner sann slutt` og `returner slutt` (tom retur) i
    # ei eittlinjes slutt-blokk, også inne i ein klammefunksjon.
    la p_gamal = "funksjon g(x)\n" +
        "    hvis x == 1 returner \"ein\" slutt\n" +
        "    hvis x == 2 returner slutt\n" +
        "    returner \"anna\"\n" +
        "slutt\n" +
        "funksjon k(x) {\n" +
        "    hvis x == 2 returner slutt\n" +
        "    returner \"k\"\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    returner g(1) + \",\" + tekst(g(2) == ingenting) + \",\" + g(3) + \",\" + tekst(k(2) == ingenting) + k(1)\n" +
        "}\n"
    assert_eq(utfor(p_gamal), "ein,sann,anna,sannk")
    returner 0
}
