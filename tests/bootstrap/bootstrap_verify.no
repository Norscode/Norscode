// tests/bootstrap/bootstrap_verify.no — deterministisk bootstrap-verifisering

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon sha256_for(sti: tekst) -> tekst {
    returner builtin.sha256_bytes(builtin.fil_les_binær(sti))
}

funksjon bygg_compiler(root: tekst, mål: tekst) -> boolsk {
    la resultat = prosess.køyr(root + "/bin/bootstrap",
        ["compile", root + "/selfhost/kompiler.no", mål],
        root, {}, 600000)
    hvis ikkje prosess.ok(resultat) {
        prosess.skriv_resultat(resultat)
        returner usann
    }
    returner builtin.fil_finnes(mål)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la stage1 = root + "/build/compiler_stage1"
    la stage2 = root + "/build/compiler_stage2"

    linje("Starting Norscode bootstrap verification...")
    hvis ikkje filops.lag_katalogar(root + "/build") { returner 1 }
    hvis ikkje bygg_compiler(root, stage1) { returner 1 }
    hvis ikkje bygg_compiler(root, stage2) { returner 1 }

    la hash1 = sha256_for(stage1)
    la hash2 = sha256_for(stage2)
    linje("Stage1 hash: " + hash1)
    linje("Stage2 hash: " + hash2)

    hvis hash1 == hash2 {
        linje("Bootstrap verification PASSED")
        returner 0
    }

    linje("Bootstrap verification FAILED")
    returner 1
}
