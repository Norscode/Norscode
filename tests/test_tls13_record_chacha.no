# TLS 1.3 record-lag (RFC 8446 §5) med ChaCha20-Poly1305.
# Eksterne anker: RFC 8439 §2.8.2 (AEAD-keystream/nonce) + RFC 8448 (IV-utleiing, suite-uavhengig).
bruk std.tls13_record som rec
funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
funksjon _hex(b: liste_heiltall) -> tekst { la ut = "" la i = 0 mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 } returner ut }
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon start() -> heiltall {
    # (1) IV-utleiing er suite-uavhengig: anker mot RFC 8448 "tls13 s hs traffic".
    la s_hs = _b("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38")
    la tk = rec.traffic_keys(s_hs)
    assert_eq(_hex(tk["iv"]), "5d313eb2671276ee13000b30")
    assert_eq(lengde(tk["key"]), 32)

    # (2) Keystream/nonce-anker mot RFC 8439 §2.8.2: set iv=nonce, seq=0 -> record-nonce=iv.
    #     ChaCha20 er strømchiffer, så dei krypterte payload-bytane må vere identiske med
    #     RFC 8439 sin ciphertext (uavhengig av vår AAD/tag og den ekstra content_type-byten).
    la key = _b("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    la iv = _b("070000004041424344454647")
    la pt = _b("4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e")
    la post = rec.krypter_post(key, iv, 0, 23, pt)
    # record = header(5) || ciphertext(len(pt)) || content_type-cipher(1) || tag(16)
    la ct: liste_heiltall = []
    la i = 5
    mens i < 5 + lengde(pt) { legg_til(ct, post[i]) i = i + 1 }
    assert_eq(_hex(ct), "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116")

    # (3) Rundtur: dekrypter tilbake til content_type 23 og opphavleg payload.
    la ut = rec.dekrypter_post(key, iv, 0, post)
    assert_eq(ut["status"], "ok")
    assert_eq(ut["type"], 23)
    assert_eq(_hex(ut["plaintext"]), _hex(pt))

    # (4) Sekvensnummer > 0 må gi anna nonce -> rundtur med rett seq, feil seq feilar.
    la p2 = rec.krypter_post(key, iv, 5, 22, _b("1400002000112233445566778899aabbccddeeff00112233445566778899aabb"))
    la ok2 = rec.dekrypter_post(key, iv, 5, p2)
    assert_eq(ok2["status"], "ok")
    assert_eq(ok2["type"], 22)
    la feil_seq = rec.dekrypter_post(key, iv, 6, p2)
    assert_eq(feil_seq["status"], "feil")

    # (5) Tukla tag skal avvisast (fail-closed).
    la tuklet: liste_heiltall = []
    i = 0
    mens i < lengde(post) { legg_til(tuklet, post[i]) i = i + 1 }
    tuklet[lengde(tuklet)-1] = tuklet[lengde(tuklet)-1] ^ 1
    la bad = rec.dekrypter_post(key, iv, 0, tuklet)
    assert_eq(bad["status"], "feil")

    assert_eq(rec.status()["abi"], "norscode-tls13-record-v1")
    skriv("test_tls13_record_chacha OK")
    returner 0
}
