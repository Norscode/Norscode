# std.pg utan tenar (H1): ingen stille suksess. Operasjonar utan open tilkopling,
# og tilkopling mot ein port ingen lyttar på, gir ein tydeleg «PG-feil: …» utan
# at passordet lekk ut i meldinga. (Ein ekte tenar blir testa i test_pg_klient.)
bruk std.pg som pg

funksjon _kastar(fn: tekst) -> tekst {
    la melding = ""
    prøv {
        hvis fn == "open" { pg.open("host=127.0.0.1 port=1 dbname=app user=ola password=hemmeleg") }
        hvis fn == "open_url" { pg.open_url("postgresql://ola:hemmeleg@127.0.0.1:1/app") }
        hvis fn == "open_cfg" { pg.open_cfg("127.0.0.1", 1, "app", "ola", "hemmeleg") }
        hvis fn == "utan_brukar" { pg.open("host=127.0.0.1 port=1 dbname=app") }
        hvis fn == "execute" { pg.execute("c", "SELECT 1", []) }
        hvis fn == "query" { pg.query("c", "SELECT 1", []) }
        hvis fn == "query_int" { pg.query_int("c", "SELECT 1") }
        hvis fn == "begin" { pg.begin("c") }
        melding = "INGEN FEIL"
    } fang (e) {
        melding = tekst(e)
    }
    returner melding
}

funksjon start() -> heltall {
    assert(pg.tilgjengeleg())
    assert(ikkje pg.er_tilkopla("c"))
    assert(ikkje pg.er_tilkopla(""))
    assert_eq(pg.close("c"), 0)
    la ops = ["open", "open_url", "open_cfg", "utan_brukar", "execute", "query", "query_int", "begin"]
    la i = 0
    mens i < lengde(ops) {
        la m = _kastar(ops[i])
        hvis ikkje builtin.starts_with(m, "PG-feil: ") {
            skriv(ops[i] + " gav: " + m + "\n")
        }
        assert(builtin.starts_with(m, "PG-feil: "))
        assert(builtin.index_of(m, "hemmeleg") < 0)
        i = i + 1
    }
    skriv("test_pg_utan_tenar OK\n")
    returner 0
}
