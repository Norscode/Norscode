bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    skriv("native runtime gap probe v3001\n")

    prøv {
        la token = builtin.random_hex(4)
        skriv("random_hex OK len=" + tekst(lengde(token)) + "\n")
    } fang (e) {
        skriv("random_hex FEIL: " + e + "\n")
    }

    prøv {
        skriv("tid_ms OK: " + tekst(builtin.tid_ms()) + "\n")
    } fang (e) {
        skriv("tid_ms FEIL: " + e + "\n")
    }

    prøv {
        skriv("tid_no OK: " + tekst(builtin.tid_no()) + "\n")
    } fang (e) {
        skriv("tid_no FEIL: " + e + "\n")
    }

    prøv {
        skriv("now OK: " + tekst(builtin.now()) + "\n")
    } fang (e) {
        skriv("now FEIL: " + e + "\n")
    }

    prøv {
        skriv("timestamp OK: " + tekst(builtin.timestamp()) + "\n")
    } fang (e) {
        skriv("timestamp FEIL: " + e + "\n")
    }

    prøv {
        // Gaten køyrer med PATH=/nonexistent: prøv den faktiske kandidaten
        // direkte, slik at prosessporten ikkje er avhengig av eit system-echo.
        la info = builtin.system_info()
        la native = tekst(info["executable"])
        la res = prosess.køyr(native, ["version"], tekst(info["cwd"]), {
            "NORSCODE_CMD": "version", "NORSCODE_FILE": "", "NORSCODE_OUTPUT": ""
        }, 5000)
        hvis ikkje prosess.ok(res) eller ikkje builtin.starts_with(tekst(res["stdout"]), "Norscode ") {
            kast "strukturert prosess feila: " + tekst(res["status"]) + "/" + tekst(res["exit_code"])
        }
        skriv("strukturert prosess-ABI OK: " + tekst(res["stdout"]) + "\n")
    } fang (e) {
        skriv("strukturert prosess-ABI FEIL: " + e + "\n")
    }

    prøv {
        la mappe = "build/runtime-gap/norscode native mappe " + tekst(builtin.tid_ms()) + "/under mappe"
        builtin.mappe_opprett(mappe)
        fil_skriv(mappe + "/probe.txt", "mappe ok")
        la inn = fil_les(mappe + "/probe.txt")
        hvis inn == "mappe ok" {
            skriv("mappe_opprett OK\n")
        } ellers {
            skriv("mappe_opprett FEIL: feil filinnhald\n")
        }
    } fang (e2) {
        skriv("mappe_opprett FEIL: " + e2 + "\n")
    }

    returner 0
}
