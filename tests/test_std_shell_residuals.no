bruk std.tekst som t

funksjon tel(haystack: tekst, needle: tekst) -> heiltall {
    returner lengde(builtin.split(haystack, needle)) - 1
}

funksjon krev_ingen_rå_sti_shell(sti: tekst) {
    la src = fil_les(sti)
    assert(ikkje t.inneholder(src, "returner \"'\" + sti + \"'\""))
}

funksjon krev_trygg_s_shell(sti: tekst) {
    la src = fil_les(sti)
    assert(t.inneholder(src, "builtin.replace(s, \"'\""))
    assert(ikkje t.inneholder(src, "returner \"'\" + s + \"'\""))
}

funksjon krev_standard_shellquote(sti: tekst) {
    la src = fil_les(sti)
    assert(ikkje t.inneholder(src, "\"'\\\\''\""))
}

funksjon start() -> heiltall {
    la stat = fil_les("std/stat.no")
    assert(t.inneholder(stat, "native_fs.native_stat_sti(sti)"))
    assert(t.inneholder(stat, "native_fs.native_sett_modus_sti(sti, mode)"))
    assert(ikkje t.inneholder(stat, "builtin.exec_prosess"))

    la pathlib = fil_les("std/pathlib.no")
    assert(t.inneholder(pathlib, "native_fs.native_list(p[\"sti\"], \"\")"))
    assert(ikkje t.inneholder(pathlib, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(pathlib, "funksjon _shell("))

    la tarfile = fil_les("std/tarfile.no")
    assert(t.inneholder(tarfile, "bruk std.zip som tar"))
    assert(t.inneholder(tarfile, "tar.tar_les_pure(sti)"))
    assert(ikkje t.inneholder(tarfile, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(tarfile, "funksjon _shell("))

    la filecmp = fil_les("std/filecmp.no")
    assert(ikkje t.inneholder(filecmp, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(filecmp, "funksjon _shell("))
    assert(ikkje t.inneholder(filecmp, "&& echo LIKE || echo ULIK"))
    assert(ikkje t.inneholder(filecmp, "test -d \" + _shell(sti)"))
    assert(ikkje t.inneholder(filecmp, "ls -1 \" + _shell(sti)"))

    la filops = fil_les("std/filops.no")
    assert(t.inneholder(filops, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(filops, "builtin.fil_les_binær(kjelde)"))
    assert(ikkje t.inneholder(filops, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(filops, "funksjon _shell("))

    la shutil = fil_les("std/shutil.no")
    assert(t.inneholder(shutil, "bruk std.filops som filops"))
    assert(t.inneholder(shutil, "native_fs.native_sett_modus_sti"))
    assert(ikkje t.inneholder(shutil, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(shutil, "funksjon _shell("))

    la gzip = fil_les("std/gzip.no")
    assert(t.inneholder(gzip, "arkiv.gzip_skriv_bytes"))
    assert(t.inneholder(gzip, "arkiv.gzip_dekomprimer_bytes"))
    assert(ikkje t.inneholder(gzip, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(gzip, "funksjon _shell("))

    la wsgiref = fil_les("std/wsgiref.no")
    assert(ikkje t.inneholder(wsgiref, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(wsgiref, "funksjon _shell("))
    la prosess = fil_les("std/prosess.no")
    assert(t.inneholder(prosess, "builtin.process_spawn_argv(req)"))
    assert(ikkje t.inneholder(prosess, "builtin.exec_prosess"))
    la fileinput = fil_les("std/fileinput.no")
    assert(t.inneholder(fileinput, "builtin.fil_les_binær(sti)"))
    assert(ikkje t.inneholder(fileinput, "builtin.exec_prosess"))
    la ftplib = fil_les("std/ftplib.no")
    assert(t.inneholder(ftplib, "Kontrollkanalen er persistent"))
    assert(t.inneholder(ftplib, "sok.native_les_hex"))
    assert(ikkje t.inneholder(ftplib, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(ftplib, "funksjon _shell("))
    la webbrowser = fil_les("std/webbrowser.no")
    assert(ikkje t.inneholder(webbrowser, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(webbrowser, "funksjon _shell("))
    krev_standard_shellquote("std/socketserver.no")
    la poplib = fil_les("std/poplib.no")
    assert(ikkje t.inneholder(poplib, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(poplib, "funksjon _shell("))
    la smtplib = fil_les("std/smtplib.no")
    assert(ikkje t.inneholder(smtplib, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(smtplib, "funksjon _shell("))
    la imaplib = fil_les("std/imaplib.no")
    assert(ikkje t.inneholder(imaplib, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(imaplib, "funksjon _shell("))
    la plistlib = fil_les("std/plistlib.no")
    assert(ikkje t.inneholder(plistlib, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(plistlib, "funksjon _shell("))
    la syslog = fil_les("std/syslog.no")
    assert(ikkje t.inneholder(syslog, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(syslog, "funksjon _shell("))
    krev_standard_shellquote("std/shlex.no")
    krev_standard_shellquote("std/multiprocessing.no")

    krev_ingen_rå_sti_shell("tools/rollback_serve_runner_cookie_fix_v682.no")
    krev_ingen_rå_sti_shell("tools/test_kernel_boot.no")
    krev_ingen_rå_sti_shell("tools/unified_bootstrap_verifier.no")
    krev_ingen_rå_sti_shell("tools/backup_stage0_before_random_hex_v734.no")
    krev_ingen_rå_sti_shell("tools/build-bootstrap-binary.no")
    krev_ingen_rå_sti_shell("tools/build-macos-window-host.no")
    krev_ingen_rå_sti_shell("tools/generate_build_embed_c.no")
    krev_ingen_rå_sti_shell("tools/no_legacy_cvm.no")
    krev_ingen_rå_sti_shell("tools/backup_native_stage0_v723.no")
    krev_ingen_rå_sti_shell("tools/nc_test.no")
    krev_ingen_rå_sti_shell("tools/test_random_session_v704.no")
    krev_ingen_rå_sti_shell("tools/compare_compilers.no")
    krev_ingen_rå_sti_shell("tools/bootstrap_diff_analyzer.no")
    la phase0 = fil_les("tools/selfhost_phase0_verify.no")
    assert(ikkje t.inneholder(phase0, "exec_prosess"))
    assert(ikkje t.inneholder(phase0, "sh -n "))
    assert(ikkje t.inneholder(phase0, "find "))

    la single_module = fil_les("tools/run_single_module_bundle_probes_v6800.no")
    assert(t.inneholder(single_module, "builtin.process_spawn_argv"))
    assert(t.inneholder(single_module, "process_abi.sett_environment"))
    assert(ikkje t.inneholder(single_module, "exec_prosess"))
    assert(ikkje t.inneholder(single_module, " | tee "))
    la bootstrap_bisect = fil_les("tools/bootstrap_refresh_bisect_v6400.no")
    assert(t.inneholder(bootstrap_bisect, "bruk tools.process_runner som runner"))
    assert(ikkje t.inneholder(bootstrap_bisect, "exec_prosess"))
    la mark_render = fil_les("tools/render-norscode-mark.no")
    assert(t.inneholder(mark_render, "builtin.system_info()[\"cwd\"]"))
    assert(ikkje t.inneholder(mark_render, "exec_prosess"))
    assert(ikkje t.inneholder(mark_render, "funksjon shell("))
    la install_alias = fil_les("tools/install-release.no")
    assert(t.inneholder(install_alias, "bruk tools.install_release som install_release"))
    assert(ikkje t.inneholder(install_alias, "exec_prosess"))
    krev_trygg_s_shell("tools/overlay_hybrid_compiler_into_bundle_v9410.no")
    krev_trygg_s_shell("tools/build_linux_x86_64_stage0_docker_v3601.no")
    la lokal_install = fil_les("tools/install.no")
    assert(t.inneholder(lokal_install, "native_fs.native_erstatt_symbolsk_lenke"))
    assert(t.inneholder(lokal_install, "bruk tools.process_runner som prosess"))
    assert(ikkje t.inneholder(lokal_install, "exec_prosess"))
    assert(ikkje t.inneholder(lokal_install, "funksjon shell("))
    krev_trygg_s_shell("tools/build-macos-app.no")
    la patch_guard = fil_les("tools/ai_patch_guard_v3021.no")
    assert(ikkje t.inneholder(patch_guard, "exec_prosess("))
    assert(ikkje t.inneholder(patch_guard, "funksjon shell("))
    la repl = fil_les("tools/nc_repl.no")
    assert(t.inneholder(repl, "builtin.process_spawn_argv"))
    assert(t.inneholder(repl, "builtin.readline(\"norscode> \")"))
    assert(ikkje t.inneholder(repl, "sh -c"))
    assert(ikkje t.inneholder(repl, "funksjon shell("))
    la macos_icons = fil_les("tools/install-macos-file-icons.no")
    assert(t.inneholder(macos_icons, "prosess.start_argv_plan(executable, args)"))
    assert(t.inneholder(macos_icons, "tempfile.ny_tempkatalog"))
    assert(ikkje t.inneholder(macos_icons, "exec_prosess"))
    assert(ikkje t.inneholder(macos_icons, "sh -c"))
    la startapp = fil_les("tools/startapp.no")
    la startproject = fil_les("tools/startproject.no")
    assert(ikkje t.inneholder(startapp, "exec_prosess"))
    assert(ikkje t.inneholder(startproject, "exec_prosess"))
    assert(ikkje t.inneholder(fil_les("tools/startapp_generator.no"), "exec_prosess"))
    assert(ikkje t.inneholder(fil_les("tools/startproject_generator.no"), "exec_prosess"))
    la controlled_promotion = fil_les("tools/controlled_runtime_promotion_v3005.no")
    assert(t.inneholder(controlled_promotion, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(controlled_promotion, "prosess.køyr(host, [\"run\", root + \"/\" + fil], root, m, timeout)"))
    assert(ikkje t.inneholder(controlled_promotion, "exec_prosess"))
    assert(ikkje t.inneholder(controlled_promotion, "funksjon shell("))
    krev_trygg_s_shell("tools/bundle_with_hybrid_compiler_v9500.no")
    la ownership = fil_les("tools/verify_norscode_surface_ownership.no")
    assert(t.inneholder(ownership, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(ownership, "native_fs.native_list(root, katalog)"))
    assert(ikkje t.inneholder(ownership, "exec_prosess"))
    assert(ikkje t.inneholder(ownership, "find "))
    la serve_plan = fil_les("tools/test_v731_serve_plan_v735.no")
    assert(t.inneholder(serve_plan, "bruk std.http som http"))
    assert(ikkje t.inneholder(serve_plan, "exec_prosess"))
    krev_trygg_s_shell("tools/refresh_bootstrap_compiler_v6000.no")
    la runtime_gap = fil_les("tools/test_v795_runtime_gap.no")
    assert(t.inneholder(runtime_gap, "bruk std.http som http"))
    assert(ikkje t.inneholder(runtime_gap, "exec_prosess"))
    la hybrid_compile = fil_les("tools/compile_with_hybrid_bundle_v9400.no")
    assert(t.inneholder(hybrid_compile, "bruk tools.process_runner som process_runner"))
    assert(t.inneholder(hybrid_compile, "runtime_fs.native_tempområde"))
    assert(ikkje t.inneholder(hybrid_compile, "exec_prosess"))
    assert(ikkje t.inneholder(hybrid_compile, "funksjon shell("))
    krev_trygg_s_shell("tools/build_hybrid_compiler_bundle_v9400.no")
    krev_trygg_s_shell("tools/bootstrap_codegen_diff_v5800.no")
    krev_trygg_s_shell("tools/bundle_entry_diagnose_v6600.no")
    krev_trygg_s_shell("tools/build_linux_native_candidate_v3005.no")

    skriv("test_std_shell_residuals OK")
    returner 0
}
