funksjon start() -> heiltall {
    la pure_vm: boolsk = usann
    prøv {
        builtin.vm_memory_status()
        pure_vm = sann
    } fang (e) {
    }
    hvis ikkje pure_vm {
        skriv("test_vm_security_disk_absolute_scope OK")
        returner 0
    }

    // Test-barn arvar ikkje foreldre-PWD (jf. nc_test.no runtime_miljø), så
    // bruk NORSCODE_ROOT (alltid bunde) med PWD som fallback.
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = miljo_hent("PWD") }
    la dokument = fil_les(root + "/docs/STATUS.md")
    hvis lengde(dokument) == 0 { returner 1 }

    // Ein absolutt sti UTANFOR disk-scope (root,.,/tmp) skal nektast av
    // capability-porten (disk.read) — /etc ligg aldri i test-scope.
    prøv {
        fil_les("/etc/hostname")
        returner 2
    } fang (e) {
        hvis lengde(e) == 0 { returner 3 }
    }

    skriv("test_vm_security_disk_absolute_scope OK")
    returner 0
}
