// Fase 1: query_rader — fler-rads lesing. Kolonnar skilde med "|", rader med "\n".
// Golden frå `sqlite3 -noheader -separator '|'` (3.51.0). Enableren for GROUP BY,
// og det list-appar treng (query_text gjev berre første verdi).

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")
    assert_eq(db.execute(h, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')"), 1)

    // Fleire kolonnar, numerisk ORDER BY
    assert_eq(db.query_rader(h, "SELECT navn, alder FROM folk ORDER BY alder ASC"), "Bjørn|29\nAda|37\nAlan|41\nLinus|55")
    // Éin kolonne, tekst ORDER BY, WHERE
    assert_eq(db.query_rader(h, "SELECT navn FROM folk WHERE by = 'Oslo' ORDER BY navn ASC"), "Ada\nAlan\nLinus")
    // SELECT * følgjer skjema-rekkjefølgje
    assert_eq(db.query_rader(h, "SELECT * FROM folk WHERE id = 2"), "2|Linus|55|Oslo")
    // LIMIT + DESC
    assert_eq(db.query_rader(h, "SELECT navn, alder FROM folk ORDER BY alder DESC LIMIT 2"), "Linus|55\nAlan|41")
    // Tom mengde => tom streng
    assert_eq(db.query_rader(h, "SELECT navn FROM folk WHERE id = 99"), "")

    assert(db.close(h))
    returner 0
}
