// Fase 0.5a-regresjon: roller/rettar skal ALDRI kome frå klient-sende headerar
// (X-Roles/X-Role/X-Permissions). Før fiksen las has_role/require_role dei rett frå
// headerane, so «X-Roles: admin» gav full tilgang (rolle-forfalsking). No kjem dei
// berre frå klarerte, server-sette felt (web.sett_roller/web.sett_rettar), og
// standard er nekt.
//
// Mutasjonsprov: la _roles_fra_ctx lese ctx["__headers__"]["x-roles"] att, og
// «headerane blir ignorert»-saka under går frå 403 til 200.

bruk std.web som web
bruk std.tekst som t

funksjon tilgang_guard(ctx: ordbok_tekst) -> bool {
    web.guard()
    returner web.require_role(ctx, "admin") og web.require_permission(ctx, "reports.read")
}

funksjon dashboard(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("tilgang_guard")
    web.route("GET /dashboard")
    returner web.response_builder(
        200,
        {"content-type": "text/plain"},
        web.role(ctx) + "|" + t.bool_til_tekst(web.has_role(ctx, "admin")) + "|" + t.bool_til_tekst(web.has_permission(ctx, "reports.write"))
    )
}

funksjon start() -> heltall {
    // (1) Klient-headerar blir IGNORERT → guard nektar (403), ingen forfalsking.
    la spoof = web.handle_request(
        web.request_context("get", "/dashboard", {}, {"x-roles": "editor, admin", "x-permissions": "reports.read, reports.write"}, "")
    )
    assert_eq(web.response_status(spoof), 403)

    // (2) Server-sette, klarerte roller/rettar → tilgang (200).
    la ctx = web.request_context("get", "/dashboard", {}, {}, "")
    web.sett_roller(ctx, "editor,admin")
    web.sett_rettar(ctx, "reports.read,reports.write")
    la lovet = web.handle_request(ctx)
    assert_eq(web.response_status(lovet), 200)
    assert_eq(web.response_body(lovet), "editor|sann|sann")

    // (3) Eksplisitt opt-in (klarert proxy) kan promotere headerane med vilje.
    la ctx2 = web.request_context("get", "/dashboard", {}, {"x-role": "admin", "x-permissions": "reports.read"}, "")
    web.stol_på_rolle_headerar(ctx2)
    la via_proxy = web.handle_request(ctx2)
    assert_eq(web.response_status(via_proxy), 200)
    assert_eq(web.response_body(via_proxy), "admin|sann|usann")

    skriv("test_web_roles OK")
    returner 0
}
