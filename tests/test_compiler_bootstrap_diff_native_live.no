bruk tools.compare_compilers som compare
bruk tools.bootstrap_diff_analyzer som diff
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "compiler-diff-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    la a = base + "/a.bin"
    la lik = base + "/lik.bin"
    la ulik = base + "/ulik.bin"
    builtin.fil_skriv_binær(a, builtin.bytes_from_list([0, 255, 16, 65]))
    builtin.fil_skriv_binær(lik, builtin.bytes_from_list([0, 255, 16, 65]))
    builtin.fil_skriv_binær(ulik, builtin.bytes_from_list([0, 254, 16, 65, 7]))

    assert(compare.samanlikn(a, lik))
    assert(ikkje compare.samanlikn(a, ulik))
    assert(compare.hash_fil(a) == sha256.hash_bytes(builtin.bytes_from_list([0, 255, 16, 65])))

    la report = base + "/reports/diff.txt"
    assert(diff.analyser(a, ulik, report))
    la body = builtin.fil_les(report)
    assert(builtin.index_of(body, "Bootstrap mismatch detected") >= 0)
    assert(builtin.index_of(body, "1 255 254") >= 0)
    assert(builtin.index_of(body, "length 4 5") >= 0)
    assert(builtin.index_of(body, diff.hash_fil(a)) >= 0)
    assert(filops.slett_tre(base))
    skriv("test_compiler_bootstrap_diff_native_live OK")
    returner 0
}
