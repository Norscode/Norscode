bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/linecache.no")
    assert(t.inneholder(src, "bruk std.sha256 som sha256_bytes"))
    assert(t.inneholder(src, "sha256_bytes.hash_bytes(builtin.fil_les_binær(filsti))"))
    assert(t.inneholder(src, "funksjon _har_kontrollteikn(verdi: tekst) -> bool"))
    assert(t.inneholder(src, "funksjon _trygg_sti(sti: tekst) -> bool"))
    assert(t.inneholder(src, "hvis ikkje _trygg_sti(filsti) { returner \"\" }"))
    assert(t.inneholder(src, "hvis ikkje _trygg_sti(filsti) { returner [] }"))
    assert(t.inneholder(src, "hvis ikkje _trygg_sti(filsti) { returner 0 }"))
    assert(t.inneholder(src, "hvis ikkje _trygg_sti(filsti) { returner usann }"))
    assert(t.inneholder(src, "la nytt_fingeravtrykk = _fil_fingeravtrykk(filsti)"))
    assert(t.inneholder(src, "la linjer = builtin.split(builtin.fil_les(filsti), \"\\n\")"))
    assert(t.inneholder(src, "la indeks: heltall = linjenummer - 1"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "sed -n '\" + tekst_fra_heltall(linjenummer)"))
    assert(ikkje t.inneholder(src, "p' \" + filsti"))

    skriv("test_linecache_native_fingerprint OK")
    returner 0
}
