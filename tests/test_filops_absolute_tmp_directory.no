bruk std.filops som filops
bruk std.runtime_filesystem som native_fs

funksjon start() -> heiltall {
    la rot = "/tmp/norscode-filops-dir-" + builtin.random_hex(12)
    assert(filops.lag_katalogar(rot + "/a/b"))
    assert(filops.katalog_finnes(rot))
    assert(filops.katalog_finnes(rot + "/a/b"))
    assert(filops.slett_tre(rot))
    assert(ikkje filops.katalog_finnes(rot))
    skriv("test_filops_absolute_tmp_directory OK\n")
    returner 0
}
