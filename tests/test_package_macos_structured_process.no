bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/package-macos-app.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(executable, argv, cwd, {}, 600000)"))
    assert(t.inneholder(src, "builtin.sha256_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(src, "filops.kopier_tre(app_path"))
    assert(t.inneholder(src, "filops.flytt(tmp_dmg, dmg_path)"))
    assert(t.inneholder(src, "[\"create\", \"-volname\", vol_name"))
    assert(t.inneholder(src, "[\"--root\", pkg_root_dir"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "command -v"))
    assert(ikkje t.inneholder(src, "shasum"))
    assert(ikkje t.inneholder(src, "sha256sum"))
    assert(ikkje t.inneholder(src, "mkdir -p"))
    assert(ikkje t.inneholder(src, "cp -R"))
    skriv("test_package_macos_structured_process OK")
    returner 0
}
