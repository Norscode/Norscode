bruk tools.verify_seed_only som seed

funksjon start() -> heiltall {
    assert(seed.info_felt({"system": "Darwin"}, "system", "os") == "darwin")
    assert(seed.info_felt({"os": "Linux"}, "system", "os") == "linux")
    assert(seed.info_felt({"machine": "ARM64"}, "machine", "arch") == "arm64")
    assert(seed.info_felt({"arch": "x86_64"}, "machine", "arch") == "x86_64")
    assert(seed.info_felt({}, "system", "os") == "")
    la kjelde = builtin.fil_les("tools/verify_seed_only.no")
    assert(builtin.contains(kjelde, "NORSCODE_SEED_TMP_ROOT"))
    assert(ikkje builtin.contains(kjelde, "env(\"TMPDIR\")"))
    skriv("test_verify_seed_system_info_contract OK\n")
    returner 0
}
