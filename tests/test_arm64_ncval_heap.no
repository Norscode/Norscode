// Fase 2: AArch64 NcVal-runtime-grunnmur (SELFHOST_ARM64_FULLHOST_CODEGEN_PLAN.md).
// Byggjer den sjølvståande prøva som reserverer ein anonym mmap-heap, allokerer
// to NcVal-int {type,val}, legg dei saman over NcVal og pakkar ut resultatet som
// exit-kode. Verifiserer mmap + allokator + NcVal-aritmetikk + utpakking på ekte
// AArch64-maskinvare. Linux-ELF-varianten deler same instruksjonar og blir køyrt
// på ekte Linux ARM64-host/CI.

bruk std.runtime_filesystem som native_fs
bruk std.filops som filops
bruk tools.process_runner som prosess
bruk selfhost.native_execution.macho_arm64_codegen som codegen

funksjon start() -> heiltall {
    la info = builtin.system_info()
    hvis tekst(info["system"]) != "Darwin" eller tekst(info["machine"]) != "arm64" { returner 0 }

    la bytes = codegen.phase2_ncval_probe_image()
    // Mach-O-header (ad-hoc signert av emitteren): CF FA ED FE.
    assert(lengde(bytes) > 4096)
    assert_eq(bytes[0], 0xCF)
    assert_eq(bytes[1], 0xFA)

    la sti = "/tmp/norscode_arm64_ncval_" + builtin.random_hex(8)
    builtin.fil_skriv_binær(sti, bytes)
    assert_eq(tekst(native_fs.native_sett_modus_sti(sti, 493)["status"]), "ok")

    la r = prosess.køyr(sti, [], tekst(info["cwd"]), {}, 30000)
    hvis tekst(r["status"]) != "ferdig" eller heltall_fra_tekst(tekst(r["exit_code"])) != 42 {
        prosess.skriv_resultat(r)
        assert_eq(heltall_fra_tekst(tekst(r["exit_code"])), 42)
    }

    filops.slett_fil(sti)
    skriv("test_arm64_ncval_heap OK\n")
    returner 0
}
