bruk std.tarfile som tarfile
bruk std.zip som zip
bruk std.bytes som bytes

funksjon skriv_octal_checksum(data: liste_heiltall) {
    la i = 148
    mens i < 156 { data[i] = 32 i = i + 1 }
    la sum = 0
    i = 0
    mens i < 512 { sum = sum + data[i] i = i + 1 }
    la oct = ""
    la v = sum
    mens v > 0 { oct = builtin.chr(48 + (v % 8)) + oct v = v / 8 }
    mens lengde(oct) < 6 { oct = "0" + oct }
    i = 0
    mens i < 6 { data[148 + i] = builtin.char_code(builtin.slice(oct, i, i + 1)) i = i + 1 }
    data[154] = 0
    data[155] = 32
}

funksjon start() -> heiltall {
    la root = "build/test-tar-security-v1-" + builtin.random_hex(6)
    builtin.mkdir_p(root + "/src")
    builtin.fil_skriv(root + "/src/ok.txt", "abc")
    la ark_sti = root + "/safe.tar"
    la writer = tarfile.open(ark_sti, "w")
    assert(tarfile.add(writer, root + "/src/ok.txt", "ok.txt"))
    tarfile.close(writer)

    la reader = tarfile.open(ark_sti, "r")
    assert(ikkje tarfile.extractall_med_grenser(reader, root + "/too-small-archive", 1, 100, 100, 10))
    assert(ikkje tarfile.extractall_med_grenser(reader, root + "/too-small-total", 10000, 2, 100, 10))
    assert(ikkje tarfile.extractall_med_grenser(reader, root + "/too-small-file", 10000, 100, 2, 10))
    assert(tarfile.extractall_med_grenser(reader, root + "/safe", 10000, 100, 100, 10))

    la gzip = zip.gzip_komprimer_bytes(bytes.fra_liste([1, 2, 3, 4]))
    assert(lengde(bytes.til_liste(zip.gzip_dekomprimer_bytes_med_grense(gzip, 3))) == 0)
    assert(lengde(bytes.til_liste(zip.gzip_dekomprimer_bytes_med_grense(gzip, 4))) == 4)

    la symlink_data = bytes.til_liste(builtin.fil_les_binær(ark_sti))
    symlink_data[156] = 50
    skriv_octal_checksum(symlink_data)
    la symlink_sti = root + "/symlink.tar"
    builtin.fil_skriv_binær(symlink_sti, bytes.fra_liste(symlink_data))
    assert(lengde(zip.tar_lista(zip.tar_les_pure(symlink_sti))) == 0)

    la traversal_data = bytes.til_liste(builtin.fil_les_binær(ark_sti))
    la farleg = "../evil"
    la i = 0
    mens i < 100 { traversal_data[i] = 0 i = i + 1 }
    i = 0
    mens i < lengde(farleg) {
        traversal_data[i] = builtin.char_code(builtin.slice(farleg, i, i + 1))
        i = i + 1
    }
    skriv_octal_checksum(traversal_data)
    la traversal_sti = root + "/traversal.tar"
    builtin.fil_skriv_binær(traversal_sti, bytes.fra_liste(traversal_data))
    assert(lengde(zip.tar_lista(zip.tar_les_pure(traversal_sti))) == 0)
    assert(ikkje builtin.fil_finnes(root + "/evil"))

    skriv("test_tarfile_security_limits OK")
    returner 0
}
