bruk tools.finalize_linux_fullhost_candidate som finalize
bruk selfhost.native_execution.native_codegen_v2 som codegen

funksjon start() -> heiltall {
    la out = "build/test_linux_fullhost_external_embed.bin"
    la input = "tests/fixtures/native_codegen_first_function_probe.ncb.json"
    builtin.fil_skriv_binær(out, builtin.bytes_from_list([127, 69, 76, 70]))

    assert(finalize.fullfør_innebygd_ncb(out, input))
    la artefakt = builtin.fil_les_binær(out)
    assert(codegen.har_innebygd_ncb(artefakt))
    assert_eq(codegen.hent_innebygd_ncb(artefakt), builtin.fil_les(input))

    builtin.fil_slett(out)
    returner 0
}
