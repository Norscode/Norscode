bruk tools.finalize_linux_fullhost_candidate som finalize
bruk selfhost.native_execution.native_codegen_v2 som codegen

// Liten NCB-payload for trailer-testen. Han blir skriven til build/ av testen
// sjølv i staden for å lesast frå ein committa fikstur (JSON-avvikling J1d).
funksjon probe_ncb() -> tekst {
    la ncb = {
        "format": "norscode-bytecode-v1",
        "entry": "__main__.start",
        "imports": [],
        "functions": {
            "__main__.hjelpar": {
                "name": "hjelpar", "module": "__main__", "params": ["verdi"], "is_async": usann,
                "code": [["LOAD_NAME", "verdi"], ["PUSH_CONST", 9], ["PUSH_CONST", 1], ["UNARY_NEG"],
                         ["CALL", "builtin.slice", 3], ["RETURN"]]
            },
            "__main__.start": {
                "name": "start", "module": "__main__", "params": [], "is_async": usann,
                "code": [["PUSH_CONST", "NATIVE_CODEGEN_PROBE_OK\n"], ["CALL", "builtin.skriv", 1],
                         ["POP"], ["PUSH_CONST", 0], ["RETURN"]]
            }
        }
    }
    returner json_skriv(ncb)
}

funksjon start() -> heiltall {
    la out = "build/test_linux_fullhost_external_embed.bin"
    la input = "build/test_linux_fullhost_external_embed.ncb.json"
    fil_skriv(input, probe_ncb())
    builtin.fil_skriv_binær(out, builtin.bytes_from_list([127, 69, 76, 70]))

    assert(finalize.fullfør_innebygd_ncb(out, input))
    la artefakt = builtin.fil_les_binær(out)
    assert(codegen.har_innebygd_ncb(artefakt))
    assert_eq(codegen.hent_innebygd_ncb(artefakt), builtin.fil_les(input))

    builtin.fil_slett(out)
    builtin.fil_slett(input)
    returner 0
}
