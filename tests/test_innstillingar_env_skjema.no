# test_innstillingar_env_skjema.no — Regresjonstest for Fase 1 punkt 1.11.
#
# Dekker:
#   * miljø VINN over fil (gamle åtferda lét fila vinne)
#   * vilkårlege nøklar: både frå fil og frå miljø (ikkje berre 25 faste)
#   * typa skjema med FEIL ved ugyldig verdi (ikkje stille fallback til 0/"")
#   * secrets-mappe: les hemmeleg frå fil per nøkkel; miljø overstyrer secrets
#
# FEILAR før fiksen:
#   - env-vinn-assertane feila (fila vann over NORSCODE_APP_*)
#   - vilkårleg miljø-berre nøkkel gav "" (berre 25 faste vart lesne frå env)
#   - hent_int_streng/valider_skjema fanst ikkje (streng typing mangla)
#   - secrets-mappe fanst ikkje

bruk std.innstillingar som cfg
bruk std.bytes som bytes

funksjon _kastar_int(s: ordbok_tekst, nøkkel: tekst) -> bool {
    prøv { cfg.hent_int_streng(s, nøkkel, 0) } fang (e) { returner sann }
    returner usann
}
funksjon _kastar_bool(s: ordbok_tekst, nøkkel: tekst) -> bool {
    prøv { cfg.hent_bool_streng(s, nøkkel, usann) } fang (e) { returner sann }
    returner usann
}
funksjon _kastar_float(s: ordbok_tekst, nøkkel: tekst) -> bool {
    prøv { cfg.hent_float_streng(s, nøkkel, 0) } fang (e) { returner sann }
    returner usann
}
funksjon _kastar_skjema(s: ordbok_tekst, skjema: ordbok_tekst) -> bool {
    prøv { cfg.valider_skjema(s, skjema) } fang (e) { returner sann }
    returner usann
}

funksjon start() -> heiltall {
    la rot = "build/cfgtest-" + builtin.random_hex(8)
    builtin.mkdir_p(rot)
    la cfg_sti = rot + "/innstillingar.toml"

    # Fil med både kjende og vilkårlege nøklar + ugyldige typa verdiar.
    la innhald = "SERVER_PORT = 4173\n"
    innhald = innhald + "DATABASE_URL = fil.db\n"
    innhald = innhald + "CUSTOM_FROMFILE = frå_fila\n"
    innhald = innhald + "RATE = 2.5\n"
    innhald = innhald + "BADINT = abc\n"
    innhald = innhald + "BADBOOL = kanskje\n"
    innhald = innhald + "BADFLOAT = 1.2.3\n"
    builtin.fil_skriv(cfg_sti, innhald)

    # Miljø skal vinne over fil for SERVER_PORT; og gje ein vilkårleg env-berre nøkkel.
    builtin.miljo_sett("NORSCODE_APP_SERVER_PORT", "9999")
    builtin.miljo_sett("NORSCODE_APP_MY_CUSTOM", "frå_miljøet")

    la s = cfg.last(cfg_sti)

    # 1) MILJØ VINN OVER FIL
    assert(cfg.hent_int_streng(s, "SERVER_PORT", 0) == 9999)
    assert(cfg.hent(s, "SERVER_PORT", "") == "9999")

    # 2) VILKÅRLEGE NØKLAR
    #    a) frå fil (ikkje i dei 25 faste)
    assert(cfg.hent(s, "CUSTOM_FROMFILE", "") == "frå_fila")
    #    b) berre frå miljø (ikkje i fil, ikkje i dei 25 faste) — lazy oppslag
    assert(cfg.hent(s, "MY_CUSTOM", "") == "frå_miljøet")
    assert(cfg.er_sett(s, "MY_CUSTOM"))

    # 3) TYPA SKJEMA — FEIL VED UGYLDIG VERDI (ikkje stille fallback)
    assert(_kastar_int(s, "BADINT"))
    assert(_kastar_bool(s, "BADBOOL"))
    assert(_kastar_float(s, "BADFLOAT"))
    #    gyldige verdiar kastar ikkje
    assert(cfg.hent_int_streng(s, "SERVER_PORT", 0) == 9999)
    la r = cfg.hent_float_streng(s, "RATE", 0)
    assert(r > 2.4 og r < 2.6)
    #    usett nøkkel → standard (ikkje feil)
    assert(cfg.hent_int_streng(s, "FINST_IKKJE", 42) == 42)

    # 4) valider_skjema: kastar på ugyldig, passerer på gyldig
    la daarleg: ordbok_tekst = {}
    daarleg["BADINT"] = "int"
    assert(_kastar_skjema(s, daarleg))
    la ok_skjema: ordbok_tekst = {}
    ok_skjema["SERVER_PORT"] = "int"
    ok_skjema["RATE"] = "float"
    ok_skjema["CUSTOM_FROMFILE"] = "tekst"
    assert(cfg.valider_skjema(s, ok_skjema) == 0)

    # 5) SECRETS-MAPPE
    la secrets = rot + "/secrets"
    builtin.mkdir_p(secrets)
    builtin.fil_skriv(secrets + "/SECRET_KEY", "hemmeleg-123\n")
    builtin.fil_skriv(secrets + "/DATABASE_URL", "secret.db")
    la s2 = cfg.last_med(cfg_sti, "NORSCODE_APP_", secrets)
    #    secret lesen (trimma) per nøkkel
    assert(cfg.hent(s2, "SECRET_KEY", "") == "hemmeleg-123")
    #    secret overstyrer fil (DATABASE_URL: fil.db → secret.db)
    assert(cfg.hent(s2, "DATABASE_URL", "") == "secret.db")
    #    men miljø overstyrer secret
    builtin.miljo_sett("NORSCODE_APP_DATABASE_URL", "env.db")
    la s3 = cfg.last_med(cfg_sti, "NORSCODE_APP_", secrets)
    assert(cfg.hent(s3, "DATABASE_URL", "") == "env.db")

    skriv("test_innstillingar_env_skjema OK")
    returner 0
}
