bruk std.sha1 som sha1
bruk std.base64 som base64

// Kjent-svar-test: SHA-1 mot RFC 3174 / FIPS 180-4-testvektorane.
//
// std.sha1 er rein pure-VM og er teken med berre for eldre wire-protokollar
// (særleg WebSocket-handshaket, RFC 6455). Denne testen bind både hex-digesten
// og den rå byte-utgangen til publiserte vektorar, pluss den kanoniske
// RFC 6455-handshake-vektoren (base64(SHA1(nøkkel + magic))).

funksjon _str_bytes(s: tekst) -> liste_heiltall {
    la teikn = builtin.split(s, "")
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(teikn) { legg_til(ut, builtin.char_code(teikn[i])) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    // RFC 3174 vektor 1: "abc".
    assert(sha1.hash("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")

    // RFC 3174 vektor 2: 56-teikns fleirblokk-melding.
    assert(sha1.hash("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
        == "84983e441c3bd26ebaae4aa1f95129e5e54670f1")

    // Tom melding (FIPS): berre padding, ei enkelt blokk.
    assert(sha1.hash("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709")

    // Klassisk kontrollmelding.
    assert(sha1.hash("The quick brown fox jumps over the lazy dog")
        == "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12")

    // hash_bytes over ei byte-liste gir same resultat som hash over teksten.
    assert(sha1.hash_bytes(_str_bytes("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d")

    // hash_raw gir 20 rå byte.
    assert(lengde(sha1.hash_raw(_str_bytes("abc"))) == 20)

    // RFC 6455 WebSocket-handshake: Sec-WebSocket-Accept for nøkkelen
    // "dGhlIHNhbXBsZSBub25jZQ==" skal vere "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=".
    la magic = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    la kombinert = "dGhlIHNhbXBsZSBub25jZQ==" + magic
    la aksept = base64.kod_bytes(sha1.hash_raw(_str_bytes(kombinert)))
    assert(aksept == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")

    skriv("test_sha1_rfc3174: OK (7 assertar)\n")
    returner 0
}
