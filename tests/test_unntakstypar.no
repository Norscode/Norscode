# M6 — typa unntak. Verkar i den utsende runtimen (seed): unntak av forma
# "Type: melding" og strukturerte unntak med eit "type"-felt kan fangast med
# `fang (e: Type)`; feil type fell gjennom til ytre handler.

funksjon start() -> heiltall {
    la spor = ""

    # Tekst-unntak med type-prefiks
    prøv {
        kast "FilFeil: fila manglar"
    } fang (e: FilFeil) {
        spor = spor + "A"
    }

    # Feil type blir IKKJE fanga av spesifikk handler → ytre fangar
    prøv {
        prøv {
            kast "NettFeil: brote"
        } fang (e: FilFeil) {
            spor = spor + "X"
        }
    } fang (e) {
        spor = spor + "B"
    }

    # Strukturert unntak med type-felt
    prøv {
        la feil: ordbok_tekst = {}
        feil["type"] = "ValideringsFeil"
        kast feil
    } fang (e: ValideringsFeil) {
        spor = spor + "C"
    }

    # fang utan type fangar alt
    prøv {
        kast "KvaSomHelst: x"
    } fang (e) {
        spor = spor + "D"
    }

    assert_eq(spor, "ABCD")
    skriv("test_unntakstypar OK\n")
    returner 0
}
