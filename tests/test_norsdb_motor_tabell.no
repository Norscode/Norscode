// Fase 4: radlag — tabellar oppå B-tre + record-format, og serialisér→replay
// (checkpoint-mekanismen, fil-uavhengig her). Verifiserer at ein serialisert db
// kan gjenoppbyggast eksakt i ein fersk db, inkl. next_rowid og sletta rader.

bruk std.norsdb_motor som motor

funksjon start() -> heltall {
    la db = motor.db_ny("")   // tom sti → rein in-memory (ingen WAL)

    motor.db_opprett_tabell(db, "folk", [
        {"navn": "navn", "tag": motor.tag_tekst()},
        {"navn": "alder", "tag": motor.tag_int()}
    ])
    motor.db_opprett_tabell(db, "by", [{"navn": "namn", "tag": motor.tag_tekst()}])

    la r1 = motor.db_sett_inn(db, "folk", ["Ada", "37"])
    la r2 = motor.db_sett_inn(db, "folk", ["Linus", "55"])
    la r3 = motor.db_sett_inn(db, "folk", ["Bjørn", "29"])
    motor.db_sett_inn(db, "by", ["Oslo"])
    assert_eq(r1, 1)
    assert_eq(r2, 2)
    assert_eq(r3, 3)

    // Hent + tel
    assert_eq(motor.db_hent(db, "folk", 2)["navn"], "Linus")
    assert_eq(motor.db_tel(db, "folk"), 3)

    // Slett rad 2
    assert(motor.db_slett(db, "folk", 2))
    assert(motor.db_finst(db, "folk", 2) == usann)
    assert_eq(motor.db_tel(db, "folk"), 2)

    // Alle i rowid-orden, sletta hoppa over → Ada(1), Bjørn(3)
    la alle = motor.db_alle(db, "folk")
    assert_eq(lengde(alle), 2)
    assert_eq(alle[0]["navn"], "Ada")
    assert_eq(alle[1]["navn"], "Bjørn")

    // ── Serialiser → replay inn i fersk db ───────────────────────────
    la payload = motor.db_serialiser(db)
    la db2 = motor.db_ny("")
    motor.db_replay(db2, payload)

    assert_eq(motor.db_tel(db2, "folk"), 2)
    assert_eq(motor.db_hent(db2, "folk", 1)["navn"], "Ada")
    assert_eq(motor.db_hent(db2, "folk", 3)["alder"], "29")
    assert_eq(motor.db_tel(db2, "by"), 1)
    assert_eq(motor.db_hent(db2, "by", 1)["namn"], "Oslo")

    // next_rowid bevart gjennom serialisering: neste insert blir 4 (ikkje 3)
    la r4 = motor.db_sett_inn(db2, "folk", ["Alan", "41"])
    assert_eq(r4, 4)

    returner 0
}
