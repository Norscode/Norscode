# R2: kjeldekontrakt for null-fallback-hol som er lukka i seed-bunten.
# Kvart namn her var «ukjent kall → null-fallback» i R1-byggloggen.
bruk std.tekst som t

funksjon start() -> heiltall {
    la vm_src = fil_les("selfhost/vm.no")
    la parser_src = fil_les("selfhost/parser.no")
    la gap_src = fil_les("std/native_gap.no")
    la image_src = fil_les("selfhost/native_execution/embedded_ncb_image.no")

    # vm.no: ingen C-æra-vertskall eller daude armar att.
    assert(ikkje t.inneholder(vm_src, "builtin.ncb_call_fn(\"selfhost.kompiler.kompiler_fil\""))
    assert(t.inneholder(vm_src, "kall_innebygd_web_og_ncb(\"builtin.ncb_call_fn\", [\"selfhost.kompiler.kompiler_fil\", args[0], args[1]], active_functions)"))
    assert(ikkje t.inneholder(vm_src, "returner builtin.exec_prosess("))
    assert(ikkje t.inneholder(vm_src, "returner exec_prosess("))
    assert(t.inneholder(vm_src, "kast \"builtin.exec_prosess er fjerna: bruk builtin.process_spawn_argv\""))
    assert(ikkje t.inneholder(vm_src, "semantic_analyser_rent("))
    assert(ikkje t.inneholder(vm_src, "semantic_ok("))
    assert(ikkje t.inneholder(vm_src, "semantic_rapport("))
    assert(ikkje t.inneholder(vm_src, "wasm_selftest("))
    assert(ikkje t.inneholder(vm_src, "builtin.n("))

    # parser.no: den daude ny_parser (kalla neste_token utan lexer-import) er borte.
    assert(ikkje t.inneholder(parser_src, "funksjon ny_parser("))
    assert(ikkje t.inneholder(parser_src, "neste_token("))

    # native_gap: fail-closed kompiler_fil_aktiv (siste-segment-treff i seeden).
    assert(t.inneholder(gap_src, "funksjon kompiler_fil_aktiv(kjelde, modul_namn)"))
    assert(t.inneholder(gap_src, "krev VM-i-VM / L5b-host"))

    # embedded_ncb_image: ingen C-æra bytes_slice_to_text.
    assert(ikkje t.inneholder(image_src, "bytes_slice_to_text("))
    assert(t.inneholder(image_src, "bytes.utsnitt_til_tekst(buf, heltall(info[\"start\"]), heltall(info[\"length\"]))"))

    skriv("test_null_fallback_hol_kjelde_contract OK\n")
    returner 0
}
