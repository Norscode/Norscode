bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/locale.no")

    assert(t.inneholder(src, "standardiserte miljøvariablane"))
    assert(t.inneholder(src, "builtin.miljo_hent(\"LC_ALL\")"))
    assert(t.inneholder(src, "builtin.miljo_hent(\"LC_CTYPE\")"))
    assert(t.inneholder(src, "builtin.miljo_hent(\"LANG\")"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "locale -k"))

    skriv("test_locale_native_environment OK")
    returner 0
}
