// A0 (app-kjensle): web.request_header og auth.hent_token skil ikkje mellom store
// og små bokstavar i headernamn (RFC 9110 §5.1). nc serve legg headerane i ctx
// slik klienten sende dei («Cookie», «X-CSRF-Token», «If-None-Match»), so eit
// kasussensitivt oppslag gav tom cookie, tom CSRF-token og aldri 304.
// Feilar mot b8e7869 (der fann oppslaget berre små bokstavar eller eksakt nøkkel).
bruk std.web som web
bruk std.auth som auth

funksjon blanda_ctx() -> ordbok_tekst {
    la h: ordbok_tekst = {}
    h["Host"] = "app.norscode.no"
    h["Cookie"] = "session=tok1; nc_demo=ja"
    h["X-CSRF-Token"] = "csrf1"
    h["If-None-Match"] = "\"e1\""
    h["Authorization"] = "Bearer bearer1"
    returner web.request_context("GET", "/", {}, h, "")
}

funksjon start() -> heiltall {
    la ctx = blanda_ctx()
    // Oppslag med små bokstavar mot nøklar med stor forbokstav.
    assert_eq(web.request_header(ctx, "cookie"), "session=tok1; nc_demo=ja")
    assert_eq(web.request_header(ctx, "x-csrf-token"), "csrf1")
    assert_eq(web.request_header(ctx, "if-none-match"), "\"e1\"")
    // Oppslag med anna blanding enn det som vart lagra.
    assert_eq(web.request_header(ctx, "X-Csrf-Token"), "csrf1")
    assert_eq(web.request_header(ctx, "IF-NONE-MATCH"), "\"e1\"")
    assert_eq(web.request_header(ctx, "Cookie"), "session=tok1; nc_demo=ja")
    // Avleidde hjelparar går via request_header.
    assert_eq(web.request_cookie(ctx, "nc_demo"), "ja")
    assert_eq(web.request_cookie(ctx, "session"), "tok1")
    assert_eq(web.auth_header(ctx), "Bearer bearer1")
    // auth.hent_token les cookie og Authorization via web.request_header.
    assert_eq(auth.hent_token(ctx), "tok1")
    la h2: ordbok_tekst = {}
    h2["AUTHORIZATION"] = "Bearer berre-bearer"
    assert_eq(auth.hent_token(web.request_context("GET", "/", {}, h2, "")), "berre-bearer")

    // Nøklar med små bokstavar (web.request_context, HTTP/2) verkar som før.
    la små: ordbok_tekst = {}
    små["x-csrf-token"] = "liten"
    la ctx_små = web.request_context("GET", "/", {}, små, "")
    assert_eq(web.request_header(ctx_små, "X-CSRF-Token"), "liten")
    // Porten seier nei: ein header som ikkje finst gjev tom tekst, òg for eit
    // namn som berre er eit prefiks av ein eksisterande nøkkel.
    assert_eq(web.request_header(ctx, "x-csrf"), "")
    assert_eq(web.request_header(ctx, "origin"), "")
    assert_eq(auth.hent_token(ctx_små), "")
    // ctx utan headerar krasjar ikkje.
    la tom: ordbok_tekst = {}
    tom["__method__"] = "GET"
    assert_eq(web.request_header(tom, "cookie"), "")
    assert_eq(auth.hent_token(tom), "")

    // Eit klientstyrt headernamn over 256 byte: tekst_til_liten heng på slike
    // tekstar på Linux-x86-stage0 (segfault under nc test), og nc serve er
    // eittrådig. Skanninga lowercasar difor berre nøklar med rett lengd.
    la lang = ""
    la li: heiltall = 0
    mens li < 300 {
        lang = lang + "X"
        li = li + 1
    }
    la med_lang: ordbok_tekst = {}
    med_lang[lang] = "1"
    med_lang["Sec-Purpose"] = "prefetch"
    la ctx_lang: ordbok_tekst = {}
    ctx_lang["__headers__"] = med_lang
    assert_eq(web.request_header(ctx_lang, "sec-purpose"), "prefetch")
    assert_eq(web.request_header(ctx_lang, "x-manglar"), "")

    skriv("test_web_request_header OK\n")
    returner 0
}
