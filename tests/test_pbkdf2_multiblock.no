bruk std.krypto som krypto

// PBKDF2-HMAC-SHA256 fleirblokk-nøkkelutleiing (dkLen > 32).
//
// Tidlegare kappa std.krypto.pbkdf2_sha256 output til 1-32 byte (éin
// SHA-256-blokk). Den reine fleirblokk-loopen støttar vilkårleg lengd; denne
// testen låser (a) den kjende éin-blokk-vektoren, (b) at fleirblokk-prefikset
// er konsistent med éin-blokk-utleiinga, og (c) at lengre lengder no er tillatne.

funksjon start() -> heiltall {
    // Kjend vektor: P="password", S="salt", c=1, dkLen=32.
    la ref32 = krypto.pbkdf2_sha256("password", "salt", 1, 32)
    assert(ref32 == "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b")

    // dkLen=64 skal gi 128 hex-teikn (64 byte) — fleirblokk.
    la ut64 = krypto.pbkdf2_sha256("password", "salt", 1, 64)
    assert(lengde(ut64) == 128)

    // Prefikset (blokk 1) skal vere identisk med éin-blokk-utleiinga.
    assert(builtin.slice(ut64, 0, 64) == ref32)

    // 48-byte (halvannan blokk) skal gi 96 hex-teikn og same prefiks.
    la ut48 = krypto.pbkdf2_sha256("password", "salt", 1, 48)
    assert(lengde(ut48) == 96)
    assert(builtin.slice(ut48, 0, 64) == ref32)

    // Over det nye taket (1024 byte) skal framleis avvisast.
    la avvist = usann
    prøv { krypto.pbkdf2_sha256("password", "salt", 1, 1025) } fang (e) { avvist = sann }
    assert(avvist)

    skriv("test_pbkdf2_multiblock: OK (6 assertar)\n")
    returner 0
}
