bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/install_linux_appdir_core.no")
    assert(t.inneholder(src, "bruk std.tarfile som tarfile"))
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "native_fs.native_tempområde"))
    assert(t.inneholder(src, "native_fs.native_erstatt_symbolsk_lenke"))
    assert(t.inneholder(src, "sorter_tekst(filops.lista_katalog(stage_dir))"))
    assert(ikkje t.inneholder(src, "| head -1"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "tar -x"))
    assert(ikkje t.inneholder(src, "find "))
    assert(ikkje t.inneholder(src, "rm -rf"))
    assert(ikkje t.inneholder(src, "ln -s"))
    assert(ikkje t.inneholder(src, "test -d "))

    skriv("test_install_linux_appdir_no_head OK")
    returner 0
}
