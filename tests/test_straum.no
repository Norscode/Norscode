# Test for std.straum (late straumar med kortslutting).
# Teljarar i ordbøker målar kor mange element som faktisk blir trekte, så testen
# prøver latskap og kortslutting, ikkje berre sluttresultatet. Eksplisitte
# samanlikningar (ikkje assert), så testen òg feilar i native AOT.
bruk std.straum som sm
bruk std.valfri som vf
bruk std.iterator som itr

funksjon _lj(l) -> tekst {
    la s = ""
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { s = s + "," }
        s = s + tekst(l[i])
        i = i + 1
    }
    returner s
}

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

# Tel kall og returner x (for kikk/map med sideeffekt).
funksjon _tel(teljar: ordbok, x) {
    teljar["n"] = teljar["n"] + 1
    returner x
}

funksjon _naturlege(teljar: ordbok) -> ordbok {
    returner sm.iterer(1, fun(x) -> _tel(teljar, x + 1))
}

funksjon _neste_i(st: ordbok) -> ordbok {
    la v = st["n"]
    hvis v >= st["stopp"] { returner {"ferdig": sann, "verdi": ingenting} }
    st["n"] = v + 1
    returner {"ferdig": usann, "verdi": v * 10}
}

funksjon _teikn(s: tekst) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(s) {
        legg_til(ut, builtin.slice(s, i, i + 1))
        i = i + 1
    }
    returner ut
}

# 1 som heiltall for "a" og "c", men som tekst for "b": grupper_etter_par skal skilje dei.
funksjon _type_nøkkel(s: tekst) {
    hvis s == "b" { returner "1" }
    returner 1
}

funksjon _kjelder(res: ordbok) {
    _sjekk(res, "frå_liste", _lj(sm.samle(sm.frå_liste([3, 1, 2]))), "3,1,2")
    _sjekk(res, "tom", _lj(sm.samle(sm.tom())) + "|" + tekst(sm.tel(sm.tom())), "|0")
    _sjekk(res, "tom liste", tekst(sm.tel(sm.frå_liste([]))), "0")
    _sjekk(res, "område", _lj(sm.samle(sm.område(-2, 3))), "-2,-1,0,1,2")
    _sjekk(res, "område tomt", _lj(sm.samle(sm.område(5, 5))), "")
    _sjekk(res, "område_inkl", _lj(sm.samle(sm.område_inkl(1, 4))), "1,2,3,4")
    _sjekk(res, "område_steg negativt", _lj(sm.samle(sm.område_steg(10, 0, -3))), "10,7,4,1")
    la steg0 = "nei"
    prøv { sm.område_steg(0, 10, 0) } fang (e) { steg0 = tekst(e) }
    _sjekk(res, "område_steg 0", steg0, "ArgumentFeil: skritt kan ikkje vere 0")
    _sjekk(res, "iterer ta", _lj(sm.samle(sm.ta(sm.iterer(1, fun(x) -> x * 2), 6))), "1,2,4,8,16,32")
    _sjekk(res, "iterer_mens", _lj(sm.samle(sm.iterer_mens(1, fun(x) -> x < 50, fun(x) -> x * 3))), "1,3,9,27")
    la g = {"n": 0}
    _sjekk(res, "generer ta", _lj(sm.samle(sm.ta(sm.generer(fun() -> _tel(g, 7)), 3))) + "|kall=" + tekst(g["n"]), "7,7,7|kall=3")
    la st = {"n": 0, "stopp": 4}
    _sjekk(res, "frå_generator", _lj(sm.samle(sm.frå_generator(fun() -> _neste_i(st)))), "0,10,20,30")
    _sjekk(res, "frå_iterator", _lj(sm.samle(sm.frå_iterator(itr.område(0, 10, 4)))), "0,4,8")
    _sjekk(res, "frå_iterator uendeleg", _lj(sm.samle(sm.ta(sm.frå_iterator(itr.teljar(5, 5)), 3))), "5,10,15")
}

funksjon _adapterar(res: ordbok) {
    la tal = [5, -3, 0, 12, 5, -3, 8, 1]
    _sjekk(res, "map", _lj(sm.samle(sm.map(sm.frå_liste(tal), fun(x) -> x * 2))), "10,-6,0,24,10,-6,16,2")
    _sjekk(res, "filter", _lj(sm.samle(sm.filter(sm.frå_liste(tal), fun(x) -> x > 0))), "5,12,5,8,1")
    _sjekk(res, "filter ingen", _lj(sm.samle(sm.filter(sm.frå_liste(tal), fun(x) -> x > 100))), "")
    _sjekk(res, "ta 0", _lj(sm.samle(sm.ta(sm.frå_liste(tal), 0))), "")
    _sjekk(res, "ta fleire enn finst", _lj(sm.samle(sm.ta(sm.frå_liste([1, 2]), 5))), "1,2")
    _sjekk(res, "hopp", _lj(sm.samle(sm.hopp(sm.frå_liste(tal), 5))), "-3,8,1")
    _sjekk(res, "hopp forbi slutten", _lj(sm.samle(sm.hopp(sm.frå_liste(tal), 50))), "")
    _sjekk(res, "ta_mens", _lj(sm.samle(sm.ta_mens(sm.frå_liste(tal), fun(x) -> x != 0))), "5,-3")
    _sjekk(res, "hopp_mens", _lj(sm.samle(sm.hopp_mens(sm.frå_liste(tal), fun(x) -> x != 0))), "0,12,5,-3,8,1")
    _sjekk(res, "distinkt", _lj(sm.samle(sm.distinkt(sm.frå_liste(tal)))), "5,-3,0,12,8,1")
    _sjekk(res, "distinkt skil type", tekst(sm.tel(sm.distinkt(sm.frå_liste([1, "1", 1, sann, "sann"])))), "4")
    # Samlingar blir samanlikna på innhald (tekst(v) er "[verdi]" for alle lister og ordbøker).
    _sjekk(res, "distinkt lister", tekst(sm.tel(sm.distinkt(sm.frå_liste([[1, 2], [3, 4], [5], [1, 2], ["1", "2"]])))), "4")
    _sjekk(res, "distinkt ordbøker", tekst(sm.tel(sm.distinkt(sm.frå_liste([{"a": 1}, {"b": 2}, {"a": 1}, {"a": 1, "b": 2}, {"b": 2, "a": 1}])))), "3")
    _sjekk(res, "distinkt samlingar vis", sm.samle_tekst(sm.distinkt(sm.frå_liste([[1], [2], [1], {"k": [1]}, {"k": [1]}, []])), " "), "[1] [2] {k=[1]} []")
    _sjekk(res, "sortert", _lj(sm.samle(sm.sortert(sm.frå_liste(tal)))), "-3,-3,0,1,5,5,8,12")
    _sjekk(res, "sortert_synkande", _lj(sm.samle(sm.sortert_synkande(sm.frå_liste(tal)))), "12,8,5,5,1,0,-3,-3")
    _sjekk(res, "sortert tekst", _lj(sm.samle(sm.sortert(sm.frå_liste(["pære", "eple", "ål", "banan"])))), "banan,eple,pære,ål")
    # Stabil: lik lengd held innbyrdes rekkjefølgje.
    la ord = ["ccc", "b", "aa", "d", "bb", "a"]
    _sjekk(res, "sortert_med stabil", _lj(sm.samle(sm.sortert_med(sm.frå_liste(ord), fun(a, b) -> lengde(a) - lengde(b)))), "b,d,a,aa,bb,ccc")
    _sjekk(res, "sortert tom", _lj(sm.samle(sm.sortert(sm.tom()))), "")
    _sjekk(res, "flat_map liste", _lj(sm.samle(sm.flat_map(sm.frå_liste([1, 0, 3]), fun(x) -> sm.samle(sm.ta(sm.iterer(x, fun(y) -> y), x))))), "1,3,3,3")
    _sjekk(res, "flat_map straum", _lj(sm.samle(sm.flat_map(sm.frå_liste(["ab", "", "c"]), fun(s) -> sm.frå_liste(_teikn(s))))), "a,b,c")
    _sjekk(res, "kjede", _lj(sm.samle(sm.kjede(sm.frå_liste([1, 2]), sm.område(7, 9)))), "1,2,7,8")
    _sjekk(res, "kjede tom først", _lj(sm.samle(sm.kjede(sm.tom(), sm.frå_liste([4])))), "4")
    _sjekk(res, "zip", _lj(sm.samle(sm.zip(sm.frå_liste(["a", "b", "c"]), sm.iterer(1, fun(x) -> x + 1), fun(a, b) -> a + tekst(b)))), "a1,b2,c3")
    la k = {"n": 0}
    _sjekk(res, "kikk", _lj(sm.samle(sm.kikk(sm.frå_liste([4, 5]), fun(x) -> _tel(k, x)))) + "|" + tekst(k["n"]), "4,5|2")
}

funksjon _latskap(res: ordbok) {
    # Ingenting blir trekt før terminaloperasjonen.
    la t = {"n": 0}
    la kjede = sm.map(sm.kikk(sm.frå_liste([1, 2, 3]), fun(x) -> _tel(t, x)), fun(x) -> x * 10)
    _sjekk(res, "lat før terminal", tekst(t["n"]), "0")
    _sjekk(res, "lat etter terminal", _lj(sm.samle(kjede)) + "|" + tekst(t["n"]), "10,20,30|3")

    # Uendeleg kjelde -> filter -> map -> ta(4): trekkjer berre det som trengst.
    la n = {"n": 0}
    la kvadrat = sm.samle(sm.ta(sm.map(sm.filter(_naturlege(n), fun(x) -> x % 2 == 0), fun(x) -> x * x), 4))
    _sjekk(res, "uendeleg kjede", _lj(kvadrat), "4,16,36,64")
    # iterer kallar f éin gong per element etter frøet: 1..8 = 7 kall.
    _sjekk(res, "uendeleg kjede trekk", tekst(n["n"]), "7")

    # finn_første kortsluttar.
    la f = {"n": 0}
    la første = sm.finn_første(sm.filter(sm.kikk(sm.område(0, 1000000), fun(x) -> _tel(f, x)), fun(x) -> x > 2))
    _sjekk(res, "finn_første", vf.til_tekst(første) + "|trekk=" + tekst(f["n"]), "Valfri[3]|trekk=4")
    _sjekk(res, "finn_første tom", vf.til_tekst(sm.finn_første(sm.tom())), "Valfri.tom")
    _sjekk(res, "finn", vf.til_tekst(sm.finn(sm.frå_liste([1, 8, 9]), fun(x) -> x > 5)) + " " + vf.til_tekst(sm.finn(sm.frå_liste([1]), fun(x) -> x > 5)), "Valfri[8] Valfri.tom")

    # nokon / alle / ingen kortsluttar.
    la a = {"n": 0}
    _sjekk(res, "nokon", tekst(sm.nokon(sm.kikk(sm.iterer(1, fun(x) -> x + 1), fun(x) -> _tel(a, x)), fun(x) -> x == 5)) + "|trekk=" + tekst(a["n"]), "sann|trekk=5")
    la b = {"n": 0}
    _sjekk(res, "alle kortsluttar", tekst(sm.alle(sm.kikk(sm.iterer(1, fun(x) -> x + 1), fun(x) -> _tel(b, x)), fun(x) -> x < 3)) + "|trekk=" + tekst(b["n"]), "usann|trekk=3")
    _sjekk(res, "alle sann", tekst(sm.alle(sm.frå_liste([2, 4]), fun(x) -> x % 2 == 0)), "sann")
    _sjekk(res, "alle tom", tekst(sm.alle(sm.tom(), fun(x) -> usann)) + tekst(sm.nokon(sm.tom(), fun(x) -> sann)), "sannusann")
    _sjekk(res, "ingen", tekst(sm.ingen(sm.frå_liste([1, 3]), fun(x) -> x % 2 == 0)) + tekst(sm.ingen(sm.frå_liste([1, 2]), fun(x) -> x % 2 == 0)), "sannusann")
    _sjekk(res, "any/all alias", tekst(sm.any(sm.frå_liste([1, 2]), fun(x) -> x > 1)) + tekst(sm.all(sm.frå_liste([1, 2]), fun(x) -> x > 1)), "sannusann")

    # ta_mens stoppar uendeleg kjelde; ta(0) trekkjer ingenting.
    la c = {"n": 0}
    _sjekk(res, "ta_mens uendeleg", _lj(sm.samle(sm.ta_mens(sm.kikk(sm.iterer(1, fun(x) -> x * 2), fun(x) -> _tel(c, x)), fun(x) -> x < 20))) + "|trekk=" + tekst(c["n"]), "1,2,4,8,16|trekk=6")
    la d = {"n": 0}
    _sjekk(res, "ta 0 trekkjer ikkje", tekst(sm.tel(sm.ta(sm.kikk(sm.iterer(1, fun(x) -> x + 1), fun(x) -> _tel(d, x)), 0))) + "|trekk=" + tekst(d["n"]), "0|trekk=0")

    # sortert er ein barriere: heile kjelda blir trekt ved første element.
    la e = {"n": 0}
    la ss = sm.sortert(sm.kikk(sm.frå_liste([3, 1, 2]), fun(x) -> _tel(e, x)))
    la skritt = sm.neste(ss)
    _sjekk(res, "sortert barriere", tekst(skritt["verdi"]) + "|trekk=" + tekst(e["n"]), "1|trekk=3")
    _sjekk(res, "neste til slutt", tekst(sm.neste(ss)["verdi"]) + tekst(sm.neste(ss)["verdi"]) + tekst(sm.neste(ss)["ferdig"]), "23sann")
}

funksjon _terminal(res: ordbok) {
    _sjekk(res, "reduser", tekst(sm.reduser(sm.område_inkl(1, 10), fun(a, x) -> a + x, 0)), "55")
    _sjekk(res, "reduser tom", tekst(sm.reduser(sm.tom(), fun(a, x) -> a + x, -1)), "-1")
    _sjekk(res, "reduser_valfri", vf.til_tekst(sm.reduser_valfri(sm.frå_liste([2, 3, 4]), fun(a, x) -> a * x)) + " " + vf.til_tekst(sm.reduser_valfri(sm.tom(), fun(a, x) -> a * x)), "Valfri[24] Valfri.tom")
    _sjekk(res, "sum", tekst(sm.sum(sm.frå_liste([5, -3, 0, 12]))) + "," + tekst(sm.sum(sm.tom())), "14,0")
    _sjekk(res, "tel", tekst(sm.tel(sm.filter(sm.område(0, 100), fun(x) -> x % 7 == 0))), "15")
    _sjekk(res, "samle_tekst", sm.samle_tekst(sm.frå_liste(["a", 1, "b"]), ", ") + "|" + sm.samle_tekst(sm.tom(), ","), "a, 1, b|")
    _sjekk(res, "min/maks", vf.til_tekst(sm.min(sm.frå_liste([5, -3, 0, 12]))) + " " + vf.til_tekst(sm.maks(sm.frå_liste([5, -3, 0, 12]))), "Valfri[-3] Valfri[12]")
    _sjekk(res, "min tom", vf.til_tekst(sm.min(sm.tom())), "Valfri.tom")
    _sjekk(res, "min_med/maks_med", vf.til_tekst(sm.min_med(sm.frå_liste(["ccc", "a", "bb"]), fun(a, b) -> lengde(a) - lengde(b))) + " " + vf.til_tekst(sm.maks_med(sm.frå_liste(["ccc", "a", "bb"]), fun(a, b) -> lengde(a) - lengde(b))), "Valfri[a] Valfri[ccc]")
    la logg = {"n": 0}
    sm.for_kvar(sm.frå_liste([1, 2, 3]), fun(x) -> _tel(logg, x))
    _sjekk(res, "for_kvar", tekst(logg["n"]), "3")
    la g = sm.grupper_etter(sm.frå_liste(["eple", "ab", "epla", "kiwi", "x"]), fun(s) -> lengde(s))
    _sjekk(res, "grupper_etter", _lj(g["4"]) + "|" + _lj(g["2"]) + "|" + _lj(g["1"]) + "|" + tekst(lengde(nøkler(g))), "eple,epla,kiwi|ab|x|3")
    la gl = sm.grupper_etter(sm.frå_liste(["ab", "cd", "xyz"]), fun(s) -> [lengde(s)])
    _sjekk(res, "grupper_etter liste-nøkkel", tekst(lengde(nøkler(gl))) + "|" + _lj(gl["[2]"]) + "|" + _lj(gl["[3]"]), "2|ab,cd|xyz")
    la gp = sm.grupper_etter_par(sm.frå_liste([1, 2, 3, 4, 5, 6]), fun(x) -> [x % 2, x % 3 == 0])
    _sjekk(res, "grupper_etter_par", sm.samle_tekst(sm.frå_liste(gp), ";"), "[[1, usann], [1, 5]];[[0, usann], [2, 4]];[[1, sann], [3]];[[0, sann], [6]]")
    la gt = sm.grupper_etter_par(sm.frå_liste(["a", "b", "c"]), fun(s) -> _type_nøkkel(s))
    _sjekk(res, "grupper_etter_par skil type", tekst(lengde(gt)) + "|" + sm.samle_tekst(sm.frå_liste(gt), ";"), "2|[1, [a, c]];[1, [b]]")
    _sjekk(res, "grupper_etter_par tom", tekst(lengde(sm.grupper_etter_par(sm.tom(), fun(x) -> x))), "0")
    _sjekk(res, "samle_tekst samlingar", sm.samle_tekst(sm.frå_liste([[1, 2], {"a": "b"}, "x"]), "|"), "[1, 2]|{a=b}|x")

    # Einskapsbruk: ein straum kan ikkje brukast to gonger.
    la s = sm.frå_liste([1, 2])
    sm.samle(s)
    la brukt = "nei"
    prøv { sm.samle(s) } fang (e) { brukt = tekst(e) }
    _sjekk(res, "brukt to gonger", brukt, "TilstandsFeil: straumen er alt brukt eller lukka")
    la s2 = sm.frå_liste([1])
    sm.map(s2, fun(x) -> x)
    la brukt2 = "nei"
    prøv { sm.filter(s2, fun(x) -> sann) } fang (e) { brukt2 = tekst(e) }
    _sjekk(res, "adapter på brukt straum", brukt2, "TilstandsFeil: straumen er alt brukt eller lukka")
    la feil_type = "nei"
    prøv { sm.samle(sm.flat_map(sm.frå_liste([1]), fun(x) -> x)) } fang (e) { feil_type = tekst(e) }
    _sjekk(res, "flat_map feil type", feil_type, "TypeFeil: flat_map-funksjonen må returnere ei liste eller ein straum")
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}
    _kjelder(res)
    _adapterar(res)
    _latskap(res)
    _terminal(res)
    hvis res["feil"] != 0 {
        skriv("test_straum FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_straum OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
