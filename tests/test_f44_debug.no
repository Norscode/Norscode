# F44: nc debug — brytepunkt på linje, steg/neste/skriv/lokale/stakk, fortset.

bruk tools.nc_debug som dbg

funksjon start() -> heiltall {
    prøv { builtin.mkdir("build/f44") } fang (e) { }
    builtin.fil_skriv("build/f44/dbg_prog.no", "funksjon dobl(x: heltall) -> heltall {\n    la y = x * 2\n    returner y\n}\nfunksjon start() -> heltall {\n    la a = 5\n    la b = dobl(a)\n    la c = b + 1\n    returner c\n}\n")
    builtin.fil_skriv("build/f44/dbg_kmd.txt", "lokale\nneste\nskriv a\nsteg\nstakk\nskriv x\nneste\nneste\nlokale\nfortset\n")
    miljo_sett("NC_VERKTOY_ARGV", "build/f44/dbg_prog.no\n--bryt\nbuild/f44/dbg_prog.no:6\n--kommandoar\nbuild/f44/dbg_kmd.txt")
    assert_eq(dbg.start(), 0)
    la ut = dbg.u_logg()
    builtin.fil_skriv("build/f44/transkript.txt", ut)
    # Stopp på brytepunkt-linje 6 (først).
    assert_inneholder(ut, "→ __main__.start linje 6: la a = 5")
    # neste → linje 7; a er sett (5) etter at linje 6 er utført.
    assert_inneholder(ut, "→ __main__.start linje 7: la b = dobl(a)")
    assert_inneholder(ut, "a = 5")
    # steg inn i dobl, stakk viser begge ramma, x = 5 der.
    assert_inneholder(ut, "→ __main__.dobl linje 2: la y = x * 2")
    assert_inneholder(ut, "#0 __main__.dobl linje 2")
    assert_inneholder(ut, "#1 __main__.start linje 7")
    assert_inneholder(ut, "x = 5")
    # neste i dobl → linje 3; neste frå linje 3 returnerer til kallaren (linje 7, b ikkje lagra enno).
    assert_inneholder(ut, "→ __main__.dobl linje 3: returner y")
    assert_inneholder(ut, "(nc-debug) neste\n→ __main__.start linje 7: la b = dobl(a)\n(nc-debug) lokale\n  a = 5\n")
    assert_inneholder(ut, "programmet er ferdig (resultat 11)")
    returner 0
}
