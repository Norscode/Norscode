bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/nc_regen_bootstrap.no")
    la cli = fil_les("selfhost/nc_main.no")

    assert(t.inneholder(src, "funksjon normaliser_ncb(root: tekst, nc: tekst, sti: tekst) -> bool"))
    assert(t.inneholder(src, "\"NORSCODE_NCB_NORMALIZE_IN\": sti"))
    assert(t.inneholder(src, "\"NORSCODE_NCB_NORMALIZE_OUT\": sti"))
    assert(t.inneholder(src, "tools/ncb_normalize_builtin_aliases_v802.no"))
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(t.inneholder(src, "Oppdaterer VM-precompiled NCB"))
    assert(t.inneholder(src, "[\"compile\", \"selfhost/vm.no\", \"bootstrap/precompiled/vm.ncb.json\"]"))
    assert(t.inneholder(src, "normaliser_ncb(root, nc, root + \"/bootstrap/precompiled/vm.ncb.json\")"))
    assert(t.inneholder(cli, "hvis cmd == \"regen-bootstrap\" eller cmd == \"bootstrap-regen\""))
    assert(t.inneholder(cli, "bruk: nc regen-bootstrap [--full]"))
    assert(t.inneholder(cli, "miljo_sett(\"NORSCODE_REGEN_BOOTSTRAP_FULL\", \"1\")"))
    assert(t.inneholder(cli, "returner \"tools/nc_regen_bootstrap.no\""))
    assert(ikkje t.inneholder(cli, "exec sh"))

    skriv("test_regen_bootstrap_vm_host_compat OK")
    returner 0
}
