bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/update_stage0_manifest.no")

    assert(t.inneholder(src, "funksjon stage0_seed_files(root: tekst) -> liste_tekst"))
    assert(t.inneholder(src, "funksjon skriv_manifest(root: tekst) -> bool"))
    assert(t.inneholder(src, "filops.lista_katalog(dir)"))
    assert(t.inneholder(src, "builtin.sha256_bytes(bytes)"))
    assert(t.inneholder(src, "sha256.hash_bytes(bytes)"))
    assert(t.inneholder(src, "liste.sorter_tekst"))
    assert(t.inneholder(src, "builtin.fil_skriv"))
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "bruk std.sha256 som sha256"))
    assert(t.inneholder(src, "returner miljo_hent(namn)"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "shasum"))
    assert(ikkje t.inneholder(src, "sha256sum"))
    assert(ikkje t.inneholder(src, "NORSCODE_STAGE0_MANIFEST_INPUT"))
    assert(ikkje t.inneholder(src, "sed "))
    assert(ikkje t.inneholder(src, "awk"))
    assert(ikkje t.inneholder(src, "sort "))
    assert(ikkje t.inneholder(src, "basename "))
    assert(ikkje fil_finnes("tools/update_stage0_manifest.sh"))

    skriv("test_update_stage0_manifest_no_shell OK")
    returner 0
}
