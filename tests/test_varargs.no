# M10 — varargs: funksjon f(...rest) samlar resten av argumenta i ei liste.
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # Berre rest: summer alle argumenta
    la p1 = "funksjon sum(...tal) -> heltall {\n" +
        "    la s: heltall = 0\n" +
        "    for t i tal { s = s + t }\n" +
        "    returner s\n" +
        "}\n" +
        "funksjon start() -> heltall { returner sum(1, 2, 3, 4) }\n"
    assert_eq(utfor(p1), "10")

    # Fast + rest
    la p2 = "funksjon f(fyrste: heltall, ...resten) -> heltall {\n" +
        "    returner fyrste * 100 + lengde(resten)\n" +
        "}\n" +
        "funksjon start() -> heltall { returner f(7, 1, 2, 3) }\n"
    assert_eq(utfor(p2), "703")

    # Rest kan vere tom
    la p3 = "funksjon f(fyrste: heltall, ...resten) -> heltall {\n" +
        "    returner fyrste * 100 + lengde(resten)\n" +
        "}\n" +
        "funksjon start() -> heltall { returner f(9) }\n"
    assert_eq(utfor(p3), "900")

    # Rest-elementa er tilgjengelege
    la p4 = "funksjon f(...xs) -> heltall { returner xs[0] * 10 + xs[2] }\n" +
        "funksjon start() -> heltall { returner f(5, 6, 7) }\n"
    assert_eq(utfor(p4), "57")

    skriv("test_varargs OK\n")
    returner 0
}
