bruk std.runtime_filesystem som fs

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_BINARY_FILESYSTEM_LIVE") != "1" {
        skriv("test_native_filesystem_binary_stream: krev eksplisitt kandidatattestasjon")
        returner 0
    }
    la sti = "build/runtime-fs-binary-stream.bin"
    la venta = builtin.bytes_from_list([0, 255, 17, 64, 128, 10])
    builtin.fil_skriv_binær(sti, venta)
    la h = fs.opne_native("build", "runtime-fs-binary-stream.bin", "read")
    assert(h["status"] == "open")
    la a = fs.native_les_binær(h, 2)
    la b = fs.native_les_binær(h, 3)
    la c = fs.native_les_binær(h, 8)
    la eof = fs.native_les_binær(h, 8)
    assert(a["status"] == "ok" og a["value"] == 2)
    assert(b["status"] == "ok" og b["value"] == 3)
    assert(c["status"] == "ok" og c["value"] == 1)
    assert(eof["status"] == "ok" og eof["value"] == 0)
    assert(a["data_bytes"] == builtin.bytes_from_list([0, 255]))
    assert(b["data_bytes"] == builtin.bytes_from_list([17, 64, 128]))
    assert(c["data_bytes"] == builtin.bytes_from_list([10]))
    assert(eof["data_bytes"] == builtin.bytes_from_list([]))
    assert(fs.native_lukk(h)["status"] == "closed")
    assert(fs.native_slett("build", "runtime-fs-binary-stream.bin")["status"] == "deleted")
    skriv("test_native_filesystem_binary_stream OK")
    returner 0
}
