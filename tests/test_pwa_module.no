// std.pwa: manifest, service worker og head-taggar som rein tekst frå Norscode.
bruk std.pwa som pwa
bruk std.json som json

funksjon start() -> heiltall {
    // Manifest: gyldig JSON med rette felt.
    la m = pwa.manifest_json("Norscode Helpdesk", "Helpdesk", "/", "/", "#04060a", "#04060a", "/assets/ikon.svg", "image/svg+xml")
    la data = json.parse(m)
    assert(json.hent_tekst(data, "name") == "Norscode Helpdesk")
    assert(json.hent_tekst(data, "short_name") == "Helpdesk")
    assert(json.hent_tekst(data, "start_url") == "/")
    assert(json.hent_tekst(data, "display") == "standalone")
    assert(json.hent_tekst(data, "theme_color") == "#04060a")
    assert(builtin.contains(m, "\"icons\":[{\"src\":\"/assets/ikon.svg\",\"sizes\":\"any\",\"type\":\"image/svg+xml\",\"purpose\":\"any\"}"))
    assert(builtin.contains(m, "\"purpose\":\"maskable\""))
    // Hermeteikn i namn blir ikkje til ugyldig JSON.
    la m2 = pwa.manifest_json("App \"X\"", "X", "/", "/", "#000", "#000", "/i.svg", "image/svg+xml")
    assert(json.hent_tekst(json.parse(m2), "name") == "App 'X'")

    la ms = pwa.manifest_response("A", "A", "/", "/", "#000", "#000", "/i.svg", "image/svg+xml")
    assert(tekst(ms["status"]) == "200")
    assert(builtin.starts_with(ms["headers"]["content-type"], "application/manifest+json"))

    // Service worker: install/activate/fetch, precache-liste, prefiks og offline-side.
    la sw = pwa.service_worker_js("helpdesk-v3", ["/", "/assets/app.css", "/offline"], "/assets/", "/offline")
    assert(builtin.contains(sw, "var CACHE='helpdesk-v3';"))
    assert(builtin.contains(sw, "var PRECACHE=['/','/assets/app.css','/offline'];"))
    assert(builtin.contains(sw, "var PREFIX='/assets/';"))
    assert(builtin.contains(sw, "var OFFLINE='/offline';"))
    assert(builtin.contains(sw, "addEventListener('install'"))
    assert(builtin.contains(sw, "addEventListener('activate'"))
    assert(builtin.contains(sw, "addEventListener('fetch'"))
    assert(builtin.contains(sw, "req.method!=='GET'"))
    assert(builtin.contains(sw, "skipWaiting"))
    assert(builtin.contains(sw, "clients.claim"))
    assert(ikkje builtin.contains(sw, "\\"))
    assert(ikkje builtin.contains(sw, "\""))
    la sws = pwa.service_worker_response("v1", [], "/assets/", "")
    assert(builtin.starts_with(sws["headers"]["content-type"], "application/javascript"))
    assert(sws["headers"]["cache-control"] == "no-cache")

    // Head-taggar og registrering.
    la head = pwa.head_tags("/manifest.webmanifest", "#04060a", "/assets/ikon.svg")
    assert(builtin.contains(head, "<link rel=\"manifest\" href=\"/manifest.webmanifest\">"))
    assert(builtin.contains(head, "<meta name=\"theme-color\" content=\"#04060a\">"))
    assert(builtin.contains(head, "<link rel=\"apple-touch-icon\" href=\"/assets/ikon.svg\">"))
    la reg = pwa.register_js("/sw.js")
    assert(builtin.contains(reg, "navigator.serviceWorker.register('/sw.js')"))
    assert(pwa.register_inline("/sw.js") == "<script>" + reg + "</script>")
    assert(pwa.register_script_tag("/assets/pwa.js") == "<script src=\"/assets/pwa.js\" defer></script>")
    la rs = pwa.register_response("/sw.js")
    assert(rs["body"] == reg)

    skriv("test_pwa_module OK\n")
    returner 0
}
