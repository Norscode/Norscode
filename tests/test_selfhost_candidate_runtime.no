// Ein kandidat skal vere både den køyrde binæren og den som vidare barn vel.
// Ei fysisk kopi avslører fallback til dist, sjølv om begge har same innhald.
bruk tools.nc_test som løpar
bruk tools.process_runner som prosess
bruk std.filops som filops

funksjon barn(root: tekst, native: tekst, venta: tekst) {
    la miljø = løpar.runtime_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tests/fixtures/candidate_runtime_child.no"
    miljø["NORSCODE_VM_FAST"] = "1"
    miljø["NORSCODE_VM_CAPABILITIES"] = "env.read,disk.read"
    miljø["NORSCODE_VM_TARGET_CAPABILITIES"] = "env.read,disk.read"
    miljø["NORSCODE_NATIVE_BIN"] = root + "/build/feil-kandidat-skal-ikkje-brukast"
    miljø["NC_RUNNER_EXPECTED_NATIVE"] = venta
    la svar = løpar.køyr_native(root, native, miljø, "30")
    hvis ikkje løpar.ok(svar) {
        skriv("kandidatbarn exit=" + svar[0] + "\n" + svar[1] + "\n" + svar[2] + "\n")
    }
    assert(løpar.ok(svar))
    assert(builtin.contains(svar[1], "candidate-executable=" + venta + "\n"))
    assert(builtin.contains(svar[1], "candidate-env=" + venta + "\n"))
}

funksjon differensial(root: tekst, runtime: tekst, kandidat: tekst, target: tekst, gyldig: boolsk) {
    la miljø = løpar.runtime_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/differensial_sele.no"
    miljø["NORSCODE_VM_FAST"] = "1"
    miljø["NORSCODE_VM_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
    miljø["NORSCODE_VM_TARGET_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
    miljø["NORSCODE_NATIVE_BIN"] = kandidat
    miljø["NORSCODE_DIFF_FILE"] = root + "/tools/fixtures/diff_smoke.no"
    miljø["NORSCODE_DIFF_TARGET"] = target
    miljø["NORSCODE_DIFF_STRICT"] = "1"
    miljø["NORSCODE_DIFF_EXPECT"] = "42"
    la svar = prosess.køyr(runtime, [], root, miljø, 120000)
    prosess.skriv_resultat(svar)
    assert_eq(tekst(svar["status"]), "ferdig")
    hvis gyldig {
        assert(prosess.ok(svar))
        assert(builtin.contains(tekst(svar["stdout"]), "[OK] tolk == AOT"))
    } ellers {
        assert_eq(tekst(svar["exit_code"]), "1")
        assert(builtin.contains(tekst(svar["stdout"]), "[FEIL] AOT-steget feila ved bygg-native"))
    }
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la relativ = "build/runner-candidate-" + builtin.random_hex(8)
    la dir = root + "/" + relativ
    la kandidat = dir + "/candidate-renamed"
    assert(filops.lag_katalogar(dir))
    assert(filops.kopier2(tekst(info["executable"]), kandidat))
    barn(root, "./" + relativ + "/candidate-renamed", kandidat)
    barn(root, relativ + "/candidate-renamed", kandidat)
    barn(root, kandidat, kandidat)
    // Ei manglande eksplisitt kandidat må avvisast, sjølv om bin/nc fungerer.
    // Den gyldige kandidaten har med vilje eit ukjent namn: arva NORSCODE_CMD
    // skal ikkje starte differensialverktøyet rekursivt under bygg-native.
    la system = tekst(info["system"])
    la maskin = tekst(info["machine"])
    la arm64 = maskin == "arm64" eller maskin == "aarch64"
    la x86_64 = maskin == "x86_64" eller maskin == "amd64"
    la target = "linux-x86_64"
    hvis system == "Darwin" og arm64 { target = "macos-arm64" }
    ellers hvis system == "Linux" og arm64 { target = "linux-arm64" }
    differensial(root, tekst(info["executable"]), dir + "/missing-candidate", target, usann)
    // Repoet har native vertscodegen for Linux x86-64 og macOS ARM64.
    // Linux ARM64 skal framleis bevise identitet og avvising av manglande
    // kandidat, utan å starte ein tolka codegen som kan ta 30–95 minutt.
    hvis (system == "Linux" og x86_64) eller (system == "Darwin" og arm64) {
        differensial(root, tekst(info["executable"]), "./" + relativ + "/candidate-renamed", target, sann)
        differensial(root, tekst(info["executable"]), kandidat, target, sann)
        differensial(root, kandidat, "", target, sann)
    } ellers {
        skriv("Positiv AOT-samanlikning ikkje tilgjengeleg utan native vertscodegen (" + system + "/" + maskin + ").\n")
    }
    assert(filops.slett_tre(dir))
    skriv("test_selfhost_candidate_runtime OK (relativ, absolutt og differensial-kandidat)\n")
    returner 0
}
