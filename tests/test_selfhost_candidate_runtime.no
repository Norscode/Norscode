// Ein kandidat skal vere både den køyrde binæren og den som vidare barn vel.
// Ei fysisk kopi avslører fallback til dist, sjølv om begge har same innhald.
bruk tools.nc_test som løpar
bruk tools.process_runner som prosess
bruk std.filops som filops

funksjon krev(vilkår: boolsk, melding: tekst) {
    hvis ikkje vilkår { kast "kandidatruntime: " + melding }
}

funksjon prosessdiagnose(svar: ordbok) -> tekst {
    la feil = ""
    hvis finnes_nøkkel(svar, "error") { feil = tekst(svar["error"]) }
    returner "status=" + tekst(svar["status"]) + " exit=" + tekst(svar["exit_code"]) +
        " error=" + feil + " stdout=" + builtin.replace(tekst(svar["stdout"]), "\n", " | ") +
        " stderr=" + builtin.replace(tekst(svar["stderr"]), "\n", " | ")
}

funksjon barn(root: tekst, native: tekst, venta: tekst) {
    la miljø = løpar.runtime_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tests/fixtures/candidate_runtime_child.no"
    miljø["NORSCODE_VM_FAST"] = "1"
    miljø["NORSCODE_VM_CAPABILITIES"] = "env.read,disk.read"
    miljø["NORSCODE_VM_TARGET_CAPABILITIES"] = "env.read,disk.read"
    miljø["NORSCODE_NATIVE_BIN"] = root + "/build/feil-kandidat-skal-ikkje-brukast"
    miljø["NC_RUNNER_EXPECTED_NATIVE"] = venta
    la svar = løpar.køyr_native(root, native, miljø, "30")
    hvis ikkje løpar.ok(svar) {
        skriv("kandidatbarn exit=" + svar[0] + "\n" + svar[1] + "\n" + svar[2] + "\n")
    }
    la diagnose = "barn=" + native + " venta=" + venta + " exit=" + svar[0] +
        " stdout=" + builtin.replace(svar[1], "\n", " | ") +
        " stderr=" + builtin.replace(svar[2], "\n", " | ")
    krev(løpar.ok(svar), "identitetsbarn feila: " + diagnose)
    krev(builtin.contains(svar[1], "candidate-executable=" + venta + "\n"),
        "feil executable i identitetsbarn: " + diagnose)
    krev(builtin.contains(svar[1], "candidate-env=" + venta + "\n"),
        "feil NORSCODE_NATIVE_BIN i identitetsbarn: " + diagnose)
}

funksjon differensial(root: tekst, runtime: tekst, kandidat: tekst,
                      target: tekst, fasit: tekst, strikt: tekst) -> ordbok {
    la miljø = løpar.runtime_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/differensial_sele.no"
    miljø["NORSCODE_OUTPUT"] = root + "/build/skal-ikkje-faa-differensial-ncb"
    miljø["NORSCODE_VM_FAST"] = "1"
    miljø["NORSCODE_VM_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
    miljø["NORSCODE_VM_TARGET_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
    miljø["NORSCODE_NATIVE_BIN"] = kandidat
    miljø["NORSCODE_DIFF_FILE"] = root + "/tools/fixtures/diff_smoke.no"
    miljø["NORSCODE_DIFF_TARGET"] = target
    miljø["NORSCODE_DIFF_STRICT"] = strikt
    miljø["NORSCODE_DIFF_EXPECT"] = fasit
    // Barnets compile må velje JSON, sjølv om forelderen har binær-NCB som val.
    miljø["NORSCODE_NCB_BINARY"] = "1"
    returner prosess.køyr(runtime, [], root, miljø, 120000)
}

funksjon krev_differensial(svar: ordbok, kandidat: tekst, kode: tekst,
                           markør: tekst, tilfelle: tekst) {
    prosess.skriv_resultat(svar)
    la diagnose = tilfelle + ": " + prosessdiagnose(svar)
    krev(tekst(svar["status"]) == "ferdig", "differensialen fullførte ikkje: " + diagnose)
    krev(tekst(svar["exit_code"]) == kode,
        "differensialen venta exit=" + kode + ": " + diagnose)
    krev(builtin.contains(tekst(svar["stdout"]), "  kandidat = " + kandidat + "\n"),
        "differensialen valde feil kandidat, venta " + kandidat + ": " + diagnose)
    krev(builtin.contains(tekst(svar["stdout"]), markør),
        "differensialen manglar markør '" + markør + "': " + diagnose)
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la relativ = "build/runner-candidate-" + builtin.random_hex(8)
    la dir = root + "/" + relativ
    la kandidat = dir + "/candidate-renamed"
    krev(filops.lag_katalogar(dir), "klarte ikkje lage " + dir)
    krev(filops.kopier2(tekst(info["executable"]), kandidat), "klarte ikkje kopiere til " + kandidat)
    barn(root, "./" + relativ + "/candidate-renamed", kandidat)
    barn(root, relativ + "/candidate-renamed", kandidat)
    barn(root, kandidat, kandidat)
    // Ei manglande eksplisitt kandidat må avvisast, sjølv om bin/nc fungerer.
    // Den gyldige kandidaten har med vilje eit ukjent namn: arva NORSCODE_CMD
    // skal ikkje starte differensialverktøyet rekursivt under compile/bygg-native.
    la system = tekst(info["system"])
    la maskin = tekst(info["machine"])
    la arm64 = maskin == "arm64" eller maskin == "aarch64"
    la x86_64 = maskin == "x86_64" eller maskin == "amd64"
    la target = "linux-x86_64"
    hvis system == "Darwin" og arm64 { target = "macos-arm64" }
    ellers hvis system == "Linux" og arm64 { target = "linux-arm64" }
    la runtime = tekst(info["executable"])
    la manglar = dir + "/missing-candidate"
    for strikt i ["1", "0"] {
        la svar = differensial(root, runtime, manglar, target, "42", strikt)
        krev_differensial(svar, manglar, "1", "[FEIL] NCB-steget feila ved compile",
            "manglande eksplisitt kandidat, STRICT=" + strikt)
        krev(ikkje builtin.contains(tekst(svar["stdout"]), "[OK] tolk == AOT"),
            "manglande kandidat fall tilbake til annan runtime: " + prosessdiagnose(svar))
    }
    // Repoet har native vertscodegen for Linux x86-64 og macOS ARM64.
    // Linux ARM64 skal framleis bevise identitet og avvising av manglande
    // kandidat, utan å starte ein tolka codegen som kan ta 30–95 minutt.
    hvis (system == "Linux" og x86_64) eller (system == "Darwin" og arm64) {
        la tilfella = [
            {"runtime": runtime, "kandidat": "./" + relativ + "/candidate-renamed", "fasit": "42", "strikt": "1", "exit": "0"},
            {"runtime": runtime, "kandidat": relativ + "/candidate-renamed", "fasit": "42", "strikt": "1", "exit": "0"},
            {"runtime": runtime, "kandidat": kandidat, "fasit": "42", "strikt": "1", "exit": "0"},
            {"runtime": kandidat, "kandidat": "", "fasit": "42", "strikt": "1", "exit": "0"},
            {"runtime": kandidat, "kandidat": "", "fasit": "43", "strikt": "1", "exit": "1"},
            {"runtime": kandidat, "kandidat": "", "fasit": "43", "strikt": "0", "exit": "0"}
        ]
        for tilfelle i tilfella {
            la fasit = tekst(tilfelle["fasit"])
            la strikt = tekst(tilfelle["strikt"])
            la val = tekst(tilfelle["kandidat"])
            la svar = differensial(root, tekst(tilfelle["runtime"]), val, target, fasit, strikt)
            la markør = "[OK] tolk == AOT"
            hvis fasit == "43" { markør = "[FEIL] tolk == AOT, men begge avvik frå fasiten 43" }
            krev_differensial(svar, kandidat, tekst(tilfelle["exit"]), markør,
                "kandidat='" + val + "' EXPECT=" + fasit + " STRICT=" + strikt)
            krev(builtin.contains(tekst(svar["stdout"]), "tolk (vm.køyr_ncb) = 42"),
                "tolkesida køyrde ikkje fasiten: " + prosessdiagnose(svar))
            krev(builtin.contains(tekst(svar["stdout"]), "AOT (bygg-native + køyr) = 42"),
                "AOT-sida køyrde ikkje fasiten: " + prosessdiagnose(svar))
        }
    } ellers {
        skriv("Positiv AOT-samanlikning ikkje tilgjengeleg utan native vertscodegen (" + system + "/" + maskin + ").\n")
    }
    krev(filops.slett_tre(dir), "klarte ikkje rydde " + dir)
    skriv("test_selfhost_candidate_runtime OK (identitet, portable compile, kandidatval, STRICT og EXPECT)\n")
    returner 0
}
