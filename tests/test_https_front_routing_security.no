bruk std.https_front som front

funksjon start() -> heiltall {
    la f = front.ny("cert", "key")
    assert(front.legg_til_domene(f, "a.example.test", "127.0.0.1", 9001))
    assert(front.legg_til_domene(f, "b.example.test", "127.0.0.1", 9002))
    assert(front.legg_til_domene(f, "Case.example.test", "127.0.0.1", 9003))
    assert(ikkje front.legg_til_domene(f, "bad/path", "127.0.0.1", 9003))
    la a = front.klassifiser(f, "a.example.test", "GET /health HTTP/1.1\r\nHost: a.example.test\r\n\r\n")
    la b = front.klassifiser(f, "b.example.test", "GET / HTTP/1.1\r\nHost: b.example.test\r\n\r\n")
    assert(a["status"] == "route")
    assert(a["backend"]["port"] == 9001)
    assert(b["backend"]["port"] == 9002)
    assert(front.klassifiser(f, "a.example.test", "GET / HTTP/1.1\r\nHost: b.example.test\r\n\r\n")["code"] == 421)
    assert(front.klassifiser(f, "unknown.test", "GET / HTTP/1.1\r\nHost: unknown.test\r\n\r\n")["code"] == 421)
    assert(front.klassifiser(f, "a.example.test", "POST / HTTP/1.1\r\nHost: a.example.test\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx")["code"] == 400)
    assert(front.klassifiser(f, "a.example.test", "POST / HTTP/1.1\r\nHost: a.example.test\r\nTransfer-Encoding: chunked\r\n\r\n")["code"] == 400)
    la rejected = front.klassifiser(f, "a.example.test", "GET / HTTP/1.1\r\nHost: a.example.test\r\nX-Bad: ok\r\nInjected: yes\r\n\r\ntrailing")
    assert(rejected["code"] == 400)
    assert(builtin.index_of(rejected["response"], "127.0.0.1") < 0)
    assert(builtin.index_of(rejected["response"], "Cache-Control: no-store") >= 0)
    skriv("test_https_front_routing_security OK\n")
    returner 0
}
