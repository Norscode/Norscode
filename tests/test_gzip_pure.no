bruk std.gzip som gz
bruk std.bytes som bytes

funksjon start() -> heiltall {
    la rot = "build/test-gzip-pure-" + builtin.random_hex(8)
    builtin.mkdir_p(rot)
    builtin.fil_skriv_binær(rot + "/input.bin", bytes.fra_liste([0, 1, 2, 127, 128, 255]))
    assert(gz.komprimer_fil(rot + "/input.bin", rot + "/input.bin.gz"))
    assert(gz.er_gzip(rot + "/input.bin.gz"))
    assert(gz.ukomprimert_storleik(rot + "/input.bin.gz") == 6)
    assert(gz.dekomprimer_fil(rot + "/input.bin.gz", rot + "/output.bin"))
    la ut = bytes.til_liste(builtin.fil_les_binær(rot + "/output.bin"))
    assert(lengde(ut) == 6 og ut[0] == 0 og ut[4] == 128 og ut[5] == 255)

    la koda = gz.komprimer_tekst("hei\nverda")
    assert(koda != "")
    la dekoda = gz.dekomprimer_tekst(koda)
    assert(dekoda == "hei\nverda")
    la f = gz.open(rot + "/tekst.gz", "w")
    gz.write(f, "linje1\n")
    gz.write(f, "linje2")
    assert(gz.close(f))
    la lesar = gz.open(rot + "/tekst.gz", "r")
    assert(gz.readline(lesar) == "linje1\n")
    assert(gz.les(lesar) == "linje2")
    assert(gz.close(lesar))

    skriv("test_gzip_pure OK")
    returner 0
}
