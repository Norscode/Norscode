// Native ARM64-codegen HMAC-SHA256-verifisering (builtin.hmac_sha256).
// Byggd til ELF via codegen; køyrt nativt på arm-runnar. 42 = alle vektorar rette.
funksjon start() -> heiltall {
    hvis builtin.hmac_sha256([], []) != "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad" { returner 1 }
    hvis builtin.hmac_sha256([107, 101, 121], [84, 104, 101, 32, 113, 117, 105, 99, 107, 32, 98, 114, 111, 119, 110, 32, 102, 111, 120, 32, 106, 117, 109, 112, 115, 32, 111, 118, 101, 114, 32, 116, 104, 101, 32, 108, 97, 122, 121, 32, 100, 111, 103]) != "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" { returner 2 }
    hvis builtin.hmac_sha256([107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107, 107], [109, 117, 108, 116, 105, 98, 108, 111, 107, 107, 45, 110, 111, 107, 107, 101, 108, 45, 104, 97, 115, 104, 97, 115, 116, 45, 102, 111, 114, 115, 116, 45, 115, 105, 100, 97, 110, 45, 111, 118, 101, 114, 45, 54, 52, 45, 98, 121, 116, 101]) != "f88b529cac3fa8e1da72a564cc2e9ce730afb1981923bac7050c2560afdf6e96" { returner 3 }
    returner 42
}
