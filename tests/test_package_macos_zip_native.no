bruk std.filops som filops
bruk std.runtime_filesystem som fs
bruk std.zip som zip
bruk tools.package_macos_app_core som pakke

funksjon le(data, pos: heiltall, breidde: heiltall) -> heiltall {
    la verdi: heiltall = 0
    la i = 0
    mens i < breidde {
        verdi = verdi | ((data[pos + i] & 255) << (i * 8))
        i = i + 1
    }
    returner verdi
}

funksjon finn_central(data) -> heiltall {
    la i = 0
    mens i + 46 <= lengde(data) {
        hvis le(data, i, 4) == 33639248 { returner i }
        i = i + 1
    }
    returner -1
}

funksjon krev(vilkår: boolsk, namn: tekst) -> heiltall {
    hvis ikkje vilkår {
        skriv("FEIL test_package_macos_zip_native: " + namn + "\n")
        returner 1
    }
    skriv("OK test_package_macos_zip_native: " + namn + "\n")
    returner 0
}

funksjon start() -> heiltall {
    la base = "build/test-package-macos-zip"
    filops.slett_tre(base)
    hvis krev(filops.lag_katalogar(base + "/Demo.app/Contents/MacOS"), "lag katalogar") != 0 { returner 1 }
    builtin.fil_skriv(base + "/Demo.app/Contents/Info.plist", "<plist></plist>\n")
    builtin.fil_skriv(base + "/Demo.app/Contents/MacOS/demo", "native-demo\n")
    hvis krev(fs.native_sett_modus_sti(base + "/Demo.app/Contents/MacOS/demo", 493)["status"] == "ok", "sett executable modus") != 0 { returner 1 }

    la arkiv = base + "/Demo.zip"
    hvis krev(pakke.package_zip(base + "/Demo.app", arkiv), "skriv ZIP og SHA-256") != 0 { returner 1 }
    la innhald = zip.zip_les_lagra(arkiv)
    hvis krev(lengde(innhald["Demo.app/Contents/Info.plist"]) == 16, "les Info.plist frå ZIP") != 0 { returner 1 }
    hvis krev(lengde(innhald["Demo.app/Contents/MacOS/demo"]) == 12, "les executable frå ZIP") != 0 { returner 1 }
    hvis krev(innhald["Demo.app/Contents/MacOS/demo"][0] == 110, "bevar executable-byte") != 0 { returner 1 }

    la data = builtin.fil_les_binær(arkiv)
    la pos = finn_central(data)
    hvis krev(pos >= 0, "finn central directory") != 0 { returner 1 }
    hvis krev(le(data, pos + 4, 2) == 788, "ZIP er merka Unix 3.20") != 0 { returner 1 }
    la ekstern = le(data, pos + 38, 4)
    hvis krev(((ekstern >> 16) & 511) == 420 eller ((ekstern >> 16) & 511) == 493, "bevar POSIX-modus") != 0 { returner 1 }
    hvis krev(builtin.index_of(builtin.fil_les("tools/package-macos-app.no"), "/usr/bin/ditto") < 0, "ingen ditto i aktiv pakkeflyt") != 0 { returner 1 }
    filops.slett_tre(base)
    skriv("test_package_macos_zip_native OK\n")
    returner 0
}
