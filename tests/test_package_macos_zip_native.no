bruk std.filops som filops
bruk std.runtime_filesystem som fs
bruk std.zip som zip
bruk tools.package_macos_app_core som pakke

funksjon le(data, pos: heiltall, breidde: heiltall) -> heiltall {
    la verdi: heiltall = 0
    la i = 0
    mens i < breidde {
        verdi = verdi | ((data[pos + i] & 255) << (i * 8))
        i = i + 1
    }
    returner verdi
}

funksjon finn_central(data) -> heiltall {
    la i = 0
    mens i + 46 <= lengde(data) {
        hvis le(data, i, 4) == 33639248 { returner i }
        i = i + 1
    }
    returner -1
}

funksjon start() -> heiltall {
    la base = "build/test-package-macos-zip"
    filops.slett_tre(base)
    assert(filops.lag_katalogar(base + "/Demo.app/Contents/MacOS"))
    builtin.fil_skriv(base + "/Demo.app/Contents/Info.plist", "<plist></plist>\n")
    builtin.fil_skriv(base + "/Demo.app/Contents/MacOS/demo", "native-demo\n")
    assert(fs.native_sett_modus_sti(base + "/Demo.app/Contents/MacOS/demo", 493)["status"] == "ok")

    la arkiv = base + "/Demo.zip"
    assert(pakke.package_zip(base + "/Demo.app", arkiv))
    la innhald = zip.zip_les_lagra(arkiv)
    assert(lengde(innhald["Demo.app/Contents/Info.plist"]) == 16)
    assert(lengde(innhald["Demo.app/Contents/MacOS/demo"]) == 12)
    assert(innhald["Demo.app/Contents/MacOS/demo"][0] == 110)

    la data = builtin.fil_les_binær(arkiv)
    la pos = finn_central(data)
    assert(pos >= 0)
    assert(le(data, pos + 4, 2) == 788)
    la ekstern = le(data, pos + 38, 4)
    assert(((ekstern >> 16) & 511) == 420 eller ((ekstern >> 16) & 511) == 493)
    assert(builtin.index_of(builtin.fil_les("tools/package-macos-app.no"), "/usr/bin/ditto") < 0)
    filops.slett_tre(base)
    skriv("test_package_macos_zip_native OK\n")
    returner 0
}
