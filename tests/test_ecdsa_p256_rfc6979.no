# ECDSA P-256: deterministisk k etter RFC 6979 A.2.5 (P-256, SHA-256).
# Berre k-utleiinga (HMAC-SHA256), utan skalarmultiplikasjon, så han er
# rask nok til VM-en. Full signering: test_ecdsa_p256_sign.no.
bruk std.ecdsa_p256 som ec
bruk std.bigint som bn
bruk std.tls13_keyschedule som ks

funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _hexbytes(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon _hex(b: liste_heiltall) -> tekst {
    la s = "0123456789abcdef" la ut = "" la i = 0
    mens i < lengde(b) { ut = ut + builtin.slice(s, b[i] / 16, b[i] / 16 + 1) + builtin.slice(s, b[i] % 16, b[i] % 16 + 1) i = i + 1 }
    returner ut
}
funksjon _strbytes(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(s) { legg_til(ut, builtin.char_code(builtin.slice(s, i, i+1)) & 255) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    la d = _hexbytes("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    la k1 = _hex(bn.til_bytes(ec.rfc6979_k(d, ks.transcript_hash(_strbytes("sample"))), 32))
    skriv("k(sample) = " + k1 + "\n")
    assert_eq(k1, "a6e3c57dd01abe90086538398355dd4c3b17aa873382b0f24d6129493d8aad60")
    la k2 = _hex(bn.til_bytes(ec.rfc6979_k(d, ks.transcript_hash(_strbytes("test"))), 32))
    skriv("k(test)   = " + k2 + "\n")
    assert_eq(k2, "d16b6ae827f17175e040871a1c7ec3500192c4c92677336ec2537acaee0008e0")
    skriv("test_ecdsa_p256_rfc6979 OK\n")
    returner 0
}
