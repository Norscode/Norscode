# M0 — byggcachen må ugyldiggjerast når ein importert modul endrar seg.
#
# Bakgrunn: `kompiler_modul` i tools/compile_with_hybrid_bundle_v9400.no
# cacha kompilerte modular under build/nc-module-cache med ein nøkkel som
# berre dekte modulens eiga kjeldefil. Ei modulkompilering kan innehalde
# funksjonane til heile den transitive importgrafen (sjå merge_fragment), så
# ei endring i ein importert modul gav gammal bytekode frå cachen — `nc run`
# var korrekt medan `nc test` køyrde utdatert kode.
#
# Denne testen låser fast at importmanifestet som nøkkelen byggjer på er
# innhaldsadressert og transitivt.

bruk tools.compile_with_hybrid_bundle_v9400 som bundlar
bruk std.tekst som t

funksjon repo_rot() -> tekst {
    prøv {
        returner tekst(builtin.system_info()["cwd"])
    } fang (e) {
        returner "."
    }
}

funksjon start() -> heiltall {
    la rot = repo_rot()
    la memo = {}
    la fixtur_a = rot + "/tests/fixtures/cachetest_a.no"

    la manifest = bundlar.import_manifest(rot, rot, fixtur_a, memo)

    # Direkte import må vere med
    assert(t.inneholder(manifest, "tests.fixtures.cachetest_b:"))
    # Transitiv import (b importerer c) må òg vere med
    assert(t.inneholder(manifest, "tests.fixtures.cachetest_c:"))

    # Oppføringane må vere innhaldshashar, ikkje berre namn
    la hash_b = bundlar.fil_hash_memo(memo, rot + "/tests/fixtures/cachetest_b.no")
    la hash_c = bundlar.fil_hash_memo(memo, rot + "/tests/fixtures/cachetest_c.no")
    assert(hash_b != "")
    assert(hash_c != "")
    assert(hash_b != hash_c)
    assert(t.inneholder(manifest, "tests.fixtures.cachetest_b:" + hash_b))
    assert(t.inneholder(manifest, "tests.fixtures.cachetest_c:" + hash_c))

    # Ein modul utan importar gir tomt manifest
    la manifest_c = bundlar.import_manifest(rot, rot, rot + "/tests/fixtures/cachetest_c.no", memo)
    assert_eq(manifest_c, "")

    # Manifestet endrar seg når innhaldet i ein import endrar seg. Vi simulerer
    # det ved å byte ut hash-verdien i memoen — same veg cachen ville sett ei
    # endra fil.
    la memo2 = {}
    memo2[rot + "/tests/fixtures/cachetest_b.no"] = "ENDRA_HASH"
    la manifest2 = bundlar.import_manifest(rot, rot, fixtur_a, memo2)
    assert(manifest2 != manifest)
    assert(t.inneholder(manifest2, "tests.fixtures.cachetest_b:ENDRA_HASH"))

    # Uløyste importar skal òg påverke nøkkelen
    assert_eq(bundlar.fil_hash_memo(memo, rot + "/finst_ikkje_i_det_heile.no"), "")

    skriv("test_byggcache_invalidering OK\n")
    returner 0
}
