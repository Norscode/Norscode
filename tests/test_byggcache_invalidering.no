# M0 — byggcachen må ugyldiggjerast når ein importert modul endrar seg.
#
# Bakgrunn: `kompiler_modul` i tools/compile_with_hybrid_bundle_v9400.no
# cacha kompilerte modular under build/nc-module-cache. Sidan #183 (B2-
# sjølvstende) er importmanifestet (`import_manifest`) borte: modular blir
# kompilerte kvar for seg, og nøkkelen byggjer på innhaldshash av modulkjelda
# + verktøykjelda (`rask_hash_bytes`). Denne testen låser fast dei to
# byggjesteinane som invalideringa framleis kviler på: (1) importgrafen blir
# oppdaga transitivt via `importer_fraa` + `finn_import_abs`, og (2) hashane
# er innhaldsadresserte (ulike filer → ulike hashar; uløyst modul → "").

bruk tools.compile_with_hybrid_bundle_v9400 som bundlar
bruk std.tekst som t

funksjon repo_rot() -> tekst {
    prøv {
        returner tekst(builtin.system_info()["cwd"])
    } fang (e) {
        returner "."
    }
}

# Transitiv importliste (djupn-fyrst) bygd av dei same primitiva som bundlaren.
funksjon transitive_importar(rot: tekst, src: tekst, sett: ordbok_tekst, ut: liste_tekst) -> heiltall {
    la direkte = bundlar.importer_fraa(src)
    la i: heiltall = 0
    mens i < lengde(direkte) {
        la modul = direkte[i]
        hvis ikkje finnes_nøkkel(sett, modul) {
            sett[modul] = sann
            legg_til(ut, modul)
            la abs = bundlar.finn_import_abs(rot, rot, modul)
            hvis abs != "" { transitive_importar(rot, abs, sett, ut) }
        }
        i = i + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la rot = repo_rot()
    la fixtur_a = rot + "/tests/fixtures/cachetest_a.no"

    # (1) Transitiv oppdaging: a → b → c
    la sett: ordbok_tekst = {}
    la modular: liste_tekst = []
    transitive_importar(rot, fixtur_a, sett, modular)
    assert_eq(lengde(modular), 2)
    assert_eq(modular[0], "tests.fixtures.cachetest_b")
    assert_eq(modular[1], "tests.fixtures.cachetest_c")

    # Ein modul utan importar gir tom liste
    assert_eq(lengde(bundlar.importer_fraa(rot + "/tests/fixtures/cachetest_c.no")), 0)

    # Uløyst modul løyser seg ikkje til noka fil
    assert_eq(bundlar.finn_import_abs(rot, rot, "tests.fixtures.finst_ikkje_i_det_heile"), "")

    # (2) Innhaldsadresserte hashar: ulike filer → ulike hashar, same fil → same hash
    la sti_b = bundlar.finn_import_abs(rot, rot, "tests.fixtures.cachetest_b")
    la sti_c = bundlar.finn_import_abs(rot, rot, "tests.fixtures.cachetest_c")
    assert(sti_b != "")
    assert(sti_c != "")
    la hash_b = bundlar.rask_hash_bytes(builtin.fil_les_binær(sti_b))
    la hash_c = bundlar.rask_hash_bytes(builtin.fil_les_binær(sti_c))
    assert(hash_b != "")
    assert(hash_c != "")
    assert(hash_b != hash_c)
    assert_eq(hash_b, bundlar.rask_hash_bytes(builtin.fil_les_binær(sti_b)))
    # Endra innhald → endra hash (same veg cachen ville sett ei endra fil)
    assert(bundlar.rask_hash(fil_les(sti_b) + "\n# endra") != bundlar.rask_hash(fil_les(sti_b)))

    skriv("test_byggcache_invalidering OK\n")
    returner 0
}
