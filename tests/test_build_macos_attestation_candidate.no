bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/build_macos_attestation_candidate.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(native, [], root, miljø, 300000)"))
    assert(t.inneholder(src, "tools/embed_release_ncb.no"))
    assert(t.inneholder(src, "NORSCODE_EMBED_SPECS"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_build_macos_attestation_candidate OK\n")
    returner 0
}
