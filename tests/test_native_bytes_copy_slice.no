// Regresjon (S1b, native_codegen_v2): bytes_to_list og bytes_from_list lagar EKTE
// kopiar, og slice på bytes (type 7) gjev bytes. Før var bytes_to_list identitet
// (lista var framleis bytes og delte lagring med originalen), bytes_from_list retagga
// kjeldelista på plass, og slice(bytes) gjekk til streng-slicen → søppeltekst →
// bytes_from_list(tekst) → SIGSEGV i fil_skriv_binær (c717e80).

funksjon start() -> heiltall {
    // ── bytes_from_list: ny behaldar; kjeldelista er urørt ──
    la kjelde: liste_heiltall = [1, 2, 3, 4, 5]
    la b = builtin.bytes_from_list(kjelde)
    assert_eq(type_av(b), "bytes")
    assert_eq(type_av(kjelde), "liste")
    assert_eq(lengde(b), 5)
    kjelde[0] = 99
    assert_eq(b[0], 1)
    legg_til(kjelde, 6)
    assert_eq(lengde(kjelde), 6)
    assert_eq(lengde(b), 5)

    // ── bytes_to_list: ny liste (type 3); bytes-originalen er urørt ──
    la l = builtin.bytes_to_list(b)
    assert_eq(type_av(l), "liste")
    assert_eq(type_av(b), "bytes")
    assert_eq(lengde(l), 5)
    assert_eq(l[0], 1)
    assert_eq(l[4], 5)
    l[0] = 200
    assert_eq(b[0], 1)
    assert_eq(l[0], 200)
    legg_til(l, 7)
    assert_eq(lengde(l), 6)
    assert_eq(lengde(b), 5)
    assert_eq(l[5], 7)
    // slice på lista er liste-slice
    la ls = builtin.slice(l, 1, 3)
    assert_eq(type_av(ls), "liste")
    assert_eq(lengde(ls), 2)
    assert_eq(ls[0], 2)
    assert_eq(ls[1], 3)

    // ── slice på bytes → bytes (typebevarande, som tekst → tekst og liste → liste) ──
    la bs = builtin.slice(b, 1, 4)
    assert_eq(type_av(bs), "bytes")
    assert_eq(lengde(bs), 3)
    assert_eq(bs[0], 2)
    assert_eq(bs[2], 4)
    assert_eq(bs[-1], 4)
    bs[0] = 77
    assert_eq(bs[0], 77)
    assert_eq(b[1], 2)
    // grenser: slutt over lengda blir klamra; start >= slutt gjev tom bytes
    assert_eq(lengde(builtin.slice(b, 3, 100)), 2)
    la tom = builtin.slice(b, 4, 2)
    assert_eq(type_av(tom), "bytes")
    assert_eq(lengde(tom), 0)
    // tekst-slicen (same dispatcher) er uendra
    la ts = builtin.slice("abcdef", 1, 4)
    assert_eq(type_av(ts), "tekst")
    assert_eq(ts, "bcd")

    // ── c717e80-vegen direkte på bytes: slice → bytes_from_list → fil ──
    la sti = "build/test-native-bytes-copy-slice.bin"
    builtin.fil_skriv_binær(sti, builtin.bytes_from_list(builtin.slice(b, 0, 3)))
    la lest = builtin.fil_les_binær(sti)
    assert_eq(type_av(lest), "bytes")
    assert_eq(lengde(lest), 3)
    assert_eq(lest[0], 1)
    assert_eq(lest[2], 3)
    // og slice direkte til fil (utan bytes_from_list)
    builtin.fil_skriv_binær(sti, builtin.slice(b, 3, 5))
    la lest_b = builtin.fil_les_binær(sti)
    assert_eq(lengde(lest_b), 2)
    assert_eq(lest_b[0], 4)
    assert_eq(lest_b[1], 5)
    // embed_release_ncb-vegen: bytes_to_list → slice(liste) → bytes_from_list → fil
    la lest_liste = builtin.bytes_to_list(lest)
    builtin.fil_skriv_binær(sti, builtin.bytes_from_list(builtin.slice(lest_liste, 1, 3)))
    la lest2 = builtin.fil_les_binær(sti)
    assert_eq(lengde(lest2), 2)
    assert_eq(lest2[0], 2)
    assert_eq(lest2[1], 3)
    // lista er uavhengig av fil-bytane ho vart laga frå
    lest_liste[0] = 250
    assert_eq(lest[0], 1)

    // ── tomme behaldarar ──
    la tb = builtin.bytes_from_list([])
    assert_eq(type_av(tb), "bytes")
    assert_eq(lengde(tb), 0)
    la tl = builtin.bytes_to_list(tb)
    assert_eq(type_av(tl), "liste")
    assert_eq(lengde(tl), 0)
    legg_til(tl, 9)
    assert_eq(lengde(tl), 1)
    assert_eq(tl[0], 9)
    assert_eq(lengde(tb), 0)

    // ── større enn inline-kapasiteten (8): kopi og vekst etterpå ──
    la stor_kjelde: liste_heiltall = []
    la i: heiltall = 0
    mens i < 300 { legg_til(stor_kjelde, (i * 7) % 256) i = i + 1 }
    la sb = builtin.bytes_from_list(stor_kjelde)
    la sl = builtin.bytes_to_list(sb)
    assert_eq(lengde(sl), 300)
    legg_til(sl, 1)
    legg_til(sl, 2)
    assert_eq(lengde(sl), 302)
    assert_eq(lengde(sb), 300)
    assert_eq(sl[299], (299 * 7) % 256)
    assert_eq(sb[299], (299 * 7) % 256)
    assert_eq(sl[301], 2)
    la sbs = builtin.slice(sb, 250, 260)
    assert_eq(type_av(sbs), "bytes")
    assert_eq(lengde(sbs), 10)
    assert_eq(sbs[0], (250 * 7) % 256)
    assert(sb == builtin.bytes_from_list(stor_kjelde))

    skriv("test_native_bytes_copy_slice OK")
    returner 0
}
