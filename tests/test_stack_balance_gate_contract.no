bruk std.tekst som t

funksjon start() -> heiltall {
    la bundler = fil_les("tests/test_bundler_hex_normalization.no")
    la dynamisk = fil_les("tests/test_vm_dynamic_continuation.no")
    la index = fil_les("tests/test_native_v2_integer_ops.no")
    la gc = fil_les("tests/test_runtime_memory_abi.no")
    la nested = fil_les("tests/test_vm_stack_balance_matrix.no")
    assert(t.inneholder(bundler, "bundle"))
    assert(t.inneholder(dynamisk, "ncb_call_fn"))
    assert(t.inneholder(dynamisk, "metrics[\"calls\"]"))
    assert(t.inneholder(index, "INDEX_GET"))
    assert(t.inneholder(gc, "legg_rot"))
    assert(t.inneholder(gc, "collect_minor"))
    assert(t.inneholder(nested, "vm.køyr_ncb(program())"))
    assert(t.inneholder(nested, "mens i < 64"))
    skriv("test_stack_balance_gate_contract OK")
    returner 0
}
