bruk std.tekst som t

// Kontrakt: std.db er den binære NorsDB-motoren (norsdb_db → norsdb_sql/norsdb_motor),
// ikkje den gamle JSON-blob-motoren (std/norsdb.no, fjerna). SQLite er berre opt-in
// via std.sqlite_adapter. Pool defaultar til norsdb.
funksjon start() -> heiltall {
    la standard = fil_les("std/db.no")
    la adapter = fil_les("std/norsdb_db.no")
    la sqlite = fil_les("std/sqlite_adapter.no")
    la pool = fil_les("std/pool.no")
    // std.db rutar til den binære adapteren, ikkje JSON-motoren.
    assert(t.inneholder(standard, "bruk std.norsdb_db som norsdb"))
    assert(ikkje t.inneholder(standard, "bruk std.norsdb som norsdb"))
    assert(t.inneholder(standard, "returner norsdb.open(sti)"))
    // Adapteren er den binære motoren, utan vm-JSON-kjeda.
    assert(t.inneholder(adapter, "norsdb-pure-v1"))
    assert(t.inneholder(adapter, "bruk std.norsdb_sql som sql"))
    assert(t.inneholder(adapter, "bruk std.norsdb_motor som motor"))
    assert(ikkje t.inneholder(adapter, "bruk selfhost.vm"))
    // SQLite er eksplisitt opt-in, og går sjølv gjennom std.db.
    assert(t.inneholder(sqlite, "funksjon open(sti: tekst) -> tekst { returner db.open(sti) }"))
    // Pool defaultar til norsdb; sqlite-pool er eiga opt-in-flate.
    assert(t.inneholder(pool, "returner _ny_pool(dsn, \"norsdb\", maks)"))
    assert(t.inneholder(pool, "funksjon ny_sqlite"))
    assert(t.inneholder(pool, "sqlite-adapter"))
    returner 0
}
