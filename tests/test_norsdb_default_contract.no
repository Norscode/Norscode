bruk std.tekst som t

funksjon start() -> heiltall {
    la standard = fil_les("std/db.no")
    la norsdb = fil_les("std/norsdb.no")
    la sqlite = fil_les("std/sqlite_adapter.no")
    la pool = fil_les("std/pool.no")
    la vm = fil_les("selfhost/vm.no")
    assert(t.inneholder(standard, "bruk std.norsdb som norsdb"))
    assert(ikkje t.inneholder(standard, "returner db.open"))
    assert(t.inneholder(norsdb, "norsdb-pure-v1"))
    assert(t.inneholder(norsdb, "bruk selfhost.vm som vm"))
    assert(ikkje t.inneholder(norsdb, "db.open"))
    assert(ikkje t.inneholder(norsdb, "sqlite" + ".open"))
    assert(t.inneholder(sqlite, "funksjon open(sti: tekst) -> tekst { returner db.open(sti) }"))
    assert(t.inneholder(pool, "returner _ny_pool(dsn, \"norsdb\", maks)"))
    assert(t.inneholder(pool, "funksjon ny_sqlite"))
    assert(t.inneholder(pool, "sqlite-adapter"))
    assert(t.inneholder(vm, "funksjon norsdb_standard_state()"))
    assert(t.inneholder(vm, "returner finnes_nøkkel(map_obj, nøkkel)"))
    returner 0
}
