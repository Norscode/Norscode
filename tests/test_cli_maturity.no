bruk std.tekst som t

funksjon start() -> heiltall {
    assert(fil_finnes("bin/nc"))
    assert(fil_finnes("dist/norscode_native"))

    la binær = builtin.fil_les_binær("bin/nc")
    assert(lengde(binær) > 4)
    // Native argv-kontrakt attesterast med plattforma sin eigen binærsignatur:
    //   Mach-O 64-bit (cf fa ed fe = 207 250 237 254) på macOS,
    //   ELF (7f 45 4c 46 = 127 69 76 70) på Linux,
    //   PE/MZ (4d 5a = 77 90) på Windows.
    la er_macho = binær[0] == 207 og binær[1] == 250 og binær[2] == 237 og binær[3] == 254
    la er_elf   = binær[0] == 127 og binær[1] == 69 og binær[2] == 76 og binær[3] == 70
    la er_pe    = binær[0] == 77 og binær[1] == 90
    assert(er_macho eller er_elf eller er_pe)

    la cli = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(cli, "la argv = native_argv()"))
    assert(t.inneholder(cli, "funksjon nc_direkte_verktøysti(cmd: tekst) -> tekst"))
    assert(t.inneholder(cli, "funksjon nc_forbered_direkte_miljø(cmd: tekst, argv: liste_tekst) -> boolsk"))
    assert(t.inneholder(cli, "hvis cmd == \"test\" eller cmd == \"selfcheck\""))
    assert(t.inneholder(cli, "hvis cmd == \"active-surface\" eller cmd == \"aktiv-flate\""))
    assert(t.inneholder(cli, "hvis cmd == \"release-preflight\" { returner \"tools/release_preflight.no\" }"))
    assert(t.inneholder(cli, "hvis cmd == \"local-green\" eller cmd == \"gronnliste\" { returner \"tools/local_green.no\" }"))
    assert(t.inneholder(cli, "hvis cmd == \"regen-bootstrap\" eller cmd == \"bootstrap-regen\" { returner \"tools/nc_regen_bootstrap.no\" }"))
    assert(t.inneholder(cli, "hvis cmd == \"stage0-release-assets\" eller cmd == \"build-stage0-release-assets\""))
    assert(t.inneholder(cli, "hvis cmd == \"verify-seed\" eller cmd == \"seed-only\""))
    assert(t.inneholder(cli, "hvis cmd == \"docker-build-linux\" { returner \"tools/docker-build-linux.no\" }"))
    assert(t.inneholder(cli, "bruk: nc local-green [--strict] [--list|-l]"))
    assert(t.inneholder(cli, "bruk: nc selvstendighet [--strict]"))
    assert(t.inneholder(cli, "bruk: nc release-preflight [--strict]"))
    assert(t.inneholder(cli, "bruk: nc regen-bootstrap [--full]"))
    assert(t.inneholder(cli, "bruk: nc docker-build-linux [--output FIL]"))
    assert(ikkje t.inneholder(cli, "exec sh"))
    assert(ikkje t.inneholder(cli, "sh -c"))
    assert(ikkje t.inneholder(cli, "rm -rf"))
    skriv("test_cli_maturity native OK\n")
    returner 0
}
