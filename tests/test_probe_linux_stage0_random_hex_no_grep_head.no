bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/probe_linux_stage0_random_hex_v732.no")

    assert(t.inneholder(src, "funksjon vis_strings_treff(sti: tekst, needle: tekst, maks: heiltall) -> heiltall"))
    assert(t.inneholder(src, "funksjon vis_fil_start(sti: tekst, maks: heiltall) -> heiltall"))
    assert(t.inneholder(src, "funksjon vis_kildetreff(mapper: tekst, needles: liste_tekst, maks: heiltall) -> heiltall"))
    assert(t.inneholder(src, "funksjon søkefiler(mapper: tekst) -> liste_tekst"))
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "native_walk_files_med_suffiks(\".\", mappe, \".no\")"))
    assert(t.inneholder(src, "ikkje har_fil(filer, fil)"))
    assert(t.inneholder(src, "builtin.fil_les(sti)"))
    assert(t.inneholder(src, "vis_kildetreff(\"selfhost std prosjekter/NorscodeWeb\", kilde_ord, 200)"))
    assert(t.inneholder(src, "la info = builtin.system_info()"))
    assert(t.inneholder(src, "native_fs.native_les(h, 1048576)"))
    assert(t.inneholder(src, "hale + data"))
    assert(t.inneholder(src, "builtin.sha256_bytes(data)"))
    assert(t.inneholder(src, "filops.lista_katalog(\"bootstrap/stage0\")"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "builtin.bytes_to_text"))
    assert(ikkje t.inneholder(src, "filops.walk(mappe)"))
    assert(ikkje t.inneholder(src, "tools/build_norscode_native.sh"))
    assert(ikkje t.inneholder(src, "| grep -n 'random_hex'"))
    assert(ikkje t.inneholder(src, "/usr/bin/grep -R -n"))
    assert(ikkje t.inneholder(src, "find \" + mapper"))
    assert(ikkje t.inneholder(src, "find \" + shell(mappe)"))
    assert(ikkje t.inneholder(src, "| head -20"))
    assert(ikkje t.inneholder(src, "| head -200"))
    assert(ikkje t.inneholder(src, "sed -n "))
    assert(ikkje t.inneholder(src, " awk "))

    skriv("test_probe_linux_stage0_random_hex_no_grep_head OK")
    returner 0
}
