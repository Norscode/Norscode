// Kontrakt for bootstrap-krokane som gjer JSON-avvikling nivå 1 mogleg utan
// ny reseed (selfhost/nc_main.no og vm_module_load i selfhost/vm.no er baka
// inn i seeden). Tekstnivå: køyrer på alle seedar.
// Åtferda sjølv er prøvd i test_bootstrap_cache_hooks_live og
// test_vm_module_load_dual_format_live (krev seed bygd frå denne kjelda).
bruk std.tekst som t

// Kolonne-0-linjer i vm.no som utleiinga av modulglobalane (nc_main:
// nc_vm_modulglobal_kjelde) kjenner. Alt anna på kolonne 0 ville vore ein
// toppnivå-setning som ikkje kjem med i den vertsstyrte __module_init__.
funksjon kjend_toppnivå(linje: tekst) -> boolsk {
    hvis linje == "" { returner sann }
    la c = builtin.slice(linje, 0, 1)
    hvis c == " " eller c == "\t" eller c == "}" eller c == ")" eller c == "]" { returner sann }
    hvis t.starter_med(linje, "//") eller t.starter_med(linje, "#") { returner sann }
    hvis t.starter_med(linje, "funksjon ") eller t.starter_med(linje, "slutt") { returner sann }
    hvis t.starter_med(linje, "la ") eller t.starter_med(linje, "bruk ") { returner sann }
    returner usann
}

// Netto parentesdjupn utanfor strengar og kommentarar (same reglar som
// nc_main: nc_parentesbalanse).
funksjon balanse(linje: tekst) -> heiltall {
    la djupn: heiltall = 0
    la i_streng = usann
    la escape = usann
    la i: heiltall = 0
    mens i < lengde(linje) {
        la c = builtin.slice(linje, i, i + 1)
        hvis i_streng {
            hvis escape { escape = usann }
            ellers hvis c == "\\" { escape = sann }
            ellers hvis c == "\"" { i_streng = usann }
        } ellers {
            hvis c == "\"" { i_streng = sann }
            ellers hvis c == "#" { bryt }
            ellers hvis c == "/" og builtin.slice(linje, i + 1, i + 2) == "/" { bryt }
            ellers hvis c == "(" eller c == "[" eller c == "{" { djupn = djupn + 1 }
            ellers hvis c == ")" eller c == "]" eller c == "}" { djupn = djupn - 1 }
        }
        i = i + 1
    }
    returner djupn
}

// Fleirlinjers toppnivå-`la` i vm.no må halde parentesane opne over
// linjeskifta. Ei innrykt linje rett etter ein balansert toppnivå-`la` (t.d.
// `la x = "a" +` + innrykt `"b"`) er ei fortsetjing utan parentes. Utleiinga i
// nc_main tek ho med, men ein seed med ei eldre utleiing kuttar ho og
// selfhost.vm-bundlar feilar då å kompilere. Kontrakten held vm.no i forma
// alle utleiingane handterer. Returnerer linjenummeret (1-basert) til første
// brot, eller 0.
funksjon første_uparentes_fortsetjing(linjer) -> heiltall {
    la djupn: heiltall = 0
    la i_la = usann
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la linje = tekst(linjer[i])
        la innrykt = t.starter_med(linje, " ") eller t.starter_med(linje, "\t")
        hvis djupn > 0 {
            djupn = djupn + balanse(linje)
            hvis djupn < 0 { djupn = 0 }
        } ellers hvis i_la og innrykt {
            la inni = builtin.trim(linje)
            hvis inni != "" og ikkje t.starter_med(inni, "//") og ikkje t.starter_med(inni, "#") {
                returner i + 1
            }
        } ellers hvis t.starter_med(linje, "la ") {
            i_la = sann
            djupn = balanse(linje)
            hvis djupn < 0 { djupn = 0 }
        } ellers {
            i_la = usann
        }
        i = i + 1
    }
    returner 0
}

// Fingeravtrykk-formelen finst i tre kopiar (baka kjelde: nc_main for
// selfhost-delen, bundler for modulcache-delen; verktøyet; hooks_live). Kvar
// bit må stå ordrett i alle tre. (Bitane blir sende som
// argument, ikkje som listeliteral: C-æra-seedane unescapar ikkje strengar i
// listeliteralar.)
funksjon formel_lik(baka: tekst, verktøy: tekst, live: tekst, bit: tekst) -> boolsk {
    hvis t.inneholder(baka, bit) og t.inneholder(verktøy, bit) og t.inneholder(live, bit) { returner sann }
    skriv("fingeravtrykk-formelen skil seg (baka/verktøy/hooks_live): " + bit + "\n")
    assert(usann)
    returner usann
}

funksjon start() -> heiltall {
    la nc = fil_les("selfhost/nc_main.no")
    la bu = fil_les("selfhost/bundler.no")
    la vm = fil_les("selfhost/vm.no")

    // (a) `nc bundle` utan --output skriv til build/, ikkje til ei committa fil.
    assert(t.inneholder(nc, "returner \"build/kompiler.ncb.json\""))
    assert(ikkje t.inneholder(nc, "la ut = \"bootstrap/kompiler.ncb.json\""))
    // (bundler.start() sin eigen standard er uendra: bundler.no er
    // fikspunktmodul, og `nc bundle` gjev alltid NORSCODE_BUNDLE_OUTPUT.)
    assert(t.inneholder(nc, "miljo_sett(\"NORSCODE_BUNDLE_OUTPUT\", ut)"))
    la sbe = fil_les("selfhost/tooling/safe_bundle_entry.no")
    assert(ikkje t.inneholder(sbe, "utfil = \"bootstrap/kompiler.ncb.json\""))

    // (b) selfhost-fragment er kjeldehash-porta (manifest + artefakthash).
    // Krokane ligg i nc_main: bundler.no er ein av dei åtte fikspunktmodulane
    // i ELF stage-0-porten (Gen1 frå committa fragment, Gen2 frå kjelde), så
    // han må vere uendra utan fragment-regen.
    assert(ikkje t.inneholder(bu, "les_verifisert_selfhost_ncb"))
    assert(ikkje t.inneholder(bu, "NORSCODE_BOOTSTRAP_CACHE"))
    assert(t.inneholder(nc, "norscode-selfhost-source-cache-v1|ncb-v1|module-globals-v1"))
    assert(t.inneholder(nc, "kjelde_hash != tekst(post[\"source_sha256\"])"))
    assert(t.inneholder(nc, "artefakt_hash != tekst(post[\"artifact_sha256\"])"))
    assert(t.inneholder(nc, "returner nc_les_verifisert_selfhost_ncb(fil, alias, root)"))
    // Den gamle uverifiserte vegen er berre ein eksplisitt naudutgang.
    assert(ikkje t.inneholder(nc, "ncb_json = bundler.les_precompiled_ncb(fil)"))
    assert(t.inneholder(nc, "NORSCODE_SELFHOST_CACHE_UNVERIFIED"))
    // … og bunde til kompilatoren: eit manifest frå ein annan runtime-binær
    // (reseed) eller annan kompilatorkjelde er ein bom.
    assert(t.inneholder(nc, "funksjon nc_selfhost_cache_compiler_fingerprint(root: tekst, runtime: tekst) -> tekst"))
    assert(t.inneholder(nc, "la fp = nc_selfhost_cache_compiler_fingerprint(root, nc_selfhost_cache_runtime())"))
    assert(t.inneholder(nc, "hvis fp == \"\" eller manifest_fp != fp {"))
    assert(t.inneholder(nc, "nc_selfhost_cache_trace(\"selfhost-miss \" + merkelapp + \" compiler\")"))
    // Verktøyet og den levande testen har kopiar av formelen (dei importerer
    // ikkje nc_main/bundler); tekstane må vere like, elles blir kvar post ein bom.
    la verktøy = fil_les("tools/materialize_bootstrap_cache.no")
    la live = fil_les("tests/test_bootstrap_cache_hooks_live.no")
    assert(t.inneholder(verktøy, "\"compiler_fingerprint\": fingeravtrykk"))
    formel_lik(nc, verktøy, live, "la runtime_hash = builtin.sha256_bytes(builtin.fil_les_binær(runtime))")
    formel_lik(nc, verktøy, live, "+ \"\\nruntime \" + runtime_hash +")
    formel_lik(nc, verktøy, live, "\"\\ncompiler \" + ")
    formel_lik(nc, verktøy, live, "modulcache_compiler_fingerprint(root) + \"\\n\")")
    formel_lik(nc, verktøy, live, "\"norscode-selfhost-source-cache-v1|ncb-v1|module-globals-v1\"")
    formel_lik(bu, verktøy, live, "\"selfhost/kompiler.no\", \"selfhost/parser.no\", \"selfhost/lexer/lexer_m1.no\",")
    formel_lik(bu, verktøy, live, "\"selfhost/compiler/semantic.no\", \"selfhost/compiler/ir_to_bytecode.no\"")
    formel_lik(bu, verktøy, live, "norscode-incremental-module-cache-v1|ncb-v1|module-globals-v1")
    formel_lik(bu, verktøy, live, "materiale = materiale + filer[i] + \" \" +")
    formel_lik(bu, verktøy, live, "builtin.sha256_bytes(builtin.fil_les_binær(sti)) + \"\\n\"")
    formel_lik(bu, verktøy, live, "materiale = materiale + filer[i] + \" missing\\n\"")
    formel_lik(bu, verktøy, live, "returner builtin.sha256(materiale)")

    // (c) vertsstyrt selfhost.vm er ein eksplisitt markør: ingen avhengnad av
    // vm.ncb.json, ingen hardkoda globalliste.
    assert(t.inneholder(nc, "funksjon nc_vm_vertsstyrt_aktiv() -> boolsk"))
    assert(t.inneholder(nc, "NORSCODE_VM_HOSTED"))
    assert(t.inneholder(nc, "compile_kjelde = nc_vm_modulglobal_kjelde(kjelde)"))
    assert(ikkje t.inneholder(nc, "vm-fragment manglar functions"))
    assert(ikkje t.inneholder(nc, "\"vm_random_counter\""))
    // AOT har ingen vert-VM: bygg-native kompilerer selfhost.vm inn med mindre
    // markøren er sett eksplisitt.
    assert(t.inneholder(nc, "hvis hosted_før == \"\" { miljo_sett(\"NORSCODE_VM_HOSTED\", \"0\") }"))

    // (d) éi cacherot for stdlib- og selfhost-fragment.
    assert(t.inneholder(nc, "NORSCODE_BOOTSTRAP_CACHE"))
    assert(t.inneholder(nc, "la cache_rot = nc_bootstrap_cache_rot(root)"))

    // (e) dynamiske plugins: dual-format, trust-hash på rå byte som før, og
    // trust-porten kjem før dekodinga (ein ikkje-godkjend fil blir aldri parsa).
    assert(t.inneholder(vm, "bruk selfhost.ncb_serde som ncb_serde"))
    assert(t.inneholder(vm, "la actual = sha256.hash(raw)"))
    la trust_pos = t.finn(vm, "ikkje vm_module_verify_trust(path, raw)")
    la dekod_pos = t.finn(vm, "la ncb = ncb_serde.deserialiser_tekst(raw)")
    assert(trust_pos > 0)
    assert(dekod_pos > trust_pos)
    assert(ikkje t.inneholder(vm, "la ncb = json_parse_raw(raw)"))

    // Føresetnaden for utleiinga i (c): alle modulglobalane i vm.no står som
    // `la` på kolonne 0, og ingen annan toppnivå-setning finst (han ville ikkje
    // kome med i den vertsstyrte initialisatoren).
    la linjer = builtin.split(vm, "\n")
    la globalar: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la linje = tekst(linjer[i])
        hvis t.starter_med(linje, "la ") { globalar = globalar + 1 }
        hvis ikkje kjend_toppnivå(linje) {
            skriv("ukjend toppnivå-linje i selfhost/vm.no:" + tekst(i + 1) + ": " + linje + "\n")
            assert(usann)
        }
        i = i + 1
    }
    assert(globalar >= 10)
    la brot = første_uparentes_fortsetjing(linjer)
    hvis brot != 0 {
        skriv("toppnivå-la held fram utan open parentes i selfhost/vm.no:" + tekst(brot) +
              " (bruk parentesar rundt fleirlinjers uttrykk)\n")
    }
    assert_eq(brot, 0)
    // Utleiinga sjølv tek med innrykte fortsetjingslinjer etter ein `la`.
    assert(t.inneholder(nc, "hvis djupn > 0 eller (i_la og innrykt) {"))

    skriv("test_bootstrap_cache_hooks_contract OK")
    returner 0
}
