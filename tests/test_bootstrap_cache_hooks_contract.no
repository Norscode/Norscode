// Kontrakt for bootstrap-krokane som gjer JSON-avvikling nivå 1 mogleg utan
// ny reseed (selfhost/nc_main.no, selfhost/bundler.no og vm_module_load i
// selfhost/vm.no er baka inn i seeden). Tekstnivå: køyrer på alle seedar.
// Åtferda sjølv er prøvd i test_bootstrap_cache_hooks_live og
// test_vm_module_load_dual_format_live (krev seed bygd frå denne kjelda).
bruk std.tekst som t

// Kolonne-0-linjer i vm.no som utleiinga av modulglobalane (nc_main:
// nc_vm_modulglobal_kjelde) kjenner. Alt anna på kolonne 0 ville vore ein
// toppnivå-setning som ikkje kjem med i den vertsstyrte __module_init__.
funksjon kjend_toppnivå(linje: tekst) -> boolsk {
    hvis linje == "" { returner sann }
    la c = builtin.slice(linje, 0, 1)
    hvis c == " " eller c == "\t" eller c == "}" eller c == ")" eller c == "]" { returner sann }
    hvis t.starter_med(linje, "//") eller t.starter_med(linje, "#") { returner sann }
    hvis t.starter_med(linje, "funksjon ") eller t.starter_med(linje, "slutt") { returner sann }
    hvis t.starter_med(linje, "la ") eller t.starter_med(linje, "bruk ") { returner sann }
    returner usann
}

funksjon start() -> heiltall {
    la nc = fil_les("selfhost/nc_main.no")
    la bu = fil_les("selfhost/bundler.no")
    la vm = fil_les("selfhost/vm.no")

    // (a) `nc bundle` utan --output skriv til build/, ikkje til ei committa fil.
    assert(t.inneholder(nc, "returner \"build/kompiler.ncb.json\""))
    assert(ikkje t.inneholder(nc, "la ut = \"bootstrap/kompiler.ncb.json\""))
    assert(t.inneholder(bu, "utfil = \"build/kompiler.ncb.json\""))
    assert(ikkje t.inneholder(bu, "utfil = \"bootstrap/kompiler.ncb.json\""))
    la sbe = fil_les("selfhost/tooling/safe_bundle_entry.no")
    assert(ikkje t.inneholder(sbe, "utfil = \"bootstrap/kompiler.ncb.json\""))

    // (b) selfhost-fragment er kjeldehash-porta (manifest + artefakthash).
    assert(t.inneholder(bu, "norscode-selfhost-source-cache-v1|ncb-v1|module-globals-v1"))
    assert(t.inneholder(bu, "kjelde_hash != tekst(post[\"source_sha256\"])"))
    assert(t.inneholder(bu, "artefakt_hash != tekst(post[\"artifact_sha256\"])"))
    assert(t.inneholder(nc, "bundler.les_verifisert_selfhost_ncb(fil, alias, root)"))
    // Den gamle uverifiserte vegen er berre ein eksplisitt naudutgang.
    assert(ikkje t.inneholder(nc, "ncb_json = bundler.les_precompiled_ncb(fil)"))
    assert(t.inneholder(bu, "NORSCODE_SELFHOST_CACHE_UNVERIFIED"))

    // (c) vertsstyrt selfhost.vm er ein eksplisitt markør: ingen avhengnad av
    // vm.ncb.json, ingen hardkoda globalliste.
    assert(t.inneholder(nc, "funksjon nc_vm_vertsstyrt_aktiv() -> boolsk"))
    assert(t.inneholder(nc, "NORSCODE_VM_HOSTED"))
    assert(t.inneholder(nc, "compile_kjelde = nc_vm_modulglobal_kjelde(kjelde)"))
    assert(ikkje t.inneholder(nc, "vm-fragment manglar functions"))
    assert(ikkje t.inneholder(nc, "\"vm_random_counter\""))
    // AOT har ingen vert-VM: bygg-native kompilerer selfhost.vm inn med mindre
    // markøren er sett eksplisitt.
    assert(t.inneholder(nc, "hvis hosted_før == \"\" { miljo_sett(\"NORSCODE_VM_HOSTED\", \"0\") }"))

    // (d) éi cacherot for stdlib- og selfhost-fragment.
    assert(t.inneholder(bu, "NORSCODE_BOOTSTRAP_CACHE"))
    assert(t.inneholder(nc, "la cache_rot = bundler.bootstrap_cache_rot(root)"))

    // (e) dynamiske plugins: dual-format, trust-hash på rå byte som før, og
    // trust-porten kjem før dekodinga (ein ikkje-godkjend fil blir aldri parsa).
    assert(t.inneholder(vm, "bruk selfhost.ncb_serde som ncb_serde"))
    assert(t.inneholder(vm, "la actual = sha256.hash(raw)"))
    la trust_pos = t.finn(vm, "ikkje vm_module_verify_trust(path, raw)")
    la dekod_pos = t.finn(vm, "la ncb = ncb_serde.deserialiser_tekst(raw)")
    assert(trust_pos > 0)
    assert(dekod_pos > trust_pos)
    assert(ikkje t.inneholder(vm, "la ncb = json_parse_raw(raw)"))

    // Føresetnaden for utleiinga i (c): alle modulglobalane i vm.no står som
    // `la` på kolonne 0, og ingen annan toppnivå-setning finst (han ville ikkje
    // kome med i den vertsstyrte initialisatoren).
    la linjer = builtin.split(vm, "\n")
    la globalar: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la linje = tekst(linjer[i])
        hvis t.starter_med(linje, "la ") { globalar = globalar + 1 }
        hvis ikkje kjend_toppnivå(linje) {
            skriv("ukjend toppnivå-linje i selfhost/vm.no:" + tekst(i + 1) + ": " + linje + "\n")
            assert(usann)
        }
        i = i + 1
    }
    assert(globalar >= 10)

    skriv("test_bootstrap_cache_hooks_contract OK")
    returner 0
}
