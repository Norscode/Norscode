# Fase 1 (kjerne) for std/apptenar.no: automatisk JSON (1.1), feil→status (1.1),
# dependency injection med cache/yield/overstyring/globale (1.2), vakt- og
# request-mellomvare-kortslutning (1.3), og bakgrunnsoppgåver etter svaret (1.7).
# Køyrer i same prosess via app.handsam_rå (ingen socket).
bruk std.web som web
bruk std.apptenar som app
bruk std.apptenar_serde som serde
bruk std.tidspunkt som tp

# Merk: ingen `struktur`-nøkkelord på toppnivå i denne fila — stage0-kompilatoren har
# ein feil der ei `struktur`-erklæring saman med ein toppnivå-`la` gjev «Stack underflow
# i __module_init__» (pre-eksisterande, i nc_main-lukkinga). Ein struktur-instans er på
# VM-nivå ei ordbok med «__type__», så h_struct byggjer ho direkte (same verdi).

la _s: ordbok = {"db": 0, "base": 0, "glob": 0, "bg": 0, "rydd": [], "mw": 0}

# ─── 1.1: automatisk JSON ────────────────────────────────────────────────────

funksjon h_ordbok(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /j/ordbok")
    returner {"id": 1, "namn": "sykkel", "aktiv": sann}
}

funksjon h_struct(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /j/struct")
    # Same form som VM-en gjev for ein struktur-instans: ordbok med "__type__".
    returner {"__type__": "Vare", "id": 7, "namn": "ball"}
}

funksjon h_liste(ctx: ordbok_tekst) -> liste {
    web.route("GET /j/liste")
    returner [1, "to", usann]
}

funksjon h_dato(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /j/dato")
    returner {"når": tp.dato(2024, 12, 31)}
}

funksjon h_bytes(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /j/bytes")
    returner {"data": builtin.bytes_from_list([104, 105])}
}

funksjon h_tekst(ctx: ordbok_tekst) -> tekst {
    web.route("GET /j/tekst")
    returner "rå tekst"
}

funksjon h_respons(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /j/respons")
    returner {"status": 201, "content_type": "text/html; charset=utf-8", "body": "<p>hei</p>"}
}

# ─── 1.1: feil → status ──────────────────────────────────────────────────────

funksjon h_httpfeil(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /feil/http")
    app.http_feil(404, "vare manglar")
    returner {"nå": "aldri"}
}

funksjon h_httpfeil_header(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /feil/http_header")
    app.http_feil_med_headers(401, "logg inn", {"www-authenticate": "Bearer"})
    returner {"nå": "aldri"}
}

funksjon h_valideringsfeil(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /feil/valid")
    app.valideringsfeil("namn er påkravd")
    returner {"nå": "aldri"}
}

funksjon h_krasj(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /feil/krasj")
    kast "noko gale internt"
    returner {"nå": "aldri"}
}

# ─── 1.2: dependency injection ───────────────────────────────────────────────

funksjon gi_db(ctx: ordbok_tekst) -> tekst {
    web.dependency("db")
    _s["db"] = _s["db"] + 1
    returner "DB"
}

funksjon bruk_db(ctx: ordbok_tekst, db: tekst) -> ordbok_tekst {
    web.use_dependency("db")
    web.route("GET /di/db")
    returner {"db": db, "kall": _s["db"]}
}

# cache: a og b deler base; base skal kallast éin gong per request
funksjon prov_base(ctx: ordbok_tekst) -> tekst {
    _s["base"] = _s["base"] + 1
    returner "B"
}

funksjon prov_a(ctx: ordbok_tekst, base: tekst) -> tekst { returner base + "a" }
funksjon prov_b(ctx: ordbok_tekst, base: tekst) -> tekst { returner base + "b" }

funksjon bruk_ab(ctx: ordbok_tekst, a: tekst, b: tekst) -> ordbok_tekst {
    web.use_dependency("a")
    web.use_dependency("b")
    web.route("GET /di/cache")
    returner {"a": a, "b": b, "base_kall": _s["base"]}
}

# yield-kontrakt {verdi, rydd} med opprydding i omvend rekkjefølgje
funksjon prov_c(ctx: ordbok_tekst) -> ordbok_tekst { returner {"verdi": "C", "rydd": "rydd_c"} }
funksjon prov_d(ctx: ordbok_tekst) -> ordbok_tekst { returner {"verdi": "D", "rydd": "rydd_d"} }
funksjon rydd_c() -> heltall { legg_til(_s["rydd"], "c")  returner 0 }
funksjon rydd_d() -> heltall { legg_til(_s["rydd"], "d")  returner 0 }

funksjon bruk_cd(ctx: ordbok_tekst, c: tekst, d: tekst) -> ordbok_tekst {
    web.use_dependency("c")
    web.use_dependency("d")
    web.route("GET /di/yield")
    returner {"c": c, "d": d}
}

# aritetsfeil: handlar krev to parametrar utan deklarerte deps → fangbar feil, ikkje SIGSEGV
funksjon h_arity(ctx: ordbok_tekst, mangler: tekst) -> ordbok_tekst {
    web.route("GET /di/arity")
    returner {"x": mangler}
}

# global dep (sideeffekt, ikkje sendt til handlaren)
funksjon gi_glob(ctx: ordbok_tekst) -> tekst {
    _s["glob"] = _s["glob"] + 1
    returner "G"
}

funksjon h_vanleg(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /vanleg")
    returner {"ok": sann}
}

# ─── 1.3: vakter og mellomvare ───────────────────────────────────────────────

funksjon vakt_401(ctx: ordbok_tekst) -> ordbok_tekst {
    web.guard()
    returner {"status": 401, "body": "logg inn", "headers": {"www-authenticate": "Bearer realm=\"nc\""}}
}

funksjon vakt_nei(ctx: ordbok_tekst) -> bool {
    web.guard()
    returner usann
}

funksjon r_401(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("vakt_401")
    web.route("GET /vakt/401")
    returner {"status": 200, "body": "hemmeleg"}
}

funksjon r_nei(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("vakt_nei")
    web.route("GET /vakt/nei")
    returner {"status": 200, "body": "hemmeleg"}
}

# request-mw: kortslutning
funksjon mw_kortslutt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.request_middleware()
    hvis app.header(ctx, "x-blokk") == "ja" {
        returner {"status": 403, "body": "blokkert av mw"}
    }
    returner ctx
}

# request-mw: endrar ctx (skal nå handlaren)
funksjon mw_berik(ctx: ordbok_tekst) -> ordbok_tekst {
    web.request_middleware()
    ctx["__params__"] = ctx["__params__"]
    ctx["__body__"] = "berika"
    returner ctx
}

funksjon h_ser_body(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /mw/body")
    returner {"body_sett": ctx["__body__"]}
}

# response-mw på alle ruter
funksjon mw_svar(svar: ordbok_tekst) -> ordbok_tekst {
    web.response_middleware()
    _s["mw"] = _s["mw"] + 1
    la h = {}
    hvis har_nokkel(svar, "headers") { h = svar["headers"] }
    h["x-mw"] = "ja"
    svar["headers"] = h
    returner svar
}

# ─── 1.7: bakgrunnsoppgåver ──────────────────────────────────────────────────

funksjon bg_jobb() -> heltall {
    _s["bg"] = _s["bg"] + 1
    returner 0
}

funksjon h_bakgrunn(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /bg")
    la før = _s["bg"]
    app.bakgrunn("bg_jobb")
    # Svaret viser verdien FØR oppgåva køyrer (ho køyrer etter svaret).
    returner {"før": før}
}

# ─── Testhjelparar ───────────────────────────────────────────────────────────

funksjon svar(rå: tekst) -> ordbok {
    la t = app.handsam_rå(rå)
    la slutt = builtin.index_of(t, "\r\n\r\n")
    la linjer = builtin.split(builtin.slice(t, 0, slutt), "\r\n")
    la hh = {}
    la i = 1
    mens i < lengde(linjer) {
        la k = builtin.index_of(linjer[i], ":")
        hh[builtin.lower(builtin.slice(linjer[i], 0, k))] = builtin.trim(builtin.slice(linjer[i], k + 1, lengde(linjer[i])))
        i = i + 1
    }
    returner {"status": heltall_fra_tekst(builtin.split(linjer[0], " ")[1]), "h": hh,
              "body": builtin.slice(t, slutt + 4, lengde(t)), "rå": t}
}

funksjon get(sti: tekst, ekstra: tekst) -> ordbok {
    returner svar("GET " + sti + " HTTP/1.1\r\nHost: x\r\n" + ekstra + "\r\n")
}

funksjon hh(r: ordbok, namn: tekst) -> tekst {
    hvis har_nokkel(r["h"], namn) { returner r["h"][namn] }
    returner ""
}

funksjon _reset() -> heltall {
    app.nullstill({"logg": "ingen"})
    app.fjern_overstyringar()
    _s["db"] = 0
    _s["base"] = 0
    _s["glob"] = 0
    _s["bg"] = 0
    _s["rydd"] = []
    _s["mw"] = 0
    returner 0
}

# ─── Testar ──────────────────────────────────────────────────────────────────

funksjon test_auto_json() -> heltall {
    _reset()
    la a = get("/j/ordbok", "")
    assert_eq(a["status"], 200)
    assert_eq(hh(a, "content-type"), "application/json; charset=utf-8")
    assert_eq(a["body"], "{\"id\":1,\"namn\":\"sykkel\",\"aktiv\":true}")
    # struktur: __type__ fjerna
    assert_eq(get("/j/struct", "")["body"], "{\"id\":7,\"namn\":\"ball\"}")
    # liste
    la l = get("/j/liste", "")
    assert_eq(hh(l, "content-type"), "application/json; charset=utf-8")
    assert_eq(l["body"], "[1,\"to\",false]")
    # dato ISO-8601
    assert_eq(get("/j/dato", "")["body"], "{\"når\":\"2024-12-31\"}")
    # bytes base64
    assert_eq(get("/j/bytes", "")["body"], "{\"data\":\"aGk=\"}")
    # bakoverkompatibelt: rå tekst og ferdig respons-ordbok
    la t = get("/j/tekst", "")
    assert_eq(hh(t, "content-type"), "text/plain; charset=utf-8")
    assert_eq(t["body"], "rå tekst")
    la rsp = get("/j/respons", "")
    assert_eq(rsp["status"], 201)
    assert_eq(hh(rsp, "content-type"), "text/html; charset=utf-8")
    assert_eq(rsp["body"], "<p>hei</p>")
    skriv("1.1 auto-JSON: ordbok, struktur (__type__ vekk), liste, dato ISO, bytes base64, bakoverkompat\n")
    returner 0
}

funksjon test_feil_status() -> heltall {
    _reset()
    la f = get("/feil/http", "")
    assert_eq(f["status"], 404)
    assert_eq(hh(f, "content-type"), "application/json; charset=utf-8")
    assert_eq(f["body"], "{\"detail\":\"vare manglar\"}")
    # HTTPFeil med header
    la fh = get("/feil/http_header", "")
    assert_eq(fh["status"], 401)
    assert_eq(hh(fh, "www-authenticate"), "Bearer")
    # ValideringsFeil → 422 (Fase 0-format)
    la v = get("/feil/valid", "")
    assert_eq(v["status"], 422)
    assert_eq(v["body"], "{\"detail\":[{\"type\":\"value_error\",\"loc\":[\"body\"],\"msg\":\"namn er påkravd\",\"input\":\"\"}]}")
    # vanleg unntak → 500, teksten ikkje i kroppen
    la k = get("/feil/krasj", "")
    assert_eq(k["status"], 500)
    assert(builtin.index_of(k["body"], "gale internt") < 0)
    # tenaren lever etter kvar feil
    assert_eq(get("/j/tekst", "")["status"], 200)
    skriv("1.1 feil→status: 404 HTTPFeil, 401+WWW-Authenticate, 422 ValideringsFeil, 500 skjult\n")
    returner 0
}

funksjon test_di_grunnleggjande() -> heltall {
    _reset()
    la r = get("/di/db", "")
    assert_eq(r["status"], 200)
    assert_eq(r["body"], "{\"db\":\"DB\",\"kall\":1}")
    assert_eq(_s["db"], 1)
    skriv("1.2 DI: provider injisert i handlar under apptenar (ingen SIGSEGV)\n")
    returner 0
}

funksjon test_di_cache() -> heltall {
    _reset()
    app.registrer_avhengigheit("base", "prov_base")
    app.registrer_avhengigheit_graf("a", "prov_a", ["base"])
    app.registrer_avhengigheit_graf("b", "prov_b", ["base"])
    la r = get("/di/cache", "")
    assert_eq(r["status"], 200)
    assert_eq(r["body"], "{\"a\":\"Ba\",\"b\":\"Bb\",\"base_kall\":1}")
    assert_eq(_s["base"], 1)
    skriv("1.2 DI-cache: delt base kalla éin gong per request\n")
    returner 0
}

funksjon test_di_yield() -> heltall {
    _reset()
    app.registrer_avhengigheit("c", "prov_c")
    app.registrer_avhengigheit("d", "prov_d")
    la r = get("/di/yield", "")
    assert_eq(r["status"], 200)
    assert_eq(r["body"], "{\"c\":\"C\",\"d\":\"D\"}")
    # opprydding i OMVEND rekkjefølgje, etter svaret
    assert_eq(builtin.json_stringify(_s["rydd"]), "[\"d\",\"c\"]")
    skriv("1.2 DI-yield: {verdi, rydd} rydda i omvend rekkjefølgje etter svaret\n")
    returner 0
}

funksjon test_di_overstyr() -> heltall {
    _reset()
    app.overstyr_avhengigheit("db", "gi_db_test")
    la r = get("/di/db", "")
    assert_eq(r["body"], "{\"db\":\"OVERSTYRT\",\"kall\":0}")
    assert_eq(_s["db"], 0)
    skriv("1.2 DI-overstyr: overstyr_avhengigheit byter provider i test\n")
    returner 0
}

funksjon gi_db_test(ctx: ordbok_tekst) -> tekst { returner "OVERSTYRT" }

funksjon test_di_aritet() -> heltall {
    _reset()
    la r = get("/di/arity", "")
    assert_eq(r["status"], 500)
    # tenaren lever (ingen SIGSEGV)
    assert_eq(get("/j/tekst", "")["status"], 200)
    skriv("1.2 aritetskontroll: for få argument gjev 500 (fangbar), ikkje SIGSEGV\n")
    returner 0
}

funksjon test_di_global() -> heltall {
    _reset()
    app.nullstill({"logg": "ingen", "globale_deps": ["glob"]})
    app.registrer_avhengigheit("glob", "gi_glob")
    la r = get("/vanleg", "")
    assert_eq(r["status"], 200)
    assert_eq(r["body"], "{\"ok\":true}")
    assert_eq(_s["glob"], 1)
    skriv("1.2 globale deps: køyrer på request (sideeffekt), ikkje sendt til handlaren\n")
    returner 0
}

funksjon test_vakt_kortslutt() -> heltall {
    _reset()
    la r = get("/vakt/401", "")
    assert_eq(r["status"], 401)
    assert_eq(hh(r, "www-authenticate"), "Bearer realm=\"nc\"")
    assert_eq(r["body"], "logg inn")
    assert_eq(get("/vakt/nei", "")["status"], 403)
    skriv("1.3 vakt: eige svar (401 + WWW-Authenticate) kortsluttar; usann gjev 403\n")
    returner 0
}

funksjon test_mw() -> heltall {
    _reset()
    app.nullstill({"logg": "ingen", "forespurnad_mw": ["mw_kortslutt", "mw_berik"], "respons_mw": ["mw_svar"]})
    # kortslutning
    la b = get("/mw/body", "x-blokk: ja\r\n")
    assert_eq(b["status"], 403)
    assert_eq(b["body"], "blokkert av mw")
    # response-mw køyrde likevel på kortslutta svar
    assert_eq(hh(b, "x-mw"), "ja")
    # ctx frå request-mw når handlaren
    la g = get("/mw/body", "")
    assert_eq(g["status"], 200)
    assert_eq(g["body"], "{\"body_sett\":\"berika\"}")
    assert_eq(hh(g, "x-mw"), "ja")
    skriv("1.3 mellomvare: request-mw kortsluttar og berikar ctx; response-mw på alle ruter\n")
    returner 0
}

funksjon test_bakgrunn() -> heltall {
    _reset()
    la r = get("/bg", "")
    assert_eq(r["status"], 200)
    # svaret viser 0 (oppgåva køyrde ikkje før svaret)
    assert_eq(r["body"], "{\"før\":0}")
    # men oppgåva har køyrt etterpå
    assert_eq(_s["bg"], 1)
    skriv("1.7 bakgrunn: oppgåve køyrer ETTER at svaret er laga\n")
    returner 0
}
