# Fase 1 (bølgje 2, 1.6) for std/apptenar_statisk.no (via std/apptenar.no): statiske filer
# med rett MIME, ETag/304, Range → 206, 416, Content-Disposition, ingen path traversal,
# og SPA-fallback. Dogfoodar std/apptest.no. Fixturar: tests/fixtures/static/.
bruk std.web som web
bruk std.apptenar som app
bruk std.apptest som tk

funksjon _konf(spa: bool, last_ned: bool) -> ordbok {
    returner {"logg": "ingen", "statisk": {"url_prefiks": "/static/",
             "mappe": "tests/fixtures/static", "index": "index.html",
             "spa": spa, "last_ned": last_ned}}
}

# Ein ekte rute for å vise at statisk berre er fallback (rør ikkje app-ruter).
funksjon h_ekte(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api")
    returner {"ok": sann}
}

funksjon test_statisk_mime_etag() -> heltall {
    la kl = tk.klient(_konf(usann, usann))
    la r = tk.get(kl, "/static/app.css", {})
    assert_eq(tk.status(r), 200)
    assert_eq(tk.header(r, "content-type"), "text/css; charset=utf-8")
    assert_eq(tk.header(r, "accept-ranges"), "bytes")
    assert(tk.header(r, "etag") != "")
    assert(tk.header(r, "last-modified") != "")
    assert_eq(tk.body_tekst(r), "body{color:red}\n")
    skriv("1.6 statisk: rett MIME (text/css), ETag, Last-Modified, Accept-Ranges\n")
    returner 0
}

funksjon test_statisk_304() -> heltall {
    la kl = tk.klient(_konf(usann, usann))
    la r = tk.get(kl, "/static/app.css", {})
    la etag = tk.header(r, "etag")
    la r2 = tk.get(kl, "/static/app.css", {"headerar": {"If-None-Match": etag}})
    assert_eq(tk.status(r2), 304)
    assert_eq(tk.body_tekst(r2), "")
    skriv("1.6 statisk: If-None-Match mot ETag gjev 304 utan kropp\n")
    returner 0
}

funksjon test_statisk_range_206() -> heltall {
    la kl = tk.klient(_konf(usann, usann))
    # data.txt = "linje1\nlinje2\nlinje3\n" (21 byte)
    la r = tk.get(kl, "/static/data.txt", {"headerar": {"Range": "bytes=0-5"}})
    assert_eq(tk.status(r), 206)
    assert_eq(tk.header(r, "content-range"), "bytes 0-5/21")
    assert_eq(tk.body_tekst(r), "linje1")
    # Suffiks-range: siste 7 byte = "linje3\n"
    la s = tk.get(kl, "/static/data.txt", {"headerar": {"Range": "bytes=-7"}})
    assert_eq(tk.status(s), 206)
    assert_eq(tk.header(s, "content-range"), "bytes 14-20/21")
    assert_eq(tk.body_tekst(s), "linje3\n")
    skriv("1.6 statisk: Range → 206 med Content-Range (både start-slutt og suffiks)\n")
    returner 0
}

funksjon test_statisk_416() -> heltall {
    la kl = tk.klient(_konf(usann, usann))
    la r = tk.get(kl, "/static/data.txt", {"headerar": {"Range": "bytes=100-200"}})
    assert_eq(tk.status(r), 416)
    assert_eq(tk.header(r, "content-range"), "bytes */21")
    skriv("1.6 statisk: ufullnøgd Range gjev 416 med Content-Range bytes */N\n")
    returner 0
}

funksjon test_statisk_ingen_traversal() -> heltall {
    la kl = tk.klient(_konf(usann, usann))
    # ../ skal ALDRI lekke ut av mappa (her: freistar å nå ei kjeldefil over mappa).
    la r = tk.get(kl, "/static/../../fixtures/static/app.css", {})
    assert_eq(tk.status(r), 404)
    la r2 = tk.get(kl, "/static/..%2fapp.css", {})
    # %2f blir ikkje dekoda her, så dette er eit ukjent filnamn → 404 (aldri 200/leak).
    assert_eq(tk.status(r2), 404)
    skriv("1.6 statisk: path traversal (../) blir avvist med 404, ingen sti-lekkasje\n")
    returner 0
}

funksjon test_statisk_404() -> heltall {
    la kl = tk.klient(_konf(usann, usann))
    assert_eq(tk.status(tk.get(kl, "/static/mangler.txt", {})), 404)
    skriv("1.6 statisk: manglande fil gjev 404\n")
    returner 0
}

funksjon test_statisk_nedlasting() -> heltall {
    la kl = tk.klient(_konf(usann, sann))
    la r = tk.get(kl, "/static/data.txt", {})
    assert_eq(tk.status(r), 200)
    assert(builtin.index_of(tk.header(r, "content-disposition"), "attachment") >= 0)
    assert(builtin.index_of(tk.header(r, "content-disposition"), "data.txt") >= 0)
    skriv("1.6 statisk: last_ned gjev Content-Disposition: attachment\n")
    returner 0
}

funksjon test_spa_fallback() -> heltall {
    la kl = tk.klient(_konf(sann, usann))
    # Ukjend rute (ikkje under /static/) → index.html.
    la r = tk.get(kl, "/ein/klient/rute", {})
    assert_eq(tk.status(r), 200)
    assert(builtin.index_of(tk.body_tekst(r), "Heim") >= 0)
    assert_eq(tk.header(r, "cache-control"), "no-cache")
    # Ekte rute vinn framleis over SPA.
    assert_eq(tk.status(tk.get(kl, "/api", {})), 200)
    # Under /static/ men manglande fil → 404 (SPA grip ikkje inn der).
    assert_eq(tk.status(tk.get(kl, "/static/finst-ikkje.js", {})), 404)
    skriv("1.6 SPA: ukjend sti → index.html; ekte rute og manglande statisk fil uendra\n")
    returner 0
}
