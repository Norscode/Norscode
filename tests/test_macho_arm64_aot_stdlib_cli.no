// Ende-til-ende AOT av importert std.math-kode frå Norscode-kjelde.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_macos_arm64() -> bool {
    la system = miljo_hent("RUNNER_OS")
    la maskin = miljo_hent("RUNNER_ARCH")
    hvis system == "" eller maskin == "" {
        prøv {
            la info = builtin.system_info()
            hvis system == "" { system = tekst(info["system"]) }
            hvis maskin == "" { maskin = tekst(info["machine"]) }
        } fang (e) {}
    }
    la macos = system == "macOS" eller system == "MacOS" eller system == "Darwin" eller system == "darwin"
    la arm64 = maskin == "ARM64" eller maskin == "arm64" eller maskin == "aarch64"
    returner macos og arm64
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon bygg_og_køyr(root: tekst, nc: tekst, namn: tekst, kjelde: tekst, kode: heiltall) -> heiltall {
    la binær = "/tmp/" + namn + "_" + builtin.random_hex(8)
    la miljø = {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    krev_exit(prosess.køyr(nc, ["bygg-native", "--target", "macos-arm64", kjelde, binær], root, miljø, 180000), 0)
    krev_exit(prosess.køyr(binær, [], root, {}, 30000), kode)
    filops.slett_fil(binær)
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_macos_arm64() { returner 0 }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la nc = runtime(root)
    bygg_og_køyr(root, nc, "norscode_macho_aot_stdlib", root + "/tests/fixtures/macos_aot_std_math.no", 49)
    bygg_og_køyr(root, nc, "norscode_macho_aot_stdlib_control", root + "/tests/fixtures/macos_aot_std_math_control.no", 10)
    bygg_og_køyr(root, nc, "norscode_macho_aot_common_ops", root + "/tests/fixtures/aot_common_integer_ops.no", 11)
    returner 0
}
