// Punkt 5d: auth_session på ei fil-database. Før vart sesjonen lagra med aktiv=''
// og oppretta='(' (DEFAULT (datetime('now')) avslutta kolonnelista, og «utgår»
// vart to token), så hent_session gav {} rett etter logg_inn; og etter gjenopning
// forsvann UNIQUE, så same brukarnamn kunne registrerast to gonger.

bruk std.auth som auth
bruk std.db som db
bruk std.filops som filops

funksjon _rydd(sti: tekst) {
    prøv { builtin.fil_slett(sti + ".cp") } fang (e) {}
    prøv { builtin.fil_slett(sti + ".cp2") } fang (e) {}
    prøv { builtin.fil_slett(sti + ".wal") } fang (e) {}
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"]) + "/build/auth-session-" + builtin.random_hex(8)
    assert(filops.lag_katalogar(root))
    miljo_sett("NORSCODE_AUTH_SECURITY_ROOT", root)
    miljo_sett("NORSCODE_AUTH_SECURITY_FILE", "security.json")
    la sti = "/tmp/norsdb_auth_session_test.db"
    _rydd(sti)

    la conn = db.open(sti)
    assert(auth.migrer(conn) == 1)
    assert(auth.registrer(conn, "ada", "ada@example.test", "correct horse battery staple") > 0)
    la token = auth.logg_inn(conn, "ada@example.test", "correct horse battery staple")
    assert(token != "")
    la s = auth.hent_session(conn, token)
    assert_eq(s["aktiv"], "sann")
    assert_eq(lengde(s["oppretta"]), 19)
    assert(auth.er_gyldig_session(conn, token))
    assert(db.close(conn))

    // Etter gjenopning: sesjonen finst framleis, og UNIQUE på brukarnamn/epost held.
    la conn2 = db.open(sti)
    assert(auth.migrer(conn2) == 1)
    assert(auth.er_gyldig_session(conn2, token))
    assert_eq(auth.hent_session(conn2, token)["aktiv"], "sann")
    assert(auth.registrer(conn2, "ada", "ada@example.test", "eit anna passord") <= 0)
    assert_eq(db.query_int(conn2, "SELECT COUNT(*) FROM auth_brukar"), 1)
    assert(auth.logg_ut(conn2, token))
    assert(auth.er_gyldig_session(conn2, token) == usann)
    assert(db.close(conn2))
    _rydd(sti)
    returner 0
}
