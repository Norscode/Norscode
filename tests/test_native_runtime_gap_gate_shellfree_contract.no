bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/native_runtime_gap_gate_v3001.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(bin_path, [\"run\", probe]"))
    assert(t.inneholder(src, "\"PATH\": \"/nonexistent\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "sh -c"))
    assert(ikkje t.inneholder(src, "mktemp "))
    assert(ikkje t.inneholder(src, "rm -f"))
    skriv("test_native_runtime_gap_gate_shellfree_contract OK\n")
    returner 0
}
