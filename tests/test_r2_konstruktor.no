# R2 / F05: konstruktørar. Punkt(1, 2) er posisjonell, felt kan ha
# standardverdiar (`x: heltall = 5`, evaluerte i strukturens eigen modul),
# Type.m() er eit direkte statisk kall, alias.Type() kallar konstruktøren i
# modulen, og eit ukjent typenamn (Pnukt()) er ein KOMPILERINGSFEIL — ingen
# stor-bokstav-heuristikk i VM-en. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon ncb_av(kjelde: tekst, modul: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, modul))
}

# Kompileringsfeilen som tekst, eller "KOMPILERTE" om kjelda vart godteken.
funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon start() -> heiltall {
    la ncb = ncb_av(fil_les("tests/fixtures/r2_konstruktor.no"), "__main__")
    # Modulen med alias.Type() blir kompilert for seg og slegen saman (som
    # bundlaren), og modul-initen hennar køyrer før hovudmodulen sin.
    la bank = ncb_av(fil_les("tests/fixtures/r2_bank.no"), "tests.fixtures.r2_bank")
    la fk = nøkler(bank["functions"])
    la i = 0
    mens i < lengde(fk) {
        ncb["functions"][fk[i]] = bank["functions"][fk[i]]
        i = i + 1
    }
    ncb["global_names"]["tests.fixtures.r2_bank"] = bank["global_names"]["tests.fixtures.r2_bank"]
    ncb["module_initializers"] = bank["module_initializers"]
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "x=1 y=2 har_x=sann;halv=7/sann;saldo=100 namn=ukjend;k2=5/ukjend;ny=7 nøklar=[x,y];ny_std=11;liten=9;bank=Ada/100/150 nøklar=[eigar,saldo];opna=Bo/100")

    # Skrivefeil i typenamn: kompileringsfeil.
    la typo = "struktur Punkt { x: heltall }\n" +
        "funksjon start() -> heltall {\n" +
        "    la p = Pnukt()\n" +
        "    returner 0\n" +
        "}\n"
    la f1 = kompileringsfeil(typo)
    assert(builtin.starts_with(f1, "Typefeil linje 3: ukjend type eller funksjon Pnukt"))
    # For mange argument til konstruktøren.
    la for_mange = "struktur Punkt { x: heltall }\n" +
        "funksjon start() -> heltall {\n" +
        "    la p = Punkt(1, 2)\n" +
        "    returner 0\n" +
        "}\n"
    assert_eq(kompileringsfeil(for_mange), "Typefeil: Punkt har 1 felt, men konstruktøren fekk 2 argument")
    # Ukjend statisk funksjon.
    la ukjend_statisk = "struktur Punkt { x: heltall }\n" +
        "funksjon start() -> heltall {\n" +
        "    la p = Punkt.lag(1)\n" +
        "    returner 0\n" +
        "}\n"
    assert_eq(kompileringsfeil(ukjend_statisk), "Typefeil: Punkt har ingen funksjon lag (venta funksjon Punkt.lag)")
    returner 0
}
