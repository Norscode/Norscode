bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(src, "funksjon nc_køyr_verktøy(sti: tekst) -> heiltall"))
    assert(t.inneholder(src, "funksjon normaliser_importalias_kall(ncb_json: tekst, imports: liste<tekst>) -> tekst"))
    assert(t.inneholder(src, "funksjon normaliser_json_kontrollteikn(data: tekst) -> tekst"))
    assert(t.inneholder(src, "la delar: liste<tekst> = [\"\"]"))
    assert(t.inneholder(src, "returner builtin.join(delar, \"\")"))
    assert(ikkje t.inneholder(src, "ut = ut + c"))
    assert(t.inneholder(src, "fiksa_json = normaliser_json_kontrollteikn(fiksa_json)"))
    assert(t.inneholder(src, "\"\\\"builtin.\" + alias + \".\""))
    assert(t.inneholder(src, "imports_str = imports_str + alias + \"=\" + fil"))
    assert(ikkje t.inneholder(src, "imports_str = imports_str + modul + \"=\" + fil"))
    assert(t.inneholder(src, "returner nc_køyr_ncb_json_modus(nc_verktøy_ncb_cached(root + \"/\" + sti, root, \"__main__\"), sann)"))
    assert(t.inneholder(src, "cmd == \"test\" eller cmd == \"selfcheck\""))
    assert(t.inneholder(src, "tools/nc_test.no"))
    assert(t.inneholder(src, "cmd == \"active-surface\" eller cmd == \"aktiv-flate\""))
    assert(t.inneholder(src, "tools/no_c_python_active_surface.no"))
    assert(t.inneholder(src, "cmd == \"surface-ownership\" eller cmd == \"flate-eigar\""))
    assert(t.inneholder(src, "tools/verify_norscode_surface_ownership.no"))
    assert(t.inneholder(src, "cmd == \"phase0-verify\" eller cmd == \"fase0-verify\""))
    assert(t.inneholder(src, "tools/selfhost_phase0_verify.no"))
    assert(t.inneholder(src, "cmd == \"selfhost-drift-guard\" eller cmd == \"drift-guard\""))
    assert(t.inneholder(src, "tools/selfhost_drift_guard.no"))
    assert(t.inneholder(src, "cmd == \"python-audit\""))
    assert(t.inneholder(src, "tools/python_dependency_audit.no"))
    assert(t.inneholder(src, "cmd == \"no-legacy-cvm\" eller cmd == \"legacy-cvm-check\""))
    assert(t.inneholder(src, "tools/no_legacy_cvm.no"))
    assert(t.inneholder(src, "cmd == \"selfhost-maintenance-verify\" eller cmd == \"maintenance-verify\""))
    assert(t.inneholder(src, "tools/selfhost_maintenance_verify.no"))
    assert(t.inneholder(src, "cmd == \"lsp\""))
    assert(t.inneholder(src, "selfhost/lsp/server.no"))
    assert(t.inneholder(src, "funksjon nc_direkte_verktøysti(cmd: tekst) -> tekst"))
    assert(t.inneholder(src, "selfhost/bootstrap_gate.no"))
    assert(t.inneholder(src, "tools/selfcompile_l5.no"))
    assert(t.inneholder(src, "tools/selfcompile_l5b.no"))
    assert(t.inneholder(src, "tools/selfcompile_l5b_mini.no"))
    assert(t.inneholder(src, "hvis cmd == \"test-parallel\" { returner \"tools/nc_test_parallel.no\" }"))
    assert(t.inneholder(src, "tools/selfcompile_native_elf.no"))
    assert(t.inneholder(src, "tools/selfcompile_stage0_elf.no"))
    assert(t.inneholder(src, "tools/verify_omgang6b.no"))
    assert(t.inneholder(src, "tools/verify_seed_only.no"))
    assert(t.inneholder(src, "tools/platform_readiness_v3600.no"))
    assert(t.inneholder(src, "selfhost/phase2_ci.no"))
    assert(t.inneholder(src, "funksjon nc_forbered_direkte_miljø(cmd: tekst, argv: liste_tekst) -> boolsk"))
    assert(t.inneholder(src, "NORSCODE_RELEASE_PREFLIGHT_STRICT_GIT"))
    assert(t.inneholder(src, "NORSCODE_RELEASE_VERSION"))
    assert(t.inneholder(src, "NORSCODE_INSTALL_ARCHIVE"))
    assert(t.inneholder(src, "NORSCODE_INSTALL_PREFIX"))
    assert(t.inneholder(src, "NORSCODE_LOCAL_GREEN_STRICT"))
    assert(t.inneholder(src, "NORSCODE_REGEN_BOOTSTRAP_FULL"))
    assert(t.inneholder(src, "NORSCODE_SELVSTENDIGHET_STRICT"))
    assert(t.inneholder(src, "NORSCODE_STAGE0_PLATFORM"))
    assert(t.inneholder(src, "NORSCODE_RELEASE_ARTIFACT_DIR"))
    assert(t.inneholder(src, "tools/package-linux-app.no"))
    assert(t.inneholder(src, "tools/docker-build-linux.no"))
    assert(t.inneholder(src, "tools/build_linux_x86_64_stage0_docker_v3601.no"))
    assert(t.inneholder(src, "tools/package-windows-app.no"))
    assert(t.inneholder(src, "tools/build-windows-app-layout.no"))
    assert(t.inneholder(src, "tools/verify-macos-app.no"))
    assert(t.inneholder(src, "NORSCODE_LINUX_PACKAGE_FORMAT"))
    assert(t.inneholder(src, "NORSCODE_DOCKER_BUILD_LINUX_OUTPUT"))
    assert(t.inneholder(src, "NORSCODE_WINDOWS_PACKAGE_EXE"))
    assert(t.inneholder(src, "NORSCODE_WINDOWS_LAYOUT_OUT"))
    assert(t.inneholder(src, "NORSCODE_MACOS_VERIFY_APP"))
    assert(t.inneholder(src, "tools/build-macos-app.no"))
    assert(t.inneholder(src, "tools/build-macos-window-host.no"))
    assert(t.inneholder(src, "tools/package-macos-app.no"))
    assert(t.inneholder(src, "tools/sign-macos-app.no"))
    assert(t.inneholder(src, "tools/notarize-macos-app.no"))
    assert(t.inneholder(src, "tools/install-linux-appdir.no"))
    assert(t.inneholder(src, "tools/install-linux-desktop-entry.no"))
    assert(t.inneholder(src, "tools/install-macos-app.no"))
    assert(t.inneholder(src, "tools/install-macos-file-icons.no"))
    assert(t.inneholder(src, "funksjon nc_config_verdi(sti: tekst, namn: tekst, standard: tekst) -> tekst"))
    assert(t.inneholder(src, "NORSCODE_MACOS_APP_NAME"))
    assert(t.inneholder(src, "NORSCODE_MACOS_WINDOW_OUT"))
    assert(t.inneholder(src, "NORSCODE_MACOS_PACKAGE_APP"))
    assert(t.inneholder(src, "NORSCODE_MACOS_SIGN_APP"))
    assert(t.inneholder(src, "NORSCODE_MACOS_NOTARIZE_ARTIFACT"))
    assert(t.inneholder(src, "NORSCODE_LINUX_APPDIR_ARCHIVE"))
    assert(t.inneholder(src, "NORSCODE_LINUX_DESKTOP_APPDIR"))
    assert(t.inneholder(src, "NORSCODE_MACOS_INSTALL_APP"))
    assert(t.inneholder(src, "NORSCODE_FILE_ICONS_BUNDLE_DIR"))
    assert(t.inneholder(src, "tools/nc_repl.no"))
    assert(t.inneholder(src, "scripts/regen_fraser.no"))
    assert(t.inneholder(src, "tools/norscode_feature_gate.no"))
    assert(t.inneholder(src, "tools/startproject.no"))
    assert(t.inneholder(src, "tools/startapp.no"))
    assert(t.inneholder(src, "NORSCODE_REPL_LINE"))
    assert(t.inneholder(src, "NORSCODE_FEATURE_FILES"))
    assert(t.inneholder(src, "NORSCODE_STARTPROJECT_DIR"))
    assert(t.inneholder(src, "NORSCODE_STARTAPP_NAME"))
    assert(t.inneholder(src, "hvis cmd == \"migrate\""))
    assert(t.inneholder(src, "miljo_sett(\"NC_MIGRATE_DB\", mig_db)"))
    assert(t.inneholder(src, "miljo_sett(\"NORSCODE_NCB_TO_ELF_INPUT\", tekst(argv[2]))"))
    assert(t.inneholder(src, "miljo_sett(\"NORSCODE_NCB_TO_ELF_OUTPUT\", tekst(argv[3]))"))
    assert(t.inneholder(src, "la direkte_invokasjon = cmd == \"\" og lengde(argv) > 1"))
    assert(t.inneholder(src, "miljo_sett(\"NC_NATIVE\", tekst(argv[0]))"))
    assert(t.inneholder(src, "funksjon nc_repo_root_fra_executable(executable_sti: tekst, cwd: tekst) -> tekst"))
    assert(t.inneholder(src, "builtin.fil_finnes(kandidat + \"/selfhost/nc_main.no\")"))
    assert(t.inneholder(src, "nc_repo_root_fra_executable("))
    assert(t.inneholder(src, "funksjon nc_køyr_ncb_json_modus"))
    assert(t.inneholder(src, "fns[\"__vm_force_fast__\"] = \"sann\""))
    assert(t.inneholder(src, "nc_køyr_ncb_json_modus(nc_verktøy_ncb_cached"))
    assert(t.inneholder(src, "funksjon nc_check(src_sti: tekst) -> heiltall"))
    assert(t.inneholder(src, "funksjon nc_bundle_cli(argv: liste_tekst) -> heiltall"))
    assert(t.inneholder(src, "hvis lengde(filer) == 1"))
    assert(t.inneholder(src, "returner nc_compile(filer[0], ut)"))
    assert(t.inneholder(src, "funksjon nc_bundle_fleire_direkte"))
    assert(t.inneholder(src, "returner nc_bundle_fleire_direkte(filer, ut)"))
    assert(t.inneholder(src, "funksjon nc_format_lint_cli(cmd: tekst, argv: liste_tekst) -> heiltall"))
    assert(t.inneholder(src, "cmd == \"compile\" eller cmd == \"build\""))
    assert(t.inneholder(src, "hvis cmd == \"check\""))
    assert(t.inneholder(src, "hvis cmd == \"bundle\""))
    assert(t.inneholder(src, "hvis cmd == \"format\" eller cmd == \"lint\""))
    assert(t.inneholder(src, "miljo_sett(\"NC_FORMAT_FILE\""))
    assert(t.inneholder(src, "miljo_sett(\"NC_LINT_FILE\""))
    assert(t.inneholder(src, "funksjon nc_versjon() -> tekst"))
    assert(t.inneholder(src, "la native_utan_arg = cmd == \"\" og lengde(argv) == 1"))
    assert(t.inneholder(src, "cmd == \"identity\" eller cmd == \"release\" eller cmd == \"release-targets\""))
    assert(t.inneholder(src, "funksjon nc_run_ncb_pure(sti: tekst) -> heiltall"))
    assert(t.inneholder(src, "hvis cmd == \"run-pure\""))
    assert(t.inneholder(src, "cmd == \"run-ncb-pure\" eller cmd == \"run-ncb\""))
    assert(t.inneholder(src, "miljo_sett(\"NC_SERVE_PORT\", port)"))
    assert(t.inneholder(src, "miljo_sett(\"NORSCODE_WORKERS\", workers)"))
    assert(t.inneholder(src, "miljo_sett(\"NC_TEST_FILES\", testfiler)"))
    skriv("test_native_cli_direct_tool_dispatch OK")
    returner 0
}
