bruk selfhost.nc_main som cli

funksjon start() -> heiltall {
    miljo_sett("NORSCODE_ROOT", "/repo")
    miljo_sett("HOME", "/home/test")
    assert(cli.nc_config_verdi("tools/macos-app.template.env", "APP_VERSION", "") == "0.1.0")
    assert(cli.nc_config_verdi("tools/macos-app.template.env", "WELCOME_TITLE", "") == "Norscode macOS app-bundle")

    assert(cli.nc_forbered_direkte_miljø("package-linux-app", ["nc", "package-linux-app", "--version", "1.2.3", "--format", "tarball"]))
    assert(miljo_hent("NORSCODE_LINUX_PACKAGE_VERSION") == "1.2.3")
    assert(miljo_hent("NORSCODE_LINUX_PACKAGE_FORMAT") == "tarball")
    assert(cli.nc_forbered_direkte_miljø("package-linux-app", ["nc", "package-linux-app", "--format", "appimage-adapter"]))
    assert(miljo_hent("NORSCODE_LINUX_PACKAGE_FORMAT") == "appimage-adapter")
    assert(ikkje cli.nc_forbered_direkte_miljø("package-linux-app", ["nc", "package-linux-app", "--format", "appimage"]))
    assert(ikkje cli.nc_forbered_direkte_miljø("package-linux-app", ["nc", "package-linux-app", "--format", "rar"]))

    assert(cli.nc_forbered_direkte_miljø("docker-build-linux", ["nc", "docker-build-linux", "--output", "out/norscode"]))
    assert(miljo_hent("NORSCODE_DOCKER_BUILD_LINUX_OUTPUT") == "/repo/out/norscode")
    assert(cli.nc_forbered_direkte_miljø("build-linux-stage0-docker", ["nc", "build-linux-stage0-docker"]))
    assert(ikkje cli.nc_forbered_direkte_miljø("build-linux-stage0-docker", ["nc", "build-linux-stage0-docker", "ekstra"]))

    assert(cli.nc_forbered_direkte_miljø("package-windows-app", ["nc", "package-windows-app", "--version", "2.0", "build/norscode.exe"]))
    assert(miljo_hent("NORSCODE_WINDOWS_PACKAGE_VERSION") == "2.0")
    assert(miljo_hent("NORSCODE_WINDOWS_PACKAGE_EXE") == "/repo/build/norscode.exe")

    assert(cli.nc_forbered_direkte_miljø("build-windows-app-layout", ["nc", "build-windows-app-layout", "--out", "layout", "--name", "Norscode Test", "native.exe"]))
    assert(miljo_hent("NORSCODE_WINDOWS_LAYOUT_OUT") == "/repo/layout")
    assert(miljo_hent("NORSCODE_WINDOWS_LAYOUT_NAME") == "Norscode Test")
    assert(miljo_hent("NORSCODE_WINDOWS_EXE_PATH") == "/repo/native.exe")

    assert(cli.nc_forbered_direkte_miljø("verify-macos-app", ["nc", "verify-macos-app"]))
    assert(miljo_hent("NORSCODE_MACOS_VERIFY_APP") == "/repo/build/macos-app/Norscode.app")
    assert(ikkje cli.nc_forbered_direkte_miljø("verify-macos-app", ["nc", "verify-macos-app", "a", "b"]))

    assert(cli.nc_forbered_direkte_miljø("build-macos-app", ["nc", "build-macos-app", "--mode", "terminal", "--name", "Norscode App", "--out", "ut", "--bundle-id", "dev.test", "--version", "3.0"]))
    assert(miljo_hent("NORSCODE_MACOS_APP_MODE") == "terminal")
    assert(miljo_hent("NORSCODE_MACOS_APP_NAME") == "Norscode App")
    assert(miljo_hent("NORSCODE_MACOS_APP_OUT") == "ut")
    assert(miljo_hent("NORSCODE_MACOS_APP_BUNDLE_ID") == "dev.test")
    assert(miljo_hent("NORSCODE_MACOS_APP_VERSION") == "3.0")

    assert(cli.nc_forbered_direkte_miljø("build-macos-window-host", ["nc", "build-macos-window-host", "--out", "window", "--name", "Host", "--path", "/docs", "--query", "hei"] ))
    assert(miljo_hent("NORSCODE_MACOS_WINDOW_OUT") == "window")
    assert(miljo_hent("NORSCODE_MACOS_WINDOW_NAME") == "Host")
    assert(miljo_hent("NORSCODE_MACOS_WINDOW_PATH") == "/docs")
    assert(miljo_hent("NORSCODE_MACOS_WINDOW_QUERY") == "hei")

    assert(cli.nc_forbered_direkte_miljø("package-macos-app", ["nc", "package-macos-app", "--version", "4.0", "--format", "zip", "App.app"]))
    assert(miljo_hent("NORSCODE_MACOS_PACKAGE_APP") == "/repo/App.app")
    assert(miljo_hent("NORSCODE_MACOS_PACKAGE_FORMAT") == "zip")
    assert(miljo_hent("NORSCODE_MACOS_PACKAGE_VERSION") == "4.0")

    assert(cli.nc_forbered_direkte_miljø("sign-macos-app", ["nc", "sign-macos-app", "App.app", "--identity", "Developer", "--entitlements", "ent.plist", "--verify"]))
    assert(miljo_hent("NORSCODE_MACOS_SIGN_APP") == "/repo/App.app")
    assert(miljo_hent("NORSCODE_MACOS_SIGN_ENTITLEMENTS") == "/repo/ent.plist")
    assert(miljo_hent("NORSCODE_MACOS_SIGN_VERIFY") == "1")
    assert(cli.nc_forbered_direkte_miljø("notarize-macos-app", ["nc", "notarize-macos-app", "release/app.zip"]))
    assert(miljo_hent("NORSCODE_MACOS_NOTARIZE_ARTIFACT") == "/repo/release/app.zip")

    assert(cli.nc_forbered_direkte_miljø("install-linux-appdir", ["nc", "install-linux-appdir", "app.tar.gz"]))
    assert(miljo_hent("NORSCODE_LINUX_APPDIR_PREFIX") == "/home/test/.local/opt/norscode-app")
    assert(cli.nc_forbered_direkte_miljø("install-linux-desktop-entry", ["nc", "install-linux-desktop-entry", "AppDir", "--prefix", "/share"]))
    assert(miljo_hent("NORSCODE_LINUX_DESKTOP_APPDIR") == "AppDir")
    assert(miljo_hent("NORSCODE_LINUX_DESKTOP_PREFIX") == "/share")

    assert(cli.nc_forbered_direkte_miljø("install-macos-app", ["nc", "install-macos-app", "App.app", "--dest", "Applications", "--name", "Test"] ))
    assert(miljo_hent("NORSCODE_MACOS_INSTALL_APP") == "/repo/App.app")
    assert(miljo_hent("NORSCODE_MACOS_INSTALL_DEST") == "/repo/Applications")
    assert(miljo_hent("NORSCODE_MACOS_INSTALL_NAME") == "Test.app")
    assert(cli.nc_forbered_direkte_miljø("install-macos-file-icons", ["nc", "install-macos-file-icons", "--bundle-dir", "/icons.app", "--skip-register"]))
    assert(miljo_hent("NORSCODE_FILE_ICONS_BUNDLE_DIR") == "/icons.app")
    assert(miljo_hent("NORSCODE_FILE_ICONS_SKIP_REGISTER") == "sann")

    assert(cli.nc_forbered_direkte_miljø("repl", ["nc", "repl", "1", "+", "2"]))
    assert(miljo_hent("NORSCODE_REPL_LINE") == "1 + 2")
    assert(cli.nc_forbered_direkte_miljø("feature-check", ["nc", "feature-check", "a.no", "b.no"]))
    assert(miljo_hent("NORSCODE_FEATURE_FILES") == "a.no\nb.no\n")
    assert(cli.nc_forbered_direkte_miljø("regen-fraser", ["nc", "regen-fraser"]))
    assert(ikkje cli.nc_forbered_direkte_miljø("regen-fraser", ["nc", "regen-fraser", "ekstra"]))

    assert(cli.nc_forbered_direkte_miljø("startproject", ["nc", "startproject", "prosjekt", "--name", "Mitt prosjekt", "--path", "/ut", "--db", "data.db", "--with-auth", "--with-admin"]))
    assert(miljo_hent("NORSCODE_STARTPROJECT_DIR") == "prosjekt")
    assert(miljo_hent("NORSCODE_STARTPROJECT_OUTPUT_DIR") == "/ut")
    assert(miljo_hent("NORSCODE_STARTPROJECT_NAME") == "Mitt prosjekt")
    assert(miljo_hent("NORSCODE_STARTPROJECT_DB") == "data.db")
    assert(miljo_hent("NORSCODE_STARTPROJECT_WITH_AUTH") == "sann")
    assert(miljo_hent("NORSCODE_STARTPROJECT_WITH_ADMIN") == "sann")
    assert(cli.nc_forbered_direkte_miljø("scaffold-api", ["nc", "scaffold-api", "api"]))
    assert(miljo_hent("NORSCODE_STARTPROJECT_NAME") == "api")
    assert(cli.nc_forbered_direkte_miljø("startapp", ["nc", "startapp", "butikk", "--path", "/prosjekt"]))
    assert(miljo_hent("NORSCODE_STARTAPP_NAME") == "butikk")
    assert(miljo_hent("NORSCODE_STARTAPP_PROJECT_ROOT") == "/prosjekt")

    skriv("test_native_cli_argument_environment OK")
    returner 0
}
