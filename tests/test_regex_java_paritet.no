// Regresjon (Java-paritet F40): std.regex (java.util.regex-semantikk).
// Før omskrivinga: escapa literal (\.) matcha aldri, {m,n} vart ignorert,
// kvantor på grupper ((?:ab)+) fann ingenting, (?P<x>...) kasta IndeksFeil,
// og backtrackinga var eksponentiell (1510 teikn tok 13 min på VM-en).
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.regex som re

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon lj(l) -> tekst {
    la r = ""
    for x i l { r = r + "[" + tekst(x) + "]" }
    returner r
}

funksjon kompileringsfeil(mønster: tekst) -> bool {
    la kasta = usann
    prøv {
        re.kompiler(mønster)
    } fang (e) {
        kasta = builtin.starts_with(tekst(e), "regex:")
    }
    returner kasta
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]

    // Escapar og teiknklassar
    la t = "xy bruker0@eksempel.no z"
    sjekk(feil, "\\.no", re.finn(t, "\\.no"), ".no")
    sjekk(feil, "\\w+\\.no", re.finn(t, "\\w+\\.no"), "eksempel.no")
    sjekk(feil, "e-post", re.finn(t, "[a-z0-9]+@[a-z]+\\.no"), "bruker0@eksempel.no")
    sjekk(feil, "klasse med escapar", re.finn("a-b_c.d", "[\\w.-]+"), "a-b_c.d")
    sjekk(feil, "negert klasse", re.finn("abc123", "[^a-z]+"), "123")
    sjekk(feil, "\\D\\S\\W", re.finn("12 ab!", "\\D\\S\\W"), "ab!")
    sjekk(feil, "\\t og \\x41", re.finn("x\tAy", "\\t\\x41"), "\tA")
    sjekk(feil, "literal spesialteikn", re.finn("a+b*c", "a\\+b\\*c"), "a+b*c")

    // Kvantorar {m} {m,} {m,n}, late og literal {
    sjekk(feil, "\\d{4}", re.finn("år 2026", "\\d{4}"), "2026")
    sjekk(feil, "{2,3}", re.finn("aaaa", "a{2,3}"), "aaa")
    sjekk(feil, "{2,}", re.finn("baaaaab", "a{2,}"), "aaaaa")
    sjekk(feil, "{2,3}?", re.finn("aaaa", "a{2,3}?"), "aa")
    sjekk(feil, "{3} for få", tekst(re.samsvar("aa", "^a{3}$")), "usann")
    sjekk(feil, "literal {", re.finn("f{x}", "f{x}"), "f{x}")
    sjekk(feil, "lat .*?", re.finn("<a><b>", "<.*?>"), "<a>")
    sjekk(feil, "grådig .*", re.finn("<a><b>", "<.*>"), "<a><b>")

    // Grupper
    sjekk(feil, "(?:ab)+", re.finn("xababy", "(?:ab)+"), "abab")
    sjekk(feil, "(ab){2}", re.finn("abababx", "(ab){2}"), "abab")
    la m = re.finn_samsvar(re.kompiler("(\\d+)-(\\w+)"), "abc 42-hei xyz")
    sjekk(feil, "grupper", re.gruppe(m, 0) + "|" + re.gruppe(m, 1) + "|" + re.gruppe(m, 2), "42-hei|42|hei")
    sjekk(feil, "start/slutt", tekst(re.samsvar_start(m)) + "-" + tekst(re.samsvar_slutt(m)), "4-10")
    la nm = re.finn_samsvar(re.kompiler("(?P<aar>\\d{4})-(?<mnd>\\d\\d)"), "dato 2026-09 ok")
    sjekk(feil, "namngjevne", re.named_gruppe(nm, "aar") + "/" + re.named_gruppe(nm, "mnd") + "/" + re.gruppe(nm, 2), "2026/09/09")
    la nx = re.finn_samsvar(re.kompiler("(?P<x>a+)"), "baaa")
    sjekk(feil, "(?P<x>a+)", re.named_gruppe(nx, "x"), "aaa")
    la valfri = re.finn_samsvar(re.kompiler("a(b)?c"), "ac")
    sjekk(feil, "gruppe ikkje med", re.gruppe(valfri, 1) + tekst(re.gruppe_start(valfri, 1)), "-1")
    la siste = re.finn_samsvar(re.kompiler("(?:(\\d)x)+"), "1x2x3x")
    sjekk(feil, "siste iterasjon", re.gruppe(siste, 1), "3")

    // Alternering, ankre, flagg
    sjekk(feil, "alternering", re.finn("ein hund", "katt|hund"), "hund")
    sjekk(feil, "alternering i gruppe", re.finn("gråkatt", "grå(katt|hund)"), "gråkatt")
    sjekk(feil, "fullsamsvar a|ab", tekst(re.passar_heilt("ab", "a|ab")), "sann")
    sjekk(feil, "fullsamsvar nei", tekst(re.passar_heilt("abc", "[a-z]+\\d")), "usann")
    sjekk(feil, "^ utan m", tekst(re.samsvar("a\nb", "^b")), "usann")
    sjekk(feil, "(?m)^b", tekst(re.samsvar("a\nb", "(?m)^b")), "sann")
    sjekk(feil, "$ før siste \\n", tekst(re.samsvar("abc\n", "c$")), "sann")
    sjekk(feil, "\\b", lj(re.finn_alle("katt kattunge", "\\bkatt\\b")), "[katt]")
    sjekk(feil, "(?i)", re.finn("sei HeI", "(?i)hei"), "HeI")
    sjekk(feil, "(?i) æøå", re.finn("BLÅBÆR", "(?i)blåbær"), "BLÅBÆR")
    sjekk(feil, "(?i:) avgrensa", re.finn("aB Ab", "(?i:a)b"), "Ab")
    sjekk(feil, ". og \\n", tekst(re.samsvar("a\nb", "a.b")) + tekst(re.samsvar("a\nb", "(?s)a.b")), "usannsann")
    sjekk(feil, "(?x)", re.finn("ab12", "(?x) [a-z]+  \\d+  # kommentar"), "ab12")
    // (?i) + negert klasse: negasjonen gjeld alle kasusvariantane (Java)
    sjekk(feil, "(?i)[^a] på A", tekst(re.samsvar("A", "(?i)[^a]")), "usann")
    sjekk(feil, "(?i)[^A-Z] på a", tekst(re.samsvar("a", "(?i)[^A-Z]")), "usann")
    sjekk(feil, "(?i)[^æ] på Æ", tekst(re.samsvar("Æ", "(?i)[^æ]")), "usann")
    sjekk(feil, "(?i)[^a-z]+", re.finn("abC12dE", "(?i)[^a-z]+"), "12")
    sjekk(feil, "(?i)[a-z]+ på ABC", re.finn("xABC1", "(?i)[a-z]+"), "xABC")

    // Lookahead
    sjekk(feil, "(?=)", re.finn("pris: 100kr 200$", "\\d+(?=\\$)"), "200")
    sjekk(feil, "(?!)", re.finn("abc abd", "ab(?!c)\\w"), "abd")
    sjekk(feil, "(?!) etter \\d+", lj(re.finn_alle("12px 34em", "\\d+(?!px)")), "[1][34]")
    sjekk(feil, "nesta lookahead", tekst(re.samsvar_start(re.finn_samsvar(re.kompiler("a(?=b(?!c))"), "abc abd"))), "4")
    sjekk(feil, "lookahead i løkke", re.finn("abc!", "(?:(?=\\w)\\w)+"), "abc")
    sjekk(feil, "lookahead delt memo", lj(re.finn_alle("aaaab aac", ".(?=a*b)")), "[a][a][a][a]")
    sjekk(feil, "\\w+(?=!)", re.finn("abc def!", "\\w+(?=!)"), "def")
    // Fangstar i positiv lookahead blir behaldne; ikkje i negativ, og ikkje
    // etter backtracking forbi lookaheaden.
    la lf = re.finn_samsvar(re.kompiler("(?=(\\d+))\\w"), "123")
    sjekk(feil, "lookahead-fangst", re.gruppe(lf, 0) + "|" + re.gruppe(lf, 1) + "|" + tekst(re.gruppe_start(lf, 1)), "1|123|0")
    la ln = re.finn_samsvar(re.kompiler("(?!(x))a"), "a")
    sjekk(feil, "negativ lookahead-fangst", tekst(re.gruppe_start(ln, 1)), "-1")
    la lb = re.finn_samsvar(re.kompiler("(?=(ab))ac|ab"), "ab")
    sjekk(feil, "lookahead-fangst rulla attende", re.gruppe(lb, 0) + "|" + tekst(re.gruppe_start(lb, 1)), "ab|-1")

    // Unicode: kodepunkt, ikkje byte
    sjekk(feil, "[æøå]+", re.finn("blåbærøy", "[æøå]+"), "å")
    sjekk(feil, ". tek heile teikn", re.finn("xåy", "x.y"), "xåy")
    la um = re.finn_samsvar(re.kompiler("b+"), "æøåbb")
    sjekk(feil, "kodepunkt-posisjon", tekst(re.samsvar_start(um)), "3")

    // finn_alle / erstatt_alle / del_på
    sjekk(feil, "finn_alle", lj(re.finn_alle("a1b22c333", "\\d+")), "[1][22][333]")
    sjekk(feil, "erstatt_alle", re.erstatt_alle_tekst("programmering", "[aeiou]", "*"), "pr*gr*mm*r*ng")
    sjekk(feil, "erstatt tomt treff", re.erstatt_alle_tekst("abc", "x*", "-"), "-a-b-c-")
    sjekk(feil, "del_på", lj(re.del_på(re.kompiler(",\\s*"), "a, b,c ,  d")), "[a][b][c ][d]")
    sjekk(feil, "erstatt første", re.erstatt_tekst("a1b2", "\\d", "#"), "a#b2")
    la objekt = re.finn_alle_objekt(re.kompiler("(\\w)(\\d)"), "a1 b2")
    sjekk(feil, "finn_alle_objekt", re.gruppe(objekt[1], 1) + re.gruppe(objekt[1], 2), "b2")

    // Patologiske mønster skal ikkje eksplodere (memo på SPLIT × posisjon)
    la mange_a = ""
    la i = 0
    mens i < 30 {
        mange_a = mange_a + "a"
        i = i + 1
    }
    sjekk(feil, "(a+)+b", tekst(re.samsvar(mange_a + "c", "(a+)+b")), "usann")
    sjekk(feil, "(a|aa)*c", tekst(re.samsvar(mange_a, "^(a|aa)*c$")), "usann")
    sjekk(feil, "(a*)* terminerer", re.finn("aaab", "(a*)*b"), "aaab")
    sjekk(feil, "()* terminerer", re.finn("x", "()*x"), "x")

    // Lookahead skal ikkje gjere søket kvadratisk. Før: fersk memo per
    // evaluering, fylt opp til posisjon × talet på SPLIT → 4800 teikn tok 28 s
    // med x(?=y+) mot 0,7 s med xy+ (VM_FAST). Dei åtte ?-a gir fleire SPLIT,
    // så skilnaden syner seg alt ved 300 teikn (før: 726 mot 68 ms; etter:
    // om lag 1,3×). Samanliknar mot same tekst utan lookahead i same prosess,
    // med romsleg margin.
    la delar: liste_tekst = []
    i = 0
    mens i < 100 {
        legg_til(delar, "xy ")
        i = i + 1
    }
    la lang = builtin.join(delar, "")
    la tok_look = re.kompiler("x(?=y+)a?b?c?d?e?f?g?h?")
    la tok_utan = re.kompiler("xy+a?b?c?d?e?f?g?h?")
    la t0 = builtin.tid_ms()
    la n_look = lengde(re.finn_alle_samsvar(tok_look, lang))
    la t1 = builtin.tid_ms()
    la n_utan = lengde(re.finn_alle_samsvar(tok_utan, lang))
    la t2 = builtin.tid_ms()
    sjekk(feil, "lookahead-treff", tekst(n_look) + "/" + tekst(n_utan), "100/100")
    hvis (t1 - t0) > 4 * (t2 - t1) + 100 {
        skriv("FEIL lookahead kvadratisk: " + tekst(t1 - t0) + " ms mot " + tekst(t2 - t1) + " ms utan\n")
        feil[0] = feil[0] + 1
    }

    // Ikkje støtta → tydeleg kompileringsfeil (ikkje stille feil treff)
    sjekk(feil, "tilbakereferanse", tekst(kompileringsfeil("(a)\\1")), "sann")
    sjekk(feil, "lookbehind", tekst(kompileringsfeil("(?<=a)b")), "sann")
    sjekk(feil, "manglar )", tekst(kompileringsfeil("(ab")), "sann")
    sjekk(feil, "ubalansert )", tekst(kompileringsfeil("ab)")), "sann")
    sjekk(feil, "manglar ]", tekst(kompileringsfeil("[ab")), "sann")
    sjekk(feil, "kvantor utan atom", tekst(kompileringsfeil("*a")), "sann")

    hvis feil[0] == 0 { skriv("test_regex_java_paritet OK\n") }
    returner feil[0]
}
