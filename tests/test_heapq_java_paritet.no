// Regresjon (Java-paritet F40): heappop/heappop_t/pk_pop og prioritet.pop må
// krympe heapen, så `mens ikkje er_tom(h)` terminerer (java.util.PriorityQueue
// poll). Før fiksen krymte heappop aldri lista (løkka gjekk evig), og
// prioritet.pop brukte fjern_indeks, som er stille no-op på x86-64-AOT.
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.heapq som hq
bruk std.prioritet som pq

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]

    // heappush/heappop: sortert ut, tom etterpå, vakt mot evig løkke.
    la h: liste_heltall = []
    for v i [5, 2, 8, 1, 9, 3, 7] { hq.heappush(h, v) }
    la ut = ""
    la vakt = 0
    mens ikkje hq.er_tom(h) og vakt < 100 {
        ut = ut + tekst(hq.heappop(h)) + ","
        vakt = vakt + 1
    }
    sjekk(feil, "heappop-rekkjefølgje", ut, "1,2,3,5,7,8,9,")
    sjekk(feil, "heappop-tal", tekst(vakt), "7")
    sjekk(feil, "heappop-tom", tekst(lengde(h)), "0")
    sjekk(feil, "heappop frå tom", tekst(hq.heappop(h)), "0")

    // heapify + nsmallest/nlargest (brukar heappop internt).
    la l: liste_heltall = [9, 4, 7, 1, 8, 2]
    sjekk(feil, "nsmallest", tekst(hq.nsmallest(3, l)[0]) + tekst(hq.nsmallest(3, l)[2]), "14")
    sjekk(feil, "nlargest", tekst(hq.nlargest(2, l)[0]) + tekst(hq.nlargest(2, l)[1]), "98")

    // heapreplace på tom heap skal ikkje krasje.
    la tom: liste_heltall = []
    sjekk(feil, "heapreplace tom", tekst(hq.heapreplace(tom, 4)) + "/" + tekst(lengde(tom)), "0/1")

    // Tekst-heap.
    la ht: liste_tekst = []
    for s i ["pære", "eple", "banan"] { hq.heappush_t(ht, s) }
    la ut_t = ""
    vakt = 0
    mens lengde(ht) > 0 og vakt < 100 {
        ut_t = ut_t + hq.heappop_t(ht) + ","
        vakt = vakt + 1
    }
    sjekk(feil, "heappop_t", ut_t, "banan,eple,pære,")

    // Prioritetskø med tekstverdiar.
    la k = hq.ny_prioritetskø()
    hq.pk_push(k, 3, "c")
    hq.pk_push(k, 1, "a")
    hq.pk_push(k, 2, "b")
    la ut_k = ""
    vakt = 0
    mens ikkje hq.pk_er_tom(k) og vakt < 100 {
        ut_k = ut_k + hq.pk_pop(k)
        vakt = vakt + 1
    }
    sjekk(feil, "pk_pop", ut_k, "abc")

    // std.prioritet: pop og pq_pop_verdi.
    la p = pq.ny()
    for v i [5, 2, 8, 1] { pq.dytt(p, v) }
    la ut_p = ""
    vakt = 0
    mens ikkje pq.er_tom(p) og vakt < 100 {
        ut_p = ut_p + tekst(pq.pop(p)) + ","
        vakt = vakt + 1
    }
    sjekk(feil, "prioritet.pop", ut_p, "1,2,5,8,")
    la h2: liste_tekst = []
    pq.pq_dytt(h2, 3, "c")
    pq.pq_dytt(h2, 1, "a")
    pq.pq_dytt(h2, 2, "b")
    la ut_v = ""
    vakt = 0
    mens ikkje pq.pq_er_tom(h2) og vakt < 100 {
        ut_v = ut_v + pq.pq_pop_verdi(h2)
        vakt = vakt + 1
    }
    sjekk(feil, "prioritet.pq_pop_verdi", ut_v, "abc")

    // Større mengd: 500 pseudo-tilfeldige, må kome ut sorterte.
    la stor: liste_heltall = []
    la x = 7
    la i = 0
    mens i < 500 {
        x = (x * 1103515245 + 12345) % 2147483648
        hq.heappush(stor, x % 1000)
        i = i + 1
    }
    la førre = -1
    la sortert = sann
    la tal = 0
    mens ikkje hq.er_tom(stor) og tal < 1000 {
        la v = hq.heappop(stor)
        hvis v < førre { sortert = usann }
        førre = v
        tal = tal + 1
    }
    sjekk(feil, "500 sortert", tekst(sortert) + "/" + tekst(tal), "sann/500")

    hvis feil[0] == 0 { skriv("test_heapq_java_paritet OK\n") }
    returner feil[0]
}
