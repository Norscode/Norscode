// Selfcompile må krevje null uløyste kall, sjølv med lempeleg kallarmiljø.
bruk tools.selfcompile_stage0_elf som bygg

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/selfcompile_strict_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(base)
    la inn = base + "/program.ncb.json"
    la ut = base + "/program.elf"
    la ukjent = "builtin.selfcompile_test_uloeyst"
    la før_rapport = miljo_hent("NC_BUILTIN_REPORT")
    la før_liste = miljo_hent("NC_BUILTIN_KVITLISTE")
    miljo_sett("NC_BUILTIN_REPORT", "0")
    miljo_sett("NC_BUILTIN_KVITLISTE", ukjent + "/1")
    la program = {"format": "norscode-bytecode-v1", "entry": "start", "functions": {
        "start": {"params": [], "code": [["PUSH_CONST", 0], ["RETURN"]]}
    }}
    builtin.fil_skriv(inn, builtin.json_skriv(program))
    assert(bygg.ncb_to_elf(root, inn, ut))
    assert(builtin.fil_finnes(ut))
    program["functions"]["start"]["code"] = [["PUSH_CONST", 7], ["CALL", ukjent, 1], ["POP"], ["PUSH_CONST", 0], ["RETURN"]]
    builtin.fil_skriv(inn, builtin.json_skriv(program))
    la godkjend = bygg.ncb_to_elf(root, inn, ut)
    miljo_sett("NC_BUILTIN_REPORT", før_rapport)
    miljo_sett("NC_BUILTIN_KVITLISTE", før_liste)
    assert(ikkje godkjend)
    assert(ikkje builtin.fil_finnes(ut))
    skriv("test_selfcompile_strict_codegen OK\n")
    returner 0
}
