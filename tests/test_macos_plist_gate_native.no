bruk std.filops som filops
bruk tools.macos_plist_gate_v1 som gate

funksjon start() -> heiltall {
    la root = "build/test-macos-plist-gate"
    filops.slett_tre(root)
    assert(filops.lag_katalogar(root))
    la sti = root + "/Info.plist"
    builtin.fil_skriv(sti,
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
        "<plist version=\"1.0\">\n<dict>\n" +
        "<key>CFBundleIdentifier</key>\n<string>dev.norscode.test</string>\n" +
        "<key>CFBundleExecutable</key>\n<string>Norscode</string>\n" +
        "<key>CFBundlePackageType</key>\n<string>APPL</string>\n" +
        "<key>CFBundleVersion</key>\n<string>1</string>\n" +
        "</dict>\n</plist>\n")
    assert(gate.valider_info(sti))
    builtin.fil_skriv(sti,
        "<plist><dict><key>CFBundleIdentifier</key><string>dev.norscode.compact</string>" +
        "<key>CFBundleExecutable</key><string>Norscode</string>" +
        "<key>CFBundlePackageType</key><string>APPL</string>" +
        "<key>CFBundleVersion</key><string>2</string></dict></plist>")
    assert(gate.valider_info(sti))
    builtin.fil_skriv(sti, "<plist><dict><key>CFBundleIdentifier</key><string>x</string></dict></plist>")
    assert(ikkje gate.valider_info(sti))
    filops.slett_tre(root)
    skriv("test_macos_plist_gate_native OK\n")
    returner 0
}
