# F43: refleksjon og annotasjonar.
#   (a) @namn / @namn(lit, …) på funksjon, struktur og strukturfelt blir NCB-metadata
#       (nøklane annotasjonar / felt_annotasjonar); utan annotasjonar er NCB-en uendra
#       og køyretida er den same.
#   (b) typar_av / type_info / funksjon_info / finn_med_annotasjon / hent_felt / sett_felt.
#   (c) tests/fixtures/f43_rute_app.no: ein ruter som registrerer @rute-handlarar via refleksjon.
# Køyrer KJELDE-kompilatoren og VM-en (ingen reseed).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon ncb_av(kjelde: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
}

funksjon rå_ncb(kjelde: tekst) -> tekst {
    returner kompiler.kompiler_fil(kjelde, "__main__")
}

funksjon feil_ved(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "INGEN-FEIL"
}

funksjon start() -> heiltall {
    # ── (a) NCB-metadata ────────────────────────────────────────────────
    la kjelde = "struktur Punkt {\n    @felt(\"x\", 1, -2.5, sann, usann, null, \"\")\n    x: heltall = 5\n    @nokkel\n    y\n}\n" +
        "@rute(\"/v/{id}\")\n@lat\n@utdatert(\"bruk ny\")\nfunksjon hent(id: heltall) -> tekst {\n    returner \"a\"\n}\n" +
        "@modell\nstruktur Boks { v }\n" +
        "funksjon vanleg() { returner 1 }\nfunksjon start() { returner 0 }\n"
    la ncb = ncb_av(kjelde)
    la fns = ncb["functions"]
    la a = fns["__main__.hent"]["annotasjonar"]
    assert_eq(lengde(a), 3)
    assert_eq(a[0]["name"], "rute")
    assert_eq(a[0]["args"][0], "/v/{id}")
    assert_eq(a[1]["name"], "lat")
    assert_eq(lengde(a[1]["args"]), 0)
    assert_eq(a[2]["args"][0], "bruk ny")
    la fa = fns["__main__.Punkt"]["felt_annotasjonar"]
    assert_eq(builtin.join(nøkler(fa), ","), "x,y")
    assert_eq(builtin.join([tekst(fa["x"][0]["args"][0]), tekst(fa["x"][0]["args"][1]), tekst(fa["x"][0]["args"][2]), tekst(fa["x"][0]["args"][3]), tekst(fa["x"][0]["args"][4]), tekst(fa["x"][0]["args"][5]) == "", tekst(fa["x"][0]["args"][6]) == ""], ";"), "x;1;-2.5;" + tekst(sann) + ";" + tekst(usann) + ";" + tekst(sann) + ";" + tekst(sann))
    assert_eq(fa["y"][0]["name"], "nokkel")
    assert_eq(fns["__main__.Boks"]["annotasjonar"][0]["name"], "modell")
    assert_eq(builtin.type(fns["__main__.Punkt"]["annotasjonar"]), "ingenting")
    assert(ikkje har_nokkel(fns["__main__.vanleg"], "annotasjonar"))
    assert(ikkje har_nokkel(fns["__main__.start"], "annotasjonar"))
    assert(ikkje har_nokkel(fns["__main__.Boks"], "felt_annotasjonar"))

    # Utan annotasjonar: ingen nye nøklar i NCB-en, og koden er lik med/utan.
    la utan = "struktur Punkt {\n    x: heltall = 5\n    y\n}\n" +
        "funksjon hent(id: heltall) -> tekst {\n    returner \"a\"\n}\n" +
        "struktur Boks { v }\n" +
        "funksjon vanleg() { returner 1 }\nfunksjon start() { returner 0 }\n"
    la raa = rå_ncb(utan)
    assert(ikkje builtin.contains(raa, "annotasjonar"))
    la n2 = builtin.json_parse_raw(raa)
    assert_eq(builtin.json_stringify(n2["functions"]["__main__.hent"]["code"]), builtin.json_stringify(fns["__main__.hent"]["code"]))
    assert_eq(builtin.json_stringify(n2["functions"]["__main__.Punkt"]["code"]), builtin.json_stringify(fns["__main__.Punkt"]["code"]))

    # @ i tekst og kommentar kolliderer ikkje.
    la med_at = "# @kommentar\nfunksjon start() {\n    la e = \"a@b.no\" // @ikkje\n    returner e\n}\n"
    assert(ikkje builtin.contains(rå_ncb(med_at), "annotasjonar"))

    # Feil: annotasjon føre noko som ikkje er funksjon/struktur, ikkje-literalt argument, hengande annotasjon.
    assert(builtin.contains(feil_ved("@lat\nla x = 1\nfunksjon start() { returner x }\n"), "annotasjonar kan berre stå framfor"))
    assert(builtin.contains(feil_ved("@rute(x)\nfunksjon start() { returner 0 }\n"), "må vere ein literal"))
    assert(builtin.contains(feil_ved("funksjon start() { returner 0 }\n@lat\n"), "annotasjon utan deklarasjon"))

    # ── (b) refleksjon ───────────────────────────────────────────────────
    la ut = builtin.split(tekst(vm.køyr_ncb(ncb_av(fil_les("tests/fixtures/f43_refl_app.no")))), "\n")
    assert_eq(ut[0], "Vare|3|ukjend|visningsnamn")
    assert_eq(ut[1], "areal,vis|__main__.Form")
    assert_eq(ut[2], "tekst|3|restensann")
    assert_eq(ut[3], "2hent_vareHEAD")
    assert_eq(ut[4], "koppkrusVare__main__.hent_vare")

    # ── (c) @rute-ruter via refleksjon ───────────────────────────────────
    la r = builtin.split(tekst(vm.køyr_ncb(ncb_av(fil_les("tests/fixtures/f43_rute_app.no")))), "|")
    assert_eq(r[0], "vare 7")
    assert_eq(r[1], "alle varer")
    assert_eq(r[2], "alle varer")
    assert_eq(r[3], "oppretta")
    assert_eq(r[4], "404")
    assert_eq(r[5], "4")
    assert_eq(r[6], "opprett_vare:bruk /varer")
    skriv("test_f43_refleksjon OK\n")
    returner 0
}
