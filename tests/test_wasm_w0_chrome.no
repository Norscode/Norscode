# W0 (WASM-sporet): røyktest i ekte headless Chrome. VALFRI: finst ikkje Chrome/Chromium
# (NC_CHROME, standardstiane på macOS og Linux), seier testen tydeleg SKIP og returnerer 0.
#
# Flagga er dei frå planen (§4.4): utan dei heng headless Chrome ofte mot nc serve, som
# tek éi tilkopling om gongen. Stdout blir lesen til </html>, så blir Chrome stoppa.
#
#   1. Teljar (testbygg, tests/fixtures/wasm_teljar_testklient.no): den ekte
#      examples/wasm_teljar/klient.no, og testklienten klikkar knappen tre gonger via
#      test_klikk → <output id="ut">3</output> og sum-teksten sett via sett_html (escapa).
#   2. NEGATIV KONTROLL: same side og same lastar med standard-CSP (utan
#      'wasm-unsafe-eval') → nettlesaren nektar å kompilere modulen, og sida står
#      urørt med 0. Kontrollen krev at sida faktisk vart lasta (</html>).
#   3. Paritet: tests/wasm_korpus/aritm.no og kontroll.no skriv resultata sine inn i sida;
#      verdiane må vere identiske med det VM-en reknar ut med dei same funksjonane
#      (fak(20) over i31-grensa, trunkerande divisjon/rest, bitoperasjonar, og/eller).
# Alle prosessar (nc serve, Chrome) blir stoppa før påstandane blir sjekka.
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_chrome_hjelp som ch
bruk tests.wasm_korpus.aritm som aritm
bruk tests.wasm_korpus.kontroll som kontroll

# Bygg, server og dump éi eller fleire sider. Gjev liste med dump-tekstar.
funksjon køyr(chrome: tekst, kjelde: tekst, namn: tekst, testbygg: bool, port: tekst, stiar: liste) -> liste {
    la ut = "build/wasm/test_chrome/" + namn
    hjelp.bygg_klient_app(kjelde, ut, testbygg, "examples/wasm_teljar/app.no")
    la app = hjelp.serve_inngang(ut)
    la s = ch.start_serve(app, port)
    hvis s["status"] != "kjorer" {
        skriv("nc serve for " + namn + " starta ikkje:\n" + tekst(s["ut"]) + "\n")
        assert(usann)
    }
    la dumpar = []
    la i = 0
    mens i < lengde(stiar) {
        legg_til(dumpar, ch.dump_side(chrome, "http://127.0.0.1:" + port + stiar[i], ut, tekst(i)))
        i = i + 1
    }
    ch.stopp(s)
    returner dumpar
}

funksjon krev(dump_tekst: tekst, nål: tekst, kva: tekst) -> heltall {
    returner ch.krev(dump_tekst, nål, kva)
}

funksjon start() -> heltall {
    la chrome = ch.finn_chrome()
    hvis chrome == "" {
        skriv("test_wasm_w0_chrome OK (SKIP: fann ikkje Chrome/Chromium; set NC_CHROME=<sti>)\n")
        returner 0
    }
    skriv("Chrome: " + chrome + "\n")
    hjelp.mkdir("build/wasm/test_chrome")

    la teljar = køyr(chrome, "tests/fixtures/wasm_teljar_testklient.no", "teljar", sann, "48321",
                     ["/", "/kontroll/streng-csp"])
    la ar = køyr(chrome, "tests/wasm_korpus/aritm.no", "aritm", usann, "48322", ["/"])
    la ko = køyr(chrome, "tests/wasm_korpus/kontroll.no", "kontroll", usann, "48323", ["/"])

    # 1. Teljaren etter tre klikk
    krev(teljar[0], "</html>", "teljar")
    krev(teljar[0], "<output id=\"ut\">3</output>", "teljar")
    krev(teljar[0], "<p id=\"sum\">Sum 1..n = <b>6</b> (oddetal)</p>", "teljar")
    # 2. Negativ kontroll: sida er lasta, men WASM vart stoppa av CSP
    krev(teljar[1], "</html>", "negativ kontroll")
    krev(teljar[1], "<output id=\"ut\">0</output>", "negativ kontroll")
    krev(teljar[1], "<p id=\"sum\"></p>", "negativ kontroll")
    # 3. Paritet med VM-en
    la f20 = aritm.fak(20)
    krev(ar[0], "<h1>" + tekst(f20) + "</h1>", "aritm fak(20)")
    krev(ar[0], "<p>" + tekst(aritm.deling()) + "</p>", "aritm deling")
    krev(ar[0], "type=\"button\">" + tekst(aritm.bitar()) + "</button>", "aritm bitar")
    krev(ar[0], "<output id=\"ut\">" + tekst(aritm.logikk_kode()) + "</output>", "aritm logikk")
    krev(ar[0], "<p id=\"sum\">" + tekst(aritm.grenser()) + "</p>", "aritm grenser")
    krev(ar[0], "<a href=\"/om\">" + tekst(aritm.kall_tal()) + "</a>", "aritm kall_tal")
    krev(ko[0], "<output id=\"ut\">" + tekst(kontroll.primtal_under(100)) + "</output>", "kontroll primtal")
    krev(ko[0], "<p id=\"sum\">" + tekst(kontroll.klassar(20)) + "</p>", "kontroll klassar")

    skriv("test_wasm_w0_chrome OK\n")
    returner 0
}
