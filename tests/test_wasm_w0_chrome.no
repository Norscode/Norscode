# W0 (WASM-sporet): røyktest i ekte headless Chrome. VALFRI: finst ikkje Chrome/Chromium
# (NC_CHROME, standardstiane på macOS og Linux), seier testen tydeleg SKIP og returnerer 0.
#
# Flagga er dei frå planen (§4.4): utan dei heng headless Chrome ofte mot nc serve, som
# tek éi tilkopling om gongen. Stdout blir lesen til </html>, så blir Chrome stoppa.
#
#   1. Teljar (testbygg, tests/fixtures/wasm_teljar_testklient.no): den ekte
#      examples/wasm_teljar/klient.no, og testklienten klikkar knappen tre gonger via
#      test_klikk → <output id="ut">3</output> og sum-teksten sett via sett_html (escapa).
#   2. NEGATIV KONTROLL: same side og same lastar med standard-CSP (utan
#      'wasm-unsafe-eval') → nettlesaren nektar å kompilere modulen, og sida står
#      urørt med 0. Kontrollen krev at sida faktisk vart lasta (</html>).
#   3. Paritet: tests/wasm_korpus/aritm.no og kontroll.no skriv resultata sine inn i sida;
#      verdiane må vere identiske med det VM-en reknar ut med dei same funksjonane
#      (fak(20) over i31-grensa, trunkerande divisjon/rest, bitoperasjonar, og/eller).
# Alle prosessar (nc serve, Chrome) blir stoppa før påstandane blir sjekka.
bruk std.prosess som prosess
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.wasm_korpus.aritm som aritm
bruk tests.wasm_korpus.kontroll som kontroll

funksjon policy() -> ordbok_tekst {
    la p = prosess.ny_policy("wasm-chrome-royk")
    prosess.tillat_alle(p)
    prosess.aktiver_køyring(p)
    returner p
}

funksjon nettlesarmiljø() -> ordbok_tekst {
    returner {"PATH": "/usr/bin:/bin", "HOME": miljo_hent("HOME"), "TMPDIR": "/tmp"}
}

funksjon finn_chrome() -> tekst {
    la kandidatar = []
    la eigen = miljo_hent("NC_CHROME")
    hvis eigen != "" {
        legg_til(kandidatar, eigen)
    } ellers {
        legg_til(kandidatar, "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
        legg_til(kandidatar, "/Applications/Chromium.app/Contents/MacOS/Chromium")
        legg_til(kandidatar, "/usr/bin/google-chrome")
        legg_til(kandidatar, "/usr/bin/chromium")
        legg_til(kandidatar, "/usr/bin/chromium-browser")
    }
    la i = 0
    mens i < lengde(kandidatar) {
        la plan = prosess.start_argv_plan(kandidatar[i], ["--version"])
        prosess.med_miljø(plan, nettlesarmiljø())
        prosess.med_timeout(plan, 30)
        prosess.med_sandbox(plan, "none", 8589934592, 4096, usann)
        la h = prosess.start_argv_async_trygt(policy(), plan)
        hvis h["status"] == "kjorer" {
            la ferdig = prosess.native_async_vent(h, 30000)
            la ut = tekst(prosess.native_async_les(h)["stdout"])
            prosess.native_async_lukk(h)
            hvis ferdig["status"] == "ferdig" og heltall_fra_tekst(tekst(ferdig["exit_code"])) == 0 og builtin.index_of(ut, "Chrom") >= 0 {
                returner kandidatar[i]
            }
        }
        i = i + 1
    }
    returner ""
}

funksjon les_meir(h: ordbok_tekst) -> tekst {
    la r = prosess.native_async_les(h)
    hvis finnes_nøkkel(r, "stdout") { returner tekst(r["stdout"]) }
    returner ""
}

funksjon stopp(h: ordbok_tekst) -> heltall {
    la st = prosess.native_async_poll(h)
    hvis st["status"] == "kjorer" {
        prosess.native_async_signal(h, 15)
        la v = prosess.native_async_vent(h, 5000)
        hvis v["status"] == "kjorer" {
            prosess.native_async_signal(h, 9)
            prosess.native_async_vent(h, 5000)
        }
    }
    prosess.native_async_lukk(h)
    returner 0
}

# Start `nc serve` for appen på porten og vent til han lyttar. Gjev handtaket, eller eit
# handtak med status «feil» og utdata i «ut».
funksjon start_serve(app: tekst, port: tekst) -> ordbok_tekst {
    la rot = hjelp.root()
    la m = hjelp.grunnmiljø(rot)
    m["NORSCODE_CMD"] = "serve"
    m["NORSCODE_FILE"] = rot + "/" + app
    m["NC_SERVE_PORT"] = port
    m["NC_SERVE_HOST"] = "127.0.0.1"
    m["NORSCODE_VM_FAST"] = "1"
    la plan = prosess.start_argv_plan(hjelp.runtime(), [])
    prosess.med_cwd(plan, rot)
    prosess.med_miljø(plan, m)
    prosess.med_timeout(plan, 300)
    prosess.med_sandbox(plan, "none", 4294967296, 1024, usann)
    la h = prosess.start_argv_async_trygt(policy(), plan)
    hvis h["status"] != "kjorer" { returner {"status": "feil", "ut": "spawn: " + tekst(h["status"])} }
    la ut = ""
    la t0 = builtin.tid_ms()
    mens builtin.tid_ms() - t0 < 120000 {
        ut = ut + les_meir(h)
        hvis builtin.index_of(ut, "Socket-lytting aktiv") >= 0 {
            h["ut"] = ut
            returner h
        }
        la v = prosess.native_async_vent(h, 250)
        hvis v["status"] != "kjorer" {
            ut = ut + les_meir(h)
            prosess.native_async_lukk(h)
            returner {"status": "feil", "ut": ut}
        }
    }
    stopp(h)
    returner {"status": "feil", "ut": ut + " (tidsavbrot)"}
}

# Headless Chrome med --dump-dom; les stdout til </html> og stopp.
funksjon dump(chrome: tekst, url: tekst, profil: tekst) -> tekst {
    la flagg = ["--headless=new", "--disable-gpu", "--no-first-run", "--disable-background-networking",
                "--dns-prefetch-disable", "--disable-features=NetworkPrediction,Prerender2",
                "--virtual-time-budget=5000", "--dump-dom", "--user-data-dir=" + profil, url]
    la plan = prosess.start_argv_plan(chrome, flagg)
    prosess.med_miljø(plan, nettlesarmiljø())
    prosess.med_timeout(plan, 90)
    prosess.med_maks_output(plan, 4194304)
    prosess.med_sandbox(plan, "none", 8589934592, 4096, usann)
    la h = prosess.start_argv_async_trygt(policy(), plan)
    hvis h["status"] != "kjorer" { returner "" }
    la ut = ""
    la t0 = builtin.tid_ms()
    mens builtin.tid_ms() - t0 < 60000 og builtin.index_of(ut, "</html>") < 0 {
        ut = ut + les_meir(h)
        hvis builtin.index_of(ut, "</html>") < 0 {
            la v = prosess.native_async_vent(h, 250)
            hvis v["status"] != "kjorer" {
                ut = ut + les_meir(h)
                bryt
            }
        }
    }
    stopp(h)
    returner ut
}

# Fersk Chrome-profil per side: den gamle blir sletta før og etter (berre under
# build/wasm/test_chrome/, med /bin/rm utan skal).
funksjon rydd_profil(sti: tekst) -> heltall {
    hvis builtin.index_of(sti, "/build/wasm/test_chrome/") < 0 { kast "rydd_profil: ulovleg sti " + sti }
    la plan = prosess.start_argv_plan("/bin/rm", ["-rf", sti])
    prosess.med_miljø(plan, nettlesarmiljø())
    prosess.med_timeout(plan, 30)
    la h = prosess.start_argv_async_trygt(policy(), plan)
    hvis h["status"] == "kjorer" {
        prosess.native_async_vent(h, 30000)
        prosess.native_async_lukk(h)
    }
    returner 0
}

# Bygg, server og dump éi eller fleire sider. Gjev liste med dump-tekstar.
funksjon køyr(chrome: tekst, kjelde: tekst, namn: tekst, testbygg: bool, port: tekst, stiar: liste) -> liste {
    la ut = "build/wasm/test_chrome/" + namn
    hjelp.bygg_klient(kjelde, ut, testbygg)
    la app = hjelp.app_kopi(ut)
    la s = start_serve(app, port)
    hvis s["status"] != "kjorer" {
        skriv("nc serve for " + namn + " starta ikkje:\n" + tekst(s["ut"]) + "\n")
        assert(usann)
    }
    la dumpar = []
    la i = 0
    mens i < lengde(stiar) {
        la profil = hjelp.root() + "/" + ut + "/profil-" + tekst(i)
        rydd_profil(profil)
        legg_til(dumpar, dump(chrome, "http://127.0.0.1:" + port + stiar[i], profil))
        rydd_profil(profil)
        i = i + 1
    }
    stopp(s)
    returner dumpar
}

funksjon krev(dump_tekst: tekst, nål: tekst, kva: tekst) -> heltall {
    hvis builtin.index_of(dump_tekst, nål) < 0 {
        skriv(kva + ": fann ikkje «" + nål + "» i DOM-en:\n" + dump_tekst + "\n")
        assert(usann)
    }
    returner 0
}

funksjon start() -> heltall {
    la chrome = finn_chrome()
    hvis chrome == "" {
        skriv("test_wasm_w0_chrome OK (SKIP: fann ikkje Chrome/Chromium; set NC_CHROME=<sti>)\n")
        returner 0
    }
    skriv("Chrome: " + chrome + "\n")
    hjelp.mkdir("build/wasm/test_chrome")

    la teljar = køyr(chrome, "tests/fixtures/wasm_teljar_testklient.no", "teljar", sann, "48321",
                     ["/", "/kontroll/streng-csp"])
    la ar = køyr(chrome, "tests/wasm_korpus/aritm.no", "aritm", usann, "48322", ["/"])
    la ko = køyr(chrome, "tests/wasm_korpus/kontroll.no", "kontroll", usann, "48323", ["/"])

    # 1. Teljaren etter tre klikk
    krev(teljar[0], "</html>", "teljar")
    krev(teljar[0], "<output id=\"ut\">3</output>", "teljar")
    krev(teljar[0], "<p id=\"sum\">Sum 1..n = <b>6</b> (oddetal)</p>", "teljar")
    # 2. Negativ kontroll: sida er lasta, men WASM vart stoppa av CSP
    krev(teljar[1], "</html>", "negativ kontroll")
    krev(teljar[1], "<output id=\"ut\">0</output>", "negativ kontroll")
    krev(teljar[1], "<p id=\"sum\"></p>", "negativ kontroll")
    # 3. Paritet med VM-en
    la f20 = aritm.fak(20)
    krev(ar[0], "<h1>" + tekst(f20) + "</h1>", "aritm fak(20)")
    krev(ar[0], "<p>" + tekst(aritm.deling()) + "</p>", "aritm deling")
    krev(ar[0], "type=\"button\">" + tekst(aritm.bitar()) + "</button>", "aritm bitar")
    krev(ar[0], "<output id=\"ut\">" + tekst(aritm.logikk_kode()) + "</output>", "aritm logikk")
    krev(ar[0], "<p id=\"sum\">" + tekst(aritm.grenser()) + "</p>", "aritm grenser")
    krev(ar[0], "<a href=\"/om\">" + tekst(aritm.kall_tal()) + "</a>", "aritm kall_tal")
    krev(ko[0], "<output id=\"ut\">" + tekst(kontroll.primtal_under(100)) + "</output>", "kontroll primtal")
    krev(ko[0], "<p id=\"sum\">" + tekst(kontroll.klassar(20)) + "</p>", "kontroll klassar")

    skriv("test_wasm_w0_chrome OK\n")
    returner 0
}
