bruk std.tekst som t

funksjon start() -> heiltall {
    la pakke = fil_les("tools/package-linux-app.no")
    la cli = fil_les("selfhost/nc_main.no")
    la workflow = fil_les(".github/workflows/linux-app-release.yml")

    assert(t.inneholder(pakke, "funksjon package_appimage_adapter"))
    assert(t.inneholder(pakke, "hvis format == \"appimage-adapter\""))
    assert(ikkje t.inneholder(pakke, "hvis format == \"appimage\""))
    assert(ikkje t.inneholder(pakke,
        "hvis format == \"all\" {\n        hvis ikkje build_appdir(root, appdir, modusar) { returner 1 }\n        hvis ikkje package_tarball(build_dir, tarball, modusar) { returner 1 }\n        package_appimage"))
    assert(t.inneholder(cli, "appdir|tarball|all|appimage-adapter"))
    assert(ikkje t.inneholder(workflow, "release-artifacts/Norscode-linux-*.AppImage"))
    assert(t.inneholder(workflow, "NORSCODE_LINUX_PACKAGE_FORMAT: all"))
    skriv("test_linux_package_external_adapter_boundary OK\n")
    returner 0
}
