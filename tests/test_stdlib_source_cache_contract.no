bruk std.tekst som t

funksjon start() -> heiltall {
    la manifest = builtin.json_parse_raw(fil_les("bootstrap/stdlib/manifest.json"))
    assert(manifest["schema"] == "norscode-stdlib-source-cache-v1|ncb-v1|module-globals-v1")
    la modular = manifest["modules"]
    la kjelder = ["std/sha256.no", "std/tekst.no"]
    la i: heiltall = 0
    mens i < lengde(kjelder) {
        la kjelde = kjelder[i]
        assert(finnes_nøkkel(modular, kjelde))
        la post = modular[kjelde]
        assert(builtin.sha256_bytes(fil_les_binær(kjelde)) == post["source_sha256"])
        la artefakt = tekst(post["artifact"])
        assert(t.starter_med(artefakt, "bootstrap/stdlib/"))
        assert(builtin.sha256_bytes(fil_les_binær(artefakt)) == post["artifact_sha256"])
        la ncb = builtin.json_parse_raw(fil_les(artefakt))
        assert(ncb["functions"] != null og lengde(nøkler(ncb["functions"])) > 0)
        i = i + 1
    }
    la src = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(src, "norscode-stdlib-source-cache-v1|ncb-v1|module-globals-v1"))
    assert(t.inneholder(src, "NORSCODE_USE_PRECOMPILED_STDLIB"))
    assert(t.inneholder(src, "NORSCODE_USE_PRECOMPILED_SELFHOST"))
    assert(t.inneholder(src, "kjelde_hash != tekst(post[\"source_sha256\"])"))
    assert(t.inneholder(src, "artefakt_hash != tekst(post[\"artifact_sha256\"])"))
    skriv("test_stdlib_source_cache_contract OK")
    returner 0
}
