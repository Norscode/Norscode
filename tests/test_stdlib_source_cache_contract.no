bruk std.tekst som t

// J1a-kontrakt: stdlib-cachen er ikkje committa. Utan <cache>/stdlib/manifest.json
// kompilerer nc_main std/* frå kjelde; ein verifisert cache kan berre kome frå
// ein generert katalog (NORSCODE_BOOTSTRAP_CACHE, t.d. build/cache/bootstrap via
// tools/materialize_bootstrap_cache.no). Den levande prøva er
// tests/test_stdlib_source_cache_live.no.
funksjon start() -> heiltall {
    // Ingen committa manifest eller fragment (tidlegare bootstrap/stdlib/*).
    assert(ikkje fil_finnes("bootstrap/stdlib/manifest.json"))
    assert(ikkje fil_finnes("bootstrap/stdlib/std_sha256_source_v1.ncb.json"))
    assert(ikkje fil_finnes("bootstrap/stdlib/std_tekst_source_v1.ncb.json"))

    // Konsumenten (baka inn i seeden) fell til kjelde utan manifest og bind
    // framleis ABI, kjeldehash og artefakthash når ein generert cache finst.
    la src = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(src, "norscode-stdlib-source-cache-v1|ncb-v1|module-globals-v1"))
    assert(t.inneholder(src, "la manifest_sti = cache_rot + \"/stdlib/manifest.json\""))
    assert(t.inneholder(src, "hvis ikkje builtin.fil_finnes(manifest_sti) { returner \"\" }"))
    assert(t.inneholder(src, "NORSCODE_BOOTSTRAP_CACHE"))
    assert(t.inneholder(src, "NORSCODE_USE_PRECOMPILED_STDLIB"))
    assert(t.inneholder(src, "NORSCODE_USE_PRECOMPILED_SELFHOST"))
    assert(t.inneholder(src, "kjelde_hash != tekst(post[\"source_sha256\"])"))
    assert(t.inneholder(src, "artefakt_hash != tekst(post[\"artifact_sha256\"])"))

    // Ingen verktøy skriv eller pakkar ein committa stdlib-cache lenger.
    la regen = fil_les("tools/nc_regen_bootstrap.no")
    assert(ikkje t.inneholder(regen, "root + \"/bootstrap/stdlib\""))
    la pakke = fil_les("tools/package_release.no")
    assert(ikkje t.inneholder(pakke, "staging + \"/bootstrap/stdlib/\""))
    la materialiser = fil_les("tools/materialize_bootstrap_cache.no")
    assert(t.inneholder(materialiser, "rot + \"/stdlib/manifest.json\""))
    skriv("test_stdlib_source_cache_contract OK")
    returner 0
}
