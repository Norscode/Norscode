# M12 — WASM-binæremitter. Byggjer gyldige WebAssembly MVP-modular frå
# Norscode-bytekode. Sjølvstendig (køyrer på seed), byte-eksakt mot spec.

bruk std.wasm_binary som w

funksjon bytes_tekst(bytes) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        hvis i > 0 { ut = ut + " " }
        ut = ut + tekst(bytes[i])
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    # LEB128
    assert_eq(bytes_tekst(w.leb_u(0)), "0")
    assert_eq(bytes_tekst(w.leb_u(42)), "42")
    assert_eq(bytes_tekst(w.leb_u(128)), "128 1")
    assert_eq(bytes_tekst(w.leb_s(42)), "42")
    assert_eq(bytes_tekst(w.leb_s(0 - 1)), "127")

    # main() -> i32 { 42 } — byte-eksakt mot WASM MVP-spec
    la main = {}
    main["namn"] = "main"
    main["n_param"] = 0
    main["n_resultat"] = 1
    main["kropp"] = w.i32_const(42)
    la m = w.bygg_modul([main])
    assert_eq(bytes_tekst(m),
        "0 97 115 109 1 0 0 0 1 5 1 96 0 1 127 3 2 1 0 7 8 1 4 109 97 105 110 0 0 10 6 1 4 0 65 42 11")
    # Magic + versjon
    assert_eq(m[0], 0)
    assert_eq(m[1], 97)
    assert_eq(m[2], 115)
    assert_eq(m[3], 109)
    assert_eq(m[4], 1)

    # add(a, b) = a + b via bytekode-lowering
    la kode = [["LOAD_NAME", "a"], ["LOAD_NAME", "b"], ["BINARY_ADD"], ["RETURN"]]
    la fn = w.spek_frå_ncb("add", ["a", "b"], kode)
    la ma = w.bygg_modul([fn])
    assert_eq(bytes_tekst(ma),
        "0 97 115 109 1 0 0 0 1 7 1 96 2 127 127 1 127 3 2 1 0 7 7 1 3 97 100 100 0 0 10 9 1 7 0 32 0 32 1 106 11")

    # Aritmetikk-uttrykk: (10 - 3) * 2
    la kode2 = [["PUSH_CONST", 10], ["PUSH_CONST", 3], ["BINARY_SUB"], ["PUSH_CONST", 2], ["BINARY_MUL"], ["RETURN"]]
    la fn2 = w.spek_frå_ncb("rekn", [], kode2)
    # kropp: i32.const 10, i32.const 3, i32.sub, i32.const 2, i32.mul
    assert_eq(bytes_tekst(fn2["kropp"]), "65 10 65 3 107 65 2 108")

    skriv("test_wasm_binary OK\n")
    returner 0
}
