bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la før = miljo_hent("NORSCODE_VM_FAST")
    miljo_sett("NORSCODE_VM_FAST", builtin.chr(49))

    la functions = {}
    vm.vm_runtime_init(functions, sann)
    assert(functions["__vm_fast_mode__"] == "sann")

    miljo_sett("NORSCODE_VM_FAST", før)
    skriv("test_vm_fast_env_contract OK\n")
    returner 0
}
