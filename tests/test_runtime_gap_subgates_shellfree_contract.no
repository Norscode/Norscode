bruk std.tekst som t

funksjon start() -> heiltall {
    la cli = fil_les("tools/native_runtime_gap_cli_gate_v3004.no")
    la pure = fil_les("tools/native_runtime_gap_pure_vm_gate_v3002.no")
    assert(t.inneholder(cli, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(pure, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(pure, "[\"run-ncb-pure\", probe_ncb]"))
    assert(t.inneholder(cli, "\"PATH\": \"/nonexistent\""))
    assert(t.inneholder(pure, "\"PATH\": \"/nonexistent\""))
    assert(ikkje t.inneholder(cli, "exec_prosess"))
    assert(ikkje t.inneholder(pure, "exec_prosess"))
    assert(ikkje t.inneholder(cli, "sh -c"))
    assert(ikkje t.inneholder(pure, "sh -c"))
    skriv("test_runtime_gap_subgates_shellfree_contract OK")
    returner 0
}
