bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/getpass.no")

    assert(t.inneholder(src, "norscode-terminal-v1"))
    assert(t.inneholder(src, "Passord blir aldri sende til ein shellprosess"))
    assert(t.inneholder(src, "Skru av terminal-ekko for éi lesing og returner tilstandsmarkør"))
    assert(t.inneholder(src, "\"operation\": \"readline\""))
    assert(t.inneholder(src, "\"hidden\": \"1\""))
    assert(t.inneholder(src, "Fail-closed: aldri fall tilbake til synleg passordinput"))
    assert(t.inneholder(src, "\"operation\": \"echo\""))
    assert(t.inneholder(src, "_terminal(\"is_tty\")"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "bash -c"))
    assert(ikkje t.inneholder(src, "stty "))

    skriv("test_getpass_no_echo_probe OK")
    returner 0
}
