bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/hosting_runtime_gate_v3610.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(root + \"/bin/nc\", [\"test\"], root, miljø, 600000)"))
    assert(t.inneholder(src, "\"NC_TEST_FILE\": testfil"))
    assert(t.inneholder(src, "\"NC_NATIVE\": bin"))
    assert(t.inneholder(src, "\"NORSCODE_VM_CAPABILITIES\": \"env.read,process.exec,disk.read,disk.write,net.dns,net.listen,net.connect,net.tls\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "cd " + "\""))
    assert(ikkje t.inneholder(src, "NORSCODE_ENABLE_EXEC_PROSESS"))
    skriv("test_hosting_gate_structured_process OK")
    returner 0
}
