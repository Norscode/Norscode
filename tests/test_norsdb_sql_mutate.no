// Fase 4b: UPDATE / DELETE i det frittståande SQL-laget. Golden = SQLite-semantikk.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    assert_eq(sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')")

    // UPDATE med WHERE → 1 rad
    assert_eq(sql.exec(db, "UPDATE folk SET alder = 99 WHERE id = 1"), 1)
    assert_eq(sql.query_rader(db, "SELECT alder FROM folk WHERE id = 1"), "99")

    // DELETE med WHERE → 1 rad (Bjørn)
    assert_eq(sql.exec(db, "DELETE FROM folk WHERE by = 'Bergen'"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk"), 3)

    // DELETE på oppdatert verdi (Ada er no 99)
    assert_eq(sql.exec(db, "DELETE FROM folk WHERE alder > 90"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk"), 2)

    // UPDATE utan WHERE → alle attverande (Linus, Alan)
    assert_eq(sql.exec(db, "UPDATE folk SET by = 'X'"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'X'"), 2)

    // Multi-kolonne SET
    assert_eq(sql.exec(db, "UPDATE folk SET alder = 60, by = 'Y' WHERE id = 2"), 1)
    assert_eq(sql.query_rader(db, "SELECT alder, by FROM folk WHERE id = 2"), "60|Y")

    returner 0
}
