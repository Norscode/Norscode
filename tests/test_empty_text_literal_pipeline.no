bruk selfhost.lexer.lexer_m1 som lexer
bruk selfhost.parser som parser
bruk selfhost.compiler.ir_to_bytecode som ir

funksjon start() -> heiltall {
    la kjelde = "funksjon start() -> tekst { returner \"\" }\n"
    la tokens = lexer.lex(kjelde)
    la fann_sentinel = usann
    la i: heiltall = 0
    mens i < lengde(tokens) {
        hvis tokens[i]["type"] == "STRING" {
            // Bygg internmarkøren av delar. Ein samanhengande literal er med
            // vilje reservert av pipeline-transporten og blir dekoda til tom
            // tekst av IR-kompilatoren.
            assert(tokens[i]["value"] == "__nclit__empty_" + "text_v1")
            fann_sentinel = sann
        }
        i = i + 1
    }
    assert(fann_sentinel)

    la ast = parser.parse_program(tokens)
    la ncb_tekst = ir.kompiler_til_ncb_json(ast, "__main__")
    la ncb = builtin.json_parse_raw(ncb_tekst)
    la kode = ncb["functions"]["__main__.start"]["code"]
    assert(kode[0][0] == "PUSH_CONST")
    assert(kode[0][1] == "")

    la tal_ast = parser.parse_program(lexer.lex("funksjon start() -> heiltall { returner 42 }\n"))
    la tal_ncb = builtin.json_parse_raw(ir.kompiler_til_ncb_json(tal_ast, "__main__"))
    la tal_kode = tal_ncb["functions"]["__main__.start"]["code"]
    assert(tal_kode[0][0] == "PUSH_CONST")
    assert(tal_kode[0][1] == 42)
    skriv("test_empty_text_literal_pipeline OK\n")
    returner 0
}
