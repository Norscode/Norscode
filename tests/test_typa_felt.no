# M5 — struktur med typa felt skal parse (gav parserfeil før). Køyrer gjennom
# KJELDE-kompilator + VM. Felt-typane er annotasjonar; runtime lagrar struktur
# som ordbok (som før).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> heltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner vm.køyr_ncb(ncb)
}

funksjon start() -> heiltall {
    # Typa felt: x: heltall, y: heltall
    la prog = "struktur Punkt {\n" +
        "    x: heltall\n" +
        "    y: heltall\n" +
        "}\n" +
        "funksjon start() -> heltall {\n" +
        "    la p = Punkt()\n" +
        "    p.x = 3\n" +
        "    p.y = 4\n" +
        "    returner p.x * 10 + p.y\n" +
        "}\n"
    assert_eq(utfor(prog), 34)

    # Blanda: typa og utypa felt
    la prog2 = "struktur Blanda {\n" +
        "    a: tekst\n" +
        "    b\n" +
        "}\n" +
        "funksjon start() -> heltall {\n" +
        "    la m = Blanda()\n" +
        "    m.b = 7\n" +
        "    returner m.b\n" +
        "}\n"
    assert_eq(utfor(prog2), 7)

    skriv("test_typa_felt OK\n")
    returner 0
}
