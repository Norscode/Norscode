bruk std.pixel_diff som diff

funksjon start() -> heiltall {
    la expected: liste_heiltall = [
        10, 20, 30, 255, 40, 50, 60, 255,
        70, 80, 90, 255, 100, 110, 120, 255
    ]
    la same = diff.samanlikn_rgba(expected, expected, 2, 2, 0, 0)
    assert_eq(same["status"], "lik")
    assert_eq(same["changed_pixels"], "0")

    la near: liste_heiltall = [
        10, 20, 30, 255, 40, 52, 60, 255,
        70, 80, 90, 255, 100, 110, 120, 255
    ]
    assert_eq(diff.samanlikn_rgba(expected, near, 2, 2, 2, 0)["status"], "lik")
    la changed = diff.samanlikn_rgba(expected, near, 2, 2, 1, 0)
    assert_eq(changed["status"], "ulik")
    assert_eq(changed["changed_pixels"], "1")
    assert_eq(changed["changed_basis_points"], "2500")
    assert_eq(changed["max_channel_delta"], "2")
    assert_eq(diff.samanlikn_rgba(expected, near, 2, 2, 1, 1)["status"], "lik")

    assert_eq(diff.samanlikn_rgba(expected, [1, 2], 2, 2, 0, 0)["status"], "feil")
    assert_eq(diff.samanlikn(expected, expected, 2, 2, 2, 0, 0)["status"], "feil")
    assert_eq(diff.samanlikn_rgba(expected, expected, 9000, 2, 0, 0)["status"], "feil")
    skriv("test_pixel_diff OK\n")
    returner 0
}
