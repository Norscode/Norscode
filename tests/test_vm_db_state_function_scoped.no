bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("selfhost/vm.no")
    assert(t.inneholder(src, "funksjon _vm_db_state(functions)"))
    assert(t.inneholder(src, "functions[\"__vm_db_store__\"] = {}"))
    assert(t.inneholder(src, "functions[\"__vm_pool_store__\"] = {}"))
    assert(t.inneholder(src, "_vm_ny_id(\"db\", active_functions)"))
    assert(t.inneholder(src, "_vm_db_get(active_functions, args[0])"))
    assert(t.inneholder(src, "builtin.ends_with(kortnavn, \"norsdb.open\")"))
    assert(t.inneholder(src, "builtin.ends_with(kortnavn, \"norsdb.pool_close\")"))
    skriv("test_vm_db_state_function_scoped OK")
    returner 0
}
