// Ende-til-ende: ei ufullstendig obligatorisk testliste må aldri bli grøn.
bruk std.runtime.process_abi som abi

funksjon køyr_manifest(root: tekst, base: tekst, innhald: tekst) -> ordbok_tekst {
    la manifest = base + "/manifest.txt"
    builtin.fil_skriv(manifest, innhald)
    la req = abi.request(root + "/dist/norscode_native", [], root, "", 180000, 65536)
    abi.sett_sandbox(req, "none", 0, 128, usann)
    abi.sett_environment(req, {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tools/nc_test.no",
        "NORSCODE_NO_ARGV": "1", "TESTS_DIR": base,
        "NC_TEST_LIST_FILE": manifest, "NC_TEST_ALL": "1", "NC_SLOW_TESTS": "1",
        "NORSCODE_VM_FAST": "1", "NC_TEST_VM_FAST": "1",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    })
    returner builtin.process_spawn_argv(req)
}

funksjon krev_feil(res) -> heiltall {
    skriv(tekst(res["stdout"]))
    skriv(tekst(res["stderr"]))
    assert_eq(res["status"], "ferdig")
    assert(heltall_fra_tekst(res["exit_code"]) != 0)
    assert(ikkje builtin.contains(res["stdout"], "OK: Alle testar bestått"))
    returner 0
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/test_manifest_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(base)
    la marker = base + "/køyrd.txt"
    builtin.fil_skriv(base + "/test_manifest_ok.no",
        "funksjon start() { assert_eq(6 * 7, 42) fil_skriv(" + builtin.json_skriv(marker) + ", \"køyrd\") returner 0 }\n")

    // Blandinga var tidlegare grøn: [MANGLAR] vart berre logga, ikkje avvist.
    la blanda = køyr_manifest(root, base, "test_manifest_ok.no\ntest_manifest_manglar.no\n")
    krev_feil(blanda)
    assert_inneholder(tekst(blanda["stdout"]) + tekst(blanda["stderr"]), "test_manifest_manglar.no")
    assert(ikkje builtin.fil_finnes(marker))

    la fleire = køyr_manifest(root, base, "test_borte_a.no\ntest_borte_b.no\n")
    krev_feil(fleire)
    assert_inneholder(tekst(fleire["stdout"]) + tekst(fleire["stderr"]), "test_borte_a.no")
    assert_inneholder(tekst(fleire["stdout"]) + tekst(fleire["stderr"]), "test_borte_b.no")
    krev_feil(køyr_manifest(root, base, "# inga testdekning\r\n\r\n"))

    // Positiv kontroll: whitespace, kommentarar og CRLF er framleis tillatne.
    la gyldig = køyr_manifest(root, base, "# kontroll\r\n  test_manifest_ok.no  \r\n\r\n")
    skriv(tekst(gyldig["stdout"]))
    skriv(tekst(gyldig["stderr"]))
    assert_eq(gyldig["status"], "ferdig")
    assert_eq(heltall_fra_tekst(gyldig["exit_code"]), 0)
    assert_inneholder(gyldig["stdout"], "Bestått:  1")
    assert_inneholder(gyldig["stdout"], "Hoppa:    0")
    assert_eq(builtin.fil_les(marker), "køyrd")
    skriv("test_nc_test_manifest_completeness OK\n")
    returner 0
}
