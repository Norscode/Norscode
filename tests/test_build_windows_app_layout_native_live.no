bruk tools.build_windows_app_layout_core som layout
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la temp = runtime_fs.native_tempområde("build", "windows-layout-")
    assert(temp["status"] == "created")
    la base = root + "/build/" + temp["relative"]
    la exe = base + "/fixture.exe"
    la out = base + "/out"
    builtin.fil_skriv_binær(exe, builtin.bytes_from_list([77, 90, 1, 2, 3, 4]))

    assert(layout.bygg(out, "Norscode", exe, root) == 0)
    assert(lengde(builtin.fil_les_binær(out + "/Norscode/bin/norscode.exe")) == 6)
    assert(lengde(builtin.fil_les_binær(out + "/Norscode/bin/nc.exe")) == 6)
    assert(builtin.index_of(builtin.fil_les(out + "/Norscode/bin/nc.cmd"), "%SCRIPT_DIR%norscode.exe") >= 0)
    assert(builtin.index_of(builtin.fil_les(out + "/Norscode/bin/nc.ps1"), "norscode.exe") >= 0)
    assert(filops.slett_tre(base))
    skriv("test_build_windows_app_layout_native_live OK")
    returner 0
}
