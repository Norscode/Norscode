bruk tools.no_c_python_active_surface som flate
bruk std.tekst som t

// F0.1: kvar klassifiserar i active-surface må kunne seie både ja og nei
// (positiv og negativ fixture per sjekk), og ratchet-vurderinga må skilje
// rapport-, ratchet- og hard-modus.

funksjon nul(n: heiltall) -> tekst {
    la ut = ""
    la i = 0
    mens i < n {
        ut = ut + builtin.chr(0)
        i = i + 1
    }
    returner ut
}

funksjon be32(v: heiltall) -> tekst {
    returner builtin.chr((v / 16777216) % 256) + builtin.chr((v / 65536) % 256) +
        builtin.chr((v / 256) % 256) + builtin.chr(v % 256)
}

funksjon le32(v: heiltall) -> tekst {
    returner builtin.chr(v % 256) + builtin.chr((v / 256) % 256) +
        builtin.chr((v / 65536) % 256) + builtin.chr((v / 16777216) % 256)
}

// Éi git-indeksoppføring (v2): 24 byte tid/dev/ino, modus, 12 byte uid/gid/storleik,
// 20 byte SHA, 2 byte flagg (namnelengd), sti og 1–8 NUL.
funksjon indeks_oppføring(sti: tekst, modus: heiltall) -> tekst {
    la e = nul(24) + be32(modus) + nul(32) + builtin.chr((lengde(sti) / 256) % 16) +
        builtin.chr(lengde(sti) % 256) + sti
    la total = ((62 + lengde(sti) + 8) / 8) * 8
    returner e + nul(total - 62 - lengde(sti))
}

// Byte-eksakt tekst: byte ≥ 0x80 er eitt teikn, og NUL overlever konkatenering,
// contains og slice. Committa macOS-stage0 droppar chr(0) i tekst.
funksjon byte_eksakt() -> bool {
    la c = builtin.chr(160)
    hvis lengde(c) != 1 eller builtin.char_code(builtin.slice(c, 0, 1)) != 160 { returner usann }
    la z = builtin.chr(0)
    la s = "a" + z + z + "b"
    hvis lengde(s) != 4 { returner usann }
    hvis ikkje builtin.contains(s, z + z + "b") eller builtin.contains(s, z + "a") { returner usann }
    hvis builtin.slice(s, 1, 2) != z eller builtin.slice(s, 3, 4) != "b" { returner usann }
    returner builtin.char_code(builtin.slice(s, 2, 3)) == 0
}

funksjon start() -> heiltall {
    // (a) Framandspråk: ending og basenamn.
    assert(flate.framandspråk_namn("tools/install.ps1"))
    assert(flate.framandspråk_namn("platform/macos/window-host/Main.swift"))
    assert(flate.framandspråk_namn("build/mv_bootstrap_stub_manifest_dispatch.inc"))
    assert(flate.framandspråk_namn("web/app.js"))
    assert(flate.framandspråk_namn("web/app.mjs"))
    assert(flate.framandspråk_namn("web/app.ts"))
    assert(flate.framandspråk_namn("x/start.S"))
    assert(flate.framandspråk_namn("x/boot.asm"))
    assert(flate.framandspråk_namn("x/main.go"))
    assert(flate.framandspråk_namn("x/lib.rs"))
    assert(flate.framandspråk_namn("x/a.cpp"))
    assert(flate.framandspråk_namn("x/a.hpp"))
    assert(flate.framandspråk_namn("x/a.mm"))
    assert(flate.framandspråk_namn("tools/evil_probe.bash"))
    assert(flate.framandspråk_namn("tools/x.zsh"))
    assert(flate.framandspråk_namn("tools/lib_probe.a"))
    assert(flate.framandspråk_namn("tools/probe.wasm"))
    assert(flate.framandspråk_namn("tools/probe.pyc"))
    assert(flate.framandspråk_namn("x/skript.lua"))
    assert(flate.framandspråk_namn("x/side.php"))
    assert(flate.framandspråk_namn("x/Prog.cs"))
    assert(flate.framandspråk_namn("Makefile"))
    assert(flate.framandspråk_namn("docker/Dockerfile"))
    assert(flate.framandspråk_namn("CMakeLists.txt"))
    assert(ikkje flate.framandspråk_namn("std/tekst.no"))
    assert(ikkje flate.framandspråk_namn("tools/seed.a.no"))
    assert(ikkje flate.framandspråk_namn("vscode-norscode/package.json"))
    assert(ikkje flate.framandspråk_namn("README.md"))
    assert(ikkje flate.framandspråk_namn("docs/api.html"))
    assert(ikkje flate.framandspråk_namn("tools/seed_gate_tests.txt"))
    assert(ikkje flate.framandspråk_namn("tests/fixtures/tls/localhost.crt"))
    assert(ikkje flate.framandspråk_namn("x/.js"))
    assert(ikkje flate.framandspråk_namn("x/.a"))

    // (h) JSON som eigen kategori.
    assert(flate.json_namn("packages/remote_registry_example.json"))
    assert(flate.json_namn("bootstrap/precompiled/vm.ncb.json"))
    assert(ikkje flate.json_namn("x/data.jsonl"))
    assert(ikkje flate.json_namn("x/json.no"))

    // (c) Generisk shebang: alt som ikkje er nc/norscode. env-opsjonar med
    // eige argument (-u, -C, -P) må ikkje lesast som tolk.
    assert_eq(flate.shebang_tolk("#!/usr/bin/env python3\nprint(1)\n"), "python3")
    assert_eq(flate.shebang_tolk("#!/usr/bin/env -S nc run\n"), "nc")
    assert_eq(flate.shebang_tolk("#!/usr/bin/env LANG=C node\n"), "node")
    assert_eq(flate.shebang_tolk("#!/bin/bash\r\n"), "bash")
    assert_eq(flate.shebang_tolk("#!/usr/bin/env -u nc python3\n"), "python3")
    assert_eq(flate.shebang_tolk("#!/usr/bin/env -C /tmp nc\n"), "nc")
    assert_eq(flate.shebang_tolk("#!/usr/bin/env -i\n"), "env")
    assert(flate.shebang_framand("#!/usr/bin/env python3\n"))
    assert(flate.shebang_framand("#!/usr/bin/env -u nc python3\n"))
    assert(flate.shebang_framand("#!/usr/bin/env -P /opt/nc ruby\n"))
    assert(flate.shebang_framand("#!/usr/bin/env node\n"))
    assert(flate.shebang_framand("#!/usr/local/bin/pwsh\n"))
    assert(flate.shebang_framand("#!/usr/bin/perl -w\n"))
    assert(flate.shebang_framand("#!/usr/bin/env sh\nexec x\n"))
    assert(ikkje flate.shebang_framand("#!/usr/bin/env nc\n"))
    assert(ikkje flate.shebang_framand("#!/usr/bin/env -C /tmp nc\n"))
    assert(ikkje flate.shebang_framand("#!/opt/norscode/bin/nc run\n"))
    assert(ikkje flate.shebang_framand("#!/usr/local/bin/norscode_native\n"))
    assert(ikkje flate.shebang_framand("// ikkje shebang\n"))
    assert(ikkje flate.shebang_framand("# #!/bin/bash i kommentar\n"))

    // (d) Binær-magic (utan NUL-literalar, så desse gjeld på alle runtimes).
    assert_eq(flate.binær_type(builtin.chr(127) + "ELF" + builtin.chr(2) + builtin.chr(1)), "elf")
    assert_eq(flate.binær_type("ELF er berre tekst"), "")
    assert_eq(flate.binær_type("MZ utan PE-signatur er tekst"), "")
    // MZ-tekst med «PE» tidleg: e_lfanew frå teksten peikar ikkje på PE-signaturen.
    la mz_tekst = "MZ PE PE PE" + "................................................................PE"
    assert_eq(flate.binær_type(mz_tekst), "")
    assert_eq(flate.binær_type("abc"), "")
    assert_eq(flate.binær_type("!<arch>\n/               0           0     0     644     4         `\n"), "ar")
    assert_eq(flate.binær_type("!<arch> er berre tekst\n"), "")
    // Python-bytekode: versjonsmagic + «\r\n»; tekst med CRLF etter to teikn er ikkje pyc.
    assert_eq(flate.binær_type(builtin.chr(167) + builtin.chr(13) + builtin.chr(13) + builtin.chr(10) + "rest"), "pyc")
    assert_eq(flate.binær_type(builtin.chr(3) + builtin.chr(243) + builtin.chr(13) + builtin.chr(10)), "pyc")
    assert_eq(flate.binær_type("ab\r\nrest"), "")
    // C-æra-signatur: dynamisk ELF (PT_INTERP tidleg) mot statisk ELF.
    la elf = builtin.chr(127) + "ELF" + builtin.chr(2)
    assert(flate.c_æra_signatur("elf", elf + "....../lib64/ld-linux-x86-64.so.2"))
    assert(ikkje flate.c_æra_signatur("elf", elf + "statisk utan tolk"))
    la fyll = "x"
    mens lengde(fyll) < 5000 { fyll = fyll + fyll }
    // ld-linux som streng djupt inne i .rodata (sjølvhosta seed) er ikkje PT_INTERP.
    assert(ikkje flate.c_æra_signatur("elf", elf + fyll + "ld-linux"))
    assert(flate.c_æra_signatur("pe", "MZ...api-ms-win-crt-runtime-l1-1-0.dll"))
    assert(ikkje flate.c_æra_signatur("pe", "MZ...KERNEL32.dll berre"))
    assert(ikkje flate.c_æra_signatur("", "libobjc"))

    // (e) Symlenkemål innanfor repoet, løyst som repo-relativ sti.
    assert(flate.symlenke_mål_innanfor("bin/nc", "../dist/norscode_native"))
    assert(flate.symlenke_mål_innanfor("bin/nl", "nc"))
    assert(flate.symlenke_mål_innanfor("nc", "bin/nc"))
    assert_eq(flate.symlenke_mål_løyst("bin/nc", "../dist/norscode_native"), "dist/norscode_native")
    assert_eq(flate.symlenke_mål_løyst("bin/nl", "nc"), "bin/nc")
    assert_eq(flate.symlenke_mål_løyst("bin/x", ".."), ".")
    assert_eq(flate.symlenke_mål_løyst("bin/nc", "/opt/homebrew/bin/pyth3"), "")
    assert(ikkje flate.symlenke_mål_innanfor("Hjemmeside/std", "/Users/x/Norscode1/std"))
    assert(ikkje flate.symlenke_mål_innanfor("ai_moduler/minne.no", "../../../ai_moduler/minne.no"))
    assert(ikkje flate.symlenke_mål_innanfor("prosjekter/NorscodeWeb", "../../NorscodeWeb"))
    assert(ikkje flate.symlenke_mål_innanfor("nc", "../utanfor"))
    assert(ikkje flate.symlenke_mål_innanfor("x", "C:/Windows"))

    // (f) Hex-literalar (≥128 hex-teikn, åleine eller konkatenert) og hex_to_bytes(.
    la hex128 = ""
    mens lengde(hex128) < 128 { hex128 = hex128 + "0123456789abcdef" }
    la hex127 = builtin.slice(hex128, 0, 127)
    la hex64 = builtin.slice(hex128, 0, 64)
    assert(flate.er_hexlitteral(hex128))
    assert(ikkje flate.er_hexlitteral(hex127))
    assert(ikkje flate.er_hexlitteral(builtin.slice(hex128, 0, 120) + "ghijklmn"))
    assert(flate.hex_flate("selfhost/native_execution/native_codegen_v2.no"))
    assert(ikkje flate.hex_flate("selfhost/native_execution/sub/x.no"))
    assert(ikkje flate.hex_flate("selfhost/vm.no"))
    assert(ikkje flate.hex_flate("selfhost/native_execution/native_codegen_v2.ncb.json"))
    la kjelde = "funksjon rt_hex_blob() { returner \"" + hex128 + "\" }\n" +
        "funksjon kort() { returner \"" + hex127 + "\" }\n" +
        "funksjon tekstlang() { returner \"" + hex128 + " mellomrom\" }\n" +
        "funksjon bruk() -> liste {\n    la b = hex_to_bytes(rt_hex_blob())\n    returner b\n}\n"
    la hx = flate.hex_treff_i_kjelde("selfhost/native_execution/a.no", kjelde)
    assert_eq(lengde(hx), 2)
    assert_eq(hx[0], "selfhost/native_execution/a.no@bruk:hex_to_bytes")
    assert_eq(hx[1], "selfhost/native_execution/a.no@rt_hex_blob:hexlitteral")
    assert_eq(lengde(flate.hex_treff_i_kjelde("selfhost/native_execution/b.no",
        "funksjon ren() { returner \"" + hex127 + "\" }\n")), 0)
    // Oppdelt blob: to literalar på 64 med «+», på same linje og over linjeskift.
    la delt = "funksjon eitt() { returner \"" + hex64 + "\" + \"" + hex64 + "\" }\n" +
        "funksjon to() {\n    returner \"" + hex64 + "\" +\n        \"" + hex64 + "\"\n}\n"
    la hd = flate.hex_treff_i_kjelde("selfhost/native_execution/d.no", delt)
    assert_eq(lengde(hd), 2)
    assert_eq(hd[0], "selfhost/native_execution/d.no@eitt:hexlitteral")
    assert_eq(hd[1], "selfhost/native_execution/d.no@to:hexlitteral")
    // Ikkje konkatenert (anna kode eller listeelement mellom) → ingen treff.
    la ikkje_delt = "funksjon tre() { la x = \"" + hex64 + "\" + y + \"" + hex64 + "\" }\n" +
        "funksjon fire() { la l = [\"" + hex64 + "\", \"" + hex64 + "\"] }\n"
    assert_eq(lengde(flate.hex_treff_i_kjelde("selfhost/native_execution/e.no", ikkje_delt)), 0)
    // Fleire treff i same funksjon blir eigne nøklar (#n).
    la fleire = "funksjon rt_hex_x() {\n    la a = \"" + hex128 + "\"\n    la b = \"" + hex128 + "\"\n" +
        "    la c = hex_to_bytes(a)\n    la d = hex_to_bytes(b)\n}\n"
    la hf = flate.hex_treff_i_kjelde("selfhost/native_execution/f.no", fleire)
    assert_eq(lengde(hf), 4)
    assert_eq(hf[0], "selfhost/native_execution/f.no@rt_hex_x:hex_to_bytes")
    assert_eq(hf[1], "selfhost/native_execution/f.no@rt_hex_x:hex_to_bytes#2")
    assert_eq(hf[2], "selfhost/native_execution/f.no@rt_hex_x:hexlitteral")
    assert_eq(hf[3], "selfhost/native_execution/f.no@rt_hex_x:hexlitteral#2")

    // Allowlist-format.
    la allow = flate.les_allowlist("# kommentar\ntak framandspråk 3\nunntak framandspråk c/Main.swift\n" +
        "kjend framandspråk Makefile\n" +
        "godkjend symlenke bin/nc -> ../dist/norscode_native\n" +
        "godkjend binær bootstrap/stage0/x sha256=ABCDEF01\ngodkjend binær utan/pin\ntak json 1\n")
    assert_eq(flate.kategori_tak(allow, "framandspråk"), 3)
    assert_eq(flate.kategori_tak(allow, "shebang"), 0)
    assert(flate.allow_har(allow, "unntak\tframandspråk\tc/Main.swift"))
    assert(flate.allow_har(allow, "kjend\tframandspråk\tMakefile"))
    assert_eq(tekst(allow["godkjend\tsymlenke\tbin/nc"]), "../dist/norscode_native")
    assert_eq(tekst(allow["godkjend\tbinær\tbootstrap/stage0/x"]), "sha256=abcdef01")
    assert_eq(tekst(allow["godkjend\tbinær\tutan/pin"]), "1")
    assert_eq(flate.treff_status(allow, "framandspråk", "c/Main.swift"), "unntak")
    assert_eq(flate.treff_status(allow, "framandspråk", "Makefile"), "kjend")
    assert_eq(flate.treff_status(allow, "framandspråk", "web/app.js"), "ny")
    // Godkjend binær utan pin er ikkje godkjend (fail closed).
    assert_eq(flate.godkjend_binær_avvik(".", "utan/pin", allow), "godkjend utan sha256-pin")
    assert_eq(flate.godkjend_binær_avvik(".", "finst/ikkje", allow), "ikkje godkjend")

    // Nøyaktig på taket, berre unntak og kjend: grønt i rapport og ratchet, hard raudt (kjend).
    la eksakt: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tMakefile\t",
                              "framandspråk\tc/Main.swift\t", "json\ta.json\t"]
    assert_eq(flate.f0_brot(eksakt, allow, "rapport"), 0)
    assert_eq(flate.f0_brot(eksakt, allow, "ratchet"), 0)
    assert_eq(flate.f0_brot(eksakt, allow, "hard"), 1)
    la r0 = builtin.join(flate.f0_rapport(eksakt, allow, "rapport"), "\n")
    assert(t.inneholder(r0, "MERK: framandspråk: 3 treff, tak 3 (2 unntak, 1 kjende, 0 nye):"))
    assert(t.inneholder(r0, "  [unntak] c/Main.swift"))
    assert(t.inneholder(r0, "  [kjend] Makefile"))
    assert(t.inneholder(r0, "OK: shebang: 0 treff (tak 0)"))
    assert(t.inneholder(r0, "MERK: json: 1 filer, tak 1"))
    // Under taket (flata krympa): rapport melder «kan senkast»; ratchet og hard krev
    // at taket blir senka i same endring.
    la krympa: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tMakefile\t", "json\ta.json\t"]
    assert_eq(flate.f0_brot(krympa, allow, "rapport"), 0)
    assert_eq(flate.f0_brot(krympa, allow, "ratchet"), 1)
    assert(t.inneholder(builtin.join(flate.f0_rapport(krympa, allow, "rapport"), "\n"),
        "MERK: framandspråk: taket kan senkast frå 3 til 2"))
    assert(t.inneholder(builtin.join(flate.f0_rapport(krympa, allow, "ratchet"), "\n"),
        "MERK: framandspråk: RATCHET-BROT, taket må senkast frå 3 til 2 i same endring"))
    // Byte: kjend fil ut, ny fil inn, same tal → ratchet seier nei (ny nøkkel + utdatert kjend).
    la bytt: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tc/Main.swift\t",
                            "framandspråk\tweb/app.js\t", "json\ta.json\t"]
    assert_eq(flate.f0_brot(bytt, allow, "rapport"), 0)
    assert_eq(flate.f0_brot(bytt, allow, "ratchet"), 1)
    assert_eq(flate.f0_brot(bytt, allow, "hard"), 1)
    la rb = builtin.join(flate.f0_rapport(bytt, allow, "ratchet"), "\n")
    assert(t.inneholder(rb, "  [ny] web/app.js"))
    assert(t.inneholder(rb, "MERK: 1 utdaterte unntak i allowlista (fjern):"))
    assert(t.inneholder(rb, "  framandspråk Makefile (kjend)"))
    // Ny nøkkel innanfor taket (taket har slakk), ingen utdaterte: ratchet nei.
    la ny_i_slakk: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tMakefile\t",
                                  "framandspråk\tweb/app.js\t", "json\ta.json\t"]
    assert_eq(flate.f0_brot(ny_i_slakk, allow, "rapport"), 0)
    assert_eq(flate.f0_brot(ny_i_slakk, allow, "ratchet"), 1)
    // Berre utdatert kjend (talet held seg via eit anna kjent treff): ratchet nei.
    la berre_utdatert: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tc/Main.swift\t",
                                      "framandspråk\tc/Main.swift\t", "json\ta.json\t"]
    assert_eq(flate.f0_brot(berre_utdatert, allow, "rapport"), 0)
    assert_eq(flate.f0_brot(berre_utdatert, allow, "ratchet"), 1)
    // Over taket: ratchet og hard raudt, rapport grønt men med RATCHET-BROT-melding.
    la over_tak: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tMakefile\t",
                                "framandspråk\tc/Main.swift\t", "framandspråk\tweb/app.js\t",
                                "shebang\tbin/x\t#!python3", "json\ta.json\t"]
    assert_eq(flate.f0_brot(over_tak, allow, "rapport"), 0)
    assert_eq(flate.f0_brot(over_tak, allow, "ratchet"), 2)
    assert_eq(flate.f0_brot(over_tak, allow, "hard"), 2)
    la r3 = builtin.join(flate.f0_rapport(over_tak, allow, "rapport"), "\n")
    assert(t.inneholder(r3, "MERK: framandspråk: RATCHET-BROT, 4 treff over taket 3"))
    assert(t.inneholder(r3, "MERK: shebang: RATCHET-BROT, 1 treff over taket 0"))
    // JSON har berre tak: nye JSON-filer bryt ikkje så lenge talet er lik taket.
    la ein_json: liste_tekst = ["framandspråk\tc/Main.swift\t", "framandspråk\tMakefile\t",
                                "framandspråk\tc/Main.swift\t", "json\tny.json\t"]
    assert_eq(flate.f0_brot(ein_json, allow, "ratchet"), 0)
    ein_json = ["framandspråk\tc/Main.swift\t", "framandspråk\tMakefile\t",
                "framandspråk\tc/Main.swift\t", "json\tny.json\t", "json\tto.json\t"]
    assert_eq(flate.f0_brot(ein_json, allow, "ratchet"), 1)
    // Utdatert unntak blir meldt.
    la r4 = builtin.join(flate.f0_rapport([], allow, "rapport"), "\n")
    assert(t.inneholder(r4, "MERK: 2 utdaterte unntak i allowlista (fjern):"))
    assert(t.inneholder(r4, "  framandspråk c/Main.swift (unntak)"))

    // Flata: ankerfiler må finnast; ratchet/hard krev git-indeksen (fail closed).
    la anker = flate.f0_ankerfiler()
    la god: liste_tekst = ["m\tgit-indeks"]
    la a = 0
    mens a < lengde(anker) {
        legg_til(god, "f\t" + anker[a])
        a = a + 1
    }
    assert_eq(flate.flate_modus_av(god), "git-indeks")
    assert_eq(lengde(flate.f0_flate_feil(god, "rapport")), 0)
    assert_eq(lengde(flate.f0_flate_feil(god, "ratchet")), 0)
    assert_eq(lengde(flate.f0_flate_feil(god, "hard")), 0)
    // Éi fil og ingen anker (macOS-stage0 med escapa listedata): feil i alle modusar.
    la blind: liste_tekst = ["m\tfilsystem", "f\ttnorscode_fil.txt\\nd\\tecosystem"]
    assert(lengde(flate.f0_flate_feil(blind, "rapport")) >= 4)
    assert(lengde(flate.f0_flate_feil(blind, "ratchet")) >= 5)
    // Runtime som ikkje er byte-eksakt: flata blir ikkje vandra, porten stoppar.
    assert(lengde(flate.f0_flate_feil(["m\tikkje-byte-eksakt"], "rapport")) >= 5)
    assert_eq(flate.runtime_byte_eksakt(), byte_eksakt())
    // Filsystem-fallback med anker: rapport OK, ratchet/hard nei.
    la fs: liste_tekst = ["m\tfilsystem"]
    a = 0
    mens a < lengde(anker) {
        legg_til(fs, "f\t" + anker[a])
        a = a + 1
    }
    assert_eq(lengde(flate.f0_flate_feil(fs, "rapport")), 0)
    assert_eq(lengde(flate.f0_flate_feil(fs, "ratchet")), 1)
    assert_eq(lengde(flate.f0_flate_feil(fs, "hard")), 1)
    // Escapa listedata blir avkoda; ekte listedata blir urørt.
    assert_eq(flate.avkod_listedata("f\\ta\\\"b\\nf\\tc\\\\d\\nl\\tlenkje\\n"), "f\ta\"b\nf\tc\\d\nl\tlenkje\n")
    assert_eq(flate.avkod_listedata("f\tc\\td\n"), "f\tc\\td\n")

    // Den committa allowlista har tak for alle kategoriar, og godkjende binærar er pinna.
    la committa = flate.les_allowlist(fil_les("tools/active_surface_allowlist.txt"))
    la kat = flate.f0_kategoriar()
    la k = 0
    mens k < lengde(kat) {
        assert(flate.allow_har(committa, "tak\t" + kat[k]))
        k = k + 1
    }
    assert_eq(tekst(committa["godkjend\tsymlenke\tbin/nc"]), "../dist/norscode_native")
    assert(builtin.starts_with(tekst(committa["godkjend\tbinær\tbootstrap/stage0/norscode-linux-x86_64"]), "sha256="))
    assert(builtin.starts_with(tekst(committa["godkjend\tbinær\tbootstrap/native_codegen_x86_64.elf"]), "sha256="))
    assert(flate.allow_har(committa, "unntak\thex\tselfhost/native_execution/native_codegen_v2.no@rt_hex_process_spawn_linux_x86_64:hexlitteral"))
    // F0.2 fjerna dei C-æra-kompilerte examples-binærane; oppføringane skal ikkje kome att.
    assert(ikkje flate.allow_har(committa, "kjend\tbinær\texamples/advanced"))

    // Byte-eksakte delar (NUL og byte ≥ 0x80): PE, Mach-O, wasm og git-indeks.
    hvis byte_eksakt() {
        la pe = "MZ" + nul(58) + le32(64) + "PE" + nul(2) + "resten"
        assert_eq(flate.binær_type(pe), "pe")
        // e_lfanew peikar forbi PE-signaturen → ikkje PE.
        assert_eq(flate.binær_type("MZ" + nul(58) + le32(68) + "PE" + nul(2) + "resten"), "")
        assert_eq(flate.binær_type("MZ" + nul(58) + le32(64) + "PX" + nul(2) + "resten"), "")
        assert_eq(flate.binær_type(nul(1) + "asm" + builtin.chr(1) + nul(3)), "wasm")
        assert_eq(flate.binær_type(nul(1) + "asx" + builtin.chr(1)), "")
        // Mach-O-magic har byte ≥ 0x80.
        la macho = builtin.chr(207) + builtin.chr(250) + builtin.chr(237) + builtin.chr(254)
        assert_eq(flate.binær_type(macho + "rest"), "macho")
        assert_eq(flate.binær_type(builtin.chr(202) + builtin.chr(254) + builtin.chr(186) + builtin.chr(190)), "macho")
        assert(flate.c_æra_signatur("macho", macho + "/usr/lib/libobjc.A.dylib"))
        assert(ikkje flate.c_æra_signatur("macho", macho + "/usr/lib/libSystem.B.dylib"))

        la oppf = indeks_oppføring("tools/a.no", 33188) + indeks_oppføring("bin/nc", 40960) +
            indeks_oppføring("tools/install.ps1", 33261) + indeks_oppføring("vendor/sub", 57344)
        la sjekksum = nul(20)
        la indeks = "DIRC" + be32(2) + be32(4) + oppf + "TREE" + be32(4) + "abcd" + sjekksum
        la e = flate.git_indeks_oppføringar(indeks)
        assert_eq(lengde(e), 3)
        assert_eq(e[0], "f\ttools/a.no")
        assert_eq(e[1], "l\tbin/nc")
        assert_eq(e[2], "f\ttools/install.ps1")
        // Split-index («link») og sparse-index («sdir») gjev ufullstendig liste → fallback.
        assert_eq(lengde(flate.git_indeks_oppføringar("DIRC" + be32(2) + be32(4) + oppf +
            "link" + be32(20) + nul(20) + sjekksum)), 0)
        assert_eq(lengde(flate.git_indeks_oppføringar("DIRC" + be32(2) + be32(4) + oppf +
            "TREE" + be32(4) + "abcd" + "sdir" + be32(0) + sjekksum)), 0)
        // Ukjend versjon, feil signatur og avkorta data gjev tom liste (fallback).
        assert_eq(lengde(flate.git_indeks_oppføringar("DIRC" + be32(4) + be32(4) + oppf)), 0)
        assert_eq(lengde(flate.git_indeks_oppføringar("DIRX" + be32(2) + be32(4) + oppf)), 0)
        assert_eq(lengde(flate.git_indeks_oppføringar("DIRC" + be32(2) + be32(5) + oppf)), 0)
        assert_eq(lengde(flate.git_indeks_oppføringar("")), 0)
        // Mest gitlinkar (typebyte feillesen) gjev òg fallback.
        la gitlinkar = indeks_oppføring("a", 57344) + indeks_oppføring("b", 57344) + indeks_oppføring("c.no", 33188)
        assert_eq(lengde(flate.git_indeks_oppføringar("DIRC" + be32(2) + be32(3) + gitlinkar)), 0)
    } ellers {
        skriv("MERK: runtime er ikkje byte-eksakt; PE-, wasm-, Mach-O- og git-indeks-delane vart hoppa over\n")
    }

    // Porten står i active-surface, i rapportmodus som standard, utan modulglobalar.
    la src = fil_les("tools/no_c_python_active_surface.no")
    assert(t.inneholder(src, "la f0 = f0_treff(root, flate, allow)"))
    assert(t.inneholder(src, "la flate = flate_les(root)"))
    assert(t.inneholder(src, "env(\"NORSCODE_SURFACE_GATE\")"))
    assert(t.inneholder(src, "hvis gate_modus == \"\" { gate_modus = \"rapport\" }"))
    assert(ikkje t.inneholder(src, "\nla _flate"))
    assert(ikkje t.inneholder(src, "third_party/sqlite/sqlite3.c"))
    assert(ikkje t.inneholder(src, "windows_process_fixture.c"))
    skriv("test_active_surface_f0_klassar OK\n")
    returner 0
}
