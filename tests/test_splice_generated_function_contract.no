bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/maint/splice_generated_function.no")
    assert(t.inneholder(src, "NC_SPLICE_FUNCTION"))
    assert(t.inneholder(src, "splice.funksjonsdefinisjon"))
    assert(t.inneholder(src, "splice.erstatt_ein"))
    assert(t.inneholder(src, "splice krev separat utfil"))
    skriv("test_splice_generated_function_contract OK")
    returner 0
}
