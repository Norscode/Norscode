bruk tools.maint.normalize_generated_c_strings som norm

funksjon start() -> heiltall {
    la bs = builtin.chr(92)
    la quote = builtin.chr(34)
    assert(norm.normaliser_payload(bs + bs + "n") == bs + "n")
    assert(norm.normaliser_payload(bs + bs + bs + quote) == bs + quote)
    assert(norm.normaliser_payload(bs + "n") == bs + "n")
    assert(norm.normaliser_payload("vanleg") == "vanleg")
    skriv("test_normalize_generated_c_strings OK")
    returner 0
}
