bruk std.tekst som t

funksjon start() -> heiltall {
    la src = builtin.fil_les("tools/ci_shell_surface_inventory.no")
    assert(t.inneholder(src, "norscode-ci-shell-surface-v2"))
    assert(t.inneholder(src, ".github/workflows"))
    assert(t.inneholder(src, "NORSCODE_CI_SHELL_STRICT"))
    assert(t.inneholder(src, "shellorkestrering"))
    assert(t.inneholder(src, "shell_execution"))
    assert(t.inneholder(src, "norscode_custom_shell"))
    assert(t.inneholder(src, "tools/ci_shell_runner.no {0}"))
    assert(t.inneholder(src, "direkte_norscode"))
    assert(t.inneholder(src, "./bin/nc"))
    assert(t.inneholder(src, "./bootstrap/stage0/norscode-"))
    assert(t.inneholder(src, "./build/windows/norscode_native_"))
    assert(t.inneholder(src, "FEIL: aktiv CI inneheld shell-eksekverte run-blokker"))
    skriv("test_ci_shell_surface_inventory_contract OK")
    returner 0
}
