// Mange røter og kantar må behalde GC-semantikken når tekstregistera blir
// erstatta med indekserte strukturar. Ingen tidsgrense som flakar i CI.
bruk std.runtime_memory som minne
bruk std.runtime.native_gc som fysisk_gc

funksjon start() -> heiltall {
    la h = minne.ny_heap()
    la rot = minne.alloker(h, "liste", 8)
    assert(minne.legg_rot(h, rot))
    assert(minne.legg_rot(h, rot))
    la barn = []
    la i = 0
    mens i < 160 {
        la id = minne.alloker(h, "barn", 8)
        assert(id != "")
        assert(minne.objekt_skriv_byte(h, id, 0, i))
        assert(minne.legg_ref(h, rot, id))
        assert(minne.legg_ref(h, rot, id))
        legg_til(barn, id)
        i = i + 1
    }
    assert_eq(minne.collect(h)["alive"], "161")
    i = 0
    mens i < lengde(barn) {
        hvis i % 2 == 0 { assert(minne.fjern_ref(h, rot, barn[i])) }
        i = i + 1
    }
    // Slett òg den fysiske hovudkanten og set han inn att. Deretter må
    // registeruavhengig GC finne nøyaktig dei 80 attverande barna gjennom
    // header/next-peikarane, utan hjelp frå runtime_memory sitt refs-kart.
    assert(minne.fjern_ref(h, rot, barn[159]))
    assert(minne.legg_ref(h, rot, barn[159]))
    la fysisk = fysisk_gc.mark_fra_roter(h["allocator"], [minne.objekt_adresse(h, rot)])
    assert_eq(fysisk["marked"], "81")
    assert_eq(fysisk["invalid_roots"], "0")
    assert_eq(minne.collect(h)["freed"], "80")
    minne.compact(h)
    i = 0
    mens i < lengde(barn) {
        hvis i % 2 == 0 { assert(ikkje minne.objekt_levande(h, barn[i])) }
        ellers { assert_eq(minne.objekt_les_byte(h, barn[i], 0), i) }
        i = i + 1
    }
    assert_eq(minne.nullstill_roter(h), 1)
    assert_eq(minne.nullstill_roter(h), 0)
    assert(ikkje minne.fjern_rot(h, rot))
    assert(minne.legg_rot(h, rot))
    assert(minne.fjern_rot(h, rot))
    assert_eq(minne.collect(h)["freed"], "81")
    assert_eq(minne.samandrag(h)["alive"], "0")
    assert(ikkje minne.legg_ref(h, rot, barn[1]))
    skriv("test_runtime_memory_fanout OK\n")
    returner 0
}
