bruk std.prosess som prosess

funksjon start() -> heiltall {
    la policy = prosess.ny_policy("async-adapter")
    prosess.tillat_alle(policy)
    prosess.aktiver_køyring(policy)
    la plan = prosess.start_plan("/bin/sleep 30")
    la handle = prosess.start_async_trygt(policy, plan, "ubrukt")
    assert_eq(handle["status"], "kjorer")
    assert(prosess.async_signal(handle, 15))
    assert_eq(handle["status"], "signal")
    assert_eq(prosess.async_exit_code(handle), 143)
    skriv("test_prosess_async_adapter OK")
    returner 0
}
