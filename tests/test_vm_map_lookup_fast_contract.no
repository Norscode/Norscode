funksjon start() -> heiltall {
    la src = builtin.fil_les("selfhost/vm.no")
    la start_idx = builtin.index_of(src, "funksjon vm_map_har_nokkel(obj, nokkel)")
    assert(start_idx >= 0)
    la rest = builtin.slice(src, start_idx, lengde(src))
    la end_idx = builtin.index_of(rest, "funksjon vm_map_get(obj, nokkel)")
    assert(end_idx > 0)
    la kropp = builtin.slice(rest, 0, end_idx)
    assert(builtin.index_of(kropp, "returner finnes_nøkkel(obj, nokkel)") >= 0)
    assert(builtin.index_of(kropp, "nøkler(obj)") < 0)
    la get_rest = builtin.slice(rest, end_idx, lengde(rest))
    la get_end = builtin.index_of(get_rest, "// ─── Hovud-VM-løkke")
    assert(get_end > 0)
    la get_kropp = builtin.slice(get_rest, 0, get_end)
    la direkte_idx = builtin.index_of(get_kropp, "hvis vm_map_har_nokkel(obj, nokkel)")
    la fallback_idx = builtin.index_of(get_kropp, "la nk = nøkler(obj)")
    assert(direkte_idx >= 0)
    assert(fallback_idx > direkte_idx)
    skriv("test_vm_map_lookup_fast_contract OK\n")
    returner 0
}
