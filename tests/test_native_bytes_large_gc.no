// Regresjon (S1b, native_codegen_v2): bytes_to_list på 1 MiB er ein native kopi
// (list_copy_tag, rep movsq), ikkje ei per-byte-løkke, og kopien, originalen og ein
// bytes-slice overlever GC. Støy-rundane kallar bytes_to_list på heile bufferen
// (8 MiB peikararray per kall) og muterer kopien: var bytes_to_list identitet, ville
// mutasjonen treffe originalen og sha256-kontrollane under feile.

funksjon sjekksum(data, per_steg: heiltall) -> heiltall {
    la s: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(data) {
        s = (s * 31 + data[i] + i) % 1000000007
        i = i + per_steg
    }
    returner s
}

funksjon støy(stor, rundar: heiltall) -> heiltall {
    la n: heiltall = 0
    la r: heiltall = 0
    mens r < rundar {
        la tmp = builtin.bytes_to_list(stor)
        tmp[0] = (r * 13 + 1) % 256
        tmp[lengde(tmp) - 1] = r % 256
        n = n + lengde(tmp)
        r = r + 1
    }
    returner n
}

funksjon samle() -> heiltall {
    // Eksplisitt collect i AOT-bygg (NORSCODE_GC_ALLOC=1). VM-vegen har ikkje
    // builtinen, men samlar sjølv under støy-rundane.
    prøv { builtin.gc_collect_native() } fang (e) { }
    returner 0
}

funksjon start() -> heiltall {
    la sti = "build/test-native-bytes-large-gc.bin"
    la blokk_liste: liste_heiltall = []
    la i: heiltall = 0
    mens i < 256 { legg_til(blokk_liste, (i * 37 + 11) % 256) i = i + 1 }
    la blokk = builtin.bytes_from_list(blokk_liste)
    builtin.fil_skriv_binær(sti, blokk)
    la k: heiltall = 1
    mens k < 4096 { builtin.fil_append_binær(sti, blokk) k = k + 1 }
    la stor = builtin.fil_les_binær(sti)
    assert_eq(type_av(stor), "bytes")
    assert_eq(lengde(stor), 1048576)
    assert_eq(stor[0], 11)
    assert_eq(stor[1048575], (255 * 37 + 11) % 256)

    la t0 = builtin.tid_ms()
    la kopi = builtin.bytes_to_list(stor)
    la dt = builtin.tid_ms() - t0
    skriv("bytes_to_list 1 MiB: " + tekst(dt) + " ms\n")
    // Native kopi er millisekund (målt 1 ms under Rosetta); ei per-byte-løkke i VM-en
    // tok ~42 s for 64 KiB på macOS-C-seeden. Romsleg tak mot flaky last.
    assert(dt < 10000)
    assert_eq(type_av(kopi), "liste")
    assert_eq(lengde(kopi), 1048576)

    la ref = builtin.sha256_bytes(stor)
    assert_eq(builtin.sha256_bytes(kopi), ref)
    la s_stor = sjekksum(stor, 1021)
    assert_eq(sjekksum(kopi, 1021), s_stor)
    la midt = builtin.slice(stor, 524288, 528384)
    assert_eq(type_av(midt), "bytes")
    assert_eq(lengde(midt), 4096)
    la s_midt = sjekksum(midt, 1)

    // Mutasjon av kopien rører ikkje originalen.
    kopi[0] = 255 - kopi[0]
    assert_eq(stor[0], 11)
    assert_eq(builtin.sha256_bytes(stor), ref)
    kopi[0] = 255 - kopi[0]

    // GC: ~24 × 8 MiB støy + eksplisitt collect, to gonger.
    assert_eq(støy(stor, 24), 24 * 1048576)
    samle()
    assert_eq(støy(stor, 8), 8 * 1048576)
    samle()

    assert_eq(lengde(kopi), 1048576)
    // Eksplisitte endepunkt: støy skriv tmp[0] og tmp[siste] (sha256_bytes er
    // null-fallback i frittståande AOT-bygg, so desse held porten ærleg der òg).
    assert_eq(stor[0], 11)
    assert_eq(stor[1048575], (255 * 37 + 11) % 256)
    assert_eq(kopi[0], 11)
    assert_eq(kopi[1048575], (255 * 37 + 11) % 256)
    assert_eq(lengde(stor), 1048576)
    assert_eq(builtin.sha256_bytes(kopi), ref)
    assert_eq(builtin.sha256_bytes(stor), ref)
    assert_eq(sjekksum(stor, 1021), s_stor)
    assert_eq(sjekksum(kopi, 1021), s_stor)
    assert_eq(type_av(midt), "bytes")
    assert_eq(lengde(midt), 4096)
    assert_eq(sjekksum(midt, 1), s_midt)
    assert_eq(midt[0], stor[524288])
    assert_eq(midt[4095], stor[528383])

    skriv("test_native_bytes_large_gc OK")
    returner 0
}
