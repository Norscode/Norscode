# RSA PKCS#1 v1.5 SHA-256 verifikasjon - mot ekte 2048-bit nøkkel/signatur (openssl-generert).
bruk std.rsa som rsa
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon start() -> heiltall {
    la n = _b("")
    la e = _b("010001")
    la msg = _b("4e6f7273636f64652052534120504b4353312076312e35205348412d323536207665726966696b61736a6f6e")
    la sig = _b("")

    # (1) Gyldig signatur -> aksept.
    assert_eq(rsa.rsa_verify(n, e, msg, sig), sann)

    # (2) Tukla melding -> avvist.
    la msg2: liste_heiltall = []
    la i = 0
    mens i < lengde(msg) { legg_til(msg2, msg[i]) i = i + 1 }
    msg2[0] = msg2[0] ^ 1
    assert_eq(rsa.rsa_verify(n, e, msg2, sig), usann)

    # (3) Tukla signatur -> avvist (fail-closed).
    la sig2: liste_heiltall = []
    i = 0
    mens i < lengde(sig) { legg_til(sig2, sig[i]) i = i + 1 }
    sig2[lengde(sig2) - 1] = sig2[lengde(sig2) - 1] ^ 1
    assert_eq(rsa.rsa_verify(n, e, msg, sig2), usann)

    assert_eq(rsa.status()["scheme"], "pkcs1-v1_5")
    skriv("test_rsa_pkcs1_sha256 OK")
    returner 0
}
