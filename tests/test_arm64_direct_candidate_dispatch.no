bruk std.tekst som t

funksjon start() -> heiltall {
    la workflow = fil_les(".github/workflows/ci.yml")
    la runner = fil_les("tools/ci_shell_runner.no")
    la overgang = fil_les("archive/legacy_c_backend/nc_native_main.c")
    assert(t.inneholder(workflow, "NORSCODE_VM_DIRECT_CMD: run-ncb"))
    assert(t.inneholder(workflow, "NORSCODE_VM_DIRECT_FILE:"))
    assert(t.inneholder(runner, "NORSCODE_VM_DIRECT_CMD"))
    assert(t.inneholder(overgang, "const char *direct_cmd = getenv(\"NORSCODE_VM_DIRECT_CMD\")"))
    assert(t.inneholder(overgang, "const char *direct_file = getenv(\"NORSCODE_VM_DIRECT_FILE\")"))
    skriv("test_arm64_direct_candidate_dispatch OK")
    returner 0
}
