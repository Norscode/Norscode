# F44: nc doc — markdown frå dokumentasjonskommentarar + signaturar.

bruk tools.nc_doc som doc

funksjon start() -> heiltall {
    la k = "// Modulomtale.\n\n/// Legg saman.\nfunksjon pluss(a: heltall,\n        b: heltall) -> heltall {\n    returner a + b\n}\n\nprivat funksjon skjult() { returner 1 }\n\n/// Eit punkt.\nstruktur Punkt {\n    x: heltall   // x-koordinat\n    y: heltall\n}\n\nfunksjon utan_doku() { returner 0 }\n"
    la md = doc.dokumenter_tekst("m.t", k)
    assert_inneholder(md, "# m.t\n\nModulomtale.")
    assert_inneholder(md, "### `funksjon pluss(a: heltall, b: heltall) -> heltall`\n\nLegg saman.")
    assert_inneholder(md, "### `struktur Punkt`\n\nEit punkt.\n\n- `x: heltall` — x-koordinat\n- `y: heltall`")
    assert_inneholder(md, "### `funksjon utan_doku()`")
    assert(builtin.index_of(md, "skjult") < 0)
    # Kommentar som heng på deklarasjonen er funksjonsdoku, ikkje modulomtale.
    la m2 = doc.dokumenter_tekst("m.u", "/// Berre denne.\nfunksjon f() { returner 1 }\n")
    assert(builtin.index_of(m2, "Berre denne.\n\n## ") < 0)
    assert_inneholder(m2, "### `funksjon f()`\n\nBerre denne.")
    # asynk-modifikator: deklarasjonen skal dokumenterast, privat asynk skal skjulast.
    la m3 = doc.dokumenter_tekst("m.v", "/// Hentar.\nasynk funksjon hent() { returner 1 }\n\nprivat asynk funksjon hemmeleg() { returner 2 }\n")
    assert_inneholder(m3, "hent()")
    assert_inneholder(m3, "Hentar.")
    assert(builtin.index_of(m3, "hemmeleg") < 0)
    returner 0
}
