bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("selfhost/maintenance.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(executable, argv, cwd, miljø, 600000)"))
    assert(t.inneholder(src, "behavior_check(nc, [\"selftest\"]"))
    assert(t.inneholder(src, "behavior_check(nc, [\"run\", \"tests/test_maturity_10_10_gates.no\"]"))
    assert(t.inneholder(src, "behavior_check(nc, [\"run\", \"tools/verify_norscode_surface_ownership.no\"]"))
    assert(t.inneholder(src, "\"NORSCODE_VM_CAPABILITIES\": \"env.read,disk.read,disk.write\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "NODE_BIN=/nonexistent ./bin/nc"))
    assert(ikkje t.inneholder(src, "NORSCODE_ENABLE_EXEC_PROSESS"))
    assert(ikkje t.inneholder(src, "$PWD"))
    skriv("test_maintenance_structured_process OK")
    returner 0
}
