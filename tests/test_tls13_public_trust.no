// Linux x86-64-port: bygg begge offentlege TLS-fixturane frå dagens kjelde,
// krev null uløyste kall og køyr ekte native-kode. Bygg-native skriv ein fersk
// kjeldebunt i ELF-en; han blir trekt ut og bygd med ncb_to_elf si strict-port.
// Ei gammal innebygd gap-rute
// i seeden kan dermed ikkje få kjeldeendringa til å sjå verifisert ut.
bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon krev_ok(r: ordbok, handling: tekst) {
    hvis ikkje prosess.ok(r) {
        prosess.skriv_resultat(r)
        kast "test_tls13_public_trust: " + handling + " feila: " + tekst(r["status"]) + "/" + tekst(r["exit_code"]) + " " + tekst(r["error"])
    }
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la system = tekst(info["system"])
    la maskin = tekst(info["machine"])
    la linux_x64 = (system == "Linux" eller system == "linux") og
        (maskin == "x86_64" eller maskin == "amd64" eller maskin == "X64")
    hvis ikkje linux_x64 {
        hvis env("NC_TEST_CI_VERT") == "linux-x86_64" { kast "TLS-port: CI-vert og faktisk vert er ulike" }
        skriv("test_tls13_public_trust: HOPPA (krev Linux x86-64)\n")
        returner 0
    }
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la runtime = env("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = tekst(info["executable"]) }
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la dir = root + "/build/tls-public-trust-" + builtin.random_hex(8)
    assert(filops.lag_katalogar(dir))
    la miljø = {
        "NORSCODE_CMD": "", "NORSCODE_FILE": "", "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root, "NORSCODE_TLS_CA_FILE": "", "NORSCODE_NATIVE_BIN": runtime,
        "NORSCODE_NATIVE_TOOL_CACHE": "0", "NORSCODE_VM_HOSTED": "0",
        "NORSCODE_USE_PRECOMPILED_SELFHOST": "0", "NORSCODE_GC_ALLOC": "1",
        "NORSCODE_CODEGEN_STRIKT": "1", "NC_BUILTIN_REPORT": "1", "NC_BUILTIN_KVITLISTE": "",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write,net.tcp,net.tls,net.connect,net.listen",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    for namn i ["tls_trust_public_boundary", "tls_trust_public_loopback"] {
        la kjelde = root + "/tests/fixtures/" + namn + ".no"
        la binær = dir + "/" + namn
        la ncb = dir + "/" + namn + ".ncb.json"
        la første = dir + "/" + namn + "-source"
        la bunt = prosess.køyr(runtime, ["bygg-native", "--target", "linux-x86_64", kjelde, første], root, miljø, 180000)
        krev_ok(bunt, "kjeldebygg " + namn)
        miljø["NC_EXTRACT_ELF"] = første
        miljø["NC_EXTRACT_NCB"] = ncb
        la extract = prosess.køyr(runtime, ["run", root + "/tools/extract_embedded_ncb_candidate.no"], root, miljø, 180000)
        krev_ok(extract, "NCB-uttrekk " + namn)
        assert(builtin.fil_finnes(ncb))
        miljø["NORSCODE_NCB_TO_ELF_INPUT"] = ncb
        miljø["NORSCODE_NCB_TO_ELF_OUTPUT"] = binær
        la b = prosess.køyr(runtime, ["run", root + "/tools/ncb_to_elf.no"], root, miljø, 180000)
        krev_ok(b, "bygg " + namn)
        la logg = tekst(b["stdout"]) + tekst(b["stderr"])
        assert(builtin.contains(logg, "BUILTIN-RAPPORT uløyste=0 uventa=0"))
        assert(ikkje builtin.contains(logg, "ÅTVARING ukjent kall"))
        assert(builtin.fil_finnes(binær))
        la r = prosess.køyr(binær, [], root, miljø, 90000)
        krev_ok(r, "køyr " + namn)
        assert(builtin.contains(tekst(r["stdout"]), namn + " OK"))
        skriv(namn + ": fersk AOT, 0 uløyste, OK\n")
        filops.slett_fil(binær)
        filops.slett_fil(ncb)
        filops.slett_fil(første)
    }
    skriv("test_tls13_public_trust OK\n")
    returner 0
}
