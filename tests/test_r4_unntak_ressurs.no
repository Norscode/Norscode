# R4 / F33: prøv med r = opne() { … } (try-with-resources). lukk() køyrer
# garantert, i omvend rekkjefølgje; feil i både kropp og lukk undertrykkjer
# lukk-unntaket (e.undertrykte); berre lukk-feil går vidare; return/bryt/
# fortsett ut av kroppen lukkar. Programmet ligg i tests/fixtures/r4_ressurs.no.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heiltall {
    la d = builtin.split(køyr(fil_les("tests/fixtures/r4_ressurs.no")), "|")
    assert_eq(lengde(d), 12)
    # tre ressursar: lukka c, b, a etter kroppen
    assert_eq(d[0], "ok:opne a,opne b,opne c,kropp,lukk c,lukk b,lukk a")
    # kropp kastar: begge lukka, det rå unntaket (tekst) kjem uendra ut
    assert_eq(d[1], "fanga:KroppFeil: x:opne a,opne b,lukk b,lukk a")
    # kropp OG begge lukk kastar: hovudunntaket vinn, lukk-unntaka er undertrykte
    assert_eq(d[2], "x u=2 [LukkFeil: b][LukkFeil: a] type=KroppFeil fang-type=sann:opne a,opne b,lukk b,lukk a")
    # berre lukk kastar: lukk-unntaket er hovudunntaket
    assert_eq(d[3], "fanga:LukkFeil: a:opne a,kropp,lukk a")
    # indre lukk kastar: ytre lukkar likevel
    assert_eq(d[4], "fanga:LukkFeil: b:opne a,opne b,kropp,lukk b,lukk a")
    # begge lukk kastar, kropp ok: ytre lukk-unntak blir undertrykt på det indre
    assert_eq(d[5], "b u=1 [LukkFeil: a]:opne a,opne b,kropp,lukk b,lukk a")
    # opning av nr. 2 feilar: nr. 1 blir lukka
    assert_eq(d[6], "fanga:OpneFeil: kunne ikkje opne:opne a,opne-feil,lukk a")
    # fortsett/bryt/return ut av kroppen lukkar ressursen (ressursar i omvend rekkjefølgje)
    assert_eq(d[7], "42:opne l0,lukk l0,opne l1,lukk l1,opne l2,lukk l2,opne r1,opne r2,lukk r2,lukk r1")
    # lukk-unntak vinn over return
    assert_eq(d[8], "lukk-vann:LukkFeil: a:opne a,lukk a")
    # null-ressurs blir ikkje lukka
    assert_eq(d[9], "null-ok:kropp")
    # endeleg køyrer etter lukkinga
    assert_eq(d[10], "ok:opne a,kropp,lukk a,endeleg")
    # stakksporet til hovudunntaket overlever undertrykkinga (kast i linje 145)
    assert_eq(d[11], "stakk_bevart:145 u=1")
    returner 0
}
