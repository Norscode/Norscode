bruk std.filecmp som fc
bruk std.runtime_filesystem som fs
bruk std.tekst som t

funksjon start() -> heiltall {
    la rot = "."
    la mappe = "build/filecmp-native-test"
    fs.native_lag_mappe(rot, mappe)
    builtin.fil_skriv(mappe + "/a.txt", "abc\nsame")
    builtin.fil_skriv(mappe + "/b.txt", "abc\nsame")
    builtin.fil_skriv(mappe + "/c.txt", "abc\nchanged")

    assert(fc.cmp_full(mappe + "/a.txt", mappe + "/b.txt"))
    assert(ikkje fc.cmp_full(mappe + "/a.txt", mappe + "/c.txt"))
    assert(fc.md5(mappe + "/a.txt") == "b9585b2944de3ee7298179bf39de0102")
    la diff = fc.diff_filer(mappe + "/a.txt", mappe + "/c.txt")
    assert(t.inneholder(diff, "-same"))
    assert(t.inneholder(diff, "+changed"))

    la dc = fc.dircmp(mappe, mappe)
    la like = builtin.json_parse(dc["like"])
    assert(lengde(like) == 3)

    fs.native_slett(rot, mappe + "/a.txt")
    fs.native_slett(rot, mappe + "/b.txt")
    fs.native_slett(rot, mappe + "/c.txt")
    fs.native_slett_mappe(rot, mappe)
    skriv("test_filecmp_native OK")
    returner 0
}
