// web.*-prefiks-ruting: builtin.web.escape_html (gap-stubba) → std.web.escape_html
// (rein Norscode, bundla via import), kompilert native. 42 = rett HTML-escaping.
bruk std.web som _rt
funksjon start() -> heiltall {
    hvis builtin.web.escape_html("<b>&\"'") != "&lt;b&gt;&amp;&quot;&#x27;" { returner 1 }
    hvis builtin.web.escape_html("safe") != "safe" { returner 2 }
    returner 42
}
