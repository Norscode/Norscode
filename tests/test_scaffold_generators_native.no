bruk std.filops som filops
bruk tools.startapp_generator som app_generator
bruk tools.startproject_generator som project_generator

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la fixture = root + "/build/test-fixtures/norscode-scaffold-test-" + builtin.random_hex(10)
    la app_project = fixture + "/app-project"
    la new_project = fixture + "/new-project"

    assert(filops.lag_katalogar(app_project))
    builtin.fil_skriv(app_project + "/norcode.toml", "[project]\nname=\"fixture\"\n")
    assert(ikkje app_generator.generer(root, app_project, "../escape"))
    assert(app_generator.generer(root, app_project, "ordre"))
    assert(filops.fil_finnes(app_project + "/apps/ordre/ordre.no"))
    assert(filops.fil_finnes(app_project + "/apps/ordre/templates/ordre/index.html"))
    la app_body = builtin.fil_les(app_project + "/apps/ordre/ordre.no")
    assert(builtin.index_of(app_body, "users") < 0)

    assert(ikkje project_generator.generer(root, new_project, "../escape", "app.db", usann, usann))
    assert(project_generator.generer(root, new_project, "butikk", "butikk.db", sann, sann))
    assert(filops.fil_finnes(new_project + "/norcode.toml"))
    assert(filops.fil_finnes(new_project + "/src/admin_bootstrap.no"))
    assert(filops.fil_finnes(new_project + "/std/filops.no"))
    assert(filops.fil_finnes(new_project + "/selfhost/vm.no"))
    assert(lengde(builtin.fil_les_binær(new_project + "/bin/nc")) > 100000)
    assert(builtin.index_of(builtin.fil_les(new_project + "/norcode.toml"), "butikk") >= 0)
    assert(builtin.index_of(builtin.fil_les(new_project + "/innstillingar.toml"), "butikk.db") >= 0)

    la app_src = builtin.fil_les(root + "/tools/startapp_generator.no")
    la project_src = builtin.fil_les(root + "/tools/startproject_generator.no")
    assert(builtin.index_of(app_src, "exec_prosess") < 0)
    assert(builtin.index_of(app_src, "find ") < 0)
    assert(builtin.index_of(project_src, "exec_prosess") < 0)
    assert(builtin.index_of(project_src, "find ") < 0)
    assert(builtin.index_of(project_src, "ln -s") < 0)
    assert(builtin.index_of(project_src, "filops.kopier2(_sti(root, \"bin/nc\"), _sti(output, \"bin/nc\"))") >= 0)

    assert(filops.slett_tre(fixture))
    skriv("test_scaffold_generators_native OK\n")
    returner 0
}
