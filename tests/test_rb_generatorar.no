# F45: generatorar med `gi`. Programmet ligg i tests/fixtures/rb_generatorar.no
# (kjelde-kjeda: kompilator -> NCB -> selfhost/vm.no).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heiltall {
    la d = builtin.split(køyr(fil_les("tests/fixtures/rb_generatorar.no")), "|")
    assert_eq(lengde(d), 17)
    assert_eq(d[0], "0,1,2,3,")
    # lat: kall køyrer ikkje kroppen; første neste køyrer fram til første gi
    assert_eq(d[1], "0/start/12/start,midt,slutt/sann")
    # neste gjev ingenting når ferdig
    assert_eq(d[2], "01sannsann")
    # returner avsluttar
    assert_eq(d[3], "ab")
    # unntak propagerer ved neste(); generatoren er ferdig etterpå
    assert_eq(d[4], "1/MinFeil: bom/sann")
    # gi frå (generator og liste)
    assert_eq(d[5], "startxypqslutt")
    # uendeleg generator + bryt (lat evaluering)
    assert_eq(d[6], "0123")
    # metodesyntaks
    assert_eq(d[7], "01usann2sann")
    # gi som vanleg identifikator
    assert_eq(d[8], "612")
    # uavhengige generatorar
    assert_eq(d[9], "001/21")
    # bryt og fortsett med neste()
    assert_eq(d[10], "012;34")
    # gi inne i prøv/endeleg
    assert_eq(d[11], "123[endeleg]")
    # gi i nøsta blokker, for og neste() på ein annan generator
    assert_eq(d[12], "10,21,100,101,")
    # tom generator
    assert_eq(d[13], "0sann")
    # gi -1: yield av negativt uttrykk; gi - 1 og gi-1 er subtraksjon
    assert_eq(d[16], "-1,-4,9,9")
    # generator som kallar funksjonar og returnerer tidleg; vanleg for uendra
    assert_eq(d[14], "1,4,9,6")
    assert_eq(d[15], "generator:liste")
    returner 0
}
