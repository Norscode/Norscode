// Vakt: kvar førehandsbygd codegen-binær (bootstrap/native_codegen_x86_64.elf og
// kryss-codegen bootstrap/native_codegen_<mål>_on_<vert>.*) må ha .srchash/.depshash som
// svarar til gjeldande kjelde. Kryss-codegen for linux-arm64 og macos-arm64 på linux-x86_64
// (A1) er PÅKRAVD: manglar han, fell `bygg-native --target <arm64-mål>` til 30–95 min tolka
// codegen. Fiks for dei: `nc run tools/build_cross_codegen.no` (skriv binær + hashar). Porten ligg i selfhost/native_execution/codegen_prebuilt.no og blir brukt
// av tools/ncb_to_elf.no og nc_main sin nc_bygg_native_prebuilt:
//   .srchash  = sha256(<codegen-kjelde> ++ selfhost/ncb_serde.no)   (uendra formel; committa
//               seedar sin innebakte nc_main les berre .srchash)
//   .depshash = sha256(resten av bruk-lukkinga til codegen-kjelda)  (F3.7: heile lukkinga,
//               for x86 ncb_bin + heap_layout + gap_ruter)
// Er ein av dei stale, fell kvar ncb-to-elf / bygg-native tilbake til tolka codegen
// (>40 min), og Linux-AOT-lanene går ut på tid langt unna årsaka. Denne testen seier
// det på sekund.
// Fiks: byggj codegen-ELF-fikspunktet (cg1 = committa ELF(ncg), cg2 = cg1(ncg),
// cg3 = cg2(ncg), krev sha256(cg2) == sha256(cg3)) og commit .elf + .srchash + .depshash
// i same commit som codegen-endringa. Testen skriv dei venta hashane ved feil.
// Negativ kontroll: ein kopi av lukkinga i /tmp med éi endra avhengnad MÅ gje «stale».
bruk selfhost.native_execution.codegen_prebuilt som cgp

funksjon inneheld(xs: liste_tekst, x: tekst) -> boolsk {
    la i: heiltall = 0
    mens i < lengde(xs) {
        hvis tekst(xs[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon forelder(sti: tekst) -> tekst {
    la i: heiltall = lengde(sti) - 1
    mens i > 0 {
        hvis builtin.slice(sti, i, i + 1) == "/" { returner builtin.slice(sti, 0, i) }
        i = i - 1
    }
    returner "."
}

funksjon kopier(frå_root: tekst, til_root: tekst, rel: tekst) -> heiltall {
    builtin.mkdir_p(forelder(til_root + "/" + rel))
    fil_skriv(til_root + "/" + rel, builtin.fil_les(frå_root + "/" + rel))
    returner 0
}

// Byggjer ein mellombels rot med x86-lukkinga, ein attrapp-binær og ferske hashfiler. `deps`
// og `src` er rekna ut éin gong av kallaren: kopiane er identiske med root, og srchash (~0,8 MB)
// kostar om lag 1 s på committa Linux-seed.
funksjon lag_probe_rot(root: tekst, probe: tekst, deps: liste_tekst, src: tekst) -> heiltall {
    la filer = cgp.src_filer("linux-x86_64")
    la i: heiltall = 0
    mens i < lengde(deps) { legg_til(filer, tekst(deps[i])) i = i + 1 }
    i = 0
    mens i < lengde(filer) { kopier(root, probe, tekst(filer[i])) i = i + 1 }
    builtin.mkdir_p(probe + "/bootstrap")
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf", "attrapp")
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf.srchash", src + "\n")
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf.depshash", cgp.depshash_av(probe, deps) + "\n")
    returner 0
}

// Probe-rot for arm64-kryss-codegen: lukkingane til begge arm64-måla, attrapp-binærar og dei
// committa hashfilene (kallaren har alt sett at dei er ferske for root).
funksjon lag_arm64_probe_rot(root: tekst, probe: tekst, mål_liste: liste_tekst) -> heiltall {
    la mi: heiltall = 0
    mens mi < lengde(mål_liste) {
        la mål = tekst(mål_liste[mi])
        la filer = cgp.lukking(root, cgp.codegen_kjelde(mål))
        legg_til(filer, "selfhost/ncb_serde.no")
        la i: heiltall = 0
        mens i < lengde(filer) { kopier(root, probe, tekst(filer[i])) i = i + 1 }
        la rel = tekst(cgp.binær_stiar(mål, "linux-x86_64")[0])
        builtin.mkdir_p(probe + "/bootstrap")
        fil_skriv(probe + "/" + rel, "attrapp")
        fil_skriv(probe + "/" + rel + ".srchash", builtin.fil_les(root + "/" + rel + ".srchash"))
        fil_skriv(probe + "/" + rel + ".depshash", builtin.fil_les(root + "/" + rel + ".depshash"))
        mi = mi + 1
    }
    returner 0
}

funksjon status_for(probe: tekst, mål: tekst) -> tekst {
    returner tekst(cgp.vel(probe, mål, "linux-x86_64")["status"])
}

funksjon liste_lik(xs: liste_tekst, venta: liste_tekst) -> boolsk {
    hvis lengde(xs) != lengde(venta) { returner usann }
    la i: heiltall = 0
    mens i < lengde(xs) {
        hvis tekst(xs[i]) != tekst(venta[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    la root = ""
    prøv { root = miljo_hent("NORSCODE_ROOT") } fang (e) { root = "" }
    hvis root == "" { root = "." }

    // 0) Import-skannaren (delar på nøkkelordet, ikkje på linjer): same linjeval som
    //    kompilatoren. Innrykk, kommentar, «;» og `importer` tel; «bruk » midt på ei linje
    //    (streng, kommentar) tel ikkje; rekkjefølgja er kjelde-rekkjefølgja.
    la kj = "bruk a.b som ab\n  \tbruk c.d // kom\nla s = \"x bruk e.f\"\n// bruk g.h\n" +
        "importer i.j;\nfunksjon f() {}\n    bruk k.l#k\nx bruk m.n\nbruk o.p"
    la venta: liste_tekst = ["a.b", "c.d", "i.j", "k.l", "o.p"]
    assert(liste_lik(cgp.bruk_modular(kj), venta))
    // Negativ kontroll: samanlikninga skil (ei ekstra linje midt i gjev ei anna liste).
    assert(ikkje liste_lik(cgp.bruk_modular(kj + "\nbruk q.r"), venta))
    assert(lengde(cgp.bruk_modular("x bruk a.b")) == 0)

    // 1) Kjent svar: x86-lukkinga dekkjer alle tre avhengnadene (ncb_bin mangla før F3.7).
    la deps = cgp.deps_filer(root, "linux-x86_64")
    assert(inneheld(deps, "selfhost/ncb_bin.no"))
    assert(inneheld(deps, "selfhost/native_execution/heap_layout.no"))
    assert(inneheld(deps, "selfhost/native_execution/gap_ruter.no"))
    assert(ikkje inneheld(deps, "selfhost/native_execution/native_codegen_v2.no"))
    assert(inneheld(cgp.deps_filer(root, "linux-arm64"), "selfhost/native_execution/macho_arm64_codegen.no"))
    assert(ikkje cgp.tolka_tillaten("windows-x86_64"))
    assert(ikkje cgp.er_mål("linux-riscv64"))

    // 2) Den committa x86-codegen-ELF-en (legacy-namnet) må vere fersk.
    la val = cgp.vel(root, "linux-x86_64", "linux-x86_64")
    hvis tekst(val["status"]) != "ok" {
        skriv("test_native_codegen_srchash FEIL: " + tekst(val["melding"]) +
              " — byggj bootstrap/native_codegen_x86_64.elf på nytt og skriv .srchash=" +
              cgp.srchash(root, "linux-x86_64") + " .depshash=" + cgp.depshash(root, "linux-x86_64") + "\n")
        feil("native_codegen_x86_64.elf.srchash/.depshash er stale")
    }
    assert_eq(tekst(val["rel"]), "bootstrap/native_codegen_x86_64.elf")
    // Status ok ⇒ den committa .srchash er lik den utrekna; gjenbruk han for probe-røtene.
    la src_root = cgp.les_hash(root + "/bootstrap/native_codegen_x86_64.elf.srchash")

    // 3) Alle andre førehandsbygde (kryss-)codegen-binærar som finst, må òg vere ferske.
    la mål = cgp.mål_liste()
    la status_av = {}
    la mi: heiltall = 0
    mens mi < lengde(mål) {
        la vi: heiltall = 0
        mens vi < lengde(mål) {
            la v = cgp.vel(root, tekst(mål[mi]), tekst(mål[vi]))
            status_av[tekst(mål[mi]) + "@" + tekst(mål[vi])] = tekst(v["status"])
            hvis tekst(v["status"]) == "stale" {
                skriv("test_native_codegen_srchash FEIL: " + tekst(v["melding"]) +
                      " — byggj på nytt med tools/build_cross_codegen.no\n")
                feil(tekst(v["rel"]) + " er stale")
            }
            vi = vi + 1
        }
        mi = mi + 1
    }
    // 3b) A1: kryss-codegen for arm64-måla på linux-x86_64 er påkravd («manglar» er FEIL).
    la arm64_mål: liste_tekst = ["linux-arm64", "macos-arm64"]
    la ai: heiltall = 0
    mens ai < lengde(arm64_mål) {
        la am = tekst(arm64_mål[ai])
        hvis tekst(status_av[am + "@linux-x86_64"]) != "ok" {
            skriv("test_native_codegen_srchash FEIL: " + tekst(cgp.binær_stiar(am, "linux-x86_64")[0]) +
                  " manglar — køyr tools/build_cross_codegen.no og commit .elf/.srchash/.depshash (+ allowlist-pin)\n")
            feil("kryss-codegen for " + am + " manglar")
        }
        ai = ai + 1
    }

    // 4) Negativ kontroll: porten må kunne seie nei.
    la probe = "/tmp/nc_codegen_srchash_probe"
    lag_probe_rot(root, probe, deps, src_root)
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "ok")
    fil_skriv(probe + "/selfhost/ncb_bin.no", builtin.fil_les(root + "/selfhost/ncb_bin.no") + "\n// endra\n")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "stale")
    lag_probe_rot(root, probe, deps, src_root)
    fil_skriv(probe + "/selfhost/ncb_serde.no", builtin.fil_les(root + "/selfhost/ncb_serde.no") + "\n// endra\n")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "stale")
    lag_probe_rot(root, probe, deps, src_root)
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf.depshash", "\n")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "stale")
    // Legacy-namnet gjeld berre x86 på x86: på ein arm64-vert finst ingen binær.
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-arm64")["status"]), "manglar")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "")["status"]), "ukjend")
    assert_eq(tekst(cgp.vel(probe, "linux-arm64", "linux-x86_64")["rel"]), "bootstrap/native_codegen_linux-arm64_on_linux-x86_64.elf")

    // 5) Negativ kontroll for kryss-codegen (A1): porten skil per mål. elf_arm64_emitter er
    //    berre i linux-arm64-lukkinga, so ei endring der gjer linux-arm64 stale medan
    //    macos-arm64 står. (Kvar vel over arm64 hashar macho_arm64_codegen, ~1 s i VM-en;
    //    difor berre éin probe-endring.)
    assert(inneheld(cgp.deps_filer(root, "linux-arm64"), "selfhost/native_execution/elf_arm64_emitter.no"))
    assert(inneheld(cgp.deps_filer(root, "linux-arm64"), "selfhost/native_execution/macho_arm64_codegen.no"))
    assert(ikkje inneheld(cgp.deps_filer(root, "macos-arm64"), "selfhost/native_execution/elf_arm64_emitter.no"))
    la aprobe = "/tmp/nc_codegen_srchash_probe_arm64"
    lag_arm64_probe_rot(root, aprobe, arm64_mål)
    assert_eq(status_for(aprobe, "linux-arm64"), "ok")
    la emitter = "selfhost/native_execution/elf_arm64_emitter.no"
    fil_skriv(aprobe + "/" + emitter, builtin.fil_les(root + "/" + emitter) + "\n// endra\n")
    assert_eq(status_for(aprobe, "linux-arm64"), "stale")
    assert_eq(status_for(aprobe, "macos-arm64"), "ok")

    skriv("test_native_codegen_srchash OK\n")
    returner 0
}
