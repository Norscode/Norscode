// Vakt: bootstrap/native_codegen_x86_64.elf.srchash må svare til gjeldande
// selfhost/native_execution/native_codegen_v2.no + selfhost/ncb_serde.no, og
// .depshash til selfhost/native_execution/heap_layout.no + gap_ruter.no (modulane
// codegen importerer sidan F2, 2026-09-25). Same hashar som tools/ncb_to_elf.no og
// nc_main sin nc_bygg_native_prebuilt_x86 reknar ut; .srchash-formelen er uendra so
// committa seedar sin innebakte nc_main framleis kan bruke ELF-en.
// Er ein av dei stale, fell kvar ncb-to-elf / bygg-native stilt tilbake til tolka codegen
// (>40 min), og Linux-AOT-lanene går ut på tid langt unna årsaka. Denne testen seier
// det på sekund.
// Fiks: byggj codegen-ELF-fikspunktet (cg1 = committa ELF(ncg), cg2 = cg1(ncg),
// cg3 = cg2(ncg), krev sha256(cg2) == sha256(cg3)) og commit .elf + .srchash + .depshash
// i same commit som codegen-endringa.
funksjon start() -> heiltall {
    la root = ""
    prøv { root = miljo_hent("NORSCODE_ROOT") } fang (e) { root = "" }
    hvis root == "" { root = "." }
    la prebuilt = root + "/bootstrap/native_codegen_x86_64.elf"
    la venta = builtin.trim(builtin.fil_les(prebuilt + ".srchash"))
    la faktisk = builtin.sha256(builtin.fil_les(root + "/selfhost/native_execution/native_codegen_v2.no") + builtin.fil_les(root + "/selfhost/ncb_serde.no"))
    hvis lengde(venta) != 64 eller faktisk != venta {
        skriv("test_native_codegen_srchash FEIL: .srchash=" + venta + " kjelde=" + faktisk +
              " — byggj bootstrap/native_codegen_x86_64.elf + .srchash på nytt\n")
        feil("native_codegen_x86_64.elf.srchash er stale")
    }
    la venta_deps = builtin.trim(builtin.fil_les(prebuilt + ".depshash"))
    la faktisk_deps = builtin.sha256(builtin.fil_les(root + "/selfhost/native_execution/heap_layout.no") + builtin.fil_les(root + "/selfhost/native_execution/gap_ruter.no"))
    hvis lengde(venta_deps) != 64 eller faktisk_deps != venta_deps {
        skriv("test_native_codegen_srchash FEIL: .depshash=" + venta_deps + " kjelde=" + faktisk_deps +
              " — byggj bootstrap/native_codegen_x86_64.elf + .depshash på nytt\n")
        feil("native_codegen_x86_64.elf.depshash er stale")
    }
    skriv("test_native_codegen_srchash OK\n")
    returner 0
}
