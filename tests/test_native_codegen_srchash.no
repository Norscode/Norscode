// Vakt: kvar førehandsbygd codegen-binær (bootstrap/native_codegen_x86_64.elf og, når dei
// kjem, bootstrap/native_codegen_<mål>_on_<vert>.*) må ha .srchash/.depshash som svarar til
// gjeldande kjelde. Porten ligg i selfhost/native_execution/codegen_prebuilt.no og blir brukt
// av tools/ncb_to_elf.no og nc_main sin nc_bygg_native_prebuilt:
//   .srchash  = sha256(<codegen-kjelde> ++ selfhost/ncb_serde.no)   (uendra formel; committa
//               seedar sin innebakte nc_main les berre .srchash)
//   .depshash = sha256(resten av bruk-lukkinga til codegen-kjelda)  (F3.7: heile lukkinga,
//               for x86 ncb_bin + heap_layout + gap_ruter)
// Er ein av dei stale, fell kvar ncb-to-elf / bygg-native tilbake til tolka codegen
// (>40 min), og Linux-AOT-lanene går ut på tid langt unna årsaka. Denne testen seier
// det på sekund.
// Fiks: byggj codegen-ELF-fikspunktet (cg1 = committa ELF(ncg), cg2 = cg1(ncg),
// cg3 = cg2(ncg), krev sha256(cg2) == sha256(cg3)) og commit .elf + .srchash + .depshash
// i same commit som codegen-endringa. Testen skriv dei venta hashane ved feil.
// Negativ kontroll: ein kopi av lukkinga i /tmp med éi endra avhengnad MÅ gje «stale».
bruk selfhost.native_execution.codegen_prebuilt som cgp

funksjon inneheld(xs: liste_tekst, x: tekst) -> boolsk {
    la i: heiltall = 0
    mens i < lengde(xs) {
        hvis tekst(xs[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon forelder(sti: tekst) -> tekst {
    la i: heiltall = lengde(sti) - 1
    mens i > 0 {
        hvis builtin.slice(sti, i, i + 1) == "/" { returner builtin.slice(sti, 0, i) }
        i = i - 1
    }
    returner "."
}

funksjon kopier(frå_root: tekst, til_root: tekst, rel: tekst) -> heiltall {
    builtin.mkdir_p(forelder(til_root + "/" + rel))
    fil_skriv(til_root + "/" + rel, builtin.fil_les(frå_root + "/" + rel))
    returner 0
}

// Byggjer ein mellombels rot med x86-lukkinga, ein attrapp-binær og ferske hashfiler.
funksjon lag_probe_rot(root: tekst, probe: tekst) -> heiltall {
    la filer = cgp.src_filer("linux-x86_64")
    la deps = cgp.deps_filer(root, "linux-x86_64")
    la i: heiltall = 0
    mens i < lengde(deps) { legg_til(filer, tekst(deps[i])) i = i + 1 }
    i = 0
    mens i < lengde(filer) { kopier(root, probe, tekst(filer[i])) i = i + 1 }
    builtin.mkdir_p(probe + "/bootstrap")
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf", "attrapp")
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf.srchash", cgp.srchash(probe, "linux-x86_64") + "\n")
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf.depshash", cgp.depshash(probe, "linux-x86_64") + "\n")
    returner 0
}

funksjon start() -> heiltall {
    la root = ""
    prøv { root = miljo_hent("NORSCODE_ROOT") } fang (e) { root = "" }
    hvis root == "" { root = "." }

    // 1) Kjent svar: x86-lukkinga dekkjer alle tre avhengnadene (ncb_bin mangla før F3.7).
    la deps = cgp.deps_filer(root, "linux-x86_64")
    assert(inneheld(deps, "selfhost/ncb_bin.no"))
    assert(inneheld(deps, "selfhost/native_execution/heap_layout.no"))
    assert(inneheld(deps, "selfhost/native_execution/gap_ruter.no"))
    assert(ikkje inneheld(deps, "selfhost/native_execution/native_codegen_v2.no"))
    assert(inneheld(cgp.deps_filer(root, "linux-arm64"), "selfhost/native_execution/macho_arm64_codegen.no"))
    assert(ikkje cgp.tolka_tillaten("windows-x86_64"))
    assert(ikkje cgp.er_mål("linux-riscv64"))

    // 2) Den committa x86-codegen-ELF-en (legacy-namnet) må vere fersk.
    la val = cgp.vel(root, "linux-x86_64", "linux-x86_64")
    hvis tekst(val["status"]) != "ok" {
        skriv("test_native_codegen_srchash FEIL: " + tekst(val["melding"]) +
              " — byggj bootstrap/native_codegen_x86_64.elf på nytt og skriv .srchash=" +
              cgp.srchash(root, "linux-x86_64") + " .depshash=" + cgp.depshash(root, "linux-x86_64") + "\n")
        feil("native_codegen_x86_64.elf.srchash/.depshash er stale")
    }
    assert_eq(tekst(val["rel"]), "bootstrap/native_codegen_x86_64.elf")

    // 3) Alle andre førehandsbygde (kryss-)codegen-binærar som finst, må òg vere ferske.
    la mål = cgp.mål_liste()
    la mi: heiltall = 0
    mens mi < lengde(mål) {
        la vi: heiltall = 0
        mens vi < lengde(mål) {
            la v = cgp.vel(root, tekst(mål[mi]), tekst(mål[vi]))
            hvis tekst(v["status"]) == "stale" {
                skriv("test_native_codegen_srchash FEIL: " + tekst(v["melding"]) + "\n")
                feil(tekst(v["rel"]) + " er stale")
            }
            vi = vi + 1
        }
        mi = mi + 1
    }

    // 4) Negativ kontroll: porten må kunne seie nei.
    la probe = "/tmp/nc_codegen_srchash_probe"
    lag_probe_rot(root, probe)
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "ok")
    fil_skriv(probe + "/selfhost/ncb_bin.no", builtin.fil_les(root + "/selfhost/ncb_bin.no") + "\n// endra\n")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "stale")
    lag_probe_rot(root, probe)
    fil_skriv(probe + "/selfhost/ncb_serde.no", builtin.fil_les(root + "/selfhost/ncb_serde.no") + "\n// endra\n")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "stale")
    lag_probe_rot(root, probe)
    fil_skriv(probe + "/bootstrap/native_codegen_x86_64.elf.depshash", "\n")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-x86_64")["status"]), "stale")
    // Legacy-namnet gjeld berre x86 på x86: på ein arm64-vert finst ingen binær.
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "linux-arm64")["status"]), "manglar")
    assert_eq(tekst(cgp.vel(probe, "linux-x86_64", "")["status"]), "ukjend")
    assert_eq(tekst(cgp.vel(probe, "linux-arm64", "linux-x86_64")["rel"]), "bootstrap/native_codegen_linux-arm64_on_linux-x86_64.elf")

    skriv("test_native_codegen_srchash OK\n")
    returner 0
}
