// Exercise rejection paths and the physical cold-input boundary. The expensive
// native fixed point itself is a separate live gate, not mocked by this test.
bruk tools.selfcompile_toolchain som chain
bruk std.filops som filops

funksjon avviser_ulik(a: tekst, b: tekst) -> boolsk {
    prøv { chain.samanlikn(a, b) } fang (e) { returner sann }
    returner usann
}

funksjon start() -> heiltall {
    la root = "/tmp/norscode_toolchain_contract_" + builtin.random_hex(8)
    assert(filops.lag_katalogar(root + "/source/selfhost"))
    assert(filops.lag_katalogar(root + "/source/std"))
    assert(filops.lag_katalogar(root + "/source/tools"))
    builtin.fil_skriv(root + "/source/selfhost/probe.no", "funksjon start() { returner 42 }\n")
    builtin.fil_skriv(root + "/source/std/probe.no", "// source\n")
    builtin.fil_skriv(root + "/source/tools/probe.no", "// source\n")
    builtin.fil_skriv(root + "/source/selfhost/poison.ncb.json", "must never be copied")
    builtin.fil_skriv(root + "/source/tools/prebuilt.elf", "must never be copied")
    la filer = chain.kjeldefiler(root + "/source")
    assert_eq(lengde(filer), 3)
    la digest = chain.kopier_kjelder(root + "/source", root + "/cold", filer)
    assert_eq(lengde(digest), 64)
    assert(ikkje builtin.fil_finnes(root + "/cold/selfhost/poison.ncb.json"))
    assert(ikkje builtin.fil_finnes(root + "/cold/tools/prebuilt.elf"))
    assert_eq(chain.hash_fil(root + "/cold/selfhost/probe.no"), chain.hash_fil(root + "/source/selfhost/probe.no"))
    chain.krev_kjelder(root + "/cold", filer, digest)
    la nekta = usann
    prøv { chain.kopier_kjelder(root + "/source", root + "/cold", filer) } fang (e) { nekta = sann }
    assert(nekta)
    builtin.fil_skriv(root + "/cold/tools/added.no", "// added during build\n")
    nekta = usann
    prøv { chain.krev_kjelder(root + "/cold", filer, digest) } fang (e) { nekta = sann }
    assert(nekta)
    assert(builtin.fil_slett(root + "/cold/tools/added.no"))
    chain.krev_kjelder(root + "/cold", filer, digest)
    builtin.fil_skriv(root + "/cold/selfhost/probe.no", "// changed during build\n")
    nekta = usann
    prøv { chain.krev_kjelder(root + "/cold", filer, digest) } fang (e) { nekta = sann }
    assert(nekta)
    builtin.fil_skriv(root + "/one", "native" + builtin.chr(0) + "bytes")
    builtin.fil_skriv(root + "/two", "native" + builtin.chr(0) + "bytes")
    la input_sha = chain.hash_fil(root + "/one")
    chain.kopier_binær(root + "/one", root + "/copied", input_sha)
    assert_eq(chain.hash_fil(root + "/copied"), input_sha)
    assert_eq(lengde(chain.samanlikn(root + "/one", root + "/two")), 64)
    builtin.fil_skriv(root + "/two", "native" + builtin.chr(0) + "byteX")
    assert(avviser_ulik(root + "/one", root + "/two"))
    // A previous generation's output is trusted by its already-validated hash,
    // not by hashing whatever happens to be at that path at the next stage.
    nekta = usann
    prøv { chain.kopier_binær(root + "/two", root + "/changed-copy", input_sha) } fang (e) { nekta = sann }
    assert(nekta)
    assert(ikkje builtin.fil_finnes(root + "/changed-copy"))
    nekta = usann
    prøv { chain.krev_hash(root + "/one", "invalid") } fang (e) { nekta = sann }
    assert(nekta)
    assert(avviser_ulik(root + "/missing", root + "/missing"))
    // Store binærar blir hasha i ein kortliva Norscode-prosess. Bevar NUL,
    // samanlikn alle byte, og avvis endringar etter NUL òg i denne ruta.
    la stor = "a" + builtin.chr(0) + "z"
    la dobling = 0
    mens dobling < 20 { stor = stor + stor dobling = dobling + 1 }
    builtin.fil_skriv(root + "/large-a", stor)
    builtin.fil_skriv(root + "/large-b", stor)
    la stor_sha = tekst(builtin.sha256_bytes(builtin.fil_les_binær(root + "/large-a")))
    assert_eq(chain.hash_fil(root + "/large-a"), stor_sha)
    assert_eq(chain.samanlikn(root + "/large-a", root + "/large-b"), stor_sha)
    builtin.fil_skriv(root + "/large-b", builtin.slice(stor, 0, lengde(stor) - 1) + "x")
    assert(avviser_ulik(root + "/large-a", root + "/large-b"))
    assert(ikkje chain.trygt_namn(".."))
    assert(ikkje chain.trygt_namn("../outside"))
    assert(ikkje chain.trygt_namn("bad\nname"))
    assert(chain.trygt_namn("parser.no"))
    assert(chain.commit_gyldig("af6cea5e91c2cf235e18025a4bf0d79295320c48"))
    assert(chain.commit_gyldig(chain.hash_fil(root + "/one")))
    assert(ikkje chain.commit_gyldig("not-a-commit"))
    assert(ikkje chain.commit_gyldig("gf6cea5e91c2cf235e18025a4bf0d79295320c48"))
    assert(filops.slett_tre(root))
    skriv("test_selfcompile_toolchain OK\n")
    returner 0
}
