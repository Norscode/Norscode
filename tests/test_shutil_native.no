bruk std.shutil som shu

funksjon start() -> heltall {
    la rot = ".norscode/test-shutil-" + builtin.random_hex(8)
    assert(shu.makedirs(rot + "/src/sub"))
    builtin.fil_skriv(rot + "/src/sub/a.txt", "norscode")
    assert(shu.copyfile(rot + "/src/sub/a.txt", rot + "/a.txt"))
    assert(shu.storleik(rot + "/a.txt") == 8)
    assert(shu.copytree(rot + "/src", rot + "/dst"))
    assert(builtin.fil_finnes(rot + "/dst/sub/a.txt"))
    assert(shu.move(rot + "/a.txt", rot + "/flytta.txt"))
    assert(lengde(shu.listdir(rot)) == 3)
    assert(shu.make_archive(rot + "/arkiv", "zip", rot) == "")
    assert(ikkje shu.unpack_archive("ikkje.zip", rot))
    la tømt = shu.tøm_katalog(rot)
    hvis miljo_hent("NORSCODE_REQUIRE_NATIVE_RMDIR") == "1" {
        assert(tømt)
        assert(lengde(shu.listdir(rot)) == 0)
        assert(shu.rmtree(rot))
    }
    skriv("test_shutil_native OK")
    returner 0
}
