bruk std.zip som zip
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "zip-stored-")
    assert(temp["status"] == "created")
    la rot = "build/" + temp["relative"]
    assert(filops.lag_katalogar(rot + "/input/bin"))
    builtin.fil_skriv_binær(rot + "/input/bin/norscode.exe",
                            builtin.bytes_from_list([77, 90, 0, 255, 1]))
    builtin.fil_skriv(rot + "/input/README.txt", "Norscode ZIP")
    la filer: liste_tekst = ["README.txt", "bin/norscode.exe"]
    assert(zip.zip_skriv_lagra_filer(rot + "/out.zip", rot + "/input", filer))
    la ark = zip.zip_les_lagra(rot + "/out.zip")
    assert(lengde(ark["README.txt"]) == 12)
    assert(lengde(ark["bin/norscode.exe"]) == 5)
    assert(ark["bin/norscode.exe"][0] == 77)
    assert(ark["bin/norscode.exe"][3] == 255)
    assert(filops.slett_tre(rot))
    skriv("test_zip_stored_pure OK")
    returner 0
}
