// Fase 0: ekte feilsignalering. Ugyldig SQL skal gje -1 + siste_feil-melding,
// men gyldige setningar som råkar 0 rader (t.d. UPDATE utan treff) skal framleis
// gje 0 utan feil. Kjende men uimplementerte setningar (PRAGMA) er stille no-op.

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")

    // Gyldig CREATE => 0, ingen feil
    assert_eq(db.execute(h, "CREATE TABLE t (id INTEGER, v TEXT)"), 0)
    assert_eq(db.siste_feil(h), "")

    // Gyldig INSERT => 1, ingen feil
    assert_eq(db.execute(h, "INSERT INTO t (v) VALUES ('a')"), 1)
    assert_eq(db.siste_feil(h), "")

    // Gyldig UPDATE som råkar 0 rader => 0 (IKKJE feil)
    assert_eq(db.execute(h, "UPDATE t SET v = 'b' WHERE id = 999"), 0)
    assert_eq(db.siste_feil(h), "")

    // Ugyldig SQL => -1 + feilmelding (før: stille 0)
    assert_eq(db.execute(h, "INSRT INTO t (v) VALUES ('x')"), -1)
    assert(db.siste_feil(h) != "")

    // Kjend men uimplementert (PRAGMA) => 0, ikkje feil; nullstiller òg forrige feil
    assert_eq(db.execute(h, "PRAGMA journal_mode = WAL"), 0)
    assert_eq(db.siste_feil(h), "")

    // Neste gyldige setning held feilen nullstilt
    assert_eq(db.execute(h, "INSERT INTO t (v) VALUES ('c')"), 1)
    assert_eq(db.siste_feil(h), "")
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM t"), 2)

    assert(db.close(h))
    returner 0
}
