// builtin.lower/upper på lange tekstar (tests/fixtures/aot_x86_tekst_case_lang.no).
// x86-64-atoma i native_codegen_v2 kopierte via ein fast 256-byte stakkbuffer
// (sub rsp,256) → tekst > 256 byte skreiv over returadressa: SIGSEGV på
// Linux-stage0 frå lengd 257 (og std.http_download, som lowerar kvar hex-lesing).
// No blir resultatet allokert med str_new og fylt direkte.
//   • Linux x86-64-vert: fiksturen blir bygd med codegen-ELF-en (NC_X86_CODEGEN, elles
//     bootstrap/native_codegen_x86_64.elf) utan og med NORSCODE_GC_ALLOC=1, og ELF-en
//     sin utskrift må vere lik aot_x86_tekst_case_lang.forventa.
//   • Andre vertar: same fikstur gjennom VM-en (`run`), same forventa utskrift.
// Committa Linux-seed sin eigen lower er framleis det gamle atomet til neste reseed;
// AOT-vegen testar det nye atomet utan reseed.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    returner system == "Linux" og (maskin == "x86_64" eller maskin == "amd64")
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la m: ordbok_tekst = {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    la nokkel = nøkler(miljø)
    la i: heiltall = 0
    mens i < lengde(nokkel) { m[nokkel[i]] = miljø[nokkel[i]]  i = i + 1 }
    returner prosess.køyr(executable, argv, root, m, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

// stdout frå prosess-ABI-en har escapa linjeskift; VM-køyringa kan òg ha «[vm] …»-linjer.
funksjon rydd(ut0: tekst) -> tekst {
    la linjer = builtin.split(builtin.replace(ut0, "\\n", "\n"), "\n")
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la l = tekst(linjer[i])
        hvis l != "" og ikkje builtin.starts_with(l, "[vm]") { ut = ut + l + "\n" }
        i = i + 1
    }
    returner ut
}

funksjon bygg_og_køyr(rt: tekst, cg: tekst, root: tekst, gc: tekst) -> tekst {
    la merke = builtin.random_hex(8)
    la ncb = "/tmp/norscode_x86_tekst_case_" + merke + ".ncb.json"
    la elf = "/tmp/norscode_x86_tekst_case_" + merke + ".elf"
    krev_exit(køyr(rt, ["bundle", "--output", ncb, root + "/tests/fixtures/aot_x86_tekst_case_lang.no"], root, {}, 300000), 0)
    krev_exit(køyr(cg, [], root, {"NC_TARGET": "linux-x86_64", "NC_INPUT": ncb, "NC_OUTPUT": elf, "NORSCODE_GC_ALLOC": gc}, 600000), 0)
    filops.slett_fil(ncb)
    assert(builtin.fil_sett_kjorbar(elf))
    la r = køyr(elf, [], root, {}, 120000)
    krev_exit(r, 0)
    filops.slett_fil(elf)
    returner rydd(tekst(r["stdout"]))
}

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la rt = runtime(root)
    la forventa = fil_les(root + "/tests/fixtures/aot_x86_tekst_case_lang.forventa")
    hvis vert_linux_x86_64() {
        la cg = miljo_hent("NC_X86_CODEGEN")
        hvis cg == "" { cg = root + "/bootstrap/native_codegen_x86_64.elf" }
        assert_eq(bygg_og_køyr(rt, cg, root, ""), forventa)
        assert_eq(bygg_og_køyr(rt, cg, root, "1"), forventa)
    } ellers {
        la r = køyr(rt, ["run", root + "/tests/fixtures/aot_x86_tekst_case_lang.no"], root, {}, 300000)
        krev_exit(r, 0)
        assert_eq(rydd(tekst(r["stdout"])), forventa)
    }
    skriv("test_x86_tekst_case_lang OK\n")
    returner 0
}
