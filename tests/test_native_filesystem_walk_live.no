bruk std.runtime_filesystem som fs

funksjon start() -> heiltall {
    la r = fs.native_walk_files_med_suffiks(".", "ecosystem", ".c,.sh,.ps1,.js,.swift")
    skriv("walk=" + tekst(r["status"]) + ":" + tekst(r["value"]) + ":" + tekst(r["error"]) + "\n")
    assert(r["status"] == "ok")
    assert(heltall_fra_tekst(tekst(r["value"])) == 0)
    assert(r["data"] == "")

    la cwd = tekst(builtin.system_info()["cwd"])
    la absolutt = fs.native_walk_files_med_suffiks(cwd, "ecosystem", ".c,.sh,.ps1,.js,.swift")
    skriv("walk_absolute=" + tekst(absolutt["status"]) + ":" + tekst(absolutt["value"]) + ":" + tekst(absolutt["error"]) + "\n")
    assert(absolutt["status"] == "ok")
    assert(heltall_fra_tekst(tekst(absolutt["value"])) == 0)
    assert(absolutt["data"] == "")

    la filtrert = fs.native_walk_files_filtrert(
        cwd, "", ".c,.sh", "archive,build,.git,ai_assistent*,tests_bak_*")
    skriv("walk_filtered=" + tekst(filtrert["status"]) + ":" + tekst(filtrert["value"]) + ":" + tekst(filtrert["error"]) + "\n")
    assert(filtrert["status"] == "ok")
    assert(ikkje builtin.contains(filtrert["data"], "archive/"))
    assert(ikkje builtin.contains(filtrert["data"], "build/"))
    skriv("test_native_filesystem_walk_live OK")
    returner 0
}
