bruk std.tekst som t

funksjon start() -> heiltall {
    la ownership = fil_les("tools/verify_norscode_surface_ownership.no")
    la phase0 = fil_les("tools/selfhost_phase0_verify.no")

    assert(t.inneholder(ownership, "funksjon samla_eigarskap_gate"))
    assert(t.inneholder(ownership, "la alle = liste_aktive_filer(root, [\".sh\", \".ps1\", \".js\", \".swift\", \".c\"])"))
    assert(t.inneholder(ownership, "funksjon traverser_katalog"))
    assert(t.inneholder(ownership, "funksjon inkluder_bygg_rotfil"))
    assert(t.inneholder(ownership, "native_fs.native_list_typed(root, katalog)"))
    assert(t.inneholder(ownership, "hvis ikkje typed { listing = native_fs.native_list(root, katalog) }"))
    assert(t.inneholder(ownership, "funksjon liste_aktive_filer_walk"))
    assert(t.inneholder(ownership, "native_fs.native_walk_files_med_suffiks"))
    assert(t.inneholder(ownership, "hvis rask[\"status\"] == \"ok\" { returner rask[\"filer\"] }"))
    assert(t.inneholder(ownership, "rel == \"build/v3009\""))
    assert(t.inneholder(ownership, "rel == \"build/v9630\""))
    assert(t.inneholder(ownership, "rel == \"build/v9646\""))
    assert(t.inneholder(phase0, "ownership.samla_eigarskap_gate(root)"))
    assert(t.inneholder(phase0, "native_fs.native_walk_files(root, relativ)"))
    assert(t.inneholder(phase0, "builtin.contains_any(innhald, mønster)"))
    assert(t.inneholder(ownership, "native_fs.native_walk_files_filtrert("))
    assert(t.inneholder(ownership, "finnes_nøkkel(expected, actual[ai])"))
    assert(t.inneholder(phase0, "la innhald = builtin.fil_les(filer[i])"))
    assert(ikkje t.inneholder(phase0, "ownership.script_eigar_gate(root)"))
    assert(ikkje t.inneholder(phase0, "sjekk_fil(root, filer[i], mønster[j])"))

    skriv("test_surface_ownership_single_pass OK")
    returner 0
}
