bruk std.js_liste som jsl

# Samanliknar lister utan å vere avhengig av korleis tekst(liste) blir formatert
# i den einskilde køyraren.
funksjon flat_tekst(l) -> tekst {
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis i > 0 {
            ut = ut + ","
        }
        la element = l[i]
        hvis builtin.type(element) == "liste" {
            ut = ut + "(" + flat_tekst(element) + ")"
        } ellers {
            ut = ut + tekst(element)
        }
        i = i + 1
    }
    returner ut
}

funksjon dobbel(x: heltall) -> heltall {
    returner x * 2
}

funksjon er_partal(x: heltall) -> bool {
    returner x % 2 == 0
}

funksjon summer(a: heltall, b: heltall) -> heltall {
    returner a + b
}

funksjon par(x: heltall) -> liste {
    returner [x, x]
}

funksjon synkande(a: heltall, b: heltall) -> heltall {
    returner b - a
}

funksjon start() -> heiltall {
    # at() med negativ indeks
    assert_eq(jsl.ved([1, 2, 3], 0), 1)
    assert_eq(jsl.ved([1, 2, 3], -1), 3)
    assert(ikkje jsl.har_indeks([1, 2, 3], 9))
    assert(jsl.har_indeks([1, 2, 3], -3))
    assert(ikkje jsl.har_indeks([1, 2, 3], -4))

    # slice med negative indeksar
    assert_eq(flat_tekst(jsl.skiv([1, 2, 3, 4], 1, 3)), "2,3")
    assert_eq(flat_tekst(jsl.skiv([1, 2, 3, 4], -2, 4)), "3,4")
    assert_eq(flat_tekst(jsl.skiv([1, 2, 3, 4], 2, 99)), "3,4")
    assert_eq(flat_tekst(jsl.skiv_frå([1, 2, 3, 4], 2)), "3,4")

    # indexOf / lastIndexOf / includes
    assert_eq(jsl.indeks_av([1, 2, 3, 2], 2), 1)
    assert_eq(jsl.siste_indeks_av([1, 2, 3, 2], 2), 3)
    assert_eq(jsl.indeks_av([1, 2], 9), 0 - 1)
    assert(jsl.inkluderer([1, 2], 2))
    assert(ikkje jsl.inkluderer([1, 2], 9))

    # streng likskap: 1 og "1" er ikkje like
    assert(ikkje jsl.inkluderer([1, 2], "1"))

    # join
    assert_eq(jsl.sett_saman([1, 2, 3], "-"), "1-2-3")
    assert_eq(jsl.sett_saman([], ","), "")

    # concat / reverse / flat
    assert_eq(flat_tekst(jsl.konkat([1, 2], [3])), "1,2,3")
    assert_eq(flat_tekst(jsl.snu([1, 2, 3])), "3,2,1")
    assert_eq(flat_tekst(jsl.flat([[1, 2], [3], 4])), "1,2,3,4")
    assert_eq(flat_tekst(jsl.flat_djup([[[1]], [2]], 2)), "1,2")

    # splice
    assert_eq(flat_tekst(jsl.spleis([1, 2, 3, 4], 1, 2, [9])), "1,9,4")
    assert_eq(flat_tekst(jsl.spleis([1, 2], 1, 0, [7, 8])), "1,7,8,2")

    # fill / keys / entries
    assert_eq(flat_tekst(jsl.fyll([1, 2, 3], 0)), "0,0,0")
    assert_eq(flat_tekst(jsl.nøklar(["a", "b"])), "0,1")
    assert_eq(flat_tekst(jsl.oppføringar(["a"])), "(0,a)")

    # push / pop / unshift / shift
    la stabel: liste = [1, 2]
    assert_eq(jsl.legg_bak(stabel, 3), 3)
    assert_eq(jsl.pop(stabel), 3)
    assert_eq(flat_tekst(jsl.legg_framfor([2, 3], 1)), "1,2,3")
    assert_eq(flat_tekst(jsl.utan_første([1, 2, 3])), "2,3")
    assert_eq(jsl.pop([]), ingenting)

    # map / filter / reduce
    assert_eq(flat_tekst(jsl.kart([1, 2, 3], "dobbel")), "2,4,6")
    assert_eq(flat_tekst(jsl.filtrer([1, 2, 3, 4], "er_partal")), "2,4")
    assert_eq(jsl.reduser([1, 2, 3], "summer", 0), 6)
    assert_eq(jsl.reduser_høgre([1, 2, 3], "summer", 0), 6)

    # find / findIndex / some / every
    assert_eq(jsl.finn([1, 3, 4], "er_partal"), 4)
    assert_eq(jsl.finn_indeks([1, 3, 4], "er_partal"), 2)
    assert_eq(jsl.finn_indeks([1, 3], "er_partal"), 0 - 1)
    assert_eq(jsl.finn_siste([2, 3, 6], "er_partal"), 6)
    assert(jsl.nokre([1, 2], "er_partal"))
    assert(ikkje jsl.nokre([1, 3], "er_partal"))
    assert(jsl.alle([2, 4], "er_partal"))
    assert(ikkje jsl.alle([2, 3], "er_partal"))

    # flatMap
    assert_eq(flat_tekst(jsl.flat_kart([1, 2], "par")), "1,1,2,2")

    # toSorted med komparator (og stabilitet)
    assert_eq(flat_tekst(jsl.sorter_med([3, 1, 2], "synkande")), "3,2,1")
    assert_eq(flat_tekst(jsl.sorter_med([], "synkande")), "")
    assert_eq(flat_tekst(jsl.sorter_med([5], "synkande")), "5")

    skriv("test_js_liste OK\n")
    returner 0
}
