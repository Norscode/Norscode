// F3.6 (J5.2–4): kontrakt for NCB-formatregelen. Binær NCB er standard der
// forbrukaren kan lese han; alt som går til dei frosne C-æra-vertane (macOS/Windows-
// stage0: JSON-berre lesarar) held seg på JSON. Tekstnivå, køyrer på alle seedar;
// åtferda er prøvd i test_ncb_bin_tekstveg (kodaren og regelfunksjonen) og på fersk
// seed i harnessen (binære test-NCB-ar via host_exec_ncb).
bruk std.tekst som t

funksjon start() -> heiltall {
    la serde = fil_les("selfhost/ncb_serde.no")
    la nc = fil_les("selfhost/nc_main.no")
    la vm = fil_les("selfhost/vm.no")
    la nct = fil_les("tools/nc_test.no")
    la hyb = fil_les("tools/compile_with_hybrid_bundle_v9400.no")
    la entry = fil_les("selfhost/tooling/ncb_host_run_entry.no")
    la embed = fil_les("tools/embed_release_ncb.no")
    la pay = fil_les("tools/materialize_runtime_payloads.no")
    la gap = fil_les("selfhost/native_execution/gap_ruter.no")
    la cg = fil_les("selfhost/native_execution/native_codegen_v2.no")

    // Regelen: éin stad (ncb_serde), flagg overstyrer, elles filendinga, og berre med
    // NUL-trygge strengar.
    assert(t.inneholder(serde, "funksjon binaer_for_sti(sti: tekst) -> boolsk"))
    assert(t.inneholder(serde, "hvis flagg != \"1\" og builtin.ends_with(sti, \".json\") { returner usann }"))
    assert(t.inneholder(fil_les("selfhost/ncb_bin.no"), "returner lengde(builtin.chr(0)) == 1"))

    // Skrivarane: nc compile og nc bundle følgjer regelen.
    assert(t.inneholder(nc, "hvis serde.binaer_for_sti(faktisk_ut) {"))
    assert(t.inneholder(nc, "hvis serde.binaer_for_sti(ut) {"))
    assert(ikkje t.inneholder(nc, "hvis miljo_hent(\"NORSCODE_NCB_BINARY\") == \"1\" {"))

    // Payloadane til C-æra-vertane er eksplisitt JSON.
    assert(t.inneholder(pay, "\"NORSCODE_NCB_BINARY\": \"0\""))
    // Release-imaget (lese av C-æra-runtimane) avviser binær.
    assert(t.inneholder(embed, "la avvis = payload_avvist(sti, ncb)"))

    // Testløparen: binær berre når runtimen melder host_exec_ncb/binær-lesar;
    // pure-VM-lana (vm_executor, tolka lesar) er alltid JSON.
    assert(t.inneholder(nct, "prøv { v = builtin.ncb_binaer_versjon() } fang (e) { returner usann }"))
    assert(t.inneholder(nct, "pure_compile[\"NORSCODE_NCB_BINARY\"] = \"0\""))
    assert(t.inneholder(nct, "la key = test_cache_key(cache, root, fil, hybrid, native) + ncb_ending"))

    // Hybrid-kompilatoren: barna får same format, rask-kopi berre ved likt format.
    assert(t.inneholder(hyb, "\"NORSCODE_NCB_BINARY\": barn_ncb_flagg()"))
    assert(t.inneholder(hyb, "hvis ikkje noko_endra og entry_etter == entry_før og root_binær == ønsk_binær {"))
    assert(t.inneholder(hyb, "la ønsk_binær = serde.binaer_for_sti(out)"))

    // Køyresteget: binær går rett til host_exec_ncb (ingen JSON-rundtur) når verten har han.
    assert(t.inneholder(entry, "hvis vert_les_binaer() { returner host_exec_ncb(t) }"))
    assert(t.inneholder(entry, "returner host_exec_ncb_json(t)"))

    // Vert-API-et og proben i VM-en, og ruta for kompilert kode.
    assert(t.inneholder(vm, "hvis namn == \"builtin.host_exec_ncb\" eller namn == \"host_exec_ncb\" {"))
    assert(t.inneholder(vm, "hvis namn == \"builtin.ncb_binaer_versjon\" {"))
    assert(t.inneholder(vm, "funksjon host_exec_ncb_gap(v) -> heltall {"))
    assert(t.inneholder(gap, "hvis kort == \"host_exec_ncb\" { returner [\"selfhost.vm.host_exec_ncb_gap\"] }"))

    // ELF-traileren er binær (V2) med JSON (V1) som reserve.
    assert(t.inneholder(cg, "funksjon NCB_EMBED_MAGIC() -> tekst { returner \"NORSCODE_NCB_V2\" }"))
    assert(t.inneholder(cg, "hvis serde.binaer_stotta() {"))

    skriv("test_ncb_formatregel_contract OK\n")
    returner 0
}
