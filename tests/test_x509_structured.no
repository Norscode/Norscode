bruk std.x509 som x509
bruk std.base64 som base64

funksjon start() -> heiltall {
    la pem = builtin.fil_les("tests/fixtures/tls/localhost.crt")
    la cert = x509.les_pem(pem)
    assert(cert["status"] == "ok")
    assert(cert["issuer"] == "CN=localhost")
    assert(cert["subject"] == "CN=localhost")
    assert(cert["serial"] == "166278C9D29CFF92E227BA7B69E40ECA39C9598B")
    assert(cert["fingerprint_sha256"] == "50cf1886c84c2c42acf7fe2683d6aa4743f1310b0f91afb09872c516e7d6f34f")
    assert(cert["not_before"] == "2026-01-01T00:00:00Z")
    assert(cert["not_after"] == "2036-01-01T00:00:00Z")
    assert(lengde(cert["sans"]) == 2)
    assert(cert["sans"][0] == "DNS:localhost")
    assert(cert["sans"][1] == "IP:127.0.0.1")
    assert(lengde(x509.les_kjede_pem(pem + "\n" + pem, 2)) == 2)
    assert(lengde(x509.les_kjede_pem(pem + "\n" + pem, 1)) == 0)
    assert(x509.les_pem("ikkje eit sertifikat")["status"] == "feil")
    la deler = builtin.split(pem, "-----BEGIN CERTIFICATE-----")
    la slutt = builtin.split(deler[1], "-----END CERTIFICATE-----")
    la der = base64.dekod_bytes(slutt[0])
    der[1] = 132
    der[2] = 255
    der[3] = 255
    der[4] = 255
    der[5] = 255
    assert(x509.les_der(der)["status"] == "feil")
    skriv("test_x509_structured OK")
    returner 0
}
