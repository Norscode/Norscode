# R1 / F09 (VM-delen): sett_inn(liste, indeks, verdi) set inn på plass (før:
# «Ukjent innebygd funksjon: builtin.sett_inn», exit 139 i 08c), og
# fjern(liste, verdi) med ein ikkje-heiltals-verdi fjernar første like element
# (før: teksten vart brukt som indeks → SIGSEGV). fjern_indeks/pop_siste/
# fjern_siste skal vere uendra. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    la p = "funksjon lj(l) -> tekst {\n" +
        "    la r = \"\"\n" +
        "    for x i l { r = r + tekst(x) + \",\" }\n" +
        "    returner r\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    la ut = \"\"\n" +
        "    la e = [10, 30]\n" +
        "    sett_inn(e, 1, 20)\n" +
        "    ut = ut + \"E=\" + lj(e)\n" +
        "    la s = [2, 3]\n" +
        "    builtin.sett_inn(s, 0, 1)\n" +
        "    sett_inn(s, 3, 4)\n" +
        "    sett_inn(s, 99, 5)\n" +
        "    sett_inn(s, -4, 0)\n" +
        "    ut = ut + \" S=\" + lj(s)\n" +
        "    la r = sett_inn([\"b\"], 0, \"a\")\n" +
        "    ut = ut + \" R=\" + lj(r)\n" +
        "    la f = [\"x\", \"y\", \"z\", \"y\"]\n" +
        "    la fv = fjern(f, \"y\")\n" +
        "    la fu = fjern(f, \"q\")\n" +
        "    ut = ut + \" F=\" + lj(f) + tekst(fv) + \"/\" + tekst(fu)\n" +
        "    la a = [10, 20, 30, 40]\n" +
        "    fjern_indeks(a, 1)\n" +
        "    builtin.fjern_indeks(a, 0)\n" +
        "    ut = ut + \" A=\" + lj(a)\n" +
        "    la d = [10, 20, 30]\n" +
        "    la pv = pop_siste(d)\n" +
        "    ut = ut + \" D=\" + tekst(pv) + \":\" + lj(d)\n" +
        "    returner ut\n" +
        "}\n"
    assert_eq(utfor(p), "E=10,20,30, S=0,1,2,3,4,5, R=a,b, F=x,z,y,sann/usann A=30,40, D=30:10,20,")
    skriv("test_r1_liste_sett_inn OK\n")
    returner 0
}
