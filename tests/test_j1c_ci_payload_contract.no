// CI-kontrakt for J1c (genererte runtime-payloadar) og B4 (Windows-stage0-paritet):
//   - B4 er ein eigen Linux-jobb som berre ventar på kandidaten og payloadane (ikkje gøymd bak
//     attestasjonsjobbane), og den samla readiness-jobben krev han grøn;
//   - release-flyten køyrer B4 på den exe-en som blir pakka, og publiserer ikkje utan han;
//   - runtime-payloads-cachen har ingen restore-keys (delvis treff = stale payload);
//   - Linux-test-compile-cachen hashar ikkje bootstrap/precompiled (generert, les ikkje av compile);
//   - C-æra-jobbane med nedlasta payloadar stoler på artefaktet (NORSCODE_PAYLOADS_TRUST).

bruk std.tekst som t

funksjon tel(kjelde: tekst, bit: tekst) -> heiltall {
    returner lengde(builtin.split(kjelde, bit)) - 1
}

// Teksten til éin jobb: frå «  <namn>:\n» til neste jobb på same innrykk.
funksjon jobb(kjelde: tekst, namn: tekst) -> tekst {
    la start = builtin.index_of(kjelde, "\n  " + namn + ":\n")
    hvis start < 0 { returner "" }
    la rest = builtin.slice(kjelde, start + 1, lengde(kjelde))
    la linjer = builtin.split(rest, "\n")
    la ut = linjer[0]
    la i = 1
    mens i < lengde(linjer) {
        la l = linjer[i]
        hvis lengde(l) > 2 og builtin.starts_with(l, "  ") og ikkje builtin.starts_with(l, "   ") og
           ikkje builtin.starts_with(l, "  #") {
            bryt
        }
        ut = ut + "\n" + l
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la ci = fil_les(".github/workflows/ci.yml")
    la rel = fil_les(".github/workflows/windows-app-release.yml")

    // B4 i hovud-CI.
    la b4 = jobb(ci, "windows-stage0-parity")
    assert(b4 != "")
    assert(t.inneholder(b4, "needs: [windows-runtime-candidate, runtime-payloads]"))
    assert(t.inneholder(b4, "runs-on: ubuntu-latest"))
    assert(t.inneholder(b4, "name: norscode-windows-cross-candidate"))
    assert(t.inneholder(b4, "name: norscode-runtime-payloads"))
    assert(t.inneholder(b4, "tools/verify_windows_stage0_parity.no"))
    assert(ikkje t.inneholder(b4, "if:"))
    la samla = jobb(ci, "all-platform-runtime-attestation")
    assert(samla != "")
    assert(t.inneholder(samla, "      - windows-stage0-parity\n"))
    assert(ikkje t.inneholder(samla, "verify_windows_stage0_parity"))
    assert_eq(tel(ci, "tools/verify_windows_stage0_parity.no"), 1)
    // Kandidatbyggjaren i CI køyrer berre formsjekken; han skal ikkje late som han er porten.
    assert(ikkje t.inneholder(jobb(ci, "windows-runtime-candidate"), "NORSCODE_REQUIRE_WINDOWS_STAGE0_PARITY"))

    // B4 i release: same exe som blir pakka, og ingen publisering utan grøn port.
    la bygg = jobb(rel, "build-windows-app")
    assert(t.inneholder(bygg, "name: norscode-windows-release-candidate"))
    assert(t.inneholder(bygg, "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(builtin.index_of(bygg, "tools/package-windows-app.no") < builtin.index_of(bygg, "name: norscode-windows-release-candidate"))
    la rel_b4 = jobb(rel, "windows-stage0-parity")
    assert(t.inneholder(rel_b4, "needs: [build-windows-app, runtime-payloads]"))
    assert(t.inneholder(rel_b4, "name: norscode-windows-release-candidate"))
    assert(t.inneholder(rel_b4, "tools/verify_windows_stage0_parity.no"))
    assert(t.inneholder(jobb(rel, "github-release"), "needs: [build-windows-app, windows-stage0-parity]"))

    // runtime-payloads-cachen: berre eksakt nøkkel.
    la pl = jobb(ci, "runtime-payloads")
    assert(t.inneholder(pl, "actions/cache/restore@v4"))
    assert(ikkje t.inneholder(pl, "restore-keys"))
    assert(t.inneholder(pl, "NORSCODE_PAYLOADS_CHECK: \"1\""))

    // Linux-test-compile-cachen: seed + hybridverktøy, ikkje den genererte precompiled-mappa.
    assert(ikkje t.inneholder(ci, "'bootstrap/precompiled/**'"))
    assert(tel(ci, "hashFiles('bootstrap/stage0/norscode-linux-x86_64', 'tools/compile_with_hybrid_bundle_v9400.no')") >= 10)

    // C-æra-jobbane med nedlasta payloadar stoler på artefaktet; Linux-jobbane kontrollerer det.
    assert(t.inneholder(jobb(ci, "native-macos"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(t.inneholder(jobb(ci, "native-macos-slow"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(t.inneholder(jobb(ci, "macos-runtime-attestation"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(t.inneholder(jobb(ci, "windows-runtime-candidate"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(ikkje t.inneholder(jobb(ci, "native-linux"), "NORSCODE_PAYLOADS_TRUST"))
    assert(ikkje t.inneholder(pl, "NORSCODE_PAYLOADS_TRUST"))
    // Adapteren må vidaresende flagget (Windows-stage0 sin prosess-ABI erstattar miljøet).
    assert(t.inneholder(fil_les("tools/ci_shell_runner.no"), "\"NORSCODE_PAYLOADS_TRUST\""))

    skriv("test_j1c_ci_payload_contract OK\n")
    returner 0
}
