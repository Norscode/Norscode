// CI-kontrakt for J1c (genererte runtime-payloadar) og B4 (Windows-stage0-paritet):
//   - B4 er ein eigen Linux-jobb som berre ventar på kandidaten og payloadane (ikkje gøymd bak
//     attestasjonsjobbane), og den samla readiness-jobben krev han grøn;
//   - release-flyten byggjer, attesterer og pakkar den same CRT-frie kjeldekandidaten;
//   - runtime-payloads-cachen har ingen restore-keys (delvis treff = stale payload);
//   - Linux-test-compile-cachen hashar ikkje bootstrap/precompiled (generert, les ikkje av compile);
//   - C-æra-jobbane med nedlasta payloadar stoler på artefaktet (NORSCODE_PAYLOADS_TRUST).

bruk std.tekst som t

funksjon tel(kjelde: tekst, bit: tekst) -> heiltall {
    returner lengde(builtin.split(kjelde, bit)) - 1
}

// Teksten til éin jobb: frå «  <namn>:\n» til neste jobb på same innrykk.
funksjon jobb(kjelde: tekst, namn: tekst) -> tekst {
    la start = builtin.index_of(kjelde, "\n  " + namn + ":\n")
    hvis start < 0 { returner "" }
    la rest = builtin.slice(kjelde, start + 1, lengde(kjelde))
    la linjer = builtin.split(rest, "\n")
    la ut = linjer[0]
    la i = 1
    mens i < lengde(linjer) {
        la l = linjer[i]
        hvis lengde(l) > 2 og builtin.starts_with(l, "  ") og ikkje builtin.starts_with(l, "   ") og
           ikkje builtin.starts_with(l, "  #") {
            bryt
        }
        ut = ut + "\n" + l
        i = i + 1
    }
    returner ut
}

// Bind krava til det namngjevne steget. Ein sjølvtest av stage0 i eit
// nabosteg må ikkje skjule at executor-testen har fått feil vert.
funksjon workflow_steg(kjelde: tekst, namn: tekst) -> tekst {
    la start = builtin.index_of(kjelde, "\n      - name: " + namn + "\n")
    hvis start < 0 { returner "" }
    la rest = builtin.slice(kjelde, start + 1, lengde(kjelde))
    la slutt = builtin.index_of(rest, "\n      - ")
    hvis slutt >= 0 { returner builtin.slice(rest, 0, slutt) + "\n" }
    returner rest + "\n"
}

funksjon executor_kompatibilitet(ci: tekst) -> boolsk {
    la windows_abi = jobb(ci, "windows-runtime-cross-compile")
    la kompat = workflow_steg(windows_abi, "Verifiser executor JSON og stream på committed Windows-vert")
    la fersk = "./build/windows/norscode_native_windows_x86_64.exe"
    la testfil = "tests/test_precompiled_vm_executor_host_run.no"
    for krav i [
        "          NORSCODE_NATIVE_BIN: ${{ github.workspace }}/bootstrap/stage0/norscode-windows-x86_64.exe\n",
        "          NORSCODE_VM_CI_CHILD_CMD: run\n",
        "          NORSCODE_VM_CI_CHILD_EXECUTABLE: " + fersk + "\n",
        "          NORSCODE_VM_CI_CHILD_FILE: ${{ github.workspace }}/" + testfil + "\n",
        "          NORSCODE_VM_CI_COMMAND: \"" + fersk + " run " + testfil + "\"\n",
        "        run: " + fersk + " run " + testfil + "\n"
    ] {
        hvis ikkje t.inneholder(kompat, krav) { returner usann }
    }
    // Driveren arvar prosess- og filtilgang frå workflow-env. Desse felta
    // skal ikkje overstyrast av jobben eller kompatibilitetssteget.
    la globalt = builtin.split(ci, "\njobs:\n")[0]
    hvis ikkje t.inneholder(globalt, "\n  NORSCODE_ENABLE_EXEC_PROSESS: \"1\"\n") { returner usann }
    hvis ikkje t.inneholder(globalt, "\n  NORSCODE_VM_CAPABILITIES: env.read,process.exec,disk.read,disk.write\n") { returner usann }
    la lokal_policy = builtin.split(windows_abi, "\n    steps:\n")[0] + kompat
    for felt i ["NORSCODE_ENABLE_EXEC_PROSESS:", "NORSCODE_VM_CAPABILITIES:",
                 "NORSCODE_VM_TARGET_CAPABILITIES:", "NORSCODE_VM_CI_CHILD_CAPABILITIES:"] {
        hvis t.inneholder(lokal_policy, felt) { returner usann }
    }
    returner sann
}

funksjon start() -> heiltall {
    la ci = fil_les(".github/workflows/ci.yml")
    la rel = fil_les(".github/workflows/windows-app-release.yml")

    // B4 i hovud-CI.
    la b4 = jobb(ci, "windows-stage0-parity")
    assert(b4 != "")
    assert(t.inneholder(b4, "needs: [windows-runtime-candidate, runtime-payloads]"))
    assert(t.inneholder(b4, "runs-on: ubuntu-latest"))
    assert(t.inneholder(b4, "name: norscode-windows-cross-candidate"))
    assert(t.inneholder(b4, "name: norscode-runtime-payloads"))
    assert(t.inneholder(b4, "tools/verify_windows_stage0_parity.no"))
    assert(ikkje t.inneholder(b4, "if:"))
    la samla = jobb(ci, "all-platform-runtime-attestation")
    assert(samla != "")
    assert(t.inneholder(samla, "      - windows-stage0-parity\n"))
    assert(ikkje t.inneholder(samla, "verify_windows_stage0_parity"))
    assert_eq(tel(ci, "tools/verify_windows_stage0_parity.no"), 1)
    // Kandidatbyggjaren i CI køyrer berre formsjekken; han skal ikkje late som han er porten.
    assert(ikkje t.inneholder(jobb(ci, "windows-runtime-candidate"), "NORSCODE_REQUIRE_WINDOWS_STAGE0_PARITY"))

    // Den gamle PE-verten har ikkje alle produksjonsbackendar. Han skal
    // framleis gjennom B4 og executor-kompatibilitet, medan runtime-
    // attestasjonen må få den ferske CRT-frie PE-en frå same fullhost-NCB.
    la linux_bygg = jobb(ci, "native-linux-build")
    la windows_abi = jobb(ci, "windows-runtime-cross-compile")
    assert(t.inneholder(linux_bygg, "tools/build_windows_seed.no"))
    assert(t.inneholder(linux_bygg, "NC_WIN_REBUILD_CODEGEN: \"1\""))
    assert(t.inneholder(linux_bygg, "NORSCODE_SEED_NCB: ${{ github.workspace }}/build/ci-runtime/nc_main_fullhost.ncb.json"))
    assert(t.inneholder(linux_bygg, "NC_WIN_OUT: ${{ github.workspace }}/build/windows/norscode_native_windows_x86_64.exe"))
    assert(t.inneholder(linux_bygg, "name: norscode-ci-windows-kandidat"))
    assert(t.inneholder(windows_abi, "name: norscode-ci-windows-kandidat"))
    assert(ikkje t.inneholder(windows_abi, "name: norscode-windows-cross-candidate"))
    assert(t.inneholder(b4, "name: norscode-windows-cross-candidate"))
    assert(t.inneholder(windows_abi, "NORSCODE_WINDOWS_FREESTANDING_ATTESTATION: \"1\""))
    // Fersk CRT-fri driver, committed vert som eksplisitt testmål.
    assert(executor_kompatibilitet(ci))
    la kompat = workflow_steg(windows_abi, "Verifiser executor JSON og stream på committed Windows-vert")
    la gammal = "./bootstrap/stage0/norscode-windows-x86_64.exe"
    la fersk = "./build/windows/norscode_native_windows_x86_64.exe"
    // Negative kontrollar endrar berre dette steget; stage0-sjølvtesten i
    // same jobb er framleis til stades og skal ikkje oppfylle krava.
    for feil i [
        builtin.replace(kompat, "NORSCODE_NATIVE_BIN:", "FEIL_NATIVE_BIN:"),
        builtin.replace(kompat, "/bootstrap/stage0/norscode-windows-x86_64.exe", "/build/windows/norscode_native_windows_x86_64.exe"),
        builtin.replace(kompat, "NORSCODE_VM_CI_CHILD_EXECUTABLE: " + fersk, "NORSCODE_VM_CI_CHILD_EXECUTABLE: " + gammal),
        builtin.replace(kompat, "NORSCODE_VM_CI_CHILD_FILE:", "FEIL_CHILD_FILE:"),
        builtin.replace(kompat, "NORSCODE_VM_CI_COMMAND: \"" + fersk, "NORSCODE_VM_CI_COMMAND: \"" + gammal),
        builtin.replace(kompat, "        run: " + fersk, "        run: " + gammal),
        builtin.replace(kompat, "        env:\n", "        env:\n          NORSCODE_VM_CI_CHILD_CAPABILITIES: env.read,disk.read\n")
    ] {
        assert(ikkje executor_kompatibilitet(builtin.replace(ci, kompat, feil)))
    }
    assert(ikkje executor_kompatibilitet(builtin.replace(ci,
        "  NORSCODE_VM_CAPABILITIES: env.read,process.exec,disk.read,disk.write\n",
        "  NORSCODE_VM_CAPABILITIES: env.read,disk.read\n")))
    assert(t.inneholder(windows_abi, "./build/windows/norscode_native_windows_x86_64.exe run tools/windows_runtime_attestation.no"))
    assert(t.inneholder(windows_abi, "./build/windows/norscode_native_windows_x86_64.exe run tools/platform_readiness_v3600.no"))

    // Release bruker den kjeldebygde og signerte pakken frå same køyring.
    la windows_seed = fil_les(".github/workflows/windows-seed.yml")
    la bygg = jobb(rel, "build-windows-app")
    la publisering = jobb(rel, "github-release")
    la attestering = jobb(windows_seed, "attest-freestanding-win")
    assert(t.inneholder(bygg, "uses: ./.github/workflows/windows-seed.yml"))
    assert(t.inneholder(windows_seed, "workflow_call:"))
    assert(ikkje t.inneholder(rel, "bootstrap/stage0/norscode-windows-x86_64.exe"))
    assert(t.inneholder(publisering, "needs: build-windows-app"))
    assert(t.inneholder(publisering, "if: startsWith(github.ref, 'refs/tags/v')"))
    assert(t.inneholder(publisering, "name: norscode-windows-freestanding-app"))
    assert(t.inneholder(attestering, "name: norscode-windows-freestanding-app"))
    assert(t.inneholder(attestering, "reports/windows-runtime-attestation.json"))
    la signering = builtin.index_of(attestering, "subject-path: build/windows/nc_main_freestanding_win.exe")
    la pakking = builtin.index_of(attestering, "NORSCODE_WINDOWS_PACKAGE_EXE: build/windows/nc_main_freestanding_win.exe")
    assert(signering >= 0 og pakking > signering)

    // runtime-payloads-cachen: berre eksakt nøkkel.
    la pl = jobb(ci, "runtime-payloads")
    assert(t.inneholder(pl, "actions/cache/restore@v4"))
    assert(ikkje t.inneholder(pl, "restore-keys"))
    assert(t.inneholder(pl, "NORSCODE_PAYLOADS_CHECK: \"1\""))

    // Linux-test-compile-cachen: seed + hybridverktøy, ikkje den genererte precompiled-mappa.
    assert(ikkje t.inneholder(ci, "'bootstrap/precompiled/**'"))
    assert(tel(ci, "hashFiles('bootstrap/stage0/norscode-linux-x86_64', 'tools/compile_with_hybrid_bundle_v9400.no')") >= 10)

    // C-æra-jobbane med nedlasta payloadar stoler på artefaktet; Linux-jobbane kontrollerer det.
    assert(t.inneholder(jobb(ci, "native-macos"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(t.inneholder(jobb(ci, "native-macos-slow"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(t.inneholder(jobb(ci, "macos-runtime-attestation"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(t.inneholder(jobb(ci, "windows-runtime-candidate"), "NORSCODE_PAYLOADS_TRUST: \"1\""))
    assert(ikkje t.inneholder(jobb(ci, "native-linux"), "NORSCODE_PAYLOADS_TRUST"))
    assert(ikkje t.inneholder(pl, "NORSCODE_PAYLOADS_TRUST"))
    // Adapteren må vidaresende flagget (Windows-stage0 sin prosess-ABI erstattar miljøet).
    assert(t.inneholder(fil_les("tools/ci_shell_runner.no"), "\"NORSCODE_PAYLOADS_TRUST\""))

    skriv("test_j1c_ci_payload_contract OK\n")
    returner 0
}
