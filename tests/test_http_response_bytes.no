// Binær body gjennom HTTP-serialiseringa: headerane skal ha rett Content-Length
// (talet på bytes, ikkje tekstlengda), og bytane skal leverast uendra etterpå.
// Bakgrunn: tekst(bytes) gjorde 8 byte om til 7 teikn, så fontar/PNG/PDF vart korrupte.
bruk selfhost.http_response som http

funksjon start() -> heiltall {
    la b = builtin.bytes_from_list([0, 1, 2, 255, 128, 65, 195, 169])

    // 1. Bytes-body: Content-Length = 8, standard content-type octet-stream, ingen body i teksten.
    la hovud = http.response_to_http({"status": 200, "body": b})
    assert(builtin.starts_with(hovud, "HTTP/1.1 200 OK\r\n"))
    assert(builtin.contains(hovud, "Content-Length: 8\r\n"))
    assert(builtin.contains(hovud, "Content-Type: application/octet-stream\r\n"))
    assert(builtin.ends_with(hovud, "\r\n\r\n"))
    assert(http.body_er_bytes({"body": b}))
    la ut = http.response_body_bytes({"status": 200, "body": b})
    assert(ut != null)
    assert(lengde(ut) == 8)
    la liste = builtin.bytes_to_list(ut)
    assert(liste[3] == 255 og liste[4] == 128 og liste[6] == 195 og liste[7] == 169)

    // 2. Eksplisitt content-type blir respektert, også via headers-ordboka.
    la png = http.response_to_http({"status": 200, "content_type": "image/png", "body": b})
    assert(builtin.contains(png, "Content-Type: image/png\r\n"))
    assert(ikkje builtin.contains(png, "octet-stream"))
    la woff = http.response_to_http({"status": 200, "headers": {"content-type": "font/woff2", "cache-control": "public, max-age=86400"}, "body": b})
    assert(builtin.contains(woff, "content-type: font/woff2\r\n"))
    assert(builtin.contains(woff, "Content-Length: 8\r\n"))

    // 3. HEAD, 204 og 304 sender aldri bytane, men HEAD melder lengda.
    la head = http.response_to_http({"status": 200, "__head__": sann, "body": b})
    assert(builtin.contains(head, "Content-Length: 8\r\n"))
    assert(http.response_body_bytes({"status": 200, "__head__": sann, "body": b}) == null)
    assert(http.response_body_bytes({"status": 304, "body": b}) == null)
    assert(http.response_body_bytes({"status": 204, "body": b}) == null)

    // 4. Tekst-body er uendra: body i teksten, Content-Length = tekstlengda, ingen bytes.
    la tekstsvar = http.response_to_http({"status": 200, "body": "hei"})
    assert(builtin.contains(tekstsvar, "Content-Length: 3\r\n"))
    assert(builtin.ends_with(tekstsvar, "\r\n\r\nhei"))
    assert(ikkje http.body_er_bytes({"body": "hei"}))
    assert(http.response_body_bytes({"status": 200, "body": "hei"}) == null)
    assert(http.response_body_bytes({"status": 200}) == null)

    skriv("test_http_response_bytes OK\n")
    returner 0
}
