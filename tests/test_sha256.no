bruk std.sha256 som sha

funksjon start() -> heiltall {
    assert_eq(sha.hash(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_eq(sha.hash("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assert_eq(sha.hash_bytes([]), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert_eq(sha.hash_bytes([97, 98, 99]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

    la data = [0, 255, 17, 64, 128, 10, 97, 98, 99]
    la forventa = sha.hash_bytes(data)
    la ctx = sha.ny_kontekst()
    assert_eq(sha.oppdater_bytes(ctx, [0, 255]), 2)
    assert_eq(sha.oppdater_bytes(ctx, [17, 64, 128]), 3)
    assert_eq(sha.oppdater_bytes(ctx, [10, 97, 98, 99]), 4)
    assert_eq(sha.ferdigstill(ctx), forventa)

    la blokkdata: liste_heiltall = []
    la i = 0
    mens i < 130 { legg_til(blokkdata, (i * 37) & 255) i = i + 1 }
    la blokkforventa = builtin.sha256_bytes(blokkdata)
    la blokkctx = sha.ny_kontekst()
    sha.oppdater_bytes(blokkctx, builtin.slice(blokkdata, 0, 1))
    sha.oppdater_bytes(blokkctx, builtin.slice(blokkdata, 1, 63))
    sha.oppdater_bytes(blokkctx, builtin.slice(blokkdata, 63, 130))
    assert_eq(sha.ferdigstill(blokkctx), blokkforventa)
    skriv("test_sha256 OK")
    returner 0
}
