bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/poplib.no")
    assert(t.inneholder(src, "native TCP/TLS-straum"))
    assert(t.inneholder(src, "bruk std.protocol_stream som stream"))
    assert(t.inneholder(src, "stream.dialog(c[\"vert\"], heltall_fra_tekst(c[\"port\"])"))
    assert(t.inneholder(src, "c[\"protokoll\"] == \"pop3s\""))
    assert(t.inneholder(src, "la ut = _socket_pop(c, \"STAT\")"))
    assert(t.inneholder(src, "la ut = _socket_pop(c, \"LIST\")"))
    assert(t.inneholder(src, "la rå = _socket_pop(c, \"RETR \" + tekst_fra_heltall(nummer))"))
    assert(t.inneholder(src, "la svar = _socket_pop(c, \"DELE \" + tekst_fra_heltall(nummer))"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "curl "))
    skriv("test_poplib_shell_quote OK")
    returner 0
}
