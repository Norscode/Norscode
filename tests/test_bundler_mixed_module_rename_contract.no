funksjon start() -> heiltall {
    la src = fil_les("selfhost/bundler.no")
    assert(builtin.contains(src, "la har_hovudmodul = usann"))
    assert(builtin.contains(src, "hvis kandidat[\"module\"] == \"__main__\" { har_hovudmodul = sann }"))
    assert(builtin.contains(src, "hvis namngitt_modul og ikkje har_hovudmodul"))
    assert(builtin.contains(src, "hvis fn[\"module\"] == \"__main__\""))
    assert(builtin.contains(src, "ny_fns[nk[i]] = fn"))
    skriv("test_bundler_mixed_module_rename_contract OK\n")
    returner 0
}
