// Native ARM64 atomic_operation (LDAXR/STLXR). 42 = alle 7 ops rette.
funksjon _op(m: ordbok_tekst) -> ordbok_tekst { returner builtin.atomic_operation(m) }
funksjon start() -> heiltall {
    la c = _op({"abi": "norscode-atomic-v1", "operation": "create", "value": 40, "order": "seq_cst"})
    hvis c["status"] != "ok" { returner 1 }
    la h = c["handle"]
    la r = _op({"abi": "norscode-atomic-v1", "operation": "fetch_add", "handle": h, "delta": 2, "order": "seq_cst"})
    hvis r["observed"] != 40 { returner 2 }
    hvis _op({"abi": "norscode-atomic-v1", "operation": "load", "handle": h, "order": "seq_cst"})["value"] != 42 { returner 3 }
    la x = _op({"abi": "norscode-atomic-v1", "operation": "exchange", "handle": h, "value": 99, "order": "seq_cst"})
    hvis x["observed"] != 42 { returner 4 }
    la cas = _op({"abi": "norscode-atomic-v1", "operation": "compare_exchange", "handle": h, "expected": 99, "replacement": 7, "order": "seq_cst", "failure_order": "relaxed"})
    hvis cas["success"] != "sann" eller cas["observed"] != 99 { returner 5 }
    hvis _op({"abi": "norscode-atomic-v1", "operation": "load", "handle": h, "order": "seq_cst"})["value"] != 7 { returner 6 }
    la cas2 = _op({"abi": "norscode-atomic-v1", "operation": "compare_exchange", "handle": h, "expected": 100, "replacement": 5, "order": "seq_cst", "failure_order": "relaxed"})
    hvis cas2["success"] != "usann" eller cas2["observed"] != 7 { returner 7 }
    hvis _op({"abi": "norscode-atomic-v1", "operation": "fence", "order": "seq_cst"})["status"] != "ok" { returner 8 }
    returner 42
}
