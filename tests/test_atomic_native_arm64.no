// Native ARM64 atomic_operation (LDXR/STXR, ingen syscall). Byggd til ELF via
// codegen; køyrt nativt på arm-runnar. 42 = create/fetch_add/load rett.
funksjon start() -> heiltall {
    la c = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "create", "value": 40, "order": "seq_cst"})
    hvis c["status"] != "ok" { returner 1 }
    la h = c["handle"]
    la r = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "fetch_add", "handle": h, "value": 2, "order": "seq_cst"})
    hvis r["status"] != "ok" { returner 2 }
    hvis r["observed"] != 40 { returner 3 }
    la l = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "load", "handle": h, "order": "seq_cst"})
    hvis l["status"] != "ok" { returner 4 }
    hvis l["value"] != 42 { returner 5 }
    returner 42
}
