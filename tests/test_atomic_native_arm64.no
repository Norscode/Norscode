// Native ARM64 atomic_operation (LDAXR/STLXR, ingen syscall). 42 = alle ops rette.
funksjon start() -> heiltall {
    la c = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "create", "value": 40, "order": "seq_cst"})
    hvis c["status"] != "ok" { returner 1 }
    la h = c["handle"]
    la r = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "fetch_add", "handle": h, "delta": 2, "order": "seq_cst"})
    hvis r["status"] != "ok" eller r["observed"] != 40 { returner 2 }
    la l = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "load", "handle": h, "order": "seq_cst"})
    hvis l["value"] != 42 { returner 3 }
    la x = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "exchange", "handle": h, "value": 99, "order": "seq_cst"})
    hvis x["observed"] != 42 { returner 4 }
    la l2 = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "load", "handle": h, "order": "seq_cst"})
    hvis l2["value"] != 99 { returner 5 }
    la f = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "fence", "order": "seq_cst"})
    hvis f["status"] != "ok" { returner 6 }
    returner 42
}
