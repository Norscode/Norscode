funksjon start() -> heiltall {
    la src = fil_les("tools/maint/compose_generated_c_batches.no")
    assert(builtin.contains(src, "NC_C_BATCH_FILES"))
    assert(builtin.contains(src, "NC_C_EXPECT_FUNCTIONS"))
    assert(builtin.contains(src, "Funksjonsdefinisjonar"))
    assert(builtin.contains(src, "Dispatch-tabell for maintainer-host"))
    assert(builtin.contains(src, "builtin.fil_append(output, definisjonar)"))
    assert(ikkje builtin.contains(src, "exec_prosess"))
    assert(ikkje builtin.contains(src, "sh -c"))
    skriv("test_compose_generated_c_batches_contract OK")
    returner 0
}
