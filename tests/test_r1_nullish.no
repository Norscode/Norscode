# R1 / F16: nullish-operatoren `??` (venstre om ikkje ingenting, elles høgre,
# kortsluttande) og `T?` som annotasjon som berre blir forkasta.
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # Manglande nøkkel gjev standardverdien, ein verdi som finst blir brukt.
    la p_ordbok = "funksjon start() -> tekst {\n" +
        "    la m = {\"y\": \"har\"}\n" +
        "    returner (m[\"x\"] ?? \"standard\") + \",\" + (m[\"y\"] ?? \"standard\")\n" +
        "}\n"
    assert_eq(utfor(p_ordbok), "standard,har")

    # Berre ingenting blir erstatta: 0, usann og tom tekst blir verande.
    la p_falsk = "funksjon start() -> tekst {\n" +
        "    returner tekst(0 ?? 9) + \",\" + tekst(usann ?? sann) + \",[\" + (\"\" ?? \"x\") + \"]\"\n" +
        "}\n"
    assert_eq(utfor(p_falsk), "0,usann,[]")

    # Kortslutting: høgresida blir ikkje evaluert når venstresida har verdi.
    # Kjede: a ?? b ?? c.
    la p_kort = "la teljar = 0\n" +
        "funksjon side() -> tekst {\n" +
        "    teljar = teljar + 1\n" +
        "    returner \"s\"\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    la a = \"v\" ?? side()\n" +
        "    la b = ingenting ?? side()\n" +
        "    la c = ingenting ?? ingenting ?? \"kjede\"\n" +
        "    returner a + b + c + tekst(teljar)\n" +
        "}\n"
    assert_eq(utfor(p_kort), "vskjede1")

    # `??` bind lausare enn aritmetikk og `eller`.
    la p_pres = "funksjon start() -> tekst {\n" +
        "    returner tekst(1 + 2 ?? 7)\n" +
        "}\n"
    assert_eq(utfor(p_pres), "3")

    # `T?` i parameter-, retur- og la-annotasjon blir berre forkasta.
    la p_valfri = "funksjon finn(x: heltall, s: tekst?) -> tekst? {\n" +
        "    hvis x > 0 { returner s }\n" +
        "    returner ingenting\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    la a: tekst? = finn(1, \"pos\") ?? \"neg\"\n" +
        "    la b: liste<tekst?> = [finn(0, \"pos\") ?? \"neg\"]\n" +
        "    returner a + \",\" + b[0]\n" +
        "}\n"
    assert_eq(utfor(p_valfri), "pos,neg")
    returner 0
}
