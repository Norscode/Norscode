bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/fileinput.no")
    assert(t.inneholder(src, "builtin.fil_les_binær(sti)"))
    assert(t.inneholder(src, "builtin.fil_skriv_binær(sti + backup_ext, original)"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))

    skriv("test_fileinput_native_backup OK")
    returner 0
}
