// 2.9: network_operation "poll_mange" — vent på FLEIRE handles i éin poll(2).
// To tilkoplingar over loopback; berre den eine får data, og berre ho skal
// vere i «klare». Utan data: «ventende» etter tidsgrensa. EOF tel som klar.
bruk std.socket som socket

funksjon poll_mange(handles: liste, ms: heiltall) -> ordbok {
    returner builtin.network_operation({"abi": socket.native_versjon(), "operation": "poll_mange", "handles": handles, "timeout_ms": tekst_fra_heltall(ms)})
}

funksjon har(l, h: tekst) -> boolsk {
    la i: heiltall = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == h { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon start() -> heiltall {
    la lytt = socket.native_lytt("127.0.0.1", 0, 16)
    assert(tekst(lytt["status"]) == "listening")
    la port = heltall_fra_tekst(tekst(lytt["port"]))
    la k1 = socket.native_tilkoble("127.0.0.1", port)
    la s1 = socket.native_aksepter(lytt)
    la k2 = socket.native_tilkoble("127.0.0.1", port)
    la s2 = socket.native_aksepter(lytt)
    assert(tekst(s1["status"]) == "connected" og tekst(s2["status"]) == "connected")
    la h1 = tekst(s1["handle"])
    la h2 = tekst(s2["handle"])

    // Ingen data: ventende etter tidsgrensa, tom klare-liste.
    la r0 = poll_mange([h1, h2], 50)
    assert_eq(tekst(r0["status"]), "ventende")
    assert_eq(lengde(r0["klare"]), 0)

    // Data berre på k2 → berre s2 er klar.
    socket.native_skriv(k2, "hei")
    la r1 = poll_mange([h1, h2, "socket:finst-ikkje:1"], 2000)
    assert_eq(tekst(r1["status"]), "klar")
    assert(har(r1["klare"], h2))
    assert(ikkje har(r1["klare"], h1))

    // EOF på k1 → s1 vert òg klar.
    socket.native_lukk(k1)
    la r2 = poll_mange([h1, h2], 2000)
    assert(har(r2["klare"], h1))
    assert(har(r2["klare"], h2))

    socket.native_lukk(k2)
    socket.native_lukk(s1)
    socket.native_lukk(s2)
    socket.native_lukk(lytt)
    skriv("test_network_poll_mange OK\n")
    returner 0
}
