# W8 (WASM-sporet): den installerbare deltakar-demoen (examples/wasm_deltakarar/) ende til ende i
# headless Chrome, via nettlesar-benken. Chrome-stega er VALFRIE (SKIP utan Chrome;
# NC_CHROME=<sti>).
#
# Alltid: testbygget med service worker (NC_WASM_SW=1) blir bygd og validert av CLI-en: sida
# importerer PWA-gruppa (sw_registrer, sw_status, sw_send) og eksporterer __sw_endra, og
# workeren importerer berre sw_lytt, sw_inn og sw_ut (og dei interne) og eksporterer
# handterarane.
# Med Chrome (tests/fixtures/wasm_deltakarar_pwa_testklient.no, same profil):
#   steg=1       på nett, fersk profil: workeren blir installert; precachen er app-skalet,
#                offline-ruta og dei versjonerte ressursane i éin cache «nc-<16 hex>»; lista
#                blir lagra lokalt
#   /mi-side     navigasjon til ei privat side (kontrollert): tenaren svarar, workeren lagrar ho
#                ikkje
#   steg=2       kontrollert: /nyheiter?ny=1 oppdaterer oppføringa, ?feil=403 og ?privat=1 gjer
#                det ikkje; cachen har framleis berre precache-URL-ane (ingen /api/, /mi-side)
#   — nc serve blir stoppa —
#   steg=3       utan nett: sida kjem frå cachen, den lokale kopien frå IndexedDB blir vist,
#                tenaren svarar ikkje, ikona er 192×192 og 512×512 frå cachen, og /nyheiter er
#                «nyheiter v2»
#   /finst-ikkje utan nett: offline-sida (data-nc-offline="1"), ikkje feilsida til Chrome
#   /mi-side     utan nett: offline-sida, ikkje persondata (negativ kontroll)
#   Negativ kontroll: ein fersk profil utan nett får ingenting (Chrome: «Page load failed»).
# Ingen lasting har «Uncaught».
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon rot() -> tekst { returner "build/wasm/test_w8_demo" }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

funksjon har(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon linjer(l: liste) -> tekst {
    returner builtin.join(l, "\n") + "\n"
}

funksjon krev_lik(namn: tekst, r: ordbok, venta: tekst) -> heltall {
    hvis r["logg"] != venta {
        skriv(namn + ": skil seg frå fasiten, " + kh.skilnad(r["logg"], venta) + "\nFekk:\n" + r["logg"] + "\nFasit:\n" + venta + "\n")
        assert(usann)
    }
    hvis r["uncaught"] {
        skriv(namn + ": «Uncaught» i konsollen:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    returner 0
}

# Byggjelinjene: sida med PWA-gruppa, workeren med berre SW-importane.
funksjon krev_bygg(ut: tekst) -> heltall {
    la p = builtin.index_of(ut, "SW: ")
    hvis p < 0 {
        skriv("fann ikkje SW-linja:\n" + ut + "\n")
        assert(usann)
    }
    la sw = builtin.slice(ut, p, lengde(ut))
    la nl = builtin.index_of(sw, "\n")
    la bs = builtin.index_of(sw, "\\")
    hvis bs >= 0 og (nl < 0 eller bs < nl) { nl = bs }
    hvis nl >= 0 { sw = builtin.slice(sw, 0, nl) }
    la imp = hjelp.liste_felt(sw, "importar")
    la eksp = hjelp.liste_felt(sw, "eksportar")
    la tillatne = ["sw_lytt", "sw_inn", "sw_ut", "logg", "flyt_tekst", "tekst_flyt", "nå_ms"]
    la i = 0
    mens i < lengde(imp) {
        hvis ikkje har(tillatne, imp[i]) {
            skriv("workeren importerer " + tekst(imp[i]) + ": " + sw + "\n")
            assert(usann)
        }
        i = i + 1
    }
    assert(har(imp, "sw_lytt") og har(imp, "sw_inn") og har(imp, "sw_ut"))
    la h = ["_sw_install", "_sw_rydd", "_sw_melding", "_sw_hent", "_sw_lagre"]
    la j = 0
    mens j < lengde(h) {
        assert(har(eksp, h[j]))
        j = j + 1
    }
    skriv("bygg: " + builtin.slice(sw, 0, builtin.index_of(sw, " importar=")) + "\n")
    returner 0
}

funksjon precache() -> liste {
    returner ["cachar: 1", "cache nc-<16 hex>", "  /", "  /_nc/app.wasm?v=*", "  /_nc/ikon-192.png?v=*", "  /_nc/ikon-512.png?v=*",
              "  /_nc/ikon-maskable.png?v=*", "  /_nc/nc.js", "  /_nc/offline", "  /_nc/sw.wasm?v=*", "  /manifest.webmanifest",
              "  /nyheiter", "  /stil.css", "  /test"]
}

funksjon med(l: liste, meir: liste) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(l) {
        legg_til(ut, l[i])
        i = i + 1
    }
    i = 0
    mens i < lengde(meir) {
        legg_til(ut, meir[i])
        i = i + 1
    }
    returner ut
}

funksjon ikkje_lagra() -> tekst { returner "Lista blir ikkje lagra på eininga." }

funksjon fasit_1() -> tekst {
    returner linjer(med(med([
        "steg 1",
        "lasta: 10 deltakarar | status=10 deltakarar. | feil= | lokal=" + ikkje_lagra(),
        "sw registrert, kontrollert=usann",
        "sw klar, aktiv=sann",
        "hugsa: 10 deltakarar | status=10 deltakarar. | feil= | lokal=Lista er lagra på eininga (10 deltakarar)."],
        precache()), ["ferdig"]))
}

funksjon fasit_2() -> tekst {
    returner linjer(med(med([
        "steg 2",
        "sw registrert, kontrollert=sann",
        "sw klar, aktiv=sann",
        "lasta: 10 deltakarar | status=10 deltakarar. | feil= | lokal=Lista er lagra på eininga.",
        "nyheiter ny=1: 200 nyheiter v2",
        "nyheiter feil=403: status 403 nekta",
        "nyheiter privat=1: 200 privat utgåve"],
        precache()), ["ferdig"]))
}

funksjon fasit_3() -> tekst {
    returner linjer(med(med([
        "steg 3",
        "sw registrert, kontrollert=sann",
        "sw klar, aktiv=sann",
        "lokal: 10 deltakarar | status=Viser lagra kopi frå eininga (10 deltakarar) – hentar frå tenaren … | feil= | lokal=Lista er lagra på eininga.",
        "lasta: 10 deltakarar | status=Viser lagra kopi frå eininga (10 deltakarar). Tenaren svarar ikkje, så lista kan vere eldre enn på tenaren. | " +
            "feil=Kunne ikkje hente lista: fekk ikkje kontakt med tenaren. | lokal=Lista er lagra på eininga.",
        "ikon frå cachen: 192x192, 512x512",
        "nyheiter utan nett: 200 nyheiter v2"],
        precache()), ["ferdig"]))
}

funksjon krev_offline_side(namn: tekst, r: ordbok) -> heltall {
    hvis ikkje inneheld(r["dom"], "<body data-nc-offline=\"1\">") eller ikkje inneheld(r["dom"], "<title>Deltakarar: du er fråkopla</title>") {
        skriv(namn + ": venta offline-sida frå workeren:\n" + r["dom"] + "\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    assert(ikkje inneheld(r["dom"], "Persondata"))
    assert(ikkje r["side_feila"])
    returner 0
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())
    la ut = bygg_sw(rot() + "/testbygg")
    krev_bygg(ut)
    hvis benk.finn_chrome() == "" {
        skriv("test_wasm_w8_demo OK (bygg; SKIP Chrome: fann ikkje Chrome/Chromium, set NC_CHROME=<sti>)\n")
        returner 0
    }
    la økt = benk.ny_økt("test_w8_demo")
    utsett {
        benk.rydd(økt)
    }
    la s = benk.start_serve(økt, hjelp.serve_inngang(rot() + "/testbygg"), "48395")
    hvis s["status"] != "kjorer" { skriv("nc serve starta ikkje:\n" + tekst(s["ut"]) + "\n") }
    assert_eq(s["status"], "kjorer")
    la u = "http://127.0.0.1:48395"
    la same = {"profil": "eining", "behald_profil": sann}
    la r1 = benk.last_side(økt, u + "/test?steg=1", same)
    krev_lik("steg 1 (på nett, fersk profil)", r1, fasit_1())
    la privat = benk.last_side(økt, u + "/mi-side", same)
    assert(inneheld(privat["dom"], "Persondata for Åse"))
    krev_lik("steg 2 (på nett, kontrollert)", benk.last_side(økt, u + "/test?steg=2", same), fasit_2())
    skriv("på nett: installert og precacha (steg 1: " + tekst(r1["ms"]) + " ms); 403 og private svar skreiv ikkje over offline-ruta; /api/ og /mi-side vart ikkje lagra\n")
    benk.stopp_serve(økt)
    la r3 = benk.last_side(økt, u + "/test?steg=3", same)
    krev_lik("steg 3 (utan nett)", r3, fasit_3())
    krev_offline_side("ukjend side utan nett", benk.last_side(økt, u + "/finst-ikkje", same))
    krev_offline_side("privat side utan nett", benk.last_side(økt, u + "/mi-side", same))
    # Negativ kontroll: utan workeren (fersk profil) får Chrome ingenting
    la fersk = benk.last_side(økt, u + "/test?steg=3", {"grense_ms": 20000})
    assert(fersk["side_feila"])
    assert(ikkje inneheld(fersk["dom"], "deltakarar"))
    skriv("utan nett: sida frå cachen (" + tekst(r3["ms"]) + " ms) med den lokale kopien og ikona; offline-sida for ukjende og private sider; fersk profil: «Page load failed»\n")
    skriv("test_wasm_w8_demo OK\n")
    returner 0
}

# Bygg testklienten med service workeren (NC_WASM_SW=1). Gjev utdata frå CLI-en (WASM- og
# SW-linja).
funksjon bygg_sw(utmappe: tekst) -> tekst {
    hjelp.mkdir(utmappe)
    la r = hjelp.bygg_sw_app("tests/fixtures/wasm_deltakarar_pwa_testklient.no", utmappe, sann, "tests/fixtures/wasm_deltakarar_pwa_testapp.no")
    returner r
}
