// R3 trinn 8 (3.5): std.modell som felles kjøretidsvalidator for strukturtypar.
// Strukturmetadata frå kompilatoren ({namn, felt: [{namn, type, har_standard,
// standard}]}, typane som tekstform frå typesystemet) blir modellar med
// modell.frå_struktur: same konvertering, 422-poster, serialisering og JSON Schema
// som skjema-som-data. som_instans gjev ein ekte struktur-instans (metodar, typenamn).
bruk std.modell som m

struktur Adresse {
    gate: tekst
    nr: heltall
}

funksjon Adresse.vis(self) -> tekst {
    returner self.gate + " " + tekst(self.nr)
}

funksjon _f(namn: tekst, typ: tekst) -> ordbok { returner {"namn": namn, "type": typ, "har_standard": usann, "standard": null} }

funksjon _katalog() -> ordbok {
    returner {
        "Adresse": {"namn": "Adresse", "felt": [_f("gate", "tekst"), _f("nr", "heltall")]},
        "Person": {"namn": "Person", "felt": [
            _f("namn", "tekst"),
            {"namn": "alder", "type": "heltall", "har_standard": sann, "standard": 0},
            _f("vekt", "desimaltall?"),
            _f("adresse", "Adresse"),
            _f("tidlegare", "liste<Adresse>"),
            _f("merke", "liste<tekst>"),
            _f("ekstra", "")
        ]}
    }
}

funksjon _har(feil: liste, typ: tekst, loc: tekst) -> boolsk {
    la i = 0
    mens i < lengde(feil) {
        la p = builtin.json_parse_raw(feil[i])
        hvis tekst(p["type"]) == typ og builtin.join(p["loc"], "/") == loc { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon test_validering() -> heltall {
    la k = _katalog()
    la md = m.frå_struktur(k["Person"], k)
    la ok = m.valider(md, {"namn": "Ada", "alder": "36", "adresse": {"gate": "G", "nr": 1},
                           "tidlegare": [{"gate": "H", "nr": "2"}], "merke": ["a"], "ekstra": [1]})
    assert(ok["gyldig"])
    la v = ok["verdiar"]
    assert_eq(v["alder"], 36)
    assert_eq(v["tidlegare"][0]["nr"], 2)
    // Valfri (desimaltall?) kan mangle og kan vere null.
    assert(ikkje finnes_nøkkel(v, "vekt"))
    assert(m.valider(md, {"namn": "A", "vekt": null, "adresse": {"gate": "G", "nr": 1}, "tidlegare": [], "merke": [], "ekstra": 1})["gyldig"])
    la f = m.valider(md, {"alder": "x", "vekt": "tung", "adresse": {"gate": 5}, "tidlegare": [{"gate": "H", "nr": "y"}], "merke": "ikkje-liste"})
    assert(ikkje f["gyldig"])
    la fl = f["feil"]
    assert(_har(fl, "missing", "body/namn"))
    assert(_har(fl, "int_parsing", "body/alder"))
    assert(_har(fl, "float_parsing", "body/vekt"))
    assert(_har(fl, "string_type", "body/adresse/gate"))
    assert(_har(fl, "missing", "body/adresse/nr"))
    assert(_har(fl, "int_parsing", "body/tidlegare/0/nr"))
    assert(_har(fl, "list_type", "body/merke"))
    // Standardverdien (alder) gjer feltet valfritt.
    assert(ikkje _har(fl, "missing", "body/alder"))
    returner 0
}

funksjon test_instans_og_filter() -> heltall {
    la k = _katalog()
    la md = m.frå_struktur(k["Adresse"], k)
    la r = m.valider(md, {"gate": "Storgata", "nr": "7", "x": 1})
    la a = m.som_instans(md, r["verdiar"], "__main__")
    assert_eq(builtin.typenamn(a), "Adresse")
    assert(er_instans(a, Adresse))
    assert_eq(a.vis(), "Storgata 7")
    // Ukjende felt kjem ikkje med; filtrer gjev berre felta i modellen.
    assert(ikkje finnes_nøkkel(a, "x"))
    la pm = m.frå_struktur(k["Person"], k)
    la ut = m.filtrer(pm, {"namn": "A", "passord": "p", "adresse": {"gate": "G", "nr": 1, "intern": 2}})
    assert(ikkje finnes_nøkkel(ut, "passord"))
    assert(ikkje finnes_nøkkel(ut["adresse"], "intern"))
    assert_eq(ut["alder"], 0)
    returner 0
}

funksjon test_skjema() -> heltall {
    la k = _katalog()
    la s = m.json_schema(m.frå_struktur(k["Person"], k))
    assert_eq(s["properties"]["alder"]["type"], "integer")
    assert_eq(s["properties"]["adresse"]["type"], "object")
    assert_eq(s["properties"]["tidlegare"]["items"]["properties"]["nr"]["type"], "integer")
    assert_eq(s["properties"]["merke"]["items"]["type"], "string")
    assert_eq(builtin.join(s["required"], ","), "namn,adresse,tidlegare,merke,ekstra")
    returner 0
}

funksjon start() -> heltall {
    test_validering()
    test_instans_og_filter()
    test_skjema()
    skriv("test_r3_modell_struktur OK\n")
    returner 0
}
