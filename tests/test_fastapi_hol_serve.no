// FastAPI-hol (matrise 07.10) under ekte `nc serve` i ein barneprosess, med
// NORSCODE_FAKE_HTTP_REQUESTS (same serve_handle_one som socket-løkka).
// Fixture: tests/fixtures/fastapi_hol_app.no. Mønsteret (miljøkontrakt med
// eksplisitt, ikkje-arva miljø og robust tolking av escapa linjeskift) er
// det same som i test_app_kjensle_serve.
//
// Krav:
//   - FA-097: web.tags("varer") i handlaren gjev 200 (ikkje 500 ArgumentFeil)
//   - FA-097/059/100: /openapi.json har tags/description/deprecated frå
//     markørane, extra_responses (404) og ingen /skjult (web.skjul())
//   - FA-016/029: ugyldig JSON, text/plain-kropp og request_query_int med
//     feil/manglande verdi gjev 422 {"detail":[…]}, ikkje 500
//   - FA-063: to web.response_set_cookie gjev to Set-Cookie-linjer
//   - FA-018: request_query_list gjev alle verdiar for ?t=a&t=b
//   - FA-066/067: asynk.streaming_response og jsonl_response gjev kropp
bruk std.runtime.process_abi som process_abi
bruk std.web som web

funksjon crlf() -> tekst { returner "\r\n" }

funksjon førespurnad(metode: tekst, sti: tekst, ekstra: liste_tekst, kropp: tekst) -> tekst {
    la r = metode + " " + sti + " HTTP/1.1" + crlf() + "Host: 127.0.0.1" + crlf()
    la i: heiltall = 0
    mens i < lengde(ekstra) {
        r = r + ekstra[i] + crlf()
        i = i + 1
    }
    hvis kropp != "" { r = r + "Content-Length: " + tekst(lengde(kropp)) + crlf() }
    returner r + crlf() + kropp
}

funksjon get(sti: tekst, ekstra: liste_tekst) -> tekst {
    returner førespurnad("GET", sti, ekstra, "")
}

// NORSCODE_FAKE_HTTP_REQUESTS skil førespurnader med bokstaveleg «\n» (to teikn).
funksjon saman(reqs: liste_tekst) -> tekst {
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(reqs) {
        hvis i > 0 { ut = ut + "\\n" }
        ut = ut + reqs[i]
        i = i + 1
    }
    returner ut
}

funksjon serve_miljø(root: tekst, reqs: tekst) -> ordbok_tekst {
    returner {
        "PATH": "/usr/bin:/bin",
        "HOME": miljo_hent("HOME"),
        "TMPDIR": "/tmp",
        "NORSCODE_CMD": "serve",
        "NORSCODE_FILE": root + "/tests/fixtures/fastapi_hol_app.no",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_MODULE": "",
        "NORSCODE_ROOT": root,
        "NC_SERVE_PORT": "48187",
        "NC_SERVE_HOST": "127.0.0.1",
        "NORSCODE_FAKE_HTTP_REQUESTS": reqs,
        "NORSCODE_FAKE_HTTP_REQUEST": "",
        "NORSCODE_VM_FAST": "1",
        "NORSCODE_VM_CI_COMMAND": "",
        "NORSCODE_VM_CI_CHILD_CMD": "",
        "NORSCODE_VM_CI_CHILD_FILE": "",
        "NORSCODE_RUN_DIRECT_HOST": "0",
        "NORSCODE_HOST_NCB_FILE": "",
        "NORSCODE_NCB_FILE": ""
    }
}

// Opphev escaping når prosess-ABI-en har levert linjeskift som «\n» (to teikn),
// eventuelt dobbelt («\\n»). Rå utdata (med ekte linjeskift) blir ikkje rørt.
funksjon normaliser(t: tekst) -> tekst {
    la s = t
    la runde: heiltall = 0
    mens ikkje builtin.contains(s, "\n") og builtin.contains(s, "\\n") og runde < 3 {
        s = tekst_erstatt(s, "\\\\", "\\")
        s = tekst_erstatt(s, "\\r", "\r")
        s = tekst_erstatt(s, "\\n", "\n")
        s = tekst_erstatt(s, "\\\"", "\"")
        s = tekst_erstatt(s, "\\t", "\t")
        runde = runde + 1
    }
    returner s
}

funksjon køyr_serve(reqs: liste_tekst) -> tekst {
    la info = builtin.system_info()
    la runtime = tekst(info["executable"])
    la root = tekst(info["cwd"])
    la req = process_abi.request(runtime, [], root, "", 600000, 33554432)
    process_abi.sett_sandbox(req, "none", 4294967296, 1024, usann)
    process_abi.sett_environment(req, serve_miljø(root, saman(reqs)))
    la res = builtin.process_spawn_argv(req)
    la ut = normaliser(tekst(res["stdout"]))
    hvis tekst(res["status"]) != "ferdig" eller heltall_fra_tekst(tekst(res["exit_code"])) != 0 {
        skriv("nc serve feila: status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) + "\n")
        skriv("stdout:\n" + ut + "\nstderr:\n" + tekst(res["stderr"]) + "\n")
        assert(usann)
    }
    returner ut
}

// Del utdata i HTTP-svar. Kvart svar: {"status", "body", "h:<namn>" (siste verdi),
// "n:<namn>" (tal på linjer med det headernamnet), "a:<namn>" (alle verdiar,
// skilde med « | »)}; namn med små bokstavar.
funksjon tolk_svar(ut: tekst) -> liste {
    la svar = []
    la rest = ut
    la p = builtin.index_of(rest, "HTTP/1.1 ")
    mens p >= 0 {
        rest = builtin.slice(rest, p, lengde(rest))
        la skil = "\r\n\r\n"
        la slutt = builtin.index_of(rest, skil)
        hvis slutt < 0 {
            skil = "\n\n"
            slutt = builtin.index_of(rest, skil)
        }
        hvis slutt < 0 {
            skriv("uferdig svar i utdata:\n" + rest + "\n")
            assert(usann)
        }
        la hovud = builtin.slice(rest, 0, slutt)
        la linjer = builtin.split(hovud, "\n")
        la s: ordbok_tekst = {}
        la statuslinje = builtin.trim(linjer[0])
        s["status"] = builtin.slice(statuslinje, 9, 12)
        la i: heiltall = 1
        mens i < lengde(linjer) {
            la l = builtin.trim(linjer[i])
            la k = builtin.index_of(l, ":")
            hvis k > 0 {
                la namn = tekst_til_liten(builtin.trim(builtin.slice(l, 0, k)))
                la verdi = builtin.trim(builtin.slice(l, k + 1, lengde(l)))
                s["h:" + namn] = verdi
                la tidlegare: heiltall = 0
                hvis finnes_nøkkel(s, "n:" + namn) {
                    tidlegare = heltall_fra_tekst(s["n:" + namn])
                    s["a:" + namn] = s["a:" + namn] + " | " + verdi
                } ellers {
                    s["a:" + namn] = verdi
                }
                s["n:" + namn] = tekst(tidlegare + 1)
            }
            i = i + 1
        }
        la kropp_start = slutt + lengde(skil)
        la cl: heiltall = 0
        hvis finnes_nøkkel(s, "h:content-length") { cl = heltall_fra_tekst(s["h:content-length"]) }
        s["body"] = builtin.slice(rest, kropp_start, kropp_start + cl)
        legg_til(svar, s)
        rest = builtin.slice(rest, kropp_start + cl, lengde(rest))
        p = builtin.index_of(rest, "HTTP/1.1 ")
    }
    returner svar
}

funksjon hdr(s: ordbok_tekst, namn: tekst) -> tekst {
    hvis finnes_nøkkel(s, "h:" + namn) { returner s["h:" + namn] }
    returner ""
}

funksjon hdr_tal(s: ordbok_tekst, namn: tekst) -> heiltall {
    hvis finnes_nøkkel(s, "n:" + namn) { returner heltall_fra_tekst(s["n:" + namn]) }
    returner 0
}

funksjon hdr_alle(s: ordbok_tekst, namn: tekst) -> tekst {
    hvis finnes_nøkkel(s, "a:" + namn) { returner s["a:" + namn] }
    returner ""
}

funksjon inneheld(t: tekst, nål: tekst) -> boolsk {
    returner builtin.index_of(t, nål) >= 0
}

// 422 i FastAPI-formatet {"detail":[{"type","loc","msg","input"}]}.
funksjon er_422(s: ordbok_tekst) -> heiltall {
    assert_eq(s["status"], "422")
    assert(web.json_er_gyldig(s["body"]))
    la d = builtin.json_parse_raw(s["body"])
    assert(finnes_nøkkel(d, "detail"))
    assert_eq(lengde(d["detail"]), 1)
    returner 0
}

funksjon start() -> heiltall {
    la reqs: liste_tekst = [
        get("/merka", []),
        get("/openapi.json", []),
        get("/docs", []),
        førespurnad("POST", "/json", ["Content-Type: application/json"], "{\"a\":1}"),
        førespurnad("POST", "/json", ["Content-Type: application/json"], "{ikkje json"),
        førespurnad("POST", "/json", ["Content-Type: text/plain"], "{\"a\":1}"),
        get("/qint?n=42", []),
        get("/qint?n=abc", []),
        get("/qint", []),
        get("/kaker", []),
        get("/qliste?t=a&t=b&s=%C3%A6+x", []),
        get("/qliste?t=a,b,c&s=1&s=2", []),
        get("/straum", []),
        get("/jsonl", [])
    ]
    la ut = køyr_serve(reqs)
    la svar = tolk_svar(ut)
    hvis lengde(svar) != lengde(reqs) {
        skriv("venta " + tekst(lengde(reqs)) + " svar, fekk " + tekst(lengde(svar)) + ":\n" + ut + "\n")
    }
    assert_eq(lengde(svar), lengde(reqs))

    // 0: FA-097 — web.tags("varer") krasjar ikkje handlaren.
    assert_eq(svar[0]["status"], "200")
    assert_eq(svar[0]["body"], "merka")

    // 1: OpenAPI med markørane.
    assert_eq(svar[1]["status"], "200")
    la oa = svar[1]["body"]
    assert(web.json_er_gyldig(oa))
    la p = builtin.json_parse_raw(oa)
    la paths = p["paths"]
    assert(ikkje finnes_nøkkel(paths, "/skjult"))
    la op = paths["/merka"]["get"]
    assert_eq(tekst(op["tags"][0]), "varer")
    assert_eq(tekst(op["description"]), "Hent merka")
    assert_eq(tekst(op["deprecated"]), "sann")
    assert(finnes_nøkkel(op["responses"], "404"))
    assert_eq(tekst(op["responses"]["404"]["description"]), "Ikkje funne")

    // 2: docs_side les dei same markørane (skjul, tag, beskriving, forelda, respons).
    assert_eq(svar[2]["status"], "200")
    la dok = svar[2]["body"]
    assert(inneheld(dok, "<code>/merka</code>"))
    assert(ikkje inneheld(dok, "/skjult"))
    assert(inneheld(dok, "<h2>varer</h2>"))
    assert(inneheld(dok, "Hent merka"))
    assert(inneheld(dok, "<em class=\"forelda\">"))
    assert(inneheld(dok, "<strong>404</strong> Ikkje funne"))

    // 3–8: 422 i staden for 500.
    assert_eq(svar[3]["status"], "200")
    assert(inneheld(svar[3]["body"], "\"a\":1"))
    er_422(svar[4])
    assert(inneheld(svar[4]["body"], "json_invalid"))
    er_422(svar[5])
    assert_eq(svar[6]["status"], "200")
    assert_eq(svar[6]["body"], "{\"n\":42}")
    er_422(svar[7])
    er_422(svar[8])

    // 9: FA-063 — to response_set_cookie → to Set-Cookie-linjer (ikkje overskrive).
    assert_eq(svar[9]["status"], "200")
    assert_eq(hdr_tal(svar[9], "set-cookie"), 2)
    assert_eq(hdr_alle(svar[9], "set-cookie"), "a=1; HttpOnly; Secure; SameSite=Lax | b=2; Max-Age=60; Path=/; HttpOnly; Secure; SameSite=Lax")

    // 10–11: FA-018 — request_query_list gjev alle verdiar; skalar = siste.
    assert_eq(svar[10]["status"], "200")
    assert_eq(svar[10]["body"], "{\"t\":[\"a\",\"b\"],\"s\":\"æ x\"}")
    assert_eq(svar[11]["body"], "{\"t\":[\"a\",\"b\",\"c\"],\"s\":\"2\"}")

    // 12–13: FA-066/067 — strøyming gav tom kropp, tom content-type og
    // «Transfer-Encoding: chunked» saman med Content-Length.
    assert_eq(svar[12]["status"], "200")
    assert_eq(svar[12]["body"], "abcdefgh")
    assert_eq(hdr(svar[12], "content-type"), "text/plain; charset=utf-8")
    assert_eq(hdr_tal(svar[12], "transfer-encoding"), 0)
    assert_eq(svar[13]["body"], "{\"a\":1}\n{\"b\":\"x\"}\n")
    assert_eq(hdr(svar[13], "content-type"), "application/x-ndjson")

    skriv("test_fastapi_hol_serve OK\n")
    returner 0
}
