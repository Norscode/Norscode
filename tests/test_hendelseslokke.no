# M7 (grunnmur) — kooperativ event loop. Akseptkriterium: to «asynk»-oppgåver
# med sov fullfører på virtuell tid ≈ maks, IKKJE sum. Data-driven, seed-rask.

bruk std.hendelseslokke som lokke

funksjon start() -> heiltall {
    # To oppgåver: søv 100 og søv 150, køyrde samtidig.
    la a = lokke.sov_oppgåve(100, "a")
    la b = lokke.sov_oppgåve(150, "b")
    la res = lokke.køyr_alle([a, b])

    # Samtidig: sluttid = maks(100,150) = 150, IKKJE sum (250).
    assert(res["tid"] == 150)
    assert(lengde(res["ferdige"]) == 2)
    # Fullføringsrekkefølgje følgjer vekketid: a (100) før b (150).
    assert(res["ferdige"][0] == "a")
    assert(res["ferdige"][1] == "b")

    # Tre oppgåver: maks-tid, ikkje sum.
    la res3 = lokke.køyr_alle([
        lokke.sov_oppgåve(50, "x"),
        lokke.sov_oppgåve(200, "y"),
        lokke.sov_oppgåve(120, "z")
    ])
    assert(res3["tid"] == 200)
    assert(res3["ferdige"][0] == "x")
    assert(res3["ferdige"][1] == "z")
    assert(res3["ferdige"][2] == "y")

    # Race: den kortaste vinn, på si eiga tid.
    la vinn = lokke.køyr_først([
        lokke.sov_oppgåve(300, "treig"),
        lokke.sov_oppgåve(40, "rask")
    ])
    assert(vinn["merke"] == "rask")
    assert(vinn["tid"] == 40)

    # med_timeout: oppgåva rekk fristen → ikkje tidsavbrot
    la ok = lokke.med_timeout(lokke.sov_oppgåve(60, "jobb"), 100)
    assert(ikkje ok["tidsavbrot"])
    assert(ok["merke"] == "jobb")
    assert(ok["tid"] == 60)

    # med_timeout: oppgåva er for treig → tidsavbrot på fristen
    la avbrot = lokke.med_timeout(lokke.sov_oppgåve(500, "jobb"), 100)
    assert(avbrot["tidsavbrot"])
    assert(avbrot["tid"] == 100)

    skriv("test_hendelseslokke OK\n")
    returner 0
}
