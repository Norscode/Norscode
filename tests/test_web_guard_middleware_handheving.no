bruk std.tekst som t

// Regresjonstest for tryggleikshòlet der `use_guard("namn")` såg ut til å verne
// ei rute utan å verne noko. To uavhengige feil måtte begge fiksast:
//
//  1) ir_to_bytecode: `web.guard()` er PARAMETERLAUS, men sjekken låg NEDANFOR
//     «hvis ikkje har_args → bryt». Den var difor daud kode, og guard-provideren
//     vart aldri registrert (guard_providers stod tom).
//  2) serve_runner: dispatchen kalla handleren direkte og køyrde korkje
//     request_middleware eller guards.
//
// Testen sjekkar STRUKTUREN i kjelda, slik at han fangar regresjonen uavhengig
// av kva seed som er committa (kompilatorfiksen ligg inni seeden, så ein
// åtferdstest ville fyrst bli grøn etter seed-promotering).
funksjon start() -> heiltall {
    la ir = fil_les("selfhost/compiler/ir_to_bytecode.no")

    // (1) `.guard` MÅ handterast blant dei parameterlause annotasjonane, altså
    // FØR «hvis ikkje har_args / bryt». Elles er han daud kode igjen.
    la guard_idx = t.finn(ir, "tekst_ender_med(target_namn, \".guard\") og ikkje har_args")
    assert(guard_idx >= 0)
    la brytt_idx = t.finn(ir, "hvis ikkje har_args\n                bryt")
    assert(brytt_idx >= 0)
    assert(guard_idx < brytt_idx)

    // (2) serve_runner MÅ køyre middleware og guards før handleren.
    la sr = fil_les("selfhost/serve_runner.no")
    assert(t.inneholder(sr, "_sr_køyr_request_middleware"))
    assert(t.inneholder(sr, "_sr_køyr_guards"))
    assert(t.inneholder(sr, "_sr_guard_kart"))
    // Fail-closed: ukjend guard skal ALDRI sleppe førespurnaden vidare.
    assert(t.inneholder(sr, "ukjend guard: "))
    assert(t.inneholder(sr, "\"__status__\": 403"))
    // Kallet må skje før handleren blir slått opp.
    la mw_idx = t.finn(sr, "_sr_køyr_request_middleware(ncb, ctx)")
    la g_idx = t.finn(sr, "_sr_køyr_guards(ncb, item, ctx)")
    la h_idx = t.finn(sr, "la handler = tekst(item[\"function\"])")
    assert(mw_idx >= 0 og g_idx >= 0 og h_idx >= 0)
    assert(mw_idx < h_idx)
    assert(g_idx < h_idx)

    skriv("test_web_guard_middleware_handheving OK\n")
    returner 0
}
