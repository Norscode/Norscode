// Regresjon (Java-paritet F40): std.collections.
//  - defaultdict: ny_standardordbok brukte engelsk `return`, så std_hent gav
//    tom/feil verdi (VM: «Ukjent variabel: return»).
//  - ordreordbok (LinkedHashMap/OrderedDict) utan JSON: rekkjefølgja låg som
//    JSON-tekst (O(n) per operasjon, og json_parse("[]") knekte på VM-en).
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.collections som coll

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon lj(l) -> tekst {
    la r = ""
    for x i l { r = r + tekst(x) + "," }
    returner r
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]

    // defaultdict
    la d = coll.ny_standardordbok("0")
    sjekk(feil, "std_hent manglar", coll.std_hent(d, "manglar"), "0")
    coll.std_set(d, "tal", "5")
    sjekk(feil, "std_hent sett", coll.std_hent(d, "tal"), "5")
    sjekk(feil, "std_nøklar", lj(coll.std_nøklar(d)), "manglar,tal,")

    // ordreordbok: innsetjingsrekkjefølgje, oppdatering flyttar ikkje
    la o = coll.ny_ordreordbok()
    coll.ord_set(o, "b", "2")
    coll.ord_set(o, "a", "1")
    coll.ord_set(o, "c", "3")
    coll.ord_set(o, "a", "10")
    sjekk(feil, "ord_nøklar", lj(coll.ord_nøklar(o)), "b,a,c,")
    sjekk(feil, "ord_verdiar", lj(coll.ord_verdiar(o)), "2,10,3,")
    sjekk(feil, "ord_storleik", tekst(coll.ord_storleik(o)), "3")
    sjekk(feil, "ord_har", tekst(coll.ord_har(o, "a")) + tekst(coll.ord_har(o, "q")), "sannusann")
    sjekk(feil, "utan JSON-rekkjefølgje", tekst(har_nokkel(o, "_rekkefølge")), "usann")

    // flytt_sist / flytt_fremst (move_to_end)
    coll.ord_flytt_sist(o, "b")
    sjekk(feil, "flytt_sist", lj(coll.ord_nøklar(o)), "a,c,b,")
    coll.ord_flytt_fremst(o, "c")
    sjekk(feil, "flytt_fremst", lj(coll.ord_nøklar(o)), "c,a,b,")
    coll.ord_flytt_sist(o, "finst_ikkje")
    sjekk(feil, "flytt ukjend", lj(coll.ord_nøklar(o)), "c,a,b,")
    sjekk(feil, "første/siste", coll.ord_første(o) + coll.ord_siste(o), "cb")

    // slett i midten, først og sist
    coll.ord_slett(o, "a")
    sjekk(feil, "slett midten", lj(coll.ord_nøklar(o)), "c,b,")
    coll.ord_set(o, "d", "4")
    coll.ord_slett(o, "c")
    sjekk(feil, "slett først", lj(coll.ord_nøklar(o)) + coll.ord_første(o), "b,d,b")
    coll.ord_slett(o, "d")
    sjekk(feil, "slett sist", lj(coll.ord_nøklar(o)) + coll.ord_siste(o), "b,b")
    coll.ord_slett(o, "b")
    sjekk(feil, "tom", lj(coll.ord_nøklar(o)) + tekst(coll.ord_storleik(o)), "0")
    coll.ord_set(o, "x", "9")
    sjekk(feil, "etter tom", lj(coll.ord_nøklar(o)), "x,")

    // par og popitem
    coll.ord_set(o, "y", "8")
    la par = coll.ord_par(o)
    sjekk(feil, "ord_par", par[0][0] + "=" + par[0][1] + ";" + par[1][0] + "=" + par[1][1], "x=9;y=8")
    la sist = coll.ord_pop_siste(o)
    sjekk(feil, "pop_siste", sist[0] + sist[1] + lj(coll.ord_nøklar(o)), "y8x,")
    la først = coll.ord_pop_første(o)
    sjekk(feil, "pop_første", først[0] + først[1] + tekst(coll.ord_storleik(o)), "x90")
    sjekk(feil, "pop tom", tekst(lengde(coll.ord_pop_siste(o))), "0")

    // LRU-mønster: 200 nøklar, flytt kvar tredje sist
    la lru = coll.ny_ordreordbok()
    la i = 0
    mens i < 200 {
        coll.ord_set(lru, "k" + tekst(i), tekst(i))
        i = i + 1
    }
    i = 0
    mens i < 200 {
        coll.ord_flytt_sist(lru, "k" + tekst(i))
        i = i + 3
    }
    la nk = coll.ord_nøklar(lru)
    sjekk(feil, "lru lengde", tekst(lengde(nk)), "200")
    sjekk(feil, "lru første/siste", nk[0] + "," + nk[199], "k1,k198")

    hvis feil[0] == 0 { skriv("test_collections_java_paritet OK\n") }
    returner feil[0]
}
