# Fase 2a / 2.7: http_response-serialisering.
# Køyrer mot KJELDE-kompilert selfhost.http_response (hybrid-bundle-kjede).
# Dekkjer: full statustabell, CRLF-strip (response-splitting), Content-Length-
# dedup, Set-Cookie som liste.

bruk selfhost.http_response som hr

funksjon tel(haystack: tekst, needle: tekst) -> heiltall {
    returner lengde(builtin.split(haystack, needle)) - 1
}

funksjon må_ha(haystack: tekst, needle: tekst, melding: tekst) {
    hvis builtin.index_of(haystack, needle) < 0 {
        kast "FEIL (" + melding + "): mangla «" + needle + "» i:\n" + haystack
    }
}

funksjon må_ikkje_ha(haystack: tekst, needle: tekst, melding: tekst) {
    hvis builtin.index_of(haystack, needle) >= 0 {
        kast "FEIL (" + melding + "): fann uønskt «" + needle + "» i:\n" + haystack
    }
}

funksjon start() -> heiltall {
    # (a) Full statustabell — 422 skal ha rett tekst (var berre "OK" før).
    la r422 = hr.response_to_http({"status": 422, "body": "x"})
    må_ha(r422, "HTTP/1.1 422 Unprocessable Content", "status 422")

    la r301 = hr.response_to_http({"status": 301, "body": "x", "location": "/ny"})
    må_ha(r301, "HTTP/1.1 301 Moved Permanently", "status 301")

    la r429 = hr.response_to_http({"status": 429, "body": "x"})
    må_ha(r429, "HTTP/1.1 429 Too Many Requests", "status 429")

    # (b) CRLF-strip: eit header-verdi med CR/LF skal ikkje injisere nye linjer.
    la rcrlf = hr.response_to_http({"status": 200, "body": "ok",
        "headers": {"X-Test": "ond\r\nInjected: evil"}})
    må_ha(rcrlf, "X-Test: ondInjected: evil", "CRLF stripa i header-verdi")
    må_ikkje_ha(rcrlf, "\r\nInjected: evil", "ingen injisert header-linje")

    # (c) Content-Length-dedup: brukar-sett Content-Length i headers skal ikkje
    # duplisere den utrekna.
    la rcl = hr.response_to_http({"status": 200, "body": "hei",
        "headers": {"Content-Length": "999"}})
    assert_eq(tekst_fra_heiltall(tel(rcl, "Content-Length:")), "1")
    må_ha(rcl, "Content-Length: 3", "utrekna Content-Length")
    må_ikkje_ha(rcl, "Content-Length: 999", "brukar-sett Content-Length undertrykt")

    # (d) Set-Cookie som liste → éin header-linje per element.
    la rsc = hr.response_to_http({"status": 200, "body": "x",
        "set_cookie": ["a=1; Path=/", "b=2; Path=/"]})
    assert_eq(tekst_fra_heiltall(tel(rsc, "Set-Cookie:")), "2")
    må_ha(rsc, "Set-Cookie: a=1; Path=/", "fyrste cookie")
    må_ha(rsc, "Set-Cookie: b=2; Path=/", "andre cookie")

    # Set-Cookie som enkel tekst skal framleis gje éi linje.
    la rsc1 = hr.response_to_http({"status": 200, "body": "x", "set_cookie": "c=3"})
    assert_eq(tekst_fra_heiltall(tel(rsc1, "Set-Cookie:")), "1")

    skriv("test_fase2a_http_response OK\n")
    returner 0
}
