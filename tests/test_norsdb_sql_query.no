// Fase 4b: utvida SELECT — ORDER BY / LIMIT / OFFSET, LIKE / NOT LIKE, IN, BETWEEN.
// Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')")

    // ORDER BY + LIMIT/OFFSET
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk ORDER BY alder ASC"), "Bjørn\nAda\nAlan\nLinus")
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk ORDER BY alder DESC LIMIT 2"), "Linus\nAlan")
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk ORDER BY alder ASC LIMIT 2 OFFSET 1"), "Ada\nAlan")

    // LIKE / NOT LIKE
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE navn LIKE 'A%'"), "Ada\nAlan")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE navn NOT LIKE 'A%'"), 2)

    // BETWEEN
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE alder BETWEEN 30 AND 45"), 2)

    // IN
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE alder IN (29, 55)"), "Linus\nBjørn")

    // WHERE + ORDER kombinert
    assert_eq(sql.query_rader(db, "SELECT navn, alder FROM folk WHERE alder > 40 ORDER BY alder ASC"), "Alan|41\nLinus|55")

    returner 0
}
