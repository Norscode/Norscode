bruk std.argon2id_pure som a
bruk std.blake2b som b

funksjon fyll(verdi: heiltall, tal: heiltall) -> liste_heiltall {
    la out: liste_heiltall = []
    la i: heiltall = 0
    mens i < tal { legg_til(out,verdi) i = i + 1 }
    returner out
}

funksjon start() -> heiltall {
    la h0 = a.test_h0(fyll(1,32), fyll(2,16), fyll(3,8), fyll(4,12), 32,3,4,32)
    assert(h0 == "2889de487eb42ae500c0007ed9252f1069eadec40d5765b485de6dc2437a67b8546a2f0acc1a0882db8fcf74714b472e94df421a5da1112ffa11434370a1e997")
    la actual = b.hex_bytes(a.hash_bytes_utvida(
        fyll(1,32), fyll(2,16), fyll(3,8), fyll(4,12), 32,3,4,32))
    assert(actual == "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659")
    assert(a.konstanttid_lik(actual, "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"))
    assert(ikkje a.konstanttid_lik(actual, "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e658"))
    assert(a.status()["standard"] == "RFC 9106")
    skriv("test_argon2id_rfc9106_pure OK")
    returner 0
}
