# TLS 1.3 nøkkelplan (RFC 8446 §7) - RFC 8448-vektorar.
bruk std.tls13_keyschedule som ks
funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
funksjon _hex(b: liste_heiltall) -> tekst { la ut = "" la i = 0 mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 } returner ut }
funksjon start() -> heiltall {
    la es = ks.early_secret([])
    assert_eq(_hex(es), "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    la derived = ks.derive_secret(es, "derived", ks.transcript_hash([]))
    assert_eq(_hex(derived), "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    assert_eq(ks.status()["abi"], "norscode-tls13-keyschedule-v1")
    skriv("test_tls13_keyschedule_rfc8448 OK")
    returner 0
}
