# Regresjon for tools/pkg_kjerne: (1) norscode.lock blir skriven først etter vellukka installasjon,
# (2) HTTP-svar med Transfer-Encoding: chunked blir dekoda. Rein filbasert test, ingen nett.
bruk tools.pkg_kjerne som pk
bruk std.filops som fo

la W = "build/test_pkg_lock_arbeid"

funksjon feilmelding(f) -> tekst {
    prøv { f() } fang (e) { returner tekst(e) }
    returner "INGEN_FEIL"
}

funksjon skriv_pakke(mappe: tekst, versjon: tekst) {
    fo.slett_tre(mappe)
    fo.lag_katalogar(mappe)
    fil_skriv(mappe + "/norcode.toml", "[project]\nname = \"b\"\nversion = \"" + versjon + "\"\n\n[dependencies]\n")
    fil_skriv(mappe + "/rot.no", "funksjon f() -> heiltall { returner " + versjon_tal(versjon) + " }\n")
}

funksjon versjon_tal(v: tekst) -> tekst {
    hvis v == "1.0.0" { returner "1" }
    returner "2"
}

funksjon test_lock_etter_installasjon() {
    fo.slett_tre(W)
    fo.lag_katalogar(W)
    la reg = W + "/register"
    la app = W + "/app"
    skriv_pakke(W + "/src_b", "1.0.0")
    pk.pkg_publiser(W + "/src_b", reg)
    la gyldig = fil_les(reg + "/arkiv/b-1.0.0.nka")
    pk.pkg_init(app, "min_app")
    fil_skriv(app + "/norcode.toml", "[project]\nname = \"min_app\"\nversion = \"0.1.0\"\nentry = \"app.no\"\n\n[dependencies]\nb = \"^1.0.0\"\n")
    # Øydelagt arkiv: installasjon feilar, ingen norscode.lock blir skriven.
    fil_skriv(reg + "/arkiv/b-1.0.0.nka", gyldig + "x")
    assert(builtin.contains(feilmelding(fun() { pk.pkg_installer(app, reg, usann, usann, "") }), "sjekksumfeil"))
    assert(ikkje fo.fil_finnes(app + "/norscode.lock"))
    # Reparert: lock blir skriven.
    fil_skriv(reg + "/arkiv/b-1.0.0.nka", gyldig)
    pk.pkg_installer(app, reg, usann, usann, "")
    assert(fo.fil_finnes(app + "/norscode.lock"))
    la lock1 = fil_les(app + "/norscode.lock")
    # Ny utgjeving 1.1.0 med øydelagt arkiv: oppdatering feilar, gammal lock er intakt.
    skriv_pakke(W + "/src_b", "1.1.0")
    pk.pkg_publiser(W + "/src_b", reg)
    fil_skriv(reg + "/arkiv/b-1.1.0.nka", "øydelagt")
    assert(feilmelding(fun() { pk.pkg_installer(app, reg, usann, sann, "") }) != "INGEN_FEIL")
    assert_eq(fil_les(app + "/norscode.lock"), lock1)
}

funksjon test_chunked() {
    la hovud = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\n\r\n"
    la r1 = pk.http_svar_tolk(hovud + "5\r\nHello\r\n7\r\n, World\r\n0\r\n\r\n")
    assert_eq(r1["status"], 200)
    assert_eq(r1["body"], "Hello, World")
    # Hex med store bokstavar, chunk-extension og trailer
    la r2 = pk.http_svar_tolk(hovud + "A;ext=1\r\n0123456789\r\n0\r\nX-Trailer: v\r\n\r\n")
    assert_eq(r2["body"], "0123456789")
    # Heiltal-kropp som inneheld CRLF og tekst som liknar chunk-storleik
    la r3 = pk.http_svar_tolk(hovud + "9\r\na\r\n5\r\nxyz\r\n0\r\n\r\n")
    assert_eq(r3["body"], "a\r\n5\r\nxyz")
    # Hovudnamn er case-insensitive
    la r4 = pk.http_svar_tolk("HTTP/1.1 200 OK\r\ntransfer-encoding: Chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n")
    assert_eq(r4["body"], "abc")
    # Avkorta / ugyldig chunk-straum gir status 0
    assert_eq(pk.http_svar_tolk(hovud + "ff\r\nkort\r\n")["status"], 0)
    assert_eq(pk.http_svar_tolk(hovud + "zz\r\nkort\r\n0\r\n\r\n")["status"], 0)
    # Content-Length og lukk-til-slutt er urørt
    la r5 = pk.http_svar_tolk("HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n5\r\nabc\r\n")
    assert_eq(r5["body"], "5\r\nabc\r\n")
    la r6 = pk.http_svar_tolk("HTTP/1.1 404 Not Found\r\n\r\nfinst ikkje")
    assert_eq(r6["status"], 404)
    assert_eq(r6["body"], "finst ikkje")
}

funksjon test_content_length_validering() {
    assert(pk.content_length_gyldig("0"))
    assert(pk.content_length_gyldig("12345"))
    assert(ikkje pk.content_length_gyldig("abc"))
    assert(ikkje pk.content_length_gyldig("-5"))
    assert(ikkje pk.content_length_gyldig("12x"))
    assert(ikkje pk.content_length_gyldig(""))
    assert(ikkje pk.content_length_gyldig("99999999999999999999"))
}

funksjon start() -> heiltall {
    test_chunked()
    test_content_length_validering()
    test_lock_etter_installasjon()
    skriv("test_pkg_lock_chunked OK\n")
    returner 0
}
