bruk std.tekst som t

funksjon start() -> heiltall {
    la vm = fil_les("selfhost/vm.no")
    la overgang = fil_les("archive/legacy_c_backend/nc_native_main.c")
    assert(t.inneholder(vm, "builtin.vent.sov(args[0])"))
    assert(t.inneholder(overgang, "fn_r=nc_builtin_vent_sov"))

    la start_ms = builtin.tid_ms()
    builtin.vent.sov(20)
    la brukt_ms = builtin.tid_ms() - start_ms
    assert(brukt_ms >= 10)
    assert(brukt_ms < 2000)
    skriv("test_vm_vent_sleep OK\n")
    returner 0
}
