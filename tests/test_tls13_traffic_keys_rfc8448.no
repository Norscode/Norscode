# RFC 8448 trafikk-nøkkel-KAT: verifiserer at record-laget si AES-128-GCM-
# nøkkelutleiing (write_key OG write_iv) matchar RFC 8448 "Simple 1-RTT Handshake"
# for BÅDE handshake- og applikasjonstrafikk, klient og tenar.
#
# Hòl som dette tettar: test_tls13_differential_kat sjekkar berre IV-en
# (suite-uavhengig, 12 byte). Den suite-avhengige 16-byte AEAD-nøkkelen
# (TLS_AES_128_GCM_SHA256) var ikkje verifisert mot RFC-fasit nokon stad.
# Vektorane under er dei kanoniske RFC 8448-verdiane.
bruk std.tls13_record som rec

funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
funksjon _hex(b: liste_heiltall) -> tekst { la ut = "" la i = 0 mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 } returner ut }
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}

# Sjekk at traffic_keys_aesgcm(secret) gjev nett forventa key/iv (RFC 8448).
funksjon _sjekk(namn: tekst, secret_hex: tekst, key_hex: tekst, iv_hex: tekst) {
    la tk = rec.traffic_keys_aesgcm(_b(secret_hex))
    assert_eq(lengde(tk["key"]), 16)
    assert_eq(lengde(tk["iv"]), 12)
    assert_eq(_hex(tk["key"]), key_hex)
    assert_eq(_hex(tk["iv"]), iv_hex)
}

funksjon start() -> heiltall {
    # --- Handshake-trafikk (RFC 8446 §7.3, RFC 8448 §3) ---
    _sjekk("c_hs",
        "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21",
        "dbfaa693d1762c5b666af5d950258d01", "5bd3c71b836e0b76bb73265f")
    _sjekk("s_hs",
        "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38",
        "3fce516009c21727d0f2e4e86ee403bc", "5d313eb2671276ee13000b30")

    # --- Applikasjonstrafikk (RFC 8446 §7.2, RFC 8448 §3) ---
    _sjekk("c_ap",
        "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5",
        "17422dda596ed5d9acd890e3c63f5051", "5b78923dee08579033e523d9")
    _sjekk("s_ap",
        "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643",
        "9f02283b6c9c07efc26bb9f2ac92e356", "cf782b88dd83549aadf1e984")

    # --- Ende-til-ende: krypter/dekrypter ein post med dei EKTE RFC 8448-
    #     tenar-handshake-nøklane. Verifiserer at AEAD-integrasjonen held
    #     med nett den nøkkelen RFC 8448 publiserer. ---
    la stk = rec.traffic_keys_aesgcm(_b("b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38"))
    la melding = _b("140000201122334455667788")
    la post = rec.krypter_post_aesgcm(stk["key"], stk["iv"], 0, 22, melding)
    la d = rec.dekrypter_post_aesgcm(stk["key"], stk["iv"], 0, post)
    assert_eq(d["status"], "ok")
    assert_eq(d["type"], 22)
    assert_eq(_hex(d["plaintext"]), _hex(melding))
    # Feil seq -> feil nonce -> AEAD-verifisering feilar (fail-closed).
    assert_eq(rec.dekrypter_post_aesgcm(stk["key"], stk["iv"], 1, post)["status"], "feil")

    skriv("test_tls13_traffic_keys_rfc8448 OK")
    returner 0
}
