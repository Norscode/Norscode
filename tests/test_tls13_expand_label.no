bruk std.tls13_keyschedule som ks
bruk std.hkdf som hkdf

// Kjent-svar-test: TLS 1.3 HKDF-Expand-Label (RFC 8446 §7.1).
//
// expand_label(secret, label, context, len) = HKDF-Expand(secret, HkdfLabel, len)
// der HkdfLabel = uint16(len) || uint8(len("tls13 "+label)) || "tls13 "+label
//                || uint8(len(context)) || context.
// Denne var kun transitivt dekt (via derive_secret i RFC 8448-flyten). Her
// konstrueres HkdfLabel FOR HÅND byte-for-byte fra RFC-spec, og resultatet
// kryss-sjekkes mot den RFC 5869-verifiserte std.hkdf.expand — en uavhengig
// verifisering av at label-encodingen er korrekt.

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la s = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(s, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(s, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon _rep(v: heiltall, n: heiltall) -> liste_heiltall {
    la u: liste_heiltall = []
    la i = 0
    mens i < n { legg_til(u, v) i = i + 1 }
    returner u
}

funksjon start() -> heiltall {
    la secret = _rep(11, 32)

    // label="key", context=[], len=16.
    // HkdfLabel = 00 10 | 09 | "tls13 key" | 00
    la key_label = [0, 16, 9, 116, 108, 115, 49, 51, 32, 107, 101, 121, 0]
    la key_uavhengig = _hex(hkdf.expand(secret, key_label, 16))
    assert(_hex(ks.expand_label(secret, "key", [], 16)) == key_uavhengig)
    assert(_hex(ks.expand_label(secret, "key", [], 16)) == "4ae137372e8502a12c7248420cf5a932")

    // label="derived", context=[0xAA,0xBB], len=32 (tester context-lengdeprefiks).
    // HkdfLabel = 00 20 | 0d | "tls13 derived" | 02 AA BB
    la der_label = [0, 32, 13, 116, 108, 115, 49, 51, 32, 100, 101, 114, 105, 118, 101, 100, 2, 170, 187]
    la der_uavhengig = _hex(hkdf.expand(secret, der_label, 32))
    assert(_hex(ks.expand_label(secret, "derived", [170, 187], 32)) == der_uavhengig)

    // Derive-Secret(secret, label, thash) = Expand-Label(secret, label, thash, 32).
    assert(_hex(ks.derive_secret(secret, "derived", [170, 187]))
        == _hex(ks.expand_label(secret, "derived", [170, 187], 32)))

    skriv("test_tls13_expand_label: OK\n")
    returner 0
}
