# W0–W4 (WASM-sporet): lastaren blir emittert frå Norscode-data, ikkje frå ein handskriven mal.
#
# Sjekkane står i tests/fixtures/wasm_lastar_sjekk.no (byte-tak, tree-shaking, importnamn
# = importseksjonen, struktur frå vertstabellen, ingen JS-malar i kjeldene, proveniens for
# kvart lastartoken, tryggleik, W4-hjelparane og presedens). Dei køyrer i ein barneprosess
# i VM-fastmodus, som CLI-en og korpuset gjer: i standard-VM-en tek emitteringa og
# tokeniseringa av dei fulle lastarane om lag 3 minutt. Testen krev exit 0 og OK-linja, og
# skriv ut storleikane.
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon start() -> heltall {
    la rot = hjelp.root()
    la m = hjelp.grunnmiljø(rot)
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = rot + "/tests/fixtures/wasm_lastar_sjekk.no"
    m["NORSCODE_VM_FAST"] = "1"
    m["NC_WASM_RT_CACHE"] = ""
    la r = hjelp.køyr_nc(m, 600000)
    la ut = r["stdout"]
    hvis r["status"] != "ferdig" eller r["exit"] != 0 eller builtin.index_of(ut, "wasm_lastar_sjekk OK") < 0 {
        skriv("wasm_lastar_sjekk feila: status=" + r["status"] + " exit=" + tekst(r["exit"]) + "\n" + ut + "\n" + r["stderr"] + "\n")
        assert(usann)
    }
    la linjer = builtin.split(ut, "\n")
    la i = 0
    mens i < lengde(linjer) {
        hvis builtin.starts_with(linjer[i], "lastar: ") { skriv(linjer[i] + "\n") }
        i = i + 1
    }
    skriv("test_wasm_lastar OK\n")
    returner 0
}
