// Fase 1: LIKE og IN i WHERE. Golden-verdiar frå ekte sqlite3 3.51.0.
// LIKE: % = null/fleire teikn, _ = eitt teikn, case-insensitiv (ASCII).
// IN: medlemskap i ei verdiliste (tekst og tal), kombinerbar med AND/OR.

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")
    assert_eq(db.execute(h, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')"), 1)

    // ── LIKE ─────────────────────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE navn LIKE 'A%'"), 2)   // Ada, Alan
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE navn LIKE 'a%'"), 2)   // case-insensitiv
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE navn LIKE '%n'"), 2)   // Alan, Bjørn
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE navn LIKE '_da'"), "Ada")
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE navn LIKE '%li%'"), 1) // Linus

    // ── IN ───────────────────────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by IN ('Oslo', 'Bergen')"), 4)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by IN ('Bergen')"), 1)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE alder IN (37, 55)"), 2)
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE alder IN (29)"), "Bjørn")

    // ── IN kombinert med AND ─────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by IN ('Oslo') AND alder > 40"), 2)

    assert(db.close(h))
    returner 0
}
