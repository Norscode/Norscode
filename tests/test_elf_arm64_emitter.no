bruk selfhost.native_execution.elf_arm64_emitter som elf

funksjon start() -> heiltall {
    // mov w0,#7; ret
    la image = elf.bygg_program([0xE0, 0x00, 0x80, 0x52, 0xC0, 0x03, 0x5F, 0xD6])
    assert(lengde(image) > 4096)
    assert_eq(image[0], 0x7F)
    assert_eq(image[1], 0x45)
    assert_eq(image[2], 0x4C)
    assert_eq(image[3], 0x46)
    assert_eq(image[18], 183)
    # _start-stubben reknar ut envp frå stakken (Linux ABI) FØR bl main, slik at
    # miljo_hent/NORSCODE_CMD virkar native (lagt til i #181, f7476ed). Fyrste
    # instruksjon på kode-offset er difor `ldr x0, [sp]` = 0xF94003E0
    # (little-endian: E0 03 40 F9), ikkje bl main.
    assert_eq(image[4096], 0xE0)
    assert_eq(image[4097], 0x03)
    assert_eq(image[4098], 0x40)
    assert_eq(image[4099], 0xF9)
    # bl main (0x94000003 → 03 00 00 94) ligg fire instruksjonar (16 byte) inn i
    # stubben, etter dei fire envp-oppsettinstruksjonane.
    assert_eq(image[4112], 0x03)
    assert_eq(image[4113], 0x00)
    assert_eq(image[4114], 0x00)
    assert_eq(image[4115], 0x94)
    returner 0
}
