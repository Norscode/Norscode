# Fase 2a / 2.10: kompilator route-metadata.
# Kompilerer ein snutt via KJELDE-kompilatoren (lexer→parser→semantic→
# bytecode_backend → ir_to_bytecode) og inspiserer route_handlers-JSON. Same
# lette veg som selfhost/tests/web_parity.no (unngår den tunge kompiler_fil-
# hybrid-reserialiseringa). Dekkjer:
#  (a) fleire web.route() per handler → éi route-oppføring kvar
#  (b) OpenAPI-markørar (tags/beskriving/respons)
#  (c) rekursiv skann: request_query inne i ein hvis-blokk vert fanga

bruk selfhost.lexer.lexer_m1
bruk selfhost.parser
bruk selfhost.semantic
bruk selfhost.bytecode_backend

funksjon ncb_for(kilde) {
    la tokens = lex(kilde)
    la ast = selfhost.parser.parse_program(tokens)
    la state = semantic_analyser(ast)
    hvis semantic_ok(state) == usann {
        kast semantic_rapport(state)
    }
    returner bytecode_kompiler(ast, "__main__")
}

funksjon tel_ruter(handlers, sti: tekst) -> heiltall {
    la n = 0
    la i = 0
    mens i < lengde(handlers) {
        hvis handlers[i]["path"] == sti { n = n + 1 }
        i = i + 1
    }
    returner n
}

funksjon finn_rute(handlers, metode: tekst, sti: tekst) {
    la i = 0
    mens i < lengde(handlers) {
        hvis handlers[i]["path"] == sti og builtin.lower(tekst(handlers[i]["method"])) == builtin.lower(metode) {
            returner handlers[i]
        }
        i = i + 1
    }
    returner null
}

funksjon liste_har(liste, verdi: tekst) -> boolsk {
    la i = 0
    mens i < lengde(liste) {
        hvis tekst(liste[i]) == verdi { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon start() -> heiltall {
    la kjelde = "bruk std.web som web\n" +
        "funksjon multi(ctx) -> tekst {\n" +
        "    web.route(\"GET /a\")\n" +
        "    web.route(\"POST /a\")\n" +
        "    web.tags(\"items\", \"admin\")\n" +
        "    web.beskriving(\"Multi-rute handler\")\n" +
        "    web.respons(\"404\", \"Ikkje funne\")\n" +
        "    hvis sann {\n" +
        "        la s = web.request_query_int(ctx, \"side\")\n" +
        "    }\n" +
        "    returner \"ok\"\n" +
        "}\n" +
        "funksjon start() -> tekst { returner \"ok\" }\n"

    la ncb = builtin.json_parse_raw(ncb_for(kjelde))
    la handlers = ncb["route_handlers"]

    # (a) To ruter for same handler (GET /a + POST /a)
    assert_eq(tekst_fra_heiltall(tel_ruter(handlers, "/a")), "2")

    la rget = finn_rute(handlers, "get", "/a")
    la rpost = finn_rute(handlers, "post", "/a")
    hvis rget == null { kast "FEIL: fann ikkje GET /a" }
    hvis rpost == null { kast "FEIL: fann ikkje POST /a" }

    # (b) Markørar
    hvis ikkje liste_har(rget["tags"], "items") { kast "FEIL: tag items mangla" }
    hvis ikkje liste_har(rget["tags"], "admin") { kast "FEIL: tag admin mangla" }
    assert_eq(tekst(rget["description"]), "Multi-rute handler")
    hvis lengde(rget["extra_responses"]) < 1 { kast "FEIL: extra_responses mangla" }
    assert_eq(tekst(rget["extra_responses"][0]["status"]), "404")

    # (c) request_query inne i hvis-blokk er fanga (rekursiv skann)
    hvis ikkje liste_har(rget["query_params"], "side") { kast "FEIL: query 'side' i hvis-blokk ikkje fanga" }
    hvis ikkje liste_har(rpost["query_params"], "side") { kast "FEIL: query 'side' mangla på POST" }

    skriv("test_fase2a_route_metadata OK\n")
    returner 0
}
