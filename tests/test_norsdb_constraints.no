// Fase 7i: constraints — NOT NULL, CHECK, PRIMARY KEY/UNIQUE, DEFAULT,
// INSERT OR IGNORE/REPLACE, UPSERT (ON CONFLICT DO NOTHING/UPDATE), FOREIGN KEY.
// Datautfall verifisert mot ekte sqlite3 3.51.0; exec()-retur = vår API (-1 = brot).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")

    // NOT NULL + CHECK
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT NOT NULL, alder INTEGER CHECK(alder >= 0))")
    assert_eq(sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (1, 'Ada', 37)"), 1)
    assert_eq(sql.exec(db, "INSERT INTO folk (id, alder) VALUES (2, 40)"), 0 - 1)       // navn NULL
    assert_eq(sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (3, 'Bob', -5)"), 0 - 1)  // CHECK
    assert_eq(sql.query_int(db, "SELECT count(*) FROM folk"), 1)

    // PRIMARY KEY / UNIQUE
    sql.exec(db, "CREATE TABLE k (id INTEGER PRIMARY KEY, e TEXT UNIQUE)")
    assert_eq(sql.exec(db, "INSERT INTO k (id, e) VALUES (1, 'a@x')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO k (id, e) VALUES (1, 'b@x')"), 0 - 1)   // PK-dup
    assert_eq(sql.exec(db, "INSERT INTO k (id, e) VALUES (2, 'a@x')"), 0 - 1)   // UNIQUE-dup
    assert_eq(sql.query_int(db, "SELECT count(*) FROM k"), 1)

    // OR IGNORE / OR REPLACE
    assert_eq(sql.exec(db, "INSERT OR IGNORE INTO k (id, e) VALUES (1, 'c@x')"), 0)
    assert_eq(sql.exec(db, "INSERT OR REPLACE INTO k (id, e) VALUES (1, 'd@x')"), 1)
    assert_eq(sql.query_text(db, "SELECT e FROM k WHERE id = 1"), "d@x")
    assert_eq(sql.query_int(db, "SELECT count(*) FROM k"), 1)

    // DEFAULT
    sql.exec(db, "CREATE TABLE d (id INTEGER, n TEXT DEFAULT 'ukjent', c INTEGER DEFAULT 7)")
    sql.exec(db, "INSERT INTO d (id) VALUES (1)")
    assert_eq(sql.query_rader(db, "SELECT n, c FROM d WHERE id = 1"), "ukjent|7")

    // UPSERT DO UPDATE (excluded)
    sql.exec(db, "CREATE TABLE u (id INTEGER PRIMARY KEY, n TEXT, c INTEGER DEFAULT 0)")
    sql.exec(db, "INSERT INTO u (id, n, c) VALUES (1, 'a', 5)")
    sql.exec(db, "INSERT INTO u (id, n, c) VALUES (1, 'b', 9) ON CONFLICT(id) DO UPDATE SET n = excluded.n")
    assert_eq(sql.query_rader(db, "SELECT n, c FROM u WHERE id = 1"), "b|5")
    // UPSERT DO NOTHING
    assert_eq(sql.exec(db, "INSERT INTO u (id, n, c) VALUES (1, 'z', 1) ON CONFLICT(id) DO NOTHING"), 0)
    assert_eq(sql.query_rader(db, "SELECT n, c FROM u WHERE id = 1"), "b|5")

    // FOREIGN KEY (grunnleggjande eksistens-sjekk)
    sql.exec(db, "CREATE TABLE avd (id INTEGER PRIMARY KEY, namn TEXT)")
    sql.exec(db, "INSERT INTO avd (id, namn) VALUES (10, 'Utv')")
    sql.exec(db, "CREATE TABLE emp (id INTEGER, avd_id INTEGER REFERENCES avd(id))")
    assert_eq(sql.exec(db, "INSERT INTO emp (id, avd_id) VALUES (1, 10)"), 1)
    assert_eq(sql.exec(db, "INSERT INTO emp (id, avd_id) VALUES (2, 99)"), 0 - 1)

    // UPDATE bryt UNIQUE
    assert_eq(sql.exec(db, "INSERT INTO k (id, e) VALUES (5, 'unik@x')"), 1)
    assert_eq(sql.exec(db, "UPDATE k SET e = 'd@x' WHERE id = 5"), 0 - 1)   // kolliderer med id=1

    returner 0
}
