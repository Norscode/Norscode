bruk std.tekst som t

funksjon start() -> heiltall {
    la ci = fil_les(".github/workflows/ci.yml")

    assert(ikkje t.inneholder(ci, "shard 1/8"))
    assert(ikkje t.inneholder(ci, "shard 8/8"))
    assert(t.inneholder(ci, "4 deterministiske parallelle shards"))
    assert(t.inneholder(ci, "NC_PARALLEL_TEST_SHARDS: \"4\""))
    // Fast-lane-budsjettet er 4800 s (80 min; 4 shards × ~270 testar på seed-dist
    // tek ~75 min) — slow-lanen har eige 8000 s-budsjett.
    assert(t.inneholder(ci, "NC_PARALLEL_TEST_TIMEOUT: \"4800\""))
    assert(t.inneholder(ci, "NC_PARALLEL_TEST_MIN_TOTAL: \"100\""))
    assert(t.inneholder(ci, "./bin/nc run tools/nc_test_parallel.no"))
    assert(t.inneholder(ci, "TEST_TIMEOUT: \"60\""))
    assert(ikkje t.inneholder(ci, "NC_TEST_SHARDS=8 TEST_TIMEOUT=10"))
    assert(ikkje t.inneholder(ci, "NC_TEST_SHARDS=8 TEST_TIMEOUT=20"))
    assert(ikkje t.inneholder(ci, "NC_TEST_SHARDS=8 TEST_TIMEOUT=30"))

    returner 0
}
