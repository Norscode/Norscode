bruk std.backup_aead som backup
bruk std.bytes som bytes
bruk std.runtime_filesystem som fs

funksjon lag_data(n: heiltall) {
    la out: liste_heiltall = []
    la i = 0
    mens i < n { legg_til(out, (i * 37 + 11) & 255) i = i + 1 }
    returner bytes.fra_liste(out)
}

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_BACKUP_AEAD_LIVE") != "1" {
        skriv("test_backup_aead_stream_restore: krev eksplisitt kandidatattestasjon")
        returner 0
    }
    la root = tekst(builtin.system_info()["cwd"]) + "/build/backup-aead-test-" + builtin.random_hex(6)
    builtin.mkdir_p(root + "/src")
    builtin.mkdir_p(root + "/out")
    la original = lag_data(10001)
    builtin.fil_skriv_binær(root + "/src/data.bin", original)
    builtin.fil_skriv(root + "/out/restored.bin", "behald-meg")
    la key_hex = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    la key = backup.nøkkel_fra_hex(key_hex)

    la made = backup.lag_backup(root, "src/data.bin", "vault/data.ncbaead", key, 4096, 20000)
    assert(made["status"] == "ok")
    assert(made["bytes"] == "10001")
    assert(made["chunks"] == "3")
    la restored = backup.gjenopprett(root, "vault/data.ncbaead", "out/restored.bin", key, 20000, 30000)
    assert(restored["status"] == "ok")
    assert(builtin.fil_les_binær(root + "/out/restored.bin") == original)
    la mode = fs.native_stat_sti(root + "/out/restored.bin")
    assert(mode["status"] == "ok")
    assert((heltall_fra_tekst(tekst(mode["mode"])) & 511) == 384)

    la rå = bytes.til_liste(builtin.fil_les_binær(root + "/vault/data.ncbaead"))
    rå[40] = rå[40] ^ 1
    builtin.fil_skriv_binær(root + "/vault/tampered.ncbaead", bytes.fra_liste(rå))
    builtin.fil_skriv(root + "/out/preserve.bin", "behald-meg")
    assert(backup.gjenopprett(root, "vault/tampered.ncbaead", "out/preserve.bin", key, 20000, 30000)["status"] == "feil")
    assert(builtin.fil_les(root + "/out/preserve.bin") == "behald-meg")

    la wrong = backup.nøkkel_fra_hex("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
    assert(backup.gjenopprett(root, "vault/data.ncbaead", "out/wrong.bin", wrong, 20000, 30000)["status"] == "feil")
    assert(ikkje builtin.fil_finnes(root + "/out/wrong.bin"))

    la full = bytes.til_liste(builtin.fil_les_binær(root + "/vault/data.ncbaead"))
    builtin.fil_skriv_binær(root + "/vault/truncated.ncbaead", bytes.fra_liste(builtin.slice(full, 0, lengde(full) - 1)))
    assert(backup.gjenopprett(root, "vault/truncated.ncbaead", "out/truncated.bin", key, 20000, 30000)["status"] == "feil")
    assert(ikkje builtin.fil_finnes(root + "/out/truncated.bin"))

    builtin.fil_skriv_binær(root + "/src/empty.bin", bytes.tom())
    assert(backup.lag_backup(root, "src/empty.bin", "vault/empty.ncbaead", key, 4096, 0)["status"] == "ok")
    assert(backup.gjenopprett(root, "vault/empty.ncbaead", "out/empty.bin", key, 0, 1000)["status"] == "ok")
    assert(lengde(builtin.fil_les_binær(root + "/out/empty.bin")) == 0)

    builtin.miljo_sett("NORSCODE_TEST_BACKUP_KEY", key_hex)
    assert(backup.lag_backup_fra_miljø(root, "src/data.bin", "vault/env.ncbaead", "NORSCODE_TEST_BACKUP_KEY", 4096, 20000)["status"] == "ok")
    assert(backup.gjenopprett_fra_miljø(root, "vault/env.ncbaead", "out/env.bin", "NORSCODE_TEST_BACKUP_KEY", 20000, 30000)["status"] == "ok")
    assert(builtin.fil_les_binær(root + "/out/env.bin") == original)

    assert(backup.lag_backup(root, "../escape", "vault/nope", key, 4096, 100)["status"] == "feil")
    assert(backup.gjenopprett(root, "vault/data.ncbaead", "../escape", key, 20000, 30000)["status"] == "feil")
    skriv("test_backup_aead_stream_restore OK")
    returner 0
}
