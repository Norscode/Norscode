# Fase 2 punkt 2.11 — rask handshake-lag-test for legacy_session_id-spegling.
# Dette er NØYAKTIG wiringa som fiksen i std/tls13_session.no:_tenar_motta gjer:
# parse ClientHello → mat cparsed["session_id"] inn i build_server_hello →
# ServerHello skal ekke same session_id. Køyrer utan ECDHE/Ed25519/ChaCha
# (som gjer full sesjons-loopback minuttlang i tolken), så han fullfører raskt.
bruk std.tls13_handshake som hs

funksjon _lik(a: liste_heiltall, b: liste_heiltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) { hvis a[i] != b[i] { returner usann } i = i + 1 }
    returner sann
}

funksjon _sid() -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < 32 { legg_til(ut, (0xA0 + i) & 255) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    la rnd: liste_heiltall = [] la i = 0
    mens i < 32 { legg_til(rnd, 7) i = i + 1 }
    la ks_pub: liste_heiltall = [] la j = 0
    mens j < 32 { legg_til(ks_pub, (j * 3) & 255) j = j + 1 }
    la sid = _sid()

    # ClientHello med NON-tom legacy_session_id (som OpenSSL/LibreSSL sender).
    la CH = hs.build_client_hello({"random": rnd, "session_id": sid, "key_share_pub": ks_pub, "server_name": "norscode.example"})
    la cph = hs.parse_handshake(CH, 0)
    assert_eq(cph["ok"], sann)
    la cp = hs.parse_client_hello(CH, cph["start"], cph["end"])
    assert_eq(cp["ok"], sann)
    assert_eq(_lik(cp["session_id"], sid), sann)

    # Server-wiringa (slik _tenar_motta no gjer): spegle cp["session_id"].
    la SH = hs.build_server_hello({"random": rnd, "session_id": cp["session_id"], "key_share_pub": ks_pub})
    la sph = hs.parse_handshake(SH, 0)
    assert_eq(sph["ok"], sann)
    assert_eq(sph["type"], 2)
    la sp = hs.parse_server_hello(SH, sph["start"], sph["end"])
    assert_eq(sp["ok"], sann)

    # KJERNA: ServerHello.legacy_session_id_echo == ClientHello.legacy_session_id.
    assert_eq(lengde(sp["session_id"]), 32)
    assert_eq(_lik(sp["session_id"], sid), sann)

    # Kontroll: med tom session_id (gammal, broten åtferd) ekkar ServerHello tomt —
    # viser at speglinga faktisk avheng av inndata, ikkje er konstant.
    la SH0 = hs.build_server_hello({"random": rnd, "session_id": [], "key_share_pub": ks_pub})
    la sph0 = hs.parse_handshake(SH0, 0)
    la sp0 = hs.parse_server_hello(SH0, sph0["start"], sph0["end"])
    assert_eq(lengde(sp0["session_id"]), 0)

    skriv("test_fase2b_tls_session OK — legacy_session_id spegla (32B) vs tom (0B) baseline")
    returner 0
}
