# X.509-kjedevalidering med ekte ECDSA P-256-signert kjede (ecdsa-with-SHA256).
# Root + leaf generert med openssl/cryptography (secp256r1), validert i rein Norscode.
bruk std.x509_chain som chain
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon start() -> heiltall {
    la root = _b("")
    la leaf = _b("")
    la trust = ["0a0b2ce5957e15b869a81119e123b6847f61662d55591021c463609880b9208a"]

    # (1) Gyldig ECDSA-kjede -> godkjent (leaf-link + anker sjølvsign).
    la r = chain.valider_kjede([leaf, root], trust, "norscode.example", "2026-06-01T12:00:00Z")
    assert_eq(r["gyldig"], sann)

    # (2) Feil vertsnamn -> avvist før signaturkostnad.
    la r2 = chain.valider_kjede([leaf, root], trust, "angrep.example", "2026-06-01T12:00:00Z")
    assert_eq(r2["gyldig"], usann)

    assert_eq(chain.status()["sig"], "ed25519+rsa-sha256+ecdsa-p256")
    skriv("test_x509_chain_ecdsa OK")
    returner 0
}
