# R2 / F21: typenamn(v) gjev strukturnamnet (kort) eller runtime-typen, og
# er_instans(v, Type) testar mot ein struktur eller eit grensesnitt (òg
# alias.Type). Kompilatoren løyser Type til det modulkvalifiserte namnet og
# skriv grensesnittlista inn i konstruktøren («interfaces»); eit ukjent
# typenamn er ein kompileringsfeil. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.bundler som bundler

funksjon ncb_av(sti: tekst, modul: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(fil_les(sti), modul))
}

funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon slå_saman(ncb, m) -> heiltall {
    la fk = nøkler(m["functions"])
    la i = 0
    mens i < lengde(fk) {
        ncb["functions"][fk[i]] = m["functions"][fk[i]]
        i = i + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la ncb = ncb_av("tests/fixtures/r2_instans.no", "__main__")
    slå_saman(ncb, ncb_av("tests/fixtures/r2_konto_a.no", "tests.fixtures.r2_konto_a"))
    # Modulen kompilert som __main__ og omdøypt av bundlaren: strukturmerket
    # og grensesnittlista i konstruktøren må følgje omdøypinga.
    slå_saman(ncb, bundler.omdøyp_ncb_objekt(ncb_av("tests/fixtures/r2_dyr.no", "__main__"), "tests.fixtures.r2_dyr"))
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "s_form=sann;b_form=usann;s_sirkel=sann;s_bil=usann;ordbok=usann;tal=usann;null=usann;alias=sann/usann;typenamn=Sirkel,Konto,tekst,liste,ordbok;dyr=sann/usann/Pus seier mjau;p31=sann/usann")

    la ukjend = "grensesnitt Form { funksjon areal(self) -> heltall }\n" +
        "funksjon start() -> heltall {\n" +
        "    la v = 1\n" +
        "    hvis er_instans(v, Frm) { returner 1 }\n" +
        "    returner 0\n" +
        "}\n"
    assert_eq(kompileringsfeil(ukjend), "Typefeil linje 4: er_instans: ukjend struktur eller grensesnitt Frm")
    returner 0
}
