// SEED-ONLY (ikkje test_-prefiks med vilje): køyrer berre i seed-porten
// (tools/seed_gate_tests.txt → b2-seed-direct), ikkje i stage0-banane.
//
// VM-armane for builtin.web.* i selfhost/vm.no (kall_innebygd_web_og_ncb) kalla
// kvarandre som VERTSbuiltins, t.d. bearer_token → builtin.web.auth_header →
// builtin.web.request_header. Armane lagar ctx med __headers__/__query__/__body__,
// men vertsbuiltinane les headers/query/body UTAN understrek. Målt 2026-09-10 på
// committa macOS-stage0 (VM-en er innbakt, so fiksen verkar ikkje der før promotering):
//   bearer_token → ""  (venta "abc")    role → ""  (venta "agent")
//   request_cookie(b) → ""  (venta "2") request_id → "req-1" (venta "req-9")
//   request_json_field(s) → ""  (venta "hei")   request_query_required(q) → KAST
// På fersk x86-seed er vertsbuiltinane null-fallback → null i staden.
// Testen er difor RAUD på committa stage0 ved konstruksjon, og grøn på ein seed
// bygd frå kjelda (armane dispatchar no til seg sjølve).

funksjon start() -> heiltall {
    la feil = builtin.web.response_error(404, "borte")
    assert(feil != null)
    assert_eq(builtin.web.response_status(feil), 404)
    assert_eq(builtin.web.response_body(feil), "{\"error\":\"borte\"}")

    la hovud = {
        "authorization": "Bearer abc",
        "x-role": "agent",
        "cookie": "a=1; b=2",
        "x-request-id": "req-9"
    }
    la ctx = builtin.web.request_context("get", "/x", {"q": "1"}, hovud, "{\"n\": 7, \"s\": \"hei\"}")
    assert_eq(builtin.web.request_query_required(ctx, "q"), "1")
    assert_eq(builtin.web.request_query_int(ctx, "q"), 1)
    assert_eq(builtin.web.bearer_token(ctx), "abc")
    assert(builtin.web.require_bearer(ctx, "abc") == sann)
    assert_eq(builtin.web.role(ctx), "agent")
    assert_eq(builtin.web.request_cookie(ctx, "b"), "2")
    assert_eq(builtin.web.request_cookie_or(ctx, "c", "standard"), "standard")
    assert_eq(builtin.web.request_id(ctx), "req-9")
    assert_eq(builtin.web.request_json_field(ctx, "s"), "hei")
    assert_eq(builtin.web.request_json_field_int(ctx, "n"), 7)
    assert_eq(builtin.web.request_json_field_or(ctx, "manglar", "x"), "x")

    la tekst_svar = builtin.web.response_text(builtin.web.response_builder(200, {}, "ok"))
    assert_eq(tekst_svar, "ok")
    skriv("seed_web_vm_intern_dispatch OK\n")
    returner 0
}
