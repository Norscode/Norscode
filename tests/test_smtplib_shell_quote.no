bruk std.smtplib som smtp
bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/smtplib.no")
    skriv("checks=" +
        tekst(t.inneholder(src, "Norscode native TCP/implicit TLS")) + "," +
        tekst(t.inneholder(src, "bruk std.base64 som base64")) + "," +
        tekst(t.inneholder(src, "bruk std.protocol_stream som stream")) + "," +
        tekst(t.inneholder(src, "base64.kod(brukarnamn)")) + "," +
        tekst(t.inneholder(src, "stream.opne_session_ca")) + "," +
        tekst(t.inneholder(src, "stream.oppgrader_tls")) + "," +
        tekst(t.inneholder(src, "send_native(lokal_server()")) + "\n")
    assert(t.inneholder(src, "Norscode native TCP/implicit TLS"))
    assert(t.inneholder(src, "bruk std.base64 som base64"))
    assert(t.inneholder(src, "bruk std.protocol_stream som stream"))
    assert(t.inneholder(src, "base64.kod(brukarnamn)"))
    assert(t.inneholder(src, "stream.opne_session_ca"))
    assert(t.inneholder(src, "stream.oppgrader_tls"))
    assert(t.inneholder(src, "send_native(lokal_server()"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "sendmail "))
    assert(ikkje t.inneholder(src, "curl "))
    assert(ikkje t.inneholder(src, "rm -f "))

    la msg = smtp.ny_melding("Test\r\nBcc: victim@example.com", "Body", "a@example.com", ["b@example.com"])
    la avvist = smtp.send_resultat(smtp.ny_server_tls("localhost", 587), msg, "user", "pass")
    assert(avvist["category"] == "validation")
    skriv("test_smtplib_shell_quote OK")
    returner 0
}
