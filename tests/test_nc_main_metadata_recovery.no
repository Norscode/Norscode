bruk selfhost.nc_main som ncmain

// J1b: syntetisk fikstur i staden for build/vm_phase8_fixed6_direct.ncb.json.
// Modulen har levande __module_init__ med ti STORE_GLOBAL, men metadatafelta
// (module_initializers/global_names) har gått tapt i transport. Recovery-vegen
// i nc_main må rekonstruere dei frå initialisatorkoden.
funksjon fikstur_ncb() -> ordbok {
    la kode = []
    la i: heiltall = 0
    mens i < 10 {
        legg_til(kode, ["PUSH_CONST", i])
        legg_til(kode, ["STORE_GLOBAL", "vm_global_" + tekst_fra_heltall(i)])
        i = i + 1
    }
    // Ein gjenteken STORE_GLOBAL skal ikkje gje duplikat.
    legg_til(kode, ["PUSH_CONST", 42])
    legg_til(kode, ["STORE_GLOBAL", "vm_global_3"])
    legg_til(kode, ["PUSH_CONST", 0])
    legg_til(kode, ["RETURN"])
    la fns = {}
    fns["selfhost.vm.__module_init__"] = {
        "name": "__module_init__", "module": "selfhost.vm", "params": [],
        "is_async": usann, "code": kode
    }
    returner {"format": "norscode-bytecode-v1", "entry": "selfhost.vm.start", "functions": fns}
}

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(builtin.json_skriv(fikstur_ncb()))
    assert(ikkje finnes_nøkkel(ncb, "global_names"))
    la initializers = []
    la global_names = {}
    assert(ncmain.nc_sikre_modulmetadata(initializers, global_names, ncb, "selfhost.vm") == 0)
    assert(lengde(initializers) == 1)
    assert(initializers[0] == "selfhost.vm.__module_init__")
    assert(finnes_nøkkel(global_names, "selfhost.vm"))
    assert(lengde(global_names["selfhost.vm"]) == 10)
    skriv("test_nc_main_metadata_recovery OK\n")
    returner 0
}
