bruk selfhost.nc_main som ncmain

// Talet på modulglobalar blir avleidd frå kjelda (toppnivå-`la` i selfhost/vm.no),
// ikkje hardkoda: vm.no fekk nye globalar (t.d. vm_green_* for grøne trådar).
funksjon venta_vm_globalar() -> heiltall {
    la linjer = builtin.split(fil_les("selfhost/vm.no"), "\n")
    la n: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(linjer) {
        hvis builtin.starts_with(linjer[i], "la ") { n = n + 1 }
        i = i + 1
    }
    returner n
}

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(fil_les("build/vm_phase8_fixed6_direct.ncb.json"))
    la initializers = []
    la global_names = {}
    assert(ncmain.nc_sikre_modulmetadata(initializers, global_names, ncb, "selfhost.vm") == 0)
    assert(lengde(initializers) == 1)
    assert(finnes_nøkkel(global_names, "selfhost.vm"))
    assert(venta_vm_globalar() >= 10)
    assert(lengde(global_names["selfhost.vm"]) == venta_vm_globalar())
    skriv("test_nc_main_metadata_recovery OK\n")
    returner 0
}
