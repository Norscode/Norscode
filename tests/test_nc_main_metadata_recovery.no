bruk selfhost.nc_main som ncmain

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(fil_les("build/vm_phase8_fixed6_direct.ncb.json"))
    la initializers = []
    la global_names = {}
    assert(ncmain.nc_sikre_modulmetadata(initializers, global_names, ncb, "selfhost.vm") == 0)
    assert(lengde(initializers) == 1)
    assert(finnes_nøkkel(global_names, "selfhost.vm"))
    assert(lengde(global_names["selfhost.vm"]) == 10)
    skriv("test_nc_main_metadata_recovery OK\n")
    returner 0
}
