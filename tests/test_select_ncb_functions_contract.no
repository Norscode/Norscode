bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/maint/select_ncb_functions.no")
    assert(t.inneholder(src, "NC_SELECT_NCB_INPUT"))
    assert(t.inneholder(src, "NC_SELECT_NCB_OUTPUT"))
    assert(t.inneholder(src, "NC_SELECT_NCB_FUNCTIONS"))
    assert(t.inneholder(src, "hvis input == output"))
    assert(t.inneholder(src, "hvis ikkje finnes_nøkkel(alle, fn)"))
    assert(t.inneholder(src, "original[\"functions\"] = valde"))
    assert(t.inneholder(src, "builtin.json_skriv(original)"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_select_ncb_functions_contract OK")
    returner 0
}
