# R3 trinn 8 (3.2/3.3): signaturbinding og responsmodell under `nc serve`.
#
# RESEED-GATED (som test_fase2b_serve): importerer selfhost.nc_main, bundlar
# tests/fixtures/r3_signatur_app.no med nc_reload_bundle (KJELDE-kompilatoren på
# greina lagar "params"/"modellar", og std.rutebinding blir lagd implisitt i bunten),
# set opp runtime og køyrer serve_handle_one direkte (same veg som nc serve, utan
# socket). Lokalt treff dette GC-veggen (nc_main er heile lukkingsmodulen); den
# installerte `nc serve` får endringa først ved neste seed-rebygging.

bruk selfhost.nc_main

funksjon krev(namn: tekst, resp: tekst, sub: tekst) {
    hvis ikkje builtin.contains(resp, sub) {
        kast "FEIL " + namn + ": fann ikkje '" + sub + "' i svaret:\n" + resp
    }
}

funksjon start() -> heltall {
    la rs = nc_reload_bundle("tests/fixtures/r3_signatur_app.no", "__main__")
    hvis ikkje rs["ok"] {
        kast "bundle feila: " + tekst(rs["error"])
    }
    la ncb = json_parse_raw(tekst(rs["ncb_json"]))
    nc_serve_init_runtime(ncb)

    # Stiparameter som heltall + responsmodell (passord/detaljar filtrerte vekk).
    la r1 = serve_handle_one(ncb, "GET /personar/41 HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("sti-heltall", r1, "\"id\":42")
    hvis builtin.contains(r1, "passord") { kast "FEIL responsmodell: passord lak ut:\n" + r1 }

    # Feil type i stien → 422 loc [path, id].
    la r2 = serve_handle_one(ncb, "GET /personar/abc HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("sti-422", r2, "422")
    krev("sti-422-loc", r2, "[\"path\",\"id\"]")

    # Query: påkravd og standardverdi.
    la r3 = serve_handle_one(ncb, "GET /sok?q=hei HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("query-standard", r3, "\"dobbel\":20")
    la r4 = serve_handle_one(ncb, "GET /sok HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("query-manglar", r4, "[\"query\",\"q\"]")
    la r5 = serve_handle_one(ncb, "GET /sok?q=x&n=y HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("query-int", r5, "int_parsing")

    # Struktur frå kroppen: manglande felt → 422 loc [body, namn].
    la r6 = serve_handle_one(ncb, "POST /personar HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}")
    krev("body-manglar", r6, "[\"body\",\"namn\"]")

    # Bakoverkompatibelt: berre ctx, og ctx + avhengnad.
    la r7 = serve_handle_one(ncb, "GET /gamal?q=z HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("gamal", r7, "\"q\":\"z\"")
    la r8 = serve_handle_one(ncb, "GET /dep HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("dep", r8, "\"db\":\"DB\"")

    skriv("test_r3_serve_signatur OK\n")
    returner 0
}
