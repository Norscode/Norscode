funksjon start() -> heiltall {
    assert(builtin.json_skriv(usann) == "fa" + "lse")
    assert(builtin.json_skriv(sann) == "tr" + "ue")
    assert(builtin.json_skriv(null) == "nu" + "ll")
    la verdi = {"f": usann, "t": sann, "n": null}
    la encoded = builtin.json_skriv(verdi)
    assert(builtin.contains(encoded, "\"f\":false"))
    assert(builtin.contains(encoded, "\"t\":true"))
    assert(builtin.contains(encoded, "\"n\":null"))
    skriv("test_json_skriv_raw_bool OK\n")
    returner 0
}
