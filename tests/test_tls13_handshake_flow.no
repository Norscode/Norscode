# TLS 1.3 1-RTT handtrykk (RFC 8446) - full loopback klient<->tenar i rein Norscode.
bruk std.tls13_handshake_flow som flow
funksjon _seed(base: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < 32 { legg_til(ut, (base + i * 7) & 255) i = i + 1 }
    returner ut
}
funksjon start() -> heiltall {
    la r = flow.handshake_loopback({
        "c_priv": _seed(1),
        "s_priv": _seed(101),
        "s_id_seed": _seed(200)
    })
    # ECDHE-løyndom likt begge sider (kjernen i nøkkelutvekslinga).
    assert_eq(r["ecdhe_lik"], sann)
    # Tenaren sin CertificateVerify (Ed25519) verifiserer hos klienten.
    assert_eq(r["cv_ok"], sann)
    # Server Finished og client Finished MAC verifiserer.
    assert_eq(r["server_finished_ok"], sann)
    assert_eq(r["client_finished_ok"], sann)
    # Applikasjonsdata krypterer/dekrypterer over record-laget.
    assert_eq(r["app_data_ok"], sann)
    # Delt løyndom er 32 byte og ikkje null.
    assert_eq(lengde(r["shared"]), 32)

    # Fail-closed: tukla CertificateVerify-signatur skal forkastast.
    assert_eq(r["cv_reject_tamper"], sann)

    assert_eq(flow.status()["abi"], "norscode-tls13-flow-v1")
    skriv("test_tls13_handshake_flow OK")
    returner 0
}
