// Runtime-ruter må finnast som ekte kompilerte funksjonar i selfhost-manifestet.
bruk tools.omgang6b_modules som modular
bruk selfhost.native_execution.gap_ruter som gap
bruk selfhost.kompiler som kompiler

funksjon start() -> heiltall {
    la fns = {}
    la krev = ["std.runtime_filesystem", "tools.process_runner", "selfhost.ncb_stream", "std.native_gap", "std.runtime_filesystem_native"]
    la funne = {}
    for spec i modular.spesifikasjonar() {
        la felt = builtin.split(spec, "|")
        la vald = usann
        for modul i krev { hvis modul == felt[1] { vald = sann } }
        hvis vald {
            la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(builtin.fil_les(felt[0]), felt[1]))
            for namn i nøkler(ncb["functions"]) { fns[namn] = ncb["functions"][namn] }
            funne[felt[1]] = sann
        }
    }
    for modul i krev { assert(har_nokkel(funne, modul)) }
    for namn i ["std.runtime_filesystem.native_lag_mappe", "std.runtime_filesystem.native_erstatt_fil_atomisk", "std.runtime_filesystem.native_sti_rot_relativ", "std.runtime_filesystem.opne_native", "std.runtime_filesystem.native_flush", "std.runtime_filesystem.native_lukk", "tools.process_runner.køyr", "tools.process_runner.ok", "tools.process_runner.skriv_resultat", "selfhost.ncb_stream.skriv_alt", "selfhost.ncb_stream.magic", "selfhost.ncb_stream.skriv_fil"] {
        assert(har_nokkel(fns, namn))
    }
    for namn i ["builtin.kompiler_fil_aktiv", "builtin.network_operation", "builtin.filesystem_read_operation", "builtin.filesystem_write_operation"] {
        la finst = usann
        for mål i gap.gap_rute(namn) { hvis har_nokkel(fns, mål) { finst = sann } }
        assert(finst)
    }
    // Aktiv VM-kompilering er ikkje ei native teneste: bevar den ærlege feilen.
    la kode = fns["std.native_gap.kompiler_fil_aktiv"]["code"]
    la kastar = usann
    for instr i kode { hvis instr[0] == "THROW" { kastar = sann } }
    assert(kastar)
    skriv("test_selfhost_runtime_gap_routes OK\n")
    returner 0
}
