bruk tools.install_macos_app_core som installer
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la temp = runtime_fs.native_tempområde("build", "macos-app-install-")
    assert(temp["status"] == "created")
    la base = root + "/build/" + temp["relative"]
    la app = base + "/Source.app"
    la dest = base + "/Applications"
    assert(filops.lag_katalogar(app + "/Contents/MacOS"))
    builtin.fil_skriv(app + "/Contents/Info.plist",
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
        "<plist version=\"1.0\">\n<dict>\n" +
        "<key>CFBundleIdentifier</key>\n<string>no.norscode.fixture</string>\n" +
        "<key>CFBundleExecutable</key>\n<string>NorscodeFixture</string>\n" +
        "<key>CFBundleShortVersionString</key>\n<string>1.2.3</string>\n" +
        "</dict>\n</plist>\n")
    builtin.fil_skriv(app + "/Contents/MacOS/NorscodeFixture", "fixture")
    assert(runtime_fs.native_sett_modus_sti(app + "/Contents/MacOS/NorscodeFixture", 493)["status"] == "ok")

    assert(installer.installer(app, dest, "Norscode.app") == 0)
    assert(builtin.fil_les(dest + "/Norscode.app/Contents/MacOS/NorscodeFixture") == "fixture")
    la metadata = builtin.fil_les(dest + "/.Norscode/current/Contents/Info.plist")
    assert(builtin.index_of(metadata, "1.2.3") >= 0)
    la modus = runtime_fs.native_stat_sti(
        dest + "/.Norscode/versions/1.2.3/Norscode.app/Contents/MacOS/NorscodeFixture")
    assert((heltall_fra_tekst(modus["mode"]) & 511) == 493)

    assert(filops.slett_tre(base))
    skriv("test_install_macos_app_native_live OK")
    returner 0
}
