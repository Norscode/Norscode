// \uXXXX i JSON skal bli UTF-8, ikkje ein rå Latin-1-byte.
//
// FUNN 2026-09-10: std.native_gap.json_parse gjorde `builtin.chr(kode)` rett,
// som gjev ÉIN RÅ BYTE. Målt på fersk seed:
//     json_parse("\"\\u00e6\"") → [230]        (rett UTF-8 for æ er [195 166])
//     surrogatpar for 😀        → [61]         (éin byte «=», heilt korrupt)
// Altså: gyldig JSON inn, ugyldig UTF-8 ut. Gap-en er den vegen fersk seed tek
// for builtin.json_parse (native_codegen_v2.no:7025–7028), so dette råka alle
// 379 kallstadene i repoet.
//
// Testen kallar gap-modulen DIREKTE i staden for via builtin.json_parse, slik at
// han verifiserer implementasjonen òg på ein runtime der builtin.json_parse går
// til C-koden. Han samanliknar teiknkodar — ikkje json_stringify, som er broten
// på den gamle seeden og har forgifta slike samanlikningar før.

bruk std.native_gap som gap

funksjon koder(v: tekst) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(v) { ut = ut + tekst(builtin.char_code(v[i])) + " " i = i + 1 }
    returner trim(ut)
}

funksjon sjekk(namn: tekst, json: tekst, venta: tekst) -> heltall {
    la fekk = koder(gap.json_parse(json))
    hvis fekk != venta {
        skriv("[FAIL] " + namn + ": fekk [" + fekk + "], venta [" + venta + "]\n")
        kast "test_json_unicode_utf8: " + namn
    }
    returner 0
}

funksjon start() -> heltall {
    sjekk("ASCII \\u0041", "\"\\u0041\"", "65")
    sjekk("æ \\u00e6", "\"\\u00e6\"", "195 166")
    sjekk("ø \\u00f8", "\"\\u00f8\"", "195 184")
    sjekk("euro \\u20ac (3 byte)", "\"\\u20ac\"", "226 130 172")
    sjekk("emoji surrogatpar (4 byte)", "\"\\ud83d\\ude00\"", "240 159 152 128")
    sjekk("rå æ skal stå uendra", "\"æ\"", "195 166")
    sjekk("vanleg tekst", "\"abc\"", "97 98 99")
    sjekk("escape \\n", "\"a\\nb\"", "97 10 98")
    skriv("test_json_unicode_utf8 OK\n")
    returner 0
}
