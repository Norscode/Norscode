funksjon start() -> heiltall {
    la src = fil_les("archive/legacy_c_backend/nc_native_main.c")
    assert(builtin.contains(src, "defined(_WIN32) || defined(NC_DYNAMIC_SQLITE)"))
    assert(builtin.contains(src, "dlopen(\"/usr/lib/libsqlite3.dylib\""))
    assert(builtin.contains(src, "dlopen(\"libsqlite3.so.0\""))
    assert(builtin.contains(src, "dlsym(g_nc_sqlite_module, #name)"))
    assert(builtin.contains(src, "LoadLibraryA(\"winsqlite3.dll\")"))
    assert(builtin.contains(src, "GetProcAddress(g_nc_sqlite_module, #name)"))
    skriv("test_dynamic_sqlite_adapter_contract OK")
    returner 0
}
