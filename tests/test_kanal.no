# M8 (primitiv) — kanal / meldingskø: FIFO, open/stengd, tapp. Seed-rask.

bruk std.kanal som kanal

funksjon start() -> heiltall {
    la k = kanal.ny_kanal()
    assert(kanal.er_tom(k))
    assert(kanal.er_open(k))

    kanal.send(k, 10)
    kanal.send(k, 20)
    kanal.send(k, 30)
    assert(kanal.lengd(k) == 3)
    assert(ikkje kanal.er_tom(k))

    # FIFO-rekkefølgje
    la a = kanal.motta(k)
    assert(a["har"])
    assert(a["verdi"] == 10)
    la b = kanal.motta(k)
    assert(b["verdi"] == 20)
    assert(kanal.lengd(k) == 1)

    # Mottak på tom kanal gir har=usann
    kanal.motta(k)
    la tom = kanal.motta(k)
    assert(ikkje tom["har"])

    # Stenging blokkerer send, men tapp fungerer
    kanal.send(k, 1)
    kanal.send(k, 2)
    kanal.steng(k)
    assert(ikkje kanal.er_open(k))
    la feila = usann
    prøv {
        kanal.send(k, 3)
    } fang (e) {
        feila = sann
    }
    assert(feila)
    la rest = kanal.tapp(k)
    assert(lengde(rest) == 2)
    assert(rest[0] == 1)
    assert(rest[1] == 2)

    skriv("test_kanal OK\n")
    returner 0
}
