bruk std.plistlib som plist

funksjon start() -> heiltall {
    builtin.mkdir_p("build")
    la xml_sti = "build/plistlib-live.xml.plist"
    la bin_sti = "build/plistlib-live.binary.plist"
    la data: ordbok_tekst = {
        "Name": "Norscode",
        "Enabled": "true",
        "Count": "42"
    }
    la formatted = plist.format_xml(data)
    skriv("formatted-bytes=" + tekst_fra_heltall(lengde(formatted)) + "\n")
    la wrote_xml = plist.skriv_fil(xml_sti, data)
    skriv("wrote-xml=" + tekst(wrote_xml) + "\n")
    assert(wrote_xml)
    la xml = plist.les_fil(xml_sti)
    skriv("xml=" + builtin.json_stringify(xml) + "\n")
    assert(plist.get(xml, "Name") == "Norscode")
    assert(plist.get(xml, "Enabled") == "true")
    assert(plist.get(xml, "Count") == "42")
    la binary_result = plist.skriv_binær_resultat(bin_sti, data)
    skriv("binary-result=" + builtin.json_stringify(binary_result) + "\n")
    la wrote_binary = binary_result["status"] == "ok"
    skriv("wrote-binary=" + tekst(wrote_binary) + "\n")
    hvis ikkje wrote_binary og miljo_hent("NORSCODE_REQUIRE_PLIST_ABI_LIVE") != "1" {
        builtin.fil_slett(xml_sti)
        skriv("test_plistlib_abi_live: binær ABI krev eksplisitt kandidatattestasjon\n")
        returner 0
    }
    assert(wrote_binary)
    la binary = plist.les_binær(bin_sti)
    skriv("binary=" + builtin.json_stringify(binary) + "\n")
    assert(plist.get(binary, "Name") == "Norscode")
    assert(plist.get(binary, "Enabled") == "true")
    assert(plist.get(binary, "Count") == "42")
    la automatic = plist.les_fil(bin_sti)
    skriv("automatic=" + builtin.json_stringify(automatic) + "\n")
    assert(plist.get(automatic, "Name") == "Norscode")
    builtin.fil_slett(xml_sti)
    builtin.fil_slett(bin_sti)
    skriv("test_plistlib_abi_live OK")
    returner 0
}
