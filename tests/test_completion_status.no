bruk tools.completion_status som gate
bruk std.runtime_status som runtime
bruk std.stdlib_status som stdlib

funksjon stabile(omfang: liste_tekst) {
    la ut = []
    for namn i omfang { legg_til(ut, {"namn": namn, "status": "stabil"}) }
    returner ut
}

funksjon start() -> heiltall {
    la krav = ["a", "b"]
    assert_eq(gate.vurder(stabile(krav), krav)["status"], "green")
    la m = gate.vurder(stabile(["a"]), krav)
    assert_eq(m["status"], "red")
    assert_eq(m["manglar"], "b")
    la d = gate.vurder(stabile(["a", "a"]), krav)
    assert_eq(d["status"], "red")
    assert_eq(d["duplikat"], "a")
    assert_eq(d["manglar"], "b")
    la u = gate.vurder(stabile(["a", "c"]), krav)
    assert_eq(u["status"], "red")
    assert_eq(u["ukjent"], "c")
    assert_eq(gate.vurder(stabile(["a", "b", "c"]), krav)["status"], "red")
    for status i ["delvis", "eksperimentell", "stub", "ukjent", ""] {
        la r = gate.vurder([{"namn": "a", "status": "stabil"}, {"namn": "b", "status": status}], krav)
        assert_eq(r["status"], "red")
        assert_eq(r["ikkje_stabil"], "b")
    }
    assert_eq(gate.vurder([], [])["status"], "red")
    assert_eq(gate.vurder(stabile(["a", "a"]), ["a", "a"])["status"], "red")
    assert_eq(gate.vurder([{"namn": "a"}, "ikkje ei rad"], krav)["ugyldig"], "2")
    // Dagens register må dekkje heile det godkjende omfanget, men behalde
    // raud sluttport så lenge faktiske modular er delvise/eksperimentelle.
    la rt = gate.vurder(runtime.runtime_v1_status(), gate.runtime_omfang())
    la st = gate.vurder(stdlib.statusmatrise(), gate.stdlib_omfang())
    for r i [rt, st] {
        assert_eq(r["manglar"], "")
        assert_eq(r["duplikat"], "")
        assert_eq(r["ukjent"], "")
        assert_eq(r["ugyldig"], "0")
        assert_eq(r["status"], "red")
    }
    assert_eq(gate.vurder(stabile(gate.runtime_omfang()), gate.runtime_omfang())["status"], "green")
    assert_eq(gate.vurder(stabile(gate.stdlib_omfang()), gate.stdlib_omfang())["status"], "green")
    skriv("test_completion_status OK\n")
    returner 0
}
