# R3: vararg-pakking og standardargument på tvers av modular. alias.f(...) og
# ukvalifisert importert f(...) får same kallform som lokale kall (tidlegare
# ArgumentFeil, t.d. web.tags("a", "b") frå ein annan modul). Standardverdiar
# blir evaluerte på kallstaden og må difor vere konstantar; ein ikkje-konstant
# standard frå ein annan modul er ein kompileringsfeil når argumentet manglar.
# Køyrer gjennom KJELDE-kompilator og KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.bundler som bundler

funksjon køyr(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la m = "tests.fixtures.r3_kallform"
    la mncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les("tests/fixtures/r3_kallform.no"), m))
    la inits = []
    bundler.slå_saman_funksjonar(ncb["functions"], mncb["functions"])
    bundler.slå_saman_modulmetadata(inits, ncb["global_names"], mncb)
    bundler.slå_saman_modulmetadata(inits, ncb["global_names"], ncb)
    ncb["module_initializers"] = inits
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon start() -> heiltall {
    la hovud = "bruk tests.fixtures.r3_kallform som kf\n" +
        "funksjon start() -> tekst {\n" +
        "    returner kf.samle(\"a\", \"b\", \"c\") + \"|\" + kf.samle(\"x\") + \"|\" + kf.helse(\"Ola\") + \"|\" + kf.helse(\"Kari\", \"hallo\") + \"|\" + kf.helse(\"Per\", \"god dag\", 1) + \"|\" + kf.med_global(\"eksplisitt\")\n" +
        "}\n"
    assert_eq(køyr(hovud), "a:2:b,c|x:0:|hei Ola;hei Ola;|hallo Kari;hallo Kari;|god dag Per;|eksplisitt")

    # Ukvalifisert importert kall får same kallform.
    la ukval = "bruk tests.fixtures.r3_kallform\n" +
        "funksjon start() -> tekst {\n" +
        "    returner samle(\"a\", \"b\") + \"|\" + helse(\"Ola\", \"hei\", 1)\n" +
        "}\n"
    assert_eq(køyr(ukval), "a:1:b|hei Ola;")

    # Ikkje-konstant standard (referansen PREFIKS høyrer til den andre modulen).
    la ikkje_konst = "bruk tests.fixtures.r3_kallform som kf\n" +
        "funksjon start() -> tekst {\n" +
        "    returner kf.med_global()\n" +
        "}\n"
    assert_eq(kompileringsfeil(ikkje_konst), "Argumentfeil: standardargument 1 til tests.fixtures.r3_kallform.med_global er ikkje ein konstant og kan ikkje fyllast ut frå ein annan modul; send argumentet eksplisitt")
    returner 0
}
