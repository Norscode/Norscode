// Fase 4b: frittståande SQL-lag oppå den binære motoren (ingen vm.no).
// CREATE TABLE / INSERT / SELECT (m/ WHERE + AND) / COUNT. Golden = SQLite-semantikk.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")   // in-memory

    assert_eq(sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    assert_eq(sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')"), 1)

    // COUNT + WHERE
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk"), 4)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo'"), 3)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE alder > 40"), 2)

    // SELECT enkeltverdi via WHERE
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE id = 2"), "Linus")

    // SELECT fleire kolonnar + AND (Oslo & alder>40 → Linus, Alan i innsettingsorden)
    assert_eq(sql.query_rader(db, "SELECT navn, alder FROM folk WHERE by = 'Oslo' AND alder > 40"), "Linus|55\nAlan|41")

    // SELECT * følgjer skjema-rekkefølge
    assert_eq(sql.query_rader(db, "SELECT * FROM folk WHERE id = 3"), "3|Bjørn|29|Bergen")

    // Ugyldig setning → -1
    assert_eq(sql.exec(db, "INSRT INTO folk (navn) VALUES ('x')"), -1)

    returner 0
}
