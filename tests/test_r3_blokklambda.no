# R3 / F17: lambda med blokkropp, `fun(x) { …; returner y }` og
# `fun(x) -> T { … }`. Same Lambda-form som `funksjon(x) { … }` (closures
# fangar omsluttande lokale). Kortforma `fun(x) -> uttrykk` (òg med ei
# ordbok-literal som kropp) er uendra. Køyrer gjennom KJELDE-kompilator og
# KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heiltall {
    la kjelde = "funksjon bruk_på(f, v) {\n" +
        "    returner f(v)\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    la n = 10\n" +
        "    la dobbel_pluss = fun(x) { la y = x * 2; returner y + 1 }\n" +
        "    la klassifiser = fun(x) {\n" +
        "        hvis x > n {\n" +
        "            returner \"stor\"\n" +
        "        }\n" +
        "        returner \"liten\"\n" +
        "    }\n" +
        "    la kvadrat = fun(x: heiltall) -> heiltall { returner x * x }\n" +
        "    la tom = fun() { la ignorert = 1 }\n" +
        "    la kort = fun(x) -> x + 1\n" +
        "    la ord = fun(x) -> {\"v\": x}\n" +
        "    returner tekst(dobbel_pluss(20)) + \"|\" + klassifiser(11) + \"|\" + klassifiser(3) + \"|\" + tekst(bruk_på(kvadrat, 7)) + \"|\" + tekst(tom()) + \"|\" + tekst(kort(1)) + \"|\" + tekst(ord(5)[\"v\"]) + \"|\" + tekst(bruk_på(fun(s) { returner s + \"!\" }, \"hei\"))\n" +
        "}\n"
    assert_eq(køyr(kjelde), "41|stor|liten|49||2|5|hei!")
    returner 0
}
