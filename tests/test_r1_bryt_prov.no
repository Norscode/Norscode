# R1 / F03: bryt/fortsett ut av prøv/endeleg. Handleren til prøv-blokka blir
# fjerna (TRY_END) og ventande endeleg-blokker køyrer før hoppet, i rett
# rekkjefølgje også når prøv-blokker er nøsta. Unntak/p15 (a, b) og p05 (g).
# Køyrer gjennom KJELDE-kompilator + VM. Programmet ligg i
# tests/fixtures/r1_bryt_prov.no.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/fixtures/r1_bryt_prov.no")
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la delar = builtin.split(tekst(vm.køyr_ncb(ncb)), "|")
    assert_eq(lengde(delar), 5)
    # p15: eit kast etter løkka går til kallaren, ikkje til ein gammal fang.
    assert_eq(delar[0], "a:rett-til-kallar [EtterLokke: a]")
    assert_eq(delar[1], "b:rett-til-kallar [EtterLokke: b]")
    # p05 g: Java-rekkjefølgja for fortsett/bryt gjennom endeleg.
    assert_eq(delar[2], "g-kropp0,g-endeleg0,g-endeleg2,g-endeleg2,g-etter i=2")
    # Nøsta prøv med fang+endeleg inni prøv+endeleg i ei for-lykkje.
    assert_eq(delar[3], "k1,ie1,ye1,ie2,ye2,ie3,ye3,etter")
    # bryt frå fang-blokka køyrer endeleg, og handleren er borte etterpå.
    assert_eq(delar[4], "f1,e1,e2,fanga:etter")
    returner 0
}
