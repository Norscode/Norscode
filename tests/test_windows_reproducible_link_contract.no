bruk std.tekst som t

funksjon start() -> heiltall {
    la kjelde = fil_les("tools/windows_runtime_cross_compile_gate.no")

    assert(t.inneholder(kjelde, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(kjelde, "prosess.køyr(executable, argv, cwd, miljø, 600000)"))
    assert(t.inneholder(kjelde, "\"-Wl,/Brepro\""))
    assert(t.inneholder(kjelde, "tools/normalize_pe_reproducible.no"))
    assert(t.inneholder(kjelde, "normaliser_pe(nc_bin, root, exe)"))
    assert(ikkje t.inneholder(kjelde, "exec_prosess"))
    assert(ikkje t.inneholder(kjelde, "funksjon shell("))
    assert(t.inneholder(kjelde, "NORSCODE_WINDOWS_OUT_DIR"))
    assert(t.inneholder(kjelde, "build/windows-repro-work"))
    assert(ikkje t.inneholder(kjelde, "work_dir = standard_dir"))
    assert(t.inneholder(kjelde, "builtin.mappe_opprett(work_dir)"))
    assert(t.inneholder(kjelde, "publish_dir != work_dir"))
    assert(t.inneholder(kjelde, "norscode_native_windows_x86_64.exe.embedded.exe"))
    assert(ikkje t.inneholder(kjelde, "mkdir -p"))
    assert(t.inneholder(kjelde, "NORSCODE_EMBED_SPECS\": specs"))

    skriv("test_windows_reproducible_link_contract OK\n")
    returner 0
}
