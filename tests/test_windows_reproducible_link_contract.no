bruk std.tekst som t

funksjon start() -> heiltall {
    la kjelde = fil_les("tools/build_windows_stage0_candidate.no")
    la embed = fil_les("tools/embed_release_ncb.no")

    assert(t.inneholder(kjelde, "bruk tools.embed_release_ncb som embed"))
    assert(t.inneholder(kjelde, "embed.stream_embed_med_lengder(base, out, namn, payloadar, payload_lengder)"))
    assert(t.inneholder(kjelde, "kandidat_a_hash != kandidat_b_hash"))
    assert(t.inneholder(kjelde, "ikkje den separate Gen1→Gen2-selfhost-porten"))
    assert(t.inneholder(kjelde, "windows_candidate_sha256="))
    assert(t.inneholder(kjelde, "windows_stage0_sha256="))
    assert(ikkje t.inneholder(kjelde, "exec_prosess"))
    assert(ikkje t.inneholder(kjelde, "funksjon shell("))
    assert(t.inneholder(kjelde, "NORSCODE_WINDOWS_CANDIDATE"))
    assert(t.inneholder(kjelde, "bootstrap/stage0/norscode-windows-x86_64.exe"))
    assert(t.inneholder(kjelde, "funksjon er_pe64"))
    assert(t.inneholder(embed, "eksisterande_text_image_start"))
    assert(t.inneholder(embed, "{\"payloads\": payload_map, \"format\": \"norscode-ncb-text-v1\"}"))
    assert(ikkje t.inneholder(kjelde, "mkdir -p"))
    assert(ikkje t.inneholder(kjelde, "zig"))
    assert(ikkje t.inneholder(kjelde, "native_candidate_gc.c"))

    skriv("test_windows_reproducible_link_contract OK\n")
    returner 0
}
