bruk tools.check_bootstrap_literal_expectations_v5600 som expectations
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "literal-expect-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    assert(filops.lag_katalogar(base))
    la krav = [
        ["list_literal.ncb.json", "BUILD_LIST"],
        ["empty_list.ncb.json", "BUILD_LIST"],
        ["map_literal.ncb.json", "BUILD_MAP"],
        ["index_expr.ncb.json", "INDEX_GET"],
        ["assignment_list.ncb.json", "BUILD_LIST"],
        ["assignment_map.ncb.json", "BUILD_MAP"],
        ["assignment_index.ncb.json", "INDEX_GET"]
    ]
    la i = 0
    mens i < lengde(krav) {
        builtin.fil_skriv(base + "/" + krav[i][0], "{\"op\":\"" + krav[i][1] + "\"}")
        i = i + 1
    }
    assert(expectations.sjekk(base))
    builtin.fil_skriv(base + "/assignment_index.ncb.json", "{\"op\":\"WRONG\"}")
    assert(ikkje expectations.sjekk(base))
    assert(filops.slett_tre(base))
    skriv("test_bootstrap_literal_expectations_native_live OK")
    returner 0
}
