# W5 (WASM-sporet): nettlesar-testbenken std/wasm_nettlesar.no og CLI-en
# tools/wasm_nettlesar.no.
#
#   1. Utan nettlesar: `NC_CHROME=/finst/ikkje nc run tools/wasm_nettlesar.no` gjev exit ≠ 0
#      og «fann ikkje nettlesar» (planen sin aksept). Ukjend modus gjev exit 2.
#   2. Tolking (utan nettlesar): loggen i #nc-logg (HTML-avescapa, NUL når han manglar),
#      «MÅL»-linjer, «Uncaught» i konsollen, og sidelastingstida frå ein netlogg med ein
#      førespurnad til eit anna opphav (skal ikkje telje) og ein som aldri vart ferdig.
#   3. Rydding: ein prosess med økt-mappa i kommandolinja (ein skal-lykkje) blir drepen av
#      benk.rydd, og ingen er att. Ein prosess utan mappa blir ikkje rørt (negativ kontroll),
#      og drep_med nektar ei nål utan benkmappe. SKIP utan pgrep.
#   4. jsc-skriptet: shimen og lastaren er emitterte frå Norscode-data (balanserte parentesar,
#      readFile med stien, «Uncaught»-fangaren), utan eval/Function.
#   5. Med Chrome (valfri, SKIP utan; NC_CHROME=<sti>): CLI-en i royk-modus gjev exit 0, og
#      med eit krav som ikkje finst exit 1 (royk diskriminerer). maal-modus: app-kjensle målt i
#      WASM-sida (tid frå hending til DOM-endring) og sidelastingstid frå netloggen, med
#      resultatfila i build/wasm-nettlesar/resultat/. Etter kvar køyring finn
#      `pgrep -f build/wasm-nettlesar` ingen prosessar.
#   6. jsc (valfri, SKIP utan): fire korpusprogram gjev fasiten i JavaScriptCore, og
#      kontroll_trap gjev «Uncaught».
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

# CLI-en i ein barneprosess i fastmodus med eit eksplisitt miljø.
funksjon køyr_cli(ekstra: ordbok_tekst) -> ordbok {
    la m = hjelp.grunnmiljø(hjelp.root())
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = hjelp.root() + "/tools/wasm_nettlesar.no"
    m["NORSCODE_VM_FAST"] = "1"
    m["NC_CHROME"] = miljo_hent("NC_CHROME")
    m["NC_JSC"] = miljo_hent("NC_JSC")
    m["NC_WASM_RT_CACHE"] = miljo_hent("NC_WASM_RT_CACHE")
    la nøk = ["NC_NETTLESAR_MODUS", "NC_NETTLESAR_KJELDE", "NC_NETTLESAR_APP", "NC_NETTLESAR_STI", "NC_NETTLESAR_KREV",
              "NC_NETTLESAR_TESTBYGG", "NC_NETTLESAR_PORT", "NC_NETTLESAR_GONGER"]
    la i = 0
    mens i < lengde(nøk) {
        m[nøk[i]] = ""
        i = i + 1
    }
    la k = nøkler(ekstra)
    i = 0
    mens i < lengde(k) {
        m[k[i]] = ekstra[k[i]]
        i = i + 1
    }
    returner hjelp.køyr_nc(m, 300000)
}

funksjon krev_ingen_prosessar(kva: tekst) -> heltall {
    la n = benk.tel_prosessar(benk.basismappe())
    hvis n != 0 {
        skriv(kva + ": " + tekst(n) + " prosessar med " + benk.basismappe() + " i kommandolinja er att\n")
        assert(usann)
    }
    returner 0
}

funksjon netlog_døme() -> tekst {
    la l = [
        "{\"constants\":{\"logEventTypes\":{\"REQUEST_ALIVE\":2,\"URL_REQUEST_START_JOB\":108,\"X\":3}},",
        "\"events\": [",
        "{\"params\":{\"url\":\"http://127.0.0.1:9/\"},\"phase\":1,\"source\":{\"id\":7,\"start_time\":\"1000\",\"type\":1},\"time\":\"1000\",\"type\":108},",
        "{\"params\":{\"url\":\"http://127.0.0.1:9/_nc/nc.js\"},\"phase\":1,\"source\":{\"id\":8,\"start_time\":\"1010\",\"type\":1},\"time\":\"1012\",\"type\":108},",
        "{\"params\":{\"url\":\"http://clients2.google.com/time\"},\"phase\":1,\"source\":{\"id\":9,\"start_time\":\"990\",\"type\":1},\"time\":\"990\",\"type\":108},",
        "{\"phase\":2,\"source\":{\"id\":7,\"start_time\":\"1000\",\"type\":1},\"time\":\"1005\",\"type\":2},",
        "{\"phase\":2,\"source\":{\"id\":9,\"start_time\":\"990\",\"type\":1},\"time\":\"1900\",\"type\":2},",
        "{\"params\":{\"url\":\"http://127.0.0.1:9/_nc/app.wasm?v=abc\"},\"phase\":1,\"source\":{\"id\":10,\"start_time\":\"1020\",\"type\":1},\"time\":\"1021\",\"type\":108},",
        "{\"phase\":2,\"source\":{\"id\":8,\"start_time\":\"1010\",\"type\":1},\"time\":\"1015\",\"type\":2},",
        "{\"phase\":2,\"source\":{\"id\":10,\"start_time\":\"1020\",\"type\":1},\"time\":\"1040\",\"type\":2},",
        "{\"params\":{\"url\":\"http://127.0.0.1:9/api/aldri\"},\"phase\":1,\"source\":{\"id\":11,\"start_time\":\"1050\",\"type\":1},\"time\":\"1050\",\"type\":108},"
    ]
    returner builtin.join(l, "\n")
}

funksjon tolking() -> heltall {
    # Loggen: avescapa, og NUL når elementet manglar
    assert_eq(benk.logg_frå_dom("<html><body><pre id=\"nc-logg\">a &lt;b&gt; &amp;amp;\nMÅL x=12\n</pre></body></html>"), "a <b> &amp;\nMÅL x=12\n")
    assert_eq(benk.logg_frå_dom("<html><body></body></html>"), builtin.chr(0))
    la m = benk.mål_frå_logg("før\nMÅL klikk_us=400\nMÅL feil=0\nikkje MÅL y=1\nMÅL utan_verdi\n")
    assert_eq(lengde(m), 2)
    assert_eq(m["klikk_us"], "400")
    assert_eq(m["feil"], "0")
    assert(benk.har_uncaught("[1:2:INFO:CONSOLE(1)] \"Uncaught (in promise) RuntimeError: unreachable\""))
    assert(ikkje benk.har_uncaught("[1:2:INFO:CONSOLE(1)] \"ERROR: x\""))
    # Netloggen: tre førespurnader til 127.0.0.1:9 er ferdige (dokument 5 ms, heile 40 ms);
    # clients2.google.com (anna opphav, slutt 1900) og /api/aldri (ingen slutt) tel ikkje.
    la s = benk.sidelasting_frå_netlog(netlog_døme(), "http://127.0.0.1:9/")
    skriv("netlog-døme: " + builtin.json_stringify(s) + "\n")
    assert_eq(s["dokument_ms"], 5)
    assert_eq(s["totalt_ms"], 40)
    assert_eq(s["førespurnader"], 3)
    assert_eq(s["stiar"]["/_nc/app.wasm"], 19)
    assert_eq(s["stiar"]["/_nc/nc.js"], 3)
    assert(ikkje finnes_nøkkel(s["stiar"], "/api/aldri"))
    assert_eq(lengde(benk.sidelasting_frå_netlog("", "http://127.0.0.1:9/")), 0)
    skriv("tolking OK\n")
    returner 0
}

funksjon rydding() -> heltall {
    hvis ikkje benk.har_pgrep() {
        skriv("rydding: SKIP (fann ikkje /usr/bin/pgrep)\n")
        returner 0
    }
    la økt = benk.ny_økt("test_w5_rydd")
    # Ein prosess med økt-mappa i kommandolinja ($0 til sh), som ikkje stoppar av seg sjølv
    la plan = benk.køyr_verktøy_plan("/bin/sh", ["-c", "while :; do sleep 1; done", økt["mappe"] + "/lykkje"])
    la h = benk.start_bakgrunn(plan)
    la plan2 = benk.køyr_verktøy_plan("/bin/sh", ["-c", "while :; do sleep 1; done", "/tmp/ikkje-benk-w5"])
    la h2 = benk.start_bakgrunn(plan2)
    la t0 = builtin.tid_ms()
    mens builtin.tid_ms() - t0 < 5000 og benk.tel_prosessar(økt["mappe"]) == 0 { }
    assert_eq(benk.tel_prosessar(økt["mappe"]), 1)
    la r = benk.rydd(økt)
    skriv("rydding: " + builtin.json_stringify(r) + "\n")
    assert_eq(r["drepne"], 1)
    assert_eq(r["attverande"], 0)
    assert_eq(benk.tel_prosessar(økt["mappe"]), 0)
    # Negativ kontroll: prosessen utan benkmappe lever framleis, og drep_med nektar nåla
    assert_eq(benk.tel_prosessar("/tmp/ikkje-benk-w5"), 1)
    la nekta = usann
    prøv {
        benk.drep_med("/tmp/ikkje-benk-w5")
    } fang (e) {
        nekta = inneheld(tekst(e), "nektar")
    }
    assert(nekta)
    benk.stopp(h2)
    benk.stopp(h)
    skriv("rydding OK\n")
    returner 0
}

funksjon jsc_skriptet() -> heltall {
    la l = benk.jsc_skript("/sti/til/app.wasm", ["asynk_iife", [["uttrykk", ["kall", ["felt", ["namn", "x"], "i"], []]]]])
    assert(inneheld(l, "readFile(\"/sti/til/app.wasm\",\"binary\")"))
    assert(inneheld(l, ".catch(a=>print(JSON.stringify(\"Uncaught \"+a)))"))
    assert(inneheld(l, "TextDecoder=Object.bind(null,{decode:"))
    assert(builtin.starts_with(l, "console={log:"))
    assert(ikkje inneheld(l, "eval"))
    assert(ikkje inneheld(l, "Function("))
    la djupn = 0
    la i = 0
    mens i < lengde(l) {
        la c = builtin.slice(l, i, i + 1)
        hvis c == "(" { djupn = djupn + 1 }
        hvis c == ")" { djupn = djupn - 1 }
        assert(djupn >= 0)
        i = i + 1
    }
    assert_eq(djupn, 0)
    skriv("jsc-skript OK (" + tekst(lengde(l)) + " B)\n")
    returner 0
}

funksjon med_chrome() -> heltall {
    # royk: teljar-demoen i produksjonsbygg
    la r = køyr_cli({"NC_NETTLESAR_PORT": "48481"})
    hvis r["exit"] != 0 eller ikkje inneheld(r["stdout"], "wasm_nettlesar: royk OK") {
        skriv("royk feila:\n" + r["stdout"] + r["stderr"] + "\n")
        assert(usann)
    }
    assert(inneheld(r["stdout"], "rydding: 0 prosessar drepne, 0 att") eller inneheld(r["stdout"], " prosessar drepne, 0 att"))
    krev_ingen_prosessar("etter royk")
    # royk diskriminerer: eit krav som ikkje finst i DOM-en gjev exit 1
    la r2 = køyr_cli({"NC_NETTLESAR_PORT": "48482", "NC_NETTLESAR_KREV": "<p id=\"sum\">Sum 1..n = <b>1</b>"})
    assert_eq(r2["exit"], 1)
    assert(inneheld(r2["stdout"], "royk: fann ikkje"))
    krev_ingen_prosessar("etter royk med feil krav")
    # maal: app-kjensle i skjema-demoen
    la før = builtin.tid_ms()
    la r3 = køyr_cli({"NC_NETTLESAR_MODUS": "maal", "NC_NETTLESAR_PORT": "48483", "NC_NETTLESAR_GONGER": "2"})
    hvis r3["exit"] != 0 {
        skriv("maal feila:\n" + r3["stdout"] + r3["stderr"] + "\n")
        assert(usann)
    }
    krev_ingen_prosessar("etter maal")
    la res = builtin.json_parse_raw(fil_les(hjelp.root() + "/" + benk.resultatmappe() + "/maal.json"))
    skriv("maal: " + builtin.json_stringify(res) + " (" + tekst(builtin.tid_ms() - før) + " ms)\n")
    assert_eq(res["feil"], 0)
    assert_eq(res["gonger"], 2)
    la k = ["filter_us", "klikk_us", "send_us"]
    la i = 0
    mens i < lengde(k) {
        # hendinga køyrde og tok tid, men under 50 ms per hending
        assert(res[k[i]] > 0)
        assert(res[k[i]] < 50000)
        i = i + 1
    }
    assert(res["sidelasting_ms"] > 0)
    assert(res["sidelasting_ms"] < 10000)
    assert_eq(lengde(res["sidelasting_alle"]), 2)
    skriv("Chrome-delen OK\n")
    returner 0
}

funksjon med_jsc(jsc: tekst) -> heltall {
    la rot = "build/wasm/test_w5/jsc"
    la prog = ["unntak_endeleg", "closure_fangst", "rt_json_feil", "w4_ordbok"]
    la i = 0
    mens i < lengde(prog) {
        la n = prog[i]
        la linje = hjelp.bygg_klient(kh.kjelde(n), rot + "/" + n, sann)
        la j = benk.jsc_køyr(jsc, rot + "/" + n)
        la f = kh.fasit(n)
        hvis j["logg"] != f eller j["uncaught"] {
            skriv(n + ": jsc skil seg frå fasiten, " + kh.skilnad(j["logg"], f) + "\njsc:\n" + j["logg"] + "\n" + j["stderr"] + "\nFasit:\n" + f + "\n")
            assert(usann)
        }
        i = i + 1
    }
    # Positiv kontroll: trapen når JavaScript
    hjelp.bygg_klient(kh.kjelde("kontroll_trap"), rot + "/kontroll_trap", sann)
    la kt = benk.jsc_køyr(jsc, rot + "/kontroll_trap")
    assert_eq(kt["logg"], "før\n")
    assert(kt["uncaught"])
    skriv("jsc: " + tekst(lengde(prog)) + " korpusprogram lik fasiten, kontroll_trap gav «Uncaught»\n")
    returner 0
}

funksjon start() -> heltall {
    hjelp.mkdir("build/wasm/test_w5")
    # ── 1. Utan nettlesar ──
    la r = køyr_cli({"NC_CHROME": "/finst/ikkje"})
    skriv("utan nettlesar: exit " + tekst(r["exit"]) + "\n")
    assert(r["exit"] != 0)
    assert(inneheld(r["stdout"], "fann ikkje nettlesar"))
    la r0 = køyr_cli({"NC_NETTLESAR_MODUS": "ukjend"})
    assert_eq(r0["exit"], 2)
    # ── 2–4 ──
    tolking()
    rydding()
    jsc_skriptet()
    # ── 5. Chrome ──
    hvis benk.finn_chrome() == "" {
        skriv("SKIP Chrome: fann ikkje Chrome/Chromium, set NC_CHROME=<sti>\n")
    } ellers {
        med_chrome()
    }
    # ── 6. jsc ──
    la jsc = benk.finn_jsc()
    hvis jsc == "" {
        skriv("SKIP jsc: fann ikkje JavaScriptCore, set NC_JSC=<sti>\n")
    } ellers {
        med_jsc(jsc)
    }
    skriv("test_wasm_w5 OK\n")
    returner 0
}
