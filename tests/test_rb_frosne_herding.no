# Herding av F46 etter kodegjennomgang (kjelde-kjeda: kompilator -> NCB -> selfhost/vm.no).
bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heiltall {
    la d = builtin.split(køyr(fil_les("tests/fixtures/rb_frosne_herding.no")), "|")
    assert_eq(lengde(d), 3)
    assert_eq(d[0], "usannsann21")
    assert_eq(d[1], "FrosenFeil1")
    assert_eq(d[2], "SamanlikningsFeil,sannusann")
    skriv("test_rb_frosne_herding OK")
    returner 0
}
