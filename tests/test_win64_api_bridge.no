// Koyr den ekte Win64-kallporten som x86-maskinkode med test-IAT paa Linux.
// Testen kontrollerer 12 argument, shadow space / 16-byte alignment, bevarte
// Linux-syscall-register, feilfangst og dei to faste Winsock extension-GUIDane.
// Dette er ABI-verifikasjon, ikkje eit substitutt for ekte Windows-attestasjon.
bruk selfhost.native_execution.win64_os som os
bruk selfhost.native_execution.win64_asm som asm
bruk selfhost.native_execution.elf_emitter som elf
bruk std.windows_abi som api
bruk std.runtime.process_abi som process

funksjon _check(a, reg: heiltall, expected: heiltall) -> heiltall {
    asm.cmp_i(a, reg, expected)
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    returner 0
}

funksjon _call(a, id: heiltall, args_va: heiltall, error: heiltall) -> heiltall {
    asm.mov_i64(a, asm.RDI(), id)
    asm.mov_i64(a, asm.RSI(), args_va)
    asm.mov_i64(a, asm.RDX(), 3333)
    asm.mov_i64(a, asm.R10(), 4444)
    asm.mov_i64(a, asm.R8(), 5555)
    asm.mov_i64(a, asm.R9(), 6666)
    asm.mov_i64(a, asm.RBP(), 7777)
    asm.call_etikett(a, "os_win_api")
    _check(a, asm.RAX(), 305419896)
    _check(a, asm.RDI(), id)
    _check(a, asm.RSI(), args_va)
    _check(a, asm.RDX(), 3333)
    _check(a, asm.R10(), 4444)
    _check(a, asm.R8(), 5555)
    _check(a, asm.R9(), 6666)
    _check(a, asm.RBP(), 7777)
    asm.ld(a, asm.RAX(), asm.RSI(), 96)
    _check(a, asm.RAX(), error)
    returner 0
}

funksjon image() -> liste_heiltall {
    la text_va: heiltall = 4198400
    la data_va: heiltall = 4259840
    la args_va = data_va + 2048
    la a = asm.ny()
    la entries = api.api_entries()
    la slots = {}
    la index: heiltall = 0
    for e i entries {
        hvis e[1] != "" { slots[tekst(e[1]) + "!" + tekst(e[2])] = index * 8 }
        index = index + 1
    }
    asm.mov_i64(a, asm.RAX(), args_va)
    la i: heiltall = 0
    mens i < 12 { asm.st_i(a, asm.RAX(), i * 8, i + 1) i = i + 1 }
    _call(a, 97, args_va, 777) // InitializeSecurityContextW har 12 argument.
    _call(a, 11, args_va, 777) // CreateProcessW brukar register + stackargument.
    _call(a, 72, args_va, 888) // Winsock sin separate feilkanal.
    _call(a, 89, args_va, 888) // AcceptEx via fast GUID.
    _call(a, 90, args_va, 888) // ConnectEx via fast GUID.
    asm.mov_i64(a, asm.RDI(), 9999)
    asm.mov_i64(a, asm.RSI(), args_va)
    asm.call_etikett(a, "os_win_api")
    _check(a, asm.RAX(), 0 - 22)
    asm.ld(a, asm.RAX(), asm.RSI(), 96)
    _check(a, asm.RAX(), 87)
    asm.mov_i32(a, asm.RAX(), 60)
    asm.xor(a, asm.RDI(), asm.RDI())
    asm.bs(a, [15, 5])
    asm.merk(a, "probe_bad")
    asm.mov_i32(a, asm.RAX(), 60)
    asm.mov_i32(a, asm.RDI(), 91)
    asm.bs(a, [15, 5])
    os.emit_win_api(a, slots, data_va)
    asm.merk(a, "test_api")
    asm.mov(a, asm.RAX(), asm.RSP())
    asm.and_i(a, asm.RAX(), 15)
    _check(a, asm.RAX(), 8)
    _check(a, asm.RCX(), 1)
    _check(a, asm.RDX(), 2)
    _check(a, asm.R8(), 3)
    _check(a, asm.R9(), 4)
    i = 4
    mens i < 12 {
        asm.ld(a, asm.RAX(), asm.RSP(), 40 + (i - 4) * 8)
        _check(a, asm.RAX(), i + 1)
        i = i + 1
    }
    // Win64 callee eig shadow space og kan klobre alle volatile register.
    i = 0
    mens i < 4 { asm.st_i(a, asm.RSP(), 8 + i * 8, 0 - 1) i = i + 1 }
    asm.mov_i32(a, asm.RDX(), 99)
    asm.mov_i32(a, asm.R8(), 99)
    asm.mov_i32(a, asm.R9(), 99)
    asm.mov_i32(a, asm.R10(), 99)
    asm.mov_i32(a, asm.RAX(), 305419896)
    asm.ret(a)
    asm.merk(a, "test_error")
    asm.mov_i32(a, asm.RAX(), 777)
    asm.ret(a)
    asm.merk(a, "test_wsa_error")
    asm.mov_i32(a, asm.RAX(), 888)
    asm.ret(a)
    asm.merk(a, "test_ioctl")
    _check(a, asm.RCX(), 1)
    // SIO_GET_EXTENSION_FUNCTION_POINTER er unsigned DWORD.
    asm.mov_i32(a, asm.RAX(), 3355443206)
    asm.cmp(a, asm.RDX(), asm.RAX())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    _check(a, asm.R9(), 16)
    asm.ld32(a, asm.RAX(), asm.R8(), 0)
    asm.mov_i32(a, asm.R11(), 3040247281) // b5367df1
    asm.cmp(a, asm.RAX(), asm.R11())
    asm.jcc(a, asm.CC_E(), "test_guid_ok")
    _check(a, asm.RAX(), 631375801) // 25a207b9
    asm.merk(a, "test_guid_ok")
    asm.ld(a, asm.R11(), asm.RSP(), 40)
    asm.lea_etikett(a, asm.RAX(), "test_api")
    asm.st(a, asm.R11(), 0, asm.RAX())
    asm.ld(a, asm.R11(), asm.RSP(), 56)
    asm.st_i(a, asm.R11(), 0, 8)
    asm.xor(a, asm.RAX(), asm.RAX())
    asm.ret(a)
    la text_bytes = asm.ferdig(a)
    assert(lengde(text_bytes) < 12288)
    la data: liste_heiltall = []
    for e i entries {
        la label = "test_api"
        hvis e[2] == "GetLastError" { label = "test_error" }
        hvis e[2] == "WSAGetLastError" { label = "test_wsa_error" }
        hvis e[2] == "WSAIoctl" { label = "test_ioctl" }
        elf.legg_u64_le(data, text_va + a["lab"][label])
    }
    mens lengde(data) < 4096 { legg_til(data, 0) }
    la out = elf.bygg_elf_header(text_va, 64, 2)
    for b i elf.bygg_program_header(1, 5, 4096, text_va, lengde(text_bytes), lengde(text_bytes), 4096) { legg_til(out, b) }
    for b i elf.bygg_program_header(1, 6, 16384, data_va, lengde(data), lengde(data), 4096) { legg_til(out, b) }
    mens lengde(out) < 4096 { legg_til(out, 0) }
    for b i text_bytes { legg_til(out, b) }
    mens lengde(out) < 16384 { legg_til(out, 0) }
    for b i data { legg_til(out, b) }
    returner out
}

funksjon start() -> heiltall {
    hvis tekst(builtin.native_target()) != "linux-x86_64" {
        skriv("test_win64_api_bridge krev Linux x86_64 for ELF-proben\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    builtin.mkdir_p(root + "/build/windows-abi")
    la path = root + "/build/windows-abi/call-probe.elf"
    fil_skriv_binær(path, image())
    builtin.fil_sett_kjorbar(path)
    la req = process.request(path, [], root, "", 5000, 4096)
    req = process.sett_sandbox(req, "none", 0, 64, sann)
    la r = builtin.process_spawn_argv(req)
    assert_eq(r["status"], "ferdig")
    assert_eq(tekst(r["exit_code"]), "0")
    skriv("test_win64_api_bridge OK\n")
    returner 0
}
