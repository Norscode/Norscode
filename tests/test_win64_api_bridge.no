// Koyr den ekte Win64-kallporten som x86-maskinkode med test-IAT paa Linux.
// Testen kontrollerer 12 argument, shadow space / 16-byte alignment, bevarte
// Linux-syscall-register, feilfangst, stioperasjonar og dei to faste Winsock
// extension-GUIDane. mkdir_p held R8/R9 levande over os_mkdir; Win32 skal
// få klobre dei utan at syscall-kallaren mistar buffer-/skannepeikarane.
// open/access/stat/rename avviser kvar mislukka UTF-16-konvertering før
// fil-API-et blir kalla; statbuf blir verande urørt ved feil.
// Dette er ABI-verifikasjon, ikkje eit substitutt for ekte Windows-attestasjon.
bruk selfhost.native_execution.win64_os som os
bruk selfhost.native_execution.win64_asm som asm
bruk selfhost.native_execution.elf_emitter som elf
bruk std.windows_abi som api
bruk std.runtime.process_abi som process

funksjon _check(a, reg: heiltall, expected: heiltall) -> heiltall {
    asm.cmp_i(a, reg, expected)
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    returner 0
}

funksjon _call(a, id: heiltall, args_va: heiltall, error: heiltall) -> heiltall {
    asm.mov_i64(a, asm.RDI(), id)
    asm.mov_i64(a, asm.RSI(), args_va)
    asm.mov_i64(a, asm.RDX(), 3333)
    asm.mov_i64(a, asm.R10(), 4444)
    asm.mov_i64(a, asm.R8(), 5555)
    asm.mov_i64(a, asm.R9(), 6666)
    asm.mov_i64(a, asm.RBP(), 7777)
    asm.call_etikett(a, "os_win_api")
    _check(a, asm.RAX(), 305419896)
    _check(a, asm.RDI(), id)
    _check(a, asm.RSI(), args_va)
    _check(a, asm.RDX(), 3333)
    _check(a, asm.R10(), 4444)
    _check(a, asm.R8(), 5555)
    _check(a, asm.R9(), 6666)
    _check(a, asm.RBP(), 7777)
    asm.ld(a, asm.RAX(), asm.RSI(), 96)
    _check(a, asm.RAX(), error)
    returner 0
}

funksjon _file_call(a, label: tekst, path_va: heiltall, second_arg: heiltall,
                   result_va: heiltall, api_result: heiltall, wide_old: heiltall,
                   wide_new: heiltall, expected: heiltall) -> heiltall {
    asm.mov_i64(a, asm.RAX(), result_va)
    // INVALID_FILE_ATTRIBUTES er ein zero-utvida DWORD, ikkje -1 som HANDLE.
    asm.mov_i64(a, asm.RDX(), api_result)
    asm.st(a, asm.RAX(), 0, asm.RDX())
    asm.st_i(a, asm.RAX(), 8, wide_old)
    asm.st_i(a, asm.RAX(), 16, 0)
    asm.st_i(a, asm.RAX(), 24, wide_new)
    asm.st_i(a, asm.RAX(), 32, 0)
    // Forventa CreateFileW-access/disposition, uavhengig av emitteren.
    la access = 2147483648
    hvis (second_arg & 3) != 0 { access = 3221225472 }
    asm.mov_i64(a, asm.RDX(), access)
    asm.st(a, asm.RAX(), 48, asm.RDX())
    la disposition = 3
    hvis (second_arg & 64) != 0 { disposition = 2 }
    asm.st_i(a, asm.RAX(), 56, disposition)
    hvis label == "os_stat" {
        asm.mov_i64(a, asm.RAX(), second_arg)
        asm.st_i(a, asm.RAX(), 24, 4660)
    }
    asm.mov_i64(a, asm.RDI(), path_va)
    asm.mov_i64(a, asm.RSI(), second_arg)
    asm.mov_i64(a, asm.RDX(), 3333)
    asm.mov_i64(a, asm.R10(), 4444)
    asm.mov_i64(a, asm.R8(), 5555)
    asm.mov_i64(a, asm.R9(), 6666)
    asm.mov_i64(a, asm.RBP(), 7777)
    asm.mov_i64(a, asm.RBX(), 8888)
    asm.mov_i64(a, asm.R12(), 1212)
    asm.mov_i64(a, asm.R13(), 1313)
    asm.mov_i64(a, asm.R14(), 1414)
    asm.mov_i64(a, asm.R15(), 1515)
    asm.call_etikett(a, label)
    _check(a, asm.RAX(), expected)
    _check(a, asm.RDI(), path_va)
    _check(a, asm.RSI(), second_arg)
    _check(a, asm.RDX(), 3333)
    _check(a, asm.R10(), 4444)
    _check(a, asm.R8(), 5555)
    _check(a, asm.R9(), 6666)
    _check(a, asm.RBP(), 7777)
    _check(a, asm.RBX(), 8888)
    _check(a, asm.R12(), 1212)
    _check(a, asm.R13(), 1313)
    _check(a, asm.R14(), 1414)
    _check(a, asm.R15(), 1515)
    // Ein mislukka UTF-16-konvertering må aldri nå fil-/katalogkallet,
    // sjølv når dette kallet ville returnert den same feilkoden.
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.RAX(), asm.RAX(), 16)
    hvis wide_old == 0 eller (label == "os_rename" og wide_new == 0) { _check(a, asm.RAX(), 0) }
    ellers { _check(a, asm.RAX(), 1) }
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.RAX(), asm.RAX(), 32)
    hvis label == "os_rename" og wide_old != 0 { _check(a, asm.RAX(), 2) }
    ellers { _check(a, asm.RAX(), 1) }
    hvis label == "os_stat" {
        la mode = 4660
        hvis expected == 0 {
            mode = 32768
            hvis (api_result & 16) != 0 { mode = 16384 }
        }
        asm.mov_i64(a, asm.RAX(), second_arg)
        asm.ld32(a, asm.RAX(), asm.RAX(), 24)
        _check(a, asm.RAX(), mode)
    }
    returner 0
}

funksjon _win64_clobber(a) -> heiltall {
    // Win64 eig fire shadow-slotar og alle desse volatile registera.
    la i = 0
    mens i < 4 { asm.st_i(a, asm.RSP(), 8 + i * 8, 0 - 1) i = i + 1 }
    asm.mov_i32(a, asm.RCX(), 99)
    asm.mov_i32(a, asm.RDX(), 99)
    asm.mov_i32(a, asm.R8(), 99)
    asm.mov_i32(a, asm.R9(), 99)
    asm.mov_i32(a, asm.R10(), 99)
    asm.mov_i32(a, asm.R11(), 99)
    returner 0
}

// close og lseek er òg Linux-forma syscall-portar. Eit Win32-kall kan
// klobre heile den volatile registermengda sjølv når det returnerer feil.
funksjon _handle_call(a, label: tekst, fd: heiltall, result_va: heiltall,
                     api_result: heiltall, expected: heiltall) -> heiltall {
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.st_i(a, asm.RAX(), 0, api_result)
    asm.st_i(a, asm.RAX(), 16, 0)
    asm.mov_i64(a, asm.RDI(), fd)
    asm.mov_i64(a, asm.RSI(), 5678)
    asm.mov_i64(a, asm.RDX(), 2)
    asm.mov_i64(a, asm.R10(), 4444)
    asm.mov_i64(a, asm.R8(), 5555)
    asm.mov_i64(a, asm.R9(), 6666)
    asm.mov_i64(a, asm.RBP(), 7777)
    asm.call_etikett(a, label)
    _check(a, asm.RAX(), expected)
    _check(a, asm.RDI(), fd)
    _check(a, asm.RSI(), 5678)
    _check(a, asm.RDX(), 2)
    _check(a, asm.R10(), 4444)
    _check(a, asm.R8(), 5555)
    _check(a, asm.R9(), 6666)
    _check(a, asm.RBP(), 7777)
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.RAX(), asm.RAX(), 16)
    hvis label == "os_close" og fd <= 2 { _check(a, asm.RAX(), 0) }
    ellers { _check(a, asm.RAX(), 1) }
    returner 0
}

funksjon _sys_call(a, label: tekst, args, result_va: heiltall,
                  api_result: heiltall, expected: heiltall, calls: heiltall) -> heiltall {
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.st_i(a, asm.RAX(), 0, api_result)
    asm.st_i(a, asm.RAX(), 8, 2) // vellykka UTF-16-konvertering av spawn-kommandolinja
    asm.st_i(a, asm.RAX(), 16, 0)
    asm.st_i(a, asm.RAX(), 32, 0)
    la allokering = args[1]
    hvis label == "os_win_spawn" { allokering = 65536 }
    asm.st_i(a, asm.RAX(), 64, allokering)
    la utbuffer = args[0]
    la kapasitet = args[1]
    hvis label == "os_readlink" { utbuffer = args[1] kapasitet = args[2] }
    asm.st_i(a, asm.RAX(), 72, utbuffer)
    asm.st_i(a, asm.RAX(), 80, kapasitet)
    la regs = [asm.RDI(), asm.RSI(), asm.RDX(), asm.R10(), asm.R8(), asm.R9()]
    la i = 0
    mens i < lengde(regs) { asm.mov_i64(a, regs[i], args[i]) i = i + 1 }
    la saved = [asm.RBP(), asm.RBX(), asm.R12(), asm.R13(), asm.R14(), asm.R15()]
    i = 0
    mens i < lengde(saved) { asm.mov_i64(a, saved[i], 7000 + i) i = i + 1 }
    asm.call_etikett(a, label)
    _check(a, asm.RAX(), expected)
    i = 0
    mens i < lengde(regs) { _check(a, regs[i], args[i]) i = i + 1 }
    i = 0
    mens i < lengde(saved) { _check(a, saved[i], 7000 + i) i = i + 1 }
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.RAX(), asm.RAX(), 16)
    _check(a, asm.RAX(), calls)
    hvis (label == "os_getcwd" eller label == "os_readlink") og api_result != 0 {
        asm.mov_i64(a, asm.RAX(), utbuffer)
        asm.ld(a, asm.RAX(), asm.RAX(), 0)
        _check(a, asm.RAX(), 112) // "p\0" frå WideCharToMultiByte
    }
    hvis label == "os_win_spawn" {
        asm.mov_i64(a, asm.RAX(), result_va)
        asm.ld(a, asm.RAX(), asm.RAX(), 32)
        _check(a, asm.RAX(), 1) // cmdline konvertert før kontrollert allokeringsfeil
    }
    returner 0
}

funksjon image() -> liste_heiltall {
    la text_va: heiltall = 4198400
    la data_va: heiltall = 4259840
    la args_va = data_va + 2048
    la path_va = data_va + 3072
    la new_path_va = path_va + 4
    la result_va = data_va + 3080
    la stat_va = data_va + 3200
    la timespec_va = data_va + 3400
    la buffer_va = data_va + 3500
    la a = asm.ny()
    la entries = api.api_entries()
    // Desse eldre OSTAB-portane har eigne importar utan offentleg API-ID.
    legg_til(entries, [0, "KERNEL32.dll", "GetCurrentDirectoryW"])
    legg_til(entries, [0, "KERNEL32.dll", "GetModuleFileNameW"])
    la slots = {}
    la index: heiltall = 0
    for e i entries {
        hvis e[1] != "" { slots[tekst(e[1]) + "!" + tekst(e[2])] = index * 8 }
        index = index + 1
    }
    asm.mov_i64(a, asm.RAX(), args_va)
    la i: heiltall = 0
    mens i < 12 { asm.st_i(a, asm.RAX(), i * 8, i + 1) i = i + 1 }
    _call(a, 97, args_va, 777) // InitializeSecurityContextW har 12 argument.
    _call(a, 11, args_va, 777) // CreateProcessW brukar register + stackargument.
    _call(a, 72, args_va, 888) // Winsock sin separate feilkanal.
    _call(a, 89, args_va, 888) // AcceptEx via fast GUID.
    _call(a, 90, args_va, 888) // ConnectEx via fast GUID.
    asm.mov_i64(a, asm.RDI(), 9999)
    asm.mov_i64(a, asm.RSI(), args_va)
    asm.call_etikett(a, "os_win_api")
    _check(a, asm.RAX(), 0 - 22)
    asm.ld(a, asm.RAX(), asm.RSI(), 96)
    _check(a, asm.RAX(), 87)
    // Kall dei verkelege emitterte stiportane, med ein Win32-vert som
    // medvite øydelegg volatile register og shadow space ved kvart kall.
    for spec i [["os_mkdir", 0 - 17], ["os_unlink", 0 - 21], ["os_rmdir", 0 - 2]] {
        _file_call(a, tekst(spec[0]), path_va, 511, result_va, 1, 2, 2, 0)
        _file_call(a, tekst(spec[0]), path_va, 511, result_va, 0, 2, 2, spec[1])
        _file_call(a, tekst(spec[0]), path_va, 511, result_va, 1, 0, 2, spec[1])
    }
    _file_call(a, "os_access", path_va, 0, result_va, 0, 2, 2, 0)
    _file_call(a, "os_access", path_va, 0, result_va, 4294967295, 2, 2, 0 - 2)
    _file_call(a, "os_access", path_va, 0, result_va, 0, 0, 2, 0 - 2)
    // OPEN_EXISTING/GENERIC_READ og O_CREAT|O_RDWR går framleis til rett Win32-argument.
    _file_call(a, "os_open", path_va, 0, result_va, 1234, 2, 2, 1234)
    _file_call(a, "os_open", path_va, 66, result_va, 1234, 2, 2, 1234)
    _file_call(a, "os_open", path_va, 66, result_va, 0 - 1, 2, 2, 0 - 2)
    _file_call(a, "os_open", path_va, 66, result_va, 1234, 0, 2, 0 - 2)
    _file_call(a, "os_stat", path_va, stat_va, result_va, 0, 2, 2, 0)
    _file_call(a, "os_stat", path_va, stat_va, result_va, 16, 2, 2, 0)
    _file_call(a, "os_stat", path_va, stat_va, result_va, 4294967295, 2, 2, 0 - 2)
    _file_call(a, "os_stat", path_va, stat_va, result_va, 16, 0, 2, 0 - 2)
    _file_call(a, "os_rename", path_va, new_path_va, result_va, 1, 2, 2, 0)
    _file_call(a, "os_rename", path_va, new_path_va, result_va, 0, 2, 2, 0 - 2)
    _file_call(a, "os_rename", path_va, new_path_va, result_va, 1, 0, 2, 0 - 2)
    _file_call(a, "os_rename", path_va, new_path_va, result_va, 1, 2, 0, 0 - 2)
    _handle_call(a, "os_close", 1234, result_va, 1, 0)
    _handle_call(a, "os_close", 1234, result_va, 0, 0 - 9)
    _handle_call(a, "os_close", 0, result_va, 0, 0)
    _handle_call(a, "os_close", 1, result_va, 0, 0)
    _handle_call(a, "os_close", 2, result_va, 0, 0)
    _handle_call(a, "os_lseek", 1234, result_va, 1, 9876)
    _handle_call(a, "os_lseek", 1234, result_va, 0, 0 - 29)
    asm.mov_i64(a, asm.RAX(), timespec_va)
    asm.st_i(a, asm.RAX(), 0, 1)
    asm.st_i(a, asm.RAX(), 8, 234000000)
    _sys_call(a, "os_nanosleep", [timespec_va, 2222, 3333, 4444, 5555, 6666], result_va, 0, 0, 1)
    _sys_call(a, "os_getcwd", [buffer_va, 32, 3333, 4444, 5555, 6666], result_va, 2, 2, 2)
    _sys_call(a, "os_getcwd", [buffer_va, 32, 3333, 4444, 5555, 6666], result_va, 0, 0, 2)
    _sys_call(a, "os_readlink", [path_va, buffer_va, 32, 4444, 5555, 6666], result_va, 2, 1, 2)
    _sys_call(a, "os_readlink", [path_va, buffer_va, 32, 4444, 5555, 6666], result_va, 0, 0 - 1, 2)
    _sys_call(a, "os_mmap", [0, 5678, 3333, 4444, 5555, 6666], result_va, 16384, 16384, 1)
    _sys_call(a, "os_mmap", [0, 5678, 3333, 4444, 5555, 6666], result_va, 0, 0 - 12, 1)
    // Den eksisterande spawn-feilvegen ved VirtualAlloc(NULL) krev ingen
    // prosess. Han må likevel bevare alle syscall-registera og returnere -1.
    _sys_call(a, "os_win_spawn", [path_va, 0, buffer_va, 32, timespec_va, 6666], result_va, 0, 0 - 1, 1)
    asm.mov_i32(a, asm.RAX(), 60)
    asm.xor(a, asm.RDI(), asm.RDI())
    asm.bs(a, [15, 5])
    asm.merk(a, "probe_bad")
    asm.mov_i32(a, asm.RAX(), 60)
    asm.mov_i32(a, asm.RDI(), 91)
    asm.bs(a, [15, 5])
    os.emit_win_api(a, slots, data_va)
    os.emit_path_bool(a, slots, data_va, "os_mkdir", "KERNEL32.dll!CreateDirectoryW", 0 - 17)
    os.emit_path_bool(a, slots, data_va, "os_unlink", "KERNEL32.dll!DeleteFileW", 0 - 21)
    os.emit_path_bool(a, slots, data_va, "os_rmdir", "KERNEL32.dll!RemoveDirectoryW", 0 - 2)
    os.emit_access(a, slots, data_va)
    os.emit_open(a, slots, data_va)
    os.emit_stat(a, slots, data_va)
    os.emit_rename(a, slots, data_va)
    os.emit_close(a, slots, data_va)
    os.emit_lseek(a, slots, data_va)
    os.emit_nanosleep(a, slots, data_va)
    os.emit_getcwd(a, slots, data_va)
    os.emit_readlink(a, slots, data_va)
    os.emit_mmap(a, slots, data_va)
    os.emit_win_spawn(a, slots, data_va)
    asm.merk(a, "test_api")
    asm.mov(a, asm.RAX(), asm.RSP())
    asm.and_i(a, asm.RAX(), 15)
    _check(a, asm.RAX(), 8)
    _check(a, asm.RCX(), 1)
    _check(a, asm.RDX(), 2)
    _check(a, asm.R8(), 3)
    _check(a, asm.R9(), 4)
    i = 4
    mens i < 12 {
        asm.ld(a, asm.RAX(), asm.RSP(), 40 + (i - 4) * 8)
        _check(a, asm.RAX(), i + 1)
        i = i + 1
    }
    // Win64 callee eig shadow space og kan klobre alle volatile register.
    i = 0
    mens i < 4 { asm.st_i(a, asm.RSP(), 8 + i * 8, 0 - 1) i = i + 1 }
    asm.mov_i32(a, asm.RDX(), 99)
    asm.mov_i32(a, asm.R8(), 99)
    asm.mov_i32(a, asm.R9(), 99)
    asm.mov_i32(a, asm.R10(), 99)
    asm.mov_i32(a, asm.RAX(), 305419896)
    asm.ret(a)
    asm.merk(a, "test_error")
    asm.mov_i32(a, asm.RAX(), 777)
    asm.ret(a)
    asm.merk(a, "test_wsa_error")
    asm.mov_i32(a, asm.RAX(), 888)
    asm.ret(a)
    asm.merk(a, "test_ioctl")
    _check(a, asm.RCX(), 1)
    // SIO_GET_EXTENSION_FUNCTION_POINTER er unsigned DWORD.
    asm.mov_i32(a, asm.RAX(), 3355443206)
    asm.cmp(a, asm.RDX(), asm.RAX())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    _check(a, asm.R9(), 16)
    asm.ld32(a, asm.RAX(), asm.R8(), 0)
    asm.mov_i32(a, asm.R11(), 3040247281) // b5367df1
    asm.cmp(a, asm.RAX(), asm.R11())
    asm.jcc(a, asm.CC_E(), "test_guid_ok")
    _check(a, asm.RAX(), 631375801) // 25a207b9
    asm.merk(a, "test_guid_ok")
    asm.ld(a, asm.R11(), asm.RSP(), 40)
    asm.lea_etikett(a, asm.RAX(), "test_api")
    asm.st(a, asm.R11(), 0, asm.RAX())
    asm.ld(a, asm.R11(), asm.RSP(), 56)
    asm.st_i(a, asm.R11(), 0, 8)
    asm.xor(a, asm.RAX(), asm.RAX())
    asm.ret(a)
    asm.merk(a, "test_path_wide")
    asm.mov(a, asm.RAX(), asm.RSP())
    asm.and_i(a, asm.RAX(), 15)
    _check(a, asm.RAX(), 8)
    _check(a, asm.RCX(), 65001)
    _check(a, asm.RDX(), 0)
    _check(a, asm.R9(), 0 - 1)
    asm.ld(a, asm.RAX(), asm.RSP(), 48)
    _check(a, asm.RAX(), 2048)
    asm.mov_i64(a, asm.R10(), result_va)
    asm.ld(a, asm.R11(), asm.R10(), 32)
    asm.cmp_i(a, asm.R11(), 0)
    asm.jcc(a, asm.CC_E(), "test_path_wide_old")
    _check(a, asm.R11(), 1)
    _check(a, asm.R8(), new_path_va)
    asm.ld(a, asm.RAX(), asm.R10(), 24)
    asm.mov_i32(a, asm.RDX(), 113) // L"q", skil ny sti frå gammal sti.
    asm.jmp(a, "test_path_wide_selected")
    asm.merk(a, "test_path_wide_old")
    _check(a, asm.R8(), path_va)
    asm.ld(a, asm.RAX(), asm.R10(), 8)
    asm.mov_i32(a, asm.RDX(), 112) // L"p"
    asm.merk(a, "test_path_wide_selected")
    asm.st(a, asm.R10(), 40, asm.RAX())
    asm.add_i(a, asm.R11(), 1)
    asm.st(a, asm.R10(), 32, asm.R11())
    asm.tst(a, asm.RAX(), asm.RAX())
    asm.jcc(a, asm.CC_E(), "test_path_wide_result")
    // UTF-16-resultatet må liggje utanfor Win64-API-et sitt shadow space.
    asm.ld(a, asm.RAX(), asm.RSP(), 40)
    asm.st(a, asm.RAX(), 0, asm.RDX()) // UTF-16-teikn og nullterminator
    asm.merk(a, "test_path_wide_result")
    _win64_clobber(a)
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.RAX(), asm.RAX(), 40)
    asm.ret(a)
    asm.merk(a, "test_path_open")
    asm.mov_i64(a, asm.R10(), result_va)
    asm.ld(a, asm.RAX(), asm.R10(), 48)
    asm.cmp(a, asm.RDX(), asm.RAX())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    _check(a, asm.R8(), 7)
    _check(a, asm.R9(), 0)
    asm.ld(a, asm.RAX(), asm.RSP(), 40)
    asm.ld(a, asm.R11(), asm.R10(), 56)
    asm.cmp(a, asm.RAX(), asm.R11())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    asm.ld(a, asm.RAX(), asm.RSP(), 48)
    _check(a, asm.RAX(), 128)
    asm.ld(a, asm.RAX(), asm.RSP(), 56)
    _check(a, asm.RAX(), 0)
    asm.jmp(a, "test_path_api")
    asm.merk(a, "test_path_move")
    asm.ld(a, asm.RAX(), asm.RDX(), 0)
    _check(a, asm.RAX(), 113)
    _check(a, asm.R8(), 3)
    asm.jmp(a, "test_path_api")
    asm.merk(a, "test_path_mkdir")
    _check(a, asm.RDX(), 0) // lpSecurityAttributes = NULL
    asm.merk(a, "test_path_api")
    asm.mov(a, asm.RAX(), asm.RSP())
    asm.and_i(a, asm.RAX(), 15)
    _check(a, asm.RAX(), 8)
    asm.ld(a, asm.RAX(), asm.RCX(), 0)
    _check(a, asm.RAX(), 112)
    _win64_clobber(a)
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.st_i(a, asm.RAX(), 16, 1)
    asm.ld(a, asm.RAX(), asm.RAX(), 0)
    asm.ret(a)
    asm.merk(a, "test_sleep")
    _check(a, asm.RCX(), 1234)
    asm.jmp(a, "test_sys_return")
    asm.merk(a, "test_mmap")
    _check(a, asm.RCX(), 0)
    _check(a, asm.R8(), 12288)
    _check(a, asm.R9(), 4)
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.RAX(), asm.RAX(), 64)
    asm.cmp(a, asm.RDX(), asm.RAX())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    asm.jmp(a, "test_sys_return")
    asm.merk(a, "test_getcwd")
    _check(a, asm.RCX(), 2048)
    asm.jmp(a, "test_wide_output")
    asm.merk(a, "test_readlink")
    _check(a, asm.RCX(), 0)
    _check(a, asm.R8(), 2048)
    asm.merk(a, "test_wide_output")
    asm.st_i(a, asm.RDX(), 0, 112) // L"p\0"
    asm.jmp(a, "test_sys_return")
    asm.merk(a, "test_utf8_output")
    _check(a, asm.RCX(), 65001)
    _check(a, asm.RDX(), 0)
    _check(a, asm.R9(), 0 - 1)
    asm.ld(a, asm.RAX(), asm.R8(), 0)
    _check(a, asm.RAX(), 112)
    asm.mov_i64(a, asm.R10(), result_va)
    asm.ld(a, asm.RAX(), asm.RSP(), 40) // lpMultiByteStr
    asm.ld(a, asm.R11(), asm.R10(), 72)
    asm.cmp(a, asm.RAX(), asm.R11())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    asm.st_i(a, asm.RAX(), 0, 112) // "p\0"
    asm.ld(a, asm.RAX(), asm.RSP(), 48) // cbMultiByte
    asm.ld(a, asm.R11(), asm.R10(), 80)
    asm.cmp(a, asm.RAX(), asm.R11())
    asm.jcc(a, asm.CC_NE(), "probe_bad")
    asm.ld(a, asm.RAX(), asm.RSP(), 56)
    _check(a, asm.RAX(), 0)
    asm.ld(a, asm.RAX(), asm.RSP(), 64)
    _check(a, asm.RAX(), 0)
    asm.merk(a, "test_sys_return")
    asm.mov(a, asm.RAX(), asm.RSP())
    asm.and_i(a, asm.RAX(), 15)
    _check(a, asm.RAX(), 8)
    _win64_clobber(a)
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.ld(a, asm.R10(), asm.RAX(), 16)
    asm.add_i(a, asm.R10(), 1)
    asm.st(a, asm.RAX(), 16, asm.R10())
    asm.ld(a, asm.RAX(), asm.RAX(), 0)
    asm.ret(a)
    asm.merk(a, "test_handle_seek")
    _check(a, asm.RDX(), 5678)
    _check(a, asm.R9(), 2)
    asm.st_i(a, asm.R8(), 0, 9876)
    asm.merk(a, "test_handle_close")
    asm.mov(a, asm.RAX(), asm.RSP())
    asm.and_i(a, asm.RAX(), 15)
    _check(a, asm.RAX(), 8)
    _check(a, asm.RCX(), 1234)
    _win64_clobber(a)
    asm.mov_i64(a, asm.RAX(), result_va)
    asm.st_i(a, asm.RAX(), 16, 1)
    asm.ld(a, asm.RAX(), asm.RAX(), 0)
    asm.ret(a)
    la text_bytes = asm.ferdig(a)
    assert(lengde(text_bytes) < 28672)
    la data: liste_heiltall = []
    for e i entries {
        la label = "test_api"
        hvis e[2] == "GetLastError" { label = "test_error" }
        hvis e[2] == "WSAGetLastError" { label = "test_wsa_error" }
        hvis e[2] == "WSAIoctl" { label = "test_ioctl" }
        hvis e[2] == "MultiByteToWideChar" { label = "test_path_wide" }
        hvis e[2] == "CreateDirectoryW" { label = "test_path_mkdir" }
        hvis e[2] == "DeleteFileW" eller e[2] == "RemoveDirectoryW" { label = "test_path_api" }
        hvis e[2] == "GetFileAttributesW" { label = "test_path_api" }
        hvis e[2] == "CreateFileW" { label = "test_path_open" }
        hvis e[2] == "MoveFileExW" { label = "test_path_move" }
        hvis e[2] == "CloseHandle" { label = "test_handle_close" }
        hvis e[2] == "SetFilePointerEx" { label = "test_handle_seek" }
        hvis e[2] == "Sleep" { label = "test_sleep" }
        hvis e[2] == "VirtualAlloc" { label = "test_mmap" }
        hvis e[2] == "GetCurrentDirectoryW" { label = "test_getcwd" }
        hvis e[2] == "GetModuleFileNameW" { label = "test_readlink" }
        hvis e[2] == "WideCharToMultiByte" { label = "test_utf8_output" }
        elf.legg_u64_le(data, text_va + a["lab"][label])
    }
    mens lengde(data) < 4096 { legg_til(data, 0) }
    la out = elf.bygg_elf_header(text_va, 64, 2)
    for b i elf.bygg_program_header(1, 5, 4096, text_va, lengde(text_bytes), lengde(text_bytes), 4096) { legg_til(out, b) }
    for b i elf.bygg_program_header(1, 6, 32768, data_va, lengde(data), lengde(data), 4096) { legg_til(out, b) }
    mens lengde(out) < 4096 { legg_til(out, 0) }
    for b i text_bytes { legg_til(out, b) }
    mens lengde(out) < 32768 { legg_til(out, 0) }
    for b i data { legg_til(out, b) }
    returner out
}

funksjon start() -> heiltall {
    hvis tekst(builtin.native_target()) != "linux-x86_64" {
        skriv("test_win64_api_bridge krev Linux x86_64 for ELF-proben\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    builtin.mkdir_p(root + "/build/windows-abi")
    la path = root + "/build/windows-abi/call-probe.elf"
    fil_skriv_binær(path, image())
    builtin.fil_sett_kjorbar(path)
    la req = process.request(path, [], root, "", 5000, 4096)
    req = process.sett_sandbox(req, "none", 0, 64, sann)
    la r = builtin.process_spawn_argv(req)
    assert_eq(r["status"], "ferdig")
    assert_eq(tekst(r["exit_code"]), "0")
    skriv("test_win64_api_bridge OK\n")
    returner 0
}
