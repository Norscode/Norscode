# Hjelpar for R5-testar: kompilerer eit program frå KJELDE og slår saman alle
# modular det importerer (std.*, tests.*, rekursivt) til éin NCB, slik at
# programmet kan bruke std.samtid, std.kanal osv. i den kjelde-bygde VM-en
# (nc test sin sjølvlasta VM er eldre enn endringane som blir testa).

bruk selfhost.kompiler som kompiler
bruk selfhost.bundler som bundler

funksjon bygg_ncb(kjelde: tekst) {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la inits = []
    la importar = {}
    bundler.registrer_modulimportar(importar, ncb, "__main__")
    la kø = []
    la sett = {}
    legg_inn(kø, sett, ncb)
    la mi = 0
    mens mi < lengde(kø) {
        la m = kø[mi]
        mi = mi + 1
        la sti = builtin.replace(m, ".", "/") + ".no"
        la mncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les(sti), m))
        bundler.slå_saman_funksjonar(ncb["functions"], mncb["functions"])
        bundler.slå_saman_modulmetadata(inits, ncb["global_names"], mncb)
        bundler.registrer_modulimportar(importar, mncb, m)
        legg_inn(kø, sett, mncb)
    }
    bundler.slå_saman_modulmetadata(inits, ncb["global_names"], ncb)
    ncb["module_initializers"] = bundler.ordne_initialiserarar(inits, importar, "__main__")
    returner ncb
}

funksjon legg_inn(kø, sett, ncb) -> heiltall {
    hvis ikkje har_nokkel(ncb, "imports") eller ncb["imports"] == null { returner 0 }
    la l = ncb["imports"]
    la i = 0
    mens i < lengde(l) {
        la navn = tekst(l[i])
        hvis ikkje har_nokkel(sett, navn) og (builtin.starts_with(navn, "std.") eller builtin.starts_with(navn, "tests.")) {
            sett[navn] = sann
            legg_til(kø, navn)
        }
        i = i + 1
    }
    returner 0
}
