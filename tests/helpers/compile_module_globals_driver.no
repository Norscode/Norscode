bruk selfhost.kompiler som komp
bruk selfhost.lexer.lexer_m1 som lexer
bruk selfhost.parser som parser

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/fixtures/module_globals.no")
    la ast = parser.parse_program(lexer.lex(kjelde))
    fil_skriv("build/module_globals_ast.json", builtin.json_stringify(ast))
    la ncb = komp.kompiler_fil(kjelde, "tests.fixtures.module_globals")
    fil_skriv("build/module_globals_v39.ncb.json", ncb)
    skriv("module globals fixture compiled\n")
    returner 0
}
