# R1 / F12: hovudtråden i eit program som ventar på ein VENTANDE future skal
# ikkje avslutte stilt (før: VM-en suspenderte, entry returnerte future-
# handtaket og resten av programmet køyrde aldri). Grøne trådar blir drivne til
# futuren er avgjord; kan ingen avgjere han, blir det eit fangbart FutureFeil.
# Ikkje-daemon grøne trådar blir joina ved programslutt; daemon-trådar og
# kansellerte trådar held ikkje programmet i live.
# Køyrer gjennom KJELDE-kompilator + VM (vm.køyr_ncb = programkøyring).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon spawn_kjelde() -> tekst {
    returner "funksjon spawn(fn: tekst, args: ordbok_tekst, daemon: tekst) -> ordbok_tekst {\n" +
        "    returner builtin.thread_spawn({\"abi\": \"norscode-native-thread-v1\", \"operation\": \"spawn\", \"fn\": fn,\n" +
        "        \"args\": args, \"name\": fn, \"stack_bytes\": \"65536\", \"daemon\": daemon})\n" +
        "}\n"
}

funksjon start() -> heiltall {
    # 1) Await på ein ventande future som ingen kan fullføre: fangbart FutureFeil,
    #    og programmet held fram etter fang-blokka.
    la p_ingen = "funksjon start() -> tekst {\n" +
        "    la ut = \"\"\n" +
        "    prøv {\n" +
        "        la v = await {\"__future__\": \"sann\", \"status\": \"ventende\", \"verdi\": \"\", \"feil\": \"\"}\n" +
        "        ut = \"INGEN-FEIL\"\n" +
        "    } fang (e: FutureFeil) {\n" +
        "        ut = \"FANGA\"\n" +
        "    }\n" +
        "    returner ut + \";SLUTT\"\n" +
        "}\n"
    la ncb1 = builtin.json_parse_raw(kompiler.kompiler_fil(p_ingen, "__main__"))
    assert_eq(tekst(vm.køyr_ncb(ncb1)), "FANGA;SLUTT")

    # 2) Await på ein future som ein grøn tråd fullfører: hovudtråden driv
    #    tråden og får verdien.
    la p_traad = spawn_kjelde() +
        "funksjon fullfør(args) -> heiltall {\n" +
        "    builtin.vent.sov(20)\n" +
        "    la f = args[\"f\"]\n" +
        "    f[\"verdi\"] = 42\n" +
        "    f[\"status\"] = \"ferdig\"\n" +
        "    returner 0\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    la f = {\"__future__\": \"sann\", \"status\": \"ventende\", \"verdi\": \"\", \"feil\": \"\"}\n" +
        "    spawn(\"__main__.fullfør\", {\"f\": f}, \"usann\")\n" +
        "    la v = await f\n" +
        "    returner \"v=\" + tekst(v)\n" +
        "}\n"
    la ncb2 = builtin.json_parse_raw(kompiler.kompiler_fil(p_traad, "__main__"))
    assert_eq(tekst(vm.køyr_ncb(ncb2)), "v=42")

    # 3) Ikkje-daemon-tråd blir joina ved programslutt (globalen blir sett etter
    #    at start() har returnert); ein kansellert evig tråd og ein daemon-tråd
    #    hindrar ikkje slutten.
    la p_exit = spawn_kjelde() +
        "la teljar: heiltall = 0\n" +
        "funksjon arbeid(args) -> heiltall {\n" +
        "    builtin.vent.sov(30)\n" +
        "    teljar = teljar + 1\n" +
        "    returner 0\n" +
        "}\n" +
        "funksjon evig(args) -> heiltall {\n" +
        "    mens sann { builtin.vent.sov(5) }\n" +
        "    returner 0\n" +
        "}\n" +
        "funksjon start() -> heiltall {\n" +
        "    spawn(\"__main__.arbeid\", {}, \"usann\")\n" +
        "    la k = spawn(\"__main__.evig\", {}, \"usann\")\n" +
        "    builtin.thread_sync({\"abi\": \"norscode-native-thread-v1\", \"operation\": \"cancel\", \"handle\": k[\"handle\"],\n" +
        "        \"thread_id\": k[\"thread_id\"], \"mutex_handle\": \"\", \"timeout_ms\": \"0\"})\n" +
        "    spawn(\"__main__.evig\", {}, \"sann\")\n" +
        "    returner teljar\n" +
        "}\n"
    la ncb3 = builtin.json_parse_raw(kompiler.kompiler_fil(p_exit, "__main__"))
    assert_eq(tekst(vm.køyr_ncb(ncb3)), "0")
    la globalar = ncb3["functions"]["__vm_globals__"]["__main__"]
    assert_eq(tekst(globalar["teljar"]), "1")

    skriv("test_r1_hovudtraad_await OK\n")
    returner 0
}
