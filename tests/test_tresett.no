# Test for std.tresett (sortert sett oppå std.tremap).
# Sjekkar gjev eksplisitte samanlikningar (ikkje assert) slik at testen òg
# feilar i native AOT, der assert er no-op.
bruk std.tresett som ts

funksjon _lj(l) -> tekst {
    la s = ""
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { s = s + "," }
        s = s + tekst(l[i])
        i = i + 1
    }
    returner s
}

funksjon _vis(v) -> tekst {
    hvis builtin.type(v) == "ingenting" { returner "<ingenting>" }
    returner tekst(v)
}

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

funksjon _tresett(res: ordbok) {
    la s = ts.ny()
    _sjekk(res, "sett tomt", tekst(ts.er_tom(s)) + "|" + _vis(ts.første(s)), "sann|<ingenting>")
    _sjekk(res, "sett legg_til", tekst(ts.legg_til(s, 5)), "sann")
    ts.legg_til(s, -3)
    ts.legg_til(s, 0)
    ts.legg_til(s, 12)
    _sjekk(res, "sett duplikat", tekst(ts.legg_til(s, 5)), "usann")
    _sjekk(res, "sett storleik", tekst(ts.storleik(s)), "4")
    _sjekk(res, "sett liste", _lj(ts.til_liste(s)), "-3,0,5,12")
    _sjekk(res, "sett inneheld", tekst(ts.inneheld(s, 0)) + tekst(ts.inneheld(s, 1)), "sannusann")
    _sjekk(res, "sett golv/tak", _vis(ts.golv(s, 4)) + "/" + _vis(ts.tak(s, 4)), "0/5")
    _sjekk(res, "sett lågare/høgare", _vis(ts.lågare(s, 0)) + "/" + _vis(ts.høgare(s, 12)), "-3/<ingenting>")
    _sjekk(res, "sett område", _lj(ts.område(s, 0, 12)), "0,5")
    _sjekk(res, "sett hovud/hale", _lj(ts.hovud(s, 5)) + "|" + _lj(ts.hale(s, 5)), "-3,0|5,12")
    _sjekk(res, "sett synkande", _lj(ts.til_liste_synkande(s)), "12,5,0,-3")
    _sjekk(res, "sett fjern", tekst(ts.fjern(s, 0)) + tekst(ts.fjern(s, 0)), "sannusann")
    _sjekk(res, "sett ta_første/siste", tekst(ts.ta_første(s)) + "/" + tekst(ts.ta_siste(s)), "-3/12")
    _sjekk(res, "sett att", ts.til_tekst(s), "[5]")

    la a = ts.frå_liste([5, 1, 3, 1, 9])
    la b = ts.frå_liste([3, 4, 5])
    _sjekk(res, "frå_liste dedup", _lj(ts.til_liste(a)), "1,3,5,9")
    _sjekk(res, "union", _lj(ts.til_liste(ts.union(a, b))), "1,3,4,5,9")
    _sjekk(res, "snitt", _lj(ts.til_liste(ts.snitt(a, b))), "3,5")
    _sjekk(res, "differanse", _lj(ts.til_liste(ts.differanse(a, b))), "1,9")
    _sjekk(res, "a urørt", _lj(ts.til_liste(a)), "1,3,5,9")
    _sjekk(res, "delmengd", tekst(ts.er_delmengd(ts.frå_liste([3, 5]), a)) + tekst(ts.er_delmengd(b, a)), "sannusann")

    la ord = ts.frå_liste_med(["ccc", "a", "bb", "dd"], fun(x, y) -> lengde(x) - lengde(y))
    _sjekk(res, "sett komparator (lik lengd = duplikat)", _lj(ts.til_liste(ord)), "a,bb,ccc")
    la syn = ts.ny_synkande()
    ts.legg_til(syn, "b")
    ts.legg_til(syn, "a")
    ts.legg_til(syn, "c")
    _sjekk(res, "sett synkande orden", _lj(ts.til_liste(syn)), "c,b,a")
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}
    _tresett(res)
    hvis res["feil"] != 0 {
        skriv("test_tresett FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_tresett OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
