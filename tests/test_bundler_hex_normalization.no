bruk selfhost.bundler som bundler

funksjon start() -> heiltall {
    la heks_i_streng = "{\"verdi\":\"0x10\",\"stor\":\"0X2A\"}"
    assert(ikkje bundler.har_heks_utanfor_streng(heks_i_streng))
    assert(bundler.normaliser_json_heks(heks_i_streng) == heks_i_streng)

    la heks_token = "{\"verdi\":0x10,\"stor\":0X2A}"
    assert(bundler.har_heks_utanfor_streng(heks_token))
    assert(bundler.normaliser_json_heks(heks_token) == "{\"verdi\":16,\"stor\":42}")

    skriv("test_bundler_hex_normalization OK\n")
    returner 0
}
