bruk std.pg som pg

// H3: TLS 1.3 mot ein ekte Postgres med SSL (std.tls13_klient, rein Norscode).
// Køyrer berre når NORSCODE_PG_TEST_TLS_DSN og NORSCODE_PG_TEST_TLS_CA er sette:
//   NORSCODE_PG_TEST_TLS_DSN = "host=127.0.0.1 port=55436 dbname=test user=norscode password=hemmeleg-pw"
//   NORSCODE_PG_TEST_TLS_CA  = sti til PEM-fila med tenarsertifikatet (sjølvsignert) eller CA-en
// Valfritt:
//   NORSCODE_PG_TEST_DSN           = tenar UTAN TLS (testar require mot tenar utan TLS, og prefer-fallback)
//   NORSCODE_PG_TEST_TLS_EC_DSN/_EC_CA = same, men for tenar med ECDSA-P256-sertifikat
// Eit anna sertifikat enn tenaren sitt (tests/fixtures/tls/localhost.crt) gir «feil CA».
// Handtrykket kostar ~20 s i den tolka VM-en (P-256 ECDH i rein Norscode), så testen held antalet
// handtrykk lågt.

funksjon _feilmelding(dsn: tekst) -> tekst {
    la melding = ""
    prøv {
        la c = pg.open(dsn)
        pg.close(c)
    } fang (e) {
        melding = tekst(e)
    }
    returner melding
}

funksjon _har(s: tekst, del: tekst) -> boolsk {
    returner builtin.index_of(s, del) >= 0
}

funksjon _test_ende_til_ende(dsn: tekst, ca: tekst) {
    la t0 = tid_ms()
    la c = pg.open(dsn + " sslmode=verify-full sslrootcert=" + ca)
    skriv("test_pg_tls: handtrykk + oppstart ms " + tekst(tid_ms() - t0) + "\n")
    assert(pg.er_tilkopla(c))
    assert(_har(pg.tls_info(c), "TLSv1.3"))
    // Tenaren stadfestar at tilkoplinga er kryptert.
    assert_eq(pg.query_verdi(c, "SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()", []), "t")
    assert_eq(pg.query_verdi(c, "SELECT version FROM pg_stat_ssl WHERE pid = pg_backend_pid()", []), "TLSv1.3")
    // Parametrar, fleire rader og lengre svar går gjennom record-laget.
    assert_eq(pg.query_verdi(c, "SELECT $1::int + $2::int", ["40", "2"]), "42")
    la rader = pg.query_raw(c, "SELECT g AS n, repeat('x', 100) AS t FROM generate_series(1, 30) g")
    assert_eq(lengde(rader), 30)
    assert_eq(rader[29]["n"], "30")
    assert_eq(lengde(rader[0]["t"]), 100)
    // Bytestrengar går uendra over TLS.
    assert_eq(pg.query_verdi(c, "SELECT $1::text", ["Åse"]), "Åse")
    pg.close(c)
    assert(ikkje pg.er_tilkopla(c))
}

funksjon start() -> heiltall {
    la dsn = miljo_hent("NORSCODE_PG_TEST_TLS_DSN")
    la ca = miljo_hent("NORSCODE_PG_TEST_TLS_CA")
    hvis dsn == "" eller ca == "" {
        skriv("test_pg_tls: HOPPA OVER (NORSCODE_PG_TEST_TLS_DSN/NORSCODE_PG_TEST_TLS_CA ikkje sett)\n")
        returner 0
    }

    // Feilsituasjonar som stoppar før eller rett etter handtrykket (billige).
    // 1) sslmode=require utan sslrootcert: ingen modus utan verifisering.
    la f1 = _feilmelding(dsn + " sslmode=require")
    assert(_har(f1, "sslrootcert manglar"))
    // 2) Ukjend sslmode.
    assert(_har(_feilmelding(dsn + " sslmode=allow"), "ukjend sslmode"))
    // 3) sslrootcert peiker på ei fil som ikkje finst.
    assert(_har(_feilmelding(dsn + " sslmode=require sslrootcert=/finst/ikkje.crt"), "sslrootcert"))
    // 4) Tenar utan TLS med sslmode=require: feil.
    la utan = miljo_hent("NORSCODE_PG_TEST_DSN")
    hvis utan != "" {
        la f4 = _feilmelding(utan + " sslmode=require sslrootcert=" + ca)
        assert(_har(f4, "støttar ikkje TLS"))
        // prefer fell tilbake til klartekst når tenaren svarar 'N'.
        la c = pg.open(utan + " sslmode=prefer sslrootcert=" + ca)
        assert_eq(pg.tls_info(c), "")
        assert_eq(pg.query_verdi(c, "SELECT 1", []), "1")
        pg.close(c)
    }
    // 5) Feil CA-fil: eit anna sertifikat enn tenaren sitt.
    la f5 = _feilmelding(dsn + " sslmode=verify-full sslrootcert=tests/fixtures/tls/localhost.crt")
    assert(_har(f5, "ikkje signert av noko sertifikat i ca_fil") eller _har(f5, "ikkje knytt til ca_fil"))
    // 6) Feil vertsnamn: koplar til hostaddr, men sertifikatet gjeld ikkje namnet.
    la f6 = _feilmelding(dsn + " hostaddr=127.0.0.1 host=feil.example.com sslmode=verify-full sslrootcert=" + ca)
    assert(_har(f6, "gjeld ikkje vertsnamnet"))

    // Det fulle handtrykket mot ekte Postgres: pg_stat_ssl.ssl = true.
    _test_ende_til_ende(dsn, ca)

    // ECDSA-P256-sertifikat (valfritt).
    la ec_dsn = miljo_hent("NORSCODE_PG_TEST_TLS_EC_DSN")
    la ec_ca = miljo_hent("NORSCODE_PG_TEST_TLS_EC_CA")
    hvis ec_dsn != "" og ec_ca != "" {
        _test_ende_til_ende(ec_dsn, ec_ca)
    }

    skriv("test_pg_tls OK\n")
    returner 0
}
