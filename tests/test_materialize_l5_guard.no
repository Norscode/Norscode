// J1b-review: tools/materialize_l5_precompiled.no skal aldri skrive til den
// committa bootstrap/precompiled, uansett stiform. Den gamle vakta
// (ends_with(katalog, "bootstrap/precompiled")) slapp gjennom til dømes ein
// avsluttande «/». Testen kallar den verkelege vaktfunksjonen i verktøyet og
// krev både nei (alle omskrivingar av stien) og ja (genererte katalogar), så
// porten må kunne diskriminere.
bruk tools.materialize_l5_precompiled som mat

funksjon krav(v: boolsk, melding: tekst) {
    hvis ikkje v { kast melding }
}

funksjon start() -> heiltall {
    la nekt = [
        "bootstrap/precompiled",
        "bootstrap/precompiled/",
        "bootstrap/precompiled//",
        "./bootstrap/precompiled",
        "bootstrap//precompiled",
        "bootstrap/./precompiled/.",
        "bootstrap/precompiled/../precompiled",
        "bootstrap/x/../precompiled",
        "build/../bootstrap/precompiled",
        "/w/bootstrap/precompiled",
        "/w/bootstrap/precompiled/",
        "bootstrap/precompiled/under"
    ]
    la i: heiltall = 0
    mens i < lengde(nekt) {
        krav(mat.er_committa_precompiled(nekt[i]), "vakta må nekte " + nekt[i])
        i = i + 1
    }
    la tillat = [
        "build/l5/precompiled",
        "build/l5/precompiled/",
        "/w/build/l5/precompiled",
        "bootstrap/precompiled_fragments",
        "bootstrap/precompiled_fragments_inner",
        "bootstrap/precompiled/..",
        "bootstrap/precompiledx",
        "mybootstrap/precompiled",
        "precompiled/bootstrap"
    ]
    i = 0
    mens i < lengde(tillat) {
        krav(ikkje mat.er_committa_precompiled(tillat[i]), "vakta skal tillate " + tillat[i])
        i = i + 1
    }
    skriv("test_materialize_l5_guard OK\n")
    returner 0
}
