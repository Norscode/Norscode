# M10 — standardargument: funksjon f(a, b = 1). Manglande argument blir fylt
# med standardverdien ved funksjonsinngang. Køyrer gjennom KJELDE-kompilator+VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    la p1 = "funksjon add(a: heltall, b: heltall = 10) -> heltall { returner a + b }\n" +
        "funksjon start() -> heltall { returner add(5) }\n"
    assert_eq(utfor(p1), "15")
    la p2 = "funksjon add(a: heltall, b: heltall = 10) -> heltall { returner a + b }\n" +
        "funksjon start() -> heltall { returner add(5, 100) }\n"
    assert_eq(utfor(p2), "105")

    la p3 = "funksjon f(a: heltall, b: heltall = 10, c: heltall = 20) -> heltall { returner a + b + c }\n" +
        "funksjon start() -> heltall { returner f(1) }\n"
    assert_eq(utfor(p3), "31")
    la p4 = "funksjon f(a: heltall, b: heltall = 10, c: heltall = 20) -> heltall { returner a + b + c }\n" +
        "funksjon start() -> heltall { returner f(1, 2) }\n"
    assert_eq(utfor(p4), "23")
    la p5 = "funksjon f(a: heltall, b: heltall = 10, c: heltall = 20) -> heltall { returner a + b + c }\n" +
        "funksjon start() -> heltall { returner f(1, 2, 3) }\n"
    assert_eq(utfor(p5), "6")

    la p6 = "funksjon f(a: heltall, b: heltall = 2 * 5) -> heltall { returner a + b }\n" +
        "funksjon start() -> heltall { returner f(1) }\n"
    assert_eq(utfor(p6), "11")

    la p7 = "funksjon g(a: heltall, b: heltall) -> heltall { returner a * b }\n" +
        "funksjon start() -> heltall { returner g(6, 7) }\n"
    assert_eq(utfor(p7), "42")

    skriv("test_standardarg OK\n")
    returner 0
}
