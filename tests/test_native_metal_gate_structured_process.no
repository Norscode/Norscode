bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/native_metal_gpu_gate.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(executable, argv, cwd, miljø, timeout_ms)"))
    assert(t.inneholder(src, "builtin.system_info()"))
    assert(t.inneholder(src, "[\"-O2\", \"-fobjc-arc\", source"))
    assert(t.inneholder(src, "[\"test\"]"))
    assert(t.inneholder(src, "\"NC_TEST_FILE\": \"tests/test_tensor_metal_backend.no\""))
    assert(t.inneholder(src, "\"NC_TEST_FILE\": \"tests/test_media_diffusion_backend.no\""))
    assert(t.inneholder(src, "Fase 5-overgangsløype"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "cd " + "\""))
    assert(ikkje t.inneholder(src, "uname -s"))
    skriv("test_native_metal_gate_structured_process OK")
    returner 0
}
