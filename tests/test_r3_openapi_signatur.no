// R3 trinn 8 (3.4): OpenAPI frå handlar-signaturen. Path- og query-parametrar med
// typen frå signaturen (påkravd når standardverdi manglar, «default», «T?» som anyOf
// med null, liste<T> som array), requestBody frå strukturparametrar ($ref, eller eit
// objekt per parameter når dei er fleire), respons-$ref frå returtypen (òg
// liste<Struktur>), components/schemas frå strukturane og 422 der binding kan feile.
bruk std.web som web
bruk tests.fixtures.r3_signatur_app som fx
bruk tests.fixtures.r3_signatur_meta som m

funksjon _param(op, namn: tekst) {
    la ps = op["parameters"]
    la i = 0
    mens i < lengde(ps) {
        hvis ps[i]["name"] == namn { returner ps[i] }
        i = i + 1
    }
    returner null
}

funksjon test_openapi() -> heltall {
    la spec = builtin.json_parse_raw(web.openapi_json_med({"ruter": m.rutemetadata()}))
    la hent = spec["paths"]["/personar/{id}"]["get"]
    la pid = _param(hent, "id")
    assert_eq(pid["in"], "path")
    assert_eq(pid["schema"]["type"], "integer")
    la pdet = _param(hent, "detaljar")
    assert_eq(pdet["in"], "query")
    assert_eq(pdet["schema"]["type"], "boolean")
    assert(ikkje pdet["required"])
    assert(ikkje pdet["schema"]["default"])
    assert_eq(_param(hent, "ctx"), null)
    assert_eq(hent["responses"]["200"]["content"]["application/json"]["schema"]["$ref"], "#/components/schemas/PersonUt")
    assert(finnes_nøkkel(hent["responses"], "422"))
    la sok = spec["paths"]["/sok"]["get"]
    assert(_param(sok, "q")["required"])
    assert_eq(_param(sok, "q")["schema"]["type"], "string")
    assert_eq(tekst(_param(sok, "n")["schema"]["default"]), "10")
    assert_eq(_param(sok, "n")["schema"]["type"], "integer")
    la lag = spec["paths"]["/personar"]["post"]
    assert(lag["requestBody"]["required"])
    assert_eq(lag["requestBody"]["content"]["application/json"]["schema"]["$ref"], "#/components/schemas/Person")
    la to = spec["paths"]["/to"]["post"]["requestBody"]["content"]["application/json"]["schema"]
    assert_eq(to["properties"]["a"]["$ref"], "#/components/schemas/Adresse")
    assert_eq(to["properties"]["p"]["$ref"], "#/components/schemas/Person")
    assert_eq(builtin.join(to["required"], ","), "a,p")
    assert_eq(_param(spec["paths"]["/tal/{n}"]["get"], "n")["schema"]["type"], "integer")
    assert(ikkje finnes_nøkkel(spec["paths"]["/gamal"]["get"]["responses"], "422"))
    la sk = spec["components"]["schemas"]
    la person = sk["Person"]
    assert_eq(person["properties"]["namn"]["type"], "string")
    assert_eq(person["properties"]["alder"]["type"], "integer")
    assert_eq(tekst(person["properties"]["alder"]["default"]), "0")
    assert_eq(person["properties"]["adresse"]["$ref"], "#/components/schemas/Adresse")
    assert_eq(builtin.join(person["required"], ","), "namn,adresse")
    assert_eq(sk["Adresse"]["properties"]["nr"]["type"], "integer")
    assert(finnes_nøkkel(sk, "PersonUt"))
    assert(finnes_nøkkel(sk, "HTTPValidationError"))
    la pl = spec["paths"]["/personliste"]["get"]
    assert_eq(pl["responses"]["200"]["content"]["application/json"]["schema"]["type"], "array")
    assert_eq(pl["responses"]["200"]["content"]["application/json"]["schema"]["items"]["$ref"], "#/components/schemas/PersonUt")
    assert_eq(_param(pl, "t")["schema"]["items"]["type"], "integer")
    assert(_param(pl, "t")["required"])
    assert(ikkje _param(pl, "merke")["required"])
    assert_eq(_param(pl, "merke")["schema"]["anyOf"][1]["type"], "null")
    la ad = spec["paths"]["/adresser"]["post"]["requestBody"]["content"]["application/json"]["schema"]
    assert_eq(ad["items"]["$ref"], "#/components/schemas/Adresse")
    returner 0
}

funksjon start() -> heltall {
    test_openapi()
    skriv("test_r3_openapi_signatur OK\n")
    returner 0
}
