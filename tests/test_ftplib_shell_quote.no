bruk std.tekst som t
bruk std.ftplib som ftp

funksjon start() -> heiltall {
    la src = fil_les("std/ftplib.no")
    assert(t.inneholder(src, "Kontrollkanalen er persistent"))
    assert(t.inneholder(src, "_kommando(f, \"EPSV\")"))
    assert(t.inneholder(src, "_kommando(f, \"PASV\")"))
    assert(t.inneholder(src, "sok.native_les_hex"))
    assert(t.inneholder(src, "sok.native_skriv_hex"))
    assert(t.inneholder(src, "builtin.fil_append_binary"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "curl "))

    la ugyldig = ftp.connect("vert\ninjeksjon", 21)
    assert(ugyldig["tilkopla"] == "usann")
    assert(ikkje ftp.login(ugyldig, "brukar\nUSER x", "pass"))
    assert(lengde(ftp.nlst(ugyldig, "../")) == 0)
    assert(ikkje ftp.retrbinary(ugyldig, "../fil", "/tmp/fil"))
    assert(ftp.size(ugyldig, "../fil") == -1)
    skriv("test_ftplib_shell_quote OK")
    returner 0
}
