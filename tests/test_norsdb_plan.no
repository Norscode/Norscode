// Fase 7l/8e: EXPLAIN (scan vs indeks-søk) + prepared statements (pre-tokenisert, ?-binding).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (1, 'Ada', 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (2, 'Linus', 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (3, 'Bjørn', 'Bergen')")

    // EXPLAIN: utan indeks → full skann
    assert_eq(sql.explain(db, "SELECT * FROM folk WHERE by = 'Oslo'"), "SCAN folk")
    // Med indeks → indeks-søk
    sql.exec(db, "CREATE INDEX idx_by ON folk (by)")
    assert_eq(sql.explain(db, "SELECT * FROM folk WHERE by = 'Oslo'"), "SEARCH folk USING INDEX (by)")

    // Prepared statement: pre-tokenisert, køyrt fleire gonger med ulike parametrar
    la st = sql.prepar(db, "SELECT navn FROM folk WHERE by = ? ORDER BY navn")
    assert_eq(sql.kjor_forberedt_rader(db, st, ["Oslo"]), "Ada\nLinus")
    assert_eq(sql.kjor_forberedt_rader(db, st, ["Bergen"]), "Bjørn")

    // Prepared count
    la st2 = sql.prepar(db, "SELECT count(*) FROM folk WHERE by = ?")
    assert_eq(sql.kjor_forberedt_int(db, st2, ["Oslo"]), 2)

    // Prepared INSERT (DML) m/ params
    la sti = sql.prepar(db, "INSERT INTO folk (id, navn, by) VALUES (?, ?, ?)")
    sql.kjor_forberedt(db, sti, ["4", "Kari", "Oslo"])
    assert_eq(sql.query_int(db, "SELECT count(*) FROM folk WHERE by = 'Oslo'"), 3)

    returner 0
}
