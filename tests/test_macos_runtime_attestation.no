bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/macos_runtime_attestation.no")
    assert(t.inneholder(src, "norscode-macos-runtime-attestation-v1"))
    assert(t.inneholder(src, "tests/test_macho_arm64_aot_cli.no"))
    assert(t.inneholder(src, "tests/test_process_os_sandbox.no"))
    assert(t.inneholder(src, "NORSCODE_EXPECT_SANDBOX_BACKEND"))
    assert(t.inneholder(src, "tests/test_native_tls_event_loop.no"))
    assert(t.inneholder(src, "builtin.sha256_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(src, "NORSCODE_SOURCE_COMMIT"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_macos_runtime_attestation OK\n")
    returner 0
}
