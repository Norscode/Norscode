bruk tools.update_stage0_manifest som manifest
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "stage0-manifest-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    assert(filops.lag_katalogar(base + "/bootstrap/stage0"))
    la a = builtin.bytes_from_list([0, 255, 1])
    la b = builtin.bytes_from_list([7, 8, 9])
    builtin.fil_skriv_binær(base + "/bootstrap/stage0/norscode-linux-x86_64", a)
    builtin.fil_skriv_binær(base + "/bootstrap/stage0/norscode-macos-arm64", b)
    builtin.fil_skriv(base + "/bootstrap/stage0/IGNORER", "x")
    assert(manifest.skriv_manifest(base))
    la body = builtin.fil_les(base + "/bootstrap/stage0/SHA256SUMS")
    la line_a = sha256.hash_bytes(a) + "  bootstrap/stage0/norscode-linux-x86_64"
    la line_b = sha256.hash_bytes(b) + "  bootstrap/stage0/norscode-macos-arm64"
    assert(builtin.index_of(body, line_a) >= 0)
    assert(builtin.index_of(body, line_b) >= 0)
    assert(builtin.index_of(body, "IGNORER") < 0)
    assert(builtin.index_of(body, line_a) < builtin.index_of(body, line_b))
    assert(filops.slett_tre(base))
    skriv("test_update_stage0_manifest_native_live OK")
    returner 0
}
