bruk std.pg som pg
bruk std.pg_csv som csv

// Reine kodek-testar (ingen tilkopling): prosent-dekoding av postgres-URL-ar, COPY text-escapes,
// og CSV med ESCAPE != QUOTE.

funksjon _test_url_dsn() {
    // Utan prosent-escapes: uendra
    assert_eq(pg._url_til_dsn("postgresql://u:p@h:5433/db"), "host=h port=5433 dbname=db user=u password=p")
    assert_eq(pg._url_til_dsn("postgres://u@h/db"), "host=h port=5432 dbname=db user=u password=")
    // %40 (@), %3A (:), %2F (/), %25 (%)
    la p = pg._parse_dsn(pg._url_til_dsn("postgresql://u:p%40ss@host/db"))
    assert_eq(p["password"], "p@ss")
    assert_eq(p["user"], "u")
    assert_eq(p["host"], "host")
    la p2 = pg._parse_dsn(pg._url_til_dsn("postgresql://a%3Ab:x%2Fy%3Az%25w@h/d%2Fb"))
    assert_eq(p2["user"], "a:b")
    assert_eq(p2["password"], "x/y:z%w")
    assert_eq(p2["dbname"], "d/b")
    assert_eq(p2["host"], "h")
    // Mellomrom og sitat i passord overlever DSN-runden
    la p3 = pg._parse_dsn(pg._url_til_dsn("postgresql://u:a%20b%27c%5Cd@h/db"))
    assert_eq(p3["password"], "a b'c\\d")
    assert_eq(p3["dbname"], "db")
    // Query-verdiar blir dekoda
    la p4 = pg._parse_dsn(pg._url_til_dsn("postgresql://u@h/db?sslmode=verify-full&sslrootcert=%2Ftmp%2Fmy%20ca.pem"))
    assert_eq(p4["sslmode"], "verify-full")
    assert_eq(p4["sslrootcert"], "/tmp/my ca.pem")
    // UTF-8: %C3%A6 = «æ» (to bytar i bytestreng-modellen, same som kjeldeliteralen)
    la p5 = pg._parse_dsn(pg._url_til_dsn("postgresql://u:%C3%A6%C3%B8%C3%A5@h/db"))
    assert_eq(p5["password"], "æøå")
    // Ugyldig %-escape blir ståande
    assert_eq(pg._prosent_dekod("100%"), "100%")
    assert_eq(pg._prosent_dekod("a%zzb"), "a%zzb")
    assert_eq(pg._prosent_dekod("%41%62"), "Ab")
}

funksjon _test_copy_avkod() {
    assert_eq(pg._copy_avkod("a\\tb\\nc\\rd"), "a\tb\nc\rd")
    assert_eq(pg._copy_avkod("\\\\"), "\\")
    assert_eq(pg._copy_avkod("\\b\\f\\v"), builtin.chr(8) + builtin.chr(12) + builtin.chr(11))
    // \N er NULL berre som heilt felt
    assert_eq(pg._copy_avkod("\\N"), pg.sql_null())
    assert_eq(pg._copy_avkod("a\\Nb"), "aNb")
    // oktal (1-3 siffer) og hex (1-2 siffer)
    assert_eq(pg._copy_avkod("\\101\\102"), "AB")
    assert_eq(pg._copy_avkod("\\7x"), builtin.chr(7) + "x")
    assert_eq(pg._copy_avkod("\\0411"), "!1")
    assert_eq(pg._copy_avkod("\\x41\\x4a"), "AJ")
    assert_eq(pg._copy_avkod("\\x4"), builtin.chr(4))
    assert_eq(pg._copy_avkod("\\x414"), "A4")
    assert_eq(pg._copy_avkod("\\xZ"), "xZ")
    // UTF-8 som rå bytar: \303\246 = «æ»
    assert_eq(pg._copy_avkod("\\303\\246"), "æ")
    // anna teikn: teiknet sjølv
    assert_eq(pg._copy_avkod("\\q\\."), "q.")
}

funksjon _test_csv_escape() {
    la v = csv.valg("COPY t FROM STDIN WITH (FORMAT csv, QUOTE '\"', ESCAPE '\\')")
    assert_eq(v["esc"], "\\")
    // Rund-tur: sitert felt med backslash
    la rad = ["a\\b", "x,y\\z", "sitat\"er"]
    la linje = csv.kod_rad(rad, v)
    assert_eq(linje, "a\\b,\"x,y\\\\z\",\"sitat\\\"er\"")
    la inn = csv.les_data(linje + "\n", v)
    assert_eq(lengde(inn), 1)
    assert_eq(inn[0][0], "a\\b")
    assert_eq(inn[0][1], "x,y\\z")
    assert_eq(inn[0][2], "sitat\"er")
    // Sitert `a\b` (komma tvingar sitat): `"a\\b,c"` -> a\b,c
    la ut = csv.les_data("\"a\\\\b,c\"\n", v)
    assert_eq(ut[0][0], "a\\b,c")
    // Standard (ESCAPE = QUOTE) uendra
    la s = csv.valg("COPY t FROM STDIN CSV")
    la r2 = csv.les_data("\"a\"\"b\\c\"\n", s)
    assert_eq(r2[0][0], "a\"b\\c")
}

funksjon start() -> heiltall {
    _test_url_dsn()
    _test_copy_avkod()
    _test_csv_escape()
    skriv("test_pg_url_copy_escape OK\n")
    returner 0
}
