// GC mark-fase probe: allokeringsfri mark-bitmap. Marker ei adresse (ny→0), marker
// igjen (alt→1), marker ein annan slot (ny→0). Stadfestar per-slot bit-set/les.
funksjon start() -> heiltall {
    la a = 6291456 + 100000
    la first = builtin.gc_mark_bit(a)
    la second = builtin.gc_mark_bit(a)
    la b = 6291456 + 200000
    la bfirst = builtin.gc_mark_bit(b)
    hvis first == 0 og second == 1 og bfirst == 0 {
        skriv("mark-bit OK: ny=0, gjenta=1, annan-slot=0 — mark-bitmap verkar\n")
        returner 0
    }
    skriv("mark-bit FEIL: first=" + tekst(first) + " second=" + tekst(second) + " bfirst=" + tekst(bfirst) + "\n")
    returner 1
}
