# Fikstur-app for Fase 2 bølgje (b) serve-integrasjonstest (test_fase2b_serve.no).
# Dekkjer request-mw (ctx-mutasjon), response-mw (header på alle svar),
# vakt med kortslutt-svar (401), dependency-injeksjon og auto-JSON-retur.

bruk std.web som web

# Request-middleware: legg ein brukar på ctx (skal følgje med inn i handlaren).
funksjon sett_bruker(ctx) {
    web.request_middleware()
    ctx["__bruker__"] = "ada"
    returner ctx
}

# Response-middleware: legg ein header på ALLE svar.
funksjon legg_header(resp) {
    web.response_middleware()
    hvis ikkje har_nokkel(resp, "__headers__") {
        resp["__headers__"] = {}
    }
    resp["__headers__"]["X-Fase2b"] = "1"
    returner resp
}

# Vakt: kortslutt med 401 + WWW-Authenticate når Authorization manglar.
funksjon krev_token(ctx) {
    web.guard()
    hvis web.request_header(ctx, "authorization") == "" {
        returner {"status": 401, "body": "Uautorisert", "__headers__": {"WWW-Authenticate": "Bearer"}}
    }
    returner sann
}

# Dependency-provider.
funksjon gi_db(ctx) {
    web.dependency("gi_db")
    returner "DB-handle"
}

# Vakta rute.
funksjon hemmeleg(ctx) {
    web.route("GET /hemmeleg")
    web.use_guard("krev_token")
    returner {"hemmeleg": sann}
}

# Rute med dependency-injeksjon + auto-JSON-retur (ordbok utan respons-nøklar).
funksjon heim(ctx, db) {
    web.route("GET /heim")
    web.use_dependency("gi_db")
    returner {"melding": "hei", "db": db, "bruker": ctx["__bruker__"]}
}

funksjon start() -> heltall {
    returner 0
}
