// Inkrementell skriv-trace: siste linje = krasjpunkt (skriv ubufra i AOT-ELF)
funksjon start() -> heiltall {
    skriv("A: start\n")
    la w: liste_heiltall = [100]
    skriv("B: literal bygd\n")
    legg_til(w, 5)
    skriv("C: legg_til ok\n")
    la x: heiltall = w[1]
    skriv("D: index ok\n")
    hvis x == 5 {
        skriv("E: verdi rett\n")
        returner 0
    }
    skriv("F: verdi feil\n")
    returner 2
}
