bruk std.runtime.process_abi som abi

funksjon start() -> heiltall {
    la r = builtin.process_spawn_argv(abi.request(
        "/usr/bin/yes", ["x"], "", "", 5000, 128
    ))
    skriv("status=" + tekst(r["status"]) + " error=" + tekst(r["error"]) +
          " exit=" + tekst(r["exit_code"]) + " out=" +
          tekst_fra_heltall(lengde(tekst(r["stdout"]))) + "\n")
    returner 0
}
