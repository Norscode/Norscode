// Fase 8: INDEX_SET (muterande tilordning). Liste: skriv verdi på plass. Kart:
// oppdater eksisterande nøkkel + veks med nye nøklar (realloc av mapdata).
// l[1]=99, l[2]=l[0]+l[1]=100; m["a"]=5(oppdater), m["b"]=7, m["c"]=30 (vekst).
// Sum = 99 + 100 + 5 + 7 + 30 = 241.
funksjon start() -> heiltall {
    la l = [1, 2, 3]
    l[1] = 99
    l[2] = l[0] + l[1]
    la m = {"a": 1}
    m["a"] = 5
    m["b"] = 7
    m["c"] = 30
    returner l[1] + l[2] + m["a"] + m["b"] + m["c"]
}
