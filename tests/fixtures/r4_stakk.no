# Fikstur for tests/test_r4_unntak_stakk.no (R4 / F34): stakkspor per unntak.

struktur Boks {
    x
}

funksjon Boks.sprekk(self) {
    kast "BoksFeil: sprakk"
}

funksjon nivaa3() {
    la b = Boks()
    b.sprekk()
}

funksjon nivaa2() {
    nivaa3()
}

funksjon nivaa1() {
    nivaa2()
}

funksjon delt(a: heiltall, b: heiltall) -> heiltall {
    returner a / b
}

funksjon rapporter(stakk) -> tekst {
    la ut = []
    for p i stakk {
        legg_til(ut, p["funksjon"] + "@" + tekst(p["linje"]) + "#" + p["fil"])
    }
    returner builtin.join(ut, " < ")
}

funksjon start() -> tekst {
    la d = []

    # Brukarkast gjennom metode og tre funksjonar.
    prøv { nivaa1() } fang (e) {
        legg_til(d, rapporter(e.stakk))
    }

    # VM-feil (divisjon med null) får òg spor, med linja til operasjonen.
    prøv { delt(1, 0) } fang (e: Unntak) {
        legg_til(d, rapporter(e.stakk))
    }

    # Nytt kast gjev nytt spor, ikkje det førre.
    prøv { nivaa3() } fang (e) {
        legg_til(d, rapporter(e.stakk))
    }

    # Pakka unntak: rethrow bevarer det opphavlege sporet.
    prøv {
        prøv { nivaa2() } fang (e) {
            la innvendig = e.stakk[0]["funksjon"]
            kast e
        }
    } fang (f) {
        legg_til(d, "rethrow:" + f.stakk[0]["funksjon"] + "," + tekst(lengde(f.stakk)) + "," + tekst(f.melding))
    }

    # Utan e.stakk-bruk er e framleis den rå teksten.
    prøv { nivaa1() } fang (e) {
        legg_til(d, tekst(e == "BoksFeil: sprakk") + "," + typenamn(e))
    }

    # Fleire fang-klausular: stakken følgjer det som vart kasta.
    prøv { delt(1, 0) } fang (e: TypeFeil) {
        legg_til(d, "feil")
    } fang (e: VerdiFeil) {
        legg_til(d, "multi:" + e.stakk[0]["funksjon"] + ":" + tekst(e.stakk[0]["linje"]))
    }

    # Ikkje-matchande klausular: rethrow beheld sporet frå kast-staden.
    prøv {
        prøv { nivaa3() } fang (e: TypeFeil) {
            legg_til(d, "feil")
        } fang (e: IndeksFeil) {
            legg_til(d, "feil")
        }
    } fang (e) {
        legg_til(d, "vidare:" + e.stakk[0]["funksjon"] + "<" + e.stakk[1]["funksjon"])
    }

    returner builtin.join(d, "|")
}

# Ufanga: køyrast av testen utan fang.
funksjon ufanga() -> heiltall {
    nivaa1()
    returner 0
}
