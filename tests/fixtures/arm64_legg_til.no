// Fase 8: legg_til (liste-append med vekst). Bygg ei tom liste opp til 5 element
// i ei løkke (kvar append reallokerer listdata), summer og legg til lengda.
// kvadrat 0,1,4,9,16 → sum 30, + lengde 5 = 35.
funksjon start() -> heiltall {
    la l = []
    la i = 0
    mens i < 5 { legg_til(l, i * i) i = i + 1 }
    la sum = 0
    la j = 0
    mens j < lengde(l) { sum = sum + l[j] j = j + 1 }
    returner sum + lengde(l)
}
