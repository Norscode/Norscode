// Codegen-miniport: den første funksjonen i bunten er ikkje entry-punktet.
// Kompilert av tools/build_linux_fullhost_candidate.no til build/ før
// den ferske codegen-ELF-en får han (ingen committa NCB-fikstur).
funksjon hjelpar(verdi: tekst) -> tekst {
    returner builtin.slice(verdi, 9, -1)
}

funksjon start() -> heiltall {
    skriv("NATIVE_CODEGEN_PROBE_OK\n")
    returner 0
}
