// GC SWEEP (live-map, referanse-algoritme): mark registrerer (addr,size) per live
// objekt; sweep finn hola mellom påfølgjande live objekt → gc_free. Her: 2 live
// objekt (region+0 sz16, region+64 sz16) med eit 48B dødt hol [region+16,+64).
// Sweep frigjer holet; gc_alloc(32) gjenbrukar det. Validerer sweep→reclaim-kjeda.
funksjon start() -> heiltall {
    la region = builtin.heap_bump() + 16384
    la lm = 271843328                          // 0x10340000 live-map scratch
    builtin.raw_store64(lm, region)            // live[0].addr
    builtin.raw_store64(lm + 8, 16)            // live[0].size
    builtin.raw_store64(lm + 16, region + 64)  // live[1].addr
    builtin.raw_store64(lm + 24, 16)           // live[1].size
    la n: heiltall = 2
    la freed: heiltall = 0
    la i: heiltall = 0
    mens i < n - 1 {
        la end_i = builtin.raw_load64(lm + i * 16) + builtin.raw_load64(lm + i * 16 + 8)
        la start_next = builtin.raw_load64(lm + (i + 1) * 16)
        la gap = start_next - end_i
        hvis gap >= 16 {
            builtin.gc_free(end_i, gap)
            freed = freed + 1
        }
        i = i + 1
    }
    la a = builtin.gc_alloc(32)                 // head-fit: 48>=32 → gjenbruk holet
    hvis freed == 1 og a == region + 16 {
        skriv("sweep OK: dødt hol frigjort + gc_alloc gjenbrukte det (sweep→reclaim)\n")
        returner 0
    }
    skriv("sweep FEIL: freed=" + tekst(freed) + "\n")
    returner 1
}
