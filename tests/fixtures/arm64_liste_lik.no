// arm64: == / != på lister er djup likskap (VM/x86-AOT), òg for bytes og nøsta lister.
funksjon start() -> heiltall {
    la a = [1, 2]
    la b = [1, 2]
    la c = [1, 3]
    la d = {"a": 1}
    la e = {"a": 1}
    skriv(tekst(a == b) + " " + tekst(a == c) + " " + tekst(a != b) + " " + tekst(d == e) + " " + tekst([] == []) + " " + tekst(["x", [1]] == ["x", [1]]) + "\n")
    skriv(tekst(builtin.bytes_from_list([1, 2]) == builtin.bytes_from_list([1, 2])) + "\n")
    returner 0
}
