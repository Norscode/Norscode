// GC F2-probe: TYPA liste (hypotese: untyped `la liste = [...]` gav 0 i AOT).
funksjon start() -> heiltall {
    la liste: liste_heiltall = [111, 222, 333]
    la addr = builtin.obj_addr(liste)
    la seen = builtin.raw_load64(6291504)   // rdi@entry lagra av obj_addr-debug
    hvis seen >= 6291456 {
        skriv("rdi@entry = heap-ptr (typa liste verkar!) → obj_addr OK\n")
    } ellers hvis seen == 0 {
        skriv("rdi@entry = 0 (typa liste gav òg 0)\n")
    } ellers {
        skriv("rdi@entry = uventa\n")
    }
    hvis addr >= 6291456 {
        skriv("obj_addr-retur i heap-range\n")
    } ellers {
        skriv("obj_addr-retur 0/lav\n")
    }
    returner 0
}
