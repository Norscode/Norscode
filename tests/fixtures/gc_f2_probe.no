// GC F2-probe: obj_addr + NcVal-boks-layout via ein INT-boks. VALIDERT.
// (obj_addr på LISTE-typa variablar gjev 0 via generisk builtin-veg — ein separat
// AOT-arg-passing-quirk for liste-typa verdiar, IKKJE ein GC-blokker: GC-mark-trace
// les rå-peikarar frå stakk-rot-skann + raw_load64, ikkje obj_addr på Norscode-var.)
funksjon start() -> heiltall {
    la x: heiltall = 12345
    la addr = builtin.obj_addr(x)               // value = x sin boks-adresse
    la type_tag = builtin.raw_load64(addr)      // [boks+0] = type-tag (1 = int)
    la value = builtin.raw_load64(addr + 8)     // [boks+8] = 12345
    hvis type_tag == 1 og value == 12345 {
        skriv("F2 OK: obj_addr + int-boks-layout [type=1][value=12345] stemmer\n")
        returner 0
    }
    skriv("F2 FEIL: type_tag/value uventa\n")
    returner 1
}
