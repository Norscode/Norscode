// GC F2-probe (DEBUG): obj_addr lagrar rdi@entry til [0x600030]. Les det tilbake
// for å sjå kva rdi FAKTISK held i runtime (disasm seier liste-ptr; runtime gav 0).
funksjon start() -> heiltall {
    la liste = [111, 222, 333]
    la addr = builtin.obj_addr(liste)          // lagrar rdi → [0x600030], returnerer boks
    la seen = builtin.raw_load64(6291504)      // [0x600030] = 0x600000+48
    la addr_heap = addr >= 6291456
    la seen_heap = seen >= 6291456
    hvis seen_heap {
        skriv("rdi@entry VAR heap-ptr → bug i boksing/retur (rdi ok)\n")
    } ellers hvis seen == 0 {
        skriv("rdi@entry VAR 0 → bug i call-site/arg trass disasm\n")
    } ellers {
        skriv("rdi@entry = uventa lav ikkje-null verdi\n")
    }
    hvis addr_heap {
        skriv("obj_addr-retur >= heap (ikkje 0)\n")
    } ellers {
        skriv("obj_addr-retur < heap (0/lav)\n")
    }
    returner 0
}
