// GC F2-probe: obj_addr på LISTE (skilt frå literal-creation med ein dummy-op).
// GC-mark-trace les eksisterande liste-objekt frå rot-skann, ikkje ferske literalar
// → dette er den relevante testen: kan vi lese ein liste-boks sin type-tag (3)?
funksjon start() -> heiltall {
    la liste: liste_heiltall = [111, 222, 333]
    la dummy: heiltall = 7
    la addr = builtin.obj_addr(liste)
    la type_tag = builtin.raw_load64(addr)     // liste-boks[0] = type-tag
    hvis type_tag == 3 {
        skriv("F2-liste OK: obj_addr(liste) → type_tag=3 (liste) — mark-trace mogleg\n")
        returner 0
    }
    hvis type_tag == 0 {
        skriv("F2-liste: type_tag=0 → obj_addr gav framleis 0 (literal-adjacency-bug held)\n")
        returner 2
    }
    skriv("F2-liste: type_tag != 3 og != 0 → vår liste-layout skil seg\n")
    returner 1
}
