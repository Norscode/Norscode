// GC F2-probe: brukar obj_addr + raw_load64 til å inspisere eksakt objekt-layout.
// Verifiserer NcVal-boks [type:8][payload:8] og liste-payload [len][cap][elem..].
funksjon start() -> heiltall {
    la liste = [111, 222, 333]
    la addr = builtin.obj_addr(liste)
    la type_tag = builtin.raw_load64(addr)         // venta 3 (liste)
    la payload = builtin.raw_load64(addr + 8)      // peikar til payload
    la len = builtin.raw_load64(payload)           // venta 3
    skriv("liste: type_tag=" + tekst(type_tag) + " len=" + tekst(len) + " (venta 3/3)\n")
    hvis type_tag == 3 og len == 3 {
        skriv("F2 OK: obj_addr + liste-layout stemmer med AOT_GC_DESIGN\n")
        returner 0
    }
    skriv("F2 FEIL: layout mismatch (type_tag=" + tekst(type_tag) + ", len=" + tekst(len) + ")\n")
    returner 1
}
