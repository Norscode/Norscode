// GC F2-probe (stabil): validerer obj_addr trygt. Sjekkar at obj_addr(liste) gjev
// ei heap-adresse (>= HEAP_VA 0x600000) og prøver type-tag @ word0 via samanlikning
// (ingen tekst() på råadressa, ingen deref av payload-peikaren — vår layout skil
// seg frå AOT_GC_DESIGN, som mark-trace må kartleggje seinare).
funksjon start() -> heiltall {
    la liste = [111, 222, 333]
    la addr = builtin.obj_addr(liste)
    la ok_heap = addr >= 6291456          // 0x600000
    la word0 = builtin.raw_load64(addr)
    hvis ok_heap {
        skriv("F2 OK: obj_addr gjev heap-adresse (>= 0x600000)\n")
    } ellers {
        skriv("F2 FEIL: obj_addr utanfor heap\n")
    }
    hvis word0 == 3 {
        skriv("F2: word0 == 3 (liste-type-tag, matchar design-layout)\n")
    } ellers {
        skriv("F2: word0 != 3 — vår NcVal-layout skil seg (kartleggjast for mark-trace)\n")
    }
    hvis ok_heap { returner 0 }
    returner 1
}
