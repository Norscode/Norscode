// GC F2-probe (inkrementell diagnostikk): skriv ei linje per steg for å pinne
// nøyaktig kvar det krasjar (skriv er ubufra → siste linje = krasjpunktet).
funksjon start() -> heiltall {
    skriv("A: start\n")
    la liste = [111, 222, 333]
    skriv("B: liste laga, lengde=" + tekst(lengde(liste)) + "\n")
    la addr = builtin.obj_addr(liste)
    skriv("C: obj_addr=" + tekst(addr) + "\n")
    la w0 = builtin.raw_load64(addr)
    skriv("D: word0=" + tekst(w0) + "\n")
    la w1 = builtin.raw_load64(addr + 8)
    skriv("E: word1=" + tekst(w1) + "\n")
    skriv("F2 dump ferdig\n")
    returner 0
}
