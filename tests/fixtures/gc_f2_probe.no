// GC F2-probe: obj_addr på INT-variabel (ingen liste-literal). Testar om obj_addr
// sjølv verkar, eller om bugen er liste-literal-stakk-handtering.
funksjon start() -> heiltall {
    la x: heiltall = 12345
    la addr = builtin.obj_addr(x)
    la seen = builtin.raw_load64(6291504)   // rdi@entry lagra av obj_addr-debug
    hvis seen >= 6291456 {
        skriv("rdi@entry(int) = heap-ptr → obj_addr VERKAR; bug var liste-literal-stakk\n")
    } ellers hvis seen == 0 {
        skriv("rdi@entry(int) = 0 → obj_addr sjølv er broten\n")
    } ellers {
        skriv("rdi@entry(int) = uventa\n")
    }
    returner 0
}
