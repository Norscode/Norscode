// GC F2-probe (layout-kartlegging): trygg — dereferer IKKJE payload enno. Skriv
// obj_addr + dei to fyrste orda i boksen så vi lærer vår faktiske NcVal-layout.
funksjon start() -> heiltall {
    la liste = [111, 222, 333]
    la addr = builtin.obj_addr(liste)
    la w0 = builtin.raw_load64(addr)
    la w1 = builtin.raw_load64(addr + 8)
    skriv("F2 layout: obj_addr=" + tekst(addr) + " word0=" + tekst(w0) + " word1=" + tekst(w1) + "\n")
    la heil = 42
    la a2 = builtin.obj_addr(heil)
    la h0 = builtin.raw_load64(a2)
    skriv("F2 int-boks: obj_addr=" + tekst(a2) + " word0=" + tekst(h0) + " (venta type-tag)\n")
    returner 0
}
