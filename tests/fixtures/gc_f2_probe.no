// GC F2-probe: obj_addr + NcVal-boks-layout via ein INT-boks (unngår den separate
// liste-literal-stakk-bugen). Validerer obj_addr og [type:8][value:8]-layouten.
funksjon start() -> heiltall {
    la x: heiltall = 12345
    la addr = builtin.obj_addr(x)               // value = x sin boks-adresse
    la type_tag = builtin.raw_load64(addr)      // [boks+0] = type-tag (1 = int)
    la value = builtin.raw_load64(addr + 8)     // [boks+8] = 12345
    hvis type_tag == 1 og value == 12345 {
        skriv("F2 OK: obj_addr + int-boks-layout [type=1][value=12345] stemmer\n")
        returner 0
    }
    skriv("F2 FEIL: type_tag/value uventa\n")
    returner 1
}
