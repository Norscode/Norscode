// GC F2-probe: skil obj_addr-krasj frå tekst(addr)-krasj (bad returverdi).
funksjon start() -> heiltall {
    skriv("A: start\n")
    la liste = [111, 222, 333]
    skriv("B: liste laga\n")
    la addr = builtin.obj_addr(liste)
    skriv("C: obj_addr returnerte (utan tekst)\n")
    la addr2 = addr + 0
    skriv("D: aritmetikk på addr ok\n")
    skriv("E: addr=" + tekst(addr) + "\n")
    returner 0
}
