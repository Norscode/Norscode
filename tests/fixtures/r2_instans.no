# Fikstur for tests/test_r2_instans.no (F21): typenamn(v) og er_instans(v, Type)
# for strukturar, grensesnitt og alias.Type.
bruk tests.fixtures.r2_konto_a som a
bruk tests.fixtures.r2_dyr som d

grensesnitt Form {
    funksjon areal(self) -> heltall
}
struktur Sirkel implementerer Form {
    r
}
struktur Bil {
    fart
}
funksjon Sirkel.areal(self) -> heltall {
    returner self.r
}

# Eldre brukarhjelpar som les det korte typemerket (oop/p31): skal framleis verke.
funksjon er_sirkel(v) -> bool {
    hvis type(v) != "ordbok" { returner usann }
    returner har_nokkel(v, "__type__") og v["__type__"] == "Sirkel"
}

funksjon start() -> tekst {
    la ut = []
    la s = Sirkel(2)
    la b = Bil(90)
    legg_til(ut, "s_form=" + tekst(er_instans(s, Form)))
    legg_til(ut, "b_form=" + tekst(er_instans(b, Form)))
    legg_til(ut, "s_sirkel=" + tekst(er_instans(s, Sirkel)))
    legg_til(ut, "s_bil=" + tekst(er_instans(s, Bil)))
    legg_til(ut, "ordbok=" + tekst(er_instans({"r": 1}, Sirkel)))
    legg_til(ut, "tal=" + tekst(er_instans(5, Form)))
    legg_til(ut, "null=" + tekst(er_instans(ingenting, Form)))
    la ka = a.ny()
    legg_til(ut, "alias=" + tekst(er_instans(ka, a.Konto)) + "/" + tekst(er_instans(s, a.Konto)))
    legg_til(ut, "typenamn=" + typenamn(s) + "," + typenamn(ka) + "," + typenamn("x") + "," + typenamn([1]) + "," + typenamn({"k": 1}))
    la katt = d.ny_katt("Pus")
    legg_til(ut, "dyr=" + tekst(er_instans(katt, d.Dyr)) + "/" + tekst(er_instans(s, d.Dyr)) + "/" + katt.lyd())
    legg_til(ut, "p31=" + tekst(er_sirkel(s)) + "/" + tekst(er_sirkel({"r": 1})))
    returner builtin.join(ut, ";")
}
