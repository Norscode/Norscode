// AOT-fikstur: builtin.tensor_operation (norscode-tensor-v1) UTAN `bruk std.native_gap`.
// Codegen rutar kallet til std.native_gap.tensor_operation; utan modulen i bunten kasta
// programmet «NATIV-GAP:tensor_operation» (std.tensor.matmul svelgde det og fall stille
// til skalar kode, so fiksturen kallar builtin-en direkte). Byggjer og køyrer rett berre
// når `nc bygg-native` legg modulen til implisitt (nc_aot_treng_native_gap_tensor i
// selfhost/nc_main.no). Exit 42 når produktet er rett; 2–4 = feil.
funksjon start() -> heiltall {
    la svar = builtin.tensor_operation({
        "abi": "norscode-tensor-v1", "operation": "matmul_i32",
        "left": [1, 2, 3, 4, 5, 6], "right": [7, 8, 9, 10, 11, 12],
        "rows": 2, "inner": 3, "columns": 2
    })
    hvis svar["status"] != "ferdig" {
        skriv("aot_tensor_implisitt FEIL: status=" + tekst(svar["status"]) + "\n")
        returner 2
    }
    la venta = [58, 64, 139, 154]
    la data = svar["data"]
    hvis lengde(data) != 4 {
        skriv("aot_tensor_implisitt FEIL: lengde " + tekst(lengde(data)) + "\n")
        returner 3
    }
    la i: heiltall = 0
    mens i < 4 {
        hvis data[i] != venta[i] {
            skriv("aot_tensor_implisitt FEIL: c[" + tekst(i) + "] = " + tekst(data[i]) + "\n")
            returner 4
        }
        i = i + 1
    }
    skriv("aot_tensor_implisitt OK backend=" + tekst(svar["backend"]) + "\n")
    returner 42
}
