// F42-fikstur: prosjektrot med norcode.toml. src/visning.no importerer
// src.mal frå prosjektrota (startproject-feilen) og hjelpar som søsken.
bruk src.visning som visning
bruk pakke.under.djup som djup
fra src.verktoy bruk dobbel, Par

funksjon start() -> tekst {
    la p = Par(2, 3)
    returner visning.vis("x") + "|" + djup.namn() + "|" + tekst(dobbel(21)) + "|" + tekst(p.a + p.b)
}
