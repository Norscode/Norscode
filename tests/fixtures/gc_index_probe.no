// Sjølvsjekkande vakt: liste-indeks utanfor grensene kastar fangbart «Indeks utanfor: N»
funksjon start() -> heiltall {
    la l = [10, 20, 30]
    skriv("inne=" + tekst(l[2]) + "\n")
    la feil = ""
    prøv { la x = l[5] skriv("x=" + tekst(x) + "\n") } fang (e) { feil = tekst(e) }
    skriv("fanga=[" + feil + "]\n")
    hvis feil != "Indeks utanfor: 5" { kast "feil melding: " + feil }
    la feil2 = ""
    prøv { la y = l[0 - 1] } fang (e) { feil2 = tekst(e) }
    hvis feil2 != "Indeks utanfor: -1" { kast "negativ: " + feil2 }
    la m: ordbok_tekst = {"a": "1"}
    skriv("map-mangler=[" + tekst(m["b"]) + "]\n")
    skriv("gc_index_probe OK\n")
    returner 0
}
