# Testklient for deltakar-demoen (W6, testbygg): startar den ekte examples/wasm_deltakarar/
# klient.no og køyrer stega som closures etter kvarandre (neste steg startar når sida er
# oppdatert etter førre svar). Etter kvart steg blir tilstanden i DOM-en skriven til #nc-logg;
# tests/test_wasm_w6.no samanliknar med fasiten.
#   lasta     standardlista (10) frå tenaren, statusen og knappane på att
#   lagt til  «Ny Person» lokalt (ulagra), og ein ugyldig e-post som blir avvist i skjemaet
#   lagra     POST /api/deltakarar: tenaren validerte og lagra 11 (informasjonskapsel)
#   henta att GET: dei 11 frå tenaren, ikkje standardlista
#   fjerna    delegert klikk på rad 2 (Berit): 10, ulagra
#   avvist    ei ugyldig liste sendt til tenaren: 400 med feila frå reglane, vist i #feil
#   offline   /api/stopp avsluttar nc serve; «Hent på nytt» gjev nettverksfeil, og lista står
bruk std.wasm_vert som vert
bruk std.wasm_nett som nett
bruk examples.wasm_deltakarar.klient som d

funksjon tekst_av(sel: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_tekst(h)
    vert.slepp(h)
    returner t
}

funksjon attr_av(sel: tekst, namn: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_attr(h, namn)
    vert.slepp(h)
    returner t
}

# Synleg når klienten har sett klassen «synleg» (saman med hidden = usann; hidden=""
# og manglande hidden gjev begge "" frå hent_attr).
funksjon skjult(sel: tekst) -> tekst {
    hvis attr_av(sel, "class") == "feil synleg" eller attr_av(sel, "class") == "synleg" { returner "synleg" }
    returner "skjult"
}

funksjon logg(namn: tekst) -> heltall {
    skriv(namn + ": " + tekst_av("#nc-resultat") + " | status=" + tekst_av("#status") + " | feil=" + tekst_av("#feil") +
          " (" + skjult("#feil") + ") | ulagra " + skjult("#ulagra") + " | lagre=" + attr_av("#lagre", "disabled") +
          " | første=" + tekst_av("#liste li:first-child strong") + " | siste=" + tekst_av("#liste li:last-child strong") + "\n")
    returner 0
}

funksjon skriv_i(sel: tekst, verdi: tekst) -> heltall {
    la h = vert.finn(sel)
    vert.test_skriv(h, verdi)
    vert.slepp(h)
    returner 0
}

funksjon steg_lasta() -> heltall {
    logg("lasta")
    skriv_i("#namn", "Ny Person")
    skriv_i("#epost", "ny@")
    vert.test_send(vert.finn("#skjema"))
    skriv("skjema: " + tekst_av("#skjema-feil") + "\n")
    skriv_i("#epost", "ny@eksempel.no")
    vert.test_send(vert.finn("#skjema"))
    logg("lagt til")
    d.lagre(fun(n) -> steg_lagra())
    logg("lagrar")
    returner 0
}

funksjon steg_lagra() -> heltall {
    logg("lagra")
    d.last_inn(fun(n) -> steg_henta())
    returner 0
}

funksjon steg_henta() -> heltall {
    logg("henta att")
    vert.test_klikk(vert.finn("#liste li:nth-child(2) button"))
    logg("fjerna")
    d.lagre_liste([{"namn": "A", "epost": "x"}, {"namn": "Bo", "epost": "bo@eksempel.no"}], fun(n) -> steg_avvist())
    returner 0
}

funksjon steg_avvist() -> heltall {
    logg("avvist")
    nett.hent("/api/stopp", fun(s) -> 0, fun(f) -> steg_stoppa())
    returner 0
}

funksjon steg_stoppa() -> heltall {
    vert.test_klikk(vert.finn("#last"))
    logg("hentar offline")
    # «Hent på nytt» gjekk via lyttaren (last_klikk, etter = null); vent på feilen med ein
    # ny henting med closure
    d.last_inn(fun(n) -> steg_offline())
    returner 0
}

funksjon steg_offline() -> heltall {
    logg("offline")
    skriv("ferdig\n")
    returner 0
}

funksjon start() -> heltall {
    d.start_med(fun(n) -> steg_lasta())
    # Før svaret: ingen rader enno (difor ikkje første/siste)
    skriv("start: " + tekst_av("#nc-resultat") + " | status=" + tekst_av("#status") + " | lagre=" + attr_av("#lagre", "disabled") +
          " | aria-busy=" + attr_av("#liste", "aria-busy") + "\n")
    returner 0
}
