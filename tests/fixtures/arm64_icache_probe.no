// AOT-berre-fixture for linux-arm64 (A2-review, fasit i tools/arm64_diff_lane.no):
// builtin.icache_sync(adr, n) gjer sjølvskriven maskinkode i anonym RWX-minne køyrbar før
// builtin.raw_call. Skriv `add x0, x0, #k ; ret` til SAME adresse for k = 1..200, synkar og
// kallar kvar gong: kvart svar skal vere argp + k. Utan sync (AArch64 har ikkje koherent
// I-cache) køyrer kjerna gamle instruksjonar (feil sum) eller får SIGILL — målt 6 av 8
// køyringar SIGILL i A2-reviewen med éin skriving.
bruk std.native_sys som nsys

funksjon skriv_u32(a: heiltall, v: heiltall) -> heiltall {
    builtin.raw_store8(a, v & 255)
    builtin.raw_store8(a + 1, (v >> 8) & 255)
    builtin.raw_store8(a + 2, (v >> 16) & 255)
    builtin.raw_store8(a + 3, (v >> 24) & 255)
    returner 0
}

funksjon start() -> heiltall {
    la rwx = nsys._flagg("PROT_READ") | nsys._flagg("PROT_WRITE") | nsys._flagg("PROT_EXEC")
    la m = builtin.sys6(nsys._nr("mmap"), 0, 4096, rwx, nsys._flagg("MAP_PRIVATE") | nsys._flagg("MAP_ANONYMOUS"), 0 - 1, 0)
    skriv("mmap_ok=" + tekst(m > 0) + "\n")
    la feil = 0
    la k = 1
    mens k <= 200 {
        skriv_u32(m, 2432696320 | (k << 10))       // add x0, x0, #k   (0x91000000 | imm12 << 10)
        skriv_u32(m + 4, 3596551104)               // ret              (0xD65F03C0)
        builtin.icache_sync(m, 8)
        la r = builtin.raw_call(m, 1000)
        hvis r != 1000 + k { feil = feil + 1 }
        k = k + 1
    }
    skriv("icache_sync: 200 kall, feil=" + tekst(feil) + "\n")
    // n <= 0 gjer ingenting og gjev 0.
    skriv("tom=" + tekst(builtin.icache_sync(m, 0)) + "\n")
    returner 58
}
