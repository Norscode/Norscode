funksjon profil_linje(namn: tekst, før: heltall, etter: heltall) {
    skriv("VM_HEAP_PROFILE " + namn + " delta=" + tekst_fra_heltall(etter - før) + " total=" + tekst_fra_heltall(etter))
}

funksjon pluss_ein(verdi: heltall) -> heltall {
    returner verdi + 1
}

funksjon start() {
    la tal = 0
    la før = builtin.native_heap_bytes()
    la i = 0
    mens i < 200 {
        tal = tal + 1
        i = i + 1
    }
    la etter = builtin.native_heap_bytes()
    profil_linje("loop_int", før, etter)

    la alfabet = "abcdefghijklmnopqrstuvwxyz"
    før = builtin.native_heap_bytes()
    i = 0
    mens i < 200 {
        la teikn = alfabet[i % 26]
        hvis teikn == "z" { tal = tal + 1 }
        i = i + 1
    }
    etter = builtin.native_heap_bytes()
    profil_linje("text_index", før, etter)

    før = builtin.native_heap_bytes()
    i = 0
    mens i < 200 {
        la tekstverdi = "v" + tekst_fra_heltall(i)
        hvis lengde(tekstverdi) > 0 { tal = tal + 1 }
        i = i + 1
    }
    etter = builtin.native_heap_bytes()
    profil_linje("text_build", før, etter)

    før = builtin.native_heap_bytes()
    i = 0
    mens i < 200 {
        la listeverdi = [i, i + 1]
        tal = tal + listeverdi[0]
        i = i + 1
    }
    etter = builtin.native_heap_bytes()
    profil_linje("list_new", før, etter)

    før = builtin.native_heap_bytes()
    i = 0
    mens i < 200 {
        la kartverdi = {"verdi": i, "neste": i + 1}
        tal = tal + kartverdi["verdi"]
        i = i + 1
    }
    etter = builtin.native_heap_bytes()
    profil_linje("map_new", før, etter)

    før = builtin.native_heap_bytes()
    i = 0
    mens i < 200 {
        tal = pluss_ein(tal)
        i = i + 1
    }
    etter = builtin.native_heap_bytes()
    profil_linje("function_call", før, etter)
    skriv("VM_HEAP_PROFILE_DONE " + tekst_fra_heltall(tal))
}
