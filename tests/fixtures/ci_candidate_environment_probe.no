// Testbarnet skal bruke kandidaten valt i CI-kommandoen, ikkje adapter-verten.
funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    assert_eq(miljo_hent("NC_NATIVE"), root + "/bin/nc")
    skriv("ci candidate NC_NATIVE=" + miljo_hent("NC_NATIVE") + "\n")
    skriv("ci candidate NORSCODE_NATIVE_BIN=" + miljo_hent("NORSCODE_NATIVE_BIN") + "\n")
    returner 0
}
