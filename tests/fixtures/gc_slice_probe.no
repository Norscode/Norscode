funksjon start() -> heiltall {
    la full: liste_heiltall = [1, 2, 3]
    la tom = builtin.slice(full, 0, 0)
    legg_til(tom, 99)
    legg_til(tom, 88)
    hvis lengde(tom) != 2 { returner 1 }
    hvis tom[0] != 99 { returner 2 }
    la sub = builtin.slice(full, 1, 3)
    hvis lengde(sub) != 2 eller sub[0] != 2 { returner 3 }
    skriv("slice OK: tom+append len=2, sub[0]=" + tekst(sub[0]) + "\n")
    returner 0
}
