// Konstanttids-swap med negativ maske (x25519 sel25519-stil).
funksjon start() -> heiltall {
    la p = [10, 20, 30]
    la q = [1, 2, 3]
    la c = 0 - 1                 // -1 (alle einarar i 64-bit)
    la i = 0
    mens i < 3 {
        la t = c & (p[i] ^ q[i])
        p[i] = p[i] ^ t
        q[i] = q[i] ^ t
        i = i + 1
    }
    returner (p[0] + q[0]) & 255
}
