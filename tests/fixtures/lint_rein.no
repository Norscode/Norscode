// Fixture for tests/test_lint_typesjekk.no: vanleg kode som `nc lint` IKKJE
// skal gje funn for (vern mot falske positive i typesjekk og AST-reglar).
funksjon er_stor(x: heltall) -> boolsk {
    returner x > 5 og x != 100
}
funksjon ikkje_tom(t: tekst) -> bool {
    returner ikkje (lengde(t) == 0)
}
funksjon helsing(namn: tekst) -> tekst {
    returner "hei " + namn + " nr " + tekst(1 + 2)
}
funksjon som_tekst(data: ordbok_tekst) -> tekst {
    // Køyretidssjekk av typen: den deklarerte typen skal ikkje gje typefeil.
    hvis type(data) == "tekst" {
        returner data
    }
    returner "ordbok"
}
funksjon sum(...tal) -> heltall {
    la s = 0
    for t i tal {
        s = s + t
    }
    returner s
}
funksjon med_lambda() -> heltall {
    la f = funksjon(y: heltall) -> heltall { returner y * 2 }
    returner f(4)
}
funksjon feil_fanga() -> heltall {
    prøv {
        kast "x"
    } fang (e) {
        returner 1
    }
    returner 0
}
funksjon start() -> heltall {
    la liste: liste_tekst = []
    legg_til(liste, helsing("a"))
    legg_til(liste, som_tekst({}))
    hvis er_stor(7) og ikkje_tom("x") {
        returner sum(1, 2, 3) + med_lambda() + feil_fanga() + lengde(liste)
    }
    returner 0
}
