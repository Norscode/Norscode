// Fixture for tests/test_lint_typesjekk.no: vanleg kode som `nc lint` IKKJE
// skal gje funn for (vern mot falske positive i typesjekk og AST-reglar).
funksjon er_stor(x: heltall) -> boolsk {
    returner x > 5 og x != 100
}
funksjon ikkje_tom(t: tekst) -> bool {
    returner ikkje (lengde(t) == 0)
}
funksjon helsing(namn: tekst) -> tekst {
    returner "hei " + namn + " nr " + tekst(1 + 2)
}
funksjon som_tekst(data: ordbok_tekst) -> tekst {
    // Køyretidssjekk av typen: den deklarerte typen skal ikkje gje typefeil.
    hvis type(data) == "tekst" {
        returner data
    }
    returner "ordbok"
}
funksjon sum(...tal) -> heltall {
    la s = 0
    for t i tal {
        s = s + t
    }
    returner s
}
funksjon med_lambda() -> heltall {
    la f = funksjon(y: heltall) -> heltall { returner y * 2 }
    returner f(4)
}
funksjon feil_fanga() -> heltall {
    prøv {
        kast "x"
    } fang (e) {
        returner 1
    }
    returner 0
}
// `og`/`eller` returnerer ein av operandane (ikkje bool): standardverdi-idiomet
// skal ikkje gje typefeil.
funksjon namn_eller_standard(x) -> tekst {
    returner x eller "standard"
}
funksjon tal_eller_null(n) -> heltall {
    la ingen = null
    la s: tekst = ingen eller ""
    la u: tekst = "x" og s
    returner lengde(u) + tar_heltall(n eller 0)
}
funksjon tar_heltall(n: heltall) -> heltall {
    returner n
}
// `la` er funksjonsskopa: ein variabel frå ei blokk kan lesast etter blokka,
// og `la v` i søskenblokker er same variabel (ikkje re-deklarasjon, ikkje
// ubrukt, og ingen typefeil sjølv om greinene gjev ulik type).
funksjon siste_av(tal: liste_heltall) -> heltall {
    la sum = 0
    for t i tal {
        la siste = t
        sum = sum + t
    }
    returner siste + sum
}
funksjon grein(a: boolsk) -> heltall {
    hvis a {
        la v = 21
    } ellers {
        la v = "ikkje tal"
    }
    hvis a {
        returner tar_heltall(v)
    }
    returner 0
}
funksjon start() -> heltall {
    la liste: liste_tekst = []
    legg_til(liste, helsing("a"))
    legg_til(liste, som_tekst({}))
    legg_til(liste, namn_eller_standard(null))
    legg_til(liste, tekst(tal_eller_null(null)))
    legg_til(liste, tekst(siste_av([1, 2]) + grein(sann)))
    hvis er_stor(7) og ikkje_tom("x") {
        returner sum(1, 2, 3) + med_lambda() + feil_fanga() + lengde(liste)
    }
    returner 0
}
