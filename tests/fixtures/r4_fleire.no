# Fikstur for tests/test_r4_unntak_fleire.no (R4 / F32): multi-catch, fleire
# fang-klausular, unntakshierarki og grensesnitt som unntaksrot.

grensesnitt FeilRot {
    funksjon kode(self) -> heltall
}

struktur ValFeil implementerer FeilRot {
    melding
}
funksjon ValFeil.kode(self) -> heltall { returner 7 }

struktur NettFeil implementerer FeilRot {
    melding
}
funksjon NettFeil.kode(self) -> heltall { returner 9 }

struktur Annan {
    melding
}

funksjon ny_val(m: tekst) -> ValFeil {
    la v = ValFeil()
    v.melding = m
    returner v
}
funksjon ny_nett(m: tekst) -> NettFeil {
    la v = NettFeil()
    v.melding = m
    returner v
}
funksjon ny_annan(m: tekst) -> Annan {
    la v = Annan()
    v.melding = m
    returner v
}

funksjon ikkje_tre(a: heiltall, b: heiltall) -> heiltall { returner a + b }
struktur Tom { x }

# Kastar éi av ti ting; k vel kva.
funksjon kast_ting(k: heiltall) -> heiltall {
    hvis k == 0 { kast "AFeil: a" }
    hvis k == 1 { kast "BFeil: b" }
    hvis k == 2 { kast "CFeil: c" }
    hvis k == 3 { la z = 1 / 0 }
    hvis k == 4 { la z = 5 % 0 }
    hvis k == 5 { la l = [1, 2]
        la z = l[10] }
    hvis k == 6 { la z = "a" - 1 }
    hvis k == 7 { la z = ikkje_tre(1) }
    hvis k == 8 { la t = Tom()
        t.ikkjemetode() }
    hvis k == 9 { kast ny_val("verdi") }
    hvis k == 10 { kast ny_nett("nett") }
    hvis k == 11 { kast ny_annan("annan") }
    hvis k == 12 { kast "ValideringsFeil: felt" }
    returner 0
}

# 1. multi-catch: fangar A og B, men ikkje C (går til ytre).
funksjon multi(k: heiltall) -> tekst {
    prøv {
        prøv { kast_ting(k) } fang (e: AFeil eller BFeil) { returner "inne:" + e }
    } fang (e) {
        returner "ytre:" + e
    }
    returner "ingen"
}

# 2. fleire klausular, første samsvar vinn.
funksjon fleire(k: heiltall) -> tekst {
    prøv {
        kast_ting(k)
    } fang (e: AFeil) {
        returner "A"
    } fang (e: BFeil eller CFeil) {
        returner "BC"
    } fang (e: IndeksFeil) {
        returner "idx"
    } fang (e) {
        returner "resten"
    }
    returner "ingen"
}

# 3. ingen samsvar → går vidare (endeleg køyrer éin gong, ytre fangar).
funksjon vidare(k: heiltall, logg) -> tekst {
    prøv {
        prøv {
            kast_ting(k)
        } fang (e: AFeil) {
            legg_til(logg, "feil-klausul")
        } fang (e: BFeil) {
            legg_til(logg, "feil-klausul")
        } endeleg {
            legg_til(logg, "endeleg")
        }
    } fang (e) {
        legg_til(logg, "ytre")
        returner "vidare:" + e
    }
    returner "fall-gjennom"
}

# 4. hierarki: kvar innebygd feil fanga på rett nivå.
funksjon nivaa(k: heiltall) -> tekst {
    la ut = ""
    prøv { kast_ting(k) } fang (e: TypeFeil) { ut = "TypeFeil" }
        fang (e: IndeksFeil) { ut = "IndeksFeil" }
        fang (e: ArgumentFeil) { ut = "ArgumentFeil" }
        fang (e: MetodeFeil) { ut = "MetodeFeil" }
        fang (e: DivisjonMedNull) { ut = "DivisjonMedNull" }
        fang (e: ModuloMedNull) { ut = "ModuloMedNull" }
        fang (e: VerdiFeil) { ut = "VerdiFeil" }
        fang (e: Unntak) { ut = "Unntak" }
    returner ut
}

funksjon som_verdifeil(k: heiltall) -> tekst {
    prøv {
        prøv { kast_ting(k) } fang (e: VerdiFeil) { returner "V" }
    } fang (e) {
        returner "-"
    }
    returner "?"
}

# 5. grensesnitt som rot for brukartypar.
funksjon rot(k: heiltall) -> tekst {
    prøv {
        kast_ting(k)
    } fang (e: FeilRot) {
        returner "rot:" + tekst(e.kode()) + ":" + typenamn(e)
    } fang (e) {
        returner "andre"
    }
    returner "ingen"
}

funksjon rot_multi(k: heiltall) -> tekst {
    prøv {
        kast_ting(k)
    } fang (e: ValFeil eller Annan) {
        returner "VA:" + typenamn(e)
    } fang (e: FeilRot) {
        returner "rot"
    }
    returner "ingen"
}

# 6. er_instans / unntak_type på unntak.
funksjon instans(k: heiltall) -> tekst {
    prøv {
        kast_ting(k)
    } fang (e) {
        la r = ""
        hvis er_instans(e, Unntak) { r = r + "U" }
        hvis er_instans(e, TypeFeil) { r = r + "T" }
        hvis er_instans(e, VerdiFeil) { r = r + "V" }
        hvis er_instans(e, FeilRot) { r = r + "R" }
        hvis er_instans(e, ValFeil) { r = r + "F" }
        returner r + "/" + unntak_type(e)
    }
    returner "ingen"
}

# 7. unntak i ei klausul fangast ikkje av ei søsterklausul; heile prøv-setninga
# kan stå i ei løkke med bryt/fortsett i klausulane.
funksjon sosken() -> tekst {
    prøv {
        prøv {
            kast_ting(0)
        } fang (e: AFeil) {
            kast "NyFeil: frå-klausul"
        } fang (e: NyFeil) {
            returner "FEIL-søsken-fanga"
        }
    } fang (e) {
        returner "ytre:" + e
    }
    returner "ingen"
}

funksjon lykkje() -> tekst {
    la s = ""
    for k i [0, 1, 2, 0, 1] {
        prøv {
            kast_ting(k)
        } fang (e: AFeil) {
            s = s + "a"
            fortsett
        } fang (e: BFeil) {
            s = s + "b"
            hvis lengde(s) > 3 { bryt }
        } fang (e) {
            s = s + "c"
        }
        s = s + "."
    }
    returner s
}

# Same variabelnamn i alle klausulane.
funksjon namn() -> tekst {
    la s = ""
    prøv { kast "AFeil: 1" } fang (e: AFeil) { s = s + e } fang (e: BFeil) { s = s + "x" }
    prøv { kast "BFeil: 2" } fang (e: AFeil) { s = s + "x" } fang (e: BFeil) { s = s + e }
    returner s
}

funksjon start() -> tekst {
    la d = []
    # multi
    legg_til(d, multi(0))
    legg_til(d, multi(1))
    legg_til(d, multi(2))
    # fleire
    legg_til(d, fleire(0))
    legg_til(d, fleire(1))
    legg_til(d, fleire(2))
    legg_til(d, fleire(5))
    legg_til(d, fleire(3))
    # vidare
    la l1 = []
    legg_til(d, vidare(2, l1) + "[" + builtin.join(l1, ",") + "]")
    # hierarki
    la h = ""
    for k i [6, 5, 7, 8, 3, 4, 12, 0] {
        h = h + nivaa(k) + ","
    }
    legg_til(d, h)
    legg_til(d, som_verdifeil(3) + som_verdifeil(4) + som_verdifeil(12) + som_verdifeil(6))
    # rot
    legg_til(d, rot(9) + "," + rot(10) + "," + rot(11) + "," + rot(0))
    legg_til(d, rot_multi(9) + "," + rot_multi(11) + "," + rot_multi(10))
    legg_til(d, instans(6) + "," + instans(3) + "," + instans(9) + "," + instans(10) + "," + instans(11) + "," + instans(0))
    legg_til(d, sosken())
    legg_til(d, lykkje())
    legg_til(d, namn())
    returner builtin.join(d, "|")
}
