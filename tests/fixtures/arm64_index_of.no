// A5: index_of/contains med første-byte-filter: tom needle, treff i start/slutt,
// ingen treff, needle lengre enn hay, gjentekne prefiks.
funksjon start() -> heiltall {
    skriv(tekst(builtin.index_of("abc", "")) + " " + tekst(builtin.index_of("", "")) + "\n")
    skriv(tekst(builtin.index_of("abcabd", "abd")) + " " + tekst(builtin.index_of("aaab", "aab")) + "\n")
    skriv(tekst(builtin.index_of("abc", "c")) + " " + tekst(builtin.index_of("abc", "a")) + "\n")
    skriv(tekst(builtin.index_of("abc", "x")) + " " + tekst(builtin.index_of("ab", "abc")) + "\n")
    skriv(tekst(builtin.contains("|la=LA|", "|la=")) + " " + tekst(builtin.contains("abc", "cb")) + "\n")
    returner 0
}
