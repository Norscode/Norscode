// Eit ekte testbarn som skil eksplisitt miljø frå forelderen sitt miljø.
funksjon start() -> heiltall {
    assert_eq(builtin.miljo_hent("NC_TEST_PROCESS_PROBE"), "child-only")
    assert_eq(tekst(builtin.system_info()["cwd"]), builtin.miljo_hent("NC_TEST_PROCESS_CWD"))
    la del = builtin.miljo_hent("NORSCODE_LINUX_PROBE_SECTION")
    hvis del != "" {
        assert_eq(builtin.miljo_hent("NORSCODE_EXPECT_SANDBOX_BACKEND"), "seccomp")
        assert_eq(builtin.miljo_hent("NORSCODE_EXPECT_EVENT_BACKEND"), "epoll")
        hvis del == "argon2id" og builtin.miljo_hent("NC_TEST_PROCESS_WAIT") == "1" {
            // Exit 0 utan markør skal feile testen og stoppe før TLS-delen.
            returner 0
        }
        skriv("test_linux_runtime_attestation_probe OK (" + del + ")\n")
        returner 0
    }
    skriv("nc-test child environment and cwd OK\n")
    hvis builtin.miljo_hent("NC_TEST_PROCESS_WAIT") == "1" {
        la ferdig = builtin.tid_ms() + 10000
        mens builtin.tid_ms() < ferdig { }
        skriv("nc-test child missed timeout\n")
    }
    returner 17
}
