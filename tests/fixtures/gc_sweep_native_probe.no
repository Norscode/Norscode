// GC (ii) probe: allokeringsfri maskinkode-SWEEP (gc_sweep_native). Byggjer adresse-
// ordna live-map (2 live objekt m/48B hol imellom) @0x10340000, køyrer maskinkode-
// sweep → gc_free holet inline; verifiser at gc_alloc gjenbrukar det.
funksjon start() -> heiltall {
    la region = builtin.heap_bump() + 16384
    la lm = 271843328                          // 0x10340000 live-map
    builtin.raw_store64(lm, region)            // live[0].addr
    builtin.raw_store64(lm + 8, 16)            // live[0].size
    builtin.raw_store64(lm + 16, region + 64)  // live[1].addr
    builtin.raw_store64(lm + 24, 16)           // live[1].size
    la freed = builtin.gc_sweep_native(2)      // maskinkode-sweep
    la a = builtin.gc_alloc(32)                 // head-fit: 48>=32 → gjenbruk holet
    hvis freed == 1 og a == region + 16 {
        skriv("gc_sweep_native OK: maskinkode-sweep frigjorde holet, gc_alloc gjenbrukte\n")
        returner 0
    }
    skriv("gc_sweep_native FEIL: freed=" + tekst(freed) + "\n")
    returner 1
}
