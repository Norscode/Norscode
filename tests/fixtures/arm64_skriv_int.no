// Fase 1 (SELFHOST_ARM64_FULLHOST_CODEGEN_PLAN.md): ekte runtime `skriv` av
// heiltal på AArch64 (write-syscall + desimalformatering, ingen heap).
// Skriv "-12345" (forteikn + fleirsifra) og deretter "0" (nullbanen).
funksjon start() -> heiltall {
    la a = 1
    la b = 12346
    skriv(a - b)      // -12345
    la c = 5
    skriv(c - c)      // 0
    returner 0
}
