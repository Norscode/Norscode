// GC-probe: gc_sort_livemap skalerer (v7, 2026-09-25) — sjølvsjekkande, GC-modus.
//
// Heap-bygginga i gc_sort_livemap mista byggjeindeksen (siftdown returnerte med rcx =
// sluttposisjonen til det sokkne elementet) → kvar sokk skanna [i, p) på nytt →
// KVADRATISK sortering. Stigande adresser er verste fall for max-heap-bygginga (kvart
// indre element søkk til eit blad). Proben fyller live-map-en (0x43000000, layout v3) med
// N stigande (addr, size)-par, sorterer og krev (a) rett orden med intakte par og (b) at
// sorteringa tek under 500 ms (O(n log n): nokre ms; kvadratisk: sekund).
//
// Collect skriv live-map-en frå 0x43000000, so fyllinga må ikkje krysse ein collect:
// oppvarminga utløyser den første collecten (startport 64 KiB), og fyllinga allokerer
// < 4 MiB (probe-bygg med NORSCODE_GC_TERSKEL_BYTES=4194304). Proben kontrollerer at
// sist-collect-slotten [HEAP_VA+24] er uendra over fyllinga (exit 4 = ugyldig måling).
// Exit: 0 = OK · 2 = feil orden/par · 3 = for treg (kvadratisk) · 4 = collect under fylling.
// N: NORSCODE_GC_SORT_N (standard 40000).
funksjon start() -> heiltall {
    la w: liste = []
    la k: heiltall = 0
    mens k < 20000 {
        legg_til(w, k * 100000)
        k = k + 1
    }
    la n: heiltall = 40000
    la n_tekst = miljo_hent("NORSCODE_GC_SORT_N")
    hvis n_tekst != "" { n = heltall_fra_tekst(n_tekst) }
    la lm: heiltall = 1124073472                   // 0x43000000 (GC_LIVEMAP_VA)
    la sist_før: heiltall = builtin.raw_load64(7864344)   // HEAP_VA+24: bump etter siste collect
    la i: heiltall = 0
    mens i < n {
        la a: heiltall = lm + i * 16
        builtin.raw_store64(a, 1000 + i)           // stigande adresse (verste fall)
        builtin.raw_store64(a + 8, i)              // storleik = opphavleg indeks (par-sjekk)
        i = i + 1
    }
    hvis builtin.raw_load64(7864344) != sist_før {
        skriv("gc_sort_scale UGYLDIG: collect under fyllinga (live-map overskriven) — mindre N\n")
        returner 4
    }
    la t0: heiltall = tid_ms()
    builtin.gc_sort_livemap(n)
    la ms: heiltall = tid_ms() - t0
    la j: heiltall = 0
    mens j < n {
        la a: heiltall = lm + j * 16
        hvis builtin.raw_load64(a) != 1000 + j eller builtin.raw_load64(a + 8) != j {
            skriv("gc_sort_scale FEIL: entry " + tekst(j) + " = (" + tekst(builtin.raw_load64(a)) + ", " + tekst(builtin.raw_load64(a + 8)) + ")\n")
            returner 2
        }
        j = j + 97
    }
    la siste: heiltall = lm + (n - 1) * 16
    hvis builtin.raw_load64(siste) != 1000 + n - 1 eller builtin.raw_load64(siste + 8) != n - 1 {
        skriv("gc_sort_scale FEIL: siste entry\n")
        returner 2
    }
    hvis ms > 500 {
        skriv("gc_sort_scale FEIL: " + tekst(n) + " entryar tok " + tekst(ms) + " ms (> 500 ms: kvadratisk heap-bygging)\n")
        returner 3
    }
    skriv("gc_sort_scale OK: " + tekst(n) + " stigande entryar sortert på " + tekst(ms) + " ms, " + tekst(lengde(w)) + " oppvarmingselement\n")
    returner 0
}
