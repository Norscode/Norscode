bruk selfhost.lexer.lexer_m1
bruk selfhost.parser

funksjon start() -> heiltall {
    la kjelde = "funksjon start() { skriv(\"test OK\\n\") }\n"
    skriv("PARSER_PROBE_LEX_START\n")
    la tokens = selfhost.lexer.lexer_m1.lex(kjelde)
    skriv("PARSER_PROBE_LEX_OK=" + tekst_fra_heltall(lengde(tokens)) + "\n")
    skriv("PARSER_PROBE_TOKEN1_VERDI=" + tekst(tokens[1]["verdi"]) + "\n")
    skriv("PARSER_PROBE_TOKEN1_VALUE=" + tekst(tokens[1]["value"]) + "\n")
    la ast = selfhost.parser.parse_program(tokens)
    skriv("PARSER_PROBE_PARSE_OK=" + tekst(ast["type"]) + "\n")
    skriv("PARSER_PROBE_FUNCTION=" + tekst(ast["barn"][0]["verdi"]) + "\n")
    returner 0
}
