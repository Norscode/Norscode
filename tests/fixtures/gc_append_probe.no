// gc_append_probe.no — builtin.fil_append / fil_append_binær var ikkje ruta i
// x86-64 v2 → hybrid-kompilatoren sin straumande JSON-skrivar gav 1-byte NCB.
funksjon start() -> heiltall {
    la sti = "/tmp/nc_append_" + tekst(builtin.tid_ms()) + ".txt"
    fil_skriv(sti, "{")
    builtin.fil_append(sti, "\"a\":1")
    builtin.fil_append(sti, ",")
    builtin.fil_append(sti, "\"b\":\"æøå\"}")
    la t = fil_les(sti)
    skriv("innhald=[" + t + "]\n")
    hvis t != "{\"a\":1,\"b\":\"æøå\"}" { returner 3 }
    builtin.fil_append_binær(sti, [10, 104, 105])
    hvis fil_les(sti) != "{\"a\":1,\"b\":\"æøå\"}\nhi" { skriv("binær feil\n") returner 4 }
    la ny = sti + ".ny"
    builtin.fil_append(ny, "skapt")
    hvis fil_les(ny) != "skapt" { returner 5 }
    la p = json_parse(t)
    hvis tekst(p["a"]) != "1" eller p["b"] != "æøå" { returner 6 }
    skriv("append OK\n")
    returner 0
}
