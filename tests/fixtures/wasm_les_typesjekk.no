# Barneprogram for tests/test_wasm_les.no (W2, W3): byggjer den handbygde standardmodulen
# og variantane med éin feil kvar, validerer dei med std/wasm_les.no og skriv éi linje per
# modul: «GODTEKEN <namn>» eller «AVVIST <namn>: <feil>». Testen køyrer programmet i
# VM-fastmodus og sjekkar kvar linje mot forventinga si; i standard-VM-en tok typesjekken
# av dei 18 modulane om lag 40 s i testprosessen.
bruk std.wasm_les som les
bruk std.wasm_binary som w

funksjon la_til(m: liste, k: liste) -> heltall {
    la i = 0
    mens i < lengde(k) {
        legg_til(m, k[i])
        i = i + 1
    }
    returner 0
}

# Kropp: lokaldeklarasjonar + instruksjonar + end, med storleiken først.
funksjon kropp(lokale: liste, instr: liste) -> liste {
    la b = []
    la_til(b, lokale)
    la_til(b, instr)
    legg_til(b, 11)
    la ut = w.leb_u(lengde(b))
    la_til(ut, b)
    returner ut
}

# Typar: 0 struct {mut i64}, 1 array (mut i8), 2 (eqref)→() [tag], 3 (i32)→i32,
#        4 ()→eqref, 5 (eqref)→eqref, 6 struct {i32} (uforanderleg)
# Funksjonar: f0..f4 med typane 3, 4, 5, 3, 3. Tag 0 av type 2. Globalar: 0 mut i32, 1 i32.
funksjon standard_kroppar() -> liste {
    returner [
        # f0: if/else, br_if med verdi, i64
        [[1, 1, 126], [32, 0, 172, 33, 1, 2, 127, 32, 0, 4, 127, 65, 1, 5, 65, 2, 11, 32, 0, 65, 5, 74, 13, 0, 26,
                        32, 1, 66, 3, 126, 167, 11]],
        # f1: try_table (catch 0 → blokka) med throw av ein struct
        [[0], [2, 109, 31, 64, 1, 0, 0, 0, 66, 7, 251, 0, 0, 8, 0, 11, 208, 109, 11]],
        # f2: ref.func (deklarert) og call_ref
        [[0], [32, 0, 210, 2, 20, 5]],
        # f3: array.new_default + array.len
        [[0], [65, 4, 251, 7, 1, 251, 15, 32, 0, 106]],
        # f4: globalar
        [[0], [35, 1, 32, 0, 106, 36, 0, 35, 0]]
    ]
}

funksjon modul(kroppar: liste, med_elem: bool) -> liste {
    la m = [0, 97, 115, 109, 1, 0, 0, 0]
    la_til(m, w.seksjon(1, [7, 95, 1, 126, 1, 94, 120, 1, 96, 1, 109, 0, 96, 1, 127, 1, 127, 96, 0, 1, 109,
                            96, 1, 109, 1, 109, 95, 1, 127, 0]))
    la_til(m, w.seksjon(3, [5, 3, 4, 5, 3, 3]))
    la_til(m, w.seksjon(13, [1, 0, 2]))
    la_til(m, w.seksjon(6, [2, 127, 1, 65, 0, 11, 127, 0, 65, 5, 11]))
    hvis med_elem { la_til(m, w.seksjon(9, [1, 3, 0, 1, 2])) }
    la kp = [lengde(kroppar)]
    la i = 0
    mens i < lengde(kroppar) {
        la_til(kp, kropp(kroppar[i][0], kroppar[i][1]))
        i = i + 1
    }
    la_til(m, w.seksjon(10, kp))
    returner m
}

# Standardmodulen med kroppen til funksjon `f` bytt ut.
funksjon med_kropp(f: heltall, lokale: liste, instr: liste) -> liste {
    la k = standard_kroppar()
    k[f] = [lokale, instr]
    returner modul(k, sann)
}

funksjon sjekk(namn: tekst, bytar: liste) -> heltall {
    la r = les.valider(bytar)
    hvis r["ok"] {
        skriv("GODTEKEN " + namn + "\n")
    } ellers {
        skriv("AVVIST " + namn + ": " + r["feil"] + "\n")
    }
    returner 0
}

funksjon start() -> heltall {
    sjekk("standardmodulen", modul(standard_kroppar(), sann))
    sjekk("ekstra verdi ved end", med_kropp(3, [0], [65, 4, 251, 7, 1, 251, 15, 32, 0, 106, 65, 9]))
    sjekk("stakkunderflyt", med_kropp(4, [0], [106]))
    sjekk("i64.add på i32", med_kropp(3, [0], [65, 4, 251, 7, 1, 251, 15, 32, 0, 124]))
    sjekk("feil returtype", med_kropp(3, [0], [66, 1]))
    sjekk("br med feil type", med_kropp(3, [0], [2, 127, 66, 1, 12, 0, 11]))
    sjekk("struct.get på eqref", med_kropp(2, [0], [32, 0, 251, 2, 0, 0, 26, 208, 109]))
    sjekk("global.set uforanderleg", med_kropp(4, [0], [35, 1, 32, 0, 106, 36, 1, 35, 0]))
    sjekk("ref.func utan deklarasjon", modul(standard_kroppar(), usann))
    sjekk("catch-etikett med feil type", med_kropp(1, [0], [2, 127, 31, 64, 1, 0, 0, 0, 11, 65, 0, 11, 26, 208, 109]))
    sjekk("throw med i32", med_kropp(1, [0], [2, 109, 31, 64, 1, 0, 0, 0, 65, 7, 8, 0, 11, 208, 109, 11]))
    sjekk("call_ref feil type", med_kropp(2, [0], [32, 0, 210, 2, 20, 3]))
    sjekk("if utan else med resultat", med_kropp(3, [0], [32, 0, 4, 127, 65, 1, 11]))
    sjekk("struct.set uforanderleg felt", med_kropp(3, [0], [65, 1, 251, 0, 6, 65, 2, 251, 5, 6, 0, 65, 0]))
    sjekk("select ulike typar", med_kropp(3, [0], [65, 1, 66, 2, 65, 1, 27, 26, 65, 0]))
    sjekk("local.set feil type", med_kropp(0, [1, 1, 126], [65, 1, 33, 1, 65, 0]))
    sjekk("br_table ulik aritet", med_kropp(3, [0], [2, 64, 2, 127, 65, 0, 65, 0, 14, 1, 0, 1, 11, 26, 11, 65, 0]))
    sjekk("struct.new feil felttype", med_kropp(1, [0], [65, 7, 251, 0, 0, 26, 208, 109]))
    returner 0
}
