// Fase 8: join (runtime-rutine __join; liste av strengar + separator → streng).
// "ab-cd-ef"(8) + "xy"(2) + "one"(3, éitt element → ingen sep) = 13.
funksjon start() -> heiltall {
    la j = builtin.join(["ab", "cd", "ef"], "-")
    la j2 = builtin.join(["x", "y"], "")
    la j3 = builtin.join(["one"], ",")
    returner lengde(j) + lengde(j2) + lengde(j3)
}
