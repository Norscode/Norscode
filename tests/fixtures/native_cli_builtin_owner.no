// Bruk gjeldande bygg-native-eigar når ein eksakt, eldre stage0 er bootstrap.
// Codegen blir framleis starta av CLI-eigaren med sitt lukka barnemiljø.
bruk selfhost.nc_main som cli

funksjon start() -> heiltall {
    returner cli.nc_bygg_native_cli(["nc", "bygg-native", "--target", "linux-x86_64", "--ncb",
        miljo_hent("NC_TEST_NATIVE_CLI_INPUT"), miljo_hent("NC_TEST_NATIVE_CLI_OUTPUT")])
}
