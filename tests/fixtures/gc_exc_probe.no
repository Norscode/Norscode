funksjon indre(n: heiltall) -> heiltall {
    hvis n < 0 { kast "negativ: " + tekst(n) }
    returner n * 2
}
funksjon start() -> heiltall {
    la fanga: tekst = ""
    prøv {
        prøv {
            la x = indre(-5)
        } fang (e) {
            fanga = e            // bruk unntaksverdien
            kast "vidare: " + e  // rethrow frå catch
        }
    } fang (e2) {
        hvis fanga != "negativ: -5" { returner 1 }
        hvis e2 != "vidare: negativ: -5" { returner 2 }
    }
    // garbage → collect medan strengane er levande
    la i: heiltall = 0
    mens i < 2000 { la t: liste_heiltall = [i]  i = i + 1 }
    hvis fanga != "negativ: -5" { returner 3 }
    skriv("exc OK: nøsta try + unntaksverdi + rethrow + collect\n")
    returner 0
}
