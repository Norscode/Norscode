// Likskaps-paritet mot referansen (committed Linux-VM, 2026-09-06): null er ein
// eigen verdi — 0 == null er USANN, samansette verdiar er aldri lik null/0.
funksjon vis(namn: tekst, v: boolsk, vil: boolsk) -> heiltall {
    la merk = ""
    hvis v != vil { merk = "  <-- FEIL" }
    skriv(namn + "=" + tekst(v) + merk + "\n")
    hvis v != vil { kast "paritet: " + namn }
    returner 0
}
funksjon start() -> heiltall {
    la m = {"a": 1}
    la tom = {}
    la l = [1, 2]
    la tl = []
    la n = null
    vis("null==null", n == null, sann)
    vis("0==null", 0 == null, usann)
    vis("map==null", m == null, usann)
    vis("tommap==null", tom == null, usann)
    vis("liste==null", l == null, usann)
    vis("tomliste==null", tl == null, usann)
    vis("map==0", m == 0, usann)
    vis("tekst==null", "" == null, usann)
    vis("map!=null", m != null, sann)
    vis("1==null", 1 == null, usann)
    skriv("eqnull OK\n")
    returner 0
}
