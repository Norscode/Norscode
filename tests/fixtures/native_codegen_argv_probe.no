funksjon start() -> heiltall {
    skriv("ARGV_PROBE_BOOT\n")
    la args = builtin.argv_list_v1()
    skriv("ARGV_PROBE_COUNT=" + tekst_fra_heiltall(lengde(args)) + "\n")
    la i: heiltall = 0
    mens i < lengde(args) {
        skriv("ARGV_PROBE_ARG=" + tekst(args[i]) + "\n")
        i = i + 1
    }
    skriv("ARGV_PROBE_OK\n")
    returner 0
}
