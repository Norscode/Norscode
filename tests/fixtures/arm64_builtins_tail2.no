// Fase 8: builtin-hale batch 2 — verdier (kart→liste av verdiar) + fjern_siste
// (pop siste, muter lista). 5+7+9 + len(ks)=3 + 40 + 30 + len(l)=2 = 96.
funksjon start() -> heiltall {
    la m = {"a": 5, "b": 7, "c": 9}
    la vs = verdier(m)
    la ks = nøkler(m)
    la l = [10, 20, 30, 40]
    la last = fjern_siste(l)
    la last2 = fjern_siste(l)
    returner vs[0] + vs[1] + vs[2] + lengde(ks) + last + last2 + lengde(l)
}
