// The size-class allocator must keep the existing hard heap bound. A request
// as large as the whole heap cannot fit; fail with 199 before touching a page.
funksjon start() -> heiltall {
    builtin.gc_alloc(1080033280)
    skriv("gc_sizeclass_oom FEIL: tok imot ein umogleg allokering\n")
    returner 3
}
