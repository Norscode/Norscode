bruk std.protocol_stream som stream

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_STARTTLS_PORT"))
    la s = stream.opne_session("localhost", port, usann, 10000)
    assert(s["status"] == "open")
    la hello = stream.les_chunk(s, 4096)
    assert(hello["status"] == "ok" og builtin.index_of(hello["data"], "220") == 0)
    assert(stream.skriv_alt(s, "STARTTLS\r\n"))
    la ready = stream.les_chunk(s, 4096)
    assert(ready["status"] == "ok" og builtin.index_of(ready["data"], "220") == 0)
    assert(stream.oppgrader_tls(s, "localhost", "tests/fixtures/tls/localhost.crt"))
    assert(stream.skriv_alt(s, "PING\r\n"))
    la secure = stream.les_chunk(s, 4096)
    assert(secure["status"] == "ok" og builtin.index_of(secure["data"], "250 secure") == 0)
    stream.lukk_session(s)
    skriv("starttls_client OK\n")
    returner 0
}
