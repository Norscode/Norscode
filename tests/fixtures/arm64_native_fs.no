// A5: builtin.native_fs_* på linux-arm64 går til std.native_gap.fs_gap_* (sys6); x86 har
// inline-atom. Same kontrakt: dirents "k\tnamn\n" (utan ./..), stat-liste, 0/−errno.
bruk std.native_gap som ng

funksjon sortert(t: tekst) -> tekst {
    la l = builtin.split(t, "\n")
    la ut: liste_tekst = []
    for x i l { hvis x != "" { legg_til(ut, x) } }
    // innsetjingssortering (få element)
    la i = 1
    mens i < lengde(ut) {
        la j = i
        mens j > 0 og ut[j - 1] > ut[j] {
            la tmp = ut[j]
            ut[j] = ut[j - 1]
            ut[j - 1] = tmp
            j = j - 1
        }
        i = i + 1
    }
    returner builtin.join(ut, ",")
}

funksjon start() -> heiltall {
    la d = "/tmp/nc_arm64_native_fs_fixtur"
    builtin.native_fs_unlink(d + "/b.txt")
    builtin.native_fs_unlink(d + "/lenkje")
    builtin.native_fs_rmdir(d + "/under")
    builtin.native_fs_rmdir(d)
    builtin.mkdir_p(d + "/under")
    builtin.fil_skriv(d + "/a.txt", "hei verda")
    skriv("rename=" + tekst(builtin.native_fs_rename(d + "/a.txt", d + "/b.txt")) + "\n")
    skriv("symlink=" + tekst(builtin.native_fs_symlink("b.txt", d + "/lenkje")) + "\n")
    skriv("dirents=" + sortert(builtin.native_fs_dirents(d)) + "\n")
    la st = builtin.native_fs_stat(d + "/b.txt", sann)
    skriv("stat_n=" + tekst(lengde(st)) + " size=" + tekst(st[1]) + " type=" + tekst(st[0] / 4096) + "\n")
    la ls = builtin.native_fs_stat(d + "/lenkje", usann)
    skriv("lstat_type=" + tekst(ls[0] / 4096) + " stat_type=" + tekst(builtin.native_fs_stat(d + "/lenkje", sann)[0] / 4096) + "\n")
    skriv("chmod=" + tekst(builtin.native_fs_chmod(d + "/b.txt", 384)) + " modus=" + tekst(builtin.native_fs_stat(d + "/b.txt", sann)[0] % 4096) + "\n")
    skriv("stat_manglar=" + tekst(builtin.native_fs_stat(d + "/finst_ikkje", sann)[0]) + "\n")
    skriv("dirents_manglar=" + builtin.native_fs_dirents(d + "/finst_ikkje") + "\n")
    skriv("unlink=" + tekst(builtin.native_fs_unlink(d + "/lenkje")) + " " + tekst(builtin.native_fs_unlink(d + "/b.txt")) + "\n")
    skriv("unlink_manglar=" + tekst(builtin.native_fs_unlink(d + "/b.txt")) + "\n")
    skriv("rmdir=" + tekst(builtin.native_fs_rmdir(d + "/under")) + " " + tekst(builtin.native_fs_rmdir(d)) + "\n")
    returner 0
}
