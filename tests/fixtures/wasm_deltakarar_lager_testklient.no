# Testklient for den lokale kopien i deltakar-demoen (W7, testbygg): startar den ekte
# examples/wasm_deltakarar/klient.no og køyrer stega som closures etter kvarandre.
# tests/test_wasm_w7_chrome.no lastar /test?steg=1, 2 og 3 med same Chrome-profil (og steg 2 òg
# med ein fersk profil, som negativ kontroll) og samanliknar loggen med fasiten.
#   steg=1  lista frå tenaren (10); «Hugs lista på denne eininga» (klikk) lagrar ho lokalt;
#           legg til «Ny Person» og fjern Berit utan å lagre på tenaren (ulagra, men lagra lokalt)
#   steg=2  tenarsvaret kjem etter 800 ms (/api/deltakarar_treg): den lokale kopien (med dei
#           ulagra endringane) blir vist straks, før tenaren har svara; når tenaren svarar, blir
#           dei ulagra endringane ståande; lagre dei; klikk på knappen igjen: kopien blir sletta
#   steg=3  valet og databasen er borte (databasen er ny når han blir opna), og lista kjem frå
#           tenaren (som no har dei lagra endringane)
# Negativ kontroll: steg=2 med ein fersk profil viser ingen lokal kopi, berre standardlista.
bruk std.wasm_vert som vert
bruk std.wasm_nett som nett
bruk std.wasm_lager som lager
bruk examples.wasm_deltakarar.klient som d

la ferdig_flagg: bool = usann
la såg_lokal: bool = usann

funksjon puls() -> heltall {
    hvis ferdig_flagg { returner 0 }
    nett.hent("/api/puls", fun(s) -> puls(), fun(f) -> puls())
    returner 0
}

funksjon ferdig() -> heltall {
    skriv("ferdig\n")
    ferdig_flagg = sann
    returner 0
}

funksjon tekst_av(sel: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_tekst(h)
    vert.slepp(h)
    returner t
}

funksjon attr_av(sel: tekst, namn: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_attr(h, namn)
    vert.slepp(h)
    returner t
}

funksjon ulagra() -> tekst {
    hvis attr_av("#ulagra", "class") == "synleg" { returner "synleg" }
    returner "skjult"
}

funksjon logg(namn: tekst) -> heltall {
    la rader = ""
    hvis d.antal() > 0 {
        rader = " | første=" + tekst_av("#liste li:first-child strong") + " | siste=" + tekst_av("#liste li:last-child strong")
    }
    skriv(namn + ": " + tekst_av("#nc-resultat") + " | status=" + tekst_av("#status") + " | ulagra " + ulagra() +
          " | hugs=" + attr_av("#hugs", "aria-pressed") + " | lokal=" + tekst_av("#lokal") + rader + "\n")
    returner 0
}

funksjon klikk(sel: tekst) -> heltall {
    la h = vert.finn(sel)
    vert.test_klikk(h)
    vert.slepp(h)
    returner 0
}

funksjon skriv_i(sel: tekst, verdi: tekst) -> heltall {
    la h = vert.finn(sel)
    vert.test_skriv(h, verdi)
    vert.slepp(h)
    returner 0
}

# ─── steg=1 ──────────────────────────────────────────────────────────────────

funksjon s1_lasta() -> heltall {
    logg("lasta")
    klikk("#hugs")
    # Køa i std/wasm_lager.no leverer i rekkjefølgje: når denne er lagra, er klikket det òg
    d.lagre_lokal(fun(n) -> s1_hugsa())
    returner 0
}

funksjon s1_hugsa() -> heltall {
    logg("hugsa")
    skriv_i("#namn", "Ny Person")
    skriv_i("#epost", "ny@eksempel.no")
    la skjema = vert.finn("#skjema")
    vert.test_send(skjema)
    vert.slepp(skjema)
    klikk("#liste li:nth-child(2) button")
    d.lagre_lokal(fun(n) -> s1_slutt())
    returner 0
}

funksjon s1_slutt() -> heltall {
    logg("endra lokalt")
    ferdig()
    returner 0
}

# ─── steg=2 ──────────────────────────────────────────────────────────────────

funksjon s2_lokal() -> heltall {
    såg_lokal = sann
    logg("lokal før tenaren")
    returner 0
}

funksjon s2_tenar() -> heltall {
    logg("tenaren svara")
    hvis ikkje såg_lokal {
        skriv("ingen lokal kopi\n")
        ferdig()
        returner 0
    }
    d.lagre(fun(n) -> s2_lagra())
    returner 0
}

funksjon s2_lagra() -> heltall {
    d.lagre_lokal(fun(n) -> s2_lagra_lokalt())
    returner 0
}

funksjon s2_lagra_lokalt() -> heltall {
    logg("lagra")
    klikk("#hugs")
    lager.slett_database(d.db_namn(), fun(x) -> s2_gløymt(), null)
    returner 0
}

funksjon s2_gløymt() -> heltall {
    logg("gløymt")
    ferdig()
    returner 0
}

# ─── steg=3 ──────────────────────────────────────────────────────────────────

funksjon s3_lasta() -> heltall {
    logg("lasta")
    la db = lager.opne(d.db_namn(), 1, d.skjema(), fun(x) -> 0, null)
    lager.køyr(db, [lager.op_tel("deltakarar", null)], fun(r) -> s3_db(db, r[0]), null)
    returner 0
}

funksjon s3_db(db: ordbok, n: heltall) -> heltall {
    skriv("databasen: oppgradert frå " + tekst(db["oppgradert_frå"]) + ", " + tekst(n) + " rader\n")
    lager.logg_ut(db, d.db_namn(), [], fun(x) -> ferdig(), null)
    returner 0
}

funksjon start() -> heltall {
    la s = vert.hent_parameter("steg")
    skriv("steg " + s + "\n")
    puls()
    hvis s == "1" {
        returner d.start_med(fun(n) -> s1_lasta())
    }
    hvis s == "2" {
        d.start_med_val({"url": "/api/deltakarar_treg", "etter_lokal": fun(n) -> s2_lokal(), "etter": fun(n) -> s2_tenar()})
        logg("start")
        returner 0
    }
    hvis s == "3" {
        returner d.start_med(fun(n) -> s3_lasta())
    }
    ferdig()
    returner 0
}
