# Testapp for WebSocket i std/apptenar.no over ekte socket
# (tests/test_apptenar_websocket_socket.no). Konfigurasjon frå miljøet:
#   APPTENAR_WS_PING_MS  heartbeat-ping (standard 30000)
#   APPTENAR_WS_LUKK_MS  ventetid på klienten sin close (standard 5000)
#   APPTENAR_MS          tidsgrense for heile prosessen (standard 120000)
bruk std.web som web
bruk std.apptenar som app
bruk std.apptenar_ws som ws

funksjon _miljø(namn: tekst, standard: tekst) -> tekst {
    la v = ""
    prøv { v = builtin.miljo_hent(namn) } fang (e) { v = "" }
    hvis v == "" { returner standard }
    returner v
}

funksjon ekko(t: ordbok) -> heltall {
    web.route("WS /ekko")
    hvis ws.hending(t) == "melding" {
        la m = ws.motta(t)
        hvis m["type"] == "binær" { ws.send_bytes(t, m["data"]) } ellers { ws.send_tekst(t, "ekko: " + m["data"]) }
    }
    returner 0
}

funksjon chat(t: ordbok) -> heltall {
    web.route("WS /chat/{rom}")
    la h = ws.hending(t)
    hvis h == "open" { ws.bli_med(t, ws.param(t, "rom")) }
    hvis h == "melding" { ws.rom_send(ws.param(t, "rom"), ws.motta_tekst(t)) }
    returner 0
}

funksjon lukkar(t: ordbok) -> heltall {
    web.route("WS /lukk")
    hvis ws.hending(t) == "open" { ws.lukk(t, 4000, "ferdig") }
    returner 0
}

funksjon status_rute(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /status")
    la s = app.status()
    returner {"status": 200, "body": "ws=" + tekst(s["ws"]) + " tilk=" + tekst(s["tilkoplingar"])}
}

funksjon stopp_rute(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /stopp")
    app.stopp()
    returner {"status": 200, "body": "stoppar"}
}

funksjon start() -> heltall {
    returner app.lytt({
        "port": 0,
        "ws_ping_ms": heltall_fra_tekst(_miljø("APPTENAR_WS_PING_MS", "30000")),
        "ws_lukk_ms": heltall_fra_tekst(_miljø("APPTENAR_WS_LUKK_MS", "5000")),
        "maks_ms": heltall_fra_tekst(_miljø("APPTENAR_MS", "120000")),
        "logg": "feil"
    })
}
