bruk std.socket som socket

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_HTTPS_BACKEND_PORT"))
    la listener = socket.native_lytt("127.0.0.1", port, 8)
    hvis listener["status"] != "listening" { returner 1 }
    la peer = socket.native_aksepter(listener)
    la i = 0
    mens peer["status"] == "ventende" og i < 1200 { socket.native_poll_vent(listener, 1, 100) peer = socket.native_aksepter(listener) i = i + 1 }
    hvis peer["status"] != "connected" { returner 1 }
    la r = socket.native_les(peer, 65536)
    i = 0
    mens r["status"] == "ventende" og i < 300 { socket.native_poll_vent(peer, 1, 100) r = socket.native_les(peer, 65536) i = i + 1 }
    hvis r["status"] != "ok" { returner 1 }
    hvis builtin.index_of(r["data"], "GET /health HTTP/1.1") < 0 { returner 1 }
    hvis builtin.index_of(r["data"], "x-forwarded-proto: https") < 0 { returner 1 }
    hvis builtin.index_of(r["data"], "x-norscode-request-id:") < 0 { returner 1 }
    hvis miljo_hent("NORSCODE_HTTPS_BACKEND_MODE") == "stall" {
        socket.native_poll_vent(peer, 1, 2000)
        socket.native_lukk(peer)
        socket.native_lukk(listener)
        skriv("https_front_backend stall OK\n")
        returner 0
    }
    la body = "backend-ok"
    la payload = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + tekst_fra_heltall(lengde(body)) + "\r\nConnection: close\r\n\r\n" + body
    la w = socket.native_skriv(peer, payload)
    i = 0
    mens w["status"] == "ventende" og i < 300 { socket.native_poll_vent(peer, 2, 100) w = socket.native_skriv(peer, payload) i = i + 1 }
    socket.native_lukk(peer)
    socket.native_lukk(listener)
    hvis w["status"] != "ok" { returner 1 }
    skriv("https_front_backend OK\n")
    returner 0
}
