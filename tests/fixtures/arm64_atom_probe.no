// A2: AArch64-atoma (sys6, raw_load/store 8/64, native_target, native_envp, system_info) i eitt
// AOT-program med fasit (ikkje differensielt: VM-en i C-æra-seedane har ikkje
// native_target/native_envp). Linux-arm64-nummer: getpid 172, mmap 222, munmap 215, close 57 (−EBADF = −9).
funksjon start() -> heiltall {
    la pid = builtin.sys6(172, 0, 0, 0, 0, 0, 0)
    skriv("pid>0=" + tekst(pid > 0) + "\n")
    la m = builtin.sys6(222, 0, 4096, 3, 34, 0 - 1, 0)
    skriv("mmap_ok=" + tekst(m > 0) + "\n")
    builtin.raw_store64(m, 1234567890123)
    builtin.raw_store8(m + 9, 200)
    builtin.raw_store8(m + 10, 300)
    skriv("l64=" + tekst(builtin.raw_load64(m)) + " l8=" + tekst(builtin.raw_load8(m + 9)) + " trunk=" + tekst(builtin.raw_load8(m + 10)) + "\n")
    skriv("ebadf=" + tekst(builtin.sys6(57, 0 - 1, 0, 0, 0, 0, 0)) + "\n")
    skriv("mål=" + builtin.native_target() + "\n")
    la e = builtin.native_envp()
    la n = 0
    la funne = usann
    mens builtin.raw_load64(e + n * 8) != 0 og n < 4096 {
        la p = builtin.raw_load64(e + n * 8)
        hvis builtin.raw_load8(p) == 65 og builtin.raw_load8(p + 1) == 50 og builtin.raw_load8(p + 2) == 95 { funne = sann }
        n = n + 1
    }
    skriv("envp_n>0=" + tekst(n > 0) + " fann_A2_=" + tekst(funne) + "\n")
    skriv("munmap=" + tekst(builtin.sys6(215, m, 4096, 0, 0, 0, 0)) + "\n")
    // system_info: same fem felt som x86 (lanen køyrer ELF-en med cwd /tmp).
    la si = builtin.system_info()
    skriv("si=" + tekst(si["system"]) + "/" + tekst(si["machine"]) + " cwd=" + tekst(si["cwd"]) +
          " exe_ok=" + tekst(builtin.ends_with(tekst(si["executable"]), "/arm64_atom_probe")) +
          " status=" + tekst(si["status"]) + " n=" + tekst(lengde(nøkler(si))) + "\n")
    returner 47
}
