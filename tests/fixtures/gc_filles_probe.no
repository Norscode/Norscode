// Sjølvsjekkande vakt: fil_les kastar for manglande fil (VM-melding) og les eksisterande
funksjon start() -> heiltall {
    la fanga = ""
    prøv { la x = fil_les("/finst/ikkje/her.txt") skriv("x=" + x + "\n") } fang (e) { fanga = tekst(e) }
    skriv("fanga=[" + fanga + "]\n")
    hvis fanga != "Kan ikkje opne fil: /finst/ikkje/her.txt" { kast "feil melding: " + fanga }
    la innhald = fil_les("/proc/self/cmdline")
    hvis lengde(innhald) < 1 { kast "tom fil_les" }
    la f = usann
    prøv { fil_les("/nei") f = sann } fang (e) { f = usann }
    hvis f { kast "manglande fil rapportert som lesbar" }
    // 2026-09-06 (VM-paritet): committed seed sin fil_les(katalog) RETURNERER (kastar
    // ikkje), og vm._rt_fil_finnes = «fil_les kastar ikkje». Fersk seed gjev "" for
    // katalog i staden for å kaste (og aldri frosen RT_FIL_LES, som avslutta stille).
    la k = ""
    la y = ""
    prøv { y = fil_les("/proc") } fang (e) { k = tekst(e) }
    hvis k != "" { kast "katalog kasta: " + k }
    hvis lengde(y) != 0 { kast "katalog gav innhald: " + tekst(lengde(y)) }
    la finst_dir = builtin.fil_finnes("/proc")
    hvis ikkje finst_dir { kast "fil_finnes(/proc) usann" }
    skriv("katalog=[" + tekst(lengde(y)) + "] fil_finnes(/proc)=" + tekst(finst_dir) + "\n")
    skriv("gc_filles_probe OK\n")
    returner 0
}
