// GC (iv) ENDE-TIL-ENDE (NORSCODE_GC_ALLOC=1): rein loop med minimal allokering/iter (3
// int-boks ≈ 48B). UTAN reclaim sprenger heapen (~253MB usable) ved ~5M iter. Milestone M4
// (4M) ligg FORBI det punktet → når han M4, har collect faktisk avgrensa minnet (reclaim
// verkar). keep verifiserer at levande verdi er urørt. Exit: 0 = OK · 2 = korrupt.
funksjon ident(x: heiltall) -> heiltall {
    returner x
}
funksjon start() -> heiltall {
    la keep: heiltall = 12321
    la i: heiltall = 0
    mens i < 6000000 {
        la a: heiltall = i + 1
        la b: heiltall = a + 1
        la c: heiltall = ident(b)              // kall → safepoint → (terskel 1000) collect
        i = i + 1
    }
    hvis keep == 12321 og i == 6000000 {
        skriv("gc_collect_e2e OK: 6M iter, collect avgrensa minnet (reclaim verkar), levande urørt\n")
        returner 0
    }
    returner 2
}
