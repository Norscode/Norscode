// GC (iv) ENDE-TIL-ENDE (NORSCODE_GC_ALLOC=1): loop som allokerer nok 16B int-garbage til
// å SPRENGE 256MB-heapen UTAN collect. Kvar iterasjon har eit funksjonskall → safepoint;
// ved terskel (1000) kallar safepoint-stubben gc_collect_native som haustar garbagen via
// konservativ rot-skann + sweep → fri-lista → gc_alloc16 gjenbrukar. Fullfører BERRE om
// GC-en avgrensar minnet. Verifiser at levande verdiar (keep, i) er urørte etterpå.
// (Utan flagg: RT_INT bumpar utan reclaim → SIGSEGV. Med flagg: skal fullføre, exit 0.)
// ~8M iter × ~48B = ~384MB garbage > 256MB heap. Exit: 0 = OK · 2 = korrupt levande.
funksjon ident(x: heiltall) -> heiltall {
    returner x
}
funksjon start() -> heiltall {
    la keep: heiltall = 12321
    la i: heiltall = 0
    mens i < 8000000 {
        la a: heiltall = i + 1
        la b: heiltall = a + 1
        la c: heiltall = ident(b)              // kall → safepoint → (terskel) collect
        i = i + 1
        hvis i == 500000 { skriv("M0.5\n") }
        hvis i == 1000000 { skriv("M1\n") }
        hvis i == 2000000 { skriv("M2\n") }
        hvis i == 3000000 { skriv("M3\n") }
        hvis i == 4000000 { skriv("M4\n") }
        hvis i == 5000000 { skriv("M5\n") }
        hvis i == 6000000 { skriv("M6\n") }
        hvis i == 7000000 { skriv("M7\n") }
    }
    hvis keep == 12321 og i == 8000000 {
        skriv("gc_collect_e2e OK: 8M iter, GC haustar garbage, levande urørt, ingen SIGSEGV\n")
        returner 0
    }
    returner 2
}
