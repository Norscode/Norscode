funksjon start() -> heiltall {
    la n = null
    skriv("io=" + tekst(builtin.index_of(n, "a")) + " io2=" + tekst(builtin.index_of("abc", n)) + " c=" + tekst(builtin.contains(n, "a")) + " sw=" + tekst(builtin.starts_with(n, "a")) + " ew=" + tekst(builtin.ends_with("abc", n)) + " io3=" + tekst(builtin.index_of("abcabc", "ca")) + " sw2=" + tekst(builtin.starts_with("abc", "ab")) + "\n")
    returner 0
}
