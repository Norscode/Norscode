// GC F3-probe: konservativ stakk-rot-skann. Hentar stakk-grensene via stack_base/
// stack_ptr og skannar [sp, sb) etter heap-peikar-lookande slots (0x600000 <= v <
// heap_bump). roots>0 stadfestar at rot-skann-mekanismen verkar.
funksjon start() -> heiltall {
    la sb = builtin.stack_base()
    la sp = builtin.stack_ptr()
    la bump = builtin.heap_bump()
    la roots: heiltall = 0
    la p = sp
    mens p < sb {
        la v = builtin.raw_load64(p)
        hvis v >= 6291456 og v < bump { roots = roots + 1 }
        p = p + 8
    }
    la djupde = sb - sp
    skriv("F3 rot-skann: djupde=" + tekst(djupde) + " bytes, roots=" + tekst(roots) + "\n")
    hvis djupde > 0 og roots > 0 {
        skriv("F3 OK: stakk-rot-skann fann heap-peikarar\n")
        returner 0
    }
    skriv("F3 FEIL: ugyldige grenser eller ingen roots\n")
    returner 1
}
