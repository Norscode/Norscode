# Fikstur for tests/test_serve_arbeidarar.no (5a): kvar arbeidar svarar med «<id>:<tid>» —
# NC_SERVE_WORKER_ID frå leiaren og tidspunktet modulen vart initialisert (skil ein
# omstarta arbeidar frå den drepne med same id). Krev env.read (NORSCODE_VM_TARGET_CAPABILITIES).
bruk std.web som web

la STARTTID = builtin.tid_ms()

funksjon identitet(ctx) {
    web.route("GET /id")
    returner miljo_hent("NC_SERVE_WORKER_ID") + ":" + tekst_fra_heltall(STARTTID)
}

funksjon start() -> heltall {
    returner 0
}
