bruk std.socket som socket

funksjon vent_aksept(listener: ordbok_tekst) -> ordbok_tekst {
    la i = 0
    mens i < 300 {
        la peer = socket.native_aksepter(listener)
        hvis peer["status"] == "connected" { returner peer }
        socket.native_poll_vent(listener, 1, 100)
        i = i + 1
    }
    returner {"status": "feil", "error": "accept timeout"}
}

funksjon les(peer: ordbok_tekst) -> tekst {
    la i = 0
    mens i < 300 {
        la r = socket.native_les(peer, 4096)
        hvis r["status"] == "ok" { returner r["data"] }
        hvis r["status"] == "feil" eller r["status"] == "eof" { returner "" }
        socket.native_poll_vent(peer, 1, 100)
        i = i + 1
    }
    returner ""
}

funksjon skriv_alt(peer: ordbok_tekst, data: tekst) -> boolsk {
    la offset = 0
    mens offset < lengde(data) {
        la r = socket.native_skriv(peer, builtin.slice(data, offset, lengde(data)))
        hvis r["status"] == "ventende" { socket.native_poll_vent(peer, 2, 100) }
        ellers hvis r["status"] != "ok" { returner usann }
        ellers { offset = offset + heltall_fra_tekst(tekst(r["value"])) }
    }
    returner sann
}

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_STARTTLS_PORT"))
    la listener = socket.native_lytt("127.0.0.1", port, 8)
    hvis listener["status"] != "listening" { skriv("server listen feil\n") returner 1 }
    la peer = vent_aksept(listener)
    hvis peer["status"] != "connected" { socket.native_lukk(listener) returner 1 }
    hvis ikkje skriv_alt(peer, "220 test ESMTP ready\r\n") { returner 1 }
    hvis builtin.index_of(les(peer), "STARTTLS") < 0 { returner 1 }
    hvis ikkje skriv_alt(peer, "220 2.0.0 Begin TLS\r\n") { returner 1 }
    la up = socket.native_tls_oppgrader_server(peer, "tests/fixtures/tls/localhost.crt", "tests/fixtures/tls/localhost.key")
    hvis up["status"] != "tls_ready" { skriv("server upgrade feil: " + up["error"] + "\n") returner 1 }
    la hs = socket.native_tls_handshake(peer)
    la i = 0
    mens hs["status"] == "ventende" og i < 300 {
        socket.native_poll_vent(peer, 3, 100)
        hs = socket.native_tls_handshake(peer)
        i = i + 1
    }
    hvis hs["status"] != "connected" { skriv("server handshake feil: " + hs["error"] + "\n") returner 1 }
    hvis builtin.index_of(les(peer), "PING") < 0 { returner 1 }
    hvis ikkje skriv_alt(peer, "250 secure\r\n") { returner 1 }
    socket.native_poll_vent(peer, 1, 1000)
    socket.native_lukk(peer)
    socket.native_lukk(listener)
    skriv("starttls_server OK\n")
    returner 0
}
