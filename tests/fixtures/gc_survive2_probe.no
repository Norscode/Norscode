funksjon start() -> heiltall {
    la a: liste_heiltall = []
    la j: heiltall = 0
    mens j < 20 { legg_til(a, j * 2)  j = j + 1 }
    la i: heiltall = 0
    mens i < 3000 {
        la t: liste_heiltall = [i, i+1]
        i = i + 1
    }
    la sum: heiltall = 0
    la k: heiltall = 0
    mens k < 20 { sum = sum + a[k]  k = k + 1 }
    returner sum
}
