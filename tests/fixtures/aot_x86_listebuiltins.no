// AOT-fikstur (R4/F09): listebuiltins. Same program på VM og linux-x86_64-AOT skal
// gje identisk utskrift (kvar linje «etikett=verdi»).
funksjon vis(l) -> tekst {
    la d = []
    la i = 0
    mens i < lengde(l) {
        legg_til(d, tekst_fra_heltall(l[i]))
        i = i + 1
    }
    returner "[" + builtin.join(d, ",") + "]"
}


funksjon prov(etikett: tekst, hva: heiltall) -> heiltall {
    la l = [1, 2, 3]
    la t = ["a", "b", "c"]
    prøv {
        hvis hva == 0 { pop_siste([]) }
        hvis hva == 1 { fjern_siste([]) }
        hvis hva == 2 { fjern_indeks(l, 3) }
        hvis hva == 3 { fjern_indeks(l, -1) }
        hvis hva == 4 { sett_inn(l, 4, 9) }
        hvis hva == 5 { sett_inn(l, -1, 9) }
        hvis hva == 6 { skriv("fjern_verdi=" + tekst(fjern(t, "b")) + builtin.join(t, ",") + "\n") }
        hvis hva == 7 { skriv("fjern_verdi_ikkje=" + tekst(fjern(t, "z")) + builtin.join(t, ",") + "\n") }
        hvis hva == 8 { skriv("slice_neg=" + vis(slice(l, 0, 9)) + vis(slice(l, 2, 1)) + vis(slice(l, 1, 3)) + "\n") }
        hvis hva == 9 { skriv("indeks_ut=" + tekst_fra_heltall(l[5]) + "\n") }
        hvis hva == 10 { l[5] = 1 }
        hvis hva == 11 { skriv("nest=" + tekst_fra_heltall(lengde([[1], [2, 3]][1])) + "\n") }
        hvis hva == 12 { skriv("indeks_neg=" + tekst_fra_heltall(l[-1]) + "\n") }
        hvis hva == 13 { skriv("pop_tekst=" + pop_siste(t) + builtin.join(t, ",") + "\n") }
        hvis hva == 14 { skriv("lengde_null=" + tekst_fra_heltall(lengde(null)) + "\n") }
        hvis hva == 15 { skriv("join_tom=[" + builtin.join([], ",") + "]\n") }
        hvis hva == 16 { l[1] = 20  skriv("sett_indeks=" + vis(l) + "\n") }
        hvis hva == 17 { la u = l  legg_til(u, 4)  skriv("alias=" + tekst_fra_heltall(lengde(l)) + "\n") }
        hvis hva == 18 { skriv("sett_inn_tekst=" + builtin.join(t, ",") + "\n") }
    } fang (e) {
        skriv(etikett + "=FEIL\n")
    }
    returner 0
}

funksjon start() -> heiltall {
    la k = 0
    mens k < 19 {
        prov("prov" + tekst_fra_heltall(k), k)
        k = k + 1
    }
    la a = [10, 20, 30, 40]
    skriv("lengde=" + tekst_fra_heltall(lengde(a)) + "\n")
    legg_til(a, 50)
    skriv("legg_til=" + vis(a) + "\n")
    la p = pop_siste(a)
    skriv("pop_siste=" + tekst_fra_heltall(p) + " " + vis(a) + "\n")
    la q = fjern_siste(a)
    skriv("fjern_siste=" + tekst_fra_heltall(q) + " " + vis(a) + "\n")
    la r = fjern_indeks(a, 1)
    skriv("fjern_indeks=" + tekst_fra_heltall(r) + " " + vis(a) + "\n")
    sett_inn(a, 0, 5)
    skriv("sett_inn0=" + vis(a) + "\n")
    sett_inn(a, 2, 7)
    skriv("sett_inn2=" + vis(a) + "\n")
    sett_inn(a, lengde(a), 99)
    skriv("sett_innslutt=" + vis(a) + "\n")
    la s = fjern(a, 0)
    skriv("fjern=" + tekst_fra_heltall(s) + " " + vis(a) + "\n")
    skriv("slice=" + vis(slice(a, 1, 3)) + "\n")
    la b = [1, 2, 3]
    skriv("lik=" + tekst(a == b) + tekst(b == [1, 2, 3]) + tekst(b != [1, 2]) + "\n")
    la tom = []
    skriv("tom=" + tekst_fra_heltall(lengde(tom)) + vis(tom) + "\n")
    la t = ["b", "a"]
    sett_inn(t, 1, "x")
    skriv("tekstliste=" + builtin.join(t, "-") + "\n")
    la m = {"k": 1, "j": 2}
    skriv("verdier=" + vis(verdier(m)) + " nøkler=" + builtin.join(nøkler(m), ",") + "\n")
    la n = 0
    for x i b { n = n + x }
    skriv("for=" + tekst_fra_heltall(n) + "\n")
    returner 0
}
