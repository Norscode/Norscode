# Testapp for W6 (nett i WASM-klienten): sida /test med <pre id="nc-logg"> og JSON-ruter som
# tests/fixtures/wasm_w6_nett_testklient.no hentar med std/wasm_nett.no.
#
#   GET  /api/ok            200 JSON, med headeren x-nc-svar
#   GET  /api/tekst         200 text/plain med linjeskift og æøå
#   POST /api/ekko          201 JSON: kroppen (parsa og skriven att av VM-en), metoden og
#                           headeren x-nc-test frå førespurnaden
#   GET  /api/404, /api/500 404 og 500 med JSON-feil
#   GET  /api/ugyldig_json  200 med Content-Type application/json og ein kropp som ikkje er JSON
#   GET  /api/sakte         200 etter 600 ms (tenaren er oppteken medan)
#   GET  /api/stopp         avsluttar nc serve (builtin.exit): denne og alle seinare
#                           førespurnader får nettverksfeil (offline)
bruk std.web som web
bruk std.wasm_serve som ws

funksjon json_svar(status: heltall, kropp: tekst) -> ordbok_tekst {
    la s = ws.svar("application/json; charset=utf-8", kropp, ws.csp_standard(), "no-store")
    s["status"] = status
    returner s
}

funksjon test_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /test")
    returner ws.side("<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>W6 nett</title>" +
        ws.script_tag() + "</head><body><output id=\"nc-resultat\">–</output><pre id=\"nc-logg\"></pre></body></html>")
}

funksjon api_ok(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/ok")
    la s = json_svar(200, builtin.json_stringify({"hei": "verda", "tal": [1, 2.5, "æ"], "tom": {}, "null": null}))
    s["headers"]["x-nc-svar"] = "ja"
    returner s
}

funksjon api_tekst(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/tekst")
    returner ws.svar("text/plain; charset=utf-8", "rå tekst\nlinje 2 æøå", ws.csp_standard(), "no-store")
}

funksjon api_ekko(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /api/ekko")
    la fekk = builtin.json_parse_raw(web.request_body(ctx))
    returner json_svar(201, builtin.json_stringify({"fekk": fekk, "metode": web.request_method(ctx),
        "header": web.request_header(ctx, "x-nc-test"), "type": web.request_header(ctx, "content-type")}))
}

funksjon api_404(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/404")
    returner json_svar(404, "{\"feil\":\"finst ikkje\"}")
}

funksjon api_500(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/500")
    returner json_svar(500, "{\"feil\":\"intern\"}")
}

funksjon api_ugyldig_json(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/ugyldig_json")
    returner json_svar(200, "{ikkje json")
}

funksjon api_sakte(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/sakte")
    la t0 = builtin.tid_ms()
    mens builtin.tid_ms() - t0 < 600 { }
    returner ws.svar("text/plain; charset=utf-8", "sein", ws.csp_standard(), "no-store")
}

funksjon api_stopp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/stopp")
    builtin.exit(0)
    returner json_svar(200, "{}")
}

funksjon start() -> heltall {
    returner 0
}
