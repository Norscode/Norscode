// gc_reuse2_probe.no — som gc_reuse_probe, men med kompilator-liknande former:
// hasha map med indeks (60 nøklar), fjern_nøkkel/reindex, lange strengar (>1 KB),
// lister langt forbi inline-kapasitet (200 element), JSON-rundtur og nøsting.
funksjon sjekksum(live) -> heiltall {
    la s: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(live) {
        la m = live[i]
        s = (s * 31 + lengde(m["namn"]) + m["tal"] + lengde(m["stor_liste"]) + m["stor_liste"][150] + lengde(m["lang"]) + lengde(nøkler(m["kart"])) + lengde(m["kart"]["k37"])) % 1000000007
        i = i + 1
    }
    returner s
}
funksjon støy(n: heiltall) -> heiltall {
    la i: heiltall = 0
    la sum: heiltall = 0
    mens i < n {
        la s = "støy" + tekst(i)
        la m: ordbok_tekst = {}
        la k: heiltall = 0
        mens k < 12 { m["n" + tekst(k)] = s + tekst(k) k = k + 1 }
        fjern_nøkkel(m, "n3")
        la l = []
        mens k < 40 { legg_til(l, k) k = k + 1 }
        la js = json_stringify(m)
        sum = sum + lengde(js) + lengde(l) + lengde(m)
        i = i + 1
    }
    returner sum
}
funksjon start() -> heiltall {
    la live = []
    la lang_base = "abcdefghijklmnopqrstuvwxyz0123456789"
    la lang = ""
    la q: heiltall = 0
    mens q < 40 { lang = lang + lang_base q = q + 1 }
    la i: heiltall = 0
    mens i < 800 {
        la kart: ordbok_tekst = {}
        la k: heiltall = 0
        mens k < 60 { kart["k" + tekst(k)] = "v" + tekst(i) + "-" + tekst(k) k = k + 1 }
        fjern_nøkkel(kart, "k5")
        fjern_nøkkel(kart, "k59")
        la sl = []
        la j: heiltall = 0
        mens j < 200 { legg_til(sl, i + j) j = j + 1 }
        la m: ordbok = {"namn": "obj" + tekst(i), "tal": i * 3, "stor_liste": sl, "lang": lang + tekst(i), "kart": kart}
        m["json"] = json_parse(json_stringify({"a": [1, 2, {"b": "c"}], "d": tekst(i)}))
        legg_til(live, m)
        i = i + 1
        hvis i % 100 == 0 { skriv("setup " + tekst(i) + " bump=" + tekst(builtin.raw_load64(6291456)) + "\n") }
    }
    la s0 = sjekksum(live)
    skriv("s0=" + tekst(s0) + " bump=" + tekst(builtin.raw_load64(6291456)) + "\n")
    la r: heiltall = 0
    mens r < 3 {
        støy(8000)
        la s1 = sjekksum(live)
        skriv("runde " + tekst(r) + ": s=" + tekst(s1) + " bump=" + tekst(builtin.raw_load64(6291456)) + " fri-hovud=" + tekst(builtin.raw_load64(6291496)) + "\n")
        hvis s1 != s0 { skriv("FEIL: sjekksum etter støy\n") returner 3 }
        builtin.gc_collect_native()
        hvis sjekksum(live) != s0 { skriv("FEIL: sjekksum etter collect\n") returner 4 }
        la j: heiltall = 0
        mens j < 800 {
            live[j]["kart"]["k37"] = "v" + tekst(j) + "-37"
            live[j]["kart"]["k0"] = "x" + tekst(r)
            live[j]["stor_liste"][150] = j + 150
            hvis live[j]["json"]["a"][2]["b"] != "c" { skriv("FEIL: json-innhald\n") returner 6 }
            j = j + 1
        }
        hvis sjekksum(live) != s0 { skriv("FEIL: sjekksum etter mutasjon\n") returner 5 }
        r = r + 1
    }
    skriv("reuse2 OK\n")
    returner 0
}
