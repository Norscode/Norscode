funksjon start() -> heiltall {
    la lc: tekst = tekst_til_liten("ABC")
    la c0: heiltall = builtin.char_code(builtin.slice(lc, 0, 1))
    la c1: heiltall = builtin.char_code(builtin.slice(lc, 1, 2))
    skriv("c0=" + tekst(c0) + " c1=" + tekst(c1) + "\n")
    // 'a'=97 'b'=98 forventa; 'A'=65 = ikkje-lowercase; anna = korrupt
    hvis c0 == 97 { returner 0 }
    hvis c0 == 65 { returner 3 }
    returner 4
}
