// gc_sys6_probe.no — rått syscall-primitiv builtin.sys6(nr, a1..a6) + raw_load8/raw_store8.
// getpid(39) > 0; mmap(9) anonym side; "sys6 OK\n" byte for byte via raw_store8;
// write(1, side, 8) == 8; open(2) av "/dev/null" ≥ 0, close(3) == 0, relativ miss → -ENOENT;
// munmap(11) == 0. Exit 0 = primitivet verkar. (Ugyldige peikarar til kernelen er IKKJE
// med: under Rosetta gjev dei SIGSEGV i emulatoren i staden for -EFAULT.)
funksjon start() -> heiltall {
    la pid = builtin.sys6(39, 0, 0, 0, 0, 0, 0)
    hvis pid <= 0 { skriv("getpid feil: " + tekst(pid) + "\n") returner 2 }
    la side = builtin.sys6(9, 0, 4096, 3, 34, -1, 0)
    hvis side <= 0 { skriv("mmap feil: " + tekst(side) + "\n") returner 3 }
    la tekst_ut = "sys6 OK\n"
    la i = 0
    mens i < lengde(tekst_ut) {
        builtin.raw_store8(side + i, builtin.char_code(builtin.slice(tekst_ut, i, i + 1)))
        i = i + 1
    }
    hvis builtin.raw_load8(side) != 115 { skriv("raw_load8 feil\n") returner 4 }
    la n = builtin.sys6(1, 1, side, lengde(tekst_ut), 0, 0, 0)
    hvis n != lengde(tekst_ut) { skriv("write feil: " + tekst(n) + "\n") returner 5 }
    la sti = "/dev/null"
    i = 0
    mens i < lengde(sti) {
        builtin.raw_store8(side + 64 + i, builtin.char_code(builtin.slice(sti, i, i + 1)))
        i = i + 1
    }
    builtin.raw_store8(side + 64 + lengde(sti), 0)
    la fd = builtin.sys6(2, side + 64, 0, 0, 0, 0, 0)
    hvis fd < 0 { skriv("open feil: " + tekst(fd) + "\n") returner 6 }
    hvis builtin.sys6(3, fd, 0, 0, 0, 0, 0) != 0 { skriv("close feil\n") returner 7 }
    la nf = builtin.sys6(2, side + 65, 0, 0, 0, 0, 0)
    hvis nf != -2 { skriv("relativ open gav " + tekst(nf) + " (vil -2)\n") returner 8 }
    la m = builtin.sys6(11, side, 4096, 0, 0, 0, 0)
    hvis m != 0 { skriv("munmap feil: " + tekst(m) + "\n") returner 9 }
    skriv("gc_sys6_probe OK\n")
    returner 0
}
