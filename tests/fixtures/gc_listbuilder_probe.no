// GC-probe (v5e, 2026-09-06): lister bygde av FROSNE rutiner (split/nøkler/literal) med
// > 8 element ligg INLINE i ein payload på 24+n*8 B — markøren registrerte fast 88 B (cap 8)
// → halen frigjord → attbrukt → element 9+ korrupte. Exit 0 = OK.
funksjon start() -> heiltall {
    la s = "a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t"
    la l = builtin.split(s, ",")
    la m: ordbok = {}
    la i: heiltall = 0
    mens i < 30 { m["k" + tekst(i)] = i i = i + 1 }
    la ks = nøkler(m)
    la lit = ["x0","x1","x2","x3","x4","x5","x6","x7","x8","x9","x10","x11"]
    la r: heiltall = 0
    mens r < 3 {
        la n: heiltall = 0
        mens n < 3000 { la tmp = "støy" + tekst(n) + "-" + tekst(r) + "-halepolstring-lang-streng" n = n + 1 }
        prøv { builtin.gc_collect() } fang (e) { }
        hvis lengde(l) != 20 eller l[19] != "t" eller l[8] != "i" { skriv("FEIL split runde " + tekst(r) + ": " + tekst(l[8]) + "\n") returner 2 }
        hvis lengde(ks) != 30 eller ks[29] != "k29" eller ks[10] != "k10" { skriv("FEIL nøkler runde " + tekst(r) + "\n") returner 3 }
        hvis lengde(lit) != 12 eller lit[11] != "x11" eller lit[9] != "x9" { skriv("FEIL literal runde " + tekst(r) + "\n") returner 4 }
        r = r + 1
    }
    skriv("listbuilder OK\n")
    returner 0
}
