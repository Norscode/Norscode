// Sjølvsjekkande vakt: streng + heiltall / manglande nøkkel / kast med samansett melding
funksjon start() -> heiltall {
    la a = "a" + tekst(5)
    skriv("tekst-konkat=" + a + "\n")
    la m: ordbok_tekst = {"x": "1"}
    la v = ""
    prøv { v = tekst(m["mangler"]) } fang (e) { v = "FANG" }
    skriv("mangler=[" + v + "]\n")
    la feil = ""
    prøv { kast "Parserfeil " + tekst(2) + ":" + tekst(10) + " - forventet " + tekst(m["mangler"]) } fang (e) { feil = tekst(e) }
    skriv("kast=[" + feil + "]\n")
    la b = "b" + 7
    hvis b != "b7" { kast "raa-konkat feil: " + b }
    la c = 7 + "c"
    hvis c != "7c" { kast "int+str feil: " + c }
    la n = 0
    n = m["mangler"]
    la d = "d" + n
    skriv("raa-konkat=" + b + " " + c + " [" + d + "]\n")
    la dyn: ordbok_tekst = {"a": "x"}
    dyn["n"] = 5
    la e = dyn["a"] + dyn["n"]
    hvis e != "x5" { kast "dynamisk str+int feil: " + e }
    la f = dyn["n"] + dyn["a"]
    hvis f != "5x" { kast "dynamisk int+str feil: " + f }
    la g = dyn["a"] + dyn["mangler"]
    hvis g != "x" { kast "dynamisk str+null feil: [" + g + "]" }
    skriv("dynamisk=" + e + " " + f + " [" + g + "]\n")
    la b1 = "x" + sann
    la b2 = tekst(usann)
    hvis b1 != "xsann" { kast "bool-konkat feil: " + b1 }
    hvis b2 != "usann" { kast "tekst(usann) feil: " + b2 }
    skriv("bool=" + b1 + " " + b2 + "\n")
    skriv("gc_concat_probe OK\n")
    returner 0
}
