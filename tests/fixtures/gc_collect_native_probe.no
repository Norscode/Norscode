// GC (ii) probe: SAMLA maskinkode-collect. Komponerer dei to validerte allokerings-
// frie maskinkode-rutinene: gc_mark_native (DFS mark + record live-map + lagra
// entry-teljar @0x600038) → gc_sweep_native (les teljar, gc_free hol). Graf: eitt-
// element-liste (DFS-record-rekkjefylgje == adresse-rekkjefylgje, ingen sort) med
// eit DAUDT int-boks-hol (48B) mellom list-boks og payload. Verifiser at holet
// vart marka bort, sweepa og gjenbrukt.
funksjon start() -> heiltall {
    la region = builtin.heap_bump() + 16384
    // A: list-boks @region  [type=3, payload=region+64]
    builtin.raw_store64(region, 3)
    builtin.raw_store64(region + 8, region + 64)
    // DAUDT int-boks @region+16 (ureferert → skal sweepast)
    builtin.raw_store64(region + 16, 1)
    builtin.raw_store64(region + 24, 999)
    // P: payload @region+64  [len=1, cap=1, elem0=region+96]
    builtin.raw_store64(region + 64, 1)
    builtin.raw_store64(region + 72, 1)
    builtin.raw_store64(region + 80, region + 96)
    // E: int-boks @region+96
    builtin.raw_store64(region + 96, 1)
    builtin.raw_store64(region + 104, 12345)
    builtin.heap_set_bump(region + 128)              // bump forbi grafen
    la marka = builtin.gc_mark_native(region)        // mark + record live-map + teljar
    la n = builtin.raw_load64(6291512)               // 0x600038 = live-map entry-teljar
    la freed = builtin.gc_sweep_native(n)            // sweep hola
    la a = builtin.gc_alloc(32)                       // 48>=32 → gjenbruk holet
    hvis marka == 2 og n == 3 og freed == 1 og a == region + 16 {
        skriv("gc_collect_native OK: mark(2 boks)+record(3 entry)+sweep(1 hol) samla → gjenbrukt\n")
        returner 0
    }
    skriv("gc_collect_native FEIL: marka=" + tekst(marka) + " n=" + tekst(n) + " freed=" + tekst(freed) + " a-region=" + tekst(a - region) + "\n")
    returner 1
}
