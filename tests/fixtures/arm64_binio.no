// fil_les_binær round-trip: skriv byte-liste → les tilbake → verifiser.
funksjon start() -> heiltall {
    la p = "/tmp/nc_arm64_binio.bin"
    builtin.fil_skriv_binær(p, builtin.bytes_from_list([10, 20, 30, 200, 255, 0, 7]))
    la b = builtin.bytes_to_list(builtin.fil_les_binær(p))
    builtin.fil_slett(p)
    la r = lengde(b)
    hvis b[3] == 200 { r = r + 100 }
    hvis b[4] == 255 { r = r + 50 }
    returner r
}
