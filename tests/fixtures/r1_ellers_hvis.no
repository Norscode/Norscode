# Fikstur for tests/test_r1_ellers_hvis.no: hvis/ellers i gammal slutt-syntaks.

# `ellers` + linjeskift + `hvis` er ein nøsta hvis med eigen slutt.
funksjon a(x)
    la ut = ""
    hvis x == 1
        ut = "ein"
    ellers
        hvis x == 2
            ut = "to"
        ellers
            ut = "anna"
        slutt
    slutt
    returner ut + "!"
slutt

# `ellers hvis` på same linje er framleis ei kjede med éin slutt.
funksjon b(x)
    hvis x == 1
        returner "ein"
    ellers hvis x == 2
        returner "to"
    ellers
        returner "anna"
    slutt
slutt

# Ein `ellers` etter ein slutt-avslutta indre hvis høyrer til den ytre hvis-en.
funksjon c(x)
    la ut = ""
    hvis x > 0
        hvis x == 1
            ut = "ein"
        slutt
    ellers
        ut = "ikkje-positiv"
    slutt
    returner ut + "."
slutt

# `slutt ellers` på same linje høyrer framleis til same hvis.
funksjon d(x)
    la ut = ""
    hvis x == 1
        ut = "ein"
    slutt ellers
        ut = "anna"
    slutt
    returner ut
slutt

funksjon start()
    returner a(1) + a(2) + a(3) + "|" + b(1) + b(2) + b(3) + "|" + c(1) + c(2) + c(0) + "|" + d(1) + d(2)
slutt
