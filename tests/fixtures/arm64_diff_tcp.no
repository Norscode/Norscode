// A2 differensial-lane: TCP-loopback i éin prosess over den blokkerande sokkel-API-en
// (std.socket → builtin.socket_*). Server bind+lytt på 127.0.0.1, klient connect (kjernen
// fullfører handshaket inn i lytte-køen), accept, send begge vegar, les, lukk. Porten er
// fast (loopback i eigen container/runner); VM- og AOT-køyringa bind han etter kvarandre
// (SO_REUSEADDR).
bruk std.native_gap
bruk std.socket som sok

funksjon start() -> heiltall {
    la port = 47311
    la srv = sok.ny_tcp()
    skriv("bind=" + tekst(sok.bind(srv, "127.0.0.1", port)) + "\n")
    skriv("lytt=" + tekst(sok.lytt(srv, 4)) + "\n")
    la cli = sok.ny_tcp()
    skriv("tilkoble=" + tekst(sok.tilkoble(cli, "127.0.0.1", port)) + "\n")
    la conn = sok.aksepter(srv)
    skriv("aksepter_open=" + tekst(sok.er_open(conn)) + "\n")
    skriv("sendt=" + tekst(sok.send(cli, "ping frå klient")) + "\n")
    skriv("mottok=[" + sok.motta(conn, 1024) + "]\n")
    skriv("svar=" + tekst(sok.send(conn, "pong")) + "\n")
    skriv("klient_fekk=[" + sok.motta(cli, 1024) + "]\n")
    sok.lukk(cli)
    skriv("eof=[" + sok.motta(conn, 1024) + "]\n")
    sok.lukk(conn)
    sok.lukk(srv)
    returner 43
}
