// Stress-test for operand-spilling: djup aritmetikk, samanlikning, indeksering og
// eit 7-arg brukarkall, alt medan operand-djupna er > 6 (mem-modus).
funksjon leggsaman7(a: heiltall, b: heiltall, c: heiltall, d: heiltall, e: heiltall, f: heiltall, g: heiltall) -> heiltall {
    returner a + b + c + d + e + f + g
}
funksjon start() -> heiltall {
    // Djup nøsta aritmetikk → djupn 8 før kollaps.
    la djup = 1 + (2 + (3 + (4 + (5 + (6 + (7 + 8))))))   // = 36
    la r = leggsaman7(1, 2, 3, 4, 5, 6, 7)                // = 28, 7 arg → djupn 7
    la liste = [r, r * 2, r * 3, r + 1, r - 1, r * r, djup, 200]  // 8-elem, djupn 8
    la kart = {"a": r, "b": djup, "c": liste[5], "d": liste[7], "e": 9}  // 5 par → djupn 10
    la sum = liste[0] + liste[7] + leggsaman7(liste[1], liste[2], liste[3], liste[4], liste[5], liste[6], kart["a"])
    // samanlikning på djupn: bygg opp fleire operandar før bruk
    la t = 0
    hvis (liste[0] + liste[1] + liste[2] + liste[3] + liste[4] + liste[5] + liste[6]) > 100 { t = 7 }
    returner (sum + kart["b"] + kart["e"] + t) % 256
}
