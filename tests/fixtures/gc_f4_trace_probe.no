// GC (b) trace-probe (heap-skann): finn lista via struktur (uavhengig av register-
// allokering). Skann [0x600000, bump) etter ein type-3-boks med len==3, følg
// payload→element0→int-boks, verifiser elem0=int(111). Stadfestar liste-layout +
// graf-traversering (mark-fasen sin kjerne). (Rot-skann sjølv er validert i F3.)
funksjon start() -> heiltall {
    la liste: liste_heiltall = [111, 222, 333]
    la bump = builtin.heap_bump()
    la funne: heiltall = 0
    la sett_tag3: heiltall = 0
    la p: heiltall = 6291456
    mens p < bump og funne == 0 {
        hvis builtin.raw_load64(p) == 3 {
            la payload = builtin.raw_load64(p + 8)
            hvis payload >= 6291456 og payload < bump {
                la len = builtin.raw_load64(payload)
                hvis len == 3 {
                    sett_tag3 = sett_tag3 + 1
                    la e0 = builtin.raw_load64(payload + 16)
                    hvis e0 >= 6291456 og e0 < bump {
                        hvis builtin.raw_load64(e0) == 1 og builtin.raw_load64(e0 + 8) == 111 {
                            skriv("trace OK: liste[len=3] elem0=int(111) — layout+traversering verkar\n")
                            funne = 1
                        }
                    }
                }
            }
        }
        p = p + 8
    }
    hvis funne == 1 { returner 0 }
    skriv("trace: fann ikkje (type3+len3-kandidatar: " + tekst(sett_tag3) + ") — layout skil seg\n")
    returner 1
}
