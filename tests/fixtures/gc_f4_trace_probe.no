// GC (b) trace-probe: DYNAMISK liste (legg_til → heap-allokert, ikkje .data-literal).
// Store verdiar (>32767) → ferske heap-element-boksar. Skann heapen etter type-3-boks
// med len==3, følg payload→element0→int-boks, verifiser elem0=int(100111).
funksjon start() -> heiltall {
    la liste: liste_heiltall = []
    legg_til(liste, 100111)
    legg_til(liste, 100222)
    legg_til(liste, 100333)
    la bump = builtin.heap_bump()
    la funne: heiltall = 0
    la kand: heiltall = 0
    la p: heiltall = 6291456
    mens p < bump og funne == 0 {
        hvis builtin.raw_load64(p) == 3 {
            la payload = builtin.raw_load64(p + 8)
            hvis payload >= 6291456 og payload < bump {
                hvis builtin.raw_load64(payload) == 3 {
                    kand = kand + 1
                    la e0 = builtin.raw_load64(payload + 16)
                    hvis e0 >= 6291456 og e0 < bump {
                        hvis builtin.raw_load64(e0) == 1 og builtin.raw_load64(e0 + 8) == 100111 {
                            skriv("trace OK: heap-liste[len=3] elem0=int(100111) — layout+traversering verkar\n")
                            funne = 1
                        }
                    }
                }
            }
        }
        p = p + 8
    }
    hvis funne == 1 { returner 0 }
    skriv("trace: fann ikkje (type3+len3-kandidatar=" + tekst(kand) + ")\n")
    returner 1
}
