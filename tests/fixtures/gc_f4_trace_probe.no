// GC (b) trace-probe: følg objekt-grafen frå rot-skann. Lag ei liste [111,222,333],
// skann stakken etter ein type-3-boks (liste), følg payload→len→element0→int-boks,
// og verifiser at element0 = int 111. Stadfestar layout + graf-traversering (mark).
// Alle reads er i heap-range (mappa BSS) → trygge.
funksjon start() -> heiltall {
    la liste: liste_heiltall = [111, 222, 333]
    la sb = builtin.stack_base()
    la sp = builtin.stack_ptr()
    la bump = builtin.heap_bump()
    la funne: heiltall = 0
    la p = sp
    mens p < sb og funne == 0 {
        la v = builtin.raw_load64(p)
        hvis v >= 6291456 og v < bump {
            hvis builtin.raw_load64(v) == 3 {              // type-tag liste
                la payload = builtin.raw_load64(v + 8)
                hvis payload >= 6291456 og payload < bump {
                    hvis builtin.raw_load64(payload) == 3 {   // len == 3
                        la e0 = builtin.raw_load64(payload + 16)   // element0-peikar
                        hvis e0 >= 6291456 og e0 < bump {
                            hvis builtin.raw_load64(e0) == 1 og builtin.raw_load64(e0 + 8) == 111 {
                                skriv("trace OK: liste[len=3] elem0=int(111) — graf-traversering verkar\n")
                                funne = 1
                            }
                        }
                    }
                }
            }
        }
        p = p + 8
    }
    hvis funne == 1 { returner 0 }
    skriv("trace: fann ikkje forventa liste (layout skil seg / list-ptr ikkje på stakk)\n")
    returner 1
}
