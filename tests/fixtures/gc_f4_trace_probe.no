// GC (b) trace-probe: validerer MARK-fasen sin graf-traversering-logikk (fleir-nivå
// raw_load64-peikar-jakt gjennom NcVal-layouten) ved å byggje ein liste-struktur
// manuelt med raw_store64 og så traversere: boks[3]→payload[len][cap][elem]→int[1][val].
// (Å manipulere EKTE liste-var i ein direkte-kompilert ELF er blokkert av liste-arg-
// quirken; ekte-liste-layout stadfestast når GC køyrer i seeden, F5. Denne validerer
// sjølve traverserings-maskineriet GC-en brukar.)
funksjon start() -> heiltall {
    la base = builtin.heap_bump() + 1024        // trygt fritt heap-område
    // liste-boks @ base: [type=3][payload→ base+64]
    builtin.raw_store64(base, 3)
    builtin.raw_store64(base + 8, base + 64)
    // payload @ base+64: [len=1][cap=1][elem0→ base+128]
    builtin.raw_store64(base + 64, 1)
    builtin.raw_store64(base + 64 + 8, 1)
    builtin.raw_store64(base + 64 + 16, base + 128)
    // int-boks @ base+128: [type=1][value=424242]
    builtin.raw_store64(base + 128, 1)
    builtin.raw_store64(base + 128 + 8, 424242)
    // TRAVERSER (som mark-fasen gjer):
    la tag = builtin.raw_load64(base)
    la payload = builtin.raw_load64(base + 8)
    la len = builtin.raw_load64(payload)
    la e0 = builtin.raw_load64(payload + 16)
    la etype = builtin.raw_load64(e0)
    la eval = builtin.raw_load64(e0 + 8)
    hvis tag == 3 og len == 1 og etype == 1 og eval == 424242 {
        skriv("trace OK: boks[3]→payload[len=1]→elem0 int(424242) — mark-traversering verkar\n")
        returner 0
    }
    skriv("trace FEIL: tag=" + tekst(tag) + " len=" + tekst(len) + " etype=" + tekst(etype) + " eval=" + tekst(eval) + "\n")
    returner 1
}
