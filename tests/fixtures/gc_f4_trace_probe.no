// GC (b) trace-probe: inkrementell — pinne krasjpunkt (build vs scan).
funksjon start() -> heiltall {
    skriv("A: start\n")
    la liste: liste_heiltall = []
    skriv("B: tom liste\n")
    legg_til(liste, 100111)
    legg_til(liste, 100222)
    legg_til(liste, 100333)
    skriv("C: bygd liste\n")
    la bump = builtin.heap_bump()
    skriv("D: bump henta\n")
    la funne: heiltall = 0
    la kand: heiltall = 0
    la p: heiltall = 6291456
    mens p < bump og funne == 0 {
        hvis builtin.raw_load64(p) == 3 {
            la payload = builtin.raw_load64(p + 8)
            hvis payload >= 6291456 og payload < bump {
                hvis builtin.raw_load64(payload) == 3 {
                    kand = kand + 1
                    la e0 = builtin.raw_load64(payload + 16)
                    hvis e0 >= 6291456 og e0 < bump {
                        hvis builtin.raw_load64(e0) == 1 og builtin.raw_load64(e0 + 8) == 100111 { funne = 1 }
                    }
                }
            }
        }
        p = p + 8
    }
    skriv("E: skann ferdig, kand=" + tekst(kand) + " funne=" + tekst(funne) + "\n")
    returner 0
}
