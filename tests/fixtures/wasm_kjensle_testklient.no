# App-kjensle for skjema-demoen (W5, testbygg): måler i WASM-sida sjølv, med builtin.tid_ms
# (Date.now() i nettlesaren), kor lang tid det tek frå ei brukarhending til DOM-en er endra.
# Hendingane går gjennom testkrokane og den ekte hendingsdelegeringa i lastaren, og lyttarane
# i klienten køyrer synkront, så når kroken returnerer, er DOM-en oppdatert. Kvar måling er
# eit gjennomsnitt over mange hendingar (mikrosekund), sidan Date.now() har millisekund-
# oppløysing. Etter kvar hending blir DOM-en lesen og samanlikna med det venta, så ei måling
# av ingenting (hendinga nådde ikkje fram) syner som «feil» > 0.
#
# Loggen (#nc-logg) får «MÅL namn=verdi»-linjer, som tools/wasm_nettlesar.no (maal) og
# tests/test_wasm_w5.no les:
#   start_ms     s.start(): 50 oppføringar og første gjengjeving
#   filter_us    input i filteret («ber» ↔ «»): gjengjeving av 7 eller 50 rader
#   klikk_us     delegert klikk på «Fjern»: fjern ei rad og gjengje
#   send_us      send skjemaet (submit): legg til ei rad og gjengje
#   feil         hendingar der DOM-en ikkje vart som venta (skal vere 0)
bruk std.wasm_vert som vert
bruk examples.wasm_skjema.klient som s

la feil: heltall = 0

funksjon treff_tekst() -> tekst {
    la h = vert.finn("#nc-resultat")
    la t = vert.hent_tekst(h)
    vert.slepp(h)
    returner t
}

funksjon venta(t: tekst) -> heltall {
    hvis treff_tekst() != t { feil = feil + 1 }
    returner 0
}

funksjon start() -> heltall {
    la t0 = builtin.tid_ms()
    s.start()
    la start_ms = builtin.tid_ms() - t0
    venta("50 treff")

    la filter = vert.finn("#filter")
    la n = 20
    la t1 = builtin.tid_ms()
    la i = 0
    mens i < n {
        vert.test_skriv(filter, "ber")
        venta("7 treff")
        vert.test_skriv(filter, "")
        venta("50 treff")
        i = i + 1
    }
    la filter_us = (builtin.tid_ms() - t1) * 1000 / (2 * n)

    # Fjern rad 1..10 med delegerte klikk (50 → 40 treff)
    la t2 = builtin.tid_ms()
    la k = 1
    mens k <= 10 {
        la knapp = vert.finn("button[data-id=\"" + tekst(k) + "\"]")
        vert.test_klikk(knapp)
        vert.slepp(knapp)
        venta(tekst(50 - k) + " treff")
        k = k + 1
    }
    la klikk_us = (builtin.tid_ms() - t2) * 1000 / 10

    # Send skjemaet ti gonger (40 → 50 treff)
    la namn = vert.finn("#namn")
    la epost = vert.finn("#epost")
    la skjema = vert.finn("#skjema")
    la t3 = builtin.tid_ms()
    la j = 1
    mens j <= 10 {
        vert.test_skriv(namn, "Ny " + tekst(j))
        vert.test_skriv(epost, "ny" + tekst(j) + "@eksempel.no")
        vert.test_send(skjema)
        venta(tekst(40 + j) + " treff")
        j = j + 1
    }
    la send_us = (builtin.tid_ms() - t3) * 1000 / 10

    skriv("MÅL start_ms=" + tekst(start_ms) + "\n")
    skriv("MÅL filter_us=" + tekst(filter_us) + "\n")
    skriv("MÅL klikk_us=" + tekst(klikk_us) + "\n")
    skriv("MÅL send_us=" + tekst(send_us) + "\n")
    skriv("MÅL feil=" + tekst(feil) + "\n")
    returner 0
}
