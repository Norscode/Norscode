// AOT-fikstur: builtin.lower/upper (tekst_til_liten/tekst_til_store) på lange tekstar.
// x86-64-atoma kopierte via ein fast 256-byte stakkbuffer → tekst > 256 byte skreiv over
// returadressa (SIGSEGV på Linux-stage0 frå lengd 257). Same program på VM og
// linux-x86_64-AOT skal gje utskrifta i aot_x86_tekst_case_lang.forventa.
// Berre ASCII A–Z/a–z blir bytte; UTF-8 for æøå/ÆØÅ skal liggje urørt.

funksjon gjenta(p: tekst, n: heiltall) -> tekst {
    la ut = ""
    la del = p
    la k = n
    mens k > 0 {
        hvis k % 2 == 1 { ut = ut + del }
        del = del + del
        k = k / 2
    }
    returner ut
}

funksjon b(v: boolsk) -> tekst {
    hvis v { returner "ja" }
    returner "nei"
}

funksjon prøv_ascii(n: heiltall) -> heiltall {
    la s = gjenta("A", n)
    la l = builtin.lower(s)
    la u = builtin.upper(l)
    skriv("ascii n=" + tekst_fra_heltall(n) + " lower=" + b(l == gjenta("a", n)) +
          " upper=" + b(u == s) + " kjelde=" + b(s == gjenta("A", n)) + "\n")
    returner 0
}

funksjon prøv_norsk(k: heiltall) -> heiltall {
    // 31 byte per bit: ÆØÅ (6) + mellomrom + æøå (6) + mellomrom + 16 ASCII + tab.
    la s = gjenta("ÆØÅ æøå Hei-Verda_ZAza09\t", k)
    la l = tekst_til_liten(s)
    la u = tekst_til_store(s)
    skriv("norsk k=" + tekst_fra_heltall(k) + " bytes=" + tekst_fra_heltall(lengde(s)) +
          " lower=" + b(l == gjenta("ÆØÅ æøå hei-verda_zaza09\t", k)) +
          " upper=" + b(u == gjenta("ÆØÅ æøå HEI-VERDA_ZAZA09\t", k)) +
          " lengd=" + b(lengde(l) == lengde(s) og lengde(u) == lengde(s)) + "\n")
    returner 0
}

funksjon start() -> heiltall {
    for n i [0, 1, 255, 256, 257, 300, 4096, 100000] { prøv_ascii(n) }
    for k i [1, 8, 9, 200, 3000] { prøv_norsk(k) }
    // Mange allokeringar etter kvarandre (GC-modus): resultatet må vere ein ny, rett tekst.
    la s = gjenta("Norscode ÆØÅ ", 400)
    la venta = gjenta("norscode ÆØÅ ", 400)
    la feil = 0
    la i = 0
    mens i < 300 {
        hvis builtin.lower(s) != venta { feil = feil + 1 }
        i = i + 1
    }
    skriv("gjenteke feil=" + tekst_fra_heltall(feil) + "\n")
    returner 0
}
