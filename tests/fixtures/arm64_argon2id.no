// Same import som fullhost-nc_main. Ingen std.argon2id-wrapper kan skjule at
// builtin-ruta peikar på eit mål som manglar i den verkelege runtime-bunten.
bruk std.argon2id_pure som argon2id_pure

funksjon start() -> heiltall {
    la hash = builtin.argon2id("password", "somesalt", 8, 1, 1, 32)
    assert_eq(hash, "f137f8e186a403a679ccd0606e5ab5dcdafe43c1640855ac8c6e33e9bd63eeb3")
    returner 42
}
