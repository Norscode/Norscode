# Hjelpemodul for tests/wasm_korpus/modul_global.no (R2/F14): globalar og ein konstant som
# hovudmodulen les og skriv som alias.NAMN (LOAD_GLOBAL/STORE_GLOBAL med modulnamn), og ei
# toppnivå-setning. Ingen funksjon her blir kalla, så modulen er berre nådd gjennom
# globalane sine; initialiseringa hennar må likevel køyre (WASM: std/wasm_lowring.no).
la teljar = 10
konst NAMN = "modb"
la liste = [1, 2]

skriv("init modul\n")

funksjon auk() -> heltall {
    teljar = teljar + 1
    returner teljar
}
