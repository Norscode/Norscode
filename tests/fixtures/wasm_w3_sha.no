# W3 tree-shaking (tests/test_wasm_w3.no): brukar berre builtin.sha256 (std/sha256.no via
# std.wasm_rt.sha256_hex), og desimaltall(tekst) (den interne vertsfunksjonen tekst_flyt).
funksjon start() -> heltall {
    skriv(sha256("abc") + " " + tekst(desimaltall("2.5") * 2.0) + "\n")
    returner 0
}
