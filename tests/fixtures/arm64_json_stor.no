// A5: json_parse med ein beholdar over 32768 element. Den native parseren samlar
// peikarar i ein 256 KiB-buffer per nivå; før skreiv han forbi bufferet (SIGSEGV).
// No fell han tilbake til selfhost.json.json_les.
bruk selfhost.json som json
bruk std.desimaltall_tekst som dtt

funksjon start() -> heiltall {
    la delar: liste_tekst = []
    la i = 0
    mens i < 40000 { legg_til(delar, tekst(i)) i = i + 1 }
    la l = builtin.json_parse("[" + builtin.join(delar, ",") + "]")
    skriv("n=" + tekst(lengde(l)) + " siste=" + tekst(l[39999]) + "\n")
    returner 0
}
