# Testbygg av teljar-klienten (tests/test_wasm_w0_chrome.no): køyrer den ekte
# examples/wasm_teljar/klient.no og klikkar knappen tre gonger via vertsfunksjonen
# test_klikk, som berre finst når NC_WASM_TESTBYGG=1. Klikka går gjennom den ekte
# hendingslyttaren som klienten registrerer med lytt_klikk.
bruk examples.wasm_teljar.klient som teljar
bruk std.wasm_vert som vert

funksjon start() -> heltall {
    teljar.start()
    la knapp = vert.finn("#knapp")
    la i = 0
    mens i < 3 {
        vert.test_klikk(knapp)
        i = i + 1
    }
    returner 0
}
