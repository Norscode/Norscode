// Sjølvsjekkande vakt: fil_finnes sann for eksisterande, usann for manglande (frosen rutine sa sann for alt)
funksjon start() -> heiltall {
    la a = builtin.fil_finnes("/proc/self/exe")
    la b = builtin.fil_finnes("/finst/ikkje/her")
    la c = builtin.fil_finnes("")
    skriv("finnes=" + tekst(a) + " manglar=" + tekst(b) + " tom=" + tekst(c) + "\n")
    hvis ikkje a { kast "eksisterande fil rapportert som manglande" }
    hvis b { kast "manglande fil rapportert som finst" }
    hvis c { kast "tom sti rapportert som finst" }
    skriv("gc_finnes_probe OK\n")
    returner 0
}
