# Ny versjon av testappen for oppdateringsflyten (W8, tests/test_wasm_w8_oppdatering.no): same
# app og ruter som tests/fixtures/wasm_deltakarar_pwa_testapp.no, men berre teksten på
# offline-sida er endra (så versjonen, sw.js og cachenamnet endrar seg), og ein ny versjon
# ventar alltid til brukaren klikkar «Oppdater» (ingen automatisk aktivering med éi fane).
bruk std.wasm_pwa som pwa
bruk tests.fixtures.wasm_deltakarar_pwa_testapp som a

funksjon pwa_konfig() -> ordbok {
    la k = a.pwa_konfig()
    pwa.med_offline_side(k, "Deltakarar: du er fråkopla (versjon B)", "Denne sida finst ikkje på eininga.")
    pwa.med_aktivering(k, usann)
    returner k
}

funksjon start() -> heltall {
    returner 0
}
