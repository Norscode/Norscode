funksjon summer(n: heiltall) -> heiltall {
    hvis n <= 0 { returner 0 }
    returner n + summer(n - 1)
}
funksjon start() -> heiltall {
    // nøsta: liste av ordbøker, kvar med liste-verdi + bool
    la data: liste = []
    la j: heiltall = 0
    mens j < 30 {
        la rad: ordbok = {}
        map_set(rad, "id", j)
        map_set(rad, "tal", [j, j*2, j*3])
        map_set(rad, "flagg", j % 2 == 0)
        legg_til(data, rad)
        j = j + 1
    }
    // rekursjon + garbage → mange collects medan data er levande
    la i: heiltall = 0
    la sjekk: heiltall = 0
    mens i < 200 {
        sjekk = sjekk + summer(50)
        i = i + 1
    }
    // verifiser data overlevde
    la k: heiltall = 0
    mens k < 30 {
        la rad = data[k]
        hvis map_get(rad, "id") != k { returner 500 + k }
        la tal = map_get(rad, "tal")
        hvis tal[1] != k * 2 { returner 600 + k }
        k = k + 1
    }
    skriv("nested OK: 30 nøsta ordbøker (liste+bool-verdiar) overlevde rekursjon+collect\n")
    returner 0
}
