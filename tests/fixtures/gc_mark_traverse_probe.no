// GC mark-traversering (referanse-algoritme): DFS over objekt-grafen med ein RÅ-
// MINNE mark-stakk (raw_store64/load64 @ scratch 0x10200000) + gc_mark_bit. Byggjer
// ein manuell graf (liste[intA,intB]) og markerer han; verifiserer at boks+element
// blir markerte (marka=3, re-mark=1). Validerer MARK-LOGIKKEN; allokeringsfri
// maskinkode-versjon er seinare optimalisering (design: referanse først).
funksjon start() -> heiltall {
    la base = builtin.heap_bump() + 8192
    // int-boks A @ base+128, B @ base+192
    builtin.raw_store64(base + 128, 1)
    builtin.raw_store64(base + 128 + 8, 100111)
    builtin.raw_store64(base + 192, 1)
    builtin.raw_store64(base + 192 + 8, 100222)
    // liste-boks @ base: [3][payload=base+64]; payload [len=2][cap][e0][e1]
    builtin.raw_store64(base, 3)
    builtin.raw_store64(base + 8, base + 64)
    builtin.raw_store64(base + 64, 2)
    builtin.raw_store64(base + 64 + 8, 2)
    builtin.raw_store64(base + 64 + 16, base + 128)
    builtin.raw_store64(base + 64 + 24, base + 192)
    // DFS-mark frå liste-rota:
    la mstack = 271581184                       // 0x10300000 (scratch mark-stakk)
    la msp = mstack
    builtin.raw_store64(msp, base)              // push root
    msp = msp + 8
    la marka: heiltall = 0
    mens msp > mstack {
        msp = msp - 8
        la addr = builtin.raw_load64(msp)
        hvis addr >= 6291456 {
            hvis builtin.gc_mark_bit(addr) == 0 {
                marka = marka + 1
                hvis builtin.raw_load64(addr) == 3 {
                    la payload = builtin.raw_load64(addr + 8)
                    la len = builtin.raw_load64(payload)
                    la i: heiltall = 0
                    mens i < len {
                        builtin.raw_store64(msp, builtin.raw_load64(payload + 16 + i * 8))
                        msp = msp + 8
                        i = i + 1
                    }
                }
            }
        }
    }
    // Verifiser: alle tre boksane er markerte (gc_mark_bit gjev no 1).
    la m1 = builtin.gc_mark_bit(base)
    la m2 = builtin.gc_mark_bit(base + 128)
    la m3 = builtin.gc_mark_bit(base + 192)
    hvis marka == 3 og m1 == 1 og m2 == 1 og m3 == 1 {
        skriv("mark-traverse OK: DFS markerte liste+2 element (marka=3, alle markerte)\n")
        returner 0
    }
    skriv("mark-traverse FEIL: marka=" + tekst(marka) + " m1=" + tekst(m1) + " m2=" + tekst(m2) + " m3=" + tekst(m3) + "\n")
    returner 1
}
