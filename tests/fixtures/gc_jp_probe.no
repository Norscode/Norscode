funksjon start() -> heiltall {
    // builtin.json_parse_raw → struktur; sjekk via re-serialisering (json_stringify verkar no)
    la v = builtin.json_parse_raw("[10, 20, 30]")
    la ut = builtin.json_stringify(v)
    skriv("parse+str=" + ut + "\n")
    hvis builtin.index_of(ut, "20") < 0 { returner 1 }
    la m = builtin.json_parse_raw("{\"a\": 1, \"b\": 2}")
    la ut2 = builtin.json_stringify(m)
    skriv("parse+str2=" + ut2 + "\n")
    returner 0
}
