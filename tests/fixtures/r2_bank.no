# Fikstur for tests/test_r2_konstruktor.no (F05): struktur i ein annan modul,
# med standardverdi som les ein modulglobal i SIN EIGEN modul.
la START_SALDO = 100

struktur Konto {
    eigar: tekst
    saldo: heltall = START_SALDO
}

funksjon Konto.opna(eigar: tekst) -> Konto {
    returner Konto(eigar)
}

funksjon Konto.set_inn(self, belop: heltall) -> heltall {
    self.saldo = self.saldo + belop
    returner self.saldo
}
