# Fikstur for tests/test_r1_mottakar.no (F04): metodekall på vilkårlege
# mottakaruttrykk, for-/fang-/fanga variablar og CALL_VALUE på uttrykksresultat.
struktur Motor {
    hk: heltall
}
funksjon Motor.effekt(self) -> heltall {
    returner self.hk * 2
}
struktur Bil {
    motor
}
funksjon Bil.effekt(self) -> heltall {
    returner self.motor.effekt()
}
struktur Byggar {
    x: heltall
    y: heltall
}
funksjon Byggar.med_x(self, v: heltall) -> Byggar {
    self.x = v
    returner self
}
funksjon Byggar.med_y(self, v: heltall) -> Byggar {
    self.y = v
    returner self
}
struktur Teljar {
    n: heltall
}
funksjon Teljar.inc(self) -> heltall {
    self.n = self.n + 1
    returner self.n
}
funksjon Teljar.lag_inc(self) {
    returner fun() -> self.inc()
}
struktur MinFeil {
    melding
}
funksjon MinFeil.beskriv(self) -> tekst {
    returner "MinFeil(" + tekst(self.melding) + ")"
}
funksjon lag_motor(hk: heltall) -> Motor {
    la m = Motor()
    m.hk = hk
    returner m
}
funksjon lag_adderar(n: heltall) {
    returner fun(x) -> x + n
}
funksjon start() -> tekst {
    la ut = []
    la b = Bil()
    b.motor = lag_motor(50)
    legg_til(ut, "A=" + tekst(b.effekt()))
    legg_til(ut, "B=" + tekst(b.motor.effekt()))
    legg_til(ut, "C=" + tekst(lag_motor(7).effekt()))
    la ms = [lag_motor(1), lag_motor(2)]
    legg_til(ut, "D=" + tekst(ms[1].effekt()))
    la r = Byggar().med_x(1).med_y(2)
    legg_til(ut, "fluent=" + tekst(r.x) + tekst(r.y))
    la sum = 0
    for m i ms { sum = sum + m.effekt() }
    legg_til(ut, "for=" + tekst(sum))
    la t = Teljar()
    t.n = 0
    la f = t.lag_inc()
    f()
    f()
    legg_til(ut, "lambda=" + tekst(t.n))
    la feil = MinFeil()
    feil.melding = "m1"
    prøv {
        kast feil
    } fang (e) {
        legg_til(ut, "fang=" + e.beskriv())
    }
    la tabell = {"f": fun(x) -> x + 1}
    legg_til(ut, "indeks=" + tekst(tabell["f"](41)))
    legg_til(ut, "kall=" + tekst(lag_adderar(10)(5)))
    returner builtin.join(ut, ",")
}
