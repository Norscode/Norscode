bruk std.protocol_stream som stream
bruk std.tid som tid

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_HTTPS_FRONT_PORT"))
    la mode = miljo_hent("NORSCODE_HTTPS_FRONT_MODE")
    la s = stream.opne_session_ca("localhost", port, sann, 1000, "tests/fixtures/tls/localhost.crt")
    la i = 0
    mens s["status"] != "open" og i < 300 {
        tid.sov(250)
        s = stream.opne_session_ca("localhost", port, sann, 1000, "tests/fixtures/tls/localhost.crt")
        i = i + 1
    }
    hvis s["status"] != "open" { skriv("front connect error=" + s["error"] + " attempts=" + tekst_fra_heltall(i) + "\n") returner 1 }
    la host = hvis mode == "mismatch" da "other.example.test" ellers "localhost"
    assert(stream.skriv_alt(s, "GET /health HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"))
    la r = stream.les_chunk(s, 1048576)
    stream.lukk_session(s)
    assert(r["status"] == "ok")
    hvis mode == "mismatch" {
        assert(builtin.index_of(r["data"], "421 Misdirected Request") >= 0)
        assert(builtin.index_of(r["data"], "127.0.0.1") < 0)
        assert(builtin.index_of(r["data"], "request_rejected") >= 0)
    } ellers hvis mode == "timeout" {
        assert(builtin.index_of(r["data"], "502 Bad Gateway") >= 0)
        assert(builtin.index_of(r["data"], "127.0.0.1") < 0)
        assert(builtin.index_of(r["data"], "request_rejected") >= 0)
    } ellers {
        assert(builtin.index_of(r["data"], "200 OK") >= 0)
        assert(builtin.index_of(r["data"], "backend-ok") >= 0)
    }
    skriv("https_front_client " + mode + " OK\n")
    returner 0
}
