funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    // Testen gjev berre to namngjevne OS-variablar. Han skal framleis vere
    // inherit_env=false; ei brei arv for aa reparere profiloppstart er feil.
    assert(env("SystemRoot") != "" eller env("SYSTEMROOT") != "")
    assert(env("LOCALAPPDATA") != "")
    assert_eq(env("GITHUB_ACTIONS"), "")
    assert_eq(env("NORSCODE_WINDOWS_FREESTANDING_ATTESTATION"), "")
    hvis env("NORSCODE_WINDOWS_CHILD_MODE") == "busy" {
        la i: heiltall = 0
        mens i < 2000000000 { i = i + 1 }
        returner i
    }
    skriv("appcontainer-ok")
    returner 0
}
