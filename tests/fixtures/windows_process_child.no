funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    hvis env("NORSCODE_WINDOWS_CHILD_MODE") == "busy" {
        la i: heiltall = 0
        mens i < 2000000000 { i = i + 1 }
        returner i
    }
    skriv("appcontainer-ok")
    returner 0
}
