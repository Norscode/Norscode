# F45: generatorar (gi). Kvar funksjon c0..cN gjev ein tekst; start() set dei saman med «|».

la logg = []

funksjon teller(n: heiltall) {
    la i = 0
    mens i < n {
        gi i
        i = i + 1
    }
}

funksjon lat_gen() {
    legg_til(logg, "start")
    gi 1
    legg_til(logg, "midt")
    gi 2
    legg_til(logg, "slutt")
}

funksjon stoppar() {
    gi "a"
    gi "b"
    returner 0
    gi "aldri"
}

funksjon kastar() {
    gi 1
    kast "MinFeil: bom"
    gi 2
}

funksjon indre() {
    gi "x"
    gi "y"
}

funksjon ytre() {
    gi "start"
    gi frå indre()
    gi frå ["p", "q"]
    gi "slutt"
}

funksjon naturlege() {
    la n = 0
    mens sann {
        gi n
        n = n + 1
    }
}

funksjon med_try() {
    prøv {
        gi 1
        gi 2
    } fang (e) {
        gi "fanga"
    } endeleg {
        legg_til(logg, "endeleg")
    }
    gi 3
}

funksjon nøsta() {
    for x i [10, 20] {
        hvis x == 20 { gi x + 1 }
        ellers { gi x }
    }
    la inner = teller(2)
    gi neste(inner) + 100
    gi neste(inner) + 100
}

funksjon tom_gen() {
    hvis usann { gi 1 }
}

funksjon kvadrat(x: heiltall) -> heiltall {
    returner x * x
}

funksjon kvadrat_gen(n: heiltall) {
    for i i [1, 2, 3, 4] {
        hvis i > n { returner 0 }
        gi kvadrat(i)
    }
}

funksjon c0() -> tekst {
    la s = ""
    for x i teller(4) { s = s + tekst(x) + "," }
    returner s
}

funksjon c1() -> tekst {
    logg = []
    la g = lat_gen()
    la a = tekst(lengde(logg))
    la v1 = neste(g)
    la b = builtin.join(logg, ",")
    la v2 = neste(g)
    la v3 = neste(g)
    returner a + "/" + b + "/" + tekst(v1) + tekst(v2) + "/" + builtin.join(logg, ",") + "/" + tekst(v3 == null)
}

funksjon c2() -> tekst {
    la g = teller(2)
    la a = neste(g)
    la b = neste(g)
    la c = neste(g)
    la d = neste(g)
    returner tekst(a) + tekst(b) + tekst(c == null) + tekst(d == null)
}

funksjon c3() -> tekst {
    la s = ""
    for x i stoppar() { s = s + x }
    returner s
}

funksjon c4() -> tekst {
    la g = kastar()
    la a = neste(g)
    la melding = ""
    prøv {
        neste(g)
    } fang (e) {
        melding = tekst(e)
    }
    la etter = neste(g)
    returner tekst(a) + "/" + melding + "/" + tekst(etter == null)
}

funksjon c5() -> tekst {
    la s = ""
    for x i ytre() { s = s + x }
    returner s
}

funksjon c6() -> tekst {
    la s = ""
    for n i naturlege() {
        hvis n >= 4 { bryt }
        s = s + tekst(n)
    }
    returner s
}

funksjon c7() -> tekst {
    la g = teller(3)
    la a = g.neste()
    la b = g.neste()
    returner tekst(a) + tekst(b) + tekst(g.ferdig()) + tekst(g.neste()) + tekst(g.ferdig())
}

funksjon c8() -> tekst {
    la gi = 5
    gi = gi + 1
    la liste = [gi, gi * 2]
    returner tekst(gi) + tekst(liste[1])
}

funksjon c9() -> tekst {
    la a = teller(3)
    la b = teller(5)
    la ein = return_c9(a, b)
    returner ein + "/" + return_c9(a, b)
}

funksjon return_c9(a, b) -> tekst {
    returner tekst(neste(a)) + tekst(neste(b)) + tekst(neste(a))
}

funksjon c10() -> tekst {
    la g = naturlege()
    la s = ""
    for n i g {
        s = s + tekst(n)
        hvis n == 2 { bryt }
    }
    returner s + ";" + tekst(neste(g)) + tekst(neste(g))
}

funksjon c11() -> tekst {
    logg = []
    la s = ""
    for x i med_try() { s = s + tekst(x) }
    returner s + "[" + builtin.join(logg, ",") + "]"
}

funksjon c12() -> tekst {
    la s = ""
    for x i nøsta() { s = s + tekst(x) + "," }
    returner s
}

funksjon c13() -> tekst {
    la n = 0
    for x i tom_gen() { n = n + 1 }
    return_ok(n)
    returner tekst(n) + tekst(neste(tom_gen()) == null)
}

funksjon return_ok(n: heiltall) -> heiltall { returner n }

funksjon c14() -> tekst {
    la s = ""
    for x i kvadrat_gen(3) { s = s + tekst(x) + "," }
    la t = 0
    for y i [1, 2, 3] { t = t + y }
    returner s + tekst(t)
}

funksjon c15() -> tekst {
    la g = teller(2)
    returner builtin.type(g) + ":" + builtin.type([1])
}

funksjon neg_gen() {
    gi -1
    la x = 4
    gi -x
}

funksjon c16() -> tekst {
    // `gi -1` er yield av eit negativt tal; `gi - 1` og `gi-1` er subtraksjon på variabelen gi.
    la g = neg_gen()
    la a = g.neste()
    la b = g.neste()
    la gi = 10
    la sub1 = gi - 1
    la sub2 = gi-1
    returner tekst(a) + "," + tekst(b) + "," + tekst(sub1) + "," + tekst(sub2)
}

funksjon start() -> tekst {
    la d = [c0(), c1(), c2(), c3(), c4(), c5(), c6(), c7(), c8(), c9(), c10(), c11(), c12(), c13(), c14(), c15(), c16()]
    returner builtin.join(d, "|")
}
