la teljar: heiltall = 1
la verdiar: ordbok_tekst = {}
la røter: liste_tekst = []

funksjon auk() -> heiltall {
    teljar = teljar + 1
    verdiar["sist"] = tekst_fra_heiltall(teljar)
    returner teljar
}

funksjon press_gc() -> heiltall {
    la i: heiltall = 0
    mens i < 2500 {
        legg_til(røter, "verdi-" + tekst_fra_heiltall(i))
        i = i + 1
    }
    returner lengde(røter)
}

funksjon start() -> heiltall {
    assert_eq(auk(), 2)
    assert_eq(auk(), 3)
    assert_eq(verdiar["sist"], "3")
    assert_eq(press_gc(), 2500)
    assert_eq(røter[0], "verdi-0")
    assert_eq(røter[2499], "verdi-2499")
    assert_eq(teljar, 3)
    returner 0
}
