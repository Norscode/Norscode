// A2 differensial-lane: hendingsventing (network_operation «poll» = epoll på Linux) og
// den ikkje-blokkerande nettverkskontrakten (std.socket native_*: listen/connect/accept/
// write/read/close via handle, «norscode-native-network-v1»).
bruk std.native_gap
bruk std.socket som sok

funksjon poll(h, events: heiltall, ms: heiltall) -> tekst {
    la r = sok.native_poll_vent(h, events, ms)
    returner tekst(r["status"]) + "/" + tekst(r["value"])
}

funksjon start() -> heiltall {
    la l = sok.native_lytt("127.0.0.1", 0, 8)
    la port = heltall_fra_tekst(tekst(l["port"]))
    skriv("lytt=" + tekst(l["status"]) + " port>0=" + tekst(port > 0) + "\n")
    skriv("poll_tom=" + poll(l, 1, 30) + "\n")
    la c = sok.native_tilkoble("127.0.0.1", port)
    skriv("tilkoble=" + tekst(c["status"]) + "\n")
    skriv("poll_lytt=" + poll(l, 1, 2000) + "\n")
    la a = sok.native_aksepter(l)
    skriv("aksepter=" + tekst(a["status"]) + "\n")
    skriv("poll_skrivbar=" + poll(c, 2, 2000) + "\n")
    skriv("poll_ingen_data=" + poll(a, 1, 30) + "\n")
    la w = sok.native_skriv(c, "epoll-data")
    skriv("skriv=" + tekst(w["status"]) + "/" + tekst(w["value"]) + "\n")
    skriv("poll_data=" + poll(a, 1, 2000) + "\n")
    la r = sok.native_les(a, 64)
    skriv("les=" + tekst(r["status"]) + " [" + tekst(r["data"]) + "]\n")
    sok.native_lukk(c)
    skriv("poll_eof=" + poll(a, 1, 2000) + "\n")
    la e = sok.native_les(a, 64)
    skriv("les_eof=" + tekst(e["status"]) + "\n")
    sok.native_lukk(a)
    sok.native_lukk(l)
    returner 44
}
