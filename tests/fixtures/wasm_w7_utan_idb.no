# W7: ein klientmodul som opnar ein database der IndexedDB ikkje finst (JavaScriptCore-skalet
# i tests/test_wasm_w7.no). Opninga og køyr som venta på ho, får LagerFeil «open» i
# rekkjefølgje, og ingenting når JavaScript som «Uncaught».
bruk std.wasm_lager som lager

funksjon start() -> heltall {
    la db = lager.opne("nc-utan", 1, [lager.lager("a", "id", [])], fun(d) -> skriv("opna\n"),
        fun(f) -> skriv("opne: " + f["art"] + " " + f["namn"] + "\n"))
    lager.tel(db, "a", null, fun(n) -> skriv("tel\n"), fun(f) -> skriv("tel: " + f["art"] + "\n"))
    lager.slett_database("nc-utan", fun(x) -> skriv("sletta\n"), fun(f) -> skriv("slett: " + f["art"] + " " + f["namn"] + "\n"))
    skriv("sendt: " + tekst(lager.ventande()) + "\n")
    returner 0
}
