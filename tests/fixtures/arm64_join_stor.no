// A5: builtin.join i ARM64-AOT — lineær snøggveg (to pass) for tekstelement; før var
// join O(n²) i tid og minne og gjekk tom for heap på 70 000 delar utan GC.
funksjon prøv_join(n: heiltall, del: tekst, sep: tekst) -> heiltall {
    la d: liste_tekst = []
    la i = 0
    mens i < n { legg_til(d, del + tekst(i % 3)) i = i + 1 }
    la ut = builtin.join(d, sep)
    la kort = ut
    hvis lengde(ut) > 30 { kort = builtin.slice(ut, 0, 30) }
    skriv("n=" + tekst(n) + " len=" + tekst(lengde(ut)) + " [" + kort + "]\n")
    returner 0
}
funksjon start() -> heiltall {
    prøv_join(0, "ab", ",")
    prøv_join(1, "ab", ",")
    prøv_join(5, "ab", ", ")
    prøv_join(10, builtin.chr(0), "")
    prøv_join(70000, "a", "")
    prøv_join(200000, "xy", "-")
    skriv(builtin.join(["a", "b"], "") + builtin.join([], "x") + "|\n")
    returner 0
}
