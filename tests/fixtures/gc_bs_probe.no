// Codegen-regresjonsvakt: bakstrek-konstant må overleve innbaking. Codegen dekodar
// escape-sekvensar når konstantar blir baka inn, men json_parse_raw(fil_les) dekodar
// ALT i nokre runtimes (stage-0-seed) → dobbeltdekoding gjorde "a\b" (rå a,\,b) til
// a+backspace. Dekodinga er no sjølvkalibrert. Exit 0 = konstanten er a,\,b (3 teikn).
funksjon start() -> heiltall {
    la k = "a\\b"
    skriv("RAW=[" + k + "] len=" + tekst(lengde(k)) + "\n")
    hvis lengde(k) != 3 {
        skriv("FEIL: venta lengd 3 (a, bakstrek, b)\n")
        returner 1
    }
    hvis builtin.slice(k, 1, 2) != builtin.chr(92) {
        skriv("FEIL: midtteiknet er ikkje bakstrek\n")
        returner 2
    }
    la rt = builtin.json_stringify([builtin.chr(92), "x" + builtin.chr(92) + "y"])
    hvis rt != "[\"\\\\\",\"x\\\\y\"]" {
        skriv("FEIL: json_stringify av runtime-bakstrek: " + rt + "\n")
        returner 3
    }
    skriv("bs OK\n")
    returner 0
}
