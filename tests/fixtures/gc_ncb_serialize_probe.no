// Real native serializer stress, without subprocess isolation. The VM builtin
// ncb_til_binaer calls this same serde.serialiser_tekst implementation. Keep a
// compiler-shaped live graph and serialize it 60 times under the normal GC cap.
bruk selfhost.ncb_serde som serde

funksjon lag_ncb() -> ordbok {
    la functions: ordbok = {}
    la f: heiltall = 0
    mens f < 500 {
        la code: liste = []
        la lines: liste = []
        la columns: liste = []
        la i: heiltall = 0
        mens i < 64 {
            legg_til(code, ["PUSH_CONST", f + i])
            legg_til(code, ["POP"])
            legg_til(lines, i + 1)
            legg_til(lines, i + 1)
            legg_til(columns, 5)
            legg_til(columns, 5)
            i = i + 1
        }
        legg_til(code, ["PUSH_CONST", f])
        legg_til(code, ["RETURN"])
        legg_til(lines, 65)
        legg_til(lines, 65)
        legg_til(columns, 5)
        legg_til(columns, 5)
        la name: tekst = "probe.f" + tekst(f)
        functions[name] = {"name": name, "module": "probe", "params": [],
            "code": code, "source_lines": lines, "source_columns": columns}
        f = f + 1
    }
    returner {"format": "norscode-bytecode-v1", "entry": "probe.f0", "functions": functions}
}

funksjon start() -> heiltall {
    la ncb = lag_ncb()
    la original: tekst = serde.serialiser_tekst(ncb)
    la maks: heiltall = builtin.heap_bump()
    la i: heiltall = 0
    mens i < 60 {
        la ut: tekst = serde.serialiser_tekst(ncb)
        hvis ut != original {
            skriv("gc_ncb_serialize FEIL: byte endra i omgang " + tekst(i) + "\n")
            returner 2
        }
        la bump: heiltall = builtin.heap_bump()
        hvis bump > maks { maks = bump }
        i = i + 1
    }
    // Retained data and the encoded stream must still be useful, not merely
    // equal corrupted buffers. Decode once after the repeated collections.
    la tilbake = serde.deserialiser_tekst(original)
    hvis lengde(tilbake["functions"]) != 500 eller
       tilbake["functions"]["probe.f499"]["code"][128][1] != 499 {
        skriv("gc_ncb_serialize FEIL: levande graf øydelagd\n")
        returner 3
    }
    skriv("gc_ncb_serialize OK: 60 omgangar, " + tekst(lengde(original)) +
          " identiske byte, maks_bump=" + tekst(maks) + "\n")
    returner 0
}
