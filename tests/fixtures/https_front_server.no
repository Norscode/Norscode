bruk std.https_front som https_front

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_HTTPS_FRONT_PORT"))
    la backend_port = heltall_fra_tekst(miljo_hent("NORSCODE_HTTPS_BACKEND_PORT"))
    la mode = miljo_hent("NORSCODE_HTTPS_FRONT_MODE")
    la f = https_front.ny("tests/fixtures/tls/localhost.crt", "tests/fixtures/tls/localhost.key")
    f["accept_timeout_ms"] = 120000
    la read_ms = hvis mode == "timeout" da 500 ellers 120000
    assert(https_front.sett_grenser(f, 2000, read_ms, 65536, 1048576, 1048576))
    assert(https_front.legg_til_domene(f, "localhost", "127.0.0.1", backend_port))
    assert(https_front.opne(f, "127.0.0.1", port))
    assert(https_front.serve_once(f))
    https_front.lukk(f)
    la t = https_front.telemetri(f)
    assert(t["requests"] == 1)
    hvis mode == "mismatch" { assert(t["rejected"] == 1) assert(t["routed"] == 0) }
    ellers hvis mode == "timeout" { assert(t["backend_errors"] == 1) assert(t["timeouts"] == 1) assert(t["routed"] == 0) }
    ellers { assert(t["routed"] == 1) assert(t["rejected"] == 0) }
    skriv("https_front_server " + mode + " OK\n")
    returner 0
}
