// arm64: kartoppslag med heiltalsnøkkel slår opp tekstnøkkelen (d[0] → d["0"]) som VM-en
// og x86-AOT; før deref-a arm64 heiltalet som strdata (SIGSEGV i test_domenehost_e2e).
funksjon start() -> heiltall {
    la d = {"0": "a", "1": "b", "12": "c"}
    la i = 0
    mens i < 3 {
        skriv(tekst(d[i]) + "|")
        i = i + 1
    }
    skriv(tekst(d[12]) + "|" + builtin.type(d[99]) + "\n")
    returner 0
}
