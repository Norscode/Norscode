// Fase 6: fil-I/O (fil_skriv/fil_les/fil_finnes). Skriv, les tilbake, samanlikn
// innhaldet, og prøv finnes på både eksisterande og ikkje-eksisterande fil.
// Forventa: lengde(innhald)=15 + ok=1 + f=2 = 18.
funksjon start() -> heiltall {
    builtin.fil_skriv("/tmp/nc_arm64_fileio_test.txt", "Norscode fase 6")
    la innhald = builtin.fil_les("/tmp/nc_arm64_fileio_test.txt")
    la ok = 0
    hvis innhald == "Norscode fase 6" { ok = 1 }
    la f = 0
    hvis builtin.fil_finnes("/tmp/nc_arm64_fileio_test.txt") { f = 1 }
    hvis ikkje builtin.fil_finnes("/tmp/nc_ikkje_her_98765.txt") { f = f + 1 }
    returner lengde(innhald) + ok + f
}
