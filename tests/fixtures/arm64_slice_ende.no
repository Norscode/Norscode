// arm64: builtin.slice-grenser som referansen — end forbi lengda (JSON-tal ved inputslutt),
// negativ end = «til slutten» (__nclit_decode_v9400), negativ start (tekst: 0, liste: tom).
funksjon grense(c: tekst) -> boolsk {
    returner c == "" eller c == " " eller c == "," eller c == "]" eller c == "}"
}
funksjon start() -> heiltall {
    la s = "123"
    la a = builtin.slice(s, 3, 4)
    skriv("[" + a + "] " + tekst(lengde(a)) + "\n")
    skriv("[" + builtin.slice(s, 2, 9) + "]\n")
    skriv("[" + builtin.slice(s, 5, 9) + "]\n")
    hvis grense(builtin.slice(s, 3, 4)) { skriv("grense ok\n") } ellers { skriv("grense FEIL\n") }
    hvis a == "" { skriv("tom\n") } ellers { skriv("ikkje tom\n") }
    la t = "abcdef"
    skriv("[" + builtin.slice(t, 1, -1) + "][" + builtin.slice(t, 1, -2) + "][" + builtin.slice(t, -3, 5) + "][" +
          builtin.slice(t, -2, -1) + "][" + builtin.slice(t, 4, 2) + "][" + builtin.slice(t, -99, 2) + "][" +
          builtin.slice(t, 9, 12) + "]\n")
    skriv("[" + builtin.slice("__nclit__ 123 ", 9, -1) + "]\n")
    la l = [1, 2, 3, 4]
    skriv(builtin.json_stringify(builtin.slice(l, 1, -1)) + builtin.json_stringify(builtin.slice(l, -2, 9)) +
          builtin.json_stringify(builtin.slice(l, -2, 3)) + builtin.json_stringify(builtin.slice(l, 3, 1)) +
          builtin.json_stringify(builtin.slice(l, 1, 99)) + builtin.json_stringify(builtin.slice(l, 0, -3)) + "\n")
    returner 0
}
