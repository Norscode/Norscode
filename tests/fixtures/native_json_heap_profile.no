funksjon start() {
    la sti = miljo_hent("NORSCODE_JSON_HEAP_PROFILE_FILE")
    la rå = fil_les(sti)
    la før = builtin.native_heap_bytes()
    la verdi = json_parse_raw(rå)
    la etter = builtin.native_heap_bytes()
    skriv("JSON_HEAP_PROFILE bytes=" + tekst_fra_heltall(lengde(rå)) + " keys=" + tekst_fra_heltall(lengde(nøkler(verdi))) + " delta=" + tekst_fra_heltall(etter - før) + " total=" + tekst_fra_heltall(etter))
}
