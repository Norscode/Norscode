// A5: fil_les på manglande fil kastar «Kan ikkje opne fil: <sti>» som VM-en. vm.no sin
// _rt_fil_finnes er fil_les i prøv, så utan kastet svara fil_finnes sann for alt.
funksjon start() -> heiltall {
    prøv { la s = fil_les("/tmp/finst_ikkje_xyz") skriv("ingen feil: [" + s + "]\n") } fang (e) { skriv("feil: " + tekst(e) + "\n") }
    prøv { la s = builtin.fil_les("/tmp") skriv("ingen feil kat: [" + tekst(lengde(s)) + "]\n") } fang (e) { skriv("feil kat: " + tekst(e) + "\n") }
    returner 0
}
