// Sjølvsjekkande vakt: builtin.vent.sov(ms) må FAKTISK sove i AOT-en (nanosleep #35).
// Seed-runtimen var no-op → test_vm_vent_sleep raud. Exit 0 = søv ≥ 40 ms av 60.
funksjon start() -> heiltall {
    la t0 = builtin.tid_ms()
    builtin.vent.sov(60)
    la brukt = builtin.tid_ms() - t0
    skriv("sov brukt=" + tekst(brukt) + "\n")
    hvis brukt < 40 { kast "vent.sov sov ikkje: " + tekst(brukt) + " ms" }
    hvis brukt > 5000 { kast "vent.sov sov for lenge: " + tekst(brukt) + " ms" }
    builtin.vent.sov(0)
    builtin.vent.sov(-5)
    skriv("gc_sov_probe OK\n")
    returner 0
}
