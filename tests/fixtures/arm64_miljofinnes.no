// miljo_finnes via overlay (miljo_sett). Uniform på Linux (envp=NULL native) og macOS.
funksjon start() -> heiltall {
    builtin.miljo_sett("NC_TESTVAR", "hei")
    la a = 0
    hvis builtin.miljo_finnes("NC_TESTVAR") { a = a + 10 }
    hvis builtin.miljo_finnes("NC_MISSING_VAR_XYZ") { a = a + 1 }
    returner a
}
