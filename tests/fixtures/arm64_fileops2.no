// fil_append + fil_sett_kjorbar + fil_slett (native syscalls).
funksjon start() -> heiltall {
    la p = "/tmp/nc_arm64_fileops2.txt"
    builtin.fil_skriv(p, "Hei")
    builtin.fil_append(p, " verden")
    la innhald = builtin.fil_les(p)
    la a = lengde(innhald)
    builtin.fil_sett_kjorbar(p)
    la fanst = builtin.fil_finnes(p)
    builtin.fil_slett(p)
    la borte = builtin.fil_finnes(p)
    la r = a
    hvis fanst { r = r + 5 }
    hvis ikkje borte { r = r + 3 }
    returner r
}
