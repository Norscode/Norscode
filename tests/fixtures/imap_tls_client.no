bruk std.imaplib som imap

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_IMAP_E2E_PORT"))
    la mode = miljo_hent("NORSCODE_IMAP_E2E_MODE")
    la c = hvis mode == "starttls" da imap.connect_starttls("localhost", port, "tests/fixtures/tls/localhost.crt") ellers imap.connect_ca("localhost", port, sann, "tests/fixtures/tls/localhost.crt")
    assert(c["tilkopla"])
    hvis ikkje imap.login(c, "user@example.test", "password") {
        skriv("login status=" + c["last_status"] + " error=" + c["last_error"] + " raw=" + c["last_raw"] + "\n")
        returner 1
    }
    assert(imap.select(c, "INBOX"))
    la folders = imap.list(c)
    assert(lengde(folders) == 1)
    la ids = imap.search(c, "UNSEEN")
    assert(lengde(ids) == 2)
    assert(ids[0] == "42")
    assert(ids[1] == "77")
    assert(imap.reconnect_count(c) == 1)

    la first = imap.fetch(c, ids[0])
    assert(first["error"] == "")
    assert(first["subject"] == "Hei frå IMAP")
    assert(lengde(first["flags"]) == 2)
    assert(ikkje first["duplicate"])
    la second = imap.fetch(c, ids[0])
    assert(second["duplicate"])
    assert(imap.store_seen(c, ids[0]))
    imap.logout(c)
    assert(ikkje c["tilkopla"])
    skriv("imap_tls_client OK\n")
    returner 0
}
