// Arbeidarprogram for tests/test_multiprocessing_prosess_map.no under VM-en
// (`nc run tests/fixtures/prosess_map_arbeidar.no` via mp.arbeidar_kommando).
// I AOT er arbeidaren testbinæren sjølv; begge brukar arbeid() herifrå.
//
// Verdiane er «op:arg»:
//   kv:<n>     → n*n
//   ekko:<t>   → t (rundtur for spesialteikn)
//   sov:<ms>   → søv ms og svarar «start:slutt» (tid_ms) — to overlappande
//                intervall kan berre kome frå to prosessar som køyrde samstundes
//   bom:<t>    → kastar «ArbeidFeil: <t>»
//   ""         → «tom»
bruk std.multiprocessing som mp

funksjon arbeid(x: tekst) -> tekst {
    hvis x == "" { returner "tom" }
    la k = builtin.index_of(x, ":")
    la op = x
    la arg = ""
    hvis k >= 0 {
        op = builtin.slice(x, 0, k)
        arg = builtin.slice(x, k + 1, lengde(x))
    }
    hvis op == "kv" {
        la n = heltall_fra_tekst(arg)
        returner tekst(n * n)
    }
    hvis op == "ekko" { returner arg }
    hvis op == "sov" {
        la t0 = builtin.tid_ms()
        builtin.vent.sov(heltall_fra_tekst(arg))
        returner tekst(t0) + ":" + tekst(builtin.tid_ms())
    }
    hvis op == "bom" { kast "ArbeidFeil: " + arg }
    kast "ArbeidFeil: ukjend op «" + op + "»"
    returner ""
}

funksjon start() -> heiltall {
    returner mp.prosessarbeidar(fun(x) -> arbeid(x))
}
