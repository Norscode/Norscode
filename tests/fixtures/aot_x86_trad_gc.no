// F37 grøne trådar + GC: fleire trådar som allokerer og gjev frå seg kontrollen (yield) medan GC
// køyrer. Alle trådstakkar (inkl. hovudstakken medan ein grøn tråd køyrer) må vere røter.
// Bygg med NORSCODE_GC_ALLOC=1 (GC-modus) og utan (bump-heap): begge må gje exit 42.
bruk std.native_gap

funksjon spawn(fn: tekst, args: ordbok) -> ordbok {
    returner builtin.thread_spawn({"abi": "norscode-native-thread-v1", "operation": "spawn", "fn": fn,
        "args": args, "name": "t", "stack_bytes": "65536"})
}
funksjon join(h: ordbok) -> ordbok {
    returner builtin.thread_join({"abi": "norscode-native-thread-v1", "operation": "join",
        "handle": h["handle"], "thread_id": h["thread_id"], "timeout_ms": "30000"})
}
funksjon gje_etter() -> heiltall {
    builtin.thread_sync({"abi": "norscode-native-thread-v1", "operation": "yield", "handle": "x", "thread_id": "x", "timeout_ms": "0"})
    returner 0
}

funksjon fyll(n: heiltall) -> tekst {
    la s = ""
    la i = 0
    mens i < n { s = s + "x"  i = i + 1 }
    returner s
}

funksjon arbeider(args: ordbok) -> tekst {
    la k = args["k"]
    la liste = []
    la kart = {}
    la i = 0
    mens i < 400 {
        la verdi = "t" + k + "-" + tekst_fra_heltall(i)
        legg_til(liste, verdi)
        kart[verdi] = [i, k, fyll(40)]
        la boss = fyll(300)              // søppel
        gje_etter()
        i = i + 1
    }
    // kontroller at alt framleis er intakt
    i = 0
    mens i < 400 {
        la v = "t" + k + "-" + tekst_fra_heltall(i)
        hvis liste[i] != v { returner "FEIL liste " + v }
        la e = kart[v]
        hvis e[0] != i eller e[1] != k eller lengde(e[2]) != 40 { returner "FEIL kart " + v }
        i = i + 1
    }
    returner "ok" + k
}

funksjon start() -> heiltall {
    // data på hovudstakken/-heapen som må overleve medan trådane køyrer
    la hovud = []
    la i = 0
    mens i < 300 { legg_til(hovud, "h-" + tekst_fra_heltall(i))  i = i + 1 }
    la hs = []
    i = 0
    mens i < 4 {
        legg_til(hs, spawn("__main__.arbeider", {"k": tekst_fra_heltall(i)}))
        i = i + 1
    }
    // hovudtråden bidreg òg med allokering og yield
    la r = 0
    mens r < 100 {
        la garb = fyll(500)
        gje_etter()
        r = r + 1
    }
    i = 0
    mens i < 4 {
        la ri = join(hs[i])
        hvis ri["status"] != "finished" { skriv("join " + tekst(ri) + "\n")  returner 2 }
        hvis ri["value"] != "ok" + tekst_fra_heltall(i) { skriv("verdi " + tekst(ri["value"]) + "\n")  returner 3 }
        i = i + 1
    }
    i = 0
    mens i < 300 {
        hvis hovud[i] != "h-" + tekst_fra_heltall(i) { returner 4 }
        i = i + 1
    }
    skriv("aot_x86_trad_gc OK\n")
    returner 42
}
