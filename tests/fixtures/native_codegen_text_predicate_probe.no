funksjon start() -> heiltall {
    hvis ikkje builtin.starts_with("hei,verda", "hei") {
        skriv("NATIVE_TEXT_PREDICATE_START_FALSE\n")
        returner 1
    }
    skriv("NATIVE_TEXT_PREDICATE_START_OK\n")
    skriv("NATIVE_TEXT_PREDICATE_START_TEXT=" + tekst(builtin.starts_with("hei,verda", "hei")) + "\n")
    hvis ikkje builtin.ends_with("hei,verda", "verda") {
        skriv("NATIVE_TEXT_PREDICATE_END_FALSE\n")
        returner 1
    }
    skriv("NATIVE_TEXT_PREDICATE_END_OK\n")
    skriv("NATIVE_TEXT_PREDICATE_END_TEXT=" + tekst(builtin.ends_with("hei,verda", "verda")) + "\n")
    returner 0
}
