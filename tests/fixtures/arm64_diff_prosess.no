// A2 differensial-lane (tools/arm64_diff_lane.no): prosess-spawn over den kanoniske
// kontrakten (std.runtime.process_abi → builtin.process_spawn_argv). Same program køyrt
// som VM (`nc run`) og som linux-arm64-AOT (std.native_gap over sys6) skal gje identisk
// stdout og exit-kode. Dekkjer stdin → stdout, exit-kode, stderr, miljø og cwd til
// barnet, argv med mellomrom og ein executable som ikkje finst.
bruk std.native_gap
bruk std.runtime.process_abi som pabi

funksjon køyr(exe: tekst, args: liste_tekst, cwd: tekst, stdin: tekst, miljø: ordbok_tekst) {
    la req = pabi.request(exe, args, cwd, stdin, 10000, 65536)
    hvis lengde(nøkler(miljø)) > 0 { pabi.sett_environment(req, miljø) }
    returner builtin.process_spawn_argv(req)
}

funksjon vis(namn: tekst, r) -> heiltall {
    skriv(namn + " status=" + tekst(r["status"]) + " exit=" + tekst(r["exit_code"]) +
          " ut=[" + tekst(r["stdout"]) + "] feil=[" + tekst(r["stderr"]) + "]\n")
    returner 0
}

funksjon start() -> heiltall {
    vis("cat", køyr("/bin/cat", [], "", "hei frå stdin\nlinje 2\n", {}))
    vis("sh", køyr("/bin/sh", ["-c", "echo ut; echo feil 1>&2; exit 7"], "", "", {}))
    vis("miljø", køyr("/bin/sh", ["-c", "printf %s \"$A2_BARN\""], "", "", {"A2_BARN": "barnverdi"}))
    vis("arva", køyr("/bin/sh", ["-c", "printf %s \"$A2_LANE_MILJO\""], "", "", {}))
    vis("cwd", køyr("/bin/pwd", [], "/tmp", "", {}))
    vis("argv", køyr("/bin/echo", ["a b", "c"], "", "", {}))
    la ukjend = køyr("/finst/ikkje/a2", [], "", "", {})
    skriv("ukjend exit=" + tekst(ukjend["exit_code"]) + "\n")

    // Asynkron ABI (builtin.process_operation): spawn, vent, les, signal, lukk.
    la s = builtin.process_operation(pabi.async_spawn_request("/bin/sh", ["-c", "read l; echo fekk:$l; exit 3"], "", "linje-inn\n", 10000, 65536))
    la h = tekst(s["handle"])
    skriv("async spawn=" + tekst(s["status"]) + " har_handle=" + tekst(h != "") + "\n")
    la w = builtin.process_operation(pabi.async_wait_request(h, 5000))
    skriv("async vent=" + tekst(w["status"]) + " exit=" + tekst(w["exit_code"]) + "\n")
    la r = builtin.process_operation(pabi.async_operation("read", h))
    skriv("async les=[" + tekst(r["stdout"]) + "]\n")
    la c = builtin.process_operation(pabi.async_operation("close", h))
    skriv("async lukk=" + tekst(c["status"]) + "\n")
    la s2 = builtin.process_operation(pabi.async_spawn_request("/bin/sleep", ["30"], "", "", 0, 65536))
    la h2 = tekst(s2["handle"])
    builtin.process_operation(pabi.async_signal_request(h2, 9))
    la w2 = builtin.process_operation(pabi.async_wait_request(h2, 5000))
    skriv("async drept=" + tekst(w2["status"]) + "\n")
    builtin.process_operation(pabi.async_operation("close", h2))
    returner 42
}
