funksjon start() -> heiltall {
    la s: tekst = "abcdefghijklmnopqrstuvwxyz0123456789ABCDEF"
    la i: heiltall = 0
    mens i < 4000 {
        la t: tekst = "garbage" + tekst(i)
        i = i + 1
    }
    // s må overleve collect; sjekk lengd + eit teikn
    hvis lengde(s) != 42 { returner 1 }
    returner lengde(s)
}
