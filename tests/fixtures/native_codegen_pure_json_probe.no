bruk selfhost.json

funksjon start() -> heiltall {
    la verdi = {"ok": sann, "tal": 42, "namn": "norscode", "liste": ["a", "b"], "nothing": selfhost.json.json_null_verdi()}
    la ut = selfhost.json.json_skriv(verdi)
    hvis ikkje builtin.contains(ut, "\"ok\":true") { returner 1 }
    hvis ikkje builtin.contains(ut, "\"tal\":42") { returner 1 }
    hvis ikkje builtin.contains(ut, "\"namn\":\"norscode\"") { returner 1 }
    hvis ikkje builtin.contains(ut, "\"liste\":[\"a\",\"b\"]") { returner 1 }
    hvis ikkje builtin.contains(ut, "\"nothing\":null") { returner 1 }
    skriv("NATIVE_PURE_JSON_PROBE_OK\n")
    returner 0
}
