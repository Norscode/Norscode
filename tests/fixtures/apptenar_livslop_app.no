# Testapp for tests/test_apptenar_livslop.no: oppstart-/avslutningskrokar og
# drenering når app.stopp() blir kalla (FastAPI lifespan + graceful shutdown).
bruk std.web som web
bruk std.apptenar som app

funksjon opp() {
    skriv("KROK oppstart\n")
}

funksjon ned() {
    skriv("KROK avslutning\n")
}

funksjon hei(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /hei")
    returner {"status": 200, "content_type": "text/plain; charset=utf-8", "body": "hei"}
}

funksjon stopp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /stopp")
    app.stopp()
    returner {"status": 200, "body": "stoppar"}
}

funksjon start() -> heltall {
    returner app.lytt({
        "port": 0,
        "vert": "127.0.0.1",
        "maks_ms": 60000,
        "drain_ms": 5000,
        "oppstart": ["__main__.opp"],
        "avslutning": ["ned"]
    })
}
