// fil_append_binær: skriv [1,2,3], append [4,5], les tilbake → lengd 5, siste=5.
funksjon start() -> heiltall {
    la p = "/tmp/nc_appendbin_arm64.bin"
    builtin.fil_skriv_binær(p, [1, 2, 3])
    builtin.fil_append_binær(p, [4, 5])
    la b = builtin.fil_les_binær(p)
    returner lengde(b) * 10 + b[4]
}
