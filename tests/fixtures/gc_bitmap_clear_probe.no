// GC (iv) probe: nullstill mark-bitmap (gc_bitmap_clear) — trengst per collect så kvar
// samling startar friskt. Marker eit int-boks (set bit), stadfest bit=1, nullstill,
// stadfest bit=0. Exit: 0 = OK · 2 = bit ikkje sett før · 3 = bit ikkje nullstilt.
funksjon start() -> heiltall {
    la region: heiltall = builtin.heap_bump() + 65536
    builtin.raw_store64(region, 1)                 // int-boks type
    builtin.raw_store64(region + 8, 42)            // verdi
    builtin.heap_set_bump(region + 128)            // bump forbi boksen (range-sjekk)
    builtin.gc_mark_native(region)                 // markerer region → set bit
    la before: heiltall = builtin.gc_mark_bit(region)
    hvis before != 1 {
        returner 2
    }
    builtin.gc_bitmap_clear()
    la after: heiltall = builtin.gc_mark_bit(region)
    hvis after != 0 {
        returner 3
    }
    skriv("gc_bitmap_clear OK: bit sett (1) → nullstilt (0)\n")
    returner 0
}
