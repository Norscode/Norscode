// A2 differensial-lane: prosessmiljøet. Lanen set A2_LANE_MILJO=frå-lanen for begge
// køyringane; programmet les det, les ein variabel som ikkje finst, set ein ny og les
// han att (miljo_sett/miljo_hent/miljo_finnes), og samanliknar tekst på tvers.
funksjon start() -> heiltall {
    skriv("lane=[" + miljo_hent("A2_LANE_MILJO") + "]\n")
    skriv("finst_ikkje=[" + miljo_hent("A2_FINST_IKKJE_X") + "] " + tekst(miljo_finnes("A2_FINST_IKKJE_X")) + "\n")
    skriv("finst=" + tekst(miljo_finnes("A2_LANE_MILJO")) + "\n")
    miljo_sett("A2_NY", "sett-i-programmet")
    skriv("ny=[" + miljo_hent("A2_NY") + "] " + tekst(miljo_finnes("A2_NY")) + "\n")
    miljo_sett("A2_NY", "endra")
    skriv("endra=[" + miljo_hent("A2_NY") + "]\n")
    skriv("path_ikkje_tom=" + tekst(lengde(miljo_hent("PATH")) > 0) + "\n")
    skriv("ordning=" + tekst("10" < "9") + tekst("abc" < "abd") + tekst("b" > "abc") + tekst("ab" <= "ab") + tekst("" < "a") + "\n")
    returner 46
}
