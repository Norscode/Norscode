// R2 / F23: ufanga køyretidsfeil i eit program utan prøv/kast (ingen unnataks-globalar):
// meldinga går til stderr som eit ufanga kast og prosessen avsluttar med 1, i staden for
// å halde fram med eit tilfeldig resultat (før: «ETTER x=0», exit 0).
funksjon del(a: heiltall, b: heiltall) -> heiltall { returner a / b }

funksjon start() -> heiltall {
    skriv("før\n")
    la x = del(7, 0)
    skriv("ETTER x=" + tekst(x) + "\n")
    returner 0
}
