# Fikstur for tests/test_r2_instans.no (F21): grensesnitt + struktur i ein
# importert modul. Testen kompilerer modulen som __main__ og omdøyper han med
# bundlaren, slik eldre cache-fragment blir handsama.
grensesnitt Dyr {
    funksjon lyd(self) -> tekst
}
struktur Katt implementerer Dyr {
    namn: tekst
}
funksjon Katt.lyd(self) -> tekst {
    returner self.namn + " seier mjau"
}
funksjon ny_katt(namn: tekst) -> Katt {
    returner Katt(namn)
}
