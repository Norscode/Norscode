// random_hex(n) → 2n hex-teikn. Ikkje-determinstisk innhald; testar struktur:
// lengd == 2n, og at alle teikn er lovlege hex (0-9a-f).
funksjon er_hex(c: heiltall) -> boolsk {
    hvis c >= 48 og c <= 57 { returner sann }   // 0-9
    hvis c >= 97 og c <= 102 { returner sann }  // a-f
    returner usann
}
funksjon start() -> heiltall {
    la h = builtin.random_hex(16)
    la n = lengde(h)
    la ok = 1
    la i = 0
    mens i < n {
        hvis er_hex(char_code(builtin.slice(h, i, i + 1))) { } ellers { ok = 0 }
        i = i + 1
    }
    // 100 om lengd rett, +ok. Forventa 100+1 = 101 (og ekte entropi ⇒ varierer).
    la r = 0
    hvis n == 32 { r = r + 100 }
    r = r + ok
    returner r
}
