# Fikstur for tests/test_r4_verdi_*.no (F22): automatisk til_tekst og strukturell likskap.
struktur Punkt {
    x: heltall
    y: heltall
}
struktur Linje {
    a: Punkt
    b: Punkt
    navn: tekst
}
struktur Boks {
    inn
    lst
}
struktur Navngjeven {
    n: tekst
}
funksjon Navngjeven.til_tekst(self) -> tekst { returner "<" + self.n + ">" }
struktur Eigen {
    v: heltall
}
funksjon Eigen.er_lik(self, andre) -> boolsk { returner self.v % 10 == andre.v % 10 }
struktur Node {
    namn: tekst
    neste
}

funksjon start() -> tekst {
    la p = Punkt(1, 2)
    la q = Punkt(1, 2)
    la r = Punkt(3, 4)
    la l = Linje(p, r, "l1")
    la b = Boks(l, [p, {"a": q}])
    la ut = []
    legg_til(ut, tekst(p))
    legg_til(ut, tekst(l))
    legg_til(ut, tekst(b))
    legg_til(ut, tekst(Navngjeven("a")))
    legg_til(ut, "s=" + p)
    legg_til(ut, tekst([p, Navngjeven("z")]))
    la n = Node("a", null)
    n.neste = n
    legg_til(ut, tekst(n))
    legg_til(ut, tekst(p == q))
    legg_til(ut, tekst(p == r))
    legg_til(ut, tekst(p != r))
    legg_til(ut, tekst(p != q))
    legg_til(ut, tekst(Boks(p, [1]) == Boks(q, [1])))
    legg_til(ut, tekst(Boks(p, [1]) == Boks(q, [2])))
    legg_til(ut, tekst(Punkt(1, 1) == Eigen(1)))
    legg_til(ut, tekst(Eigen(3) == Eigen(13)))
    legg_til(ut, tekst(Eigen(3) != Eigen(13)))
    legg_til(ut, tekst(Eigen(3) == Eigen(4)))
    legg_til(ut, tekst([p] == [q]))
    legg_til(ut, tekst(p == null))
    skriv(p)
    returner builtin.join(ut, "|")
}
