// slice på LISTE (ikkje berre streng) — krypto skiv keystream-lister.
funksjon start() -> heiltall {
    la l = [10,20,30,40,50,60,70,80]
    la s = builtin.slice(l, 2, 6)       // [30,40,50,60]
    la sum = 0  la i = 0
    mens i < lengde(s) { sum = sum + s[i]  i = i + 1 }
    returner (lengde(s) * 1 + sum) & 255   // 4 + 180 = 184
}
