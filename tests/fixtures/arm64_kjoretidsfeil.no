// R2 / F23: køyretidsfeil i ARM64-AOT er fangbare unnatak med same tekst som VM-en
// (selfhost/vm.no): DivisjonMedNull / ModuloMedNull (heiltal og desimaltal), IndeksFeil på
// liste (INDEX_GET og INDEX_SET, negativ indeks inkludert), «Ugyldig heiltall: …» frå
// heltall_fra_tekst, og assert / assert_eq som kast. Typa fang skil på prefikset.

funksjon ut(s: tekst) -> heiltall {
    skriv(s + "\n")
    returner 0
}

funksjon del(a: heiltall, b: heiltall) -> heiltall { returner a / b }
funksjon mod(a: heiltall, b: heiltall) -> heiltall { returner a % b }

funksjon prøv_div(a: heiltall, b: heiltall) -> tekst {
    prøv { returner "div=" + tekst(del(a, b)) } fang (e) { returner "fanga [" + tekst(e) + "]" }
    returner "?"
}

funksjon prøv_tal(t: tekst) -> tekst {
    prøv { returner "[" + tekst(heltall_fra_tekst(t)) + "]" } fang (e) { returner "kast: " + tekst(e) }
    returner "?"
}

funksjon start() -> heiltall {
    ut("A " + prøv_div(7, 2) + " " + prøv_div(-7, 2) + " " + prøv_div(7, 0))
    prøv { ut("B mod=" + tekst(mod(7, 0))) } fang (e) { ut("B fanga [" + tekst(e) + "]") }
    prøv {
        la x = 1.5
        la y = 0.0
        ut("C " + tekst(x / y))
    } fang (e) { ut("C fanga [" + tekst(e) + "]") }
    prøv {
        prøv { ut("D " + tekst(del(1, 0))) } fang (e: ModuloMedNull) { ut("D feil fang") }
    } fang (e: DivisjonMedNull) { ut("D typa DivisjonMedNull") }
    prøv {
        prøv { ut("E " + tekst(mod(1, 0))) } fang (e: DivisjonMedNull) { ut("E feil fang") }
    } fang (e: ModuloMedNull) { ut("E typa ModuloMedNull") }

    la l = [10, 20, 30]
    ut("F l[0]=" + tekst(l[0]) + " l[2]=" + tekst(l[2]))
    prøv { ut("G " + tekst(l[3])) } fang (e) { ut("G fanga [" + tekst(e) + "]") }
    prøv { la i = -1  ut("H " + tekst(l[i])) } fang (e) { ut("H fanga [" + tekst(e) + "]") }
    prøv { l[5] = 1  ut("I ingen feil") } fang (e: IndeksFeil) { ut("I typa [" + tekst(e) + "]") }
    prøv { l[-2] = 1  ut("J ingen feil") } fang (e) { ut("J fanga [" + tekst(e) + "]") }
    l[1] = 21
    ut("K l=" + tekst(l[0]) + "," + tekst(l[1]) + "," + tekst(l[2]) + " n=" + tekst(lengde(l)))
    la b = bytes_new(3, 7)
    b[-1] = 9
    ut("L bytes " + tekst(b[0]) + "," + tekst(b[-1]) + " ute=" + builtin.type(b[5]))

    ut("M " + prøv_tal("123") + prøv_tal("-45") + prøv_tal("0") + prøv_tal("-") + prøv_tal("9223372036854775807"))
    ut("N " + prøv_tal("abc"))
    ut("N " + prøv_tal("12x"))
    ut("N " + prøv_tal(""))
    ut("N " + prøv_tal(" 12"))
    prøv { assert(1 == 2) } fang (e) { ut("O fanga [" + tekst(e) + "]") }
    prøv { assert_eq(1, 2) } fang (e) { ut("P fanga [" + tekst(e) + "]") }
    prøv { assert_eq("a", "b") } fang (e) { ut("Q fanga [" + tekst(e) + "]") }
    assert(sann)
    assert_eq("x", "x")
    assert_eq(3, 3)
    ut("R ferdig")
    returner 0
}
