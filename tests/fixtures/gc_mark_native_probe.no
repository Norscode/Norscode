// GC (ii) probe: allokeringsfri maskinkode-mark (gc_mark_native). Byggjer same
// graf som referanse-marken (liste[intA,intB]) og markerer via den REINE maskinkode-
// DFS-en; verifiserer retur == 3 (liste + 2 element markerte, ingen boksing i løkka).
funksjon start() -> heiltall {
    la base = builtin.heap_bump() + 8192
    builtin.raw_store64(base + 128, 1)
    builtin.raw_store64(base + 128 + 8, 100111)
    builtin.raw_store64(base + 192, 1)
    builtin.raw_store64(base + 192 + 8, 100222)
    builtin.raw_store64(base, 3)
    builtin.raw_store64(base + 8, base + 64)
    builtin.raw_store64(base + 64, 2)
    builtin.raw_store64(base + 64 + 8, 2)
    builtin.raw_store64(base + 64 + 16, base + 128)
    builtin.raw_store64(base + 64 + 24, base + 192)
    la marka = builtin.gc_mark_native(base)
    // verifiser òg at boksane er markerte (gc_mark_bit gjev 1)
    la m1 = builtin.gc_mark_bit(base)
    la m2 = builtin.gc_mark_bit(base + 128)
    la m3 = builtin.gc_mark_bit(base + 192)
    hvis marka == 3 og m1 == 1 og m2 == 1 og m3 == 1 {
        skriv("gc_mark_native OK: allokeringsfri maskinkode-DFS markerte 3 (liste+2 elem)\n")
        returner 0
    }
    skriv("gc_mark_native FEIL: marka=" + tekst(marka) + " m1=" + tekst(m1) + " m2=" + tekst(m2) + " m3=" + tekst(m3) + "\n")
    returner 1
}
