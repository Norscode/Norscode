funksjon start() -> heiltall {
    la v = builtin.json_parse_raw("[null, 0, false]")
    skriv("type(v0)=" + builtin.type(v[0]) + " v0==null=" + tekst(v[0] == null) + " v0==0=" + tekst(v[0] == 0) + "\n")
    skriv("type(v1)=" + builtin.type(v[1]) + " v1==null=" + tekst(v[1] == null) + "\n")
    skriv("type(null)=" + builtin.type(null) + " 0==null=" + tekst(0 == null) + " null==0=" + tekst(null == 0) + "\n")
    la l = [1, 2]
    skriv("tekst(liste)=[" + tekst(l) + "] liste==null=" + tekst(l == null) + "\n")
    la m = {"a": 1}
    skriv("map==null=" + tekst(m == null) + " map==0=" + tekst(m == 0) + " tekst(map)=[" + tekst(m) + "]\n")
    returner 0
}
