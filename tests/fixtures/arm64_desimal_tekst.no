// A5: tekst()/konkatenering av desimaltall → std.desimaltall_tekst.desimal_til_tekst
// (kortaste tapsfrie form), same som VM-en. Før skreiv ARM64 IEEE-bita som heiltal.
bruk std.desimaltall_tekst som dtt

funksjon start() -> heiltall {
    skriv(tekst(3.5) + " " + tekst(0.1) + " " + tekst(2.0) + " " + tekst(-7.25) + "\n")
    skriv("x=" + 2.5 + " y=" + 1.0e300 + " z=" + 0.000001 + "\n")
    la n = 0.0
    skriv(tekst(1.0 / 3.0) + " " + tekst(n) + " " + tekst(123456789.125) + "\n")
    skriv(tekst(7) + " " + tekst("s") + " " + tekst(sann) + "\n")
    returner 0
}
