// A5: split utan fast stakkbuffer — 40k delar og tom delim (per byte) som VM-en.
funksjon start() -> heiltall {
    la a = builtin.split("abc", "")
    skriv(tekst(lengde(a)) + "\n")
    for x i a { skriv("[" + x + "]") }
    skriv("\n")
    la b = builtin.split("", ",")
    skriv(tekst(lengde(b)) + "\n")
    la s = ""
    la i = 0
    mens i < 40000 { s = s + "x," i = i + 1 }
    skriv(tekst(lengde(builtin.split(s, ","))) + "\n")
    returner 0
}
