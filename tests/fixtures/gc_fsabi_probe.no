// gc_fsabi_probe.no — native filsystem-ABI (norscode-native-filesystem-v1) i
// self-hosta x86-64-codegen: builtin.filesystem_read/write_operation blir ruta
// (gap_rute_v2) til std.runtime_filesystem_native på native_fs_*-primitiv
// (getdents64/stat/lstat/unlink/rmdir/chmod/rename/symlink).
// Krev: /tmp skrivbart. Exit 0 = heile kontrakten verkar; exit 3+ = kva som feila.
bruk std.runtime_filesystem som rfs
bruk std.filops som filops

funksjon start() -> heiltall {
    la base = "/tmp/nc_fsabi_probe_" + tekst(builtin.tid_ms())
    // mkdir_p via ABI
    la mk = rfs.native_lag_mappe("/", builtin.slice(base, 1, lengde(base)) + "/a/b")
    skriv("mkdir_p status=" + tekst(mk["status"]) + " value=" + tekst(mk["value"]) + "\n")
    hvis tekst(mk["status"]) != "ok" { returner 3 }
    hvis ikkje filops.katalog_finnes(base + "/a/b") { skriv("katalog_finnes usann\n") returner 4 }
    // filer
    fil_skriv(base + "/a/x.txt", "hei")
    fil_skriv(base + "/a/b/y.no", "hallo verda")
    // list / list_typed
    la l = rfs.native_list("/", builtin.slice(base, 1, lengde(base)) + "/a")
    skriv("list status=" + tekst(l["status"]) + " value=" + tekst(l["value"]) + " data=[" + tekst(l["data"]) + "]\n")
    hvis tekst(l["status"]) != "ok" eller tekst(l["value"]) != "2" { returner 5 }
    la lt = rfs.native_list_typed(base, "a")
    skriv("list_typed data=[" + tekst(lt["data"]) + "]\n")
    hvis builtin.index_of(tekst(lt["data"]), "d\tb\n") < 0 eller builtin.index_of(tekst(lt["data"]), "f\tx.txt\n") < 0 { returner 6 }
    // walk_files (+ suffiks)
    la w = rfs.native_walk_files(base, "")
    skriv("walk value=" + tekst(w["value"]) + " data=[" + tekst(w["data"]) + "]\n")
    hvis tekst(w["value"]) != "2" { returner 7 }
    la ws = rfs.native_walk_files_med_suffiks(base, "", ".no")
    hvis tekst(ws["value"]) != "1" eller builtin.index_of(tekst(ws["data"]), "a/b/y.no") < 0 { skriv("walk suffiks feil\n") returner 8 }
    // path_stat
    la st = rfs.native_stat_sti(base + "/a/b/y.no")
    skriv("stat status=" + tekst(st["status"]) + " kind=" + tekst(st["kind"]) + " size=" + tekst(st["value"]) + " mode=" + tekst(st["mode"]) + "\n")
    hvis tekst(st["status"]) != "ok" eller tekst(st["kind"]) != "file" eller tekst(st["value"]) != "11" { returner 9 }
    skriv("[dir-stat]\n")
    la sd = rfs.native_stat_sti(base + "/a")
    skriv("[dir-stat ok] kind=" + tekst(sd["kind"]) + "\n")
    hvis tekst(sd["kind"]) != "directory" { skriv("kind katalog feil: " + tekst(sd["kind"]) + "\n") returner 10 }
    skriv("[missing-stat]\n")
    la sm = rfs.native_stat_sti(base + "/finst_ikkje")
    skriv("[missing-stat ok] status=" + tekst(sm["status"]) + "\n")
    hvis tekst(sm["status"]) != "feil" { skriv("manglande stat skulle feile\n") returner 11 }
    // chmod
    skriv("[chmod]\n")
    la ch = rfs.native_sett_modus_sti(base + "/a/x.txt", 420)
    skriv("[chmod ok]\n")
    hvis tekst(ch["status"]) != "ok" eller tekst(ch["value"]) != "420" { skriv("chmod feil: " + tekst(ch["error"]) + "\n") returner 12 }
    la st2 = rfs.native_stat_sti(base + "/a/x.txt")
    hvis (heltall_fra_tekst(tekst(st2["mode"])) & 511) != 420 { skriv("mode etter chmod: " + tekst(st2["mode"]) + "\n") returner 13 }
    // file_replace (rename)
    skriv("[rename]\n")
    la fr = rfs.native_erstatt_fil_atomisk(base, "a/x.txt", "a/z.txt")
    skriv("[rename ok]\n")
    hvis tekst(fr["status"]) != "replaced" { skriv("file_replace feil: " + tekst(fr["error"]) + "\n") returner 14 }
    hvis fil_finnes(base + "/a/x.txt") eller ikkje fil_finnes(base + "/a/z.txt") { returner 15 }
    // symlink_replace
    skriv("[symlink]\n")
    la sl = rfs.native_erstatt_symbolsk_lenke(base, "a/lenkje", "z.txt")
    skriv("[symlink ok]\n")
    hvis tekst(sl["status"]) != "ok" { skriv("symlink feil: " + tekst(sl["error"]) + "\n") returner 16 }
    hvis fil_les(base + "/a/lenkje") != "hei" { returner 17 }
    la ls = rfs.native_stat_sti(base + "/a/lenkje")
    hvis tekst(ls["kind"]) != "symlink" { skriv("lstat kind: " + tekst(ls["kind"]) + "\n") returner 18 }
    // delete + rmdir + slett_tre
    skriv("[delete]\n")
    la dl = rfs.native_slett(base, "a/lenkje")
    skriv("[delete ok]\n")
    hvis tekst(dl["status"]) != "deleted" { returner 19 }
    la rd = rfs.native_slett_mappe(base, "a")
    hvis tekst(rd["status"]) != "feil" { skriv("rmdir på ikkje-tom katalog skulle feile\n") returner 20 }
    skriv("[slett_tre]\n")
    hvis ikkje filops.slett_tre(base) { skriv("slett_tre usann\n") returner 21 }
    hvis fil_finnes(base) { returner 22 }
    // ustøtta handtak-op → ærleg feil-status, ingen krasj
    la op = rfs.native_flush({"handle": "h0", "mode": "write"})
    hvis tekst(op["status"]) != "feil" { returner 23 }
    skriv("fsabi OK\n")
    returner 0
}
