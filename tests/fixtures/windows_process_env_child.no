// Spawna av CRT-fri Windows-runtime utan argv: berre eksplisitt miljø kan
// velje kjelde og få barnet til dette inngangspunktet.
funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_WIN_ENV_PROBE") != "W6_2" {
        skriv("WIN-ENV-MISSING\n")
        returner 1
    }
    skriv("WIN-ENV-OK\n")
    returner 0
}
