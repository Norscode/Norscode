funksjon start() -> heiltall {
    la l: liste_heiltall = [1, 2, 3]
    skriv("list=" + builtin.json_stringify(l) + "\n")
    la m: ordbok = {}
    map_set(m, "a", 1)
    map_set(m, "b", 2)
    skriv("map=" + builtin.json_stringify(m) + "\n")
    la nøsta: liste = [[1, 2], [3, 4]]
    skriv("nest=" + builtin.json_stringify(nøsta) + "\n")
    returner 0
}
