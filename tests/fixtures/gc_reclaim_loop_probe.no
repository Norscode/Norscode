// GC reclaim-LOOP-probe (Fase 3): 5000 iterasjonar av det VALIDERTE reclaim-mønsteret
// (gc_free 64B → gc_alloc 32B gjenbrukar same blokk). Regionen ligg fast OVER bump, så
// ein stabil fri-liste-syklus skal ALDRI røre bump. Dette er kjernepåstanden bak
// litmusen: alloc/free/reuse held minne AVGRENSA i staden for å vekse til SIGSEGV.
// Verifiser at bump står HEILT stille (vekst == 0) og at kvar alloc gjenbrukar regionen.
funksjon start() -> heiltall {
    la region: heiltall = builtin.heap_bump() + 4096
    la start_bump: heiltall = builtin.heap_bump()
    la i: heiltall = 0
    la feil: heiltall = 0
    mens i < 5000 {
        builtin.gc_free(region, 64)                 // donér 64B fri-blokk
        la a: heiltall = builtin.gc_alloc(32)       // head-fit 64>=32 → gjenbruk regionen
        hvis a != region {
            feil = feil + 1
        }
        i = i + 1
    }
    la vekst: heiltall = builtin.heap_bump() - start_bump
    hvis vekst == 0 og feil == 0 {
        skriv("gc_reclaim_loop OK: 5000 free/alloc, bump urørt (vekst=0), kvar runde gjenbrukte\n")
        returner 0
    }
    skriv("gc_reclaim_loop FEIL: vekst=" + tekst(vekst) + " feil=" + tekst(feil) + "\n")
    returner 1
}
