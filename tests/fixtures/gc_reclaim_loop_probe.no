// GC reclaim-LOOP-probe (Fase 3): 5000× det validerte reclaim-mønsteret (gc_free 64B →
// gc_alloc 32B). Provar at fri-lista er STABIL over litmus-skala: kvar runde head-fit-ar
// og returnerer SAME region, ingen korrupsjon/drift i fri-liste-hovudet.
//
// MERK (viktig funn): vi kan IKKJE assertere "bump urørt" her — kvar `la a=…`, `i=i+1`
// og `feil=feil+1` BOKSAR eit heiltal (RT_INT bumpar 16B). Dvs. sjølve løkka bumpar.
// Det er NETTOPP litmus-sjukdomen: boksing driv ubunden vekst → SIGSEGV. Det motiverer
// (iii): re-pek boks-allokatoren (RT_INT/STR/LIST) → gc_alloc så safepoint+collect kan
// hauste boksinga. Her isolerer vi fri-liste-korrektheit. Exit: 0 = OK · 3 = reuse feila.
funksjon start() -> heiltall {
    la region: heiltall = builtin.heap_bump() + 4096
    la i: heiltall = 0
    la feil: heiltall = 0
    mens i < 5000 {
        builtin.gc_free(region, 64)                 // donér 64B fri-blokk
        la a: heiltall = builtin.gc_alloc(32)       // head-fit 64>=32 → gjenbruk regionen
        hvis a != region {
            feil = feil + 1
        }
        i = i + 1
    }
    hvis feil != 0 {
        returner 3
    }
    skriv("gc_reclaim_loop OK: 5000 free/alloc, fri-lista stabil (kvar runde gjenbrukte regionen)\n")
    returner 0
}
