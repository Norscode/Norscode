// GC reclaim-LOOP-probe (Fase 3): 5000× det validerte reclaim-mønsteret (gc_free 64B →
// gc_alloc 32B gjenbrukar same faste region OVER bump). Kjernepåstanden bak litmusen:
// alloc/free/reuse held minne AVGRENSA. Diagnose via EXIT-KODE (tekst av rekna heiltal
// er ein AOT-luke → blankt), så vi kan sjå kva sjekk som feila:
//   0 = OK · 2 = bump flytta seg (vekst != 0) · 3 = ein alloc gjenbrukte ikkje regionen
funksjon start() -> heiltall {
    la region: heiltall = builtin.heap_bump() + 4096
    la start_bump: heiltall = builtin.heap_bump()
    la i: heiltall = 0
    la feil: heiltall = 0
    mens i < 5000 {
        builtin.gc_free(region, 64)                 // donér 64B fri-blokk
        la a: heiltall = builtin.gc_alloc(32)       // head-fit 64>=32 → gjenbruk regionen
        hvis a != region {
            feil = feil + 1
        }
        i = i + 1
    }
    la vekst: heiltall = builtin.heap_bump() - start_bump
    hvis vekst != 0 {
        returner 2
    }
    hvis feil != 0 {
        returner 3
    }
    skriv("gc_reclaim_loop OK: 5000 free/alloc, bump urørt, kvar runde gjenbrukte regionen\n")
    returner 0
}
