// GC reclaim-LOOP-probe (Fase 3): 5000 iterasjonar av gc_alloc→gc_free. Fyrste
// alloc bumpar (tom fri-liste); resten gjenbrukar SAME blokk via fri-lista → bump
// veks IKKJE. Dette er kjernepåstanden bak litmusen: alloc/collect/reuse held minne
// AVGRENSA i staden for å vekse til SIGSEGV. Verifiser bump-vekst <= 16 over 5000 rundar.
funksjon start() -> heiltall {
    la start_bump: heiltall = builtin.heap_bump()
    la i: heiltall = 0
    mens i < 5000 {
        la a: heiltall = builtin.gc_alloc(16)
        builtin.gc_free(a, 16)
        i = i + 1
    }
    la end_bump: heiltall = builtin.heap_bump()
    la vekst: heiltall = end_bump - start_bump
    hvis vekst <= 16 {
        skriv("gc_reclaim_loop OK: 5000 alloc/free, bump-vekst=" + tekst(vekst) + " (<=16, gjenbruk stabil)\n")
        returner 0
    }
    skriv("gc_reclaim_loop FEIL: bump vaks " + tekst(vekst) + " over 5000 rundar (lekk)\n")
    returner 1
}
