# Sjekkane for tests/test_wasm_lastar.no (W0–W4). Køyrer i ein barneprosess i VM-fastmodus:
# emitteringa og tokeniseringa av dei fulle lastarane og skanninga av kjeldene tek om lag
# 3 minutt i standard-VM-en og 5 s i fastmodus.
#
# W0 (WASM-sporet): lastaren blir emittert frå Norscode-data, ikkje frå ein handskriven mal.
#
#   1. Byte-tak: lastaren for teljar-settet (4 importar) ≤ 600 byte, eitt import ≤ 400,
#      W4: heile produksjonstabellen (alle vertsfunksjonar utanom testkrokane) ≤ 2560 byte
#      (planbudsjettet), heile tabellen med testkrokane ≤ 3072, og ein typisk
#      interaktiv klient (examples/wasm_skjema/klient.no, 21 importar) ≤ 2048.
#      W6: nett-gruppa (hent_start, hent_svar, Q, R) har eige tak (448 byte) oppå dei 2560;
#      heile produksjonstabellen med nett ≤ 3008, og med testkrokane ≤ 3520.
#      W7: lagrings-gruppa (lager_start, lager_svar, fjern_lokalt, I, J) har eige tak (1280
#      byte); heile produksjonstabellen med nett og lagring ≤ 4288, og med testkrokane ≤ 4800.
#   7. W6: Q og R berre med nett-importane; fetch med mode og credentials same-origin sett
#      etter førespurnaden (kan ikkje overstyrast), signal for avbryting og tidsgrense.
#   8. W7: I og J berre med lagrings-importane; IndexedDB berre i I (open og deleteDatabase),
#      nøkkelstien og indeksstiane er faste («k» og «i.<indeks>»), tilkoplinga lukkar seg ved
#      versionchange, og ein feil i catch avbryt transaksjonen utan eit svar til.
#   2. Tree-shaking: berre importerte vertsfunksjonar og hjelparane dei treng kjem med.
#      Importnamna i lastaren er nøyaktig importseksjonen i modulen (sjekken diskriminerer:
#      ein lastar med ein ekstra import blir avvist).
#   3. Strukturen kjem frå data: endrar ein vertstabellen (ny DOM-operasjon, ny funksjon),
#      endrar lastaren seg tilsvarande.
#   4. Ingen handskrivne malar: ingen strengliteral i std/wasm_js.no eller
#      std/wasm_vert.no er eit JS-fragment (skannaren diskriminerer: han flaggar ein
#      handskriven lastarbit), og kvart kodetoken i lastaren finst som literal i éi av
#      dei to filene (proveniens).
#   5. Tryggleik: ingen eval/Function/document.write/on…-attributt; innerHTML blir berre
#      sett via escape-hjelparen, og html_escape er lik std.html.escape. W4: setAttribute
#      og createElement berre med namn som er kontrollerte ved kompilering (attributt/tag),
#      og navigasjon berre til same opphav.
#   6. W4: tekst frå DOM-en (resultattypen tekst) går gjennom U, hendingar gjennom L, og
#      hjelparane blir tree-shaka etter bruk.
#   9. W8: PWA-gruppa på sida (sw_registrer, sw_status, sw_send, G, B, O) har eige tak (704 byte)
#      og kjem berre med PWA-importane; testkrokane for Cache Storage og bilete (M) har eige tak
#      (384) og finst berre i testbygg. SW-lastaren (sw.js) er emittert frå same data: tak 1792
#      byte, importnamna er importseksjonen, hendingane blir registrerte synkront på toppnivå,
#      modulen kjem frå Cache Storage først, skipWaiting og lagring berre etter planen frå
#      Norscode (med kopien laga før svaret går vidare), ingen DOM/nett/lagring-importar
#      (fail-closed), og proveniens for kvart token i sw.js og i PWA-lastaren.
bruk std.wasm_js som js
bruk std.wasm_vert som vert
bruk std.html som html
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon tak_teljar() -> heltall { returner 600 }
funksjon tak_eitt_import() -> heltall { returner 400 }
funksjon tak_fullt() -> heltall { returner 2560 }
# W6: nett-gruppa (hent_start, hent_svar og hjelparane Q og R) er eit eige budsjett. Taket
# for resten av produksjonstabellen er uendra (2560); nett-gruppa kostar berre modular som
# brukar std/wasm_nett.no (tree-shaking).
funksjon tak_nett() -> heltall { returner 448 }
funksjon tak_fullt_nett() -> heltall { returner tak_fullt() + tak_nett() }
# W7: lagrings-gruppa (lager_start, lager_svar, fjern_lokalt og hjelparane I og J) er eit eige
# budsjett, som nett-gruppa: berre modular som brukar std/wasm_lager.no betaler for henne.
funksjon tak_lager() -> heltall { returner 1280 }
funksjon tak_fullt_alle() -> heltall { returner tak_fullt_nett() + tak_lager() }
# W8: PWA-gruppa på sida (sw_registrer, sw_status, sw_send og hjelparane G, B og O) har eige tak,
# som nett og lagring: berre modular som brukar std/wasm_pwa_klient.no betaler. Testkrokane
# test_cachar, test_bilete og test_resultat (M) har eit eige tak i testbygg. SW-lastaren (sw.js)
# har sitt eige tak: 1792 byte med dei importane std/wasm_sw.no har (planen hadde 1,5 KB for eit
# utkast utan svarmetadata til Norscode, kopien før respondWith, nett-fallbacken, synkron
# gjennomsleppning av «forbi» og talet på faner i meldingane).
funksjon tak_pwa() -> heltall { returner 704 }
funksjon tak_pwa_test() -> heltall { returner 384 }
funksjon tak_fullt_pwa() -> heltall { returner tak_fullt_alle() + tak_pwa() }
funksjon tak_sw() -> heltall { returner 1792 }
funksjon tak_fullt_test() -> heltall { returner 3520 + tak_lager() + tak_pwa() + tak_pwa_test() }
funksjon tak_øy() -> heltall { returner 2048 }

funksjon url() -> tekst { returner "/_nc/app.wasm?v=0123456789ab" }

funksjon teljar_importar() -> liste { returner ["finn", "sett_tekst", "sett_html", "lytt_klikk"] }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

funksjon tal_av(t: tekst, nål: tekst) -> heltall {
    la n = 0
    la rest = t
    la p = builtin.index_of(rest, nål)
    mens p >= 0 {
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
        p = builtin.index_of(rest, nål)
    }
    returner n
}

# ─── Enkel JS-tokenisering (for proveniens- og fragmentsjekken) ──────────────

# W4: bytar over 127 (æ ø å i namn som tøm og gå_til) høyrer til identifikatoren.
funksjon er_id(c: tekst) -> bool {
    hvis c == "" { returner usann }
    la k = builtin.char_code(c)
    returner k >= 128 eller (k >= 48 og k <= 57) eller (k >= 65 og k <= 90) eller (k >= 97 og k <= 122) eller k == 95 eller k == 36
}

# Operatorar på to teikn som emitteren skriv som eitt token.
funksjon er_op2(s: tekst) -> bool {
    returner s == "=>" eller s == "&&" eller s == "||" eller s == "==" eller s == "??" eller s == ">>" eller s == "!=" eller s == "<=" eller s == ">="
}

# Token i ein JS-tekst. Strengliteralar og regex-literalar blir eitt token kvar
# (prefiks «"» eller «/»), identifikatorar og tal eitt token, «=>» eitt token, anna
# teiknsetjing eitt teikn per token.
funksjon js_token(t: tekst) -> liste {
    la ut = []
    la i = 0
    la n = lengde(t)
    mens i < n {
        la c = builtin.slice(t, i, i + 1)
        hvis c == " " {
            i = i + 1
        } ellers hvis c == "\"" {
            la j = i + 1
            mens j < n og builtin.slice(t, j, j + 1) != "\"" {
                hvis builtin.slice(t, j, j + 1) == "\\" { j = j + 1 }
                j = j + 1
            }
            legg_til(ut, builtin.slice(t, i, j + 1))
            i = j + 1
        } ellers hvis c == "/" og builtin.slice(t, i + 1, i + 2) == "[" {
            la j = i + 2
            mens j < n og builtin.slice(t, j, j + 1) != "]" {
                hvis builtin.slice(t, j, j + 1) == "\\" { j = j + 1 }
                j = j + 1
            }
            # «]/» og flagg
            j = j + 2
            mens j < n og er_id(builtin.slice(t, j, j + 1)) { j = j + 1 }
            legg_til(ut, builtin.slice(t, i, j))
            i = j
        } ellers hvis er_id(c) {
            la j = i
            mens j < n og er_id(builtin.slice(t, j, j + 1)) { j = j + 1 }
            legg_til(ut, builtin.slice(t, i, j))
            i = j
        } ellers hvis er_op2(builtin.slice(t, i, i + 2)) {
            legg_til(ut, builtin.slice(t, i, i + 2))
            i = i + 2
        } ellers {
            legg_til(ut, c)
            i = i + 1
        }
    }
    returner ut
}

# Strengliteralane i ei Norscode-kjeldefil (utan kommentarar), avkoda.
funksjon literalar(src: tekst) -> liste {
    la ut = []
    la i = 0
    la n = lengde(src)
    mens i < n {
        la c = builtin.slice(src, i, i + 1)
        hvis c == "#" eller (c == "/" og builtin.slice(src, i + 1, i + 2) == "/") {
            mens i < n og builtin.slice(src, i, i + 1) != "\n" { i = i + 1 }
        } ellers hvis c == "\"" {
            la s = ""
            i = i + 1
            mens i < n og builtin.slice(src, i, i + 1) != "\"" {
                la d = builtin.slice(src, i, i + 1)
                hvis d == "\\" {
                    la e = builtin.slice(src, i + 1, i + 2)
                    hvis e == "n" { s = s + "\n" } ellers { s = s + e }
                    i = i + 2
                } ellers {
                    s = s + d
                    i = i + 1
                }
            }
            legg_til(ut, s)
            i = i + 1
        } ellers {
            i = i + 1
        }
    }
    returner ut
}

funksjon er_html_entitet(s: tekst) -> bool {
    hvis lengde(s) < 3 { returner usann }
    hvis builtin.slice(s, 0, 1) != "&" eller builtin.slice(s, lengde(s) - 1, lengde(s)) != ";" { returner usann }
    la i = 1
    mens i < lengde(s) - 1 {
        la c = builtin.slice(s, i, i + 1)
        hvis ikkje er_id(c) og c != "#" { returner usann }
        i = i + 1
    }
    returner sann
}

# Eit JS-fragment er ein literal med minst to token der minst eitt er ein identifikator
# og minst eitt er strukturell JS-teiknsetjing — t.d. «E[a].textContent=b» eller
# «(async()=>{let d=document». Enkelttoken («=>», «textContent», «{}») er ikkje fragment.
funksjon er_js_fragment(s: tekst) -> bool {
    hvis er_html_entitet(s) { returner usann }
    la tok = js_token(s)
    hvis lengde(tok) < 2 { returner usann }
    la har_id = usann
    la har_struktur = usann
    la i = 0
    mens i < lengde(tok) {
        la t = tekst(tok[i])
        hvis er_id(builtin.slice(t, 0, 1)) { har_id = sann }
        hvis t == "(" eller t == ")" eller t == "{" eller t == "}" eller t == "[" eller t == "]" eller t == ";" eller t == "=" eller t == "=>" {
            har_struktur = sann
        }
        i = i + 1
    }
    returner har_id og har_struktur
}

# Importnamna (nøklane i nc-objektet) i ein lastar, i rekkjefølgje.
funksjon lastar_importar(js_tekst: tekst) -> liste {
    la tok = js_token(js_tekst)
    la ut = []
    la i = 0
    mens i + 3 < lengde(tok) {
        hvis tok[i] == "nc" og tok[i + 1] == ":" og tok[i + 2] == "{" {
            la djup = 0
            la j = i + 3
            la forventar_nøkkel = sann
            mens j < lengde(tok) {
                la t = tekst(tok[j])
                hvis t == "(" eller t == "[" eller t == "{" { djup = djup + 1 }
                hvis t == ")" eller t == "]" { djup = djup - 1 }
                hvis t == "}" {
                    hvis djup == 0 { returner ut }
                    djup = djup - 1
                }
                hvis djup == 0 og t == "," { forventar_nøkkel = sann }
                ellers hvis djup == 0 og forventar_nøkkel og j + 1 < lengde(tok) og tok[j + 1] == ":" {
                    # W4: namn som ikkje er JS-identifikatorar (tøm, gå_til) står i hermeteikn
                    hvis builtin.starts_with(t, "\"") { t = builtin.slice(t, 1, lengde(t) - 1) }
                    legg_til(ut, t)
                    forventar_nøkkel = usann
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    returner ut
}

funksjon like_lister(a: liste, b: liste) -> bool {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) {
        hvis tekst(a[i]) != tekst(b[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon balansert(t: tekst) -> bool {
    la tok = js_token(t)
    la stakk = []
    la i = 0
    mens i < lengde(tok) {
        la x = tekst(tok[i])
        hvis x == "(" eller x == "[" eller x == "{" { legg_til(stakk, x) }
        hvis x == ")" eller x == "]" eller x == "}" {
            hvis lengde(stakk) == 0 { returner usann }
            la topp = tekst(stakk[lengde(stakk) - 1])
            hvis (x == ")" og topp != "(") eller (x == "]" og topp != "[") eller (x == "}" og topp != "{") { returner usann }
            la ny = []
            la k = 0
            mens k < lengde(stakk) - 1 {
                legg_til(ny, stakk[k])
                k = k + 1
            }
            stakk = ny
        }
        i = i + 1
    }
    returner lengde(stakk) == 0
}

# W7: hendingsfelta til IndexedDB-objekta (førespurnadene d og x, transaksjonen eller
# tilkoplinga t i hjelparen I). Dei er ikkje DOM-element og har ingen HTML-attributt; verdien er alltid ein
# pilfunksjon frå emitteren.
funksjon idb_hendingsfelt() -> liste {
    returner ["onupgradeneeded", "onsuccess", "onerror", "onblocked", "oncomplete", "onabort", "onversionchange"]
}

# Ingen tildeling til eit on…-felt (t.d. «.onclick=»): lyttarar på DOM-element går berre via
# addEventListener. Unnateke (W7) er hendingsfelta til IndexedDB i I: «d.», «x.» eller «t.» og eit
# namn i idb_hendingsfelt(), med ein pilfunksjon eller null som verdi.
funksjon ingen_on_tildeling(t: tekst) -> bool {
    la tok = js_token(t)
    la idb = idb_hendingsfelt()
    la i = 0
    mens i + 1 < lengde(tok) {
        la x = tekst(tok[i])
        hvis builtin.starts_with(x, "on") og lengde(x) > 2 og tok[i + 1] == "=" {
            la er_idb = usann
            la k = 0
            mens k < lengde(idb) {
                hvis idb[k] == x { er_idb = sann }
                k = k + 1
            }
            la mottakar = ""
            hvis i >= 2 og tok[i - 1] == "." { mottakar = tekst(tok[i - 2]) }
            la pil = i + 3 < lengde(tok) og (tok[i + 2] == "(" eller tok[i + 3] == "=>" eller tok[i + 2] == "null")
            hvis ikkje (er_idb og (mottakar == "d" eller mottakar == "x" eller mottakar == "t") og pil) { returner usann }
        }
        i = i + 1
    }
    returner sann
}

# W8: djupna (parentesar, klammer, krøllparentesar) før posisjonen `pos` i ein JS-tekst.
funksjon djupn_ved(t: tekst, pos: heltall) -> heltall {
    la tok = js_token(builtin.slice(t, 0, pos))
    la d = 0
    la i = 0
    mens i < lengde(tok) {
        la x = tekst(tok[i])
        hvis x == "(" eller x == "[" eller x == "{" { d = d + 1 }
        hvis x == ")" eller x == "]" eller x == "}" { d = d - 1 }
        i = i + 1
    }
    returner d
}

# Proveniens: kvart kodetoken (unnateke streng- og regexliteralar, som er data, og tal) er ein
# literal i emitteren eller vertsmodulen.
funksjon proveniens(t: tekst, lit_sett: ordbok) -> heltall {
    la tok = js_token(t)
    la i = 0
    mens i < lengde(tok) {
        la x = tekst(tok[i])
        la f = builtin.slice(x, 0, 1)
        la er_data = f == "\"" eller (f == "/" og lengde(x) > 1)
        la er_tal = builtin.char_code(f) >= 48 og builtin.char_code(f) <= 57
        hvis ikkje er_data og ikkje er_tal og ikkje finnes_nøkkel(lit_sett, x) {
            skriv("lastartokenet «" + x + "» finst ikkje som literal i emitteren eller vertstabellen\n")
            assert(usann)
        }
        i = i + 1
    }
    returner 0
}

# W8: lengda til lastaren for `namn` utan testkrokane for Cache Storage og bilete.
funksjon js_lengd_utan_krokar(namn: liste) -> heltall {
    la l = []
    la i = 0
    mens i < lengde(namn) {
        hvis ikkje vert.er_i(["test_cachar", "test_bilete", "test_resultat"], namn[i]) { legg_til(l, namn[i]) }
        i = i + 1
    }
    returner lengde(js.bygg_lastar(l, url(), sann)["js"])
}

funksjon js_av(e: liste) -> tekst {
    la ut = []
    js.emit(e, ut)
    returner js.token_til_tekst(ut)
}

funksjon kopi_tabell() -> liste {
    returner vert.vertsfunksjonar()
}

funksjon start() -> heltall {
    la rot = hjelp.root()

    # ── 1. Byte-tak ──
    la l_teljar = js.bygg_lastar(teljar_importar(), url(), sann)["js"]
    la l_eitt = js.bygg_lastar(["sett_tekst"], url(), sann)["js"]
    la alle_namn = []
    la prod_namn = []
    la prod_nett = []
    la prod_alle = []
    la prod_pwa = []
    la nett_namn = vert.nett_funksjonar()
    la lager_namn = vert.lager_funksjonar()
    la tab = vert.vertsfunksjonar()
    la ti = 0
    mens ti < lengde(tab) {
        # W8: vertsfunksjonane til service workeren finst ikkje i sidelastaren (sjå 9.)
        la er_sw = vert.er_i(vert.sw_funksjonar(), tab[ti]["namn"])
        la er_pwa = vert.er_i(vert.pwa_funksjonar(), tab[ti]["namn"])
        hvis ikkje er_sw { legg_til(alle_namn, tab[ti]["namn"]) }
        hvis ikkje tab[ti]["berre_test"] og ikkje er_sw { legg_til(prod_pwa, tab[ti]["namn"]) }
        hvis ikkje tab[ti]["berre_test"] og ikkje er_sw og ikkje er_pwa {
            legg_til(prod_alle, tab[ti]["namn"])
            la er_nett = usann
            la ni = 0
            mens ni < lengde(nett_namn) {
                hvis nett_namn[ni] == tab[ti]["namn"] { er_nett = sann }
                ni = ni + 1
            }
            la er_lager = usann
            la li = 0
            mens li < lengde(lager_namn) {
                hvis lager_namn[li] == tab[ti]["namn"] { er_lager = sann }
                li = li + 1
            }
            hvis ikkje er_lager { legg_til(prod_nett, tab[ti]["namn"]) }
            hvis ikkje er_nett og ikkje er_lager { legg_til(prod_namn, tab[ti]["namn"]) }
        }
        ti = ti + 1
    }
    la l_fullt = js.bygg_lastar(prod_namn, url(), sann)["js"]
    la l_fullt_nett = js.bygg_lastar(prod_nett, url(), sann)["js"]
    la l_fullt_alle = js.bygg_lastar(prod_alle, url(), sann)["js"]
    la l_fullt_test = js.bygg_lastar(alle_namn, url(), sann)["js"]
    la l_fullt_pwa = js.bygg_lastar(prod_pwa, url(), sann)["js"]
    skriv("lastar: teljar " + tekst(lengde(l_teljar)) + " B (tak " + tekst(tak_teljar()) + "), eitt import " +
        tekst(lengde(l_eitt)) + " B (tak " + tekst(tak_eitt_import()) + "), fullt " + tekst(lengde(l_fullt)) + " B (tak " + tekst(tak_fullt()) +
        "), fullt med testkrokar " + tekst(lengde(l_fullt_test)) + " B (tak " + tekst(tak_fullt_test()) + ")\n")
    skriv("lastar: fullt med nett (W6) " + tekst(lengde(l_fullt_nett)) + " B (tak " + tekst(tak_fullt_nett()) + "), nett-gruppa " +
        tekst(lengde(l_fullt_nett) - lengde(l_fullt)) + " B (tak " + tekst(tak_nett()) + ")\n")
    skriv("lastar: fullt med nett og lagring (W7) " + tekst(lengde(l_fullt_alle)) + " B (tak " + tekst(tak_fullt_alle()) + "), lagrings-gruppa " +
        tekst(lengde(l_fullt_alle) - lengde(l_fullt_nett)) + " B (tak " + tekst(tak_lager()) + ")\n")
    assert(lengde(l_fullt_alle) <= tak_fullt_alle())
    assert(lengde(l_fullt_alle) - lengde(l_fullt_nett) <= tak_lager())
    assert(balansert(l_fullt_alle))
    assert(ikkje inneheld(l_fullt_nett, "indexedDB"))
    assert(lengde(l_fullt_nett) <= tak_fullt_nett())
    assert(lengde(l_fullt_nett) - lengde(l_fullt) <= tak_nett())
    assert(balansert(l_fullt_nett))
    assert(ikkje inneheld(l_fullt, "fetch(a.u"))
    assert(lengde(l_teljar) <= tak_teljar())
    assert(lengde(l_eitt) <= tak_eitt_import())
    assert(lengde(l_fullt) <= tak_fullt())
    assert(lengde(l_fullt_test) <= tak_fullt_test())
    assert(ikkje inneheld(l_fullt, "test_"))
    assert(balansert(l_teljar))
    assert(balansert(l_fullt))
    assert(balansert(l_fullt_test))
    assert(ikkje balansert(l_teljar + ")"))

    # ── 2. Tree-shaking og importnamn = importseksjonen ──
    # sett_tekst tek ein tekstverdi (W3) og treng S, men ikkje escape eller lyttarar
    assert(inneheld(l_eitt, "TextDecoder"))
    assert(ikkje inneheld(l_eitt, "H="))
    assert(ikkje inneheld(l_eitt, "innerHTML"))
    assert(ikkje inneheld(l_eitt, "addEventListener"))
    la l_finn = js.bygg_lastar(["finn"], url(), sann)
    assert(like_lister(l_finn["hjelparar"], ["E", "S"]))
    la l_html = js.bygg_lastar(["sett_html"], url(), sann)
    assert(like_lister(l_html["hjelparar"], ["E", "S", "H"]))
    la l_klikk = js.bygg_lastar(["test_klikk"], url(), sann)
    assert(like_lister(l_klikk["hjelparar"], ["E"]))
    assert(ikkje inneheld(l_klikk["js"], "TextDecoder"))
    assert(ikkje inneheld(l_teljar, "test_klikk"))
    assert(inneheld(l_fullt_test, "test_klikk"))
    # Ekte modul: teljar-klienten, bygd med CLI-en (barneprosess i VM-fastmodus; lowring og
    # validering av ein W1-modul tek fleire sekund per KB i standard-VM-en). Importane i
    # utdatalinja er dei validatoren las ut av bytane, og nc.js er lastaren CLI-en skreiv.
    hjelp.mkdir("build/wasm/test_lastar")
    la l_linje = hjelp.bygg_klient("examples/wasm_teljar/klient.no", "build/wasm/test_lastar/teljar", usann)
    la info = {"importar": hjelp.liste_felt(l_linje, "importar")}
    la res = {"importar": info["importar"]}
    la l_modul = fil_les(rot + "/build/wasm/test_lastar/teljar/nc.js")
    assert(like_lister(lastar_importar(l_modul), info["importar"]))
    assert(like_lister(info["importar"], teljar_importar()))
    # Diskriminerer: ein lastar med ein import meir enn modulen blir avvist.
    la ekstra = []
    la ei = 0
    mens ei < lengde(res["importar"]) {
        legg_til(ekstra, res["importar"][ei])
        ei = ei + 1
    }
    legg_til(ekstra, "test_klikk")
    assert(ikkje like_lister(lastar_importar(js.bygg_lastar(ekstra, url(), sann)["js"]), info["importar"]))
    # W1: dei interne vertsfunksjonane (runtime-atoma) kjem frå tabellen og blir tree-shaka
    la l_logg = js.bygg_lastar(["logg"], url(), sann)
    assert(inneheld(l_logg["js"], "logg:(a,b)=>console.log(S(a,b))"))
    assert(like_lister(l_logg["hjelparar"], ["S"]))
    la l_flyt = js.bygg_lastar(["flyt_tekst"], url(), sann)
    # W4: sifra går gjennom U (same hjelpar som tekst frå DOM-en; W er borte)
    assert(inneheld(l_flyt["js"], "flyt_tekst:(a,b)=>U(a.toExponential(),b)"))
    assert(like_lister(l_flyt["hjelparar"], ["U"]))
    assert(ikkje inneheld(l_flyt["js"], "TextDecoder"))
    la l_lt = js.bygg_lastar(["logg_test"], url(), sann)["js"]
    assert(inneheld(l_lt, "logg_test:(a,b)=>document.getElementById(\"nc-logg\").append(S(a,b))"))
    # Ein W1-modul (skriv + deling), bygd med CLI-en: skriv går til logg, eller logg_test i
    # testbygg, og lastaren CLI-en skreiv har nøyaktig importane validatoren fann i modulen.
    la l_d = hjelp.bygg_klient("tests/wasm_korpus/feil_div.no", "build/wasm/test_lastar/feil_div", usann)
    la imp_d = hjelp.liste_felt(l_d, "importar")
    assert(like_lister(imp_d, ["logg"]))
    assert(like_lister(lastar_importar(fil_les(rot + "/build/wasm/test_lastar/feil_div/nc.js")), imp_d))
    la l_dt = hjelp.bygg_klient("tests/wasm_korpus/feil_div.no", "build/wasm/test_lastar/feil_div_t", sann)
    assert(like_lister(hjelp.liste_felt(l_dt, "importar"), ["logg_test"]))
    # Init-kallet kjem berre med når modulen har init
    assert(inneheld(l_modul, "x.i()"))
    assert(ikkje inneheld(js.bygg_lastar(["sett_tekst"], url(), usann)["js"], "x.i()"))
    # URL-en med versjon er bakt inn
    assert(inneheld(l_teljar, "fetch(\"/_nc/app.wasm?v=0123456789ab\")"))

    # ── 3. Strukturen kjem frå vertstabellen ──
    la t2 = kopi_tabell()
    la i2 = 0
    mens i2 < lengde(t2) {
        hvis t2[i2]["namn"] == "sett_tekst" {
            t2[i2]["op"] = ["tildel", ["felt", ["element", 0], "innerText"], ["arg", 1]]
            t2[i2]["param"] = ["handtak", "heltall"]
        }
        i2 = i2 + 1
    }
    legg_til(t2, {"namn": "fokus", "param": ["handtak"], "resultat": "ingen", "berre_test": usann,
                  "op": ["kall", ["felt", ["element", 0], "focus"], []]})
    la l2 = js.bygg_lastar_frå_tabell(t2, ["sett_tekst", "fokus"], url(), sann)["js"]
    assert(inneheld(l2, "sett_tekst:(a,b)=>E[a].innerText=b"))
    assert(ikkje inneheld(l2, "textContent"))
    assert(inneheld(l2, "fokus:a=>E[a].focus()"))
    assert(inneheld(l_teljar, "sett_tekst:(a,b,c)=>E[a].textContent=S(b,c)"))
    # W3: tekstverdiar til finn/sett_tekst/sett_html og desimaltall(tekst) via verten
    la l_tf = js.bygg_lastar(["tekst_flyt"], url(), sann)
    assert(inneheld(l_tf["js"], "tekst_flyt:(a,b)=>parseFloat(S(a,b))"))
    assert(like_lister(l_tf["hjelparar"], ["S"]))
    # Escape-hjelparen er bygd frå escape_tabell: kvar entitet i tabellen står i lastaren.
    la et = vert.escape_tabell()
    la eti = 0
    mens eti < lengde(et) {
        assert(inneheld(l_teljar, et[eti][1]))
        eti = eti + 1
    }

    # ── 4. Ingen handskrivne malar ──
    la kjelder = ["std/wasm_js.no", "std/wasm_vert.no", "std/wasm_jsc.no"]
    la lit_sett = {}
    la ki = 0
    mens ki < lengde(kjelder) {
        la lit = literalar(fil_les(rot + "/" + kjelder[ki]))
        assert(lengde(lit) > 20)
        la li = 0
        mens li < lengde(lit) {
            la s = tekst(lit[li])
            hvis er_js_fragment(s) {
                skriv(kjelder[ki] + ": strengliteralen «" + s + "» er eit JS-fragment (handskriven mal?)\n")
                assert(usann)
            }
            lit_sett[s] = sann
            li = li + 1
        }
        ki = ki + 1
    }
    # Skannaren diskriminerer
    assert(er_js_fragment("(async()=>{let d=document"))
    assert(er_js_fragment("E[a].textContent=b"))
    assert(er_js_fragment("x.i()"))
    assert(ikkje er_js_fragment("=>"))
    assert(ikkje er_js_fragment("textContent"))
    assert(ikkje er_js_fragment("{}"))
    assert(ikkje er_js_fragment("&#x27;"))
    assert(ikkje er_js_fragment("wasm_js: ukjend JS-node "))
    # Proveniens: kvart kodetoken i lastaren (unnateke streng- og regexliteralar, som er
    # data) er ein literal i emitteren eller vertsmodulen.
    la tok = js_token(l_fullt_test)
    la tki = 0
    mens tki < lengde(tok) {
        la t = tekst(tok[tki])
        la f = builtin.slice(t, 0, 1)
        la er_data = f == "\"" eller (f == "/" og lengde(t) > 1)
        la er_tal = builtin.char_code(f) >= 48 og builtin.char_code(f) <= 57
        hvis ikkje er_data og ikkje er_tal og ikkje finnes_nøkkel(lit_sett, t) {
            skriv("lastartokenet «" + t + "» finst ikkje som literal i emitteren eller vertstabellen\n")
            assert(usann)
        }
        tki = tki + 1
    }

    # ── 5. Tryggleik ──
    assert(ikkje inneheld(l_fullt_test, "eval"))
    assert(ikkje inneheld(l_fullt_test, "Function("))
    assert(ikkje inneheld(l_fullt_test, "document.write"))
    assert(ikkje inneheld(l_fullt_test, "onclick"))
    assert(ingen_on_tildeling(l_fullt_test))
    assert(ikkje ingen_on_tildeling("E[a].onclick=b"))
    # W7: unntaket for IndexedDB gjeld berre d/t, namna i lista og ein pilfunksjon
    assert(ingen_on_tildeling("d.onsuccess=()=>r(0)"))
    assert(ikkje ingen_on_tildeling("E[a].onsuccess=()=>r(0)"))
    assert(ikkje ingen_on_tildeling("d.onclick=()=>r(0)"))
    assert(ikkje ingen_on_tildeling("d.onerror=S(a,b)"))
    assert_eq(tal_av(l_fullt_test, "innerHTML="), 1)
    assert(inneheld(l_fullt_test, "innerHTML=S(b,c).split(\"{}\").join(H(S(d,e)))"))
    # W4: setAttribute og createElement berre i sett_attr og lag, med namn som er kontrollerte
    # ved kompilering (parametertypane attributt og tag), og navigasjon berre til same opphav
    assert_eq(tal_av(l_fullt_test, "setAttribute("), 2)
    assert(inneheld(l_fullt_test, "sett_handlar:(a,b,c,d,e)=>E[a].setAttribute(\"data-nc-\"+S(b,c),S(d,e).slice(1))"))
    assert(like_lister(vert.vertsfunksjon("sett_handlar")["param"], ["handtak", "hending", "funksjon"]))
    assert_eq(tal_av(l_fullt_test, "createElement("), 1)
    assert(like_lister(vert.vertsfunksjon("sett_attr")["param"], ["handtak", "attributt", "verdi"]))
    assert(like_lister(vert.vertsfunksjon("lag")["param"], ["tag"]))
    assert(inneheld(l_fullt_test, "gå_til:(a,b)=>(a=new URL(S(a,b),location.href)).origin==location.origin&&location.assign(a)"))
    assert_eq(tal_av(l_fullt_test, "location.assign("), 1)
    assert(vert.trygt_attributt("title") og vert.trygt_attributt("data-id") og vert.trygt_attributt("aria-invalid"))
    la farlege = ["onclick", "onmouseover", "href", "src", "style", "srcdoc", "action", "formaction", "data-nc-klikk", "data-", "data-A", "xlink:href"]
    la fi = 0
    mens fi < lengde(farlege) {
        hvis vert.trygt_attributt(farlege[fi]) {
            skriv("attributtet " + farlege[fi] + " skulle ikkje vere trygt\n")
            assert(usann)
        }
        fi = fi + 1
    }
    assert(vert.trygg_tag("li") og ikkje vert.trygg_tag("script") og ikkje vert.trygg_tag("iframe") og ikkje vert.trygg_tag("style"))
    la prøver = ["", "vanleg tekst", "<script>alert(\"x\")</script>", "a & b 'c' \"d\" <e>", "&amp; allereie", "blåbær <b>"]
    la pi = 0
    mens pi < lengde(prøver) {
        assert_eq(vert.html_escape(prøver[pi]), html.escape(prøver[pi]))
        pi = pi + 1
    }
    assert_eq(vert.html_frå_mal("<b>{}</b> og {}", "<i>&"), "<b>&lt;i&gt;&amp;</b> og &lt;i&gt;&amp;")

    # ── 6. W4: tekst frå DOM-en, hendingar og tree-shaking av dei nye hjelparane ──
    la l_hv = js.bygg_lastar(["hent_verdi"], url(), sann)
    assert(like_lister(l_hv["hjelparar"], ["E", "U"]))
    assert(inneheld(l_hv["js"], "hent_verdi:(a,b)=>U(E[a].value,b)"))
    assert(inneheld(l_hv["js"], "U=(a,b)=>(a=new TextEncoder().encode(a),b+a.length>x.m.buffer.byteLength&&x.m.grow((a.length>>16)+1),new Uint8Array(x.m.buffer).set(a,b),a.length)"))
    la l_ly = js.bygg_lastar(["lytt"], url(), sann)
    assert(like_lister(l_ly["hjelparar"], ["E", "S", "N", "V", "T", "L"]))
    assert(inneheld(l_ly["js"], "lytt:(a,b,c,d,e)=>L(E[a],S(b,c),x[S(d,e)])"))
    assert(inneheld(l_ly["js"], "b==\"send\"&&e.preventDefault()"))
    # N kjem frå hendingar(): kvar hending i tabellen står der
    la hd = vert.hendingar()
    la hdi = 0
    mens hdi < lengde(hd) {
        assert(inneheld(l_ly["js"], hd[hdi][0] + ":\"" + hd[hdi][1] + "\""))
        hdi = hdi + 1
    }
    la l_dl = js.bygg_lastar(["deleger"], url(), sann)
    assert(inneheld(l_dl["js"], "closest(\"[data-nc-\"+b+\"]\")"))
    assert(inneheld(l_dl["js"], "deleger:(a,b,c,d)=>L(document,S(a,b),x[S(c,d)],S(c,d).slice(1))"))
    la l_et = js.bygg_lastar(["etter"], url(), sann)
    assert(like_lister(l_et["hjelparar"], ["E", "S"]))
    assert(ikkje inneheld(l_et["js"], "addEventListener"))
    la l_sl = js.bygg_lastar(["slepp"], url(), sann)
    assert(like_lister(l_sl["hjelparar"], ["E", "F"]))
    assert(inneheld(l_sl["js"], "slepp:a=>(E[a]&&E[a].abort?E[a].abort():clearTimeout(E[a]),E[a]=null,F.push(a))"))
    # Handtak blir gjenbrukte (P) berre når modulen importerer slepp, også lyttarhandtaka
    la l_gj = js.bygg_lastar(["finn", "lytt", "slepp"], url(), sann)
    assert(like_lister(l_gj["hjelparar"], ["E", "F", "P", "S", "N", "V", "T", "L"]))
    assert(inneheld(l_gj["js"], "P=(a,b)=>(F.length?E[b=F.pop()]=a:b=E.push(a)-1,b)"))
    assert(inneheld(l_gj["js"], "finn:(a,b)=>P(document.querySelector(S(a,b)))"))
    assert(inneheld(l_gj["js"], "{signal:f.signal}),P(f))"))
    assert(ikkje inneheld(l_ly["js"], "P("))
    assert(inneheld(js.bygg_lastar(["finn"], url(), sann)["js"], "finn:(a,b)=>E.push(document.querySelector(S(a,b)))-1"))
    la l_hd = js.bygg_lastar(["hending_data"], url(), sann)
    assert(like_lister(l_hd["hjelparar"], ["S", "U", "T"]))
    # Teljaren (W0-settet) har ingen av dei nye hjelparane
    assert(ikkje inneheld(l_teljar, ",U=(") og ikkje inneheld(l_teljar, ",L=(") og ikkje inneheld(l_teljar, ",N={") og ikkje inneheld(l_teljar, ",P=("))
    assert(inneheld(l_gj["js"], ",L=(") og inneheld(l_hv["js"], ",U=("))
    # Presedens: parentes berre der JS krev det
    assert_eq(js_av(["binær", "-", ["namn", "a"], ["binær", "-", ["namn", "b"], ["namn", "c"]]]), "a-(b-c)")
    assert_eq(js_av(["binær", "-", ["binær", "-", ["namn", "a"], ["namn", "b"]], ["namn", "c"]]), "a-b-c")
    assert_eq(js_av(["binær", "||", ["binær", "??", ["namn", "a"], ["namn", "b"]], ["namn", "c"]]), "(a??b)||c")
    assert_eq(js_av(["binær", "&&", ["binær", "||", ["namn", "a"], ["namn", "b"]], ["namn", "c"]]), "(a||b)&&c")
    assert_eq(js_av(["binær", ">>", ["binær", "+", ["namn", "a"], ["namn", "b"]], ["tal", 16]]), "a+b>>16")
    assert_eq(js_av(["vilkår", ["binær", "&&", ["namn", "a"], ["namn", "b"]], ["namn", "c"], ["namn", "d"]]), "a&&b?c:d")
    # ── 7. W6: nett ──
    # Q og R kjem berre med når modulen importerer hent_start/hent_svar (std/wasm_nett.no).
    la l_nett = js.bygg_lastar(["hent_start", "hent_svar"], url(), sann)
    assert(like_lister(l_nett["hjelparar"], ["E", "S", "U", "R", "Q"]))
    assert(inneheld(l_nett["js"], "hent_start:(a,b,c,d)=>E.push(Q(S(a,b),x[S(c,d)]))-1"))
    assert(inneheld(l_nett["js"], "hent_svar:a=>U(R,a)"))
    # mode og credentials same-origin blir sette ETTER førespurnaden frå Norscode
    # (Object.assign), så dei kan ikkje overstyrast; avbryting og tidsgrense via signal
    assert(inneheld(l_nett["js"], "fetch(a.u,Object.assign(a,{signal:AbortSignal.any([k.signal,AbortSignal.timeout(a.t)]),mode:\"same-origin\",credentials:\"same-origin\"}))"))
    assert(inneheld(l_nett["js"], ".catch(e=>[a.i,0,e.name,\"\"]).then(b=>(R=b.join(\"\\n\"),c())),k)"))
    assert_eq(tal_av(l_fullt_test, "fetch("), 2)
    assert(ikkje inneheld(l_fullt, ",Q=(") og ikkje inneheld(l_teljar, ",Q=(") og inneheld(l_fullt_nett, ",Q=("))
    assert(ikkje inneheld(js.bygg_lastar(["slepp"], url(), sann)["js"], "AbortSignal"))
    # ── 8. W7: lokal lagring ──
    # I og J kjem berre med når modulen importerer lager_start/lager_svar (std/wasm_lager.no).
    la l_lager = js.bygg_lastar(["lager_start", "lager_svar"], url(), sann)
    assert(like_lister(l_lager["hjelparar"], ["E", "S", "U", "J", "I"]))
    assert(inneheld(l_lager["js"], "lager_start:(a,b,c,d,e)=>I(a,S(b,c),x[S(d,e)])"))
    assert(inneheld(l_lager["js"], "lager_svar:a=>U(J,a)"))
    la l_fl = js.bygg_lastar(["fjern_lokalt"], url(), sann)
    assert(like_lister(l_fl["hjelparar"], ["S"]))
    assert(inneheld(l_fl["js"], "fjern_lokalt:(a,b)=>localStorage.removeItem(S(a,b))"))
    # IndexedDB berre i I: opne eller slette, med faste nøkkel- og indeksstiar
    assert_eq(tal_av(l_fullt_test, "indexedDB."), 2)
    assert(inneheld(l_lager["js"], "d=a.v?indexedDB.open(a.n,a.v):indexedDB.deleteDatabase(a.n)"))
    assert(inneheld(l_lager["js"], "createObjectStore(n,{keyPath:\"k\",autoIncrement:a.s[n].a})"))
    assert(inneheld(l_lager["js"], "o.createIndex(x,\"i.\"+x,{unique:u[x]})"))
    # Tilkoplinga lukkar seg sjølv når ein annan fane oppgraderer eller slettar databasen
    assert(inneheld(l_lager["js"], "t.onversionchange=()=>t.close()"))
    # Éin transaksjon per batch; feil i catch avbryt han og fjernar onabort (berre eitt svar)
    assert(inneheld(l_lager["js"], "t=E[a.h].transaction(a.s,a.m)"))
    assert(inneheld(l_lager["js"], ".catch(e=>(t&&(t.onabort=null,t.abort()),r(e)))"))
    assert(inneheld(l_lager["js"], "J=JSON.stringify([i,e&&e.name,e&&e.message,b]),c()"))
    assert(ikkje inneheld(l_fullt, ",I=(") og ikkje inneheld(l_teljar, ",I=(") og ikkje inneheld(l_fullt_nett, ",I=(") og inneheld(l_fullt_alle, ",I=("))

    # ── 9. W8: service worker ──
    # PWA-gruppa på sida: G, B og O berre med PWA-importane (tree-shaking), eige tak.
    skriv("lastar: fullt med PWA (W8) " + tekst(lengde(l_fullt_pwa)) + " B (tak " + tekst(tak_fullt_pwa()) + "), PWA-gruppa " +
        tekst(lengde(l_fullt_pwa) - lengde(l_fullt_alle)) + " B (tak " + tekst(tak_pwa()) + ")\n")
    assert(lengde(l_fullt_pwa) <= tak_fullt_pwa())
    assert(lengde(l_fullt_pwa) - lengde(l_fullt_alle) <= tak_pwa())
    assert(balansert(l_fullt_pwa))
    assert(ikkje inneheld(l_fullt_alle, "serviceWorker") og ikkje inneheld(l_teljar, "serviceWorker"))
    la l_pwa = js.bygg_lastar(vert.pwa_funksjonar(), url(), sann)
    assert(like_lister(l_pwa["hjelparar"], ["S", "U", "B", "O", "G"]))
    assert(inneheld(l_pwa["js"], "sw_registrer:(a,b,c,d)=>G(S(a,b),x[S(c,d)])"))
    assert(inneheld(l_pwa["js"], "G=(a,c,n)=>(n=navigator.serviceWorker)?n.register(a).then(r=>(B=r,"))
    assert(inneheld(l_pwa["js"], "sw_send:(a,b)=>B&&B.waiting&&B.waiting.postMessage(S(a,b))"))
    assert_eq(tal_av(l_fullt_test, "postMessage("), 1)
    assert_eq(tal_av(l_fullt_test, ".register("), 1)
    # Testkrokane for Cache Storage og bilete berre i testbygg
    la l_krok = js.bygg_lastar(["test_cachar", "test_bilete", "test_resultat"], url(), sann)
    skriv("lastar: testkrokane i W8 " + tekst(lengde(l_fullt_test) - js_lengd_utan_krokar(alle_namn)) + " B (tak " + tekst(tak_pwa_test()) + ")\n")
    assert(lengde(l_fullt_test) - js_lengd_utan_krokar(alle_namn) <= tak_pwa_test())
    assert(like_lister(l_krok["hjelparar"], ["S", "U", "M"]))
    assert(ikkje inneheld(l_fullt_pwa, "caches") og ikkje inneheld(l_fullt_pwa, ".src=") og ikkje inneheld(l_fullt_pwa, "Image"))
    assert(inneheld(l_fullt_test, "caches.keys()"))
    # SW-lastaren (sw.js): importane til std/wasm_sw.no
    la sw_imp = ["sw_lytt", "sw_inn", "sw_ut", "logg", "flyt_tekst", "tekst_flyt"]
    la l_sw = js.bygg_sw_lastar(sw_imp, "/_nc/sw.wasm?v=0123456789ab")
    la sw_js = l_sw["js"]
    skriv("lastar: SW-lastaren (W8) " + tekst(lengde(sw_js)) + " B (tak " + tekst(tak_sw()) + ")\n")
    assert(lengde(sw_js) <= tak_sw())
    assert(balansert(sw_js))
    assert(like_lister(l_sw["hjelparar"], ["S", "U", "A", "D", "Y"]))
    assert(like_lister(lastar_importar(sw_js), sw_imp))
    # Hendingane blir registrerte synkront, på toppnivå i skriptet (eit krav i spesifikasjonen)
    la hend = ["install", "activate", "message", "fetch"]
    la hi2 = 0
    mens hi2 < lengde(hend) {
        la nål = ";addEventListener(\"" + hend[hi2] + "\",e=>"
        la pos = builtin.index_of(sw_js, nål)
        assert(pos > 0)
        assert_eq(djupn_ved(sw_js, pos), 0)
        hi2 = hi2 + 1
    }
    assert_eq(tal_av(sw_js, "addEventListener("), 4)
    assert(ikkje inneheld(sw_js, "(async"))
    # Modulen frå Cache Storage først (workeren kan starte utan nett), og init før hendingane
    assert(inneheld(sw_js, "K=caches.match(W).then(r=>r||fetch(W)).then(r=>WebAssembly.instantiateStreaming(r,{nc:{"))
    assert(inneheld(sw_js, "W=\"/_nc/sw.wasm?v=0123456789ab\""))
    assert(inneheld(sw_js, ".then(r=>(x=r.instance.exports,x.i()))"))
    # D startar som konfigurasjonen C frå tenaren; planane går gjennom Z
    assert(inneheld(sw_js, "D=C,"))
    assert(inneheld(sw_js, "Z=(n,d)=>(D=JSON.stringify(d),A[n](),JSON.parse(Y))"))
    # skipWaiting berre når Norscode-planen for ei melding seier det (klikk, eller auto med éi
    # fane: talet på faner kjem med), aldri under install
    assert_eq(tal_av(sw_js, "skipWaiting()"), 1)
    assert(inneheld(sw_js, "clients.matchAll({includeUncontrolled:true})).then(k=>Z(\"melding\",{m:e.data,k:k.length}).s&&skipWaiting())"))
    assert(inneheld(sw_js, "K.then(()=>(P=Z(\"install\",0),caches.open(P.c)))"))
    assert(ikkje inneheld(sw_js, "claim"))
    # Lagring berre når planen (l) og «lagre» (Norscode) seier ja; kopien blir laga før svaret
    # går vidare; ved install feilar heile installasjonen når éin URL ikkje kan lagrast
    assert_eq(tal_av(sw_js, ".put("), 2)
    assert(inneheld(sw_js, "p.l&&Z(\"lagre\",B(s)).l&&(q=s.clone(),caches.open(p.c).then(c=>c.put(p.n,q)))"))
    assert(inneheld(sw_js, "Z(\"lagre\",B(r)).l?c.put(u,r):Promise.reject(u)"))
    assert(inneheld(sw_js, "B=r=>({s:r.status,t:r.type,r:r.redirected,c:r.headers.get(\"cache-control\")})"))
    # fetch: planen frå Norscode; kan modulen ikkje startast, går førespurnaden til nettet
    # Når modulen er klar, blir «forbi» ikkje handtert (ingen respondWith: den gamle workeren har
    # då ingenting i gang, så ein ny versjon kan aktiverast)
    assert(inneheld(sw_js, "addEventListener(\"fetch\",e=>x?(J=Q(e.request)).k!=\"forbi\"&&e.respondWith(H(J,e.request)):e.respondWith(K.then(()=>H(Q(e.request),e.request),()=>fetch(e.request))))"))
    assert(inneheld(sw_js, "Q=r=>Z(\"hent\",{m:r.method,u:r.url,n:r.mode,o:location.origin})"))
    assert_eq(tal_av(sw_js, "respondWith("), 2)
    # Gamle cachar: berre dei Norscode listar
    assert(inneheld(sw_js, "Promise.all(Z(\"rydd\",k).map(n=>caches.delete(n)))"))
    assert(ikkje inneheld(sw_js, "eval") og ikkje inneheld(sw_js, "Function(") og ikkje inneheld(sw_js, "importScripts") og ikkje inneheld(sw_js, "document"))
    # Tree-shaking: utan logg ingen console, og utan tekst frå verten ingen U
    la l_sw_min = js.bygg_sw_lastar(["sw_lytt", "sw_ut"], "/_nc/sw.wasm?v=0123456789ab")
    assert(ikkje inneheld(l_sw_min["js"], "console"))
    assert(like_lister(l_sw_min["hjelparar"], ["S", "A", "D", "Y"]))
    # Fail-closed: DOM, nett og lagring finst ikkje i ein service worker
    la avviste = ["finn", "hent_start", "lager_start", "sw_registrer", "logg_test"]
    la ai = 0
    mens ai < lengde(avviste) {
        la kasta = usann
        prøv {
            js.bygg_sw_lastar(["sw_lytt", avviste[ai]], "/_nc/sw.wasm?v=0")
        } fang (e) {
            kasta = builtin.index_of(tekst(e), "finst ikkje i ein service worker") >= 0
        }
        hvis ikkje kasta {
            skriv(avviste[ai] + " vart ikkje avvist i SW-lastaren\n")
            assert(usann)
        }
        ai = ai + 1
    }
    # Førebuinga tenaren skriv (`let C="…"`) er emittert: JSON-teksten er éin strengliteral
    assert_eq(js.sw_konfig_setning("{\"v\":\"a\\\"b\\n\"}"), "let C=\"{\\\"v\\\":\\\"a\\\\\\\"b\\\\n\\\"}\"")
    # Proveniens: kvart kodetoken i sw.js (førebuinga og lastaren) og i PWA-lastaren er ein
    # literal i emitteren eller vertsmodulen
    proveniens(js.sw_konfig_setning("{}") + ";" + sw_js, lit_sett)
    proveniens(l_pwa["js"], lit_sett)

    # Ein typisk interaktiv klient (skjema-demoen), bygd med CLI-en: importnamna i lastaren
    # er importseksjonen (også namn i hermeteikn), og lastaren er under taket for øy-program
    la l_s = hjelp.bygg_klient("examples/wasm_skjema/klient.no", "build/wasm/test_lastar/skjema", usann)
    la imp_s = hjelp.liste_felt(l_s, "importar")
    la js_s = fil_les(rot + "/build/wasm/test_lastar/skjema/nc.js")
    assert(like_lister(lastar_importar(js_s), imp_s))
    assert(lengde(imp_s) >= 10)
    skriv("lastar: skjema-klienten " + tekst(lengde(js_s)) + " B (tak " + tekst(tak_øy()) + "), " + tekst(lengde(imp_s)) + " importar\n")
    assert(lengde(js_s) <= tak_øy())
    assert(balansert(js_s))

    skriv("wasm_lastar_sjekk OK\n")
    returner 0
}
