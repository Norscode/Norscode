funksjon start() -> heiltall {
    la m: ordbok = {}
    map_set(m, "alfa", 111)
    map_set(m, "beta", 222)
    map_set(m, "gamma", 333)
    // tving mange allokeringar → collect medan m er levande
    la i: heiltall = 0
    mens i < 3000 {
        la t: liste_heiltall = [i, i+1, i+2]
        i = i + 1
    }
    // m må overleve
    hvis map_get(m, "alfa") != 111 { returner 1 }
    hvis map_get(m, "beta") != 222 { returner 2 }
    hvis map_get(m, "gamma") != 333 { returner 3 }
    skriv("map OK: 111/222/333 overlevde collect\n")
    returner 0
}
