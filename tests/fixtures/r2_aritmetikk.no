# Fikstur for tests/test_r2_aritmetikk.no (F08): blanda aritmetikk.
funksjon feil_av(op: tekst, a, b) -> tekst {
    prøv {
        hvis op == "+" { returner "ingen feil: " + tekst(a + b) }
        hvis op == "-" { returner "ingen feil: " + tekst(a - b) }
        hvis op == "*" { returner "ingen feil: " + tekst(a * b) }
        hvis op == "/" { returner "ingen feil: " + tekst(a / b) }
        hvis op == "%" { returner "ingen feil: " + tekst(a % b) }
    } fang (e: TypeFeil) {
        returner tekst(e)
    }
    returner "?"
}

funksjon start() -> tekst {
    la ut = []
    la a = 1
    la b = "x"
    la c = a + b
    legg_til(ut, "a+b=" + c + "/" + type(c))
    legg_til(ut, "b+a=" + (b + a))
    legg_til(ut, "des=" + tekst(2.5 + a) + "+" + tekst("v" + 2.5))
    legg_til(ut, "bool=" + ("s=" + sann))
    la s = 0
    for v i ["x", "y"] {
        s = s + v
    }
    legg_til(ut, "løkke=" + s)
    legg_til(ut, "tal=" + tekst(7 - 2) + "," + tekst(3 * 4) + "," + tekst(9 / 2) + "," + tekst(9 % 4))
    legg_til(ut, feil_av("-", 5, "x"))
    legg_til(ut, feil_av("*", "a", sann))
    legg_til(ut, feil_av("/", [1], 2))
    legg_til(ut, feil_av("%", 5, ingenting))
    legg_til(ut, feil_av("+", sann, 1))
    legg_til(ut, feil_av("+", [1], [2]))
    prøv {
        la n = -"x"
        legg_til(ut, "neg=" + tekst(n))
    } fang (e) {
        legg_til(ut, tekst(e))
    }
    returner builtin.join(ut, ";")
}
