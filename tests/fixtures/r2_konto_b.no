# Fikstur for tests/test_r2_struktur.no (F20): modul B med ein ANNAN struktur
# som òg heiter Konto. Metodeoppslaget må treffe B.Konto.kven, ikkje A sin.
struktur Konto {
    v
}
funksjon ny() -> Konto {
    la k = Konto()
    k.v = 2
    returner k
}
funksjon Konto.kven(self) -> tekst {
    returner "B"
}
