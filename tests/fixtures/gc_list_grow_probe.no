// GC (3b) probe: RT_LIST_APP grow-path korrektheit MED gc_alloc_var_r8 (NORSCODE_GC_ALLOC=1).
// Byggjer ei liste på 100 element (tvingar mange grows forbi cap 8). Om grow-patchen klobra
// feil register eller allokerte feil, blir innhaldet feil / krasj. Verifiser liste[50]==50,
// liste[99]==99, sum(0..99)==4950. Exit: 0 = OK · 2 = feil innhald.
funksjon start() -> heiltall {
    la liste: liste_heiltall = []
    la i: heiltall = 0
    mens i < 100 {
        legg_til(liste, i)
        i = i + 1
    }
    la sum: heiltall = 0
    la k: heiltall = 0
    mens k < 100 {
        sum = sum + liste[k]
        k = k + 1
    }
    hvis liste[50] == 50 og liste[99] == 99 og sum == 4950 {
        skriv("gc_list_grow OK: 100-elem liste (mange grows) korrekt med gc_alloc_var_r8\n")
        returner 0
    }
    returner 2
}
