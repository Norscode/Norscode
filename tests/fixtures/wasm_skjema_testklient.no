# Testklient for skjema-demoen (W4, testbygg): startar den ekte examples/wasm_skjema/klient.no
# og køyrer brukarsteg gjennom testkrokane (test_skriv, test_send, test_klikk, test_tast), som
# sender ekte hendingar gjennom lastaren (L, delegering). Etter kvart steg blir tilstanden i
# DOM-en skriven til #nc-logg; tests/test_wasm_w4.no samanliknar med fasiten.
bruk std.wasm_vert som vert
bruk examples.wasm_skjema.klient som s

funksjon tekst_av(sel: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_tekst(h)
    vert.slepp(h)
    returner t
}

funksjon attr_av(sel: tekst, namn: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_attr(h, namn)
    vert.slepp(h)
    returner t
}

funksjon logg_steg(namn: tekst) -> heltall {
    skriv(namn + ": " + tekst_av("#nc-resultat") + " | namn=" + tekst_av("#namn-feil") + " (" + attr_av("#namn", "aria-invalid") +
          ") | epost=" + tekst_av("#epost-feil") + " | lagre=" + attr_av("#lagre", "disabled") + " | status=" + tekst_av("#status") + "\n")
    returner 0
}

funksjon skriv_i(sel: tekst, verdi: tekst) -> heltall {
    la h = vert.finn(sel)
    vert.test_skriv(h, verdi)
    vert.slepp(h)
    returner 0
}

# Reglane i WASM (tests/test_wasm_w4.no reknar dei same i VM-en)
funksjon reglar() -> heltall {
    la namn = ["", " ", "A", "Al", "  Bo  ", "Åse"]
    la epost = ["", "a", "@b.no", "a@b", "a@.no", "a@b.", "a@b.no", "a b@c.no", "  x@y.z  "]
    la i = 0
    mens i < lengde(namn) {
        skriv("namn «" + namn[i] + "»: " + s.gyldig_namn(namn[i]) + "\n")
        i = i + 1
    }
    i = 0
    mens i < lengde(epost) {
        skriv("epost «" + epost[i] + "»: " + s.gyldig_epost(epost[i]) + "\n")
        i = i + 1
    }
    skriv("treff: " + tekst(s.treff("Herbert", "BER")) + " " + tekst(s.treff("Åse", "å")) + " " + tekst(s.treff("Åse", "Å")) + " " + tekst(s.treff("Ola", "")) + "\n")
    returner 0
}

funksjon start() -> heltall {
    # Tekst frå DOM-en som er større enn minnet: U må vekse minnet (70 006 bytar)
    la frå_dom = vert.hent_verdi(vert.finn("#stor"))
    skriv("stor frå DOM: " + tekst(lengde(frå_dom)) + " " + tekst(builtin.slice(frå_dom, 0, 3) == "yyy") + " " + tekst(builtin.ends_with(frå_dom, "yæøå")) + "\n")
    reglar()
    s.start()
    logg_steg("start")
    skriv_i("#filter", "ber")
    logg_steg("filter ber")
    skriv_i("#filter", "BER")
    logg_steg("filter BER")
    skriv_i("#namn", "A")
    logg_steg("namn A")
    skriv_i("#namn", "Åse Berg")
    skriv_i("#epost", "åse@")
    logg_steg("epost åse@")
    skriv_i("#epost", "ase@eksempel.no")
    logg_steg("gyldig")
    la skjema = vert.finn("#skjema")
    vert.test_send(skjema)
    logg_steg("send")
    skriv("namn-feltet: «" + vert.hent_verdi(vert.finn("#namn")) + "»\n")
    # Delegering: knappen i rad 3 (Berit) har data-nc-klikk="fjern"
    vert.test_klikk(vert.finn("button[data-id=\"3\"]"))
    logg_steg("fjern 3")
    # Negativ kontroll: data-nc-klikk med ein funksjon som ikkje er delegert, gjer ingenting
    vert.test_klikk(vert.finn("#falsk"))
    logg_steg("falsk")
    la f = vert.finn("#filter")
    vert.test_tast(f, "a")
    logg_steg("tast a")
    vert.test_tast(f, "Escape")
    logg_steg("escape")
    # Lokal lagring: lista (50 + Åse Berg − Berit) og to tekstverdiar i postkassa
    la lagra = vert.hent_lokalt("wasm_skjema.namn")
    la namna = builtin.split(lagra, ",")
    skriv("lagra: " + tekst(lengde(namna)) + " namn, " + tekst(builtin.contains(lagra, "Åse Berg")) + " " + tekst(builtin.contains(lagra, "Berit")) + "\n")
    vert.lagre_lokalt("flyt", 2.5)
    vert.lagre_lokalt("k" + tekst(1), "v" + tekst(2))
    skriv("lokalt: " + vert.hent_lokalt("flyt") + " " + vert.hent_lokalt("k1") + " «" + vert.hent_lokalt("manglar") + "»\n")
    # Stor tekst frå DOM-en: 65536 bytar + æøå (minnet må vekse)
    la stor = "x"
    la i = 0
    mens i < 16 {
        stor = stor + stor
        i = i + 1
    }
    stor = stor + "æøå"
    skriv_i("#namn", stor)
    la attende = vert.hent_verdi(vert.finn("#namn"))
    skriv("stor: " + tekst(lengde(attende)) + " " + tekst(attende == stor) + "\n")
    skriv_i("#namn", "")
    # Handtaka blir gjenbrukte etter slepp: tabellen har ikkje vakse med kvar gjengjeving
    la h = vert.finn("#status")
    skriv("handtak små: " + tekst(h < 400) + "\n")
    returner 0
}
