// Regresjonsvakt: tekst(heiltall) må rendere desimal (var TOM i native codegen).
funksjon start() -> heiltall {
    hvis tekst(42) != "42" { returner 1 }
    hvis tekst(0) != "0" { returner 2 }
    hvis tekst(1000) != "1000" { returner 3 }
    la x: heiltall = 5 + 3
    hvis tekst(x) != "8" { returner 4 }
    hvis ("v=" + tekst(255) + "!") != "v=255!" { returner 5 }
    skriv("tekst(heiltall) OK: 42/0/1000/8/255 rett\n")
    returner 0
}
