// Fase 8: fjern_nokkel (skann + skyv par ned, dekrementer count) + json_parse_raw
// (alias for __json_parse). 3-nøkkel-kart (operand-djupn ≤ 6). Fjern "b" → {a,c};
// len=2 + m["a"]=1 + m["c"]=3 + (7+8+9)=24 = 30.
funksjon start() -> heiltall {
    la m = {"a": 1, "b": 2, "c": 3}
    builtin.fjern_nokkel(m, "b")
    la total = lengde(nøkler(m))
    total = total + m["a"]
    total = total + m["c"]
    la p = builtin.json_parse_raw("[7, 8, 9]")
    total = total + p[0]
    total = total + p[1]
    total = total + p[2]
    returner total
}
