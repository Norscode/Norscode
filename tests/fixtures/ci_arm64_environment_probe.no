bruk tools.ci_shell_runner som ci_runner

funksjon start() -> heiltall {
    assert_eq(miljo_hent("NC_ARM64_OS"), "macos")
    assert_eq(miljo_hent("NORSCODE_SEED_NCB"), "/tmp/norscode arm64 kandidat.ncb.json")
    assert_eq(miljo_hent("NC_ARM64_KREV_LIK"), "1")
    la miljø = ci_runner.barnemiljø()
    assert_eq(tekst(miljø["NC_ARM64_OS"]), "macos")
    assert_eq(tekst(miljø["NORSCODE_SEED_NCB"]), "/tmp/norscode arm64 kandidat.ncb.json")
    assert_eq(tekst(miljø["NC_ARM64_KREV_LIK"]), "1")
    la namn = ["NC_ARM64_OUT", "NC_ARM64_GC", "NC_TEST_VM_FAST", "NORSCODE_VM_FAST", "NC_VERBOSE",
                "NORSCODE_DIFF_FILE", "NORSCODE_DIFF_TARGET", "NORSCODE_DIFF_STRICT", "NORSCODE_DIFF_EXPECT",
                "NORSCODE_LINGUIST_SOURCE_SHA", "NORSCODE_WINDOWS_FREESTANDING_ATTESTATION"]
    la verdiar = ["/tmp/norscode arm64 kandidat", "0", "1", "1", "1",
                   "tools/fixtures/diff_smoke.no", "macos-arm64", "1", "42",
                   "a0a33089e33362e7336bc8e84fe19489bda28376", "/tmp/norscode windows freestanding attestasjon.json"]
    la i = 0
    mens i < lengde(namn) {
        assert_eq(miljo_hent(namn[i]), verdiar[i])
        assert_eq(tekst(miljø[namn[i]]), verdiar[i])
        i = i + 1
    }
    // Nokre runtime-ar arvar foreldremiljøet. Berre det eksplisitte kartet
    // skal vere avgrensa til adapteren si liste over tillatne variablar.
    assert(ikkje finnes_nøkkel(miljø, "NORSCODE_CI_UNLISTED_PROBE"))
    skriv("ci ARM64 environment OK\n")
    returner 0
}
