bruk std.runtime_profiler som profiler

funksjon start() -> heiltall {
    profiler.nullstill()
    la behold: liste<ordbok_tekst> = []
    la i: heiltall = 0
    mens i < 12000 {
        legg_til(behold, {"index": tekst_fra_heltall(i), "payload": "norscode-gc-benchmark-payload"})
        i = i + 1
    }
    prøv { builtin.gc_collect() } fang (e) { }
    la data = profiler.snapshot()
    skriv("__NORSCODE_GC_PAUSE_MS__=" + tekst_fra_heltall(profiler.gc_pause_ms(data)) + "\n")
    assert(lengde(behold) == 12000)
    returner 0
}
