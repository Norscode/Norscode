// Fase 6-JSON (containerar): rekursiv json_stringify av lister og kart, med
// nøsting for å prove rekursjonen. Forventa stdout:
//   [1,2,3]|{"a":1}|[true,false]|[[1,2],[3]]
// Lengder: 7 + 7 + 12 + 11 = 37.
funksjon start() -> heiltall {
    la a = builtin.json_stringify([1, 2, 3])
    la b = builtin.json_stringify({"a": 1})
    la c = builtin.json_stringify([sann, usann])
    la d = builtin.json_stringify([[1, 2], [3]])
    skriv(a) skriv("|") skriv(b) skriv("|") skriv(c) skriv("|") skriv(d) skriv("\n")
    returner lengde(a) + lengde(b) + lengde(c) + lengde(d)
}
