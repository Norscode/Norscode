# Fikstur for tests/test_r2_modulglobal.no (F14): mod.KONST, mod.x = v og
# initialisering i avhengnadsrekkjefølgje.
bruk tests.fixtures.r2_init_a som a
bruk tests.fixtures.r2_init_b som b
bruk tests.fixtures.r2_init_c som c
bruk tests.fixtures.r2_logg som lg

la H = 1
lg.logg("H")

funksjon start() -> tekst {
    la ut = []
    legg_til(ut, "init=" + lg.alle())
    legg_til(ut, "B=" + tekst(b.B_VERDI) + " C=" + tekst(c.C_VERDI) + " GRENSE=" + tekst(c.GRENSE))
    c.C_VERDI = 50
    legg_til(ut, "skrive=" + tekst(c.c_verdi()))
    c.C_VERDI += 1
    legg_til(ut, "auke=" + tekst(c.C_VERDI) + "/" + tekst(c.c_verdi()))
    legg_til(ut, "a=" + a.a())
    returner builtin.join(ut, ";")
}
