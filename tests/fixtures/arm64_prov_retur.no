// A5: `returner` inne i `prøv` må ikkje leke handlerpostar. Før lak kvar slik retur
// ein 80-byte-post i ARM64-AOT; etter 256 kall rann handler-regionen over i
// miljø-overlayet (miljo_hent krasja). No blir __exc_top__ sett tilbake ved RETURN.
funksjon tidleg(x: heiltall) -> heiltall {
    prøv {
        hvis x % 2 == 0 { returner x * 2 }
        returner x + 1
    } fang (e) {
        returner -1
    }
    returner 0
}

funksjon kastar(x: heiltall) -> heiltall {
    prøv {
        hvis x > 1000 { kast "stor" }
        returner x
    } fang (e) {
        returner 0 - x
    }
    returner 0
}

funksjon start() -> heiltall {
    miljo_sett("NC_PROV_A", "a")
    la sum = 0
    la i = 0
    mens i < 2000 {
        sum = sum + tidleg(i)
        i = i + 1
    }
    miljo_sett("NC_PROV_B", "b")
    skriv("sum=" + tekst(sum) + "\n")
    skriv("miljø=" + miljo_hent("NC_PROV_A") + miljo_hent("NC_PROV_B") + "\n")
    skriv("kast=" + tekst(kastar(5)) + " " + tekst(kastar(2000)) + "\n")
    la fanga = "nei"
    prøv { kast "ytst" } fang (e) { fanga = "ja" }
    skriv("ytst=" + fanga + "\n")
    returner 0
}
