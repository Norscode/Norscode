// Fixture for tests/test_nc_test_oppdaging.no (F38): éin bestått og éin feilande
// test-blokk ved sida av start(). `nc test` skal rapportere 1/2 og feile fila.
funksjon dobbel(x: heiltall) -> heiltall { returner x * 2 }

test "dobbel gir rett svar" {
    assert_eq(dobbel(2), 4)
}

test "denne skal feile" {
    assert_eq(dobbel(2), 5)
}

funksjon start() {
    skriv("start køyrde\n")
}
