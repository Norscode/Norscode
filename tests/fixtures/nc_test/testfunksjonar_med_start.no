// Fixture for tests/test_nc_test_oppdaging.no (F38): med start() er test_*-funksjonar
// hjelparar som start() kallar sjølv. Testløparen skal IKKJE køyre dei på eiga hand
// (test_ikkje_sjolvstendig ville feile), so fila er grøn.
funksjon test_hjelpar() -> heiltall {
    returner 7
}

funksjon test_ikkje_sjolvstendig() {
    assert_eq(1, 2)
}

funksjon start() -> heiltall {
    assert_eq(test_hjelpar(), 7)
    returner 0
}
