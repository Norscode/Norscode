// Fixture for tests/test_nc_test_oppdaging.no (F38): fatale feil som prøv/fang i
// testkøyraren ikkje kan fange. «Ukjent variabel» er eit vert-nivå-kast i VM-en, og
// builtin.exit(0) avsluttar prosessen. Kvar av dei skal bli FEIL på sin eigen test, og
// testane etter skal framleis køyre (i ein ny prosess): 2/4 bestått, fila raud.
// (Kompilatoren avviser i dag ikkje udefinerte namn; gjer han det ein gong, må den
// andre blokka byttast ut med ein annan ufangbar feil.)
test "fyrst ok" {
    assert_eq(1, 1)
}

test "ukjent variabel" {
    assert_eq(finst_ikkje_nokon_stad, 5)
}

test "avsluttar prosessen" {
    builtin.exit(0)
}

test "etter fatale feil" {
    assert_eq(2, 2)
}

funksjon start() -> heiltall {
    returner 0
}
