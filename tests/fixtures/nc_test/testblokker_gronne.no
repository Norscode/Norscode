// Fixture for tests/test_nc_test_oppdaging.no (F38): berre grøne test-blokker og ein
// modulglobal som blokkene les. `nc test` skal rapportere 2/2 og la fila vere grøn.
la grunnlag = 20

funksjon pluss(a: heiltall, b: heiltall) -> heiltall { returner a + b }

test "pluss" {
    assert_eq(pluss(2, 3), 5)
}

test "les modulglobal" {
    assert_eq(pluss(grunnlag, 1), 21)
}

funksjon start() -> heiltall {
    returner 0
}
