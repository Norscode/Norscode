// Fixture for tests/test_nc_test_oppdaging.no (F38): start() avsluttar prosessen med
// exit 0 før test-blokka rekk å køyre. builtin.exit(0) frå start() var grønt før F38 òg,
// so testløparen noterer det og køyrer test-blokka i ein ny prosess. Blokka feilar, so
// fila skal vere raud — ikkje falsk grøn fordi prosessen enda med exit 0.
test "blokk etter exit" {
    assert_eq(1, 2)
}

funksjon start() -> heiltall {
    skriv("før exit\n")
    builtin.exit(0)
    returner 0
}
