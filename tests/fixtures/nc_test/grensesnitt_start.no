// Fixture for tests/test_nc_test_oppdaging.no (F38-gransking): ein metode `start` i eit
// grensesnitt er ikkje start() for fila. Førefilteret såg det innrykka
// `funksjon start(self)` som start() og hoppa over testkøyraren, so berre den fyrste
// funksjonen (entry) køyrde → falsk grønt. No avgjer NCB-en: fila har ingen start(), so
// test_*-funksjonane skal køyrast (1/2) og fila vere raud.
grensesnitt Motor {
    funksjon start(self) -> heltall
}

funksjon test_ok() {
    assert_eq(1, 1)
}

funksjon test_skal_feile() {
    assert_eq(1, 2)
}
