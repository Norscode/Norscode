# W8: sjekkane av dei store ikona for tests/test_wasm_w8.no, i ein barneprosess i VM-fastmodus
# (eit ikon på 512 px er om lag 33 000 CRC- og Adler-steg per byte-lykkje, som tek om lag 0,4 s
# i fastmodus og fleire minutt i standard-VM-en). Skriv éi linje per sjekk og «wasm_w8_png OK».
bruk std.png_enkel som png
bruk std.wasm_pwa som pwa

funksjon linje(namn: tekst, b: tekst) -> heltall {
    la s = png.sjekk(b)
    skriv("ikon " + namn + ": ok=" + tekst(s["ok"]) + " " + tekst(s["bredde"]) + "x" + tekst(s["høgd"]) + " bitdjupn=" + tekst(s["bitdjupn"]) +
          " fargetype=" + tekst(s["fargetype"]) + " palett=" + tekst(s["palett"]) + " chunks=" + builtin.join(s["chunks"], ",") + " byte=" + tekst(lengde(b)) + "\n")
    returner 0
}

funksjon start() -> heltall {
    la k = pwa.konfig("Test", "Test")
    la b192 = pwa.ikon_bytar(k, "192")
    la b512 = pwa.ikon_bytar(k, "512")
    linje("192", b192)
    linje("512", b512)
    # maskable er same bilete som 512 (ringen ligg innanfor tryggleikssona)
    skriv("maskable lik 512: " + tekst(pwa.ikon_bytar(k, "maskable") == b512) + "\n")
    # Deterministisk: same fargar gjev same bytar, andre fargar gjev andre
    skriv("deterministisk: " + tekst(png.ikon(192, "#1f5f99", "#ffffff") == b192) + " andre fargar ulike: " + tekst(png.ikon(192, "#000000", "#ffffff") != b192) + "\n")
    # Eit ikon levert av appen med feil storleik blir avvist av valideringa
    la k2 = pwa.konfig("Test", "Test")
    pwa.med_skal(k2, "/", "x")
    pwa.med_ikon(k2, "512", b192)
    skriv("levert 512 med 192 px: " + builtin.join(pwa.valider(k2), "; ") + "\n")
    la k3 = pwa.konfig("Test", "Test")
    pwa.med_skal(k3, "/", "x")
    pwa.med_ikon(k3, "192", b192)
    skriv("levert 192: «" + builtin.join(pwa.valider(k3), "; ") + "» versjon frå bytane: " + tekst(pwa.ikon_versjon(k3, "192") == builtin.slice(builtin.sha256(b192), 0, 12)) + "\n")
    skriv("wasm_w8_png OK\n")
    returner 0
}
