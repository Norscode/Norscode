// Regresjon for native __json_parse: >64 element per JSON-nivå + JSON-escapes.
// Før fiksen (2026-08-15): liste/kart brukte ein 512 B (64-slot) stack-buffer →
// SIGBUS over 64 element; og strengar hadde inga escape-handtering → desync på
// første \" i ein ekte NCB. Etter: 256 KiB buffer (32768 slots) + escape-dekoding
// (\" \\ \/ \n \r \t \b \f). Interpretert = 88; native (Docker linux/arm64 /
// macho) skal gje same. Køyr native via same veg som dei andre arm64-fixturane.
funksjon start() -> heiltall {
    // Liste med 200 element (langt over den gamle 64-grensa).
    la buf = "["
    la i = 0
    mens i < 200 {
        hvis i > 0 { buf = buf + "," }
        buf = buf + tekst_fra_heltall(i)
        i = i + 1
    }
    buf = buf + "]"
    la lst = builtin.json_parse_raw(buf)
    assert_eq(lengde(lst), 200)
    assert_eq(lst[0], 0)
    assert_eq(lst[199], 199)

    // Kart med 100 nøklar (200 slots key+val).
    la mbuf = "{"
    i = 0
    mens i < 100 {
        hvis i > 0 { mbuf = mbuf + "," }
        mbuf = mbuf + "\"k" + tekst_fra_heltall(i) + "\":" + tekst_fra_heltall(i)
        i = i + 1
    }
    mbuf = mbuf + "}"
    la m = builtin.json_parse_raw(mbuf)
    assert_eq(m["k0"], 0)
    assert_eq(m["k99"], 99)

    // JSON-escapes: bygg strengen via teiknkodar for å unngå kjelde-escape-forvirring.
    la dq = "\""
    la bs = "\\"
    // JSON = ["a\"b","c\nd","e\\f"]
    la js = "[" + dq + "a" + bs + dq + "b" + dq + "," + dq + "c" + bs + "n" + "d" + dq + "," + dq + "e" + bs + bs + "f" + dq + "]"
    la es = builtin.json_parse_raw(js)
    assert_eq(lengde(es), 3)
    assert_eq(es[0], "a" + dq + "b")     // a"b (escaped quote → literal ")
    assert_eq(lengde(es[1]), 3)          // c\nd → c, linjeskift, d = 3 teikn
    assert_eq(es[2], "e" + bs + "f")     // e\f (escaped backslash → literal \)

    returner 88
}
