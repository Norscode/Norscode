// Fase 8: builtin-hale — tekst_fra_heltall/heltall_fra_tekst (alias), builtin.type
// (køyretids typenamn, kart→"ordbok"), nøkler (kart→liste av nøklar).
// len("42")=2 + 17 + len(ks)=3 = 22; fire type-sjekkar +4 = 26.
funksjon start() -> heiltall {
    la a = tekst_fra_heltall(42)
    la b = heltall_fra_tekst("17")
    la m = {"x": 1, "y": 2, "z": 3}
    la ks = nøkler(m)
    la sum = lengde(a) + b + lengde(ks)
    hvis builtin.type(5) == "heltall" { sum = sum + 1 }
    hvis builtin.type("hi") == "tekst" { sum = sum + 1 }
    hvis builtin.type([1, 2]) == "liste" { sum = sum + 1 }
    hvis builtin.type(m) == "ordbok" { sum = sum + 1 }
    returner sum
}
