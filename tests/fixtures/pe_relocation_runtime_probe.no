// AOT-probe for PE-relokering: .rdata-peikarar, modulglobalar, verts-/closure-tabell,
// catch-adresser og GC sine heap-/bitmap-/live-map-/markstakk-adresser.
la global_tal: heiltall = 20
la global_tekst: tekst = "relokert"

funksjon auk() -> heiltall {
    global_tal = global_tal + 1
    returner global_tal
}

funksjon start() -> heiltall {
    assert_eq(auk(), 21)
    la x: heiltall = 21
    la f = fun(y: heiltall) -> x + y
    assert_eq(f(21), 42)
    assert_eq(global_tekst + "-tekst", "relokert-tekst")
    la fanga = usann
    prøv { kast "flytta" } fang (e) { fanga = tekst(e) == "flytta" }
    assert(fanga)
    assert_eq(builtin.sha256_bytes_hex([97, 98, 99]), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    la roter: liste = []
    la i: heiltall = 0
    mens i < 3000 { legg_til(roter, "levande-" + tekst(i)) i = i + 1 }
    builtin.gc_collect_native()
    assert_eq(roter[2999], "levande-2999")
    assert_eq(global_tekst, "relokert")
    assert_eq(f(21), 42)
    skriv("PE_RELOCATION_RUNTIME_OK\n")
    returner 42
}
