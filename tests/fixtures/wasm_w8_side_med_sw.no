# W8, negativ kontroll (tests/test_wasm_w8_serve.no): ein klientmodul for sida som importerer ein
# vertsfunksjon som berre finst i service workeren. tools/nc_wasm.no skal avvise han.
bruk std.wasm_vert som vert

funksjon handterar() -> heltall {
    returner 0
}

funksjon start() -> heltall {
    vert.sw_lytt("hent", "handterar")
    returner 0
}
