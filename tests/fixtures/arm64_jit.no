// arm64: norscode-jit-v1 med AArch64-senking (std.native_gap.jit_operation, a64-greina i
// _jit_senk): heiltal, desimaltal (NaN-ordna samanlikning), tekst (eq/concat/text_len),
// hopp/etikettar og feilvegen (bump-sona full → status feil).
bruk std.native_gap som ng
bruk std.desimaltall_tekst som dt

funksjon jit(ops, ar: heiltall, nk: tekst, rk: tekst) {
    returner builtin.jit_operation({"abi": "norscode-jit-v1", "operation": "compile", "operations": ops,
                                    "arity": ar, "numeric_kind": nk, "result_kind": rk})
}

funksjon køyr(h, args) {
    returner builtin.jit_operation({"abi": "norscode-jit-v1", "operation": "run", "handle": h, "arguments": args})["value"]
}

funksjon start() -> heiltall {
    la add = jit(["arg:0", "arg:1", "add", "const:-3", "mul", "return"], 2, "int", "int")
    skriv("backend=" + tekst(add["backend"]) + " int=" + tekst(køyr(add["handle"], [4, 5])) + "\n")
    la maks = jit(["arg:0", "arg:1", "gt", "jump_if_false:b", "arg:0", "return", "label:b", "arg:1", "return"], 2, "int", "int")
    skriv("maks=" + tekst(køyr(maks["handle"], [7, 3])) + "," + tekst(køyr(maks["handle"], [-2, 9])) + "\n")
    la f = jit(["arg:0", "const:0.5", "mul", "arg:1", "div", "neg", "return"], 2, "float", "float")
    skriv("float=" + tekst(køyr(f["handle"], [3.0, 2.0])) + "\n")
    la lt = jit(["arg:0", "arg:1", "le", "return"], 2, "float", "bool")
    skriv("le=" + tekst(køyr(lt["handle"], [1.5, 1.5])) + "," + tekst(køyr(lt["handle"], [2.5, 1.5])) + "\n")
    la eq = jit(["arg:0", "arg:1", "ne", "return"], 2, "text", "bool")
    skriv("ne=" + tekst(køyr(eq["handle"], ["nors", "nors"])) + "," + tekst(køyr(eq["handle"], ["a", "ab"])) + "\n")
    la cat = jit(["arg:0", "arg:1", "concat", "arg:0", "concat", "return"], 2, "text", "text")
    skriv("concat=" + tekst(køyr(cat["handle"], ["Nors", "code"])) + "\n")
    la len = jit(["arg:0", "arg:1", "concat", "text_len", "return"], 2, "text", "int")
    skriv("len=" + tekst(køyr(len["handle"], ["abc", "de"])) + "\n")
    la big = "x"
    la i: heiltall = 0
    mens i < 20 { big = big + big i = i + 1 }
    la full = builtin.jit_operation({"abi": "norscode-jit-v1", "operation": "run", "handle": cat["handle"], "arguments": [big, big]})
    skriv("full=" + tekst(full["status"]) + "\n")
    returner 0
}
