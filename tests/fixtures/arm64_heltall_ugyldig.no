// arm64: heltall_fra_tekst i AOT-kode tolkar eit strtol-prefiks som x86-AOT ("12x" → 12,
// " 12"/""/"-" → 0). Før vart kvart teikn rekna som siffer ("12x" → 192). VM-en kastar her.
funksjon prøv_tal(t: tekst) -> heiltall {
    prøv {
        skriv("[" + tekst(heltall_fra_tekst(t)) + "]\n")
    } fang (e) {
        skriv("kast: " + tekst(e) + "\n")
    }
    returner 0
}
funksjon start() -> heiltall {
    prøv_tal("123")
    prøv_tal("-45")
    prøv_tal("0")
    prøv_tal("")
    prøv_tal(" 12")
    prøv_tal("12x")
    prøv_tal("-")
    prøv_tal("9223372036854775807")
    returner 0
}
