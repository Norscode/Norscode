// Sjølvsjekkande vakt: feil(melding) kastar fangbart unntak (frosen RT_FEIL krasja)
funksjon start() -> heiltall {
    la fanga = ""
    prøv { feil("Parserfeil 1:2 - test") } fang (e) { fanga = tekst(e) }
    skriv("fanga=[" + fanga + "]\n")
    hvis fanga != "Parserfeil 1:2 - test" { kast "feil melding: " + fanga }
    la f2 = ""
    prøv { feil("n=" + 7) } fang (e) { f2 = tekst(e) }
    hvis f2 != "n=7" { kast "feil2: " + f2 }
    skriv("gc_feil_probe OK\n")
    returner 0
}
