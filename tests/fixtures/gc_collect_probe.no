// GC gc_collect (ende-til-ende referanse): mark+sweep samla. Region med live liste
// (box→payload→int) og eit DØDT hol imellom. gc_collect: DFS-mark frå rot (registrer
// (addr,size) i live-map), sweep gap-walk → gc_free døde hol. Verifiser: dødt hol
// frigjort + gc_alloc gjenbrukar, live-verdiar urørte. (Live-map er adresse-ordna
// her; generell usortert live-map treng eit sort-steg — refinement.)
funksjon start() -> heiltall {
    la region = builtin.heap_bump() + 32768
    la rend = region + 112
    // liste-box @ region+0: [3][payload=region+64]
    builtin.raw_store64(region, 3)
    builtin.raw_store64(region + 8, region + 64)
    // DØt hol [region+16, region+64): 48B garbage
    builtin.raw_store64(region + 16, 1)
    builtin.raw_store64(region + 24, 999)
    // payload @ region+64: [len=1][cap=1][elem0=region+96]
    builtin.raw_store64(region + 64, 1)
    builtin.raw_store64(region + 72, 1)
    builtin.raw_store64(region + 80, region + 96)
    // live int @ region+96: [1][777]
    builtin.raw_store64(region + 96, 1)
    builtin.raw_store64(region + 104, 777)
    // --- gc_collect(region) ---
    la lm = 271843328                          // live-map scratch 0x10340000
    la lm_n: heiltall = 0
    la mstack = 271581184                      // mark-stakk 0x10300000
    la msp = mstack
    builtin.raw_store64(msp, region)
    msp = msp + 8
    mens msp > mstack {
        msp = msp - 8
        la addr = builtin.raw_load64(msp)
        hvis addr >= region og addr < rend {
            hvis builtin.gc_mark_bit(addr) == 0 {
                builtin.raw_store64(lm + lm_n * 16, addr)        // record box
                builtin.raw_store64(lm + lm_n * 16 + 8, 16)
                lm_n = lm_n + 1
                hvis builtin.raw_load64(addr) == 3 {
                    la payload = builtin.raw_load64(addr + 8)
                    la len = builtin.raw_load64(payload)
                    builtin.raw_store64(lm + lm_n * 16, payload)  // record payload
                    builtin.raw_store64(lm + lm_n * 16 + 8, 16 + len * 8)
                    lm_n = lm_n + 1
                    la i: heiltall = 0
                    mens i < len {
                        builtin.raw_store64(msp, builtin.raw_load64(payload + 16 + i * 8))
                        msp = msp + 8
                        i = i + 1
                    }
                }
            }
        }
    }
    // SWEEP: gap-walk (live-map adresse-ordna her).
    la prev_end = region
    la freed: heiltall = 0
    la j: heiltall = 0
    mens j < lm_n {
        la a = builtin.raw_load64(lm + j * 16)
        hvis a > prev_end og (a - prev_end) >= 16 {
            builtin.gc_free(prev_end, a - prev_end)
            freed = freed + 1
        }
        la e = a + builtin.raw_load64(lm + j * 16 + 8)
        hvis e > prev_end { prev_end = e }
        j = j + 1
    }
    // Verifiser: dødt hol [region+16,+64) frigjort; gc_alloc(32) gjenbrukar; live urørt.
    la alloc = builtin.gc_alloc(32)
    la live_val = builtin.raw_load64(region + 104)
    hvis freed == 1 og alloc == region + 16 og live_val == 777 {
        skriv("gc_collect OK: dødt hol frigjort+gjenbrukt, live-verdi 777 urørt (mark+sweep samla)\n")
        returner 0
    }
    skriv("gc_collect FEIL: freed=" + tekst(freed) + " live_val=" + tekst(live_val) + "\n")
    returner 1
}
