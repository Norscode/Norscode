# W4: vertskall som backenden skal avvise ved kompilering (tests/test_wasm_w4.no). Kvar
# linje i start() har éin feil; rapporten skal ha alle, og ingen app.wasm blir skriven.
bruk std.wasm_vert som vert

funksjon med_param(x: heltall) -> heltall {
    returner x
}

funksjon ok() -> heltall {
    returner 0
}

funksjon start() -> heltall {
    la h = vert.finn("#x")
    la namn = "title"
    vert.sett_attr(h, "onclick", "alert(1)")
    vert.sett_attr(h, "href", "javascript:alert(1)")
    vert.sett_attr(h, "data-nc-klikk", "ok")
    vert.sett_attr(h, "style", "color:red")
    vert.sett_attr(h, namn, "x")
    vert.lag("script")
    vert.lytt(h, "hover", "ok")
    vert.deleger("klikk", "finst_ikkje")
    vert.lytt(h, "klikk", "med_param")
    vert.etter("100", "ok")
    vert.test_skriv(h, "x")
    returner 0
}
