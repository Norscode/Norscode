// kortslutta `eller` over kontrollflyt-merge (som dekrypter_post length-sjekk).
funksjon start() -> heiltall {
    la a = 28  la b = 23
    la r = 0
    hvis a != 28 eller b < 16 { r = 100 } ellers { r = 7 }
    la s = 0
    hvis a == 28 eller b < 16 { s = 5 } ellers { s = 200 }
    returner r + s   // 7 + 5 = 12
}
