funksjon start() -> heiltall {
    la før = builtin.native_heap_bytes()
    la verdiar = []
    la i: heiltall = 0
    mens i < 100 {
        legg_til(verdiar, i)
        i = i + 1
    }
    la etter = builtin.native_heap_bytes()
    hvis etter < før {
        skriv("NATIVE_HEAP_BYTES_INVALID\n")
        returner 1
    }
    skriv("NATIVE_HEAP_BYTES_OK " + tekst_fra_heltall(før) + " " + tekst_fra_heltall(etter) + "\n")
    returner 0
}
