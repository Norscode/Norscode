# W8, negativ kontroll (tests/test_wasm_w8_serve.no): ei kjelde for service workeren
# (NC_WASM_SW_KJELDE) som brukar DOM-en, som ikkje finst i ein service worker. tools/nc_wasm.no
# skal avvise henne.
bruk std.wasm_vert som vert
bruk std.wasm_sw som sw

funksjon start() -> heltall {
    vert.sett_tekst(vert.finn("#x"), "hei")
    returner sw.start()
}
