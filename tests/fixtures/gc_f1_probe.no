// GC F1-probe: store→load round-trip via råminne-primitiva. Skriv eit kjent ord
// til ein trygg fri heap-adresse (bump+4096, godt over hot alloc-regionen) og les
// det tilbake. Verifiserer raw_store64/raw_load64 + heap_bump. Exit 0 = F1 verkar.
funksjon start() -> heiltall {
    la addr = builtin.heap_bump() + 4096
    builtin.raw_store64(addr, 123456789)
    la got = builtin.raw_load64(addr)
    skriv("F1 store/load: skreiv 123456789, las " + tekst(got) + "\n")
    hvis got == 123456789 {
        skriv("F1 OK: raw_store64/raw_load64/heap_bump verkar\n")
        returner 0
    }
    skriv("F1 FEIL: round-trip mismatch\n")
    returner 1
}
