// AOT-fikstur (relay X5, os-x86-io): TCP-ekko over loopback i ÉIN linux-x86_64-ELF.
// Tenar og klient i same prosess: listen på 127.0.0.1:0 → getsockname gjev porten →
// klienten koplar til (backlog tek imot) → accept → poll(POLLIN) → recv/send begge vegar.
// Dekkjer socket_new/setsockopt/bind/listen/getsockname/connect/accept/poll/send/recv/close
// og feilkontrakten (bind på oppteken port → −errno; socket_new med ugyldig familie kastar;
// recv etter at peer har lukka → "" (EOF)). Exit 42 = alt OK; 2..20 = steg som feila.
bruk std.native_gap

funksjon feil(kode: heiltall, m: tekst) -> heiltall {
    skriv("aot_x86_socket_ekko FEIL " + tekst_fra_heltall(kode) + ": " + m + "\n")
    returner kode
}

funksjon start() -> heiltall {
    la srv = socket_new(2, 1)
    hvis srv < 0 { returner feil(2, "socket_new") }
    hvis socket_setsockopt(srv, 1, 2, 1) != 0 { returner feil(3, "setsockopt SO_REUSEADDR") }
    hvis socket_bind(srv, "127.0.0.1", 0) != 0 { returner feil(4, "bind") }
    hvis socket_listen(srv, 4) != 0 { returner feil(5, "listen") }
    la port = socket_getsockname(srv)
    hvis port <= 0 eller port > 65535 { returner feil(6, "getsockname port=" + tekst_fra_heltall(port)) }

    // Ingen ventande tilkopling enno: poll med 0 ms gjev 0.
    la p0 = socket_poll([srv], 1, 0)
    hvis lengde(p0) != 1 eller p0[0] != 0 { returner feil(7, "poll før connect") }

    la kli = socket_new(2, 1)
    la rc = socket_connect(kli, "127.0.0.1", port)
    hvis rc != 0 { returner feil(8, "connect rc=" + tekst_fra_heltall(rc)) }
    la p1 = socket_poll([srv], 1, 2000)
    hvis (p1[0] & 1) == 0 { returner feil(9, "poll ser ikkje tilkoplinga") }
    la c = socket_accept(srv)
    hvis c < 0 { returner feil(10, "accept") }

    // Binære byte (0, 200, 255) og norsk tekst skal kome byte-eksakt fram.
    la melding = "hei æøå " + builtin.chr(0) + builtin.chr(200) + builtin.chr(255) + " slutt"
    hvis socket_send(kli, melding) != lengde(melding) { returner feil(11, "send klient") }
    la p2 = socket_poll([c, kli], 1, 2000)
    hvis (p2[0] & 1) == 0 { returner feil(12, "poll ser ikkje data på tenarsida") }
    la mot = socket_recv(c, 4096)
    hvis mot != melding { returner feil(13, "tenar fekk " + tekst_fra_heltall(lengde(mot)) + " byte") }
    hvis socket_send(c, mot) != lengde(mot) { returner feil(14, "send tenar") }
    la svar = socket_recv(kli, 4096)
    hvis svar != melding { returner feil(15, "klient fekk anna svar") }

    // Feilkontrakt: bind på ein oppteken port gjev −errno (EADDRINUSE = −98).
    la s2 = socket_new(2, 1)
    la rb = socket_bind(s2, "127.0.0.1", port)
    hvis rb >= 0 { returner feil(16, "bind på oppteken port lukkast") }
    socket_close(s2)
    la kasta = usann
    prøv { socket_new(999, 1) } fang (e) { kasta = sann }
    hvis ikkje kasta { returner feil(17, "socket_new(999) kasta ikkje") }

    // EOF: klienten lukkar → tenaren les "".
    socket_close(kli)
    la eof = socket_recv(c, 4096)
    hvis eof != "" { returner feil(18, "venta EOF") }
    socket_close(c)
    socket_close(srv)
    skriv("aot_x86_socket_ekko OK port=" + tekst_fra_heltall(port) + " bind_oppteken=" + tekst_fra_heltall(rb) + "\n")
    returner 42
}
