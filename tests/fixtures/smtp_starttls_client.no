bruk std.smtplib som smtp

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_SMTP_E2E_PORT"))
    la mode = miljo_hent("NORSCODE_SMTP_E2E_MODE")
    hvis mode == "" { mode = "starttls" }
    la attachment = "build/smtp-e2e-attachment.bin"
    builtin.fil_skriv_binær(attachment, builtin.bytes_from_list([0, 255, 17, 65]))
    la msg = smtp.ny_melding("Norscode SMTP", ".dot-stuffed", "sender@example.test", ["receiver@example.test"])
    smtp.set_html(msg, "<p>HTML</p>")
    smtp.legg_til_vedlegg(msg, attachment)
    la srv = hvis mode == "implicit" da smtp.ny_server_ssl("localhost", port) ellers smtp.ny_server_tls("localhost", port)
    smtp.sett_ca_fil(srv, "tests/fixtures/tls/localhost.crt")
    hvis mode == "retry" { assert(smtp.sett_retry(srv, 2, 0)) }
    la result = smtp.send_resultat(srv, msg, "user", "password")
    assert(result["status"] == "sent")
    assert(result["category"] == "ok")
    assert(result["provider_id"] == "provider-123")
    hvis mode == "retry" { assert(result["attempts"] == "2") }
    ellers { assert(result["attempts"] == "1") }
    skriv("smtp_" + mode + "_client OK\n")
    returner 0
}
