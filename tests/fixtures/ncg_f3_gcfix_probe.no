// F3.8-probe (2026-09-25): fail-closed innskriving av GC-kallstadene i native_codegen_v2.
// Cache-fallbackane (int-boks, str_raw-payload/-boks, join-råobjekt/-boks) emitterer GC-greina
// direkte i GC-modus og legg framover-referansane i gc_fix; gc_fix_løys skriv inn adressene
// til gc_alloc16/gc_alloc_var/gc_alloc_str_r11_rbx. Proben krev at
//   * alle fem stadene blir skrivne rett (abs64 LE og rel32 relativt til neste instruksjon),
//   * ein MANGLANDE stad (ein rå bump-allokator i GC-modus) blir AVVIST med kast,
//   * ein stad som alt er skriven (dobbel innskriving) blir AVVIST,
//   * flagg AV (gc=0) ikkje rører bytane.
// Erstattar ncg_f0_patchtal_probe.no (patch-passa er sletta).
// Tung å kompilere (importerer heile kodegeneratoren).
// Exit: 0 = OK · 1 = feil.
bruk selfhost.native_execution.native_codegen_v2 som ncg

funksjon nullar(n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < n { legg_til(ut, 0) i = i + 1 }
    returner ut
}

funksjon atom() -> ordbok {
    la a: ordbok = {}
    a["gc_alloc16"] = 4198400 + 4096          // 0x402000
    a["gc_alloc_var"] = 4198400 + 8192        // 0x403000
    a["gc_alloc_str_r11_rbx"] = 4198400 + 64  // 0x401040
    returner a
}

funksjon fix(gc: heiltall, utan: tekst) -> ordbok {
    la f: ordbok = {}
    f["gc"] = gc
    la namn = ["int_boks", "str_payload", "str_boks", "join_raw", "join_boks"]
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis namn[i] != utan { f[namn[i]] = 16 + i * 16 }
        i = i + 1
    }
    returner f
}

funksjon avvist(b: liste_heiltall, f: ordbok) -> boolsk {
    prøv {
        ncg.gc_fix_løys(b, f, atom())
    } fang (e) {
        returner sann
    }
    returner usann
}

funksjon u64_på(b: liste_heiltall, pos: heiltall) -> heiltall {
    la v: heiltall = 0
    la j: heiltall = 7
    mens j >= 0 { v = v * 256 + b[pos + j] j = j - 1 }
    returner v
}

funksjon start() -> heiltall {
    la feil: heiltall = 0
    // Rett: alle fem stader.
    la b = nullar(128)
    la n = ncg.gc_fix_løys(b, fix(1, ""), atom())
    hvis n != 5 { skriv("F3.8 FEIL: venta 5 stader, fekk " + tekst(n) + "\n") feil = feil + 1 }
    hvis u64_på(b, 16) != 4202496 { skriv("F3.8 FEIL: int_boks peikar ikkje på gc_alloc16\n") feil = feil + 1 }
    hvis u64_på(b, 32) != 4206592 { skriv("F3.8 FEIL: str_payload peikar ikkje på gc_alloc_var\n") feil = feil + 1 }
    hvis u64_på(b, 48) != 4202496 { skriv("F3.8 FEIL: str_boks peikar ikkje på gc_alloc16\n") feil = feil + 1 }
    hvis u64_på(b, 80) != 4202496 { skriv("F3.8 FEIL: join_boks peikar ikkje på gc_alloc16\n") feil = feil + 1 }
    // join_raw: rel32 @64 → mål 0x40 (TEXT_VA-relativ) frå neste instruksjon (64+4) = -4 = 0xFFFFFFFC.
    hvis b[64] != 252 eller b[65] != 255 eller b[66] != 255 eller b[67] != 255 {
        skriv("F3.8 FEIL: join_raw rel32 feil\n") feil = feil + 1
    }
    // Nei: manglande stad og dobbel innskriving.
    hvis ikkje avvist(nullar(128), fix(1, "join_boks")) { skriv("F3.8 FEIL: manglande join_boks vart godteken\n") feil = feil + 1 }
    hvis ikkje avvist(nullar(128), fix(1, "str_payload")) { skriv("F3.8 FEIL: manglande str_payload vart godteken\n") feil = feil + 1 }
    hvis ikkje avvist(b, fix(1, "")) { skriv("F3.8 FEIL: dobbel innskriving vart godteken\n") feil = feil + 1 }
    // Flagg AV: ingen endring.
    la c = nullar(128)
    ncg.gc_fix_løys(c, fix(0, ""), atom())
    hvis u64_på(c, 16) != 0 { skriv("F3.8 FEIL: gc=0 skreiv bytar\n") feil = feil + 1 }
    hvis feil != 0 { returner 1 }
    skriv("F3.8 OK: gc_fix_løys skriv 5 stader rett; manglande stad og dobbel innskriving avviste; gc=0 urørt\n")
    returner 0
}
