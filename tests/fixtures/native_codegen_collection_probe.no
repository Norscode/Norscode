funksjon probe_har(kart, nokkel) -> boolsk {
    returner har_nokkel(kart, nokkel)
}

funksjon probe_registrer(tabell, namn) {
    tabell["funksjonar"][namn] = []
}

funksjon start() -> heiltall {
    skriv("COLLECTION_PROBE_BOOT\n")
    la verdiar = []
    legg_til(verdiar, "ok")
    skriv("COLLECTION_PROBE_LIST=" + tekst(verdiar[0]) + "\n")
    la kart = {}
    kart["status"] = "ok"
    skriv("COLLECTION_PROBE_MAP=" + tekst(kart["status"]) + "\n")
    la ytre = {"indre": {}}
    ytre["indre"]["status"] = "ok"
    skriv("COLLECTION_PROBE_NESTED=" + tekst(ytre["indre"]["status"]) + "\n")
    hvis har_nokkel(ytre["indre"], "status") { skriv("COLLECTION_PROBE_HAS=ok\n") }
    hvis har_nokkel(ytre["indre"], "manglar") { returner 8 }
    la tomt_kart = {}
    hvis har_nokkel(tomt_kart, "manglar") { returner 9 }
    hvis probe_har(tomt_kart, "manglar") { returner 10 }
    la tabell = {"funksjonar": {}}
    probe_registrer(tabell, "start")
    hvis ikkje probe_har(tabell["funksjonar"], "start") { returner 11 }
    hvis probe_har(tabell["funksjonar"], "skriv") { returner 12 }
    skriv("COLLECTION_PROBE_EMPTY_HAS=ok\n")
    skriv("COLLECTION_PROBE_OK\n")
    returner 0
}
