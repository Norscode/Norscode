# Fikstur for tests/test_r4_unntak_ressurs.no (R4 / F33): prøv med r = opne() { … }.

struktur Res {
    namn
    kast_lukk
    logg
}

funksjon ny_res(namn: tekst, kast_lukk: boolsk, logg) -> Res {
    la r = Res()
    r.namn = namn
    r.kast_lukk = kast_lukk
    r.logg = logg
    legg_til(logg, "opne " + namn)
    returner r
}

funksjon opne_feil(logg) -> Res {
    legg_til(logg, "opne-feil")
    kast "OpneFeil: kunne ikkje opne"
}

funksjon Res.lukk(self) {
    legg_til(self.logg, "lukk " + self.namn)
    hvis self.kast_lukk { kast "LukkFeil: " + self.namn }
}

# Ingen feil: lukk i omvendt rekkjefølgje etter kroppen.
funksjon normal(logg) -> tekst {
    prøv med a = ny_res("a", usann, logg), b = ny_res("b", usann, logg), c = ny_res("c", usann, logg) {
        legg_til(logg, "kropp")
    }
    returner "ok"
}

# Feil i kroppen: lukk køyrer, det rå unntaket kjem ut uendra (tekst).
funksjon kropp_feil(logg) -> tekst {
    prøv med a = ny_res("a", usann, logg), b = ny_res("b", usann, logg) {
        kast "KroppFeil: x"
    } fang (e) {
        returner "fanga:" + e
    }
    returner "ikkje"
}

# Feil i kropp OG i to lukk: lukk-unntaka blir undertrykte (b lukkast fyrst).
funksjon begge(logg) -> tekst {
    prøv med a = ny_res("a", sann, logg), b = ny_res("b", sann, logg) {
        kast "KroppFeil: x"
    } fang (e) {
        returner e.melding + " u=" + tekst(lengde(e.undertrykte)) + " [" + e.undertrykte[0] + "][" + e.undertrykte[1] + "] type=" + typenamn(e) + " fang-type=" + tekst(er_instans(e, Unntak))
    }
    returner "ikkje"
}

# Berre lukk kastar: det går vidare som hovudunntak.
funksjon berre_lukk(logg) -> tekst {
    prøv med a = ny_res("a", sann, logg) {
        legg_til(logg, "kropp")
    } fang (e) {
        returner "fanga:" + e
    }
    returner "ikkje"
}

# To ressursar, berre den indre lukkinga kastar: ytre lukkar likevel, og lukk-
# unntaket er hovudunntaket (kroppen var ok).
funksjon indre_lukk(logg) -> tekst {
    prøv med a = ny_res("a", usann, logg), b = ny_res("b", sann, logg) {
        legg_til(logg, "kropp")
    } fang (e) {
        returner "fanga:" + e
    }
    returner "ikkje"
}

# Kropp ok, indre lukk kastar OG ytre lukk kastar: ytre lukk-unntak blir
# undertrykt på det indre.
funksjon lukk_lukk(logg) -> tekst {
    prøv med a = ny_res("a", sann, logg), b = ny_res("b", sann, logg) {
        legg_til(logg, "kropp")
    } fang (e) {
        returner e.melding + " u=" + tekst(lengde(e.undertrykte)) + " [" + e.undertrykte[0] + "]"
    }
    returner "ikkje"
}

# Opning av ressurs nr. 2 feilar: ressurs nr. 1 blir lukka.
funksjon opne_feilar(logg) -> tekst {
    prøv med a = ny_res("a", usann, logg), b = opne_feil(logg) {
        legg_til(logg, "kropp")
    } fang (e) {
        returner "fanga:" + e
    }
    returner "ikkje"
}

# return/bryt/fortsett ut av kroppen lukkar ressursen.
funksjon ut_av(logg) -> heiltall {
    for i i [0, 1, 2, 3] {
        prøv med a = ny_res("l" + tekst(i), usann, logg) {
            hvis i == 1 { fortsett }
            hvis i == 2 { bryt }
        }
    }
    prøv med r1 = ny_res("r1", usann, logg), r2 = ny_res("r2", usann, logg) {
        returner 42
    }
    returner 0
}

# return frå kroppen medan lukk kastar: lukk-unntaket vinn over return.
funksjon return_lukk(logg) -> tekst {
    prøv {
        prøv med a = ny_res("a", sann, logg) {
            returner "returnert"
        }
    } fang (e) {
        returner "lukk-vann:" + e
    }
    returner "ikkje"
}

# null-ressurs: ingen lukk (som Java), kroppen køyrer.
funksjon null_ressurs(logg) -> tekst {
    prøv med a = null {
        legg_til(logg, "kropp")
    }
    returner "null-ok"
}

# med endeleg, i tillegg til ressurslukking; og utan fang/endeleg.
funksjon med_endeleg(logg) -> tekst {
    prøv med a = ny_res("a", usann, logg) {
        legg_til(logg, "kropp")
    } endeleg {
        legg_til(logg, "endeleg")
    }
    returner "ok"
}

# Stakksporet til hovudunntaket overlever undertrykking.
funksjon stakk_bevart(logg) -> tekst {
    prøv med a = ny_res("a", sann, logg) {
        kast "KroppFeil: x"
    } fang (e) {
        returner e.stakk[0]["funksjon"] + ":" + tekst(e.stakk[0]["linje"]) + " u=" + tekst(lengde(e.undertrykte))
    }
    returner "ikkje"
}

funksjon start() -> tekst {
    la d = []
    la l1 = []
    la l2 = []
    la l3 = []
    la l4 = []
    la l5 = []
    la l6 = []
    la l7 = []
    la l8 = []
    la l9 = []
    la l10 = []
    la l11 = []
    la l12 = []
    legg_til(d, normal(l1) + ":" + builtin.join(l1, ","))
    legg_til(d, kropp_feil(l2) + ":" + builtin.join(l2, ","))
    legg_til(d, begge(l3) + ":" + builtin.join(l3, ","))
    legg_til(d, berre_lukk(l4) + ":" + builtin.join(l4, ","))
    legg_til(d, indre_lukk(l5) + ":" + builtin.join(l5, ","))
    legg_til(d, lukk_lukk(l6) + ":" + builtin.join(l6, ","))
    legg_til(d, opne_feilar(l7) + ":" + builtin.join(l7, ","))
    legg_til(d, tekst(ut_av(l8)) + ":" + builtin.join(l8, ","))
    legg_til(d, return_lukk(l9) + ":" + builtin.join(l9, ","))
    legg_til(d, null_ressurs(l10) + ":" + builtin.join(l10, ","))
    legg_til(d, med_endeleg(l11) + ":" + builtin.join(l11, ","))
    legg_til(d, stakk_bevart(l12))
    returner builtin.join(d, "|")
}
