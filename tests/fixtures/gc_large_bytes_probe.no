// Exercise real emitted GC code with live bytes/list payloads beyond 16 MiB.
// The independent SHA-256 oracle is for 25,165,825 ASCII 'A' bytes.
funksjon lag_fil(sti: tekst) {
    la blokk: tekst = "A"
    la i: heiltall = 0
    mens i < 24 { blokk = blokk + blokk i = i + 1 }
    builtin.fil_skriv(sti, blokk)
    builtin.fil_append(sti, builtin.slice(blokk, 0, 8388608))
    builtin.fil_append(sti, "A")
}

funksjon krev_data(data) {
    assert_eq(lengde(data), 25165825)
    assert_eq(data[0], 65)
    assert_eq(data[16777216], 65)
    assert_eq(data[25165824], 65)
    // This is the real SHA-256 atom, so a null fallback cannot satisfy the oracle.
    assert_eq(builtin.sha256_bytes_hex(data),
        "eea6bf9db762588fb676f68870c3ca8ae4c93a535504a537e08d669d0b39abaa")
}

funksjon støy(data) {
    la tmp = builtin.bytes_to_list(data)
    tmp[0] = 17
    tmp[25165824] = 93
    assert_eq(tmp[0], 17)
    assert_eq(tmp[25165824], 93)
}

funksjon levande_røter(sti: tekst) {
    la stor = builtin.fil_les_binær(sti)
    la kopi = builtin.bytes_to_list(stor)
    assert_eq(type_av(stor), "bytes")
    assert_eq(type_av(kopi), "liste")
    krev_data(stor)
    krev_data(kopi)
    la i: heiltall = 0
    mens i < 3 {
        builtin.gc_collect_native()
        støy(stor)
        krev_data(stor)
        krev_data(kopi)
        i = i + 1
    }
    skriv("gc_large_bytes roots OK: 25165825 bytes, 3 collections\n")
}

funksjon flat_lesing(sti: tekst) {
    la data = builtin.fil_les_binær(sti)
    la i: heiltall = 0
    mens i < 12 {
        // The previous result stays live while the RHS allocates its successor.
        // Reading a known-size file must not spend half the heap on abandoned
        // geometric buffers. Keep the normal 1 GiB native heap limit unchanged.
        data = builtin.fil_les_binær(sti)
        krev_data(data)
        i = i + 1
    }
    skriv("gc_large_bytes flat OK: 25165825 bytes, 12 rereads\n")
}

funksjon start() -> heiltall {
    la sti: tekst = miljo_hent("NC_GC_PROBE_FILE")
    assert(sti != "")
    lag_fil(sti)
    builtin.gc_collect_native()
    hvis miljo_hent("NC_GC_PROBE_MODE") == "roots" { levande_røter(sti) }
    ellers { flat_lesing(sti) }
    returner 0
}
