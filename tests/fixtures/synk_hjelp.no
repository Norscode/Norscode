# Klienthjelparar for testane av NSP/1-tenaren (std/synk.no): hallo, push og pull mot
# ein barne-apptenar (tests/fixtures/synk_app.no) over std.socket.
bruk tests.fixtures.apptenar_hjelp som ah

funksjon start_tenar(data: tekst, ekstra: ordbok_tekst) -> ordbok {
    la m: ordbok_tekst = {"SYNK_DATA": data, "SYNK_MS": "170000"}
    la ks = nøkler(ekstra)
    la i = 0
    mens i < lengde(ks) {
        m[ks[i]] = ekstra[ks[i]]
        i = i + 1
    }
    la app = ah.start_app("tests/fixtures/synk_app.no", data, m)
    hvis app["status"] != "kjorer" {
        skriv("synk-tenaren starta ikkje:\n" + tekst(app["ut"]) + "\n")
        assert(usann)
    }
    returner app
}

funksjon cookie(sesjon: tekst) -> ordbok_tekst {
    hvis sesjon == "" { returner {} }
    returner {"Cookie": "nc_sesjon=" + sesjon}
}

funksjon json_av(r: ordbok) -> ordbok {
    hvis r["body"] == "" { returner {} }
    returner builtin.json_parse_raw(r["body"])
}

# GET /_synk/hallo → {"status", "json"}
funksjon hallo(port: heltall, sesjon: tekst) -> ordbok {
    la r = ah.kall(port, "GET", "/_synk/hallo", cookie(sesjon), "")
    returner {"status": r["status"], "json": json_av(r), "r": r}
}

funksjon op_put(seq: heltall, s: tekst, id: tekst, hlc: tekst, felt_json: tekst) -> tekst {
    returner "{\"seq\":" + tekst(seq) + ",\"op\":\"put\",\"s\":\"" + s + "\",\"id\":\"" + id + "\",\"hlc\":\"" + hlc + "\",\"felt\":" + felt_json + "}"
}

funksjon op_del(seq: heltall, s: tekst, id: tekst, hlc: tekst) -> tekst {
    returner "{\"seq\":" + tekst(seq) + ",\"op\":\"del\",\"s\":\"" + s + "\",\"id\":\"" + id + "\",\"hlc\":\"" + hlc + "\"}"
}

funksjon push_kropp(epoke: tekst, klient: tekst, kvittert: heltall, ops: liste) -> tekst {
    returner "{\"p\":1,\"epoke\":\"" + epoke + "\",\"klient\":\"" + klient + "\",\"kvittert\":" + tekst(kvittert) + ",\"ops\":[" + builtin.join(ops, ",") + "]}"
}

# POST /_synk/push med CSRF-token og JSON. `ekstra` er fleire headerar.
funksjon push_rå(port: heltall, sesjon: tekst, csrf: tekst, kropp: tekst, ekstra: ordbok_tekst) -> ordbok {
    la h = cookie(sesjon)
    h["Content-Type"] = "application/json"
    hvis csrf != "" { h["X-NC-CSRF"] = csrf }
    la ks = nøkler(ekstra)
    la i = 0
    mens i < lengde(ks) {
        h[ks[i]] = ekstra[ks[i]]
        i = i + 1
    }
    la r = ah.kall(port, "POST", "/_synk/push", h, kropp)
    returner {"status": r["status"], "json": json_av(r), "r": r}
}

funksjon push(port: heltall, sesjon: tekst, csrf: tekst, epoke: tekst, klient: tekst, kvittert: heltall, ops: liste) -> ordbok {
    returner push_rå(port, sesjon, csrf, push_kropp(epoke, klient, kvittert, ops), {})
}

funksjon pull(port: heltall, sesjon: tekst, sidan: heltall, ekstra: ordbok_tekst) -> ordbok {
    la h = cookie(sesjon)
    la ks = nøkler(ekstra)
    la i = 0
    mens i < lengde(ks) {
        h[ks[i]] = ekstra[ks[i]]
        i = i + 1
    }
    la r = ah.kall(port, "GET", "/_synk/pull?sidan=" + tekst(sidan), h, "")
    returner {"status": r["status"], "json": json_av(r), "etag": ah.hdr(r, "etag"), "r": r}
}

# Finn endringa for (s, id) i eit pull-svar, eller null.
funksjon endring(p: ordbok, s: tekst, id: tekst) {
    la e = p["json"]["endringar"]
    la i = 0
    mens i < lengde(e) {
        hvis e[i]["s"] == s og e[i]["id"] == id { returner e[i] }
        i = i + 1
    }
    returner null
}

funksjon krev(namn: tekst, r: ordbok, status: heltall) -> heltall {
    hvis r["status"] != status {
        skriv(namn + ": venta " + tekst(status) + ", fekk " + tekst(r["status"]) + " " + tekst(r["r"]["body"]) + "\n")
        assert(usann)
    }
    returner 0
}

funksjon krev_feil(namn: tekst, r: ordbok, status: heltall, feil: tekst) -> heltall {
    krev(namn, r, status)
    hvis ikkje har_nokkel(r["json"], "feil") eller r["json"]["feil"] != feil {
        skriv(namn + ": venta feil=" + feil + ", fekk " + tekst(r["r"]["body"]) + "\n")
        assert(usann)
    }
    returner 0
}

funksjon hlc(ms: heltall, c: heltall, node: tekst) -> tekst {
    la t = tekst(ms)
    mens lengde(t) < 15 { t = "0" + t }
    la ct = tekst(c)
    mens lengde(ct) < 5 { ct = "0" + ct }
    returner t + ":" + ct + ":" + node
}
