// GC bump-ratchet-probe (v7, 2026-09-24) — sjølvsjekkande, GC-modus (NORSCODE_GC_ALLOC=1).
//
// Churn utan anker: kvar iterasjon byggjer ei 2000-elements liste (element-arrayen veks
// via gc_alloc_var) og slepp henne. Levande sett er flatt (~30 KB), so bump skal liggje
// flatt på om lag HEAP_ALLOC_START + port (64 MiB standard, 4 MiB i probe-bygg).
//
// Før v7 samla safepoint-stubben berre når BUMP hadde vakse port sidan siste collect:
// fri-lista vart brukt «gratis» før bump, og collect fyrte rett etter ei bump-allokering
// hvis resultat låg levande ØVST → sweepen kunne aldri senke bump → +port per collect →
// forbi SOFT_LIMIT (~15 collects) → collect ved kvart safepoint (storm, timeout).
//
// Exit: 0 = OK (flat bump, rett sum) · 2 = feil sum (korrupsjon) · 3 = bump over
// HEAP_VA + 256 MiB (ratchet). Proben sjekkar bump kvar 256. iterasjon og avsluttar med 3
// med ein gong taket er passert → raud på sekund med ratchet-runtime, ikkje timeout.
// Iterasjonar: NORSCODE_GC_RATCHET_ITER (standard 200000).
funksjon lag_liste(n: heiltall) -> liste {
    la ut: liste = []
    la j = 0
    mens j < n {
        legg_til(ut, j)
        j = j + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la iter: heiltall = 200000
    la iter_tekst = miljo_hent("NORSCODE_GC_RATCHET_ITER")
    hvis iter_tekst != "" { iter = heltall_fra_tekst(iter_tekst) }
    la tak: heiltall = 7864320 + 268435456          // HEAP_VA (0x780000) + 256 MiB
    la start_bump: heiltall = builtin.heap_bump()
    la maks_bump: heiltall = start_bump
    la i: heiltall = 0
    la sum: heiltall = 0
    mens i < iter {
        la l = lag_liste(2000)
        sum = sum + lengde(l) + l[1999] - 1999
        hvis i % 256 == 0 {
            la b: heiltall = builtin.heap_bump()
            hvis b > maks_bump { maks_bump = b }
            hvis b > tak {
                skriv("gc_ratchet FEIL: bump=" + tekst(b) + " > tak=" + tekst(tak) + " ved iterasjon " + tekst(i) + " (bump-ratchet)\n")
                returner 3
            }
        }
        i = i + 1
    }
    la slutt_bump: heiltall = builtin.heap_bump()
    hvis slutt_bump > maks_bump { maks_bump = slutt_bump }
    skriv("gc_ratchet: iter=" + tekst(iter) + " sum=" + tekst(sum) + " start_bump=" + tekst(start_bump) + " maks_bump=" + tekst(maks_bump) + " slutt_bump=" + tekst(slutt_bump) + "\n")
    hvis sum != 2000 * iter {
        skriv("gc_ratchet FEIL: sum=" + tekst(sum) + " venta " + tekst(2000 * iter) + "\n")
        returner 2
    }
    hvis maks_bump > tak {
        skriv("gc_ratchet FEIL: maks_bump over tak (bump-ratchet)\n")
        returner 3
    }
    skriv("gc_ratchet OK: flat bump (maks " + tekst((maks_bump - 7864320) / 1048576) + " MiB over HEAP_VA)\n")
    returner 0
}
