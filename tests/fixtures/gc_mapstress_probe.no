// gc_mapstress_probe.no — tyngre map-arbeidslast enn reuse2 for å reprodusere
// seed-harness-krasjen (map_set med korrupt vals_ptr etter mange collects). Mange
// levande map som VEKS langt forbi start-cap (grown keys/vals/idx-arrays), nøsta
// map-i-liste-i-map, sletting, mutasjon på tvers av gjentekne collects. Sjekksum
// stabil = ingen korrupsjon. Exit 0 = OK.
funksjon sjekksum(live: liste) -> heiltall {
    la s: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(live) {
        la m = live[i]
        la ks = nøkler(m["stor"])
        la j: heiltall = 0
        mens j < lengde(ks) { s = s + lengde(tekst(m["stor"][ks[j]])) j = j + 1 }
        s = s + lengde(m["barn"])
        i = i + 1
    }
    returner s
}
funksjon lag_map(seed: heiltall) -> ordbok {
    la stor: ordbok = {}
    la k: heiltall = 0
    mens k < 250 { stor["nk" + tekst(k)] = "verdi-" + tekst(seed) + "-" + tekst(k) + "-halepolstring" k = k + 1 }
    la barn: liste = []
    la b: heiltall = 0
    mens b < 40 {
        la indre: ordbok = {}
        la c: heiltall = 0
        mens c < 30 { indre["i" + tekst(c)] = seed + b + c c = c + 1 }
        legg_til(barn, indre)
        b = b + 1
    }
    returner {"stor": stor, "barn": barn, "id": seed}
}
funksjon start() -> heiltall {
    la live: liste = []
    la i: heiltall = 0
    mens i < 300 { legg_til(live, lag_map(i)) i = i + 1 }
    la s0 = sjekksum(live)
    skriv("s0=" + tekst(s0) + " bump=" + tekst(builtin.raw_load64(6291456)) + "\n")
    la r: heiltall = 0
    mens r < 4 {
        // støy: lag og forkast store map for å tvinge collect + attbruk
        la n: heiltall = 0
        mens n < 4000 {
            la tmp: ordbok = {}
            la t: heiltall = 0
            mens t < 40 { tmp["s" + tekst(t)] = "støy" + tekst(n) + "-" + tekst(t) t = t + 1 }
            n = n + 1
        }
        prøv { builtin.gc_collect() } fang (e) { }
        hvis sjekksum(live) != s0 { skriv("FEIL: sjekksum etter collect runde " + tekst(r) + "\n") returner 3 }
        // mutasjon: veks kvar map endå meir, slett nokre, les nøsta
        la j: heiltall = 0
        mens j < 300 {
            live[j]["stor"]["ekstra" + tekst(r)] = "m" + tekst(r) + "-" + tekst(j)
            fjern_nøkkel(live[j]["stor"], "nk5")
            live[j]["stor"]["nk5"] = "verdi-" + tekst(j) + "-5-halepolstring"
            hvis lengde(live[j]["barn"]) != 40 { skriv("FEIL: barn-lengd\n") returner 4 }
            hvis live[j]["barn"][20]["i10"] != j + 20 + 10 { skriv("FEIL: nøsta verdi j=" + tekst(j) + "\n") returner 5 }
            j = j + 1
        }
        // Re-baseline: mutasjonen ovanfor ENDRAR sjekksummen lovleg (+ekstra-nøkkel).
        // Den må vere STABIL gjennom neste runde sin støy + collect (attbruk av hol).
        s0 = sjekksum(live)
        skriv("runde " + tekst(r) + ": bump=" + tekst(builtin.raw_load64(6291456)) + " s=" + tekst(s0) + "\n")
        r = r + 1
    }
    skriv("mapstress OK\n")
    returner 0
}
