// A fit must not remain hidden after the bounded fast pass: 600 holes of
// 8 KiB precede a 15 KiB hole in the SAME [8 KiB,16 KiB) class. A 12,016-byte
// string payload cannot use the first 600. It must find the later hole before
// advancing bump. This fails both the original single list and class-only fix.
funksjon start() -> heiltall {
    builtin.raw_store64(7864336, 536870912)
    builtin.raw_store64(7864352, 0)
    la venstre: tekst = "abcdefgh"
    la i: heiltall = 0
    mens i < 10 { venstre = venstre + venstre i = i + 1 }
    venstre = builtin.slice(venstre, 0, 6000)
    la region: heiltall = builtin.heap_bump() + 1048576
    region = region + 16 - region % 16
    la lm: heiltall = 1124073472
    builtin.raw_store64(lm, 8921184)
    builtin.raw_store64(lm + 8, region - 8921184)
    i = 0
    mens i <= 600 {
        la p: heiltall = region + 15360 + i * 8208
        builtin.raw_store64(lm + 16 + i * 16, p)
        builtin.raw_store64(lm + 24 + i * 16, 16)
        builtin.raw_store64(p, 12345)
        builtin.raw_store64(p + 8, 23456)
        i = i + 1
    }
    builtin.heap_set_bump(region + 15360 + 600 * 8208 + 16)
    builtin.gc_sweep_full(602)
    la før: heiltall = builtin.heap_bump()
    la s: tekst = venstre + venstre
    la p: heiltall = builtin.raw_load64(builtin.obj_addr(s) + 8)
    hvis p != region eller builtin.heap_bump() != før {
        skriv("gc_sameclass FEIL: 12 KiB-førespurnad fann ikkje 15 KiB-holet\n")
        returner 7
    }
    hvis lengde(s) != 12000 eller builtin.slice(s, 11992, 12000) != "abcdefgh" {
        skriv("gc_sameclass FEIL: nyttelast øydelagd\n")
        returner 8
    }
    i = 0
    mens i <= 600 {
        la q: heiltall = region + 15360 + i * 8208
        hvis builtin.raw_load64(q) != 12345 eller builtin.raw_load64(q + 8) != 23456 {
            skriv("gc_sameclass FEIL: levande skiljeblokk øydelagd\n")
            returner 9
        }
        i = i + 1
    }
    skriv("gc_sameclass OK: komplett søk etter 512, ingen bump-vekst\n")
    returner 0
}
