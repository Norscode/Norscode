// A5: ordbok-vekst må vere amortisert O(1). Før kopierte ARM64-AOT heile
// mapdata ved kvar ny nøkkel (O(n²) bump-allokering utan GC) → heapen gjekk
// tom ved ~16k nøklar. No har mapdata eit kapasitetsprefiks og doblar.
funksjon start() -> heiltall {
    la m = {}
    la andre = {}
    la støy = []
    la i = 0
    mens i < 30000 {
        m["k" + tekst(i)] = i
        hvis i % 7 == 0 {
            andre[tekst(i)] = "v" + tekst(i)
            legg_til(støy, i)
        }
        i = i + 1
    }
    m["k5"] = 55
    la sum = 0
    i = 0
    mens i < 30000 {
        sum = sum + m["k" + tekst(i)]
        i = i + 1
    }
    skriv("n=" + tekst(lengde(m)) + " andre=" + tekst(lengde(andre)) + " støy=" + tekst(lengde(støy)) + "\n")
    skriv("sum=" + tekst(sum) + " k5=" + tekst(m["k5"]) + " a7=" + andre["7"] + "\n")
    la kopi = m
    kopi["ny"] = 1
    skriv("ny=" + tekst(m["ny"]) + " n2=" + tekst(lengde(m)) + "\n")
    returner 0
}
