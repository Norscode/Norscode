bruk std.deploy_state som deploy
bruk std.tarfile som tarfile
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon hash_file(sti: tekst) -> tekst {
    la bytes = builtin.fil_les_binær(sti)
    prøv { returner builtin.sha256_bytes(bytes) } fang (e) { returner sha256.hash_bytes(bytes) }
    returner ""
}

funksjon start() -> heiltall {
    la port = heltall_fra_tekst(miljo_hent("NORSCODE_DEPLOY_HEALTH_PORT"))
    la root = "build/deploy-live-health-" + builtin.random_hex(8)
    assert(filops.lag_katalogar(root + "/packages"))
    builtin.fil_skriv(root + "/release.manifest", "release_id=live-v1\n")
    builtin.fil_skriv(root + "/app.no", "funksjon start() -> heiltall { returner 0 }\n")
    la archive = root + "/packages/live-v1.tar"
    la ark = tarfile.open(archive, "w")
    assert(tarfile.add(ark, root + "/release.manifest", "release.manifest"))
    assert(tarfile.add(ark, root + "/app.no", "app.no"))
    tarfile.close(ark)
    la cfg = deploy.ny(root, "", "http://127.0.0.1:" + tekst_fra_heltall(port) + "/health")
    cfg["health_attempts"] = 1
    cfg["health_timeout_ms"] = 5000
    la result = deploy.deploy(cfg, "packages/live-v1.tar", hash_file(archive), "live-v1")
    assert(result["status"] == "deployed")
    assert(result["state"] == "completed")
    assert(builtin.trim(builtin.fil_les(root + "/deploy/current.release")) == "live-v1")
    assert(filops.slett_tre(root))
    skriv("deploy_live_health_client OK\n")
    returner 0
}
