// A2 differensial-lane: namneoppslag (builtin.dns_lookup, «norscode-dns-v1»). Numerisk
// IPv4, localhost (127.0.0.1 skal vere med; ::1 kan kome i tillegg frå C-æra-verten),
// vertsnamnet frå /etc/hostname (står i /etc/hosts i containerar og på runnarar), eit
// namn som ikkje finst i hosts-fila og tom vert.
bruk std.native_gap

funksjon har(r, adr: tekst) -> boolsk {
    hvis builtin.type(r["addresses"]) != "liste" { returner usann }
    for a i r["addresses"] { hvis tekst(a) == adr { returner sann } }
    returner usann
}

funksjon start() -> heiltall {
    la ip = builtin.dns_lookup("10.1.2.3", "80")
    skriv("ipv4 status=" + tekst(ip["status"]) + " har=" + tekst(har(ip, "10.1.2.3")) + "\n")
    la lh = builtin.dns_lookup("localhost", "443")
    skriv("localhost status=" + tekst(lh["status"]) + " har_127=" + tekst(har(lh, "127.0.0.1")) + "\n")
    la vert = ""
    prøv { vert = builtin.trim(builtin.fil_les("/etc/hostname")) } fang (e) { vert = "" }
    hvis vert != "" {
        la r = builtin.dns_lookup(vert, "80")
        la n = 0
        hvis builtin.type(r["addresses"]) == "liste" { n = lengde(r["addresses"]) }
        skriv("vert status=" + tekst(r["status"]) + " fann_adresse=" + tekst(n > 0) + "\n")
    }
    la tom = builtin.dns_lookup("", "80")
    skriv("tom status=" + tekst(tom["status"]) + "\n")
    returner 45
}
