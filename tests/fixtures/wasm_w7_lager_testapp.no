# Testapp for W7 (lokal lagring i IndexedDB i WASM-klienten): sida /test med <pre id="nc-logg">
# og <output id="nc-resultat">, og /api/puls, som testklienten
# (tests/fixtures/wasm_w7_lager_testklient.no) hentar om att og om att medan han ventar på
# IndexedDB.
#
# Kvifor puls: headless Chrome med --virtual-time-budget dumpar DOM-en når den virtuelle
# tida er brukt opp, og ho står berre stille medan ein førespurnad går på nettverket.
# IndexedDB-svar kjem utanfor det, så utan ein førespurnad i gang blir sida dumpa før
# IndexedDB har svara [V: 0 av 3 lastingar kom forbi opninga; med puls kom alle]. Pulsen
# er berre i testklienten, ikkje i std/wasm_lager.no.
bruk std.web som web
bruk std.wasm_serve som ws

funksjon test_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /test")
    returner ws.side("<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>W7 lager</title>" +
        ws.script_tag() + "</head><body><output id=\"nc-resultat\">–</output><pre id=\"nc-logg\"></pre></body></html>")
}

funksjon api_puls(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/puls")
    returner ws.svar("text/plain; charset=utf-8", "p", ws.csp_standard(), "no-store")
}

funksjon start() -> heltall {
    returner 0
}
