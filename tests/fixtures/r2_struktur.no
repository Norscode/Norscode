# Fikstur for tests/test_r2_struktur.no (F20): éin strukturrepresentasjon med
# eksakt metodeoppslag, skjult typemerke og fangbar MetodeFeil.
bruk tests.fixtures.r2_konto_a som a
bruk tests.fixtures.r2_konto_b som b

grensesnitt Form {
    funksjon areal(self) -> heltall
    funksjon namn(self) -> tekst
}
struktur Kvadrat implementerer Form {
    s: heltall
}
struktur Rektangel implementerer Form {
    b: heltall
    h: heltall
}
funksjon Kvadrat.areal(self) -> heltall { returner self.s * self.s }
funksjon Kvadrat.namn(self) -> tekst { returner "kvadrat" }
funksjon Rektangel.areal(self) -> heltall { returner self.b * self.h }
funksjon Rektangel.namn(self) -> tekst { returner "rektangel" }

struktur Punkt {
    x: heltall
    y: heltall
}
funksjon Punkt.flytt(self, dx: heltall) -> heltall {
    self.x = self.x + dx
    returner self.x
}
struktur Kalk {
    op
}
struktur Bil {
    fart
}
struktur MinFeil {
    melding
}

# Fri funksjon med same namn som ein metode: skal IKKJE nåast via p.dobbel().
funksjon dobbel(v) -> heltall {
    returner 2
}

funksjon total(former) -> heltall {
    la sum = 0
    for f i former {
        sum = sum + f.areal()
    }
    returner sum
}

funksjon vis(l) -> tekst {
    la s = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { s = s + "," }
        s = s + tekst(l[i])
        i = i + 1
    }
    returner s + "]"
}

funksjon metodefeil(v, metode: tekst) -> tekst {
    prøv {
        hvis metode == "areal" { v.areal() }
        hvis metode == "dobbel" { v.dobbel() }
    } fang (e: MetodeFeil) {
        returner tekst(e)
    }
    returner "ingen feil"
}

funksjon start() -> tekst {
    la ut = []
    # Dispatch over ei blanda liste og via for-variabel.
    la k = Kvadrat()
    k.s = 3
    la r = Rektangel()
    r.b = 2
    r.h = 5
    la former = [k, r]
    legg_til(ut, "total=" + tekst(total(former)))
    legg_til(ut, former[1].namn() + "=" + tekst(former[1].areal()))
    # Mutasjon via self.
    la p = Punkt()
    p.x = 1
    p.y = 2
    legg_til(ut, "flytt=" + tekst(p.flytt(10)) + "/" + tekst(p.x))
    # Same strukturnamn i to modular: eksakt modulkvalifisert oppslag.
    la ka = a.ny()
    la kb = b.ny()
    legg_til(ut, "kven=" + ka.kven() + kb.kven())
    # Skjult merke: ikkje i nøkler/lengde/for/json.
    legg_til(ut, "nøkler=" + vis(nøkler(p)) + " lengde=" + tekst(lengde(p)))
    la n = 0
    for nk i p {
        n = n + 1
    }
    legg_til(ut, "for=" + tekst(n))
    legg_til(ut, "json=" + json_stringify(p))
    la tom = Punkt()
    legg_til(ut, "tom=" + vis(nøkler(tom)))
    # Vanleg ordbok med eige __type__-felt er ikkje ein struktur: uendra.
    la d = {"__type__": "zip", "a": 1}
    legg_til(ut, "ordbok=" + tekst(lengde(d)))
    # Closure i felt.
    la kalk = Kalk()
    kalk.op = fun(x, y) -> x + y
    legg_til(ut, "op=" + tekst(kalk.op(2, 3)))
    # Fangbar MetodeFeil: manglande metode, ingen UFCS, ingenting, ikkje-struktur.
    la bil = Bil()
    legg_til(ut, metodefeil(bil, "areal"))
    legg_til(ut, metodefeil(p, "dobbel"))
    legg_til(ut, metodefeil(ingenting, "areal"))
    legg_til(ut, metodefeil(5, "areal"))
    # Struktur-unntak fangast framleis på kort typenamn.
    prøv {
        la mf = MinFeil()
        mf.melding = "m1"
        kast mf
    } fang (e: MinFeil) {
        legg_til(ut, "fang=" + tekst(e.melding))
    }
    returner builtin.join(ut, ";")
}
