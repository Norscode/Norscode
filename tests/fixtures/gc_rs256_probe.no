// GC RS256-probe (v7, 2026-09-24) — GC-modus (NORSCODE_GC_ALLOC=1), bigint-tung churn.
//
// RSA-2048-signering (std.rsa.rsa_sign, privat modexp i std.bigint base 2^16) med
// tests/fixtures/tls/localhost.key, verifisert mot localhost.crt. Allokerer svært mykje
// kortliva liste-/int-søppel med lite levande sett — same mønster som bump-ratcheten
// (gcpeek 2026-09-23: bump 480 → 886 MB på 6 s, collect-storm i dns_zone/tls_acme).
// Skriv bump og tid etter kvar signering. Exit: 0 = alle signaturar verifiserte og bump
// under HEAP_VA + 256 MiB · 2 = nøkkel/sign/verify feila · 3 = bump over taket (ratchet).
// Tal signeringar: NORSCODE_GC_RS256_N (standard 2). Nøkkelrot: NORSCODE_ROOT (standard .).
bruk std.rsa som rsa
bruk std.x509 som x509

funksjon bytes_av(t: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(t) { legg_til(ut, builtin.char_code(builtin.slice(t, i, i + 1))) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    la rot = miljo_hent("NORSCODE_ROOT")
    hvis rot == "" { rot = "." }
    la n: heiltall = 2
    la n_tekst = miljo_hent("NORSCODE_GC_RS256_N")
    hvis n_tekst != "" { n = heltall_fra_tekst(n_tekst) }
    la tak: heiltall = 7864320 + 268435456          // HEAP_VA (0x780000) + 256 MiB
    la key = x509.rsa_privat_frå_pem(fil_les(rot + "/tests/fixtures/tls/localhost.key"))
    hvis key["status"] != "ok" { skriv("gc_rs256 FEIL: privatnøkkel\n") returner 2 }
    la pub = x509.offentleg_nøkkel_frå_pem(fil_les(rot + "/tests/fixtures/tls/localhost.crt"))
    hvis pub["status"] != "ok" { skriv("gc_rs256 FEIL: offentleg nøkkel\n") returner 2 }
    la t0: heiltall = tid_ms()
    la maks_bump: heiltall = builtin.heap_bump()
    skriv("gc_rs256: start bump=" + tekst(maks_bump) + "\n")
    la k: heiltall = 0
    mens k < n {
        la melding = bytes_av("gc-rs256-probe." + tekst(k))
        la sig = rsa.rsa_sign(key["n"], key["d"], melding)
        hvis lengde(sig) != 256 { skriv("gc_rs256 FEIL: signaturlengd " + tekst(lengde(sig)) + "\n") returner 2 }
        hvis ikkje rsa.rsa_verify(pub["n"], pub["e"], melding, sig) { skriv("gc_rs256 FEIL: verifisering\n") returner 2 }
        la b: heiltall = builtin.heap_bump()
        hvis b > maks_bump { maks_bump = b }
        skriv("gc_rs256: sign " + tekst(k + 1) + "/" + tekst(n) + " ok, bump=" + tekst(b) + " (" + tekst((b - 7864320) / 1048576) + " MiB), t=" + tekst(tid_ms() - t0) + " ms\n")
        hvis b > tak { skriv("gc_rs256 FEIL: bump over tak (bump-ratchet)\n") returner 3 }
        k = k + 1
    }
    skriv("gc_rs256 OK: " + tekst(n) + " signaturar, maks_bump " + tekst((maks_bump - 7864320) / 1048576) + " MiB over HEAP_VA, " + tekst(tid_ms() - t0) + " ms\n")
    returner 0
}
