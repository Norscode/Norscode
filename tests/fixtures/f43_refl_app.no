// F43: refleksjon og annotasjonar. Programmet returnerer ei samla tekst som
// tests/test_f43_refleksjon.no sjekkar. Annotasjonane er rein metadata.
grensesnitt Form {
    funksjon areal(self) -> heltall
}

@modell("vare")
struktur Vare implementerer Form {
    @nøkkel
    id: heltall
    @felt("visningsnamn", 3)
    namn: tekst = "ukjend"
    pris
}

funksjon Vare.areal(self) -> heltall { returner 1 }
funksjon Vare.vis(self) -> tekst { returner self.namn }

@rute("GET", "/vare/{id}")
@rute("HEAD", "/vare/{id}")
@lat
funksjon hent_vare(id: heltall, detalj: bool = usann, ...resten: tekst) -> tekst {
    returner "vare"
}

@utdatert("bruk hent_vare")
funksjon gammal() { returner 0 }

funksjon start() -> tekst {
    la v = Vare(1, "kopp", 10)
    la ut = ""
    la ti = type_info(Vare)
    ut = ut + ti["namn"] + "|" + tekst(lengde(ti["felt"])) + "|" + ti["felt"][1]["standard"] + "|" + ti["felt"][1]["annotasjonar"][0]["argument"][0] + "\n"
    ut = ut + builtin.join(ti["metodar"], ",") + "|" + builtin.join(ti["grensesnitt"], ",") + "\n"
    la fi = funksjon_info("hent_vare")
    ut = ut + fi["returtype"] + "|" + tekst(lengde(fi["parametrar"])) + "|" + fi["parametrar"][2]["namn"] + tekst(fi["parametrar"][2]["vararg"]) + "\n"
    la fr = finn_med_annotasjon("rute")
    ut = ut + tekst(lengde(fr)) + fr[0]["namn"] + fr[1]["annotasjon"]["argument"][0] + "\n"
    ut = ut + hent_felt(v, "namn")
    sett_felt(v, "namn", "krus")
    ut = ut + v.namn + typar_av(v)["namn"]
    la f = funksjon_info(hent_vare)
    ut = ut + f["fullt_namn"]
    returner ut
}
