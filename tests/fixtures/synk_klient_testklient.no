# Testklient for den synka oppgåvelista (W9, testbygg): startar den ekte examples/wasm_synk/klient.no
# og køyrer stega i ?steg= som ein plan av [namn, vilkår, handling] (closures). Brukarsteg går
# gjennom testkrokane (test_skriv, test_send, test_klikk), og loggen (#nc-logg) viser statuslinja,
# talet på oppgåver og lista frå kopien. iframe-fana (steg fb) sender loggane sine til tenaren
# (/test/rapport). Chrome med --virtual-time-budget ventar ikkje på IndexedDB, så klienten held
# ein puls (/api/puls) i gang til han er ferdig; SSE blir stoppa til slutt (ein open straum held
# den virtuelle klokka).
bruk std.wasm_vert som vert
bruk std.wasm_nett som nett
bruk std.wasm_lager som lager
bruk std.synk_klient som synk
bruk examples.wasm_synk.klient som d

la plan: liste = []
la plan_i: heltall = 0
la pulsar: heltall = 0
la ferdig_flagg: bool = usann
la hendingar: liste = []
la alle_hendingar: liste = []
la steg_namn: tekst = ""
la i_ramme: bool = usann

# ─── Planen ──────────────────────────────────────────────────────────────────

funksjon ledd(namn: tekst, vilkår, handling) -> heltall {
    legg_til(plan, [namn, vilkår, handling])
    returner 0
}

funksjon sjekk() -> heltall {
    mens ikkje ferdig_flagg og plan_i < lengde(plan) {
        la s = plan[plan_i]
        hvis s[1] != null og ikkje builtin.ncb_call_fn(s[1], 0) { returner 0 }
        plan_i = plan_i + 1
        builtin.ncb_call_fn(s[2], 0)
    }
    returner 0
}

funksjon puls() -> heltall {
    hvis ferdig_flagg { returner 0 }
    pulsar = pulsar + 1
    hvis pulsar > 900 {
        la namn = "(slutt)"
        hvis plan_i < lengde(plan) { namn = plan[plan_i][0] }
        logg_linje("tidsavbrot ved " + namn + ": " + tilstand())
        returner ferdig()
    }
    sjekk()
    hvis ikkje ferdig_flagg { nett.hent("/api/puls", fun(s) -> puls(), fun(f) -> puls()) }
    returner 0
}

funksjon ferdig() -> heltall {
    hvis ferdig_flagg { returner 0 }
    ferdig_flagg = sann
    synk.stopp_varsling()
    logg_linje("ferdig")
    returner 0
}

# ─── Utskrift ────────────────────────────────────────────────────────────────

funksjon logg_linje(t: tekst) -> heltall {
    hvis i_ramme {
        nett.send(nett.med_tekst(nett.førespurnad("POST", "/test/rapport"), steg_namn + " " + t, "text/plain"), null, null)
    } ellers {
        skriv(t + "\n")
    }
    returner 0
}

funksjon tekst_av(sel: tekst) -> tekst {
    la h = vert.finn(sel)
    la t = vert.hent_tekst(h)
    vert.slepp(h)
    returner t
}

# Lista frå kopien: titlane i rekkjefølgje, ✓ for ferdig og * for ventande.
funksjon lista_tekst() -> tekst {
    la l = d.sortert(synk.liste(d.oppgåver()))
    la delar = []
    la i = 0
    mens i < lengde(l) {
        la t = tekst(l[i]["data"]["tittel"])
        hvis l[i]["data"]["ferdig"] == sann { t = t + "✓" }
        hvis l[i]["ventar"] { t = t + "*" }
        legg_til(delar, t)
        i = i + 1
    }
    returner "[" + builtin.join(delar, ", ") + "]"
}

funksjon tilstand() -> tekst {
    la s = synk.status()
    returner s["tilstand"] + " ventar=" + tekst(s["ventar"])
}

# «namn: statuslinja | #nc-resultat | lista»
funksjon logg(namn: tekst) -> heltall {
    logg_linje(namn + ": " + tekst_av("#status") + " | " + tekst_av("#nc-resultat") + " | " + lista_tekst())
    returner 0
}

funksjon hendingar_tekst() -> tekst {
    la t = builtin.join(hendingar, ",")
    hendingar = []
    returner t
}

funksjon ved_status(s: ordbok) -> heltall {
    hvis s["hending"] != "" {
        legg_til(hendingar, s["hending"])
        legg_til(alle_hendingar, s["hending"])
    }
    sjekk()
    returner 0
}

# ─── Vilkår ──────────────────────────────────────────────────────────────────

funksjon såg(h: tekst) -> bool {
    la i = 0
    mens i < lengde(alle_hendingar) {
        hvis alle_hendingar[i] == h { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon er(t: tekst) -> bool {
    returner synk.status()["tilstand"] == t
}

funksjon synka() -> bool {
    la s = synk.status()
    returner s["tilstand"] == "synka" og s["ventar"] == 0
}

funksjon har(tittel: tekst) -> bool {
    la l = synk.liste(d.oppgåver())
    la i = 0
    mens i < lengde(l) {
        hvis l[i]["data"]["tittel"] == tittel { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon har_synka(tittel: tekst) -> bool {
    la l = synk.liste(d.oppgåver())
    la i = 0
    mens i < lengde(l) {
        hvis l[i]["data"]["tittel"] == tittel og ikkje l[i]["ventar"] { returner sann }
        i = i + 1
    }
    returner usann
}

# ─── Handlingar (gjennom sida, som ein brukar) ───────────────────────────────

funksjon skriv_oppgåve(tittel: tekst) -> heltall {
    la t = vert.finn("#tittel")
    vert.test_skriv(t, tittel)
    vert.slepp(t)
    la f = vert.finn("#skjema")
    vert.test_send(f)
    vert.slepp(f)
    returner 0
}

funksjon klikk(sel: tekst) -> heltall {
    la h = vert.finn(sel)
    vert.test_klikk(h)
    vert.slepp(h)
    returner 0
}

# POST (eller GET) til ei testrute; `så` blir kalla med svaret (eller feilen).
funksjon kall(metode: tekst, url: tekst, så) -> heltall {
    nett.send(nett.førespurnad(metode, url), fun(s) -> _så(så), fun(f) -> _så(så))
    returner 0
}

funksjon _så(så) -> heltall {
    hvis så != null { builtin.ncb_call_fn(så, 0) }
    sjekk()
    returner 0
}

# ─── Stega ───────────────────────────────────────────────────────────────────

funksjon plan_1() -> heltall {
    ledd("start", fun(x) -> synka(), fun(x) -> logg("start"))
    ledd("legg til", null, fun(x) -> _legg_til_og_logg("Kjøp mjølk", "optimistisk"))
    ledd("synka", fun(x) -> har_synka("Kjøp mjølk") og stille(), fun(x) -> logg("synka"))
    ledd("anna eining", null, fun(x) -> _skriv_frå_anna_eining())
    ledd("sse", fun(x) -> har("Anna-eining"), fun(x) -> _sse_ferdig())
    ledd("hugs", null, fun(x) -> klikk("#hugs"))
    ledd("hugsa", fun(x) -> synk.status()["hugs"] og synka(), fun(x) -> logg_linje("hugs: " + tekst_av("#lokal") + " aria-pressed=" + vert.hent_attr(vert.finn("#hugs"), "aria-pressed")))
    ledd("ring", null, fun(x) -> skriv_oppgåve("Ring Åse"))
    ledd("ring synka", fun(x) -> har_synka("Ring Åse"), fun(x) -> klikk("#liste li button"))
    ledd("veksla", fun(x) -> synka() og _første_ferdig(), fun(x) -> logg("veksla"))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

# Klienten er i ro (ingen push eller pull i gang eller venta), så berre ei SSE-hending kan føre
# skrivinga frå den andre eininga hit (polling er av medan SSE er oppe).
la sse_før: heltall = 0

funksjon stille() -> bool {
    la k = synk.klient()
    returner ikkje k["opptatt"] og ikkje k["vil_pull"] og ikkje k["vil_push"]
}

funksjon _skriv_frå_anna_eining() -> heltall {
    sse_før = synk.klient()["sse_v_n"]
    kall("POST", "/test/tenar_skriv?u=u1&id=anna-1&tittel=Anna-eining", null)
    returner 0
}

# SSE-hendinga kom (tenaren sende «v» etter skrivinga frå den andre eininga), og pullen henta ho.
# Varslinga blir stoppa før IndexedDB blir brukt: headless Chrome med virtuell tid held att
# IndexedDB-svar medan ein SSE-straum er open (sjå docs/WASM_KLIENT.md).
funksjon _sse_ferdig() -> heltall {
    la k = synk.klient()
    logg("sse (open=" + tekst(k["sse_open"]) + " brot=" + tekst(k["sse_brot_n"]) + " ny hending=" + tekst(k["sse_v_n"] > sse_før) + ")")
    synk.stopp_varsling()
    returner 0
}

funksjon _første_ferdig() -> bool {
    la l = d.sortert(synk.liste(d.oppgåver()))
    returner lengde(l) > 0 og l[0]["data"]["ferdig"] == sann
}

funksjon _legg_til_og_logg(tittel: tekst, namn: tekst) -> heltall {
    skriv_oppgåve(tittel)
    logg(namn)
    returner 0
}

funksjon plan_2() -> heltall {
    ledd("omlasta", fun(x) -> synka() og har("Kjøp mjølk"), fun(x) -> logg("omlasta"))
    ledd("stopp tenaren", null, fun(x) -> kall("POST", "/test/stopp", fun(y) -> _legg_til_og_logg("Utan nett", "optimistisk")))
    ledd("offline", fun(x) -> er("offline") og synk.status()["ventar"] == 1, fun(x) -> logg("offline"))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

funksjon plan_3() -> heltall {
    ledd("tilbake", fun(x) -> synka() og har_synka("Utan nett"), fun(x) -> logg("tilbake"))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

funksjon plan_4() -> heltall {
    # Fersk profil: u1 vel «hugs» og skriv (409 treng IndexedDB: to skrivingar i éin push)
    ledd("start", fun(x) -> synka(), fun(x) -> klikk("#hugs"))
    ledd("hugsa", fun(x) -> synk.status()["hugs"] og synka(), fun(x) -> skriv_oppgåve("U1 si oppgåve"))
    ledd("u1", fun(x) -> har_synka("U1 si oppgåve") og stille(), fun(x) -> _u1_logg())
    ledd("hol", null, fun(x) -> kall("POST", "/test/hol", fun(y) -> _to_oppgåver("Hol 1", "Hol 2")))
    ledd("409", fun(x) -> synka() og har_synka("Hol 1") og har_synka("Hol 2"), fun(x) -> logg_linje("409: " + hendingar_tekst() + " | " + tilstand()))
    ledd("ny epoke", null, fun(x) -> kall("POST", "/test/ny_epoke", fun(y) -> skriv_oppgåve("Etter restore")))
    ledd("410", fun(x) -> synka() og har_synka("Etter restore"), fun(x) -> logg_linje("410: " + hendingar_tekst() + " | " + tilstand()))
    ledd("utgått", null, fun(x) -> kall("POST", "/test/utgaa?u=u1", fun(y) -> skriv_oppgåve("Utan sesjon")))
    ledd("401", fun(x) -> er("ikkje_innlogga"), fun(x) -> logg("401"))
    ledd("logg inn", null, fun(x) -> kall("GET", "/test/logg_inn?u=u1", fun(y) -> synk.prøv_igjen()))
    ledd("innlogga att", fun(x) -> synka() og har_synka("Utan sesjon"), fun(x) -> logg("innlogga att"))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

funksjon _to_oppgåver(a: tekst, b: tekst) -> heltall {
    skriv_oppgåve(a)
    skriv_oppgåve(b)
    returner 0
}

# Brukarbyte: u2 på eininga der u1 valde «hugs».
funksjon plan_b1() -> heltall {
    ledd("start", fun(x) -> synka(), fun(x) -> klikk("#hugs"))
    ledd("hugsa", fun(x) -> synk.status()["hugs"], fun(x) -> skriv_oppgåve("U1 si oppgåve"))
    ledd("u1", fun(x) -> synka() og har_synka("U1 si oppgåve"), fun(x) -> logg("u1"))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

funksjon plan_b2() -> heltall {
    ledd("u2", fun(x) -> synka() og såg("brukarbyte"), fun(x) -> logg_linje("u2: " + hendingar_tekst() + " | " + tekst_av("#feil") + " | " + lista_tekst() + " | hugs=" + tekst(synk.status()["hugs"])))
    ledd("hugs u2", null, fun(x) -> klikk("#hugs"))
    ledd("skriv u2", fun(x) -> synk.status()["hugs"], fun(x) -> skriv_oppgåve("U2 si oppgåve"))
    ledd("u2 synka", fun(x) -> synka() og har_synka("U2 si oppgåve"), fun(x) -> logg("u2 synka"))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

# To faner i same profil: toppsida (fa) og iframe-sida (fb).
funksjon plan_fa() -> heltall {
    ledd("a klar", fun(x) -> synka() og synk.status()["hugs"], fun(x) -> logg_linje("a klar"))
    ledd("a såg b", fun(x) -> har("Frå fane B"), fun(x) -> _a_såg_b())
    ledd("a synka", fun(x) -> synka() og har_synka("Frå fane A") og har_synka("Frå fane B"), fun(x) -> logg_linje("a synka: " + lista_tekst() + " leiar=" + tekst(synk.status()["leiar"])))
    ledd("db endra", fun(x) -> er("db_endra"), fun(x) -> logg_linje("a: " + tekst_av("#status")))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

funksjon plan_fb() -> heltall {
    ledd("b klar", fun(x) -> synka() og synk.status()["hugs"], fun(x) -> _b_klar())
    ledd("b såg a", fun(x) -> har_synka("Frå fane A") og har_synka("Frå fane B"), fun(x) -> _b_slett())
    ledd("slutt", fun(x) -> er("db_endra"), fun(x) -> _b_slutt())
    returner 0
}

funksjon _a_såg_b() -> heltall {
    logg_linje("a såg b")
    skriv_oppgåve("Frå fane A")
    returner 0
}

funksjon _b_klar() -> heltall {
    logg_linje("b klar")
    skriv_oppgåve("Frå fane B")
    returner 0
}

# Fana B slettar databasen (som ein utlogging eller ein ny versjon av appen): A får versionchange.
funksjon _b_slett() -> heltall {
    logg_linje("b såg a: " + lista_tekst() + " leiar=" + tekst(synk.status()["leiar"]))
    lager.slett_database(synk.klient()["db_namn"], fun(r) -> 0, fun(f) -> logg_linje("b: " + lager.feil_tekst(f)))
    returner 0
}

funksjon _b_slutt() -> heltall {
    logg_linje("b: " + tekst_av("#status"))
    ferdig()
    returner 0
}

# Utlogging gjennom sida: køa er tom, så databasen blir sletta og tenaren avsluttar sesjonen.
funksjon plan_ut() -> heltall {
    ledd("start", fun(x) -> synka(), fun(x) -> klikk("#logg-ut"))
    ledd("logga ut", fun(x) -> er("logga_ut") og d.er_utlogga_hjå_tenaren(), fun(x) -> _logg_og_ferdig("logga ut"))
    returner 0
}

funksjon plan_etter_ut() -> heltall {
    ledd("etter", fun(x) -> er("ikkje_innlogga"), fun(x) -> logg_linje("etter utlogging: " + tekst_av("#status") + " | " + lista_tekst() + " | hugs=" + tekst(synk.status()["hugs"])))
    ledd("slutt", null, fun(x) -> ferdig())
    returner 0
}

funksjon start() -> heltall {
    steg_namn = vert.hent_parameter("steg")
    i_ramme = steg_namn == "fb"
    # Utan service worker: testbygget har ingen /sw.js (sjå docs/WASM_KLIENT.md om W8 og synk)
    la val = {"last_på_nytt": usann, "sw": usann, "ved_status": fun(s) -> ved_status(s), "konf": {"varsling": "poll", "poll_ms": 3000}}
    hvis steg_namn == "1" { val["konf"] = {"varsling": "sse"} }
    hvis steg_namn == "1" { plan_1() }
    hvis steg_namn == "2" { plan_2() }
    hvis steg_namn == "3" eller steg_namn == "3b" { plan_3() }
    hvis steg_namn == "4" { plan_4() }
    hvis steg_namn == "b1" { plan_b1() }
    hvis steg_namn == "b2" { plan_b2() }
    hvis steg_namn == "fa" { plan_fa() }
    hvis steg_namn == "fb" { plan_fb() }
    hvis steg_namn == "ut" { plan_ut() }
    hvis steg_namn == "etter_ut" { plan_etter_ut() }
    logg_linje("steg " + steg_namn)
    d.start_med_val(val)
    synk.lytt(d.oppgåver(), fun(h) -> sjekk())
    # iframe-fana held ingen eigen puls: med to pulsar er det nesten alltid ein førespurnad på
    # nettet, og då går den virtuelle klokka aldri, så IndexedDB-svara kjem ikkje (målt). Stega hennar
    # går på hendingane (status, lyttar); toppsida sin puls held klokka i gang for begge.
    hvis ikkje i_ramme { puls() }
    returner 0
}

funksjon _logg_og_ferdig(namn: tekst) -> heltall {
    logg(namn)
    ferdig()
    returner 0
}

funksjon _u1_logg() -> heltall {
    logg("u1")
    hendingar_tekst()
    returner 0
}
