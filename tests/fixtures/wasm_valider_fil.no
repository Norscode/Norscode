# Barneprogram for WASM-testane (W2): validerer fila i NC_WASM_FIL (relativ til rota) med
# std/wasm_les.no og skriv éi linje, «VALIDERING: OK» eller «VALIDERING: AVVIST <feil>».
# Testane køyrer det i VM-fastmodus, der typesjekken av ein modul på fleire KB tek under
# eitt sekund (i standard-VM-en tek han om lag 12 s per KB).
bruk std.wasm_les som les
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon start() -> heltall {
    la sti = miljo_hent("NC_WASM_FIL")
    hvis sti == "" {
        skriv("VALIDERING: AVVIST set NC_WASM_FIL\n")
        returner 2
    }
    la r = les.valider(hjelp.les_bytar(sti))
    hvis r["ok"] {
        skriv("VALIDERING: OK\n")
    } ellers {
        skriv("VALIDERING: AVVIST " + r["feil"] + "\n")
    }
    returner 0
}
