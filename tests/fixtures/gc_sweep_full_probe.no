// GC (iv) probe: full-range sweep (gc_sweep_full) — indre hol OG halen [last_live_end,
// bump). Sortert live-map: 3 live objekt m/48B indre hol + 64B hale. Verifiser at BEGGE
// vart frigjort (freed==2), at halen vart attvunnen ved BUMP-RESET (layout v3, 2026-09-04:
// bump == last_live_end = region+96, ikkje fri-liste-node) og at gc_alloc16 gjenbrukar det
// indre holet (fyrste-passing, 16 B karva frå hol-HALEN → region+48). Live-map @GC_LIVEMAP_VA = 0x43000000 (layout v3).
// Exit: 0 = OK · 2 = feil frigjering/gjenbruk.
funksjon start() -> heiltall {
    la region: heiltall = builtin.heap_bump() + 65536
    la lm: heiltall = 1124073472                   // 0x43000000 (GC_LIVEMAP_VA, layout v3)
    builtin.raw_store64(lm, region)                // live[0] @region, 16
    builtin.raw_store64(lm + 8, 16)
    builtin.raw_store64(lm + 16, region + 64)      // live[1] @region+64 (48B hol før)
    builtin.raw_store64(lm + 24, 16)
    builtin.raw_store64(lm + 32, region + 80)      // live[2] @region+80 (tilstøytande)
    builtin.raw_store64(lm + 40, 16)
    builtin.heap_set_bump(region + 160)            // hale [region+96, region+160) = 64B
    la freed: heiltall = builtin.gc_sweep_full(3)
    la bump_etter: heiltall = builtin.heap_bump()
    la a: heiltall = builtin.obj_addr(builtin.gc_alloc16())
    hvis freed == 2 og bump_etter == region + 96 og a == region + 48 {
        skriv("gc_sweep_full OK: indre hol (48B) på fri-lista + hale (64B) attvunnen via bump-reset\n")
        returner 0
    }
    skriv("gc_sweep_full FEIL: freed=" + tekst(freed) + " bump-region=" + tekst(bump_etter - region) + " a-region=" + tekst(a - region) + "\n")
    returner 2
}
