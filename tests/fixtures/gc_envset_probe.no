// Sjølvsjekkande vakt: miljo_sett/miljo_hent-overlay (nc_main publiserer TARGET-policy slik)
funksjon start() -> heiltall {
    miljo_sett("NC_PROBE_X", "verdi1")
    la a = miljo_hent("NC_PROBE_X")
    hvis a != "verdi1" { kast "sett/hent feil: [" + a + "]" }
    miljo_sett("NC_PROBE_X", "verdi2")
    la b = miljo_hent("NC_PROBE_X")
    hvis b != "verdi2" { kast "overskriv feil: [" + b + "]" }
    la c = miljo_hent("NC_PROBE_FINST_IKKJE")
    hvis c != "" { kast "manglande skal vere tom: [" + c + "]" }
    la d = miljo_hent("PATH")
    hvis lengde(d) < 1 { kast "arva PATH tom" }
    skriv("overlay=" + a + " " + b + " [" + c + "] path_len=" + tekst(lengde(d)) + "\n")
    skriv("gc_envset_probe OK\n")
    returner 0
}
