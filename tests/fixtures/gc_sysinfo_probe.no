// Sjølvsjekkande vakt: builtin.system_info nativt (uname/getcwd/readlink) → map med status ok
funksjon start() -> heiltall {
    la m = builtin.system_info()
    skriv("system=" + tekst(m["system"]) + " machine=" + tekst(m["machine"]) + " status=" + tekst(m["status"]) + "\n")
    skriv("cwd=" + tekst(m["cwd"]) + "\n")
    skriv("exe=" + tekst(m["executable"]) + "\n")
    hvis tekst(m["status"]) != "ok" { kast "status ikkje ok" }
    hvis tekst(m["system"]) != "Linux" { kast "system: " + tekst(m["system"]) }
    hvis lengde(tekst(m["cwd"])) < 1 { kast "tom cwd" }
    hvis lengde(tekst(m["executable"])) < 1 { kast "tom executable" }
    skriv("gc_sysinfo_probe OK\n")
    returner 0
}
