// Isolert test av 64-bit-aritmetikk (carry over bit 32, mask, shift).
funksjon start() -> heiltall {
    la a = 4294967295           // 0xFFFFFFFF
    la b = a + 1                // 0x100000000
    la carry = b >> 32          // 1
    la lo = b & 4294967295      // 0
    la x = 255 << 24            // 0xFF000000
    la y = x >> 16              // 0xFF00
    returner carry * 7 + (y >> 8) + lo   // 7 + 255 + 0 = 262 -> exit 6
}
