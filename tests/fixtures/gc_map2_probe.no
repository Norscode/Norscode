funksjon start() -> heiltall {
    la m: ordbok = {}
    la j: heiltall = 0
    // 40 entries → tvingar map-grow; verdiar er STRENGAR (GC-managed)
    mens j < 40 {
        map_set(m, "n" + tekst(j), "verdi_" + tekst(j))
        j = j + 1
    }
    la i: heiltall = 0
    mens i < 3000 { la t: liste_heiltall = [i, i+1]  i = i + 1 }
    // sjekk alle 40 overlevde
    la k: heiltall = 0
    mens k < 40 {
        hvis map_get(m, "n" + tekst(k)) != "verdi_" + tekst(k) { returner 500 + k }
        k = k + 1
    }
    skriv("map2 OK: 40 streng-entries overlevde grow+collect\n")
    returner 0
}
