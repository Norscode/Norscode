# Testapp for skjema-demoen (W4): den ekte examples/wasm_skjema/app.no (rutene hennar blir
# med) og sida /test med <pre id="nc-logg">, der logg_test skriv i testbygg, ein knapp med
# data-nc-klikk til ein funksjon som ikkje er delegert (negativ kontroll), og ein
# <textarea id="stor"> med 2^16 + 6 bytar tekst som klienten les før han skriv noko stort
# sjølv (så lastaren sin U-hjelpar må vekse minnet).
bruk std.web som web
bruk std.wasm_serve som ws
bruk examples.wasm_skjema.app som app

funksjon stor_tekst() -> tekst {
    la t = "y"
    la i = 0
    mens i < 16 {
        t = t + t
        i = i + 1
    }
    returner t + "æøå"
}

funksjon test_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /test")
    returner ws.side(app.side_html("<pre id=\"nc-logg\"></pre>" +
        "<button id=\"falsk\" type=\"button\" data-nc-klikk=\"tøm_status\" data-id=\"2\">falsk</button>" +
        "<textarea id=\"stor\" hidden>" + stor_tekst() + "</textarea>"))
}

funksjon start() -> heltall {
    returner 0
}
