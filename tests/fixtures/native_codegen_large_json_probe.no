funksjon start() -> heiltall {
    la sti = miljo_hent("NC_LARGE_JSON_PROBE")
    skriv("large-json: read\n")
    la rå = fil_les(sti)
    skriv("large-json: bytes=" + tekst_fra_heltall(lengde(rå)) + "\n")
    la parsed = json_parse_raw(rå)
    skriv("large-json: parsed functions=" +
          tekst_fra_heltall(lengde(nøkler(parsed["functions"]))) + "\n")
    returner 0
}
