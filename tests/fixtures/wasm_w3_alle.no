# W3 storleik (tests/test_wasm_w3.no): ein tom app som brukar HEILE runtime-biblioteket, både
# builtinane som blir kopla til std.wasm_rt og rt-funksjonane utan builtin.
bruk std.wasm_rt som rt

funksjon start() -> heltall {
    la d = split("a,b", ",")
    la s = join(d, "-") + trim(" x ") + tekst_erstatt("a", "a", "b") + tekst_til_liten("A") + tekst_til_store("a")
    la b = starts_with(s, "a") og ends_with(s, "b") og contains(s, "-")
    la i = index_of(s, "-")
    la v = builtin.json_parse_raw("[1.5]")
    la j = json_stringify(verdier({"a": v}))
    la h = sha256(j)
    la l = rt.sorter(rt.sortert([2, 1]), fun(x, y) -> x - y)
    la t = rt.tekst_til_liste("æø")
    skriv(s + tekst(b) + tekst(i) + j + h + tekst(l) + tekst(t) + "\n")
    returner 0
}
