// Fase 7: TCP socket-loopback i éin prosess. Server bind+lytt på 127.0.0.1,
// klient connect (kjernen fullfører loopback-handshaket inn i lytte-køen), server
// aksepterer, klient sender "hello!", server les det tilbake. Forventa: 6 byte.
// Brukar socket_new/bind/listen/connect/accept/send/recv/close direkte.
funksjon start() -> heiltall {
    la srv = builtin.socket_new(2, 1)
    builtin.socket_bind(srv, "127.0.0.1", 19491)
    builtin.socket_listen(srv, 1)
    la cli = builtin.socket_new(2, 1)
    builtin.socket_connect(cli, "127.0.0.1", 19491)
    la conn = builtin.socket_accept(srv)
    builtin.socket_send(cli, "hello!")
    la data = builtin.socket_recv(conn, 1024)
    builtin.socket_close(cli)
    builtin.socket_close(conn)
    builtin.socket_close(srv)
    returner lengde(data)
}
