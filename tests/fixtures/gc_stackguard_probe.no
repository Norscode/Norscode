// Sjølvsjekkande vakt: uendeleg rekursjon → fangbart «For djup rekursjon (native stakk)»
funksjon ned(n: heiltall) -> heiltall { returner ned(n + 1) + 1 }
funksjon start() -> heiltall {
    la fanga = ""
    prøv { la x = ned(0) skriv("x=" + tekst(x) + "\n") } fang (e) { fanga = tekst(e) }
    skriv("fanga=[" + fanga + "]\n")
    hvis fanga != "For djup rekursjon (native stakk)" { kast "feil melding: " + fanga }
    la d = 0
    prøv { d = ned2(2000) } fang (e) { d = -1 }
    hvis d != 2000 { kast "endeleg rekursjon 2000 feila" }
    skriv("gc_stackguard_probe OK\n")
    returner 0
}
funksjon ned2(n: heiltall) -> heiltall { hvis n == 0 { returner 0 } returner 1 + ned2(n - 1) }
