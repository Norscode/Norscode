// R3-fikstur: vararg- og standardparametrar som blir kalla frå ein annan modul.
la PREFIKS = "p"

funksjon samle(forst: tekst, ...rest) -> tekst {
    returner forst + ":" + tekst(lengde(rest)) + ":" + builtin.join(rest, ",")
}

funksjon helse(namn: tekst, helsing: tekst = "hei", gonger: heiltall = 2) -> tekst {
    la ut = ""
    la i = 0
    mens i < gonger {
        ut = ut + helsing + " " + namn + ";"
        i = i + 1
    }
    returner ut
}

funksjon med_global(x: tekst = PREFIKS) -> tekst {
    returner x
}
