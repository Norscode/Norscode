// GC (iii) probe: register-trygg rå 16B-allokator (gc_alloc16) — målet for hex-patchen
// av bump-prologen. Verifiser at han returnerer ei brukbar 16B-blokk og GJENBRUKAR ein
// gc_free-a blokk (fri-liste, ikkje rein bump). Adressa vert observert via obj_addr.
// Exit: 0 = OK · 3 = gjenbrukte ikkje fri-blokka.
funksjon start() -> heiltall {
    // donér ein 16B fri-blokk høgt over bump; gc_alloc16 skal returnere nett den
    la region: heiltall = builtin.heap_bump() + 65536
    builtin.gc_free(region, 16)
    la a: heiltall = builtin.obj_addr(builtin.gc_alloc16())
    hvis a != region {
        returner 3
    }
    skriv("gc_alloc16 OK: register-trygg rå 16B-allokator gjenbrukte fri-blokk\n")
    returner 0
}
