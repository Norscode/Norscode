// Fase 6-JSON (skalarar): json_stringify på int/streng/bool.
// int 42→"42"(2), streng "hei"→"\"hei\""(5), sann→"true"(4), usann→"false"(5).
// Sum lengder = 2+5+4+5 = 16.
funksjon start() -> heiltall {
    la a = builtin.json_stringify(42)
    la b = builtin.json_stringify("hei")
    la c = builtin.json_stringify(sann)
    la d = builtin.json_stringify(usann)
    skriv(a) skriv("|") skriv(b) skriv("|") skriv(c) skriv("|") skriv(d) skriv("\n")
    returner lengde(a) + lengde(b) + lengde(c) + lengde(d)
}
