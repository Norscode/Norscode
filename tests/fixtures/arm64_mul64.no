// 64-bit sum-av-produkt (x25519 field-mul-kjerne).
funksjon start() -> heiltall {
    la a = [65535, 65535, 65535, 65535]
    la b = [65535, 65535, 65535, 65535]
    la sum = 0  la i = 0
    mens i < 4 { sum = sum + a[i] * b[i]  i = i + 1 }
    la hi = sum >> 16
    la lo = sum & 65535
    returner (hi + lo) & 255
}
