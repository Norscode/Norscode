// GC soft-OOM-probe (v7, 2026-09-24) — GC-modus (NORSCODE_GC_ALLOC=1). VENTA utfall: exit
// 199 med «norscode: GC-heap full» på stderr, innan kort tid.
//
// Veks eit LEVANDE sett (liste av 1000-elements lister) til heapen er full. Når bump passerer
// GC_SOFT_LIMIT (tak − 64 MiB) skal safepoint-stubben berre samle når bump har vakse ≥ 8 MiB
// sidan siste collect (budsjett); etter ein collect med bump ≥ GC_HARD_LIMIT → gc_oom (199).
// Før v7 samla stubben ved KVART safepoint i soft-sona (full mark av ~1 GiB levande kvar
// gong) → collect-storm, i praksis heng til timeout. Exit 1 her = FEIL (skulle ikkje nå
// slutten: 4M lister × ~8 KiB er langt over 1 GiB).
funksjon lag_liste(n: heiltall) -> liste {
    la ut: liste = []
    la j = 0
    mens j < n {
        legg_til(ut, j)
        j = j + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la hald: liste = []
    la i: heiltall = 0
    mens i < 4000000 {
        legg_til(hald, lag_liste(1000))
        i = i + 1
        hvis i % 16384 == 0 {
            skriv("soft_oom: " + tekst(i) + " lister, bump=" + tekst(builtin.heap_bump()) + "\n")
        }
    }
    skriv("soft_oom FEIL: nådde slutten utan OOM (" + tekst(lengde(hald)) + " lister)\n")
    returner 1
}
