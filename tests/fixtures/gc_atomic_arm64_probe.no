// GC-probe (A4, AArch64): builtin.atomic_operation må ikkje gje ei atom-celle som GC-en
// frigjer medan handtaket lever. Den inline ARM64-emitteren legg cella rått ved fronten og
// adressa hennar som bytes i handtak-strengen; ingen boks peikar på cella. Utan GC (bump)
// er det trygt. I GC-modus er kallet difor ein fail-closed NATIV-GAP-stubb (fangbart
// unnatak) — ein inline-celle i GC-modus ville bli frigjord ved første collect og gjenbrukt
// av churn-listene under (negativ kontroll i a4-rapporten).
//
// Proben lagar 32 celler (verdi 1000·i + 7), churnar ~200 MiB lister (fleire collects i
// GC-modus), og les cellene att. Exit 0 = OK (rette verdiar, eller NATIV-GAP fanga) ·
// 2 = feil verdi (cella er frigjord/gjenbrukt) · 3 = uventa svar.
funksjon lag_liste(n: heiltall) -> liste {
    la ut: liste = []
    la j = 0
    mens j < n {
        legg_til(ut, j)
        j = j + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la handtak: liste = []
    la i = 0
    prøv {
        mens i < 32 {
            la r = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "create", "value": 1000 * i + 7, "order": "seq_cst"})
            hvis tekst(r["status"]) != "ok" {
                skriv("gc_atomic_arm64 UVENTA: create status=" + tekst(r["status"]) + "\n")
                returner 3
            }
            legg_til(handtak, r["handle"])
            i = i + 1
        }
    } fang (e) {
        la m = tekst(e)
        hvis builtin.contains(m, "NATIV-GAP") {
            skriv("gc_atomic_arm64 OK: atomic_operation er fail-closed (" + m + ")\n")
            returner 0
        }
        skriv("gc_atomic_arm64 UVENTA unnatak: " + m + "\n")
        returner 3
    }
    // Churn: 400 × 2000-elements lister (~64 KiB kvar) → ~200 MiB allokert og sleppt.
    la sum = 0
    la k = 0
    mens k < 400 {
        la l = lag_liste(2000)
        sum = sum + l[1999]
        k = k + 1
    }
    la feil = 0
    i = 0
    mens i < 32 {
        la r = builtin.atomic_operation({"abi": "norscode-atomic-v1", "operation": "load", "handle": handtak[i], "order": "seq_cst"})
        la v = r["value"]
        hvis v != 1000 * i + 7 {
            hvis feil < 3 { skriv("gc_atomic_arm64 FEIL: celle " + tekst(i) + " = " + tekst(v) + ", venta " + tekst(1000 * i + 7) + "\n") }
            feil = feil + 1
        }
        i = i + 1
    }
    hvis feil > 0 {
        skriv("gc_atomic_arm64 FEIL: " + tekst(feil) + " av 32 celler øydelagde etter churn (sum=" + tekst(sum) + ")\n")
        returner 2
    }
    skriv("gc_atomic_arm64 OK: 32 celler urørte etter churn (sum=" + tekst(sum) + ")\n")
    returner 0
}
