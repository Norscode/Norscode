// gc_hashmap_probe.no — hasha map i self-hosta x86-64-runtime (map_new/get/set/has/del-
// atom via entry-trampolinar). Frosen map var lineær → kvadratisk på store map.
// Sjekkar: 20000 innsetjingar + oppslag, finnes_nøkkel, oppdatering, fjern_nøkkel
// (ordensbevarande), nøkkelrekkjefølgje, map-literal, JSON-rundtur, miljo-overlay,
// og (GC-layout) collect midt i. Exit 0 = alt rett; skriv tid.
funksjon start() -> heiltall {
    la t0 = builtin.tid_ms()
    la m: ordbok_tekst = {}
    la i: heiltall = 0
    mens i < 20000 {
        m["k" + tekst(i)] = "v" + tekst(i)
        i = i + 1
    }
    hvis lengde(m) != 20000 { skriv("lengde " + tekst(lengde(m)) + "\n") returner 3 }
    i = 0
    mens i < 20000 {
        hvis m["k" + tekst(i)] != "v" + tekst(i) { skriv("oppslag feil " + tekst(i) + "\n") returner 4 }
        i = i + 7
    }
    hvis ikkje finnes_nøkkel(m, "k12345") { returner 5 }
    hvis finnes_nøkkel(m, "k20000") { returner 6 }
    hvis finnes_nøkkel(m, "x") { returner 7 }
    m["k5"] = "ny"
    hvis m["k5"] != "ny" eller lengde(m) != 20000 { returner 8 }
    la n = nøkler(m)
    hvis n[0] != "k0" eller n[1] != "k1" eller n[19999] != "k19999" { skriv("orden feil\n") returner 9 }
    builtin.gc_collect_native()
    fjern_nøkkel(m, "k1")
    hvis lengde(m) != 19999 eller finnes_nøkkel(m, "k1") { returner 10 }
    la n2 = nøkler(m)
    hvis n2[1] != "k2" eller n2[19998] != "k19999" { skriv("orden etter fjern feil\n") returner 11 }
    hvis m["k19999"] != "v19999" eller m["k2"] != "v2" { returner 12 }
    la lit = {"a": "1", "b": "2", "c": "3"}
    hvis lit["b"] != "2" eller lengde(lit) != 3 { returner 13 }
    la liten: ordbok_tekst = {}
    liten["x"] = "1"
    liten["y"] = "2"
    hvis liten["y"] != "2" eller finnes_nøkkel(liten, "z") { returner 14 }
    la js = json_stringify(lit)
    la tilbake = json_parse(js)
    hvis tilbake["c"] != "3" eller lengde(tilbake) != 3 { skriv("json feil: " + js + "\n") returner 15 }
    // JSON-rundtur på 2000 entryar (frosen json_stringify er kvadratisk i minne — 20k
    // entryar sprengjer 2 GiB-heapen; eige, eldre gap, ikkje map-relatert).
    la mm: ordbok_tekst = {}
    i = 0
    mens i < 2000 { mm["k" + tekst(i)] = "v" + tekst(i) i = i + 1 }
    la stor = json_parse(json_stringify(mm))
    hvis lengde(stor) != 2000 eller stor["k777"] != "v777" { skriv("stor json feil\n") returner 16 }
    miljo_sett("NC_HM", "hei")
    hvis miljo_hent("NC_HM") != "hei" { returner 17 }
    builtin.gc_collect_native()
    hvis m["k19998"] != "v19998" eller ikkje finnes_nøkkel(stor, "k1000") { returner 18 }
    skriv("hashmap OK " + tekst(builtin.tid_ms() - t0) + " ms\n")
    returner 0
}
