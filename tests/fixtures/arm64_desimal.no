// A5: desimaltall (type 6) i ARM64-AOT. Skriv IEEE-bita som heiltal og bool-svar,
// så utdata er uavhengig av desimalformateringa. Må vere lik VM-en byte for byte.

funksjon b(x) -> heiltall { returner builtin.desimal_til_bits(x) }

funksjon vis(namn: tekst, x) -> heiltall {
    skriv(namn + "=" + tekst(b(x)) + "\n")
    returner 0
}

funksjon vis_b(namn: tekst, v: boolsk) -> heiltall {
    hvis v { skriv(namn + "=sann\n") } ellers { skriv(namn + "=usann\n") }
    returner 0
}

funksjon start() -> heiltall {
    la a = 3.5
    la c = -0.25
    la n = 7
    vis("a", a)
    vis("c", c)
    vis("add", a + c)
    vis("sub", a - c)
    vis("mul", a * c)
    vis("div", a / c)
    vis("mod", 7.5 % 2.0)
    vis("modneg", -7.5 % 2.0)
    vis("modstor", 1.0e300 % 3.0)
    vis("blanda_add", a + n)
    vis("blanda_mul", n * a)
    vis("blanda_div", n / 2.0)
    vis("neg", -a)
    vis("negnull", -(0.0))
    vis("frå_bits", builtin.desimal_frå_bits(4614253070214989087))
    skriv("til_heiltal=" + tekst(builtin.desimal_til_heiltal(-7.9)) + "\n")
    vis_b("er_desimal", builtin.er_desimaltall(a))
    vis_b("er_desimal_int", builtin.er_desimaltall(n))
    vis_b("lt", c < a)
    vis_b("le", a <= 3.5)
    vis_b("gt", a > n)
    vis_b("ge", 7.0 >= n)
    vis_b("eq", 2.0 == 2)
    vis_b("ne", a != 3.5)
    la nan = builtin.desimal_frå_bits(9221120237041090560)
    vis_b("nan_eq", nan == nan)
    vis_b("nan_ne", nan != nan)
    vis_b("nan_lt", nan < a)
    skriv("type=" + builtin.type(a) + "\n")
    la fanga = "nei"
    prøv { la z = a / 0.0 } fang (e) { fanga = "ja" }
    skriv("div0_fanga=" + fanga + "\n")
    la fanga2 = "nei"
    prøv { la z2 = a % 0 } fang (e2) { fanga2 = "ja" }
    skriv("mod0_fanga=" + fanga2 + "\n")
    returner 0
}
