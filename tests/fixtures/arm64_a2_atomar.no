// A2-atom som ikkje har eigen fixture i test_arm64_kryss_codegen (a12fix): random_byte,
// __str_cmp (leksikografisk <, <=, >, >= på tekst), tekst(bool), native_target og
// system_info, i både linux-arm64-ELF og Mach-O (fiksturen er liten nok for Mach-O-taket).
// Testen samanliknar kryss-codegen-binæren med tolka codegen på denne fila, so ei
// feilkompilering av desse emitterane i kryss-binæren blir raud i CI.
funksjon start() -> heiltall {
    la b = builtin.random_byte()
    la ok_b = b >= 0 og b <= 255
    la s1 = "abc" < "abd"
    la s2 = "b" > "a"
    la s3 = "10.1" <= "10.1"
    la s4 = "z" >= "za"
    skriv("rb=" + tekst(ok_b) + " cmp=" + tekst(s1) + tekst(s2) + tekst(s3) + tekst(s4) + "\n")
    skriv("bool=" + tekst(sann) + "/" + tekst(usann) + "\n")
    la si = builtin.system_info()
    skriv("mål=" + builtin.native_target() + " si=" + tekst(si["status"]) + " n=" + tekst(lengde(nøkler(si))) + "\n")
    returner 44
}
