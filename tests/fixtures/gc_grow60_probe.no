// GC (3b) probe: byggjer 60-elem liste via legg_til (som sha256 sin message-schedule w=64),
// les tilbake. Køyrt flagg PÅ (gc_alloc_var_r8) OG AV (baseline). Om baseline (av) verkar men
// på krasjar → grow-patch buggy. Om begge verkar → grow-patch korrekt. Exit: 0 OK · 2 feil.
funksjon start() -> heiltall {
    la w: liste_heiltall = []
    la i: heiltall = 0
    mens i < 60 {
        legg_til(w, i * 3)
        i = i + 1
    }
    hvis w[0] == 0 og w[30] == 90 og w[59] == 177 {
        skriv("gc_grow60 OK: 60-elem legg_til-liste korrekt\n")
        returner 0
    }
    returner 2
}
