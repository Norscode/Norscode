// Felles for R3 trinn 8-testane (signaturbinding, responsmodell, OpenAPI):
// rutemetadata for tests/fixtures/r3_signatur_app.no og ein apptest-klient.
//
// Ein NCB frå kompilatoren på greina har "params", "modellar" og "return_type" (3.1),
// og felttypane i struktur kjem frå typesystemet (R3 spor A, docs/TYPEMETADATA.md).
// Dagens seed-kompilator (før reseed) lagar ikkje nøklane, så metadataen blir fylt
// inn her i same form som kompilatoren lagar han, og gjeven til apptenar via konfig
// "rutemetadata". Med ein fersk seed blir metadataen frå VM-en brukt som han er.
bruk std.apptenar som app
bruk std.apptest som t

funksjon _p(namn: tekst, typ: tekst) -> ordbok {
    returner {"namn": namn, "type": typ, "har_standard": usann, "standard": null}
}

funksjon _ps(namn: tekst, typ: tekst, standard) -> ordbok {
    returner {"namn": namn, "type": typ, "har_standard": sann, "standard": standard}
}

funksjon _modellar() -> ordbok {
    returner {
        "Adresse": {"namn": "Adresse", "felt": [_p("gate", "tekst"), _p("nr", "heltall")]},
        "Person": {"namn": "Person", "felt": [_p("namn", "tekst"), _ps("alder", "heltall", 0), _p("adresse", "Adresse")]},
        "PersonUt": {"namn": "PersonUt", "felt": [_p("id", "heltall"), _p("namn", "tekst"), _ps("aktiv", "boolsk", sann)]}
    }
}

// Signaturane i fiksturen, i same form som kompilatoren lagar dei.
funksjon _signaturar() -> ordbok {
    la m = _modellar()
    returner {
        "hent_person": {"params": [_p("ctx", ""), _p("id", "heltall"), _ps("detaljar", "boolsk", usann)],
                        "modellar": {"PersonUt": m["PersonUt"]}},
        "ekko": {"params": [_p("ctx", ""), _p("id", "heltall"), _ps("detaljar", "boolsk", usann)], "modellar": {}},
        "sok": {"params": [_p("q", "tekst"), _ps("n", "heltall", 10)], "modellar": {}},
        "lag_person": {"params": [_p("ctx", ""), _p("p", "Person")],
                       "modellar": {"Person": m["Person"], "Adresse": m["Adresse"]}},
        "to_kroppar": {"params": [_p("a", "Adresse"), _p("p", "Person")],
                       "modellar": {"Person": m["Person"], "Adresse": m["Adresse"]}},
        "utypa": {"params": [_p("ctx", ""), _p("slug", "")], "modellar": {}},
        "talrute": {"params": [_p("ctx", ""), _p("n", "")], "modellar": {}},
        "gamal": {"params": [_p("ctx", "")], "modellar": {}},
        "med_dep": {"params": [_p("ctx", ""), _p("handle", "")], "modellar": {}},
        "personliste": {"params": [_p("ctx", ""), _p("t", "liste<heltall>"), _p("merke", "tekst?")],
                        "modellar": {"PersonUt": m["PersonUt"]}, "return_type": "liste<PersonUt>"},
        "adresser": {"params": [_p("ctx", ""), _p("a", "liste<Adresse>")], "modellar": {"Adresse": m["Adresse"]}}
    }
}

funksjon kort(fn: tekst) -> tekst {
    la d = builtin.split(fn, ".")
    returner d[lengde(d) - 1]
}

funksjon rutemetadata() -> liste {
    la rh = ncb_route_handlers()
    la sig = _signaturar()
    la ut = []
    la i = 0
    mens i < lengde(rh) {
        la r = rh[i]
        la k = kort(tekst(r["function"]))
        hvis har_nokkel(sig, k) {
            hvis ikkje har_nokkel(r, "params") eller lengde(r["params"]) == 0 {
                r["params"] = sig[k]["params"]
            }
            hvis ikkje har_nokkel(r, "modellar") eller lengde(nøkler(r["modellar"])) == 0 {
                r["modellar"] = sig[k]["modellar"]
            }
            hvis (ikkje har_nokkel(r, "return_type") eller tekst(r["return_type"]) == "") og har_nokkel(sig[k], "return_type") {
                r["return_type"] = sig[k]["return_type"]
            }
            // Felttypane kjem frå typesystemet (spor A); til då blir dei fylte inn her.
            la mk = nøkler(r["modellar"])
            la mi = 0
            mens mi < lengde(mk) {
                la mf = r["modellar"][mk[mi]]["felt"]
                hvis lengde(mf) > 0 og tekst(mf[0]["type"]) == "" og har_nokkel(sig[k]["modellar"], mk[mi]) {
                    r["modellar"][mk[mi]] = sig[k]["modellar"][mk[mi]]
                }
                mi = mi + 1
            }
        }
        legg_til(ut, r)
        i = i + 1
    }
    returner ut
}

funksjon klient() -> ordbok {
    la kl = t.klient({"logg": "ingen", "rutemetadata": rutemetadata()})
    // `nc run` kopierer ikkje dependency_providers frå importerte modular inn i VM-en.
    app.registrer_avhengigheit("db", "tests.fixtures.r3_signatur_app.db_dep")
    returner kl
}

// Éin 422-post med gjeven type og loc.
funksjon har_post(res: ordbok, typ: tekst, loc: liste) -> boolsk {
    hvis t.status(res) != 422 { returner usann }
    la d = builtin.json_parse_raw(t.body_tekst(res))
    la poster = d["detail"]
    la i = 0
    mens i < lengde(poster) {
        la p = poster[i]
        hvis tekst(p["type"]) == typ og builtin.join(p["loc"], "/") == builtin.join(loc, "/") { returner sann }
        i = i + 1
    }
    returner usann
}


// Rutemetadata for éin handlar (kort namn), eller null.
funksjon rute(fn_kort: tekst) {
    la rh = rutemetadata()
    la i = 0
    mens i < lengde(rh) {
        hvis kort(tekst(rh[i]["function"])) == fn_kort { returner rh[i] }
        i = i + 1
    }
    returner null
}
