// Fase 8: unnataks-handtering. dyp() rekursivt til kast (utrulling over 5 rammer);
// nøsta try med re-kast frå indre catch til ytre. Forventa 42 + 1 + 10 = 53.
funksjon dyp(n: heiltall) -> heiltall {
    hvis n <= 0 { kast "bunn" }
    returner dyp(n - 1)
}
funksjon start() -> heiltall {
    la r = 0
    prøv { r = dyp(5) } fang (e) { r = 42 }
    prøv {
        prøv { kast "indre" } fang (e) { r = r + 1 kast "ytre" }
    } fang (e) { r = r + 10 }
    returner r
}
