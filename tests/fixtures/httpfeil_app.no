# Fikstur for tests/test_serve_httpfeil.no (4.1): HTTPFeil-hierarkiet under nc serve.
bruk std.web som web
bruk std.httpfeil
bruk std.httpfeil_handterar som hf

# Oppstart: feilhandterar for Konflikt (eksakt type). Andre HTTPFeil får standardsvaret.
funksjon oppsett() {
    web.startup_hook()
    hf.feilhandterar("Konflikt", fun(req, feil) -> {"status": 409, "body": "{\"egen\":\"" + tekst(feil.detalj) + "\"}", "content_type": "application/json; charset=utf-8", "headers": {"X-Handterar": "konflikt"}})
}

funksjon r_funnet(ctx) {
    web.route("GET /funnet")
    kast IkkjeFunnet("Fann ikkje")
}

funksjon r_generell(ctx) {
    web.route("GET /generell")
    kast HTTPFeil(418, "tekanne")
}

funksjon r_input(ctx) {
    web.route("GET /input")
    kast UgyldigInput({"felt": "namn", "krav": ["påkravd"]})
}

funksjon r_auth(ctx) {
    web.route("GET /auth")
    kast IkkjeAutorisert("logg inn", {"WWW-Authenticate": "Bearer"})
}

funksjon r_forbode(ctx) {
    web.route("GET /forbode")
    kast Forbode("ikkje din")
}

funksjon r_konflikt(ctx) {
    web.route("GET /konflikt")
    kast Konflikt("dobbel")
}

funksjon r_server(ctx) {
    web.route("GET /server")
    kast ServerFeil("kaput")
}

funksjon r_ok(ctx) {
    web.route("GET /ok")
    returner "ok"
}

funksjon r_krasj(ctx) {
    web.route("GET /krasj")
    kast "gale internt"
}

funksjon start() -> heltall {
    returner 0
}
