// GC (iv) probe: SAMLA collect (gc_collect_native) = mark-roots → sort → sweep-full i éin
// maskinkode-rutine. Verifiser at collecten køyrer utan krasj OG at levande lokalvariablar
// overlever (mark-roots fann dei → sweep frigjorde dei IKKJE). Exit: 0 = OK · 2 = korrupt.
funksjon start() -> heiltall {
    la a: heiltall = 111
    la b: heiltall = 222
    la c: heiltall = 333
    builtin.gc_collect_native()
    hvis a == 111 og b == 222 og c == 333 {
        skriv("gc_collect_native OK: mark-roots+sort+sweep samla, levande verdiar urørte\n")
        returner 0
    }
    returner 2
}
