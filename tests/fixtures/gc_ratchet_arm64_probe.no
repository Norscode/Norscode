// GC bump-ratchet- og prefiks-lekk-probe (A4, AArch64) — sjølvsjekkande, GC-modus
// (NORSCODE_GC_ALLOC=1 ved codegen; porten gjerne 4 MiB via NORSCODE_GC_TERSKEL_BYTES so
// det blir hundrevis av collects). ARM64-spegelen av gc_ratchet_probe.no (x86, v7).
//
// Churn UTAN anker: kvar iterasjon byggjer ei 2000-elements liste (legg_til-vekst) og slepp
// henne. Alle verdiar som lever gjennom heile køyringa blir allokerte PÅ NYTT kvar gong dei
// blir brukte (grensa i løkkevilkåret er ein literal, sum/maks blir tilordna kvar runde), so
// det lågaste levande objektet flyttar seg oppover syklus for syklus. Då er feilen frå
// minnet gc-sweep-prefix-leak synleg: ein sweep som startar på slutten av lm[0] (ikkje på
// gc_lo) frigjer aldri [gc_lo, lm[0]), og fronten veks med om lag ein port per collect
// (negativ kontroll i a4-rapporten: kryss-codegen med den gamle sweepen gjev exit 3; med
// NORSCODE_GC_TERSKEL_BYTES=4194304 ved codegen blir det 616 collects). Med rett sweep ligg fronten
// flatt. (Eit langlevande objekt allokert FØRST ville maskere feilen, sjå minnet.)
//
// Exit: 0 = OK (flat front, rett sum) · 2 = feil sum (korrupsjon) · 3 = fronten over
// HEAP_VA + 64 MiB + 4 × port (ratchet/lekk; med 4 MiB-port 80 MiB, flat er ~4 MiB).
// Sjekkar fronten kvar 256. iterasjon og avsluttar med 3 med ein gong taket er passert → raud
// på sekund, ikkje timeout.
funksjon lag_liste(n: heiltall) -> liste {
    la ut: liste = []
    la j = 0
    mens j < n {
        legg_til(ut, j)
        j = j + 1
    }
    returner ut
}

funksjon heap_va() -> heiltall {
    la hb: heiltall = builtin.heap_bump()
    returner hb - (hb % 68719476736)
}

funksjon start() -> heiltall {
    la i: heiltall = 0
    la sum: heiltall = 0
    la maks: heiltall = 0
    mens i < 20000 {
        la l = lag_liste(2000)
        sum = sum + lengde(l) + l[1999] - 1999
        hvis i % 256 == 0 {
            la b: heiltall = builtin.heap_bump() - heap_va()
            hvis b > maks { maks = b }
            // Tak: 64 MiB + 4 × port_dyn ([HEAP_VA+16]) — flat front ligg rundt éin port over gc_lo.
            la tak: heiltall = 67108864 + 4 * builtin.raw_load64(heap_va() + 16)
            hvis b > tak {
                skriv("gc_ratchet_arm64 FEIL: front=HEAP_VA+" + tekst(b) + " > tak HEAP_VA+" + tekst(tak) + " ved iterasjon " + tekst(i) + " (bump-ratchet / prefiks-lekk)\n")
                returner 3
            }
        }
        maks = maks + 0
        i = i + 1
    }
    la slutt: heiltall = builtin.heap_bump() - heap_va()
    skriv("gc_ratchet_arm64: iter=20000 sum=" + tekst(sum) + " maks_front=HEAP_VA+" + tekst(maks) + " slutt_front=HEAP_VA+" + tekst(slutt) + " collects=" + tekst(builtin.raw_load64(heap_va() + 80)) + "\n")
    hvis sum != 2000 * 20000 {
        skriv("gc_ratchet_arm64 FEIL: sum=" + tekst(sum) + " venta " + tekst(2000 * 20000) + "\n")
        returner 2
    }
    skriv("gc_ratchet_arm64 OK: flat front (maks " + tekst(maks / 1048576) + " MiB over HEAP_VA)\n")
    returner 0
}
