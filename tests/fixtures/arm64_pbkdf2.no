// arm64: builtin.pbkdf2_sha256 er native (emit_pbkdf2; passord/salt som tekst, som std.krypto
// sender). RFC 7914 / RFC 6070-stil vektorar for PBKDF2-HMAC-SHA256, òg nøkkel > 64 byte.
funksjon start() -> heiltall {
    skriv(builtin.pbkdf2_sha256("password", "salt", 1, 32) + "\n")
    skriv(builtin.pbkdf2_sha256("password", "salt", 2, 32) + "\n")
    skriv(builtin.pbkdf2_sha256("password", "salt", 4096, 32) + "\n")
    skriv(builtin.pbkdf2_sha256("passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, 32) + "\n")
    skriv(builtin.pbkdf2_sha256("passwd", "salt", 1, 16) + "\n")
    la langt = "0123456789012345678901234567890123456789012345678901234567890123456789"
    skriv(builtin.pbkdf2_sha256(langt, "salt", 3, 32) + "\n")
    returner 0
}
