// Fase 3: streng-`+`-konkatenering (runtime type-dispatch) + lengde(streng),
// saman med heiltalsaddisjon for å prøve at `+` framleis fungerer for int.
// Forventa: stdout "Hei verden!", exit 12 (lengde("abcde")=5 + (3+4)=7).
funksjon start() -> heiltall {
    la a = "Hei "
    la b = "verden"
    skriv(a + b)
    skriv("!")
    la n = lengde("abcde")
    la m = 3 + 4
    returner n + m
}
