// gc_envgc_probe.no — miljo_sett-overlayet (og modulglobalar i verts-ABI-sida)
// må overleve GC-collect: rotskannet var berre native stakk → overlay-mappet vart
// sweepa → miljo_hent gav "" etter fyrste collect (Gen1-ELF i stage-0 fann ikkje
// NORSCODE_ROOT: «Kan ikkje opne fil: /selfhost/lexer/lexer_m1.nors»).
// Krev NORSCODE_GC_ALLOC=1 ved codegen. Exit 0 = overlay + global overlever.
la global_kart: ordbok_tekst = {"g": "global-verdi"}
funksjon støy(n: heiltall) -> heiltall {
    la i: heiltall = 0
    la sum: heiltall = 0
    mens i < n {
        la m: ordbok_tekst = {"k": "v" + tekst(i), "j": tekst(i * 2)}
        la l = [tekst(i), tekst(i + 1), tekst(i + 2)]
        sum = sum + lengde(m["k"]) + lengde(l)
        i = i + 1
    }
    returner sum
}
funksjon start() -> heiltall {
    miljo_sett("NC_GC_OVERLAY", "overlever")
    la før = miljo_hent("NC_GC_OVERLAY")
    støy(3000)
    builtin.gc_collect_native()
    støy(3000)
    builtin.gc_collect_native()
    la etter = miljo_hent("NC_GC_OVERLAY")
    skriv("før=[" + før + "] etter=[" + etter + "] global=[" + global_kart["g"] + "]\n")
    hvis før != "overlever" { returner 3 }
    hvis etter != "overlever" { returner 4 }
    // NB: modulglobal med map-literal les tom i BEGGE layout (eige, eldre codegen-
    // gap for toppnivå-initialisering — ikkje GC). Rapportert, ikkje asserta.
    skriv("envgc OK\n")
    returner 0
}
