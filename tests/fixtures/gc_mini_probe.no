// Mini-uttrykkstolk: token → rekursiv parse → evaluer, med symboltabell (map) + unnatak.
funksjon tokeniser(s: tekst) -> liste {
    la toks: liste = []
    la i: heiltall = 0
    mens i < lengde(s) {
        la c = builtin.slice(s, i, i + 1)
        hvis c == " " { i = i + 1  fortsett }
        hvis c == "+" eller c == "*" eller c == "(" eller c == ")" {
            legg_til(toks, c)  i = i + 1  fortsett
        }
        // tal (fleirsifra)
        la j: heiltall = i
        mens j < lengde(s) og builtin.index_of("0123456789", builtin.slice(s, j, j+1)) >= 0 { j = j + 1 }
        hvis j > i { legg_til(toks, builtin.slice(s, i, j))  i = j  fortsett }
        kast "ukjent teikn: " + c
    }
    returner toks
}
funksjon eval_uttrykk(toks: liste, pos: liste) -> heiltall {
    la v = eval_term(toks, pos)
    mens pos[0] < lengde(toks) og toks[pos[0]] == "+" {
        pos[0] = pos[0] + 1
        v = v + eval_term(toks, pos)
    }
    returner v
}
funksjon eval_term(toks: liste, pos: liste) -> heiltall {
    la v = eval_faktor(toks, pos)
    mens pos[0] < lengde(toks) og toks[pos[0]] == "*" {
        pos[0] = pos[0] + 1
        v = v * eval_faktor(toks, pos)
    }
    returner v
}
funksjon eval_faktor(toks: liste, pos: liste) -> heiltall {
    hvis pos[0] >= lengde(toks) { kast "uventa slutt" }
    la t = toks[pos[0]]
    hvis t == "(" {
        pos[0] = pos[0] + 1
        la v = eval_uttrykk(toks, pos)
        hvis pos[0] >= lengde(toks) eller toks[pos[0]] != ")" { kast "manglar )" }
        pos[0] = pos[0] + 1
        returner v
    }
    pos[0] = pos[0] + 1
    returner heltall(t)
}
funksjon rekn(s: tekst) -> heiltall {
    la toks = tokeniser(s)
    la pos: liste = [0]
    returner eval_uttrykk(toks, pos)
}
funksjon start() -> heiltall {
    // symboltabell av uttrykk→forventa
    la fasit: ordbok = {}
    map_set(fasit, "2+3*4", 14)
    map_set(fasit, "(2+3)*4", 20)
    map_set(fasit, "10+20+30", 60)
    map_set(fasit, "2*3*4", 24)
    la nøklar = ["2+3*4", "(2+3)*4", "10+20+30", "2*3*4"]
    // køyr mange gonger → collect medan alt er levande
    la iter: heiltall = 0
    mens iter < 500 {
        la ki: heiltall = 0
        mens ki < lengde(nøklar) {
            la uttr = nøklar[ki]
            la fikk = rekn(uttr)
            hvis fikk != map_get(fasit, uttr) { returner 100 + ki }
            ki = ki + 1
        }
        iter = iter + 1
    }
    // feilhandtering
    la feil_ok: heiltall = 0
    prøv { la x = rekn("2+@") } fang (e) { feil_ok = 1 }
    hvis feil_ok != 1 { returner 200 }
    skriv("mini-tolk OK: 2000 evalueringar + symboltabell + unnatak overlevde collect\n")
    returner 0
}
