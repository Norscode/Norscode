// bytes_to_text (byte→streng) + fil_skriv_binær (byte→fil). bytes via bytes_from_list.
funksjon start() -> heiltall {
    la data = builtin.bytes_from_list([72, 101, 108, 108, 111])
    la t = builtin.bytes_to_text(data)
    la a = lengde(t)
    la p = "/tmp/nc_arm64_bytesio.bin"
    builtin.fil_skriv_binær(p, builtin.bytes_from_list([65, 66, 67]))
    la back = builtin.fil_les(p)
    a = a + lengde(back)
    a = a + builtin.char_code(builtin.slice(back, 0, 1))
    builtin.fil_slett(p)
    returner a & 255
}
