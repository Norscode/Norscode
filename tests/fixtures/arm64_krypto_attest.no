// Native ARM64 krypto/TLS-attestasjon (null OpenSSL). Éin binær som stadfestar
// heile TLS_CHACHA20_POLY1305_SHA256-flata: SHA-512 (NIST), og full TLS 1.3-
// handtrykk (X25519 ECDHE + Ed25519 CertVerify + HKDF + ChaCha20-Poly1305 record).
bruk std.sha512 som sha
bruk std.tls13_handshake_flow som flow
funksjon _seed(base: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []  la i = 0
    mens i < 32 { legg_til(ut, (base + i * 7) & 255)  i = i + 1 }
    returner ut
}
funksjon start() -> heiltall {
    hvis sha.hash("abc") != "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" { returner 1 }
    la r = flow.handshake_loopback({"c_priv": _seed(1), "s_priv": _seed(101), "s_id_seed": _seed(200)})
    hvis ikkje r["ecdhe_lik"] { returner 2 }
    hvis ikkje r["cv_ok"] { returner 3 }
    hvis ikkje r["server_finished_ok"] { returner 4 }
    hvis ikkje r["client_finished_ok"] { returner 5 }
    hvis ikkje r["app_data_ok"] { returner 6 }
    hvis ikkje r["cv_reject_tamper"] { returner 7 }
    hvis lengde(r["shared"]) != 32 { returner 8 }
    skriv("ARM64 KRYPTO/TLS ATTESTASJON: GROEN (null OpenSSL)\n")
    returner 0
}
