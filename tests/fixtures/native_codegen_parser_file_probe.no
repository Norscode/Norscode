bruk selfhost.lexer.lexer_m1
bruk selfhost.parser

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/runtime_basics_probe_v4200.no")
    skriv("PARSER_FILE_PROBE_LEX_START\n")
    la tokens = selfhost.lexer.lexer_m1.lex(kjelde)
    skriv("PARSER_FILE_PROBE_TOKENS=" + tekst(lengde(tokens)) + "\n")
    la ast = selfhost.parser.parse_program(tokens)
    skriv("PARSER_FILE_PROBE_NODES=" + tekst(lengde(ast["barn"])) + "\n")
    skriv("PARSER_FILE_PROBE_OK\n")
    returner 0
}
