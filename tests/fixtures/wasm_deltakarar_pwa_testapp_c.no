# Tredje versjon av testappen for oppdateringsflyten (W8, tests/test_wasm_w8_oppdatering.no):
# offline-teksten er endra igjen, og ein ny versjon blir teken i bruk automatisk når det berre
# finst éi fane (standarden i std/wasm_pwa.no).
bruk std.wasm_pwa som pwa
bruk tests.fixtures.wasm_deltakarar_pwa_testapp som a

funksjon pwa_konfig() -> ordbok {
    la k = a.pwa_konfig()
    pwa.med_offline_side(k, "Deltakarar: du er fråkopla (versjon C)", "Denne sida finst ikkje på eininga.")
    pwa.med_aktivering(k, sann)
    returner k
}

funksjon start() -> heltall {
    returner 0
}
