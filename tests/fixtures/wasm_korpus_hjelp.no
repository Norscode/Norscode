# Hjelparar for paritetskorpuset i WASM-sporet (W1): fasitane i korpusfilene, køyring i
# VM-en (barne-`nc run`), bygg for nettlesaren og ein generert serve-app med éi side per
# program. Alt som blir skrive, hamnar under build/wasm/.
bruk tests.fixtures.wasm_test_hjelp som hjelp

# Paritetsprogramma i tests/wasm_korpus/ (kvart har ein fasit i «#=»-linjer).
funksjon korpus_w1() -> liste {
    returner ["fak", "tekst_utf8", "flyt", "liste", "ordbok_orden", "blanda", "feil_div", "feil_indeks", "feil_heltall"]
}

funksjon kjelde(namn: tekst) -> tekst {
    returner "tests/wasm_korpus/" + namn + ".no"
}

# Fasiten: linjene som byrjar med «#= », utan prefikset, kvar avslutta med linjeskift.
funksjon fasit(namn: tekst) -> tekst {
    la src = fil_les(hjelp.root() + "/" + kjelde(namn))
    la linjer = builtin.split(src, "\n")
    la ut = ""
    la i = 0
    mens i < lengde(linjer) {
        la l = tekst(linjer[i])
        hvis builtin.starts_with(l, "#= ") {
            ut = ut + builtin.slice(l, 3, lengde(l)) + "\n"
        } ellers hvis l == "#=" {
            ut = ut + "\n"
        }
        i = i + 1
    }
    returner ut
}

# Køyr programmet i VM-en (fastmodus) og gjev stdout utan VM-ens avsluttande statuslinje.
funksjon køyr_vm(namn: tekst) -> ordbok {
    la rot = hjelp.root()
    la m = hjelp.grunnmiljø(rot)
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = rot + "/" + kjelde(namn)
    m["NORSCODE_VM_FAST"] = "1"
    la r = hjelp.køyr_nc(m, 300000)
    la ut = r["stdout"]
    la hale = "[vm] entry returned\n"
    hvis builtin.ends_with(ut, hale) { ut = builtin.slice(ut, 0, lengde(ut) - lengde(hale)) }
    returner {"ut": ut, "exit": r["exit"], "stderr": r["stderr"]}
}

# Første linja der a og b skil seg (for feilmeldingar).
funksjon skilnad(a: tekst, b: tekst) -> tekst {
    la la_ = builtin.split(a, "\n")
    la lb = builtin.split(b, "\n")
    la i = 0
    mens i < lengde(la_) eller i < lengde(lb) {
        la x = "<slutt>"
        la y = "<slutt>"
        hvis i < lengde(la_) { x = tekst(la_[i]) }
        hvis i < lengde(lb) { y = tekst(lb[i]) }
        hvis x != y { returner "linje " + tekst(i + 1) + ": «" + x + "» mot «" + y + "»" }
        i = i + 1
    }
    returner "(like)"
}

funksjon _no_streng(s: tekst) -> tekst {
    la bs = "\\"
    la q = "\""
    returner q + builtin.replace(builtin.replace(s, bs, bs + bs), q, bs + q) + q
}

# Serve-app (Norscode-kjelde) med sida /k/<namn>, lastaren og modulen for kvart program.
# Modulane ligg i build/wasm/<rot>/<namn>/klient_data.no (bygde med prefikset /_nc/<namn>/).
funksjon app_kjelde(rot: tekst, namn: liste) -> tekst {
    la modulrot = builtin.replace(rot, "/", ".")
    la csp = "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    la ut = "# GENERERT av tests/fixtures/wasm_korpus_hjelp.no. Ikkje rediger og ikkje commit (ligg under build/).\n"
    ut = ut + "bruk std.web som web\n"
    la i = 0
    mens i < lengde(namn) {
        ut = ut + "bruk " + modulrot + "." + namn[i] + ".klient_data som k_" + namn[i] + "\n"
        i = i + 1
    }
    ut = ut + "\nfunksjon svar(ct: tekst, body: tekst) -> ordbok_tekst {\n"
    ut = ut + "    la h = {}\n"
    ut = ut + "    h[\"content-security-policy\"] = " + _no_streng(csp) + "\n"
    ut = ut + "    h[\"x-content-type-options\"] = \"nosniff\"\n"
    ut = ut + "    h[\"cache-control\"] = \"no-cache\"\n"
    ut = ut + "    returner {\"status\": 200, \"content_type\": ct, \"body\": body, \"headers\": h}\n}\n\n"
    ut = ut + "funksjon hex_til_rå(h: tekst) -> tekst {\n"
    ut = ut + "    la hs = \"0123456789abcdef\"\n    la ut = \"\"\n    la i = 0\n"
    ut = ut + "    mens i + 1 < lengde(h) {\n"
    ut = ut + "        ut = ut + builtin.chr(builtin.index_of(hs, builtin.slice(h, i, i + 1)) * 16 + builtin.index_of(hs, builtin.slice(h, i + 1, i + 2)))\n"
    ut = ut + "        i = i + 2\n    }\n    returner ut\n}\n"
    i = 0
    mens i < lengde(namn) {
        la n = namn[i]
        la side = "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>" + n + "</title>" +
            "<script src=\"/_nc/" + n + "/nc.js?v="
        la side2 = "\" defer></script></head><body><pre id=\"nc-logg\"></pre></body></html>"
        ut = ut + "\nfunksjon side_" + n + "(ctx: ordbok_tekst) -> ordbok_tekst {\n"
        ut = ut + "    web.route(\"GET /k/" + n + "\")\n"
        ut = ut + "    returner svar(\"text/html; charset=utf-8\", " + _no_streng(side) + " + k_" + n + ".lastar_versjon() + " + _no_streng(side2) + ")\n}\n"
        ut = ut + "\nfunksjon lastar_" + n + "(ctx: ordbok_tekst) -> ordbok_tekst {\n"
        ut = ut + "    web.route(\"GET /_nc/" + n + "/nc.js\")\n"
        ut = ut + "    returner svar(\"text/javascript; charset=utf-8\", k_" + n + ".lastar())\n}\n"
        ut = ut + "\nfunksjon modul_" + n + "(ctx: ordbok_tekst) -> ordbok_tekst {\n"
        ut = ut + "    web.route(\"GET /_nc/" + n + "/app.wasm\")\n"
        ut = ut + "    returner svar(\"application/wasm\", hex_til_rå(k_" + n + ".wasm_hex()))\n}\n"
        i = i + 1
    }
    ut = ut + "\nfunksjon start() -> heltall {\n    returner 0\n}\n"
    returner ut
}

# Talet på byte i «app.wasm <n> byte» i WASM-linja frå tools/nc_wasm.no.
funksjon storleik(linje: tekst) -> tekst {
    la p = builtin.index_of(linje, "app.wasm ")
    hvis p < 0 { returner "?" }
    la rest = builtin.slice(linje, p + 9, lengde(linje))
    la s = builtin.index_of(rest, " ")
    hvis s < 0 { returner rest }
    returner builtin.slice(rest, 0, s)
}
