// Fixture for tests/test_fastapi_hol_serve.no: FastAPI-hola frå matrisa 07.10
// (OpenAPI-markørar, 400/422-mapping, fleire Set-Cookie, strøyming) under ekte
// `nc serve` (NORSCODE_FAKE_HTTP_REQUESTS → serve_handle_one).
bruk std.web som web
bruk std.docs_side som docs

funksjon merka(ctx) -> tekst {
    web.route("GET /merka")
    web.tags("varer")
    web.beskriving("Hent merka")
    web.forelda()
    web.respons("404", "Ikkje funne")
    returner "merka"
}

funksjon skjult(ctx) -> tekst {
    web.route("GET /skjult")
    web.skjul()
    returner "skjult"
}

funksjon oa(ctx) {
    web.route("GET /openapi.json")
    returner {"status": 200, "content_type": "application/json", "body": web.openapi_json("Hol", "1")}
}

funksjon dok(ctx) {
    web.route("GET /docs")
    returner docs.docs_respons({"tittel": "Hol"}, usann)
}
