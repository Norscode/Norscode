// Builtin-hale batch 3: tekst_erstatt/tekst_starter_med/nøkkel_finnes/json_skriv-aliasar.
funksjon start() -> heiltall {
    la s = tekst_erstatt("hello world", "world", "there")   // "hello there"
    la a = 0
    hvis tekst_starter_med(s, "hello") { a = a + 10 }
    la kart = {"x": 1, "y": 2}
    hvis nøkkel_finnes(kart, "x") { a = a + 5 }
    hvis nøkkel_finnes(kart, "z") { a = a + 100 }
    la js = json_skriv(kart)
    a = a + lengde(js)
    returner a
}
