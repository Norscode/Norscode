// gc_closure_arm64_probe.no — closures overlever GC (A34, AArch64, GC-modus: NORSCODE_GC_ALLOC=1
// ved codegen; gjerne NORSCODE_GC_TERSKEL_BYTES=4194304 for mange collects).
//
// A3 flytta closure-taggen frå 6 til 8 (tagg 6 = desimaltal, payload = IEEE-bitane), medan A4-
// markøren følgde closure-data på tagg 6. Fletta utan retting vart ein closure-boks (tagg 8)
// eit blad: closure-data (16 B: fn_addr + capture-kart) vart aldri merkt, sweepen frigjorde
// blokka, og neste 16 B-allokering (ein boks) skreiv over fn_addr → CALL_VALUE hoppa i heapen.
// Proben byggjer closures som fangar ferske strengar og lister, churnar so det blir fleire
// collects, og kallar closurane etterpå. Negativ kontroll i a34-rapporten: kryss-codegen der
// markøren følgjer tagg 6 gjev SIGSEGV (139) eller feil sjekksum (2).
//
// Exit: 0 = OK · 2 = feil verdi frå ein closure (fangst øydelagd) · 4 = færre enn 2 collects
// (proben har då ikkje prøvd noko — sjå port/terskel).
//
// gc-integ (#204): her har closures framleis tagg 6, same som desimaltal. Markøren (arm64_gc.no,
// TAGG_CLOSURE) følgjer difor tagg 6 med validering (16-aligna payload i [gc_lo, bump)), og
// proben prøver at closure-data og capture-kart overlever collect på denne layouten.
funksjon heap_va() -> heiltall {
    la hb: heiltall = builtin.heap_bump()
    returner hb - (hb % 68719476736)
}

funksjon sjekk(s: tekst) -> heiltall {
    la h: heiltall = 7
    la i: heiltall = 0
    mens i < lengde(s) {
        h = (h * 31 + builtin.char_code(builtin.slice(s, i, i + 1)) + i) % 1000003
        i = i + 1
    }
    returner h
}

funksjon lag_streng(i: heiltall) -> tekst {
    returner "fangst-" + tekst(i) + "-" + tekst(i * 7919) + "-ende"
}

funksjon lag_liste(i: heiltall) -> liste {
    la l: liste = []
    la j: heiltall = 0
    mens j < 5 + (i % 7) {
        legg_til(l, i * 100 + j)
        j = j + 1
    }
    returner l
}

funksjon lag(i: heiltall) {
    la s = lag_streng(i)
    la l = lag_liste(i)
    la n: heiltall = i * 3
    returner fun(x: heiltall) -> sjekk(s) * 10 + lengde(l) * 1000000 + l[lengde(l) - 1] + n + x
}

funksjon venta(i: heiltall, x: heiltall) -> heiltall {
    la l = lag_liste(i)
    returner sjekk(lag_streng(i)) * 10 + lengde(l) * 1000000 + l[lengde(l) - 1] + i * 3 + x
}

funksjon churn(n: heiltall) -> heiltall {
    la i: heiltall = 0
    la sum: heiltall = 0
    mens i < n {
        la l = []
        la j: heiltall = 0
        mens j < 200 {
            legg_til(l, "støy" + tekst(j))
            j = j + 1
        }
        sum = sum + lengde(l)
        i = i + 1
    }
    returner sum
}

funksjon kontroller(fl, antal: heiltall, x: heiltall) -> heiltall {
    la i: heiltall = 0
    mens i < antal {
        la f = fl[i]
        la v: heiltall = f(x)
        la e: heiltall = venta(i, x)
        hvis v != e {
            skriv("gc_closure_arm64 FEIL: closure " + tekst(i) + " gav " + tekst(v) + ", venta " + tekst(e) + "\n")
            returner 2
        }
        i = i + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la fl = []
    la i: heiltall = 0
    mens i < 48 {
        legg_til(fl, lag(i))
        i = i + 1
    }
    la c: heiltall = churn(15000)
    hvis kontroller(fl, 48, 5) != 0 { returner 2 }
    mens i < 96 {
        legg_til(fl, lag(i))
        i = i + 1
    }
    c = c + churn(15000)
    hvis kontroller(fl, 96, 11) != 0 { returner 2 }
    la collects: heiltall = builtin.raw_load64(heap_va() + 80)
    skriv("gc_closure_arm64: closures=96 churn=" + tekst(c) + " collects=" + tekst(collects) + "\n")
    hvis collects < 2 {
        skriv("gc_closure_arm64 FEIL: berre " + tekst(collects) + " collects — proben prøvde ingenting\n")
        returner 4
    }
    skriv("gc_closure_arm64 OK\n")
    returner 0
}
