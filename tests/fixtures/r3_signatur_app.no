// R3 trinn 8 (3.1–3.5): handlarar med typa signatur (FastAPI-stil).
// Brukt av tests/test_r3_signaturbinding.no (apptenar) og
// tests/test_r3_signaturmetadata.no (kompilatoren sin rutemetadata).
bruk std.web som web

struktur Adresse {
    gate: tekst
    nr: heltall
}

struktur Person {
    namn: tekst
    alder: heltall = 0
    adresse: Adresse
}

struktur PersonUt {
    id: heltall
    namn: tekst
    aktiv: boolsk = sann
}

// Stiparameter med type + valfri query-parameter; returtypen filtrerer svaret.
funksjon hent_person(ctx, id: heltall, detaljar: boolsk = usann) -> PersonUt {
    web.route("GET /personar/{id}")
    returner {"id": id + 1, "namn": "Ada", "passord": "hemmeleg", "detaljar": detaljar}
}

// Same signatur utan returtype: svaret blir ikkje filtrert.
funksjon ekko(ctx, id: heltall, detaljar: boolsk = usann) {
    web.route("GET /ekko/{id}")
    returner {"id": id + 1, "detaljar": detaljar}
}

// Utan ctx: berre query-parametrar (påkravd tekst, heltall med standard).
funksjon sok(q: tekst, n: heltall = 10) {
    web.route("GET /sok")
    returner {"q": q, "dobbel": n * 2}
}

// Strukturtype frå JSON-kroppen (nøsta struktur inni).
funksjon lag_person(ctx, p: Person) {
    web.route("POST /personar")
    returner {"namn": p.namn, "alder_neste": p.alder + 1, "gate": p.adresse.gate, "nr_neste": p.adresse.nr + 1, "type": builtin.typenamn(p)}
}

// Fleire strukturparametrar: kroppen er {"a": {...}, "p": {...}}.
funksjon to_kroppar(a: Adresse, p: Person) {
    web.route("POST /to")
    returner {"gate": a.gate, "namn": p.namn}
}

// Utypa parameter med namnet til ein stiparameter: bunden som tekst.
funksjon utypa(ctx, slug) {
    web.route("GET /utypa/{slug}")
    returner {"slug": slug}
}

// {n:int} i mønsteret og utypa parameter: typen frå mønsteret gjeld.
funksjon talrute(ctx, n) {
    web.route("GET /tal/{n:int}")
    returner {"n_neste": n + 1}
}

// Bakoverkompatibelt: berre ctx.
funksjon gamal(ctx) {
    web.route("GET /gamal")
    returner {"q": web.request_query_param(ctx, "q")}
}

// Bakoverkompatibelt: ctx + avhengnad posisjonelt (namnet er ulikt dep-namnet).
funksjon db_dep(ctx) {
    web.dependency("db")
    returner "DB"
}

funksjon med_dep(ctx, handle) {
    web.route("GET /dep")
    web.use_dependency("db")
    returner {"db": handle}
}

// Liste av strukturar som returtype, liste-query med elementtype og valfri query.
funksjon personliste(ctx, t: liste<heltall>, merke: tekst?) -> liste<PersonUt> {
    web.route("GET /personliste")
    la ut = []
    la i = 0
    mens i < lengde(t) {
        legg_til(ut, {"id": t[i] * 10, "namn": "P", "hemmeleg": 1})
        i = i + 1
    }
    hvis merke == null {
        legg_til(ut, {"id": 0, "namn": "utan-merke"})
    }
    returner ut
}

// Liste av strukturar i kroppen.
funksjon adresser(ctx, a: liste<Adresse>) {
    web.route("POST /adresser")
    returner {"n": lengde(a), "nr_neste": a[0].nr + 1, "type": builtin.typenamn(a[0])}
}
