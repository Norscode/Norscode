// AOT (linux-x86_64): assert/assert_eq/assert_ne er ekte sjekkar (fangbare, VM-tekst)
// og std.bytes.ny/tom gjev bytes (type 7) utan native_gap i bunten. Exit 7 når alt stemmer.
bruk std.bytes som bytes

funksjon start() -> heltall {
    assert(1 == 1)
    assert_eq(2 + 2, 4)
    assert_eq("ab", "a" + "b")
    assert_eq([1, 2, 3], [1, 2, 3])
    assert_ne(1, 2)
    la melding = ""
    prøv { assert_eq(1, 2) } fang (e) { melding = tekst(e) }
    hvis melding != "assert_eq feilet: 1 != 2" { returner 21 }
    prøv { assert_ne("x", "x") } fang (e) { melding = tekst(e) }
    hvis melding != "assert_ne feilet: x == x" { returner 22 }
    prøv { assert(usann) } fang (e) { melding = tekst(e) }
    hvis melding != "assert feilet" { returner 23 }

    la b = bytes.ny(4, 9)
    hvis type_av(b) != "bytes" { returner 31 }
    hvis lengde(b) != 4 eller b[0] != 9 eller b[3] != 9 { returner 32 }
    b[1] = 42
    hvis b[1] != 42 eller b[2] != 9 { returner 33 }
    la t = bytes.tom()
    hvis type_av(t) != "bytes" eller lengde(t) != 0 { returner 34 }
    hvis builtin.bytes_new(3, 256 + 7)[2] != 7 { returner 35 }
    la i: heltall = 0
    mens i < 2000 {
        hvis lengde(bytes.ny(32, i % 256)) != 32 { returner 36 }
        i = i + 1
    }
    returner 7
}
