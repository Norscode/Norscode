// R2 / F24 (+ F23 på x86): typa fang, endeleg og utsett i AOT. Fixturen samanliknar
// sjølv med VM-fasiten og returnerer 42 når alt stemmer (elles skriv han avviket, exit 1).

funksjon del(a: heiltall, b: heiltall) -> heiltall { returner a / b }

funksjon typa() -> tekst {
    la spor = ""
    prøv { kast "FilFeil: fila manglar" } fang (e: FilFeil) { spor = spor + "A" }
    prøv {
        prøv { kast "NettFeil: brote" } fang (e: FilFeil) { spor = spor + "X" }
    } fang (e) { spor = spor + "B" }
    prøv {
        la f: ordbok_tekst = {}
        f["type"] = "ValideringsFeil"
        kast f
    } fang (e: ValideringsFeil) { spor = spor + "C" }
    prøv { kast "utan kolon" } fang (e: tekst) { spor = spor + "D" }
    prøv { la x = del(1, 0)  spor = spor + "x" + tekst(x) } fang (e: DivisjonMedNull) { spor = spor + "E" }
    prøv {
        la l = [1, 2]
        la i = 9
        spor = spor + tekst(l[i])
    } fang (e: IndeksFeil) { spor = spor + "F[" + tekst(e) + "]" }
    returner spor
}

funksjon a_normal(logg: liste_tekst) -> heiltall {
    prøv { legg_til(logg, "a") } endeleg { legg_til(logg, "a-e") }
    returner 0
}
funksjon c_indre(logg: liste_tekst) -> heiltall {
    prøv { kast "CFeil: c" } endeleg { legg_til(logg, "c-e") }
    legg_til(logg, "c-FEIL")
    returner 0
}
funksjon c_ytre(logg: liste_tekst) -> heiltall {
    prøv { c_indre(logg) } fang (e: CFeil) { legg_til(logg, "c-fang") }
    returner 0
}
funksjon d_retur(logg: liste_tekst) -> heiltall {
    prøv { returner 42 } endeleg { legg_til(logg, "d-e") }
    returner -1
}
funksjon e_retur_i_endeleg(logg: liste_tekst) -> heiltall {
    prøv { returner 1 } endeleg { legg_til(logg, "e-e")  returner 2 }
    returner -1
}
funksjon g_bryt(logg: liste_tekst) -> heiltall {
    la i = 0
    mens i < 5 {
        prøv {
            hvis i == 2 { bryt }
            legg_til(logg, "g" + tekst(i))
        } endeleg { legg_til(logg, "g-e" + tekst(i)) }
        i = i + 1
    }
    returner i
}
funksjon u_lifo(logg: liste_tekst) -> heiltall {
    utsett { legg_til(logg, "u1") }
    utsett { legg_til(logg, "u2") }
    legg_til(logg, "u-kropp")
    returner 0
}
funksjon u_kast_indre(logg: liste_tekst) -> heiltall {
    utsett { legg_til(logg, "uk-utsett") }
    kast "UFeil: u"
    returner 0
}
funksjon u_kast(logg: liste_tekst) -> heiltall {
    prøv { u_kast_indre(logg) } fang (e: UFeil) { legg_til(logg, "uk-fang") }
    returner 0
}
funksjon u_retur(logg: liste_tekst) -> heiltall {
    la x = 1
    utsett { x = 99  legg_til(logg, "ur") }
    returner x
}

funksjon start() -> heiltall {
    la logg: liste_tekst = []
    a_normal(logg)
    c_ytre(logg)
    legg_til(logg, "d=" + tekst(d_retur(logg)))
    legg_til(logg, "e=" + tekst(e_retur_i_endeleg(logg)))
    legg_til(logg, "g=" + tekst(g_bryt(logg)))
    u_lifo(logg)
    u_kast(logg)
    legg_til(logg, "ur=" + tekst(u_retur(logg)))
    la ut = typa() + " | " + builtin.join(logg, ",")
    la fasit = "ABCDEF[IndeksFeil: indeks 9 utanfor lista (lengde 2) ved __main__.typa] | a,a-e,c-e,c-fang,d-e,d=42,e-e,e=2,g0,g-e0,g1,g-e1,g-e2,g=2,u-kropp,u2,u1,uk-utsett,uk-fang,ur,ur=1"
    hvis ut != fasit {
        skriv("AVVIK\n" + ut + "\n" + fasit + "\n")
        returner 1
    }
    returner 42
}
