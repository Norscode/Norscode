funksjon start() -> heiltall {
    la venta = miljo_hent("NC_RUNNER_EXPECTED_NATIVE")
    la executable = tekst(builtin.system_info()["executable"])
    la native = miljo_hent("NORSCODE_NATIVE_BIN")
    skriv("candidate-executable=" + executable + "\n")
    skriv("candidate-env=" + native + "\n")
    assert(venta != "")
    assert(executable == venta)
    assert(native == venta)
    returner 0
}
