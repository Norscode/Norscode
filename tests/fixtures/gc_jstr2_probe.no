funksjon start() -> heiltall {
    // NCB-like: liste av instruksjonar (kvar ei liste), + metadata-map
    la instr: liste = []
    legg_til(instr, ["PUSH_CONST", 42])
    legg_til(instr, ["LOAD_NAME", "x"])
    legg_til(instr, ["BINARY_ADD"])
    la prog: ordbok = {}
    map_set(prog, "namn", "start")
    map_set(prog, "kode", instr)
    // serialiser mange gonger → collect medan treet er levande
    la i: heiltall = 0
    la ut: tekst = ""
    mens i < 300 {
        ut = builtin.json_stringify(prog)
        i = i + 1
    }
    hvis builtin.index_of(ut, "PUSH_CONST") < 0 { returner 1 }
    hvis builtin.index_of(ut, "BINARY_ADD") < 0 { returner 2 }
    skriv("jstr2 OK: " + ut + "\n")
    returner 0
}
