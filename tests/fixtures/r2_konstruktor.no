# Fikstur for tests/test_r2_konstruktor.no (F05): posisjonelle konstruktørar,
# standardverdiar for felt, statiske kall Type.m() og alias.Type().
bruk tests.fixtures.r2_bank som bank

struktur Punkt {
    x: heltall
    y: heltall
}
struktur Konto {
    saldo: heltall = 100
    namn: tekst = "ukjend"
}
struktur punkt3 {
    x
}
funksjon Punkt.ny(x: heltall, y: heltall = 10) -> Punkt {
    returner Punkt(x, y)
}
funksjon Punkt.sum(self) -> heltall {
    returner self.x + self.y
}

funksjon vis(l) -> tekst {
    la s = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { s = s + "," }
        s = s + tekst(l[i])
        i = i + 1
    }
    returner s + "]"
}

funksjon start() -> tekst {
    la ut = []
    la p = Punkt(1, 2)
    legg_til(ut, "x=" + tekst(p.x) + " y=" + tekst(p.y) + " har_x=" + tekst(har_nokkel(p, "x")))
    la halv = Punkt(7)
    legg_til(ut, "halv=" + tekst(halv.x) + "/" + tekst(halv.y == ingenting))
    la k = Konto()
    legg_til(ut, "saldo=" + tekst(k.saldo) + " namn=" + k.namn)
    la k2 = Konto(5)
    legg_til(ut, "k2=" + tekst(k2.saldo) + "/" + k2.namn)
    la q = Punkt.ny(3, 4)
    legg_til(ut, "ny=" + tekst(q.sum()) + " nøklar=" + vis(nøkler(q)))
    legg_til(ut, "ny_std=" + tekst(Punkt.ny(1).sum()))
    la l = punkt3(9)
    legg_til(ut, "liten=" + tekst(l.x))
    la b = bank.Konto("Ada")
    legg_til(ut, "bank=" + b.eigar + "/" + tekst(b.saldo) + "/" + tekst(b.set_inn(50)) + " nøklar=" + vis(nøkler(b)))
    la b2 = bank.Konto.opna("Bo")
    legg_til(ut, "opna=" + b2.eigar + "/" + tekst(b2.saldo))
    returner builtin.join(ut, ";")
}
