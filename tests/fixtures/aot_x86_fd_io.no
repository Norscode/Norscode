// AOT-fikstur (relay X5, os-x86-io): rein fd-I/O og feilkode-skriving på linux-x86_64.
// Køyr med stdin frå eit røyr: `printf 'linje1\nlinje2\n' | ./elf <modus>` der argumentet
// vel modus via miljøvariabelen AOT_FD_MODUS:
//   stdin   → les_stdin() skal gje nøyaktig røyr-innhaldet (skriv det med fd_skriv(1, …))
//   fdles   → fd_les(0, 4) i lykkje til "" (EOF), sett saman
//   devstdin→ fil_les("/dev/stdin") på eit røyr skal lese til EOF (ikkje "")
//   fil     → fil_prøv_skriv: 0 på skrivbar sti, −errno (aldri unntak) på nekta/manglande sti
// Exit 42 = OK.
bruk std.native_gap

funksjon start() -> heiltall {
    la modus = miljo_hent("AOT_FD_MODUS")
    hvis modus == "stdin" {
        la t = les_stdin()
        la n = fd_skriv(1, "[" + t + "]\n")
        hvis n != lengde(t) + 3 { returner 3 }
        returner 42
    }
    hvis modus == "fdles" {
        la delar: liste_tekst = []
        la runde: heiltall = 0
        la ferdig = usann
        mens ikkje ferdig {
            la d = fd_les(0, 4)
            hvis d == "" { ferdig = sann } ellers { legg_til(delar, d) runde = runde + 1 }
        }
        fd_skriv(1, "[" + builtin.join(delar, "") + "] rundar=" + tekst_fra_heltall(runde) + "\n")
        returner 42
    }
    hvis modus == "devstdin" {
        la t = fil_les("/dev/stdin")
        fd_skriv(1, "[" + t + "]\n")
        hvis t == "" { returner 4 }
        returner 42
    }
    hvis modus == "fil" {
        la ok = fil_prøv_skriv("/tmp/aot_x86_fd_io_ok.txt", "innhald æøå\n")
        hvis ok != 0 { skriv("ok-sti gav " + tekst_fra_heltall(ok) + "\n") returner 5 }
        hvis fil_les("/tmp/aot_x86_fd_io_ok.txt") != "innhald æøå\n" { returner 6 }
        la mangl = fil_prøv_skriv("/finst/ikkje/mappe/x.txt", "x")
        la kat = fil_prøv_skriv("/tmp", "x")
        la tom = fil_prøv_skriv("", "x")
        la nekta = fil_prøv_skriv("/proc/version", "x")
        skriv("manglande=" + tekst_fra_heltall(mangl) + " katalog=" + tekst_fra_heltall(kat) +
              " tom=" + tekst_fra_heltall(tom) + " nekta=" + tekst_fra_heltall(nekta) + "\n")
        hvis mangl != 0 - 2 { returner 7 }    // ENOENT
        hvis kat != 0 - 21 { returner 8 }     // EISDIR
        hvis tom != 0 - 22 { returner 9 }     // EINVAL
        hvis nekta >= 0 { returner 10 }       // EACCES/EPERM/EIO (Docker: /proc er ro for root òg)
        returner 42
    }
    skriv("ukjent AOT_FD_MODUS=" + modus + "\n")
    returner 2
}
