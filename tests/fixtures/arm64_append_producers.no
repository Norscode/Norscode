// A0-review: legg_til på ei liste frå ein køyretids-produsent. Den amortiserte
// emit_legg_til skriv på plass når count ikkje er ein toarpotens, så produsenten
// må reservere next_pow2(count) slots — elles går skrivinga inn i neste objekt.
// Her: json-array, fil_les_binær (via bytes_to_list) og bytes_new. json_parse_raw
// fordi json_parse i VM-en gjev ei ordbok for array; slik er VM == native (225).
funksjon start() -> heiltall {
    la j = builtin.json_parse_raw("[1,2,3]")
    legg_til(j, 30)
    la z = [40]
    la p = "/tmp/nc_arm64_append_bin.bin"
    builtin.fil_skriv_binær(p, builtin.bytes_from_list([1, 2, 3, 4, 5]))
    la f = builtin.bytes_to_list(builtin.fil_les_binær(p))
    builtin.fil_slett(p)
    legg_til(f, 50)
    la w = [60]
    la b = builtin.bytes_to_list(bytes_new(5, 1))
    legg_til(b, 9)
    la y = [20]
    returner lengde(j) + j[3] + z[0] + lengde(f) + f[5] + w[0] + lengde(b) + b[5] + y[0]
}
