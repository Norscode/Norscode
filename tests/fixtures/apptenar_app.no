# Testapp for std/apptenar.no (tests/test_apptenar_integrasjon.no og målingane i
# docs/APPTENAR_SYNK.md). Konfigurasjonen kjem frå miljøet (krev env.read):
#   APPTENAR_DATA   datamappa (absolutt); disk-testane skriv berre der
#   APPTENAR_HB_MS  SSE-heartbeat (standard 25000)
#   APPTENAR_MAKS   maks tilkoplingar (standard 64)
#   APPTENAR_MS     tidsgrense for heile prosessen (standard 120000)
bruk std.web som web
bruk std.apptenar som app
bruk std.runtime.process_abi som process_abi

la _teljar: ordbok = {"n": 0}

funksjon _miljø(namn: tekst, standard: tekst) -> tekst {
    la v = ""
    prøv { v = builtin.miljo_hent(namn) } fang (e) { v = "" }
    hvis v == "" { returner standard }
    returner v
}

funksjon heim(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /")
    returner {"status": 200, "content_type": "text/html; charset=utf-8", "etag": "\"heim-v1\"",
              "body": "<!doctype html><title>heim</title><p>Hei frå apptenaren</p>",
              "headers": {"cache-control": "no-cache", "vary": "x-norscode-fragment"}}
}

funksjon om(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /om")
    returner {"status": 200, "content_type": "text/plain; charset=utf-8", "body": "om"}
}

funksjon ren_tekst(ctx: ordbok_tekst) -> tekst {
    web.route("GET /tekst")
    returner "berre tekst"
}

funksjon teljar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /teljar")
    _teljar["n"] = _teljar["n"] + 1
    returner {"status": 200, "body": tekst(_teljar["n"])}
}

funksjon vakt_kastar(ctx: ordbok_tekst) -> bool {
    web.guard()
    kast "vakta kasta med vilje"
}

funksjon vakt_nei(ctx: ordbok_tekst) -> bool {
    web.guard()
    returner usann
}

funksjon med_kastande_vakt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("vakt_kastar")
    web.route("GET /vakt/kastar")
    returner {"status": 200, "body": "skulle ikkje kome hit"}
}

funksjon med_nei_vakt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("vakt_nei")
    web.route("GET /vakt/nei")
    returner {"status": 200, "body": "skulle ikkje kome hit"}
}

funksjon kastar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /kastar")
    kast "handlaren kasta med vilje"
}

funksjon disk_inne(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /disk/inne")
    la sti = _miljø("APPTENAR_DATA", "/finst/ikkje") + "/inne.txt"
    fil_skriv(sti, "skrive i datamappa")
    returner {"status": 200, "body": fil_les(sti)}
}

funksjon disk_ute(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /disk/ute")
    fil_skriv(_miljø("APPTENAR_DATA", "/finst/ikkje") + "/../utanfor.txt", "skal ikkje skrivast")
    returner {"status": 200, "body": "skreiv utanfor"}
}

funksjon les_ute(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /disk/les")
    returner {"status": 200, "body": fil_les("/etc/hosts")}
}

funksjon spawn(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /spawn")
    la req = process_abi.request("/bin/echo", ["hei"], "/", "", 5000, 1000)
    la r = builtin.process_spawn_argv(req)
    returner {"status": 200, "body": "spawn: " + tekst(r["status"])}
}

funksjon hendingar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /hendingar")
    returner app.sse("test", app.sse_hending("hei", "start"))
}

funksjon send(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /send")
    la n = app.send_hending("test", "melding", web.request_body(ctx))
    returner {"status": 200, "body": tekst(n)}
}

funksjon ekko(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /ekko")
    returner {"status": 200, "content_type": "text/plain; charset=utf-8",
              "body": tekst(lengde(web.request_body(ctx))) + ":" + app.header(ctx, "X-Test")}
}

funksjon param_a(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /a/{id}")
    returner {"status": 200, "body": "a=" + web.request_param(ctx, "id")}
}

funksjon param_b(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /b/{id:int}")
    returner {"status": 200, "body": "b=" + web.request_param(ctx, "id")}
}

funksjon stor(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /stor")
    la b = "0123456789abcdef"
    la i = 0
    mens i < 13 {
        b = b + b
        i = i + 1
    }
    returner {"status": 200, "body": b}
}

funksjon statusrute(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /status")
    la s = app.status()
    returner {"status": 200, "body": "tilk=" + tekst(s["tilkoplingar"]) + " sse=" + tekst(s["sse"]) + " fsp=" + tekst(s["forespurnader"]) + " avviste=" + tekst(s["avviste"])}
}

funksjon stopp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /stopp")
    app.stopp()
    returner {"status": 200, "body": "stoppar"}
}

# Response-mellomvare: gjeld alle ruter under apptenar (under nc serve berre /helse).
funksjon merk_svar(svar: ordbok_tekst) -> ordbok_tekst {
    web.response_middleware()
    la h = {}
    hvis har_nokkel(svar, "headers") og svar["headers"] != null { h = svar["headers"] }
    h["x-mw"] = "ja"
    svar["headers"] = h
    returner svar
}

funksjon start() -> heltall {
    returner app.lytt({
        "port": 0,
        "sse_hb_ms": heltall_fra_tekst(_miljø("APPTENAR_HB_MS", "25000")),
        "maks_tilkoplingar": heltall_fra_tekst(_miljø("APPTENAR_MAKS", "64")),
        "maks_ms": heltall_fra_tekst(_miljø("APPTENAR_MS", "120000")),
        "respons_mw": ["__main__.merk_svar"],
        "logg": _miljø("APPTENAR_LOGG", "feil")
    })
}
