// Indre program for tests/test_precompiled_vm_payload_run.no: køyrt av VM-en I
// bootstrap/precompiled/vm.ncb.json (ikkje av vertens baka VM). Dekkjer brukarfunksjon,
// liste, ordbok, prøv/fang og dei nye F3-builtinane (native_target, ncb_binaer_versjon)
// gjennom kall_innebygd i payloaden. Exit 42 når alt stemmer, 3 ved feil sum.
funksjon dobbel(n: heiltall) -> heiltall { returner n * 2 }

funksjon start() -> heiltall {
    la m = {"a": 1}
    la l = [1, 2, 3]
    la sum = dobbel(lengde(l)) + m["a"]
    la mål = builtin.native_target()
    la v = -1
    prøv { v = builtin.ncb_binaer_versjon() } fang (e) { v = -2 }
    skriv("payload-vm indre: sum=" + tekst(sum) + " native_target=" + tekst(mål) + " ncb_binaer_versjon=" + tekst(v) + "\n")
    hvis sum != 7 { returner 3 }
    returner 42
}
