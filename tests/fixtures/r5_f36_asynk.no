# Fikstur for tests/test_r5_f36_asynk.no (R5 / F36): ekte asynk. Eit kall til ein
# asynk funksjon gjev ei future og køyrer samtidig; vent parkerer oppgåva.
bruk std.oppgaver som oppg
bruk std.samtid som sm

la ut = []
la logg = []

funksjon rapport(namn: tekst, verdi) -> heiltall {
    legg_til(ut, namn + "=" + tekst(verdi))
    returner 0
}

funksjon L(s: tekst) -> heiltall {
    legg_til(logg, s)
    returner 0
}

# ── Kroppen startar ikkje før kallaren ventar ───────────────────────────────
asynk funksjon pluss_ein(x: heiltall) -> heiltall {
    L("pluss_ein-start")
    returner x + 1
}

funksjon lat_start() -> heiltall {
    la fut = pluss_ein(1)
    L("etter-kall")
    rapport("a1_er_future", oppg.er_future(fut))
    rapport("a2_ikkje_ferdig_enno", oppg.er_ferdig(fut))
    la v = vent fut
    L("etter-vent")
    rapport("a3_verdi", v)
    rapport("a4_rekkjefølgje", builtin.join(logg, ","))
    # vent på ein vanleg verdi (ikkje-future) er identitet.
    la vanleg = 5
    rapport("a5_vent_vanleg_verdi", vent vanleg)
    returner 0
}

# ── Samtidig køyring: alle fire må vere inne samstundes for å kome vidare ───
# (tidsuavhengig: ei sekvensiell køyring ville stått fast i ventinga).
la ankommet = 0
la maks_inne = 0

asynk funksjon moetast(verdi: tekst) -> tekst {
    ankommet = ankommet + 1
    la spinn = 0
    mens ankommet < 4 {
        oppg.sov_asynk(1)
        spinn = spinn + 1
        hvis spinn > 30000 { kast "VerdiFeil: oppgåvene køyrer ikkje samtidig" }
    }
    returner verdi
}

funksjon samtidig() -> heiltall {
    ankommet = 0
    la a = moetast("a")
    la b = moetast("b")
    la c = moetast("c")
    la d = moetast("d")
    la alle = oppg.vent_alle([a, b, c, d])
    rapport("b1_resultat", builtin.join(alle, ""))
    rapport("b2_alle_fire_inne_samtidig", ankommet)
    returner 0
}

# ── Vekslande utføring: ping-pong som krev at oppgåvene køyrer samtidig ─────
# (med synkron kjøring av kroppen ved kallet ville A vente evig på B.)
la tur = "A"

asynk funksjon veksle(namn: tekst, neste: tekst) -> heiltall {
    la i = 1
    mens i <= 3 {
        mens tur != namn { oppg.sov_asynk(1) }
        L(namn + tekst(i))
        tur = neste
        i = i + 1
    }
    returner 0
}

funksjon vekslande() -> heiltall {
    logg = []
    tur = "A"
    la a = veksle("A", "B")
    la b = veksle("B", "A")
    oppg.vent_alle([a, b])
    rapport("c1_veksling", builtin.join(logg, ","))
    returner 0
}

# ── Kooperativ: hovudkoden blir ikkje avbroten mellom ventepunkt ────────────
asynk funksjon markør() -> heiltall {
    L("oppgåve-køyrer")
    returner 0
}

funksjon kooperativ() -> heiltall {
    logg = []
    la m = markør()
    la i = 0
    la sum = 0
    mens i < 20000 {
        sum = sum + i
        i = i + 1
    }
    L("hovud-lykkje-ferdig")
    vent m
    rapport("d1_ingen_preemption", builtin.join(logg, ","))
    returner 0
}

# ── Oppgåve som ventar på ei anna oppgåve ───────────────────────────────────
asynk funksjon indre(x: heiltall) -> heiltall {
    oppg.sov_asynk(10)
    returner x * 2
}

asynk funksjon ytre(x: heiltall) -> heiltall {
    la a = indre(x)
    la b = indre(x + 1)
    la va = vent a
    la vb = vent b
    returner va + vb
}

# returner f() i ein asynk funksjon: futuren blir flata ut av vent.
asynk funksjon vidaresend(x: heiltall) -> heiltall {
    returner indre(x)
}

asynk funksjon vent_felles(f) -> heiltall {
    la v = vent f
    returner v + 1
}

funksjon kjeding() -> heiltall {
    rapport("e1_nøsta_vent", vent ytre(3))
    rapport("e2_flata_future", vent vidaresend(10))
    # to oppgåver ventar på same future
    la delt = indre(4)
    la x = vent_felles(delt)
    la y = vent_felles(delt)
    rapport("e3_delt_future", tekst(vent x) + "," + tekst(vent y))
    returner 0
}

# ── Unntak gjennom vent ──────────────────────────────────────────────────────
funksjon djupt() {
    kast "VerdiFeil: feil-i-oppgåve"
}

asynk funksjon feilar() -> heiltall {
    oppg.sov_asynk(5)
    djupt()
    returner 1
}

asynk funksjon ok_tal(x: heiltall) -> heiltall {
    returner x
}

funksjon feil_scenario() -> heiltall {
    la type = "ingen"
    la topp = ""
    prøv {
        vent feilar()
    } fang (e: VerdiFeil) {
        type = unntak_type(e)
        la p = unntak_pakk(e)
        topp = p["stakk"][0]["funksjon"]
    }
    rapport("f1_type", type)
    rapport("f2_stakk_frå_oppgåva", topp)
    # vent_alle: første feil i listerekkjefølgje
    la fanga = "ingen"
    prøv {
        oppg.vent_alle([ok_tal(1), feilar(), ok_tal(3)])
    } fang (e: Unntak) {
        fanga = unntak_type(e)
    }
    rapport("f3_vent_alle_feil", fanga)
    # ei feila oppgåve som ingen ventar på velter ikkje programmet
    feilar()
    rapport("f4_ikkje_venta_feil_ufarleg", "ok")
    returner 0
}

# ── vent_første + avbrot (porter i staden for klokka) ───────────────────────
la port_sein = usann
la port_middels = usann

asynk funksjon med_port(namn: tekst) -> tekst {
    hvis namn == "sein" {
        mens ikkje port_sein { oppg.sov_asynk(1) }
    } ellers hvis namn == "middels" {
        mens ikkje port_middels { oppg.sov_asynk(1) }
    }
    L("ferdig-" + namn)
    returner namn
}

funksjon fyrste_scenario() -> heiltall {
    logg = []
    port_sein = usann
    port_middels = usann
    la a = med_port("sein")
    la b = med_port("rask")
    la c = med_port("middels")
    rapport("g1_fyrste", oppg.vent_første([a, b, c]))
    rapport("g2_indeks", oppg.vent_første_indeks([a, b, c]))
    rapport("g3_avbryt_sein", oppg.avbryt(a))
    rapport("g4_avbryt_middels", oppg.avbryt(c))
    la a_status = "ingen"
    prøv {
        vent a
    } fang (e: AvbruttFeil) {
        a_status = "AvbruttFeil"
    }
    la c_status = "ingen"
    prøv {
        vent c
    } fang (e: AvbruttFeil) {
        c_status = "AvbruttFeil"
    }
    rapport("g5_avbroten_oppgåve", a_status + "," + c_status)
    port_sein = sann
    port_middels = sann
    oppg.sov_asynk(30)
    rapport("g6_ingen_sideeffekt_etter_avbrot", builtin.join(logg, ","))
    rapport("g7_kansellert", oppg.er_kansellert(a))
    rapport("g8_avbryt_ferdig", oppg.avbryt(b))
    returner 0
}

asynk funksjon med_sideeffekt(ms: heiltall, namn: tekst) -> tekst {
    oppg.sov_asynk(ms)
    L("ferdig-" + namn)
    returner namn
}

# ── Avbrot før start ────────────────────────────────────────────────────────
funksjon avbrot_for_start() -> heiltall {
    logg = []
    la f = med_sideeffekt(0, "aldri")
    rapport("h1_avbryt", oppg.avbryt(f))
    la st = "ingen"
    prøv {
        vent f
    } fang (e: FutureFeil) {
        st = unntak_type(e)
    }
    rapport("h2_vent_avbroten", st)
    oppg.sov_asynk(20)
    rapport("h3_kroppen_køyrde_aldri", lengde(logg))
    returner 0
}

# ── Tidsavbrot ──────────────────────────────────────────────────────────────
funksjon tidsavbrot() -> heiltall {
    logg = []
    la sein = med_sideeffekt(60000, "sein")
    la t0 = builtin.tid_ms()
    la fanga = "ingen"
    prøv {
        oppg.vent_innan(sein, 60)
    } fang (e: TimeoutFeil) {
        fanga = "TimeoutFeil"
    }
    rapport("i1_timeout", fanga)
    rapport("i2_raskt", builtin.tid_ms() - t0 < 5000)
    la sein2 = med_sideeffekt(60000, "sein2")
    la fanga2 = "ingen"
    prøv {
        oppg.vent_innan(sein2, 20)
    } fang (e: FutureFeil) {
        fanga2 = unntak_type(e)
    }
    rapport("i3_timeout_er_futurefeil", fanga2)
    oppg.sov_asynk(30)
    rapport("i4_oppgåva_avbroten", oppg.er_kansellert(sein))
    rapport("i5_ingen_sideeffekt", lengde(logg))
    la rask = med_sideeffekt(10, "rask")
    rapport("i6_innan_fristen", oppg.vent_innan(rask, 20000))
    # Kallforma vent(f, ms): TimeoutFeil + avbrot, også frå ei oppgåve.
    la sein3 = med_sideeffekt(60000, "sein3")
    la fanga3 = "ingen"
    prøv {
        vent(sein3, 30)
    } fang (e: TimeoutFeil) {
        fanga3 = "TimeoutFeil"
    }
    rapport("i7_vent_kallform_timeout", fanga3)
    oppg.sov_asynk(20)
    rapport("i8_kallform_avbraut_oppgåva", oppg.er_kansellert(sein3))
    la rask2 = med_sideeffekt(5, "rask2")
    rapport("i9_kallform_innan_fristen", vent(rask2, 20000))
    rapport("i10_kallform_frå_oppgåve", vent ventar_med_frist())
    returner 0
}

asynk funksjon ventar_med_frist() -> tekst {
    la treg = med_sideeffekt(60000, "treg")
    prøv {
        vent(treg, 30)
    } fang (e: TimeoutFeil) {
        returner "oppgåve-fekk-timeout"
    }
    returner "?"
}

# ── Samspel med trådar ──────────────────────────────────────────────────────
funksjon vent_i_tråd(f) -> heiltall {
    la v = vent f
    returner v + 100
}

funksjon trådar() -> heiltall {
    la f = indre(5)
    la t = sm.tråd(fun() -> vent_i_tråd(f))
    rapport("j1_tråd_ventar_på_oppgåve", t.join())
    returner 0
}

funksjon start() -> tekst {
    lat_start()
    samtidig()
    vekslande()
    kooperativ()
    kjeding()
    feil_scenario()
    fyrste_scenario()
    avbrot_for_start()
    tidsavbrot()
    trådar()
    returner builtin.join(ut, "|")
}
