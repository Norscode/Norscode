// F37 grøne trådar (AOT x86-64): spawn/join, returverdi, argument, unntak i tråd, ukjend fn,
// kooperativ vent.sov, mutex-rekkjefølgje og ei tråd som søv medan hovudtråden joinar.
//   exit 42 = alt OK; elles nummeret på steget som feila.
bruk std.native_gap

la logg = ""

funksjon spawn(fn: tekst, args: ordbok) -> ordbok {
    returner builtin.thread_spawn({"abi": "norscode-native-thread-v1", "operation": "spawn", "fn": fn,
        "args": args, "name": "t", "stack_bytes": "65536"})
}

funksjon join(h: ordbok, ms: heiltall) -> ordbok {
    returner builtin.thread_join({"abi": "norscode-native-thread-v1", "operation": "join",
        "handle": h["handle"], "thread_id": h["thread_id"], "timeout_ms": tekst_fra_heltall(ms)})
}

funksjon arbeider(args: ordbok) -> tekst {
    returner "hei " + args["x"]
}

funksjon feilar(args: ordbok) -> tekst {
    kast "worker-feil"
    returner "aldri"
}

funksjon talar(args: ordbok) -> heiltall {
    la s = 0
    la i = 0
    mens i < 1000 { s = s + i  i = i + 1 }
    returner s
}

funksjon sovar(args: ordbok) -> tekst {
    logg = logg + "a"
    vent.sov(60)
    logg = logg + "c"
    returner "sov-ferdig"
}

funksjon rekursjon(n: heiltall) -> heiltall {
    hvis n == 0 { returner 0 }
    returner 1 + rekursjon(n - 1)
}

funksjon djup(args: ordbok) -> tekst {
    returner "djup:" + tekst_fra_heltall(rekursjon(2000))
}

funksjon start() -> heiltall {
    // 1. spawn + join + argument
    la a = spawn("__main__.arbeider", {"x": "verda"})
    hvis a["status"] != "started" { returner 1 }
    la ra = join(a, 5000)
    hvis ra["status"] != "finished" { returner 2 }
    hvis ra["value"] != "hei verda" { returner 3 }
    // 2. heiltalsreturverdi som tekst
    la b = spawn("__main__.talar", {})
    la rb = join(b, 5000)
    hvis rb["value"] != "499500" { returner 4 }
    // 3. unntak i tråd -> status error, hovudtråden lever
    la c = spawn("__main__.feilar", {})
    la rc = join(c, 5000)
    hvis rc["status"] != "error" { returner 5 }
    hvis ikkje builtin.contains(tekst(rc["error"]), "worker-feil") { returner 6 }
    // 4. ukjend funksjon: synkron feil
    la d = spawn("__main__.finst_ikkje", {})
    hvis d["status"] != "error" { returner 7 }
    // 5. handtaket er konsumert etter join
    la re = join(a, 0)
    hvis re["status"] != "error" { returner 8 }
    // 6. kooperativ søvn: tråden søv, hovudtråden joinar (join ventar kooperativt)
    la e = spawn("__main__.sovar", {})
    logg = logg + "b"
    la rf = join(e, 5000)
    hvis rf["value"] != "sov-ferdig" { returner 9 }
    hvis logg != "bac" { returner 10 }
    // 7. join med timeout 0 på tråd som søv -> timeout, så ferdig
    la f = spawn("__main__.sovar", {})
    la rg = join(f, 0)
    hvis rg["status"] != "timeout" { returner 11 }
    la rh = join(f, 5000)
    hvis rh["status"] != "finished" { returner 12 }
    // 8. djup rekursjon i tråd (eigen stakk)
    la g = spawn("__main__.djup", {})
    la ri = join(g, 5000)
    hvis ri["value"] != "djup:2000" { returner 13 }
    // 9. mange trådar, ein om gongen og alle samstundes
    la hs = []
    la i = 0
    mens i < 10 {
        legg_til(hs, spawn("__main__.arbeider", {"x": tekst_fra_heltall(i)}))
        i = i + 1
    }
    i = 9
    mens i >= 0 {
        la rr = join(hs[i], 5000)
        hvis rr["value"] != "hei " + tekst_fra_heltall(i) { returner 14 }
        i = i - 1
    }
    skriv("aot_x86_trad_basis OK\n")
    returner 42
}
