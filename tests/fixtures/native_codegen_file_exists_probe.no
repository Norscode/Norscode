funksjon start() -> heiltall {
    hvis ikkje builtin.fil_finnes("tests/fixtures/runtime_basics_v4200.json") {
        skriv("NATIVE_FILE_EXISTS_PROBE_MISSING\n")
        returner 1
    }
    hvis builtin.fil_finnes("tests/fixtures/does-not-exist-v4200.json") {
        skriv("NATIVE_FILE_EXISTS_PROBE_FALSE_POSITIVE\n")
        returner 1
    }
    skriv("NATIVE_FILE_EXISTS_PROBE_OK\n")
    returner 0
}
