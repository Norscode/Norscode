funksjon start() {
    la ncb_sti = miljo_hent("NORSCODE_NESTED_HEAP_NCB")
    la spor_sti = miljo_hent("NORSCODE_NESTED_HEAP_PROGRESS")
    la før_les = builtin.native_heap_bytes()
    la rå = fil_les(ncb_sti)
    la etter_les = builtin.native_heap_bytes()
    la ncb = json_parse_raw(rå)
    la etter_parse = builtin.native_heap_bytes()
    builtin.fil_skriv(spor_sti,
        "before_read=" + tekst_fra_heltall(før_les) +
        " after_read=" + tekst_fra_heltall(etter_les) +
        " after_parse=" + tekst_fra_heltall(etter_parse) +
        " parse_delta=" + tekst_fra_heltall(etter_parse - etter_les) + "\n")
    builtin.køyr_ncb(ncb)
}
