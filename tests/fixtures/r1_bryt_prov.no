# Fikstur for tests/test_r1_bryt_prov.no (F03): bryt/fortsett gjennom prøv/fang/endeleg.
funksjon a_bryt() -> tekst {
    la i = 0
    mens i < 5 {
        prøv {
            hvis i == 2 {
                bryt
            }
        } fang (e) {
            returner "a:STALE-FANG-I-LØKKE [" + e + "]"
        }
        i = i + 1
    }
    kast "EtterLokke: a"
    returner "a:?"
}
funksjon b_fortsett() -> tekst {
    la i = 0
    mens i < 5 {
        i = i + 1
        prøv {
            fortsett
        } fang (e) {
            returner "b:STALE-FANG-I-LØKKE [" + e + "]"
        }
    }
    kast "EtterLokke: b"
    returner "b:?"
}
funksjon vakt(namn: tekst) -> tekst {
    prøv {
        hvis namn == "a" { returner a_bryt() }
        hvis namn == "b" { returner b_fortsett() }
    } fang (e) {
        returner namn + ":rett-til-kallar [" + e + "]"
    }
    returner namn + ":?"
}
funksjon g_bryt_gjennom(logg) -> heltall {
    la i = 0
    mens i < 3 {
        prøv {
            hvis i == 1 {
                i = i + 1
                fortsett
            }
            hvis i == 2 {
                bryt
            }
            legg_til(logg, "g-kropp" + tekst(i))
        } endeleg {
            legg_til(logg, "g-endeleg" + tekst(i))
        }
        i = i + 1
    }
    legg_til(logg, "g-etter i=" + tekst(i))
    returner 0
}
funksjon h_nosta(logg) -> heltall {
    for x i [1, 2, 3] {
        prøv {
            prøv {
                hvis x == 2 { fortsett }
                hvis x == 3 { bryt }
                legg_til(logg, "k" + tekst(x))
            } fang (e) {
                legg_til(logg, "STALE")
            } endeleg {
                legg_til(logg, "ie" + tekst(x))
            }
        } endeleg {
            legg_til(logg, "ye" + tekst(x))
        }
    }
    legg_til(logg, "etter")
    returner 0
}
funksjon k_fang_bryt(logg) -> heltall {
    la i = 0
    mens sann {
        i = i + 1
        prøv {
            kast "X"
        } fang (e) {
            hvis i == 2 { bryt }
            legg_til(logg, "f" + tekst(i))
        } endeleg {
            legg_til(logg, "e" + tekst(i))
        }
    }
    prøv { kast "etter" } fang (e) { legg_til(logg, "fanga:" + e) }
    returner 0
}
funksjon start() -> tekst {
    la g = []
    g_bryt_gjennom(g)
    la h = []
    h_nosta(h)
    la k = []
    k_fang_bryt(k)
    returner vakt("a") + "|" + vakt("b") + "|" + builtin.join(g, ",") + "|" + builtin.join(h, ",") + "|" + builtin.join(k, ",")
}
