// miljo_sett/miljo_hent round-trip via in-heap overlay (AOT har ingen setenv).
funksjon start() -> heiltall {
    miljo_sett("NC_SPILLK1", "hello")
    la a = lengde(miljo_hent("NC_SPILLK1"))        // 5
    miljo_sett("NC_SPILLK1", "worldwide")           // oppdater eksisterande
    a = a + lengde(miljo_hent("NC_SPILLK1"))        // +9 = 14
    a = a + lengde(miljo_hent("NC_SPILL_NOPE"))     // usett → "" → +0
    miljo_sett("NC_SPILLK2", "ab")                   // ny nøkkel (grow)
    a = a + lengde(miljo_hent("NC_SPILLK2"))         // +2 = 16
    returner a
}
