# W4: ein liten klient med dei nye vertsvegane (tests/test_wasm_w4.no sjekkar modulen):
# to tekstverdiar til éin vertsfunksjon (lagre_lokalt), tekst frå DOM-en (hent_verdi),
# delegering (deleger) med tilbakekall, tid_ms og fjern_nokkel.
bruk std.wasm_vert som vert

la d: ordbok = {}

funksjon fjern() -> heltall {
    fjern_nokkel(d, vert.hending_data("id"))
    returner lengde(d)
}

funksjon start() -> heltall {
    d = {"a": 1, "b": 2}
    vert.lagre_lokalt("k", vert.hent_verdi(vert.finn("#inn")))
    vert.deleger("klikk", "fjern")
    vert.sett_tekst(vert.finn("#ut"), builtin.tid_ms())
    returner 0
}
