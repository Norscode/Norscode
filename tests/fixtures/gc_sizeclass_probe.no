// Native x86-64 regression for bounded free-list starvation. Build with
// NORSCODE_GC_ALLOC=1. The old allocator sees 600 small holes before the large
// hole, stops after 512 and advances bump although enough free memory exists.
// The map is synthetic, but sweep, string payload allocation and reuse are the
// real emitted runtime. No collector is allowed while the synthetic map is in use.
funksjon start() -> heiltall {
    la venstre: tekst = "abcdefgh"
    la i: heiltall = 0
    mens i < 9 { venstre = venstre + venstre i = i + 1 }
    builtin.raw_store64(7864336, 536870912) // allocation budget: no automatic collect
    builtin.raw_store64(7864352, 0)
    la region: heiltall = builtin.heap_bump() + 1048576
    region = region + 16 - region % 16
    la stor: heiltall = 65536
    la n: heiltall = 600
    la lm: heiltall = 1124073472
    la golv: heiltall = 8921184
    builtin.raw_store64(lm, golv)
    builtin.raw_store64(lm + 8, region - golv)
    i = 0
    mens i <= n {
        la p: heiltall = region + stor + i * 32
        builtin.raw_store64(lm + 16 + i * 16, p)
        builtin.raw_store64(lm + 24 + i * 16, 16)
        builtin.raw_store64(p, 12345)
        builtin.raw_store64(p + 8, 23456)
        i = i + 1
    }
    builtin.heap_set_bump(region + stor + n * 32 + 16)
    builtin.gc_sweep_full(n + 2)
    la før: heiltall = builtin.heap_bump()
    la a: tekst = venstre + venstre
    la ap: heiltall = builtin.raw_load64(builtin.obj_addr(a) + 8)
    hvis ap != region {
        skriv("gc_sizeclass FEIL: stor streng gjekk forbi det ledige holet\n")
        returner 7
    }
    la b: tekst = venstre + venstre
    la bp: heiltall = builtin.raw_load64(builtin.obj_addr(b) + 8)
    // Payload = round16(length + 9), including length and trailing NUL.
    hvis bp != ap + 8208 eller ap % 16 != 0 eller bp % 16 != 0 {
        skriv("gc_sizeclass FEIL: split/alignment\n")
        returner 8
    }
    hvis builtin.heap_bump() != før {
        skriv("gc_sizeclass FEIL: bump voks trass fri plass\n")
        returner 9
    }
    hvis lengde(a) != 8192 eller lengde(b) != 8192 eller
       builtin.slice(a, 8184, 8192) != "abcdefgh" eller
       builtin.slice(b, 0, 8) != "abcdefgh" {
        skriv("gc_sizeclass FEIL: nyttelast øydelagd\n")
        returner 10
    }
    i = 0
    mens i <= n {
        la p: heiltall = region + stor + i * 32
        hvis builtin.raw_load64(p) != 12345 eller builtin.raw_load64(p + 8) != 23456 {
            skriv("gc_sizeclass FEIL: levande skiljeblokk overskriven\n")
            returner 11
        }
        i = i + 1
    }
    // gc_free receives exact, possibly unaligned ranges. Its header and every
    // returned slot must stay inside that range, including at its trailing edge.
    la kant: heiltall = builtin.heap_bump() + 1048576
    kant = kant + 16 - kant % 16
    builtin.raw_store64(kant - 5, 12345)
    builtin.raw_store64(kant + 79, 23456)
    builtin.gc_free(kant + 3, 76)
    // The aligned usable extent is 48 bytes. Ask for that extent so this
    // checks its boundaries without prescribing which smaller free bin wins.
    la rå: heiltall = builtin.gc_alloc(48)
    hvis rå != kant + 16 eller builtin.raw_load64(kant - 5) != 12345 eller
       builtin.raw_load64(kant + 79) != 23456 {
        skriv("gc_sizeclass FEIL: ualigna hol skada naboen\n")
        returner 12
    }
    la null_a: heiltall = builtin.gc_alloc(0)
    la null_b: heiltall = builtin.gc_alloc(0)
    hvis null_a == null_b eller null_a % 16 != 0 eller null_b % 16 != 0 {
        skriv("gc_sizeclass FEIL: nullstorleik gav overlappande blokker\n")
        returner 13
    }
    // Reuse a larger sub-KiB hole across several requests. Address-return
    // boxing also consumes 16-byte slots, so verify reuse and nonoverlap
    // without prescribing the exact position of each split.
    la liten: heiltall = kant + 1048576
    builtin.raw_store64(liten - 8, 34567)
    builtin.raw_store64(liten + 1008, 45678)
    builtin.gc_free(liten, 1008)
    la liten_før: heiltall = builtin.heap_bump()
    la del_a: heiltall = builtin.gc_alloc(48)
    la del_b: heiltall = builtin.gc_alloc(512)
    la del_c: heiltall = builtin.gc_alloc(320)
    la liten_etter: heiltall = builtin.heap_bump()
    hvis liten_etter != liten_før eller del_a % 16 != 0 eller
       del_b % 16 != 0 eller del_c % 16 != 0 {
        skriv("gc_sizeclass FEIL: smaahol/split vart ikkje attbrukte\n")
        returner 14
    }
    hvis (del_a < del_b + 512 og del_b < del_a + 48) eller
       (del_a < del_c + 320 og del_c < del_a + 48) eller
       (del_b < del_c + 320 og del_c < del_b + 512) {
        skriv("gc_sizeclass FEIL: smaahol overlappa\n")
        returner 15
    }
    builtin.raw_store64(del_a + 40, 56789)
    builtin.raw_store64(del_b, 67890)
    builtin.raw_store64(del_c + 312, 78901)
    hvis builtin.raw_load64(del_a + 40) != 56789 eller
       builtin.raw_load64(del_b) != 67890 eller
       builtin.raw_load64(del_c + 312) != 78901 eller
       builtin.raw_load64(liten - 8) != 34567 eller
       builtin.raw_load64(liten + 1008) != 45678 {
        skriv("gc_sizeclass FEIL: smaahol overlappa eller skada naboen\n")
        returner 16
    }
    skriv("gc_sizeclass OK: 600 smaahol, stor attbruk, split, alignment og levande data\n")
    returner 0
}
