funksjon start() -> heiltall {
    la a: liste_heiltall = []
    la j: heiltall = 0
    mens j < 20 { legg_til(a, 100 + j)  j = j + 1 }
    la i: heiltall = 0
    mens i < 3000 {
        la t: liste_heiltall = [i, i+1]
        i = i + 1
    }
    // finn fyrste indeks der a[k] != 100+k; returner 500+k, eller 999 om alt rett
    la k: heiltall = 0
    mens k < 20 {
        hvis a[k] != 100 + k { returner 500 + k }
        k = k + 1
    }
    returner 999
}
