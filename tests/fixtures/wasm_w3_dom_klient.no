# W3: vertsfunksjonane med tekstverdiar (tests/test_wasm_korpus_w3.no). Klienten byter ut
# <body> med ein konstant HTML-mal via sett_html, der verdien (med script-tagg og HTML-teikn)
# blir escapa, og set så tekst med sett_tekst på element han finn med selektorar som blir
# rekna ut ved køyring: HTML-teikn i textContent blir ikkje tolka, og eit desimaltal blir
# tekst(x).
bruk std.wasm_vert som vert

funksjon start() -> heltall {
    la kropp = vert.finn(join(["bo", "dy"], ""))
    vert.sett_html(kropp, "<p id=\"a\"></p><p id=\"x\">{}</p><pre id=\"nc-logg\"></pre>", "<script>alert(1)</script> æ & \"'")
    la id = "a"
    vert.sett_tekst(vert.finn("#" + id), "blåbær & <b>ikkje feit</b>")
    vert.sett_tekst(vert.finn("#nc-" + "logg"), 2.5)
    returner 0
}
