bruk selfhost.lexer.lexer_m1 som lexer

funksjon start() {
    la sti = miljo_hent("NORSCODE_LEXER_PROFILE_SOURCE")
    la grense = heltall_fra_tekst(miljo_hent("NORSCODE_LEXER_PROFILE_LIMIT"))
    la kjelde = fil_les(sti)
    hvis grense > 0 og grense < lengde(kjelde) {
        kjelde = builtin.slice(kjelde, 0, grense)
    }
    la før = builtin.native_heap_bytes()
    la tokens = lexer.lex(kjelde)
    la etter = builtin.native_heap_bytes()
    skriv("LEXER_HEAP_PROFILE bytes=" + tekst_fra_heltall(lengde(kjelde)) + " tokens=" + tekst_fra_heltall(lengde(tokens)) + " delta=" + tekst_fra_heltall(etter - før) + " total=" + tekst_fra_heltall(etter))
}
