funksjon start() -> heiltall {
    la h0: heiltall = builtin.raw_load64(6291496)
    la w: liste_heiltall = [100, 200]
    la h1: heiltall = builtin.raw_load64(6291496)
    // h0=start-verdi, h1=etter list-build. Exit: 0 begge 0; 2 h0!=0; 3 h1!=0
    hvis h0 != 0 { returner 2 }
    hvis h1 != 0 { returner 3 }
    returner 0
}
