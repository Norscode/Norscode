funksjon del(a: heiltall, b: heiltall) -> heiltall {
    hvis b == 0 { kast "divisjon med null" }
    returner a / b
}
funksjon start() -> heiltall {
    la sum: heiltall = 0
    la feil_talt: heiltall = 0
    la i: heiltall = 0
    mens i < 2000 {
        prøv {
            sum = sum + del(100, i % 5)
        } fang (e) {
            feil_talt = feil_talt + 1
        }
        i = i + 1
    }
    // strengformatering + samanlikning
    la melding: tekst = "sum=" + tekst(sum) + " feil=" + tekst(feil_talt)
    hvis feil_talt != 400 { returner 1 }
    skriv(melding + "\n")
    skriv("feat OK: prøv/fang/kast + strengformat overlevde collect\n")
    returner 0
}
