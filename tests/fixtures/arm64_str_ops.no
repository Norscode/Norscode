// Fase 3: samla strengruntime over NcVal — contains/starts_with/ends_with/
// index_of/lower/upper/trim/replace/slice/char_code/tekst/heltall/streng-==.
// Speglar strengdelane av macos_aot_common_runtime. Forventa exit 16.
funksjon start() -> heiltall {
    la namn = "Norscode"
    la total = 0
    hvis builtin.contains(namn, "code") { total = total + 4 }
    hvis builtin.starts_with(namn, "Nor") { total = total + 1 }
    hvis builtin.ends_with(namn, "code") { total = total + builtin.index_of(namn, "code") }
    la liten = builtin.lower(namn)
    hvis builtin.contains(liten, "code") { total = total + 1 }
    la stor = builtin.upper(namn)
    hvis builtin.starts_with(stor, "NOR") { total = total + 1 }
    la trimma = builtin.trim(" Norscode ")
    hvis builtin.ends_with(trimma, "code") { total = total + 1 }
    la bytta = builtin.replace(namn, "code", "lang")
    hvis builtin.ends_with(bytta, "lang") { total = total + 1 }
    la utsnitt = builtin.slice(namn, 0, 3)
    hvis builtin.starts_with(utsnitt, "Nor") { total = total + 1 }
    hvis builtin.char_code("N") == 78 { total = total + 1 }
    la t = tekst(42)
    hvis t == "42" { total = total + 1 }
    la h = heltall("100")
    total = total + h - 100
    returner total
}
