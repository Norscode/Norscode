// GC (iv) DIAGNOSE: kor mange «roter» finn den konservative skanninga? 1500 iter (1 collect),
// les rot-tal @0x600040 (lagra av gc_mark_roots). Exit-kode = storleik: 10=>100k, 11=>10k,
// 12=>1k, 13=>100, 14=<100. Fortel om skanninga over-scannar (forklarar e2e-krasjen).
funksjon ident(x: heiltall) -> heiltall {
    returner x
}
funksjon start() -> heiltall {
    la i: heiltall = 0
    mens i < 1500 {
        la a: heiltall = i + 1
        la c: heiltall = ident(a)
        i = i + 1
    }
    la r: heiltall = builtin.raw_load64(6291520)   // 0x600040 rot-tal
    hvis r > 100000 { returner 10 }
    hvis r > 10000 { returner 11 }
    hvis r > 1000 { returner 12 }
    hvis r > 100 { returner 13 }
    returner 14
}
