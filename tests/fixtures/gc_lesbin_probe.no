// gc_lesbin_probe.no — fil_les_binær i self-hosta x86-64-codegen: gav null (ingen
// ruting) → frosen RT_FIL_SKRIV_BINAR(sti, null) SIGSEGV @0x402371 i harnessen
// sitt compile-steg (filops.kopier_fil). No: fil_les_bin-atom → liste av byte-
// heiltal (som committed seed sin «bytes»), bytes.til_liste = identitet,
// bytes.til_tekst, fil_skriv_binær-rundtur, sha256_bytes gap-ruta til hash_bytes.
bruk std.bytes som bytes
bruk std.sha256 som sha
funksjon start() -> heiltall {
    la sti = "/tmp/nc_lesbin_" + tekst(builtin.tid_ms()) + ".bin"
    fil_skriv(sti, "hallo\nverda")
    la b = builtin.fil_les_binær(sti)
    skriv("len=" + tekst(lengde(b)) + " b0=" + tekst(b[0]) + " b5=" + tekst(b[5]) + "\n")
    hvis lengde(b) != 11 eller b[0] != 104 eller b[5] != 10 { returner 3 }
    la l = bytes.til_liste(b)
    hvis lengde(l) != 11 eller l[10] != 97 { skriv("til_liste feil\n") returner 4 }
    la t = bytes.til_tekst(b)
    skriv("tekst=[" + t + "]\n")
    hvis t != "hallo\nverda" { returner 5 }
    builtin.fil_skriv_binær(sti + ".kopi", b)
    hvis fil_les(sti + ".kopi") != "hallo\nverda" { skriv("rundtur feil\n") returner 6 }
    la h = builtin.sha256_bytes(b)
    skriv("sha256_bytes=" + tekst(h) + "\n")
    hvis tekst(h) != sha.hash("hallo\nverda") { returner 7 }
    prøv { builtin.fil_les_binær("/finst_ikkje_lesbin") returner 8 } fang (e) { skriv("manglande: " + tekst(e) + "\n") }
    skriv("lesbin OK\n")
    returner 0
}
