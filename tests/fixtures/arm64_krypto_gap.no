// A0-review: pbkdf2_sha256 og hmac_sha256(tekst) på ARM64 skal anten gje rett
// svar eller kaste fangbar NATIV-GAP (krypto fell då til rein kode) — ALDRI feil
// hash (ruta til std.sha256.pbkdf2_hex brukte SHA-padda nøkkel) eller SIGSEGV
// (tekst-hmac i liste-emitteren). 20 + 22 = 42.
bruk std.sha256 som s
funksjon start() -> heiltall {
    la r = 0
    la h = ""
    la kasta = usann
    prøv { h = builtin.pbkdf2_sha256("password", "salt", 2, 32) } fang (e) { kasta = sann }
    hvis kasta eller h == "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43" { r = r + 20 }
    kasta = usann
    prøv { h = builtin.hmac_sha256("key", "The quick brown fox jumps over the lazy dog") } fang (e) { kasta = sann }
    hvis kasta eller h == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" { r = r + 22 }
    returner r
}
