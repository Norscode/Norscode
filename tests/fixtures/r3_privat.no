// R3/F31-fikstur: privat funksjon, global, konstant og felt.
privat la teljar = 0
privat konst HEMMELEG = 1234
la OPEN = "open"

struktur Konto {
    privat saldo: heiltall
    eigar: tekst
}

privat funksjon intern_hemmeleg() -> heiltall {
    returner HEMMELEG
}

funksjon offentleg() -> heiltall {
    teljar = teljar + 1
    returner intern_hemmeleg() + teljar
}

funksjon ny_konto() -> Konto {
    la k = Konto()
    k.saldo = 10
    k.eigar = "Ada"
    returner k
}

funksjon saldo(k: Konto) -> heiltall {
    returner k.saldo
}
