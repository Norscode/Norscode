// Codegen-regresjonsvakt: json_stringify MÅ escape \ " LF CR TAB. Den frosne
// legacy-rutinen (@0x4028d2) droppa bakstrek + neste teikn ("a\b" → "a") og skreiv
// einsleg bakstrek rått → ugyldig JSON ("\") → Gen2-bundlar i ELF stage-0-fixpunktet
// vart korrupte. Exit 0 = rett escaping.
funksjon start() -> heiltall {
    la s = builtin.json_stringify(["a\\b", "q\"r", "n\nl", "t\tu", "\\"])
    la venta = "[\"a\\\\b\",\"q\\\"r\",\"n\\nl\",\"t\\tu\",\"\\\\\"]"
    skriv("JSONESC=" + s + "\n")
    hvis s != venta {
        skriv("FEIL: venta " + venta + "\n")
        returner 1
    }
    skriv("jsonesc OK\n")
    returner 0
}
