// AOT (linux-x86_64): builtin.ncb_call_fn med funksjonsnamn og closure, CALL_VALUE,
// closure som returverdi, ukjent namn som fangbart unntak og std.sched-callback.
// Regresjonsvakt (review r2cg): unntak fanga INNE i ein callee kalla via ncb_call_fn/
// CALL_VALUE/host_kall (assert_eq/assert_ne, indre ukjent ncb_call_fn, 7-arg-kast) —
// stakkoppryddinga brukte rbx, som ikkje overlever eit fanga kast → SIGSEGV. Òg
// «builtin.»-prefiks (ikkje brukarfunksjon) og CALL_VALUE på tekst (berre closure).
// host_kall er eit AOT-/seed-builtin (vm.no kall_innebygd-fallback), so fixturen er AOT-only.
// Exit 42 når alt stemmer; kvar feil har eigen exit-kode.
bruk std.sched som sched

funksjon dobbel(x: heltall) -> heltall { returner x * 2 }
funksjon legg_saman(a: heltall, b: heltall) -> heltall { returner a + b }
funksjon kvadrér_ø(x: heltall) -> heltall { returner x * x }

funksjon sched_cb(args: ordbok_tekst) -> tekst {
    args["køyrd"] = "ja"
    returner "cb:" + args["v"]
}

funksjon assert_inne(x: heltall) -> heltall {
    prøv { assert_eq(x, 2) } fang (e) { }
    returner 6
}
funksjon kast_inne() -> heltall {
    la m = ""
    prøv { builtin.ncb_call_fn("finst_ikkje_abc", 1) } fang (e) { m = tekst(e) }
    hvis m != "Ukjent selfhost-funksjon: finst_ikkje_abc" { returner 99 }
    returner 5
}
funksjon g7(a: heltall, b: heltall, c: heltall, d: heltall, e: heltall, f: heltall, g: heltall) -> heltall {
    kast "z"
}
funksjon ytre7() -> heltall {
    la m = ""
    prøv { builtin.ncb_call_fn("g7", 1, 2, 3, 4, 5, 6, 7) } fang (e) { m = tekst(e) }
    hvis m != "z" { returner 99 }
    returner 5
}
funksjon g7c(a: heltall, b: heltall, c: heltall, d: heltall, e: heltall, f: heltall, g: heltall) -> heltall {
    prøv { builtin.ncb_call_fn("finst_ikkje_q", 1) } fang (x) { }
    prøv { assert_ne(a, 1) } fang (x) { }
    returner a + b + c + d + e + f + g
}
funksjon sjekk_ne(a: heltall, b: heltall) -> heltall {
    prøv { assert_ne(a, b) } fang (e) { }
    returner 7
}
funksjon kall_verdi(f, x: heltall) -> heltall { returner f(x) }

funksjon lag_adder(k: heltall) {
    returner fun(y: heltall) -> y + k
}

funksjon start() -> heltall {
    hvis builtin.ncb_call_fn("dobbel", 21) != 42 { returner 11 }
    hvis builtin.ncb_call_fn("__main__.legg_saman", 40, 2) != 42 { returner 12 }
    hvis builtin.ncb_call_fn("kvadrér_ø", 7) != 49 { returner 13 }
    la k: heltall = 10
    la f = fun(y: heltall) -> y + k
    hvis f(32) != 42 { returner 14 }
    hvis builtin.ncb_call_fn(f, 32) != 42 { returner 15 }
    la add5 = lag_adder(5)
    hvis add5(37) != 42 { returner 16 }
    la melding = ""
    prøv { builtin.ncb_call_fn("finst_ikkje_xyz", 1) } fang (e) { melding = tekst(e) }
    hvis melding != "Ukjent selfhost-funksjon: finst_ikkje_xyz" { returner 17 }
    la s = sched.ny()
    la a: ordbok_tekst = {}
    a["v"] = "hei"
    sched.call_soon(s, "sched_cb", a)
    hvis sched.run_ferdig(s) != 1 { returner 18 }
    hvis ikkje har_nokkel(a, "køyrd") { returner 19 }
    hvis builtin.ncb_call_fn("assert_inne", 1) != 6 { returner 20 }
    hvis builtin.ncb_call_fn("kast_inne") != 5 { returner 21 }
    hvis builtin.ncb_call_fn("ytre7") != 5 { returner 22 }
    la k3: heltall = 3
    la fc = fun(y: heltall) -> sjekk_ne(y, k3)
    hvis fc(3) != 7 { returner 23 }
    hvis builtin.host_kall("__main__.assert_inne", [1]) != 6 { returner 24 }
    la sum: heltall = 0
    la i: heltall = 0
    mens i < 500 {
        sum = sum + builtin.ncb_call_fn("g7c", 1, 2, 3, 4, 5, 6, i)
        sum = sum + builtin.host_kall("__main__.g7c", [1, 2, 3, 4, 5, 6, 7, 8])
        i = i + 1
    }
    hvis sum != 500 * 21 + 124750 + 500 * 28 { returner 25 }
    la mb = ""
    prøv { builtin.ncb_call_fn("builtin.dobbel", 2) } fang (e) { mb = tekst(e) }
    hvis mb != "Ukjent selfhost-funksjon: builtin.dobbel" { returner 26 }
    la mv = ""
    prøv { kall_verdi("dobbel", 21) } fang (e) { mv = tekst(e) }
    // AOT: «Ukjent selfhost-funksjon: dobbel»; VM: «Ukjent innebygd funksjon: » (tomt mål).
    hvis ikkje builtin.starts_with(mv, "Ukjent ") { returner 27 }
    returner 42
}
