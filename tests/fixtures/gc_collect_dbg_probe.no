// GC (iv) DEBUG: liten e2e (1500 iter → collect fyrer éin gong ved terskel 1000). Markørar
// (skriv er ubufra i AOT-ELF → siste linje = krasjpunkt). A=start, B=etter loop, C=keep ok.
funksjon ident(x: heiltall) -> heiltall {
    returner x
}
funksjon start() -> heiltall {
    la keep: heiltall = 12321
    skriv("A: start\n")
    la i: heiltall = 0
    mens i < 1500 {
        la a: heiltall = i + 1
        la b: heiltall = a + 1
        la c: heiltall = ident(b)
        i = i + 1
    }
    skriv("B: loop ferdig (collect fyrte utan krasj)\n")
    hvis keep == 12321 {
        skriv("C: keep urørt\n")
        returner 0
    }
    returner 2
}
