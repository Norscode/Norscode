bruk selfhost.vm

funksjon start() -> heiltall {
    la sti = miljo_hent("NC_LARGE_VM_PROBE")
    skriv("large-vm: read\n")
    la rå = fil_les(sti)
    skriv("large-vm: bytes=" + tekst_fra_heltall(lengde(rå)) + "\n")
    la ncb = json_parse_raw(rå)
    skriv("large-vm: parsed=" +
          tekst_fra_heltall(lengde(nøkler(ncb["functions"]))) + "\n")
    la rc = køyr_ncb(ncb)
    skriv("large-vm: returned=" + tekst(rc) + "\n")
    returner rc
}
