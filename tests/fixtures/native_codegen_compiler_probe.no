bruk selfhost.kompiler som komp

funksjon start() -> heiltall {
    skriv("COMPILER_PROBE_START\n")
    la ncb = komp.kompiler_fil("funksjon start() { skriv(\"test OK\\n\") }\n", "__main__")
    la dokument = json_parse_raw(ncb)
    skriv("COMPILER_PROBE_FUNCTIONS=" + tekst_fra_heltall(lengde(nøkler(dokument["functions"]))) + "\n")
    skriv("COMPILER_PROBE_OK\n")
    returner 0
}
