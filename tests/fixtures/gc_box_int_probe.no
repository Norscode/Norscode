// GC (iii) probe: fri-liste-støtta int-boksar (gc_box_int) — byggjekloss for å re-peke
// allokatoren. Verifiser (1) KORREKTHEIT: boksen er ein ekte int (verdi round-trippar),
// (2) GJENBRUK: ein gc_free-a 16B-blokk blir gjenbrukt av gc_box_int (fri-liste, ikkje
// rein bump). Exit: 0 = OK · 2 = feil verdi · 3 = gjenbrukte ikkje fri-blokka.
funksjon start() -> heiltall {
    // (1) korrektheit
    la a: heiltall = builtin.gc_box_int(12345)
    hvis a != 12345 {
        returner 2
    }
    // (2) gjenbruk: donér ein 16B fri-blokk høgt over bump, box → skal lande der
    la region: heiltall = builtin.heap_bump() + 65536
    builtin.gc_free(region, 16)
    la b: heiltall = builtin.gc_box_int(777)
    la addr: heiltall = builtin.obj_addr(b)
    hvis b != 777 {
        returner 2
    }
    hvis addr != region {
        returner 3
    }
    skriv("gc_box_int OK: korrekt int-boks (verdi round-trippar) + gjenbrukte fri-blokk\n")
    returner 0
}
