// arm64: binær NCB-tekstkoding rundtur (ncb_bin) i AOT-kode — tekstkonstantar, tal, boolske.
bruk selfhost.ncb_bin som nb
funksjon start() -> heiltall {
    la v = {"a": ["123", " 123 ", "", "x", 5, -3, sann, "12.3", "null"], "b": "123"}
    la t = nb.bin_encode_tekst(v)
    skriv(tekst(lengde(t)) + "\n")
    la d = nb.bin_decode_tekst(t, 0)
    skriv(builtin.json_stringify(d) + "\n")
    la l = d["a"]
    la i = 0
    mens i < lengde(l) { skriv(builtin.type(l[i]) + ":[" + tekst(l[i]) + "] ") i = i + 1 }
    skriv("\n")
    returner 0
}
