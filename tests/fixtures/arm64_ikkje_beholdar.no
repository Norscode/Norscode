// A5: indeksering og lengde på verdiar som ikkje er beholdarar gjev null/0 som VM-en.
// vm.no sin vm_map_get returnerer 0 for ukjende funksjonar (t.d. manglande start) og
// les så fn_def["code"]; ARM64 deref-a då val som mapdata (SIGSEGV).
funksjon hent(x) { returner x }

funksjon start() -> heiltall {
    la a = hent(0)
    la v = a["code"]
    skriv("int[k]=" + tekst(v) + " t=" + builtin.type(v) + "\n")
    la b = hent(sann)
    skriv("bool[k]=" + tekst(b["x"]) + "\n")
    la n = hent(null)
    skriv("null[k]=" + tekst(n["x"]) + " lengde(null)=" + tekst(lengde(n)) + "\n")
    a["x"] = 5
    skriv("int etter set=" + tekst(a) + "\n")
    returner 0
}
