// Litmus for fase 8 gap-emitterar: fjern/sett_inn (liste), system_info,
// native_heap_bytes (-1-fallback), feil (throw) og NATIV-GAP-stubb (throw
// fanga i prøv/fang). VM og native skal gje same exit-verdi.
funksjon start() -> heiltall {
    la sum = 0

    // fjern(liste, indeks): [10,20,30,40] - idx1 → [10,30,40]
    la l = [10, 20, 30, 40]
    fjern(l, 1)
    sum = sum + lengde(l)          // +3
    sum = sum + l[1]               // +30

    // sett_inn(liste, indeks, verdi): [10,30,40] + 25@1 → [10,25,30,40]
    sett_inn(l, 1, 25)
    sum = sum + lengde(l)          // +4
    sum = sum + l[1]               // +25

    // fjern på siste element
    fjern(l, lengde(l) - 1)
    sum = sum + lengde(l)          // +3

    // system_info: begge felta skal finnast og vere ikkje-tomme
    la info = builtin.system_info()
    hvis lengde(tekst(info["system"])) > 0 { sum = sum + 5 }   // +5
    hvis lengde(tekst(info["machine"])) > 0 { sum = sum + 7 }  // +7

    // native_heap_bytes: berre at kallet svarar eit heiltal
    la hb = builtin.native_heap_bytes()
    hvis hb != 0 { sum = sum + 2 }                             // +2 (native: -1, VM: bytes>0)

    // feil() fanga i prøv/fang
    prøv {
        feil("kontrollert")
        sum = sum + 1000
    } fang (e) {
        sum = sum + 11             // +11
    }

    // NATIV-GAP-stubb fanga (VM har builtinen, native kastar — begge
    // vegar skal gje kontrollert flyt; testen aksepterer begge svar ved å
    // berre sjekke at vi kjem hit utan krasj)
    prøv {
        la a = builtin.argv_list_v1()
        sum = sum + 0 * lengde(a)
    } fang (e) {
        sum = sum + 0
    }

    returner sum                   // 3+30+4+25+3+5+7+2+11 = 90
}
