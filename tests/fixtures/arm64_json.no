// A5: JSON i ARM64-AOT — escape i begge retningar (\n \r \t \" \\ \/ \uXXXX med
// surrogatpar), desimaltal (snøggveg og json_les-fallback), 64-bit heiltal og
// heltall() av tekst/heiltal. Utdata må vere lik VM-en byte for byte.
bruk selfhost.json som json
bruk std.desimaltall_tekst som dt

funksjon koder(s: tekst) -> tekst {
    la ut = ""
    la k = 0
    mens k < lengde(s) { ut = ut + tekst(builtin.char_code(s[k])) + "," k = k + 1 }
    returner ut
}

funksjon vis(i: heiltall, x) -> heiltall {
    la t = builtin.type(x)
    hvis t == "desimaltall" { skriv(tekst(i) + ": d " + tekst(builtin.desimal_til_bits(x)) + "\n") }
    ellers hvis t == "heltall" { skriv(tekst(i) + ": i " + tekst(x) + "\n") }
    ellers hvis t == "tekst" { skriv(tekst(i) + ": t " + koder(x) + "\n") }
    ellers { skriv(tekst(i) + ": " + t + "\n") }
    returner 0
}

funksjon start() -> heiltall {
    la e = builtin.json_parse_raw("[\"a\\nb\", \"t\\tc\", \"q\\\"d\", \"s\\\\e\", \"u\\u0041f\", \"r\\rg\", \"sl\\/h\", \"\\u00e6\\u20ac\", \"\\ud83d\\ude00\"]")
    la i = 0
    mens i < lengde(e) { vis(i, e[i]) i = i + 1 }
    skriv(builtin.json_stringify(["x\ny", "t\tq\"z\\", "r\rs"]) + "\n")
    la v = builtin.json_parse_raw("[1.5, -0.25, 1e3, 2E-2, 12345678901234567, 0.1, [3.25, {\"a\": -7.5e1}], 9007199254740993, 1.23456789012345678, -0]")
    i = 0
    mens i < lengde(v) { vis(100 + i, v[i]) i = i + 1 }
    skriv("heltall_tekst " + tekst(heltall("-9007199254740993")) + "\n")
    skriv("heltall_int " + tekst(heltall(41)) + "\n")
    la dup = builtin.json_parse_raw("{\"a\": 1, \"b\": 2, \"a\": 3, \"c\": {\"x\": 1, \"x\": 2}}")
    skriv("dup n=" + tekst(lengde(builtin.nøkler(dup))) + " a=" + tekst(dup["a"]) + " k0=" + tekst(builtin.nøkler(dup)[0]) + " cx=" + tekst(dup["c"]["x"]) + " cn=" + tekst(lengde(builtin.nøkler(dup["c"]))) + "\n")
    returner 0
}
