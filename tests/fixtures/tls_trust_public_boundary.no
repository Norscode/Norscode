// Køyr som native-binær eller med ein nybygd runtime. Ein gammal seed har den
// gamle gap-ruta bakt inn; bygg-native må bruke kjelda frå denne revisjonen.
bruk std.socket som socket

funksjon avvis(ca_file: tekst, hostname: tekst, grunn: tekst) {
    la r = socket.native_tls_tilkoble("127.0.0.1", 1, hostname, ca_file)
    assert_eq(r["status"], "feil")
    assert_eq(r["handle"], "")
    assert(builtin.contains(r["error"], grunn))
}

funksjon avvis_lyttar(req: ordbok, grunn: tekst) {
    la r = builtin.network_operation(req)
    // Lukk ein feilaktig opna lyttar før assert, slik at regresjonen ikkje
    // etterlet ein port dersom han blir køyrd mot ein eldre runtime.
    hvis r["status"] == "listening" { socket.native_lukk(r) }
    assert_eq(r["status"], "feil")
    assert_eq(r["handle"], "")
    assert(builtin.contains(r["error"], grunn))
}

funksjon lyttar_policy_og_identitet() {
    la cert = "tests/fixtures/tls/localhost-ed25519.crt"
    la key = "tests/fixtures/tls/localhost-ed25519.key"
    la req = {"abi": socket.native_versjon(), "operation": "tls_listen",
        "host": "127.0.0.1", "port": "0", "backlog": "8",
        "cert_file": cert, "key_file": key}
    // Den typa builtin-ruta må krevje same klient-CA som tekst-ABI-et.
    // Tidlegare vart berre "1" tolka som krav; true opna ein vanleg lyttar.
    for krav i [sann, "true", "1", 1, "sann", "sant"] {
        req["require_client_cert"] = krav
        avvis_lyttar(req, "TLS client CA unavailable or invalid")
    }
    req["require_client_cert"] = "yes"
    avvis_lyttar(req, "TLS require_client_cert policy invalid")
    req["require_client_cert"] = usann
    req["key_file"] = "std/tls13_session.no"
    avvis_lyttar(req, "TLS key invalid or unsupported")
    req["key_file"] = "tests/fixtures/tls/revoked-client-ed25519.key"
    avvis_lyttar(req, "TLS certificate and key mismatch")
    req["key_file"] = key
    req["cert_file"] = "tests/fixtures/tls/localhost.crt"
    avvis_lyttar(req, "TLS certificate key unsupported")
}

funksjon start() -> heiltall {
    lyttar_policy_og_identitet()
    la tidlegare_ca = builtin.miljo_hent("NORSCODE_TLS_CA_FILE")
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", "")
    avvis("", "localhost", "TLS CA file required")
    avvis("tests/fixtures/tls/does-not-exist.crt", "localhost", "TLS CA unavailable or invalid")
    avvis("std/tls13_session.no", "localhost", "TLS CA unavailable or invalid")
    avvis("tests/fixtures/tls/localhost-ed25519.crt", "", "TLS hostname required")
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", "std/tls13_session.no")
    avvis("", "localhost", "TLS CA unavailable or invalid")
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", "tests/fixtures/tls/localhost-ed25519.crt")
    avvis("tests/fixtures/tls/does-not-exist.crt", "localhost", "TLS CA unavailable or invalid")
    la r = socket.native_tls_tilkoble_med_klientsertifikat("127.0.0.1", 1, "localhost", "",
        "tests/fixtures/tls/does-not-exist.crt", "tests/fixtures/tls/does-not-exist.key")
    assert_eq(r["status"], "feil")
    assert(builtin.contains(r["error"], "TLS client certificate or key unavailable"))
    la crl = socket.native_tls_tilkoble_med_crl("127.0.0.1", 1, "localhost", "", "missing.crl")
    assert_eq(crl["status"], "feil")
    assert(builtin.contains(crl["error"], "TLS client CRL verification unsupported"))
    la ocsp = socket.native_tls_tilkoble_krev_ocsp("127.0.0.1", 1, "localhost", "")
    assert_eq(ocsp["status"], "feil")
    assert(builtin.contains(ocsp["error"], "TLS OCSP verification unsupported"))
    for crl_file i ["missing.crl", "std/tls13_session.no", "tests/fixtures/tls/revoked-client-ed25519.crl.pem"] {
        la listener = socket.native_tls_lytt_med_klientsertifikat_og_crl("127.0.0.1", 0, 8,
            "tests/fixtures/tls/localhost-ed25519.crt", "tests/fixtures/tls/localhost-ed25519.key",
            "tests/fixtures/tls/localhost-ed25519.crt", crl_file)
        assert_eq(listener["status"], "feil")
        assert_eq(listener["handle"], "")
        assert(builtin.contains(listener["error"], "TLS server CRL verification unsupported"))
    }
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", tidlegare_ca)
    skriv("tls_trust_public_boundary OK\n")
    returner 0
}
