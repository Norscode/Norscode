# F46: frosne samlingar. c0..cN gjev kvar ein tekst; start() set dei saman med «|».

struktur Punkt {
    x
    y
}

funksjon Punkt.sum(self) -> heiltall {
    returner self.x + self.y
}

funksjon Punkt.flytt(self) {
    self.x = self.x + 1
}

funksjon feiltype(f) -> tekst {
    prøv {
        f()
    } fang (e: FrosenFeil) {
        returner "FrosenFeil"
    } fang (e) {
        returner "anna:" + tekst(e)
    }
    returner "ingen feil"
}

funksjon c0() -> tekst {
    la f = frys([1, 2, 3])
    la sum = 0
    for x i f { sum = sum + x }
    returner tekst(lengde(f)) + "/" + tekst(f[0]) + "/" + tekst(sum) + "/" + tekst(er_frosen(f)) + "/" + tekst(f[2])
}

funksjon c1() -> tekst {
    la f = frys([1, 2, 3])
    la a = feiltype(fun() -> sett_indeks(f))
    la b = feiltype(fun() -> legg_til(f, 4))
    la c = feiltype(fun() -> pop_siste(f))
    la d = feiltype(fun() -> sett_inn(f, 0, 9))
    returner a + "," + b + "," + c + "," + d + "," + tekst(lengde(f)) + tekst(f[0])
}

funksjon sett_indeks(f) {
    f[0] = 99
}

funksjon c2() -> tekst {
    la o = frys({"a": 1, "b": [1, 2], "c": {"d": 5}})
    la a = feiltype(fun() -> sett_nokkel(o, "a"))
    la b = feiltype(fun() -> sett_nokkel(o, "ny"))
    la c = feiltype(fun() -> sett_djup(o))
    la d = feiltype(fun() -> sett_djup2(o))
    returner a + "," + b + "," + c + "," + d + "," + tekst(o["a"]) + tekst(o["b"][1]) + tekst(o["c"]["d"]) + tekst(lengde(nøkler(o)))
}

funksjon sett_nokkel(o, k: tekst) {
    o[k] = 2
}

funksjon sett_djup(o) {
    o["b"][0] = 5
}

funksjon sett_djup2(o) {
    o["c"]["d"] = 6
}

funksjon c3() -> tekst {
    la p = frys(Punkt(1, 2))
    la a = feiltype(fun() -> sett_felt(p))
    la b = feiltype(fun() -> p.flytt())
    returner a + "," + b + "," + tekst(p.x) + tekst(p.y) + tekst(p.sum()) + tekst(er_frosen(p))
}

funksjon sett_felt(p) {
    p.x = 10
}

funksjon c4() -> tekst {
    # original uendra, frosen er ei kopi
    la orig = [1, [2, 3]]
    la f = frys(orig)
    orig[0] = 100
    legg_til(orig[1], 4)
    returner tekst(f[0]) + tekst(lengde(f[1])) + tekst(er_frosen(orig)) + tekst(er_frosen(f)) + tekst(er_frosen(f[1]))
}

funksjon c5() -> tekst {
    # tin gjev mutabel djup kopi
    la f = frys({"l": [1, 2]})
    la m = tin(f)
    legg_til(m["l"], 3)
    m["ny"] = 7
    return_c5(f)
    returner tekst(lengde(m["l"])) + tekst(m["ny"]) + tekst(lengde(f["l"])) + tekst(er_frosen(m)) + tekst(er_frosen(m["l"]))
}

funksjon return_c5(f) -> heiltall { returner 0 }

funksjon c6() -> tekst {
    # likskap, tekst og skalarar
    la f = frys([1, 2])
    returner tekst(f == [1, 2]) + tekst([1, 2] == f) + tekst(f == frys([1, 2])) + tekst(f == [1, 3]) + tekst(er_frosen(5)) + tekst(er_frosen("a")) + tekst(frys(5) + 1)
}

funksjon c7() -> tekst {
    # FrosenFeil er under Unntak; fang-alt og typa fang
    la f = frys([1])
    la s = ""
    prøv { f[0] = 2 } fang (e: Unntak) { s = s + "u" }
    prøv { f[0] = 2 } fang (e: FrosenFeil) { s = s + "f" }
    prøv { f[0] = 2 } fang (e: TypeFeil) { s = s + "t" } fang (e) { s = s + "a" }
    prøv { legg_til(f, 1) } fang (e) { s = s + tekst(e) }
    returner s
}

funksjon c8() -> tekst {
    # frosen samling i lista/ordboka: elementet er frosent, containaren kan endrast
    la mut = []
    legg_til(mut, frys([1, 2]))
    legg_til(mut, 5)
    la s = tekst(lengde(mut)) + tekst(er_frosen(mut[0])) + tekst(er_frosen(mut))
    mut[1] = 6
    returner s + tekst(mut[1]) + feiltype(fun() -> sett_indeks(mut[0]))
}

funksjon c9() -> tekst {
    # for over frosen ordbok gjev nøklane; tom frosen liste
    la o = frys({"k": 1})
    la s = ""
    for k i o { s = s + k + tekst(o[k]) }
    la n = 0
    for x i frys([]) { n = n + 1 }
    return_c5(o)
    returner s + tekst(n) + tekst(builtin.type(frys([1]))) + tekst(builtin.type(o))
}

funksjon start() -> tekst {
    la d = [c0(), c1(), c2(), c3(), c4(), c5(), c6(), c7(), c8(), c9()]
    returner builtin.join(d, "|")
}
