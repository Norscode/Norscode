// Fase 8: split (streng → liste av delstrengar; generell fleirteikns-delim).
// éitt operand per linje for å unngå presedens-tvil.
// 3 + len("a")=1 + len("ccc")=3 + 3 + len("yy")=2 = 12.
funksjon start() -> heiltall {
    la parts = builtin.split("a,bb,ccc", ",")
    la total = lengde(parts)
    total = total + lengde(parts[0])
    total = total + lengde(parts[2])
    la p2 = builtin.split("xx--yy--zz", "--")
    total = total + lengde(p2)
    total = total + lengde(p2[1])
    returner total
}
