// GC reclaim-probe: gc_free ein blokk, så gc_alloc gjenbrukar han (fri-liste).
funksjon start() -> heiltall {
    la base = builtin.heap_bump() + 4096       // trygt fritt heap-område
    builtin.gc_free(base, 64)                   // push 64B fri-blokk @ base
    la a = builtin.gc_alloc(32)                 // head-fit: 64>=32 → gjenbruk base
    hvis a == base {
        skriv("reclaim OK: gc_alloc gjenbrukte gc_free-blokka\n")
        // gc_alloc(64) igjen: fri-lista er no tom → skal bumpe (a2 != base)
        la a2 = builtin.gc_alloc(16)
        hvis a2 != base {
            skriv("reclaim OK 2: tom fri-liste → gc_alloc bumpar\n")
            returner 0
        }
        skriv("reclaim FEIL 2: gjenbrukte tom fri-liste\n")
        returner 1
    }
    skriv("reclaim FEIL: gc_alloc gjenbrukte ikkje blokka\n")
    returner 1
}
