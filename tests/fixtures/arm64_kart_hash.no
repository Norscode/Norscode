// R2 / F25: ARM64-AOT-kart med hash-indeks og typa nøklar (som x86 map_hash/map_find).
// Dekkjer store kart (indeks byggjer seg og veks), overskriving, fjern_nokkel (indeksen blir
// bygd på nytt), innsetjingsrekkjefølgje, heiltals-/bool-nøklar (typa, med tekst-fallback for
// heiltal som x86), json_parse-kart utan indeks (blir bygd ved første oppslag) og json_stringify
// av typa nøklar. Ein søppel-straum mellom operasjonane driv GC-en i GC-bygget.

funksjon ut(s: tekst) -> heiltall {
    skriv(s + "\n")
    returner 0
}

funksjon søppel(n: heiltall) -> heiltall {
    la i = 0
    la s = 0
    mens i < n {
        la l = [i, i + 1, "x" + tekst(i)]
        s = s + lengde(l)
        i = i + 1
    }
    returner s
}

funksjon start() -> heiltall {
    // 1. Stort tekstkart: innsetjing, oppslag, overskriving.
    la m = {}
    la i = 0
    mens i < 5000 {
        m["k" + tekst(i)] = i
        i = i + 1
    }
    søppel(20000)
    la sum = 0
    i = 0
    mens i < 5000 {
        sum = sum + m["k" + tekst(i)]
        i = i + 1
    }
    m["k7"] = 700
    m["k4999"] = 1
    ut("A n=" + tekst(lengde(m)) + " sum=" + tekst(sum) + " k7=" + tekst(m["k7"]) + " k4999=" + tekst(m["k4999"]) + " manglar=" + builtin.type(m["k5000"]))
    ut("A har=" + tekst(har_nokkel(m, "k123")) + "/" + tekst(har_nokkel(m, "k5000")) + "/" + tekst(finnes_nøkkel(m, "k0")))

    // 2. fjern_nokkel i stort kart: indeksen blir bygd på nytt, rekkjefølgja står.
    i = 0
    mens i < 5000 {
        hvis i % 3 == 0 { fjern_nokkel(m, "k" + tekst(i)) }
        i = i + 1
    }
    søppel(20000)
    la att = 0
    la borte = 0
    i = 0
    mens i < 5000 {
        hvis har_nokkel(m, "k" + tekst(i)) { att = att + 1 } ellers { borte = borte + 1 }
        i = i + 1
    }
    la ks = nøkler(m)
    ut("B n=" + tekst(lengde(m)) + " att=" + tekst(att) + " borte=" + tekst(borte) + " første=" + tekst(ks[0]) + "," + tekst(ks[1]) + " siste=" + tekst(ks[lengde(ks) - 1]))
    m["k3"] = 33
    ut("B k3=" + tekst(m["k3"]) + " k4=" + tekst(m["k4"]) + " siste=" + tekst(nøkler(m)[lengde(m) - 1]) + " n=" + tekst(lengde(m)))

    // 3. Heiltalsnøklar (typa) i stort kart + bool-nøklar.
    la h = {}
    i = 0
    mens i < 3000 {
        h[i * 7] = i
        i = i + 1
    }
    søppel(10000)
    la hs = 0
    i = 0
    mens i < 3000 {
        hs = hs + h[i * 7]
        i = i + 1
    }
    ut("C n=" + tekst(lengde(h)) + " sum=" + tekst(hs) + " h[14]=" + tekst(h[14]) + " h[15]=" + builtin.type(h[15]) + " type(nøkkel)=" + builtin.type(nøkler(h)[1]))
    ut("C har=" + tekst(har_nokkel(h, 21)) + "/" + tekst(har_nokkel(h, "21")) + "/" + tekst(har_nokkel(h, 22)))
    la b = {}
    b[sann] = "ja"
    b[usann] = "nei"
    b[sann] = "JA"
    ut("D bool n=" + tekst(lengde(b)) + " sann=" + tekst(b[sann]) + " usann=" + tekst(b[usann]))

    // 4. Heiltal mot tekstnøkkel (x86-paritet): d[0] finn "0"; d[0] = … oppdaterer "0".
    la d = {"0": "null", "1": "ein"}
    d[0] = "NULL"
    d[2] = "to"
    ut("E d[0]=" + tekst(d[0]) + " d[\"0\"]=" + tekst(d["0"]) + " d[1]=" + tekst(d[1]) + " d[2]=" + tekst(d[2]) + " n=" + tekst(lengde(d)) + " har(\"2\")=" + tekst(har_nokkel(d, "2")))

    // 5. json_parse-kart (ingen indeks) med mange nøklar → indeks ved første oppslag.
    la js = "{"
    i = 0
    mens i < 40 {
        hvis i > 0 { js = js + "," }
        js = js + "\"f" + tekst(i) + "\":" + tekst(i * 2)
        i = i + 1
    }
    js = js + "}"
    la jo = json_parse(js)
    la jsum = 0
    i = 0
    mens i < 40 {
        jsum = jsum + jo["f" + tekst(i)]
        i = i + 1
    }
    jo["ny"] = 1
    ut("F n=" + tekst(lengde(jo)) + " sum=" + tekst(jsum) + " f39=" + tekst(jo["f39"]) + " ny=" + tekst(jo["ny"]))

    // 6. json_stringify av typa nøklar.
    la t = {}
    t[1] = "a"
    t["b"] = 2
    t[sann] = usann
    ut("G " + json_stringify(t))

    // 7. Mange små kart (under indeksgrensa) og eit kart som veks forbi grensa i små steg.
    la små = []
    i = 0
    mens i < 200 {
        legg_til(små, {"a": i, "b": i + 1})
        i = i + 1
    }
    la ss = 0
    for k i små { ss = ss + k["a"] + k["b"] }
    la v = {}
    i = 0
    mens i < 40 {
        v["v" + tekst(i)] = i
        hvis i % 5 == 4 { fjern_nokkel(v, "v" + tekst(i - 2)) }
        i = i + 1
    }
    ut("H små=" + tekst(ss) + " v.n=" + tekst(lengde(v)) + " v0=" + tekst(v["v0"]) + " v2=" + builtin.type(v["v2"]) + " v39=" + tekst(v["v39"]))
    returner 0
}
