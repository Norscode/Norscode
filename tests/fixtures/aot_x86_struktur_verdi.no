// AOT-fikstur (R4/F22): automatisk til_tekst og strukturell likskap for strukturar.
// Same program på VM og linux-x86_64-AOT skal gje identisk utskrift.
// (Ordbøker i lister blir «[verdi]» i AOT, så fiksturen har dei ikkje.)
struktur Punkt {
    x: heltall
    y: heltall
}
struktur Linje {
    a: Punkt
    b: Punkt
    navn: tekst
}
struktur Boks {
    inn
    lst
}
struktur Navngjeven {
    n: tekst
}
funksjon Navngjeven.til_tekst(self) -> tekst { returner "<" + self.n + ">" }
struktur Eigen {
    v: heltall
}
funksjon Eigen.er_lik(self, andre) -> boolsk { returner self.v % 10 == andre.v % 10 }
struktur Node {
    namn: tekst
    neste
}
struktur Blanda {
    t: tekst
    ok: boolsk
    ingen
}

la ut: liste_tekst = []

funksjon vis(etikett: tekst, v) -> heiltall {
    legg_til(ut, etikett + "=" + tekst(v))
    returner 0
}

funksjon lag() -> tekst {
    la p = Punkt(1, 2)
    la q = Punkt(1, 2)
    la r = Punkt(3, 4)
    la l = Linje(p, r, "l1")
    vis("punkt", p)
    vis("linje", l)
    vis("boks", Boks(l, [p, r]))
    vis("eigen_tekst", Navngjeven("a"))
    vis("konkat", "s=" + p)
    vis("liste", [p, Navngjeven("z")])
    vis("blanda", Blanda("a=b", sann, null))
    la n = Node("a", null)
    n.neste = n
    vis("syklus", n)
    vis("p==q", p == q)
    vis("p==r", p == r)
    vis("p!=r", p != r)
    vis("p!=q", p != q)
    vis("boks1", Boks(p, [1]) == Boks(q, [1]))
    vis("boks2", Boks(p, [1]) == Boks(q, [2]))
    vis("ulike_typar", Punkt(1, 1) == Eigen(1))
    vis("er_lik1", Eigen(3) == Eigen(13))
    vis("er_lik2", Eigen(3) != Eigen(13))
    vis("er_lik3", Eigen(3) == Eigen(4))
    vis("lister", [p] == [q])
    vis("mot_null", p == null)
    vis("null_mot", null == p)
    vis("linjer", Linje(p, r, "x") == Linje(q, r, "x"))
    vis("linjer2", Linje(p, r, "x") == Linje(q, r, "y"))
    returner builtin.join(ut, "\n") + "\n"
}

// AOT-inngang: skriv(struktur) direkte, så resten av linjene.
funksjon start() -> heiltall {
    skriv(Punkt(5, 6))
    skriv("\n")
    skriv(lag())
    returner 0
}
