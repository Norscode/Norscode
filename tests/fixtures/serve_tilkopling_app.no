# Fikstur for tests/test_serve_tilkopling.no (2.9): liten app under ekte `nc serve`
# over sokkel (keep-alive, ledig sokkel, 408/503, SIGHUP/SIGTERM + shutdown_hooks).
bruk std.web som web

funksjon heim(ctx) {
    web.route("GET /")
    returner "ok"
}

funksjon andre(ctx) {
    web.route("GET /andre")
    returner "andre"
}

funksjon ekko(ctx) {
    web.route("POST /ekko")
    returner "ekko:" + tekst(ctx["__body__"])
}

# Binær body (ut_bytes-vegen i nc serve): sendast uendra etter headerane.
funksjon binær(ctx) {
    web.route("GET /bin")
    returner web.response_bytes(200, {"Content-Type": "application/octet-stream"}, builtin.bytes_from_list([104, 101, 105, 0, 1, 127]))
}

funksjon stopp_logg() -> heltall {
    web.shutdown_hook()
    skriv("SHUTDOWN_HOOK_KOYRDE\n")
    returner 0
}

funksjon start() -> heltall {
    returner 0
}
