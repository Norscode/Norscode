# Testapp for NSP/1-tenaren (std/synk.no under std/apptenar.no). Brukt av
# tests/test_synk_tenar.no, tests/test_synk_negativ.no og målingane i
# docs/APPTENAR_SYNK.md. Miljø (krev env.read):
#   SYNK_DATA   datamappa (absolutt)
#   SYNK_MAKS_DOK, SYNK_MAKS_OPS, SYNK_SJEKKPUNKT_BYTE (valfrie tak)
#   SYNK_MS     tidsgrense for prosessen (standard 150000)
# Sesjonar (cookie nc_sesjon): t-u1 → u1, t-u2 → u2, t-utgatt → utgått (ikkje innlogga).
bruk std.web som web
bruk std.apptenar som app
bruk std.synk som synk

funksjon _miljø(namn: tekst, standard: tekst) -> tekst {
    la v = ""
    prøv { v = builtin.miljo_hent(namn) } fang (e) { v = "" }
    hvis v == "" { returner standard }
    returner v
}

# Appen sin sesjonsoppslag for synk. Eit ukjent eller utgått token gjev {}.
funksjon synk_brukar(ctx: ordbok_tekst) -> ordbok_tekst {
    la t = app.cookie(ctx, "nc_sesjon")
    hvis t == "t-u1" { returner {"uid": "u1", "sesjon": "s-u1"} }
    hvis t == "t-u2" { returner {"uid": "u2", "sesjon": "s-u2"} }
    hvis t == "t-kast" { kast "sesjonslageret svarar ikkje" }
    returner {}
}

# Ein open funksjon med eit vaktnamn: skal IKKJE opne synk-endepunkta (dei brukar ikkje
# vakter, men sjekkar brukaren i handlaren).
funksjon krev_brukar(ctx: ordbok_tekst) -> bool {
    returner sann
}

funksjon t_sjekkpunkt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /test/sjekkpunkt")
    synk.sjekkpunkt()
    returner {"status": 200, "body": "ok"}
}

funksjon t_slett(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /test/slett/{uid}")
    returner {"status": 200, "body": tekst(synk.slett_brukar(web.request_param(ctx, "uid")))}
}

funksjon t_epoke(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /test/ny_epoke")
    returner {"status": 200, "body": synk.ny_epoke()}
}

funksjon t_status(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /test/status")
    la s = synk.status()
    returner {"status": 200, "content_type": "application/json", "body": builtin.json_stringify(s)}
}

funksjon t_stopp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /test/stopp")
    synk.sjekkpunkt()
    app.stopp()
    returner {"status": 200, "body": "stoppar"}
}

funksjon start() -> heltall {
    synk.sett_opp({
        "datamappe": _miljø("SYNK_DATA", ""),
        "brukar_fn": "__main__.synk_brukar",
        "samlingar": {
            "oppg": {"felt": {"tittel": "tekst", "ferdig": "bool", "pri": "heltall", "notat": "tekst"}, "maks_byte": 2048},
            "merke": {"felt": {"namn": "tekst", "farge": "tekst"}, "maks_byte": 256}
        },
        "maks_dok_per_brukar": heltall_fra_tekst(_miljø("SYNK_MAKS_DOK", "10000")),
        "maks_ops_per_push": heltall_fra_tekst(_miljø("SYNK_MAKS_OPS", "500")),
        "sjekkpunkt_byte": heltall_fra_tekst(_miljø("SYNK_SJEKKPUNKT_BYTE", "1048576"))
    })
    returner app.lytt({
        "port": 0,
        "maks_ms": heltall_fra_tekst(_miljø("SYNK_MS", "150000")),
        "sse_hb_ms": 1000,
        "logg": "feil"
    })
}
