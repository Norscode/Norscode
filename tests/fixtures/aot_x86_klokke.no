// AOT-fikstur (rA-os punkt 6/7): tid_ms() og mono_ms() på linux-x86_64.
//   Vanleg køyring: exit 42 (tid_ms > 0, mono_ms monoton, vent.sov 30 ms gjev ≥ 25 ms differanse).
//   Køyrt med clock_gettime nekta (seccomp errno): exit 43 — begge gjev −errno (< 0), ikkje søppel
//   frå uinitialisert stakk (140737488289536004 før fiksen).
//   Andre utfall: 2..5 = steg som feila, 44 = blanda/uventa verdiar.
bruk std.native_gap

funksjon start() -> heiltall {
    la t0 = tid_ms()
    la m0 = mono_ms()
    la n0 = builtin.now_ms()
    skriv("tid_ms=" + tekst_fra_heltall(t0) + " now_ms=" + tekst_fra_heltall(n0) + " mono_ms=" + tekst_fra_heltall(m0) + "\n")
    hvis t0 < 0 og n0 < 0 og m0 < 0 {
        // Nekta klokke: feilkontrakten (−errno, lita verdi — ikkje stakk-søppel).
        hvis t0 < -4096 eller n0 < -4096 eller m0 < -4096 { returner 44 }
        returner 43
    }
    hvis t0 < 1000000000000 { returner 2 }
    hvis m0 < 0 eller n0 < 1000000000000 { returner 3 }
    vent.sov(30)
    la m1 = mono_ms()
    la t1 = tid_ms()
    hvis m1 - m0 < 25 { returner 4 }
    hvis m1 - m0 > 2000 { returner 4 }
    hvis t1 < t0 { returner 5 }
    returner 42
}
