// A0-review: legg_til på ei liste frå ein køyretids-produsent. Den amortiserte
// emit_legg_til skriv på plass når count ikkje er ein toarpotens, så produsenten
// må reservere next_pow2(count) slots — elles går skrivinga inn i neste objekt.
// utvid er native-builtinen som M10-spread ([...a, ...b]) blir senka til. Kallet
// er direkte fordi macOS-seedane ikkje parsar spread; VM-en har ikkje utvid for
// brukarkode, så denne fixturen er berre for native codegen.
// Strengen s ligg rett bak utvid sin nye listdata (sentinel som over).
funksjon start() -> heiltall {
    la c = [1, 2, 3]
    la b = [4, 5]
    utvid(c, b)
    la s = "abc"
    legg_til(c, 6)
    hvis lengde(s) != 3 { returner 1 }
    returner lengde(c) * 10 + c[5] + lengde(s) + 50
}
