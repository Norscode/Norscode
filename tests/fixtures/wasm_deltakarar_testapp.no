# Testapp for deltakar-demoen (W6): den ekte examples/wasm_deltakarar/app.no (rutene hennar blir
# med), sida /test med <pre id="nc-logg"> der logg_test skriv i testbygg, og /api/stopp, som
# avsluttar nc serve (offline-steget i testklienten).
# W7 (tests/fixtures/wasm_deltakarar_lager_testklient.no): /api/deltakarar_treg er same svar som
# GET /api/deltakarar etter 800 ms (så den lokale kopien alltid kjem før tenarsvaret), og
# /api/puls held den virtuelle tida i Chrome stille medan IndexedDB arbeider (sjå
# tests/fixtures/wasm_w7_lager_testapp.no).
bruk std.web som web
bruk std.wasm_serve som ws
bruk examples.wasm_deltakarar.app som app

# Testsida (W8: òg app-skal i tests/fixtures/wasm_deltakarar_pwa_testapp.no).
funksjon test_html() -> tekst {
    returner app.side_html("<pre id=\"nc-logg\"></pre>")
}

funksjon test_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /test")
    returner ws.side(test_html())
}

funksjon api_stopp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/stopp")
    builtin.exit(0)
    returner app.json_svar(200, {})
}

funksjon api_treg(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/deltakarar_treg")
    la t0 = builtin.tid_ms()
    mens builtin.tid_ms() - t0 < 800 { }
    returner app.hent_deltakarar(ctx)
}

funksjon api_puls(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/puls")
    returner ws.svar("text/plain; charset=utf-8", "p", ws.csp_standard(), "no-store")
}

funksjon start() -> heltall {
    returner 0
}
