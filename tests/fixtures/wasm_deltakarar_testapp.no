# Testapp for deltakar-demoen (W6): den ekte examples/wasm_deltakarar/app.no (rutene hennar blir
# med), sida /test med <pre id="nc-logg"> der logg_test skriv i testbygg, og /api/stopp, som
# avsluttar nc serve (offline-steget i testklienten).
bruk std.web som web
bruk std.wasm_serve som ws
bruk examples.wasm_deltakarar.app som app

funksjon test_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /test")
    returner ws.side(app.side_html("<pre id=\"nc-logg\"></pre>"))
}

funksjon api_stopp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/stopp")
    builtin.exit(0)
    returner app.json_svar(200, {})
}

funksjon start() -> heltall {
    returner 0
}
