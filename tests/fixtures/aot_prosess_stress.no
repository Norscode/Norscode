// AOT (linux-x86_64): tests/test_native_process_stress.no bygd med gjeldande codegen og
// std.native_gap frå KJELDE (ikkje seeden sin baka spawn-motor). Gjev CI-dekning av
// Norscode-spawn-motoren (F3.2) før seed-promotering, då VM-vegen på den committa seeden
// framleis har den gamle motoren. Exit 42 når alt stemmer; assert-feil gjev exit 1.
bruk std.native_gap
bruk tests.test_native_process_stress som stress

funksjon start() -> heiltall {
    la r = stress.start()
    hvis r != 0 { returner r }
    returner 42
}
