// Kortslutta `og`/`eller` i ein MEM-MODUS-funksjon (4-nøkkel-map-retur → djupn 8).
funksjon f(a: heiltall) -> ordbok {
    hvis a != 2 og a != 4 { returner {"s": 1, "e": 0, "t": a, "p": a * 2} }
    returner {"s": 0, "e": 9, "t": a, "p": 0}
}
funksjon g(n: heiltall, len: heiltall) -> ordbok {
    hvis n != len eller len < 16 { returner {"s": 0, "e": 1, "t": 0, "p": 0} }
    returner {"s": 1, "e": 0, "t": n, "p": len}
}
funksjon start() -> heiltall {
    la r5 = f(5)  la r4 = f(4)
    la ga = g(28, 28)  la gb = g(10, 28)
    // r5.s=1 r5.p=10 ; r4.s=0 ; ga.s=1 ga.p=28 ; gb.s=0
    returner r5["s"] * 100 + r5["p"] + r4["s"] * 50 + ga["s"] * 10 + ga["p"] + gb["s"] * 30
    // 100 + 10 + 0 + 10 + 28 + 0 = 148
}
