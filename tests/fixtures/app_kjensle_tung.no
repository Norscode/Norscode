// Fikstur for app-kjensle A0: køyrer under `nc serve` (barneprosess i
// tests/test_app_kjensle_serve.no, og for hand ved gevinstmålinga i
// docs/APP_KJENSLE.md). Svara følgjer den felles responskontrakten
// (std/http_cache.no) og er deterministiske: ingen klokke, ingen tilfeldige tal,
// so utdata kan samanliknast byte for byte mellom VM_FAST=0 og VM_FAST=1.
//
//   GET /            «ok» (tenaren lever)
//   GET /ekko-cookie verdien av cookien nc_demo (header-kasus: «Cookie»)
//   GET /etag-side   HTML med sterk ETag, no-cache og tryggleiksheaderar
//   GET /vakt        verna av ei TOTAL vakt som tolkar cookien nc_rtt
//   GET /liste       tabell med 50 rader
//   GET /liste-500   tabell med 500 rader (berre gevinstmålinga)
bruk std.web som web
bruk std.http_cache som hc

// Vakt-regelen (docs/APP_KJENSLE.md): ei vakt er TOTAL. All logikk ligg i
// prøv/fang, og kvart unntak gjev usann (403). Eit unntak som slepp ut av ei
// vakt, tek ned heile nc serve i dag (nc_main.no kallar vakta utan prøv; R1).
// nc_rtt=<ms> simulerer rundtur (maks 2000 ms); ein ugyldig verdi kastar.
funksjon rtt_vakt(ctx: ordbok_tekst) -> bool {
    web.guard()
    prøv {
        la rå = web.request_cookie(ctx, "nc_rtt")
        hvis rå == "" { returner sann }
        la ms = heltall_fra_tekst(rå)
        hvis tekst(ms) != rå { kast "nc_rtt er ikkje eit heiltal: " + rå }
        hvis ms > 0 og ms <= 2000 { builtin.sov(ms) }
        returner sann
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon rot_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /")
    returner hc.nytt_svar(200, "text/plain; charset=utf-8", "ok")
}

funksjon ekko_cookie(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /ekko-cookie")
    la s = hc.nytt_svar(200, "text/plain; charset=utf-8", web.request_cookie(ctx, "nc_demo"))
    returner hc.med_header(s, "cache-control", "private, no-store")
}

funksjon etag_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /etag-side")
    la html = "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">" +
        "<title>ETag</title></head><body><main id=\"app-main\" class=\"app-main\" data-nc-outlet>" +
        "<p>Stabil side</p></main></body></html>"
    returner hc.med_tryggleik(hc.svar_revalider(html, "text/html; charset=utf-8"))
}

funksjon vakt_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("rtt_vakt")
    web.route("GET /vakt")
    returner hc.nytt_svar(200, "text/plain; charset=utf-8", "vakt-ok")
}

funksjon _rader(n: heiltall) -> liste {
    la ut = []
    la i: heiltall = 0
    mens i < n {
        legg_til(ut, {"id": tekst(i), "tittel": "Oppgave nr " + tekst(i) + " <&>", "ferdig": i % 3 == 0})
        i = i + 1
    }
    returner ut
}

funksjon _liste_html(n: heiltall) -> tekst {
    la d = _rader(n)
    la kropp = ""
    la i: heiltall = 0
    mens i < lengde(d) {
        la r = d[i]
        la status = "open"
        hvis r["ferdig"] { status = "ferdig" }
        kropp = kropp + "<tr class=\"" + status + "\"><td>" + web.escape_html(r["id"]) +
            "</td><td><a href=\"/oppgave/" + web.escape_html(r["id"]) + "\">" +
            web.escape_html(r["tittel"]) + "</a></td></tr>"
        i = i + 1
    }
    returner "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>Liste</title></head>" +
        "<body><main id=\"app-main\" class=\"app-main\" data-nc-outlet><table>" + kropp +
        "</table></main></body></html>"
}

funksjon liste_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /liste")
    returner hc.med_tryggleik(hc.svar_revalider(_liste_html(50), "text/html; charset=utf-8"))
}

funksjon liste_500_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /liste-500")
    returner hc.med_tryggleik(hc.svar_revalider(_liste_html(500), "text/html; charset=utf-8"))
}
