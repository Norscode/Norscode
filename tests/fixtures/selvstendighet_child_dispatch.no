// Ekte barn for strict-dispatchtesten. Berre denne eigaren skriv markøren;
// ein utilsikta nc_main-selftest må aldri kunne gje eit falskt grønt resultat.
funksjon start() -> heiltall {
    la markør = builtin.miljo_hent("NORSCODE_STRICT_DISPATCH_MARKER")
    hvis markør == "" { returner 41 }
    la kommando = builtin.miljo_hent("NORSCODE_CMD")
    la fil = builtin.miljo_hent("NORSCODE_FILE")
    la verdi = builtin.miljo_hent("NORSCODE_STRICT_DISPATCH_VALUE")
    la exit_code = builtin.miljo_hent("NORSCODE_STRICT_DISPATCH_EXIT")
    builtin.fil_skriv(markør, kommando + "\n" + fil + "\n" + verdi + "\n" + exit_code + "\n")
    returner heiltall_fra_tekst(exit_code)
}
