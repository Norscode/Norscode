// gc_argv_arm64_probe.no — argv-lista frå __argv_list overlever GC (A34, AArch64, GC-modus).
// Køyr med argument, t.d. `./gc_argv_arm64_probe alfa beta gamma-delta`.
//
// A3 bygde boksane i __argv_list for hand ved x28. I GC-modus er x28 ikkje alltid 16-aligna
// (ope bygde payloadar som tekst(heiltal) sluttar på vilkårleg byte), og markøren avviser
// ualigna boksar: argv-strengane vart då frigjorde medan lista levde, og churn skreiv over
// dei. A34 tek boksane frå __gc_alloc i GC-modus. Proben gjer x28 ualigna (tekst(12345)) rett
// før kallet, les argv, churnar gjennom fleire collects og samanliknar sjekksummen.
// gc-integ (#204): same feil og same retting i ncd_emit_argv_liste / emit_argv_op_routine.
//
// Exit: 0 = OK · 2 = argv endra etter GC · 3 = for få argument (proben treng ≥ 2) ·
// 4 = færre enn 2 collects (proben prøvde ingenting).
funksjon heap_va() -> heiltall {
    la hb: heiltall = builtin.heap_bump()
    returner hb - (hb % 68719476736)
}

funksjon sum_argv(a) -> heiltall {
    la h: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(a) {
        la s = a[i]
        la j: heiltall = 0
        mens j < lengde(s) {
            h = (h * 131 + builtin.char_code(builtin.slice(s, j, j + 1)) + i) % 1000000007
            j = j + 1
        }
        i = i + 1
    }
    returner h
}

funksjon churn(n: heiltall) -> heiltall {
    la i: heiltall = 0
    la sum: heiltall = 0
    mens i < n {
        la l = []
        la j: heiltall = 0
        mens j < 200 {
            legg_til(l, "støy" + tekst(j))
            j = j + 1
        }
        sum = sum + lengde(l)
        i = i + 1
    }
    returner sum
}

funksjon start() -> heiltall {
    la ujamn = tekst(12345)
    la a = builtin.argv_list_v1()
    hvis lengde(a) < 2 {
        skriv("gc_argv_arm64 FEIL: treng minst eitt argument (fekk " + tekst(lengde(a)) + ")\n")
        returner 3
    }
    la før: heiltall = sum_argv(a)
    la c: heiltall = churn(30000)
    la etter: heiltall = sum_argv(a)
    la collects: heiltall = builtin.raw_load64(heap_va() + 80)
    skriv("gc_argv_arm64: argc=" + tekst(lengde(a)) + " sum=" + tekst(før) + "/" + tekst(etter) + " churn=" + tekst(c) + " collects=" + tekst(collects) + " " + ujamn + "\n")
    hvis etter != før {
        skriv("gc_argv_arm64 FEIL: argv endra etter GC\n")
        returner 2
    }
    hvis collects < 2 {
        skriv("gc_argv_arm64 FEIL: berre " + tekst(collects) + " collects\n")
        returner 4
    }
    skriv("gc_argv_arm64 OK\n")
    returner 0
}
