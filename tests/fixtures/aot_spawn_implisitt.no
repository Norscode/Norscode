// AOT-fikstur for F3.2-porten: spawnar gjennom tools.process_runner (→ std.runtime.process_abi
// → builtin.process_spawn_argv) UTAN `bruk std.native_gap`. Codegen kompilerer spawn-kallet til
// std.native_gap.process_spawn_argv_gap og kastar når funksjonen manglar i bunten, so dette
// byggjer berre når `nc bygg-native` legg modulen til implisitt (nc_aot_treng_native_gap i
// selfhost/nc_main.no). Exit 42 når barnet svarar rett; 2–4 = feil i spawn-resultatet.
bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la r = prosess.køyr("/bin/echo", ["aot-spawn-implisitt"], "", {}, 20000)
    hvis tekst(r["status"]) != "ferdig" {
        skriv("aot_spawn_implisitt FEIL: status=" + tekst(r["status"]) + " error=" + tekst(r["error"]) + "\n")
        returner 2
    }
    hvis heltall_fra_tekst(tekst(r["exit_code"])) != 0 {
        skriv("aot_spawn_implisitt FEIL: exit=" + tekst(r["exit_code"]) + "\n")
        returner 3
    }
    hvis ikkje builtin.contains(tekst(r["stdout"]), "aot-spawn-implisitt") {
        skriv("aot_spawn_implisitt FEIL: stdout=" + tekst(r["stdout"]) + "\n")
        returner 4
    }
    skriv("aot_spawn_implisitt OK\n")
    returner 42
}
