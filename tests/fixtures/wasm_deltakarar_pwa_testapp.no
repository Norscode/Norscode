# Testapp for den installerbare deltakar-demoen (W8): testappen frå W6/W7
# (tests/fixtures/wasm_deltakarar_testapp.no: /test med <pre id="nc-logg">, /api/puls og
# /api/stopp) med PWA-konfigurasjonen til demoen, der testsida /test òg er app-skal (så ho kan
# opnast utan nett). tests/test_wasm_w8_demo.no og tests/test_wasm_w8_oppdatering.no byggjer
# henne med NC_WASM_SW=1. I tillegg, for dei negative kontrollane:
#   GET /mi-side    ei «innlogga» side med persondata UTAN Cache-Control private (berre no-cache,
#                   som mange appar gjer); privat i konfigurasjonen, så workeren verken lagrar ho
#                   eller viser ho frå cachen (det er konfigurasjonen, ikkje headeren, som vernar)
#   GET /nyheiter   ei eksplisitt offline-rute («nyheiter v1»). ?ny=1 gjev «nyheiter v2»
#                   (lagra: positiv kontroll), ?feil=403 gjev 403 og ?privat=1 gjev 200 med
#                   Cache-Control private: ingen av dei to skal skrive over oppføringa
#   GET /api/vent  svarar etter 0,4 s (privat, så workeren slepp han rett til nettet): held den
#                   virtuelle tida i Chrome i ro medan ein ny worker blir aktivert (testklienten)
bruk std.web som web
bruk std.wasm_serve som ws
bruk std.wasm_pwa som pwa
bruk examples.wasm_deltakarar.app som app
bruk tests.fixtures.wasm_deltakarar_testapp som testapp

funksjon nyheiter_v1() -> tekst {
    returner "nyheiter v1"
}

funksjon pwa_konfig() -> ordbok {
    la k = app.pwa_konfig()
    pwa.med_skal(k, "/test", testapp.test_html())
    pwa.med_offline_rute(k, "/nyheiter", nyheiter_v1())
    pwa.med_privat(k, "/mi-side")
    returner k
}

funksjon mi_side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /mi-side")
    returner ws.svar("text/html; charset=utf-8", "<!doctype html><html><body><p id=\"privat\">Persondata for Åse</p></body></html>",
        ws.csp_standard(), "no-cache")
}

funksjon nyheiter(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /nyheiter")
    hvis web.request_query_param(ctx, "feil") == "403" {
        la s = ws.svar("text/plain; charset=utf-8", "nekta", ws.csp_standard(), "no-cache")
        s["status"] = 403
        returner s
    }
    hvis web.request_query_param(ctx, "privat") == "1" {
        returner ws.svar("text/plain; charset=utf-8", "privat utgåve", ws.csp_standard(), "private")
    }
    hvis web.request_query_param(ctx, "ny") == "1" {
        returner ws.svar("text/plain; charset=utf-8", "nyheiter v2", ws.csp_standard(), "no-cache")
    }
    returner ws.svar("text/plain; charset=utf-8", nyheiter_v1(), ws.csp_standard(), "no-cache")
}

funksjon api_vent(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /api/vent")
    la t0 = builtin.tid_ms()
    mens builtin.tid_ms() - t0 < 400 { }
    returner ws.svar("text/plain; charset=utf-8", "v", ws.csp_standard(), "no-store")
}

funksjon start() -> heltall {
    returner 0
}
