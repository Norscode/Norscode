// Fase 6-JSON: json_parse over strengar, bool, nøsta lister, kart med blanda
// verdiar, og ein json_stringify→json_parse-rundtur (begge vegar samverkar).
// s="hello"(5) + true(+100) + n[0][1]=2 + n[1][0]=3 + len("Nor")=3 + o["n"]=5
// + rt[0..2]=9+8+7=24  →  5+100+5+8+24 = 142.
funksjon start() -> heiltall {
    la s = builtin.json_parse("\"hello\"")
    la t = builtin.json_parse("true")
    la n = builtin.json_parse("[[1, 2], [3, 4]]")
    la o = builtin.json_parse("{\"name\": \"Nor\", \"n\": 5}")
    la rt = builtin.json_parse(builtin.json_stringify([9, 8, 7]))
    la sum = lengde(s)
    hvis t { sum = sum + 100 }
    sum = sum + n[0][1] + n[1][0]
    sum = sum + lengde(tekst(o["name"])) + o["n"]
    sum = sum + rt[0] + rt[1] + rt[2]
    returner sum
}
