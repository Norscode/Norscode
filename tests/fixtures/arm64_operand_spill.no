// Red-test for operand-spilling: liste-literal >6 element og kart-literal >3 par.
// Begge overstig den register-baserte operand-stakken (x19–x24, maks djupn 6).
funksjon start() -> heiltall {
    la liste = [10, 20, 30, 40, 50, 60, 70]      // 7 element → djupn 7
    la kart = {"a": 1, "b": 2, "c": 3, "d": 4}   // 4 par → djupn 8
    la sum = 0
    la i = 0
    mens i < lengde(liste) {
        sum = sum + liste[i]
        i = i + 1
    }
    // sum = 280; + kart["a"]+kart["d"] = 1+4 = 5 → 285 → exit 285 & 0xFF = 29
    returner sum + kart["a"] + kart["d"]
}
