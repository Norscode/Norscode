// A0-review: legg_til på ei liste frå ein køyretids-produsent. Den amortiserte
// emit_legg_til skriv på plass når count ikkje er ein toarpotens, så produsenten
// må reservere next_pow2(count) slots — elles går skrivinga inn i neste objekt.
funksjon start() -> heiltall {
    la l = [1, 2, 3, 4, 5, 6, 7, 8]
    la s = builtin.slice(l, 0, 3)
    la y = [100]
    legg_til(s, 6)
    returner y[0] + lengde(s) + s[3]
}
