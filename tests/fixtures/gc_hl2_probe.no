bruk std.sha256 som sha
funksjon start() -> heiltall {
    la i: heiltall = 0
    mens i < 10 {
        la msg: liste_heiltall = []
        la j: heiltall = 0
        mens j < 40 { legg_til(msg, j)  j = j + 1 }
        la h = sha.hash_bytes(msg)
        i = i + 1
    }
    skriv("hl2 OK\n")
    returner 0
}
