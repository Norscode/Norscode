# Hjelparar for Chrome-testane av synk-klienten (W9): bygg testklienten
# (tests/fixtures/synk_klient_testklient.no) med testappen (tests/fixtures/synk_klient_testapp.no)
# og start han som barne-apptenar (nc run) under deploy-malen, med fast port, så opphavet (og
# dermed IndexedDB i Chrome-profilen) er det same etter ein omstart.
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.apptenar_hjelp som ah
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

# Bygg testklienten i testbygg med testappen. Byggjelinja må ha synk-gruppa, nett og lagring.
funksjon bygg(utmappe: tekst) -> tekst {
    la r = benk.bygg("tests/fixtures/synk_klient_testklient.no", utmappe, sann, "/_nc/", "tests/fixtures/synk_klient_testapp.no")
    hvis ikkje r["ok"] {
        skriv("bygget feila:\n" + r["ut"] + "\n")
        assert(usann)
    }
    la imp = benk.liste_felt(r["linje"], "importar")
    la venta = ["synk_sse", "synk_kanal", "synk_kanal_send", "synk_las", "synk_db_vakt", "synk_melding", "synk_uuid", "lager_start", "hent_start"]
    la i = 0
    mens i < lengde(venta) {
        hvis ikkje _har(imp, venta[i]) {
            skriv("bygget manglar importen " + venta[i] + ": " + r["linje"] + "\n")
            assert(usann)
        }
        i = i + 1
    }
    skriv("bygg: " + builtin.slice(r["linje"], 0, builtin.index_of(r["linje"], " v=")) + "\n")
    returner r["linje"]
}

funksjon _har(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon start_tenar(utmappe: tekst, data: tekst, port: tekst) -> ordbok {
    la a = ah.start_app(utmappe + "/serve.no", data, {"SYNK_DATA": data, "SYNK_PORT": port})
    hvis a["status"] != "kjorer" {
        skriv("testappen starta ikkje:\n" + tekst(a["ut"]) + "\n")
        assert(usann)
    }
    returner a
}

funksjon last(økt: ordbok, port: tekst, sti: tekst, profil: tekst) -> ordbok {
    returner benk.last_side(økt, "http://127.0.0.1:" + port + sti, {"profil": profil, "behald_profil": sann, "grense_ms": 45000})
}

funksjon linjer(l: liste) -> tekst {
    returner builtin.join(l, "\n") + "\n"
}

# Loggen (#nc-logg) må vere lik fasiten, og konsollen fri for «Uncaught».
funksjon krev_logg(namn: tekst, r: ordbok, venta: tekst) -> heltall {
    hvis r["logg"] != venta {
        skriv(namn + ": skil seg frå fasiten, " + kh.skilnad(r["logg"], venta) + "\nFekk:\n" + r["logg"] + "\nFasit:\n" + venta + "\nKonsoll:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    hvis r["uncaught"] {
        skriv(namn + ": «Uncaught» i konsollen:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    returner 0
}
