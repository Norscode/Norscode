# Hjelparar for Chrome-testane av synk-klienten (W9): bygg testklienten
# (tests/fixtures/synk_klient_testklient.no) med testappen (tests/fixtures/synk_klient_testapp.no)
# og start han som barne-apptenar (nc run) under deploy-malen, med fast port, så opphavet (og
# dermed IndexedDB i Chrome-profilen) er det same etter ein omstart.
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.apptenar_hjelp som ah
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

# Begge Chrome-testane brukar same bygg (om lag 30 s i fastmodus).
funksjon utmappe() -> tekst { returner "build/wasm/test_synk_klient/testbygg" }

# Kjeldene modulen og lastaren er laga av: klienten og det han importerer, og backenden.
# (Appen og testappen blir kompilerte når tenaren startar, så dei er ikkje med.)
funksjon kjelder() -> liste {
    returner ["tools/nc_wasm.no", "std/wasm_lowring.no", "std/wasm_atom.no", "std/wasm_binary.no", "std/wasm_vert.no",
              "std/wasm_js.no", "std/wasm_les.no", "std/wasm_rt.no", "std/wasm_nett.no", "std/wasm_lager.no",
              "std/wasm_pwa_klient.no", "std/synk_klient.no", "std/synk_kjerne.no", "std/sha256.no",
              "examples/wasm_synk/klient.no", "tests/fixtures/synk_klient_testklient.no"]
}

# sha256 over kjeldene (og runtimen): når stempelet i utmappa er det same, er bygget ferskt.
funksjon stempel() -> tekst {
    la rot = benk.rot()
    la alt = benk.runtime() + "\n"
    la k = kjelder()
    la i = 0
    mens i < lengde(k) {
        alt = alt + k[i] + "\n" + builtin.sha256(fil_les(rot + "/" + k[i])) + "\n"
        i = i + 1
    }
    returner builtin.sha256(alt)
}

# Bygg testklienten i testbygg med testappen, eller bruk bygget i utmappa når stempelet (sha256
# over kjeldene) er det same som då det vart laga. Byggjelinja må ha synk-gruppa, nett og lagring.
funksjon bygg(utmappe: tekst) -> tekst {
    la rot = benk.rot()
    la st = stempel()
    la st_fil = rot + "/" + utmappe + "/stempel.txt"
    la linje_fil = rot + "/" + utmappe + "/linje.txt"
    la r = {"ok": usann, "linje": "", "ut": ""}
    hvis builtin.fil_finnes(st_fil) og builtin.fil_finnes(linje_fil) og builtin.fil_finnes(rot + "/" + utmappe + "/serve.no") og builtin.trim(fil_les(st_fil)) == st {
        r = {"ok": sann, "linje": builtin.trim(fil_les(linje_fil)), "ut": ""}
        skriv("bygg: brukar bygget med same stempel (" + builtin.slice(st, 0, 12) + ")\n")
    } ellers {
        # Eit gammalt stempel må ikkje overleve eit bygg som feilar halvvegs
        hvis builtin.fil_finnes(st_fil) { fil_skriv(st_fil, "") }
        r = benk.bygg("tests/fixtures/synk_klient_testklient.no", utmappe, sann, "/_nc/", "tests/fixtures/synk_klient_testapp.no")
        hvis r["ok"] {
            fil_skriv(linje_fil, r["linje"])
            fil_skriv(st_fil, st)
        }
    }
    hvis ikkje r["ok"] {
        skriv("bygget feila:\n" + r["ut"] + "\n")
        assert(usann)
    }
    la imp = benk.liste_felt(r["linje"], "importar")
    la venta = ["synk_sse", "synk_kanal", "synk_kanal_send", "synk_las", "synk_db_vakt", "synk_melding", "synk_uuid", "lager_start", "hent_start"]
    la i = 0
    mens i < lengde(venta) {
        hvis ikkje _har(imp, venta[i]) {
            skriv("bygget manglar importen " + venta[i] + ": " + r["linje"] + "\n")
            assert(usann)
        }
        i = i + 1
    }
    skriv("bygg: " + builtin.slice(r["linje"], 0, builtin.index_of(r["linje"], " v=")) + "\n")
    returner r["linje"]
}

funksjon _har(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon start_tenar(utmappe: tekst, data: tekst, port: tekst) -> ordbok {
    la a = ah.start_app(utmappe + "/serve.no", data, {"SYNK_DATA": data, "SYNK_PORT": port})
    hvis a["status"] != "kjorer" {
        skriv("testappen starta ikkje:\n" + tekst(a["ut"]) + "\n")
        assert(usann)
    }
    returner a
}

funksjon last(økt: ordbok, port: tekst, sti: tekst, profil: tekst) -> ordbok {
    returner benk.last_side(økt, "http://127.0.0.1:" + port + sti, {"profil": profil, "behald_profil": sann, "grense_ms": 45000})
}

funksjon linjer(l: liste) -> tekst {
    returner builtin.join(l, "\n") + "\n"
}

# Loggen (#nc-logg) må vere lik fasiten, og konsollen fri for «Uncaught».
funksjon krev_logg(namn: tekst, r: ordbok, venta: tekst) -> heltall {
    hvis r["logg"] != venta {
        skriv(namn + ": skil seg frå fasiten, " + kh.skilnad(r["logg"], venta) + "\nFekk:\n" + r["logg"] + "\nFasit:\n" + venta + "\nKonsoll:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    hvis r["uncaught"] {
        skriv(namn + ": «Uncaught» i konsollen:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    returner 0
}
