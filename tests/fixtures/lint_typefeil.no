// Fixture for tests/test_lint_typesjekk.no: seks statiske typefeil som
// `nc lint` skal rapportere (error type-error). Posisjonane er låste i testen.
funksjon tar_tal(x: heltall) -> heltall {
    returner x
}
funksjon start() -> heltall {
    la a = tar_tal("tekst")
    la c: heltall = "ikkje tal"
    skriv(tekst(a) + tekst(c) + "\n")
    returner 0
}
funksjon gjev_tal() -> heltall {
    returner "tekst"
}
funksjon standard_tekst(x: tekst) -> heltall {
    returner x eller "standard"
}
// Same typa deklarasjon i begge greiner: typen er kjend, så feilen skal meldast.
funksjon grein_typa(a: boolsk) -> heltall {
    hvis a {
        la w: tekst = "x"
    } ellers {
        la w: tekst = "y"
    }
    returner tar_tal(w)
}
// Éin utypa la i ei grein: typen er framleis kjend.
funksjon grein_ein(a: boolsk) -> heltall {
    hvis a {
        la u = "x"
    }
    returner tar_tal(u)
}
