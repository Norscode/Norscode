// Fixture for tests/test_lint_typesjekk.no: AST-reglane i `nc lint`
// (berre åtvaringar, så exit-koden skal vere 0).
funksjon ubrukt_lokal() -> heltall {
    la ikkje_brukt = 5
    returner 1
}
funksjon dobbel_deklarasjon() -> heltall {
    la x = 1
    la x = 2
    returner x
}
funksjon daud_kode() -> heltall {
    returner 1
    skriv("aldri\n")
}
funksjon dynamisk() -> tekst {
    la v = 0
    v = "no tekst"
    returner v
}
funksjon start() -> heltall {
    la _med_vilje = 3
    la ignorert = dynamisk()
    returner ubrukt_lokal() + dobbel_deklarasjon() + daud_kode()
}
// la er funksjonsskopa: ein indre la av ein ytre variabel skriv over han
// (åtvaring), men variabelen er lesen etter blokka og er difor ikkje ubrukt.
funksjon indre_overskriv() -> heltall {
    la y = 1
    hvis sann {
        la y = 2
    }
    returner y
}
funksjon nosta_for() -> heltall {
    la s = 0
    for i i [1, 2] {
        for i i [3, 4] {
            s = s + i
        }
    }
    returner s
}
