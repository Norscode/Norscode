// F43-døme: @rute-annotasjonar registrerer handlarar via refleksjon.
// Annotasjonane er rein metadata; ruteren under er vanleg Norscode som les dei
// med finn_med_annotasjon og kallar handlarane ved namn. Sjå docs/REFLEKSJON.md.

@rute("GET", "/vare/{id}")
funksjon hent_vare(id: heltall) -> tekst {
    returner "vare " + tekst(id)
}

@rute("GET", "/vare")
@rute("GET", "/varer")
funksjon liste_varer() -> tekst {
    returner "alle varer"
}

@rute("POST", "/vare")
@utdatert("bruk /varer")
funksjon opprett_vare() -> tekst {
    returner "oppretta"
}

// Ingen annotasjon: ikkje med i ruteren.
funksjon hjelpar() -> tekst {
    returner "hjelp"
}

// Eitt segment i mønsteret: «{namn}» tek med eit heiltal, elles må dei vere like.
funksjon passar(monster: tekst, sti: tekst) {
    la m = builtin.split(monster, "/")
    la s = builtin.split(sti, "/")
    hvis lengde(m) != lengde(s) { returner null }
    la args = []
    la i = 0
    mens i < lengde(m) {
        hvis builtin.starts_with(m[i], "{") {
            legg_til(args, heltall_fra_tekst(s[i]))
        } ellers hvis m[i] != s[i] {
            returner null
        }
        i = i + 1
    }
    returner args
}

funksjon send(metode: tekst, sti: tekst) -> tekst {
    la rutene = finn_med_annotasjon("rute")
    la i = 0
    mens i < lengde(rutene) {
        la a = rutene[i]["annotasjon"]["argument"]
        hvis a[0] == metode {
            la args = passar(a[1], sti)
            hvis args != null {
                hvis lengde(args) == 0 { returner builtin.ncb_call_fn(rutene[i]["fullt_namn"]) }
                returner builtin.ncb_call_fn(rutene[i]["fullt_namn"], args[0])
            }
        }
        i = i + 1
    }
    returner "404"
}

funksjon start() -> tekst {
    la ut = []
    legg_til(ut, send("GET", "/vare/7"))
    legg_til(ut, send("GET", "/varer"))
    legg_til(ut, send("GET", "/vare"))
    legg_til(ut, send("POST", "/vare"))
    legg_til(ut, send("GET", "/finst/ikkje"))
    legg_til(ut, tekst(lengde(finn_med_annotasjon("rute"))))
    legg_til(ut, finn_med_annotasjon("utdatert")[0]["namn"] + ":" + finn_med_annotasjon("utdatert")[0]["annotasjon"]["argument"][0])
    returner builtin.join(ut, "|")
}
