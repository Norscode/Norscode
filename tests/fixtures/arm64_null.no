// A5: null i ARM64-AOT (det kanoniske null-objektet {0, 0}): type/tekst/json, == og != mot
// null/0/tekst, manglande kartnøkkel, funksjon utan returverdi, json null og konkatenering
// med null/heiltal/bool. Må vere lik VM-en byte for byte.
funksjon f() { }
funksjon start() -> heiltall {
    la n = null
    skriv("type=" + builtin.type(n) + "\n")
    skriv("tekst=[" + tekst(n) + "]\n")
    skriv("json=" + builtin.json_stringify([n, 1]) + "\n")
    skriv("eq_null=" + tekst(n == null) + " eq0=" + tekst(n == 0) + " ne0=" + tekst(n != 0) + "\n")
    hvis n { skriv("sann\n") } ellers { skriv("usann\n") }
    la m = {"a": 1}
    skriv("miss_type=" + builtin.type(m["b"]) + "\n")
    skriv("miss_eq=" + tekst(m["b"] == null) + "\n")
    skriv("f_type=" + builtin.type(f()) + "\n")
    la p = builtin.json_parse_raw("[null, {\"k\": null}]")
    skriv("parse_type=" + builtin.type(p[0]) + " " + builtin.type(p[1]["k"]) + "\n")
    skriv("concat=[" + "a" + tekst(null) + "]\n")
    skriv("concat2=[" + "a" + null + "|" + 7 + "|" + sann + "]\n")
    skriv("s_eq_null=" + tekst("x" == null) + "\n")
    returner 0
}
