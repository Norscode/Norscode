// Sjølvsjekkande vakt: `returner` inne i prøv {} må ikkje leke handler-ramme
funksjon hent(x: heiltall) -> heiltall {
    prøv { returner x * 2 } fang (e) { returner -1 }
    returner -2
}
funksjon start() -> heiltall {
    la s = 0
    la i = 0
    mens i < 200 { s = s + hent(i) i = i + 1 }
    skriv("sum=" + tekst(s) + "\n")
    la fanga = ""
    prøv { kast "etter lekkasje" } fang (e) { fanga = tekst(e) }
    hvis fanga != "etter lekkasje" { kast "feil fanga: " + fanga }
    skriv("gc_tryret_probe OK\n")
    returner 0
}
