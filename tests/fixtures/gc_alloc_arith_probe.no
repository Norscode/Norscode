// GC (iii) probe: aritmetikk-korrektheit MED fri-liste-boksing (NORSCODE_GC_ALLOC=1).
// Kompilert med flagget PÅ går KVAR int-boks gjennom gc_alloc16 (hex-patcha bump-prolog).
// Om patchen klobra ein levande register ville aritmetikken bli feil → dette er den
// ende-til-ende register-trygg-testen. 1..100=5050, pluss multiplikasjon. Exit: 0 OK · 2/3 feil.
funksjon start() -> heiltall {
    la sum: heiltall = 0
    la i: heiltall = 1
    mens i <= 100 {
        sum = sum + i
        i = i + 1
    }
    hvis sum != 5050 {
        returner 2
    }
    la p: heiltall = 1
    la k: heiltall = 1
    mens k <= 10 {
        p = p * 2
        k = k + 1
    }
    hvis p != 1024 {
        returner 3
    }
    skriv("gc_alloc_arith OK: 1..100=5050 og 2^10=1024 med fri-liste-boksing (register-trygt)\n")
    returner 0
}
