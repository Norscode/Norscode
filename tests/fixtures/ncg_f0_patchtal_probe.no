// F0-probe (v7, 2026-09-25): fail-closed patch-tal i native_codegen_v2. Køyrer dei to
// hex-patch-passa på syntetiske byte-lister og krev at eit anna tal treff enn det
// cache-regionen faktisk har (3 bump-prologar; E=1 H=1/1 rå streng-allokatorar) blir
// AVVIST med kast, medan det rette talet går gjennom. Utan F0 skreiv passa berre talet
// ut og bygde vidare (ein upatcha rå bump-allokator ville gå forbi fri-lista og
// allokeringsteljaren utan å bli oppdaga).
// Tung å kompilere (importerer heile kodegeneratoren); køyr som AOT-ELF.
// Exit: 0 = OK · 1 = feil tal godteke eller rett tal avvist.
bruk selfhost.native_execution.native_codegen_v2 som ncg

funksjon heap4() -> liste_heiltall {
    returner [0x00, 0x00, 0x78, 0x00]              // HEAP_VA 0x780000 (LE)
}

funksjon med(ut: liste_heiltall, xs: liste_heiltall) -> heiltall {
    for x i xs { legg_til(ut, x) }
    returner 0
}

// n kopiar av rcx-bump-prologen (mov rax,[bump]; lea rcx,[rax+16]; mov [bump],rcx), skilde med nop.
funksjon prologar(n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la k: heiltall = 0
    mens k < n {
        med(ut, [0x48, 0x8B, 0x04, 0x25]) med(ut, heap4())
        med(ut, [0x48, 0x8D, 0x48, 0x10, 0x48, 0x89, 0x0C, 0x25]) med(ut, heap4())
        med(ut, [0x90, 0x90, 0x90, 0x90])
        k = k + 1
    }
    returner ut
}

// e kopiar av E-mønsteret (str_raw-fallback) + h kopiar av H1 (join) med H2 20 B etter.
funksjon strengar(e: heiltall, h: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la k: heiltall = 0
    mens k < e {
        med(ut, [0x48, 0x8B, 0x04, 0x25]) med(ut, heap4())
        med(ut, [0x48, 0x89, 0xC3, 0x4A, 0x8D, 0x4C, 0x28, 0x09, 0x48, 0x89, 0x0C, 0x25]) med(ut, heap4())
        med(ut, [0x90, 0x90, 0x90, 0x90])
        k = k + 1
    }
    k = 0
    mens k < h {
        med(ut, [0x4C, 0x8B, 0x1C, 0x25]) med(ut, heap4()) med(ut, [0x49, 0x89, 0x1B])
        med(ut, [0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
        med(ut, [0x48, 0x89, 0x04, 0x25]) med(ut, heap4())
        med(ut, [0x90, 0x90, 0x90, 0x90])
        k = k + 1
    }
    returner ut
}

funksjon bump_avvist(n: heiltall) -> boolsk {
    la b = prologar(n)
    prøv {
        ncg.patch_bump_prologer(b, 4198400, lengde(b))
    } fang (e) {
        returner sann
    }
    returner usann
}

funksjon streng_avvist(e: heiltall, h: heiltall) -> boolsk {
    la b = strengar(e, h)
    prøv {
        ncg.patch_raw_string_allocs(b, 4198400, 4198464, lengde(b))
    } fang (feil) {
        returner sann
    }
    returner usann
}

funksjon start() -> heiltall {
    la feil: heiltall = 0
    hvis bump_avvist(3) { skriv("F0 FEIL: 3 bump-prologar (rett tal) vart avvist\n") feil = feil + 1 }
    hvis ikkje bump_avvist(2) { skriv("F0 FEIL: 2 bump-prologar vart godtekne\n") feil = feil + 1 }
    hvis ikkje bump_avvist(4) { skriv("F0 FEIL: 4 bump-prologar vart godtekne\n") feil = feil + 1 }
    hvis streng_avvist(1, 1) { skriv("F0 FEIL: E=1 H=1/1 (rett tal) vart avvist\n") feil = feil + 1 }
    hvis ikkje streng_avvist(0, 1) { skriv("F0 FEIL: E=0 vart godteke\n") feil = feil + 1 }
    hvis ikkje streng_avvist(2, 1) { skriv("F0 FEIL: E=2 vart godteke\n") feil = feil + 1 }
    hvis ikkje streng_avvist(1, 0) { skriv("F0 FEIL: H=0/0 vart godteke\n") feil = feil + 1 }
    hvis feil != 0 { returner 1 }
    skriv("F0 OK: patch-tal fail-closed (3 / E=1 H=1/1 godteke; 2, 4, E=0, E=2, H=0 avviste)\n")
    returner 0
}
