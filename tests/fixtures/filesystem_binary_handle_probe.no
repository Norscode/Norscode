bruk std.runtime_filesystem_native som fs
bruk std.windows_filesystem som windows_fs

funksjon les_operasjon(req) {
    req["abi"] = fs.abi_versjon()
    returner fs.read_operation(req)
}
funksjon skriv_operasjon(req) {
    req["abi"] = fs.abi_versjon()
    returner fs.write_operation(req)
}
funksjon posisjon(h) -> heiltall {
    hvis windows_fs.er_windows() { returner windows_fs.hent_fil(h)["pos"] }
    returner fs.fh_hent(h)["pos"]
}

funksjon les(h, maks: heiltall) {
    returner les_operasjon({"operation": "read_binary", "handle": h["handle"], "max": tekst_fra_heiltall(maks)})
}
funksjon start() -> heiltall {
    la namn = "binary-handle-" + tekst_fra_heiltall(builtin.tid_ms()) + ".bin"
    la sti = "build/" + namn
    builtin.fil_skriv_binær(sti, builtin.bytes_from_list([0, 255, 17, 64, 128, 10]))
    la h = les_operasjon({"operation": "open", "root": "build", "relative": namn, "mode": "read"})
    assert_eq(h["status"], "open")
    // POSIX-programvarelesaren held eit bilete frå open. Windows bruker
    // eit ekte overlapped HANDLE og krev ikkje snapshot-isolasjon; den
    // felles byte-/seek-/moduskontrakten nedanfor blir køyrd på begge.
    la snapshot = ikkje windows_fs.er_windows()
    hvis snapshot { builtin.fil_skriv_binær(sti, builtin.bytes_from_list([9, 9])) }
    la a = les(h, 2)
    assert_eq(a["status"], "ok")
    assert_eq(a["value"], 2)
    assert_eq(a["data_bytes"], builtin.bytes_from_list([0, 255]))
    la tekstbit = les_operasjon({"operation": "read", "handle": h["handle"], "max": "1"})
    assert_eq(builtin.char_code(tekstbit["data"]), 17)
    la b = les(h, 8)
    assert_eq(b["value"], 3)
    assert_eq(b["data_bytes"], builtin.bytes_from_list([64, 128, 10]))
    assert_eq(les(h, 1)["value"], 0)
    les_operasjon({"operation": "seek", "handle": h["handle"], "position": "1"})
    assert_eq(les(h, 0)["value"], 0)
    assert_eq(les(h, 1)["data_bytes"], builtin.bytes_from_list([255]))
    assert_eq(les(h, 0 - 1)["status"], "feil")
    assert_eq(les(h, 1)["data_bytes"], builtin.bytes_from_list([17]))
    les_operasjon({"operation": "seek", "handle": h["handle"], "position": "1"})
    hvis snapshot { assert_eq(les(h, 9223372036854775807)["value"], 5) }
    ellers {
        // IOCP set eit eksplisitt tak på kvar ny OS-buffer. Avslag skal
        // bevare posisjonen, slik at eit nytt, avgrensa kall les same byte.
        assert_eq(les(h, 9223372036854775807)["status"], "feil")
        assert_eq(les(h, 5)["value"], 5)
    }
    les_operasjon({"operation": "seek", "handle": h["handle"], "position": "100"})
    assert_eq(les(h, 8)["value"], 0)
    assert_eq(posisjon(h), 100)
    assert_eq(les_operasjon({"operation": "read", "handle": h["handle"], "max": "1"})["value"], 0)
    assert_eq(posisjon(h), 100)
    assert_eq(les_operasjon({"operation": "close", "handle": h["handle"]})["status"], "closed")
    assert_eq(les(h, 1)["status"], "feil")
    la w = skriv_operasjon({"operation": "open", "root": "build", "relative": namn, "mode": "write"})
    assert_eq(w["status"], "open")
    assert_eq(les(w, 1)["status"], "feil")
    assert_eq(skriv_operasjon({"operation": "close", "handle": w["handle"]})["status"], "closed")
    assert_eq(skriv_operasjon({"operation": "delete", "root": "build", "relative": namn})["status"], "deleted")
    skriv("filesystem_binary_handle_probe OK\n")
    returner 0
}
