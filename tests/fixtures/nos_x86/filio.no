// norscodeos-x86_64-fikstur: fil-I/O, tid og miljø over Linux-delmengda
// (open/read/write/close/stat/lseek/access/unlink/clock_gettime). Exit 42 når alt stemmer.
funksjon start() -> heiltall {
    la sti = "/tmp/nos_x86_filio.txt"
    fil_skriv(sti, "hei frå norscodeos\n")
    hvis ikkje fil_finnes(sti) { returner 2 }
    la t = fil_les(sti)
    hvis t != "hei frå norscodeos\n" { returner 3 }
    builtin.fil_slett(sti)
    hvis fil_finnes(sti) { returner 4 }
    la t0 = builtin.tid_ms()
    hvis t0 <= 0 { returner 5 }
    skriv("filio ok " + miljo_hent("NOS_PROBE") + "\n")
    returner 42
}
