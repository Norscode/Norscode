// norscodeos-x86_64-fikstur (rA-os punkt 8): prosess_start / prosess_vent_ikkje_blokkerande /
// prosess_drep. Under NorscodeOS-kjerna (X6a: spawn 4097, wait4 61 med WNOHANG, kill 62):
// /initrd/sov blir starta, er ikkje ferdig, blir drepen og så ferdig. Under Linux (Docker) gjev
// spawn 4097 −ENOSYS (−38) → prosess_start gjev −38 og fiksturen avsluttar med 41.
// Exit 42 = start+vent+drep stemde; 41 = spawn utilgjengeleg (Linux); elles feilsteg.
bruk std.native_gap

funksjon start() -> heiltall {
    la pid = prosess_start("/initrd/sov", [0, 1, 2])
    skriv("pid=" + tekst_fra_heltall(pid) + "\n")
    hvis pid == -38 { returner 41 }
    hvis pid <= 0 { returner 2 }
    la v = prosess_vent_ikkje_blokkerande(pid)
    hvis v["ferdig"] { returner 3 }
    hvis prosess_drep(pid) != 0 { returner 4 }
    la n: heiltall = 0
    mens ikkje v["ferdig"] og n < 500 {
        vent.sov(10)
        v = prosess_vent_ikkje_blokkerande(pid)
        n = n + 1
    }
    hvis ikkje v["ferdig"] { returner 5 }
    skriv("status=" + tekst_fra_heltall(v["status"]) + "\n")
    returner 42
}
