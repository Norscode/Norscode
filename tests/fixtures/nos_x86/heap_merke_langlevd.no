// norscodeos-x86_64-fikstur: eit langlevd heap_merke() (tatt før løkka) må overleve mange heap_sett().
// Før fiksen låg merket-boksen PÅ merket og vart frigjort av fyrste heap_sett(merke); neste allokering
// overskreiv han, og merket vart søppel (eller programmet krasja på 2.–3. reset). Exit 42 når alt stemmer.
funksjon start() -> heiltall {
    la merke = heap_merke()
    la runde = 0
    mens runde < 12 {
        la s = ""
        la j = 0
        mens j < 3000 {
            s = s + "x"
            j = j + 1
        }
        la liste = []
        la k = 0
        mens k < 200 {
            legg_til(liste, k * 3)
            k = k + 1
        }
        heap_sett(merke)
        // Etter reset: merket skal framleis vere ei gyldig heap-adresse (over 0x400000, under 2 GiB).
        hvis merke < 4194304 { returner 1 }
        hvis merke > 2147483648 { returner 2 }
        runde = runde + 1
    }
    skriv("heap_merke_langlevd OK\n")
    returner 42
}
