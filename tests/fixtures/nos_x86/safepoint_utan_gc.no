// norscodeos-x86_64: safepoint utan GC-modus må ikkje utløyse kollektoren (ring-3-#PF @0x40600000 =
// GC_BITMAP_VA, utanfor 64 MiB-heapen). Paritet-safepointet (flagg AV) kallar gc_collect_native når
// teljaren når terskelen (standard 2^31) OG bump−sist ≥ port. Byggjer ein med NC_SAFEPOINT_TERSKEL=1000
// no etter 1000 safepoint, og programmet veks heapen mykje meir enn 64 KiB utan å nå segmenttaket:
// ~4 MiB totalt (lister og strengar i ei tung løkke, ingen heap_sett). Exit 42 når alt stemmer.
// Linux-x86_64 (2 GiB-segment) køyrer same program med kollektoren på.
funksjon start() -> heltall {
    la sum = 0
    la runde = 0
    mens runde < 4000 {
        la s = "linje-" + tekst(runde) + "-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        la liste = []
        la k = 0
        mens k < 20 {
            legg_til(liste, k * runde)
            k = k + 1
        }
        sum = sum + lengde(s) + lengde(liste)
        runde = runde + 1
    }
    hvis sum != 346890 { returner 1 }
    skriv("safepoint_utan_gc OK\n")
    returner 42
}
