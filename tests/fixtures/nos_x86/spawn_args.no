// norscodeos-x86_64-fikstur: args()/miljo() og process_spawn_argv utan fork.
// Under Linux (Docker) gjev spawn 4097 -ENOSYS, so spawn-grenen skal feile reint med
// «spawn(…) feila (-38)». Under NorscodeOS-kjerna skal /initrd/hei køyre og gje exit 42.
// Exit 42 når args/miljo stemmer og spawn enten lukkast eller feilar reint.
bruk std.native_gap som ng

funksjon start() -> heiltall {
    la a = builtin.argv_list_v1()
    hvis lengde(a) < 1 { returner 2 }
    hvis miljo_hent("NOS_PROBE") != "ja" { returner 3 }
    hvis miljo_finnes("NOS_FINST_IKKJE") { returner 4 }
    la r = builtin.process_spawn_argv({"abi": "norscode-process-spawn-v1", "executable": "/initrd/hei", "args": [], "stdin": ""})
    skriv("status=" + tekst(r["status"]) + " exit=" + tekst(r["exit_code"]) + " detalj=" + tekst(r["error_detail"]) + "\n")
    returner 42
}
