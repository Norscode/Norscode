// norscodeos-x86_64-fikstur: heap_merke/heap_sett (arena-reset) og krypto_op (privat 4098).
// Under Linux gjev 4098 -ENOSYS (-38) ... men Linux-målet har ingen krypto-leaf: der kastar
// krypto_op «NATIV-GAP» (fangbart). Arena-løkka allokerer ~200 MiB totalt i ein 64 MiB-heap:
// ho går berre om heap_sett frigjer. Kontrakten: alt som er allokert etter merket er borte
// etter heap_sett, so arbeidet ligg i ein eigen funksjon og berre argumentet (allokert før
// merket) blir returnert.
funksjon runde(n: heiltall) -> heiltall {
    la m = builtin.heap_merke()
    la s = "x" + tekst(n) + builtin.join(["abcdefghij", "klmnopqrst", "uvwxyz0123", "4567890abc"], "-")
    la lst: liste_tekst = []
    la k: heiltall = 0
    mens k < 100 { legg_til(lst, s)  k = k + 1 }
    la t = builtin.join(lst, ",")
    hvis lengde(t) < 100 { kast "for kort" }
    builtin.heap_sett(m)
    returner n
}

funksjon start() -> heiltall {
    la i: heiltall = 0
    mens i < 20000 {
        i = runde(i) + 1
    }
    la rv: heiltall = 0
    prøv {
        rv = builtin.krypto_op(1, 0, 0)
    } fang (e) {
        skriv("krypto_op kasta: " + tekst(e) + "\n")
        returner 43
    }
    skriv("krypto_op=" + tekst(rv) + "\n")
    hvis rv != -38 { returner 4 }
    returner 42
}
