funksjon djup(n: heiltall) -> heiltall {
    returner djup(n + 1) + 1
}

funksjon start() -> heiltall {
    la ok = 0
    prøv {
        djup(0)
    } fang (e) {
        skriv("fanga: " + tekst(e) + "\n")
        ok = 1
    }
    la xs: liste_tekst = []
    la i: heiltall = 0
    mens i < 10 { legg_til(xs, "x" + tekst(i))  i = i + 1 }
    skriv(builtin.join(xs, ",") + "\n")
    hvis ok == 1 { returner 7 }
    returner 3
}
