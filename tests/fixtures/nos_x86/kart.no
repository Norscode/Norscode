// norscodeos-x86_64-fikstur: ordbøker, lister, tekst, JSON. Exit 42 når alt stemmer.
funksjon start() -> heiltall {
    la m = {"a": 1, "b": 2}
    m["c"] = m["a"] + m["b"]
    la l = [m["c"], 4, 5]
    la s = 0
    la i = 0
    mens i < lengde(l) { s = s + l[i]  i = i + 1 }
    hvis s != 12 { returner 2 }
    la j = json_skriv({"k": [1, 2, 3]})
    la p = json_parse_raw(j)
    hvis lengde(p["k"]) != 3 { returner 3 }
    hvis builtin.upper("norscode") != "NORSCODE" { returner 4 }
    skriv("kart ok\n")
    returner 42
}
