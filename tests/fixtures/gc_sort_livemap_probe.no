// GC (iv) probe: insertion-sort av live-map (gc_sort_livemap). Byggjer usortert live-map
// (300,33),(100,11),(200,22) @0x10340000, sorterer, stadfestar stigande adresse OG at
// (addr,size)-par held saman. Exit: 0 = OK · 2 = feil orden/par.
funksjon start() -> heiltall {
    la lm: heiltall = 271843328                    // 0x10340000
    builtin.raw_store64(lm, 300)
    builtin.raw_store64(lm + 8, 33)
    builtin.raw_store64(lm + 16, 100)
    builtin.raw_store64(lm + 24, 11)
    builtin.raw_store64(lm + 32, 200)
    builtin.raw_store64(lm + 40, 22)
    builtin.gc_sort_livemap(3)
    la a0: heiltall = builtin.raw_load64(lm)
    la s0: heiltall = builtin.raw_load64(lm + 8)
    la a1: heiltall = builtin.raw_load64(lm + 16)
    la s1: heiltall = builtin.raw_load64(lm + 24)
    la a2: heiltall = builtin.raw_load64(lm + 32)
    la s2: heiltall = builtin.raw_load64(lm + 40)
    hvis a0 == 100 og s0 == 11 og a1 == 200 og s1 == 22 og a2 == 300 og s2 == 33 {
        skriv("gc_sort_livemap OK: usortert → stigande adresse, (addr,size)-par intakte\n")
        returner 0
    }
    returner 2
}
