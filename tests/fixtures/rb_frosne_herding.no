# Herding etter kodegjennomgang: __frosen__-nøkkel i vanleg ordbok, sett_felt på frosne
# verdiar og likskap på for djupe strukturar.

funksjon feiltekst(f) -> tekst {
    prøv {
        f()
    } fang (e) {
        returner tekst(e)
    }
    returner "ingen feil"
}

struktur Node {
    b
}

funksjon djup(n: heiltall) {
    la d = Node(0)
    la i = 0
    mens i < n {
        d = Node(d)
        i = i + 1
    }
    returner d
}

funksjon c0() -> tekst {
    # ein vanleg ordbok med nøkkelen __frosen__ er ikkje ei innpakking
    la o = {"__frosen__": 1, "x": 2}
    la f = frys(o)
    returner tekst(er_frosen(o)) + tekst(er_frosen(f)) + tekst(f["x"]) + tekst(f["__frosen__"])
}

funksjon c1() -> tekst {
    la f = frys({"a": 1})
    la m = feiltekst(fun() -> sett_felt(f, "a", 2))
    returner builtin.slice(m, 0, 10) + tekst(f["a"])
}

funksjon c2() -> tekst {
    la m = feiltekst(fun() -> djup(150) == djup(150))
    returner builtin.slice(m, 0, 17) + "," + tekst(djup(5) == djup(5)) + tekst(djup(5) == djup(6))
}

funksjon c3() -> tekst {
    # Regresjon: `x != null` på ein lambda som fangar si eiga ordbok (sirkulært miljø) måtte ikkje skanne grafen.
    la kl = {"ved": null, "n": 1}
    kl["ved"] = fun(s) -> kl
    la tre = {"a": kl, "b": kl, "c": kl}
    kl["tre"] = tre
    kl["ved2"] = fun(s) -> tre
    returner tekst(kl["ved"] != null) + tekst(kl["ved"] == null) + tekst(kl["ved2"] != null)
}

funksjon start() -> tekst {
    returner builtin.join([c0(), c1(), c2(), c3()], "|")
}
