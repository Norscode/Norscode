# W3 (WASM-sporet): paritetskorpuset for runtime-biblioteket std/wasm_rt.no, pluss
# vertsfunksjonane med tekstverdiar. Same tre steg som tests/test_wasm_korpus_chrome.no
# (tests/fixtures/wasm_korpus_hjelp.no, køyr_korpus):
#   1. VM: kvart program i kh.korpus_w3() gjev fasiten (builtins i VM-en; rt-funksjonar utan
#      builtin blir kalla direkte og køyrer som Norscode i VM-en);
#   2. bygg med CLI-en, som lenkar inn std/wasm_rt.no og validerer modulen;
#   3. Chrome (VALFRI, SKIP utan Chrome): identisk utskrift, ingen «Uncaught», og negativ og
#      positiv kontroll.
# I tillegg (Chrome): tests/fixtures/wasm_w3_dom_klient.no finn element med utrekna
# selektorar og set tekst og HTML med tekstverdiar. textContent blir ikkje tolka som HTML,
# og verdien i sett_html blir escapa (script-taggen blir tekst).
bruk tests.fixtures.wasm_korpus_hjelp som kh
bruk tests.fixtures.wasm_chrome_hjelp som ch

funksjon start() -> heltall {
    la r = kh.køyr_korpus("test_wasm_korpus_w3", "build/wasm/test_korpus_w3", kh.korpus_w3(), ["rt_json_feil"], "48341",
                          {"dom": "tests/fixtures/wasm_w3_dom_klient.no"})
    hvis ikkje r["chrome"] {
        returner 0
    }
    la d = r["ekstra"]["dom"]
    ch.krev(d, "</html>", "dom")
    # sett_html: den konstante malen er HTML, verdien er escapa tekst (ikkje eit script-element)
    ch.krev(d, "<p id=\"x\">&lt;script&gt;alert(1)&lt;/script&gt; æ &amp; \"'</p>", "dom sett_html")
    # sett_tekst med utrekna selektor: HTML-teikna blir tekst
    ch.krev(d, "<p id=\"a\">blåbær &amp; &lt;b&gt;ikkje feit&lt;/b&gt;</p>", "dom sett_tekst")
    ch.krev(d, "<pre id=\"nc-logg\">2.5</pre>", "dom sett_tekst desimaltal")
    hvis builtin.index_of(d, "<script>alert") >= 0 eller builtin.index_of(d, "<b>ikkje") >= 0 {
        skriv("dom: ein tekstverdi vart tolka som HTML:\n" + d + "\n")
        assert(usann)
    }
    skriv("test_wasm_korpus_w3 OK\n")
    returner 0
}
