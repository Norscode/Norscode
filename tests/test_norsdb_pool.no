// Fase 0: pool-fiksar.
//  1) maks håndhevast som tak på talet ledige (idle) tilkoblingar.
//  2) transaksjonstilstand nullstillast når ei tilkobling går tilbake i poolen,
//     slik at neste pool_acquire får ei rein tilkobling.

bruk std.db som db

funksjon start() -> heltall {
    // ── maks-tak ─────────────────────────────────────────────────────
    la p = db.pool(":memory:", 1)
    assert_eq(db.pool_size(p), 1)          // éin ledig oppretta ivrig
    la a = db.pool_acquire(p)
    assert_eq(db.pool_size(p), 0)
    la b = db.pool_acquire(p)              // ledig tom => ny tilkobling
    assert_eq(db.pool_size(p), 0)
    assert(db.close(a))                    // 0 < maks(1) => cache
    assert_eq(db.pool_size(p), 1)
    assert(db.close(b))                    // 1 !< maks(1) => forkast, ikkje veks forbi maks
    assert_eq(db.pool_size(p), 1)
    assert(db.pool_close(p))

    // ── tx-nullstilling ved gjenbruk ─────────────────────────────────
    la p2 = db.pool(":memory:", 2)
    la c = db.pool_acquire(p2)
    assert(db.begin(c))                    // startar transaksjon => _in_tx sann
    assert(db.close(c))                    // tilbake i pool: skal nullstille _in_tx
    la c2 = db.pool_acquire(p2)            // gjenbrukar same tilkobling
    assert(db.begin(c2))                   // sann berre om _in_tx vart nullstilt
    assert(db.commit(c2))
    assert(db.close(c2))
    assert(db.pool_close(p2))
    returner 0
}
