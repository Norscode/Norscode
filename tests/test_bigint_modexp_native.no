funksjon start() -> heiltall {
    # (1) Paritet: bn.modexp (atom når det finst) == bn.modexp_rein, små/mellomstore.
    la st = {"x": 20260924}
    la storleikar = [1, 2, 3, 5, 7, 8, 9, 15, 16, 17, 24, 31, 32, 33]
    la i = 0
    mens i < lengde(storleikar) {
        la k = storleikar[i]
        la m = _rnd_mod(st, k)
        la b = _rnd_bytes(st, k)
        la e = _rnd_bytes(st, 1 + (i % 4))
        la nb = bn.fra_bytes(b) la ne = bn.fra_bytes(e) la nm = bn.fra_bytes(m)
        assert(bn.cmp(bn.modexp(nb, ne, nm), bn.modexp_rein(nb, ne, nm)) == 0)
        i = i + 1
    }
    # Partal modul går alltid den reine vegen: 7^5 mod 10 = 7.
    assert(bn.cmp(bn.modexp([7], [5], [10]), [7]) == 0)
    # Base >= modul blir redusert først: 1000^3 mod 13 = 12.
    assert(bn.cmp(bn.modexp([1000], [3], [13]), [12]) == 0)
    hvis ikkje _atom_finst() {
        skriv("test_bigint_modexp_native OK (utan native bn_modexp: rein paritet)")
        returner 0
    }

    # (2) Atomkontrakt.
    assert(_lik(_atom([2], [], [5]), [1]))                    # exp tom = 0 → 1
    assert(_lik(_atom([0, 0, 5], [3], [0, 11]), [4]))         # leiande null; k = 1
    assert(_lik(_atom([5], [3], [1]), [0]))                   # mod 1 → 0
    assert(_lik(_atom([0], [7], [0, 13]), [0]))               # base 0
    assert(_lik(_atom([12], [2], [13]), [1]))                 # (n-1)^2 = 1
    assert(lengde(_atom([3], [3], [4])) == 0)                 # partal modul
    assert(lengde(_atom([3], [3], [])) == 0)                  # tom modul
    assert(lengde(_atom([3], [3], [0, 0])) == 0)              # modul 0
    assert(lengde(_atom([256], [3], [13])) == 0)              # element > 255
    assert(lengde(_atom([3], [-1], [13])) == 0)               # negativt element
    assert(lengde(_atom([1, 0, 0, 0, 0, 0, 0, 0, 0], [3], [255, 255, 255, 255, 255, 255, 255, 197])) == 0) # base >= 2^64 (s=1)
    la stor = _rnd_mod(st, 513)
    assert(lengde(_atom([3], [3], stor)) == 0)                # > 4096 bit
    assert(_lik(_atom(builtin.bytes_from_list([2]), [3], [5]), [3]))   # bytes (tag 7)
    # Resultatet er ei vanleg, muterbar liste.
    la r = _atom([2], [10], [0, 0, 255, 241])                 # 1024 mod 65521 = 1024
    assert(_lik(r, [4, 0]))
    legg_til(r, 9)
    assert(lengde(r) == 3)

    # (3) dc-orakel, full eksponent (base kan vere >= modul).
    assert_eq(_hx(_atom(_b(_kat1_b()), _b(_kat1_e()), _b(_kat1_m()))), _kat1_r())
    assert_eq(_hx(_atom(_b(_kat2_b()), _b(_kat2_e()), _b(_kat2_m()))), _kat2_r())
    assert_eq(_hx(_atom(_b(_kat3_b()), _b(_kat3_e()), _b(_kat3_m()))), _kat3_r())
    # og via bn.modexp (limbar) for 2048-bit-KAT-en
    la via_bn = bn.modexp(bn.fra_bytes(_b(_kat2_b())), bn.fra_bytes(_b(_kat2_e())), bn.fra_bytes(_b(_kat2_m())))
    assert_eq(_hx(bn.til_bytes(via_bn, 256)), _kat2_r())

    # (4) openssl-KAT: RSA-2048 PKCS#1 v1.5 SHA-256 (deterministisk), byte-lik.
    la pem = builtin.fil_les("tests/fixtures/tls/localhost.key")
    la key = x509.rsa_privat_frå_pem(pem)
    assert_eq(key["status"], "ok")
    la melding = _tekst_bytes("example.no. 3600 IN A 192.0.2.10")
    la sig = rsa.rsa_sign(key["n"], key["d"], melding)
    assert_eq(_hx(sig), _rsa_kat_sig())
    # CRT-vegen (p, q, dP, dQ, qInv frå PKCS#8) gjev same bytar.
    assert(finnes_nøkkel(key, "qinv"))
    assert_eq(_hx(rsa.rsa_sign_nokkel(key, melding)), _rsa_kat_sig())
    # Øydelagd CRT-felt → feilsjekken fangar det og fell tilbake til d (same bytar).
    la skadd = {"n": key["n"], "e": key["e"], "d": key["d"], "p": key["p"], "q": key["q"], "dp": key["dq"], "dq": key["dq"], "qinv": key["qinv"]}
    assert_eq(_hx(rsa.rsa_sign_nokkel(skadd, melding)), _rsa_kat_sig())
    assert(rsa.rsa_verify(key["n"], key["e"], melding, sig))
    assert(ikkje rsa.rsa_verify(key["n"], key["e"], _tekst_bytes("example.no. 3600 IN A 192.0.2.11"), sig))
    skriv("test_bigint_modexp_native OK")
    returner 0
}
