# Native Montgomery-modexp (builtin.bn_modexp_bytes, nytta av std.bigint.modexp) mot
# den reine vegen (bn.modexp_rein), dc-orakel (4096/3072/2048 bit, full eksponent) og
# ein openssl-KAT: RSA-2048 PKCS#1 v1.5-SHA256-signatur med tests/fixtures/tls/localhost.key
# over "example.no. 3600 IN A 192.0.2.10" (`openssl dgst -sha256 -sign`), byte-lik.
# Utan atomet (tolka VM / seed utan bn_modexp) køyrer berre rein-paritetsdelen: modexp
# skal då falle tilbake til modexp_rein og gje same svar.
bruk std.bigint som bn
bruk std.rsa som rsa
bruk std.x509 som x509

funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h, i, i + 1)) * 16 + _nib(builtin.slice(h, i + 1, i + 2))) i = i + 2 }
    returner ut
}
funksjon _hx(b: liste_heiltall) -> tekst {
    la c = "0123456789abcdef"
    la ut = "" la i = 0
    mens i < lengde(b) {
        la v = b[i]
        ut = ut + builtin.slice(c, (v >> 4) & 15, ((v >> 4) & 15) + 1) + builtin.slice(c, v & 15, (v & 15) + 1)
        i = i + 1
    }
    returner ut
}
# Element-for-element (ikkje liste-==, som er upåliteleg på store lister på seed).
funksjon _lik(a: liste_heiltall, b: liste_heiltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) { hvis a[i] != b[i] { returner usann } i = i + 1 }
    returner sann
}
funksjon _rnd(st: ordbok) -> heiltall {
    st["x"] = (st["x"] * 1103515245 + 12345) & 2147483647
    returner (st["x"] >> 16) & 255
}
funksjon _rnd_bytes(st: ordbok, n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < n { legg_til(ut, _rnd(st)) i = i + 1 }
    returner ut
}
# Tilfeldig odde modul med n byte og topp-byte != 0.
funksjon _rnd_mod(st: ordbok, n: heiltall) -> liste_heiltall {
    la m = _rnd_bytes(st, n)
    m[0] = m[0] | 128
    m[n - 1] = m[n - 1] | 1
    returner m
}
funksjon _atom_finst() -> boolsk {
    prøv {
        la r = builtin.bn_modexp_bytes([2], [3], [5])
        hvis r != null { hvis lengde(r) == 1 { returner r[0] == 3 } }
    } fang (e) { }
    returner usann
}
funksjon _atom(b: liste_heiltall, e: liste_heiltall, m: liste_heiltall) -> liste_heiltall {
    returner builtin.bn_modexp_bytes(b, e, m)
}
funksjon _tekst_bytes(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(s) { legg_til(ut, builtin.char_code(builtin.slice(s, i, i + 1))) i = i + 1 }
    returner ut
}
