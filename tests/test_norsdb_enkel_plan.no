// Punkt 5d: snarvegen for enkle WHERE-predikat («kol op literal [AND …]») skal gje
// nøyaktig same svar som den fulle uttrykks-evaluatoren, for alle kombinasjonar av
// verdiar (tal/tekst/NULL/ikkje-kanoniske talformer), literalar og operatorar.
// Og indeks-kandidatane (likskap/område) skal gje same rader som full skann.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la verdiar = ["4", "04", "4.0", "-4", "40", "", sql._NULLV(), "abc", "4abc", "-0", "0.0", "+4"]
    la literalar = ["4", "'4'", "0", "-4", "4.5", "'abc'", "'4abc'", "''", "04"]
    la ops = ["=", "!=", "<>", "<", "<=", ">", ">="]
    la kt = sql._kt_ny({}, {})
    la feil = 0
    la tal = 0
    la li = 0
    mens li < lengde(literalar) {
        la oi = 0
        mens oi < lengde(ops) {
            la wt = ["k", ops[oi], literalar[li]]
            la plan = sql._enkel_plan(wt, "t", "")
            assert(plan["ok"])
            la vi = 0
            mens vi < lengde(verdiar) {
                la rad = {"k": verdiar[vi]}
                la a = sql._enkel_match(rad, plan)
                la b = sql._match(rad, wt, kt)
                // Skann-snarvegen (_filtrer_med) må seie det same.
                la via_skann = lengde(sql._filtrer_med([rad], wt, kt, plan)) == 1
                hvis a != b eller via_skann != b {
                    feil = feil + 1
                    skriv("ULIK: k=" + verdiar[vi] + " " + ops[oi] + " " + literalar[li] + "\n")
                }
                tal = tal + 1
                vi = vi + 1
            }
            oi = oi + 1
        }
        li = li + 1
    }
    assert(tal > 700)
    assert_eq(feil, 0)

    // IS [NOT] NULL og AND-kjeder.
    la wt2 = ["k", "IS", "NOT", "NULL", "AND", "k", ">=", "0", "AND", "k", "<", "'5'"]
    la p2 = sql._enkel_plan(wt2, "t", "")
    assert(p2["ok"])
    la vi = 0
    mens vi < lengde(verdiar) {
        la rad = {"k": verdiar[vi]}
        assert_eq(sql._enkel_match(rad, p2), sql._match(rad, wt2, kt))
        vi = vi + 1
    }
    // Ikkje-enkle WHERE fell attende til evaluatoren.
    assert(sql._enkel_plan(["k", "=", "1", "OR", "k", "=", "2"], "t", "")["ok"] == usann)
    assert(sql._enkel_plan(["k", "+", "1", "=", "2"], "t", "")["ok"] == usann)
    assert(sql._enkel_plan(["andre.k", "=", "1"], "t", "")["ok"] == usann)

    // Indeks-kandidatar (likskap/område på blanda kolonne) == full skann.
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE t (k TEXT)")
    vi = 0
    mens vi < lengde(verdiar) {
        hvis sql._ern(verdiar[vi]) {
            sql.exec(db, "INSERT INTO t (k) VALUES (NULL)")
        } ellers {
            sql.exec(db, "INSERT INTO t (k) VALUES ('" + verdiar[vi] + "')")
        }
        vi = vi + 1
    }
    la svar_skann = []
    li = 0
    mens li < lengde(literalar) {
        la oi = 0
        mens oi < lengde(ops) {
            legg_til(svar_skann, sql.query_rader(db, "SELECT k FROM t WHERE k " + ops[oi] + " " + literalar[li]))
            oi = oi + 1
        }
        li = li + 1
    }
    sql.exec(db, "CREATE INDEX ix ON t (k)")
    la j = 0
    li = 0
    mens li < lengde(literalar) {
        la oi = 0
        mens oi < lengde(ops) {
            la med = sql.query_rader(db, "SELECT k FROM t WHERE k " + ops[oi] + " " + literalar[li])
            hvis med != svar_skann[j] {
                feil = feil + 1
                skriv("INDEKS ULIK: k " + ops[oi] + " " + literalar[li] + "\n")
            }
            j = j + 1
            oi = oi + 1
        }
        li = li + 1
    }
    assert_eq(feil, 0)
    returner 0
}
