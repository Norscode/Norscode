# test_deflate_gzip_pure.no — Regresjonstest for ekte DEFLATE (RFC 1951) i gzip.
#
# Dekker Fase 1 punkt 1.8:
#   * round-trip byte-eksakt (eigen fast-Huffman encoder → eigen inflate)
#   * komprimert output MINDRE enn input for komprimerbar data (ekte LZ77)
#   * CRC32 mot kjend vektor
#   * dekoding av ekte zlib/gzip-straumar (fixed OG dynamic Huffman), bevis på
#     RFC-1951-kompatibilitet mot ein ekstern komprimerer
#   * bakoverkompat: gamle stored-blokk gzip dekomprimerer framleis via ny veg
#
# FEILAR før fiksen: den gamle skrivaren gav berre stored-blokker, så
# `lengde(komprimert) < lengde(input)` var usann, og dynamic-vektoren under
# (btype=2) ville gje tom output fordi den gamle lesaren avviste alt != stored.

bruk std.gzip som gz
bruk std.bytes som bytes
bruk std.zip som zip

funksjon _bygg_komprimerbar() -> liste_heltall {
    la d: liste_heltall = []
    la i = 0
    mens i < 400 {
        legg_til(d, 65) legg_til(d, 66) legg_til(d, 67) legg_til(d, 32)
        legg_til(d, 49) legg_til(d, 50) legg_til(d, 51) legg_til(d, 10)
        i = i + 1
    }
    returner d
}

funksjon _lik(a: liste_heltall, b: liste_heltall) -> bool {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) {
        hvis a[i] != b[i] { returner usann }
        i = i + 1
    }
    returner sann
}

# Ekte gzip-straum frå systemets `gzip -9 -n`, DYNAMIC Huffman (btype=2).
funksjon _ekstern_dynamic_gz() -> liste_heltall {
    returner [31,139,8,0,0,0,0,0,2,3,45,142,75,18,193,64,20,69,183,114,205,85,136,191,161,242,41,3,165,20,54,208,145,78,167,137,188,164,243,239,57,107,176,1,214,96,222,27,211,148,241,57,247,214,57,134,28,105,33,79,23,120,138,170,24,1,213,56,23,215,36,3,149,92,33,183,56,98,186,129,79,194,193,142,89,239,218,192,179,82,37,243,16,129,44,185,69,154,199,136,100,90,144,178,91,145,181,112,72,66,25,215,160,0,94,244,221,164,5,83,185,110,91,234,11,254,125,40,169,114,176,166,10,37,175,101,44,162,230,31,225,179,32,135,230,158,98,217,47,195,193,150,84,118,34,159,195,237,245,7,195,209,120,50,237,194,220,205,195,220,96,94,230,109,158,16,90,38,157,197,114,181,153,29,151,216,175,230,238,116,232,58,31,180,134,35,141,216,0,0,0]
}

funksjon _ekstern_dynamic_rå() -> liste_heltall {
    returner [84,104,101,32,113,117,105,99,107,32,98,114,111,119,110,32,102,111,120,32,106,117,109,112,115,32,111,118,101,114,32,116,104,101,32,108,97,122,121,32,100,111,103,46,32,80,97,99,107,32,109,121,32,98,111,120,32,119,105,116,104,32,102,105,118,101,32,100,111,122,101,110,32,108,105,113,117,111,114,32,106,117,103,115,33,32,83,112,104,105,110,120,32,111,102,32,98,108,97,99,107,32,113,117,97,114,116,122,44,32,106,117,100,103,101,32,109,121,32,118,111,119,46,32,72,111,119,32,118,101,120,105,110,103,108,121,32,113,117,105,99,107,32,100,97,102,116,32,122,101,98,114,97,115,32,106,117,109,112,46,32,78,111,114,115,99,111,100,101,32,49,50,51,52,53,54,55,56,57,48,32,195,134,195,152,195,133,32,195,166,195,184,195,165,32,103,122,105,112,47,68,69,70,76,65,84,69,32,82,70,67,49,57,53,49,46]
}

funksjon start() -> heiltall {
    # 1) CRC32 mot kjende vektorar
    assert(zip._tar_crc32([]) == 0)
    assert(zip._tar_crc32([49, 50, 51, 52, 53, 54, 55, 56, 57]) == 3421780262)

    # 2) Eigen encoder (fast Huffman + LZ77) → eigen inflate, byte-eksakt
    la rå = _bygg_komprimerbar()
    la gzb = zip.gzip_komprimer_bytes(bytes.fra_liste(rå))
    la gzl = bytes.til_liste(gzb)
    assert(gzl[0] == 31 og gzl[1] == 139 og gzl[2] == 8 og gzl[3] == 0)
    # Blokkhovud: BFINAL=1 (bit0), BTYPE=01 (fixed) → byte 10 sine lågaste 3 bitar = 011 = 3
    assert((gzl[10] & 7) == 3)
    # EKTE komprimering: output klart mindre enn input
    assert(lengde(gzl) < lengde(rå))
    assert(lengde(gzl) < lengde(rå) / 4)
    la ut = bytes.til_liste(zip.gzip_dekomprimer_bytes(gzb))
    assert(_lik(ut, rå))

    # 3) Alle byteverdiar 0..255 (testar 8- og 9-bits literalar), round-trip
    la alle: liste_heltall = []
    la i = 0
    mens i < 256 { legg_til(alle, i) i = i + 1 }
    mens i < 512 { legg_til(alle, i - 256) i = i + 1 }
    la alle_gz = zip.gzip_komprimer_bytes(bytes.fra_liste(alle))
    la alle_ut = bytes.til_liste(zip.gzip_dekomprimer_bytes(alle_gz))
    assert(_lik(alle_ut, alle))

    # 4) Tom input round-trip
    la tom_gz = zip.gzip_komprimer_bytes(bytes.fra_liste([]))
    la tom_ut = bytes.til_liste(zip.gzip_dekomprimer_bytes(tom_gz))
    assert(lengde(tom_ut) == 0)

    # 5) Ekstern zlib/gzip DYNAMIC-straum (btype=2) dekoda byte-eksakt
    la dyn_forventa = _ekstern_dynamic_rå()
    la dyn_ut = bytes.til_liste(zip.gzip_dekomprimer_bytes(bytes.fra_liste(_ekstern_dynamic_gz())))
    assert(_lik(dyn_ut, dyn_forventa))

    # 6) Bakoverkompat: gammal stored-blokk gzip dekomprimerer via ny inflate
    la stored_rå = _bygg_komprimerbar()
    la stored_gz = zip._tar_gzip_bytes(stored_rå)
    la stored_ut = bytes.til_liste(zip.gzip_dekomprimer_bytes(bytes.fra_liste(stored_gz)))
    assert(_lik(stored_ut, stored_rå))

    # 7) gz-modulens fil-API: ekte storleiksreduksjon + round-trip på disk
    la rot = "build/test-deflate-" + builtin.random_hex(8)
    builtin.mkdir_p(rot)
    builtin.fil_skriv_binær(rot + "/big.bin", bytes.fra_liste(rå))
    assert(gz.komprimer_fil(rot + "/big.bin", rot + "/big.bin.gz"))
    assert(gz.er_gzip(rot + "/big.bin.gz"))
    la ks = gz.komprimert_storleik(rot + "/big.bin.gz")
    la us = gz.ukomprimert_storleik(rot + "/big.bin.gz")
    assert(us == 3200)
    assert(ks < us)
    assert(gz.dekomprimer_fil(rot + "/big.bin.gz", rot + "/big.out"))
    la disk_ut = bytes.til_liste(builtin.fil_les_binær(rot + "/big.out"))
    assert(_lik(disk_ut, rå))

    # 8) gz-modulens tekst-API round-trip
    la koda = gz.komprimer_tekst("hei\nverda\nhei\nverda\nhei\nverda")
    assert(koda != "")
    assert(gz.dekomprimer_tekst(koda) == "hei\nverda\nhei\nverda\nhei\nverda")

    skriv("test_deflate_gzip_pure OK")
    returner 0
}
