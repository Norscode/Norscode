bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/verify_norscode_surface_ownership.no")

    assert(builtin.contains(src, "funksjon fil_inneheld(sti: tekst, needle: tekst) -> bool"))
    assert(builtin.contains(src, "funksjon c_artifact_markorar(root: tekst) -> bool"))
    assert(builtin.contains(src, "funksjon liste_aktive_filer(root: tekst, suffiksar: liste_tekst) -> liste_tekst"))
    assert(builtin.contains(src, "funksjon script_eigar_gate(root: tekst) -> bool"))
    assert(builtin.contains(src, "funksjon c_overflate_gate(root: tekst) -> bool"))
    assert(builtin.contains(src, "funksjon berre_forventa(actual: liste_tekst, expected: liste_tekst) -> bool"))
    assert(builtin.contains(src, "funksjon krev_filmarkor_hvis_finnes(root: tekst, rel: tekst, needle: tekst) -> bool"))
    assert(builtin.contains(src, "builtin.index_of(builtin.fil_les(sti), needle)"))
    assert(builtin.contains(src, "c_artifact_markorar_med_filer(root, c_filer)"))
    assert(builtin.contains(src, "[\".sh\", \".ps1\", \".js\", \".swift\"]"))
    assert(builtin.contains(src, "native_fs.native_list_typed(root, katalog)"))
    assert(builtin.contains(src, "hvis ikkje typed { listing = native_fs.native_list(root, katalog) }"))
    assert(ikkje builtin.contains(src, "exec_prosess"))
    assert(ikkje builtin.contains(src, "find "))
    assert(builtin.contains(src, "Norscode-first bridge"))
    assert(builtin.contains(src, "alle aktive .sh/.ps1/.js/.swift har same-namn .no-eigar"))

    assert(ikkje builtin.contains(src, "grep -q 'Auto-generated by tools/generate_build_embed_c.sh'"))
    assert(ikkje builtin.contains(src, "grep -q 'Generert av archive/legacy_c_backend'"))
    assert(ikkje builtin.contains(src, "grep -q 'IKKJE REDIGER'"))
    assert(ikkje builtin.contains(src, "grep -q '#include"))
    assert(ikkje builtin.contains(src, "sed 's#^./##'"))
    assert(ikkje builtin.contains(src, "awk '!/^archive"))
    assert(ikkje builtin.contains(src, "for p in $(find"))
    assert(ikkje builtin.contains(src, "actual=$(find"))

    skriv("test_surface_ownership_no_grep_markers OK")
    returner 0
}
