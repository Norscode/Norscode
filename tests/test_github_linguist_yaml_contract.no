// Valider strukturen i Norscode sitt framlegg til GitHub Linguist-heuristikk.
// Fangar feil som laus strengsøk/regex-test ikkje kan sjå: rekkefølgje,
// namngjevne mønster, feil regelgrupper og manglande Text-fallback.
bruk std.tekst som t

funksjon krev(ok: bool, melding: tekst) -> heiltall {
    hvis ikkje ok {
        skriv("FEIL Linguist YAML-kontrakt: " + melding + "\n")
        returner 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la sti = "docs/04-how-to-guides/linguist-proposal/norscode-heuristics.yml"
    la tekstlinjer = t.splitt(fil_les(sti), "\n")
    la n_norscode = 0
    la n_text = 0
    la n_and = 0
    la n_patterns = 0
    la n_negative = 0
    la n_ext = 0
    la named_pos = -1
    la disamb_pos = -1
    la first_rule_pos = -1
    la last_rule = ""
    la text_pos = -1
    la i = 0
    mens i < lengde(tekstlinjer) {
        la linje = t.trim(tekstlinjer[i])
        hvis linje == "named_patterns: {}" { named_pos = i }
        hvis linje == "disambiguations:" { disamb_pos = i }
        hvis linje == "- extensions: ['.no']" { n_ext = n_ext + 1 }
        hvis linje == "- language: Norscode" {
            n_norscode = n_norscode + 1
            hvis first_rule_pos == -1 { first_rule_pos = i }
            last_rule = "Norscode"
        }
        hvis linje == "- language: Text" {
            n_text = n_text + 1
            last_rule = "Text"
            text_pos = i
        }
        hvis linje == "and:" { n_and = n_and + 1 }
        hvis t.starter_med(linje, "- pattern: ") { n_patterns = n_patterns + 1 }
        hvis t.starter_med(linje, "- negative_pattern: ") { n_negative = n_negative + 1 }
        i = i + 1
    }

    la feil = 0
    feil = feil + krev(named_pos >= 0 og named_pos < disamb_pos, "named_patterns før disambiguations")
    feil = feil + krev(disamb_pos >= 0 og disamb_pos < first_rule_pos, "disambiguations før første regel")
    feil = feil + krev(n_ext == 1, "éin .no-extensions-regel")
    feil = feil + krev(n_norscode == 2, "to Norscode-reglar")
    feil = feil + krev(n_and == 2, "begge Norscode-reglane må bruke and")
    feil = feil + krev(n_patterns == 4, "fire positive mønster totalt")
    feil = feil + krev(n_negative == 2, "begge Norscode-reglane må ha negativt kodegjerde-mønster")
    feil = feil + krev(n_text == 1 og last_rule == "Text", "Text skal vere siste og einaste fallback")
    feil = feil + krev(text_pos > first_rule_pos, "Text kjem etter Norscode")
    hvis feil != 0 {
        skriv("test_github_linguist_yaml_contract FEIL: " + tekst(feil) + "\n")
        returner 1
    }
    skriv("test_github_linguist_yaml_contract OK\n")
    returner 0
}
