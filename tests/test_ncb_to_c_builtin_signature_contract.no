funksjon start() -> heiltall {
    la src = fil_les("archive/legacy_c_backend/ncb_to_c.no")
    assert(builtin.contains(src, "funksjon ncbj_les(src: tekst)"))
    assert(builtin.contains(src, "ncb = ncbj_les(ncb_json)"))
    assert(builtin.contains(src, "NC_NCB_JSON_SELFTEST"))
    assert(builtin.contains(src, "builtin_kart[\"builtin.system_info\"] = \"nc_builtin_system_info\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.builtin.system_info\"] = \"nc_builtin_system_info\""))
    assert(builtin.contains(src, "static NcVal *nc_builtin_system_info(void);"))
    assert(builtin.contains(src, "builtin_kart[\"builtin.system_operation\"] = \"nc_builtin_system_operation\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.builtin.system_operation\"] = \"nc_builtin_system_operation\""))
    assert(builtin.contains(src, "static NcVal *nc_builtin_system_operation(NcVal *request);"))
    assert(builtin.contains(src, "NcVal *nc_fn_builtin_host_exec_ncb_json(NcVal **, int);"))
    assert(builtin.contains(src, "NcVal *nc_fn_builtin_host_kall_bygg_bundle(NcVal **, int);"))
    assert(builtin.contains(src, "Builtins har fleire C-signaturfamiliar"))
    assert(builtin.contains(src, "returner opcode_til_c(instr, functions, ip, builtin_kart, legacy_escape)"))
    assert(builtin.contains(src, "hvis ikkje finnes_nøkkel(builtin_kart, \"builtin.lengde\")"))
    assert(builtin.contains(src, "Ikkje materialiser heile nøkkellista for kvart CALL"))
    assert(builtin.contains(src, "(ip + 1) % 256 == 0"))
    assert(builtin.contains(src, "NC_NCB_FUNCTION_START"))
    assert(builtin.contains(src, "NC_NCB_FUNCTION_END"))
    assert(builtin.contains(src, "funksjon ncb_parse_nonnegative"))
    assert(builtin.contains(src, "builtin.char_code(teikn) - 48"))
    assert(builtin.contains(src, "i = funksjon_start"))
    assert(builtin.contains(src, "mens i < funksjon_slutt"))
    assert(builtin.contains(src, "base == \"ncb_call_fn\""))
    assert(builtin.contains(src, "base == \"ncb_route_handlers\""))
    assert(builtin.contains(src, "base == \"tensor_operation\""))
    assert(builtin.contains(src, "builtin.kompiler_fil_aktiv"))
    assert(builtin.contains(src, "selfhost.kompiler.kompiler_fil"))
    assert(builtin.contains(src, "builtin.argv_operation"))
    assert(builtin.contains(src, "builtin.fil_append_binary"))
    assert(builtin.contains(src, "builtin.mkdir_p"))
    assert(builtin.contains(src, "builtin_kart[\"builtin.sha256\"] = \"nc_builtin_sha256\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.sha256_bytes\"] = \"nc_builtin_sha256_bytes\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.pbkdf2_sha256\"] = \"nc_builtin_pbkdf2_sha256\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.argon2id\"] = \"nc_builtin_argon2id\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.acme_sign\"] = \"nc_builtin_acme_sign\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.acme_verify\"] = \"nc_builtin_acme_verify\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.dns_lookup\"] = \"nc_builtin_dns_lookup\""))
    assert(builtin.contains(src, "builtin_kart[\"builtin.resolve_host\"] = \"nc_builtin_dns_lookup\""))
    la vm_src = fil_les("selfhost/vm.no")
    assert(builtin.contains(vm_src, "hvis namn == \"builtin.system_info\""))
    assert(builtin.contains(vm_src, "returner builtin.system_info()"))
    assert(builtin.contains(vm_src, "hvis namn == \"builtin.system_operation\""))
    assert(builtin.contains(vm_src, "returner builtin.system_operation(args[0])"))
    assert(builtin.contains(vm_src, "builtin.system_operation\" eller namn == \"builtin.kompiler_fil"))
    assert(builtin.contains(vm_src, "hvis namn == \"builtin.sha256\""))
    assert(builtin.contains(vm_src, "returner builtin.sha256(args[0])"))
    assert(builtin.contains(vm_src, "hvis namn == \"builtin.sha256_bytes\""))
    assert(builtin.contains(vm_src, "returner builtin.sha256_bytes(args[0])"))
    assert(builtin.contains(vm_src, "namn == \"builtin.lex\""))
    assert(builtin.contains(vm_src, "lexer_m1.lex"))
    assert(builtin.contains(vm_src, "selfhost.lexer.lexer_m1.lex"))
    skriv("test_ncb_to_c_builtin_signature_contract OK")
    returner 0
}
