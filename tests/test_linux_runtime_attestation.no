bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/linux_runtime_attestation.no")
    assert(t.inneholder(src, "norscode-linux-runtime-attestation-v1"))
    assert(t.inneholder(src, "prosess.køyr(\"/usr/bin/uname\", [flagg]"))
    assert(t.inneholder(src, "NORSCODE_EXPECT_SANDBOX_BACKEND\": \"seccomp"))
    assert(t.inneholder(src, "NORSCODE_EXPECT_EVENT_BACKEND\": \"epoll"))
    assert(t.inneholder(src, "tests/test_native_thread_backend.no"))
    assert(t.inneholder(src, "tests/test_argon2_native.no"))
    assert(t.inneholder(src, "test_native_tls_event_loop OK"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_linux_runtime_attestation OK\n")
    returner 0
}
