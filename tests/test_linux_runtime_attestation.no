bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/linux_runtime_attestation.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "norscode-linux-runtime-attestation-v1"))
    assert(t.inneholder(src, "ark == \"x64\""))
    assert(t.inneholder(src, "NORSCODE_LINUX_ATTESTATION_DIRECT"))
    assert(t.inneholder(src, "arm_probe.start()"))
    assert(t.inneholder(src, "NORSCODE_LINUX_ATTESTATION_REPORT_ONLY"))
    // Dei tre NORSCODE_ARM64_PROBE_SECTION-stega låg i jobben
    // «Linux runtime attestasjon (arm64)», som er fjerna i Fase C.5: han bygde
    // kandidaten sin med gcc frå build/v3009/native_candidate_gc.c, og den fila
    // finst ikkje lenger. ARM64-attestasjon ventar på ein Norscode-bygd
    // AArch64-runtime (B2/C.2), og readiness-rapporten seier framleis
    // production_ready_linux_arm64=false. Det som blir sjekka her no, er at
    // ARM64-PROBEN sjølv framleis finst — den er uavhengig av den slettne jobben.
    assert(fil_finnes("tests/test_linux_arm64_runtime_attestation_probe.no"))
    assert(t.inneholder(src, "la info = builtin.system_info()"))
    assert(ikkje t.inneholder(src, "/usr/bin/uname"))
    assert(t.inneholder(src, "NORSCODE_EXPECT_SANDBOX_BACKEND\": \"seccomp"))
    assert(t.inneholder(src, "NORSCODE_EXPECT_EVENT_BACKEND\": \"epoll"))
    assert(t.inneholder(src, "tests/test_linux_runtime_attestation_probe.no"))
    assert(t.inneholder(src, "test_linux_runtime_attestation_probe OK"))
    assert(t.inneholder(src, "probe_ncb_sha256"))
    assert(t.inneholder(src, "miljø[\"NORSCODE_CMD\"] = \"run-ncb\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_linux_runtime_attestation OK\n")
    returner 0
}
