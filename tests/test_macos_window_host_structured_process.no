bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/build-macos-window-host.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "hvis fil_finst(\"/usr/bin/xcrun\") { returner \"/usr/bin/xcrun\" }"))
    assert(t.inneholder(src, "la resultat: liste_tekst = [\"swiftc\"]"))
    assert(t.inneholder(src, "swiftc_argv(swiftc_path, swift_args)"))
    assert(t.inneholder(src, "prosess.køyr(executable, argv, cwd, {}, 600000)"))
    assert(t.inneholder(src, "bruk tools.platform_context_v1 som kontekst"))
    assert(t.inneholder(src, "kontekst.er_macos()"))
    assert(t.inneholder(src, "[\"-O\", \"-module-cache-path\", module_cache_dir"))
    assert(t.inneholder(src, "plist_gate.valider_info(contents_dir + \"/Info.plist\")"))
    assert(ikkje t.inneholder(src, "plutil"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "command -v"))
    assert(ikkje t.inneholder(src, "uname -s"))
    assert(ikkje t.inneholder(src, "kommando(\"pwd\")"))
    skriv("test_macos_window_host_structured_process OK")
    returner 0
}
