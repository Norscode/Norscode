bruk std.tekst som t

funksjon sjekk_shell_readiness(sti: tekst) {
    la src = fil_les(sti)
    assert(t.inneholder(src, "builtin.sha256_bytes(builtin.fil_les_binær(sti))"))
    assert(ikkje t.inneholder(src, "exec_prosess("))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "shasum"))
    assert(ikkje t.inneholder(src, "sha256sum"))
    assert(ikkje t.inneholder(src, "awk"))
    assert(ikkje t.inneholder(src, "| awk"))
}

funksjon start() -> heiltall {
    sjekk_shell_readiness("tools/native_readiness_v3400.no")
    sjekk_shell_readiness("tools/native_active_status_v3007.no")
    la platform = fil_les("tools/platform_readiness_v3600.no")
    assert(t.inneholder(platform, "builtin.sha256_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(platform, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(platform, "native_fs.native_tempområde"))
    assert(t.inneholder(platform, "funksjon verifiser_github_attestasjon"))
    assert(t.inneholder(platform, "for mappe i builtin.split(sti, skilje)"))
    assert(ikkje t.inneholder(platform, "exec_prosess"))
    assert(ikkje t.inneholder(platform, "shasum"))
    assert(ikkje t.inneholder(platform, "sha256sum"))
    assert(ikkje t.inneholder(platform, "awk"))
    la readiness = fil_les("tools/native_readiness_v3400.no")
    assert(t.inneholder(readiness, "builtin.fil_finnes(sti)"))
    assert(t.inneholder(readiness, "NORSCODE_PROMOTE_CANDIDATE="))
    assert(t.inneholder(readiness, "bin/nc run tools/promote_native_stage0_v3001.no"))
    assert(t.inneholder(readiness, "NORSCODE_NATIVE_GAP_BIN="))
    assert(t.inneholder(readiness, "bin/nc run tools/native_runtime_gap_gate_v3001.no"))
    assert(ikkje t.inneholder(readiness, "bash tools/promote_native_stage0_v3001.sh"))
    assert(ikkje t.inneholder(readiness, "bash tools/native_runtime_gap_gate_v3001.sh"))
    assert(ikkje t.inneholder(readiness, "test -x "))
    la active = fil_les("tools/native_active_status_v3007.no")
    assert(t.inneholder(active, "builtin.fil_finnes(sti)"))
    assert(t.inneholder(active, "NORSCODE_NATIVE_GAP_BIN="))
    assert(t.inneholder(active, "bin/nc run tools/native_runtime_gap_gate_v3001.no"))
    assert(ikkje t.inneholder(active, "bash tools/native_runtime_gap_gate_v3001.sh"))
    assert(ikkje t.inneholder(active, "test -x "))
    skriv("test_readiness_sha_parsing_no_awk OK")
    returner 0
}
