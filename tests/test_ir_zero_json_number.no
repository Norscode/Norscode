bruk selfhost.compiler.ir_to_bytecode som ir

funksjon start() -> heiltall {
    la liste = ir.json_instruksjon_med_int("BUILD_LIST", 0)
    la kart = ir.json_instruksjon_med_int("BUILD_MAP", 0)
    la kall = ir.json_kall("builtin.tid_ms", 0)
    la kjeldekart = ir.json_liste([0, 1, 0])

    assert(liste == "[\"BUILD_LIST\",0]")
    assert(kart == "[\"BUILD_MAP\",0]")
    assert(kall == "[\"CALL\",\"builtin.tid_ms\",0]")
    assert(kjeldekart == "[0,1,0]")
    assert(ir.json_instruksjon_med_tekst("PUSH_CONST", "") == "[\"PUSH_CONST\",\"\"]")
    assert(ir.json_heiltal_tekst(null) == "0")
    assert(ir.json_heiltal_tekst("") == "0")
    assert(ir.json_heiltal_tekst(12) == "12")
    assert(ir.json_heiltal_tekst(-37) == "-37")

    la dokument = builtin.json_parse_raw("[" + liste + "," + kart + "," + kall + "," + kjeldekart + "]")
    assert(lengde(dokument) == 4)
    assert(dokument[0][1] == 0)
    assert(dokument[1][1] == 0)
    assert(dokument[2][2] == 0)
    assert(dokument[3][0] == 0)
    skriv("test_ir_zero_json_number OK\n")
    returner 0
}
