bruk std.dns som dns
bruk std.sha256 som sha

// Kjent-svar-test: DNSSEC DS-record (RFC 4034 §5 / RFC 4509).
//
// dnssec_ds_digest = SHA-256(kanonisk eier-navn i wire-format ∥ DNSKEY-rdata)
// (RFC 4034 §5.1.1). dnssec_ds_record er presentasjonsformatet
// "<key_tag> <alg=8> <digest_type=2> <digest-hex>". DS binder delegering fra
// foreldresonen — fundamentet under DNSSEC og dermed ACME/DNS-tillit.
//
// Uavhengig kryss-sjekk: eier-navnet "example.com" har det RFC-1035-kjente
// wire-formatet 07"example" 03"com" 00; vi SHA-256-er det ∥ rdata med den
// allerede RFC-verifiserte std.sha256 og krever at DS-digesten er lik.

funksjon _bygg(wire: liste_heltall, rdata: liste_heltall) -> liste_heltall {
    la ut: liste_heltall = []
    la i = 0
    mens i < lengde(wire) { legg_til(ut, wire[i]) i = i + 1 }
    i = 0
    mens i < lengde(rdata) { legg_til(ut, rdata[i]) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    la rdata = [1, 2, 3, 4, 5]
    // 07 "example" 03 "com" 00
    la wire = [7, 101, 120, 97, 109, 112, 108, 101, 3, 99, 111, 109, 0]
    la uavhengig = sha.hash_bytes(_bygg(wire, rdata))

    // Digesten er SHA-256(wire-navn ∥ rdata) — verifisert uavhengig + som anker.
    assert(dns.dnssec_ds_digest("example.com", rdata, "SHA-256") == uavhengig)
    assert(dns.dnssec_ds_digest("example.com", rdata, "SHA-256")
        == "76e8b03a8cf2f34807640e5d0c5f58363f6136b36f290f3e00c7e7264b1d2442")

    // Kanonisk navn er case-insensitivt (RFC 4034 §6.2).
    assert(dns.dnssec_ds_digest("EXAMPLE.COM", rdata, "SHA-256")
        == dns.dnssec_ds_digest("example.com", rdata, "SHA-256"))

    // "2" er alias for SHA-256; andre digest-typer avvises.
    assert(dns.dnssec_ds_digest("example.com", rdata, "2")
        == dns.dnssec_ds_digest("example.com", rdata, "SHA-256"))
    assert(dns.dnssec_ds_digest("example.com", rdata, "SHA-1") == "")
    assert(dns.dnssec_ds_digest("", rdata, "SHA-256") == "")

    // Presentasjonsformat: key_tag, algoritme 8 (RSASHA256), digest-type 2.
    assert(dns.dnssec_ds_record("example.com", 12345, rdata)
        == "12345 8 2 76e8b03a8cf2f34807640e5d0c5f58363f6136b36f290f3e00c7e7264b1d2442")

    // Validering: riktig record aksepteres, tuklet key_tag avvises.
    la gyldig = dns.dnssec_ds_record("example.com", 12345, rdata)
    assert(dns.dnssec_ds_valider("example.com", 12345, rdata, gyldig))
    assert(ikkje dns.dnssec_ds_valider("example.com", 99999, rdata, gyldig))

    skriv("test_dns_ds_record: OK\n")
    returner 0
}
