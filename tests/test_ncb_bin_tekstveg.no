// F3.6 (J5): tekstvegen i ncb_bin (ncb_encode_tekst / ncb_decode_tekst) skal gje
// NØYAKTIG same bytar som liste-vegen (bin_encode / bin_decode), og formatregelen
// (serde.binaer_for_sti_flagg) og release-image-regelen (embed_release_ncb) skal seie
// både ja og nei. Hermetisk, køyrer på alle vertar: på C-æra-vertane (chr(0) = "")
// skal den binære tekstvegen nekte (fail-closed) i staden for å skrive korrupt.

bruk selfhost.ncb_bin som bin
bruk selfhost.ncb_serde som serde
bruk tools.embed_release_ncb som embed

// Tekst → bytar via char_code (aldri json_stringify: sjå verifikasjonsfeller nr. 1).
funksjon like_bytar(t: tekst, b: liste_heiltall) -> boolsk {
    hvis lengde(t) != lengde(b) {
        skriv("lengd: tekst=" + tekst(lengde(t)) + " liste=" + tekst(lengde(b)) + "\n")
        returner usann
    }
    la i = 0
    mens i < lengde(b) {
        hvis (builtin.char_code(builtin.slice(t, i, i + 1)) & 255) != (b[i] & 255) {
            skriv("byte " + tekst(i) + " skil seg\n")
            returner usann
        }
        i = i + 1
    }
    returner sann
}

// Rundtur: tekst-kode → tekst-dekode → tekst-kode på nytt skal gje same tekst.
funksjon rundtur_lik(v) -> boolsk {
    la a = bin.bin_encode_tekst(v)
    la b = bin.bin_encode_tekst(bin.bin_decode_tekst(a, 0))
    returner a == b
}

funksjon kastar_ved_dekoding(t: tekst) -> boolsk {
    prøv { bin.bin_decode_tekst(t, 0) } fang (e) { returner sann }
    returner usann
}

funksjon regel() -> heiltall {
    // flagg "0" → alltid JSON; "1" → binær når støtta; "" → filendinga avgjer.
    assert(ikkje serde.binaer_for_sti_flagg("x.ncb", "0", sann))
    assert(serde.binaer_for_sti_flagg("x.ncb.json", "1", sann))
    assert(ikkje serde.binaer_for_sti_flagg("x.ncb.json", "", sann))
    assert(serde.binaer_for_sti_flagg("x.ncb", "", sann))
    assert(serde.binaer_for_sti_flagg("build/out", "", sann))
    // Utan NUL-trygge strengar (C-æra) er svaret alltid JSON.
    assert(ikkje serde.binaer_for_sti_flagg("x.ncb", "1", usann))
    assert(ikkje serde.binaer_for_sti_flagg("x.ncb", "", usann))

    // Release-imaget (lese av C-æra-runtimane) tek berre JSON.
    la binær = builtin.chr(147) + "NCB" + builtin.chr(1) + builtin.chr(4)
    assert(embed.er_binær_ncb(binær))
    assert(embed.payload_avvist("p.ncb", binær) != "")
    assert(builtin.contains(embed.payload_avvist("p.ncb", binær), "JSON-berre"))
    la json = "{\"format\":\"norscode-bytecode-v1\",\"entry\":\"x.start\",\"functions\":{}}"
    assert(ikkje embed.er_binær_ncb(json))
    assert_eq(embed.payload_avvist("p.ncb.json", json), "")
    returner 0
}

funksjon start() -> heiltall {
    regel()

    hvis ikkje serde.binaer_stotta() {
        // C-æra-vert: kodaren skal nekte, ikkje skrive ein avkorta fil.
        la nekta = usann
        prøv { serde.serialiser_tekst({"format": "norscode-bytecode-v1"}) } fang (e) { nekta = sann }
        assert(nekta)
        skriv("test_ncb_bin_tekstveg OK (C-æra: berre regel + fail-closed)\n")
        returner 0
    }

    la nul = "a" + builtin.chr(0) + "b"
    la verdiar = [
        [], {}, [[], {}, [[]]],
        [0, 127, 128, 16383, 16384, 2097151, 2097152, 1000000000],
        [-1, -127, -128, -16384, -1000000000],
        ["", "æøå", "a\"b\\c", "line1\nline2\ttab", "😀emoji", nul],
        [sann, usann],
        [3.5, -0.25, 12345.678, 0.1],
        {"format": "norscode-bytecode-v1", "entry": "__main__.start",
         "functions": {"__main__.start": {"name": "start", "module": "__main__", "params": [],
             "is_async": usann, "code": [["PUSH_CONST", "blåbær"], ["PUSH_CONST", 2.5],
             ["PUSH_CONST", -7], ["RETURN"]]}}}
    ]
    la i = 0
    mens i < lengde(verdiar) {
        la v = verdiar[i]
        hvis ikkje like_bytar(bin.bin_encode_tekst(v), bin.bin_encode(v)) {
            skriv("tekst- og liste-vegen skil seg for verdi " + tekst(i) + "\n")
            assert(usann)
        }
        assert(rundtur_lik(v))
        i = i + 1
    }

    // Heile i64-området: |v| >= 2^62 gjev zigzag med toppbiten sett. Før F3.6 stoppa
    // varint-lykkja då etter éin byte (2^63-1 vart 63, målt i nc_main-NCB-en).
    // Verdiane skal kome att (ikkje berre re-kodast likt), og 2^63-1 skal gje dei
    // eksakte 10 LEB128-bytane FE FF FF FF FF FF FF FF FF 01.
    la maks = 9223372036854775807
    la minst = (0 - maks) - 1
    la store = [maks, minst, 4611686018427387904, 0 - 4611686018427387904,
                4611686018427387903, 0 - 4611686018427387905, 0 - 1, 0]
    la store_ut = bin.bin_decode_tekst(bin.bin_encode_tekst(store), 0)
    la si = 0
    mens si < lengde(store) {
        hvis store_ut[si] != store[si] {
            skriv("stort heiltal " + tekst(si) + " kom ikkje att: " + tekst(store_ut[si]) + "\n")
            assert(usann)
        }
        si = si + 1
    }
    assert(like_bytar(bin.bin_encode_tekst(store), bin.bin_encode(store)))
    assert(like_bytar(bin.bin_encode_tekst(maks), [1, 254, 255, 255, 255, 255, 255, 255, 255, 255, 1]))
    assert(like_bytar(bin.bin_encode_tekst(minst), [1, 255, 255, 255, 255, 255, 255, 255, 255, 255, 1]))
    assert_eq(bin.bin_decode(bin.bin_encode(maks)), maks)
    assert_eq(bin.bin_decode(bin.bin_encode(minst)), minst)

    // NUL inne i ein tekst overlever rundturen (lengd 3, midtbyte 0).
    la nul_ut = bin.bin_decode_tekst(bin.bin_encode_tekst([nul]), 0)
    assert_eq(lengde(nul_ut[0]), 3)
    assert_eq(builtin.char_code(builtin.slice(nul_ut[0], 1, 2)) & 255, 0)
    // Flyttal: type og verdi.
    la fl = bin.bin_decode_tekst(bin.bin_encode_tekst([3.5, -0.25]), 0)
    assert_eq(builtin.type(fl[0]), "desimaltall")
    assert_eq(tekst(fl[0]), "3.5")
    assert_eq(tekst(fl[1]), "-0.25")
    // Heile NCB-en: serialiser_tekst == serialiser (magic + versjon + kropp).
    la ncb = verdiar[lengde(verdiar) - 1]
    la st = serde.serialiser_tekst(ncb)
    assert(like_bytar(st, serde.serialiser(ncb)))
    assert(serde.er_binaer_tekst(st))
    la tilbake = serde.deserialiser_tekst(st)
    assert_eq(tilbake["entry"], "__main__.start")
    assert_eq(tilbake["functions"]["__main__.start"]["code"][0][1], "blåbær")

    // Negative kontrollar: dekodaren skal seie nei.
    la heil = bin.bin_encode_tekst({"a": [1, 2, "xyz"]})
    assert(kastar_ved_dekoding(builtin.slice(heil, 0, lengde(heil) - 2)))   // avkorta
    assert(kastar_ved_dekoding(builtin.chr(9)))                            // ukjend tag
    assert(ikkje kastar_ved_dekoding(heil))

    skriv("test_ncb_bin_tekstveg OK\n")
    returner 0
}
