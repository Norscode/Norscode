// Regresjon (Java-paritet F40): dato/tid (java.time-semantikk).
//  - tid.unix_til_iso og sone.format_iso gav 30. desember for 31. desember i
//    skotår (årsløkka trekte frå ein dag i staden for å stoppe).
//  - EU-sommartid starta 00:00 UTC i staden for 01:00 UTC.
//  - dato.frå_ordinal gav 2024-01-01 for 2024-12-31 (og 1901 for 2000-12-31).
//  - Sør-amerikanske soner fekk US-sommartid.
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.tid som tid
bruk std.sone som sone
bruk std.dato som dato

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]

    // tid.unix_til_iso (UTC)
    sjekk(feil, "2024-12-31", tid.unix_til_iso(1735646400), "2024-12-31T12:00:00")
    sjekk(feil, "2024-12-31 23:59:59", tid.unix_til_iso(1735689599), "2024-12-31T23:59:59")
    sjekk(feil, "2025-01-01", tid.unix_til_iso(1735689600), "2025-01-01T00:00:00")
    sjekk(feil, "2000-12-31", tid.unix_til_iso(978220800), "2000-12-31T00:00:00")
    sjekk(feil, "2000-02-29", tid.unix_til_iso(951782400), "2000-02-29T00:00:00")
    sjekk(feil, "2100-03-01", tid.unix_til_iso(4107542400), "2100-03-01T00:00:00")
    sjekk(feil, "epoch", tid.unix_til_iso(0), "1970-01-01T00:00:00")
    sjekk(feil, "før 1970", tid.unix_til_iso(-1), "1969-12-31T23:59:59")
    sjekk(feil, "1900-03-01", tid.unix_til_iso(-2203891200), "1900-03-01T00:00:00")
    sjekk(feil, "ymd_hms_til_unix", tekst(tid.ymd_hms_til_unix(2024, 12, 31, 12, 0, 0)), "1735646400")
    sjekk(feil, "rundtur 1972-12-31", tekst(tid.ymd_til_dagar(1972, 12, 31)), "1095")

    // norsk_sommertid: CET/CEST
    sjekk(feil, "norsk vinter", tekst(tid.norsk_sommertid(1774745999) - 1774745999), "3600")
    sjekk(feil, "norsk sommar", tekst(tid.norsk_sommertid(1774746000) - 1774746000), "7200")
    sjekk(feil, "norsk haust", tekst(tid.norsk_sommertid(1792889999) - 1792889999) + "/" + tekst(tid.norsk_sommertid(1792890000) - 1792890000), "7200/3600")

    // sone.format_iso: EU-overgangar 2026 (29. mars 01:00Z, 25. oktober 01:00Z)
    sjekk(feil, "Oslo før DST", sone.format_iso(1774745999, "Europe/Oslo"), "2026-03-29T01:59:59+01:00")
    sjekk(feil, "Oslo DST-start", sone.format_iso(1774746000, "Europe/Oslo"), "2026-03-29T03:00:00+02:00")
    sjekk(feil, "Oslo før DST-slutt", sone.format_iso(1792889999, "Europe/Oslo"), "2026-10-25T02:59:59+02:00")
    sjekk(feil, "Oslo DST-slutt", sone.format_iso(1792890000, "Europe/Oslo"), "2026-10-25T02:00:00+01:00")
    sjekk(feil, "London sommar", sone.format_iso(1782907200, "Europe/London"), "2026-07-01T13:00:00+01:00")
    sjekk(feil, "Helsinki DST-start", sone.format_iso(1774746000, "Europe/Helsinki"), "2026-03-29T04:00:00+03:00")
    sjekk(feil, "Oslo 31. desember skotår", sone.format_iso(1735689000, "Europe/Oslo"), "2025-01-01T00:50:00+01:00")
    sjekk(feil, "UTC 31. desember skotår", sone.format_iso(1735646400, "UTC"), "2024-12-31T12:00:00+00:00")

    // US: 8. mars 2026 07:00Z (02:00 EST) og 1. november 06:00Z (02:00 EDT)
    sjekk(feil, "New York før", sone.format_iso(1772953199, "America/New_York"), "2026-03-08T01:59:59-05:00")
    sjekk(feil, "New York DST", sone.format_iso(1772953200, "America/New_York"), "2026-03-08T03:00:00-04:00")
    sjekk(feil, "New York haust", sone.format_iso(1793512800, "America/New_York"), "2026-11-01T01:00:00-05:00")
    sjekk(feil, "Sao Paulo utan DST", sone.format_iso(1782907200, "America/Sao_Paulo"), "2026-07-01T09:00:00-03:00")
    sjekk(feil, "Sao Paulo januar", sone.format_iso(1767268800, "America/Sao_Paulo"), "2026-01-01T09:00:00-03:00")
    sjekk(feil, "Phoenix", sone.format_iso(1782907200, "America/Phoenix"), "2026-07-01T05:00:00-07:00")
    sjekk(feil, "Sydney januar", sone.format_iso(1767268800, "Australia/Sydney"), "2026-01-01T23:00:00+11:00")
    sjekk(feil, "Sydney juli", sone.format_iso(1782907200, "Australia/Sydney"), "2026-07-01T22:00:00+10:00")

    // til_utc (lokal → UTC), inkl. DST-dagar
    sjekk(feil, "til_utc sommar", tekst(sone.til_utc(1782907200 + 7200, "Europe/Oslo")), "1782907200")
    sjekk(feil, "til_utc vinter", tekst(sone.til_utc(1767268800 + 3600, "Europe/Oslo")), "1767268800")
    sjekk(feil, "til_utc like etter start", tekst(sone.til_utc(1774746000 + 7200, "Europe/Oslo")), "1774746000")

    // dato: ordinal-rundtur for 31. desember i skotår
    for s i ["2024-12-31", "2000-12-31", "2400-12-31", "1996-12-31", "2023-12-31", "2024-02-29", "2100-12-31"] {
        sjekk(feil, "dato " + s, dato.til_iso(dato.frå_iso(s)), s)
    }
    sjekk(feil, "dato +1 dag", dato.til_iso(dato.pluss_dagar(dato.frå_iso("2024-12-30"), 1)), "2024-12-31")
    sjekk(feil, "dato +2 dagar", dato.til_iso(dato.pluss_dagar(dato.frå_iso("2024-12-30"), 2)), "2025-01-01")

    hvis feil[0] == 0 { skriv("test_tid_sone_java_paritet OK\n") }
    returner feil[0]
}
