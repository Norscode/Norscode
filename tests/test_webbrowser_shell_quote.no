bruk std.tekst som t
bruk std.webbrowser som webbrowser

funksjon start() -> heiltall {
    la src = fil_les("std/webbrowser.no")
    assert(t.inneholder(src, "shell-fri prosess-ABI"))
    assert(t.inneholder(src, "bruk std.platform som platform"))
    assert(t.inneholder(src, "bruk std.prosess som prosess"))
    assert(t.inneholder(src, "prosess.start_argv_plan(executable, args)"))
    assert(t.inneholder(src, "prosess.start_argv_trygt(policy, plan)"))
    assert(t.inneholder(src, "prosess.finn_kjorbar"))
    assert(t.inneholder(src, "funksjon _trygg_url(url: tekst) -> bool"))
    assert(t.inneholder(src, "funksjon _trygg_nettlesar_kommando(kommando: tekst) -> bool"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "sh -c"))
    assert(ikkje t.inneholder(src, "which "))
    assert(ikkje webbrowser.open("javascript:alert(1)"))
    assert(webbrowser.get("norscode-browser-does-not-exist")["funne"] == "usann")
    skriv("test_webbrowser_shell_quote OK")
    returner 0
}
