bruk std.desktop_layout som layout

la rot = layout.nytt_panel("vindu", 0, 0, 1200, 800)
hvis rot["valid"] != "sann" { kast "rot" }
la delar = layout.del_vassrett(rot, 300)
hvis lengde(delar) != 2 { kast "vassrett" }
hvis delar[0]["width"] != "300" eller delar[1]["width"] != "900" { kast "breidde" }
hvis ikkje layout.innanfor(rot, delar[0]) { kast "venstre utanfor" }
hvis ikkje layout.innanfor(rot, delar[1]) { kast "høgre utanfor" }
la loddrett = layout.del_loddrett(delar[1], 600)
hvis lengde(loddrett) != 2 { kast "loddrett" }
hvis loddrett[1]["height"] != "200" { kast "botn" }
hvis lengde(layout.del_vassrett(rot, 0)) != 0 { kast "ugyldig split" }
hvis layout.nytt_panel("bad", -1, 0, 100, 100)["valid"] != "usann" { kast "negativ posisjon" }
hvis layout.nytt_panel("bad", 16000, 0, 800, 100)["valid"] != "usann" { kast "overflow" }
skriv("desktop layout OK")
