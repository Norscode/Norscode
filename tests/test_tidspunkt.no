// Test for std.tidspunkt: java.time-liknande verdityper med kjende fasitverdiar.
// Kvar sjekk tel feil sjølv (assert er no-op i AOT), og start() returnerer talet på feil.
bruk std.tidspunkt som tp

funksjon sjekk(namn: tekst, fått: tekst, venta: tekst) -> heiltall {
    hvis fått == venta {
        returner 0
    }
    skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
    returner 1
}

funksjon sjekk_tal(namn: tekst, fått: heiltall, venta: heiltall) -> heiltall {
    returner sjekk(namn, tekst(fått), tekst(venta))
}

funksjon sjekk_sant(namn: tekst, v: boolsk) -> heiltall {
    hvis v {
        returner 0
    }
    skriv("FEIL " + namn + ": venta sann\n")
    returner 1
}

funksjon t_tekst(sek: heiltall) -> tekst {
    returner tp.tidspunkt_til_tekst(tp.tidspunkt_frå_sekund(sek))
}

funksjon oslo(iso: tekst) -> tekst {
    returner tp.sonetid_til_tekst(tp.sonetid_frå_tidspunkt(tp.tidspunkt_frå_tekst(iso), "Europe/Oslo"))
}

funksjon d(år: heiltall, månad: heiltall, dag: heiltall) {
    returner tp.dato(år, månad, dag)
}

funksjon dt(d0) -> tekst {
    returner tp.dato_til_tekst(d0)
}

funksjon v(x) -> tekst {
    returner tp.varigheit_til_tekst(x)
}

// Forventar DatoTidFeil (eller anna tekst) som inneheld `del` frå kallet `nr`.
funksjon feil_frå(nr: heiltall) -> tekst {
    la melding: tekst = "INGEN FEIL"
    prøv {
        hvis nr == 1 {
            tp.dato(2023, 2, 29)
        } ellers hvis nr == 2 {
            tp.dato_frå_tekst("2024-02-30")
        } ellers hvis nr == 3 {
            tp.dato_frå_tekst("2024-1-01")
        } ellers hvis nr == 4 {
            tp.dato(2024, 13, 1)
        } ellers hvis nr == 5 {
            tp.datotid_frå_tekst("2024-12-31T24:00")
        } ellers hvis nr == 6 {
            tp.varigheit_frå_tekst("PT")
        } ellers hvis nr == 7 {
            tp.varigheit_frå_tekst("1H")
        } ellers hvis nr == 8 {
            tp.varigheit_frå_tekst("PT1S2M")
        } ellers hvis nr == 9 {
            tp.varigheit_frå_tekst("P1H")
        } ellers hvis nr == 10 {
            tp.sonetid_frå_tidspunkt(tp.tidspunkt_frå_sekund(0), "Mars/Olympus")
        } ellers hvis nr == 11 {
            tp.tidspunkt_frå_tekst("2024-12-31T12:00:00")
        } ellers hvis nr == 12 {
            tp.varigheit_frå_tekst("PT1.1234567891S")
        } ellers hvis nr == 13 {
            tp.dato_pluss_dagar(tp.varigheit_av_sekund(1), 1)
        }
    } fang (e: DatoTidFeil) {
        melding = tekst(e)
    }
    returner melding
}

funksjon sjekk_feil(nr: heiltall, del: tekst) -> heiltall {
    la m: tekst = feil_frå(nr)
    hvis builtin.starts_with(m, "DatoTidFeil: ") og builtin.index_of(m, del) >= 0 {
        returner 0
    }
    skriv("FEIL feiltilfelle " + tekst(nr) + ": fekk [" + m + "] venta DatoTidFeil med [" + del + "]\n")
    returner 1
}

funksjon test_kalender() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk_sant("skotår 2000", tp.er_skotår(2000))
    feil = feil + sjekk_sant("ikkje skotår 1900", ikkje tp.er_skotår(1900))
    feil = feil + sjekk_sant("skotår 2024", tp.er_skotår(2024))
    feil = feil + sjekk_sant("ikkje skotår 2023", ikkje tp.er_skotår(2023))
    feil = feil + sjekk_sant("ikkje skotår 2100", ikkje tp.er_skotår(2100))
    feil = feil + sjekk_sant("skotår år 0", tp.er_skotår(0))
    feil = feil + sjekk_tal("feb 2024", tp.dagar_i_månad(2024, 2), 29)
    feil = feil + sjekk_tal("feb 2023", tp.dagar_i_månad(2023, 2), 28)
    feil = feil + sjekk_tal("apr", tp.dagar_i_månad(2024, 4), 30)
    feil = feil + sjekk_tal("des", tp.dagar_i_månad(2024, 12), 31)
    feil = feil + sjekk_tal("epoch_dag 1970", tp.epoch_dag(1970, 1, 1), 0)
    feil = feil + sjekk_tal("epoch_dag 2024-12-31", tp.epoch_dag(2024, 12, 31), 20088)
    feil = feil + sjekk_tal("epoch_dag 0001-01-01", tp.epoch_dag(1, 1, 1), -719162)
    la ymd: liste_heltall = tp.frå_epoch_dag(-1)
    feil = feil + sjekk("frå_epoch_dag -1", tekst(ymd[0]) + "-" + tekst(ymd[1]) + "-" + tekst(ymd[2]), "1969-12-31")
    // Naiv dag-for-dag-teljing (eigen månadstabell) i vindauge rundt skotdagar,
    // hundreårsskiftet 1900 (ikkje skotår), 2000 (skotår), nyttår og epoken.
    la vindauge: liste_heltall = [1900, 2, 20, 2000, 2, 20, 2023, 12, 20, 2024, 2, 20, 1969, 12, 25]
    la k: heiltall = 0
    mens k < lengde(vindauge) {
        la y: heiltall = vindauge[k]
        la m: heiltall = vindauge[k + 1]
        la dag: heiltall = vindauge[k + 2]
        la z: heiltall = tp.epoch_dag(y, m, dag)
        la steg_feil: heiltall = 0
        la n: heiltall = 0
        mens n < 16 {
            la r: liste_heltall = tp.frå_epoch_dag(z)
            hvis r[0] != y eller r[1] != m eller r[2] != dag {
                steg_feil = steg_feil + 1
            }
            hvis tp.epoch_dag(y, m, dag) != z {
                steg_feil = steg_feil + 1
            }
            z = z + 1
            dag = dag + 1
            hvis dag > naiv_månadslengd(y, m) {
                dag = 1
                m = m + 1
                hvis m > 12 {
                    m = 1
                    y = y + 1
                }
            }
            n = n + 1
        }
        feil = feil + sjekk_tal("dag-for-dag frå " + tekst(vindauge[k]) + "-" + tekst(vindauge[k + 1]), steg_feil, 0)
        k = k + 3
    }
    // Rundtur epoch_dag(frå_epoch_dag(z)) == z over år -220 til 10183, og vekedag held takta.
    la z2: heiltall = -800000
    la rundtur_feil: heiltall = 0
    mens z2 < 3000000 {
        la r2: liste_heltall = tp.frå_epoch_dag(z2)
        hvis tp.epoch_dag(r2[0], r2[1], r2[2]) != z2 {
            rundtur_feil = rundtur_feil + 1
        }
        hvis tp.vekedag_for_epoch_dag(z2) != ((z2 + 800000 + 5) % 7) + 1 {
            rundtur_feil = rundtur_feil + 1
        }
        z2 = z2 + 97571
    }
    feil = feil + sjekk_tal("rundtur", rundtur_feil, 0)
    returner feil
}

funksjon naiv_månadslengd(y: heiltall, m: heiltall) -> heiltall {
    la lengder: liste_heltall = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    hvis m == 2 og ((y % 4 == 0 og y % 100 != 0) eller y % 400 == 0) {
        returner 29
    }
    returner lengder[m - 1]
}

funksjon test_tidspunkt() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("oppgåvefasit", t_tekst(1735646400), "2024-12-31T12:00:00Z")
    feil = feil + sjekk("epoch", t_tekst(0), "1970-01-01T00:00:00Z")
    feil = feil + sjekk("y2k", t_tekst(946684800), "2000-01-01T00:00:00Z")
    feil = feil + sjekk("2038", t_tekst(2147483647), "2038-01-19T03:14:07Z")
    feil = feil + sjekk("1900", t_tekst(-2208988800), "1900-01-01T00:00:00Z")
    feil = feil + sjekk("år 1", t_tekst(-62135596800), "0001-01-01T00:00:00Z")
    feil = feil + sjekk("år -1", t_tekst(-62167305600), "-0001-12-31T00:00:00Z")
    feil = feil + sjekk("år 9999", t_tekst(253402300799), "9999-12-31T23:59:59Z")
    feil = feil + sjekk("år 10000", t_tekst(253402300800), "+10000-01-01T00:00:00Z")
    feil = feil + sjekk("ms", tp.tidspunkt_til_tekst(tp.tidspunkt_frå_ms(1735646400123)), "2024-12-31T12:00:00.123Z")
    la neg = tp.tidspunkt_frå_ms(-1)
    feil = feil + sjekk("ms -1", tp.tidspunkt_til_tekst(neg), "1969-12-31T23:59:59.999Z")
    feil = feil + sjekk_tal("ms -1 sekund", tp.tidspunkt_sekund(neg), -1)
    feil = feil + sjekk_tal("ms -1 nano", tp.tidspunkt_nano(neg), 999000000)
    feil = feil + sjekk_tal("ms -1 til_ms", tp.tidspunkt_til_ms(neg), -1)
    feil = feil + sjekk("mikro", tp.tidspunkt_til_tekst(tp.tidspunkt(0, 1000)), "1970-01-01T00:00:00.000001Z")
    feil = feil + sjekk("nano", tp.tidspunkt_til_tekst(tp.tidspunkt(0, 1)), "1970-01-01T00:00:00.000000001Z")
    la ns = tp.tidspunkt_frå_ns(1735646400123456789)
    feil = feil + sjekk("frå_ns", tp.tidspunkt_til_tekst(ns), "2024-12-31T12:00:00.123456789Z")
    feil = feil + sjekk_tal("til_ns", tp.tidspunkt_til_ns(ns), 1735646400123456789)
    feil = feil + sjekk_tal("tolk Z", tp.tidspunkt_sekund(tp.tidspunkt_frå_tekst("2024-12-31T12:00:00Z")), 1735646400)
    feil = feil + sjekk_tal("tolk offset", tp.tidspunkt_sekund(tp.tidspunkt_frå_tekst("2025-01-01T01:00:00+01:00")), 1735689600)
    feil = feil + sjekk_tal("tolk utan sekund", tp.tidspunkt_sekund(tp.tidspunkt_frå_tekst("2024-12-31T12:00Z")), 1735646400)
    feil = feil + sjekk_tal("tolk brøk", tp.tidspunkt_nano(tp.tidspunkt_frå_tekst("2024-12-31T12:00:00.5Z")), 500000000)
    la t0 = tp.tidspunkt_frå_sekund(1735646400)
    la t1 = tp.tidspunkt_pluss(t0, tp.varigheit_av_minutt(90))
    feil = feil + sjekk("mellom", v(tp.tidspunkt_mellom(t0, t1)), "PT1H30M")
    feil = feil + sjekk("mellom neg", v(tp.tidspunkt_mellom(t1, t0)), "PT-1H-30M")
    feil = feil + sjekk("minus", tp.tidspunkt_til_tekst(tp.tidspunkt_minus(t0, tp.varigheit_av_dagar(1))), "2024-12-30T12:00:00Z")
    feil = feil + sjekk_tal("samanlikn", tp.tidspunkt_samanlikn(t0, t1), -1)
    feil = feil + sjekk_sant("er_etter", tp.tidspunkt_er_etter(t1, t0))
    la nå = tp.tidspunkt_nå()
    feil = feil + sjekk_sant("nå er etter 2024", tp.tidspunkt_sekund(nå) > 1735646400 og tp.tidspunkt_sekund(nå) < 4102444800)
    returner feil
}

funksjon test_varigheit() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("null", v(tp.varigheit_av_sekund(0)), "PT0S")
    feil = feil + sjekk("90 min", v(tp.varigheit_av_minutt(90)), "PT1H30M")
    feil = feil + sjekk("3725 s", v(tp.varigheit_av_sekund(3725)), "PT1H2M5S")
    feil = feil + sjekk("1500 ms", v(tp.varigheit_av_ms(1500)), "PT1.5S")
    feil = feil + sjekk("-1500 ms", v(tp.varigheit_av_ms(-1500)), "PT-1.5S")
    feil = feil + sjekk("-1 s", v(tp.varigheit_av_sekund(-1)), "PT-1S")
    feil = feil + sjekk("2 dagar", v(tp.varigheit_av_dagar(2)), "PT48H")
    feil = feil + sjekk("-500 ms", v(tp.varigheit_av_ms(-500)), "PT-0.5S")
    feil = feil + sjekk("1 ns", v(tp.varigheit_av_ns(1)), "PT0.000000001S")
    feil = feil + sjekk("-90 min", v(tp.varigheit_av_minutt(-90)), "PT-1H-30M")
    feil = feil + sjekk("61001 ms", v(tp.varigheit_av_ms(61001)), "PT1M1.001S")
    feil = feil + sjekk("1 t", v(tp.varigheit_av_timar(1)), "PT1H")
    feil = feil + sjekk("pluss", v(tp.varigheit_pluss(tp.varigheit_av_timar(1), tp.varigheit_av_minutt(30))), "PT1H30M")
    feil = feil + sjekk("minus", v(tp.varigheit_minus(tp.varigheit_av_timar(1), tp.varigheit_av_minutt(90))), "PT-30M")
    feil = feil + sjekk("neger", v(tp.varigheit_neger(tp.varigheit_av_ms(1500))), "PT-1.5S")
    feil = feil + sjekk("gonger", v(tp.varigheit_gonger(tp.varigheit_av_minutt(20), 3)), "PT1H")
    feil = feil + sjekk("abs", v(tp.varigheit_abs(tp.varigheit_av_ms(-2500))), "PT2.5S")
    feil = feil + sjekk_tal("til_ms trunkert", tp.varigheit_til_ms(tp.varigheit_av_ns(-1500000)), -1)
    feil = feil + sjekk_tal("til_ns", tp.varigheit_til_ns(tp.varigheit_av_ms(-1500)), -1500000000)
    feil = feil + sjekk_tal("til_dagar", tp.varigheit_til_dagar(tp.varigheit_av_timar(-25)), -1)
    feil = feil + sjekk_tal("til_timar", tp.varigheit_til_timar(tp.varigheit_av_minutt(-90)), -1)
    feil = feil + sjekk_tal("til_minutt", tp.varigheit_til_minutt(tp.varigheit_av_sekund(-61)), -1)
    feil = feil + sjekk_tal("getSeconds -500ms", tp.varigheit_sekund(tp.varigheit_av_ms(-500)), -1)
    feil = feil + sjekk_tal("samanlikn", tp.varigheit_samanlikn(tp.varigheit_av_ms(-1), tp.varigheit_null()), -1)
    feil = feil + sjekk_tal("tolk PT1H30M", tp.varigheit_sekund(tp.varigheit_frå_tekst("PT1H30M")), 5400)
    feil = feil + sjekk_tal("tolk P2DT3H", tp.varigheit_sekund(tp.varigheit_frå_tekst("P2DT3H")), 183600)
    feil = feil + sjekk_tal("tolk PT-0.5S", tp.varigheit_til_ms(tp.varigheit_frå_tekst("PT-0.5S")), -500)
    feil = feil + sjekk_tal("tolk -PT6H3M", tp.varigheit_sekund(tp.varigheit_frå_tekst("-PT6H3M")), -21780)
    feil = feil + sjekk_tal("tolk -PT-6H+3M", tp.varigheit_sekund(tp.varigheit_frå_tekst("-PT-6H+3M")), 21420)
    feil = feil + sjekk_tal("tolk PT1.5S", tp.varigheit_til_ms(tp.varigheit_frå_tekst("PT1.5S")), 1500)
    feil = feil + sjekk_tal("tolk P1D", tp.varigheit_sekund(tp.varigheit_frå_tekst("P1D")), 86400)
    feil = feil + sjekk_tal("tolk små bokstavar", tp.varigheit_sekund(tp.varigheit_frå_tekst("pt10m")), 600)
    feil = feil + sjekk("rundtur", v(tp.varigheit_frå_tekst("PT-1.5S")), "PT-1.5S")
    returner feil
}

funksjon test_dato() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("skotdag + 1 år", dt(tp.dato_pluss_år(d(2024, 2, 29), 1)), "2025-02-28")
    feil = feil + sjekk("skotdag + 4 år", dt(tp.dato_pluss_år(d(2024, 2, 29), 4)), "2028-02-29")
    feil = feil + sjekk("31. jan + 1 mnd (skotår)", dt(tp.dato_pluss_månader(d(2024, 1, 31), 1)), "2024-02-29")
    feil = feil + sjekk("31. jan + 1 mnd", dt(tp.dato_pluss_månader(d(2023, 1, 31), 1)), "2023-02-28")
    feil = feil + sjekk("31. mars - 1 mnd", dt(tp.dato_pluss_månader(d(2024, 3, 31), -1)), "2024-02-29")
    feil = feil + sjekk("31. okt + 4 mnd", dt(tp.dato_pluss_månader(d(2024, 10, 31), 4)), "2025-02-28")
    feil = feil + sjekk("-13 mnd", dt(tp.dato_pluss_månader(d(2024, 1, 15), -13)), "2022-12-15")
    feil = feil + sjekk("+1 dag skot", dt(tp.dato_pluss_dagar(d(2024, 2, 28), 1)), "2024-02-29")
    feil = feil + sjekk("+2 dagar skot", dt(tp.dato_pluss_dagar(d(2024, 2, 28), 2)), "2024-03-01")
    feil = feil + sjekk("nyttår", dt(tp.dato_pluss_dagar(d(2024, 12, 31), 1)), "2025-01-01")
    feil = feil + sjekk("-1 dag", dt(tp.dato_pluss_dagar(d(2024, 1, 1), -1)), "2023-12-31")
    feil = feil + sjekk("+10000 dagar", dt(tp.dato_pluss_dagar(d(2000, 1, 1), 10000)), "2027-05-19")
    feil = feil + sjekk("+2 veker", dt(tp.dato_pluss_veker(d(2024, 12, 25), 2)), "2025-01-08")
    feil = feil + sjekk_tal("vekedag 2024-12-31", tp.dato_vekedag(d(2024, 12, 31)), 2)
    feil = feil + sjekk("vekedagnamn", tp.dato_vekedag_namn(d(2024, 12, 31)), "tysdag")
    feil = feil + sjekk_tal("vekedag 1970", tp.dato_vekedag(d(1970, 1, 1)), 4)
    feil = feil + sjekk("vekedag 2000", tp.dato_vekedag_namn(d(2000, 1, 1)), "laurdag")
    feil = feil + sjekk_tal("vekedag 2024-03-31", tp.dato_vekedag(d(2024, 3, 31)), 7)
    feil = feil + sjekk_tal("vekedag 1900", tp.dato_vekedag(d(1900, 1, 1)), 1)
    feil = feil + sjekk_tal("dag i år 366", tp.dato_dag_i_år(d(2024, 12, 31)), 366)
    feil = feil + sjekk_tal("dag i år 60", tp.dato_dag_i_år(d(2023, 3, 1)), 60)
    feil = feil + sjekk_tal("dag i år 61", tp.dato_dag_i_år(d(2024, 3, 1)), 61)
    feil = feil + sjekk_tal("dagar mellom", tp.dato_dagar_mellom(d(2024, 1, 1), d(2025, 1, 1)), 366)
    feil = feil + sjekk_tal("dagar mellom neg", tp.dato_dagar_mellom(d(2025, 1, 1), d(2024, 1, 1)), -366)
    feil = feil + sjekk_tal("lengd månad", tp.dato_lengd_månad(d(2024, 2, 1)), 29)
    feil = feil + sjekk_sant("er_før", tp.dato_er_før(d(2024, 2, 28), d(2024, 2, 29)))
    feil = feil + sjekk("år 12345", dt(d(12345, 1, 1)), "+12345-01-01")
    feil = feil + sjekk("år 5", dt(d(5, 3, 4)), "0005-03-04")
    feil = feil + sjekk("år -1", dt(d(-1, 1, 1)), "-0001-01-01")
    feil = feil + sjekk("år 0 skotdag", dt(d(0, 2, 29)), "0000-02-29")
    feil = feil + sjekk("tolk", dt(tp.dato_frå_tekst("2024-02-29")), "2024-02-29")
    feil = feil + sjekk("tolk +år", dt(tp.dato_frå_tekst("+12345-01-01")), "+12345-01-01")
    feil = feil + sjekk("tolk -år", dt(tp.dato_frå_tekst("-0001-01-01")), "-0001-01-01")
    feil = feil + sjekk("epoch_dag rundtur", dt(tp.dato_frå_epoch_dag(20088)), "2024-12-31")
    la juli = d(2024, 7, 9)
    feil = feil + sjekk_tal("felt", juli["månad"], 7)
    returner feil
}

funksjon test_datotid() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("utan sekund", tp.datotid_til_tekst(tp.datotid(2024, 12, 31, 12, 0, 0)), "2024-12-31T12:00")
    feil = feil + sjekk("sekund", tp.datotid_til_tekst(tp.datotid(2024, 12, 31, 12, 0, 5)), "2024-12-31T12:00:05")
    feil = feil + sjekk("ms", tp.datotid_til_tekst(tp.datotid_nano(2024, 12, 31, 12, 0, 5, 123000000)), "2024-12-31T12:00:05.123")
    feil = feil + sjekk("mikro", tp.datotid_til_tekst(tp.datotid_nano(2024, 12, 31, 12, 0, 0, 1000)), "2024-12-31T12:00:00.000001")
    feil = feil + sjekk("nano", tp.datotid_til_tekst(tp.datotid_nano(2024, 12, 31, 12, 0, 0, 5)), "2024-12-31T12:00:00.000000005")
    feil = feil + sjekk("+1 time over nyttår", tp.datotid_til_tekst(tp.datotid_pluss_timar(tp.datotid(2024, 12, 31, 23, 30, 0), 1)), "2025-01-01T00:30")
    feil = feil + sjekk("-31 min", tp.datotid_til_tekst(tp.datotid_pluss_minutt(tp.datotid(2024, 1, 1, 0, 30, 0), -31)), "2023-12-31T23:59")
    feil = feil + sjekk("+1 ns", tp.datotid_til_tekst(tp.datotid_pluss_nano(tp.datotid_nano(2024, 12, 31, 23, 59, 59, 999999999), 1)), "2025-01-01T00:00")
    feil = feil + sjekk("pluss varigheit", tp.datotid_til_tekst(tp.datotid_pluss(tp.datotid(2024, 2, 28, 22, 0, 0), tp.varigheit_frå_tekst("PT26H30M"))), "2024-03-01T00:30")
    feil = feil + sjekk("frå epoch", tp.datotid_til_tekst(tp.datotid_frå_epoch_sekund(1735646400, 0, 3600)), "2024-12-31T13:00")
    feil = feil + sjekk_tal("til epoch", tp.datotid_til_epoch_sekund(tp.datotid(2024, 12, 31, 13, 0, 0), 3600), 1735646400)
    feil = feil + sjekk("+1 mnd klemt", tp.datotid_til_tekst(tp.datotid_pluss_månader(tp.datotid(2024, 1, 31, 10, 0, 0), 1)), "2024-02-29T10:00")
    feil = feil + sjekk("tolk rundtur", tp.datotid_til_tekst(tp.datotid_frå_tekst("2024-12-31T12:00:05.123")), "2024-12-31T12:00:05.123")
    feil = feil + sjekk("tolk utan sek", tp.datotid_til_tekst(tp.datotid_frå_tekst("2024-12-31T12:00")), "2024-12-31T12:00")
    feil = feil + sjekk_tal("vekedag", tp.datotid_vekedag(tp.datotid(2024, 12, 31, 23, 0, 0)), 2)
    feil = feil + sjekk("dato ved tid", tp.datotid_til_tekst(tp.dato_ved_tid(d(2024, 6, 1), 8, 15, 0)), "2024-06-01T08:15")
    returner feil
}

funksjon test_sonetid() -> heiltall {
    la feil: heiltall = 0
    // Overgangar: siste sundag i mars/oktober 01:00 UTC (1981–1995: september; 1980: 6/4–28/9).
    la ov = tp.sommartid_overgangar(2024)
    feil = feil + sjekk("2024 start", tp.tidspunkt_til_tekst(ov[0]), "2024-03-31T01:00:00Z")
    feil = feil + sjekk("2024 slutt", tp.tidspunkt_til_tekst(ov[1]), "2024-10-27T01:00:00Z")
    ov = tp.sommartid_overgangar(2025)
    feil = feil + sjekk("2025 start", tp.tidspunkt_til_tekst(ov[0]), "2025-03-30T01:00:00Z")
    feil = feil + sjekk("2025 slutt", tp.tidspunkt_til_tekst(ov[1]), "2025-10-26T01:00:00Z")
    ov = tp.sommartid_overgangar(1990)
    feil = feil + sjekk("1990 start", tp.tidspunkt_til_tekst(ov[0]), "1990-03-25T01:00:00Z")
    feil = feil + sjekk("1990 slutt", tp.tidspunkt_til_tekst(ov[1]), "1990-09-30T01:00:00Z")
    ov = tp.sommartid_overgangar(1980)
    feil = feil + sjekk("1980 start", tp.tidspunkt_til_tekst(ov[0]), "1980-04-06T01:00:00Z")
    feil = feil + sjekk("1980 slutt", tp.tidspunkt_til_tekst(ov[1]), "1980-09-28T01:00:00Z")
    feil = feil + sjekk_tal("1979 ingen", lengde(tp.sommartid_overgangar(1979)), 0)

    la t = tp.tidspunkt_frå_sekund(1735646400)
    la z = tp.sonetid_frå_tidspunkt(t, "Europe/Oslo")
    feil = feil + sjekk("vinter", tp.sonetid_til_tekst(z), "2024-12-31T13:00+01:00[Europe/Oslo]")
    feil = feil + sjekk("CET", tp.sonetid_forkorting(z), "CET")
    la zs = tp.sonetid_frå_tidspunkt(tp.tidspunkt_frå_tekst("2024-07-01T12:00:00Z"), "Europe/Oslo")
    feil = feil + sjekk("sommar", tp.sonetid_til_tekst(zs), "2024-07-01T14:00+02:00[Europe/Oslo]")
    feil = feil + sjekk("CEST", tp.sonetid_forkorting(zs), "CEST")
    feil = feil + sjekk_sant("er sommartid", tp.sonetid_er_sommartid(zs))
    feil = feil + sjekk("før vår", oslo("2024-03-31T00:59:59Z"), "2024-03-31T01:59:59+01:00[Europe/Oslo]")
    feil = feil + sjekk("vår", oslo("2024-03-31T01:00:00Z"), "2024-03-31T03:00+02:00[Europe/Oslo]")
    feil = feil + sjekk("før haust", oslo("2024-10-27T00:59:59Z"), "2024-10-27T02:59:59+02:00[Europe/Oslo]")
    feil = feil + sjekk("haust", oslo("2024-10-27T01:00:00Z"), "2024-10-27T02:00+01:00[Europe/Oslo]")
    feil = feil + sjekk("1975 utan sommartid", oslo("1975-07-01T12:00:00Z"), "1975-07-01T13:00+01:00[Europe/Oslo]")
    feil = feil + sjekk("1990 okt", oslo("1990-10-15T12:00:00Z"), "1990-10-15T13:00+01:00[Europe/Oslo]")
    feil = feil + sjekk("1990 sep", oslo("1990-09-15T12:00:00Z"), "1990-09-15T14:00+02:00[Europe/Oslo]")

    // Hol og overlapp.
    la hol = tp.sonetid(2024, 3, 31, 2, 30, 0, "Europe/Oslo")
    feil = feil + sjekk("hol", tp.sonetid_til_tekst(hol), "2024-03-31T03:30+02:00[Europe/Oslo]")
    feil = feil + sjekk("hol tidspunkt", tp.tidspunkt_til_tekst(tp.sonetid_til_tidspunkt(hol)), "2024-03-31T01:30:00Z")
    la over = tp.sonetid(2024, 10, 27, 2, 30, 0, "Europe/Oslo")
    feil = feil + sjekk("overlapp", tp.sonetid_til_tekst(over), "2024-10-27T02:30+02:00[Europe/Oslo]")
    feil = feil + sjekk("overlapp tidspunkt", tp.tidspunkt_til_tekst(tp.sonetid_til_tidspunkt(over)), "2024-10-27T00:30:00Z")
    feil = feil + sjekk("overlapp +1 t", tp.sonetid_til_tekst(tp.sonetid_pluss_timar(over, 1)), "2024-10-27T02:30+01:00[Europe/Oslo]")

    // Lokal vs. tidsline-aritmetikk over vårovergangen.
    la laurdag = tp.sonetid(2024, 3, 30, 12, 0, 0, "Europe/Oslo")
    la sundag = tp.sonetid_pluss_dagar(laurdag, 1)
    feil = feil + sjekk("+1 dag lokal", tp.sonetid_til_tekst(sundag), "2024-03-31T12:00+02:00[Europe/Oslo]")
    feil = feil + sjekk("+1 dag = 23 t", v(tp.tidspunkt_mellom(tp.sonetid_til_tidspunkt(laurdag), tp.sonetid_til_tidspunkt(sundag))), "PT23H")
    feil = feil + sjekk("+24 t", tp.sonetid_til_tekst(tp.sonetid_pluss_timar(laurdag, 24)), "2024-03-31T13:00+02:00[Europe/Oslo]")
    la haust = tp.sonetid_frå_tekst("2024-10-26T02:30+02:00[Europe/Oslo]")
    feil = feil + sjekk("+1 dag i overlapp held offset", tp.sonetid_til_tekst(tp.sonetid_pluss_dagar(haust, 1)), "2024-10-27T02:30+02:00[Europe/Oslo]")
    feil = feil + sjekk("+1 mnd", tp.sonetid_til_tekst(tp.sonetid_pluss_månader(tp.sonetid(2024, 1, 31, 9, 0, 0, "Europe/Oslo"), 1)), "2024-02-29T09:00+01:00[Europe/Oslo]")

    // Faste soner og UTC.
    feil = feil + sjekk("UTC", tp.sonetid_til_tekst(tp.sonetid_frå_tidspunkt(t, "UTC")), "2024-12-31T12:00Z[UTC]")
    feil = feil + sjekk("Z", tp.sonetid_til_tekst(tp.sonetid_frå_tidspunkt(t, "Z")), "2024-12-31T12:00Z")
    feil = feil + sjekk("+05:30", tp.sonetid_til_tekst(tp.sonetid_frå_tidspunkt(t, "+05:30")), "2024-12-31T17:30+05:30")
    feil = feil + sjekk("-03:00", tp.sonetid_til_tekst(tp.sonetid_frå_tidspunkt(t, "-03:00")), "2024-12-31T09:00-03:00")
    feil = feil + sjekk("+2", tp.sonetid_til_tekst(tp.sonetid_frå_tidspunkt(t, "+2")), "2024-12-31T14:00+02:00")
    feil = feil + sjekk("med sone", tp.sonetid_til_tekst(tp.sonetid_med_sone(z, "UTC")), "2024-12-31T12:00Z[UTC]")
    feil = feil + sjekk("offset -03:30", tp.offset_tekst(-12600), "-03:30")

    // Teksttolking.
    la p1 = tp.sonetid_frå_tekst("2024-10-27T02:30+01:00[Europe/Oslo]")
    feil = feil + sjekk("tolk overlapp +01", tp.tidspunkt_til_tekst(tp.sonetid_til_tidspunkt(p1)), "2024-10-27T01:30:00Z")
    feil = feil + sjekk("tolk overlapp +01 tekst", tp.sonetid_til_tekst(p1), "2024-10-27T02:30+01:00[Europe/Oslo]")
    feil = feil + sjekk("tolk sommar", tp.tidspunkt_til_tekst(tp.sonetid_til_tidspunkt(tp.sonetid_frå_tekst("2024-07-01T14:00+02:00[Europe/Oslo]"))), "2024-07-01T12:00:00Z")
    feil = feil + sjekk("tolk fast", tp.sonetid_til_tekst(tp.sonetid_frå_tekst("2024-07-01T14:00+02:00")), "2024-07-01T14:00+02:00")
    feil = feil + sjekk("tolk feil offset", tp.sonetid_til_tekst(tp.sonetid_frå_tekst("2024-07-01T14:00+01:00[Europe/Oslo]")), "2024-07-01T15:00+02:00[Europe/Oslo]")

    // Den 15. i kvar månad 2024 kl. 12 UTC: sommartid i april–oktober (7 månader).
    la m: heiltall = 1
    la sommar: tekst = ""
    mens m <= 12 {
        hvis tp.offset_i_sone("Europe/Oslo", tp.epoch_dag(2024, m, 15) * 86400 + 43200) == 7200 {
            sommar = sommar + "S"
        } ellers {
            sommar = sommar + "v"
        }
        m = m + 1
    }
    feil = feil + sjekk("sommarmånader 2024", sommar, "vvvSSSSSSSvv")
    returner feil
}

funksjon test_feil() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk_feil(1, "ugyldig dato 2023-02-29")
    feil = feil + sjekk_feil(2, "ugyldig dato 2024-02-30")
    feil = feil + sjekk_feil(3, "kan ikkje tolke")
    feil = feil + sjekk_feil(4, "ugyldig månad 13")
    feil = feil + sjekk_feil(5, "ugyldig time 24")
    feil = feil + sjekk_feil(6, "'T' utan")
    feil = feil + sjekk_feil(7, "venta 'P'")
    feil = feil + sjekk_feil(8, "uventa eining")
    feil = feil + sjekk_feil(9, "venta 'D'")
    feil = feil + sjekk_feil(10, "ukjend tidssone")
    feil = feil + sjekk_feil(11, "manglar offset")
    feil = feil + sjekk_feil(12, "meir enn 9 siffer")
    feil = feil + sjekk_feil(13, "venta Dato")
    returner feil
}

funksjon start() -> heiltall {
    la feil: heiltall = 0
    feil = feil + test_kalender()
    feil = feil + test_tidspunkt()
    feil = feil + test_varigheit()
    feil = feil + test_dato()
    feil = feil + test_datotid()
    feil = feil + test_sonetid()
    feil = feil + test_feil()
    skriv("test_tidspunkt: " + tekst(feil) + " feil\n")
    returner feil
}
