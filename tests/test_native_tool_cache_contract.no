bruk std.tekst som t
bruk std.runtime_filesystem som rfs

funksjon start() -> heiltall {
    la main = fil_les("selfhost/nc_main.no")
    la fs = fil_les("std/runtime_filesystem.no")

    assert(builtin.contains(main, "norscode-native-tool-cache-v4|ncb-v1|module-globals-v1|control-json-v1|selfhost-l5-20260802"))
    assert(builtin.contains(main, "funksjon nc_verktøy_fingeravtrykk"))
    assert(builtin.contains(main, "funksjon nc_verktøy_relativ_sti"))
    assert(builtin.contains(main, "FILE \" + nøkkelsti + \" \""))
    assert(builtin.contains(main, "builtin.sha256_bytes(builtin.fil_les_binær(fil))"))
    assert(ikkje builtin.contains(main, "\"\\n\" + kjelde + \"\\n\""))
    assert(builtin.contains(main, "builtin.sha256(materiale)"))
    assert(builtin.contains(main, "MODULE \" + modul"))
    assert(builtin.contains(main, "NORSCODE_NATIVE_TOOL_CACHE"))
    assert(builtin.contains(main, "NORSCODE_NATIVE_TOOL_CACHE_TRACE"))
    assert(builtin.contains(main, "build/cache/nc/native-tools/"))
    assert(builtin.contains(main, "native_fs.native_flush(ut)"))
    assert(builtin.contains(main, "native_fs.native_erstatt_fil_atomisk(root, tmp, relativ)"))
    assert(builtin.contains(main, "cache_fs_root = \"/\""))
    assert(builtin.contains(main, "cache_fs_relativ = builtin.slice(root, 1"))
    assert(builtin.contains(main, "nc_verktøy_cache_gyldig(cache_data)"))
    assert(builtin.contains(main, "builtin.contains(ncb_json, \"module_initializers\")"))
    assert(builtin.contains(main, "builtin.contains(ncb_json, \"global_names\")"))
    assert(builtin.contains(main, "builtin.contains(ncb_json, \"ncb-v1\")"))
    assert(builtin.contains(main, "ncb[\"entry\"] == null"))
    assert(builtin.contains(main, "returner nc_køyr_ncb_json_modus(nc_verktøy_ncb_cached"))
    assert(builtin.contains(main, "la ncb_json = normaliser_json_kontrollteikn("))
    assert(builtin.contains(main, "nc_verktøy_ncb_cached(src_sti, root, modul)"))

    assert(builtin.contains(fs, "\"operation\": \"file_replace\""))

    // Dei to siste sjekkane las C-implementasjonen av atomisk filerstatning:
    //     archive/legacy_c_backend/nc_native_main.c    → renameat(...)
    //     archive/legacy_c_backend/nc_windows_backend.c → MOVEFILE_REPLACE_EXISTING
    // Begge filene er sletta i Fase C.5, so dei kan ikkje grepast lenger. I
    // staden for å droppe dekninga testar vi no ÅTFERDA, som uansett er det
    // kontrakten handlar om — og som held uavhengig av kva språk backenden er
    // skriven i.
    la rot = tekst(builtin.system_info()["cwd"])
    la kat = "build/test-file-replace"
    prøv { builtin.mkdir_p(rot + "/" + kat) } fang (e) { }
    la kjelde = kat + "/ny.txt"
    la mål = kat + "/mål.txt"
    builtin.fil_skriv(rot + "/" + mål, "gammal")
    builtin.fil_skriv(rot + "/" + kjelde, "ny")
    la res = rfs.native_erstatt_fil_atomisk(rot, kjelde, mål)
    // ABI-en svarar «replaced» på ei vellukka erstatning, ikkje «ok».
    assert(tekst(res["status"]) == "replaced")
    // Målet skal ha innhaldet frå kjelda, og kjelda skal vere borte (flytta).
    assert(builtin.trim(fil_les(rot + "/" + mål)) == "ny")
    assert(ikkje builtin.fil_finnes(rot + "/" + kjelde))
    // Kontrakten avviser ugyldige argument i staden for å gjere noko halvvegs.
    assert(tekst(rfs.native_erstatt_fil_atomisk(rot, mål, mål)["status"]) == "feil")
    assert(tekst(rfs.native_erstatt_fil_atomisk("", kjelde, mål)["status"]) == "feil")

    skriv("test_native_tool_cache_contract OK")
    returner 0
}
