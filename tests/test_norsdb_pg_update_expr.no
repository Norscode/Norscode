// Postgres/SQLite: UPDATE ... SET col = <uttrykk> (aritmetikk, kolonne-ref, konkat).
// Alle RHS evaluerast mot dei GAMLE rad-verdiane (SQL-semantikk).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE t (id INTEGER, x INTEGER, y INTEGER, s TEXT)")
    sql.exec(db, "INSERT INTO t (id, x, y, s) VALUES (1, 10, 3, 'a')")
    sql.exec(db, "INSERT INTO t (id, x, y, s) VALUES (2, 20, 7, 'b')")

    // aritmetikk
    sql.exec(db, "UPDATE t SET x = x + 5 WHERE id = 1")
    assert_eq(sql.query_text(db, "SELECT x FROM t WHERE id = 1"), "15")

    // fleire SET, alle mot gamle verdiar: x=20*2=40, y=7+20(old x)=27
    sql.exec(db, "UPDATE t SET x = x * 2, y = y + x WHERE id = 2")
    assert_eq(sql.query_rader(db, "SELECT x, y FROM t WHERE id = 2"), "40|27")

    // streng-konkat
    sql.exec(db, "UPDATE t SET s = s || '!' WHERE id = 1")
    assert_eq(sql.query_text(db, "SELECT s FROM t WHERE id = 1"), "a!")

    // literal held fram å virke
    sql.exec(db, "UPDATE t SET s = 'z' WHERE id = 2")
    assert_eq(sql.query_text(db, "SELECT s FROM t WHERE id = 2"), "z")

    // NULL
    sql.exec(db, "UPDATE t SET s = NULL WHERE id = 1")
    assert_eq(sql.query_text(db, "SELECT s FROM t WHERE id = 1"), "")

    returner 0
}
