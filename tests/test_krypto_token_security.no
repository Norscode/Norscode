bruk std.krypto som krypto
bruk std.base64 som base64

funksjon berre(s: tekst, alfabet: tekst) -> boolsk {
    la i = 0
    mens i < lengde(s) {
        hvis builtin.index_of(alfabet, builtin.slice(s, i, i + 1)) < 0 { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    la h = krypto.token(32)
    assert_eq(lengde(h), 64)
    assert(berre(h, "0123456789abcdefABCDEF"))
    assert_eq(krypto.token(0), "")
    assert_eq(krypto.token_url(0), "")
    assert_eq(krypto.token_sifre(0), "")
    for n i [1, 2, 3, 16, 32] {
        la url = krypto.token_url(n)
        assert_eq(lengde(url), (n * 8 + 5) / 6)
        assert(berre(url, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"))
        la b64 = builtin.replace(builtin.replace(url, "-", "+"), "_", "/")
        mens lengde(b64) % 4 != 0 { b64 = b64 + "=" }
        assert_eq(lengde(base64.dekod_bytes(b64)), n)
    }
    for n i [1, 6, 32, 128] {
        la kode = krypto.token_sifre(n)
        assert_eq(lengde(kode), n)
        assert(berre(kode, "0123456789"))
    }
    la id = krypto.uuid4()
    assert(krypto.er_gyldig_uuid(id))
    assert_eq(builtin.slice(id, 14, 15), "4")
    assert(berre(builtin.slice(id, 19, 20), "89ab"))
    la feil = 0
    prøv { krypto.token(-1) } fang (e) { feil = feil + 1 }
    prøv { krypto.token_url(-1) } fang (e) { feil = feil + 1 }
    prøv { krypto.token_sifre(-1) } fang (e) { feil = feil + 1 }
    assert_eq(feil, 3)
    skriv("test_krypto_token_security OK\n")
    returner 0
}
