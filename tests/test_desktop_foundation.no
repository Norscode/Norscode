# Røyk- og grenseverditest for ren Norscode desktop-grunnmur
bruk std.desktop som d
bruk std.desktop_text som t

la a = d.ny_skrivebordsapp("Studio")
hvis a["desktop.native_ready"] != "usann" { kast "native status feil" }
hvis ikkje d.opprett_vindu(a, "hoved", "Studio", 1200, 800) { kast "vindu" }
hvis d.opprett_vindu(a, "for_lite", "Feil", 1, 1) { kast "vindusgrense" }
hvis ikkje d.ny_komponent(a, "hoved", "editor", "tekstfelt", "Hei") { kast "komponent" }
hvis d.ny_komponent(a, "hoved", "editor", "tekstfelt", "Duplikat") { kast "duplikat" }
hvis ikkje d.aktiver(a, "editor") { kast "fokus" }
hvis ikkje d.tastatur_event(a, "editor", "Enter", "Cmd") { kast "tastatur" }
hvis d.mus_event(a, "editor", "bad", 0, 0) { kast "musvalidering" }
hvis lengde(d.tilgjengelegheit(a, "hoved")) != 1 { kast "a11y" }
hvis builtin.index_of(d.render_headless(a, "hoved"), "editor") < 0 { kast "render" }

la b = t.ny_buffer("main.no", "Hei\nverden")
hvis t.linje_antall(b) != 2 { kast "linjer" }
hvis ikkje t.erstatt_område(b, 0, 3, "Hallo") { kast "erstatt" }
hvis b["text"] != "Hallo\nverden" eller b["dirty"] != "sann" { kast "buffer" }
hvis t.erstatt_område(b, -1, 2, "x") { kast "negativ indeks" }
hvis t.erstatt_område(b, 3, 999, "x") { kast "stor indeks" }
t.sett_lagret(b)
hvis b["dirty"] != "usann" { kast "lagring" }
skriv("desktop foundation OK")
