bruk std.js_tal som jst

funksjon start() -> heiltall {
    # ekte divisjon (JS /)
    assert_eq(tekst(jst.del(7, 2)), "3.5")
    assert_eq(tekst(jst.del(6, 3)), "2")

    # trunc / floor / ceil / round
    assert_eq(jst.trunker(3.9), 3)
    assert_eq(jst.trunker(0.0 - 3.9), 0 - 3)
    assert_eq(jst.golv(3.9), 3)
    assert_eq(jst.golv(0.0 - 3.9), 0 - 4)
    assert_eq(jst.golv(3), 3)
    assert_eq(jst.tak(3.1), 4)
    assert_eq(jst.tak(0.0 - 3.1), 0 - 3)
    assert_eq(jst.tak(4), 4)
    assert_eq(jst.rund(2.5), 3)
    assert_eq(jst.rund(2.4), 2)
    assert_eq(jst.rund(0.0 - 2.5), 0 - 2)

    # abs / sign
    assert_eq(tekst(jst.absolutt(0.0 - 2.5)), "2.5")
    assert_eq(jst.signum(0.0 - 7), 0 - 1)
    assert_eq(jst.signum(0), 0)
    assert_eq(jst.signum(7), 1)

    # min / max
    assert_eq(tekst(jst.min(2, 3.5)), "2")
    assert_eq(tekst(jst.maks(2, 3.5)), "3.5")
    assert_eq(tekst(jst.min_av([4, 2, 9])), "2")
    assert_eq(tekst(jst.maks_av([4, 2, 9])), "9")

    # pow / sqrt
    assert_eq(tekst(jst.potens(2, 10)), "1024")
    assert_eq(tekst(jst.potens(2, 0 - 2)), "0.25")
    assert_eq(tekst(jst.kvadratrot(9)), "3")
    assert_eq(jst.til_fast(jst.kvadratrot(2), 4), "1.4142")

    # toFixed
    assert_eq(jst.til_fast(3.14159, 2), "3.14")
    assert_eq(jst.til_fast(2.5, 0), "3")
    assert_eq(jst.til_fast(1, 3), "1.000")
    assert_eq(jst.til_fast(0.0 - 1.25, 1), "-1.3")
    assert_eq(jst.til_fast(1.005, 2), "1.01")

    # parseInt / parseFloat
    assert_eq(jst.parse_heltall("42x"), 42)
    assert_eq(jst.parse_heltall("  -7 "), 0 - 7)
    assert_eq(jst.parse_heltall("3.9"), 3)
    assert_eq(jst.parse_heltall("abc"), 0)
    assert_eq(jst.parse_heltall_eller("abc", 0 - 1), 0 - 1)
    assert_eq(tekst(jst.parse_desimal("3.75kr")), "3.75")
    assert_eq(tekst(jst.parse_desimal("abc")), "0")

    # er_talstreng / er_heiltal
    assert(jst.er_talstreng("3.75"))
    assert(jst.er_talstreng("-42"))
    assert(jst.er_talstreng("+3"))
    assert(jst.er_talstreng(" 3 "))
    assert(ikkje jst.er_talstreng("+"))
    assert(ikkje jst.er_talstreng("3.75kr"))
    assert(ikkje jst.er_talstreng(""))
    assert(jst.er_heiltal(4))
    assert(ikkje jst.er_heiltal(4.5))

    skriv("test_js_tal OK\n")
    returner 0
}
