funksjon start() -> heiltall {
    la pure_vm: boolsk = usann
    prøv {
        builtin.vm_memory_status()
        pure_vm = sann
    } fang (e) {
    }
    hvis ikkje pure_vm {
        skriv("test_vm_dynamic_loader OK")
        returner 0
    }

    la first = builtin.vm_module_load("build/vm_plugin_v1.ncb.json", "demo", "")
    assert_eq(first["generation"], tekst_fra_heltall(1))
    assert_eq(first["entry"], "demo.start")
    assert_eq(builtin.ncb_call_fn("demo.svar"), "v1")

    la second = builtin.vm_module_reload("build/vm_plugin_v2.ncb.json", "demo", "")
    assert_eq(second["generation"], tekst_fra_heltall(2))
    assert_eq(builtin.ncb_call_fn("demo.svar"), "v2")

    la dependency_nekt: tekst = ""
    prøv {
        builtin.vm_module_load("build/vm_plugin_v1.ncb.json", "child_early", "", "base")
        assert(usann)
    } fang (e) {
        dependency_nekt = e
    }
    assert(lengde(dependency_nekt) > 0)
    builtin.vm_module_load("build/vm_plugin_v1.ncb.json", "base", "", "")
    builtin.vm_module_load("build/vm_plugin_v1.ncb.json", "child", "", "base")
    assert_eq(builtin.ncb_call_fn("child.svar"), "v1")

    la metrics = builtin.vm_runtime_metrics()
    assert(metrics["module_loads"] != metrics["module_reloads"])

    skriv("test_vm_dynamic_loader OK")
    returner 0
}
