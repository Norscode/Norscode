bruk std.fileinput som fi

funksjon start() -> heiltall {
    la sti = "build/fileinput-native-backup.txt"
    la backup = sti + ".bak"
    prøv { builtin.fil_slett(sti) } fang (e) { }
    prøv { builtin.fil_slett(backup) } fang (e) { }

    builtin.fil_skriv(sti, "første\nandre\n")
    la state = fi.input_ein(sti)
    fi.start_inplace(state, ".bak")

    assert(builtin.fil_les(backup) == "første\nandre\n")
    assert(builtin.fil_les(sti) == "")

    builtin.fil_slett(sti)
    builtin.fil_slett(backup)
    skriv("test_fileinput_native_backup OK")
    returner 0
}
