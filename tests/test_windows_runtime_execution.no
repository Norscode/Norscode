bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la src = builtin.fil_les("tools/windows_runtime_execution_gate.no")
    assert(builtin.contains(src, "bruk tools.process_runner som prosess"))
    assert(builtin.contains(src, "prosess.køyr(sti, [], root, {}, 120000)"))
    assert(ikkje builtin.contains(src, "exec_prosess("))
    assert(ikkje builtin.contains(src, "uname -s"))
    la root = tekst(builtin.system_info()["cwd"])
    la res = prosess.køyr(root + "/bin/nc",
        ["run", root + "/tools/windows_runtime_execution_gate.no"],
        root, {"NORSCODE_ROOT": root}, 300000)
    hvis builtin.contains(tekst(res["stdout"]), "krev faktisk Windows-host") {
        assert_eq(tekst(res["exit_code"]), "2")
    } ellers {
        assert(prosess.ok(res))
        assert_inneholder(tekst(res["stdout"]), "Windows runtime execution-gate er grøn")
    }
    skriv("test_windows_runtime_execution OK")
    returner 0
}
