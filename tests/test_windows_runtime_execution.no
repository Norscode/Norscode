bruk tests.test_windows_process_appcontainer som appcontainer

funksjon start() -> heiltall {
    la miljø = appcontainer.barn_miljø("D:/Norscode", "ok", "C:/Windows", "C:/Users/test/AppData/Local")
    assert_eq(miljø["SystemRoot"], "C:/Windows")
    assert_eq(miljø["LOCALAPPDATA"], "C:/Users/test/AppData/Local")
    assert_eq(miljø["NORSCODE_WINDOWS_CHILD_MODE"], "ok")
    assert_eq(miljø["NORSCODE_FILE"], "D:/Norscode/tests/fixtures/windows_process_child.no")
    assert_eq(lengde(nøkler(miljø)), 10)
    assert(ikkje finnes_nøkkel(miljø, "GITHUB_ACTIONS"))
    assert(ikkje finnes_nøkkel(miljø, "GITHUB_TOKEN"))
    la src = builtin.fil_les("tests/test_windows_process_appcontainer.no")
    assert(builtin.contains(src, "bruk std.runtime.process_abi som abi"))
    assert(builtin.contains(src, "builtin.process_spawn_argv(req)"))
    assert(builtin.contains(src, "appcontainer+job-object"))
    assert(builtin.contains(src, "job-object"))
    assert(ikkje builtin.contains(src, "exec_prosess("))
    assert(ikkje builtin.contains(src, "uname -s"))
    skriv("test_windows_runtime_execution OK")
    returner 0
}
