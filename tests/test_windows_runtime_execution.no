funksjon start() -> heiltall {
    la src = builtin.fil_les("tests/test_windows_process_appcontainer.no")
    assert(builtin.contains(src, "bruk std.runtime.process_abi som abi"))
    assert(builtin.contains(src, "builtin.process_spawn_argv(req)"))
    assert(builtin.contains(src, "appcontainer+job-object"))
    assert(builtin.contains(src, "job-object"))
    assert(ikkje builtin.contains(src, "exec_prosess("))
    assert(ikkje builtin.contains(src, "uname -s"))
    skriv("test_windows_runtime_execution OK")
    returner 0
}
