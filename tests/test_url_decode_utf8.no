bruk std.url som url

funksjon start() -> heiltall {
    # Prosentkoda UTF-8 skal dekodast, både med store og små hex-siffer
    assert_eq(url.url_decode("k%C3%A6re"), "kære")
    assert_eq(url.url_decode("k%c3%a6re"), "kære")
    assert_eq(url.url_decode("%C3%B8y"), "øy")
    assert_eq(url.url_decode("%E2%82%AC"), "€")

    # ASCII og skiljeteikn
    assert_eq(url.url_decode("a%20b"), "a b")
    assert_eq(url.url_decode("a%2Fb"), "a/b")
    assert_eq(url.url_decode("hei+der"), "hei der")
    assert_eq(url.url_decode("rein tekst"), "rein tekst")

    # Ugyldige escapes skal ikkje øydeleggje teksten
    assert_eq(url.url_decode("100%"), "100%")
    assert_eq(url.url_decode("a%zzb"), "a%zzb")

    # Rundtur gjennom encode
    assert_eq(url.url_decode(url.url_encode("kære øl & vin")), "kære øl & vin")

    # Query-verdiar må dekodast eksplisitt
    la q = url.url_parse_query("sok=k%C3%A6re&side=2")
    assert_eq(url.url_decode(q["sok"]), "kære")
    assert_eq(q["side"], "2")

    skriv("test_url_decode_utf8 OK\n")
    returner 0
}
