// Integritet (same byte som seed) kan ikkje erstatte faktisk køyrbarheit.
bruk tools.build_norscode_native som bygg

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la probe = root + "/build/seed_smoke_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(probe + "/bootstrap/stage0")
    la kandidat = probe + "/ikkje_ein_runtime"
    // To identiske, medvite ugyldige executable-filer i eit eige testområde.
    // Ingen fungerande runtime eller seed blir erstatta av denne fixturen.
    builtin.fil_skriv(kandidat, "ikkje ein gyldig native executable\n")
    builtin.fil_skriv(bygg.stage0_seed_path(probe), "ikkje ein gyldig native executable\n")
    assert(builtin.fil_sett_kjorbar(kandidat))
    assert(bygg.same_bytes_as_stage0_seed(probe, kandidat))
    la før_ci = miljo_hent("CI")
    la før_smoke = miljo_hent("NORSCODE_REQUIRE_SMOKE")
    miljo_sett("NORSCODE_REQUIRE_SMOKE", "1")
    miljo_sett("CI", "")
    assert(ikkje bygg.smoke_check(probe, kandidat))
    miljo_sett("CI", "1")
    assert(ikkje bygg.smoke_check(probe, kandidat))
    // Den kontrollerte, ekte runtimen er den positive kontrollen.
    assert(bygg.smoke_check(root, root + "/dist/norscode_native"))
    miljo_sett("CI", før_ci)
    miljo_sett("NORSCODE_REQUIRE_SMOKE", før_smoke)
    skriv("test_bootstrap_smoke_failclosed OK\n")
    returner 0
}
