bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la functions: ordbok<tekst, tekst> = {}
    functions["std.text_model_bundle.kod"] = "fyrste fuzzy kollisjon"
    la i: heiltall = 0
    mens i < 2048 {
        functions["fixture.module" + tekst_fra_heltall(i) + ".fn"] = "x"
        i = i + 1
    }
    functions["std.tokenizer.kod"] = "eksakt mål"
    assert(vm.vm_map_get(functions, "std.tokenizer.kod") == "eksakt mål")
    assert(vm.finn_funksjon("std.tokenizer.kod", functions) == "std.tokenizer.kod")
    assert(vm.finn_funksjon("builtin.lengde", functions) == "")
    assert(vm.finn_funksjon("manglar.kod", functions) == "std.text_model_bundle.kod")
    skriv("test_vm_exact_function_lookup_before_fuzzy OK\n")
    returner 0
}
