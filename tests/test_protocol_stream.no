bruk std.protocol_stream som stream

funksjon start() -> heiltall {
    assert(stream.dialog("", 0, usann, "", 100, 100) == "")
    # HTTPS-front kallar les_chunk(..., 1048576); socketen sin native
    # read-ABI tillèt berre 65536 om gongen. Beskytt denne kontrakten.
    assert_eq(stream._native_chunk_maks(1), 1)
    assert_eq(stream._native_chunk_maks(16384), 16384)
    assert_eq(stream._native_chunk_maks(65536), 65536)
    assert_eq(stream._native_chunk_maks(65537), 65536)
    assert_eq(stream._native_chunk_maks(1048576), 65536)
    skriv("test_protocol_stream OK")
    returner 0
}
