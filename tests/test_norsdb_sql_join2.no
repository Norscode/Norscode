// Fase 4: JOIN-utvidingar — reversert ON + JOIN+GROUP(+HAVING). Golden = sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE ans (id INTEGER, navn TEXT, avd TEXT)")
    sql.exec(db, "INSERT INTO ans (id, navn, avd) VALUES (1, 'Ada', 'Tech')")
    sql.exec(db, "INSERT INTO ans (id, navn, avd) VALUES (2, 'Linus', 'Tech')")
    sql.exec(db, "INSERT INTO ans (id, navn, avd) VALUES (3, 'Bjørn', 'Salg')")
    sql.exec(db, "INSERT INTO ans (id, navn, avd) VALUES (4, 'Alan', 'Tech')")
    sql.exec(db, "INSERT INTO ans (id, navn, avd) VALUES (5, 'Eve', 'Salg')")
    sql.exec(db, "CREATE TABLE avd (kode TEXT, byen TEXT)")
    sql.exec(db, "INSERT INTO avd (kode, byen) VALUES ('Tech', 'Oslo')")
    sql.exec(db, "INSERT INTO avd (kode, byen) VALUES ('Salg', 'Bergen')")

    // Reversert ON (høgre tabell til venstre for "=")
    assert_eq(sql.query_rader(db, "SELECT ans.navn, avd.byen FROM ans JOIN avd ON avd.kode = ans.avd ORDER BY ans.navn"), "Ada|Oslo\nAlan|Oslo\nBjørn|Bergen\nEve|Bergen\nLinus|Oslo")

    // JOIN + GROUP BY (kvalifisert) + ORDER
    assert_eq(sql.query_rader(db, "SELECT avd.byen, COUNT(*) FROM ans JOIN avd ON ans.avd = avd.kode GROUP BY avd.byen ORDER BY avd.byen"), "Bergen|2\nOslo|3")

    // JOIN + GROUP + HAVING
    assert_eq(sql.query_rader(db, "SELECT avd.byen, COUNT(*) FROM ans JOIN avd ON ans.avd = avd.kode GROUP BY avd.byen HAVING COUNT(*) >= 3"), "Oslo|3")

    returner 0
}
