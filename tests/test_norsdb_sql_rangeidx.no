// Ytelse: range-indeks. `CREATE INDEX` brukt for >, <, >=, <=, BETWEEN (ikkje berre =).
// Testar KORREKTHET — indeks-stien gjev nøyaktig same svar som full skann.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE ans (id INTEGER, navn TEXT, lonn INTEGER)")
    sql.exec(db, "INSERT INTO ans (id, navn, lonn) VALUES (1, 'Ada', 700)")
    sql.exec(db, "INSERT INTO ans (id, navn, lonn) VALUES (2, 'Linus', 900)")
    sql.exec(db, "INSERT INTO ans (id, navn, lonn) VALUES (3, 'Bjørn', 500)")
    sql.exec(db, "INSERT INTO ans (id, navn, lonn) VALUES (4, 'Alan', -100)")
    sql.exec(db, "INSERT INTO ans (id, navn, lonn) VALUES (5, 'Eve', 500)")

    sql.exec(db, "CREATE INDEX idx_lonn ON ans (lonn)")

    // Range via indeks
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn > 600"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn < 500"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn >= 500"), 4)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn BETWEEN 400 AND 800"), 3)
    assert_eq(sql.query_rader(db, "SELECT navn FROM ans WHERE lonn > 600 ORDER BY lonn DESC"), "Linus\nAda")

    // Equality via indeks framleis korrekt (fleire rader per verdi)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn = 500"), 2)
    assert_eq(sql.query_rader(db, "SELECT navn FROM ans WHERE lonn = 500 ORDER BY navn"), "Bjørn\nEve")

    returner 0
}
