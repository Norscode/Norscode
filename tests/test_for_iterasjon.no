# M10 — for-løkke over ordbok skal iterere nøklane (som `for k in dict`), medan
# liste og tekst held den gamle åtferda. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon kør(kjelde: tekst) -> heltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner vm.køyr_ncb(ncb)
}

funksjon start() -> heiltall {
    # ── for over ordbok gir nøklane; vi summerer verdiane via oppslag ─────────
    la prog_map = "funksjon start() -> heltall {\n" +
        "    la m: ordbok_heltall = {}\n" +
        "    m[\"a\"] = 10\n" +
        "    m[\"b\"] = 20\n" +
        "    m[\"c\"] = 30\n" +
        "    la sum: heltall = 0\n" +
        "    for k i m {\n" +
        "        sum = sum + m[k]\n" +
        "    }\n" +
        "    returner sum\n" +
        "}\n"
    assert_eq(kør(prog_map), 60)

    # ── for over liste er uendra ──────────────────────────────────────────────
    la prog_liste = "funksjon start() -> heltall {\n" +
        "    la sum: heltall = 0\n" +
        "    for x i [1, 2, 3, 4] {\n" +
        "        sum = sum + x\n" +
        "    }\n" +
        "    returner sum\n" +
        "}\n"
    assert_eq(kør(prog_liste), 10)

    # ── for over tekst itererer teikn (uendra) ────────────────────────────────
    la prog_tekst = "funksjon start() -> heltall {\n" +
        "    la n: heltall = 0\n" +
        "    for c i \"abcd\" {\n" +
        "        n = n + 1\n" +
        "    }\n" +
        "    returner n\n" +
        "}\n"
    assert_eq(kør(prog_tekst), 4)

    # ── tom ordbok: null iterasjonar ──────────────────────────────────────────
    la prog_tom = "funksjon start() -> heltall {\n" +
        "    la m: ordbok_heltall = {}\n" +
        "    la n: heltall = 0\n" +
        "    for k i m {\n" +
        "        n = n + 1\n" +
        "    }\n" +
        "    returner n\n" +
        "}\n"
    assert_eq(kør(prog_tom), 0)

    skriv("test_for_iterasjon OK\n")
    returner 0
}
