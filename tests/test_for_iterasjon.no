# M10 — for-løkke over liste og tekst. Codegen er byte-identisk med seeden
# (ingen ekstra opcode), slik at sjølvhostings-fixpunktet Gen1==Gen2 held.
# For-løkke over ordbok-nøklar går via std.iterator.frå_ordbok (sjå
# tests/test_generator.no), ikkje via ei codegen-endring. Køyrer gjennom
# KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon kør(kjelde: tekst) -> heltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner vm.køyr_ncb(ncb)
}

funksjon start() -> heiltall {
    # ── for over liste ────────────────────────────────────────────────────────
    la prog_liste = "funksjon start() -> heltall {\n" +
        "    la sum: heltall = 0\n" +
        "    for x i [1, 2, 3, 4] {\n" +
        "        sum = sum + x\n" +
        "    }\n" +
        "    returner sum\n" +
        "}\n"
    assert_eq(kør(prog_liste), 10)

    # ── for over tekst itererer teikn ─────────────────────────────────────────
    la prog_tekst = "funksjon start() -> heltall {\n" +
        "    la n: heltall = 0\n" +
        "    for c i \"abcd\" {\n" +
        "        n = n + 1\n" +
        "    }\n" +
        "    returner n\n" +
        "}\n"
    assert_eq(kør(prog_tekst), 4)

    # ── tom liste: null iterasjonar ───────────────────────────────────────────
    la prog_tom = "funksjon start() -> heltall {\n" +
        "    la xs: liste_heltall = []\n" +
        "    la n: heltall = 0\n" +
        "    for x i xs {\n" +
        "        n = n + 1\n" +
        "    }\n" +
        "    returner n\n" +
        "}\n"
    assert_eq(kør(prog_tom), 0)

    skriv("test_for_iterasjon OK\n")
    returner 0
}
