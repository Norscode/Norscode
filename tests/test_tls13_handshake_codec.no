# TLS 1.3 handshake-meldingskodek (RFC 8446 §4).
# Eksternt anker: parsar RFC 8448 ClientHello/ServerHello og les ut felta korrekt.
bruk std.tls13_handshake som hs
funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
funksjon _hex(b: liste_heiltall) -> tekst { la ut = "" la i = 0 mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 } returner ut }
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon start() -> heiltall {
    # RFC 8448 ClientHello (196 oktettar) - komplett handshake-melding.
    la ch = _b("010000c00303cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7000006130113031302010000910000000b0009000006736572766572ff01000100000a00140012001d0017001800190100010101020103010400230000003300260024001d0020" + "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c" + "002b0003020304000d0020001e0403050306030203080408050806040105010601020104020502060202020" + "02d00020101001c00024001")
    la ph = hs.parse_handshake(ch, 0)
    assert_eq(ph["ok"], sann)
    assert_eq(ph["type"], hs.HT_CLIENT_HELLO())
    la c = hs.parse_client_hello(ch, ph["start"], ph["end"])
    assert_eq(c["version"], 771)                       # 0x0303
    assert_eq(c["server_name"], "server")
    # klientens x25519 offentlege nøkkel (RFC 8448)
    assert_eq(_hex(c["key_share_pub"]), "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c")
    # cipher_suites inneheld 0x1301 0x1303 0x1302
    assert_eq(lengde(c["suites"]), 3)
    assert_eq(c["suites"][0], 4865)

    # RFC 8448 ServerHello (90 oktettar).
    la sh = _b("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020" + "c982887611209" + "5fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f" + "002b00020304")
    la psh = hs.parse_handshake(sh, 0)
    assert_eq(psh["type"], hs.HT_SERVER_HELLO())
    la s = hs.parse_server_hello(sh, psh["start"], psh["end"])
    assert_eq(s["suite"], 4865)                        # 0x1301 (RFC 8448 brukar AES-GCM)
    assert_eq(s["valgt_versjon"], 772)                 # 0x0304
    assert_eq(_hex(s["key_share_pub"]), "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f")

    # Rundtur på våre eigne byggjarar (suite = ChaCha20-Poly1305).
    la rnd: liste_heiltall = []
    la i = 0
    mens i < 32 { legg_til(rnd, i) i = i + 1 }
    la pub: liste_heiltall = []
    i = 0
    mens i < 32 { legg_til(pub, 255 - i) i = i + 1 }
    la mCH = hs.build_client_hello({"random": rnd, "session_id": [], "key_share_pub": pub, "server_name": "example.no"})
    la q = hs.parse_handshake(mCH, 0)
    la cc = hs.parse_client_hello(mCH, q["start"], q["end"])
    assert_eq(cc["server_name"], "example.no")
    assert_eq(_hex(cc["key_share_pub"]), _hex(pub))
    assert_eq(cc["suites"][0], hs.SUITE_CHACHA20())

    la mSH = hs.build_server_hello({"random": rnd, "session_id": [], "key_share_pub": pub})
    la r2 = hs.parse_handshake(mSH, 0)
    la ss = hs.parse_server_hello(mSH, r2["start"], r2["end"])
    assert_eq(ss["suite"], hs.SUITE_CHACHA20())
    assert_eq(ss["valgt_versjon"], 772)
    assert_eq(_hex(ss["key_share_pub"]), _hex(pub))

    # Certificate / CertificateVerify / Finished rundtur.
    la der = _b("30820102aabbccdd")
    la mCert = hs.build_certificate(der)
    la rc = hs.parse_handshake(mCert, 0)
    assert_eq(rc["type"], hs.HT_CERTIFICATE())
    la cert = hs.parse_certificate(mCert, rc["start"], rc["end"])
    assert_eq(_hex(cert["cert_der"]), _hex(der))

    la sig: liste_heiltall = []
    i = 0
    mens i < 64 { legg_til(sig, (i * 3) & 255) i = i + 1 }
    la mCV = hs.build_certificate_verify(hs.SIG_ED25519(), sig)
    la rcv = hs.parse_handshake(mCV, 0)
    la cv = hs.parse_certificate_verify(mCV, rcv["start"], rcv["end"])
    assert_eq(cv["alg"], hs.SIG_ED25519())
    assert_eq(_hex(cv["signatur"]), _hex(sig))

    la vd: liste_heiltall = []
    i = 0
    mens i < 32 { legg_til(vd, (i + 7) & 255) i = i + 1 }
    la mFin = hs.build_finished(vd)
    la rf = hs.parse_handshake(mFin, 0)
    assert_eq(rf["type"], hs.HT_FINISHED())
    la fin = hs.parse_finished(mFin, rf["start"], rf["end"])
    assert_eq(_hex(fin["verify_data"]), _hex(vd))

    assert_eq(hs.status()["abi"], "norscode-tls13-handshake-v1")
    skriv("test_tls13_handshake_codec OK")
    returner 0
}
