// Prosessgrensa er sjølve regresjonsvernet: ei ny opning i den gamle prosessen
// kan ikkje erstatte ein fersk lesar etter at skrivaren har avslutta utan commit.
bruk tools.process_runner som prosess
bruk std.filops som filops

funksjon barn(root: tekst, runtime: tekst, sti: tekst, modus: tekst, kode: heiltall) {
    la fil = root + "/tests/fixtures/norsdb_tx_prosess.no"
    la miljø = {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run", "NORSCODE_FILE": fil,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_TARGET_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_VM_TARGET_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSDB_TX_PATH": sti, "NORSDB_TX_CASE": modus
    }
    la r = prosess.køyr(runtime, ["run", fil], root, miljø, 120000)
    hvis tekst(r["status"]) != "ferdig" eller heiltall_fra_tekst(tekst(r["exit_code"])) != kode {
        prosess.skriv_resultat(r)
        kast "NorsDB-barneprosess feila: " + modus + " status=" + tekst(r["status"]) + " exit=" + tekst(r["exit_code"])
    }
    assert(builtin.contains(tekst(r["stdout"]), "norsdb-child: " + modus))
}

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la runtime = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la dir = root + "/build/norsdb-tx-prosess-" + builtin.random_hex(8)
    assert(filops.lag_katalogar(dir))
    barn(root, runtime, dir + "/seed", "seed", 0)
    la base = builtin.fil_les(dir + "/seed.cp")
    for modus i ["leave", "rollback", "close", "commit-wal", "commit"] {
        la sti = dir + "/" + modus
        hvis modus != "leave" { builtin.fil_skriv(sti + ".cp", base) }
        la kode = 0
        hvis modus == "leave" { kode = 23 }
        barn(root, runtime, sti, modus, kode)
        hvis modus == "leave" { assert(ikke builtin.fil_finnes(sti + ".cp")) }
        la lesar = "read-original"
        hvis modus == "commit-wal" eller modus == "commit" { lesar = "read-committed" }
        barn(root, runtime, sti, lesar, 0)
    }
    skriv("test_norsdb_tx_prosess OK (11 separate prosessar)\n")
    returner 0
}
