bruk std.ws som ws

// WebSocket-handshake (RFC 6455) ende-til-ende gjennom std.ws.
//
// Tidlegare var handshaket ikkje-funksjonelt: det bygde på ein native
// builtin.sha1 som ikkje finst, med ein feil base64-fallback. No brukar
// std.ws rein pure-VM SHA-1 (std.sha1) + rein base64 (std.base64).
// Denne testen låser den kanoniske RFC 6455-vektoren.

funksjon start() -> heiltall {
    // RFC 6455 §1.3: sec-websocket-key "dGhlIHNhbXBsZSBub25jZQ=="
    // gir Sec-WebSocket-Accept "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=".
    la ctx: ordbok_tekst = {}
    ctx["sec-websocket-key"] = "dGhlIHNhbXBsZSBub25jZQ=="
    la r = ws.handshake_respons(ctx)
    la h = r["headers"]

    assert(r["status"] == "101")
    assert(h["sec-websocket-accept"] == "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
    assert(h["upgrade"] == "websocket")
    assert(h["connection"] == "Upgrade")
    assert(h["sec-websocket-version"] == "13")

    skriv("test_ws_handshake_rfc6455: OK (5 assertar)\n")
    returner 0
}
