// KJENT AVVIK (A0 app-kjensle, docs/APP_KJENSLE.md): VM-spegelen av web-laget i
// selfhost/vm.no ligg i nc_main-lukkinga og kan ikkje rettast utan reseed (R1).
// Han blir berre nådd når programmet kallar builtin.web.* UTAN å importere
// std.web (med std.web blir namnet løyst til std/web.no, sjå test_web_cors).
// Der speglar vm_web_finalize_response framleis Origin med credentials, og
// builtin.web.request_header skil mellom store og små bokstavar.
// Denne testen pinnar avviket. Når R1 rettar vm.no, blir han raud: snu
// påstandane då og fjern avviket frå docs/APP_KJENSLE.md.
// Medvite: ingen «bruk std.web» her.

funksjon start() -> heiltall {
    la h: ordbok_tekst = {}
    h["origin"] = "https://evil.example"
    h["cookie"] = "session=abc"
    la ctx: ordbok_tekst = {}
    ctx["__method__"] = "GET"
    ctx["__path__"] = "/finst-ikkje"
    ctx["__headers__"] = h
    ctx["__query__"] = {}
    ctx["__body__"] = ""
    la r: ordbok_tekst = {}
    prøv {
        r = builtin.web.handle_request(ctx)
    } fang (e) {
        // Runtime utan VM-spegelen: avviket finst ikkje der.
        skriv("test_web_vm_spegel_kjent_avvik OK (runtime utan builtin.web.handle_request: " + tekst(e) + ")\n")
        returner 0
    }
    la hs = r["__headers__"]
    la acao = ""
    la acac = ""
    hvis hs != null og finnes_nøkkel(hs, "access-control-allow-origin") { acao = tekst(hs["access-control-allow-origin"]) }
    hvis hs != null og finnes_nøkkel(hs, "access-control-allow-credentials") { acac = tekst(hs["access-control-allow-credentials"]) }
    hvis acao != "https://evil.example" eller acac != "true" {
        skriv("KJENT AVVIK ENDRA: VM-spegelen speglar ikkje lenger Origin (acao=[" + acao + "] acac=[" + acac + "]). Oppdater docs/APP_KJENSLE.md og snu denne testen.\n")
    }
    assert_eq(acao, "https://evil.example")
    assert_eq(acac, "true")

    la h2: ordbok_tekst = {}
    h2["Cookie"] = "nc_demo=ja"
    la ctx2: ordbok_tekst = {}
    ctx2["__headers__"] = h2
    la v = builtin.web.request_header(ctx2, "cookie")
    hvis v != "" {
        skriv("KJENT AVVIK ENDRA: builtin.web.request_header er no kasus-uavhengig (fekk [" + v + "]). Oppdater docs/APP_KJENSLE.md og snu denne testen.\n")
    }
    assert_eq(v, "")
    // Kontroll på at oppslaget verkar i det heile (elles ville tom tekst over
    // ikkje bety noko): eksakt nøkkel gjev verdien.
    assert_eq(builtin.web.request_header(ctx2, "Cookie"), "nc_demo=ja")
    skriv("test_web_vm_spegel_kjent_avvik OK\n")
    returner 0
}
