bruk std.runtime.process_abi som abi

funksjon start() -> heiltall {
    la req = abi.request("/usr/bin/printf", ["a b", ";", "$HOME"], "", "", 5000, 4096)
    assert_eq(req["abi"], "norscode-process-spawn-v1")
    assert(abi.gyldig_request(req))
    assert_eq(req["args"][0], "a b")
    assert_eq(req["args"][1], ";")
    assert_eq(req["args"][2], "$HOME")
    abi.sett_capture(req, "usann", "sann")
    assert_eq(req["capture_stdout"], "usann")
    assert_eq(req["capture_stderr"], "sann")
    assert(abi.gyldig_request(req))
    abi.sett_capture(req, "sann", "sann")
    assert(ikkje abi.gyldig_request(abi.request("", [], "", "", 1, 1)))
    assert(ikkje abi.gyldig_request(abi.request("x", [], "", "", 0, 1)))
    assert(ikkje abi.gyldig_request(abi.request("x", ["bad\narg"], "", "", 1, 1)))
    assert(ikkje abi.gyldig_request({}))
    req["sandbox"] = "ukjent"
    assert(ikkje abi.gyldig_request(req))
    req["sandbox"] = "no-network"
    req["max_open_files"] = "4097"
    assert(ikkje abi.gyldig_request(req))
    req["max_open_files"] = "64"
    req["inherit_env"] = "2"
    assert(ikkje abi.gyldig_request(req))
    req["inherit_env"] = "1"
    req["stdin"] = "bad\ninput"
    assert(ikkje abi.gyldig_request(req))

    la ok = abi.resultat("ferdig", 42, 0, "ok", "", "")
    assert(abi.gyldig_resultat(ok))
    assert(abi.gyldig_resultat(abi.resultat("timeout", 42, 124, "", "timeout", "timeout")))
    assert(ikkje abi.gyldig_resultat(abi.resultat("kjorer", 42, -1, "", "", "")))
    assert(ikkje abi.gyldig_resultat(abi.resultat("ferdig", 42, -1, "", "", "")))
    # ABI-grenser skal avvise feilformatert taltekst foer native dispatch.
    la ugyldig = abi.request("x", [], "", "", 5000, 4096)
    ugyldig["timeout_ms"] = "ikke-tal"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["timeout_ms"] = "5000"
    ugyldig["max_output_bytes"] = "999999999999999999999"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["max_output_bytes"] = "4096"
    ugyldig["max_memory_bytes"] = "feil"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["max_memory_bytes"] = "536870912"
    ugyldig["max_open_files"] = "064"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["max_open_files"] = "64"
    ugyldig["timeout_ms"] = "+5000"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["timeout_ms"] = "05000"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["timeout_ms"] = "5000"
    assert(abi.gyldig_request(ugyldig))
    # Native capture-flagg må vere kanoniske, elles kan output bli
    # fanga ulikt på ulike prosess-backendar.
    ugyldig["capture_stdout"] = "ja"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["capture_stdout"] = "usann"
    assert(abi.gyldig_request(ugyldig))
    ugyldig["capture_stdout"] = "sann"
    ugyldig["capture_stderr"] = "1"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["capture_stderr"] = "usann"
    assert(abi.gyldig_request(ugyldig))
    ugyldig["capture_stderr"] = "sann"

    # Native ABI-grenser skal halde seg innanfor trygg signed 32-bit,
    # og ikkje la ikkje-validerte ekstreme verdiar nå backend.
    ugyldig["timeout_ms"] = "2147483648"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["timeout_ms"] = "2147483647"
    assert(abi.gyldig_request(ugyldig))
    ugyldig["timeout_ms"] = "5000"
    ugyldig["max_output_bytes"] = "2147483648"
    assert(ikkje abi.gyldig_request(ugyldig))
    ugyldig["max_output_bytes"] = "2147483647"
    assert(abi.gyldig_request(ugyldig))
    ugyldig["max_output_bytes"] = "4096"

    la mangler = {"abi": abi.versjon(), "status": "ferdig"}
    assert(ikkje abi.gyldig_resultat(mangler))
    # Sync-kall les stdout/stderr direkte; malformed backend-respons
    # skal returnere usann, ikkje la kallaren indeksere manglande felt.
    la mangler_stdout = abi.resultat("ferdig", 42, 0, "", "", "")
    fjern_nokkel(mangler_stdout, "stdout")
    assert(ikkje abi.gyldig_resultat(mangler_stdout))
    la mangler_stderr = abi.resultat("ferdig", 42, 0, "", "", "")
    fjern_nokkel(mangler_stderr, "stderr")
    assert(ikkje abi.gyldig_resultat(mangler_stderr))

    # Valfrie error-felt må vere tekst; alle målefelt må ha
    # kanonisk talformat slik at seinare lesarar ikkje krasjar.
    la feil_type = abi.resultat("ferdig", 42, 0, "", "", "")
    feil_type["error"] = ""
    feil_type["wall_ms"] = "01"
    assert(ikkje abi.gyldig_resultat(feil_type))
    feil_type["wall_ms"] = "0"
    assert(abi.gyldig_resultat(feil_type))

    la feil_pid = abi.resultat("ferdig", 42, 0, "", "", "")
    feil_pid["pid"] = "ikkje-tal"
    assert(ikkje abi.gyldig_resultat(feil_pid))
    feil_pid["pid"] = "42"
    feil_pid["wall_ms"] = "-1"
    assert(ikkje abi.gyldig_resultat(feil_pid))
    feil_pid["wall_ms"] = "0"
    feil_pid["peak_rss_bytes"] = "feil"
    assert(ikkje abi.gyldig_resultat(feil_pid))

    la asynk = {"abi": abi.async_versjon(), "status": "kjorer", "pid": "42", "wall_ms": "0", "peak_rss_bytes": "0"}
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["handle"] = "h1"
    assert(abi.gyldig_async_resultat(asynk))
    asynk["pid"] = "ikkje-tal"
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["pid"] = "42"
    asynk["exit_code"] = "ikkje-tal"
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["exit_code"] = "-1"
    assert(abi.gyldig_async_resultat(asynk))
    asynk["handle"] = ""
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["handle"] = "h1"
    assert(abi.gyldig_async_resultat(asynk))
    # Native-resultat må ikkje kunne levere handle som seinare operasjonar avviser.
    asynk["handle"] = "bad\nhandle"
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["handle"] = "bad\rhandle"
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["handle"] = "bad\u0000handle"
    assert(ikkje abi.gyldig_async_resultat(asynk))
    asynk["handle"] = "h1"
    assert(abi.gyldig_async_resultat(asynk))
    la ferdig_async = {"abi": abi.async_versjon(), "status": "ferdig", "pid": "42", "wall_ms": "0", "peak_rss_bytes": "0", "handle": "bad\nhandle"}
    assert(ikkje abi.gyldig_async_resultat(ferdig_async))
    fjern_nokkel(ferdig_async, "handle")
    assert(abi.gyldig_async_resultat(ferdig_async))
    fjern_nokkel(asynk, "wall_ms")
    assert(ikkje abi.gyldig_async_resultat(asynk))
    assert(ikkje abi.gyldig_async_resultat({}))

    # Async spawn brukar no same fail-closed validering som sync spawn.
    la async_req = abi.async_spawn_request("/usr/bin/printf", ["ok"], "", "", 5000, 4096)
    assert(abi.gyldig_request(async_req))
    async_req["max_open_files"] = "ikkje-tal"
    assert(ikkje abi.gyldig_request(async_req))
    async_req["max_open_files"] = "64"
    async_req["operation"] = "wait"
    assert(ikkje abi.gyldig_request(async_req))
    async_req["operation"] = "spawn_argv"
    assert(abi.gyldig_request(async_req))

    la poll_req = abi.async_operation("poll", "h1")
    assert(abi.gyldig_async_operasjon(poll_req))
    assert(abi.gyldig_async_operasjon(abi.async_operation("read", "h1")))
    assert(abi.gyldig_async_operasjon(abi.async_operation("close", "h1")))
    assert(ikkje abi.gyldig_async_operasjon(abi.async_operation("poll", "")))
    assert(ikkje abi.gyldig_async_operasjon(abi.async_operation("read", "bad\nhandle")))
    assert(ikkje abi.gyldig_async_operasjon(abi.async_operation("spawn_argv", "h1")))
    la wait_req = abi.async_wait_request("h1", 0)
    assert(abi.gyldig_async_operasjon(wait_req))
    wait_req["wait_ms"] = "2147483647"
    assert(abi.gyldig_async_operasjon(wait_req))
    wait_req["wait_ms"] = "2147483648"
    assert(ikkje abi.gyldig_async_operasjon(wait_req))
    wait_req["wait_ms"] = "-1"
    assert(ikkje abi.gyldig_async_operasjon(wait_req))
    wait_req["wait_ms"] = "01"
    assert(ikkje abi.gyldig_async_operasjon(wait_req))
    la signal_req = abi.async_signal_request("h1", 15)
    assert(abi.gyldig_async_operasjon(signal_req))
    signal_req["signal"] = "0"
    assert(ikkje abi.gyldig_async_operasjon(signal_req))
    signal_req["signal"] = "16"
    assert(ikkje abi.gyldig_async_operasjon(signal_req))
    returner 0
}
