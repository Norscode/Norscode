bruk std.tls_trust_store som trust

funksjon test_prioritet() {
    la config = trust.velg_kandidatar("explicit.pem", "environment.pem", "Linux")
    assert_eq(config["paths"], ["explicit.pem"])
    assert_eq(config["source_kind"], "config")
    la miljø = trust.velg_kandidatar("", "environment.pem", "Linux")
    assert_eq(miljø["paths"], ["environment.pem"])
    assert_eq(miljø["source_kind"], "environment")
    assert_eq(trust.system_kandidatar("Darwin"), ["/etc/ssl/cert.pem"])
    la linux = trust.system_kandidatar("Linux")
    assert_eq(linux[0], "/etc/ssl/certs/ca-certificates.crt")
    for sti i linux { assert(builtin.starts_with(sti, "/etc/")) }
    assert_eq(trust.system_kandidatar("Windows"), [])
    assert_eq(trust.system_kandidatar("ukjent"), [])
    assert_eq(trust.resolve_med_kontekst({}, "", "Windows")["status"], "feil")
    assert_eq(trust.resolve_med_kontekst({"ca_file": 42}, "", "Linux")["status"], "feil")
}

funksjon test_ramme() {
    la liten = "-----BEGIN CERTIFICATE-----\nAA==\n-----END CERTIFICATE-----\n"
    assert_eq(trust.valider_pem_ramme(liten)["certificates"], 1)
    assert_eq(trust.valider_pem_ramme("# system-CA\n" + liten + liten)["certificates"], 2)
    assert_eq(trust.valider_pem_ramme("")["status"], "feil")
    assert_eq(trust.valider_pem_ramme("ikkje PEM")["status"], "feil")
    assert_eq(trust.valider_pem_ramme("-----END CERTIFICATE-----")["status"], "feil")
    assert_eq(trust.valider_pem_ramme("-----BEGIN CERTIFICATE-----\nAA==")["status"], "feil")
    assert_eq(trust.valider_pem_ramme("-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----")["status"], "feil")
    assert_eq(trust.valider_pem_ramme("-----BEGIN CERTIFICATE-----\n" + liten)["status"], "feil")
    la mange = ""
    la i = 0
    mens i < trust.maks_sertifikat() { mange = mange + liten i = i + 1 }
    assert_eq(trust.valider_pem_ramme(mange)["status"], "ok")
    assert_eq(trust.valider_pem_ramme(mange + liten)["status"], "feil")
    la stor = "x"
    mens lengde(stor) <= trust.maks_byte() { stor = stor + stor }
    assert_eq(trust.valider_pem_ramme(stor)["status"], "feil")
}

funksjon test_fil() {
    la root = tekst(builtin.system_info()["cwd"])
    la sti = root + "/build/tls-ca-bunt-" + builtin.random_hex(8) + ".pem"
    la pem = builtin.fil_les(root + "/tests/fixtures/tls/localhost.crt")
    builtin.fil_skriv(sti, pem)
    la eksplisitt = trust.resolve_med_kontekst({"ca_file": sti}, "manglar.pem", "Windows")
    assert_eq(eksplisitt["status"], "ok")
    assert_eq(eksplisitt["ca_pem"], pem)
    assert_eq(eksplisitt["source"], sti)
    assert_eq(eksplisitt["source_kind"], "config")
    assert_eq(trust.resolve({"ca_file": sti})["ca_pem"], pem)
    la miljø = trust.resolve_med_kontekst({}, sti, "Windows")
    assert_eq(miljø["status"], "ok")
    assert_eq(miljø["source_kind"], "environment")
    // Manglande eksplisitt fil får ikkje falle tilbake til ein gyldig
    // miljøbunt eller til verten sine systemrøter.
    la manglar = trust.resolve_med_kontekst({"ca_file": sti + ".missing"}, sti, "Linux")
    assert_eq(manglar["status"], "feil")
    assert_eq(manglar["source"], sti + ".missing")
    assert_eq(manglar["ca_pem"], "")
    builtin.fil_skriv(sti, "skadd PEM")
    assert_eq(trust.resolve_med_kontekst({"ca_file": sti}, "", "Linux")["status"], "feil")
    assert_eq(trust.resolve_med_kontekst({}, sti, "Linux")["status"], "feil")
    builtin.fil_slett(sti)
}

funksjon start() -> heiltall {
    test_prioritet()
    test_ramme()
    test_fil()
    skriv("test_tls_trust_store OK\n")
    returner 0
}
