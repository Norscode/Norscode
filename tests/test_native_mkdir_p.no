// builtin.native_mkdir_p må opprette katalogtreet på fersk seed. VM-armen kalla
// vertsbuiltinen builtin.native_mkdir_p, som var null-fallback i x86-codegen
// (returnerte null, oppretta ingenting). I C er han identisk med mkdir_p.

bruk std.filops som filops

funksjon start() -> heiltall {
    la rot = "/tmp/norscode-native-mkdir-" + builtin.random_hex(12)
    la ok = builtin.native_mkdir_p(rot + "/a/b/c")
    assert(ok == sann)
    assert(filops.katalog_finnes(rot + "/a/b/c"))
    assert(filops.slett_tre(rot))
    skriv("test_native_mkdir_p OK\n")
    returner 0
}
