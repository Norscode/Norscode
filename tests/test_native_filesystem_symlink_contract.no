funksjon start() -> heiltall {
    la kjelde = builtin.fil_les("std/runtime_filesystem.no")
    la vert = builtin.fil_les("archive/legacy_c_backend/nc_native_main.c")

    assert(builtin.index_of(kjelde, "funksjon native_erstatt_symbolsk_lenke") >= 0)
    assert(builtin.index_of(kjelde, "\"operation\": \"symlink_replace\"") >= 0)
    assert(builtin.index_of(vert, "nc_symlink_target_beneath") >= 0)
    assert(builtin.index_of(vert, "AT_SYMLINK_NOFOLLOW") >= 0)
    assert(builtin.index_of(vert, "symlinkat(target, dirfd, temporary)") >= 0)
    assert(builtin.index_of(vert, "renameat(dirfd, temporary, dirfd, part)") >= 0)
    assert(builtin.index_of(vert, "symbolic link platform ABI unavailable on Windows") >= 0)
    skriv("test_native_filesystem_symlink_contract OK")
    returner 0
}
