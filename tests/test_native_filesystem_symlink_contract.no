// Kontrakten for atomisk utskifting av symbolske lenker.
//
// FØR FASE C.5 las denne testen archive/legacy_c_backend/nc_native_main.c og
// sjekka fem detaljar i C-implementasjonen (nc_symlink_target_beneath,
// AT_SYMLINK_NOFOLLOW, symlinkat(...), renameat(...), Windows-avvisinga). Den
// fila er sletta, so dei kan ikkje grepast lenger.
//
// I staden testar vi ÅTFERDA. Det er ein strengare kontrakt enn kjeldegrepping:
// den held uavhengig av kva språk backenden er skriven i, og han ville fanga ein
// backend som kompilerer fint men gjer feil ting.

bruk std.runtime_filesystem som rfs

funksjon start() -> heiltall {
    la kjelde = builtin.fil_les("std/runtime_filesystem.no")
    assert(builtin.index_of(kjelde, "funksjon native_erstatt_symbolsk_lenke") >= 0)
    assert(builtin.index_of(kjelde, "\"operation\": \"symlink_replace\"") >= 0)

    la rot = tekst(builtin.system_info()["cwd"])
    la kat = "build/test-symlink"
    prøv { builtin.mkdir_p(rot + "/" + kat) } fang (e) { }
    builtin.fil_skriv(rot + "/" + kat + "/a.txt", "AAA")
    builtin.fil_skriv(rot + "/" + kat + "/b.txt", "BBB")

    // Fyrste peiking, og deretter ATOMISK ompeiking av ei eksisterande lenke.
    la lenke = kat + "/peikar"
    la r1 = rfs.native_erstatt_symbolsk_lenke(rot, lenke, "a.txt")
    assert(tekst(r1["status"]) != "feil")
    assert(builtin.trim(fil_les(rot + "/" + lenke)) == "AAA")
    la r2 = rfs.native_erstatt_symbolsk_lenke(rot, lenke, "b.txt")
    assert(tekst(r2["status"]) != "feil")
    assert(builtin.trim(fil_les(rot + "/" + lenke)) == "BBB")

    // Kontrakten avviser tomme argument i staden for å gjere noko halvvegs.
    assert(tekst(rfs.native_erstatt_symbolsk_lenke("", lenke, "a.txt")["status"]) == "feil")
    assert(tekst(rfs.native_erstatt_symbolsk_lenke(rot, "", "a.txt")["status"]) == "feil")
    assert(tekst(rfs.native_erstatt_symbolsk_lenke(rot, lenke, "")["status"]) == "feil")

    skriv("test_native_filesystem_symlink_contract OK")
    returner 0
}
