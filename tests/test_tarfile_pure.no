bruk std.tarfile som tf
bruk std.bytes som bytes

funksjon start() -> heiltall {
    la rot = "build/test-tarfile-pure-" + builtin.random_hex(8)
    builtin.mkdir_p(rot + "/src/sub")
    builtin.fil_skriv(rot + "/src/hello.txt", "hei")
    builtin.fil_skriv_binær(rot + "/src/sub/data.bin", bytes.fra_liste([0, 255, 1, 128]))

    la ark_sti = rot + "/data.tar.gz"
    la ark = tf.open(ark_sti, "w:gz")
    assert(tf.add(ark, rot + "/src", "payload"))
    assert(ikkje builtin.fil_finnes(ark_sti))
    tf.close(ark)
    assert(ark["feil"] == "")
    assert(builtin.fil_finnes(ark_sti))
    assert(tf.is_tarfile(ark_sti))

    la lesar = tf.open(ark_sti, "r:gz")
    la namn = tf.getnames(lesar)
    assert(lengde(namn) == 2)
    assert(tf.extract(lesar, "payload/hello.txt", rot + "/one"))
    assert(builtin.fil_les(rot + "/one/payload/hello.txt") == "hei")
    assert(tf.extractall(lesar, rot + "/all"))
    la bin = bytes.til_liste(builtin.fil_les_binær(rot + "/all/payload/sub/data.bin"))
    assert(lengde(bin) == 4 og bin[0] == 0 og bin[1] == 255 og bin[3] == 128)
    assert(ikkje tf.extract(lesar, "../escape", rot))
    tf.close(lesar)

    skriv("test_tarfile_pure OK")
    returner 0
}
