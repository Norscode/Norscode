bruk std.runtime_filesystem som fs
bruk std.stat som stat

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_PLATFORM_ABI_LIVE") != "1" {
        skriv("test_platform_abi_live: krev eksplisitt kandidatattestasjon\n")
        returner 0
    }
    la root = "build"
    la mappe = "platform-abi-live"
    la fil = mappe + "/modus.txt"
    la kandidat = mappe + "/kandidat.txt"

    # Rydd fail-closed frå eit eventuelt tidlegare avbrot.
    prøv { fs.native_slett(root, fil) } fang (e) { }
    prøv { fs.native_slett(root, kandidat) } fang (e) { }
    prøv { fs.native_slett_mappe(root, mappe) } fang (e) { }

    la laga = fs.native_lag_mappe(root, mappe)
    skriv("mkdir=" + tekst(laga["status"]) + "\n")
    assert(laga["status"] == "ok")
    la h = fs.opne_native(root, fil, "write")
    assert(h["status"] == "open")
    assert(fs.native_skriv(h, "plattform-abi")["status"] == "ok")
    assert(fs.native_lukk(h)["status"] == "closed")

    la mode = fs.native_sett_modus(root, fil, 384)
    skriv("chmod=" + tekst(mode["status"]) + ":" + tekst(mode["value"]) + ":" + tekst(mode["error"]) + "\n")
    assert(mode["status"] == "ok")
    assert(heltall_fra_tekst(tekst(mode["value"])) == 384)
    la metadata = fs.native_stat_sti(root + "/" + fil)
    skriv("stat=" + tekst(metadata["status"]) + ":" + tekst(metadata["value"]) + ":" +
          tekst(metadata["mode"]) + ":" + tekst(metadata["error"]) + "\n")
    assert(metadata["status"] == "ok")
    assert(heltall_fra_tekst(tekst(metadata["value"])) == 13)
    assert((heltall_fra_tekst(tekst(metadata["mode"])) & 511) == 384)
    la stat_info = stat.stat(root + "/" + fil)
    skriv("stdlib-stat=" + tekst(stat_info["feil"]) + ":" + tekst(stat_info["size"]) +
          ":" + tekst(stat_info["mode"]) + "\n")
    assert(stat_info["feil"] == "")
    assert(stat.storleik(root + "/" + fil) == 13)
    assert(stat.S_ISREG(heltall_fra_tekst(stat_info["mode"])))
    assert(stat.er_lesbar(root + "/" + fil))
    assert(stat.er_skrivbar(root + "/" + fil))
    assert(ikkje stat.er_køyrbar(root + "/" + fil))

    la kandidat_h = fs.opne_native(root, kandidat, "write")
    assert(kandidat_h["status"] == "open")
    assert(fs.native_skriv(kandidat_h, "atomisk")["status"] == "ok")
    assert(fs.native_flush(kandidat_h)["status"] == "ok")
    assert(fs.native_lukk(kandidat_h)["status"] == "closed")
    la erstatta = fs.native_erstatt_fil_atomisk(root, kandidat, fil)
    skriv("file-replace=" + tekst(erstatta["status"]) + ":" + tekst(erstatta["error"]) + "\n")
    assert(erstatta["status"] == "replaced")
    assert(fil_les(root + "/" + fil) == "atomisk")
    assert(ikkje builtin.fil_finnes(root + "/" + kandidat))

    la sletta = fs.native_slett(root, fil)
    skriv("delete=" + tekst(sletta["status"]) + ":" + tekst(sletta["error"]) + "\n")
    assert(sletta["status"] == "deleted")
    la mappe_sletta = fs.native_slett_mappe(root, mappe)
    skriv("rmdir=" + tekst(mappe_sletta["status"]) + ":" + tekst(mappe_sletta["error"]) + "\n")
    assert(mappe_sletta["status"] == "deleted")
    assert(fs.native_list(root, mappe)["status"] == "feil")

    la line = builtin.readline("stdin-abi> ")
    skriv("readline=" + line + "\n")
    assert(line == "abi-input")
    skriv("test_platform_abi_live OK")
    returner 0
}
