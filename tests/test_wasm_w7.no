# W7 (WASM-sporet): lokal lagring i IndexedDB frå Norscode — std/wasm_lager.no, hjelparane I og J
# i lastaren og den lokale kopien i deltakar-demoen (examples/wasm_deltakarar/).
#
# Utan nettlesar (alle plattformer):
#   1. Paritetskorpusa w7_lager (skjema, nøklar, op-ane som JSON, JSON utan rå kontrollteikn,
#      konvolutten, feilklassar, resultat, LagerFeil, databasenamn per brukar) og w7_lager_ko
#      (køa: levering i rekkjefølgja førespurnadene vart gjorde, tilbakekall som kastar,
#      manglande feil-tilbakekall, ukjend og dobbel id, ny førespurnad under levering) gjev
#      fasiten i VM-en, og same utskrift i Chrome når han finst (kh.køyr_korpus).
#   2. Stubbane kastar i VM-en; ugyldige argument kastar LagerFeil «data» før noko blir sendt.
#   3. Demoen i VM-en (same kode som i WASM): skjemaet, databasenamnet og feilmeldingane for
#      den lokale kopien.
#   4. Bygg: tests/fixtures/wasm_w7_utan_idb.no importerer lager_start, lager_svar og
#      eksporterer __lager_ferdig. Regresjon (rt-cachen): han og så w7_lager_ko med ein fersk,
#      delt cache gjev ein gyldig modul, byte-lik den frå korpuset (før fiksen tok
#      analysecachen opp verknadene til std.wasm_lager._kall utan dispatcharen for
#      ncb_call_fn). Bygga av testklienten og demoen (med lastartaket) er i
#      tests/test_wasm_w7_chrome.no, som byggjer dei uansett.
#   5. JavaScriptCore (valfri, SKIP utan): korpusa gjev fasiten i jsc. jsc-skalet har ikkje
#      IndexedDB, så ende-til-ende-testane er SKIP der (dei køyrer i Chrome:
#      tests/test_wasm_w7_chrome.no); i staden viser tests/fixtures/wasm_w7_utan_idb.no at ein
#      nettlesar utan IndexedDB gjev LagerFeil «open» i rekkjefølgje, utan «Uncaught».
bruk std.wasm_lager som lager
bruk std.wasm_jsc som shim
bruk std.wasm_nettlesar som benk
bruk examples.wasm_deltakarar.klient som demo
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon rot() -> tekst { returner "build/wasm/test_w7" }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

# ── 2 ──
funksjon stubbar_og_validering() -> heltall {
    la stubb = ""
    prøv {
        lager.opne("nc-x", 1, [lager.lager("a", "id", [])], fun(d) -> 0, fun(f) -> 0)
    } fang (e) {
        stubb = tekst(e)
    }
    assert(inneheld(stubb, "wasm_vert.lager_start finst berre i nettlesaren"))
    la stubb2 = ""
    prøv {
        lager.logg_ut(null, "nc-x", ["nøkkel"], null, null)
    } fang (e) {
        stubb2 = tekst(e)
    }
    assert(inneheld(stubb2, "wasm_vert.fjern_lokalt finst berre i nettlesaren"))
    la før = lager.ventande()
    la feil = []
    prøv {
        lager.opne("nc-x", 0, [], null, null)
    } fang (e: LagerFeil) {
        legg_til(feil, e["art"] + ": " + e["melding"])
    }
    prøv {
        lager.opne("", 1, [], null, null)
    } fang (e: LagerFeil) {
        legg_til(feil, e["art"] + ": " + e["melding"])
    }
    prøv {
        lager.opne("nc-x", 1, [lager.lager("a", "", []), lager.lager("a", "", [])], null, null)
    } fang (e: LagerFeil) {
        legg_til(feil, e["art"] + ": " + e["melding"])
    }
    prøv {
        lager.slett_database("", null, null)
    } fang (e: LagerFeil) {
        legg_til(feil, e["art"] + ": " + e["melding"])
    }
    prøv {
        lager.køyr(lager.test_db("t", [lager.lager("a", "id", [])]), [lager.op_put("a", {"id": [1]})], null, null)
    } fang (e: LagerFeil) {
        legg_til(feil, e["art"] + ": " + e["melding"])
    }
    assert_eq(builtin.join(feil, " | "), "data: versjonen må vere eit heiltal ≥ 1 | data: databasen må ha eit namn | data: lageret «a» står to gonger | data: databasen må ha eit namn | data: verdien har ingen gyldig nøkkel i «id»: [verdi]")
    # Ingenting vart registrert i køa
    assert_eq(lager.ventande(), før)
    skriv("stubbar og validering OK (VM)\n")
    returner 0
}

# ── 3 ──
funksjon demo_lokal() -> heltall {
    assert_eq(lager.valider_skjema(demo.skjema()), "")
    assert(builtin.starts_with(demo.db_namn(), "nc-deltakarar-"))
    assert_eq(lengde(demo.db_namn()), lengde("nc-deltakarar-") + 16)
    assert_eq(demo.db_namn(), lager.brukar_db_namn("nc-deltakarar", "demo"))
    assert_eq(builtin.json_stringify(demo.lokale_rader([{"id": 7, "namn": "Åse", "epost": "a@b.no"}, {"id": 9, "namn": "Bo", "epost": "b@b.no"}])),
        "[{\"pos\":0,\"namn\":\"Åse\",\"epost\":\"a@b.no\"},{\"pos\":1,\"namn\":\"Bo\",\"epost\":\"b@b.no\"}]")
    la arter = ["kvote", "open", "blokkert", "versjon", "transaksjon", "data"]
    la m = []
    la i = 0
    mens i < lengde(arter) {
        legg_til(m, demo.lokal_feilmelding({"art": arter[i]}))
        i = i + 1
    }
    assert_eq(builtin.join(m, " | "), "Eininga har ikkje meir plass til den lokale kopien. | Nettlesaren tillèt ikkje lokal lagring her. | " +
        "Lukk andre faner med sida og prøv igjen. | Ein nyare versjon av sida har lagra lista. Last sida på nytt. | " +
        "Den lokale kopien kunne ikkje oppdaterast (transaksjon). | Den lokale kopien kunne ikkje oppdaterast (data).")
    skriv("demo: lokal kopi OK (VM)\n")
    returner 0
}

# Bygg med ein eigen rt-cache (NC_WASM_RT_CACHE_MAPPE), elles som hjelp.bygg.
funksjon bygg_med_cache(kjelde: tekst, utmappe: tekst, cache: tekst, app: tekst) -> tekst {
    hjelp.mkdir(utmappe)
    la rot = hjelp.root()
    la m = hjelp.grunnmiljø(rot)
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = rot + "/tools/nc_wasm.no"
    m["NORSCODE_VM_FAST"] = "1"
    m["NC_WASM_KJELDE"] = kjelde
    m["NC_WASM_NCB"] = ""
    m["NC_WASM_UT"] = utmappe
    m["NC_WASM_APP"] = app
    m["NC_WASM_RT_CACHE"] = "1"
    m["NC_WASM_RT_CACHE_MAPPE"] = cache
    m["NC_WASM_TESTBYGG"] = "1"
    m["NC_WASM_PREFIKS"] = ""
    la r = hjelp.køyr_nc(m, 300000)
    hjelp.krev_ok("nc_wasm " + kjelde + " (cache " + cache + ")", r)
    la ut = r["stdout"]
    la p = builtin.index_of(ut, "WASM: ")
    assert(p >= 0)
    la linje = builtin.slice(ut, p, lengde(ut))
    la nl = builtin.index_of(linje, "\n")
    hvis nl >= 0 { linje = builtin.slice(linje, 0, nl) }
    returner linje
}

funksjon har(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon krev_bygg_lager(linje: tekst, kva: tekst) -> heltall {
    la imp = hjelp.liste_felt(linje, "importar")
    la eksp = hjelp.liste_felt(linje, "eksportar")
    la ok = har(imp, "lager_start") og har(imp, "lager_svar") og har(eksp, "__lager_ferdig")
    hvis ikkje ok {
        skriv(kva + ": manglar lagrings-importane eller __lager_ferdig: " + linje + "\n")
        assert(usann)
    }
    returner 0
}

# ── 5 ──
funksjon med_jsc(jsc: tekst) -> heltall {
    la prog = ["w7_lager", "w7_lager_ko"]
    la i = 0
    mens i < lengde(prog) {
        la n = prog[i]
        la j = shim.jsc_køyr(jsc, rot() + "/korpus/" + n)
        la f = kh.fasit(n)
        hvis j["logg"] != f eller j["uncaught"] {
            skriv(n + ": jsc skil seg frå fasiten, " + kh.skilnad(j["logg"], f) + "\njsc:\n" + j["logg"] + "\n" + j["stderr"] + "\nFasit:\n" + f + "\n")
            assert(usann)
        }
        i = i + 1
    }
    la u = shim.jsc_køyr(jsc, rot() + "/utan_idb")
    hvis u["logg"] != "sendt: 3\nopne: open ReferenceError\ntel: open\nslett: open ReferenceError\n" eller u["uncaught"] {
        skriv("utan IndexedDB:\n" + u["logg"] + "\n" + u["stderr"] + "\n")
        assert(usann)
    }
    skriv("jsc: " + tekst(lengde(prog)) + " korpusprogram lik fasiten; utan IndexedDB gav LagerFeil «open» i rekkjefølgje, utan «Uncaught»\n")
    skriv("SKIP jsc IndexedDB: JavaScriptCore-skalet har ikkje IndexedDB (ende til ende i Chrome: tests/test_wasm_w7_chrome.no)\n")
    returner 0
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())
    # ── 1. Korpus (VM mot fasit, bygg, Chrome) ──
    kh.køyr_korpus("test_wasm_w7", rot() + "/korpus", ["w7_lager", "w7_lager_ko"], [], "48381", {})
    # ── 2–3 ──
    stubbar_og_validering()
    demo_lokal()
    # ── 4. Bygg ──
    # Ein fersk cache (mappa blir sletta først; ho må liggje under build/wasm/)
    la cache = rot() + "/rt_cache_regresjon"
    benk.køyr_verktøy("/bin/rm", ["-rf", hjelp.root() + "/" + cache], 60)
    la l_u = bygg_med_cache("tests/fixtures/wasm_w7_utan_idb.no", rot() + "/utan_idb", cache, "")
    krev_bygg_lager(l_u, "utan_idb")
    la l_ko = bygg_med_cache("tests/wasm_korpus/w7_lager_ko.no", rot() + "/ko_cache", cache, "")
    # fil_les er byte-eksakt
    assert(fil_les(hjelp.root() + "/" + rot() + "/ko_cache/app.wasm") == fil_les(hjelp.root() + "/" + rot() + "/korpus/w7_lager_ko/app.wasm"))
    skriv("rt-cache: w7_lager_ko etter utan_idb med same cache er byte-lik (" + hjelp.felt(l_ko, "rt_cache") + ")\n")
    # ── 5. jsc ──
    la jsc = benk.finn_jsc()
    hvis jsc == "" {
        skriv("SKIP jsc: fann ikkje JavaScriptCore, set NC_JSC=<sti>\n")
    } ellers {
        med_jsc(jsc)
    }
    skriv("test_wasm_w7 OK\n")
    returner 0
}
