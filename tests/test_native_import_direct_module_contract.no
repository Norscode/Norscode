bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(src, "komp.kompiler_fil(kjelde, alias)"))
    assert(t.inneholder(src, "komp.kompiler_fil(hoved_kjelde, modul)"))
    assert(t.inneholder(src, "Berre cache-kompatibilitetsbana får tekstnormalisering"))
    assert(t.inneholder(src, "hvis lengde(bit) >= 4096"))
    assert(t.inneholder(src, "legg_til(delar, bit)"))
    assert(ikkje t.inneholder(src, "legg_til(delar, c)"))
    assert(t.inneholder(src, "hvis builtin.contains(ncb_json, \"\\\"__main__.\")"))
    assert(ikkje t.inneholder(src, "ncb_json = komp.kompiler_fil(rein_kjelde, alias)"))
    assert(ikkje t.inneholder(src, "komp.kompiler_fil(rein_kjelde, \"__main__\")"))
    assert(ikkje t.inneholder(src, "komp.kompiler_fil(hoved_rein_kjelde, modul)"))
    skriv("test_native_import_direct_module_contract OK\n")
    returner 0
}
