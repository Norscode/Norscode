// Fase 3: durabilitet — append-WAL + binær checkpoint + crash-recovery.
// Kjernen: ein trunkert WAL-hale (krasj midt i skriving) skal ignorerast, og eit
// avbrote checkpoint-skriv skal oppdagast som ugyldig.

bruk std.norsdb_motor som motor
bruk std.bytes som bytes

funksjon start() -> heltall {
    la wal = "/tmp/norsdb_motor_test.wal"
    la cp = "/tmp/norsdb_motor_test.cp"
    motor.logg_tøm(wal)
    hvis builtin.fil_finnes(cp) { builtin.fil_slett(cp) }

    // ── WAL: tre durable postar, les tilbake ─────────────────────────
    motor.logg_legg_til(wal, [65, 66, 67])       // "ABC"
    motor.logg_legg_til(wal, [1, 2])
    motor.logg_legg_til(wal, [10, 20, 30, 40])
    la recs = motor.logg_les_alle(wal)
    assert_eq(lengde(recs), 3)
    assert_eq(recs[0][0], 65)
    assert_eq(recs[0][2], 67)
    assert_eq(lengde(recs[1]), 2)
    assert_eq(recs[2][3], 40)

    // ── Trunkert hale: ramme påstår 50 bytes, berre 3 finst → ignorerast ─
    builtin.fil_append_binær(wal, bytes.fra_liste([0, 0, 0, 50, 9, 9, 9]))
    la recs2 = motor.logg_les_alle(wal)
    assert_eq(lengde(recs2), 3)                   // dei tre komplette står, halen droppa
    assert_eq(recs2[2][0], 10)

    // ── Checkpoint round-trip ────────────────────────────────────────
    motor.checkpoint_skriv(cp, [11, 22, 33])
    la c = motor.checkpoint_les(cp)
    assert(c["gyldig"])
    assert_eq(lengde(c["payload"]), 3)
    assert_eq(c["payload"][1], 22)

    // ── Avbrote/korrupt checkpoint → gyldig = usann ──────────────────
    builtin.fil_skriv_binær(cp, bytes.fra_liste([1, 2, 3, 4, 5]))
    la c2 = motor.checkpoint_les(cp)
    assert(c2["gyldig"] == usann)

    // ── Manglande checkpoint → gyldig = usann ────────────────────────
    builtin.fil_slett(cp)
    la c3 = motor.checkpoint_les(cp)
    assert(c3["gyldig"] == usann)

    // Rydd opp
    motor.logg_tøm(wal)
    returner 0
}
