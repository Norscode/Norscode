bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/syslog.no")
    assert(t.inneholder(src, "norscode-system-log-v1"))
    assert(t.inneholder(src, "builtin.system_log_operation"))
    assert(t.inneholder(src, "\"operation\": \"write\""))
    assert(t.inneholder(src, "\"operation\": \"read_recent\""))
    assert(t.inneholder(src, "funksjon _filtrer_liner(tekstblokk: tekst, mønster: tekst) -> tekst"))
    assert(t.inneholder(src, "builtin.index_of(builtin.lower(linje), needle)"))
    assert(t.inneholder(src, "funksjon _siste_ikkje_tomme_liner(tekstblokk: tekst, n: heltall) -> liste_tekst"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "logger "))
    assert(ikkje t.inneholder(src, "journalctl"))
    assert(ikkje t.inneholder(src, "log show"))
    assert(ikkje t.inneholder(src, "| tail"))
    skriv("test_syslog_shell_quote OK")
    returner 0
}
