# R3 / F42: moduloppløysing. Søskenmodular (.no ved sida av importøren),
# nøsta pakkar, prosjektrota (næraste norcode.toml/innstillingar.toml over
# importøren), NORSCODE_PATH med fleire røter og selektiv import
# `fra M bruk a, b`. Kompilatoren (registrer_importerte_funksjonar), bundle-
# vegen i nc_main og `nc check` brukar same resolver (finn_modulfil).
# Fiksturen tests/fixtures/r3_modul er forma som eit ferskt `nc startproject`:
# src/visning.no brukar `bruk src.mal` (gav «import feila src/src/mal.nors»)
# og tests/t.no slår opp src.* frå prosjektrota, ikkje frå tests/.
# Køyrer gjennom KJELDE-kompilator, KJELDE-nc_main og KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.nc_main som ncm

la P = "tests/fixtures/r3_modul"

funksjon kompileringsfeil(kjelde: tekst, kjeldefil: tekst) -> tekst {
    miljo_sett("NORSCODE_KJELDEFIL", kjeldefil)
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon køyr_bundle(hovudfil: tekst) -> tekst {
    la imports = ncm.finn_bruk_imports(fil_les(hovudfil))
    la ncb_json = ncm.nc_bundle_ncb(hovudfil, "__main__", imports)
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(ncb_json)))
}

funksjon start() -> heiltall {
    # 1. Resolveren: søsken, prosjektrot, nøsta pakke, tests/ → prosjektrot.
    assert_eq(kompiler.finn_modulfil("hjelpar", P + "/src/visning.no"), P + "/src/hjelpar.no")
    assert_eq(kompiler.finn_modulfil("src.mal", P + "/src/visning.no"), P + "/src/mal.no")
    assert_eq(kompiler.finn_modulfil("src.mal", P + "/tests/t.no"), P + "/src/mal.no")
    assert_eq(kompiler.finn_modulfil("pakke.under.djup", P + "/app.no"), P + "/pakke/under/djup.no")
    assert_eq(kompiler.finn_modulfil("finst.ikkje", P + "/app.no"), "")

    # 2. NORSCODE_PATH: fleire røter, «:»-skilde og JSON-liste.
    assert_eq(kompiler.finn_modulfil("extlib", P + "/app.no"), "")
    miljo_sett("NORSCODE_PATH", "tests/fixtures/finst_ikkje:tests/fixtures/r3_modul_ekstern")
    assert_eq(kompiler.finn_modulfil("extlib", P + "/app.no"), "tests/fixtures/r3_modul_ekstern/extlib.no")
    miljo_sett("NORSCODE_PATH", "[\"tests/fixtures/finst_ikkje\", \"tests/fixtures/r3_modul_ekstern\"]")
    assert_eq(kompiler.finn_modulfil("extlib", P + "/app.no"), "tests/fixtures/r3_modul_ekstern/extlib.no")
    la ekstern = "bruk extlib\nfunksjon start() -> tekst { returner extlib.ekstern() }\n"
    assert_eq(kompileringsfeil(ekstern, P + "/app.no"), "KOMPILERTE")
    miljo_sett("NORSCODE_PATH", "")

    # 3. Kompilatoren løyser søskenmodular frå kjeldefila (NORSCODE_KJELDEFIL).
    assert_eq(kompileringsfeil(fil_les(P + "/src/visning.no"), P + "/src/visning.no"), "KOMPILERTE")

    # 4. Selektiv import: valde namn må finnast i modulen.
    la ukjend = "fra src.verktoy bruk dobbel, finst_ikkje\nfunksjon start() -> heiltall { returner dobbel(1) }\n"
    assert_eq(kompileringsfeil(ukjend, P + "/app.no"), "Importfeil linje 1: modulen src.verktoy har ingen funksjon eller struktur finst_ikkje")
    la stjerne = "fra src.verktoy bruk *\nfunksjon start() -> heiltall { returner dobbel(4) }\n"
    assert_eq(kompileringsfeil(stjerne, P + "/app.no"), "KOMPILERTE")

    # 5. Bundle-vegen (run/test/serve): src.* frå src/, søsken, nøsta pakke,
    #    `fra … bruk` med funksjon og struktur; tests/ i prosjektet.
    assert_eq(køyr_bundle(P + "/app.no"), "[xx]|djup|42|5")
    assert_eq(køyr_bundle(P + "/tests/t.no"), "[t]")

    # 6. nc check brukar same resolver (transitivt) og melder manglande modul.
    assert_eq(ncm.nc_check(P + "/app.no"), 0)
    assert_eq(ncm.nc_check_importar("tests/fixtures/r3_modul_manglar.no"), "modul ikkje funnen: finst.ikkje (importert frå tests/fixtures/r3_modul_manglar.no)")
    miljo_sett("NORSCODE_KJELDEFIL", "")
    returner 0
}
