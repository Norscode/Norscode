// P0.1: prosjekt-lokal moduloppløysing. `bruk mymod` der mymod.no (eller .nors)
// ligg ved sida av importøren skal løyse sjølv om _modul_filsti_fra_namn gjettar
// motsett ending (NORSCODE_ROOT-prioritet gjev .nors; brukarprosjekt som
// NorscodeOS har ofte .no). Testen byggjer eit syntetisk tre under build/ og
// køyrer den EKTE nc_main._resolve_import_sti / _bytt_modul_ending frå kjelde, så
// stock Norscode skal byggje slike tre utan hand-patching.

bruk selfhost.nc_main som ncmain
bruk std.filops som filops
bruk std.tekst som tt

funksjon rot() -> tekst { returner "build/test-p0-prosjekt-lokal" }

funksjon skriv_rel(rel: tekst, innhald: tekst) -> heiltall {
    assert(filops.lag_katalogar(filops.katalog(rot() + "/" + rel)))
    fil_skriv(rot() + "/" + rel, innhald)
    returner 0
}

funksjon start() -> heiltall {
    // Syntetisk prosjekt: ein importør + lokale modular med ulike endingar.
    skriv_rel("proj/main.no", "funksjon start() -> heiltall { returner 0 }\n")
    skriv_rel("proj/mymod.no", "funksjon f() -> heiltall { returner 1 }\n")        // berre .no
    skriv_rel("proj/onlynors.nors", "funksjon g() -> heiltall { returner 2 }\n")   // berre .nors
    skriv_rel("proj/both.no", "funksjon h() -> heiltall { returner 3 }\n")         // begge
    skriv_rel("proj/both.nors", "funksjon h() -> heiltall { returner 4 }\n")

    la importør = rot() + "/proj/main.no"
    la dir = rot() + "/proj"

    // 1. _bytt_modul_ending: .nors ↔ .no, elles tom.
    assert_eq(ncmain._bytt_modul_ending("a/b.nors"), "a/b.no")
    assert_eq(ncmain._bytt_modul_ending("a/b.no"), "a/b.nors")
    assert_eq(ncmain._bytt_modul_ending("a/b"), "")
    assert_eq(ncmain._bytt_modul_ending("mymod.no"), "mymod.nors")

    // 2. KJERNEFIKSEN: gjetta .nors manglar, men .no ligg ved sida → .no.
    assert_eq(ncmain._resolve_import_sti(importør, "mymod.nors"), dir + "/mymod.no")

    // 3. Motsett veg: gjetta .no manglar, men .nors ligg ved sida → .nors.
    assert_eq(ncmain._resolve_import_sti(importør, "onlynors.no"), dir + "/onlynors.nors")

    // 4. Eksisterande veg uendra: når den gjetta endinga finst, bruk ho direkte.
    assert_eq(ncmain._resolve_import_sti(importør, "mymod.no"), dir + "/mymod.no")
    assert_eq(ncmain._resolve_import_sti(importør, "onlynors.nors"), dir + "/onlynors.nors")

    // 5. .nors-prioritet når BEGGE finst: syskensjekken slår aldri inn for .no,
    //    og .no-forma løyser framleis direkte til .no.
    assert_eq(ncmain._resolve_import_sti(importør, "both.nors"), dir + "/both.nors")
    assert_eq(ncmain._resolve_import_sti(importør, "both.no"), dir + "/both.no")

    // 6. Ingen fil finst: returner kandidaten uendra (som før fiksen).
    assert_eq(ncmain._resolve_import_sti(importør, "ghost.nors"), dir + "/ghost.nors")

    // 7. Prefiks-importar (std/ …) går framleis rett til NORSCODE_ROOT og rører
    //    aldri syskenlogikken — regresjonsvakt for byte-identiteten.
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root != "" {
        assert_eq(ncmain._resolve_import_sti(importør, "std/tekst.no"), root + "/std/tekst.no")
    }

    // 8. ENDE-TIL-ENDE gjennom den EKTE bundle-vegen (finn_bruk_imports →
    //    nc_bundle_ncb → _resolve_import_sti): eit program som `bruk lokalmod`
    //    der lokalmod.no (berre .no) ligg ved sida — same forma som NorscodeOS
    //    sin `bruk a64` → a64.no. Før fiksen gav dette «Kan ikkje opne fil».
    skriv_rel("e2e/app.no",
        "bruk lokalmod som m\nfunksjon start() -> heiltall { returner m.svar() }\n")
    skriv_rel("e2e/lokalmod.no",
        "funksjon svar() -> heiltall { returner 42 }\n")
    la app_sti = rot() + "/e2e/app.no"
    // `nc run/compile <app>` set IKKJE NORSCODE_IMPORT_BASE sjølv — bundlaren
    // reknar han ut frå src-stien (dirname). Testharnessen køyrer derimot denne
    // testfila frå tests/, så han arvar NORSCODE_IMPORT_BASE=tests (jf.
    // verifikasjonsfelle: arva miljøvariabel vinn). Tøm han, så bundlaren reknar
    // basen frå app_sti slik CLI-en gjer — elles får vi ein falsk negativ.
    miljo_sett("NORSCODE_IMPORT_BASE", "")
    la res = ncmain.nc_reload_bundle(app_sti, "app")
    assert(res["ok"])
    assert(res["bundled"])
    assert_eq(tekst(res["error"]), "")
    // Den lokale .no-modulen blei faktisk lesen og slått inn i bunten.
    la bundle = tekst(res["ncb_json"])
    assert(lengde(bundle) > 0)
    assert(tt.inneholder(bundle, "lokalmod.svar"))

    skriv("test_prosjekt_lokal_import_oppslag OK\n")
    returner 0
}
