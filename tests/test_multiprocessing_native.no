bruk std.multiprocessing som mp

funksjon start() -> heiltall {
    la p = mp.ny_native_prosess("/usr/bin/printf", ["%s", "norscode-native-mp"])
    assert_eq(p["backend"], "native-argv")

    // start_native ber om sandkasseprofilen «no-network» (seccomp-BPF). Mål utan
    // seccomp (macOS: Seatbelt krev libsandbox) skal feile LUKKA: barnet køyrer
    // aldri utan avgrensinga det bad om, og feilen seier kvifor.
    hvis tekst(builtin.system_info()["system"]) != "Linux" {
        assert(ikkje mp.start_native(p, "/tmp"))
        assert_eq(p["tilstand"], "feil")
        assert(builtin.index_of(tekst(p["feil"]), "seccomp") >= 0)
        skriv("test_multiprocessing_native OK (fail-closed utan seccomp)")
        returner 0
    }

    assert(mp.start_native(p, "/tmp"))

    la i: heiltall = 0
    la status: tekst = "køyrer"
    mens i < 100 og status == "køyrer" {
        status = mp.native_status(p)
        i = i + 1
    }
    hvis status == "køyrer" { status = mp.native_wait(p, 5000) }
    la resultat = mp.native_resultat(p)
    assert_eq(resultat["status"], "ferdig")
    assert_eq(resultat["exit_code"], "0")
    assert_eq(builtin.trim(resultat["stdout"]), "norscode-native-mp")
    skriv("test_multiprocessing_native OK")
    returner 0
}
