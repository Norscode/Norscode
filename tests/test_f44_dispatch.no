# F44 / 5b: nc_main sender dev/coverage/doc/profile/debug til verktøya og gjev dei
# argumenta via NC_VERKTOY_ARGV (linjeskild); `nc serve --reload` er alias for dev.

bruk selfhost.nc_main som nc

funksjon start() -> heiltall {
    assert_eq(nc.nc_direkte_verktøysti("dev"), "tools/nc_dev.no")
    assert_eq(nc.nc_direkte_verktøysti("coverage"), "tools/nc_coverage.no")
    assert_eq(nc.nc_direkte_verktøysti("doc"), "tools/nc_doc.no")
    assert_eq(nc.nc_direkte_verktøysti("profile"), "tools/nc_profile.no")
    assert_eq(nc.nc_direkte_verktøysti("debug"), "tools/nc_debug.no")
    assert_eq(nc.nc_verktøy_argv(["nc", "doc", "std.web", "--ut", "x.md"]), "std.web\n--ut\nx.md")
    assert_inneholder(nc.nc_direkte_bruk("coverage"), "nc coverage")
    assert(nc.nc_forbered_direkte_miljø("coverage", ["nc", "coverage", "tests/x.no", "--alle"]))
    assert_eq(miljo_hent("NC_VERKTOY_ARGV"), "tests/x.no\n--alle")
    returner 0
}
