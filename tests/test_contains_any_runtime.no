funksjon start() -> heiltall {
    la runtime = fil_les("archive/legacy_c_backend/nc_runtime_mini.c")
    la host = fil_les("archive/legacy_c_backend/nc_native_main.c")
    assert(builtin.contains(runtime, "#define NC_HAS_BUILTIN_CONTAINS_ANY 1"))
    assert(builtin.contains(host, "#if !defined(NC_HAS_BUILTIN_CONTAINS_ANY)"))
    la treff = builtin.contains_any("alpha beta gamma", ["manglar", "beta", "alpha"])
    assert(lengde(treff) == 2)
    assert(treff[0] == "beta")
    assert(treff[1] == "alpha")
    assert(lengde(builtin.contains_any("rein", ["x", "y"])) == 0)
    skriv("test_contains_any_runtime OK")
    returner 0
}
