# R1: hvis/ellers i gammal slutt-syntaks. `ellers` + linjeskift + `hvis` vart
# lese som `ellers hvis` (éin slutt for lite), og ein `ellers` etter ein
# slutt-avslutta indre hvis vart knytt til den indre. Begge åt opp ein slutt
# for mykje, så resten av funksjonen hamna på toppnivå (t.d. halen av
# emit_uttrykk i ir_to_bytecode.no og mens-lykkja i bytecode_integrity.no).
# Køyrer gjennom KJELDE-kompilator + VM. Programmet ligg i
# tests/fixtures/r1_ellers_hvis.no.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/fixtures/r1_ellers_hvis.no")
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    assert_eq(tekst(vm.køyr_ncb(ncb)), "ein!to!anna!|eintoanna|ein..ikkje-positiv.|einanna")
    returner 0
}
