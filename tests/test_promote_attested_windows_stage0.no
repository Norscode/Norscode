bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/promote_attested_windows_stage0.no")
    assert(t.inneholder(src, "readiness.windows_attestasjon_ok(root, kandidat, attestasjon)"))
    assert(t.inneholder(src, "hash_fil(kandidat) != rapport_hash"))
    assert(t.inneholder(src, "tekst(data[\"source_commit\"]) != commit"))
    assert(t.inneholder(src, "godkjenn kritisk runtime-promotering"))
    assert(t.inneholder(src, "promotion.promoter(root, kandidat_rel, target_rel"))
    assert(t.inneholder(src, "promotion.gjenopprett(root, target_rel"))
    assert(t.inneholder(src, "stage0_manifest.skriv_manifest(root)"))
    assert(t.inneholder(src, "NORSCODE_PROMOTION_FINALIZE"))
    assert(t.inneholder(src, "bootstrap/stage0/rollback"))
    assert(t.inneholder(src, "build/windows/norscode_native_windows_x86_64.exe"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "sh -c"))
    assert(ikkje t.inneholder(src, "cp "))
    skriv("test_promote_attested_windows_stage0 OK\n")
    returner 0
}
