// Fase 7a/7c: uttrykk + presedens + parentesar + funksjonar I WHERE (via evaluatoren).
// Golden = ekte sqlite3 3.51.0. Inneheld òg inline-regresjon på eksisterande WHERE-features.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')")

    // NYTT: uttrykk i WHERE
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE alder + 3 > 39"), 3)
    // NYTT: presedens — AND binder tettare enn OR
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Bergen' OR alder > 50 AND alder < 60"), 2)
    // NYTT: parentesar
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE (by = 'Bergen' OR alder > 50) AND alder < 60"), 2)
    // NYTT: funksjon i WHERE
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE upper(navn) = 'ADA'"), "Ada")
    // NYTT: konkat i WHERE
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE navn || by = 'AdaOslo'"), 1)

    // REGRESJON: eksisterande WHERE-features via ny evaluator
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo'"), 3)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by != 'Oslo'"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE alder BETWEEN 30 AND 45"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE navn LIKE 'A%'"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE navn NOT LIKE 'A%'"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE alder IN (37, 55)"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo' AND alder > 40"), 2)

    returner 0
}
