bruk std.aes som aes

// Kjent-svar-test: AES-128 blokkchiffer mot FIPS-197.
//
// std.aes.aes128_encrypt_block er byggekloss for AES-128-GCM (TLS 1.3 sin
// obligatoriske AEAD, RFC 8446). Verifisert mot de to kanoniske FIPS-197-
// vektorane (Appendix C.1 og Appendix B). Ren byte-beregning — kjører i nc run.

funksjon _bytes(hex: tekst) -> liste_heiltall {
    la sifre = "0123456789abcdef"
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(hex) {
        la hi = builtin.index_of(sifre, builtin.slice(hex, i, i + 1))
        la lo = builtin.index_of(sifre, builtin.slice(hex, i + 1, i + 2))
        legg_til(ut, hi * 16 + lo)
        i = i + 2
    }
    returner ut
}

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la sifre = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(sifre, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(sifre, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    // FIPS-197 Appendix C.1.
    assert(_hex(aes.aes128_encrypt_block(_bytes("000102030405060708090a0b0c0d0e0f"),
        _bytes("00112233445566778899aabbccddeeff")))
        == "69c4e0d86a7b0430d8cdb78070b4c55a")

    // FIPS-197 Appendix B (cipher-eksempelet).
    assert(_hex(aes.aes128_encrypt_block(_bytes("2b7e151628aed2a6abf7158809cf4f3c"),
        _bytes("3243f6a8885a308d313198a2e0370734")))
        == "3925841d02dc09fbdc118597196a0b32")

    skriv("test_aes128_fips197: OK\n")
    returner 0
}
