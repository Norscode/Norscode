funksjon start() -> heiltall {
    la id_hex = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    la lyttar = builtin.network_operation({"operation": "tls_listen", "host": "127.0.0.1", "port": 0, "backlog": 16, "tls_id_hex": id_hex})
    skriv("listen: " + lyttar["status"] + " port=" + tekst(lyttar["port"]) + "\n")
    hvis lyttar["status"] != "listening" { returner 1 }
    la klient = builtin.network_operation({"operation": "tls_connect", "host": "127.0.0.1", "port": lyttar["port"], "hostname": "localhost"})
    skriv("connect: " + klient["status"] + "\n")
    hvis klient["status"] != "connected" { returner 1 }
    la srv = {"status": "ventande"}
    la n = 0
    mens srv["status"] == "ventande" og n < 200 {
        srv = builtin.network_operation({"operation": "accept", "handle": lyttar["handle"]})
        n = n + 1
    }
    skriv("accept: " + srv["status"] + " (forsøk " + tekst(n) + ")\n")
    hvis srv["status"] != "connected" { returner 1 }
    la ch = {"status": "ventande"}
    la sh = {"status": "ventande"}
    n = 0
    mens (ch["status"] != "connected" eller sh["status"] != "connected") og n < 400 {
        hvis ch["status"] != "connected" { ch = builtin.network_operation({"operation": "tls_handshake", "handle": klient["handle"]}) }
        hvis sh["status"] != "connected" { sh = builtin.network_operation({"operation": "tls_handshake", "handle": srv["handle"]}) }
        hvis ch["status"] == "feil" { skriv("klient-feil: " + ch["error"] + "\n") returner 1 }
        hvis sh["status"] == "feil" { skriv("tenar-feil: " + sh["error"] + "\n") returner 1 }
        n = n + 1
    }
    skriv("handshake: klient=" + ch["status"] + " tenar=" + sh["status"] + " (rundar " + tekst(n) + ")\n")
    hvis ch["status"] != "connected" eller sh["status"] != "connected" { returner 1 }
    skriv("tls=" + ch["tls_version"] + " cipher=" + ch["cipher"] + " verified=" + tekst(ch["peer_verified"]) + "\n")
    builtin.network_operation({"operation": "write", "handle": klient["handle"], "data": "hei-tenar-frå-klient"})
    la rd = {"status": "ventande"}
    n = 0
    mens rd["status"] == "ventande" og n < 200 {
        rd = builtin.network_operation({"operation": "read", "handle": srv["handle"], "max": "1024"})
        n = n + 1
    }
    skriv("tenar mottok: '" + rd["data"] + "'\n")
    hvis rd["data"] != "hei-tenar-frå-klient" { returner 1 }
    skriv("TLS_SOCKET_LOOPBACK_OK\n")
    returner 0
}
