funksjon krav(v: boolsk, melding: tekst) {
    hvis ikkje v { kast melding }
}

funksjon start() {
    la vm = fil_les("selfhost/vm.no")
    la bundler = fil_les("selfhost/bundler.no")
    la materialiser = fil_les("tools/materialize_l5_precompiled.no")

    krav(builtin.contains(vm, "returner json_skriv(args[0])"), "VM-broen må bruke typebevarande JSON")
    krav(builtin.contains(bundler, "funksjonar_utan_strengformat_markør"), "bundler må fjerne transportmarkøren")
    krav(builtin.contains(bundler, "la rå_bundle = json.json_skriv(bundle_ncb)"), "bundle må serialiserast typebevarande")
    krav(builtin.contains(materialiser, "fil_skriv(sti, builtin.json_skriv(cache))"), "cachematerialisering må bevare teksttypar")
    krav(builtin.contains(materialiser, "fn[\"module\"] == modular[modul_idx]"), "cachematerialisering må velje eksakt modul, ikkje prefiks")
    krav(builtin.contains(materialiser, "std.runtime.process_abi,selfhost.ncb_stream|bundler.ncb.json"), "bundler-cache må bevare Gen1-rekkjefølgja for transitive modular")
    // J1b: cachen er generert under build/, aldri committa bootstrap/precompiled.
    krav(ikkje builtin.contains(materialiser, "|bootstrap/precompiled/"), "cachematerialisering skriv ikkje til committa bootstrap/precompiled")
    krav(builtin.contains(materialiser, "katalog = \"build/l5/precompiled\""), "cachematerialisering har generert standardkatalog")
    la l5b = fil_les("tools/selfcompile_l5b.no")
    krav(builtin.contains(l5b, "returner root + \"/build/l5/precompiled\""), "L5b cache-på brukar generert cachekatalog")
    krav(builtin.contains(l5b, "root + \"/tools/materialize_l5_precompiled.no\""), "L5b cache-på materialiserer cachen frå Gen1")
    krav(ikkje builtin.contains(l5b, "root + \"/bootstrap/precompiled\""), "L5b les ikkje committa bootstrap/precompiled")
    skriv("test_l5b_cache_string_types_contract OK\n")
}
