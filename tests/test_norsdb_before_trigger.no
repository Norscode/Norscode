// BEFORE-triggere (INSERT/UPDATE/DELETE) med NEW/OLD. Golden = ekte sqlite3 3.51.0.
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")
    assert_eq(sql.exec(db, "CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT)"), 0)
    assert_eq(sql.exec(db, "CREATE TABLE audit (msg TEXT)"), 0)
    assert_eq(sql.exec(db, "CREATE TRIGGER bi BEFORE INSERT ON t BEGIN INSERT INTO audit VALUES('bi:'||NEW.v); END"), 0)
    assert_eq(sql.exec(db, "CREATE TRIGGER bu BEFORE UPDATE ON t BEGIN INSERT INTO audit VALUES('bu:'||OLD.v||'->'||NEW.v); END"), 0)
    assert_eq(sql.exec(db, "CREATE TRIGGER bd BEFORE DELETE ON t BEGIN INSERT INTO audit VALUES('bd:'||OLD.v); END"), 0)

    assert_eq(sql.exec(db, "INSERT INTO t (v) VALUES ('a')"), 1)
    assert_eq(sql.exec(db, "UPDATE t SET v='b' WHERE v='a'"), 1)
    assert_eq(sql.exec(db, "DELETE FROM t WHERE v='b'"), 1)

    // BEFORE-triggarane skreiv tre audit-rader i rett rekkjefølgje
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM audit"), 3)
    assert_eq(sql.query_rader(db, "SELECT msg FROM audit"), "bi:a\nbu:a->b\nbd:b")

    skriv("test_norsdb_before_trigger OK\n")
    returner 0
}
