bruk std.argon2id_pure som pure

funksjon linux_x86_64() -> bool {
    la info = builtin.system_info()
    returner builtin.starts_with(tekst(info["system"]), "Linux") og tekst(info["machine"]) == "x86_64"
}

funksjon start() -> heiltall {
    la rein = pure.hash_pure("password", "somesalt", 8, 1, 1, 32)
    la native: tekst = ""
    la tilgjengeleg = sann
    prøv {
        native = builtin.argon2id("password", "somesalt", 8, 1, 1, 32)
    } fang (e) {
        tilgjengeleg = usann
    }
    hvis ikkje tilgjengeleg {
        // Den ferske sjølv-hosta Linux-x86-64-seeden har builtin.argon2id i rein Norscode
        // (native_gap + atom). Der er HOPP ein feil, elles kunne porten aldri seie nei.
        hvis linux_x86_64() {
            skriv("test_argon2id_differential_optional FEIL: builtin.argon2id manglar på Linux x86-64")
            returner 1
        }
        skriv("test_argon2id_differential_optional HOPP: native adapter ikkje tilgjengeleg")
        returner 0
    }
    assert(rein == native)
    skriv("test_argon2id_differential_optional OK")
    returner 0
}
