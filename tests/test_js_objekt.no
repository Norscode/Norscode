bruk std.js_objekt som jso

# Samanliknar lister utan å vere avhengig av korleis tekst(liste) blir formatert
# i den einskilde køyraren.
funksjon flat_tekst(l) -> tekst {
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis i > 0 {
            ut = ut + ","
        }
        la element = l[i]
        hvis builtin.type(element) == "liste" {
            ut = ut + "(" + flat_tekst(element) + ")"
        } ellers {
            ut = ut + tekst(element)
        }
        i = i + 1
    }
    returner ut
}

funksjon dobbel(x: heltall) -> heltall {
    returner x * 2
}

funksjon er_stor(nøkkel: tekst, verdi: heltall) -> bool {
    returner verdi > 1
}

funksjon start() -> heiltall {
    la o = {"a": 1, "b": 2}

    # keys / values / entries
    assert_eq(flat_tekst(jso.nøklar_sortert(o)), "a,b")
    assert_eq(jso.hent(o, "a", 0), 1)
    assert_eq(jso.hent(o, "b", 0), 2)
    assert_eq(lengde(jso.verdiar(o)), 2)
    assert_eq(flat_tekst(jso.oppføringar_sorterte(o)), "(a,1),(b,2)")

    # fromEntries
    la bygd = jso.frå_oppføringar([["x", 1], ["y", 2]])
    assert_eq(bygd["x"], 1)
    assert_eq(bygd["y"], 2)

    # in / hasOwnProperty / ?? / lengde
    assert(jso.har(o, "a"))
    assert(ikkje jso.har(o, "z"))
    assert_eq(jso.hent(o, "a", 0), 1)
    assert_eq(jso.hent(o, "z", 0 - 1), 0 - 1)
    assert_eq(jso.antal(o), 2)
    assert(ikkje jso.er_tom(o))
    assert(jso.er_tom({}))

    # kopi endrar ikkje originalen
    la k = jso.kopi(o)
    k["a"] = 99
    assert_eq(o["a"], 1)
    assert_eq(k["a"], 99)

    # assign / spread
    la mål = {"a": 1}
    jso.tildel(mål, {"b": 2})
    assert_eq(mål["b"], 2)
    la saman = jso.slå_saman({"a": 1, "b": 1}, {"b": 2})
    assert_eq(saman["a"], 1)
    assert_eq(saman["b"], 2)

    # delete
    la utan_b = jso.utan(o, "b")
    assert(ikkje jso.har(utan_b, "b"))
    assert(jso.har(o, "b"))

    # map over verdiar / filter over oppføringar
    la dobla = jso.kart_verdiar(o, "dobbel")
    assert_eq(dobla["a"], 2)
    assert_eq(dobla["b"], 4)
    la store = jso.filtrer(o, "er_stor")
    assert_eq(flat_tekst(jso.nøklar_sortert(store)), "b")

    # invertert
    la snudd = jso.snu({"a": "1"})
    assert_eq(snudd["1"], "a")

    skriv("test_js_objekt OK\n")
    returner 0
}
