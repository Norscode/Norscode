// Postgres-utvidingar batch 2: ILIKE (case-insensitiv LIKE) + `::`-cast-syntaks.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la rad = {"navn": "Hello"}

    // ILIKE — case-insensitiv mønstermatch
    assert_eq(sql.evaluer_uttrykk("'Hello' ILIKE 'hello'", rad), "1")
    assert_eq(sql.evaluer_uttrykk("'Hello' ILIKE 'HEL%'", rad), "1")
    assert_eq(sql.evaluer_uttrykk("'Hello' ILIKE 'xyz%'", rad), "0")
    assert_eq(sql.evaluer_uttrykk("'Hello' NOT ILIKE 'xyz%'", rad), "1")

    // ::-cast — typen ignorerast, verdien går gjennom, parsing held fram
    assert_eq(sql.evaluer_uttrykk("'123'::int", rad), "123")
    assert_eq(sql.evaluer_uttrykk("'5'::int + 3", rad), "8")
    assert_eq(sql.evaluer_uttrykk("('a' || 'b')::text", rad), "ab")
    assert_eq(sql.evaluer_uttrykk("'5'::numeric(10,2)", rad), "5")
    assert_eq(sql.evaluer_uttrykk("-'5'::int", rad), "-5")

    // I ei ekte spørring: ILIKE i WHERE
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn) VALUES (1, 'Ada')")
    sql.exec(db, "INSERT INTO folk (id, navn) VALUES (2, 'ADA')")
    sql.exec(db, "INSERT INTO folk (id, navn) VALUES (3, 'Bob')")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE navn ILIKE 'ada'"), 2)
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE navn ILIKE 'a%' ORDER BY id"), "Ada\nADA")

    returner 0
}
