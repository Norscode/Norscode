bruk std.tekst som t

funksjon start() -> heiltall {
    la src = builtin.fil_les("tools/performance_benchmark.no")
    assert(t.inneholder(src, "norscode-performance-benchmark-v1"))
    assert(t.inneholder(src, "cold_compile"))
    assert(t.inneholder(src, "warm_compile"))
    assert(t.inneholder(src, "selfcompile-l5b"))
    assert(t.inneholder(src, "scope == \"l5b\" eller scope == \"full\""))
    assert(t.inneholder(src, "full_test"))
    assert(t.inneholder(src, "peak_rss_bytes"))
    assert(t.inneholder(src, "gc_pause_ms"))
    assert(t.inneholder(src, "__NORSCODE_TEST_SHARD_PEAK_RSS_SUM_BYTES__="))
    assert(t.inneholder(src, "deterministic_compile"))
    assert(t.inneholder(src, "full_test_måling[\"status\"] != \"passed\""))
    assert(t.inneholder(src, "l5b[\"status\"] != \"passed\""))
    assert(t.inneholder(src, "NORSCODE_L5B_BASELINE_RSS_BYTES"))
    assert(t.inneholder(src, "l5b_reduksjon_bp >= 4000"))
    assert(t.inneholder(src, "l5b_40_percent_target"))
    assert(t.inneholder(src, "varm_fart_bp >= 20000"))
    assert(t.inneholder(src, "warm_compile_2x_target"))
    assert(t.inneholder(src, "cold_source_reference"))
    assert(t.inneholder(src, "kald_forbetring_bp >= 3000"))
    assert(t.inneholder(src, "cold_compile_30_percent_target"))
    assert(t.inneholder(src, "NORSCODE_USE_PRECOMPILED_STDLIB"))
    assert(t.inneholder(src, "eller ikkje deterministisk"))
    assert(ikkje t.inneholder(src, "\"PATH\": \"/nonexistent\""))
    assert(ikkje t.inneholder(src, "sh -c"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(builtin.fil_finnes("tests/test_incremental_module_cache_live.no"))
    returner 0
}
