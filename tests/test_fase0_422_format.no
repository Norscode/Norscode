// Fase 0.7-regresjon: samla 422-format {detail:[{type,loc,msg,input}]} med rett
// JSON-escaping, likt i web, skjema og rest. Før fiksen hadde web/skjema/rest tre
// ulike feilformat og web.validation_error_body escapa feil (FA-030).

bruk std.web som web
bruk std.skjema som skjema
bruk std.rest som rest

funksjon start() -> heltall {
    // Grunnform og escaping av brukarinput (anførselsteikn, backslash)
    la loc: liste<tekst> = ["body", "na\"vn"]
    la post = web.valideringsfeil_post("value_error", loc, "på\"kravd", "x\\y")
    assert_eq(post, "{\"type\":\"value_error\",\"loc\":[\"body\",\"na\\\"vn\"],\"msg\":\"på\\\"kravd\",\"input\":\"x\\\\y\"}")

    la poster: liste<tekst> = [post]
    assert_eq(web.valideringsfeil_json(poster), "{\"detail\":[" + post + "]}")

    // Likt format i web, skjema og rest for same feil
    la feil: ordbok_tekst = {}
    feil["namn"] = "på\"kravd"
    la venta = web.valideringsfeil_json([web.valideringsfeil_post("value_error", ["body", "namn"], "på\"kravd", "")])

    la rest_resp = rest.valideringsfeil_detail(feil)
    assert_eq(web.response_status(rest_resp), 422)
    assert_eq(web.response_body(rest_resp), venta)

    la res_sk: ordbok_tekst = {}
    res_sk["feil"] = feil
    la skjema_resp = skjema.valideringsfeil_respons(res_sk)
    assert_eq(web.response_status(skjema_resp), 422)
    assert_eq(web.response_body(skjema_resp), venta)
    assert_eq(skjema.valideringsfeil_json(res_sk), venta)

    // web.valideringsfeil_respons gjev application/json
    assert_eq(web.response_header(rest_resp, "content-type"), "application/json; charset=utf-8")

    skriv("test_fase0_422_format OK")
    returner 0
}
