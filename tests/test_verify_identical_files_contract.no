bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/verify_identical_files.no")
    assert(t.inneholder(src, "NORSCODE_COMPARE_FILE_A"))
    assert(t.inneholder(src, "NORSCODE_COMPARE_FILE_B"))
    assert(t.inneholder(src, "bytes_a != bytes_b"))
    assert(t.inneholder(src, "sha256.hash_bytes"))
    assert(ikkje t.inneholder(src, "cmp -s"))
    skriv("test_verify_identical_files_contract OK\n")
    returner 0
}

