// Regresjon (Java-paritet F40): std.deque som ringbuffer (java.util.ArrayDeque).
// Før fiksen var legg_framme/pop_framme O(n) listeskift, og pop_* brukte
// fjern_indeks, som er stille no-op på x86-64-AOT (køa vart aldri tømd).
// No: O(1) amortisert i begge endar, generiske element, kapasiteten veks
// berre når bufferen er full (vakta nedanfor).
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.deque som dq

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon lj(l) -> tekst {
    la r = ""
    for x i l { r = r + tekst(x) + "," }
    returner r
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]

    // Typa heiltals-API (bakoverkompatibelt)
    la d = dq.ny_tall()
    dq.legg_framme_tall(d, 1)
    dq.legg_bak_tall(d, 2)
    dq.legg_bak_tall(d, 3)
    dq.legg_framme_tall(d, 0)
    sjekk(feil, "til_liste", lj(dq.til_liste(d)), "0,1,2,3,")
    sjekk(feil, "pop_framme/pop_bak", tekst(dq.pop_framme_tall(d)) + tekst(dq.pop_bak_tall(d)) + tekst(dq.storleik_tall(d)), "032")
    sjekk(feil, "framme/bak", tekst(dq.framme_tall(d)) + tekst(dq.bak_tall(d)), "12")
    dq.tøm_tall(d)
    sjekk(feil, "tøm", tekst(dq.er_tom_tall(d)) + tekst(dq.pop_framme_tall(d)), "sann0")

    // Generisk: blanda verdiar, ombrot og vekst frå framsida
    la g = dq.ny()
    la i = 0
    mens i < 20 {
        dq.legg_framme(g, i)
        i = i + 1
    }
    dq.legg_bak(g, "x")
    sjekk(feil, "vekst framme", tekst(dq.storleik(g)) + ":" + tekst(dq.framme(g)) + ":" + tekst(dq.bak(g)), "21:19:x")
    sjekk(feil, "hent", tekst(dq.hent(g, 0)) + tekst(dq.hent(g, 19)) + tekst(dq.hent(g, -1)), "190x")
    dq.sett(g, 1, "y")
    sjekk(feil, "sett", tekst(dq.hent(g, 1)), "y")
    sjekk(feil, "pop_bak generisk", tekst(dq.pop_bak(g)), "x")
    la kasta = usann
    prøv { dq.hent(g, 99) } fang (e) { kasta = sann }
    sjekk(feil, "hent utanfor kastar", tekst(kasta), "sann")
    la tom = dq.ny()
    sjekk(feil, "pop tom", builtin.type(dq.pop_framme(tom)), "ingenting")

    // Kø (FIFO): 3000 legg_bak + pop_framme med høgst 5 levande element.
    // Ringbufferen skal gjenbruke plassane (kapasitet 8, lista 10 lang).
    la q = dq.ny_tall()
    la sum = 0
    i = 0
    mens i < 3000 {
        dq.legg_bak_tall(q, i)
        hvis dq.storleik_tall(q) > 4 { sum = sum + dq.pop_framme_tall(q) }
        i = i + 1
    }
    mens ikkje dq.er_tom_tall(q) { sum = sum + dq.pop_framme_tall(q) }
    sjekk(feil, "kø-sum", tekst(sum), "4498500")
    sjekk(feil, "kapasitet gjenbrukt", tekst(lengde(q)), "10")

    // Stakk frå framsida (LIFO) over vekstgrensa
    la s = dq.ny_tekst()
    for t i ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"] { dq.legg_framme_tekst(s, t) }
    la ut = ""
    mens ikkje dq.er_tom_tekst(s) { ut = ut + dq.pop_framme_tekst(s) }
    sjekk(feil, "lifo framme", ut, "jihgfedcba")

    // Rotering og avgrensa deque
    la r = dq.frå_liste([1, 2, 3, 4, 5])
    dq.roter(r, 2)
    sjekk(feil, "roter 2", lj(dq.til_liste(r)), "4,5,1,2,3,")
    dq.roter_venstre_tall(r, 3)
    sjekk(feil, "roter venstre 3", lj(dq.til_liste(r)), "2,3,4,5,1,")
    la a = dq.ny_tall()
    i = 1
    mens i <= 6 {
        dq.legg_bak_avgrensa_tall(a, i, 3)
        i = i + 1
    }
    sjekk(feil, "avgrensa", lj(dq.til_liste(a)), "4,5,6,")

    hvis feil[0] == 0 { skriv("test_deque_ringbuffer OK\n") }
    returner feil[0]
}
