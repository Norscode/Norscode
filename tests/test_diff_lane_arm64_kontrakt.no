// A2: kontrakt for samanlikningssteget i tools/arm64_diff_lane.no (AOT == VM). Køyrer på
// alle vertar (ingen arm64 trengst): lagar ref/aot-filer syntetisk og krev at porten seier
// JA berre når alt er likt, og NEI ved skilnad, manglande AOT-output og feil fasit.
bruk tools.arm64_diff_lane som lane
bruk std.filops som filops

funksjon skriv_alle(dir: tekst, ref_endring: tekst) -> heiltall {
    lane.mappe(dir + "/ref")
    lane.mappe(dir + "/aot")
    for fx i lane.diff_fixturar() {
        la innhald = "linje for " + fx + "\nstatus=ferdig exit=42\n"
        la ref = innhald
        hvis fx == ref_endring { ref = "linje for " + fx + " (VM)\nstatus=ferdig exit=42\n" }
        fil_skriv(dir + "/ref/" + fx + ".txt", ref)
        fil_skriv(dir + "/aot/" + fx + ".txt", innhald)
    }
    la fasit = lane.aot_fasit()
    for fx i nøkler(fasit) { fil_skriv(dir + "/aot/" + tekst(fx) + ".txt", tekst(fasit[fx])) }
    returner 0
}

funksjon start() -> heiltall {
    la dir = "/tmp/norscode_a2_lane_" + builtin.random_hex(8)

    // Likt overalt → 0 feil.
    skriv_alle(dir, "")
    assert_eq(lane.steg_samanlikn(dir), 0)

    // Éi fixture skil seg (AOT != VM) → nøyaktig 1 feil.
    skriv_alle(dir, "arm64_diff_epoll")
    assert_eq(lane.steg_samanlikn(dir), 1)

    // Manglande AOT-output → feil (ikkje hoppa over).
    skriv_alle(dir, "")
    filops.slett_fil(dir + "/aot/arm64_diff_dns.txt")
    assert_eq(lane.steg_samanlikn(dir), 1)

    // Fasit for AOT-berre-fixturen må stemme byte for byte.
    skriv_alle(dir, "")
    fil_skriv(dir + "/aot/arm64_atom_probe.txt", "pid>0=sann\nstatus=ferdig exit=47\n")
    assert_eq(lane.steg_samanlikn(dir), 1)

    // A2-review: fail-open-entropi (output frå det gamle native_gap, abs(−EPERM) → 0x01)
    // er NEI mot fasiten, og fasitane krev fail-closed / 0 icache-feil.
    skriv_alle(dir, "")
    fil_skriv(dir + "/aot/aot_rng_failclosed.txt", "getrandom nekta: errno=1\nrandom_byte=-1\nrandom_hex_secure gav 0101010101010101 (FEIL: fail-open)\n_tls_random32 gav 32 byte (FEIL: fail-open)\nstatus=ferdig exit=57\n")
    assert_eq(lane.steg_samanlikn(dir), 1)
    la rng = tekst(lane.aot_fasit()["aot_rng_failclosed"])
    assert(builtin.contains(rng, "random_byte=-1"))
    assert(builtin.contains(rng, "random_hex_secure kasta: sann"))
    assert(builtin.contains(rng, "_tls_random32 kasta: sann"))
    assert(ikkje builtin.contains(rng, "fail-open"))
    assert(builtin.contains(tekst(lane.aot_fasit()["arm64_icache_probe"]), "200 kall, feil=0"))

    // Hjelparar: tolkens «[vm] …»-linjer er ikkje programoutput; statuslinja kjem sist.
    la r = {"stdout": "a\n[vm] entry returned\nb\n", "status": "ferdig", "exit_code": 7}
    assert_eq(lane.post(r, sann), "a\nb\nstatus=ferdig exit=7\n")
    assert_eq(lane.post(r, usann), "a\n[vm] entry returned\nb\nstatus=ferdig exit=7\n")
    assert_eq(lane.fyrste_skilnad("x\ny\n", "x\nz\n"), "linje 2: venta [y] fekk [z]")
    assert_eq(lane.fyrste_skilnad("x\n", "x\n"), "")
    assert_eq(lane.vert_frå("Linux", "aarch64"), "linux-arm64")
    assert_eq(lane.vert_frå("Linux", "x86_64"), "linux-x86_64")
    assert_eq(lane.vert_frå("Darwin", "arm64"), "macos-arm64")

    // Fasiten for atom-proben dekkjer alle A2-atoma.
    la fasit = tekst(lane.aot_fasit()["arm64_atom_probe"])
    for bit i ["mål=linux-arm64", "ebadf=-9", "l64=1234567890123", "fann_A2_=sann", "si=Linux/aarch64"] {
        assert(builtin.contains(fasit, bit))
    }
    filops.slett_tre(dir)
    returner 0
}
