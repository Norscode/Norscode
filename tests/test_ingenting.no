# M4 — `ingenting` skal vere ein distinkt verdi, ikkje heiltalet 0. Køyrer
# snuttar gjennom KJELDE-kompilator + VM. (Aktiv i ./bin/nc etter stage0-regen.)

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfør(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la r = vm.køyr_ncb(ncb)
    returner tekst(r)
}

funksjon start() -> heiltall {
    # type(ingenting) == "ingenting"
    la p1 = "funksjon start() -> tekst { returner builtin.type(ingenting) }\n"
    assert_eq(utfør(p1), "ingenting")

    # ingenting != 0
    la p2 = "funksjon start() -> tekst { hvis ingenting == 0 { returner \"lik0\" } returner \"ulik0\" }\n"
    assert_eq(utfør(p2), "ulik0")

    # ingenting == ingenting
    la p3 = "funksjon start() -> tekst { hvis ingenting == ingenting { returner \"lik\" } returner \"ulik\" }\n"
    assert_eq(utfør(p3), "lik")

    # manglande oppslag == ingenting  (idiomet som var broten)
    la p4 = "funksjon start() -> tekst {\n" +
        "    la m: ordbok_tekst = {}\n" +
        "    hvis m[\"finst_ikkje\"] == ingenting { returner \"tom\" }\n" +
        "    returner \"har\"\n" +
        "}\n"
    assert_eq(utfør(p4), "tom")

    # ingenting er falsy i hvis
    la p5 = "funksjon start() -> tekst { hvis ingenting { returner \"sann\" } returner \"falsy\" }\n"
    assert_eq(utfør(p5), "falsy")

    # ein sett verdi (ikkje ingenting) skal framleis vere seg sjølv
    la p6 = "funksjon start() -> heltall { la x: heltall = 5\n returner x }\n"
    assert_eq(utfør(p6), "5")

    skriv("test_ingenting OK\n")
    returner 0
}
