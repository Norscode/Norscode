bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/acme_pebble_ci.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "docker(argv: liste_tekst"))
    assert(t.inneholder(src, "PEBBLE_VA_ALWAYS_VALID=1"))
    assert(t.inneholder(src, "NORSCODE_ACME_CI_ACTION"))
    assert(t.inneholder(src, "http.request_full_ca(\"GET\", \"https://localhost:14000/dir\""))
    assert(t.inneholder(src, "http.response_ok(directory)"))
    assert(t.inneholder(src, "builtin.vent.sov(1000)"))
    assert(t.inneholder(src, "tid.sov(1000)"))
    assert(t.inneholder(src, "tid.monotonisk() - start_ms < 1000"))
    assert(ikkje t.inneholder(src, "/usr/bin/curl"))
    assert(ikkje t.inneholder(src, "/usr/bin/sleep"))
    assert(ikkje t.inneholder(src, "bash -lc"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_acme_pebble_ci_contract OK\n")
    returner 0
}
