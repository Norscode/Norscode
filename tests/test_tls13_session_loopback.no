bruk std.tls13_session som tls

funksjon _bytes(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(s) { legg_til(ut, builtin.char_code(builtin.slice(s, i, i+1)) & 255) i = i + 1 }
    returner ut
}
funksjon _lik(a: liste_heiltall, b: liste_heiltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) { hvis a[i] != b[i] { returner usann } i = i + 1 }
    returner sann
}
funksjon _seed(v: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < 32 { legg_til(ut, (v + i) & 255) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    la klient = tls.ny_klient({"priv": _seed(1), "hostname": "norscode.example"})
    la tenar = tls.ny_tenar({"priv": _seed(2), "id_seed": _seed(3)})

    # 1) Klient → ClientHello
    la ch = tls.start(klient)
    skriv("CH-lengd=" + tekst(lengde(ch)) + "\n")

    # 2) Tenar mottar CH → SH + kryptert flight
    la r1 = tls.motta(tenar, ch)
    skriv("tenar etter CH: status=" + r1["status"] + " feil=" + r1["feil"] + " ut=" + tekst(lengde(r1["ut"])) + "\n")
    hvis r1["status"] == "feil" { returner 1 }

    # 3) Klient mottar SH+flight → CFIN, klient etablert
    la r2 = tls.motta(klient, r1["ut"])
    skriv("klient etter flight: status=" + r2["status"] + " feil=" + r2["feil"] + " verified=" + tekst(klient["peer_verified"]) + " ver=" + klient["tls_version"] + "\n")
    hvis r2["status"] == "feil" { returner 1 }
    assert_eq(r2["status"], "ferdig")
    assert(klient["peer_verified"])
    assert_eq(klient["tls_version"], "TLSv1.3")

    # 4) Tenar mottar CFIN → etablert
    la r3 = tls.motta(tenar, r2["ut"])
    skriv("tenar etter CFIN: status=" + r3["status"] + " feil=" + r3["feil"] + "\n")
    hvis r3["status"] == "feil" { returner 1 }
    assert_eq(r3["status"], "ferdig")

    # 5) App-data: klient → tenar
    la m1 = _bytes("hei-tenar")
    la post1 = tls.krypter_app(klient, m1)
    la dec1 = tls.dekrypter_app(tenar, post1)
    skriv("tenar app: status=" + dec1["status"] + " lik=" + tekst(_lik(dec1["plaintext"], m1)) + "\n")
    assert_eq(dec1["status"], "ok")
    assert(_lik(dec1["plaintext"], m1))

    # 6) App-data: tenar → klient
    la m2 = _bytes("hei-klient-tilbake")
    la post2 = tls.krypter_app(tenar, m2)
    la dec2 = tls.dekrypter_app(klient, post2)
    assert_eq(dec2["status"], "ok")
    assert(_lik(dec2["plaintext"], m2))

    skriv("TLS_SESSION_M2A_OK\n")
    returner 0
}
