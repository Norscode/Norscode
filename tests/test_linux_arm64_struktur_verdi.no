// R4/F22: automatisk til_tekst og strukturell likskap for strukturar i linux-arm64-AOT
// (std.verdi_rt, implisitt i bygg-native når programmet har strukturar) gjev same utskrift
// som VM-en og x86-AOT (tests/fixtures/aot_x86_struktur_verdi.no + .forventa).
// Køyrer berre på Linux arm64-vert (eller med NORSCODE_VERIFY_LINUX_DOCKER=1 via Docker
// linux/arm64); elles hoppa over. Krev ein kryss-codegen med verdi_rt-stadene (reseed).

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_arm64() -> bool {
    la system = miljo_hent("NORSCODE_CI_SYSTEM")
    la maskin = miljo_hent("NORSCODE_CI_ARCH")
    hvis system == "" { system = miljo_hent("RUNNER_OS") }
    hvis maskin == "" { maskin = miljo_hent("RUNNER_ARCH") }
    hvis system == "" eller maskin == "" {
        prøv {
            la info = builtin.system_info()
            hvis system == "" { system = tekst(info["system"]) }
            hvis maskin == "" { maskin = tekst(info["machine"]) }
        } fang (e) {}
    }
    la linux = system == "Linux" eller system == "linux"
    la arm64 = maskin == "ARM64" eller maskin == "arm64" eller maskin == "aarch64"
    returner linux og arm64
}

funksjon nok_minne() -> bool {
    prøv {
        returner heltall_fra_tekst(tekst(builtin.system_info()["total_memory_bytes"])) >= 12884901888
    } fang (e) { returner sann }
    returner sann
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    // bygg-native (elf_arm64 whole-program-codegen) toppar ~8-10GB; standard 3GB-cap
    // + prosess.køyr sin 4GB drep den. Set høg cap og sandbox-grense.
    returner prosess.køyr_med_grenser(executable, argv, root, {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_PROCESS_MAX_MEMORY_BYTES": "12884901888",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms, 12884901888, 1024)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon docker_køyr(root: tekst, namn: tekst) -> ordbok_tekst {
    la docker = miljo_hent("NORSCODE_DOCKER_BIN")
    hvis docker == "" { docker = "docker" }
    returner køyr(docker, ["run", "--platform", "linux/arm64", "--rm", "-v", "/private/tmp:/work:ro", "alpine:3.20", "/work/" + namn], root, 180000)
}

funksjon start() -> heiltall {
    hvis ikkje nok_minne() { returner 0 }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la native = vert_linux_arm64()
    hvis ikkje native og miljo_hent("NORSCODE_VERIFY_LINUX_DOCKER") != "1" {
        skriv("test_linux_arm64_struktur_verdi: hoppa over (ikkje Linux arm64)\n")
        returner 0
    }
    la nc = runtime(root)
    la binær = "/tmp/norscode_arm64_struktur_verdi_" + builtin.random_hex(8)
    krev_exit(køyr(nc, ["bygg-native", "--target", "linux-arm64",
                        root + "/tests/fixtures/aot_x86_struktur_verdi.no", binær], root, 360000), 0)
    la r = {}
    hvis native {
        r = køyr(binær, [], root, 30000)
    } ellers {
        r = docker_køyr(root, builtin.slice(binær, 5, lengde(binær)))
    }
    krev_exit(r, 0)
    la ut = builtin.replace(tekst(r["stdout"]), "\\n", "\n")
    la forventa = fil_les(root + "/tests/fixtures/aot_x86_struktur_verdi.forventa")
    assert_eq(ut, "Punkt(x=5, y=6)\n" + forventa)
    filops.slett_fil(binær)
    skriv("test_linux_arm64_struktur_verdi OK\n")
    returner 0
}
