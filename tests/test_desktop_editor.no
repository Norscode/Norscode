bruk std.desktop_editor som editor
bruk std.desktop_text som tekstbuffer

la d = editor.nytt_dokument("fil.no", "Hei")
hvis editor.angre(d) { kast "tom undo" }
hvis ikkje editor.rediger(d, 3, 3, "!") { kast "innsetting" }
hvis d["text"] != "Hei!" { kast "endring" }
hvis ikkje editor.angre(d) { kast "angre" }
hvis d["text"] != "Hei" eller d["dirty"] != "usann" { kast "angre til lagret" }
hvis ikkje editor.gjor_om(d) { kast "gjør om" }
hvis d["text"] != "Hei!" { kast "redo tekst" }
hvis ikkje editor.angre(d) { kast "angre igjen" }
hvis ikkje editor.rediger(d, 0, 3, "Hallo") { kast "ny gren" }
hvis editor.gjor_om(d) { kast "redo må slettes" }
hvis d["text"] != "Hallo" { kast "sluttverdi" }
hvis editor.rediger(d, -1, 0, "x") { kast "ugyldig redigering" }
tekstbuffer.sett_lagret(d)
hvis d["dirty"] != "usann" { kast "lagret" }
skriv("desktop editor OK")
