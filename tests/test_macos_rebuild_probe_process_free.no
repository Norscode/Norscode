bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/probe_macos_native_rebuild_v722.no")
    assert(t.inneholder(src, "builtin.system_info()"))
    assert(t.inneholder(src, "builtin.bytes_to_text(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(src, "funksjon vis_binærinfo(sti: tekst) -> heiltall"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "strings "))
    assert(ikkje t.inneholder(src, "uname -"))
    assert(ikkje t.inneholder(src, "ls -lh"))
    skriv("test_macos_rebuild_probe_process_free OK")
    returner 0
}
