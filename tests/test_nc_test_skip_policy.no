bruk std.tekst som t

funksjon tel(haystack: tekst, needle: tekst) -> heiltall {
    returner lengde(builtin.split(haystack, needle)) - 1
}

funksjon start() -> heiltall {
    la src = fil_les("tools/nc_test.no")

    assert(t.inneholder(src, "funksjon er_tung_sjølvhost(namn: tekst) -> bool"))
    assert(t.inneholder(src, "funksjon er_slow(namn: tekst) -> bool"))
    assert(t.inneholder(src, "returner er_tung_sjølvhost(namn)"))
    assert(t.inneholder(src, "hvis er_tung_sjølvhost(namn) { returner sann }"))

    assert(tel(src, "\"test_chunk_2000.no\"") == 1)
    assert(tel(src, "\"test_chunk_end.no\"") == 1)
    assert(tel(src, "\"test_chunk_full.no\"") == 1)
    assert(tel(src, "\"test_chunk_tail.no\"") == 1)
    assert(tel(src, "\"test_selfhost.no\"") == 1)

    assert(t.inneholder(src, "hvis slow_mode og ikkje er_treg"))
    assert(t.inneholder(src, "hvis ikkje slow_mode og er_treg"))
    assert(t.inneholder(src, "hvis er_native_unsupported(namn)"))
    assert(t.inneholder(src, "NC_TEST_SKIP_OPTIONAL_NATIVE_CRYPTO"))
    assert(t.inneholder(src, "optional-native-crypto-adapter"))
    assert(t.inneholder(src, "bruk std.liste som liste"))
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "bruk std.runtime.process_abi som process_abi"))
    assert(t.inneholder(src, "liste.sorter_tekst(ut)"))
    assert(t.inneholder(src, "funksjon køyr_native(root: tekst, native: tekst, miljø: ordbok_tekst"))
    assert(t.inneholder(src, "process_abi.request(executable, [], root"))
    assert(t.inneholder(src, "builtin.process_spawn_argv(req)"))
    assert(t.inneholder(src, "compile_miljø[\"NORSCODE_HYBRID_SRC\"]"))
    assert(t.inneholder(src, "root + \"/tools/compile_with_hybrid_bundle_v9400.no\""))
    assert(t.inneholder(src, "la cache_val = env(\"NC_TEST_CACHE\")"))
    assert(t.inneholder(src, "env(\"NC_TEST_FILE\") == \"\" eller cache_val == \"1\""))
    assert(t.inneholder(src, "la use_cache = cache_val != \"0\""))
    assert(t.inneholder(src, "\"NORSCODE_VM_FAST\": \"0\""))
    assert(ikkje t.inneholder(src, "grep -Eq 'builtin\\\\.vm_"))
    assert(t.inneholder(src, "Køyrelane må ikkje avgjerast av teksttreff"))
    assert(t.inneholder(src, "test_vm_profiler_integration.no|"))
    assert(ikkje t.inneholder(src, "exec_prosess("))
    assert(ikkje t.inneholder(src, "root + \"/bin/nc\""))
    assert(ikkje t.inneholder(src, "hvis hybrid == \"\" { hybrid = root + \"/tools/compile_with_hybrid_bundle_v9400.sh\" }"))
    assert(ikkje t.inneholder(src, "test_*.no' | sort"))

    assert(ikkje builtin.fil_finnes("tools/nc_test.sh"))


    skriv("test_nc_test_skip_policy OK")
    returner 0
}
