// Vakt: tools/nc_test.no byggjer testkøyrar-NCB-en i ein kortliva barneprosess
// (tools/nc_test_forbered.no), ikkje i løparprosessen. Koding av test-NCB-ar i den
// langliva løparen fekk bump på den native GC-heapen til å krype ~45 MB per test, og
// slow-shardane døydde med «GC-heap full» (exit 199) etter ~250 testar.
bruk std.tekst som t

funksjon start() -> heiltall {
    la løpar = fil_les("tools/nc_test.no")
    assert(t.inneholder(løpar, "funksjon forbered_ncb_i_barn("))
    assert(t.inneholder(løpar, "\"/tools/nc_test_forbered.no\""))
    assert(ikkje t.inneholder(løpar, "oppdaging.forbered_ncb("))
    la barn = fil_les("tools/nc_test_forbered.no")
    assert(t.inneholder(barn, "oppdaging.forbered_ncb("))
    assert(t.inneholder(barn, "ut + \".plan\""))
    skriv("test_nc_test_forbered_barn OK\n")
    returner 0
}
