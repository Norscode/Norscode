// Fase 0.5-regresjon (b/c/d/e/f): tryggleiksfiksar i std utan reseed.

bruk std.web som web
bruk std.krypto som krypto
bruk std.auth som auth
bruk std.oauth som oauth
bruk std.cache som cache
bruk std.mw som mw

funksjon rate_ttl(c: ordbok_tekst) -> tekst {
    la t = builtin.json_parse_raw(c["__ttl__"])
    returner tekst(t["__rate__k"])
}

funksjon start() -> heltall {
    // 0.5b konstant-tid: require_bearer og verifiser_passord
    la bctx = web.request_context("get", "/x", {}, {"authorization": "Bearer hemmeleg-token"}, "")
    assert(web.require_bearer(bctx, "hemmeleg-token"))
    assert(ikkje web.require_bearer(bctx, "feil-token"))
    assert(web.konstant_tid_lik("abcDEF", "abcDEF"))
    assert(ikkje web.konstant_tid_lik("abc", "abd"))
    assert(ikkje web.konstant_tid_lik("abc", "abcd"))

    la salt = "s4lt"
    la h = krypto.pbkdf2_sha256("hemmel", salt, 120000, 32)
    assert(auth.verifiser_passord("hemmel", salt, h))
    assert(ikkje auth.verifiser_passord("gal", salt, h))
    assert(krypto.konstant_tid_lik("x", "x"))
    assert(ikkje krypto.konstant_tid_lik("x", "y"))

    // 0.5c b64url-padding: signer/usigner round-trip for ulike lengder
    la i: heltall = 0
    la grunn = ""
    mens i < 20 {
        grunn = grunn + "a"
        la sig = krypto.signer("nøkkel", grunn)
        assert_eq(krypto.usigner("nøkkel", sig), grunn)
        i = i + 1
    }
    // tukla signatur → kast (konstant-tid-samanlikning)
    la god = krypto.signer("nøkkel", "data")
    la tukla = builtin.slice(god, 0, lengde(god) - 1) + "X"
    la kasta: boolsk = usann
    prøv { krypto.usigner("nøkkel", tukla) } fang (e) { kasta = sann }
    assert(kasta)

    // 0.5d PKCE S256 = base64url(SHA256(verifier)), verifier bevart
    // RFC 7636 Appendix B testvektor
    assert_eq(krypto.pkce_s256_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"),
              "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM")
    la cfg: ordbok_tekst = {}
    cfg["auth_url"] = "https://id/authorize"
    cfg["client_id"] = "cid"
    cfg["redirect_uri"] = "https://a/cb"
    la pk = oauth.autoriser_url_pkce(cfg, "st", "openid")
    assert(lengde(tekst(pk["pkce_verifier"])) > 0)
    assert_eq(tekst(pk["code_challenge_method"]), "S256")
    assert_eq(tekst(pk["code_challenge"]), krypto.pkce_s256_challenge(tekst(pk["pkce_verifier"])))
    assert(builtin.contains(tekst(pk["url"]), "code_challenge_method=S256"))

    // 0.5e CSRF: metode-kasus normalisert, cookie-namn csrf_token konsistent
    la cfg_c = mw.csrf_cfg("s")
    la h_ok: ordbok_tekst = {}
    h_ok["x-csrf-token"] = "tok123"
    h_ok["cookie"] = "csrf_token=tok123"
    assert(mw.verifiser_csrf(web.request_context("post", "/x", {}, h_ok, ""), cfg_c))
    assert(mw.verifiser_csrf(web.request_context("PoSt", "/x", {}, h_ok, ""), cfg_c))
    assert(mw.verifiser_csrf(web.request_context("get", "/x", {}, h_ok, ""), cfg_c))
    la h_feil: ordbok_tekst = {}
    h_feil["x-csrf-token"] = "tok123"
    h_feil["cookie"] = "csrf_token=FEIL"
    assert(ikkje mw.verifiser_csrf(web.request_context("post", "/x", {}, h_feil, ""), cfg_c))

    // 0.5f rate_check glidande vindauge: TTL endrar seg ikkje over inkrement
    la c = cache.ny_minne()
    assert(cache.rate_check(c, "k", 2, 3600))
    la ttl1 = rate_ttl(c)
    assert(cache.rate_check(c, "k", 2, 3600))
    assert(ikkje cache.rate_check(c, "k", 2, 3600))
    la ttl2 = rate_ttl(c)
    assert_eq(ttl1, ttl2)

    skriv("test_fase0_tryggleik OK")
    returner 0
}
