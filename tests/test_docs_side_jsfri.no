# Fase 1 punkt 1.10: JS-fri, interaktiv dokumentasjonsside + modell→OpenAPI-wiring.
#
# Verifiserer:
#  - /docs-HTML gruppert etter tags, med parametrar, request-body og modell-skjema
#  - INGEN JavaScript i output (<script, on*=, javascript:)
#  - «Prøv»-skjema berre når DEV er på; CSRF-token i skjemaet
#  - prov_dispatch er AV som standard (404) og dispatchar når DEV på
#  - openapi.json har components/schemas med modellen og $ref frå rutene

bruk std.web som web
bruk std.docs_side som docs
bruk std.modell som modell
bruk std.tekst som t
bruk std.csrf som csrf

# ─── App-endepunkt (route_handlers-metadata frå web.route) ─────────────────────

funksjon list_brukarar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /brukere")
    la side = web.request_query_int(ctx, "side")
    returner web.response_builder(200, {"content-type": "application/json"}, "[]")
}

funksjon opprett_brukar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /brukere")
    la navn = web.request_json_field_or(ctx, "namn", "ukjent")
    returner web.response_builder(201, {"content-type": "application/json"}, "{\"ok\":true}")
}

funksjon hent_brukar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /brukere/{id:int}")
    returner web.response_builder(200, {"content-type": "application/json"}, "{\"id\":1}")
}

# ─── Modell ────────────────────────────────────────────────────────────────────

funksjon brukar_modell() -> ordbok {
    la m = modell.ny_modell()
    m = modell.legg(m, modell.felt("namn", "tekst"))
    m = modell.legg(m, modell.lengd(modell.felt("e_post", "tekst"), 3, 200))
    m = modell.legg(m, modell.valfri(modell.felt("alder", "heltall")))
    returner m
}

funksjon lag_oppsett() -> ordbok {
    la oppsett: ordbok = {}
    oppsett["tittel"] = "Brukar-API"
    oppsett["versjon"] = "2.0.0"
    oppsett["beskriving"] = "Demo for 1.10"
    oppsett["tags"] = {"standard": "Standard-ruter"}
    la mm: ordbok = {}
    mm["Brukar"] = modell.json_schema(brukar_modell())
    oppsett["modellar"] = mm
    la rm: ordbok = {}
    rm["opprett_brukar"] = {"request": "Brukar"}
    rm["hent_brukar"] = {"respons": "Brukar"}
    oppsett["rute_modell"] = rm
    returner oppsett
}

funksjon start() -> heltall {
    la oppsett = lag_oppsett()

    # ── openapi.json: components/schemas + $ref ──
    la spec = web.openapi_json_med(oppsett)
    assert(t.inneholder(spec, "\"components\":{\"schemas\":{\"Brukar\":"))
    assert(t.inneholder(spec, "\"$ref\":\"#/components/schemas/Brukar\""))
    assert(t.inneholder(spec, "\"minLength\":3"))
    assert(t.inneholder(spec, "\"maxLength\":200"))
    assert(t.inneholder(spec, "\"/brukere\""))
    assert(t.inneholder(spec, "\"/brukere/{id}\""))

    # ── docs-side (DEV på) ──
    la html = docs.side_html(oppsett, sant, "TESTTOKEN123")

    # Gruppert etter tags.
    assert(t.inneholder(html, "<section class=\"tag\"><h2>standard</h2>"))
    assert(t.inneholder(html, "Standard-ruter"))
    # Endepunkt synlege.
    assert(t.inneholder(html, "/brukere"))
    assert(t.inneholder(html, "/brukere/{id}"))
    assert(t.inneholder(html, "POST"))
    assert(t.inneholder(html, "GET"))
    # Parametrar.
    assert(t.inneholder(html, "Parametrar"))
    assert(t.inneholder(html, "<code>id</code>"))
    # Modell-skjema via $ref (request + respons).
    assert(t.inneholder(html, "Modell: <code>Brukar</code>"))
    assert(t.inneholder(html, "<code>namn</code>"))
    assert(t.inneholder(html, "<code>e_post</code>"))
    assert(t.inneholder(html, "Request-body"))
    assert(t.inneholder(html, "Responsar"))

    # JS-fri: ingen script/on-handlarar/javascript:.
    assert(ikkje t.inneholder(html, "<script"))
    assert(ikkje t.inneholder(html, "javascript:"))
    assert(ikkje t.inneholder(html, "onclick="))
    assert(ikkje t.inneholder(html, "onload="))
    assert(ikkje t.inneholder(html, "onerror="))
    assert(ikkje t.inneholder(html, "onsubmit="))
    assert(ikkje t.inneholder(html, "onmouseover="))
    assert(ikkje t.inneholder(html, "oninput="))
    assert(ikkje t.inneholder(html, "onchange="))

    # «Prøv»-skjema med CSRF-token.
    assert(t.inneholder(html, "<form"))
    assert(t.inneholder(html, ">Prøv<"))
    assert(t.inneholder(html, "TESTTOKEN123"))
    assert(t.inneholder(html, "name=\"" + csrf.felt_namn() + "\""))

    # ── docs-side (DEV av) → ingen «Prøv» ──
    la html_prod = docs.side_html(oppsett, usann, "TESTTOKEN123")
    assert(ikkje t.inneholder(html_prod, "<form"))
    assert(ikkje t.inneholder(html_prod, "TESTTOKEN123"))
    assert(ikkje t.inneholder(html_prod, ">Prøv<"))
    # Framleis JS-fri.
    assert(ikkje t.inneholder(html_prod, "<script"))
    assert(ikkje t.inneholder(html_prod, "javascript:"))

    # ── prov_dispatch: av i produksjon ──
    la form_body = csrf.felt_namn() + "=TOK&__metode=GET&__sti=/brukere/5&__kropp="
    la ctx_prod = web.request_context("POST", docs.prov_sti(), {},
        {"content-type": "application/x-www-form-urlencoded", "cookie": csrf.cookie_namn() + "=TOK"},
        form_body)
    la resp_av = docs.prov_dispatch(ctx_prod, usann)
    assert(web.response_status(resp_av) == 404)

    # ── prov_dispatch: på + gyldig CSRF → dispatchar GET /brukere ──
    la resp_på = docs.prov_dispatch(ctx_prod, sant)
    assert(web.response_status(resp_på) == 200)
    assert(t.inneholder(web.response_body(resp_på), "Status: 200"))

    # ── prov_dispatch: på men CSRF-mismatch → 403 ──
    la ctx_feil = web.request_context("POST", docs.prov_sti(), {},
        {"content-type": "application/x-www-form-urlencoded", "cookie": csrf.cookie_namn() + "=ANNA"},
        form_body)
    la resp_feil = docs.prov_dispatch(ctx_feil, sant)
    assert(web.response_status(resp_feil) == 403)

    skriv("test_docs_side_jsfri OK")
    returner 0
}
