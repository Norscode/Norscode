bruk std.socket som socket
bruk std.ws som ws

// WebSocket-transport ende-til-ende over ekte native loopback-socket.
//
// Verifiserer at std.ws sender/mottek ekte RFC 6455-frames over
// std.socket (native_skriv_hex/native_les_hex) — ikkje dei fantom-
// builtin.ws_*-kalla som ikkje finst. Krev net.tcp med scope 127.0.0.1
// (gitt av testløparen; sjå tools/nc_test.no).

funksjon start() -> heiltall {
    la listener = socket.native_lytt("127.0.0.1", 0, 16)
    assert(tekst(listener["status"]) == "listening")
    la port = heltall_fra_tekst(tekst(listener["port"]))

    la client_sock = socket.native_tilkoble("127.0.0.1", port)
    la server_sock = socket.native_aksepter(listener)
    assert(tekst(server_sock["status"]) == "connected")

    la server = ws.ny_tilkopling("s1", {})
    ws.fest_socket(server, server_sock)
    la client = ws.ny_tilkopling("c1", {})
    ws.fest_socket(client, client_sock)

    // Server → klient: umaskert tekst-frame (RFC 6455 §5.1).
    ws.send(server, "Hei frå server")
    assert(ws.motta(client) == "Hei frå server")

    // Klient → server: binær-sikker payload med newline.
    ws.send(client, "ping\n123")
    assert(ws.motta(server) == "ping\n123")

    // UTF-8-byte overlever roundtrip.
    ws.send(server, "blåbær 200%")
    assert(ws.motta(client) == "blåbær 200%")

    // Pen lukking: close-frame set klienten til lukka.
    ws.lukk(server)
    ws.motta(client)
    assert(ikkje ws.er_open(client))

    socket.native_lukk(listener)
    skriv("test_ws_transport_loopback: OK (6 assertar)\n")
    returner 0
}
