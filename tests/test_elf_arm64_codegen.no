bruk selfhost.native_execution.elf_arm64_codegen som codegen
bruk selfhost.native_execution.macho_arm64_codegen som arm64
bruk selfhost.native_execution.heap_layout som hl

// Same kjelde/modul -> tekst-signatur som den baka selfhost-kompilatoren.
// Hjelparkallet krev at gap-ruting òg held transitive avhengigheiter nåbare.
funksjon kompiler_probe(kallnamn: tekst) {
    returner {"entry": "probe.start", "functions": {
        "probe.start": {"params": [], "code": [
            ["TRY_BEGIN", "feil"],
            ["PUSH_CONST", "kjelde"], ["PUSH_CONST", "modul"], ["CALL", kallnamn, 2],
            ["TRY_END"], ["RETURN"], ["LABEL", "feil"], ["LOAD_EXCEPTION"], ["RETURN"]]},
        "selfhost.kompiler.kompiler_fil": {"params": ["kjelde", "modul"], "code": [
            ["LOAD_NAME", "kjelde"], ["LOAD_NAME", "modul"],
            ["CALL", "probe.kompiler_tekst", 2], ["RETURN"]]},
        "probe.kompiler_tekst": {"params": ["kjelde", "modul"], "code": [
            ["LOAD_NAME", "kjelde"], ["PUSH_CONST", ":"], ["BINARY_ADD"],
            ["LOAD_NAME", "modul"], ["BINARY_ADD"], ["RETURN"]]}
    }}
}

funksjon har_bytar(img, venta) -> boolsk {
    la i = 0
    mens i + lengde(venta) <= lengde(img) {
        la j = 0
        mens j < lengde(venta) og img[i + j] == venta[j] { j = j + 1 }
        hvis j == lengde(venta) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon sjekk_kompiler_builtin() -> heiltall {
    assert_eq(arm64.ncval_gap_rute("builtin.kompiler_fil"), "selfhost.kompiler.kompiler_fil")
    assert_eq(arm64.ncval_gap_rute("kompiler_fil"), "selfhost.kompiler.kompiler_fil")
    assert_eq(arm64.ncval_gap_rute("annan.kompiler_fil"), "")
    assert_eq(arm64.ncval_gap_rute("builtin.kompiler_fil_aktiv"), "std.native_gap.kompiler_fil_aktiv")
    la gammal_rapport = miljo_hent("NC_BUILTIN_REPORT")
    miljo_sett("NC_BUILTIN_REPORT", "1")
    for os i ["linux", "macos"] {
        la direkte = arm64.ncval_compile_program(kompiler_probe("selfhost.kompiler.kompiler_fil"), os)
        hvis direkte["ok"] != "sann" { arm64.ncval_rapport_skriv() kast tekst(direkte["error"]) }
        assert_eq(direkte["ok"], "sann")
        la stubb = []
        arm64.emit_ncval_str_const(stubb, "NATIV-GAP:kompiler_fil", 11)
        for namn i ["builtin.kompiler_fil", "kompiler_fil"] {
            la ruta = arm64.ncval_compile_program(kompiler_probe(namn), os)
            assert_eq(ruta["ok"], "sann")
            assert(builtin.har_nokkel(ruta["fn_start"], "selfhost.kompiler.kompiler_fil"))
            assert(builtin.har_nokkel(ruta["fn_start"], "probe.kompiler_tekst"))
            // Byte-identisk med eit vanleg to-argumentskall: same NcVal-register,
            // argumentrekkjefølgje og uendra tekstretur. Ingen ARM64-køyring her.
            la a = ruta["image"]
            la b = direkte["image"]
            assert_eq(lengde(a), lengde(b))
            la i = 0
            mens i < lengde(a) { assert_eq(a[i], b[i]) i = i + 1 }
            assert(ikkje har_bytar(a, stubb))
            skriv("kompiler-ABI " + os + " " + namn + ": venta stubba=0\n")
            assert_eq(arm64.ncval_rapport_skriv(), 0)
        }

        // Ein namnelik brukarfunksjon skal ikkje kapre builtin-en når den
        // eksakte baka kompilatoren manglar. Bevar fangbar NATIV-GAP.
        la utan = kompiler_probe("builtin.kompiler_fil")
        utan["functions"]["annan.kompiler_fil"] = utan["functions"]["selfhost.kompiler.kompiler_fil"]
        builtin.fjern_nokkel(utan["functions"], "selfhost.kompiler.kompiler_fil")
        la manglar = arm64.ncval_compile_program(utan, os)
        assert_eq(manglar["ok"], "sann")
        assert(ikkje builtin.har_nokkel(manglar["fn_start"], "annan.kompiler_fil"))
        assert(har_bytar(manglar["image"], stubb))
        skriv("kompiler-ABI " + os + " utan kompilator: venta stubba=1\n")
        assert_eq(arm64.ncval_rapport_skriv(), 0)

        // *_aktiv må framleis gå til den native fail-closed-funksjonen,
        // sjølv om ein baka kompilator finst. Aktiv VM-rute blir testa separat.
        la aktiv = kompiler_probe("builtin.kompiler_fil_aktiv")
        aktiv["functions"]["std.native_gap.kompiler_fil_aktiv"] = {
            "params": ["kjelde", "modul"], "code": [
                ["PUSH_CONST", "krev aktiv NCB"], ["THROW"], ["PUSH_CONST", 0], ["RETURN"]]}
        la ar = arm64.ncval_compile_program(aktiv, os)
        assert_eq(ar["ok"], "sann")
        assert(builtin.har_nokkel(ar["fn_start"], "std.native_gap.kompiler_fil_aktiv"))
        assert(ikkje builtin.har_nokkel(ar["fn_start"], "selfhost.kompiler.kompiler_fil"))

        // Eitt eller tre argument må ikkje sende uinitialiserte/feil register
        // til den faste (kjelde, modul)-signaturen.
        miljo_sett("NC_BUILTIN_REPORT", "0")
        for tal i [1, 3] {
            la ugyldig = kompiler_probe("builtin.kompiler_fil")
            la kode = []
            la a = 0
            mens a < tal { legg_til(kode, ["PUSH_CONST", "arg"]) a = a + 1 }
            legg_til(kode, ["CALL", "builtin.kompiler_fil", tal])
            legg_til(kode, ["RETURN"])
            ugyldig["functions"]["probe.start"]["code"] = kode
            la ur = arm64.ncval_compile_program(ugyldig, os)
            assert_eq(ur["ok"], "usann")
            assert(builtin.contains(tekst(ur["error"]), "kompiler_fil krev 2 argument"))
        }
        miljo_sett("NC_BUILTIN_REPORT", "1")
    }
    miljo_sett("NC_BUILTIN_REPORT", gammal_rapport)
    returner 0
}

funksjon start() -> heiltall {
    sjekk_kompiler_builtin()
    la ncb = {
        "entry": "__main__.start",
        "functions": {
            "__main__.start": {
                "params": [],
                "code": [["PUSH_CONST", 7], ["PUSH_CONST", 5], ["BINARY_ADD"], ["RETURN"]]
            }
        }
    }
    la sti = "/tmp/norscode_elf_arm64_codegen_" + builtin.random_hex(8)
    la resultat = codegen.kompiler_ncb(ncb, sti)
    assert_eq(resultat["ok"], "sann")
    assert_eq(resultat["format"], "ELF64 AArch64")
    // kompiler_ncb strøymer biletet til fil (sparar minne i kryss-codegen); les bytane frå
    // fila i staden for frå returen (som er [] for store seed-bilete).
    la res_img = builtin.fil_les_binær(sti)
    assert_eq(res_img[0], 0x7F)
    prøv { builtin.fil_slett(sti) } fang (e) {}

    // A0-review: pbkdf2_sha256/hmac_sha256(tekst) skal IKKJE rutast (ruta til
    // std.sha256.pbkdf2_hex gav feil PBKDF2; tekst-hmac kan ikkje rutast utan
    // rekursjon) — stubben kastar NATIV-GAP og krypto fell til rein kode.
    assert_eq(arm64.ncval_gap_rute("builtin.pbkdf2_sha256"), "")
    assert_eq(arm64.ncval_gap_rute("builtin.hmac_sha256"), "")
    assert(arm64.ncval_gap_stub("builtin.pbkdf2_sha256"))
    assert(arm64.ncval_gap_stub("builtin.hmac_sha256"))
    // Fullhost importerer rå-minne-Argon2id. Ruta må både velje han og halde
    // kroppen nåbar, elles blir builtin.argon2id ein NATIV-GAP-stubb på ARM64.
    assert_eq(arm64.ncval_gap_rute("builtin.argon2id"), "std.argon2id_pure.hash_raw_hex")
    la argon_funksjonar = {
        "probe.start": {"params": [], "code": [["CALL", "builtin.argon2id", 6], ["RETURN"]]},
        "std.argon2id_pure.hash_raw_hex": {"params": [], "code": [["PUSH_CONST", "hash"], ["RETURN"]]}
    }
    la argon_nåbar = arm64.ncval_reachable("probe.start", argon_funksjonar, [], sann)
    assert(builtin.contains(builtin.join(argon_nåbar, ","), "std.argon2id_pure.hash_raw_hex"))
    // M1: gap-ruting er på for både Linux-ELF og Mach-O (Mach-O-taket er løfta; native_gap
    // vel Darwin-tabellane i std.native_sys).
    assert(arm64.ncval_ruting_aktiv("macos"))
    assert(arm64.ncval_ruting_aktiv("linux"))

    // A2: plattformmål og heap-base (heap_layout) for AArch64.
    assert_eq(arm64.ncval_mål("linux"), "linux-arm64")
    assert_eq(arm64.ncval_mål("macos"), "macos-arm64")
    assert_eq(hl.HEAP_VA("linux-arm64"), 68719476736)     // 0x10_0000_0000
    assert_eq(hl.HEAP_VA("macos-arm64"), 824633720832)    // 0xC0_0000_0000
    assert_eq(hl.HEAP_VA("linux-x86_64"), 7864320)        // x86 uendra

    // A2: OS-vegane går til std.native_gap via den delte rutetabellen (gap_ruter.no).
    assert(arm64.ncval_os_rute_namn("builtin.socket_new"))
    assert(arm64.ncval_os_rute_namn("builtin.process_spawn_argv"))
    assert(arm64.ncval_os_rute_namn("builtin.network_operation"))
    assert(arm64.ncval_os_rute_namn("builtin.dns_lookup"))
    assert(ikkje arm64.ncval_os_rute_namn("builtin.skriv"))
    assert(ikkje arm64.ncval_os_rute_namn("builtin.exec_prosess"))
    assert_eq(arm64.ncval_gap_rute("builtin.socket_new"), "std.native_gap.socket_new")
    assert_eq(arm64.ncval_gap_rute("builtin.socket_recv_bytes"), "std.native_gap.socket_recv_bytes")
    assert_eq(arm64.ncval_gap_rute("builtin.process_spawn_argv"), "std.native_gap.process_spawn_argv_gap")
    assert_eq(arm64.ncval_gap_rute("builtin.network_operation"), "std.native_gap.network_operation")
    assert_eq(arm64.ncval_gap_rute("builtin.dns_lookup"), "std.native_gap.dns_lookup")
    assert_eq(arm64.ncval_gap_rute("builtin.kompiler_fil_aktiv"), "std.native_gap.kompiler_fil_aktiv")
    assert_eq(arm64.ncval_gap_rute("builtin.db.open"), "std.db.open")
    // A5: JIT-en har AArch64-senking i std.native_gap (a64-greina i _jit_senk).
    assert_eq(arm64.ncval_gap_rute("builtin.jit_operation"), "std.native_gap.jit_operation")
    // Ikkje i den delte tabellen for ARM64: eigne emitterar / x86-atom som manglar.
    assert_eq(arm64.ncval_gap_rute("builtin.sha256_bytes"), "")
    assert_eq(arm64.ncval_gap_rute("builtin.random_hex"), "")
    assert_eq(arm64.ncval_gap_rute("builtin.exec_prosess"), "")

    // A2: sokkel utan std.native_gap i bunten er kompileringsfeil på Linux-ELF (som x86
    // sin process_spawn_argv), ikkje ein stille inline-emitter.
    la utan_gap = {
        "entry": "__main__.start",
        "functions": {
            "__main__.start": {
                "params": [],
                "code": [["PUSH_CONST", 2], ["PUSH_CONST", 1], ["CALL", "builtin.socket_new", 2], ["RETURN"]]
            }
        }
    }
    la r2 = codegen.kompiler_ncb(utan_gap, sti)
    assert_eq(r2["ok"], "usann")
    assert(builtin.contains(tekst(r2["error"]), "krev std.native_gap"))
    prøv { builtin.fil_slett(sti) } fang (e2) {}

    // A2: atoma kompilerer for Linux-ELF (sys6 i mem-modus: 7 operandar).
    la atom = {
        "entry": "__main__.start",
        "functions": {
            "__main__.start": {
                "params": [],
                "code": [["PUSH_CONST", 172], ["PUSH_CONST", 0], ["PUSH_CONST", 0], ["PUSH_CONST", 0],
                         ["PUSH_CONST", 0], ["PUSH_CONST", 0], ["PUSH_CONST", 0], ["CALL", "builtin.sys6", 7],
                         ["POP"], ["CALL", "builtin.native_target", 0], ["POP"],
                         ["CALL", "builtin.native_envp", 0], ["CALL", "builtin.raw_load64", 1], ["POP"],
                         ["CALL", "builtin.random_byte", 0], ["POP"],
                         ["CALL", "builtin.system_info", 0], ["POP"],
                         ["PUSH_CONST", 0], ["RETURN"]]
            }
        }
    }
    la r3 = codegen.kompiler_ncb(atom, sti)
    assert_eq(r3["ok"], "sann")
    // svc #0 (0xD4000001, little-endian) finst i biletet. Les frå fila (returen gjev [] for store bilete).
    la r3_img = builtin.fil_les_binær(sti)
    la img = r3_img
    la fann_svc = usann
    la bi = 0
    mens bi + 3 < lengde(img) og ikkje fann_svc {
        hvis img[bi] == 1 og img[bi + 1] == 0 og img[bi + 2] == 0 og img[bi + 3] == 212 { fann_svc = sann }
        bi = bi + 4
    }
    assert(fann_svc)
    prøv { builtin.fil_slett(sti) } fang (e3) {}

    // A2-review: den pensjonerte builtin.exec_prosess kompilerer på Linux-ELF til NATIV-GAP-
    // stubben (fangbar ved køyring, som VM-en sin «builtin.exec_prosess er fjerna»), ikkje til
    // den macOS-berre inline-emitteren (som kasta eit ufanga unnatak i heile codegen-en).
    la exec_ncb = {
        "entry": "__main__.start",
        "functions": {
            "__main__.start": {
                "params": [],
                "code": [["PUSH_CONST", 0], ["CALL", "builtin.exec_prosess", 1], ["POP"],
                         ["PUSH_CONST", 0], ["RETURN"]]
            }
        }
    }
    la r4 = codegen.kompiler_ncb(exec_ncb, sti)
    assert_eq(r4["ok"], "sann")
    prøv { builtin.fil_slett(sti) } fang (e4) {}

    // A2-review: native_gap ER i bunten men manglar målet (builtin.socket_read finst ikkje i
    // std.native_gap) → feilmeldinga seier det, og ber IKKJE om ein import som alt finst.
    la gap_ncb = {
        "entry": "__main__.start",
        "functions": {
            "__main__.start": {
                "params": [],
                "code": [["PUSH_CONST", 3], ["PUSH_CONST", 10], ["CALL", "builtin.socket_read", 2], ["RETURN"]]
            },
            "std.native_gap.socket_new": {
                "params": ["af", "type"],
                "code": [["PUSH_CONST", 0], ["RETURN"]]
            }
        }
    }
    la r5 = codegen.kompiler_ncb(gap_ncb, sti)
    assert_eq(r5["ok"], "usann")
    assert(builtin.contains(tekst(r5["error"]), "std.native_gap har ingen"))
    assert(builtin.contains(tekst(r5["error"]), "std.native_gap.socket_read"))
    assert(ikkje builtin.contains(tekst(r5["error"]), "legg til"))
    // … medan manglande native_gap framleis ber om importen (r2 over).
    assert(builtin.contains(tekst(r2["error"]), "legg til `bruk std.native_gap`"))

    // A2-review: icache_sync(adr, n) kompilerer for Linux-ELF og emitterer dc cvau / ic ivau /
    // isb (I-cache-vedlikehald før raw_call på sjølvskriven kode).
    la ic_ncb = {
        "entry": "__main__.start",
        "functions": {
            "__main__.start": {
                "params": [],
                "code": [["PUSH_CONST", 4096], ["PUSH_CONST", 8], ["CALL", "builtin.icache_sync", 2], ["RETURN"]]
            }
        }
    }
    la r6 = codegen.kompiler_ncb(ic_ncb, sti)
    assert_eq(r6["ok"], "sann")
    la r6_img = builtin.fil_les_binær(sti)
    assert(har_ord(r6_img, 3574299438))     // 0xD50B7B2E dc cvau, x14
    assert(har_ord(r6_img, 3574297902))     // 0xD50B752E ic ivau, x14
    assert(har_ord(r6_img, 3573759967))     // 0xD5033FDF isb
    assert(har_ord(r6_img, 3577413675))     // 0xD53B002B mrs x11, ctr_el0 (Linux: linjelengd frå CTR_EL0)
    prøv { builtin.fil_slett(sti) } fang (e6) {}
    // macOS: CTR_EL0 trappar på EL0 (målt SIGILL på Apple M3) → fast 64-byte-steg, ingen mrs.
    la r6m = arm64.ncval_compile_program(ic_ncb, "macos")
    assert_eq(r6m["ok"], "sann")
    assert(har_ord(r6m["image"], 3574299438))    // dc cvau, x14
    assert(ikkje har_ord(r6m["image"], 3577413675))
    assert(har_ord(r6m["image"], 3531606028))    // 0xD280080C movz x12, #64

    // A2-review: random_byte feilar lukka (−errno, EINTR på nytt) og heap-init skil «mmap
    // feila» (errno) frå «VA opptatt» (EEXIST / anna adresse).
    assert(har_ord(r3_img, 2969571359))     // 0xB100101F cmn x0, #4 (−EINTR → igjen)
    assert(har_ord(r3_img, 2592714761))     // 0x9A89B009 csel x9, x0, x9, lt (−errno / −EIO)
    assert(har_ord(r3_img, 2973760543))     // 0xB13FFC1F cmn x0, #4095 (heap: errno-område)
    assert(har_ord(r3_img, 2969584671))     // 0xB100441F cmn x0, #17 (heap: −EEXIST)
    returner 0
}

// Finst det 32-bits ordet `ord` (little-endian, 4-justert) i biletet?
funksjon har_ord(img, ord: heiltall) -> boolsk {
    la b0 = ord & 255
    la b1 = (ord >> 8) & 255
    la b2 = (ord >> 16) & 255
    la b3 = (ord >> 24) & 255
    la i = 0
    mens i + 3 < lengde(img) {
        hvis img[i] == b0 og img[i + 1] == b1 og img[i + 2] == b2 og img[i + 3] == b3 { returner sann }
        i = i + 4
    }
    returner usann
}
