bruk std.dns som dns

// Kjent-svar-test: DNS wire-query-encoding mot RFC 1035.
//
// std.dns.wire_query(namn, type, id) bygger en DNS-spørrepakke som resolveren
// og mail-MX-/ACME-dns-01-flyten sender på tråden. Byte-nøyaktighet er
// avgjørende for ekte DNS-interop. Pakkestruktur: 12-byte header
// (ID | flags 0x0100 RD=1 | QDCOUNT=1 | ANCOUNT/NSCOUNT/ARCOUNT=0), deretter
// QNAME (lengde-prefiksede labels avslutta med 0x00), QTYPE og QCLASS 0x0001 (IN).
// Ren byte-beregning — kjører uten socket/native.

funksjon _hex(bytes) -> tekst {
    la sifre = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(sifre, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(sifre, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    // A, id 0x1234: header + 08"norscode" 02"no" 00 + QTYPE 0001 + QCLASS 0001.
    assert(_hex(dns.wire_query("norscode.no", "A", 4660)) == "123401000001000000000000086e6f7273636f6465026e6f0000010001")

    // Same navn/id, ulike record-typer (QTYPE-koden per RFC 1035).
    assert(_hex(dns.wire_query("norscode.no", "MX", 4660)) == "123401000001000000000000086e6f7273636f6465026e6f00000f0001")
    assert(_hex(dns.wire_query("norscode.no", "TXT", 1)) == "000101000001000000000000086e6f7273636f6465026e6f0000100001")
    assert(_hex(dns.wire_query("norscode.no", "CNAME", 1)) == "000101000001000000000000086e6f7273636f6465026e6f0000050001")
    assert(_hex(dns.wire_query("norscode.no", "NS", 1)) == "000101000001000000000000086e6f7273636f6465026e6f0000020001")
    assert(_hex(dns.wire_query("norscode.no", "AAAA", 1)) == "000101000001000000000000086e6f7273636f6465026e6f00001c0001")

    // Fler-label-navn: 01 'a' | 07 'example' | 03 'com' | 00.
    assert(_hex(dns.wire_query("a.example.com", "A", 1)) == "0001010000010000000000000161076578616d706c6503636f6d0000010001")

    skriv("test_dns_wire_query: OK\n")
    returner 0
}
