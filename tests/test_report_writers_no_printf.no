bruk std.tekst som t

funksjon krev_fil_skriv(sti: tekst, markor: tekst) {
    la src = fil_les(sti)
    assert(t.inneholder(src, markor))
    assert(t.inneholder(src, "builtin.fil_skriv"))
    assert(ikkje t.inneholder(src, "printf '%s' \" + shell(body)"))
}

funksjon start() -> heiltall {
    krev_fil_skriv("tools/compiler_stage_snapshot.no", "hashes.txt")
    krev_fil_skriv("tools/compiler_snapshot_compare.no", "compiler_snapshot_compare_report.txt")
    krev_fil_skriv("tools/unified_bootstrap_verifier.no", "unified_bootstrap_verification.txt")
    krev_fil_skriv("tools/bootstrap_artifact_pipeline.no", "artifact_manifest.txt")

    la stage = fil_les("tools/compiler_stage_snapshot.no")
    assert(t.inneholder(stage, "funksjon hash_liste(root: tekst) -> tekst"))
    assert(t.inneholder(stage, "funksjon sha256_for(sti: tekst) -> tekst"))
    assert(t.inneholder(stage, "bruk std.liste som liste"))
    assert(t.inneholder(stage, "bruk std.filops som filops"))
    assert(t.inneholder(stage, "bruk std.sha256 som sha256"))
    assert(t.inneholder(stage, "filops.walk(root)"))
    assert(t.inneholder(stage, "liste.sorter_tekst(filer)"))
    assert(t.inneholder(stage, "sha256.hash_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(stage, "hash_liste(snapshot_dir)"))
    assert(ikkje t.inneholder(stage, "exec_prosess"))
    assert(ikkje t.inneholder(stage, "find "))
    assert(ikkje t.inneholder(stage, "shasum"))
    assert(ikkje t.inneholder(stage, "date "))
    assert(ikkje t.inneholder(stage, "cp "))
    assert(ikkje t.inneholder(stage, "while read -r FILE"))
    assert(ikkje t.inneholder(stage, "| sort"))

    la compare = fil_les("tools/compiler_snapshot_compare.no")
    assert(t.inneholder(compare, "funksjon hash_samanlikning"))
    assert(t.inneholder(compare, "funksjon relative_filer(root: tekst) -> liste_tekst"))
    assert(t.inneholder(compare, "funksjon samanlikn(snap_a: tekst, snap_b: tekst, report: tekst) -> bool"))
    assert(t.inneholder(compare, "bruk std.liste som liste"))
    assert(t.inneholder(compare, "bruk std.filops som filops"))
    assert(t.inneholder(compare, "bruk std.sha256 som sha256"))
    assert(t.inneholder(compare, "filops.walk(root)"))
    assert(t.inneholder(compare, "liste.sorter_tekst(ut)"))
    assert(t.inneholder(compare, "hash_samanlikning(snap_a, snap_b)"))
    assert(t.inneholder(compare, "returner miljo_hent(namn)"))
    assert(t.inneholder(compare, "sha256.hash_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(compare, "NORSCODE_SNAPSHOT_A=<snapshot_dir_a> NORSCODE_SNAPSHOT_B=<snapshot_dir_b> ./bin/nc run tools/compiler_snapshot_compare.no"))
    assert(ikkje t.inneholder(compare, "exec_prosess"))
    assert(ikkje t.inneholder(compare, "find "))
    assert(ikkje t.inneholder(compare, "diff "))
    assert(ikkje t.inneholder(compare, "shasum"))
    assert(ikkje t.inneholder(compare, "compiler_snapshot_compare.sh <"))
    assert(ikkje t.inneholder(compare, "while read -r FILE_A"))
    assert(ikkje t.inneholder(compare, "awk '{print $1}'"))
    assert(ikkje t.inneholder(compare, "test -d "))
    assert(ikkje t.inneholder(compare, "| sort"))
    assert(ikkje fil_finnes("tools/compiler_stage_snapshot.sh"))
    assert(ikkje fil_finnes("tools/compiler_snapshot_compare.sh"))

    la artifact = fil_les("tools/bootstrap_artifact_pipeline.no")
    assert(t.inneholder(artifact, "funksjon hash_liste(root: tekst, filer: liste_tekst) -> tekst"))
    assert(t.inneholder(artifact, "funksjon sha256_for(sti: tekst) -> tekst"))
    assert(t.inneholder(artifact, "bruk std.liste som liste"))
    assert(t.inneholder(artifact, "bruk std.filops som filops"))
    assert(t.inneholder(artifact, "bruk std.sha256 som sha256"))
    assert(t.inneholder(artifact, "filops.walk(run_dir)"))
    assert(t.inneholder(artifact, "liste.sorter_tekst(filer)"))
    assert(t.inneholder(artifact, "sha256.hash_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(artifact, "hash_liste(run_dir, filer)"))
    assert(ikkje t.inneholder(artifact, "exec_prosess"))
    assert(ikkje t.inneholder(artifact, "find "))
    assert(ikkje t.inneholder(artifact, "shasum"))
    assert(ikkje t.inneholder(artifact, "date "))
    assert(ikkje t.inneholder(artifact, "cp "))
    assert(ikkje t.inneholder(artifact, "while read -r FILE"))
    assert(ikkje t.inneholder(artifact, "| sort"))
    assert(ikkje fil_finnes("tools/bootstrap_artifact_pipeline.sh"))

    la unified = fil_les("tools/unified_bootstrap_verifier.no")
    assert(t.inneholder(unified, "bruk tools.python_dependency_audit som python_audit"))
    assert(t.inneholder(unified, "bruk tools.bootstrap_artifact_pipeline som artifacts"))
    assert(t.inneholder(unified, "python_audit.start() == 0"))
    assert(t.inneholder(unified, "artifacts.samle(root, root + \"/reports/bootstrap_artifacts\")"))
    assert(t.inneholder(unified, "compare.samanlikn(stage1, stage2)"))
    assert(t.inneholder(unified, "bootstrap_diff.analyser(stage1, stage2"))
    assert(ikkje t.inneholder(unified, "exec_prosess"))
    assert(ikkje t.inneholder(unified, "./bin/nc"))
    assert(ikkje t.inneholder(unified, "|| true"))
    assert(ikkje t.inneholder(unified, "bash tools/python_dependency_audit.sh"))
    assert(ikkje t.inneholder(unified, "bash tools/compare_compilers.sh"))
    assert(ikkje t.inneholder(unified, "bash tools/bootstrap_diff_analyzer.sh"))
    assert(ikkje t.inneholder(unified, "bash tools/backend_ordering_validator.sh"))
    assert(ikkje t.inneholder(unified, "bash tools/semantic_diff_analyzer.sh"))
    assert(ikkje t.inneholder(unified, "bash tools/bootstrap_artifact_pipeline.sh"))
    assert(ikkje t.inneholder(unified, "builtin.exec_prosess"))

    skriv("test_report_writers_no_printf OK")
    returner 0
}
