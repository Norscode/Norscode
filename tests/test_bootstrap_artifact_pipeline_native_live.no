bruk tools.bootstrap_artifact_pipeline som pipeline
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "artifact-live-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    assert(filops.lag_katalogar(base + "/reports/compiler_snapshots/s1"))
    assert(filops.lag_katalogar(base + "/build/compiler_stage1/nested"))
    builtin.fil_skriv(base + "/reports/bootstrap_diff_report.txt", "diff")
    builtin.fil_skriv_binær(base + "/build/compiler_stage1/nested/compiler.bin", builtin.bytes_from_list([0, 255, 7]))

    la run_dir = pipeline.samle(base, base + "/out")
    assert(run_dir != "")
    assert(builtin.fil_les(run_dir + "/bootstrap_diff_report.txt") == "diff")
    la bytes = builtin.fil_les_binær(run_dir + "/compiler_stage1/nested/compiler.bin")
    assert(sha256.hash_bytes(bytes) == sha256.hash_bytes(builtin.bytes_from_list([0, 255, 7])))
    la manifest = builtin.fil_les(run_dir + "/artifact_manifest.txt")
    assert(builtin.index_of(manifest, "bootstrap_diff_report.txt") >= 0)
    assert(builtin.index_of(manifest, "compiler_stage1/nested/compiler.bin") >= 0)
    assert(builtin.index_of(manifest, sha256.hash_bytes(bytes)) >= 0)
    assert(filops.slett_tre(base))
    skriv("test_bootstrap_artifact_pipeline_native_live OK")
    returner 0
}
