bruk tools.ncb_to_elf som drivar

funksjon start() -> heiltall {
    la før = miljo_hent("NC_BUILTIN_REPORT")
    miljo_sett("NC_BUILTIN_REPORT", "1")
    assert(drivar.builtin_port_godkjend("native_codegen_v2: BUILTIN-RAPPORT uløyste=0 uventa=0\n"))
    assert(drivar.builtin_port_godkjend("åtvaring\nnative_codegen_v2: BUILTIN-RAPPORT uløyste=1 uventa=0\r\n  kvitlista builtin.krok/1\n"))
    assert(ikkje drivar.builtin_port_godkjend(""))
    assert(ikkje drivar.builtin_port_godkjend("native_codegen_v2: 100 bytes (NCB innebygd)\n"))
    assert(ikkje drivar.builtin_port_godkjend("native_codegen_v2: BUILTIN-RAPPORT uløyste=1 uventa=1\n"))
    assert(ikkje drivar.builtin_port_godkjend("native_codegen_v2: BUILTIN-RAPPORT uløyste=1 uventa=01\n"))
    assert(ikkje drivar.builtin_port_godkjend("annan prosess: uventa=0\n"))
    assert(ikkje drivar.builtin_port_godkjend("native_codegen_v2: BUILTIN-RAPPORT uløyste= uventa=0\n"))
    assert(ikkje drivar.builtin_port_godkjend("native_codegen_v2: BUILTIN-RAPPORT uløyste=ukjend uventa=0\n"))
    assert(ikkje drivar.builtin_port_godkjend("native_codegen_v2: BUILTIN-RAPPORT uløyste=0 uventa=0\nnative_codegen_v2: BUILTIN-RAPPORT uløyste=1 uventa=1\n"))
    miljo_sett("NC_BUILTIN_REPORT", "")
    assert(drivar.builtin_port_godkjend(""))
    miljo_sett("NC_BUILTIN_REPORT", før)
    skriv("test_ncb_to_elf_report_contract OK\n")
    returner 0
}
