bruk tools.compiler_snapshot_compare som compare
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "snapshot-live-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    la a = base + "/a"
    la b = base + "/b"
    assert(filops.lag_katalogar(a + "/nested"))
    assert(filops.lag_katalogar(b + "/nested"))
    builtin.fil_skriv_binær(a + "/same.bin", builtin.bytes_from_list([0, 255, 1]))
    builtin.fil_skriv_binær(b + "/same.bin", builtin.bytes_from_list([0, 255, 1]))
    builtin.fil_skriv(a + "/nested/diff.txt", "A")
    builtin.fil_skriv(b + "/nested/diff.txt", "B")
    builtin.fil_skriv(a + "/only-a.txt", "A")
    builtin.fil_skriv(b + "/only-b.txt", "B")
    la report = base + "/report.txt"
    assert(compare.samanlikn(a, b, report))
    la body = builtin.fil_les(report)
    assert(builtin.index_of(body, "MATCH same.bin") >= 0)
    assert(builtin.index_of(body, "DIFF  nested/diff.txt") >= 0)
    assert(builtin.index_of(body, "MISSING IN SNAPSHOT_B: only-a.txt") >= 0)
    assert(builtin.index_of(body, "MISSING IN SNAPSHOT_A: only-b.txt") >= 0)
    assert(filops.slett_tre(base))
    skriv("test_compiler_snapshot_native_live OK")
    returner 0
}
