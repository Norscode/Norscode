bruk selfhost.native_execution.native_codegen_v2 som codegen
bruk selfhost.ncb_serde som serde

funksjon slutt_med(elf, markør: tekst) -> boolsk {
    la start = lengde(elf) - 8 - lengde(markør)
    hvis start < 0 { returner usann }
    la i = 0
    mens i < lengde(markør) {
        hvis elf[start + i] != (builtin.char_code(markør[i]) & 255) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    la ncb = "{\"format\":\"norscode-bytecode-v1\",\"entry\":\"__main__.start\",\"functions\":{\"__main__.start\":{\"name\":\"start\",\"module\":\"__main__\",\"params\":[],\"is_async\":false,\"code\":[[\"PUSH_CONST\",\"blåbær\"],[\"PUSH_CONST\",3.5],[\"RETURN\"]]}}}"
    la elf = codegen.kompiler_v2(ncb)

    assert_eq(elf[0], 0x7F)
    assert_eq(elf[1], 0x45)
    assert_eq(elf[2], 0x4C)
    assert_eq(elf[3], 0x46)
    assert(codegen.har_innebygd_ncb(elf))
    // F3.6: sjølvhosta runtime skriv binær trailer (V2); C-æra-vertar (chr(0) = "")
    // fell til JSON-traileren (V1). Begge gjev same NCB-objekt.
    hvis serde.binaer_stotta() {
        assert(slutt_med(elf, "NORSCODE_NCB_V2"))
        assert(serde.er_binaer_tekst(codegen.hent_innebygd_ncb(elf)))
    } ellers {
        assert(slutt_med(elf, "NORSCODE_NCB_V1"))
        assert_eq(codegen.hent_innebygd_ncb(elf), ncb)
    }
    la inne = codegen.hent_innebygd_ncb_objekt(elf)
    assert_eq(inne["entry"], "__main__.start")
    la kode = inne["functions"]["__main__.start"]["code"]
    assert_eq(kode[0][1], "blåbær")
    assert_eq(builtin.type(kode[1][1]), "desimaltall")
    assert_eq(tekst(kode[1][1]), "3.5")

    // Ein skadd trailer skal ikkje bli godkjend som innebygd NCB.
    elf[lengde(elf) - 9] = 0
    assert(ikkje codegen.har_innebygd_ncb(elf))
    returner 0
}
