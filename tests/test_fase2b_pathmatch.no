# Fase 2 bølgje (b) / 2.5: path_match + parse_query.
#
# RESEED-GATED: testen importerer selfhost.nc_main og kallar path_match /
# parse_query direkte. Fordi nc_main er heile lukkingsmodulen, treff ei lokal
# kjøring GC-veggen (Linux OOM exit 199 / macOS evig grind på committa seed).
# Testen VIL køyre grønt på ein fersk seed som har bølgje-(b)-endringane.
# Lokal stadfesting av sjølve logikken er gjort med eit frittståande utdrag
# (scratchpad/t25.no) som køyrer på committa seed.

bruk selfhost.nc_main

funksjon sjekk(namn: tekst, faktisk: tekst, venta: tekst) {
    hvis faktisk != venta {
        kast "FEIL " + namn + ": fekk '" + faktisk + "' venta '" + venta + "'"
    }
}

funksjon start() -> heltall {
    # Utypa {id} = str
    la m1 = path_match("/u/{id}", "/u/42")
    sjekk("untyped", tekst(m1["id"]), "42")
    sjekk("untyped-match", tekst(har_nokkel(m1, "__path_match__")), "sann")

    # int-konvertar: ok + mismatch → 422-signal
    sjekk("int-ok", tekst(path_match("/u/{id:int}", "/u/42")["id"]), "42")
    sjekk("int-422", tekst(har_nokkel(path_match("/u/{id:int}", "/u/abc"), "__path_422__")), "sann")

    # bool / uuid / desimaltall
    sjekk("bool-ok", tekst(har_nokkel(path_match("/f/{b:bool}", "/f/true"), "__path_match__")), "sann")
    sjekk("bool-bad", tekst(har_nokkel(path_match("/f/{b:bool}", "/f/kanskje"), "__path_422__")), "sann")
    sjekk("uuid-bad", tekst(har_nokkel(path_match("/f/{u:uuid}", "/f/xyz"), "__path_422__")), "sann")
    sjekk("dec-ok", tekst(har_nokkel(path_match("/f/{d:desimaltall}", "/f/3.14"), "__path_match__")), "sann")

    # path-konvertar slukar resten av stien
    sjekk("path-conv", tekst(path_match("/files/{rest:path}", "/files/a/b/c.txt")["rest"]), "a/b/c.txt")

    # %-dekoding av path-segment
    sjekk("pct", tekst(path_match("/u/{name}", "/u/a%20b")["name"]), "a b")

    # ingen strukturell match
    sjekk("nomatch", tekst(har_nokkel(path_match("/a/b", "/a"), "__path_match__")), "usann")

    # parse_query: rå streng, %-dekod (plus→mellomrom), gjentekne nøklar som liste
    la q = parse_query("a=1&b=hei%20du&a=2&flag")
    sjekk("q-raw", tekst(q["__raw__"]), "a=1&b=hei%20du&a=2&flag")
    sjekk("q-b", tekst(q["b"]), "hei du")
    sjekk("q-a-list", tekst(builtin.type(q["a"])), "liste")
    sjekk("q-flag", tekst(q["flag"]), "")

    skriv("test_fase2b_pathmatch OK\n")
    returner 0
}
