bruk std.dns som dns

// Kjent-svar-test: DNS autoritativt SVAR-encoding mot RFC 1035.
//
// std.dns.wire_authoritative_response bygger svaret DNS-daemonen sender tilbake
// (komplementet til wire_query). Byte-nøyaktighet trengs for ekte DNS-interop:
// mail-MX-oppslag og ACME dns-01 der Pebble/valideraren leser Norscode sin
// autoritative daemon. Struktur: 12-byte header (flags 0x8400 = QR+AA når
// funnet, 0x8403 = QR+AA+RCODE3/NXDOMAIN når ikke), spørsmål ekko, deretter
// answer-RR med kompresjons-peker 0xC00C, TYPE, CLASS IN, TTL, RDLENGTH, RDATA.
// Ren byte-beregning — kjører uten socket/native.

funksjon _hex(bytes) -> tekst {
    la sifre = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(sifre, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(sifre, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la sone = dns.ny_sone("norscode.no")
    dns.legg_a(sone, "@", "192.0.2.1")
    dns.legg_txt(sone, "@", "hei")

    // A funnet: flags 0x8400 (QR+AA), ANCOUNT=1, answer = peker 0xC00C +
    // TYPE A + CLASS IN + TTL 3600 (0x00000e10) + RDLENGTH 4 + 192.0.2.1.
    assert(_hex(dns.wire_authoritative_response(sone, 4660, "norscode.no", "A"))
        == "123484000001000100000000086e6f7273636f6465026e6f0000010001c00c0001000100000e100004c0000201")

    // TXT: RDATA = character-string (lengde-prefiks 0x03 + "hei"), RDLENGTH 4.
    assert(_hex(dns.wire_authoritative_response(sone, 4660, "norscode.no", "TXT"))
        == "123484000001000100000000086e6f7273636f6465026e6f0000100001c00c0010000100000e10000403686569")

    // NXDOMAIN: flags 0x8403 (RCODE=3), ANCOUNT=0, fullt navn ekko, ingen answer.
    assert(_hex(dns.wire_authoritative_response(sone, 4660, "mangler.norscode.no", "A"))
        == "123484030001000000000000076d616e676c6572086e6f7273636f6465026e6f0000010001")

    skriv("test_dns_wire_response: OK\n")
    returner 0
}
