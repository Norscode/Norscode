bruk std.web som web
bruk std.apptenar som app

// FA-097/059/100: OpenAPI-markørane. web.tags("a") gav 500 ArgumentFeil
// fordi markøren var parameterlaus (kallet køyrer faktisk i handlaren), og
// generatoren ignorerte description, deprecated, hidden og extra_responses
// sjølv om kompilatoren la dei i rute-metadataen.

funksjon merka(ctx: ordbok_tekst) -> tekst {
    web.route("GET /merka")
    web.tags("varer")
    web.tags("admin")
    web.beskriving("Hent \"merka\" varer")
    web.forelda()
    web.respons("404", "Ikkje funne")
    web.respons("409", "Konflikt")
    returner "merka"
}

funksjon skjult(ctx: ordbok_tekst) -> tekst {
    web.route("GET /skjult")
    web.skjul()
    returner "skjult"
}

funksjon vanleg(ctx: ordbok_tekst) -> tekst {
    web.route("GET /vanleg")
    returner "vanleg"
}

funksjon _status(rå: tekst) -> tekst {
    la linje = builtin.slice(rå, 0, builtin.index_of(rå, "\r\n"))
    returner builtin.split(linje, " ")[1]
}

funksjon _body(rå: tekst) -> tekst {
    la s = builtin.index_of(rå, "\r\n\r\n")
    returner builtin.slice(rå, s + 4, lengde(rå))
}

funksjon _har(xs, v: tekst) -> boolsk {
    la i: heltall = 0
    mens i < lengde(xs) {
        hvis tekst(xs[i]) == v { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon test_tags_krasjar_ikkje() -> heltall {
    // Produksjonsvegen (apptenar = same dispatch som app.lytt).
    la r = app.handsam_rå("GET /merka HTTP/1.1\r\nHost: x\r\n\r\n")
    assert_eq(_status(r), "200")
    assert_eq(_body(r), "merka")
    // Direkte kall: markørane returnerer trygt.
    assert_eq(web.tags("x"), "x")
    returner 0
}

funksjon test_generator_les_markorar() -> heltall {
    la spec = web.openapi_json("Markørar", "1")
    assert(json_er_gyldig(spec))
    la p = builtin.json_parse_raw(spec)
    la paths = p["paths"]

    // hidden → ikkje med (include_in_schema=False).
    assert(ikkje finnes_nøkkel(paths, "/skjult"))
    assert(finnes_nøkkel(paths, "/vanleg"))

    la op = paths["/merka"]["get"]
    // tags frå markørane, ikkje modul-standard.
    la tg = op["tags"]
    assert_eq(lengde(tg), 2)
    assert(_har(tg, "varer"))
    assert(_har(tg, "admin"))
    assert(ikkje _har(tg, "standard"))
    // description og deprecated.
    assert_eq(tekst(op["description"]), "Hent \"merka\" varer")
    assert_eq(tekst(op["deprecated"]), "sann")
    // extra_responses (web.respons) blir sjekka i test_fastapi_hol_serve: den
    // hybride testkompilatoren (nc test) legg ikkje extra_responses i
    // metadataen, berre produksjonskompilatoren (nc run/serve) gjer det.
    assert(finnes_nøkkel(op["responses"], "200"))

    // Umerka rute: standard-tag, ingen deprecated/description.
    la op2 = paths["/vanleg"]["get"]
    assert(_har(op2["tags"], "standard"))
    assert(ikkje finnes_nøkkel(op2, "deprecated"))
    assert(ikkje finnes_nøkkel(op2, "description"))

    // Topp-nivå tags inneheld markør-tagane.
    la alle = p["tags"]
    la namn = []
    la i: heltall = 0
    mens i < lengde(alle) {
        legg_til(namn, tekst(alle[i]["name"]))
        i = i + 1
    }
    assert(_har(namn, "varer"))
    assert(_har(namn, "admin"))
    returner 0
}

funksjon start() -> heltall {
    test_tags_krasjar_ikkje()
    test_generator_les_markorar()
    skriv("test_web_openapi_markorar OK\n")
    returner 0
}
