bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/build_linux_x86_64_stage0_docker_v3601.no")

    assert(t.inneholder(src, "v3601 Linux stage0-Docker-løypa er avvikla"))
    assert(t.inneholder(src, "Promoter berre gjennom den kontrollerte promoteringsporten"))
    assert(t.inneholder(src, "Ingen filer i dist/ eller bootstrap/stage0 blir endra"))
    assert(t.inneholder(src, "returner 2"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "sh -lc"))
    assert(ikkje t.inneholder(src, "NORSCODE_PROMOTE_STAGE0"))

    skriv("test_linux_stage0_docker_no_shell_wrappers OK")
    returner 0
}
