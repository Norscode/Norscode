// tests/test_os_k2_drivarar.no — Norscode OS K2: maskinvarebibliotek og drivarar.
//
// Byggjer os/kjerne/k2_prøve.no og bootar ho i QEMU -m 256M med inndata:
//   * COM1 får «Hei fra verten over COM1» (via -serial mon:stdio)
//   * tastaturet får «Norscode OS k2!» via monitoren sin sendkey (inkl. shift og backspace)
// og krev: info-blokk/stubbar, PIT 100 Hz der nanosleep(100 ms) tek 9–11 tikk, RTC-dato
// lik vertsdatoen (UTC, ±1 dag), K1-søppelarbeidslasta (>= 3 GC-innsamlingar) med PIT-avbrot
// på heile vegen (same resultat som utan avbrot), rammeallokator alloc/fri, sidetabell map/unmap,
// seriell ekko, tastaturtekst og null tapte hendingar.
// Hoppar reint over (rc 0, med grunn) når qemu-system-x86_64 manglar.

bruk os.boot.byggjar som byggjar
bruk os.boot.qemu som qemu

funksjon krev(serie: tekst, linje: tekst) -> heiltall {
    hvis builtin.index_of(serie, linje + "\n") < 0 { skriv("MANGLAR: " + linje + "\n") }
    assert(builtin.index_of(serie, linje + "\n") >= 0)
    returner 0
}

// Dagnummer sidan 1970-01-01 for ein gregoriansk dato (days_from_civil).
funksjon dagar(y0: heiltall, m: heiltall, d: heiltall) -> heiltall {
    la y = y0
    hvis m <= 2 { y = y - 1 }
    la era = y / 400
    la yoe = y - era * 400
    la mp = m + 9
    hvis m > 2 { mp = m - 3 }
    la doy = (153 * mp + 2) / 5 + d - 1
    la doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    returner era * 146097 + doe - 719468
}

funksjon start() -> heiltall {
    la q = qemu.finn_qemu()
    hvis q == "" {
        skriv("HOPPA: qemu-system-x86_64 finst ikkje (set OS_QEMU eller installer QEMU)\n")
        returner 0
    }
    la r = byggjar.bygg_kjerne("os/kjerne/k2_prøve.no", "build/os/test_k2.img", "demand")
    hvis r["feil"] != "" { skriv("FEIL (bygg): " + r["feil"] + "\n") }
    assert_eq(r["feil"], "")
    la root = byggjar.rot()
    la tastar: liste_tekst = ["shift-n", "o", "r", "s", "c", "o", "d", "e", "spc", "shift-o", "shift-s",
        "spc", "k", "2", "backspace", "2", "shift-1", "ret"]
    la k = qemu.køyr_med_inndata(q, r["bilete"], "256M", 180000, "Hei fra verten over COM1" + builtin.chr(10),
        tastar, root + "/build/os/test_k2.debugcon.txt")
    fil_skriv(root + "/build/os/test_k2.serie.txt", k["serie"])
    skriv("status=" + k["status"] + " qemu=" + k["qemu_kode"] + " kjerne=" + k["kjerne_kode"] + " ms=" + k["ms"] + "\n")
    skriv(k["serie"])
    skriv("debugcon: " + k["debugcon"])
    assert_eq(k["status"], "ferdig")
    assert_eq(k["kjerne_kode"], "0")
    la s = k["serie"]
    krev(s, "K2-prøve: Norscode OS")
    krev(s, "info: versjon=2 stubbar=30 ring=256")
    krev(s, "multiboot: data før pool=ok")
    krev(s, "cpuid: maksblad>=1 ok")
    krev(s, "rdrand: ok")
    krev(s, "cr0: PG=1 PE=1 cr4: PAE=1 OSFXSR=1")
    krev(s, "rdtsc: aukar ok")
    krev(s, "tidtakar: 100 Hz, tikk går ok")
    krev(s, "tidtakar: sov ok")
    assert(builtin.index_of(s, "gc under avbrot: tot=102889 ok (samlingar=") >= 0)
    krev(s, "rtc: plausibel ok")
    krev(s, "rammer: tre ulike ok, gjenbruk etter fri ok, utanfor pool ok")
    krev(s, "rammer: dobbel fri avvist ok")
    krev(s, "sidetabell: skriv via VA, les via direktekart ok")
    krev(s, "sidetabell: oversett ok")
    krev(s, "sidetabell: unmap ok")
    krev(s, "sidetabell: 2 MiB-side i direktekartet ok")
    krev(s, "serie: ekko «Hei fra verten over COM1»")
    krev(s, "tastatur: «Norscode OS k2!»")
    krev(s, "hendingar: tapte=0")
    krev(s, "K2-prøve: ferdig")
    assert(builtin.index_of(s, "FEIL") < 0)

    // RTC-datoen skal vere vertsdatoen (UTC) ±1 dag.
    la i = builtin.index_of(s, "rtc: ")
    la dato = builtin.slice(s, i + 5, i + 15)
    la del = builtin.split(dato, "-")
    la d_rtc = dagar(heltall_fra_tekst(del[0]), heltall_fra_tekst(del[1]), heltall_fra_tekst(del[2]))
    la d_vert = builtin.tid_ms() / 86400000
    skriv("rtc-dato " + dato + " = dag " + tekst(d_rtc) + ", vert dag " + tekst(d_vert) + "\n")
    assert(d_rtc >= d_vert - 1 og d_rtc <= d_vert + 1)
    skriv("OK: K2 drivarar og minne-API i QEMU\n")
    returner 0
}
