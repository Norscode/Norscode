// Postgres-utvidingar batch 1: skalar streng-/tal-funksjonar utover SQLite.
// Golden = dokumentert PostgreSQL-semantikk (16/17).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la rad = {"x": "1"}

    // split_part (1-basert; tom utanfor rekkevidde)
    assert_eq(sql.evaluer_uttrykk("split_part('a,b,c', ',', 2)", rad), "b")
    assert_eq(sql.evaluer_uttrykk("split_part('a,b,c', ',', 5)", rad), "")
    // left / right (inkl. negativ)
    assert_eq(sql.evaluer_uttrykk("left('hello', 3)", rad), "hel")
    assert_eq(sql.evaluer_uttrykk("left('hello', -2)", rad), "hel")
    assert_eq(sql.evaluer_uttrykk("right('hello', 2)", rad), "lo")
    assert_eq(sql.evaluer_uttrykk("right('hello', -2)", rad), "llo")
    // repeat / reverse
    assert_eq(sql.evaluer_uttrykk("repeat('ab', 3)", rad), "ababab")
    assert_eq(sql.evaluer_uttrykk("reverse('abc')", rad), "cba")
    // ascii / chr
    assert_eq(sql.evaluer_uttrykk("ascii('A')", rad), "65")
    assert_eq(sql.evaluer_uttrykk("chr(65)", rad), "A")
    // initcap
    assert_eq(sql.evaluer_uttrykk("initcap('HELLO wORLD')", rad), "Hello World")
    // lpad / rpad (pad + trunkering)
    assert_eq(sql.evaluer_uttrykk("lpad('5', 3, '0')", rad), "005")
    assert_eq(sql.evaluer_uttrykk("rpad('5', 3, '0')", rad), "500")
    assert_eq(sql.evaluer_uttrykk("lpad('hello', 3)", rad), "hel")
    // strpos
    assert_eq(sql.evaluer_uttrykk("strpos('hello', 'll')", rad), "3")
    assert_eq(sql.evaluer_uttrykk("strpos('hello', 'z')", rad), "0")
    // concat / concat_ws (NULL hoppa over)
    assert_eq(sql.evaluer_uttrykk("concat('a', NULL, 'b')", rad), "ab")
    assert_eq(sql.evaluer_uttrykk("concat_ws('-', 'a', NULL, 'b')", rad), "a-b")
    // greatest / least (NULL ignorert)
    assert_eq(sql.evaluer_uttrykk("greatest(3, 9, 1)", rad), "9")
    assert_eq(sql.evaluer_uttrykk("least(3, 9, 1)", rad), "1")
    assert_eq(sql.evaluer_uttrykk("greatest(NULL, 5)", rad), "5")
    // translate (3 → borte, 1→a, 4→x)
    assert_eq(sql.evaluer_uttrykk("translate('12345', '143', 'ax')", rad), "a2x5")
    // btrim
    assert_eq(sql.evaluer_uttrykk("btrim('xxhixx', 'x')", rad), "hi")
    assert_eq(sql.evaluer_uttrykk("btrim('  hi  ')", rad), "hi")
    // sign / mod / to_hex
    assert_eq(sql.evaluer_uttrykk("sign(-5)", rad), "-1")
    assert_eq(sql.evaluer_uttrykk("sign(5)", rad), "1")
    assert_eq(sql.evaluer_uttrykk("sign(0)", rad), "0")
    assert_eq(sql.evaluer_uttrykk("mod(7, 3)", rad), "1")
    assert_eq(sql.evaluer_uttrykk("mod(17, 5)", rad), "2")
    assert_eq(sql.evaluer_uttrykk("to_hex(255)", rad), "ff")
    assert_eq(sql.evaluer_uttrykk("to_hex(16)", rad), "10")

    returner 0
}
