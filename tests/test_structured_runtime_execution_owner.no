funksjon start() -> heiltall {
    la src = builtin.fil_les("tools/windows_runtime_execution_gate.no")
    assert(builtin.contains(src, "bruk tools.process_runner som prosess"))
    assert(builtin.contains(src, "prosess.køyr(sti, [], root, {}, 120000)"))
    assert(builtin.contains(src, "builtin.system_info()[\"system\"]"))
    assert(ikkje builtin.contains(src, "exec_prosess("))
    assert(ikkje builtin.contains(src, "uname -s"))
    skriv("test_structured_runtime_execution_owner OK\n")
    returner 0
}
