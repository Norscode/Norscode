// Ytelse: equality-indeks brukt i spørring. Testar KORREKTHET — indeks-stien skal gje
// nøyaktig same svar som full skann, vedlikehald på insert, og invalidering på update.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (1, 'Ada', 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (2, 'Linus', 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (3, 'Bjørn', 'Bergen')")

    assert_eq(sql.exec(db, "CREATE INDEX idx_by ON folk (by)"), 0)

    // Spørring via indeks — same som skann
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo'"), 2)
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE by = 'Oslo' ORDER BY id ASC"), "Ada\nLinus")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Bergen'"), 1)
    // Indeksert, ingen treff → tom (ikkje skann)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Trondheim'"), 0)

    // INSERT etter indeks: vedlikehald → ny rad blir funne
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (4, 'Alan', 'Oslo')")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo'"), 3)

    // UPDATE invaliderer indeks → skann-fallback, framleis korrekt
    sql.exec(db, "UPDATE folk SET by = 'Bergen' WHERE id = 1")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Oslo'"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk WHERE by = 'Bergen'"), 2)

    // Gjenopprett indeks og verifiser
    sql.exec(db, "CREATE INDEX idx_by ON folk (by)")
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE by = 'Bergen' ORDER BY id ASC"), "Ada\nBjørn")

    returner 0
}
