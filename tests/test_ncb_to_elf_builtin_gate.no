// Levande regresjon: den strenge builtin-porten må overleve ncb-to-elf-drivaren.
// Brukar ekte codegen og minimale NCB-program, ikkje tekstmatching av implementasjonen.
bruk std.runtime.process_abi som abi

funksjon bygg(root: tekst, inn: tekst, ut: tekst, kvitliste: tekst) -> ordbok_tekst {
    la req = abi.request(root + "/dist/norscode_native", [], root, "", 600000, 65536)
    abi.sett_sandbox(req, "none", 0, 64, usann)
    abi.sett_environment(req, {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tools/ncb_to_elf.no",
        "NORSCODE_NCB_TO_ELF_INPUT": inn,
        "NORSCODE_NCB_TO_ELF_OUTPUT": ut,
        "NC_BUILTIN_REPORT": "1",
        "NC_BUILTIN_KVITLISTE": kvitliste,
        "NORSCODE_VM_FAST": "1",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    })
    returner builtin.process_spawn_argv(req)
}

funksjon krev_avvist(res, ut: tekst) -> heiltall {
    skriv(tekst(res["stdout"]))
    skriv(tekst(res["stderr"]))
    assert_eq(res["status"], "ferdig")
    assert_eq(heltall_fra_tekst(res["exit_code"]), 3)
    assert(ikkje builtin.fil_finnes(ut))
    assert_inneholder(res["stdout"], "uventa=1")
    assert(ikkje builtin.contains(res["stdout"], "fell tilbake til tolka"))
    returner 0
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/test_ncb_to_elf_builtin_gate"
    builtin.mkdir_p(base)
    la inn = base + "/program.ncb.json"
    la ut = base + "/program.elf"
    la ukjent = "builtin.norscode_test_uloeyst_kall"
    la program = {"format": "norscode-bytecode-v1", "entry": "start", "functions": {
        "start": {"params": [], "code": [["PUSH_CONST", 0], ["RETURN"]]}
    }}
    builtin.fil_skriv(inn, builtin.json_skriv(program))

    // Positiv kontroll: rapporten må faktisk kome frå den køyrde kodegeneratoren.
    la positiv = bygg(root, inn, ut, "")
    skriv(tekst(positiv["stdout"]))
    skriv(tekst(positiv["stderr"]))
    assert_eq(positiv["status"], "ferdig")
    assert_eq(heltall_fra_tekst(positiv["exit_code"]), 0)
    assert_inneholder(positiv["stdout"], "BUILTIN-RAPPORT uløyste=0 uventa=0")
    assert(builtin.fil_finnes(ut))

    // Den gamle ELF-en frå den positive kontrollen må ikkje overleve ei avvising.
    program["functions"]["start"]["code"] = [["PUSH_CONST", 7], ["CALL", ukjent, 1], ["POP"], ["PUSH_CONST", 0], ["RETURN"]]
    builtin.fil_skriv(inn, builtin.json_skriv(program))
    krev_avvist(bygg(root, inn, ut, ""), ut)

    // Ei aritetspinna kvitliste må ikkje godta eit anna kall med same namn.
    krev_avvist(bygg(root, inn, ut, ukjent + "/2"), ut)

    // Eksplisitte kallarkontraktar skal overleve det lukka barnemiljøet.
    la tillaten = bygg(root, inn, ut, ukjent + "/1")
    skriv(tekst(tillaten["stdout"]))
    skriv(tekst(tillaten["stderr"]))
    assert_eq(tillaten["status"], "ferdig")
    assert_eq(heltall_fra_tekst(tillaten["exit_code"]), 0)
    assert_inneholder(tillaten["stdout"], "BUILTIN-RAPPORT uløyste=1 uventa=0")
    assert_inneholder(tillaten["stdout"], "kvitlista " + ukjent + "/1")
    assert(builtin.fil_finnes(ut))
    skriv("test_ncb_to_elf_builtin_gate OK\n")
    returner 0
}
