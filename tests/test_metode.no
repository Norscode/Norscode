# M5 — struktur-metodar: funksjon Type.metode(self, ...) + p.metode(args) med
# køyretids-dispatch på struktur-typen. Éin nested VM-køyring (minne-trygg).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la prog = "struktur Punkt { x y }\n" +
        "funksjon Punkt.sum(self) -> heltall { returner self.x + self.y }\n" +
        "funksjon Punkt.flytt(self, dx) -> heltall { self.x = self.x + dx\n returner self.x }\n" +
        "struktur Kvadrat { s }\n" +
        "funksjon Kvadrat.sum(self) -> heltall { returner self.s * self.s }\n" +
        "funksjon start() -> heltall {\n" +
        "    la p = Punkt()\n" +
        "    p.x = 3\n" +
        "    p.y = 4\n" +
        "    la a = p.sum()\n" +          // 7  (metode self)
        "    la b = p.flytt(10)\n" +      // 13 (metode m/arg, muterer self)
        "    la q = Kvadrat()\n" +
        "    q.s = 5\n" +
        "    la c = q.sum()\n" +          // 25 (dispatch: Kvadrat.sum, ikkje Punkt.sum)
        "    returner a * 10000 + b * 100 + c\n" +   // 71325
        "}\n"
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(prog, "__main__"))
    la r = vm.køyr_ncb(ncb)
    assert_eq(tekst(r), "71325")
    skriv("test_metode OK\n")
    returner 0
}
