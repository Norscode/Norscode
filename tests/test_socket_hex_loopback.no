bruk std.socket som socket

# Binær TCP-transport må bevare alle bytes uendra.
# Denne payloaden liknar ein DNS-ramme nok til at den gamle generelle
# _reparer_dns_hex_transport ville ha endra innhaldet.
funksjon start() -> heiltall {
    la payload = "abcd1234840101beef1001ffeedd"
    assert(socket._reparer_dns_hex_transport(payload) != "")
    assert(socket._reparer_dns_hex_transport(payload) != payload)

    la listener = socket.native_lytt("127.0.0.1", 0, 8)
    assert_eq(listener["status"], "listening")
    la port = heltall_fra_tekst(listener["port"])
    la client = socket.native_tilkoble("127.0.0.1", port)
    la server = socket.native_aksepter(listener)
    assert_eq(server["status"], "connected")
    assert(client["status"] == "connected" eller client["status"] == "connecting")

    la sent = socket.native_skriv_hex(client, payload)
    assert_eq(sent["status"], "ok")
    la ready = socket.native_poll_vent(server, 1, 1000)
    assert_eq(ready["status"], "klar")
    la received = socket.native_les_hex(server, 4096)
    assert_eq(received["status"], "ok")
    assert_eq(received["data_hex"], payload)

    assert_eq(socket.native_lukk(client)["status"], "closed")
    assert_eq(socket.native_lukk(server)["status"], "closed")
    assert_eq(socket.native_lukk(listener)["status"], "closed")
    skriv("test_socket_hex_loopback OK")
    returner 0
}
