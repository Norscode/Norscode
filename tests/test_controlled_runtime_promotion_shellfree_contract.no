bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/controlled_runtime_promotion_v3005.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "bruk tools.runtime_promotion_core som promotion"))
    assert(t.inneholder(src, "godkjenn kritisk runtime-promotering"))
    assert(t.inneholder(src, "promotion.gjenopprett"))
    assert(t.inneholder(src, "builtin.sha256_bytes(bytes)"))
    assert(t.inneholder(src, "grønn(readiness, \"ready_for_controlled_promotion\")"))
    assert(t.inneholder(src, "\"PATH\": \"/nonexistent\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "shasum"))
    assert(ikkje t.inneholder(src, "mkdir -p"))
    assert(ikkje t.inneholder(src, "cp "))
    skriv("test_controlled_runtime_promotion_shellfree_contract OK")
    returner 0
}
