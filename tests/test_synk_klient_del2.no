# W9: synk-klienten (std/synk_klient.no) mot den ekte NSP/1-tenaren (std/synk.no), del 2: same
# fixture som tests/test_synk_klient.no (tests/fixtures/synk_klient_sjekk.no, del_2) i ein eigen
# barneprosess i VM-fastmodus med fersk tenar, så kvar test held seg under tidsgrensa.
#   - klokka på eininga 5 min bak: HLC-en til tenaren blir teken imot i hallo, push og pull, og til
#     leiarfana på kanalen; ei redigering i fylgjarfana etter det brukaren såg, vinn
#   - kvittert skriving blir verande i kopien (begge faner, eininga, omlasting) når pullen feilar
#   - «hugs» av i ei fane medan ei anna fane si skriving er på veg: begge held fram i minnet med
#     kvar sin klient-id, og ingenting går tapt
#   - brukarbyte i minnemodus: usynka endringar blir parkerte (hendinga «brukarbyte» med talet),
#     aldri sende som den nye brukaren, og sende når den førre kjem att
#   - hallo som feilar med nett (503, innloggingsside, tidsavbrot) viser ikkje kopien til den som
#     valde «hugs»; berre utan nett (positiv kontroll)
#   - klokka 1 t for fort: to redigeringar i éin push blir klemde i rekkjefølgje
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon start() -> heltall {
    la rot = hjelp.root()
    la m = hjelp.grunnmiljø(rot)
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = rot + "/tests/fixtures/synk_klient_sjekk.no"
    m["NORSCODE_VM_FAST"] = "1"
    m["NC_SYNK_SJEKK_DEL"] = "2"
    la r = hjelp.køyr_nc(m, 300000)
    skriv(r["stdout"])
    hjelp.krev_ok("synk_klient_sjekk del 2", r)
    assert(builtin.index_of(r["stdout"], "synk_klient_sjekk del 2 OK") >= 0)
    assert(builtin.index_of(r["stdout"], "ERROR") < 0)
    skriv("test_synk_klient_del2 OK\n")
    returner 0
}
