// Regresjon for attesteringsporten: gammal NCB-image + fersk native V1/V2.
// Syntetiske payloadar testar berre strukturgrensa, ikkje bytecode-utføring.
bruk tools.windows_runtime_attestation som attest

funksjon bytes_fra_tekst(t: tekst) -> liste_heiltall {
    la b: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(t) {
        legg_til(b, builtin.char_code(t[i]) & 255)
        i = i + 1
    }
    returner b
}

funksjon bygg_trailer(payload: liste_heiltall, magic: tekst, oppgitt_lengd: heiltall) -> liste_heiltall {
    la b: liste_heiltall = [77, 90, 0, 0]
    la i: heiltall = 0
    mens i < lengde(payload) {
        legg_til(b, payload[i])
        i = i + 1
    }
    la m = bytes_fra_tekst(magic)
    i = 0
    mens i < lengde(m) {
        legg_til(b, m[i])
        i = i + 1
    }
    la n = oppgitt_lengd
    i = 0
    mens i < 8 {
        legg_til(b, n & 255)
        n = n >> 8
        i = i + 1
    }
    returner b
}

funksjon start() -> heiltall {
    la v1 = bytes_fra_tekst("{\"functions\":{}}")
    la v2: liste_heiltall = [147, 78, 67, 66, 1, 0, 1]

    // Begge faktisk brukte native_codegen_v2-format skal godtakast.
    assert(attest.har_embedded_ncb_bytes(bygg_trailer(v1, "NORSCODE_NCB_V1", lengde(v1))))
    assert(attest.har_embedded_ncb_bytes(bygg_trailer(v2, "NORSCODE_NCB_V2", lengde(v2))))

    // Existing committed stage0-image-format må ikkje regressere.
    assert(attest.har_embedded_ncb_bytes(bytes_fra_tekst("MZNORSCODE_NCB_IMAGE_V1")))
    assert(attest.har_embedded_ncb_bytes(bytes_fra_tekst("MZNORSCODE_NCB_TEXT_V1")))

    // Avvis kort/trunkert fil, ukjend versjon og tom/urimeleg payload-lengd.
    assert(ikkje attest.har_embedded_ncb_bytes(bytes_fra_tekst("MZNORSCODE_NCB_V2")))
    assert(ikkje attest.har_embedded_ncb_bytes(bygg_trailer(v2, "NORSCODE_NCB_V3", lengde(v2))))
    assert(ikkje attest.har_embedded_ncb_bytes(bygg_trailer(v2, "NORSCODE_NCB_V2", 0)))
    assert(ikkje attest.har_embedded_ncb_bytes(bygg_trailer(v2, "NORSCODE_NCB_V2", 9999999)))
    assert(ikkje attest.har_embedded_ncb_bytes(bygg_trailer(v1, "NORSCODE_NCB_V1", 9999999)))

    // Rett lengde, men feil payload-format: må avvisast.
    assert(ikkje attest.har_embedded_ncb_bytes(bygg_trailer(v1, "NORSCODE_NCB_V2", lengde(v1))))
    assert(ikkje attest.har_embedded_ncb_bytes(bygg_trailer(v2, "NORSCODE_NCB_V1", lengde(v2))))

    skriv("test_windows_ncb_trailer_validation OK\n")
    returner 0
}
