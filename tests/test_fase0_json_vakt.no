// Fase 0.3-regresjon: streng JSON-validator FØR den native json_parse_raw.
// Før fiksen kunne ein POST med feilforma JSON (t.d. «{ikkje» eller «{"a":1,}»)
// ta ned nc serve via builtin.json_parse_raw (SIGSEGV/DoS). No validerer web.no
// i rein Norscode og gjev 422 json_invalid i staden.
//
// Mutasjonsprov: la json_er_gyldig alltid returnere sann, og dei ugyldige sakene
// under går frå «nei»/422 til å bli sende vidare (krasj-risiko / feil status).

bruk std.web som web

funksjon gyldig(s: tekst) -> boolsk { returner web.json_er_gyldig(s) }

funksjon ctx_med(body: tekst, ct: tekst) -> ordbok_tekst {
    la h: ordbok_tekst = {}
    hvis ct != "" { h["content-type"] = ct }
    returner web.request_context("post", "/x", {}, h, body)
}

funksjon start() -> heltall {
    // Gyldige verdiar
    assert(gyldig("{\"a\":1,\"b\":[1,2,3],\"c\":\"x\\\"y\"}"))
    assert(gyldig("123"))
    assert(gyldig("[]"))
    assert(gyldig("{}"))
    assert(gyldig("\"ab\\u00e6\""))
    assert(gyldig("{\"n\":true,\"m\":false,\"k\":null}"))
    assert(gyldig("-1.5e+3"))

    // Ugyldige: ubalansert, hengande komma, søppel, feil tal, uavslutta streng
    assert(ikkje gyldig("{ikkje json"))
    assert(ikkje gyldig("{\"a\":1,"))
    assert(ikkje gyldig("{\"a\":1,}"))
    assert(ikkje gyldig("[1,2,]"))
    assert(ikkje gyldig("{\"a\":1}x"))
    assert(ikkje gyldig("01"))
    assert(ikkje gyldig("\"uavslutta"))
    assert(ikkje gyldig("[1 2]"))
    assert(ikkje gyldig(""))

    // DoS-vakt: request_json kastar json_invalid i staden for å krasje. Unntaket
    // er ein ValideringsFeil, so nc serve og apptenar gjev 422 (ikkje 500).
    la kasta: boolsk = usann
    prøv {
        web.request_json(ctx_med("{\"a\":1,", ""))
    } fang (e) {
        kasta = sann
        assert(builtin.starts_with(tekst(e), "ValideringsFeil:"))
        assert(builtin.contains(tekst(e), "json_invalid"))
    }
    assert(kasta)

    // request_json: Content-Type som ikkje er JSON → ValideringsFeil (som FastAPI);
    // manglande Content-Type og application/*+json blir godtekne.
    la kasta_ct: boolsk = usann
    prøv {
        web.request_json(ctx_med("{\"a\":1}", "text/plain"))
    } fang (e) {
        kasta_ct = sann
        assert(builtin.starts_with(tekst(e), "ValideringsFeil:"))
    }
    assert(kasta_ct)
    assert_eq(tekst(web.request_json(ctx_med("{\"a\":1}", ""))["a"]), "1")
    assert_eq(tekst(web.request_json(ctx_med("{\"a\":2}", "application/merge-patch+json"))["a"]), "2")
    assert_eq(tekst(web.request_json(ctx_med("{\"a\":3}", "Application/JSON; charset=utf-8"))["a"]), "3")

    // request_json_resultat: feilforma kropp → 422 json_invalid
    la r1 = web.request_json_resultat(ctx_med("{ikkje", "application/json"))
    assert_eq(tekst(r1["ok"]), "usann")
    assert_eq(web.response_status(r1["respons"]), 422)
    assert(builtin.contains(web.response_body(r1["respons"]), "json_invalid"))

    // feil Content-Type → 422
    la r2 = web.request_json_resultat(ctx_med("{\"a\":1}", "text/plain"))
    assert_eq(tekst(r2["ok"]), "usann")
    assert_eq(web.response_status(r2["respons"]), 422)

    // gyldig JSON + rett Content-Type → ok med parsa data
    la r3 = web.request_json_resultat(ctx_med("{\"a\":1}", "application/json; charset=utf-8"))
    assert_eq(tekst(r3["ok"]), "sann")
    assert_eq(tekst(r3["data"]["a"]), "1")

    skriv("test_fase0_json_vakt OK")
    returner 0
}
