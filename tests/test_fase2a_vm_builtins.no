# Fase 2a / 2.12: nye builtins (unix_timestamp, now_iso, hmac_sha256,
# constant_time_compare). std forventa desse; dei utan prøv/fang hard-feila før.
# Køyrer gjennom KJELDE-kompilator + VM (vm.no-dispatch frå kjelde).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    la p = "funksjon start() -> tekst {\n" +
        # HMAC-SHA256 kjend testvektor (RFC-stil): key=\"key\",
        # msg=\"The quick brown fox jumps over the lazy dog\"
        "    assert_eq(builtin.hmac_sha256(\"key\", \"The quick brown fox jumps over the lazy dog\"), \"f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8\")\n" +
        # constant_time_compare
        "    assert_eq(tekst(builtin.constant_time_compare(\"abc\", \"abc\")), \"sann\")\n" +
        "    assert_eq(tekst(builtin.constant_time_compare(\"abc\", \"abd\")), \"usann\")\n" +
        "    assert_eq(tekst(builtin.constant_time_compare(\"abc\", \"abcd\")), \"usann\")\n" +
        # unix_timestamp (sekund) skal vere eit stort positivt tal
        "    la uts = builtin.unix_timestamp()\n" +
        "    hvis uts < 1000000000 { kast \"unix_timestamp for liten\" }\n" +
        # now_iso format: YYYY-MM-DDTHH:MM:SSZ (20 teikn)
        "    la iso = builtin.now_iso()\n" +
        "    hvis lengde(iso) != 20 { kast \"now_iso feil lengde\" }\n" +
        "    hvis builtin.slice(iso, 19, 20) != \"Z\" { kast \"now_iso manglar Z\" }\n" +
        "    hvis builtin.slice(iso, 10, 11) != \"T\" { kast \"now_iso manglar T\" }\n" +
        "    hvis builtin.slice(iso, 4, 5) != \"-\" { kast \"now_iso feil dato-separator\" }\n" +
        "    hvis builtin.slice(iso, 0, 2) != \"20\" { kast \"now_iso feil århundre\" }\n" +
        "    returner \"OK\"\n" +
        "}\n"
    assert_eq(utfor(p), "OK")

    skriv("test_fase2a_vm_builtins OK\n")
    returner 0
}
