bruk selfhost.lsp.straum som s
funksjon send(t, m) {
    la ut = s.lsp_behandle(t, m)
    la i = 0
    mens i < lengde(ut) { skriv(ut[i] + "\n") i = i + 1 }
}
funksjon start() -> heiltall {
    la t = s.lsp_ny_tilstand()
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"rootUri\":\"file:///Users/jansteinar/Norscode/.worktrees/rC-lsp\"}}"))
    la src = "bruk std.tekst som t\n// Legg saman to tal.\nfunksjon pluss(a: heltall, b: heltall) -> heltall {\n    la   sum=a+b\n    returner sum\n}\nfunksjon start() {\n    la x: heltall = pluss(1, \"to\")\n    la ø = 2\n}\n"
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\",\"version\":1,\"text\":" + s.lsp_js_tekst(src) + "}}}"))
    la f = s.lsp_flush(t)
    skriv(f[0] + "\n")
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\"},\"position\":{\"line\":7,\"character\":22}}}"))
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\"},\"position\":{\"line\":7,\"character\":22}}}"))
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\"},\"position\":{\"line\":7,\"character\":18}}}"))
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\"}}}"))
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"textDocument/references\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\"},\"position\":{\"line\":2,\"character\":12}}}"))
    send(t, json_parse_raw("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.no\"}}}"))
    returner 0
}
