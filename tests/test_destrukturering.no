# M10 — la [a, b] = liste (destrukturering). Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon kør(kjelde: tekst) -> heltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner vm.køyr_ncb(ncb)
}

funksjon start() -> heiltall {
    # ── to element ────────────────────────────────────────────────────────────
    la p1 = "funksjon start() -> heltall {\n" +
        "    la [a, b] = [3, 4]\n" +
        "    returner a * 10 + b\n" +
        "}\n"
    assert_eq(kør(p1), 34)

    # ── tre element ───────────────────────────────────────────────────────────
    la p2 = "funksjon start() -> heltall {\n" +
        "    la [x, y, z] = [5, 6, 7]\n" +
        "    returner x + y + z\n" +
        "}\n"
    assert_eq(kør(p2), 18)

    # ── frå funksjonsreturverdi ───────────────────────────────────────────────
    la p3 = "funksjon lag() -> liste { returner [11, 22] }\n" +
        "funksjon start() -> heltall {\n" +
        "    la [f, s] = lag()\n" +
        "    returner s - f\n" +
        "}\n"
    assert_eq(kør(p3), 11)

    # ── vanleg la er uendra ───────────────────────────────────────────────────
    la p4 = "funksjon start() -> heltall {\n" +
        "    la x: heltall = 42\n" +
        "    returner x\n" +
        "}\n"
    assert_eq(kør(p4), 42)

    # ── ordbok-destrukturering ────────────────────────────────────────────────
    la p5 = "funksjon start() -> heltall {\n" +
        "    la m: ordbok_heltall = {}\n" +
        "    m[\"x\"] = 8\n" +
        "    m[\"y\"] = 9\n" +
        "    la {x, y} = m\n" +
        "    returner x * 10 + y\n" +
        "}\n"
    assert_eq(kør(p5), 89)

    skriv("test_destrukturering OK\n")
    returner 0
}
