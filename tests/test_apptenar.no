# A6: std/apptenar.no i same prosess (ingen socket): tolking av hovudet, stimatch,
# responskontrakten og serialiseringa, 304-matrisa, HEAD, totale vakter, utrygge
# headerar, 404/405/OPTIONS og response-mellomvare. Rutene er definerte her.
bruk std.web som web
bruk std.apptenar som app

la _mw_teljar: ordbok = {"n": 0}

funksjon heim(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /")
    returner {"status": 200, "content_type": "text/html; charset=utf-8", "etag": "\"v1\"",
              "body": "<p>heim</p>", "headers": {"cache-control": "no-cache", "vary": "x-norscode-fragment"}}
}

funksjon ren_tekst(ctx: ordbok_tekst) -> tekst {
    web.route("GET /tekst")
    returner "berre tekst"
}

funksjon tom(ctx: ordbok_tekst) -> tekst {
    web.route("GET /tom")
    returner ""
}

funksjon status_tekst(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /lag")
    returner {"status": "201", "body": "{\"ok\":true}", "content_type": "application/json"}
}

funksjon injeksjon(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /injeksjon")
    returner {"status": 200, "body": "x", "headers": {"x-a": "ok\r\nSet-Cookie: stole=1"}}
}

funksjon vakt_kastar(ctx: ordbok_tekst) -> bool {
    web.guard()
    kast "vakt kasta"
}

funksjon vakt_tal(ctx: ordbok_tekst) -> bool {
    web.guard()
    returner 1
}

funksjon med_vakt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("vakt_kastar")
    web.route("GET /vakt")
    returner {"status": 200, "body": "nei"}
}

funksjon med_talvakt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.use_guard("vakt_tal")
    web.route("GET /talvakt")
    returner {"status": 200, "body": "nei"}
}

funksjon element(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /e/{id:int}")
    returner {"status": 200, "body": "e" + web.request_param(ctx, "id")}
}

funksjon element_slett(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("DELETE /e/{id:int}")
    returner {"status": 204, "body": ""}
}

funksjon fritt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /f/{namn}")
    returner {"status": 200, "body": "f" + web.request_param(ctx, "namn") + ":" + web.request_header(ctx, "X-Kasus")}
}

funksjon mw(svar: ordbok_tekst) -> ordbok_tekst {
    web.response_middleware()
    _mw_teljar["n"] = _mw_teljar["n"] + 1
    la h = {}
    hvis har_nokkel(svar, "headers") { h = svar["headers"] }
    h["x-mw"] = "ja"
    svar["headers"] = h
    returner svar
}

funksjon svar(rå: tekst) -> ordbok {
    la t = app.handsam_rå(rå)
    la slutt = builtin.index_of(t, "\r\n\r\n")
    la linjer = builtin.split(builtin.slice(t, 0, slutt), "\r\n")
    la h = {}
    la i = 1
    mens i < lengde(linjer) {
        la k = builtin.index_of(linjer[i], ":")
        h[builtin.lower(builtin.slice(linjer[i], 0, k))] = builtin.trim(builtin.slice(linjer[i], k + 1, lengde(linjer[i])))
        i = i + 1
    }
    returner {"status": heltall_fra_tekst(builtin.split(linjer[0], " ")[1]), "linje": linjer[0], "h": h,
              "body": builtin.slice(t, slutt + 4, lengde(t)), "rå": t}
}

funksjon get(sti: tekst, ekstra: tekst) -> ordbok {
    returner svar("GET " + sti + " HTTP/1.1\r\nHost: x\r\n" + ekstra + "\r\n")
}

funksjon h(r: ordbok, namn: tekst) -> tekst {
    hvis har_nokkel(r["h"], namn) { returner r["h"][namn] }
    returner ""
}

funksjon test_tolk() -> heltall {
    la r = app.tolk_hovud("GET /a/b?x=1&y=to HTTP/1.1\r\nHost: x\r\nCoOkie: a=1\r\ncookie: b=2\r\nAccept: text/html\r\nACCEPT: */*")
    assert(r["ok"])
    assert_eq(r["metode"], "GET")
    assert_eq(r["sti"], "/a/b")
    assert_eq(r["query"]["y"], "to")
    assert_eq(r["headers"]["cookie"], "a=1; b=2")
    assert_eq(r["headers"]["accept"], "text/html, */*")
    assert(r["keep_alive"])
    assert_eq(r["lengd"], -1)
    assert(ikkje app.tolk_hovud("GET / HTTP/1.1\r\nConnection: close")["keep_alive"])
    assert(ikkje app.tolk_hovud("GET / HTTP/1.0\r\nHost: x")["keep_alive"])
    assert(app.tolk_hovud("GET / HTTP/1.0\r\nConnection: keep-alive")["keep_alive"])
    assert_eq(app.tolk_hovud("POST / HTTP/1.1\r\nContent-Length: 12")["lengd"], 12)
    assert_eq(app.tolk_hovud("GET / HTTP/1.1\r\n folda: x")["status"], 400)
    assert_eq(app.tolk_hovud("GET /")["status"], 400)
    assert_eq(app.tolk_hovud("GET / HTTP/2.0")["status"], 505)
    assert_eq(app.tolk_hovud("GET x HTTP/1.1")["status"], 400)
    assert_eq(app.tolk_hovud("POST / HTTP/1.1\r\nTransfer-Encoding: chunked")["status"], 501)
    assert_eq(app.tolk_hovud("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 3")["status"], 400)
    assert_eq(app.tolk_hovud("POST / HTTP/1.1\r\nContent-Length: 3\r\nContent-Length: 4")["status"], 400)
    assert_eq(app.tolk_hovud("POST / HTTP/1.1\r\nContent-Length: 3a")["status"], 400)
    assert_eq(app.tolk_hovud("GET / HTTP/1.1\r\nHo st: x")["status"], 400)
    la langt = "x"
    la i = 0
    mens i < 8 {
        langt = langt + langt
        i = i + 1
    }
    assert_eq(app.tolk_hovud("GET / HTTP/1.1\r\n" + langt + ": 1")["status"], 431)
    skriv("tolk_hovud: 17 tilfelle (små bokstavar, samanslåtte headerar, keep-alive, 400/431/501/505)\n")
    returner 0
}

funksjon test_sti_og_etag() -> heltall {
    assert_eq(app.sti_match("/e/{id:int}", "/e/42")["id"], "42")
    assert_eq(app.sti_match("/e/{id:int}", "/e/-3")["id"], "-3")
    assert(app.sti_match("/e/{id:int}", "/e/x") == null)
    assert_eq(app.sti_match("/f/{namn}", "/f/åse/")["namn"], "åse")
    assert(app.sti_match("/f/{namn}", "/f/a/b") == null)
    assert(app.sti_match("/", "/") != null)
    assert(app.etag_passar("\"a\"", "\"a\""))
    assert(app.etag_passar("W/\"a\"", "\"a\""))
    assert(app.etag_passar("\"a\"", "W/\"a\""))
    assert(app.etag_passar("\"b\", W/\"a\"", "\"a\""))
    assert(app.etag_passar("*", "\"a\""))
    assert(ikkje app.etag_passar("*", ""))
    assert(ikkje app.etag_passar("\"b\"", "\"a\""))
    assert(ikkje app.etag_passar("\"a", "\"a\""))
    assert_eq(app.http_dato(0), "Thu, 01 Jan 1970 00:00:00 GMT")
    assert_eq(app.http_dato(951782400000), "Tue, 29 Feb 2000 00:00:00 GMT")
    assert_eq(app.http_dato(1790000000123), "Mon, 21 Sep 2026 14:13:20 GMT")
    skriv("sti_match, etag_passar og http_dato: OK\n")
    returner 0
}

funksjon test_dispatch() -> heltall {
    app.nullstill({"respons_mw": ["mw"], "logg": "ingen"})
    la g = get("/", "")
    assert_eq(g["status"], 200)
    assert_eq(h(g, "etag"), "\"v1\"")
    assert_eq(h(g, "content-type"), "text/html; charset=utf-8")
    assert_eq(h(g, "content-length"), "11")
    assert_eq(h(g, "x-mw"), "ja")
    assert_eq(h(g, "connection"), "keep-alive")
    assert_eq(g["body"], "<p>heim</p>")
    # HEAD: same headerar, ingen kropp
    la hd = svar("HEAD / HTTP/1.1\r\nHost: x\r\n\r\n")
    assert_eq(hd["status"], 200)
    assert_eq(h(hd, "content-length"), "11")
    assert_eq(h(hd, "content-type"), h(g, "content-type"))
    assert_eq(hd["body"], "")
    # 304-matrisa
    la n = get("/", "If-None-Match: W/\"v1\"\r\n")
    assert_eq(n["status"], 304)
    assert_eq(h(n, "etag"), "\"v1\"")
    assert_eq(h(n, "cache-control"), "no-cache")
    assert_eq(h(n, "vary"), "x-norscode-fragment")
    assert_eq(h(n, "content-length"), "")
    assert_eq(n["body"], "")
    assert_eq(get("/", "if-none-match: \"x\", \"v1\"\r\n")["status"], 304)
    assert_eq(get("/", "If-None-Match: *\r\n")["status"], 304)
    assert_eq(get("/", "If-None-Match: \"v2\"\r\n")["status"], 200)
    assert_eq(svar("POST /lag HTTP/1.1\r\nIf-None-Match: *\r\nContent-Length: 0\r\n\r\n")["status"], 201)
    # Tekstretur, tom retur, status som tekst
    la t = get("/tekst", "")
    assert_eq(t["status"], 200)
    assert_eq(h(t, "content-type"), "text/plain; charset=utf-8")
    assert_eq(t["body"], "berre tekst")
    assert_eq(get("/tom", "")["status"], 204)
    la l = svar("POST /lag HTTP/1.1\r\nContent-Length: 0\r\n\r\n")
    assert_eq(l["linje"], "HTTP/1.1 201 Created")
    # Vakter: unntak gjev 500 og tenaren lever; ikkje-bool gjev 403
    assert_eq(get("/vakt", "")["status"], 500)
    assert_eq(get("/", "")["status"], 200)
    assert_eq(get("/talvakt", "")["status"], 403)
    # Utrygg header (CR/LF i verdien) gjev 500, ikkje headerinjeksjon
    la inj = get("/injeksjon", "")
    assert_eq(inj["status"], 500)
    assert(builtin.index_of(inj["rå"], "stole") < 0)
    # Ruter: parametrar, kasus i headerar, 404, 405 med Allow, OPTIONS
    assert_eq(get("/e/7", "")["body"], "e7")
    assert_eq(get("/e/x", "")["status"], 404)
    assert_eq(get("/f/abc", "x-kasus: Liten\r\n")["body"], "fabc:Liten")
    la m = svar("PUT /e/7 HTTP/1.1\r\n\r\n")
    assert_eq(m["status"], 405)
    assert_eq(h(m, "allow"), "GET, DELETE, HEAD, OPTIONS")
    la o = svar("OPTIONS /e/7 HTTP/1.1\r\n\r\n")
    assert_eq(o["status"], 204)
    assert_eq(h(o, "allow"), "GET, DELETE, HEAD, OPTIONS")
    la f = get("/finst/ikkje", "")
    assert_eq(f["status"], 404)
    assert_eq(h(f, "x-content-type-options"), "nosniff")
    # Helse og 400 frå tolkinga
    assert_eq(get("/helse", "")["status"], 200)
    assert_eq(svar("GET / HTTP/9.9\r\n\r\n")["status"], 505)
    # Mellomvaren køyrde på alle ruter som svara (ikkje berre /helse)
    assert(_mw_teljar["n"] >= 10)
    skriv("dispatch: HEAD, 304-matrisa, tekstretur, totale vakter, headerinjeksjon, 404/405/OPTIONS og mellomvare (" + tekst(_mw_teljar["n"]) + " gonger)\n")
    returner 0
}

funksjon start() -> heltall {
    test_tolk()
    test_sti_og_etag()
    test_dispatch()
    skriv("test_apptenar OK\n")
    returner 0
}
