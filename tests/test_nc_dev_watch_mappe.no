bruk tools.nc_dev som dev
bruk std.filops som fo

// --watch <mappe>: fillista skal reflektere nye/sletta .no-filer ved kvar ekspandering.
funksjon start() -> heiltall {
    la mappe = "build/test_nc_dev_watch_mappe"
    fo.slett_tre(mappe)
    fo.lag_katalogar(mappe)
    la hovud = mappe + "/hovud.no"
    builtin.fil_skriv(hovud, "funksjon start() -> heiltall { returner 0 }\n")
    builtin.fil_skriv(mappe + "/a.no", "la x = 1\n")
    la f1 = dev.samle_filer(hovud, ".", [mappe])
    assert(dev.inneheld(f1, "./" + mappe + "/a.no"))
    assert(ikkje dev.inneheld(f1, "./" + mappe + "/ny.no"))
    la b1 = dev.øyeblikk(f1)
    // Ny fil i mappa
    builtin.fil_skriv(mappe + "/ny.no", "la y = 2\n")
    la f2 = dev.samle_filer(hovud, ".", [mappe])
    assert(dev.inneheld(f2, "./" + mappe + "/ny.no"))
    la alle = dev.slå_saman(f1, f2)
    la endra = dev.endra_filer(b1, dev.øyeblikk(alle), alle)
    assert_eq(lengde(endra), 1)
    // Sletting
    la b2 = dev.øyeblikk(alle)
    fo.slett_tre(mappe + "/ny.no")
    la endra2 = dev.endra_filer(b2, dev.øyeblikk(alle), alle)
    assert_eq(lengde(endra2), 1)
    fo.slett_tre(mappe)
    skriv("test_nc_dev_watch_mappe OK\n")
    returner 0
}
