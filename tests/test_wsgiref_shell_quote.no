bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/wsgiref.no")
    assert(t.inneholder(src, "HTTP-klient (rein Norscode HTTP/TLS)"))
    assert(t.inneholder(src, "bruk std.http som httpklient"))
    assert(t.inneholder(src, "httpklient.request_full(\"GET\", url, {}, {}, \"\", 15000)"))
    assert(t.inneholder(src, "httpklient.request_full(\"POST\", url, headers, {}, data, 15000)"))
    assert(t.inneholder(src, "httpklient.response_text(res_http)"))
    assert(t.inneholder(src, "httpklient.response_status(res_http)"))
    assert(t.inneholder(src, "builtin.fil_slett(tenar[\"pid_fil\"])"))
    assert(t.inneholder(src, "kan ikkje stoppe prosess utan native handle"))

    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "curl "))
    assert(ikkje t.inneholder(src, "kill "))
    assert(ikkje t.inneholder(src, "rm -f "))

    skriv("test_wsgiref_shell_quote OK")
    returner 0
}
