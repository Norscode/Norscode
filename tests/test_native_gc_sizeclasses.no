// Execute emitted x86 GC code, not an allocator model or source-text assertion.
// For an unpromoted source-built codegen candidate, set NORSCODE_GC_TEST_CODEGEN
// explicitly; normal CI uses bygg-native and its existing freshness gate.
bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon miljø(root: tekst) -> ordbok_tekst {
    returner {"NORSCODE_ROOT": root, "NORSCODE_CMD": "", "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "", "NORSCODE_GC_ALLOC": "1", "NC_BUILTIN_REPORT": "1",
        "NC_BUILTIN_KVITLISTE": "",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"}
}

funksjon krev_exit(r: ordbok_tekst, kode: heiltall) {
    hvis tekst(r["status"]) != "ferdig" eller heltall_fra_tekst(tekst(r["exit_code"])) != kode {
        prosess.skriv_resultat(r)
        assert_eq(tekst(r["status"]) + "/" + tekst(r["exit_code"]), "ferdig/" + tekst(kode))
    }
}

funksjon bygg(root: tekst, runtime: tekst, kjelde: tekst, ut: tekst) {
    la cg: tekst = miljo_hent("NORSCODE_GC_TEST_CODEGEN")
    hvis cg == "" {
        krev_exit(prosess.køyr(runtime, ["bygg-native", "--target", "linux-x86_64", kjelde, ut],
            root, miljø(root), 300000), 0)
        returner
    }
    la ncb: tekst = ut + ".ncb.json"
    krev_exit(prosess.køyr(runtime, ["bundle", "--output", ncb, kjelde],
        root, miljø(root), 300000), 0)
    la env = miljø(root)
    env["NC_INPUT"] = ncb
    env["NC_OUTPUT"] = ut
    la r = prosess.køyr(cg, [], root, env, 300000)
    krev_exit(r, 0)
    assert(builtin.contains(tekst(r["stdout"]), "uløyste=0 uventa=0"))
    assert(builtin.fil_sett_kjorbar(ut))
    filops.slett_fil(ncb)
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la maskin: tekst = tekst(info["machine"])
    hvis tekst(info["system"]) != "Linux" eller (maskin != "x86_64" og maskin != "amd64") {
        skriv("test_native_gc_sizeclasses: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root: tekst = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la runtime: tekst = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la prefix: tekst = "/tmp/norscode_gc_classes_" + builtin.random_hex(8)
    la namn: liste_tekst = ["gc_sizeclass_probe", "gc_ncb_serialize_probe", "gc_sizeclass_oom_probe", "gc_sameclass_probe"]
    la i: heiltall = 0
    mens i < lengde(namn) {
        la ut: tekst = prefix + "_" + tekst(i)
        bygg(root, runtime, root + "/tests/fixtures/" + namn[i] + ".no", ut)
        la r = prosess.køyr(ut, [], root, miljø(root), 60000)
        la venta: heiltall = 0
        hvis i == 2 { venta = 199 }
        krev_exit(r, venta)
        hvis i == 0 { assert(builtin.contains(tekst(r["stdout"]), "gc_sizeclass OK")) }
        hvis i == 1 { assert(builtin.contains(tekst(r["stdout"]), "gc_ncb_serialize OK: 60")) }
        hvis i == 3 { assert(builtin.contains(tekst(r["stdout"]), "gc_sameclass OK")) }
        hvis i == 2 {
            assert(builtin.contains(tekst(r["stdout"]) + tekst(r["stderr"]), "GC-heap full"))
        }
        prosess.skriv_resultat(r)
        filops.slett_fil(ut)
        i = i + 1
    }
    skriv("test_native_gc_sizeclasses OK\n")
    returner 0
}
