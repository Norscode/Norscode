# R3 / F27: valfri streng statisk typesjekk på javac-nivå (NORSCODE_STRICT_TYPAR=1
# eller `nc check --strict`). Argument-, retur-, deklarasjons-, omtilordnings-,
# felt-, element- og operandtypar; heltall vs desimaltall; ukjende typenamn;
# generisk substitusjon; metodekall; manglande returner, bruk før tilordning og
# uoppnåeleg kode. Diagnosane har fil:linje:kolonne. Utan flagget kompilerer
# alle programma som før (typar er erased). Køyrer gjennom KJELDE-kompilatoren.

bruk selfhost.kompiler som kompiler

funksjon streng_feil(kjelde: tekst) -> tekst {
    miljo_sett("NORSCODE_STRICT_TYPAR", "1")
    la ut = ""
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        ut = kompiler.diagnose_med_fil("p.no", tekst(e))
    }
    miljo_sett("NORSCODE_STRICT_TYPAR", "")
    returner ut
}

funksjon mjuk_ok(kjelde: tekst) -> boolsk {
    miljo_sett("NORSCODE_STRICT_TYPAR", "")
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        skriv("uventa feil utan flagg: " + tekst(e) + "\n")
        returner usann
    }
    returner sann
}

funksjon krev(kjelde: tekst, fyrste_linje: tekst) -> heltall {
    la f = streng_feil(kjelde)
    la linjer = builtin.split(f, "\n")
    assert_eq(linjer[0], fyrste_linje)
    assert(mjuk_ok(kjelde))
    returner 0
}

funksjon start() -> heltall {
    la st = "funksjon start() -> heltall {\n"

    // t01 argument, t02 retur, t03 deklarasjon, t04 omtilordning (deklarert og utleidd)
    krev("funksjon tar(x: heltall) -> heltall {\n    returner x\n}\n" + st + "    la a = tar(\"t\")\n    returner 0\n}\n",
         "p.no:5:16: Typefeil - argument 1 til tar() er tekst, venta heltall")
    krev("funksjon f() -> heltall {\n    returner \"t\"\n}\n", "p.no:2:5: Typefeil - returnerer tekst, funksjonen er deklarert heltall")
    krev(st + "    la c: heltall = \"t\"\n    returner 0\n}\n", "p.no:2:5: Typefeil - la c: heltall får tekst")
    krev(st + "    la c: heltall = 1\n    c = \"t\"\n    skriv(type(c))\n    returner 0\n}\n", "p.no:3:5: Typefeil - c er heltall, får tekst")
    krev(st + "    la s = \"a\"\n    s = 42\n    returner 0\n}\n", "p.no:3:5: Typefeil - s er tekst (utleidd frå la), får heltall")

    // t05/t17 felt: feil felttype, ukjent felt; struktur mot ordbok/heltall/annan struktur
    la pk = "struktur Punkt {\n    x: heltall\n}\nstruktur Kvadrat {\n    s: heltall\n}\n"
    krev(pk + st + "    la p = Punkt()\n    p.x = \"t\"\n    returner 0\n}\n", "p.no:9:6: Typefeil - Punkt.x er heltall, får tekst")
    krev(pk + st + "    la p = Punkt()\n    la v = p.z\n    returner 0\n}\n", "p.no:9:13: Typefeil - Punkt har ikkje feltet z")
    krev(pk + st + "    la q: Punkt = {\"a\": 1}\n    returner 0\n}\n", "p.no:8:5: Typefeil - la q: Punkt får ordbok<tekst,heltall>")
    krev(pk + st + "    la k = Kvadrat()\n    la p: Punkt = k\n    returner 0\n}\n", "p.no:9:5: Typefeil - la p: Punkt får Kvadrat")

    // t06/t07/g10b elementtypar
    krev(st + "    la l: liste<heltall> = [1, 2]\n    legg_til(l, \"tre\")\n    returner 0\n}\n", "p.no:3:17: Typefeil - legg_til: liste<heltall> får element av type tekst")
    krev(st + "    la m: liste<heltall> = [\"a\"]\n    returner 0\n}\n", "p.no:2:5: Typefeil - la m: liste<heltall> får liste<tekst>")
    krev(st + "    la o: ordbok<tekst, heltall> = {}\n    o[\"a\"] = \"x\"\n    returner 0\n}\n", "p.no:3:5: Typefeil - element i ordbok<tekst,heltall> er heltall, får tekst")
    krev("funksjon sum(l: liste<heltall>) -> heltall {\n    returner 0\n}\n" + st + "    returner sum([\"x\"])\n}\n", "p.no:5:18: Typefeil - argument 1 til sum() er liste<tekst>, venta liste<heltall>")

    // t21 heltall vs desimaltall (heltall -> desimaltall er lov)
    krev(st + "    la y: desimaltall = 2\n    la x: heltall = 3.5\n    returner 0\n}\n", "p.no:3:5: Typefeil - la x: heltall får desimaltall")

    // t15 ukjende typenamn
    krev("funksjon f(x: Tulletype) -> heltall {\n    returner 1\n}\n", "p.no:1:15: Typefeil - ukjend type Tulletype")

    // generisk substitusjon: T blir bunden frå argumentet
    la gen = "funksjon fyrste<T>(l: liste<T>) -> T {\n    returner l[0]\n}\n"
    krev(gen + st + "    la t: tekst = fyrste([7, 8])\n    returner 0\n}\n", "p.no:5:5: Typefeil - la t: tekst får heltall")
    krev("funksjon par<T>(a: T, b: T) -> T {\n    returner a\n}\n" + st + "    returner par(1, \"x\")\n}\n", "p.no:5:21: Typefeil - argument 2 til par() er tekst, venta heltall")

    // metodekall: argumenttype og ukjend metode
    la konto = "struktur Konto {\n    saldo: heltall\n}\nfunksjon Konto.inn(self, b: heltall) -> heltall {\n    self.saldo = self.saldo + b\n    returner self.saldo\n}\n"
    krev(konto + st + "    la k = Konto()\n    la r = k.inn(\"x\")\n    returner 0\n}\n", "p.no:10:18: Typefeil - argument 1 til Konto.inn() er tekst, venta heltall")
    krev(konto + st + "    la k = Konto()\n    la r = k.ut(1)\n    returner 0\n}\n", "p.no:10:13: Typefeil - Konto har ingen metode ut()")

    // t18 manglande returner, t22 bruk før tilordning, t24 uoppnåeleg kode
    krev("funksjon f(n: heltall) -> heltall {\n    hvis n > 0 {\n        returner 1\n    }\n}\n", "p.no:1:1: Typefeil - funksjon f manglar returner på minst éin veg (deklarert -> heltall)")
    krev(st + "    la x: heltall\n    skriv(tekst(x))\n    returner 0\n}\n", "p.no:3:17: Typefeil - x er brukt før han har fått ein verdi")
    krev("funksjon f() -> heltall {\n    returner 1\n    skriv(\"x\")\n}\n", "p.no:3:5: Typefeil - uoppnåeleg kode etter Returner")

    // A3 (streng): vilkår og operandar til ikkje/og/eller må vere boolsk.
    krev(st + "    hvis 5 {\n        skriv(\"x\")\n    }\n    returner 0\n}\n", "p.no:2:10: Typefeil - vilkåret i hvis må vere bool, fekk heltall")
    krev(st + "    la n: heltall = 3\n    mens n {\n        n = n - 1\n    }\n    returner 0\n}\n", "p.no:3:10: Typefeil - vilkåret i mens må vere bool, fekk heltall")
    krev(st + "    hvis 1 > 2 {\n        returner 1\n    } ellers hvis \"t\" {\n        returner 2\n    }\n    returner 0\n}\n", "p.no:4:19: Typefeil - vilkåret i hvis må vere bool, fekk tekst")
    krev(st + "    la b = ikkje 5\n    returner 0\n}\n", "p.no:2:18: Typefeil - operanden til ikkje må vere bool, fekk heltall")
    krev(st + "    la b = (1 > 2) og 1\n    returner 0\n}\n", "p.no:2:23: Typefeil - operanden til og må vere bool, fekk heltall")
    krev("funksjon f(s: tekst) -> tekst {\n    returner s eller \"\"\n}\n", "p.no:2:14: Typefeil - operanden til eller må vere bool, fekk tekst")

    // Fleire feil: éin diagnose per linje.
    la fleire = streng_feil(st + "    la a: heltall = \"x\"\n    la b: tekst = 1\n    returner 0\n}\n")
    assert_eq(fleire, "p.no:2:5: Typefeil - la a: heltall får tekst\np.no:3:5: Typefeil - la b: tekst får heltall")

    // Gyldige program: ingen falske positive i streng modus.
    la gyldig = gen + pk + konto
    gyldig = gyldig + "grensesnitt Form {\n    funksjon areal(self) -> heltall\n}\nstruktur Sirkel implementerer Form { r: heltall }\nfunksjon Sirkel.areal(self) -> heltall {\n    returner 3 * self.r * self.r\n}\n"
    gyldig = gyldig + "funksjon areal_av(f: Form) -> heltall {\n    returner f.areal()\n}\n"
    gyldig = gyldig + "funksjon tal_eller(n: heltall?) -> heltall {\n    hvis n == ingenting {\n        returner 0\n    } ellers {\n        returner n\n    }\n}\n"
    gyldig = gyldig + "funksjon logikk(a: bool, n: heltall?) -> heltall {\n    hvis ikkje a og (n != ingenting eller a) {\n        returner n ?? 0\n    }\n    returner 1\n}\n"
    gyldig = gyldig + "funksjon evig() -> heltall {\n    mens sann {\n        returner 1\n    }\n}\n"
    gyldig = gyldig + st + "    la s = Sirkel()\n    s.r = 2\n    la a: heltall = areal_av(s)\n    la d: desimaltall = 2\n    d = d * 1.5\n    la l: liste<heltall> = [1, 2]\n    legg_til(l, 3)\n    la v: heltall = fyrste(l)\n    la o: ordbok<tekst, liste<heltall>> = {}\n    o[\"a\"] = l\n    la k = Konto()\n    k.saldo = 1\n    k.inn(4)\n    la x: heltall\n    hvis a > 1 {\n        x = 1\n    } ellers {\n        x = 2\n    }\n    la t = \"n=\" + tekst(x) + 1\n    returner v + x\n}\n"
    assert_eq(streng_feil(gyldig), "")
    skriv("typesjekk ok\n")
    returner 0
}
