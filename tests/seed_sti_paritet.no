// SEED-ONLY (ikkje test_-prefiks med vilje): køyrer berre i seed-porten.
//
// std/path.no kallar dei nakne builtinane sti_basename/sti_dirname/sti_stem.
// VM-en hadde armar berre for path.*-aliasa og sti_join → «Ukjent innebygd
// funksjon: builtin.sti_basename» på fersk seed. Målt 2026-09-10:
//   committa Linux-stage0: alle forventningane under held.
//   committa macOS-stage0: manglar builtin.sti_basename (og sti_join) heilt —
//   difor seed-only; testen ville vore raud i macOS-banane.
// Punktfiler (".bashrc") er utelatne med vilje: Linux-stage0 gjev stem "" og
// den arkiverte C-kjelda ".bashrc" — ope semantikkval, ikkje ein paritetsfeil.

bruk std.path som path

funksjon start() -> heiltall {
    assert_eq(path.basename("docs/README.md"), "README.md")
    assert_eq(path.basename("a/"), "")
    assert_eq(path.basename("fil"), "fil")
    assert_eq(path.dirname("docs/README.md"), "docs")
    assert_eq(path.dirname("fil"), ".")
    assert_eq(path.dirname("/x"), "/")
    assert_eq(path.dirname("/"), "/")
    assert_eq(path.dirname("a/b/"), "a/b")
    assert_eq(path.stem("docs/README.md"), "README")
    assert_eq(path.stem("a.tar.gz"), "a.tar")
    assert_eq(path.stem("utan_ending"), "utan_ending")
    skriv("seed_sti_paritet OK\n")
    returner 0
}
