bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/shutil.no")

    assert(t.inneholder(src, "Norscode-eigde høgnivå fil- og katalogoperasjonar"))
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(src, "bruk std.tarfile som tarfile"))
    assert(t.inneholder(src, "bruk std.gzip som gzip"))
    assert(t.inneholder(src, "returner filops.kopier"))
    assert(t.inneholder(src, "returner filops.kopier_tre"))
    assert(t.inneholder(src, "returner filops.slett_tre"))
    assert(t.inneholder(src, "returner filops.flytt"))
    assert(t.inneholder(src, "format != \"tar\" og format != \"gztar\""))
    assert(t.inneholder(src, "tarfile.extractall_enkel"))
    assert(t.inneholder(src, "gzip.dekomprimer_fil"))

    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "rm -rf"))
    assert(ikkje t.inneholder(src, "mkdir -p"))
    assert(ikkje t.inneholder(src, "find "))
    assert(ikkje t.inneholder(src, "tar -"))
    assert(ikkje t.inneholder(src, "gzip -"))
    assert(ikkje t.inneholder(src, "unzip "))
    assert(ikkje t.inneholder(src, "cp -"))
    assert(ikkje t.inneholder(src, "mv "))

    skriv("test_shutil_native_surface OK")
    returner 0
}
