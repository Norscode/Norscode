// Dual-format NCB-serde: binær round-trip, JSON-fallback, magic-deteksjon,
// byte-determinisme, og alle NcVal-typar (særleg PUSH_CONST null vs int 0).
// Hermetisk: byggjer NCB-strukturen i testen, ingen ekstern fil.

bruk selfhost.ncb_serde som serde

// Representativ NCB med alle typar + null-konstant (regresjon for null→0-bugen).
funksjon lag_ncb() -> ordbok {
    la null_val = builtin.json_parse_raw("null")   // ekte ingenting (json_skriv → "null")
    returner {
        "format": "ncb-v1",
        "entry": "__main__.start",
        "imports": [],
        "functions": {
            "__main__.start": {
                "name": "start",
                "module": "__main__",
                "params": [],
                "is_async": usann,
                "code": [
                    ["PUSH_CONST", null_val],       // ← null-konstant må overleve
                    ["PUSH_CONST", 0],              // ← int 0, må IKKJE bli forveksla med null
                    ["PUSH_CONST", -12345],         // negativt (zigzag)
                    ["PUSH_CONST", "tekst med \"hermetegn\" og æøå"],
                    ["PUSH_CONST", sann],
                    ["PUSH_CONST", usann],
                    ["BUILD_LIST", 3],
                    ["RETURN"]
                ],
                "source_lines": [1, 2, 3, 4, 5, 6, 7, 8],
                "source_columns": [5, 5, 5, 5, 5, 5, 5, 5]
            }
        }
    }
}

funksjon feil(m: tekst) -> heiltall { skriv("FEIL: " + m + "\n") returner 1 }

funksjon start() -> heiltall {
    la ncb = lag_ncb()

    // 1. serialiser → binær med magic
    la bytes = serde.serialiser(ncb)
    hvis ikkje serde.er_binaer(bytes) { returner feil("magic ikkje detektert på serialisert output") }

    // 2. deserialiser binær
    la ncb_b = serde.deserialiser(bytes)
    hvis ikkje har_nokkel(ncb_b, "functions") { returner feil("binær-veg manglar functions") }

    // 3. null-konstant må framleis vere null (ikkje 0), int 0 må framleis vere 0
    la kode = ncb_b["functions"]["__main__.start"]["code"]
    hvis builtin.json_skriv(kode[0][1]) != "null" { returner feil("PUSH_CONST null → " + builtin.json_skriv(kode[0][1])) }
    hvis builtin.json_skriv(kode[1][1]) != "0" { returner feil("PUSH_CONST 0 endra til " + builtin.json_skriv(kode[1][1])) }
    hvis kode[2][1] != -12345 { returner feil("negativt tal endra: " + tekst(kode[2][1])) }

    // 4. JSON-tekst gjennom SAME deserialiser (bakoverkompat)
    la ncb_j = serde.deserialiser(builtin.json_skriv(ncb))
    hvis ikkje har_nokkel(ncb_j, "functions") { returner feil("JSON-veg manglar functions") }
    hvis builtin.json_skriv(ncb_j["functions"]["__main__.start"]["code"][0][1]) != "null" {
        returner feil("JSON-veg: null-konstant tapt")
    }

    // 5. JSON-byte (utan magic) gjennom deserialiser
    la jbytes: liste_heiltall = []
    la jt = builtin.json_skriv(ncb)
    la i = 0
    mens i < lengde(jt) { legg_til(jbytes, builtin.char_code(builtin.slice(jt, i, i+1)) & 255) i = i + 1 }
    hvis serde.er_binaer(jbytes) { returner feil("JSON-byte feilaktig detektert som binær") }
    la ncb_jb = serde.deserialiser(jbytes)
    hvis ikkje har_nokkel(ncb_jb, "functions") { returner feil("JSON-byte-veg manglar functions") }

    // 6. determinisme: serialiser to gonger → byte-identisk
    la bytes2 = serde.serialiser(serde.deserialiser(bytes))
    hvis lengde(bytes) != lengde(bytes2) { returner feil("determinisme: ulik lengd") }
    la d = 0
    for x i bytes { hvis x != bytes2[d] { returner feil("byte-drift @" + tekst(d)) } d = d + 1 }

    // 7. debug-metadata (source_lines/columns) strippa i binærforma
    hvis har_nokkel(ncb_b["functions"]["__main__.start"], "source_lines") {
        returner feil("source_lines ikkje strippa i binær")
    }

    skriv("test_ncb_serde_dualformat: OK (" + tekst(lengde(bytes)) + " binærbyte, deterministisk)\n")
    returner 0
}
