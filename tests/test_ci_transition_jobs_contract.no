bruk std.tekst som t

funksjon start() -> heiltall {
    la gc = fil_les("tools/ci_native_gc.no")
    la workflow = fil_les(".github/workflows/ci.yml")
    assert(t.inneholder(gc, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(gc, "tests/test_runtime_memory.no"))
    assert(t.inneholder(gc, "tests/test_runtime_gc_generational.no"))
    assert(t.inneholder(gc, "tests/test_runtime_memory_parallel_gc.no"))
    assert(t.inneholder(gc, "tests/test_native_gc_reference_graph.no"))
    assert(t.inneholder(gc, "tests/test_vm_gc_root_dedup.no"))
    assert(t.inneholder(gc, "prosess.køyr_med_grenser"))
    assert(ikkje t.inneholder(gc, "exec_prosess"))
    assert(ikkje t.inneholder(gc, ".c"))
    assert(ikkje t.inneholder(gc, "/usr/bin/cc"))
    assert(ikkje t.inneholder(gc, "-fsanitize"))
    assert(t.inneholder(workflow, "tools/ci_native_gc.no"))
    assert(ikkje t.inneholder(workflow, "tools/ci_native_gc_transition.no"))
    assert(ikkje builtin.fil_finnes("tools/ci_linux_packages.no"))
    assert(ikkje t.inneholder(workflow, "Installer sqlite3"))
    assert(ikkje t.inneholder(workflow, "libsqlite3-dev"))
    assert(ikkje t.inneholder(workflow, "ci_linux_packages.no"))
    skriv("test_ci_transition_jobs_contract OK\n")
    returner 0
}
