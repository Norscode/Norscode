bruk std.fjern_agent som agent
bruk std.krypto som krypto

// M6: einingstest for den sikkerheitskritiske protokoll-logikken i std.fjern_agent
// (HMAC challenge-response), utan sockets. Verifiserer determinisme, at feil token
// / fersk nonce / endra argv gir ulik signatur, konstanttids-samanlikning og at
// HMAC-en er 64 hex (SHA-256). Live socket-transport testast separat (sjå
// test_fjern_agent_loopback.no; den er per no blokkert av runtime-socket-åtferd).

funksjon start() -> heiltall {
    la f = 0
    la nonce = "nonce-abc123"
    la argv: liste_tekst = ["/usr/bin/printf", "hei"]

    // 1) determinisme
    la a = agent.signer("token1", nonce, argv)
    la b = agent.signer("token1", nonce, argv)
    assert(a == b)

    // 2) feil token → ulik signatur (auth-avvising)
    assert(agent.signer("token2", nonce, argv) != a)

    // 3) fersk nonce → ulik signatur (replay-vern)
    assert(agent.signer("token1", "nonce-XYZ", argv) != a)

    // 4) endra argv → ulik signatur (integritet mot kommando-tukling)
    assert(agent.signer("token1", nonce, ["/bin/rm", "-rf"]) != a)

    // 5) konstanttids-samanlikning: lik / ulik
    assert(krypto.konstant_lik(a, b))
    assert(ikkje krypto.konstant_lik(a, "feil"))

    // 6) HMAC-SHA256 = 64 hex-teikn
    assert(lengde(a) == 64)

    skriv("test_fjern_agent_signer: OK (7 assertar)\n")
    returner f
}
