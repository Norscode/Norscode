// Gjeldande nc_main må bevare streng builtin-policy gjennom det lukka miljøet
// til bygg-native sin førehandsbygde codegen, også ved eksplisitt kvitliste.
// Ferske runtimar blir alltid prøvde gjennom sin innebygde CLI. Berre den
// eksakte eldre Linux-stage0-en får tolke dagens CLI-kjelde som bootstrap.
bruk std.runtime.process_abi som abi
bruk tools.no_c_python_active_surface som flate

funksjon klargjer_kjeldeeigar(root: tekst, runtime: tekst, ut: tekst) -> tekst {
    // Hash heile den faktisk valde binæren gjennom den isolerte, binærsikre
    // hjelparen. Lesefeil skal feile testen, aldri velje ei kompatibilitetsrute.
    la sha = flate.fil_sha256(runtime)
    assert_eq(lengde(sha), 64)
    hvis sha != "1f7b588917c47e5c68dce3000df6f9bc7d8cde8e5e90e669a5fb1c7a0f62de48" {
        skriv("native-cli builtin: direkte runtime\n")
        returner ""
    }
    // Denne frosne stage0-en frå ee71687 har ikkje policy-felta i sin
    // innebygde CLI. Han skal framleis køyre alle fire kontrollane av dagens
    // kjeldeeigar. Kompiler eigaren éin gong, før fire isolerte CLI-kall.
    skriv("native-cli builtin: gjeldande kjeldeeigar på SHA-bunden bootstrap\n")
    la req = abi.request(runtime, [], root, "", 120000, 65536)
    abi.sett_sandbox(req, "none", 0, 64, usann)
    abi.sett_environment(req, {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": root + "/tests/fixtures/native_cli_builtin_owner.no",
        "NORSCODE_OUTPUT": ut,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1", "NORSCODE_VM_FAST": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    })
    la res = builtin.process_spawn_argv(req)
    skriv(tekst(res["stdout"]))
    skriv(tekst(res["stderr"]))
    assert_eq(tekst(res["status"]), "ferdig")
    assert_eq(heltall_fra_tekst(tekst(res["exit_code"])), 0)
    assert(builtin.fil_finnes(ut))
    returner ut
}

funksjon bygg(root: tekst, runtime: tekst, inn: tekst, ut: tekst, kvitliste: tekst, kjelde_ncb: tekst) {
    la args: liste_tekst = ["bygg-native", "--target", "linux-x86_64", "--ncb", inn, ut]
    la miljø = {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "", "NORSCODE_FILE": "",
        "NC_BUILTIN_REPORT": "1", "NC_BUILTIN_KVITLISTE": kvitliste,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1", "NORSCODE_VM_FAST": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    hvis kjelde_ncb != "" {
        args = []
        miljø["NORSCODE_CMD"] = "run-ncb-pure"
        miljø["NORSCODE_FILE"] = kjelde_ncb
        miljø["NC_TEST_NATIVE_CLI_INPUT"] = inn
        miljø["NC_TEST_NATIVE_CLI_OUTPUT"] = ut
    }
    la req = abi.request(runtime, args, root, "", 300000, 65536)
    abi.sett_sandbox(req, "none", 0, 64, usann)
    abi.sett_environment(req, miljø)
    returner builtin.process_spawn_argv(req)
}

funksjon sjekk(r, kode: heiltall, rapport: tekst) {
    skriv(tekst(r["stdout"]))
    skriv(tekst(r["stderr"]))
    assert_eq(tekst(r["status"]), "ferdig")
    assert_eq(heltall_fra_tekst(tekst(r["exit_code"])), kode)
    assert(builtin.contains(tekst(r["stdout"]), rapport))
    assert(ikkje builtin.contains(tekst(r["stdout"]), "ÅTVARING:"))
}

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la runtime = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la base = root + "/build/cli_builtin_" + builtin.random_hex(8)
    builtin.mkdir_p(root + "/build")
    la kjelde_ncb = klargjer_kjeldeeigar(root, runtime, base + ".cli.ncb.json")
    la inn = base + ".ncb.json"
    la ut = base + ".elf"
    la fn = {"params": [], "code": [["PUSH_CONST", 0], ["RETURN"]]}
    la program = {"format": "norscode-bytecode-v1", "entry": "start", "functions": {"start": fn}}
    builtin.fil_skriv(inn, builtin.json_skriv(program))
    sjekk(bygg(root, runtime, inn, ut, "", kjelde_ncb), 0, "BUILTIN-RAPPORT uløyste=0 uventa=0")
    assert(builtin.fil_finnes(ut))
    la ukjent = "builtin.norscode_test_uloeyst_kall"
    fn["code"] = [["PUSH_CONST", 7], ["CALL", ukjent, 1], ["POP"], ["PUSH_CONST", 0], ["RETURN"]]
    builtin.fil_skriv(inn, builtin.json_skriv(program))
    sjekk(bygg(root, runtime, inn, ut, "", kjelde_ncb), 3, "uventa=1")
    assert(ikkje builtin.fil_finnes(ut))
    sjekk(bygg(root, runtime, inn, ut, ukjent + "/2", kjelde_ncb), 3, "uventa=1")
    assert(ikkje builtin.fil_finnes(ut))
    sjekk(bygg(root, runtime, inn, ut, ukjent + "/1", kjelde_ncb), 0, "BUILTIN-RAPPORT uløyste=1 uventa=0")
    assert(builtin.fil_finnes(ut))
    builtin.fil_slett(inn)
    builtin.fil_slett(ut)
    hvis kjelde_ncb != "" { builtin.fil_slett(kjelde_ncb) }
    skriv("test_native_cli_builtin_gate OK\n")
    returner 0
}
