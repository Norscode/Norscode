# R2 / F14: globalar og konstantar på tvers av modular. alias.NAMN les ein
# modulglobal i ein annan modul (LOAD_GLOBAL NAMN modul), alias.NAMN = v og
# alias.NAMN += v skriv han (STORE_GLOBAL NAMN modul); ein konst i den andre
# modulen kan ikkje tilordnast (kompileringsfeil). Ein modul med berre
# toppnivå-setningar får __module_init__, og hovudmodulen utan start() køyrer
# som skript. Initialisatorane blir ordna i avhengnadsrekkjefølgje av
# bundler.ordne_initialiserarar (som nc_main brukar). Køyrer gjennom
# KJELDE-kompilator + VM; modulane blir kompilerte kvar for seg og slegne saman.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.bundler som bundler

funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon start() -> heiltall {
    # Same rekkjefølgje som BFS-køa i nc_main (importane til hovudmodulen).
    la modular = ["tests.fixtures.r2_init_a", "tests.fixtures.r2_init_b", "tests.fixtures.r2_init_c", "tests.fixtures.r2_logg"]
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les("tests/fixtures/r2_modulglobal.no"), "__main__"))
    la inits = []
    la importar = {}
    bundler.registrer_modulimportar(importar, ncb, "__main__")
    la mi = 0
    mens mi < lengde(modular) {
        la m = modular[mi]
        la sti = builtin.replace(m, ".", "/") + ".no"
        la mncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les(sti), m))
        bundler.slå_saman_funksjonar(ncb["functions"], mncb["functions"])
        bundler.slå_saman_modulmetadata(inits, ncb["global_names"], mncb)
        bundler.registrer_modulimportar(importar, mncb, m)
        mi = mi + 1
    }
    bundler.slå_saman_modulmetadata(inits, ncb["global_names"], ncb)
    # Samanslåingsrekkjefølgja (a, b, c, logg, hovud) ville køyrt A før logg
    # og B før C; ordne_initialiserarar gjev avhengnadsrekkjefølgja.
    ncb["module_initializers"] = bundler.ordne_initialiserarar(inits, importar, "__main__")
    assert_eq(builtin.join(ncb["module_initializers"], ","), "tests.fixtures.r2_logg.__module_init__,tests.fixtures.r2_init_a.__module_init__,tests.fixtures.r2_init_c.__module_init__,tests.fixtures.r2_init_b.__module_init__,__main__.__module_init__")
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "init=A,C,B,H;B=20 C=10 GRENSE=3;skrive=50;auke=51/51;a=a")

    # Konstant i ein annan modul kan ikkje tilordnast.
    la konst_skriv = "bruk tests.fixtures.r2_init_c som c\n" +
        "funksjon start() -> heltall {\n" +
        "    c.GRENSE = 5\n" +
        "    returner 0\n" +
        "}\n"
    assert_eq(kompileringsfeil(konst_skriv), "Konstfeil linje 3: kan ikkje tilordne til konstanten tests.fixtures.r2_init_c.GRENSE")

    # Skriptmodus: hovudmodul utan start(); toppnivåkoden køyrer som modul-init.
    la skript = "la x = 2\n" +
        "kast \"skript x=\" + tekst(x * 21)\n"
    la skript_feil = ""
    prøv {
        vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(skript, "__main__")))
    } fang (e) {
        skript_feil = tekst(e)
    }
    assert_eq(skript_feil, "skript x=42")
    la skript2 = "la y = 1\nskriv(\"\")\n"
    assert_eq(tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(skript2, "__main__")))), "0")
    returner 0
}
