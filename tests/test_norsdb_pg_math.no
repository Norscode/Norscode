// Postgres-utvidingar batch 4: matte-funksjonar + string_agg (alias for group_concat).
// Golden = dokumentert PostgreSQL-semantikk.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la rad = {"x": "1"}

    // ceil / ceiling
    assert_eq(sql.evaluer_uttrykk("ceil(4.2)", rad), "5")
    assert_eq(sql.evaluer_uttrykk("ceil(-4.2)", rad), "-4")
    assert_eq(sql.evaluer_uttrykk("ceil(4)", rad), "4")
    assert_eq(sql.evaluer_uttrykk("ceiling(4.2)", rad), "5")
    // floor
    assert_eq(sql.evaluer_uttrykk("floor(4.7)", rad), "4")
    assert_eq(sql.evaluer_uttrykk("floor(-4.2)", rad), "-5")
    // trunc
    assert_eq(sql.evaluer_uttrykk("trunc(4.7)", rad), "4")
    assert_eq(sql.evaluer_uttrykk("trunc(-4.7)", rad), "-4")
    // power / pow
    assert_eq(sql.evaluer_uttrykk("power(2, 10)", rad), "1024")
    assert_eq(sql.evaluer_uttrykk("power(2, 0)", rad), "1")
    assert_eq(sql.evaluer_uttrykk("power(2, -1)", rad), "0.5")
    assert_eq(sql.evaluer_uttrykk("pow(5, 3)", rad), "125")
    // div (heiltalskvotient)
    assert_eq(sql.evaluer_uttrykk("div(7, 2)", rad), "3")
    assert_eq(sql.evaluer_uttrykk("div(8, 3)", rad), "2")
    // pi
    assert_eq(sql.evaluer_uttrykk("pi()", rad), "3.141592653589793")

    // string_agg = group_concat med separator
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, namn TEXT)")
    sql.exec(db, "INSERT INTO folk (id, namn) VALUES (1, 'Ada')")
    sql.exec(db, "INSERT INTO folk (id, namn) VALUES (2, 'Bo')")
    sql.exec(db, "INSERT INTO folk (id, namn) VALUES (3, 'Cy')")
    assert_eq(sql.query_rader(db, "SELECT string_agg(namn, ', ') FROM folk"), "Ada, Bo, Cy")

    returner 0
}
