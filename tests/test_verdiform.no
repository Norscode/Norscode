# Test for std.verdiform (strukturell nøkkel, likskap og visingsform).
# tekst(v) gjev "[verdi]" for alle lister og ordbøker; testen sjekkar at
# nøkkel/lik skil samlingar på innhald og at vis gjev innhaldet. Eksplisitte
# samanlikningar (ikkje assert), så testen òg feilar i native AOT.
bruk std.verdiform som vfm
bruk std.valfri som vf

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

funksjon _b(x: bool) -> tekst {
    hvis x { returner "J" }
    returner "N"
}

# Tel ulike nøklar i xs (for å prøve at nøkkel er injektiv over ei heil gruppe).
funksjon _ulike(xs) -> heiltall {
    la sett = {}
    for x i xs {
        sett[vfm.nøkkel(x)] = sann
    }
    returner lengde(nøkler(sett))
}

funksjon _likskap(res: ordbok) {
    # Typen tel: 1, 1.5-typen, "1", sann og ingenting er ulike; like skalarar er like.
    _sjekk(res, "skalar-typar", tekst(_ulike([1, "1", sann, ingenting, 1.0, usann, 0, ""])), "8")
    _sjekk(res, "skalar lik", _b(vfm.lik(7, 7)) + _b(vfm.lik("ab", "ab")) + _b(vfm.lik(sann, sann)) + _b(vfm.lik(ingenting, ingenting)), "JJJJ")
    _sjekk(res, "negative tal", _b(vfm.lik(-5, 5)) + _b(vfm.lik(-5, -5)) + _b(vfm.lik(0, -0)), "NJJ")
    _sjekk(res, "store tal", _b(vfm.lik(9223372036854775807, 9223372036854775807)) + _b(vfm.lik(9223372036854775807, 9223372036854775806)), "JN")

    # Lister: innhald og rekkjefølgje.
    _sjekk(res, "liste lik", _b(vfm.lik([1, 2], [1, 2])) + _b(vfm.lik([1, 2], [2, 1])) + _b(vfm.lik([1, 2], [1, 2, 3])) + _b(vfm.lik([], [])), "JNNJ")
    _sjekk(res, "liste nøsta", _b(vfm.lik([[1], [2, [3]]], [[1], [2, [3]]])) + _b(vfm.lik([[1], [2, [3]]], [[1], [2, [4]]])), "JN")
    _sjekk(res, "liste vs ordbok", _b(vfm.lik([], {})) + _b(vfm.lik([ingenting], [])), "NN")
    # Injektiv: separator- og siffer-teikn inne i tekst kan ikkje lage kollisjon.
    _sjekk(res, "liste injektiv", tekst(_ulike([[1, 2], ["1", "2"], ["1, 2"], [12], ["12"], ["1", 2], [[1], 2], [[1, 2]], ["t1:a"], ["t1:a", "b"], ["t1:at1:b"]])), "11")
    _sjekk(res, "tomme samlingar", tekst(_ulike([[], {}, [[]], [{}], {"": []}, "", ingenting])), "7")

    # Ordbøker: innhald, uavhengig av innsetjingsrekkjefølgja.
    la a = {"a": 1, "b": 2}
    la b = {"b": 2, "a": 1}
    _sjekk(res, "ordbok rekkjefølgje", _b(vfm.lik(a, b)) + "|" + tekst(a == b), "J|usann")
    _sjekk(res, "ordbok ulik", _b(vfm.lik({"a": 1}, {"a": 2})) + _b(vfm.lik({"a": 1}, {"a": 1, "b": 2})) + _b(vfm.lik({"a": 1}, {"b": 1})) + _b(vfm.lik({}, {})), "NNNJ")
    _sjekk(res, "ordbok nøsta", _b(vfm.lik({"x": [1, {"y": 2}]}, {"x": [1, {"y": 2}]})) + _b(vfm.lik({"x": [1, {"y": 2}]}, {"x": [1, {"y": 3}]})), "JN")
    _sjekk(res, "ordbok nøkkel/verdi-grense", tekst(_ulike([{"ab": "c"}, {"a": "bc"}, {"a": "b", "c": ""}])), "3")

    # Valfri-verdiar er ordbøker og blir samanlikna på innhald.
    _sjekk(res, "valfri", _b(vfm.lik(vf.av([1, 2]), vf.av([1, 2]))) + _b(vfm.lik(vf.av([1]), vf.av([2]))) + _b(vfm.lik(vf.tom(), vf.tom())), "JNJ")
}

funksjon _visning(res: ordbok) {
    _sjekk(res, "vis skalar", vfm.vis(42) + "|" + vfm.vis(-3) + "|" + vfm.vis("ab") + "|" + vfm.vis(sann) + "|" + vfm.vis(ingenting), "42|-3|ab|sann|ingenting")
    _sjekk(res, "vis liste", vfm.vis([1, "a", [2, 3], []]), "[1, a, [2, 3], []]")
    _sjekk(res, "vis ordbok", vfm.vis({"k": [2], "a": {"b": 1}}), "{k=[2], a={b=1}}")
    _sjekk(res, "vis tomme", vfm.vis([]) + vfm.vis({}), "[]{}")
    _sjekk(res, "vis ingenting i liste", vfm.vis([1, ingenting]), "[1, ingenting]")
    _sjekk(res, "vis valfri", vfm.vis([vf.av([1]), vf.tom()]) + "|" + vfm.vis(vf.av(vf.av(3))), "[Valfri[[1]], Valfri.tom]|Valfri[Valfri[3]]")
    # Kontrast: tekst() skil ikkje samlingar (det er grunnen til modulen).
    _sjekk(res, "tekst skil ikkje", tekst(tekst([1]) == tekst([2])) + tekst(vfm.vis([1]) == vfm.vis([2])), "sannusann")
}

funksjon _djupn(res: ordbok) {
    # Djup, men endeleg nøsting er i orden.
    la d = [0]
    la i = 0
    mens i < 90 {
        d = [d]
        i = i + 1
    }
    _sjekk(res, "djup nøsting", _b(vfm.lik(d, d)) + tekst(lengde(vfm.vis(d))), "J183")

    # Sirkulær struktur gjev TilstandsFeil, ikkje uendeleg rekursjon.
    la sirkel = [1]
    legg_til(sirkel, sirkel)
    la feil_n = "nei"
    prøv { vfm.nøkkel(sirkel) } fang (e) { feil_n = builtin.slice(tekst(e), 0, 15) }
    _sjekk(res, "sirkulær nøkkel", feil_n, "TilstandsFeil: ")
    la feil_v = "nei"
    prøv { vfm.vis(sirkel) } fang (e) { feil_v = builtin.slice(tekst(e), 0, 15) }
    _sjekk(res, "sirkulær vis", feil_v, "TilstandsFeil: ")
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}
    _likskap(res)
    _visning(res)
    _djupn(res)
    hvis res["feil"] != 0 {
        skriv("test_verdiform FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_verdiform OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
