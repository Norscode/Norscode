// Linux x86-64 AOT, GC-markøren (fdda014): byggjer tests/fixtures/gc_falsk_liste_probe.no med
// `nc bygg-native` i GC-modus (NORSCODE_GC_ALLOC=1 til codegen) og køyrer binæren. Proben
// planta 480 falske liste/map-boksar som den gamle markøren følgde (~10^10 gc_push, collect-
// stans på 30–110 s i binær-NCB-kodinga); han krev at éin collect tek under 1000 ms og at
// levande data er urørte. Exit 0 = OK · 2 = levande data øydelagde · 3 = for treg · 4 = ugyldig
// måling. Negativ kontroll: med codegen-ELF-en før fiksen (91cb9174) gjev proben exit 3.
// Køyrd i GC-matrisa (tools/ci_native_gc.no). Berre på Linux x86-64-vert.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    returner system == "Linux" og (maskin == "x86_64" eller maskin == "amd64")
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_GC_ALLOC": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_linux_x86_64() {
        skriv("test_native_gc_falsk_liste: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la binær = "/tmp/norscode_gc_falsk_liste_" + builtin.random_hex(8)
    krev_exit(køyr(runtime(root), ["bygg-native", "--target", "linux-x86_64",
                                   root + "/tests/fixtures/gc_falsk_liste_probe.no", binær], root, 300000), 0)
    // Proben måler sjølv (> 1000 ms → exit 3); 60 s fangar ein stans som aldri kjem tilbake.
    la resultat = køyr(binær, [], root, 60000)
    krev_exit(resultat, 0)
    assert(builtin.contains(tekst(resultat["stdout"]), "gc_falsk_liste OK"))
    filops.slett_fil(binær)
    skriv("test_native_gc_falsk_liste OK\n")
    returner 0
}
