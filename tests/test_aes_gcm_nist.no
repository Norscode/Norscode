bruk std.aes_gcm som gcm

// Kjent-svar-test: AES-128-GCM mot NIST GCM Test Cases (McGrew/Viega, SP 800-38D).
// TC2 (K=0), TC3 (K≠0, 64-byte P), TC4 (20-byte AAD, 60-byte P), pluss
// open(seal)-round-trip og tag-/AAD-tuklings-avvisning. Ren byte-beregning.

funksjon _b(hex: tekst) -> liste_heiltall {
    la s = "0123456789abcdef"
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(hex) {
        legg_til(ut, builtin.index_of(s, builtin.slice(hex, i, i + 1)) * 16
            + builtin.index_of(s, builtin.slice(hex, i + 1, i + 2)))
        i = i + 2
    }
    returner ut
}

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la s = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(s, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(s, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    // ── Test Case 2: K=0, IV=0^96, ingen AAD, P=0^128 ──
    la r2 = gcm.aes128_gcm_seal(_b("00000000000000000000000000000000"),
        _b("000000000000000000000000"), [], _b("00000000000000000000000000000000"))
    assert(_hex(r2["ciphertext"]) == "0388dace60b6a392f328c2b971b2fe78")
    assert(_hex(r2["tag"]) == "ab6e47d42cec13bdf53a67b21257bddf")

    // ── Test Case 3: K≠0, 64-byte P, ingen AAD ──
    la k = _b("feffe9928665731c6d6a8f9467308308")
    la iv = _b("cafebabefacedbaddecaf888")
    la p3 = _b("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255")
    la r3 = gcm.aes128_gcm_seal(k, iv, [], p3)
    assert(_hex(r3["ciphertext"]) == "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f5985")
    assert(_hex(r3["tag"]) == "4d5c2af327cd64a62cf35abd2ba6fab4")

    // ── Test Case 4: 20-byte AAD, 60-byte P ──
    la aad = _b("feedfacedeadbeeffeedfacedeadbeefabaddad2")
    la p4 = _b("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
    la r4 = gcm.aes128_gcm_seal(k, iv, aad, p4)
    assert(_hex(r4["tag"]) == "5bc94fbc3221a5db94fae95ae7121a47")

    // ── open(seal)-round-trip ──
    la o = gcm.aes128_gcm_open(k, iv, aad, r4["ciphertext"], r4["tag"])
    assert(o["ok"])
    assert(_hex(o["plaintext"]) == _hex(p4))

    // ── Tuklet tag avvises ──
    assert(ikkje gcm.aes128_gcm_open(k, iv, aad, r4["ciphertext"], _b("00000000000000000000000000000000"))["ok"])

    // ── Feil AAD avvises (AAD er autentisert) ──
    assert(ikkje gcm.aes128_gcm_open(k, iv, _b("00000000000000000000000000000000"), r4["ciphertext"], r4["tag"])["ok"])

    skriv("test_aes_gcm_nist: OK\n")
    returner 0
}
