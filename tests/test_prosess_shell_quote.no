bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/prosess.no")
    assert(t.inneholder(src, "norscode-process-spawn-v1"))
    assert(t.inneholder(src, "builtin.process_spawn_argv(req)"))
    assert(t.inneholder(src, "funksjon _finn_kjorbar(namn: tekst) -> tekst"))
    assert(t.inneholder(src, "shellmetateikn er ikkje tillatne"))
    assert(t.inneholder(src, "builtin.prosess_pid()"))
    assert(t.inneholder(src, "builtin.prosess_ppid()"))
    assert(t.inneholder(src, "builtin.chdir(sti)"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))

    skriv("test_prosess_native_argv OK")
    returner 0
}
