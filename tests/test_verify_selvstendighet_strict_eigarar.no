// Kvar run_step(...)-liste i tools/verify_selvstendighet.no må løysast av eigar_sti() til ei
// eigarfil som finst. Eit steg med ukjend eigar feilar lukka ("Ukjend strict-eigar") — i strict-
// modus fyrst etter timar med L5/L5b, og berre på main (PR-CI køyrer ikkje Selvstendighet).
// Steg 8b stod med ["run", …] (eigar_sti kjenner berre "run-pure") og ville alltid ha stoppa der.

bruk tools.verify_selvstendighet som selv

// Strengliteralane i fyrste [...]-liste etter kvar «run_step(» (definisjonen er hoppa over).
// Resultat: éi oppføring per kall, strengane skilde med "\n".
funksjon run_step_lister(kjelde: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la n = lengde(kjelde)
    la frå = 0
    mens frå < n {
        la rel = builtin.index_of(builtin.slice(kjelde, frå, n), "run_step(")
        hvis rel < 0 { bryt }
        la start = frå + rel
        frå = start + 9
        hvis start >= 9 og builtin.slice(kjelde, start - 9, start) == "funksjon " { fortsett }
        // Skann fram til fyrste [ utanfor strengar, og samle strengane fram til ].
        la i = frå
        la i_streng = usann
        la escape = usann
        la i_liste = usann
        la gjeldande = ""
        la delar = ""
        la tal = 0
        mens i < n {
            la c = builtin.slice(kjelde, i, i + 1)
            hvis i_streng {
                hvis escape {
                    escape = usann
                    gjeldande = gjeldande + c
                } ellers hvis c == "\\" {
                    escape = sann
                } ellers hvis c == "\"" {
                    i_streng = usann
                    hvis i_liste {
                        hvis tal > 0 { delar = delar + "\n" }
                        delar = delar + gjeldande
                        tal = tal + 1
                    }
                } ellers {
                    gjeldande = gjeldande + c
                }
            } ellers hvis c == "\"" {
                i_streng = sann
                gjeldande = ""
            } ellers hvis c == "[" {
                i_liste = sann
            } ellers hvis c == "]" og i_liste {
                bryt
            }
            i = i + 1
        }
        legg_til(ut, delar)
        frå = i
    }
    returner ut
}

funksjon som_liste(delar: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    hvis delar == "" { returner ut }
    la d = builtin.split(delar, "\n")
    la i = 0
    mens i < lengde(d) {
        legg_til(ut, d[i])
        i = i + 1
    }
    returner ut
}

// Kall der eigar_sti() gjev "" eller peikar på ei fil som ikkje finst.
funksjon ukjende_eigarar(kjelde: tekst) -> liste_tekst {
    la brot: liste_tekst = []
    la lister = run_step_lister(kjelde)
    la i = 0
    mens i < lengde(lister) {
        la args = som_liste(lister[i])
        la eigar = selv.eigar_sti(args)
        hvis eigar == "" {
            legg_til(brot, "ukjend eigar for [" + lister[i] + "]")
        } ellers hvis ikkje builtin.fil_finnes(eigar) {
            legg_til(brot, "eigarfila " + eigar + " finst ikkje for [" + lister[i] + "]")
        }
        i = i + 1
    }
    returner brot
}

funksjon start() -> heiltall {
    la kjelde = fil_les("tools/verify_selvstendighet.no")
    la lister = run_step_lister(kjelde)
    // Parseren må faktisk finne kalla (ein port som ikkje ser noko, seier alltid ja).
    assert(lengde(lister) >= 10)
    la brot = ukjende_eigarar(kjelde)
    la i = 0
    mens i < lengde(brot) {
        skriv("FEIL: " + brot[i] + "\n")
        i = i + 1
    }
    assert_eq(lengde(brot), 0)
    la har_8b = usann
    i = 0
    mens i < lengde(lister) {
        hvis lister[i] == "run-pure\ntools/materialize_runtime_payloads.no" { har_8b = sann }
        i = i + 1
    }
    assert(har_8b)

    // Negativ: dei to måtane eit nytt steg kan feile lukka på.
    la gammal_8b = "hvis ikkje run_step(root, \"8b. x\", [\"run\", \"tools/materialize_runtime_payloads.no\"], ingen) { returner 1 }"
    assert_eq(lengde(ukjende_eigarar(gammal_8b)), 1)
    la feil_fil = "hvis ikkje run_step(root, \"9. y [z]\", [\"run-pure\", \"tools/finst_ikkje_eigar.no\"], ingen) { returner 1 }"
    la b2 = ukjende_eigarar(feil_fil)
    assert_eq(lengde(b2), 1)
    assert(builtin.index_of(b2[0], "finst ikkje") >= 0)
    // Og ein kjend eigar med fleirlinjes kall blir godteken.
    la ok = "hvis ikkje run_step(root, \"7a. a\",\n        [\"selfcompile-l5b\"], cache_på) { returner 1 }"
    assert_eq(lengde(ukjende_eigarar(ok)), 0)

    skriv("test_verify_selvstendighet_strict_eigarar OK\n")
    returner 0
}
