// Cutover: std.db-kompatibel adapter over den binære motoren.
// Speiler typisk std.db-bruk: open/execute/query_*/begin/commit/rollback/transaction/
// migrate + auto-id + feilsignalering. Beviser at motoren kan vere drop-in.

bruk std.norsdb_db som db

funksjon start() -> heltall {
    assert_eq(db.backend(), "norsdb-pure-v1")
    assert_eq(db.status()["storage"], "binær-btre-wal")
    la h = db.open(":memory:")
    assert(db.ping(h))

    assert_eq(db.execute(h, "CREATE TABLE users (id INTEGER, name TEXT, age INTEGER)"), 0)
    assert_eq(db.execute(h, "INSERT INTO users (name, age) VALUES ('Ada', 37)"), 1)
    assert_eq(db.execute(h, "INSERT INTO users (name, age) VALUES ('Linus', 55)"), 1)

    // auto-id (som gamle std.db): id fylt ut automatisk
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM users"), 2)
    assert_eq(db.query_text(h, "SELECT name FROM users WHERE id = 1"), "Ada")
    assert_eq(db.query_text(h, "SELECT age FROM users WHERE id = 2"), "55")

    // begin / rollback
    assert(db.begin(h))
    assert_eq(db.execute(h, "UPDATE users SET age = 99 WHERE id = 1"), 1)
    assert_eq(db.query_text(h, "SELECT age FROM users WHERE id = 1"), "99")
    assert(db.rollback(h))
    assert_eq(db.query_text(h, "SELECT age FROM users WHERE id = 1"), "37")

    // begin / commit
    assert(db.begin(h))
    assert_eq(db.execute(h, "INSERT INTO users (name, age) VALUES ('Eli', 20)"), 1)
    assert(db.commit(h))
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM users"), 3)

    // transaction (gyldig → commit, ugyldig → rollback)
    assert_eq(db.transaction(h, "INSERT INTO users (name, age) VALUES ('Lin', 30)"), 1)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM users"), 4)
    assert_eq(db.transaction(h, "INSRT INTO users (name) VALUES ('X')"), 0)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM users"), 4)

    // migrate
    assert_eq(db.migrate(h, "INSERT INTO users (name, age) VALUES ('Zoe', 25);"), 1)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM users"), 5)

    // feilsignalering
    assert_eq(db.execute(h, "INSRT INTO users (name) VALUES ('bad')"), -1)
    assert(db.siste_feil(h) != "")
    assert_eq(db.execute(h, "INSERT INTO users (name, age) VALUES ('ok', 1)"), 1)
    assert_eq(db.siste_feil(h), "")

    assert(db.close(h))
    assert(db.ping(h) == usann)
    returner 0
}
