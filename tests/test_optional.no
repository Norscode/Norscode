# M10 — optional chaining o?.felt: kortsluttar til ingenting når o er ingenting,
# elles vanleg feltoppslag. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # o?.felt på ein ordbok med feltet
    la p1 = "funksjon start() -> tekst {\n" +
        "    la m: ordbok_tekst = {}\n" +
        "    m[\"navn\"] = \"Kari\"\n" +
        "    returner m?.navn\n" +
        "}\n"
    assert_eq(utfor(p1), "Kari")

    # o?.felt der o er ingenting (frå manglande oppslag) → ingenting.
    # Merk: ingenting kan ikkje lagrast i ein variabel (native avgrensing),
    # so vi held ingenting-verdien inline på stacken.
    la p2 = "funksjon start() -> tekst {\n" +
        "    la m: ordbok_tekst = {}\n" +
        "    returner builtin.type(m[\"finst_ikkje\"]?.navn)\n" +
        "}\n"
    assert_eq(utfor(p2), "ingenting")

    # kjeda: m?.indre?.verdi der indre finst
    la p3 = "funksjon start() -> heltall {\n" +
        "    la indre: ordbok_heltall = {}\n" +
        "    indre[\"verdi\"] = 42\n" +
        "    la m: ordbok_tekst = {}\n" +
        "    m[\"indre\"] = indre\n" +
        "    returner m?.indre?.verdi\n" +
        "}\n"
    assert_eq(utfor(p3), "42")

    # vanleg o.felt (utan ?) er uendra
    la p4 = "funksjon start() -> tekst {\n" +
        "    la m: ordbok_tekst = {}\n" +
        "    m[\"a\"] = \"b\"\n" +
        "    returner m.a\n" +
        "}\n"
    assert_eq(utfor(p4), "b")

    skriv("test_optional OK\n")
    returner 0
}
