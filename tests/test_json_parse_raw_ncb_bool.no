// J1b: syntetisk NCB-tekst i staden for build/lexer_phase8_json_probe.ncb.json
// (avleidd av committa bootstrap/precompiled/lexer_m1.ncb.json). JSON-boolean
// i NCB må bli boolsk etter json_parse_raw og skrivast attende som false.
funksjon start() -> heiltall {
    la tekst_ncb = "{\"format\":\"norscode-bytecode-v1\",\"entry\":\"selfhost.lexer.lexer_m1.start\"," +
        "\"functions\":{\"selfhost.lexer.lexer_m1.er_bokstav\":{\"name\":\"er_bokstav\"," +
        "\"module\":\"selfhost.lexer.lexer_m1\",\"params\":[\"c\"],\"is_async\":false," +
        "\"code\":[[\"LOAD_NAME\",\"c\"],[\"PUSH_CONST\",true],[\"RETURN\"]]}}}"
    la ncb = builtin.json_parse_raw(tekst_ncb)
    la fn = ncb["functions"]["selfhost.lexer.lexer_m1.er_bokstav"]
    assert(builtin.type(fn["is_async"]) == "boolsk")
    assert(fn["is_async"] == usann)
    assert(builtin.type(fn["code"][1][1]) == "boolsk")
    la encoded = builtin.json_skriv(fn)
    assert(builtin.contains(encoded, "\"is_async\":false"))
    assert(ikke builtin.contains(encoded, "usann"))
    skriv("test_json_parse_raw_ncb_bool OK\n")
    returner 0
}
