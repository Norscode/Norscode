funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(fil_les("build/lexer_phase8_json_probe.ncb.json"))
    la fn = ncb["functions"]["selfhost.lexer.lexer_m1.er_bokstav"]
    assert(builtin.type(fn["is_async"]) == "boolsk")
    la encoded = builtin.json_skriv(fn)
    assert(builtin.contains(encoded, "\"is_async\":false"))
    assert(ikke builtin.contains(encoded, "usann"))
    skriv("test_json_parse_raw_ncb_bool OK\n")
    returner 0
}
