// Testløparen må sende eksplisitt miljø til både synkrone og asynkrone barn.
// Forelderen peikar med vilje på selftest, slik at eit tapt miljø ikkje kan
// starte denne testen rekursivt eller late ein annan kommando bli grøn.
bruk tools.nc_test som runner
bruk std.runtime_filesystem som fs

funksjon krev_barn(res) {
    hvis lengde(res) != 3 { kast "nc_test: prosessbackenden starta ikkje barnet" }
    hvis res[0] != "17" { skriv("nc_test child: " + tekst(res) + "\n") }
    assert_eq(res[0], "17")
    assert(builtin.contains(res[1], "nc-test child environment and cwd OK"))
    assert(ikkje builtin.contains(res[1], "=== nc_main.no selftest ==="))
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la native = tekst(builtin.system_info()["executable"])
    la cwd = root + "/build/nc-test-process-" + tekst(builtin.tid_ms())
    builtin.mkdir_p(cwd)
    la caps = "env.read,disk.read"
    la miljø = {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tests/fixtures/nc_test_process_child.no",
        "NORSCODE_HOST_NCB_FILE": "", "NORSCODE_NCB_FILE": "", "NORSCODE_VM_SOURCE": "0",
        "NORSCODE_RUN_DIRECT_HOST": "0", "NORSCODE_OUTPUT": "",
        "NORSCODE_NO_ARGV": "1", "NORSCODE_VM_FAST": "1",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": caps, "NORSCODE_VM_TARGET_CAPABILITIES": caps,
        "NORSCODE_VM_DISK_ROOT": root + ",.", "NORSCODE_VM_TARGET_DISK_ROOT": root + ",.",
        "NC_TEST_PROCESS_PROBE": "child-only", "NC_TEST_PROCESS_CWD": cwd,
        "NC_TEST_PROCESS_WAIT": "0"
    }
    la saved = {}
    for name i ["NORSCODE_CMD", "NORSCODE_FILE", "NC_TEST_PROCESS_PROBE", "NC_TEST_ASYNC_SPAWN"] {
        saved[name] = builtin.miljo_hent(name)
    }
    builtin.miljo_sett("NORSCODE_CMD", "selftest")
    builtin.miljo_sett("NORSCODE_FILE", "")
    builtin.miljo_sett("NC_TEST_PROCESS_PROBE", "parent-only")
    builtin.miljo_sett("NC_TEST_ASYNC_SPAWN", "0")
    prøv {
        krev_barn(runner.køyr_native(cwd, native, miljø, "15"))
        krev_barn(runner.køyr_native_async(native, cwd, miljø, 15000, 1073741824))
        miljø["NC_TEST_PROCESS_WAIT"] = "1"
        la timeout = runner.køyr_native(cwd, native, miljø, "2")
        assert_eq(timeout[0], "124")
        assert(builtin.contains(timeout[1], "nc-test child environment and cwd OK"))
        assert(ikkje builtin.contains(timeout[1], "nc-test child missed timeout"))
        la probe_namn = "test_linux_runtime_attestation_probe.no"
        la ufullstendig = runner.køyr_testprogram(cwd, native, probe_namn, miljø, "15")
        assert_eq(ufullstendig[0], "1")
        assert(builtin.contains(ufullstendig[1], "Linux-probe (argon2id): manglar sluttmarkør"))
        miljø["NC_TEST_PROCESS_WAIT"] = "0"
        la fullført = runner.køyr_testprogram(cwd, native, probe_namn, miljø, "15")
        assert_eq(fullført[0], "0")
        assert(builtin.contains(fullført[1], "test_linux_runtime_attestation_probe OK (core)"))
        assert(builtin.contains(fullført[1], "test_linux_runtime_attestation_probe OK (argon2id)"))
        assert(builtin.contains(fullført[1], "test_linux_runtime_attestation_probe OK (tls)"))
    } fang (e) {
        for name i nøkler(saved) { builtin.miljo_sett(name, saved[name]) }
        kast e
    }
    for name i nøkler(saved) { builtin.miljo_sett(name, saved[name]) }
    assert_eq(fs.native_slett_mappe(root + "/build", builtin.slice(cwd, lengde(root) + 7, lengde(cwd)))["status"], "deleted")
    skriv("test_nc_test_process_environment OK\n")
    returner 0
}
