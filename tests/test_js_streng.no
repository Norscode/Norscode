bruk std.js_streng som jss

# Samanliknar lister utan å vere avhengig av korleis tekst(liste) blir formatert
# i den einskilde køyraren.
funksjon flat_tekst(l) -> tekst {
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis i > 0 {
            ut = ut + ","
        }
        la element = l[i]
        hvis builtin.type(element) == "liste" {
            ut = ut + "(" + flat_tekst(element) + ")"
        } ellers {
            ut = ut + tekst(element)
        }
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    # teikn og lengde (UTF-8-medviten)
    assert_eq(jss.lengde_teikn("kjæra"), 5)
    assert_eq(jss.lengde_bytes("kjæra"), 6)
    assert_eq(flat_tekst(jss.teikn("æøå")), "æ,ø,å")

    # at / charAt
    assert_eq(jss.ved("kjæra", 2), "æ")
    assert_eq(jss.ved("kjæra", -1), "a")
    assert_eq(jss.ved("abc", 9), "")
    assert_eq(jss.teikn_ved("abc", 1), "b")
    assert_eq(jss.teikn_ved("abc", 0 - 1), "")

    # codePointAt / fromCodePoint
    assert_eq(jss.kodepunkt_ved("A", 0), 65)
    assert_eq(jss.kodepunkt_ved("æ", 0), 230)
    assert_eq(jss.kodepunkt_ved("€", 0), 8364)
    assert_eq(jss.frå_kodepunkt(65), "A")
    assert_eq(jss.frå_kodepunkt(230), "æ")
    assert_eq(jss.frå_kodepunkt(8364), "€")

    # slice / substring
    assert_eq(jss.skiv("kjæra", 2, 4), "ær")
    assert_eq(jss.skiv("kjæra", -2, 5), "ra")
    assert_eq(jss.skiv("abc", 2, 1), "")
    assert_eq(jss.skiv_frå("abcd", 2), "cd")
    assert_eq(jss.del_streng("abcd", 3, 1), "bc")
    assert_eq(jss.del_streng("abcd", 0 - 5, 2), "ab")

    # søk
    assert(jss.inkluderer("kjæra", "æra"))
    assert(jss.startar_med("kjæra", "kj"))
    assert(jss.sluttar_med("kjæra", "ra"))
    assert_eq(jss.indeks_av("kjæra", "ra"), 3)
    assert_eq(jss.indeks_av("abc", "z"), 0 - 1)
    assert_eq(jss.siste_indeks_av("a-b-c", "-"), 3)
    assert_eq(jss.siste_indeks_av("abc", "z"), 0 - 1)

    # replace / replaceAll
    assert_eq(jss.erstatt("a-b-c", "-", "+"), "a+b-c")
    assert_eq(jss.erstatt("abc", "z", "+"), "abc")
    assert_eq(jss.erstatt_alle("a-b-c", "-", "+"), "a+b+c")

    # split
    assert_eq(flat_tekst(jss.del("a,b", ",")), "a,b")
    assert_eq(flat_tekst(jss.del("æø", "")), "æ,ø")
    assert_eq(flat_tekst(jss.del_grense("a,b,c", ",", 2)), "a,b")

    # trim
    assert_eq(jss.trim("  hei  "), "hei")
    assert_eq(jss.trim_start("  hei  "), "hei  ")
    assert_eq(jss.trim_slutt("  hei  "), "  hei")

    # padStart / padEnd / repeat
    assert_eq(jss.fyll_start("7", 3, "0"), "007")
    assert_eq(jss.fyll_start("lang", 2, "0"), "ng")
    assert_eq(jss.fyll_slutt("7", 3, "0"), "700")
    assert_eq(jss.fyll_slutt("abcd", 2, "0"), "ab")
    assert_eq(jss.gjenta("ab", 3), "ababab")
    assert_eq(jss.gjenta("ab", 0), "")

    # case (æøå skal følgje med)
    assert_eq(jss.til_store("kjæra"), "KJÆRA")
    assert_eq(jss.til_små("KJÆRA"), "kjæra")

    # concat / localeCompare
    assert_eq(jss.konkat("a", "b"), "ab")
    assert_eq(jss.samanlikn("a", "a"), 0)
    assert_eq(jss.samanlikn("a", "b"), 0 - 1)
    assert_eq(jss.samanlikn("b", "a"), 1)
    assert_eq(jss.samanlikn("ab", "abc"), 0 - 1)

    skriv("test_js_streng OK\n")
    returner 0
}
