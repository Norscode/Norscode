# Fase 2a / stage0-fiks: toppnivå `struktur` + toppnivå `la` i same fil gav
# «Stack underflow i __main__.__module_init__» fordi Struktur mangla i skip-lista
# i kompiler_modul_init (ir_to_bytecode). Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # Minimalrepro: struktur + toppnivå la + funksjon som les globalen.
    la p = "struktur P { x: heltall }\n" +
           "la g = 1\n" +
           "funksjon start() -> heltall { returner g }\n"
    # Før fiksen: «Stack underflow i __main__.__module_init__». Etter: returnerer 1.
    assert_eq(utfor(p), "1")

    # Fleire strukturar + fleire globalar.
    la p2 = "struktur A { x: heltall }\n" +
            "struktur B { y: heltall }\n" +
            "la a = 10\n" +
            "la b = 32\n" +
            "funksjon start() -> heltall { returner a + b }\n"
    assert_eq(utfor(p2), "42")

    skriv("test_fase2a_stage0_struktur OK\n")
    returner 0
}
