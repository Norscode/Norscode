bruk std.runtime.thread_abi som abi
bruk std.runtime.atomic som atomic

// Regresjon (threads.md §8.1): etter at eit kall inn i ein ANNAN modul returnerer
// (RETURN) eller kastar til ein handler i kallaren (unwind), må LOAD_GLOBAL og
// STORE_GLOBAL i kallaren bruke kallaren sin modul. VM-en frissa ikkje fn_def når
// continuation-ramma vart teken attende, so `g = 5` under skreiv stille til
// std.runtime.thread_abi sine globalar og les_g() såg 0.

la g: heiltall = 0

funksjon sett_etter_kryssmodul() -> heiltall {
    la v = abi.versjon()
    g = 5
    returner lengde(v)
}

funksjon les_g() -> heiltall {
    returner g
}

funksjon auk_etter_kast_i_annan_modul() -> heiltall {
    la fanga = usann
    prøv {
        atomic.load({"abi": "ugyldig", "backend": ""}, "seq_cst")
    } fang (e) {
        fanga = sann
    }
    assert(fanga)
    g = g + 1
    returner g
}

funksjon start() -> heiltall {
    assert(sett_etter_kryssmodul() > 0)
    assert_eq(les_g(), 5)
    assert_eq(auk_etter_kast_i_annan_modul(), 6)
    assert_eq(les_g(), 6)
    skriv("test_modulglobal_etter_kryssmodulkall OK\n")
    returner 0
}
