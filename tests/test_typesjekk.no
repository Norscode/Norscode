# M1 — valfri streng type-sjekk (NORSCODE_STRICT_TYPAR). Verifiserer at
# openberre typefeil blir avviste ved kompilering, at gyldig kode framleis
# kompilerer, og at sjekken er AV som standard (bakoverkompatibel).

bruk selfhost.kompiler som kompiler

funksjon kompilerer(kjelde: tekst, streng: bool) -> bool {
    hvis streng { miljo_sett("NORSCODE_STRICT_TYPAR", "1") } ellers { miljo_sett("NORSCODE_STRICT_TYPAR", "0") }
    la ok = sann
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        ok = usann
    }
    miljo_sett("NORSCODE_STRICT_TYPAR", "0")
    returner ok
}

funksjon start() -> heiltall {
    # ── Skal AVVISAST i streng modus ─────────────────────────────────────────
    la retur_feil = "funksjon f() -> heltall { returner \"tekst\" }\n" +
        "funksjon start() -> heltall { returner 0 }\n"
    assert(ikkje kompilerer(retur_feil, sann))
    # ... men kompilerer med flagget AV (bakoverkompatibel)
    assert(kompilerer(retur_feil, usann))

    la tildel_feil = "funksjon start() -> heltall { la c: heltall = \"tekst\"\n returner 0 }\n"
    assert(ikkje kompilerer(tildel_feil, sann))
    assert(kompilerer(tildel_feil, usann))

    la arg_feil = "funksjon tar(x: heltall) -> heltall { returner x }\n" +
        "funksjon start() -> heltall { la a = tar(\"tekst\")\n returner 0 }\n"
    assert(ikkje kompilerer(arg_feil, sann))

    # ── Skal GODTAKAST i streng modus ────────────────────────────────────────
    la gyldig1 = "funksjon f(x: heltall) -> heltall { returner x }\n" +
        "funksjon start() -> heltall { returner f(3) }\n"
    assert(kompilerer(gyldig1, sann))

    la gyldig2 = "funksjon start() -> heltall { la c: heltall = 5\n returner c }\n"
    assert(kompilerer(gyldig2, sann))

    # tekst-konkatenering med + skal IKKJE gi falsk positiv
    la gyldig3 = "funksjon start() -> tekst { la s: tekst = \"a\" + tekst_fra_heltall(1)\n returner s }\n"
    assert(kompilerer(gyldig3, sann))

    # uinferrbare typar (builtin-kall) skal ikkje gi falsk positiv
    la gyldig4 = "funksjon start() -> heltall { la n = lengde([1, 2, 3])\n returner n }\n"
    assert(kompilerer(gyldig4, sann))

    skriv("test_typesjekk OK\n")
    returner 0
}
