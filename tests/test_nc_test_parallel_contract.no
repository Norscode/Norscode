funksjon start() -> heiltall {
    la src = builtin.fil_les("tools/nc_test_parallel.no")
    assert(builtin.index_of(src, "bruk std.runtime.process_abi som process_abi") >= 0)
    assert(builtin.index_of(src, "process_abi.async_spawn_request") >= 0)
    assert(builtin.index_of(src, "builtin.process_operation(req)") >= 0)
    assert(builtin.index_of(src, "native, [], root") >= 0)
    assert(builtin.index_of(src, "miljø[\"NORSCODE_CMD\"] = \"test\"") >= 0)
    assert(builtin.index_of(src, "miljo_sett(\"NORSCODE_CMD\", \"test\")") >= 0)
    assert(builtin.index_of(src, "miljo_sett(\"NC_TEST_SHARD\", miljø[\"NC_TEST_SHARD\"])") >= 0)
    assert(builtin.index_of(src, "barnet får eit eige") >= 0)
    assert(builtin.index_of(src, "resultat_tal(tekst(output[\"stdout\"]), \"Totalt\")") >= 0)
    assert(builtin.index_of(src, "builtin.replace(output, \"\\\\n\", \"\\n\")") >= 0)
    assert(builtin.index_of(src, "NC_PARALLEL_TEST_MIN_TOTAL") >= 0)
    assert(builtin.index_of(src, "__NORSCODE_TEST_TOTAL__=") >= 0)
    assert(builtin.index_of(src, "nc_main-selftest tel ikkje") >= 0)
    assert(builtin.index_of(src, "miljø[\"NORSCODE_FILE\"]") < 0)
    assert(builtin.index_of(src, "shard_driver(") < 0)
    assert(builtin.index_of(src, "builtin.fil_les(root + \"/tools/nc_test.no\")") < 0)
    assert(builtin.index_of(src, "NC_TEST_SHARD") >= 0)
    assert(builtin.index_of(src, "NC_TEST_SHARDS") >= 0)
    assert(builtin.index_of(src, "NC_PARALLEL_TEST_SHARDS") >= 0)
    assert(builtin.index_of(src, "exec_prosess") < 0)
    assert(builtin.index_of(src, "sh -c") < 0)
    assert(builtin.index_of(src, " &") < 0)

    la strict = builtin.fil_les("tools/verify_selvstendighet.no")
    assert(builtin.index_of(strict, "[\"test-parallel\"]") >= 0)
    assert(builtin.index_of(strict, "[\"run\", \"tools/nc_test_parallel.no\"]") < 0)
    assert(builtin.index_of(strict, "process_abi.request(native, [], root") >= 0)
    assert(builtin.index_of(strict, "builtin.process_spawn_argv(req)") >= 0)
    assert(builtin.index_of(strict, "Full normal testflate (8 deterministiske native shards)") >= 0)
    assert(builtin.index_of(strict, "Langsam testflate (8 deterministiske native shards)") >= 0)
    la runner = builtin.fil_les("tools/nc_test.no")
    assert(builtin.index_of(runner, "builtin.argv_operation") >= 0)
    assert(builtin.index_of(runner, "konfig(\"NC_TEST_SHARD\", \"--shard\")") >= 0)
    assert(builtin.index_of(runner, "funksjon start_konfigurert(shard_override: heiltall, shards_override: heiltall)") >= 0)
    assert(builtin.index_of(runner, "compile_miljø[\"NORSCODE_HYBRID_SRC\"] = absolutt_test") >= 0)
    assert(builtin.index_of(runner, "compile_miljø[\"NORSCODE_HYBRID_PROJECT_ROOT\"] = dirname(absolutt_test)") >= 0)
    assert(builtin.index_of(runner, "builtin.process_spawn_argv(req)") >= 0)
    assert(builtin.index_of(runner, "test_thread_native_backend_lifecycle.no") >= 0)
    assert(builtin.index_of(runner, "test_macho_arm64_aot_stdlib_cli.no") >= 0)
    assert(builtin.index_of(runner, "test_runtime_memory_parallel_gc.no") >= 0)
    assert(builtin.index_of(runner, "test_linux_arm64_aot_cli.no") >= 0)
    assert(builtin.index_of(runner, "test_macho_arm64_aot_common_runtime.no") >= 0)
    assert(builtin.index_of(runner, "norscode-test-cache-v4|norscode-bytecode-v1|selfhost-compiler-0.31") >= 0)
    assert(builtin.index_of(runner, "funksjon compiler_implementation_key(root: tekst, hybrid: tekst)") >= 0)
    assert(builtin.index_of(runner, "funksjon dependency_key(root: tekst, fil: tekst)") >= 0)
    assert(builtin.index_of(runner, "dependency_filhash_cache") >= 0)
    assert(builtin.index_of(runner, "dependency_import_cache") >= 0)
    assert(builtin.index_of(runner, "dependency_key_cache") >= 0)
    assert(builtin.index_of(runner, "compiler_key_cache") >= 0)
    assert(builtin.index_of(runner, "dependency_import_cache[sti] = resultat") >= 0)
    assert(builtin.index_of(runner, "dependency_key_cache[startfil] = nøkkel") >= 0)
    assert(builtin.index_of(runner, "compiler_key_cache[cache_nøkkel] = nøkkel") >= 0)
    assert(builtin.index_of(runner, "builtin.sha256_bytes(builtin.fil_les_binær(sti))") >= 0)
    assert(builtin.index_of(runner, "relativ != \"tools/nc_test.no\"") >= 0)
    assert(builtin.index_of(runner, "relativ != \"tools/nc_test_parallel.no\"") >= 0)
    assert(builtin.index_of(runner, "native_fs.native_list(test_dir, \"\")") >= 0)
    assert(builtin.index_of(runner, "find \" + shell(test_dir)") < 0)
    assert(builtin.index_of(runner, "stat -f") < 0)
    assert(builtin.index_of(runner, "sha256sum") < 0)
    la hybrid = builtin.fil_les("tools/compile_with_hybrid_bundle_v9400.no")
    assert(builtin.index_of(hybrid, "tmpdir + \"/cache-publish-\"") >= 0)
    assert(builtin.index_of(hybrid, "cache_fil + \".\" + import_out_namn(modul) + \".tmp\"") < 0)
    assert(builtin.index_of(hybrid, "norscode-module-cache-v2|norscode-bytecode-v1|selfhost-compiler-0.31") >= 0)
    assert(builtin.index_of(hybrid, "rask_hash_bytes(builtin.fil_les_binær(src))") >= 0)
    assert(builtin.index_of(hybrid, "runtime_fs.native_slett_mappe(rot, ferdige[fi])") >= 0)
    assert(builtin.index_of(hybrid, "kommando(\"rm -rf \" + shell(tmpdir))") < 0)
    assert(builtin.fil_finnes("tests/test_process_async_environment.no"))
    assert(builtin.index_of(strict, "native_fs.native_list(root, katalog)") >= 0)
    assert(builtin.index_of(strict, "kommando(\"find \"") < 0)
    skriv("test_nc_test_parallel_contract OK")
    returner 0
}
