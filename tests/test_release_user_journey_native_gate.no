// Ei ikkje-tom fil frå ein feila byggjeprosess må aldri godkjenne ein release.
// Køyr verkelege barneprosessar: negativ exit med artefakt, vellukka bygg og
// den eksplisitte sluttmarkøren til native-proben.
bruk tools.release_user_journey som ferd
bruk tools.process_runner som prosess

funksjon barn(root: tekst, runtime: tekst, kjelde: tekst) -> ordbok_tekst {
    returner prosess.køyr(runtime, [], root, {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "run", "NORSCODE_FILE": kjelde,
        "NORSCODE_OUTPUT": "", "NORSCODE_RUN_CMD": "", "NORSCODE_RUN_FILE": "",
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, 120000)
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la runtime = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la base = root + "/build/release-native-gate-" + builtin.random_hex(8)
    builtin.mkdir_p(base)
    la kjelde = base + "/barn.no"
    la ut = base + "/delvis-native"
    // JSON-strengen er også eit gyldig, escapa Norscode-tekstliteral.
    la skrive_ut = "builtin.fil_skriv(" + builtin.json_skriv(ut) + ", \"delvis artefakt\"); "
    builtin.fil_skriv(kjelde, "funksjon start() { " + skrive_ut + "returner 23 }\n")
    la feil = barn(root, runtime, kjelde)
    assert_eq(tekst(feil["status"]), "ferdig")
    assert_eq(tekst(feil["exit_code"]), "23")
    assert(ferd.ikkje_tom(ut))
    assert(ikkje ferd.native_bygg_ok(feil, ut))

    builtin.fil_skriv(kjelde, "funksjon start() { returner 0 }\n")
    la ok = barn(root, runtime, kjelde)
    assert(prosess.ok(ok))
    assert(ferd.native_bygg_ok(ok, ut))
    assert(ikkje ferd.native_bygg_ok(ok, base + "/manglar"))
    builtin.fil_skriv(ut, "")
    assert(ikkje ferd.native_bygg_ok(ok, ut))

    builtin.fil_skriv(kjelde,
        "funksjon start() { skriv(\"release-native-selfhost-wrong\"); returner 42 }\n")
    la smoke = barn(root, runtime, kjelde)
    assert_eq(tekst(smoke["status"]), "ferdig")
    assert_eq(tekst(smoke["exit_code"]), "42")
    // Rett exitkode er ikkje nok når sluttmarkøren manglar eller er feil.
    assert_inneholder(tekst(smoke["stdout"]), "release-native-selfhost-wrong")
    assert(ikkje ferd.native_smoke_ok(smoke))
    assert(ikkje ferd.native_smoke_ok(ok))
    assert(ikkje ferd.native_smoke_ok(feil))
    la native = {"status": "ferdig", "exit_code": "42", "stdout": "release-native-selfhost-ok"}
    assert(ferd.native_smoke_ok(native))
    native["stdout"] = ""
    assert(ikkje ferd.native_smoke_ok(native))
    native["stdout"] = "release-native-selfhost-ok"
    native["status"] = "timeout"
    assert(ikkje ferd.native_smoke_ok(native))

    assert_eq(ferd.native_mål("Linux", "x86_64"), "linux-x86_64")
    assert_eq(ferd.native_mål("Linux", "AMD64"), "linux-x86_64")
    assert_eq(ferd.native_mål("Linux", "aarch64"), "linux-arm64")
    assert_eq(ferd.native_mål("Darwin", "arm64"), "macos-arm64")
    assert_eq(ferd.native_mål("Windows", "AMD64"), "windows-x86_64")
    assert_eq(ferd.native_mål("Darwin", "x86_64"), "")
    assert_eq(ferd.native_mål("FreeBSD", "x86_64"), "")
    assert_eq(ferd.native_mål("Linux", "riscv64"), "")

    builtin.fil_slett(kjelde)
    builtin.fil_slett(ut)
    skriv("test_release_user_journey_native_gate OK\n")
    returner 0
}
