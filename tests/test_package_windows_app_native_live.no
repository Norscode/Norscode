bruk tools.package_windows_app_core som pakke
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.zip som zip
bruk tools.zip_stored_writer som zip_writer

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    assert(pakke.abs_sti(root, "D:" + builtin.chr(92) + "repo" + builtin.chr(92) + "norscode.exe") ==
           "D:" + builtin.chr(92) + "repo" + builtin.chr(92) + "norscode.exe")
    assert(pakke.abs_sti(root, "C:/repo/norscode.exe") == "C:/repo/norscode.exe")
    assert(pakke.abs_sti(root, builtin.chr(92) + builtin.chr(92) + "server" + builtin.chr(92) + "norscode.exe") ==
           builtin.chr(92) + builtin.chr(92) + "server" + builtin.chr(92) + "norscode.exe")
    la temp = runtime_fs.native_tempområde("build", "windows-package-live-")
    assert(temp["status"] == "created")
    la base = root + "/build/" + temp["relative"]
    la exe = base + "/fixture.exe"
    builtin.fil_skriv_binær(exe, builtin.bytes_from_list([77, 90, 9, 8, 7]))
    la fixture_info = zip_writer.analyser_fil(base, "fixture.exe")
    assert(fixture_info["status"] == "ok")
    assert(heltall_fra_tekst(fixture_info["crc"]) == 2610798599)

    assert(pakke.pakk(exe, "test-native", root) == 0)
    la zip_sti = root + "/release-artifacts/norscode-windows-test-native.zip"
    la ark = zip.zip_les_lagra(zip_sti)
    assert(lengde(ark["Norscode/bin/norscode.exe"]) == 5)
    assert(lengde(ark["Norscode/bin/nc.exe"]) == 5)
    assert(lengde(ark["Norscode/bin/nc.cmd"]) > 20)
    assert(builtin.trim(builtin.fil_les(zip_sti + ".sha256")) ==
           builtin.sha256_bytes(builtin.fil_les_binær(zip_sti)))

    filops.slett_fil(zip_sti)
    filops.slett_fil(zip_sti + ".sha256")
    assert(filops.slett_tre(base))
    skriv("test_package_windows_app_native_live OK")
    returner 0
}
