bruk tools.verify_arm_blob_windows_inputs som verify

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    la data = builtin.fil_les_binær(root + "/build/arm-blob-stage/windows/nc_main_freestanding_win.exe")
    assert(verify.windows_bytes_ok(data))
    // Same-size corruption must be rejected before this artifact can execute.
    la original = data[4096]
    data[4096] = original ^ 1
    assert(ikkje verify.windows_bytes_ok(data))
    data[4096] = original
    assert(verify.windows_bytes_ok(data))
    assert(ikkje verify.windows_bytes_ok([77, 90]))
    skriv("OK: Windows-adapterens ekte pin og byte-korrupsjonskontroll\n")
    returner 0
}
