// Offentlege HTTP-kall skal sende query-ordboka, bevare eksisterande query,
// prosentkode UTF-8/strukturteikn og aldri sende URL-fragment.
bruk std.http som http
bruk std.socket som socket

funksjon tenar(args: ordbok_tekst) -> tekst {
    la listener = {"handle": args["listener_handle"]}
    la frist = builtin.tid_ms() + 10000
    la peer = {"status": "ventende"}
    mens peer["status"] == "ventende" og builtin.tid_ms() < frist {
        peer = socket.native_aksepter(listener)
    }
    hvis peer["status"] != "connected" { returner "accept:" + tekst(peer["status"]) }
    la req = ""
    mens builtin.index_of(req, "\r\n\r\n") < 0 og builtin.tid_ms() < frist {
        la r = socket.native_les(peer, 4096)
        hvis r["status"] == "ok" { req = req + tekst(r["data"]) }
        ellers hvis r["status"] != "ventende" { returner "read:" + tekst(r["status"]) }
    }
    la slutt = builtin.index_of(req, "\r\n")
    hvis slutt < 0 { returner "read:timeout" }
    la linje = builtin.slice(req, 0, slutt)
    la svar = "HTTP/1.1 200 OK\r\nContent-Length: " + tekst(lengde(linje)) + "\r\nConnection: close\r\n\r\n" + linje
    la offset = 0
    mens offset < lengde(svar) og builtin.tid_ms() < frist {
        la w = socket.native_skriv(peer, builtin.slice(svar, offset, lengde(svar)))
        hvis w["status"] == "ok" {
            la n = heltall_fra_tekst(tekst(w["value"]))
            hvis n <= 0 { returner "write:closed" }
            offset = offset + n
        } ellers hvis w["status"] != "ventende" { returner "write:" + tekst(w["status"]) }
    }
    socket.native_lukk(peer)
    hvis offset != lengde(svar) { returner "write:timeout" }
    returner linje
}

funksjon prøv_kall(api: tekst, suffix: tekst, query: ordbok_tekst, venta: tekst) -> heiltall {
    la l = socket.native_lytt("127.0.0.1", 0, 4)
    assert_eq(tekst(l["status"]), "listening")
    la t = builtin.thread_spawn({"abi": "norscode-native-thread-v1", "operation": "spawn",
        "fn": "__main__.tenar", "args": {"listener_handle": l["handle"]},
        "name": "http-query", "stack_bytes": "262144"})
    assert_eq(tekst(t["status"]), "started")
    la url = "http://127.0.0.1:" + tekst(l["port"]) + suffix
    la r = ""
    hvis api == "request" { r = http.request("GET", url, {}, query, "", 10000) }
    ellers { r = http.request_full("GET", url, {}, query, "", 10000) }
    la j = builtin.thread_join({"abi": "norscode-native-thread-v1", "operation": "join",
        "handle": t["handle"], "thread_id": t["thread_id"], "timeout_ms": "10000"})
    socket.native_lukk(l)
    assert_eq(tekst(j["status"]), "finished")
    assert_eq(tekst(j["value"]), "GET " + venta + " HTTP/1.1")
    assert_eq(http.response_status(r), 200)
    assert_eq(http.response_text(r), "GET " + venta + " HTTP/1.1")
    returner 0
}

funksjon start() -> heiltall {
    assert_eq(http._url_med_query("https://example.test/a#lokal", {"q": "æ &?=#"}),
        "https://example.test/a?q=%c3%a6%20%26%3f%3d%23")
    assert_eq(http._url_med_query("http://example.test/?", {"": ""}), "http://example.test/?=")
    assert_eq(http._url_med_query("http://example.test/?x=1&", {"y": "2"}), "http://example.test/?x=1&y=2")
    assert_eq(http._url_med_query("http://example.test/a?x=1#fragment", {}), "http://example.test/a?x=1")
    assert_eq(http._http_url("http://example.test?x=1")["path"], "/?x=1")
    assert_eq(http._http_url("http://example.test/\r\nInjected: x")["status"], "feil")
    prøv_kall("request", "/søk?keep=1#lokal", {"q": "a b&c=æ"}, "/søk?keep=1&q=a%20b%26c%3d%c3%a6")
    prøv_kall("request_full", "#lokal", {"q": "a/b"}, "/?q=a%2fb")
    prøv_kall("request_full", "/?keep=1#lokal", {}, "/?keep=1")
    skriv("test_http_query OK\n")
    returner 0
}
