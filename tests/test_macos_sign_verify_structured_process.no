bruk std.tekst som t

funksjon krev_strukturert(sti: tekst) {
    la src = fil_les(sti)
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(sti, argv, cwd, {}, 120000)"))
    assert(t.inneholder(src, "builtin.system_info()"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "command -v"))
    assert(ikkje t.inneholder(src, "uname -s"))
    assert(ikkje t.inneholder(src, "kommando(\"pwd\")"))
}

funksjon start() -> heiltall {
    krev_strukturert("tools/verify-macos-app.no")
    krev_strukturert("tools/sign-macos-app.no")

    la verify = fil_les("tools/verify-macos-app.no")
    assert(t.inneholder(verify, "[\"--verify\", \"--deep\", \"--strict\", app_path]"))
    assert(t.inneholder(verify, "[\"--assess\", \"--type\", \"execute\", \"--verbose=4\", app_path]"))

    la sign = fil_les("tools/sign-macos-app.no")
    assert(t.inneholder(sign, "[\"--force\", \"--deep\", \"--sign\", identity"))
    assert(t.inneholder(sign, "[\"verify-macos-app\", app_path]"))

    skriv("test_macos_sign_verify_structured_process OK")
    returner 0
}
