# R4 / F34: stakkspor med funksjon, fil og linje per ramme. e.stakk finst når
# fang-blokka les det (liste av {funksjon, fil, linje}, innerste ramme først);
# ufanga unntak får eit lesbart spor på stderr. Programmet ligg i
# tests/fixtures/r4_stakk.no.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon ncb_av(kjelde: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
}

# Rapporten verten skriv til stderr for eit ufanga unntak.
funksjon rapport_for(kjelde: tekst) -> tekst {
    la ncb = ncb_av(kjelde)
    prøv {
        vm.køyr_ncb(ncb)
    } fang (e) {
        returner vm.vm_ufanga_rapport(e, ncb["functions"])
    }
    returner "INGEN-UNNTAK"
}

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/fixtures/r4_stakk.no")
    la d = builtin.split(tekst(vm.køyr_ncb(ncb_av(kjelde))), "|")
    assert_eq(lengde(d), 7)
    # brukarkast: metode + tre funksjonar + start, med linjenummer
    assert_eq(d[0], "Boks.sprekk@8#__main__ < nivaa3@13#__main__ < nivaa2@17#__main__ < nivaa1@21#__main__ < start@40#__main__")
    # VM-feil (divisjon med null)
    assert_eq(d[1], "delt@25#__main__ < start@45#__main__")
    # nytt kast, nytt spor
    assert_eq(d[2], "Boks.sprekk@8#__main__ < nivaa3@13#__main__ < start@50#__main__")
    # rethrow av pakka unntak bevarer sporet (innerste ramme er framleis sprekk)
    assert_eq(d[3], "rethrow:Boks.sprekk,4,sprakk")
    # utan e.stakk er e den rå teksten (og typenamn(e) er tekst)
    assert_eq(d[4], "sann,tekst")
    # fleire klausular, VM-feil: VerdiFeil-klausulen får sporet
    assert_eq(d[5], "multi:delt:25")
    # ingen klausul passar: sporet frå kast-staden følgjer med vidare
    assert_eq(d[6], "vidare:Boks.sprekk<nivaa3")

    # Ufanga: «ERROR: Type: melding» og eitt «ved»-steg per ramme. (Halekall
    # `returner f()` gjenbruker rammer og er derfor ikkje med i sporet.)
    la p = "funksjon a() -> heiltall {\n    kast \"EigenFeil: djupt\"\n}\n" +
        "funksjon b() -> heiltall {\n    returner a() + 1\n}\n" +
        "funksjon start() -> heiltall {\n    la r = b()\n    returner r\n}\n"
    assert_eq(rapport_for(p),
        "ERROR: EigenFeil: djupt\n" +
        "    ved a (__main__:2)\n" +
        "    ved b (__main__:5)\n" +
        "    ved start (__main__:8)\n")
    # unntak frå ein importert modul: fil frå modulnamnet
    assert_eq(vm.vm_modul_fil({}, "selfhost.vm"), "selfhost/vm.no")
    assert_eq(vm.vm_modul_fil({}, "std.web"), "std/web.no")
    # struktur-unntak og ordbok-unntak: rapporten har typen og sporet
    la ps = "struktur MinFeil {\n    melding\n}\n" +
        "funksjon k() -> heiltall {\n    la f = MinFeil()\n    f.melding = \"stor\"\n    kast f\n}\n" +
        "funksjon start() -> heiltall {\n    la r = k()\n    returner r\n}\n"
    assert_eq(rapport_for(ps),
        "ERROR: MinFeil: stor\n" +
        "    ved k (__main__:7)\n" +
        "    ved start (__main__:10)\n")
    returner 0
}
