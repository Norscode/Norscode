bruk std.auth som auth
bruk std.auth_mfa som mfa
bruk std.base32 som base32
bruk std.db som db
bruk std.filops som filops

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"]) + "/build/auth-full-mfa-" + builtin.random_hex(8)
    assert(filops.lag_katalogar(root))
    miljo_sett("NORSCODE_AUTH_SECURITY_ROOT", root)
    miljo_sett("NORSCODE_AUTH_SECURITY_FILE", "security.json")
    la conn = db.open(":memory:")
    assert(auth.migrer(conn) == 1)
    la user_id = auth.registrer(conn, "ada", "ada@example.test", "correct horse battery staple")
    assert(user_id > 0)
    assert(db.query_text(conn, "SELECT aktiv FROM auth_brukar WHERE id = 1") == "sann")
    assert(db.query_text(conn, "SELECT epost FROM auth_brukar WHERE id = 1") == "ada@example.test")
    assert(db.query_int(conn, "SELECT COUNT(*) FROM auth_brukar WHERE epost = 'ada@example.test'") == 1)
    la lagra_salt = db.query_text(conn, "SELECT salt FROM auth_brukar WHERE id = 1")
    la lagra_hash = db.query_text(conn, "SELECT passord_hash FROM auth_brukar WHERE id = 1")
    assert(auth.verifiser_passord("correct horse battery staple", lagra_salt, lagra_hash))
    la direkte_token = auth.logg_inn(conn, "ada@example.test", "correct horse battery staple")
    assert(direkte_token != "")
    assert(auth.logg_ut(conn, direkte_token))

    la secret_text = "12345678901234567890123456789012"
    la secret = base32.kod_bytes(base32.tekst_til_bytes(secret_text), usann)
    la uri = mfa.start_enrollment(root, "security.json", tekst_fra_heltall(user_id), secret, "Norscode", "ada", 1000)
    assert(builtin.starts_with(uri, "otpauth://totp/"))
    la recovery = mfa.aktiver(root, "security.json", tekst_fra_heltall(user_id), secret, "46119246", 59, 8)
    assert(lengde(recovery) == 8)

    la denied = auth.logg_inn_med_mfa_ved(conn, "ada@example.test", "wrong", "127.0.0.1", 59000)
    assert(denied["status"] == "avvist")
    la pending = auth.logg_inn_med_mfa_ved(conn, "ada@example.test", "correct horse battery staple", "127.0.0.1", 59001)
    assert(pending["status"] == "mfa_påkravd")
    assert(pending["token"] == "")
    assert(pending["challenge"] != "")
    assert(auth.fullfor_mfa_innlogging_ved(conn, pending["challenge"], secret, "00000000", 59001) == "")
    la token = auth.fullfor_mfa_innlogging_ved(conn, pending["challenge"], secret, "46119246", 59001)
    assert(token != "")
    assert(auth.fullfor_mfa_innlogging_ved(conn, pending["challenge"], secret, "46119246", 59001) == "")
    assert(auth.logg_ut(conn, token))

    db.close(conn)
    assert(filops.slett_tre(root))
    skriv("test_auth_full_mfa_norsdb OK\n")
    returner 0
}
