# R3 / F29: grensesnitt fullstendig. Signatursjekk (aritet og returtype),
# fleire grensesnitt per struktur, grensesnitt-arv (grensesnitt B implementerer A),
# standardmetodar (kropp i grensesnittet, syntetisert som Struktur.metode),
# feil ved ukjent grensesnitt / manglande metode, og klar feil for `abstrakt`.
# Køyrer gjennom KJELDE-kompilator + KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner ""
}

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heltall {
    la form = "grensesnitt Form {\n    funksjon areal(self) -> heltall\n}\n"

    // Aritet og returtype må stemme med grensesnittet.
    assert_eq(kompileringsfeil(form + "struktur S implementerer Form { r }\nfunksjon S.areal(self, a, b) -> heltall { returner 1 }\n"),
              "Grensesnittfeil: S.areal har 3 parametrar, men Form.areal krev 1")
    assert_eq(kompileringsfeil(form + "struktur S implementerer Form { r }\nfunksjon S.areal(self) -> tekst { returner \"x\" }\n"),
              "Grensesnittfeil: S.areal returnerer tekst, men Form.areal krev heltall")
    // heiltall og heltall er same type.
    assert_eq(kompileringsfeil(form + "struktur S implementerer Form { r }\nfunksjon S.areal(self) -> heiltall { returner 1 }\n"), "")
    // Ukjent grensesnitt og manglande metode.
    assert_eq(kompileringsfeil("struktur S implementerer Finst { r }\n"), "Grensesnittfeil: S implementerer ukjent grensesnitt Finst")
    assert_eq(kompileringsfeil(form + "struktur S implementerer Form { r }\n"), "Grensesnittfeil: S implementerer Form men manglar metode areal")

    // Grensesnitt-arv: Figur arvar areal frå Form.
    la figur = form + "grensesnitt Figur implementerer Form {\n    funksjon namn(self) -> tekst\n}\n"
    assert_eq(kompileringsfeil(figur + "struktur S implementerer Figur { r }\nfunksjon S.namn(self) -> tekst { returner \"s\" }\n"),
              "Grensesnittfeil: S implementerer Figur men manglar metode areal")
    assert_eq(kompileringsfeil("grensesnitt B implementerer Ukjent { funksjon f(self) }\nstruktur S implementerer B { r }\nfunksjon S.f(self) { returner 1 }\n"),
              "Grensesnittfeil: B implementerer ukjent grensesnitt Ukjent")

    // Fleire grensesnitt, arv og er_instans mot alle forfedrane.
    la prog = figur + "grensesnitt Namngjeven {\n    funksjon kallenamn(self) -> tekst\n}\n"
    prog = prog + "struktur Sirkel implementerer Figur, Namngjeven { r }\n"
    prog = prog + "funksjon Sirkel.areal(self) -> heltall { returner 3 * self.r * self.r }\n"
    prog = prog + "funksjon Sirkel.namn(self) -> tekst { returner \"sirkel\" }\n"
    prog = prog + "funksjon Sirkel.kallenamn(self) -> tekst { returner \"rundt\" }\n"
    prog = prog + "funksjon start() -> tekst {\n    la s = Sirkel(2)\n"
    prog = prog + "    returner s.namn() + \"/\" + s.kallenamn() + \"/\" + tekst(s.areal()) + \"/\" + tekst(er_instans(s, Form)) + tekst(er_instans(s, Figur)) + tekst(er_instans(s, Namngjeven))\n}\n"
    assert_eq(køyr(prog), "sirkel/rundt/12/sannsannsann")

    // Standardmetodar: syntetiserte når strukturen manglar dei, overstyrte elles,
    // òg arva frå eit foreldregrensesnitt.
    la std = "grensesnitt Form {\n    funksjon areal(self) -> heltall\n    funksjon beskriv(self) -> tekst {\n        returner \"areal=\" + tekst(self.areal())\n    }\n}\n"
    std = std + "grensesnitt Teikna implementerer Form {\n    funksjon teikn(self) -> tekst {\n        returner \"[\" + self.beskriv() + \"]\"\n    }\n}\n"
    std = std + "struktur Kvadrat implementerer Teikna { s }\nfunksjon Kvadrat.areal(self) -> heltall { returner self.s * self.s }\n"
    std = std + "struktur Eigen implementerer Form { s }\nfunksjon Eigen.areal(self) -> heltall { returner 1 }\nfunksjon Eigen.beskriv(self) -> tekst { returner \"eigen\" }\n"
    std = std + "funksjon start() -> tekst {\n    returner Kvadrat(3).teikn() + \" \" + Kvadrat(2).beskriv() + \" \" + Eigen(1).beskriv()\n}\n"
    assert_eq(køyr(std), "[areal=9] areal=4 eigen")

    // abstrakt finst ikkje (A4): klar feil i staden for at start() blir sluka.
    assert(builtin.contains(kompileringsfeil("abstrakt struktur Dyr { namn }\nfunksjon start() -> heltall { returner 0 }\n"), "abstrakt er ikkje støtta"))

    // Streng typesjekk: ein struktur passar til eit forfedre-grensesnitt.
    miljo_sett("NORSCODE_STRICT_TYPAR", "1")
    la streng = kompileringsfeil(prog + "funksjon mål(f: Form) -> heltall {\n    returner f.areal()\n}\nfunksjon bruk() -> heltall {\n    returner mål(Sirkel(1))\n}\n")
    la streng_feil = kompileringsfeil(prog + "funksjon mål(f: Namngjeven) -> heltall {\n    returner 1\n}\nstruktur Rute { s }\nfunksjon bruk() -> heltall {\n    returner mål(Rute(1))\n}\n")
    miljo_sett("NORSCODE_STRICT_TYPAR", "")
    assert_eq(streng, "")
    assert(builtin.contains(streng_feil, "argument 1 til mål() er Rute, venta Namngjeven"))
    skriv("grensesnitt ok\n")
    returner 0
}
