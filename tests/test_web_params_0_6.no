bruk std.web som web

// Fase 0.6: tolerant parameter-tolking i std/web.no.
// Byggjer ctx direkte med request_context (utan nc serve), so testen er
// uavhengig av produksjonsdispatcharen og køyrer likt på VM og i Docker.

funksjon _ctx_query(q: ordbok_tekst) -> ordbok_tekst {
    returner web.request_context("get", "/", q, {}, "")
}

funksjon _ctx_form(body: tekst) -> ordbok_tekst {
    la h: ordbok_tekst = {"content-type": "application/x-www-form-urlencoded"}
    returner web.request_context("post", "/", {}, h, body)
}

funksjon start() -> heltall {
    // ── request_query_bool: heile sanningssettet, kasus-uavhengig ──
    assert(web.request_query_bool(_ctx_query({"a": "1"}), "a"))
    assert(web.request_query_bool(_ctx_query({"a": "true"}), "a"))
    assert(web.request_query_bool(_ctx_query({"a": "TRUE"}), "a"))
    assert(web.request_query_bool(_ctx_query({"a": "yes"}), "a"))
    assert(web.request_query_bool(_ctx_query({"a": "On"}), "a"))
    assert(web.request_query_bool(_ctx_query({"a": "sann"}), "a"))
    assert(ikkje web.request_query_bool(_ctx_query({"a": "0"}), "a"))
    assert(ikkje web.request_query_bool(_ctx_query({"a": "false"}), "a"))
    assert(ikkje web.request_query_bool(_ctx_query({"a": "no"}), "a"))
    assert(ikkje web.request_query_bool(_ctx_query({"a": "OFF"}), "a"))
    // ukjend verdi → usann (standard), eller fallback med _or
    assert(ikkje web.request_query_bool(_ctx_query({"a": "kanskje"}), "a"))
    assert(web.request_query_bool_or(_ctx_query({}), "mangler", sann))
    assert(ikkje web.request_query_bool_or(_ctx_query({}), "mangler", usann))
    assert(web.request_query_bool_or(_ctx_query({"a": "rar"}), "a", sann))

    // ── request_query_float ──
    assert_eq(web.request_query_float(_ctx_query({"p": "3.5"}), "p"), 3.5)
    assert_eq(web.request_query_float(_ctx_query({"p": "-2"}), "p"), 0.0 - 2.0)
    assert_eq(web.request_query_float_or(_ctx_query({}), "p", 1.25), 1.25)
    assert_eq(web.request_query_float_or(_ctx_query({"p": "abc"}), "p", 9.0), 9.0)

    // ── request_query_int_or: ugyldig gjev fallback, ikkje unntak ──
    assert_eq(web.request_query_int_or(_ctx_query({"n": "42"}), "n", 7), 42)
    assert_eq(web.request_query_int_or(_ctx_query({"n": "abc"}), "n", 7), 7)
    assert_eq(web.request_query_int_or(_ctx_query({}), "n", 7), 7)

    // ── request_query_list: kommaliste ──
    la lst = web.request_query_list(_ctx_query({"tags": "a,b, c"}), "tags")
    assert_eq(lengde(lst), 3)
    assert_eq(lst[0], "a")
    assert_eq(lst[2], "c")
    assert_eq(lengde(web.request_query_list(_ctx_query({}), "tags")), 0)

    // ── request_form: %-dekoding og + → mellomrom ──
    la ctx = _ctx_form("navn=Ada+Lovelace&by=%C3%98slo&tom=&rolle=a&rolle=b")
    la f = web.request_form(ctx)
    assert_eq(tekst(f["navn"]), "Ada Lovelace")
    assert_eq(tekst(f["by"]), "Øslo")
    assert_eq(tekst(f["tom"]), "")
    // siste verdi vinn for enkeltfelt-oppslag
    assert_eq(web.request_form_field(ctx, "rolle"), "b")
    assert_eq(web.request_form_field_or(ctx, "finst-ikkje", "std"), "std")
    // men request_form_list gjev alle verdiane
    la roller = web.request_form_list(ctx, "rolle")
    assert_eq(lengde(roller), 2)
    assert_eq(roller[0], "a")
    assert_eq(roller[1], "b")

    // feil Content-Type → tom ordbok (ikkje JSON-kropp som form)
    la ctx_json = web.request_context("post", "/", {}, {"content-type": "application/json"}, "navn=X")
    assert_eq(lengde(nøkler(web.request_form(ctx_json))), 0)

    returner 0
}
