bruk selfhost.native_execution.pe_emitter som pe
bruk selfhost.native_execution.windows_codegen som windows
bruk selfhost.native_execution.win64_asm som asm

funksjon start() -> heiltall {
    la image = pe.bygg_exit_pe()
    fil_skriv_binær("build/test-pe-emitter.exe", image)
    assert(pe.verifiser_pe(image))
    assert_eq(lengde(image), 1536)
    assert_eq(pe.les_u32_le(image, 60), 128)
    assert_eq(pe.les_u16_le(image, 132), 34404)
    assert_eq(pe.les_u32_le(image, 272), 8192)
    la exit_7 = windows.kompiler_instruksjoner([["PUSH_CONST", 7], ["RETURN"]])
    assert_eq(exit_7["ok"], "sann")
    assert_eq(exit_7["format"], "PE32+")
    assert(pe.verifiser_pe(exit_7["image"]))
    assert_eq(exit_7["image"][517], 7)
    fil_skriv_binær("build/test-pe-exit7.exe", exit_7["image"])
    assert_eq(windows.kompiler_instruksjoner([["PUSH_CONST", 256], ["RETURN"]])["ok"], "usann")
    assert_eq(windows.kompiler_instruksjoner([["NOP"], ["RETURN"]])["ok"], "usann")

    // W0: generell byggjar med importtabell (GetStdHandle/WriteFile/ExitProcess via IAT).
    la hei = pe.bygg_hei_pe("hei\n", 5)
    fil_skriv_binær("build/test-pe-hei.exe", hei)
    la info = pe.beskriv_pe(hei)
    assert_eq(info["maskin"], 34404)
    assert_eq(info["image_base"], 4194304)
    assert_eq(info["entry_rva"], 4096)
    assert_eq(info["karakteristikk"] & 1, 1)             // RELOCS_STRIPPED
    assert_eq(info["dll_karakteristikk"] & 64, 0)         // ikkje DYNAMIC_BASE
    assert_eq(lengde(info["seksjonar"]), 3)
    assert_eq(info["seksjonar"][0]["namn"], ".text")
    assert_eq(info["seksjonar"][2]["namn"], ".idata")
    assert(finnes_nøkkel(info["importar"], "KERNEL32.dll!WriteFile"))
    assert(finnes_nøkkel(info["importar"], "KERNEL32.dll!GetStdHandle"))
    assert(finnes_nøkkel(info["importar"], "KERNEL32.dll!ExitProcess"))
    // IAT-slotane frå lesaren er dei same som koden kallar gjennom (call [abs32]).
    la imp = pe.bygg_importar(pe.hei_importar(), 12288)
    assert_eq(info["importar"]["KERNEL32.dll!WriteFile"], imp["slot"]["KERNEL32.dll!WriteFile"])

    // Fleire DLL-ar: kvar DLL får eigen IAT-blokk, samanhengande i katalog 12.
    la fleire = pe.bygg_importar([["KERNEL32.dll", ["A", "Bb"]], ["SHELL32.dll", ["C"]]], 8192)
    assert_eq(fleire["import_size"], 60)
    assert_eq(fleire["iat_size"], 40)
    assert_eq(fleire["slot"]["SHELL32.dll!C"], fleire["slot"]["KERNEL32.dll!A"] + 24)

    // Assemblaren: etikettar og rel32-fiksar.
    la a = asm.ny()
    asm.jmp(a, "slutt")
    asm.mov_i32(a, asm.RAX(), 7)
    asm.merk(a, "slutt")
    asm.ret(a)
    la kode = asm.ferdig(a)
    assert_eq(lengde(kode), 11)
    assert_eq(kode[0], 0xE9)
    assert_eq(kode[1], 5)
    la b = asm.ny()
    asm.ld(b, asm.R12(), asm.RSP(), 8)
    asm.st(b, asm.RBP(), 0 - 8, asm.RDI())
    la bb = asm.ferdig(b)
    // mov r12,[rsp+8] = 4C 8B A4 24 08 00 00 00 ; mov [rbp-8],rdi = 48 89 BD F8 FF FF FF
    assert_eq(bb[0], 0x4C) assert_eq(bb[1], 0x8B) assert_eq(bb[2], 0xA4) assert_eq(bb[3], 0x24)
    assert_eq(bb[8], 0x48) assert_eq(bb[9], 0x89) assert_eq(bb[10], 0xBD) assert_eq(bb[11], 0xF8)
    skriv("test_pe_emitter OK")
    returner 0
}
