# Ed25519 (RFC 8032) - offisiell testvektor 2 (§7.1) + aksept/avvising.
# Merk: Ed25519 er tungt i pure VM; køyr helst gjennom native runtime.
bruk std.ed25519 som ed
funksjon _hv(c: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", c) }
funksjon _unhex(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(s) { legg_til(ut, _hv(builtin.slice(s,i,i+1))*16 + _hv(builtin.slice(s,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
funksjon _hex(b: liste_heiltall) -> tekst { la ut = "" la i = 0 mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 } returner ut }
funksjon start() -> heiltall {
    la seed = _unhex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    la pk = ed.public_key(seed)
    assert_eq(_hex(pk), "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")
    la sig = ed.sign(seed, [114])
    assert_eq(_hex(sig), "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
    assert(ed.verify(pk, [114], sig))
    assert(ikkje ed.verify(pk, [115], sig))
    assert_eq(ed.status()["abi"], "norscode-ed25519-v1")
    skriv("test_ed25519_rfc8032 OK")
    returner 0
}
