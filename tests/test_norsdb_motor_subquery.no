// Fase 7d (BINÆR-MOTOREN, std.norsdb_sql): subqueries — skalar, IN (SELECT),
// EXISTS/NOT EXISTS, korrelert, FROM-subquery. Golden = ekte sqlite3 3.51.0.
// NB: eige namn (test_norsdb_motor_subquery) for å ikkje kollidere med
// test_norsdb_subquery.no som ein parallell sesjon eig (std.db/vm-stien).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')")
    sql.exec(db, "CREATE TABLE byar (namn TEXT, land TEXT)")
    sql.exec(db, "INSERT INTO byar (namn, land) VALUES ('Oslo', 'NO')")
    sql.exec(db, "INSERT INTO byar (namn, land) VALUES ('Bergen', 'NO')")
    sql.exec(db, "INSERT INTO byar (namn, land) VALUES ('Paris', 'FR')")

    // Skalar subquery i WHERE (aggregat)
    assert_eq(sql.query_int(db, "SELECT count(*) FROM folk WHERE alder > (SELECT avg(alder) FROM folk)"), 2)
    // Skalar subquery som SELECT-kolonne
    assert_eq(sql.query_rader(db, "SELECT navn, (SELECT count(*) FROM folk) FROM folk WHERE id = 1"), "Ada|4")
    // IN (SELECT …)
    assert_eq(sql.query_int(db, "SELECT count(*) FROM folk WHERE by IN (SELECT namn FROM byar WHERE land = 'NO')"), 4)
    // NOT IN (SELECT …)
    assert_eq(sql.query_rader(db, "SELECT group_concat(navn) FROM folk WHERE by NOT IN (SELECT namn FROM byar WHERE namn = 'Bergen')"), "Ada,Linus,Alan")
    // EXISTS (korrelert)
    assert_eq(sql.query_int(db, "SELECT count(*) FROM folk WHERE EXISTS (SELECT 1 FROM byar WHERE byar.namn = folk.by)"), 4)
    // NOT EXISTS (korrelert, m/ alias)
    assert_eq(sql.query_rader(db, "SELECT group_concat(navn) FROM folk f WHERE NOT EXISTS (SELECT 1 FROM byar WHERE byar.namn = f.by AND land = 'FR')"), "Ada,Linus,Bjørn,Alan")
    // Skalar subquery m/ namneskygging (indre `folk` skyggar ytre → max over alle = 55)
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk WHERE alder = (SELECT max(alder) FROM folk WHERE by = folk.by) ORDER BY navn"), "Linus")
    // Ekte korrelert skalar: alias skil ytre frå indre — eldste i kvar by
    assert_eq(sql.query_rader(db, "SELECT navn FROM folk f WHERE alder = (SELECT max(alder) FROM folk WHERE by = f.by) ORDER BY navn"), "Bjørn\nLinus")

    // FROM (SELECT …) — derivert tabell
    assert_eq(sql.query_rader(db, "SELECT navn, alder FROM (SELECT navn, alder FROM folk WHERE by = 'Oslo') WHERE alder > 40 ORDER BY navn"), "Alan|41\nLinus|55")
    assert_eq(sql.query_int(db, "SELECT count(*) FROM (SELECT * FROM folk WHERE alder > 30)"), 3)
    // FROM-subquery m/ AS-alias på kolonne
    assert_eq(sql.query_rader(db, "SELECT namn2 FROM (SELECT navn AS namn2, alder FROM folk) WHERE alder = 55"), "Linus")

    returner 0
}
