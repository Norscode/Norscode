# R4 / F22: automatisk til_tekst (felt, nøsting, syklus, eigen til_tekst vinn) og
# strukturell == / != (djup, ulike typar ulike, eigen er_lik vinn). VM, kjelde-kjeda.
bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les("tests/fixtures/r4_verdi.no"), "__main__"))
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "Punkt(x=1, y=2)|Linje(a=Punkt(x=1, y=2), b=Punkt(x=3, y=4), navn=l1)|Boks(inn=Linje(a=Punkt(x=1, y=2), b=Punkt(x=3, y=4), navn=l1), lst=[Punkt(x=1, y=2), {a: Punkt(x=1, y=2)}])|<a>|s=Punkt(x=1, y=2)|[Punkt(x=1, y=2), <z>]|Node(namn=a, neste=Node(...))|sann|usann|sann|usann|sann|usann|usann|sann|usann|usann|sann|usann")
    returner 0
}
