# R2 / F15: konst-bindingar. `konst NAMN = v` (kontekstuelt nøkkelord: berre
# ved setningsstart og føre eit namn, så funksjonen konst(…) i native-koden
# er uendra) er ein binding som ikkje kan tilordnast på nytt: `NAMN = …` eller
# `NAMN += …` er ein KOMPILERINGSFEIL, både for modulkonstantar og lokale
# konstantar. Ein lokal deklarasjon med same namn skuggar modulkonstanten.
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon start() -> heiltall {
    # Modulkonstant og lokal konstant (oppg. modular/m03e).
    la ok = "konst MAKS = 10\n" +
        "konst NAMN: tekst = \"n\"\n" +
        "funksjon konst(a, b) -> heltall { returner a + b }\n" +
        "funksjon skugge() -> heltall {\n" +
        "    la MAKS = 1\n" +
        "    MAKS = MAKS + 1\n" +
        "    returner MAKS\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    konst lokal = 5\n" +
        "    la k = konst(1, 2)\n" +
        "    returner \"MAKS=\" + tekst(MAKS) + \" NAMN=\" + NAMN + \" lokal=\" + tekst(lokal) + \" konst()=\" + tekst(k) + \" skugge=\" + tekst(skugge())\n" +
        "}\n"
    assert_eq(utfor(ok), "MAKS=10 NAMN=n lokal=5 konst()=3 skugge=2")

    # Omtilordning av modulkonstant i ein funksjon (oppg. modular/m03f med konst).
    la m03f = "konst MAKS = 10\n" +
        "funksjon endre() {\n" +
        "    MAKS = 99\n" +
        "}\n" +
        "funksjon start() -> heltall { endre() returner MAKS }\n"
    assert_eq(kompileringsfeil(m03f), "Konstfeil linje 3: kan ikkje tilordne til konstanten MAKS")
    # Utvida tilordning, lokal konstant og toppnivå-tilordning.
    assert_eq(kompileringsfeil("konst N = 1\nfunksjon start() -> heltall {\n    N += 1\n    returner N\n}\n"),
        "Konstfeil linje 3: kan ikkje tilordne til konstanten N")
    assert_eq(kompileringsfeil("funksjon start() -> heltall {\n    konst x = 1\n    x = 2\n    returner x\n}\n"),
        "Konstfeil linje 3: kan ikkje tilordne til konstanten x")
    assert_eq(kompileringsfeil("konst N = 1\nN = 2\nfunksjon start() -> heltall { returner N }\n"),
        "Konstfeil linje 2: kan ikkje tilordne til konstanten N")
    # konst utan verdi.
    assert(builtin.contains(kompileringsfeil("konst N\nfunksjon start() -> heltall { returner 0 }\n"), "konstanten N manglar verdi"))
    returner 0
}
