# bigint-verifikasjon mot Python-berekna referansevektorar (mul, divmod, modexp).
bruk std.bigint som bn
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
# bigint -> minimal big-endian hex (som Python hex uten leiande null).
funksjon bn_hex(a: liste_heiltall) -> tekst {
    la bytes = bn.til_bytes(a, lengde(a) * 2)
    la i = 0
    mens i < lengde(bytes) - 1 og bytes[i] == 0 { i = i + 1 }
    la ut = ""
    mens i < lengde(bytes) { ut = ut + _hx(bytes[i]) i = i + 1 }
    returner ut
}
funksjon start() -> heiltall {
    # (1) MUL liten
    la a = bn.fra_bytes(_b("bdd640fb06671ad1"))
    la b = bn.fra_bytes(_b("bc8960a923b8c1e9392456de3eb13b91"))
    assert_eq(bn_hex(bn.mul(a, b)), "8bcf370ee45679a939a2d20f381ed3931f4085ae8c155b61")

    # (2) DIVMOD
    la u = bn.fra_bytes(_b("18c267976142ea7d17be31111a2a73ed562b0f79c37459eef50bea63371ecd7b"))
    la v = bn.fra_bytes(_b("43b7a3a69a8dca03580d7b71d8f56413"))
    la dm = bn.divmod(u, v)
    assert_eq(bn_hex(dm["q"]), "5d99d52a8cd43bf52f1881080799b4e9")
    assert_eq(bn_hex(dm["r"]), "0b4b857c192e5f1924206f3ae10e5c30")

    # (3) MODEXP 2048-bit med e=65537 (RSA-verifikasjonssti)
    la base = bn.fra_bytes(_b(""))
    la e = bn.fra_bytes(_b("010001"))
    la n = bn.fra_bytes(_b(""))
    la r = bn.modexp(base, e, n)
    assert_eq(bn_hex(r), "")

    assert_eq(bn.status()["base"], 65536)
    skriv("test_bigint OK")
    returner 0
}
