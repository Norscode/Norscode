// Fase 4b: aggregat + GROUP BY / HAVING i det frittståande SQL-laget.
// Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')")

    // Skalar-aggregat via query_int
    assert_eq(sql.query_int(db, "SELECT SUM(alder) FROM folk"), 162)
    assert_eq(sql.query_int(db, "SELECT MIN(alder) FROM folk"), 29)
    assert_eq(sql.query_int(db, "SELECT MAX(alder) FROM folk"), 55)
    assert_eq(sql.query_int(db, "SELECT SUM(alder) FROM folk WHERE by = 'Oslo'"), 133)

    // GROUP BY (grupper sortert på nøkkel = SQLite default)
    assert_eq(sql.query_rader(db, "SELECT by, COUNT(*) FROM folk GROUP BY by"), "Bergen|1\nOslo|3")
    assert_eq(sql.query_rader(db, "SELECT by, SUM(alder) FROM folk GROUP BY by ORDER BY by"), "Bergen|29\nOslo|133")
    assert_eq(sql.query_rader(db, "SELECT by, MIN(alder), MAX(alder) FROM folk GROUP BY by ORDER BY by"), "Bergen|29|29\nOslo|37|55")

    // HAVING på aggregat
    assert_eq(sql.query_rader(db, "SELECT by, COUNT(*) FROM folk GROUP BY by HAVING COUNT(*) > 1"), "Oslo|3")

    returner 0
}
