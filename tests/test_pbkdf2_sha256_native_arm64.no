// RUTING-TEST: builtin.pbkdf2_sha256 (gap-stubba) → rutast til rein-Norscode
// std.pbkdf2 (tvangs-bundla via NORSCODE_BUNDLE_FORCE_STD_ROUTING), kompilert native.
// Ingen import — rutinga leverer impl. 42 = alle RFC-vektorar rette.
funksjon start() -> heiltall {
    la pw = [112, 97, 115, 115, 119, 111, 114, 100]
    la salt = [115, 97, 108, 116]
    hvis builtin.pbkdf2_sha256(pw, salt, 1, 32) != "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b" { returner 1 }
    hvis builtin.pbkdf2_sha256(pw, salt, 2, 32) != "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43" { returner 2 }
    hvis builtin.pbkdf2_sha256(pw, salt, 4096, 32) != "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a" { returner 3 }
    returner 42
}
