funksjon start() -> heiltall {
    la pw = [112, 97, 115, 115, 119, 111, 114, 100]
    la salt = [115, 97, 108, 116]
    skriv("pbkdf2(1,32)=") skriv(builtin.pbkdf2_sha256(pw, salt, 1, 32)) skriv("\n")
    skriv("pbkdf2(2,32)=") skriv(builtin.pbkdf2_sha256(pw, salt, 2, 32)) skriv("\n")
    la saltbe = [115, 97, 108, 116, 0, 0, 0, 1]
    skriv("hmac(salt||BE1)=") skriv(builtin.hmac_sha256(pw, saltbe)) skriv("\n")
    returner 42
}
