bruk std.ws som ws

// RFC 6455 §5.7 frame-codec: kjende byte-vektorar + roundtrip.
//
// Frame-codecen i std.ws (bygg_frame/parse_frame/frame_til_tekst) var aldri
// testa. Denne testen låser (a) den kanoniske umaskerte "Hello"-tekstframen,
// (b) dekoding av den maskerte "Hello"-framen frå spesifikasjonen, og
// (c) binær-sikker roundtrip inkludert newline og høge byte (0-255).

funksjon _bytes_lik(a: liste_heltall, b: liste_heltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i: heltall = 0
    mens i < lengde(a) {
        hvis a[i] != b[i] { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    // RFC 6455 §5.7: éin umaskert tekst-frame "Hello".
    // Forventa byte: 0x81 0x05 0x48 0x65 0x6c 0x6c 0x6f.
    la f = ws.bygg_tekst_frame("Hello", usann)
    la forventa: liste_heltall = [129, 5, 72, 101, 108, 108, 111]
    assert(_bytes_lik(f, forventa))

    // RFC 6455 §5.7: éin maskert tekst-frame "Hello" (mask 0x37fa213d).
    // Parse skal gi tilbake payload "Hello".
    la maskert: liste_heltall = [129, 133, 55, 250, 33, 61, 127, 159, 77, 81, 88]
    la p = ws.parse_frame(maskert)
    assert(p["maskert"] == "1")
    assert(p["payload_len"] == "5")
    assert(ws.frame_til_tekst(p) == "Hello")

    // Binær-sikker roundtrip: bytes med newline (10) og høg byte (200).
    // Den gamle frame_til_tekst slepte alt utanfor 32-126.
    la raa: liste_heltall = [72, 73, 10, 200, 0, 255]
    la bf = ws.bygg_frame(raa, ws.OPCODE_BINAR(), sann)
    la bp = ws.parse_frame(bf)
    assert(_bytes_lik(ws.frame_til_bytes(bp), raa))

    // Umaskert roundtrip via tekst.
    la tf = ws.bygg_tekst_frame("Hei verda!", usann)
    la tp = ws.parse_frame(tf)
    assert(ws.frame_til_tekst(tp) == "Hei verda!")

    skriv("test_ws_frame_rfc6455: OK (7 assertar)\n")
    returner 0
}
