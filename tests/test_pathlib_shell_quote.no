bruk std.tekst som t
bruk std.pathlib som pl

funksjon start() -> heiltall {
    la src = fil_les("std/pathlib.no")
    assert(t.inneholder(src, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(src, "returner builtin.fil_finnes(p[\"sti\"])"))
    assert(t.inneholder(src, "native_fs.native_list(p[\"sti\"], \"\")"))
    assert(t.inneholder(src, "Fail-closed til lstat/reparse-point"))
    assert(t.inneholder(src, "builtin.mkdir_p(p[\"sti\"])"))
    assert(t.inneholder(src, "builtin.fil_slett(p[\"sti\"])"))
    assert(t.inneholder(src, "native_fs.native_slett_mappe(rot, namn(p))"))
    assert(t.inneholder(src, "builtin.fil_skriv_binær(ny_sti[\"sti\"], builtin.fil_les_binær(p[\"sti\"]))"))
    assert(t.inneholder(src, "lengde(builtin.fil_les_binær(p[\"sti\"]))"))
    assert(t.inneholder(src, "funksjon _mønster_treff"))
    assert(t.inneholder(src, "funksjon _rglob_fyll"))

    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "find "))
    assert(ikkje t.inneholder(src, "rm -rf"))
    assert(ikkje t.inneholder(src, "rmdir "))

    la fil = pl.ny("build/pathlib-native-test.txt")
    la flytta = pl.ny("build/pathlib-native-moved.txt")
    hvis pl.eksisterer(fil) { pl.slett_fil(fil) }
    hvis pl.eksisterer(flytta) { pl.slett_fil(flytta) }
    pl.skriv_tekst(fil, "pathlib-ok")
    assert(pl.er_fil(fil))
    assert(pl.er_katalog(pl.forelder(fil)))
    assert(pl.storleik(fil) == 10)
    assert(lengde(pl.glob(pl.forelder(fil), "pathlib-native-*.txt")) >= 1)
    pl.omdøyp(fil, flytta)
    assert(ikkje pl.eksisterer(fil))
    assert(pl.les_tekst(flytta) == "pathlib-ok")
    pl.slett_fil(flytta)
    assert(ikkje pl.eksisterer(flytta))

    skriv("test_pathlib_shell_quote OK")
    returner 0
}
