// Ende-til-ende: .no -> NCB -> signert Mach-O arm64 -> ekte prosess.
// Alle prosessar blir starta gjennom strukturert argv-ABI, aldri gjennom shelltekst.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    // Committed macOS stage0 har ikkje argv_operation i den innebygde
    // nc_main-generasjonen. Den ekte attestasjonslana uttrykkjer derfor dei
    // same to Norscode-operasjonane gjennom den stabile miljø-ABI-en.
    hvis miljo_hent("NORSCODE_ATTEST_REAL_MACOS") == "1" og executable == miljo_hent("NORSCODE_NATIVE_BIN") {
        hvis lengde(argv) == 3 og argv[0] == "compile" {
            miljø["NORSCODE_CMD"] = "compile"
            miljø["NORSCODE_FILE"] = argv[1]
            miljø["NORSCODE_OUTPUT"] = argv[2]
        } ellers hvis lengde(argv) == 6 og argv[0] == "bygg-native" og argv[3] == "--ncb" {
            miljø["NORSCODE_CMD"] = "run"
            miljø["NORSCODE_FILE"] = root + "/selfhost/native_execution/macho_arm64_codegen.no"
            miljø["NC_INPUT"] = argv[4]
            miljø["NC_OUTPUT"] = argv[5]
        }
    }
    returner prosess.køyr(executable, argv, root, miljø, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon start() -> heiltall {
    // Den signerte macOS-attestasjonsporten har allereie kontrollert Darwin
    // og arm64 med /usr/bin/uname gjennom prosess-ABI-en. Eldre committed
    // stage0 manglar system_info i den innebygde VM-en, så akkurat den
    // kandidaten får bruke det eksplisitte, fail-closed hostbeviset.
    hvis miljo_hent("NORSCODE_ATTEST_REAL_MACOS") != "1" {
        la info = builtin.system_info()
        hvis tekst(info["system"]) != "Darwin" eller tekst(info["machine"]) != "arm64" { returner 0 }
    }

    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la id = builtin.random_hex(8)
    la ncb = "/tmp/norscode_macho_aot_cli_" + id + ".ncb.json"
    la binær = "/tmp/norscode_macho_aot_cli_" + id
    la kjelde = root + "/tests/fixtures/macos_aot_control_flow.no"
    la nc = runtime(root)

    krev_exit(køyr(nc, ["compile", kjelde, ncb], root, 180000), 0)
    krev_exit(køyr(nc, ["bygg-native", "--target", "macos-arm64", "--ncb", ncb, binær], root, 180000), 0)
    // Også eldre macOS-stage0 eksponerer Norscode sin smale executable-ABI.
    // Filmodus er derfor aldri delegert til ein ekstern normaloperasjon.
    assert(builtin.fil_sett_kjorbar(binær))
    krev_exit(køyr("/usr/bin/codesign", ["--verify", "--verbose=4", binær], root, 30000), 0)
    krev_exit(køyr(binær, [], root, 30000), 17)

    filops.slett_fil(ncb)
    filops.slett_fil(binær)
    skriv("test_macho_arm64_aot_cli OK\n")
    returner 0
}
