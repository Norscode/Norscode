# A7: eigenskapane til std/synk_kjerne.no (HLC, samanfletting, validering, JSON). Sjølve
# sjekkane står i tests/fixtures/synk_kjerne_sjekk.no og køyrer i ein barneprosess i
# VM-fastmodus; standard-VM-en brukar over 100 s på dei 600 samanflettingane.
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon start() -> heltall {
    la rot = hjelp.root()
    la m = hjelp.grunnmiljø(rot)
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = rot + "/tests/fixtures/synk_kjerne_sjekk.no"
    m["NORSCODE_VM_FAST"] = "1"
    la r = hjelp.køyr_nc(m, 300000)
    skriv(r["stdout"])
    hjelp.krev_ok("synk_kjerne_sjekk", r)
    assert(builtin.index_of(r["stdout"], "synk_kjerne_sjekk OK") >= 0)
    assert(builtin.index_of(r["stdout"], "ERROR") < 0)
    skriv("test_synk_kjerne OK\n")
    returner 0
}
