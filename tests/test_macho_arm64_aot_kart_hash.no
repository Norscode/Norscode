// R2 / F25: macOS arm64 AOT — hasha kart med typa nøklar (tests/fixtures/arm64_kart_hash.no),
// bygd både med bump-heap (NORSCODE_GC_ALLOC=0) og i GC-modus med låg port (NORSCODE_GC_TERSKEL_BYTES),
// so hash-indeksen må overleve mange collects. Før F25 søkte ARM64 lineært (5000 nøklar:
// 1 M oppslag 2,7 s mot 26 ms no) og heiltalsnøkkel i har_nokkel gav SIGSEGV.
// Køyrer berre på macOS arm64 (linux-arm64 går gjennom tools/arm64_diff_lane.no).

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_macos_arm64() -> bool {
    la system = miljo_hent("NORSCODE_CI_SYSTEM")
    la maskin = miljo_hent("NORSCODE_CI_ARCH")
    hvis system == "" { system = miljo_hent("RUNNER_OS") }
    hvis maskin == "" { maskin = miljo_hent("RUNNER_ARCH") }
    hvis system == "" eller maskin == "" {
        prøv {
            la info = builtin.system_info()
            hvis system == "" { system = tekst(info["system"]) }
            hvis maskin == "" { maskin = tekst(info["machine"]) }
        } fang (e) {}
    }
    la macos = system == "macOS" eller system == "MacOS" eller system == "Darwin" eller system == "darwin"
    la arm64 = maskin == "ARM64" eller maskin == "arm64" eller maskin == "aarch64"
    returner macos og arm64
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon fasit() -> tekst {
    returner "A n=5000 sum=12497500 k7=700 k4999=1 manglar=ingenting\n" +
        "A har=sann/usann/sann\n" +
        "B n=3333 att=3333 borte=1667 første=k1,k2 siste=k4999\n" +
        "B k3=33 k4=4 siste=k3 n=3334\n" +
        "C n=3000 sum=4498500 h[14]=2 h[15]=ingenting type(nøkkel)=heltall\n" +
        "C har=sann/usann/usann\n" +
        "D bool n=2 sann=JA usann=nei\n" +
        "E d[0]=NULL d[\"0\"]=NULL d[1]=ein d[2]=to n=3 har(\"2\")=usann\n" +
        "F n=41 sum=1560 f39=78 ny=1\n" +
        "G {\"1\":\"a\",\"b\":2,\"true\":false}\n" +
        "H små=40000 v.n=32 v0=0 v2=ingenting v39=39\n"
}

funksjon bygg_og_køyr(root: tekst, nc: tekst, kjelde: tekst, binær: tekst, gc: bool) -> heiltall {
    la miljø = {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_GC_ALLOC": "0",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    hvis gc {
        miljø["NORSCODE_GC_ALLOC"] = "1"
        miljø["NORSCODE_GC_TERSKEL_BYTES"] = "1048576"
    }
    krev_exit(prosess.køyr_med_grenser(nc, ["bygg-native", "--target", "macos-arm64", kjelde, binær], root, miljø, 900000, 0, 1024), 0)
    la res = prosess.køyr(binær, [], root, {}, 60000)
    krev_exit(res, 0)
    hvis tekst(res["stdout"]) != fasit() {
        prosess.skriv_resultat(res)
        assert_eq(tekst(res["stdout"]), fasit())
    }
    filops.slett_fil(binær)
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_macos_arm64() { returner 0 }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la id = builtin.random_hex(8)
    la kjelde = root + "/tests/fixtures/arm64_kart_hash.no"
    la nc = runtime(root)
    bygg_og_køyr(root, nc, kjelde, "/tmp/norscode_macho_kart_hash_" + id, usann)
    bygg_og_køyr(root, nc, kjelde, "/tmp/norscode_macho_kart_hash_gc_" + id, sann)
    skriv("test_macho_arm64_aot_kart_hash OK\n")
    returner 0
}
