bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/maint/splice_generated_functions.no")
    assert(t.inneholder(src, "NC_SPLICE_FUNCTIONS"))
    assert(t.inneholder(src, "hvis ut_sti == base_sti"))
    assert(t.inneholder(src, "splice.funksjonsdefinisjon"))
    assert(t.inneholder(src, "nye_prototypar"))
    assert(t.inneholder(src, "nye_definisjonar"))
    skriv("test_splice_generated_functions_contract OK")
    returner 0
}
