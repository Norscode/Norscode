// GLOB-operator (case-sensitiv glob: * ? [..]). Golden = ekte sqlite3 3.51.0.
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")
    assert_eq(sql.exec(db, "CREATE TABLE g (v TEXT)"), 0)
    assert_eq(sql.exec(db, "INSERT INTO g VALUES ('Ada')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO g VALUES ('ada')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO g VALUES ('file.txt')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO g VALUES ('aXc')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO g VALUES ('abc')"), 1)

    // case-sensitiv: 'A*' treffer 'Ada' men ikkje 'ada'
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM g WHERE v GLOB 'A*'"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM g WHERE v GLOB 'a*'"), 3)
    // ? = eitt teikn
    assert_eq(sql.query_text(db, "SELECT v FROM g WHERE v GLOB 'A?a'"), "Ada")
    // teiknklasse [..], negasjon [^..], range [a-c]
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM g WHERE v GLOB 'A[dz]a'"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM g WHERE v GLOB 'A[^x]a'"), 1)
    assert_eq(sql.query_text(db, "SELECT v FROM g WHERE v GLOB '*.txt'"), "file.txt")
    assert_eq(sql.query_text(db, "SELECT v FROM g WHERE v GLOB '*.[tc]xt'"), "file.txt")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM g WHERE v GLOB '[a-c][a-c][a-c]'"), 1)
    // NOT GLOB
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM g WHERE v NOT GLOB '[a-c][a-c][a-c]'"), 4)

    skriv("test_norsdb_glob OK\n")
    returner 0
}
