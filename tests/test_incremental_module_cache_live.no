bruk selfhost.bundler som bundler

funksjon env_eller(namn: tekst, fallback: tekst) -> tekst {
    prøv {
        la verdi = miljo_hent(namn)
        hvis verdi != "" { returner verdi }
    } fang (e) {}
    returner fallback
}

funksjon tel(src: tekst, nål: tekst) -> heiltall {
    returner lengde(builtin.split(src, nål)) - 1
}

funksjon start() -> heiltall {
    la root = env_eller("NORSCODE_ROOT", ".")
    la runtime = env_eller("NORSCODE_NATIVE_BIN", root + "/dist/norscode_native")
    la run_id = tekst_fra_heiltall(builtin.tid_ms())
    la dir = root + "/build/incremental-module-live-" + run_id
    builtin.mkdir_p(dir)
    la a = dir + "/a.no"
    la b = dir + "/b.no"
    la trace = dir + "/trace.txt"
    la out1 = dir + "/first.ncb.json"
    la out2 = dir + "/second.ncb.json"
    fil_skriv(trace, "")
    fil_skriv(a, "funksjon verdi() -> tekst { returner \"" + run_id + "-a1\" }\n")
    fil_skriv(b, "funksjon verdi() -> tekst { returner \"" + run_id + "-b1\" }\n")

    miljo_sett("NORSCODE_ROOT", root)
    miljo_sett("NORSCODE_NATIVE_BIN", runtime)
    miljo_sett("NORSCODE_INCREMENTAL_MODULE_CACHE", "1")
    miljo_sett("NORSCODE_MODULE_CACHE_TRACE_FILE", trace)
    bundler.bygg_bundle(["inc.a=" + a, "inc.b=" + b], out1)

    fil_skriv(a, "funksjon verdi() -> tekst { returner \"" + run_id + "-a2\" }\n")
    bundler.bygg_bundle(["inc.a=" + a, "inc.b=" + b], out2)

    la logg = fil_les(trace)
    assert(tel(logg, "compile inc.a\n") == 2)
    assert(tel(logg, "compile inc.b\n") == 1)
    assert(tel(logg, "hit inc.a\n") == 0)
    assert(tel(logg, "hit inc.b\n") == 1)
    assert(fil_les(out1) != fil_les(out2))
    returner 0
}
