bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/maint/splice_native_argv_dispatch.no")
    assert(t.inneholder(src, "funksjon nc_main_funksjonsnamn"))
    assert(t.inneholder(src, "nc_fn_selfhost_nc_main_"))
    assert(t.inneholder(src, "lengde(namn) == 0"))
    assert(t.inneholder(src, "funksjonsdefinisjon(base, fn)"))
    assert(t.inneholder(src, "norscode_generated_argv_dispatch.c"))
    assert(t.inneholder(src, "splice-målet er ikkje eintydig"))
    assert(t.inneholder(src, "nye_prototypar"))
    assert(t.inneholder(src, "nye_definisjonar"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    la main = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(main, "funksjon nc_run_policy() -> heiltall"))
    assert(t.inneholder(main, "NORSCODE_VM_TARGET_CAPABILITIES"))
    assert(t.inneholder(main, "NORSCODE_VM_TARGET_DISK_ROOT"))
    assert(t.inneholder(main, "nc_run_policy()"))
    skriv("test_splice_native_argv_dispatch_contract OK")
    returner 0
}
