funksjon normaliser(ncb_json: tekst, alias: tekst) -> tekst {
    returner tekst_erstatt(ncb_json, "\"builtin." + alias + ".", "\"" + alias + ".")
}

funksjon start() -> heiltall {
    la src = fil_les("selfhost/nc_main.no")
    la inn = "{\"code\":[[\"CALL\",\"builtin.native_fs.native_list\",2],[\"CALL\",\"builtin.native_fs.native_slett\",2]]}"
    la ut = normaliser(inn, "native_fs")
    assert(ikkje builtin.contains(ut, "builtin.native_fs."))
    assert(builtin.contains(ut, "\"native_fs.native_list\""))
    assert(builtin.contains(ut, "\"native_fs.native_slett\""))
    assert(builtin.contains(src, "builtin.starts_with(import_fil, \"tools/\")"))
    assert(builtin.contains(src, "builtin.starts_with(import_fil, \"tests/\")"))
    skriv("test_native_cli_import_alias_normalization OK")
    returner 0
}
