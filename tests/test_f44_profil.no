# F44: nc profile — funksjonsprofil frå VM-metrikkar (kall, instruksjonar, tid).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk tools.nc_profile som prof

funksjon start() -> heiltall {
    la kjelde = "funksjon liten() -> heltall {\n    returner 1\n}\nfunksjon stor() -> heltall {\n    la s = 0\n    la i = 0\n    mens i < 20 {\n        s = s + liten()\n        i = i + 1\n    }\n    returner s\n}\nfunksjon start() -> heltall {\n    stor()\n    returner 0\n}\n"
    miljo_sett("NORSCODE_VM_FAST", "0")
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la res = vm.køyr_ncb_dekning(ncb)
    assert_eq(res["resultat"], 0)
    la metrics = ncb["functions"]["__vm_metrics__"]
    la rader = prof.profil_rader(metrics)
    assert_eq(lengde(rader), 3)
    la liten = 0
    la stor = 0
    la i = 0
    mens i < lengde(rader) {
        hvis rader[i]["fn"] == "__main__.liten" { liten = rader[i]["kall"] }
        hvis rader[i]["fn"] == "__main__.stor" { stor = rader[i]["instr"] }
        i = i + 1
    }
    assert_eq(liten, 20)
    assert(stor > 100)
    # Sortert fallande på tid, deretter instruksjonar.
    assert(rader[0]["ms"] >= rader[1]["ms"])
    la tekst_ut = prof.formater(rader, 2, metrics)
    assert_inneholder(tekst_ut, "Funksjonsprofil")
    assert_inneholder(tekst_ut, "__main__.stor")
    returner 0
}
