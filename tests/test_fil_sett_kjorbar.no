// builtin.fil_sett_kjorbar må gje ein ekte bool på fersk seed. Før gap-ruta
// (std.native_gap.fil_sett_kjorbar_gap) var kallet null-fallback i x86-codegen:
// returnerte null, sette ingen x-bit, og `nc bygg-native` skreiv ELF-ar som
// ikkje kunne køyrast.

//
// Målt 2026-09-10: committa stage0 (macOS arm64 og Linux x86_64) → boolsk sann,
// modus -rwxr-xr-x. Fersk x86-seed utan gap-ruta → ingenting, modus -rw-r--r--.

bruk std.filops som filops

funksjon start() -> heiltall {
    la sti = "/tmp/norscode-kjorbar-" + builtin.random_hex(12) + ".sh"
    fil_skriv(sti, "#!/bin/sh\nexit 3\n")
    la ok = builtin.fil_sett_kjorbar(sti)
    filops.slett_fil(sti)
    assert(ok == sann)

    // Manglande fil: chmod gjev ENOENT → ikkje sann (eller unntak på eldre vertar).
    la mangler = "/tmp/norscode-kjorbar-mangler-" + builtin.random_hex(12)
    prøv { assert(builtin.fil_sett_kjorbar(mangler) != sann) } fang (e) { }
    skriv("test_fil_sett_kjorbar OK\n")
    returner 0
}
