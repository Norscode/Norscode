// Fase 7b: SQL-skalarfunksjonar (streng/heiltal) + group_concat (tekst-aggregat).
// Golden = ekte sqlite3 3.51.0. (round/printf-%f/typeof krev REAL → Fase 7j.)

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la rad = {"navn": "Ada", "by": "Oslo", "tom": ""}

    // Streng-trim
    assert_eq(sql.evaluer_uttrykk("trim('  hi  ')", rad), "hi")
    assert_eq(sql.evaluer_uttrykk("ltrim('  hi  ')", rad), "hi  ")
    assert_eq(sql.evaluer_uttrykk("rtrim('  hi  ')", rad), "  hi")
    // instr (1-basert, 0 = ikkje funne)
    assert_eq(sql.evaluer_uttrykk("instr('hello', 'll')", rad), "3")
    assert_eq(sql.evaluer_uttrykk("instr('hello', 'z')", rad), "0")
    // ifnull / nullif
    assert_eq(sql.evaluer_uttrykk("ifnull(nullif('x','x'), 'FALLBACK')", rad), "FALLBACK")
    assert_eq(sql.evaluer_uttrykk("ifnull('a', 'b')", rad), "a")
    assert_eq(sql.evaluer_uttrykk("nullif('a', 'b')", rad), "a")
    // hex / quote
    assert_eq(sql.evaluer_uttrykk("hex('AB')", rad), "4142")
    assert_eq(sql.evaluer_uttrykk("quote('a''b')", rad), "'a''b'")
    // multi-arg max/min (skalar)
    assert_eq(sql.evaluer_uttrykk("max(3, 9, 1)", rad), "9")
    assert_eq(sql.evaluer_uttrykk("min(3, 9, 1)", rad), "1")
    // substr med negativ start
    assert_eq(sql.evaluer_uttrykk("substr('hello', -2, 2)", rad), "lo")
    // printf
    assert_eq(sql.evaluer_uttrykk("printf('%s=%05d', 'n', 42)", rad), "n=00042")
    assert_eq(sql.evaluer_uttrykk("printf('%d-%d', 3, 4)", rad), "3-4")
    assert_eq(sql.evaluer_uttrykk("printf('%x', 255)", rad), "ff")
    // char (multi-arg)
    assert_eq(sql.evaluer_uttrykk("char(72, 105)", rad), "Hi")

    // group_concat i spørring
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (1, 'Ada', 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (2, 'Linus', 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, by) VALUES (3, 'Bjørn', 'Bergen')")
    assert_eq(sql.query_rader(db, "SELECT group_concat(navn) FROM folk"), "Ada,Linus,Bjørn")
    assert_eq(sql.query_rader(db, "SELECT group_concat(navn, '; ') FROM folk"), "Ada; Linus; Bjørn")
    assert_eq(sql.query_rader(db, "SELECT by, group_concat(navn) FROM folk GROUP BY by ORDER BY by"),
        "Bergen|Bjørn\nOslo|Ada,Linus")

    returner 0
}
