funksjon start() -> heiltall {
    la delt = [1, 2, 3]
    la alias_ein = delt
    la alias_to = delt
    assert_eq(alias_ein[1], 2)
    assert_eq(alias_to[2], 3)

    // Standard pure-VM-terskel er 16 allokeringar. Hald aliasane levande
    // medan nye lister utløyser minst éi automatisk innsamling.
    la i: heiltall = 0
    mens i < 40 {
        la mellombels = [i, i + 1]
        assert_eq(mellombels[0], i)
        i = i + 1
    }
    la metrics = builtin.vm_runtime_metrics()
    la kandidatar = heltall_fra_tekst(metrics["gc_root_candidates"])
    la unike = heltall_fra_tekst(metrics["gc_root_unique"])
    la fjerna = heltall_fra_tekst(metrics["gc_root_duplicates_elided"])
    assert(kandidatar > unike)
    assert(fjerna > 0)
    assert_eq(kandidatar - unike, fjerna)
    assert_eq(alias_to[0], 1)
    skriv("test_vm_gc_root_dedup OK")
    returner 0
}
