bruk std.auth_security som auth

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"]) + "/build/auth-security-test-v1"
    la relativ = "state.json"
    la full = root + "/" + relativ
    builtin.mkdir_p(root)
    prøv { hvis builtin.fil_finnes(full) { builtin.fil_slett(full) } } fang (e) {}

    la start_ms: heiltall = 1000000
    assert(auth.innlogging_tillaten_ved(root, relativ, "Ada@Example.test", "203.0.113.7", start_ms))
    assert(auth.registrer_innloggingsfeil_ved(root, relativ, "Ada@Example.test", "203.0.113.7", start_ms, 3, 60000, 120000) == 0)
    assert(auth.registrer_innloggingsfeil_ved(root, relativ, "ada@example.test", "203.0.113.7", start_ms + 1, 3, 60000, 120000) == 0)
    la sperra = auth.registrer_innloggingsfeil_ved(root, relativ, "ADA@example.test", "203.0.113.7", start_ms + 2, 3, 60000, 120000)
    assert(sperra == start_ms + 120002)
    assert(ikkje auth.innlogging_tillaten_ved(root, relativ, "ada@example.test", "203.0.113.7", start_ms + 3))

    // Ny innlasting frå fil beviser restartbestandig sperre.
    assert(ikkje auth.innlogging_tillaten_ved(root, relativ, "ada@example.test", "203.0.113.7", start_ms + 4))
    assert(auth.innlogging_tillaten_ved(root, relativ, "ada@example.test", "203.0.113.7", start_ms + 120003))
    auth.nullstill_innloggingsvern(root, relativ, "ada@example.test", "203.0.113.7")
    assert(auth.innlogging_tillaten_ved(root, relativ, "ada@example.test", "203.0.113.7", start_ms + 5))

    // Reautentisering er kortlevd, sessionbunden, brukarbunden og eingongs.
    la billett = auth.utsted_reautentisering_ved(root, relativ, "session-A", "7", start_ms, 60000)
    assert(billett != "")
    assert(auth.bruk_reautentisering_ved(root, relativ, "session-A", "7", billett, start_ms + 1))
    assert(ikkje auth.bruk_reautentisering_ved(root, relativ, "session-A", "7", billett, start_ms + 2))
    la feil_session = auth.utsted_reautentisering_ved(root, relativ, "session-A", "7", start_ms, 60000)
    assert(ikkje auth.bruk_reautentisering_ved(root, relativ, "session-B", "7", feil_session, start_ms + 1))
    la feil_brukar = auth.utsted_reautentisering_ved(root, relativ, "session-A", "7", start_ms, 60000)
    assert(ikkje auth.bruk_reautentisering_ved(root, relativ, "session-A", "8", feil_brukar, start_ms + 1))
    la utløpt = auth.utsted_reautentisering_ved(root, relativ, "session-A", "7", start_ms, 1000)
    assert(ikkje auth.bruk_reautentisering_ved(root, relativ, "session-A", "7", utløpt, start_ms + 1001))

    prøv { builtin.fil_slett(full) } fang (e) {}
    skriv("test_auth_persistent_guard_reauth OK")
    returner 0
}
