// BLOB-literalar x'…' (hex → bytes-streng). Golden = sqlite3 3.51.0.
// Merk: string-lagring, so typeof forblir 'text' (dokumentert divergens).
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")
    assert_eq(sql.query_text(db, "SELECT hex(x'414243')"), "414243")
    assert_eq(sql.query_text(db, "SELECT CAST(x'414243' AS TEXT)"), "ABC")
    assert_eq(sql.query_text(db, "SELECT length(x'414243')"), "3")
    assert_eq(sql.query_text(db, "SELECT 'pre-' || CAST(x'4F4B' AS TEXT)"), "pre-OK")
    skriv("test_norsdb_blob OK\n")
    returner 0
}
