# A7/W9: std/synk_kjerne.no gjev same resultat i VM-en og som WebAssembly. Korpusprogrammet
# tests/wasm_korpus/synk_kjerne.no (HLC, samanfletting i fleire rekkjefølgjer, validering,
# JSON, kontrollteikn, ETag) blir køyrt i VM-en mot fasiten, bygt med tools/nc_wasm.no
# (validert) og, når Chrome finst, køyrt i nettlesaren med krav om identisk utskrift.
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon start() -> heltall {
    la r = kh.køyr_korpus("test_synk_kjerne_wasm", "build/wasm/test_synk_korpus", ["synk_kjerne"], [], "48371", {})
    skriv("storleik: synk_kjerne=" + tekst(r["storleik"]["synk_kjerne"]) + " byte\n")
    skriv("test_synk_kjerne_wasm OK\n")
    returner 0
}
