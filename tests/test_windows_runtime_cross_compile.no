bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la res = prosess.køyr(root + "/bin/nc",
        ["run", root + "/tools/windows_runtime_cross_compile_gate.no"],
        root, {"NORSCODE_ROOT": root}, 600000)
    assert(prosess.ok(res))
    assert_inneholder(tekst(res["stdout"]), "Windows x86_64 native ABI compile/link")
    skriv("test_windows_runtime_cross_compile OK")
    returner 0
}
