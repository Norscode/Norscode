bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    // Standardmodus (utan NORSCODE_REQUIRE_WINDOWS_STAGE0_PARITY): berre formsjekken køyrer,
    // så byggjaren skal seie windows_stage0_parity=unverified, aldri true (B4).
    la res = prosess.køyr(root + "/bin/nc",
        ["run", root + "/tools/build_windows_stage0_candidate.no"],
        root, {"NORSCODE_ROOT": root, "NORSCODE_REQUIRE_WINDOWS_STAGE0_PARITY": "0"}, 600000)
    assert(prosess.ok(res))
    la ut = tekst(res["stdout"])
    assert_inneholder(ut, "byte-identisk kandidat A/B")
    assert_inneholder(ut, "windows_stage0_form=true")
    assert_inneholder(ut, "windows_stage0_parity=unverified")
    assert(builtin.index_of(ut, "windows_stage0_parity=true") < 0)
    skriv("test_windows_runtime_cross_compile OK")
    returner 0
}
