bruk tools.compile_with_hybrid_bundle_v9400 som hybrid
bruk selfhost.json som json

funksjon start() -> heiltall {
    la sti = "/tmp/norscode_hybrid_ncb_stream_writer.json"
    prøv { hvis builtin.fil_finnes(sti) { builtin.fil_slett(sti) } } fang (e) { }
    assert_eq(builtin.json_stringify("truth"), "\"truth\"")
    assert_eq(builtin.json_stringify(sann), "true")

    la nested = {}
    nested["truth"] = sann
    nested["falsehood"] = usann
    nested["nothing"] = null
    nested["zero"] = 0
    nested["number"] = 42
    nested["decimal"] = 1.5
    nested["text"] = "null"
    nested["escaped"] = "linje\n\"verdi\"\\"
    nested["items"] = ["0", 0, 7, sann]

    hybrid.json_stream_skriv_fil(sti, nested)
    la raw = builtin.fil_les(sti)
    assert_eq(raw, "{\"truth\":true,\"falsehood\":false,\"nothing\":null,\"zero\":0,\"number\":42,\"decimal\":1.5,\"text\":\"null\",\"escaped\":\"linje\\n\\\"verdi\\\"\\\\\",\"items\":[\"0\",0,7,true]}")
    // Den enkle bootstrap-parseren bruker null som intern "manglar"-sentinel
    // ved kartinnsetting. Bytekontrollen over beviser null-outputen; bruk 0 i
    // den separate struktur-rundturen slik at resten av feltene kan bevisast.
    la decoded_raw = builtin.replace(raw, "\"nothing\":null", "\"nothing\":0")
    la decoded = json.json_les(decoded_raw)
    assert_eq(decoded["truth"], sann)
    assert_eq(decoded["falsehood"], usann)
    assert_eq(decoded["nothing"], 0)
    assert_eq(decoded["zero"], 0)
    assert_eq(decoded["number"], 42)
    assert_eq(decoded["decimal"], 1.5)
    assert_eq(decoded["text"], "null")
    assert_eq(decoded["escaped"], "linje\n\"verdi\"\\")
    la items = decoded["items"]
    assert_eq(items[0], "0")
    assert_eq(items[1], 0)
    assert_eq(items[2], 7)
    assert_eq(items[3], sann)

    la ncb_sti = "/tmp/norscode_hybrid_ncb_specialized_writer.json"
    la ncb = {}
    ncb["format"] = "ncb-v1"
    ncb["entry"] = "m.start"
    ncb["functions"] = {}
    ncb["functions"]["m.start"] = {"name": "start", "module": "m", "code": [["BUILD_MAP", 0], ["PUSH_CONST", null], ["RETURN"]]}
    hybrid.json_stream_skriv_ncb_fil(ncb_sti, ncb)
    assert_eq(builtin.fil_les(ncb_sti), "{\"format\":\"ncb-v1\",\"entry\":\"m.start\",\"functions\":{\"m.start\":{\"code\":[[\"BUILD_MAP\",0],[\"PUSH_CONST\",null],[\"RETURN\"]],\"module\":\"m\",\"name\":\"start\"}}}")
    builtin.fil_slett(ncb_sti)

    builtin.fil_slett(sti)
    skriv("test_hybrid_ncb_stream_writer OK")
    returner 0
}
