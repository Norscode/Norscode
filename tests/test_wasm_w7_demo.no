# W7 (WASM-sporet): den lokale kopien i deltakar-demoen (examples/wasm_deltakarar/) ende til ende
# i headless Chrome, via nettlesar-benken. Chrome-stega er VALFRIE (SKIP utan Chrome;
# NC_CHROME=<sti>).
#
# Alltid: testklienten og produksjonsbygget blir bygde (validerte av CLI-en); begge importerer
# lagrings-vertsfunksjonane, og produksjonslastaren er under taket (produksjonstabellen 2560
# + lagrings-gruppa 1280 byte) og har ingen testkrokar.
# Med Chrome (tests/fixtures/wasm_deltakarar_lager_testklient.no, same profil):
#   steg=1  lista frå tenaren; «Hugs lista på denne eininga» lagrar ho i IndexedDB; ei ny
#           deltakar og ei fjerna blir lagra lokalt (ulagra på tenaren)
#   steg=2  tenaren svarar etter 800 ms: den lokale kopien (med dei ulagra endringane) er vist
#           før svaret, med status; dei ulagra endringane blir ståande når tenaren svarar;
#           lagre; eit nytt trykk på knappen slettar kopien og valet
#   steg=3  ingen kopi og intet val att (databasen er ny når han blir opna); lista kjem frå
#           tenaren
#   Negativ kontroll: steg=2 med ein fersk profil viser ingen lokal kopi, berre standardlista.
#   Produksjon: «/» viser dei 10 frå tenaren og «Lista blir ikkje lagra på eininga.».
# Ingen lasting har «Uncaught».
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon rot() -> tekst { returner "build/wasm/test_w7_demo" }

# Produksjonstabellen (2560) + lagrings-gruppa (1280), som i tests/fixtures/wasm_lastar_sjekk.no.
funksjon tak_demo() -> heltall { returner 2560 + 1280 }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

funksjon tal_av(t: tekst, nål: tekst) -> heltall {
    la n = 0
    la rest = t
    la p = builtin.index_of(rest, nål)
    mens p >= 0 {
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
        p = builtin.index_of(rest, nål)
    }
    returner n
}

funksjon har(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon krev_lagring(linje: tekst, kva: tekst) -> heltall {
    la imp = hjelp.liste_felt(linje, "importar")
    hvis ikkje (har(imp, "lager_start") og har(imp, "lager_svar") og har(imp, "fjern_lokalt") og har(hjelp.liste_felt(linje, "eksportar"), "__lager_ferdig")) {
        skriv(kva + ": manglar lagrings-importane eller __lager_ferdig: " + linje + "\n")
        assert(usann)
    }
    returner 0
}

funksjon krev_lik(namn: tekst, r: ordbok, venta: tekst) -> heltall {
    hvis r["logg"] != venta {
        skriv(namn + ": skil seg frå fasiten, " + kh.skilnad(r["logg"], venta) + "\nFekk:\n" + r["logg"] + "\nFasit:\n" + venta + "\n")
        assert(usann)
    }
    hvis r["uncaught"] {
        skriv(namn + ": «Uncaught» i konsollen:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    returner 0
}

funksjon linjer(l: liste) -> tekst {
    returner builtin.join(l, "\n") + "\n"
}

funksjon rad(namn: tekst, resultat: tekst, status: tekst, ulagra: tekst, hugs: tekst, lokal: tekst, siste: tekst) -> tekst {
    la t = namn + ": " + resultat + " | status=" + status + " | ulagra " + ulagra + " | hugs=" + hugs + " | lokal=" + lokal
    hvis siste != "" { t = t + " | første=Aksel | siste=" + siste }
    returner t
}

funksjon ikkje_lagra() -> tekst { returner "Lista blir ikkje lagra på eininga." }

funksjon fasit_1() -> tekst {
    returner linjer([
        "steg 1",
        rad("lasta", "10 deltakarar", "10 deltakarar.", "skjult", "false", ikkje_lagra(), "Åse"),
        rad("hugsa", "10 deltakarar", "10 deltakarar.", "skjult", "true", "Lista er lagra på eininga (10 deltakarar).", "Åse"),
        rad("endra lokalt", "10 deltakarar", "10 deltakarar.", "synleg", "true", "Lista er lagra på eininga (10 deltakarar).", "Ny Person"),
        "ferdig"
    ])
}

funksjon fasit_2() -> tekst {
    returner linjer([
        "steg 2",
        rad("start", "–", "Hentar deltakarlista …", "skjult", "true", "Les den lokale kopien …", ""),
        rad("lokal før tenaren", "10 deltakarar", "Viser lagra kopi frå eininga (10 deltakarar) – hentar frå tenaren …", "synleg", "true",
            "Lista er lagra på eininga.", "Ny Person"),
        rad("tenaren svara", "10 deltakarar", "Tenaren har 10 deltakarar. Du har ulagra endringar frå førre gong: lagre dei eller hent på nytt.",
            "synleg", "true", "Lista er lagra på eininga.", "Ny Person"),
        rad("lagra", "10 deltakarar", "Lagra 10 deltakarar.", "skjult", "true", "Lista er lagra på eininga (10 deltakarar).", "Ny Person"),
        rad("gløymt", "10 deltakarar", "Lagra 10 deltakarar.", "skjult", "false", "Den lokale kopien er sletta. Lista blir ikkje lagra på eininga.", "Ny Person"),
        "ferdig"
    ])
}

funksjon fasit_2_fersk() -> tekst {
    returner linjer([
        "steg 2",
        rad("start", "–", "Hentar deltakarlista …", "skjult", "false", ikkje_lagra(), ""),
        rad("tenaren svara", "10 deltakarar", "10 deltakarar.", "skjult", "false", ikkje_lagra(), "Åse"),
        "ingen lokal kopi",
        "ferdig"
    ])
}

funksjon fasit_3() -> tekst {
    returner linjer([
        "steg 3",
        rad("lasta", "10 deltakarar", "10 deltakarar.", "skjult", "false", ikkje_lagra(), "Ny Person"),
        "databasen: oppgradert frå 0, 0 rader",
        "ferdig"
    ])
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())
    la l_test = hjelp.bygg_klient_app("tests/fixtures/wasm_deltakarar_lager_testklient.no", rot() + "/testbygg", sann, "tests/fixtures/wasm_deltakarar_testapp.no")
    krev_lagring(l_test, "testklienten")
    la l_prod = hjelp.bygg_klient_app("examples/wasm_deltakarar/klient.no", rot() + "/prod", usann, "examples/wasm_deltakarar/app.no")
    krev_lagring(l_prod, "demoen")
    la lastar = fil_les(hjelp.root() + "/" + rot() + "/prod/nc.js")
    skriv("demo: lastar " + tekst(lengde(lastar)) + " B (tak " + tekst(tak_demo()) + "), modul " + kh.storleik_av(l_prod) + " B\n")
    assert(lengde(lastar) <= tak_demo())
    assert(ikkje inneheld(lastar, "test_"))
    hvis benk.finn_chrome() == "" {
        skriv("test_wasm_w7_demo OK (bygg; SKIP Chrome: fann ikkje Chrome/Chromium, set NC_CHROME=<sti>)\n")
        returner 0
    }
    la økt = benk.ny_økt("test_w7_demo")
    utsett {
        benk.rydd(økt)
    }
    # ── Testbygget, tre lastingar med same profil og ei med fersk ──
    la s = benk.start_serve(økt, hjelp.serve_inngang(rot() + "/testbygg"), "48393")
    hvis s["status"] != "kjorer" { skriv("nc serve starta ikkje:\n" + tekst(s["ut"]) + "\n") }
    assert_eq(s["status"], "kjorer")
    la url = "http://127.0.0.1:48393/test?steg="
    la same = {"profil": "eining", "behald_profil": sann}
    krev_lik("steg 1", benk.last_side(økt, url + "1", same), fasit_1())
    la r2 = benk.last_side(økt, url + "2", same)
    krev_lik("steg 2 (same profil)", r2, fasit_2())
    krev_lik("steg 3 (same profil)", benk.last_side(økt, url + "3", same), fasit_3())
    krev_lik("steg 2 (fersk profil)", benk.last_side(økt, url + "2", {}), fasit_2_fersk())
    skriv("demoen (testbygg): lokal kopi vist før tenarsvaret (steg 2: " + tekst(r2["ms"]) + " ms, tenaren svarar etter 800 ms), sletta med knappen; fersk profil utan kopi\n")
    # ── Produksjonsbygget ──
    benk.start_serve(økt, hjelp.serve_inngang(rot() + "/prod"), "48394")
    la p = benk.last_side(økt, "http://127.0.0.1:48394/", {})
    assert(inneheld(p["dom"], "<output id=\"nc-resultat\">10 deltakarar</output>"))
    assert(inneheld(p["dom"], "aria-pressed=\"false\">Hugs lista på denne eininga</button>"))
    assert(inneheld(p["dom"], "aria-live=\"polite\">Lista blir ikkje lagra på eininga.</span>"))
    assert_eq(tal_av(p["dom"], "<li>"), 10)
    assert(ikkje p["uncaught"])
    benk.stopp_serve(økt)
    skriv("demoen (produksjon): 10 frå tenaren, ingen lokal kopi utan val\n")
    skriv("test_wasm_w7_demo OK\n")
    returner 0
}
