bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/native_media_runtime_gate_v3010.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "prosess.køyr(kandidat, [\"run\", root + \"/\" + testfil]"))
    assert(t.inneholder(src, "root, miljø, 300000"))
    assert(t.inneholder(src, "\"PATH\": \"/nonexistent\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "NORSCODE_CMD="))
    assert(ikkje t.inneholder(src, "sh -c"))
    skriv("test_native_media_runtime_gate_shellfree_contract OK\n")
    returner 0
}
