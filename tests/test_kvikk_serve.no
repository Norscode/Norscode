// App-kjensle del 1: examples/app_kjensle.no (Oppgåvetavle med std/kvikk.no)
// under ekte `nc serve` i ein barneprosess, med NORSCODE_FAKE_HTTP_REQUESTS
// (heile HTTP-vegen i nc_main: parse → vakt → handlar → 304-sjekk →
// response_to_http, utan sokkel). Same mønster som test_app_kjensle_serve.
//
// Barnet blir starta via miljøkontrakten med eksplisitt, ikkje-arva miljø.
//
// Krav, i begge VM-modusar og byte-identisk mellom dei:
//   - HTML: Speculation-Rules peikar på reglane, sterk ETag, éin Cache-Control
//     (no-cache, aldri no-store), CSP og nosniff; If-None-Match (òg W/) gjev 304
//   - reglane: application/speculationrules+json, immutable ved rett ?v=,
//     gyldig JSON med prefetch og prerender (moderate), versjonen stemmer
//   - stilarket: text/css, immutable, @view-transition og prefers-reduced-motion
//   - /oppgaver har 50 rader, /oppgave/{id:int} 200 og 404
//   - POST /ny: 303 med Location ved suksess, 422 med skjema ved feil
//   - Sec-Purpose: prefetch blir ikkje talt som sidevising, og GET /logg-ut
//     (sideeffekt) gjev 403 for spekulativ henting og 303 elles
//   - ingen HTML-svar inneheld <script eller on*=-attributt
// Utdata blir tolka robust mot escapa linjeskift (\n som to teikn, dobbelt på macOS).
bruk std.runtime.process_abi som process_abi
bruk std.http_cache som hc

funksjon crlf() -> tekst { returner "\r\n" }

funksjon førespurnad(sti: tekst, ekstra: liste_tekst) -> tekst {
    la r = "GET " + sti + " HTTP/1.1" + crlf() + "Host: 127.0.0.1" + crlf()
    la i: heiltall = 0
    mens i < lengde(ekstra) {
        r = r + ekstra[i] + crlf()
        i = i + 1
    }
    returner r + crlf()
}

funksjon post_skjema(sti: tekst, kropp: tekst) -> tekst {
    returner "POST " + sti + " HTTP/1.1" + crlf() + "Host: 127.0.0.1" + crlf() +
        "Content-Type: application/x-www-form-urlencoded" + crlf() +
        "Content-Length: " + tekst(lengde(kropp)) + crlf() + crlf() + kropp
}

// NORSCODE_FAKE_HTTP_REQUESTS skil førespurnader med bokstaveleg «\n» (to teikn).
funksjon saman(reqs: liste_tekst) -> tekst {
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(reqs) {
        hvis i > 0 { ut = ut + "\\n" }
        ut = ut + reqs[i]
        i = i + 1
    }
    returner ut
}

funksjon serve_miljø(root: tekst, fast: tekst, reqs: tekst) -> ordbok_tekst {
    returner {
        "PATH": "/usr/bin:/bin",
        "HOME": miljo_hent("HOME"),
        "TMPDIR": "/tmp",
        "NORSCODE_CMD": "serve",
        "NORSCODE_FILE": root + "/examples/app_kjensle.no",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_MODULE": "",
        "NORSCODE_ROOT": root,
        "NC_SERVE_PORT": "48193",
        "NC_SERVE_HOST": "127.0.0.1",
        "NORSCODE_FAKE_HTTP_REQUESTS": reqs,
        "NORSCODE_FAKE_HTTP_REQUEST": "",
        "NORSCODE_VM_FAST": fast,
        "NORSCODE_VM_CI_COMMAND": "",
        "NORSCODE_VM_CI_CHILD_CMD": "",
        "NORSCODE_VM_CI_CHILD_FILE": "",
        "NORSCODE_RUN_DIRECT_HOST": "0",
        "NORSCODE_HOST_NCB_FILE": "",
        "NORSCODE_NCB_FILE": ""
    }
}

// Opphev escaping når prosess-ABI-en har levert linjeskift som «\n» (to teikn),
// eventuelt dobbelt («\\n»). Rå utdata (med ekte linjeskift) blir ikkje rørt.
funksjon normaliser(t: tekst) -> tekst {
    la s = t
    la runde: heiltall = 0
    mens ikkje builtin.contains(s, "\n") og builtin.contains(s, "\\n") og runde < 3 {
        s = tekst_erstatt(s, "\\\\", "\\")
        s = tekst_erstatt(s, "\\r", "\r")
        s = tekst_erstatt(s, "\\n", "\n")
        s = tekst_erstatt(s, "\\\"", "\"")
        s = tekst_erstatt(s, "\\t", "\t")
        runde = runde + 1
    }
    returner s
}

funksjon køyr_serve(runtime: tekst, root: tekst, fast: tekst, reqs: liste_tekst) -> tekst {
    la req = process_abi.request(runtime, [], root, "", 600000, 33554432)
    process_abi.sett_sandbox(req, "none", 4294967296, 1024, usann)
    process_abi.sett_environment(req, serve_miljø(root, fast, saman(reqs)))
    la res = builtin.process_spawn_argv(req)
    la ut = normaliser(tekst(res["stdout"]))
    hvis tekst(res["status"]) != "ferdig" eller heltall_fra_tekst(tekst(res["exit_code"])) != 0 {
        skriv("nc serve (VM_FAST=" + fast + ") feila: status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) + "\n")
        skriv("stdout:\n" + ut + "\nstderr:\n" + tekst(res["stderr"]) + "\n")
        assert(usann)
    }
    returner ut
}

funksjon tal_forekomstar(t: tekst, nål: tekst) -> heiltall {
    la n: heiltall = 0
    la rest = t
    la p = builtin.index_of(rest, nål)
    mens p >= 0 {
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
        p = builtin.index_of(rest, nål)
    }
    returner n
}

// Del utdata i HTTP-svar. Kvart svar: {"status", "body", "h:<namn>" (siste verdi),
// "n:<namn>" (tal på linjer med det headernamnet)}; namn med små bokstavar.
funksjon tolk_svar(ut: tekst) -> liste {
    la svar = []
    la rest = ut
    la p = builtin.index_of(rest, "HTTP/1.1 ")
    mens p >= 0 {
        rest = builtin.slice(rest, p, lengde(rest))
        la skil = "\r\n\r\n"
        la slutt = builtin.index_of(rest, skil)
        hvis slutt < 0 {
            skil = "\n\n"
            slutt = builtin.index_of(rest, skil)
        }
        hvis slutt < 0 {
            skriv("uferdig svar i utdata:\n" + rest + "\n")
            assert(usann)
        }
        la hovud = builtin.slice(rest, 0, slutt)
        la linjer = builtin.split(hovud, "\n")
        la s: ordbok_tekst = {}
        la statuslinje = builtin.trim(linjer[0])
        s["status"] = builtin.slice(statuslinje, 9, 12)
        la i: heiltall = 1
        mens i < lengde(linjer) {
            la l = builtin.trim(linjer[i])
            la k = builtin.index_of(l, ":")
            hvis k > 0 {
                la namn = tekst_til_liten(builtin.trim(builtin.slice(l, 0, k)))
                s["h:" + namn] = builtin.trim(builtin.slice(l, k + 1, lengde(l)))
                la tidlegare: heiltall = 0
                hvis finnes_nøkkel(s, "n:" + namn) { tidlegare = heltall_fra_tekst(s["n:" + namn]) }
                s["n:" + namn] = tekst(tidlegare + 1)
            }
            i = i + 1
        }
        la kropp_start = slutt + lengde(skil)
        la cl: heiltall = 0
        hvis finnes_nøkkel(s, "h:content-length") { cl = heltall_fra_tekst(s["h:content-length"]) }
        s["body"] = builtin.slice(rest, kropp_start, kropp_start + cl)
        legg_til(svar, s)
        rest = builtin.slice(rest, kropp_start + cl, lengde(rest))
        p = builtin.index_of(rest, "HTTP/1.1 ")
    }
    returner svar
}

funksjon hdr(s: ordbok_tekst, namn: tekst) -> tekst {
    hvis finnes_nøkkel(s, "h:" + namn) { returner s["h:" + namn] }
    returner ""
}

funksjon hdr_tal(s: ordbok_tekst, namn: tekst) -> heiltall {
    hvis finnes_nøkkel(s, "n:" + namn) { returner heltall_fra_tekst(s["n:" + namn]) }
    returner 0
}

// Sann når teksten har eit on<bokstavar>=-attributt etter mellomrom, / eller
// linjeskift (onclick=, ONLOAD= …).
funksjon har_on_attributt(html: tekst) -> bool {
    la t = tekst_til_liten(html)
    la i: heiltall = 1
    la n = lengde(t)
    mens i + 2 < n {
        la før = builtin.slice(t, i - 1, i)
        hvis builtin.slice(t, i, i + 2) == "on" og (før == " " eller før == "/" eller før == "\n" eller før == "\t" eller før == "\r") {
            la j = i + 2
            mens j < n og builtin.char_code(builtin.slice(t, j, j + 1)) >= 97 og builtin.char_code(builtin.slice(t, j, j + 1)) <= 122 {
                j = j + 1
            }
            hvis j > i + 2 og j < n og builtin.slice(t, j, j + 1) == "=" { returner sann }
        }
        i = i + 1
    }
    returner usann
}

// Felles krav til kvart HTML-svar frå demoen.
funksjon krev_html(namn: tekst, s: ordbok_tekst) -> heiltall {
    assert_eq(hdr(s, "content-type"), "text/html; charset=utf-8")
    assert_eq(hdr_tal(s, "cache-control"), 1)
    la cc = hdr(s, "cache-control")
    hvis builtin.contains(cc, "no-store") { skriv(namn + ": no-store på HTML blokkerer bfcache\n") }
    assert(ikkje builtin.contains(cc, "no-store"))
    assert(builtin.contains(cc, "no-cache"))
    assert(builtin.starts_with(hdr(s, "speculation-rules"), "\"/_nc/spekulasjon"))
    assert_eq(hdr(s, "x-content-type-options"), "nosniff")
    assert_eq(hdr(s, "content-security-policy"), hc.csp_standard())
    la skript = builtin.contains(tekst_til_liten(s["body"]), "<script")
    la on = har_on_attributt(s["body"])
    hvis skript eller on { skriv(namn + ": klientkode i HTML (<script=" + tekst(skript) + ", on*=" + tekst(on) + ")\n") }
    assert(ikkje skript)
    assert(ikkje on)
    returner 0
}

// Tek ut stien i Speculation-Rules: "\"/_nc/…?v=…\"" → /_nc/…?v=…
funksjon regler_sti(s: ordbok_tekst) -> tekst {
    la v = hdr(s, "speculation-rules")
    assert(builtin.starts_with(v, "\"") og builtin.ends_with(v, "\""))
    returner builtin.slice(v, 1, lengde(v) - 1)
}

funksjon stil_sti(html: tekst) -> tekst {
    la p = builtin.index_of(html, "/_nc/stil.css?v=")
    assert(p >= 0)
    la rest = builtin.slice(html, p, lengde(html))
    returner builtin.slice(rest, 0, builtin.index_of(rest, "\""))
}

funksjon sjekk_sekvens(modus: tekst, ut: tekst, etag: tekst, regler: tekst, stil: tekst) -> heiltall {
    la svar = tolk_svar(ut)
    hvis lengde(svar) != 16 {
        skriv("VM_FAST=" + modus + ": venta 16 svar, fekk " + tekst(lengde(svar)) + ":\n" + ut + "\n")
    }
    assert_eq(lengde(svar), 16)

    // 0: GET /
    la heim = svar[0]
    assert_eq(heim["status"], "200")
    krev_html("/", heim)
    assert_eq(hdr(heim, "cache-control"), "no-cache")
    assert_eq(hdr(heim, "etag"), etag)
    assert_eq(hdr(heim, "etag"), hc.etag_av(heim["body"]))
    assert_eq(regler_sti(heim), regler)
    assert(builtin.contains(heim["body"], "<main id=\"app-main\""))
    assert(builtin.contains(heim["body"], "href=\"" + stil + "\""))

    // 1: reglane
    la r = svar[1]
    assert_eq(r["status"], "200")
    assert_eq(hdr(r, "content-type"), "application/speculationrules+json")
    assert_eq(hdr(r, "cache-control"), "public, max-age=31536000, immutable")
    assert_eq(hdr_tal(r, "cache-control"), 1)
    assert_eq("/_nc/spekulasjon.json?v=" + hc.versjon_av(r["body"]), regler)
    la j = builtin.json_parse_raw(r["body"])
    assert_eq(builtin.type(j), "ordbok")
    assert_eq(tekst(j["prefetch"][0]["eagerness"]), "moderate")
    assert_eq(tekst(j["prerender"][0]["eagerness"]), "moderate")
    assert_eq(tekst(j["prefetch"][0]["source"]), "document")
    assert(builtin.contains(r["body"], "{\"pathname\":\"/_*\"}"))
    assert(builtin.contains(r["body"], "[data-nc-prefetch='false']"))
    assert(builtin.contains(r["body"], "[rel~='nofollow']"))

    // 2: stilarket
    la c = svar[2]
    assert_eq(c["status"], "200")
    assert_eq(hdr(c, "content-type"), "text/css; charset=utf-8")
    assert_eq(hdr(c, "cache-control"), "public, max-age=31536000, immutable")
    assert_eq("/_nc/stil.css?v=" + hc.versjon_av(c["body"]), stil)
    assert(builtin.contains(c["body"], "@view-transition { navigation: auto; }"))
    assert(builtin.contains(c["body"], "prefers-reduced-motion: reduce"))

    // 3: /oppgaver med 50 rader
    assert_eq(svar[3]["status"], "200")
    krev_html("/oppgaver", svar[3])
    assert_eq(tal_forekomstar(svar[3]["body"], "<tr class=\"status-"), 50)
    assert_eq(tal_forekomstar(svar[3]["body"], "<a href=\"/oppgave/"), 50)

    // 4–5: /oppgave/7 og /oppgave/99
    assert_eq(svar[4]["status"], "200")
    krev_html("/oppgave/7", svar[4])
    assert(builtin.contains(svar[4]["body"], "href=\"/oppgave/8\""))
    assert_eq(svar[5]["status"], "404")
    krev_html("/oppgave/99", svar[5])
    assert_eq(hdr(svar[5], "etag"), "")

    // 6–7: If-None-Match (sterk og W/) → 304 utan kropp
    assert_eq(svar[6]["status"], "304")
    assert_eq(svar[6]["body"], "")
    assert_eq(hdr(svar[6], "etag"), etag)
    assert_eq(svar[7]["status"], "304")
    assert_eq(svar[7]["body"], "")

    // 8–9: /om med og utan Sec-Purpose; berre den vanlege blir talt
    assert_eq(svar[8]["status"], "200")
    assert_eq(svar[9]["status"], "200")
    krev_html("/om", svar[9])
    assert_eq(svar[8]["body"], svar[9]["body"])
    assert_eq(tal_forekomstar(ut, "sidevising /om"), 1)
    // GET / tre gonger (200 og to 304): ein person navigerte kvar gong.
    assert_eq(tal_forekomstar(ut, "sidevising /\n"), 3)

    // 10: skjemaet
    assert_eq(svar[10]["status"], "200")
    krev_html("/ny", svar[10])
    assert(builtin.contains(svar[10]["body"], "<form method=\"post\" action=\"/ny\">"))

    // 11: gyldig POST → 303 See Other
    assert_eq(svar[11]["status"], "303")
    assert_eq(hdr(svar[11], "location"), "/oppgaver?lagt_til=1")
    // 12: ugyldig POST → 422 med skjema og feilmeldingar
    assert_eq(svar[12]["status"], "422")
    krev_html("POST /ny 422", svar[12])
    assert(builtin.contains(svar[12]["body"], "Tittel manglar."))
    assert(builtin.contains(svar[12]["body"], "Vel prioritet"))
    assert(builtin.contains(svar[12]["body"], "value=\"\"></p>"))
    assert(builtin.contains(svar[12]["body"], "<option value=\"middels\" selected>"))

    // 13–14: /logg-ut: spekulativ → 403 (vakta), vanleg → 303
    assert_eq(svar[13]["status"], "403")
    assert_eq(svar[14]["status"], "303")
    assert_eq(hdr(svar[14], "location"), "/")
    assert_eq(tal_forekomstar(ut, "utlogging"), 1)

    // 15: ukjend ressurs under /_nc/
    assert_eq(svar[15]["status"], "404")
    returner 0
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la runtime = tekst(info["executable"])
    la root = tekst(info["cwd"])

    // Fase 1: ETag, regel-URL og stilark-URL frå GET /.
    la ut0 = køyr_serve(runtime, root, "1", [førespurnad("/", [])])
    la første = tolk_svar(ut0)
    assert_eq(lengde(første), 1)
    la etag = hdr(første[0], "etag")
    assert_eq(lengde(etag), 34)
    la regler = regler_sti(første[0])
    assert(builtin.starts_with(regler, "/_nc/spekulasjon.json?v="))
    la stil = stil_sti(første[0]["body"])

    la reqs: liste_tekst = [
        førespurnad("/", []),
        førespurnad(regler, []),
        førespurnad(stil, []),
        førespurnad("/oppgaver", []),
        førespurnad("/oppgave/7", []),
        førespurnad("/oppgave/99", []),
        førespurnad("/", ["If-None-Match: " + etag]),
        førespurnad("/", ["If-None-Match: W/" + etag]),
        førespurnad("/om", ["Sec-Purpose: prefetch"]),
        førespurnad("/om", []),
        førespurnad("/ny", []),
        post_skjema("/ny", "tittel=Kj%C3%B8p+mj%C3%B8lk&prioritet=h%C3%B8g"),
        post_skjema("/ny", "tittel=&prioritet=snart"),
        førespurnad("/logg-ut", ["Sec-Purpose: prefetch;prerender"]),
        førespurnad("/logg-ut", []),
        førespurnad("/_nc/ukjend.js", [])
    ]
    la ut_std = køyr_serve(runtime, root, "0", reqs)
    sjekk_sekvens("0", ut_std, etag, regler, stil)
    la ut_fast = køyr_serve(runtime, root, "1", reqs)
    sjekk_sekvens("1", ut_fast, etag, regler, stil)
    hvis ut_std != ut_fast {
        la i: heiltall = 0
        mens i < lengde(ut_std) og i < lengde(ut_fast) og builtin.slice(ut_std, i, i + 1) == builtin.slice(ut_fast, i, i + 1) {
            i = i + 1
        }
        skriv("VM_FAST=0 og VM_FAST=1 gav ulike svar frå byte " + tekst(i) + "\n")
    }
    assert(ut_std == ut_fast)
    skriv("test_kvikk_serve OK\n")
    returner 0
}
