bruk std.shutil som shu
bruk std.bytes som bytes
bruk std.runtime_filesystem som fs

funksjon krev_innhald(sti: tekst) -> heiltall {
    assert(builtin.fil_les(sti + "/hello.txt") == "norscode tar")
    la rå = bytes.til_liste(builtin.fil_les_binær(sti + "/sub/data.bin"))
    assert(lengde(rå) == 5)
    assert(rå[0] == 0 og rå[1] == 255 og rå[2] == 17 og rå[4] == 128)
    returner 0
}

funksjon start() -> heiltall {
    la rot = ".norscode/test-shutil-archive-" + builtin.random_hex(8)
    assert(shu.makedirs(rot + "/src/sub"))
    builtin.fil_skriv(rot + "/src/hello.txt", "norscode tar")
    builtin.fil_skriv_binær(rot + "/src/sub/data.bin", bytes.fra_liste([0, 255, 17, 64, 128]))

    la format = shu.get_archive_formats()
    assert(lengde(format) == 2 og format[0] == "tar" og format[1] == "gztar")

    la tar_sti = shu.make_archive(rot + "/standard", "tar", rot + "/src")
    assert(tar_sti == rot + "/standard.tar")
    assert(shu.unpack_archive(tar_sti, rot + "/ut-tar"))
    krev_innhald(rot + "/ut-tar")

    la gztar_sti = shu.make_archive(rot + "/standard-gz", "gztar", rot + "/src")
    assert(gztar_sti == rot + "/standard-gz.tar.gz")
    assert(shu.unpack_archive(gztar_sti, rot + "/ut-gztar"))
    krev_innhald(rot + "/ut-gztar")

    la modusar: ordbok_tekst = {"hello.txt": "493"}
    la modus_sti = shu.make_archive_med_modus(rot + "/standard-mode", "gztar", rot + "/src", modusar)
    assert(modus_sti == rot + "/standard-mode.tar.gz")
    assert(shu.unpack_archive(modus_sti, rot + "/ut-mode"))
    la mode = fs.native_stat_sti(rot + "/ut-mode/hello.txt")
    assert(mode["status"] == "ok")
    assert((heltall_fra_tekst(tekst(mode["mode"])) & 511) == 493)

    assert(shu.make_archive(rot + "/ikkje-støtta", "zip", rot + "/src") == "")
    assert(ikkje shu.unpack_archive(rot + "/ikkje-støtta.zip", rot + "/ut-zip"))
    assert(shu.rmtree(rot))
    skriv("test_shutil_archive_default OK")
    returner 0
}
