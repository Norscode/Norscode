# F46: frosne samlingar (frys / er_frosen / tin, FrosenFeil). Programmet ligg i
# tests/fixtures/rb_frosne.no (kjelde-kjeda: kompilator -> NCB -> selfhost/vm.no).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heiltall {
    la d = builtin.split(køyr(fil_les("tests/fixtures/rb_frosne.no")), "|")
    assert_eq(lengde(d), 10)
    # lesing, iterasjon, lengde, indeks
    assert_eq(d[0], "3/1/6/sann/3")
    # skriving til frosen liste kastar FrosenFeil (indeks, legg_til, pop_siste, sett_inn); lista er uendra
    assert_eq(d[1], "FrosenFeil,FrosenFeil,FrosenFeil,FrosenFeil,31")
    # ordbok: nøkkel, ny nøkkel, djup (liste i ordbok, ordbok i ordbok)
    assert_eq(d[2], "FrosenFeil,FrosenFeil,FrosenFeil,FrosenFeil,1253")
    # struktur: feltsetting, mutasjon i metode, lesing og metodekall
    assert_eq(d[3], "FrosenFeil,FrosenFeil,123sann")
    # frys er ei djup kopi; originalen er framleis mutabel
    assert_eq(d[4], "12usannsannsann")
    # tin gjev ei mutabel djup kopi, den frosne er uendra
    assert_eq(d[5], "372usannusann")
    # likskap mot vanlege lister, skalarar er alltid «frosne»
    assert_eq(d[6], "sannsannsannusannsannsann6")
    # FrosenFeil høyrer til Unntak; typa fang
    assert_eq(d[7], "ufaFrosenFeil: kan ikkje endre ei frosen samling (builtin.legg_til)")
    # frosent element i mutabel liste
    assert_eq(d[8], "2sannusann6FrosenFeil")
    # for over frosen ordbok/liste, type()
    assert_eq(d[9], "k10listeordbok")
    returner 0
}
