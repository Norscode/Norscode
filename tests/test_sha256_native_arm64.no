// Native ARM64-codegen SHA-256-verifisering (builtin.sha256_bytes, FIPS 180-4).
// Byggd til ELF via codegen; køyrt nativt på arm-runnar. 42 = alle vektorar rette.
funksjon start() -> heiltall {
    hvis builtin.sha256_bytes([]) != "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" { returner 1 }
    hvis builtin.sha256_bytes([97, 98, 99]) != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" { returner 2 }
    hvis builtin.sha256_bytes([97, 98, 99, 100, 98, 99, 100, 101, 99, 100, 101, 102, 100, 101, 102, 103, 101, 102, 103, 104, 102, 103, 104, 105, 103, 104, 105, 106, 104, 105, 106, 107, 105, 106, 107, 108, 106, 107, 108, 109, 107, 108, 109, 110, 108, 109, 110, 111, 109, 110, 111, 112, 110, 111, 112, 113]) != "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1" { returner 3 }
    returner 42
}
