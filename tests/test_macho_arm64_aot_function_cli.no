// Ende-til-ende AOT av eit Norscode-funksjonskall med argument og retur.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    hvis tekst(info["system"]) != "Darwin" eller tekst(info["machine"]) != "arm64" { returner 0 }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la id = builtin.random_hex(8)
    la ncb = "/tmp/norscode_macho_aot_call_" + id + ".ncb.json"
    la binær = "/tmp/norscode_macho_aot_call_" + id
    la kjelde = root + "/tests/fixtures/macos_aot_function_call.no"
    la nc = runtime(root)
    la miljø = {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }

    krev_exit(prosess.køyr(nc, ["compile", kjelde, ncb], root, miljø, 180000), 0)
    krev_exit(prosess.køyr(nc, ["bygg-native", "--target", "macos-arm64", "--ncb", ncb, binær], root, miljø, 180000), 0)
    krev_exit(prosess.køyr(binær, [], root, {}, 30000), 12)
    filops.slett_fil(ncb)
    filops.slett_fil(binær)
    returner 0
}
