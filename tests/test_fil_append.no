// test_fil_append.no — std.fil: append utan å lese fila, finnes utan å lese
// fila, og skrivefeil som blir melde.
bruk std.fil som fil
bruk std.env som env
bruk std.path som path

funksjon tmpsti(navn: tekst) -> tekst {
    hvis env.finnes("TMPDIR") { returner path.join(env.hent("TMPDIR"), navn) }
    hvis env.finnes("TEMP") { returner path.join(env.hent("TEMP"), navn) }
    hvis env.finnes("TMP") { returner path.join(env.hent("TMP"), navn) }
    returner path.join(".", navn)
}

funksjon start() -> heltall {
    la sti = tmpsti("norscode_fil_append_test.txt")
    la manglar = tmpsti("norscode_fil_append_mappe_finst_ikkje/x.txt")

    // append lagar fila og returnerer talet på byte som vart lagt til
    fil.skriv_fil(sti, "")
    assert_eq(fil.append(sti, "abc"), 3)
    assert_eq(fil.append(sti, "de"), 2)
    assert_eq(fil.les(sti), "abcde")

    // mange tillegg: innhaldet er rett (gamle append var kvadratisk her)
    fil.skriv_fil(sti, "")
    la i: heiltall = 0
    mens i < 2000 {
        fil.append(sti, "linje " + tekst(i) + "\n")
        i = i + 1
    }
    la innhald = fil.les(sti)
    assert(builtin.contains(innhald, "linje 0\n"))
    assert(builtin.contains(innhald, "linje 1999\n"))
    assert_eq(lengde(builtin.split(innhald, "\n")), 2001)

    // skrivefeil blir melde: append gir 0, kontrollert skriving kastar
    assert_eq(fil.append(manglar, "z"), 0)
    assert(ikkje fil.finnes(manglar))
    assert_eq(fil.skriv_fil(manglar, "z"), 0)
    la kasta = usann
    prøv { fil.skriv_fil_kontrollert(manglar, "z") } fang (e) {
        kasta = builtin.contains(tekst(e), "IOFeil")
    }
    assert(kasta)
    assert_eq(fil.skriv_fil_kontrollert(sti, "ok"), 2)
    assert_eq(fil.les(sti), "ok")

    // finnes: same svar som før
    assert(fil.finnes(sti))
    assert(ikkje fil.finnes(tmpsti("norscode_fil_append_finst_ikkje.txt")))
    assert(ikkje fil.finnes(""))

    fil.slett_fil(sti)
    skriv("test_fil_append OK\n")
    returner 0
}
