bruk std.chacha20_poly1305 som aead
bruk std.bytes som bytes

funksjon hex_bytes(hex: tekst) {
    la out: liste_heiltall = []
    la digits = "0123456789abcdef"
    la i = 0
    mens i < lengde(hex) {
        la a = builtin.index_of(digits, builtin.lower(builtin.slice(hex, i, i + 1)))
        la b = builtin.index_of(digits, builtin.lower(builtin.slice(hex, i + 1, i + 2)))
        hvis a < 0 eller b < 0 { kast "ugyldig hex" }
        legg_til(out, a * 16 + b)
        i = i + 2
    }
    returner bytes.fra_liste(out)
}

funksjon hex(buffer) -> tekst {
    la digits = "0123456789abcdef"
    la data = bytes.til_liste(buffer)
    la out = ""
    la i = 0
    mens i < lengde(data) {
        out = out + builtin.slice(digits, data[i] / 16, data[i] / 16 + 1)
        out = out + builtin.slice(digits, data[i] & 15, (data[i] & 15) + 1)
        i = i + 1
    }
    returner out
}

funksjon start() -> heiltall {
    la key = hex_bytes("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    la nonce = hex_bytes("070000004041424344454647")
    la aad = hex_bytes("50515253c0c1c2c3c4c5c6c7")
    la plaintext = hex_bytes("4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e")
    la expected_cipher = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116"
    la encrypted = aead.krypter(key, nonce, plaintext, aad)
    assert(hex(encrypted["ciphertext"]) == expected_cipher)
    assert(hex(encrypted["tag"]) == "1ae10b594f09e26a7e902ecbd0600691")
    la opened = aead.dekrypter(key, nonce, encrypted["ciphertext"], aad, encrypted["tag"])
    assert(opened["status"] == "ok")
    assert(hex(opened["plaintext"]) == hex(plaintext))
    la bad = bytes.til_liste(encrypted["tag"])
    bad[0] = bad[0] ^ 1
    assert(aead.dekrypter(key, nonce, encrypted["ciphertext"], aad, bytes.fra_liste(bad))["status"] == "feil")
    skriv("test_chacha20_poly1305_rfc8439 OK")
    returner 0
}
