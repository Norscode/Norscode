# W0 (WASM-sporet): NCB → WasmGC-lowring og strukturell validator.
#
#   1. Validatoren godtek fasitmodulane frå W0-proben (WasmGC-typar og exnref-unnatak,
#      validerte i Chromium) og ein handbygd modul med import, kall, lokal og blokk.
#   2. Validatoren AVVISER den same modulen med éin feil om gongen (importtype utanfor,
#      kall utanfor, lokal utanfor, greinedjupn utanfor, manglande end, feil
#      seksjonsrekkjefølgje, feil magic, avkorta fil, eksport utanfor). Kvar negativ
#      har ein positiv kontroll, så porten diskriminerer.
#   3. Korpuset (tests/wasm_korpus/*.no og examples/wasm_teljar/klient.no) blir kompilert
#      med `nc compile` og bygd med tools/nc_wasm.no i barneprosessar, som validerer
#      modulen (std/wasm_les.no) og rapporterer importane og eksportane validatoren fann.
#      minimal.no er byte-eksakt mot ein fasit (og har ingen rt-funksjonar, sjølv om CLI-en
#      lenkar inn std/wasm_rt.no, W3). Lowring og validering skjer berre i barneprosessane
#      (W3: i standard-VM-en tok dei over eitt minutt i testprosessen).
#   4. feil_ustotta.no gjev kompileringsfeil med ALLE funna (fail-closed) frå CLI-en
#      (exit 1, ingen app.wasm); test_klikk blir berre godteken i testbygg.
#   5. Versjonen er sha256 over bytane: éin endra byte gjev ny versjon.
bruk std.wasm_binary som w
bruk std.wasm_lowring som lowring
bruk std.wasm_les som les
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon la_til(m: liste, k: liste) -> heltall {
    la i = 0
    mens i < lengde(k) {
        legg_til(m, k[i])
        i = i + 1
    }
    returner 0
}

# Handbygd modul: type 0 = (i32) -> i32, import nc.f (type imp_type), funksjon g (type 0)
# eksportert som «g» (indeks eksp): block { local.get 0; call kall; local.set lokal; br djup }
# local.get 1. Med standardverdiane (0, 0, 1, 0, 1, sann) er modulen gyldig.
funksjon testmodul(imp_type: heltall, kall: heltall, lokal: heltall, djup: heltall,
                   eksp: heltall, med_end: bool) -> liste {
    la m = [0, 97, 115, 109, 1, 0, 0, 0]
    la_til(m, w.seksjon(1, [1, 96, 1, 127, 1, 127]))
    la_til(m, w.seksjon(2, [1, 2, 110, 99, 1, 102, 0, imp_type]))
    la_til(m, w.seksjon(3, [1, 0]))
    la_til(m, w.seksjon(7, [1, 1, 103, 0, eksp]))
    la kropp = [1, 1, 127, 2, 64, 32, 0, 16, kall, 33, lokal, 12, djup, 11, 32, 1]
    hvis med_end { legg_til(kropp, 11) }
    la kode = [1]
    la_til(kode, w.leb_u(lengde(kropp)))
    la_til(kode, kropp)
    la_til(m, w.seksjon(10, kode))
    returner m
}

funksjon krev_avvist(namn: tekst, bytar: liste, forventa: tekst) -> heltall {
    la r = les.valider(bytar)
    hvis r["ok"] {
        skriv("validatoren godtok " + namn + " (skulle avvise)\n")
        assert(usann)
    }
    hvis builtin.index_of(r["feil"], forventa) < 0 {
        skriv(namn + ": venta feil med «" + forventa + "», fekk: " + r["feil"] + "\n")
        assert(usann)
    }
    returner 0
}

funksjon krev_godteken(namn: tekst, bytar: liste) -> ordbok {
    la r = les.valider(bytar)
    hvis ikkje r["ok"] {
        skriv("validatoren avviste " + namn + ": " + r["feil"] + "\n")
        assert(usann)
    }
    returner r["info"]
}

funksjon like_lister(a: liste, b: liste) -> bool {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) {
        hvis tekst(a[i]) != tekst(b[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

# Bygg med CLI-en (tools/nc_wasm.no i ein barneprosess, VM-fastmodus). CLI-en validerer
# modulen med std/wasm_les.no før han skriv app.wasm (exit 1 elles), og importane og
# eksportane i utdatalinja er dei validatoren las ut av bytane. W1-modulane er fleire KB,
# og validatoren i standard-VM-en brukar sekund per KB, så han køyrer ikkje på nytt her.
# Gjev utdatalinja.
funksjon krev_bygd(kjelde: tekst, namn: tekst, importar: liste, eksportar: liste) -> tekst {
    la ut = "build/wasm/test_w0/" + namn
    la linje = hjelp.bygg_klient(kjelde, ut, usann)
    la imp = hjelp.liste_felt(linje, "importar")
    la eksp = hjelp.liste_felt(linje, "eksportar")
    hvis ikkje like_lister(imp, importar) {
        skriv(namn + ": importar " + builtin.join(imp, ",") + ", venta " + builtin.join(importar, ",") + "\n")
        assert(usann)
    }
    hvis ikkje like_lister(eksp, eksportar) {
        skriv(namn + ": eksportar " + builtin.join(eksp, ",") + ", venta " + builtin.join(eksportar, ",") + "\n")
        assert(usann)
    }
    returner linje
}

funksjon inneheld(t: tekst, nål: tekst) -> bool {
    returner builtin.index_of(t, nål) >= 0
}

# tools/nc_wasm.no på feil_ustotta-NCB-en (barneprosess i VM-fastmodus).
funksjon feil_cli(testbygg: bool) -> ordbok {
    la m = hjelp.grunnmiljø(hjelp.root())
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = hjelp.root() + "/tools/nc_wasm.no"
    m["NORSCODE_VM_FAST"] = "1"
    m["NC_WASM_NCB"] = "build/wasm/test_w0/feil_cli/klient.ncb.json"
    m["NC_WASM_UT"] = "build/wasm/test_w0/feil_cli"
    hvis testbygg { m["NC_WASM_TESTBYGG"] = "1" } ellers { m["NC_WASM_TESTBYGG"] = "" }
    returner hjelp.køyr_nc(m, 300000)
}

funksjon start() -> heltall {
    hjelp.mkdir("build/wasm/test_w0")

    # ── 1. Fasitmodular frå proben (WasmGC og exnref) ──
    la gc = les.frå_hex("0061736d010000000110045f017e015e78016000017e6000017f030403020303071d030767635f626f6b7300000369333100010974656b73745f6c656e00020a23030e004229fb0000fb02000042017c0b08004179fb1cfb1d0b09004105fb0701fb0f0b")
    la gi = krev_godteken("GC-fasit", gc)
    assert_eq(lengde(gi["typar"]), 4)
    assert_eq(gi["typar"][0]["art"], "struct")
    assert_eq(gi["typar"][1]["art"], "array")
    assert_eq(gi["typar"][2]["art"], "func")
    assert(like_lister(gi["eksportar"], ["gc_boks", "i31", "tekst_len"]))
    la eh = les.frå_hex("0061736d01000000010a0260017f0060017f017f030201010d030100000708010470726f7600000a19011700027f1f4001000000200008000b417f0f0b41e4006a0b")
    la ei = krev_godteken("EH-fasit", eh)
    assert_eq(ei["n_tag"], 1)

    # ── 2. Handbygd modul: positiv kontroll og éin feil om gongen ──
    krev_godteken("testmodul", testmodul(0, 0, 1, 0, 1, sann))
    krev_avvist("importtype utanfor", testmodul(5, 0, 1, 0, 1, sann), "typeindeks 5 utanfor")
    krev_avvist("kall utanfor", testmodul(0, 2, 1, 0, 1, sann), "call 2 utanfor")
    krev_avvist("lokal utanfor", testmodul(0, 0, 2, 0, 1, sann), "lokal 2 utanfor")
    krev_avvist("greinedjupn utanfor", testmodul(0, 0, 1, 2, 1, sann), "greinedjupn 2 utanfor")
    krev_avvist("eksport utanfor", testmodul(0, 0, 1, 0, 2, sann), "funksjon 2 utanfor")
    krev_avvist("manglande end", testmodul(0, 0, 1, 0, 1, usann), "manglar avsluttande end")
    la feil_magic = testmodul(0, 0, 1, 0, 1, sann)
    feil_magic[1] = 98
    krev_avvist("feil magic", feil_magic, "feil magic")
    la avkorta = testmodul(0, 0, 1, 0, 1, sann)
    la kort = []
    la ki = 0
    mens ki < lengde(avkorta) - 3 {
        legg_til(kort, avkorta[ki])
        ki = ki + 1
    }
    krev_avvist("avkorta", kort, "forbi slutten")
    # Funksjonsseksjonen (3) før importseksjonen (2)
    la byta = [0, 97, 115, 109, 1, 0, 0, 0]
    la_til(byta, w.seksjon(1, [1, 96, 1, 127, 1, 127]))
    la_til(byta, w.seksjon(3, [1, 0]))
    la_til(byta, w.seksjon(2, [1, 2, 110, 99, 1, 102, 0, 0]))
    krev_avvist("seksjonsrekkjefølgje", byta, "feil rekkjefølgje")

    # ── 3. Korpus ──
    # Alle modulane blir lowra og validerte av CLI-en i barneprosessar (VM-fastmodus). I
    # standard-VM-en kostar lowringa og typesjekken fleire sekund per KB, så testprosessen
    # berre les resultatet: minimal.no er byte-eksakt mot fasiten.
    la fasit = ""
    la fasit_bytar = les.frå_hex(fasit)
    la min_linje = krev_bygd("tests/wasm_korpus/minimal.no", "minimal_cli", [], ["i"])
    la minimal = hjelp.les_bytar("build/wasm/test_w0/minimal_cli/app.wasm")
    hvis ikkje like_lister(minimal, fasit_bytar) {
        skriv("minimal.no er ikkje byte-eksakt mot fasiten:\n" + les.til_hex(minimal) + "\n")
        assert(usann)
    }
    assert(like_lister(hjelp.liste_felt(min_linje, "rt"), []))
    assert_eq(hjelp.felt(min_linje, "v"), lowring.versjon(minimal))
    krev_bygd("tests/wasm_korpus/aritm.no", "aritm", ["finn", "sett_tekst", "logg"], ["m", "i"])
    krev_bygd("tests/wasm_korpus/kontroll.no", "kontroll", ["finn", "sett_tekst", "logg"], ["m", "i"])
    krev_bygd("examples/wasm_teljar/klient.no", "teljar", ["finn", "sett_tekst", "sett_html", "lytt_klikk"], ["m", "i", "k0"])

    # ── 4. Fail-closed: alle funna i éin rapport ──
    # W2: unnatak er støtta, men bryt ut av ei prøv-blokk og utsett i ei lykkje gjev ulik
    # unnatakstilstand der vegane møtest og blir avviste (fail-closed). CLI-en: exit 1,
    # rapporten listar alle åtte, og ingen app.wasm blir skriven.
    hjelp.mkdir("build/wasm/test_w0/feil_cli")
    hvis builtin.fil_finnes(hjelp.root() + "/build/wasm/test_w0/feil_cli/app.wasm") { builtin.fil_slett(hjelp.root() + "/build/wasm/test_w0/feil_cli/app.wasm") }
    hjelp.kompiler_ncb("tests/wasm_korpus/feil_ustotta.no", "build/wasm/test_w0/feil_cli/klient.ncb.json")
    la r = feil_cli(usann)
    assert(r["exit"] != 0)
    la o = r["stdout"]
    assert(inneheld(o, "WASM-kompilering feila (8 feil)"))
    assert(inneheld(o, "funksjon __main__.bryt_i_prøv: ulik unntakstilstand"))
    assert(inneheld(o, "funksjon __main__.utsett_i_lykkje: ulik unntakstilstand"))
    assert(inneheld(o, "ustøtta builtin: område"))
    assert(inneheld(o, "ustøtta builtin: lengde_ukjend"))
    assert(inneheld(o, "ustøtta builtin: ukjend\n"))
    assert(inneheld(o, "argument 2 til sett_html må vere ein tekstkonstant i kjelda"))
    assert(inneheld(o, "test_klikk finst berre i testbygg"))
    assert(inneheld(o, "finn ikkje funksjonen finst_ikkje"))
    assert(ikkje builtin.fil_finnes(hjelp.root() + "/build/wasm/test_w0/feil_cli/app.wasm"))
    # Testbygg: test_klikk er lov, resten feilar framleis.
    la rt = feil_cli(sann)
    assert(rt["exit"] != 0)
    assert(inneheld(rt["stdout"], "WASM-kompilering feila (7 feil)"))
    assert(ikkje inneheld(rt["stdout"], "test_klikk"))
    assert(inneheld(rt["stdout"], "ustøtta builtin: område"))

    # ── 5. Versjon over bytane ──
    la v = lowring.versjon(minimal)
    assert_eq(lengde(v), 12)
    assert_eq(v, builtin.slice(builtin.sha256_bytes(minimal), 0, 12))
    la kopi = []
    la i = 0
    mens i < lengde(minimal) {
        legg_til(kopi, minimal[i])
        i = i + 1
    }
    assert_eq(lowring.versjon(kopi), v)
    kopi[lengde(kopi) - 2] = (kopi[lengde(kopi) - 2] + 1) & 255
    assert(lowring.versjon(kopi) != v)

    skriv("test_wasm_w0 OK\n")
    returner 0
}
