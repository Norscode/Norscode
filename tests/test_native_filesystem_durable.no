// Ekte write/flush/rename/delete gjennom den kjeldebygde filesystem-ABI-en.
// Dette beviser OS-barrierar og filidentitet, ikkje eit fysisk straumbrot.
bruk std.runtime_filesystem som fs
bruk std.filops som filops

funksjon start() -> heiltall {
    skriv("[filesystem] opprett testkatalog\n")
    la dir = "build/filesystem-durable-" + builtin.random_hex(8)
    builtin.mkdir_p(dir)
    la sti = dir + "/wal"
    la data = ""
    la i = 0
    mens i < 600 { data = data + "Å-test" + builtin.chr(0) + "\n" i = i + 1 }
    skriv("[filesystem] varig skrive/lese\n")
    assert_eq(fs.native_skriv_varig(sti, data, usann)["value"], lengde(data))
    assert_eq(builtin.fil_les(sti), data)
    // Native stat gjev NcVal-heiltal. Metadatafasaden må normalisere dei
    // før tekst-til-tal-konvertering; elles segfaulta NorsDB etter WAL-write.
    skriv("[filesystem] filmetadata\n")
    assert_eq(filops.fil_storleik(sti), lengde(data))
    assert_eq(fs.native_skriv_varig(sti, "slutt", sann)["status"], "ok")
    assert_eq(builtin.fil_les(sti), data + "slutt")
    assert_eq(fs.native_skriv_varig(dir + "/ny", "ny checkpoint", usann)["status"], "ok")
    skriv("[filesystem] varig rename\n")
    assert_eq(fs.native_erstatt_fil_varig(dir, "ny", "wal")["status"], "replaced")
    assert_eq(builtin.fil_les(sti), "ny checkpoint")
    assert(ikkje builtin.fil_finnes(dir + "/ny"))
    skriv("[filesystem] feilbaner og sletting\n")
    assert_eq(fs.native_erstatt_fil_varig(dir, "manglar", "wal")["status"], "feil")
    assert(ikkje builtin.fil_finnes(dir + "/manglar"))
    assert_eq(builtin.fil_les(sti), "ny checkpoint")
    assert_eq(fs.native_erstatt_fil_varig(dir, "wal", "../utanfor")["status"], "feil")
    assert_eq(fs.native_skriv_varig(dir + "/../utanfor", "nei", usann)["status"], "feil")
    assert_eq(fs.native_skriv_varig(dir, "ikkje katalog", usann)["status"], "feil")
    assert_eq(fs.native_skriv_varig(dir + "/manglar/fil", "nei", usann)["status"], "feil")
    assert_eq(fs.native_slett_varig(sti)["status"], "deleted")
    assert(ikkje builtin.fil_finnes(sti))
    assert_eq(fs.native_slett_varig(sti)["status"], "feil")

    la les = fs.opne_native(".", "README.md", "read")
    assert_eq(les["status"], "open")
    assert_eq(fs.native_flush(les)["status"], "feil")
    assert_eq(fs.native_lukk(les)["status"], "closed")

    // Seek forbi EOF må bevare posisjonen, og tom skriving må ikkje utvide fila.
    skriv("[filesystem] seek forbi EOF\n")
    la hol = fs.opne_native(dir, "seek-hol", "write")
    assert_eq(hol["status"], "open")
    assert_eq(fs.native_skriv(hol, "a")["value"], 1)
    assert_eq(fs.native_seek(hol, 4)["value"], 4)
    assert_eq(fs.native_skriv(hol, "")["value"], 0)
    assert_eq(fs.native_stat(hol)["value"], 1)
    assert_eq(fs.native_skriv(hol, "z")["value"], 1)
    assert_eq(fs.native_stat(hol)["value"], 5)
    assert_eq(fs.native_flush(hol)["status"], "ok")
    assert_eq(fs.native_lukk(hol)["status"], "closed")
    assert_eq(builtin.fil_les(dir + "/seek-hol"), "a" + builtin.chr(0) + builtin.chr(0) + builtin.chr(0) + "z")
    assert_eq(fs.native_slett_varig(dir + "/seek-hol")["status"], "deleted")

    // POSIX: ei unlink + ny fil med same namn skal ikkje flytte skrivehandtaket.
    // Ei implementering som opnar stien på nytt ved write/flush feilar denne testen.
    hvis tekst(builtin.system_info()["system"]) != "Windows" {
        la h = fs.opne_native(dir, "identitet", "write")
        assert_eq(h["status"], "open")
        assert_eq(fs.native_skriv(h, "opphav")["status"], "ok")
        assert_eq(fs.native_slett(dir, "identitet")["status"], "deleted")
        assert_eq(fs.native_skriv_varig(dir + "/identitet", "anna inode", usann)["status"], "ok")
        assert_eq(fs.native_skriv(h, "-fortsett")["status"], "ok")
        assert_eq(fs.native_flush(h)["status"], "ok")
        assert_eq(fs.native_lukk(h)["status"], "closed")
        assert_eq(builtin.fil_les(dir + "/identitet"), "anna inode")
        assert_eq(fs.native_flush(h)["status"], "feil")
        assert_eq(fs.native_slett_varig(dir + "/identitet")["status"], "deleted")
    }
    assert_eq(fs.native_slett_mappe("build", builtin.slice(dir, 6, lengde(dir)))["status"], "deleted")
    skriv("test_native_filesystem_durable OK\n")
    returner 0
}
