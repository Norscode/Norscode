// Test for årsakskjede-hjelparane i std.feil (ny_feil, årsak, rotårsak, kjede_til_tekst)
// med verdiar slik prøv/fang faktisk fangar dei: tekst og ordbøker.
// Kvar sjekk tel feil sjølv (assert er no-op i AOT), og start() returnerer talet på feil.
bruk std.feil som feil

funksjon sjekk(namn: tekst, fått: tekst, venta: tekst) -> heiltall {
    hvis fått == venta {
        returner 0
    }
    skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
    returner 1
}

funksjon sjekk_sant(namn: tekst, v: boolsk) -> heiltall {
    hvis v {
        returner 0
    }
    skriv("FEIL " + namn + ": venta sann\n")
    returner 1
}

funksjon lågnivå() -> heiltall {
    kast "IOFeil: disk full"
}

funksjon lagre() -> heiltall {
    prøv {
        lågnivå()
    } fang (e) {
        kast feil.ny_feil("TenestFeil: kunne ikkje lagre", e)
    }
    returner 0
}

funksjon test_to_ledd() -> heiltall {
    la f: heiltall = 0
    la fanga = null
    prøv {
        lagre()
    } fang (e: TenestFeil) {
        fanga = e
    }
    f = f + sjekk_sant("fanga", fanga != null)
    f = f + sjekk("type", feil.type_av(fanga), "TenestFeil")
    f = f + sjekk("melding", feil.melding_av(fanga), "kunne ikkje lagre")
    f = f + sjekk("årsak", tekst(feil.årsak(fanga)), "IOFeil: disk full")
    f = f + sjekk("årsak type", feil.type_av(feil.årsak(fanga)), "IOFeil")
    f = f + sjekk("årsak melding", feil.melding_av(feil.årsak(fanga)), "disk full")
    f = f + sjekk("rotårsak", tekst(feil.rotårsak(fanga)), "IOFeil: disk full")
    f = f + sjekk("kjede", feil.kjede_til_tekst(fanga), "TenestFeil: kunne ikkje lagre\nForårsaka av: IOFeil: disk full")
    f = f + sjekk("kjedelengd", tekst(lengde(feil.årsakskjede(fanga))), "2")
    f = f + sjekk_sant("rot har inga årsak", feil.årsak(feil.rotårsak(fanga)) == null)
    returner f
}

funksjon nivå_c() -> heiltall {
    kast feil.ny_feil_typa("CFeil", "botn", null)
}

funksjon nivå_b() -> heiltall {
    prøv {
        nivå_c()
    } fang (e) {
        kast feil.ny_feil("BFeil: midten", e)
    }
    returner 0
}

funksjon nivå_a() -> heiltall {
    prøv {
        nivå_b()
    } fang (e) {
        feil.kast_med_årsak("AFeil: toppen", e)
    }
    returner 0
}

funksjon test_tre_ledd() -> heiltall {
    la f: heiltall = 0
    la fanga = null
    prøv {
        nivå_a()
    } fang (e: AFeil) {
        fanga = e
    }
    la kjede = feil.årsakskjede(fanga)
    f = f + sjekk("lengd", tekst(lengde(kjede)), "3")
    la typar: tekst = ""
    la i: heiltall = 0
    mens i < lengde(kjede) {
        typar = typar + feil.type_av(kjede[i]) + ";"
        i = i + 1
    }
    f = f + sjekk("typar", typar, "AFeil;BFeil;CFeil;")
    f = f + sjekk("rot", feil.feil_til_tekst(feil.rotårsak(fanga)), "CFeil: botn")
    f = f + sjekk_sant("har BFeil", feil.har_årsak_av_type(fanga, "BFeil"))
    f = f + sjekk_sant("har AFeil (seg sjølv)", feil.har_årsak_av_type(fanga, "AFeil"))
    f = f + sjekk_sant("har ikkje XFeil", ikkje feil.har_årsak_av_type(fanga, "XFeil"))
    f = f + sjekk("finn", feil.melding_av(feil.finn_årsak(fanga, "CFeil")), "botn")
    f = f + sjekk_sant("finn ingen", feil.finn_årsak(fanga, "XFeil") == null)
    f = f + sjekk("kjede", feil.kjede_til_tekst(fanga), "AFeil: toppen\nForårsaka av: BFeil: midten\nForårsaka av: CFeil: botn")
    returner f
}

funksjon les_manglande_fil() -> tekst {
    returner fil_les("/tmp/finst_ikkje_norscode_feil_kjede_7f3a.txt")
}

// Innebygd runtime-feil (manglande fil; teksten kan variere mellom VM og AOT) som
// årsak: sjekk strukturen, ikkje teksten. Fil-feilen blir kasta på VM, x86-64 og
// macOS-AOT (indeksfeil blir det ikkje på macOS-AOT enno).
funksjon test_innebygd_årsak() -> heiltall {
    la f: heiltall = 0
    la fanga = null
    prøv {
        prøv {
            les_manglande_fil()
        } fang (e) {
            kast feil.ny_feil("KonfigFeil: kunne ikkje lese oppsettet", e)
        }
    } fang (e) {
        fanga = e
    }
    la rot = feil.rotårsak(fanga)
    f = f + sjekk("rot er tekst", builtin.type(rot), "tekst")
    f = f + sjekk_sant("rot ikkje tom", lengde(rot) > 0)
    f = f + sjekk("kjede", feil.kjede_til_tekst(fanga), "KonfigFeil: kunne ikkje lese oppsettet\nForårsaka av: " + rot)
    returner f
}

funksjon test_former() -> heiltall {
    la f: heiltall = 0
    // Utan gyldig typeprefiks blir typen "Feil" og heile teksten meldinga.
    la u = feil.ny_feil("noko gjekk gale", null)
    f = f + sjekk("utan type", feil.type_av(u), "Feil")
    f = f + sjekk("utan type melding", feil.melding_av(u), "noko gjekk gale")
    f = f + sjekk_sant("utan årsak", feil.årsak(u) == null)
    f = f + sjekk("utan årsak kjede", feil.kjede_til_tekst(u), "Feil: noko gjekk gale")
    la m = feil.ny_feil("Mangel på: x", null)
    f = f + sjekk("mellomrom i prefiks", feil.type_av(m), "Feil")
    f = f + sjekk("mellomrom i prefiks melding", feil.melding_av(m), "Mangel på: x")
    // Typa fang på ordbok frå ny_feil_typa.
    la fanga_typa: tekst = "nei"
    prøv {
        kast feil.ny_feil_typa("DbFeil", "tapt", null)
    } fang (e: DbFeil) {
        fanga_typa = feil.feil_til_tekst(e)
    }
    f = f + sjekk("typa fang", fanga_typa, "DbFeil: tapt")
    // Brukarlaga ordbok-unntak med ekstra felt.
    la eigen = {type: "ValideringsFeil", melding: "felt x manglar", felt: "x"}
    f = f + sjekk("eigen ordbok", feil.kjede_til_tekst(eigen), "ValideringsFeil: felt x manglar")
    // Rein tekst og andre verdiar.
    f = f + sjekk("tekst utan type", feil.feil_til_tekst("noko gjekk gale"), "noko gjekk gale")
    f = f + sjekk("tekst type tom", feil.type_av("noko gjekk gale"), "")
    f = f + sjekk("tekst type", feil.type_av("IOFeil:disk"), "IOFeil")
    f = f + sjekk("tekst melding utan mellomrom", feil.melding_av("IOFeil:disk"), "disk")
    f = f + sjekk_sant("tekst har inga årsak", feil.årsak("IOFeil: x") == null)
    f = f + sjekk_sant("tal har inga årsak", feil.årsak(42) == null)
    f = f + sjekk("tal type", feil.type_av(42), "heltall")
    f = f + sjekk("rotårsak av tekst", tekst(feil.rotårsak("IOFeil: x")), "IOFeil: x")
    // Sirkulær kjede: traverseringa må stoppe.
    la a = feil.ny_feil("AFeil: a", null)
    la b = feil.ny_feil("BFeil: b", a)
    a["årsak"] = b
    la n: heiltall = lengde(feil.årsakskjede(b))
    f = f + sjekk_sant("sirkulær stoppar", n >= 2 og n <= 100)
    f = f + sjekk_sant("sirkulær tekst avkorta", builtin.index_of(feil.kjede_til_tekst(b), "avkorta") >= 0)
    // Eldre hjelparar er uendra.
    f = f + sjekk("gamal ny", feil.ny("IOFeil", "x"), "IOFeil: x")
    f = f + sjekk("gamal feil_type", feil.feil_type("IOFeil: x"), "IOFeil")
    returner f
}

funksjon start() -> heiltall {
    la f: heiltall = 0
    f = f + test_to_ledd()
    f = f + test_tre_ledd()
    f = f + test_innebygd_årsak()
    f = f + test_former()
    skriv("test_feil_kjede: " + tekst(f) + " feil\n")
    returner f
}
