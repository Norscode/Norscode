bruk selfhost.l5b_raw_bundler som raw_bundler

funksjon start() -> heiltall {
    la metadata_raw = "{\"version\":1,\"entry\":\"selfhost.l5b_host.start\",\"module_initializers\":[\"selfhost.lexer.lexer_m1.__module_init__\",\"selfhost.vm.__module_init__\"],\"global_names\":{\"selfhost.lexer.lexer_m1\":[\"tokeniser\"],\"selfhost.vm\":[\"køyr\"]}}"

    la berre_lexer: liste_tekst = ["selfhost.lexer.lexer_m1=selfhost/lexer/lexer_m1.no"]
    la filtrert = builtin.json_parse_raw(raw_bundler.filtrer_metadata(metadata_raw, berre_lexer))
    assert(lengde(filtrert["module_initializers"]) == 1)
    assert(filtrert["module_initializers"][0] == "selfhost.lexer.lexer_m1.__module_init__")
    assert(finnes_nøkkel(filtrert["global_names"], "selfhost.lexer.lexer_m1"))
    assert(ikkje finnes_nøkkel(filtrert["global_names"], "selfhost.vm"))

    la begge: liste_tekst = [
        "selfhost.lexer.lexer_m1=selfhost/lexer/lexer_m1.no",
        "selfhost.vm=selfhost/vm.no"
    ]
    la uendra = builtin.json_parse_raw(raw_bundler.filtrer_metadata(metadata_raw, begge))
    assert(lengde(uendra["module_initializers"]) == 2)
    assert(finnes_nøkkel(uendra["global_names"], "selfhost.lexer.lexer_m1"))
    assert(finnes_nøkkel(uendra["global_names"], "selfhost.vm"))

    builtin.mkdir_p("build")
    la fn_json = "\"m.f\":{\"name\":\"f\",\"code\":[[\"PUSH_CONST\",\"},\\\"route_handlers\\\":\"]]}"
    la route_etter = "{\"format\":\"ncb-v1\",\"functions\":{" + fn_json + "},\"route_handlers\":[],\"tests\":[]}"
    la init_etter = "{\"format\":\"ncb-v1\",\"functions\":{" + fn_json + "},\"module_initializers\":[],\"global_names\":{}}"
    la funksjonar_sist = "{\"format\":\"ncb-v1\",\"route_handlers\":[],\"functions\":{" + fn_json + "}}"
    fil_skriv("build/test-raw-metadata-route.ncb.json", route_etter)
    fil_skriv("build/test-raw-metadata-init.ncb.json", init_etter)
    fil_skriv("build/test-raw-metadata-last.ncb.json", funksjonar_sist)
    assert(raw_bundler.funksjonar_innhald("build/test-raw-metadata-route.ncb.json") == fn_json)
    assert(raw_bundler.funksjonar_innhald("build/test-raw-metadata-init.ncb.json") == fn_json)
    assert(raw_bundler.funksjonar_innhald("build/test-raw-metadata-last.ncb.json") == fn_json)

    la gammal_vm_delar = miljo_hent("NORSCODE_L5B_VM_PART_COUNT")
    miljo_sett("NORSCODE_L5B_VM_PART_COUNT", "0")
    builtin.mkdir_p("build/test-raw-metadata-source-utan-init")
    builtin.mkdir_p("build/test-raw-metadata-source-med-init")
    fil_skriv("build/test-raw-metadata-source-utan-init/vm.ncb.json",
        "{\"format\":\"ncb-v1\",\"functions\":{\"selfhost.vm.køyr\":{}}}")
    fil_skriv("build/test-raw-metadata-source-med-init/vm.ncb.json",
        "{\"format\":\"ncb-v1\",\"functions\":{\"selfhost.vm.__module_init__\":{},\"selfhost.vm.køyr\":{}}}")
    la berre_vm: liste_tekst = ["selfhost.vm=selfhost/vm.no"]
    la utan_init = builtin.json_parse_raw(raw_bundler.filtrer_metadata_for_source(
        metadata_raw, berre_vm, "build/test-raw-metadata-source-utan-init"))
    assert(lengde(utan_init["module_initializers"]) == 0)
    assert(finnes_nøkkel(utan_init["global_names"], "selfhost.vm"))
    la med_init = builtin.json_parse_raw(raw_bundler.filtrer_metadata_for_source(
        metadata_raw, berre_vm, "build/test-raw-metadata-source-med-init"))
    assert(lengde(med_init["module_initializers"]) == 1)
    assert(med_init["module_initializers"][0] == "selfhost.vm.__module_init__")
    miljo_sett("NORSCODE_L5B_VM_PART_COUNT", gammal_vm_delar)

    skriv("test_l5b_raw_bundler_metadata_filter OK\n")
    returner 0
}
