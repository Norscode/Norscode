bruk std.linux_drift som drift

funksjon start() -> heiltall {
    assert(drift.abi() == "norscode-linux-ops-v1")
    la live = drift.status()
    hvis live["status"] == "unsupported" {
        assert(builtin.index_of(live["error"], "Linux ABI unavailable") >= 0)
    } ellers {
        assert(live["status"] == "ok")
        assert(live["pid"] > 0)
        assert(live["rss_bytes"] >= 0)
        assert(drift.brukar("root")["status"] == "ok")
        assert(drift.gruppe("root")["status"] == "ok")
        assert(drift.brukar("bad\r\nname")["status"] == "feil")
        assert(drift.systemd_status("bad/name.service")["status"] == "feil")
    }
    skriv("test_linux_drift_contract OK\n")
    returner 0
}
