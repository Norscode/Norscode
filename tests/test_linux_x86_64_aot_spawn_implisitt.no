// Linux x86-64 AOT, F3.2-port: eit program som spawnar via stdlib-innpakningane
// (tools.process_runner → std.runtime.process_abi) utan eksplisitt `bruk std.native_gap`
// skal byggje med `nc bygg-native` og køyre. Codegen krev std.native_gap i bunten for
// builtin.process_spawn_argv (fail-closed kompileringsfeil); bygg-native legg modulen til
// implisitt når bunten kallar spawn (selfhost/nc_main.no: nc_aot_treng_native_gap).
// Negativ kontroll: ein seed utan den implisitte importen (079b1c02, F3-integ før fiksen)
// gjev «builtin.process_spawn_argv krev std.native_gap i bunten» og exit 1 frå bygget.
// I tillegg: eit program utan spawn får IKKJE modulen (ELF-storleiken skil dei to).
// Berre på Linux x86-64-vert; nc_test klassifiserer han som plattformhopp elles.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    returner system == "Linux" og (maskin == "x86_64" eller maskin == "amd64")
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_linux_x86_64() {
        skriv("test_linux_x86_64_aot_spawn_implisitt: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la merke = builtin.random_hex(8)
    la med_spawn = "/tmp/norscode_aot_spawn_implisitt_" + merke
    la utan_spawn = "/tmp/norscode_aot_utan_spawn_" + merke
    krev_exit(køyr(runtime(root), ["bygg-native", "--target", "linux-x86_64",
                                   root + "/tests/fixtures/aot_spawn_implisitt.no", med_spawn], root, 300000), 0)
    la resultat = køyr(med_spawn, [], root, 60000)
    krev_exit(resultat, 42)
    assert(builtin.contains(tekst(resultat["stdout"]), "aot_spawn_implisitt OK"))
    // Program utan spawn: modulen skal ikkje bli dregen inn (om lag 1,7 MB skilnad).
    krev_exit(køyr(runtime(root), ["bygg-native", "--target", "linux-x86_64",
                                   root + "/tests/fixtures/aot_utan_spawn.no", utan_spawn], root, 300000), 0)
    krev_exit(køyr(utan_spawn, [], root, 30000), 42)
    la stor_med = filops.fil_storleik(med_spawn)
    la stor_utan = filops.fil_storleik(utan_spawn)
    skriv("ELF med spawn " + tekst(stor_med) + " B, utan spawn " + tekst(stor_utan) + " B\n")
    assert(stor_med > stor_utan + 1000000)
    filops.slett_fil(med_spawn)
    filops.slett_fil(utan_spawn)
    skriv("test_linux_x86_64_aot_spawn_implisitt OK\n")
    returner 0
}
