// Benchmark: insert-gjennomstrøyming + skann-vs-indeks-spørring. Skriv tidsbruk (ms)
// og assertar korrektheit. Køyr for å sjå at motoren + indeks faktisk yter.
// (Samanlikn med sqlite3 for referanse: same SQL mot `sqlite3 :memory:` med .timer on.)

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE t (id INTEGER, k INTEGER, v TEXT)")

    // Liten N: den tolka runtimen er treg ved skala (sjå plan/gap — runtime-modning).
    la n = 100
    la t0 = builtin.tid_ms()
    la i = 0
    mens i < n {
        sql.exec(db, "INSERT INTO t (id, k, v) VALUES (" + tekst_fra_heltall(i) + ", " + tekst_fra_heltall(i % 10) + ", 'rad')")
        i = i + 1
    }
    la t1 = builtin.tid_ms()
    skriv("insert " + tekst_fra_heltall(n) + " rader: " + tekst_fra_heltall(t1 - t0) + " ms\n")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t"), n)

    // k = 4 finst i n/10 rader
    la venta = n / 10

    // Skann (utan indeks)
    la t2 = builtin.tid_ms()
    la q = 0
    mens q < 20 {
        assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t WHERE k = 4"), venta)
        q = q + 1
    }
    la t3 = builtin.tid_ms()
    skriv("20 skann-spørringar (k=4): " + tekst_fra_heltall(t3 - t2) + " ms\n")

    // Indeks
    sql.exec(db, "CREATE INDEX idx_k ON t (k)")
    la t4 = builtin.tid_ms()
    q = 0
    mens q < 20 {
        assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t WHERE k = 4"), venta)
        q = q + 1
    }
    la t5 = builtin.tid_ms()
    skriv("20 indeks-spørringar (k=4): " + tekst_fra_heltall(t5 - t4) + " ms\n")

    skriv("BENCHMARK OK\n")
    returner 0
}
