# Test for std.valfri (Java Optional og ingenting-hjelparar).
# Eksplisitte samanlikningar (ikkje assert), så testen òg feilar i native AOT.
bruk std.valfri som vf

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

funksjon _tel(teljar: ordbok, v) -> heiltall {
    teljar["n"] = teljar["n"] + 1
    returner v
}

funksjon _logg(logg: ordbok, v) {
    logg["s"] = logg["s"] + "[" + tekst(v) + "]"
}

funksjon _finn(m: ordbok, k: tekst) -> ordbok {
    hvis har_nokkel(m, k) { returner vf.av(m[k]) }
    returner vf.tom()
}

funksjon _halver_partal(x) -> ordbok {
    hvis x % 2 == 0 { returner vf.av(x / 2) }
    returner vf.tom()
}

funksjon _fangar(o: ordbok) -> tekst {
    prøv {
        la v = vf.hent(o)
        returner "ok:" + tekst(v)
    } fang (e) {
        returner tekst(e)
    }
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}

    la t = vf.tom()
    la a = vf.av(42)
    la null_verdi = vf.av(0)
    _sjekk(res, "tom er_tom", tekst(vf.er_tom(t)) + tekst(vf.er_til_stades(t)), "sannusann")
    _sjekk(res, "av er_til_stades", tekst(vf.er_til_stades(a)) + tekst(vf.er_tom(a)), "sannusann")
    _sjekk(res, "av(0) er til stades", tekst(vf.er_til_stades(null_verdi)) + "|" + tekst(vf.hent(null_verdi)), "sann|0")
    _sjekk(res, "av(usann) er til stades", tekst(vf.er_til_stades(vf.av(usann))), "sann")
    _sjekk(res, "av(\"\") er til stades", tekst(vf.er_til_stades(vf.av(""))), "sann")
    _sjekk(res, "av_nullbar(ingenting)", tekst(vf.er_tom(vf.av_nullbar(ingenting))), "sann")
    _sjekk(res, "av_nullbar(-1)", tekst(vf.hent(vf.av_nullbar(-1))), "-1")
    _sjekk(res, "til_tekst", vf.til_tekst(a) + " " + vf.til_tekst(t), "Valfri[42] Valfri.tom")

    # av(ingenting) kastar (som Optional.of(null)).
    la fanga = "nei"
    prøv { vf.av(ingenting) } fang (e) { fanga = tekst(e) }
    _sjekk(res, "av(ingenting) kastar", fanga, "VerdiFeil: valfri.av fekk ingenting (bruk av_nullbar)")
    _sjekk(res, "hent tom kastar", _fangar(t), "TomtFeil: valfri utan verdi")
    _sjekk(res, "hent verdi", _fangar(a), "ok:42")

    # eller_*
    _sjekk(res, "eller_standard", tekst(vf.eller_standard(t, 7)) + "," + tekst(vf.eller_standard(a, 7)), "7,42")
    la teljar = {"n": 0}
    la r1 = vf.eller_hent(a, fun() -> _tel(teljar, 99))
    _sjekk(res, "eller_hent lat (ikkje kalla)", tekst(r1) + "|" + tekst(teljar["n"]), "42|0")
    la r2 = vf.eller_hent(t, fun() -> _tel(teljar, 99))
    _sjekk(res, "eller_hent tom (kalla éin gong)", tekst(r2) + "|" + tekst(teljar["n"]), "99|1")
    la kast_tekst = "nei"
    prøv { vf.eller_kast(t, "fann ikkje brukar") } fang (e) { kast_tekst = tekst(e) }
    _sjekk(res, "eller_kast", kast_tekst, "TomtFeil: fann ikkje brukar")
    _sjekk(res, "eller_kast med verdi", tekst(vf.eller_kast(a, "x")), "42")
    _sjekk(res, "eller_valfri", vf.til_tekst(vf.eller_valfri(t, fun() -> vf.av(5))) + " " + vf.til_tekst(vf.eller_valfri(a, fun() -> vf.av(5))), "Valfri[5] Valfri[42]")

    # map / flat_map / filter
    _sjekk(res, "map", vf.til_tekst(vf.map(a, fun(x) -> x + 1)), "Valfri[43]")
    _sjekk(res, "map tom", vf.til_tekst(vf.map(t, fun(x) -> x + 1)), "Valfri.tom")
    _sjekk(res, "map til ingenting gjev tom", vf.til_tekst(vf.map(a, fun(x) -> ingenting)), "Valfri.tom")
    _sjekk(res, "flat_map", vf.til_tekst(vf.flat_map(vf.av(8), fun(x) -> _halver_partal(x))), "Valfri[4]")
    _sjekk(res, "flat_map til tom", vf.til_tekst(vf.flat_map(vf.av(7), fun(x) -> _halver_partal(x))), "Valfri.tom")
    la kjede = vf.flat_map(vf.flat_map(vf.av(40), fun(x) -> _halver_partal(x)), fun(x) -> _halver_partal(x))
    _sjekk(res, "flat_map kjede", vf.til_tekst(kjede), "Valfri[10]")
    _sjekk(res, "filter held", vf.til_tekst(vf.filter(a, fun(x) -> x > 40)), "Valfri[42]")
    _sjekk(res, "filter fjernar", vf.til_tekst(vf.filter(a, fun(x) -> x > 50)), "Valfri.tom")
    la ikkje_valfri = "nei"
    prøv { vf.flat_map(a, fun(x) -> x) } fang (e) { ikkje_valfri = tekst(e) }
    _sjekk(res, "flat_map krev valfri", ikkje_valfri, "TypeFeil: flat_map-funksjonen må returnere ein valfri")

    # Oppslag i kart via valfri-kjede.
    la brukar = {"namn": "Kari", "alder": 41}
    la alder_om_ti = vf.map(_finn(brukar, "alder"), fun(x) -> x + 10)
    _sjekk(res, "kart-kjede", tekst(vf.eller_standard(alder_om_ti, -1)), "51")
    _sjekk(res, "kart-kjede manglar", tekst(vf.eller_standard(vf.map(_finn(brukar, "epost"), fun(x) -> x + "!"), "ingen")), "ingen")

    # om_til_stades
    la logg = {"s": ""}
    _sjekk(res, "om_til_stades", tekst(vf.om_til_stades(a, fun(v) -> _logg(logg, v))) + tekst(vf.om_til_stades(t, fun(v) -> _logg(logg, v))), "sannusann")
    vf.om_til_stades_ellers(t, fun(v) -> _logg(logg, v), fun() -> _logg(logg, "tom"))
    _sjekk(res, "om_til_stades logg", logg["s"], "[42][tom]")

    # til_liste / lik
    _sjekk(res, "til_liste", tekst(lengde(vf.til_liste(a))) + tekst(lengde(vf.til_liste(t))), "10")
    _sjekk(res, "lik", tekst(vf.lik(vf.av(3), vf.av(3))) + tekst(vf.lik(vf.av(3), vf.av(4))) + tekst(vf.lik(t, vf.tom())) + tekst(vf.lik(t, a)), "sannusannsannusann")
    _sjekk(res, "er_valfri", tekst(vf.er_valfri(a)) + tekst(vf.er_valfri({"x": 1})) + tekst(vf.er_valfri(3)), "sannusannusann")

    # Rå ingenting-hjelparar: 0, "" og usann er IKKJE ingenting.
    _sjekk(res, "er_ingenting", tekst(vf.er_ingenting(ingenting)) + tekst(vf.er_ingenting(0)) + tekst(vf.er_ingenting("")) + tekst(vf.er_ingenting(usann)), "sannusannusannusann")
    _sjekk(res, "verdi_eller", tekst(vf.verdi_eller(ingenting, "std")) + "," + tekst(vf.verdi_eller(0, "std")) + "," + tekst(vf.verdi_eller(brukar["epost"], "ingen")), "std,0,ingen")
    la krev_tekst = "nei"
    prøv { vf.krev(ingenting, "id manglar") } fang (e) { krev_tekst = tekst(e) }
    _sjekk(res, "krev", krev_tekst + "|" + tekst(vf.krev(5, "x")), "VerdiFeil: id manglar|5")

    hvis res["feil"] != 0 {
        skriv("test_valfri FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_valfri OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
