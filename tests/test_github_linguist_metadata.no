// Regresjon for Norscode-språkmetadata, ikkje ein faktisk Linguist-klassifiseringstest.
bruk std.tekst som t

funksjon start() -> heiltall {
    assert(fil_finnes("vscode-norscode/package.json"))
    assert(fil_finnes("vscode-norscode/syntaxes/norscode.tmLanguage.json"))
    assert(fil_finnes("docs/04-how-to-guides/GITHUB_LINGUIST_DETECTION_TESTS.md"))

    la manifest = fil_les("vscode-norscode/package.json")
    assert(t.inneholder(manifest, "\".no\""))
    assert(t.inneholder(manifest, "\"source.norscode\""))
    assert(t.inneholder(manifest, "norscode.tmLanguage.json"))

    la gramm = fil_les("vscode-norscode/syntaxes/norscode.tmLanguage.json")
    assert(t.inneholder(gramm, "source.norscode"))
    assert(t.inneholder(gramm, "keyword.control.import.norscode"))
    assert(t.inneholder(gramm, "keyword.operator.logical.norscode"))
    assert(t.inneholder(gramm, "pakke|hvis"))
    assert(t.inneholder(gramm, "entity.name.function.norscode"))

    la grunnlag = fil_les("docs/04-how-to-guides/GITHUB_LINGUIST_DETECTION_TESTS.md")
    assert(t.inneholder(grunnlag, "Positive (.no-kildekode)"))
    assert(t.inneholder(grunnlag, "Negative (vanlige .no-tekstfiler"))

    // Forslag til ekte Linguist-registrering; ikkje aktivert upstream.
    assert(fil_finnes("docs/04-how-to-guides/linguist-proposal/norscode-language.yml"))
    assert(fil_finnes("docs/04-how-to-guides/linguist-proposal/norscode-heuristics.yml"))
    la språk = fil_les("docs/04-how-to-guides/linguist-proposal/norscode-language.yml")
    assert(t.inneholder(språk, "Norscode:"))
    assert(t.inneholder(språk, "type: programming"))
    assert(t.inneholder(språk, "source.norscode"))
    la heuristikk = fil_les("docs/04-how-to-guides/linguist-proposal/norscode-heuristics.yml")
    assert(t.inneholder(heuristikk, "extensions: ['.no']"))
    assert(t.inneholder(heuristikk, "language: Norscode"))
    assert(t.inneholder(heuristikk, "language: Text"))

    // Staging-pakke for separat TextMate-grammatikkrepo, ikkje publisert upstream.
    la pack = "docs/04-how-to-guides/linguist-proposal/grammar-repo/"
    assert(fil_finnes(pack + "README.md"))
    assert(fil_finnes(pack + "package.json"))
    assert(fil_finnes(pack + "LICENSE"))
    assert(fil_finnes(pack + "syntaxes/norscode.tmLanguage.json"))
    la pack_manifest = fil_les(pack + "package.json")
    assert(t.inneholder(pack_manifest, "\"norscode-grammar\""))
    assert(t.inneholder(pack_manifest, "\"Apache-2.0\""))
    assert(t.inneholder(pack_manifest, "\"source.norscode\""))
    assert(t.inneholder(pack_manifest, "\".no\""))

    // Desse kopiane må aldri driva frå kanonisk VS Code-grammatikk / rotlisens.
    assert(fil_les(pack + "syntaxes/norscode.tmLanguage.json") == gramm)
    assert(fil_les(pack + "LICENSE") == fil_les("LICENSE"))

    skriv("test_github_linguist_metadata OK")
    returner 0
}
