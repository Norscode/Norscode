bruk std.tekst som t
bruk tools.build_linux_attestation_candidate som kandidat
bruk tools.finalize_linux_fullhost_candidate som finalize

funksjon test_innebygd_kandidat() {
    la namn = "build/linux-attestation-embed-" + builtin.random_hex(8)
    la ncb = namn + ".ncb.json"
    builtin.fil_skriv(ncb, "{\"entry\":\"probe.start\",\"functions\":{}}")
    builtin.fil_skriv_binær(namn, builtin.bytes_from_list([127, 69, 76, 70]))
    assert(ikkje kandidat.har_embedded_ncb(namn))
    assert(finalize.fullfør_innebygd_ncb(namn, ncb))
    assert(kandidat.har_embedded_ncb(namn))
    builtin.fil_slett(namn)
    builtin.fil_slett(ncb)
}

funksjon start() -> heiltall {
    test_innebygd_kandidat()
    la src = fil_les("tools/build_linux_attestation_candidate.no")
    assert(t.inneholder(src, "prosess.køyr(native, [], root, miljø, 300000)"))
    assert(t.inneholder(src, "NORSCODE_LINUX_ATTESTATION_CANDIDATE"))
    assert(t.inneholder(src, "NORSCODE_EMBED_STREAM"))
    assert(t.inneholder(src, "native_fs.native_lag_mappe(root, \"build\")"))
    assert(t.inneholder(src, "NORSCODE_LINUX_CANDIDATE_ALREADY_EMBEDDED"))
    assert(t.inneholder(src, "hvis ikkje har_embedded_ncb(native)"))
    assert(t.inneholder(src, "NORSCODE_LINUX_ATTESTATION_NCB"))
    assert(t.inneholder(src, "NORSCODE_LINUX_ATTESTATION_DRIVER_NCB"))
    assert(t.inneholder(src, "NORSCODE_LINUX_ARM64_ATTESTATION_NCB"))
    assert(t.inneholder(src, "\"NORSCODE_CMD\": \"compile\""))
    // J1c/F1.2: genererte payloadar, ingen pensjonert compiler-payload.
    assert(t.inneholder(src, "payloads.sikre_alle(root, native)"))
    assert(ikkje t.inneholder(src, "kompiler.ncb.json"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_build_linux_attestation_candidate OK\n")
    returner 0
}
