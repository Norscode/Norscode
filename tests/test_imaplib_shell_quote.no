bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/imaplib.no")
    assert(t.inneholder(src, "native TCP/TLS"))
    assert(t.inneholder(src, "bruk std.protocol_stream som stream"))
    assert(t.inneholder(src, "stream.dialog(c[\"vert\"], heltall_fra_tekst(c[\"port\"])"))
    assert(t.inneholder(src, "c[\"protokoll\"] == \"imaps\""))
    assert(t.inneholder(src, "la res = _socket_imap(c, \"LIST \\\"\\\" \\\"*\\\"\")"))
    assert(t.inneholder(src, "la res = _socket_imap(c, \"SEARCH \" + kriterie)"))
    assert(t.inneholder(src, "la rå = _socket_imap(c, \"UID FETCH \" + melding_id + \" BODY[]\")"))
    assert(t.inneholder(src, "UID STORE \" + melding_id + \" +FLAGS"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "curl "))
    skriv("test_imaplib_shell_quote OK")
    returner 0
}
