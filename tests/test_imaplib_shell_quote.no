bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/imaplib.no")
    assert(t.inneholder(src, "persistent, shell-fri IMAP/IMAPS"))
    assert(t.inneholder(src, "bruk std.protocol_stream som stream"))
    assert(t.inneholder(src, "stream.opne_session_ca"))
    assert(t.inneholder(src, "stream.oppgrader_tls"))
    assert(t.inneholder(src, "funksjon _tag_status"))
    assert(t.inneholder(src, "UID SEARCH \" + kriterie"))
    assert(t.inneholder(src, "UID FETCH \" + uid"))
    assert(t.inneholder(src, "UID STORE \" + uid"))
    assert(t.inneholder(src, "funksjon _gjenopprett"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "curl "))
    skriv("test_imaplib_shell_quote OK")
    returner 0
}
