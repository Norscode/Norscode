# R1 / F13: enum-fullstende. Ukjend variant og ikkje-uttømmande match over ein
# enum er kompileringsfeil; Enum.verdiar() / Enum.namn(v) / Enum.fraa_tekst(t)
# og Enum.Variant.namn blir løyste ved kompilering.
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon kompileringsfeil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner ""
}

funksjon start() -> heiltall {
    # Kryss-modul-caset kompilerer «bruk tests.fixtures.r1_fargar». Kjelde-kompilatoren
    # leitar fyrst i NORSCODE_IMPORT_BASE (mappa til testfila, t.d. «tests») og PWD (kan
    # vere «/» i CI) — begge gjev stiar utanfor disk-scopet, der fil_finnes kastar i staden
    # for å svare nei. Peik import-basen på repo-rota so oppslaget treffer fyrst.
    la rot = miljo_hent("NORSCODE_ROOT")
    hvis rot != "" {
        prøv { miljo_sett("NORSCODE_IMPORT_BASE", rot) } fang (e) { }
    }
    la enum_decl = "enum Farge { RAUD, GRON, BLA }\n"

    # g08d: ukjend variant.
    la feil_variant = kompileringsfeil(enum_decl +
        "funksjon start() -> heiltall {\n" +
        "    la f = Farge.GUL\n" +
        "    returner 0\n" +
        "}\n")
    assert(builtin.index_of(feil_variant, "ukjend variant Farge.GUL") >= 0)

    # g06: match over enum utan BLA og utan ellers.
    la feil_match = kompileringsfeil(enum_decl +
        "funksjon namn_paa(f) -> tekst {\n" +
        "    match f {\n" +
        "        case Farge.RAUD { returner \"raud\" }\n" +
        "        case Farge.GRON { returner \"gron\" }\n" +
        "    }\n" +
        "    returner \"?\"\n" +
        "}\n" +
        "funksjon start() -> heiltall { returner 0 }\n")
    assert(builtin.index_of(feil_match, "manglar BLA") >= 0)

    # Uttømmande match, og match med ellers, kompilerer og køyrer.
    la p_match = enum_decl +
        "funksjon namn_paa(f) -> tekst {\n" +
        "    match f {\n" +
        "        case Farge.RAUD { returner \"raud\" }\n" +
        "        case Farge.GRON { returner \"gron\" }\n" +
        "        case Farge.BLA { returner \"bla\" }\n" +
        "    }\n" +
        "    returner \"?\"\n" +
        "}\n" +
        "funksjon er_raud(f) -> tekst {\n" +
        "    match f {\n" +
        "        case Farge.RAUD { returner \"ja\" }\n" +
        "        ellers { returner \"nei\" }\n" +
        "    }\n" +
        "    returner \"?\"\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    returner namn_paa(Farge.BLA) + \",\" + er_raud(Farge.GRON)\n" +
        "}\n"
    assert_eq(utfor(p_match), "bla,nei")

    # g08a / g08b / g08f: verdiar(), namn, fraa_tekst().
    la p_metodar = enum_decl +
        "funksjon start() -> tekst {\n" +
        "    la alle = Farge.verdiar()\n" +
        "    la f = Farge.fraa_tekst(\"GRON\")\n" +
        "    la ukjend = Farge.fraa_tekst(\"GUL\")\n" +
        "    la ut = \"antal=\" + tekst(lengde(alle)) + \",namn=\" + Farge.BLA.namn\n" +
        "    ut = ut + \",dyn=\" + Farge.namn(alle[2]) + \",valueOf=\" + tekst(f)\n" +
        "    ut = ut + \",ukjend=\" + tekst(ukjend == ingenting)\n" +
        "    for v i Farge.verdiar() { ut = ut + \",\" + Farge.namn(v) }\n" +
        "    returner ut\n" +
        "}\n"
    assert_eq(utfor(p_metodar), "antal=3,namn=BLA,dyn=BLA,valueOf=1,ukjend=sann,RAUD,GRON,BLA")

    # g13: enum i importert modul blir konstant ved kompilering.
    la p_kryss = "bruk tests.fixtures.r1_fargar som fg\n" +
        "funksjon start() -> tekst {\n" +
        "    returner tekst(fg.Farge.GRON) + \",\" + tekst(lengde(fg.Farge.verdiar()))\n" +
        "}\n"
    assert_eq(utfor(p_kryss), "1,3")
    la feil_kryss = kompileringsfeil("bruk tests.fixtures.r1_fargar som fg\n" +
        "funksjon start() -> heiltall { returner fg.Farge.GUL }\n")
    assert(builtin.index_of(feil_kryss, "ukjend variant fg.Farge.GUL") >= 0)

    # Ukjend enum-metode er òg kompileringsfeil.
    la feil_metode = kompileringsfeil(enum_decl +
        "funksjon start() -> heiltall { returner lengde(Farge.alle()) }\n")
    assert(builtin.index_of(feil_metode, "ukjend enum-metode Farge.alle") >= 0)
    returner 0
}
