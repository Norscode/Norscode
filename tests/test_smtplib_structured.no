bruk std.smtplib som smtp

funksjon start() -> heiltall {
    la transient = smtp._smtp_feil("421 4.3.0 temporary", "greeting")
    assert(transient["category"] == "transient")
    assert(transient["retryable"] == "sann")
    assert(transient["code"] == "421")

    la auth = smtp._smtp_feil("535 5.7.8 credentials rejected", "AUTH")
    assert(auth["category"] == "auth")
    assert(auth["retryable"] == "usann")

    la permanent = smtp._smtp_feil("550 5.1.1 mailbox unavailable", "RCPT TO")
    assert(permanent["category"] == "permanent")
    assert(permanent["retryable"] == "usann")

    la protocol = smtp._smtp_feil("nonsense", "EHLO")
    assert(protocol["category"] == "protocol")

    la msg = smtp.ny_melding("trygt", "innhald", "sender@example.test", ["receiver@example.test"])
    msg["emne"] = "injeksjon\r\nBcc: victim@example.test"
    la invalid = smtp.send_resultat(smtp.ny_server("127.0.0.1", 1), msg, "", "")
    assert(invalid["category"] == "validation")
    assert(invalid["attempts"] == "1")

    la srv = smtp.ny_server_tls("smtp.example.test", 587)
    assert(smtp.sett_retry(srv, 5, 0))
    assert(ikkje smtp.sett_retry(srv, 6, 0))
    assert(ikkje smtp.sett_retry(srv, 1, 30001))

    skriv("test_smtplib_structured OK\n")
    returner 0
}
