// std.spa: shimmen skal vere trygg å emittere frå Norscode og dekke kontrakten.
bruk std.spa som spa

funksjon start() -> heiltall {
    la js = spa.spa_js()

    // Trygg emittering: ingen </script>, ingen HTML-kommentar, ingen omvend skråstrek, ingen doble hermeteikn.
    assert(ikkje builtin.contains(js, "</script>"))
    assert(ikkje builtin.contains(js, "<!--"))
    assert(ikkje builtin.contains(js, "\\"))
    assert(ikkje builtin.contains(js, "\""))
    assert(builtin.starts_with(js, "(function(){"))
    assert(builtin.ends_with(js, "})();"))

    // Kontrakten og åtferda er med.
    assert(builtin.contains(js, "[data-spa-main]"))
    assert(builtin.contains(js, "[data-spa-nav]"))
    assert(builtin.contains(js, "[data-spa-shell]"))
    assert(builtin.contains(js, "data-no-spa"))
    assert(builtin.contains(js, "data-spa-target"))
    assert(builtin.contains(js, "data-spa-poll"))
    assert(builtin.contains(js, "data-spa-search"))
    assert(builtin.contains(js, "data-spa-prefetch"))
    assert(builtin.contains(js, "aria-busy"))
    assert(builtin.contains(js, "aria-live"))
    assert(builtin.contains(js, "history.replaceState"))
    assert(builtin.contains(js, "history.pushState"))
    assert(builtin.contains(js, "popstate"))
    assert(builtin.contains(js, "data-theme"))
    assert(builtin.contains(js, "X-Requested-With"))
    assert(builtin.contains(js, "window.NorscodeSpa"))
    assert(builtin.contains(js, "spa:load"))
    // Ingen automatisk ny innsending ved nettverksfeil (gamal shim kalla f.submit()).
    assert(ikkje builtin.contains(js, "f.submit()"))

    // Innpakking.
    assert(spa.spa_inline() == "<script>" + js + "</script>")
    assert(spa.spa_script_tag("/assets/spa.js") == "<script src=\"/assets/spa.js\" defer></script>")
    la svar = spa.spa_js_response()
    assert(tekst(svar["status"]) == "200")
    assert(builtin.starts_with(svar["headers"]["content-type"], "application/javascript"))
    assert(svar["body"] == js)

    // Attributt-hjelparar.
    assert(spa.main_attr() == " data-spa-main")
    assert(spa.nav_attr() == " data-spa-nav")
    assert(spa.shell_attr("tenant") == " data-spa-shell=\"tenant\"")
    assert(spa.no_spa_attr() == " data-no-spa")
    assert(spa.target_attr("#inspektor") == " data-spa-target=\"#inspektor\"")
    assert(spa.poll_attr(30) == " data-spa-poll=\"30\"")
    assert(spa.search_attr() == " data-spa-search")

    // Request-deteksjon.
    assert(spa.er_spa_request({"__headers__": {"x-requested-with": "spa"}}))
    assert(spa.er_spa_request({"__headers__": {"x-requested-with": "SPA"}}))
    assert(ikkje spa.er_spa_request({"__headers__": {}}))

    skriv("test_spa_module OK\n")
    returner 0
}
