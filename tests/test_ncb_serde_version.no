// Ukjende binærversjonar må avvisast før payload-dekoding; JSON er normalformatet.
bruk selfhost.ncb_serde som serde

funksjon avvist_liste(b, melding: tekst) -> boolsk {
    prøv { serde.deserialiser(b) } fang (e) { returner builtin.contains(tekst(e), melding) }
    returner usann
}
funksjon avvist_tekst(t: tekst, melding: tekst) -> boolsk {
    prøv { serde.deserialiser_tekst(t) } fang (e) { returner builtin.contains(tekst(e), melding) }
    returner usann
}
funksjon start() -> heiltall {
    la ncb = {"format": "norscode-bytecode-v1", "entry": "start", "functions": {
        "start": {"params": [], "code": [["PUSH_CONST", 0], ["RETURN"]]}
    }}
    la b = serde.serialiser(ncb)
    assert_eq(serde.deserialiser(b)["entry"], "start")
    assert_eq(serde.deserialiser(builtin.json_skriv(ncb))["entry"], "start")
    assert_eq(serde.deserialiser_tekst(builtin.json_skriv(ncb))["entry"], "start")
    for versjon i [0, 2, 255] {
        b[4] = versjon
        assert(avvist_liste(b, "ustøtta binærversjon"))
        assert(avvist_liste(builtin.bytes_from_list(b), "ustøtta binærversjon"))
    }
    // Teksttesten treng ikkje ein NUL-trygg vert: headerfeilen kjem først.
    for versjon i [2, 255] {
        la t = builtin.chr(147) + "NCB" + builtin.chr(versjon)
        assert(avvist_tekst(t, "ustøtta binærversjon"))
    }
    assert(avvist_liste([147, 78, 67, 66], "manglar binærversjon"))
    assert(avvist_liste(builtin.bytes_from_list([147, 78, 67, 66]), "manglar binærversjon"))
    assert(avvist_tekst(builtin.chr(147) + "NCB", "manglar binærversjon"))
    skriv("test_ncb_serde_version OK\n")
    returner 0
}
