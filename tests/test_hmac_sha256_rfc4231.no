bruk std.sha256 som sha
bruk std.krypto som krypto

// Kjent-svar-test: HMAC-SHA256 mot RFC 4231-vektorane.
//
// std.sha256.hmac_sha256_bytes er den ekte HMAC-SHA256 som HKDF, PBKDF2 og
// JWS/ACME-signeringa byggjer på. Han var tidlegare berre indirekte dekt (via
// HKDF RFC 5869 og PBKDF2). Denne testen bind primitivet direkte til dei
// publiserte RFC 4231-testvektorane (Case 1-4, 6-7; Case 5 er trunkert og
// utelaten). Testen les ikkje codegen-løypa, så han er rask og reint pure-VM.
//
// std.krypto.hmac_sha256 (tekst→hex-fasaden) blir låst mot same Case 2.

funksjon _rep(val: heiltall, n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < n { legg_til(ut, val) i = i + 1 }
    returner ut
}

funksjon _seq(start: heiltall, n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < n { legg_til(ut, start + i) i = i + 1 }
    returner ut
}

funksjon _str_bytes(s: tekst) -> liste_heiltall {
    la teikn = builtin.split(s, "")
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(teikn) { legg_til(ut, builtin.char_code(teikn[i])) i = i + 1 }
    returner ut
}

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la sifre = "0123456789abcdef"
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(bytes) {
        la b = bytes[i]
        la hi = (b / 16) % 16
        la lo = b % 16
        ut = ut + builtin.slice(sifre, hi, hi + 1) + builtin.slice(sifre, lo, lo + 1)
        i = i + 1
    }
    returner ut
}

funksjon _hmac_hex(nokkel: liste_heiltall, data: liste_heiltall) -> tekst {
    returner _hex(sha.hmac_sha256_bytes(nokkel, data))
}

funksjon start() -> heiltall {
    // RFC 4231 Case 1: 20-byte 0x0b nøkkel, "Hi There".
    assert(_hmac_hex(_rep(0x0b, 20), _str_bytes("Hi There"))
        == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")

    // Case 2: "Jefe" nøkkel, "what do ya want for nothing?".
    assert(_hmac_hex(_str_bytes("Jefe"), _str_bytes("what do ya want for nothing?"))
        == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")

    // Case 3: 20-byte 0xaa nøkkel, 50-byte 0xdd data.
    assert(_hmac_hex(_rep(0xaa, 20), _rep(0xdd, 50))
        == "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")

    // Case 4: nøkkel 0x01..0x19 (25 byte), 50-byte 0xcd data.
    assert(_hmac_hex(_seq(1, 25), _rep(0xcd, 50))
        == "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")

    // Case 6: 131-byte 0xaa nøkkel (> blokk, blir hasha først).
    assert(_hmac_hex(_rep(0xaa, 131), _str_bytes("Test Using Larger Than Block-Size Key - Hash Key First"))
        == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")

    // Case 7: 131-byte 0xaa nøkkel, lang melding.
    assert(_hmac_hex(_rep(0xaa, 131), _str_bytes("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."))
        == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")

    // Tekst-fasaden std.krypto.hmac_sha256 mot same Case 2.
    assert(krypto.hmac_sha256("Jefe", "what do ya want for nothing?")
        == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")

    skriv("test_hmac_sha256_rfc4231: OK (7 assertar)\n")
    returner 0
}
