# R4 / F22: VM-utskrifta til tests/fixtures/aot_x86_struktur_verdi.no (lag()) er lik den
# forventa utskrifta som linux-x86_64-AOT òg skal gje (tests/test_x86_struktur_verdi.no).
bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les("tests/fixtures/aot_x86_struktur_verdi.no"), "__main__"))
    ncb["entry"] = "__main__.lag"
    assert_eq(tekst(vm.køyr_ncb(ncb)), fil_les("tests/fixtures/aot_x86_struktur_verdi.forventa"))
    returner 0
}
