bruk selfhost.ncb_stream som stream

funksjon start() -> heiltall {
    la functions = {}
    la i: heiltall = 0
    mens i < 200 {
        la namn = "mod.f" + tekst_fra_heltall(i)
        functions[namn] = {"name": "f" + tekst_fra_heltall(i), "module": "mod", "params": [], "is_async": usann, "code": [["PUSH_CONST", i], ["RETURN"]]}
        i = i + 1
    }
    functions["mod.start"] = {"name": "start", "module": "mod", "params": [], "is_async": usann, "code": [["PUSH_CONST", 7], ["RETURN"]]}
    la ncb = {"format": "ncb-v1", "entry": "mod.start", "imports": [], "module_initializers": [], "global_names": {}, "functions": functions}
    la a = "build/test-ncb-stream-a.ncbs"
    la b = "build/test-ncb-stream-b.ncbs"
    la skreve = stream.skriv_fil(a, ncb)
    assert_eq(skreve["status"], "ok")
    assert_eq(skreve["abi"], "norscode-ncb-stream-v1")
    assert(stream.er_stream_fil(a))

    la rapport = stream.les_fil_rapport(a, 4096)
    la lest = rapport["value"]
    assert_eq(lest["entry"], "mod.start")
    assert_eq(lest["functions"]["mod.f137"]["code"][0][1], 137)
    assert_eq(lest["functions"]["mod.start"]["code"][0][1], 7)
    assert_eq(heltall_fra_tekst(rapport["records"]), 201)
    assert(heltall_fra_tekst(rapport["chunks"]) > 1)
    assert(heltall_fra_tekst(rapport["max_record"]) < heltall_fra_tekst(skreve["bytes"]))

    la lazy = stream.les_fil_lazy(a, 4096)
    assert(har_nokkel(lazy["functions"]["mod.f137"], "__ncb_lazy_json__"))
    assert(builtin.contains(lazy["functions"]["mod.f137"]["__ncb_lazy_json__"], "\"PUSH_CONST\",137"))

    stream.skriv_fil(b, lest)
    assert_eq(builtin.sha256_bytes(fil_les_binær(a)), builtin.sha256_bytes(fil_les_binær(b)))
    fil_slett(a)
    fil_slett(b)
    skriv("test_ncb_stream_roundtrip OK")
    returner 0
}
