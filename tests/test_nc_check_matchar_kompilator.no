bruk std.tekst som t

// «Eit check som ikkje matchar kompilatoren er verre enn ingen check.»
//
// Invarianten: `nc check` MÅ godta nøyaktig det `nc compile` godtar. Det er i
// dag oppfylt VED KONSTRUKSJON — nc_check kallar same nc_kompiler_fil som
// compile-vegen — men ingenting hindra at nokon seinare gav check ein eigen,
// lettare parser «for fart». Då ville check kunne seie OK på kode kompilatoren
// avviser, og feilen ville fyrst dukke opp ved deploy.
//
// MERK: semikolon er FULLT STØTTA i denne versjonen (lexer_m1 handterer ";"),
// både som terminator og separator — verifisert med check/compile/run. Rapportar
// om at «check godtek ; medan kompilatoren avviser det» kjem frå ein ELDRE
// runtime på serveren, ikkje frå divergens i denne toolchainen. Å stramme inn
// check her ville brote gyldig kode.
funksjon start() -> heiltall {
    la nc = fil_les("selfhost/nc_main.no")

    // 1) check MÅ gå gjennom den felles kompilatorinngangen.
    la check_idx = t.finn(nc, "funksjon nc_check(")
    assert(check_idx >= 0)
    la kropp = builtin.slice(nc, check_idx, check_idx + 400)
    assert(t.inneholder(kropp, "nc_kompiler_fil("))

    // 2) check skal IKKJE ha ein eigen parser-/lexer-veg.
    assert(ikkje t.inneholder(kropp, "lexer_m1.lex("))
    assert(ikkje t.inneholder(kropp, "parse_program("))

    // 3) Semikolon er ein støtta token i lexeren — check skal ikkje avvise han.
    la lex = fil_les("selfhost/lexer/lexer_m1.no")
    assert(t.inneholder(lex, "tegn == \";\""))

    skriv("test_nc_check_matchar_kompilator OK\n")
    returner 0
}
