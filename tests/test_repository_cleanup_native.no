bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk tools.repository_cleanup_core som cleanup

funksjon skriv_fil(sti: tekst) {
    builtin.fil_skriv(sti, "test")
}

funksjon start() -> heiltall {
    assert(cleanup.rydd("/", sann) == -1)
    assert(cleanup.rydd("/tmp", sann) == -1)
    skriv("cleanup safety OK\n")

    la repo = miljo_hent("NORSCODE_ROOT")
    hvis repo == "" { repo = tekst(builtin.system_info()["cwd"]) }
    la rot = repo + "/build/test-fixtures/norscode-cleanup-test-" + builtin.random_hex(10)
    assert(filops.lag_katalogar(rot + "/src/__pycache__"))
    assert(filops.lag_katalogar(rot + "/src/__MACOSX"))
    assert(filops.lag_katalogar(rot + "/src/tom"))
    assert(filops.lag_katalogar(rot + "/.git/objects"))
    assert(filops.lag_katalogar(rot + "/build/nested"))
    assert(filops.lag_katalogar(rot + "/dist"))
    assert(filops.lag_katalogar(rot + "/release"))
    assert(filops.lag_katalogar(rot + "/artifacts"))
    skriv_fil(rot + "/norcode.toml")
    skriv_fil(rot + "/src/main.no")
    skriv_fil(rot + "/src/__pycache__/cache.pyc")
    skriv_fil(rot + "/src/__MACOSX/junk")
    skriv_fil(rot + "/src/cache.pyc")
    skriv_fil(rot + "/src/cache.pyo")
    skriv_fil(rot + "/src/cache.tmp")
    skriv_fil(rot + "/src/cache.bak")
    skriv_fil(rot + "/src/cache.old")
    skriv_fil(rot + "/src/run.log")
    skriv_fil(rot + "/src/.DS_Store")
    skriv_fil(rot + "/src/tmp_generated")
    skriv_fil(rot + "/src/debug_trace")
    skriv_fil(rot + "/build/nested/output.bin")
    skriv_fil(rot + "/.git/objects/keep")

    la rmdir_probe = native_fs.native_slett_mappe("/", builtin.slice(rot + "/src/tom", 1, lengde(rot + "/src/tom")))
    skriv("cleanup rmdir probe=" + tekst(rmdir_probe["status"]) + ":" + tekst(rmdir_probe["error"]) + "\n")
    assert(rmdir_probe["status"] == "deleted")

    la lett = cleanup.rydd(rot, usann)
    skriv("cleanup light=" + tekst(lett) + "\n")
    assert(lett >= 6)
    assert(ikkje filops.katalog_finnes(rot + "/src/__pycache__"))
    assert(ikkje filops.fil_finnes(rot + "/src/cache.pyc"))
    assert(ikkje filops.fil_finnes(rot + "/src/cache.tmp"))
    assert(ikkje filops.fil_finnes(rot + "/src/.DS_Store"))
    assert(ikkje filops.fil_finnes(rot + "/src/tmp_generated"))
    assert(ikkje filops.fil_finnes(rot + "/src/debug_trace"))
    assert(filops.katalog_finnes(rot + "/src/__MACOSX"))
    assert(filops.fil_finnes(rot + "/src/cache.pyo"))
    assert(filops.fil_finnes(rot + "/src/run.log"))
    assert(filops.katalog_finnes(rot + "/build"))
    assert(filops.fil_finnes(rot + "/.git/objects/keep"))

    la full = cleanup.rydd(rot, sann)
    skriv("cleanup full=" + tekst(full) + "\n")
    assert(full >= 8)
    assert(ikkje filops.katalog_finnes(rot + "/src/__MACOSX"))
    assert(ikkje filops.fil_finnes(rot + "/src/cache.pyo"))
    assert(ikkje filops.fil_finnes(rot + "/src/cache.bak"))
    assert(ikkje filops.fil_finnes(rot + "/src/cache.old"))
    assert(ikkje filops.fil_finnes(rot + "/src/run.log"))
    assert(ikkje filops.katalog_finnes(rot + "/build"))
    assert(ikkje filops.katalog_finnes(rot + "/dist"))
    assert(ikkje filops.katalog_finnes(rot + "/release"))
    assert(ikkje filops.katalog_finnes(rot + "/artifacts"))
    assert(filops.fil_finnes(rot + "/src/main.no"))
    assert(filops.fil_finnes(rot + "/.git/objects/keep"))

    assert(filops.slett_tre(rot))
    skriv("test_repository_cleanup_native OK\n")
    returner 0
}
