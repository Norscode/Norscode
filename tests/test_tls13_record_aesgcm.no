bruk std.tls13_record som rec

// TLS 1.3 record-lag med AES-128-GCM (RFC 8446 §5, TLS_AES_128_GCM_SHA256).
// Verifiserer integrasjonen av std.aes_gcm (NIST-verifisert) i record-laget:
// nøkkellengd, round-trip, differensiell (≠ ChaCha), tag-tukling og seq-binding.

funksjon _rep(v: heiltall, n: heiltall) -> liste_heiltall {
    la u: liste_heiltall = []
    la i = 0
    mens i < n { legg_til(u, v) i = i + 1 }
    returner u
}

funksjon _kopi(v: liste_heiltall) -> liste_heiltall {
    la u: liste_heiltall = []
    la i = 0
    mens i < lengde(v) { legg_til(u, v[i]) i = i + 1 }
    returner u
}

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la s = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(s, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(s, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la secret = _rep(11, 32)
    la tk = rec.traffic_keys_aesgcm(secret)
    // AES-128: 16-byte nøkkel, 12-byte IV.
    assert(lengde(tk["key"]) == 16)
    assert(lengde(tk["iv"]) == 12)

    // Round-trip: "hello" som application_data (type 23) på seq 0.
    la pt = [104, 101, 108, 108, 111]
    la post = rec.krypter_post_aesgcm(tk["key"], tk["iv"], 0, 23, pt)
    // Post = header(5) || ciphertext(6) || tag(16) = 27 byte. Inner = plaintext(5)
    // + content_type(1) = 6, og ciphertext har same lengd i CTR-modus.
    assert(lengde(post) == 5 + 6 + 16)
    assert(post[0] == 23 og post[1] == 3 og post[2] == 3)

    la d = rec.dekrypter_post_aesgcm(tk["key"], tk["iv"], 0, post)
    assert(d["status"] == "ok")
    assert(d["type"] == 23)
    assert(_hex(d["plaintext"]) == _hex(pt))

    // Differensiell: AES-GCM-posten skal skilje seg frå ChaCha-posten (annan AEAD).
    la tkc = rec.traffic_keys(secret)
    la post_chacha = rec.krypter_post(tkc["key"], tkc["iv"], 0, 23, pt)
    assert(_hex(post) != _hex(post_chacha))

    // Tuklet ciphertext-byte -> verifisering feilar.
    la tuklet = _kopi(post)
    tuklet[5] = tuklet[5] ^ 1
    assert(rec.dekrypter_post_aesgcm(tk["key"], tk["iv"], 0, tuklet)["status"] == "feil")

    // Feil sekvensnummer -> feil nonce -> verifisering feilar.
    assert(rec.dekrypter_post_aesgcm(tk["key"], tk["iv"], 1, post)["status"] == "feil")

    skriv("test_tls13_record_aesgcm: OK\n")
    returner 0
}
