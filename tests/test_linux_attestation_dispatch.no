// Kandidatbunden attestasjon må køyre proben, ikkje ein arva selftest/driver.
bruk tools.linux_runtime_attestation som attest
bruk tools.process_runner som prosess
bruk std.filops som filops

funksjon svar(status: tekst, kode: tekst, output: tekst) -> ordbok_tekst {
    returner {"status": status, "exit_code": kode, "stdout": output, "stderr": ""}
}

funksjon start() -> heiltall {
    la markør = "linux_attestation_dispatch OK"
    assert(attest.test_bestått(svar("ferdig", "0", markør), markør))
    assert(ikkje attest.test_bestått(svar("ferdig", "0", "test OK"), markør))
    assert(ikkje attest.test_bestått(svar("ferdig", "0", "Norscode - nc help"), markør))
    assert(ikkje attest.test_bestått(svar("ferdig", "1", markør), markør))
    assert(ikkje attest.test_bestått(svar("timeout", "124", markør), markør))
    assert(ikkje attest.test_bestått(svar("ferdig", "0", markør), ""))
    la kilde_argv = attest.test_argv("/repo", "probe.no", "")
    assert_eq(kilde_argv[0], "run")
    assert_eq(kilde_argv[1], "/repo/probe.no")
    la ncb_argv = attest.test_argv("/repo", "probe.no", "/repo/probe.ncb.json")
    assert_eq(ncb_argv[0], "run-ncb")
    assert_eq(ncb_argv[1], "/repo/probe.ncb.json")

    la root = attest.env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = attest.env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = tekst(builtin.system_info()["executable"]) }
    la rel = "build/linux-attestation-dispatch-" + tekst(builtin.tid_ms())
    assert(filops.lag_katalogar(root + "/" + rel))
    la kjelde = rel + "/probe.no"
    la sti = root + "/" + kjelde
    la ncb = root + "/" + rel + "/probe.ncb.json"
    la feil_miljø = {"NORSCODE_CMD": "selftest", "NORSCODE_FILE": root + "/manglar.no"}
    fil_skriv(sti, "funksjon start() -> heiltall { skriv(\"linux_attestation_dispatch OK\\n\") returner 0 }\n")
    assert(attest.køyr(root, native, kjelde, "", feil_miljø, "kjelde", markør))
    la kompilert = prosess.køyr(native, ["compile", sti, ncb], root,
        {"NORSCODE_ROOT": root, "NORSCODE_CMD": "compile", "NORSCODE_FILE": sti,
         "NORSCODE_OUTPUT": ncb}, 120000)
    prosess.skriv_resultat(kompilert)
    assert(prosess.ok(kompilert))
    // NCB-en må verke òg etter at kjeldefila er endra til feil program.
    fil_skriv(sti, "funksjon start() -> heiltall { skriv(\"test OK\\n\") returner 0 }\n")
    assert(attest.køyr(root, native, kjelde, ncb, feil_miljø, "NCB", markør))
    assert(ikkje attest.køyr(root, native, kjelde, "", feil_miljø, "manglande markør", markør))
    fil_skriv(sti, "funksjon start() -> heiltall { skriv(\"linux_attestation_dispatch OK\\n\") returner 23 }\n")
    assert(ikkje attest.køyr(root, native, kjelde, "", feil_miljø, "feilkode", markør))
    assert(filops.slett_tre(root + "/" + rel))
    skriv("test_linux_attestation_dispatch OK\n")
    returner 0
}
