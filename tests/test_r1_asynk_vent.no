# R1 / F18: norske nøkkelord `asynk`/`vent` som synonym for `async`/`await`.
# Begge er kontekstuelle: `asynk` berre rett før `funksjon`, `vent` berre rett
# før eit namn på same linje. Elles er dei vanlege identifikatorar (std brukar
# `la asynk = …`, `la vent = 1`, `funksjon vent(…)`, `builtin.vent.sov`).
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # samtidigheit/p09: asynk funksjon + vent på kallet.
    la p09 = "asynk funksjon f(x: heiltall) -> heiltall {\n" +
        "    returner x + 1\n" +
        "}\n" +
        "funksjon start() -> tekst {\n" +
        "    la v = vent f(1)\n" +
        "    returner \"asynk/vent: \" + tekst(v)\n" +
        "}\n"
    assert_eq(utfor(p09), "asynk/vent: 2")

    # `asynk funksjon` gjev same NCB-merke som `async funksjon`.
    la ncb_tekst = kompiler.kompiler_fil("asynk funksjon g() -> heiltall { returner 1 }\nfunksjon start() -> heiltall { returner 0 }\n", "__main__")
    assert(builtin.index_of(ncb_tekst, "\"is_async\":true") >= 0)

    # Som vanlege namn: variabel, funksjon og variabel sist på ei linje.
    la p_namn = "funksjon vent(a: heiltall) -> heiltall { returner a * 10 }\n" +
        "funksjon start() -> tekst {\n" +
        "    la asynk = 5\n" +
        "    la w = vent(2)\n" +
        "    la ventetid = 1\n" +
        "    la t = ventetid\n" +
        "    la v = asynk\n" +
        "    la o = {\"vent\": 3}\n" +
        "    returner tekst(asynk) + \",\" + tekst(w) + \",\" + tekst(v + t) + \",\" + tekst(o[\"vent\"])\n" +
        "}\n"
    assert_eq(utfor(p_namn), "5,20,6,3")

    la p_var = "funksjon start() -> tekst {\n" +
        "    la vent = 1\n" +
        "    la maks = 8\n" +
        "    mens vent < maks { vent = vent * 2 }\n" +
        "    la v = vent\n" +
        "    la ut = tekst(v)\n" +
        "    returner ut\n" +
        "}\n"
    assert_eq(utfor(p_var), "8")
    returner 0
}
