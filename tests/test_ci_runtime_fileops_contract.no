bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/ci_runtime_fileops.no")
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "native_sett_modus_sti(mål, 493)"))
    assert(t.inneholder(src, "builtin.fil_sett_kjorbar(mål)"))
    assert(ikkje t.inneholder(src, "/bin/chmod"))
    assert(t.inneholder(src, "NORSCODE_CI_FILE_SOURCE"))
    assert(t.inneholder(src, "NORSCODE_CI_FILE_TARGET"))
    assert(t.inneholder(src, "prosess.køyr(mål, [mål, \"selftest\"]"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "chmod +x"))
    skriv("test_ci_runtime_fileops_contract OK\n")
    returner 0
}
