bruk std.base32 som base32
bruk std.totp som totp

funksjon start() -> heiltall {
    assert(base32.kod("foobar") == "MZXW6YTBOI======")
    assert(base32.dekod("MZXW6YTBOI======") == "foobar")
    assert(base32.dekod("mzxw6-ytboi") == "foobar")

    // RFC 6238 Appendix B, SHA256, T=59, 8 siffer.
    la secret = "12345678901234567890123456789012"
    la secret_bytes: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(secret) {
        legg_til(secret_bytes, builtin.char_code(secret[i]))
        i = i + 1
    }
    la encoded = base32.kod_bytes(secret_bytes, usann)
    assert(totp.kode(encoded, 59, 30, 8) == "46119246")
    assert(totp.verifiser(encoded, "46119246", 59, 30, 8, 1))
    assert(ikkje totp.verifiser(encoded, "46119247", 59, 30, 8, 1))
    assert(builtin.contains(totp.otpauth_uri("Norscode", "brukar", encoded, 30, 8), "algorithm=SHA256"))
    skriv("test_base32_totp_rfc6238 OK")
    returner 0
}
