bruk std.tekst som t
bruk std.tempfile som tf

funksjon start() -> heiltall {
    la src = fil_les("std/tempfile.no")
    assert(t.inneholder(src, "Byggjer og registrerer mellombels ressursar i Norscode"))
    assert(t.inneholder(src, "versjonerte filesystem-ABI-en"))
    assert(t.inneholder(src, "native_fs.native_list(rot, relativ)"))
    assert(t.inneholder(src, "native_fs.native_slett(rot, relativ)"))
    assert(t.inneholder(src, "builtin.random_hex(12)"))
    assert(t.inneholder(src, "builtin.mkdir_p(kandidat)"))
    assert(t.inneholder(src, "returner builtin.fil_finnes(obj[\"sti\"])"))

    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "mktemp "))
    assert(ikkje t.inneholder(src, "rm -f"))
    assert(ikkje t.inneholder(src, "rm -rf"))

    la fil = tf.ny_tempfil("norscode_test_", ".txt")
    assert(tf.eksisterer(fil))
    tf.skriv_tempfil(fil, "temp-ok")
    assert(tf.les_tempfil(fil) == "temp-ok")
    assert(tf.slett(fil))
    assert(ikkje tf.eksisterer(fil))

    la katalog = tf.ny_tempkatalog("norscode_test_")
    builtin.mkdir_p(tf.sti(katalog) + "/under")
    builtin.fil_skriv(tf.sti(katalog) + "/under/data.txt", "tre-ok")
    assert(builtin.fil_finnes(tf.sti(katalog) + "/under/data.txt"))
    la katalog_sletta = tf.slett_katalog(katalog)
    assert(ikkje builtin.fil_finnes(tf.sti(katalog) + "/under/data.txt"))
    hvis katalog_sletta { assert(ikkje tf.eksisterer(katalog)) }
    ellers { assert(tf.eksisterer(katalog)) }

    skriv("test_tempfile_shell_quote OK")
    returner 0
}
