// Compile and execute the real native allocator/marker, with no larger heap.
bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon miljø(root: tekst) -> ordbok_tekst {
    returner {"NORSCODE_ROOT": root, "NORSCODE_CMD": "", "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "", "NORSCODE_GC_ALLOC": "1", "NC_BUILTIN_REPORT": "1",
        "NC_BUILTIN_KVITLISTE": "",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"}
}

funksjon krev_ok(r: ordbok_tekst) {
    hvis ikkje prosess.ok(r) {
        prosess.skriv_resultat(r)
        assert_eq(tekst(r["status"]) + "/" + tekst(r["exit_code"]), "ferdig/0")
    }
}

funksjon bygg(root: tekst, runtime: tekst, kjelde: tekst, ut: tekst) {
    la cg: tekst = miljo_hent("NORSCODE_GC_TEST_CODEGEN")
    hvis cg == "" {
        krev_ok(prosess.køyr(runtime, ["bygg-native", "--target", "linux-x86_64", kjelde, ut],
            root, miljø(root), 300000))
        returner
    }
    la ncb: tekst = ut + ".ncb.json"
    krev_ok(prosess.køyr(runtime, ["bundle", "--output", ncb, kjelde], root, miljø(root), 300000))
    la env = miljø(root)
    env["NC_INPUT"] = ncb
    env["NC_OUTPUT"] = ut
    la r = prosess.køyr(cg, [], root, env, 300000)
    krev_ok(r)
    assert(builtin.contains(tekst(r["stdout"]), "uløyste=0 uventa=0"))
    assert(builtin.fil_sett_kjorbar(ut))
    filops.slett_fil(ncb)
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la maskin: tekst = tekst(info["machine"])
    hvis tekst(info["system"]) != "Linux" eller (maskin != "x86_64" og maskin != "amd64") {
        skriv("test_native_gc_large_bytes: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root: tekst = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la runtime: tekst = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la ut: tekst = "/tmp/norscode_gc_large_" + builtin.random_hex(8)
    bygg(root, runtime, root + "/tests/fixtures/gc_large_bytes_probe.no", ut)
    la env = miljø(root)
    env["NC_GC_PROBE_FILE"] = ut + ".bin"
    for modus i ["roots", "flat"] {
        env["NC_GC_PROBE_MODE"] = modus
        la r = prosess.køyr(ut, [], root, env, 120000)
        krev_ok(r)
        assert(builtin.contains(tekst(r["stdout"]), "gc_large_bytes " + modus + " OK:"))
        prosess.skriv_resultat(r)
    }
    filops.slett_fil(ut + ".bin")
    filops.slett_fil(ut)
    skriv("test_native_gc_large_bytes OK\n")
    returner 0
}
