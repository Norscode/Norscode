// Same scenario kan køyrast tolka (kjelde-ruta) og som bygg-native-binær
// (offentleg builtin/network-ABI). Ingen av desse feila skal opne ein sokkel.
bruk std.native_gap som ng
bruk std.socket som socket

funksjon avvis(req: ordbok, grunn: tekst) {
    la r = ng.network_operation(req)
    assert_eq(r["status"], "feil")
    assert_eq(r["handle"], "")
    assert(builtin.contains(r["error"], grunn))
}

funksjon start() -> heiltall {
    la tidlegare_ca = builtin.miljo_hent("NORSCODE_TLS_CA_FILE")
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", "")
    la req = {"abi": socket.native_versjon(), "operation": "tls_connect",
        "host": "127.0.0.1", "port": "1", "hostname": "localhost", "ca_file": ""}
    avvis(req, "TLS CA file required")
    // Ukjende «insecure»/rånøkkel-opsjonar må ikkje opne eit smotthol i ABI-en.
    req["test_raw_peer_key"] = [1, 2, 3]
    req["insecure"] = "1"
    avvis(req, "TLS CA file required")
    req["ca_file"] = "tests/fixtures/tls/does-not-exist.crt"
    avvis(req, "TLS CA unavailable or invalid")
    req["ca_file"] = "std/tls13_session.no"
    avvis(req, "TLS CA unavailable or invalid")
    req["ca_file"] = "tests/fixtures/tls/localhost-ed25519.crt"
    req["hostname"] = ""
    avvis(req, "TLS hostname required")
    req["hostname"] = "localhost"
    req["client_cert_file"] = "tests/fixtures/tls/does-not-exist.crt"
    req["client_key_file"] = "tests/fixtures/tls/does-not-exist.key"
    avvis(req, "TLS client certificate or key unavailable")
    // Same strenge filkontroll for eksplisitt miljøkonfigurasjon. Eit gyldig
    // miljøanker når fram til klientsertifikatkontrollen, utan å opne sokkel.
    req["ca_file"] = ""
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", "std/tls13_session.no")
    avvis(req, "TLS CA unavailable or invalid")
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", "tests/fixtures/tls/localhost-ed25519.crt")
    avvis(req, "TLS client certificate or key unavailable")
    req["ca_file"] = "tests/fixtures/tls/does-not-exist.crt"
    avvis(req, "TLS CA unavailable or invalid") // eksplisitt argument vinn
    req["crl_file"] = "tests/fixtures/tls/revoked-localhost.crl.pem"
    avvis(req, "TLS client CRL verification unsupported")
    req["crl_file"] = ""
    req["require_ocsp"] = "1"
    avvis(req, "TLS OCSP verification unsupported")
    req["require_ocsp"] = sann
    avvis(req, "TLS OCSP verification unsupported")
    la listener = {"abi": socket.native_versjon(), "operation": "tls_listen",
        "host": "127.0.0.1", "port": "0", "client_crl_file": "missing.crl"}
    avvis(listener, "TLS server CRL verification unsupported")
    listener["client_crl_file"] = "tests/fixtures/tls/revoked-client-ed25519.crl.pem"
    avvis(listener, "TLS server CRL verification unsupported")
    builtin.miljo_sett("NORSCODE_TLS_CA_FILE", tidlegare_ca)
    skriv("test_tls13_network_trust OK\n")
    returner 0
}
