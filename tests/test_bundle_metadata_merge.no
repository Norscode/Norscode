bruk selfhost.bundler som bundler

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(fil_les("build/vm_phase8_fixed6_direct.ncb.json"))
    la initializers = []
    la global_names = {}
    assert(bundler.slå_saman_modulmetadata(initializers, global_names, ncb) == 0)
    assert(lengde(initializers) == 1)
    assert(initializers[0] == "selfhost.vm.__module_init__")
    assert(finnes_nøkkel(global_names, "selfhost.vm"))
    assert(lengde(global_names["selfhost.vm"]) == 10)
    skriv("test_bundle_metadata_merge OK\n")
    returner 0
}
