bruk selfhost.bundler som bundler

// J1b: syntetisk fikstur i staden for build/vm_phase8_fixed6_direct.ncb.json
// (som vart avleidd av committa bootstrap/precompiled-NCB). Ein modul med
// __module_init__, module_initializers og ti global_names.
funksjon fikstur_ncb() -> ordbok {
    la kode = []
    la namn = []
    la i: heiltall = 0
    mens i < 10 {
        la g = "vm_global_" + tekst_fra_heltall(i)
        legg_til(namn, g)
        legg_til(kode, ["PUSH_CONST", i])
        legg_til(kode, ["STORE_GLOBAL", g])
        i = i + 1
    }
    legg_til(kode, ["PUSH_CONST", 0])
    legg_til(kode, ["RETURN"])
    la fns = {}
    fns["selfhost.vm.__module_init__"] = {
        "name": "__module_init__", "module": "selfhost.vm", "params": [],
        "is_async": usann, "code": kode
    }
    la globalar = {}
    globalar["selfhost.vm"] = namn
    returner {
        "format": "norscode-bytecode-v1",
        "entry": "selfhost.vm.start",
        "functions": fns,
        "module_initializers": ["selfhost.vm.__module_init__"],
        "global_names": globalar
    }
}

funksjon start() -> heiltall {
    // JSON-rundtur som i bundle-vegen (tekst → json_parse_raw).
    la ncb = builtin.json_parse_raw(builtin.json_skriv(fikstur_ncb()))
    la initializers = []
    la global_names = {}
    assert(bundler.slå_saman_modulmetadata(initializers, global_names, ncb) == 0)
    assert(lengde(initializers) == 1)
    assert(initializers[0] == "selfhost.vm.__module_init__")
    assert(finnes_nøkkel(global_names, "selfhost.vm"))
    assert(lengde(global_names["selfhost.vm"]) == 10)
    // Andre samanslåing av same modul skal ikkje duplisere noko.
    assert(bundler.slå_saman_modulmetadata(initializers, global_names, ncb) == 0)
    assert(lengde(initializers) == 1)
    assert(lengde(global_names["selfhost.vm"]) == 10)
    skriv("test_bundle_metadata_merge OK\n")
    returner 0
}
