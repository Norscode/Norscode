# W9: synk-klienten i Chrome, del 2 (same testklient og testapp som tests/test_synk_klient_chrome.no).
# Chrome-stega er VALFRIE (SKIP utan Chrome; NC_CHROME=<sti>).
#
# Same profil «c» gjennom heile testen:
#   steg=b1  u1 loggar inn, vel «Hugs denne eininga» og skriv ei oppgåve (synka)
#   steg=4   409 (tenaren mistar den første op-en i ein batch; klienten sender frå siste_seq + 1),
#            410 (ny epoke: ny klient-id, seq frå 1, full pull), 401 (sesjonen går ut: køa blir
#            verande; etter ny innlogging blir ho send)
#   steg=b2  u2 loggar inn på same eining: hendinga «brukarbyte», ingen av oppgåvene til u1 er
#            synlege, og u2 får sin eigen database
#   /test/faner  to faner (toppsida og ei iframe) i same profil: éi er leiar, fana som ikkje er
#            leiar skriv, og den andre ser endringa med ein gong; begge blir synka; fana i
#            iframen slettar databasen, og toppsida får versionchange («db_endra»)
#   steg=ut  «Logg ut» på sida: databasen blir sletta og tenaren avsluttar sesjonen
#   steg=etter_ut  ingen sesjon: «ikkje innlogga», ingenting på eininga
# Ingen lasting har «Uncaught».
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.apptenar_hjelp som ah
bruk tests.fixtures.synk_klient_chrome_hjelp som ch

funksjon utmappe() -> tekst { returner "build/wasm/test_synk_faner/testbygg" }

funksjon port() -> tekst { returner "48641" }

funksjon fasit_b1() -> tekst {
    returner ch.linjer(["steg b1", "u1: Alt er synka og lagra på eininga. | 1 oppgåve | [U1 si oppgåve]", "ferdig"])
}

funksjon fasit_4() -> tekst {
    returner ch.linjer(["steg 4",
        "409: hol | synka ventar=0",
        "410: resync | synka ventar=0",
        "401: Du er ikkje innlogga. 1 endring ventar på eininga. | 5 oppgåver | [U1 si oppgåve, Hol 1, Hol 2, Etter restore, Utan sesjon*]",
        "innlogga att: Alt er synka og lagra på eininga. | 5 oppgåver | [U1 si oppgåve, Hol 1, Hol 2, Etter restore, Utan sesjon]",
        "ferdig"])
}

funksjon fasit_b2() -> tekst {
    returner ch.linjer(["steg b2",
        "u2: brukarbyte | Ein annan brukar var innlogga på denne eininga. Oppgåvene hans blir ikkje viste. | [] | hugs=usann",
        "u2 synka: Alt er synka og lagra på eininga. | 1 oppgåve | [U2 si oppgåve]",
        "ferdig"])
}

funksjon fasit_fa() -> tekst {
    returner ch.linjer(["steg fa", "a klar", "a såg b", "a synka: [U2 si oppgåve, Frå fane B, Frå fane A] leiar=*",
        "a: Oppgåvene vart endra i ei anna fane. Last sida på nytt.", "ferdig"])
}

funksjon fasit_ut() -> tekst {
    returner ch.linjer(["steg ut", "logga ut: Du er logga ut. | 0 oppgåver | []", "ferdig"])
}

funksjon fasit_etter_ut() -> tekst {
    returner ch.linjer(["steg etter_ut", "etter utlogging: Du er ikkje innlogga. | [] | hugs=usann", "ferdig"])
}

# «leiar=sann» eller «leiar=usann» i linja → «leiar=*» (kven som får låsen først, varierer).
funksjon utan_leiar(t: tekst) -> tekst {
    returner builtin.replace(builtin.replace(t, "leiar=sann", "leiar=*"), "leiar=usann", "leiar=*")
}

funksjon start() -> heltall {
    ch.bygg(utmappe())
    hvis benk.finn_chrome() == "" {
        skriv("test_synk_klient_faner OK (bygg; SKIP Chrome: fann ikkje Chrome/Chromium, set NC_CHROME=<sti>)\n")
        returner 0
    }
    la økt = benk.ny_økt("test_synk_faner")
    la data = ah.ny_datamappe("synk-faner")
    la app = ch.start_tenar(utmappe(), data, port())
    utsett {
        ah.stopp(app["h"])
        benk.rydd(økt)
    }
    ch.krev_logg("steg b1 (u1 med hugs)", ch.last(økt, port(), "/test?steg=b1&u=u1", "c"), fasit_b1())
    ch.krev_logg("steg 4 (409, 410, 401)", ch.last(økt, port(), "/test?steg=4", "c"), fasit_4())
    skriv("409: tenaren mista den første op-en, klienten sende frå siste_seq + 1; 410: ny klient-id og full pull; 401: køa vart verande til ny innlogging\n")
    ch.krev_logg("steg b2 (brukarbyte)", ch.last(økt, port(), "/test?steg=b2&u=u2", "c"), fasit_b2())
    skriv("brukarbyte: u2 såg ingen av oppgåvene til u1 og fekk sin eigen database\n")
    la fa = ch.last(økt, port(), "/test/faner?steg=fa", "c")
    la fa_leiar = builtin.index_of(fa["logg"], "leiar=sann") >= 0
    fa["logg"] = utan_leiar(fa["logg"])
    ch.krev_logg("to faner (toppsida)", fa, fasit_fa())
    la rapp = ah.kall(app["port"], "GET", "/test/rapportar", {}, "")["body"]
    la venta_b = ["fb steg fb", "fb b klar", "fb b såg a: [U2 si oppgåve, Frå fane B, Frå fane A] leiar=", "fb b: Oppgåvene vart endra i ei anna fane. Last sida på nytt.", "fb ferdig"]
    la i = 0
    mens i < lengde(venta_b) {
        hvis builtin.index_of(rapp, venta_b[i]) < 0 {
            skriv("iframe-fana: fann ikkje «" + venta_b[i] + "» i rapportane:\n" + rapp + "\n")
            assert(usann)
        }
        i = i + 1
    }
    la fb_leiar = builtin.index_of(rapp, "leiar=sann") >= 0
    # Éi og berre éi fane er leiar (Web Locks)
    hvis fa_leiar == fb_leiar {
        skriv("venta nøyaktig éin leiar: toppsida=" + tekst(fa_leiar) + " iframen=" + tekst(fb_leiar) + "\n" + rapp + "\n")
        assert(usann)
    }
    la kven = "iframen"
    hvis fa_leiar { kven = "toppsida" }
    skriv("to faner: leiaren var " + kven + "; fana som ikkje var leiar skreiv, den andre såg det straks, begge vart synka, og sletting i éi fane gav db_endra i den andre\n")
    ch.krev_logg("steg ut (logg ut på sida)", ch.last(økt, port(), "/test?steg=ut", "c"), fasit_ut())
    ch.krev_logg("steg etter_ut", ch.last(økt, port(), "/test?steg=etter_ut", "c"), fasit_etter_ut())
    skriv("logg ut: databasen sletta og sesjonen avslutta; neste lasting er ikkje innlogga og har ingenting på eininga\n")
    skriv("test_synk_klient_faner OK\n")
    returner 0
}
