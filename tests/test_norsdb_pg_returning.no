// Postgres-utvidingar batch 6: RETURNING på INSERT/UPDATE/DELETE.
// Golden = dokumentert PostgreSQL-semantikk (påverka rader, post-mutasjon-verdiar).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE t (id INTEGER, namn TEXT, poeng INTEGER)")

    // INSERT ... RETURNING id
    assert_eq(sql.query_text(db, "INSERT INTO t (id, namn, poeng) VALUES (1, 'Ada', 10) RETURNING id"), "1")
    // INSERT ... RETURNING *
    assert_eq(sql.query_rader(db, "INSERT INTO t (id, namn, poeng) VALUES (2, 'Bo', 20) RETURNING *"), "2|Bo|20")
    // INSERT ... RETURNING med uttrykk
    assert_eq(sql.query_rader(db, "INSERT INTO t (id, namn, poeng) VALUES (3, 'Cy', 30) RETURNING id, upper(namn)"), "3|CY")
    // exec med RETURNING gjev framleis rad-tal
    assert_eq(sql.exec(db, "INSERT INTO t (id, namn, poeng) VALUES (4, 'Di', 40) RETURNING id"), 1)

    // UPDATE ... RETURNING (post-mutasjon-verdi)
    assert_eq(sql.query_rader(db, "UPDATE t SET poeng = poeng + 5 WHERE id = 1 RETURNING id, poeng"), "1|15")
    // UPDATE fleire rader → fleire returrader (rad-orden)
    assert_eq(sql.query_rader(db, "UPDATE t SET poeng = 100 WHERE id >= 2 RETURNING id, poeng"), "2|100\n3|100\n4|100")

    // DELETE ... RETURNING
    assert_eq(sql.query_rader(db, "DELETE FROM t WHERE id = 4 RETURNING namn, poeng"), "Di|100")
    // DELETE som ikkje matchar → tomt returresultat
    assert_eq(sql.query_rader(db, "DELETE FROM t WHERE id = 99 RETURNING *"), "")

    // Sluttilstand
    assert_eq(sql.query_rader(db, "SELECT id, poeng FROM t ORDER BY id"), "1|15\n2|100\n3|100")

    returner 0
}
