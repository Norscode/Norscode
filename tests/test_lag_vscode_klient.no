// VS Code-klienten under archive/vscode-klient/ er GENERERT av
// tools/lag_vscode_klient.no: den innsjekka utgåva må vere lik generatoren sin
// utdata (ingen handredigering), og JS skal ikkje liggje i aktiv flate.
bruk tools.lag_vscode_klient som g

funksjon start() -> heiltall {
    la rot = g.rot()
    la feil = 0
    la js = g.extension_js()
    hvis fil_les(rot + "/archive/vscode-klient/extension.js") != js {
        skriv("FEIL: extension.js er utdatert; køyr nc run tools/lag_vscode_klient.no\n")
        feil = feil + 1
    }
    hvis fil_les(rot + "/archive/vscode-klient/package.json") != g.pen(g.pakke_json(), "") + "\n" {
        skriv("FEIL: package.json er utdatert\n")
        feil = feil + 1
    }
    hvis fil_les(rot + "/archive/vscode-klient/README.md") != g.readme_tekst() {
        skriv("FEIL: README.md er utdatert\n")
        feil = feil + 1
    }
    hvis ikkje builtin.contains(js, "new LanguageClient(") eller ikkje builtin.contains(js, "TransportKind.stdio") eller ikkje builtin.contains(js, "documentSelector") {
        skriv("FEIL: klienten startar ikkje ein stdio-språkklient\n")
        feil = feil + 1
    }
    la m = g.pakke_json()
    hvis m["main"] != "./extension.js" eller m["contributes"]["configuration"]["properties"]["norscode.server.command"]["default"] != "nc" eller m["dependencies"]["vscode-languageclient"] == null {
        skriv("FEIL: manifestet manglar main/avhengnad/innstilling\n")
        feil = feil + 1
    }
    // Ingen JS i aktiv vscode-mappe.
    hvis fil_finnes(rot + "/vscode-norscode/extension.js") {
        skriv("FEIL: extension.js skal ikkje ligge i vscode-norscode/ (aktiv flate)\n")
        feil = feil + 1
    }
    hvis feil > 0 { returner 1 }
    skriv("test_lag_vscode_klient OK\n")
    returner 0
}
