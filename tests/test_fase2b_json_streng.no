// tests/test_fase2b_json_streng.no — Fase 2.2
// Isolert test av std.native_gap.json_parse_raw_streng (streng typa JSON-parser).
// Køyrer på committa seed (rein funksjon). Verifiserer at:
//   (a) eit utval GYLDIGE JSON/NCB-døme parsar rett, med type og struktur lik
//       RT_JSON_PARSE (builtin.json_parse_raw), og
//   (b) eit utval UGYLDIGE døme KASTAR fangbar feil (ikkje null/delvis verdi).

bruk std.native_gap som ng

la feil_tal: heiltall = 0

funksjon sjekk(namn: tekst, vilkaar: boolsk) {
    hvis vilkaar {
        skriv("  [OK] " + namn + "\n")
    } ellers {
        skriv("  [FEIL] " + namn + "\n")
        feil_tal = feil_tal + 1
    }
}

// Rekursiv strukturell samanlikning (type/lengd/nøklar/verdi) — IKKJE
// json_stringify (som kan forgifte samanlikningar).
funksjon lik(a, b) -> boolsk {
    la ta = builtin.type(a)
    la tb = builtin.type(b)
    hvis ta != tb { returner usann }
    hvis ta == "ordbok" {
        la ka = nøkler(a)
        la kb = nøkler(b)
        hvis lengde(ka) != lengde(kb) { returner usann }
        la i: heiltall = 0
        mens i < lengde(ka) {
            la k = ka[i]
            hvis ikkje finnes_nøkkel(b, k) { returner usann }
            hvis ikkje lik(a[k], b[k]) { returner usann }
            i = i + 1
        }
        returner sann
    }
    hvis ta == "liste" {
        hvis lengde(a) != lengde(b) { returner usann }
        la i: heiltall = 0
        mens i < lengde(a) {
            hvis ikkje lik(a[i], b[i]) { returner usann }
            i = i + 1
        }
        returner sann
    }
    hvis ta == "ingenting" { returner sann }
    returner a == b
}

// Parse med både RT (lempeleg) og streng; krev at dei er strukturelt like.
funksjon gyldig(namn: tekst, json: tekst) {
    la rt = builtin.json_parse_raw(json)
    la streng = null
    la kasta = usann
    prøv {
        streng = ng.json_parse_raw_streng(json)
    } fang (e) {
        kasta = sann
    }
    hvis kasta {
        skriv("  [FEIL] " + namn + " — streng parser KASTA på gyldig input\n")
        feil_tal = feil_tal + 1
        returner 0
    }
    sjekk(namn + " (lik RT)", lik(rt, streng))
    returner 0
}

// Krev at streng parser KASTAR.
funksjon ugyldig(namn: tekst, json: tekst) {
    la kasta = usann
    prøv {
        la r = ng.json_parse_raw_streng(json)
    } fang (e) {
        kasta = sann
    }
    sjekk(namn + " (kastar)", kasta)
    returner 0
}

funksjon start() {
    skriv("=== Fase 2.2: streng json_parse_raw_streng ===\n")

    skriv("(a) GYLDIGE — struktur lik RT_JSON_PARSE:\n")
    gyldig("tomt objekt", "{}")
    gyldig("tom liste", "[]")
    gyldig("heiltall", "123")
    gyldig("negativt", "-42")
    gyldig("null-heiltall", "0")
    gyldig("desimal", "2.5")
    gyldig("desimal negativ", "-100.25")
    gyldig("eksponent", "1e3")
    gyldig("eksponent neg", "6.5E-2")
    gyldig("sann", "true")
    gyldig("usann", "false")
    gyldig("null", "null")
    gyldig("enkel streng", "\"hei\"")
    gyldig("streng escapes", "\"a\\nb\\tc\\r\\\"\\\\\"")
    gyldig("unicode aa", "\"\\u00e5\"")
    gyldig("unicode ae", "\"\\u00e6\"")
    gyldig("rå UTF-8 æøå", "\"æøå\"")
    gyldig("surrogatpar emoji", "\"\\ud83d\\ude00\"")
    gyldig("nøsta objekt", "{\"a\":1,\"b\":{\"c\":[2,3],\"d\":true},\"e\":null}")
    gyldig("liste av objekt", "[{\"x\":1},{\"y\":2}]")
    gyldig("NCB-liknande", "{\"entry\":\"start\",\"functions\":{\"start\":{\"instr\":[[\"PUSH_CONST\",1],[\"RET\"]],\"params\":[]}}}")
    gyldig("whitespace", "  {  \"a\" : [ 1 , 2 ] }  ")
    gyldig("stort heiltall", "1000003")
    gyldig("djup nøsting", "[[[[[[[[1]]]]]]]]")

    skriv("(b) UGYLDIGE — må kaste:\n")
    ugyldig("ufullstendig objekt", "{")
    ugyldig("ufullstendig liste", "[1,2")
    ugyldig("ubalansert", "{\"a\":1")
    ugyldig("hengande komma obj", "{\"a\":1,}")
    ugyldig("hengande komma liste", "[1,2,]")
    ugyldig("dobbel komma", "[1,,2]")
    ugyldig("leiande komma", "[,1]")
    ugyldig("søppel etter verdi", "[1,2]xyz")
    ugyldig("søppel etter obj", "{}abc")
    ugyldig("tal + søppel", "123abc")
    ugyldig("uavslutta streng", "\"abc")
    ugyldig("uavslutta escape", "\"abc\\")
    ugyldig("ugyldig escape", "\"a\\qb\"")
    ugyldig("avkutta \\u", "\"a\\u00\"")
    ugyldig("ugyldig \\u hex", "\"a\\uZZZZ\"")
    ugyldig("leiande null", "007")
    ugyldig("bart minus", "-")
    ugyldig("punktum utan brøk", "1.")
    ugyldig("eksponent utan siffer", "1e")
    ugyldig("tom input", "")
    ugyldig("berre whitespace", "   ")
    ugyldig("manglande kolon", "{\"a\" 1}")
    ugyldig("manglande nøkkel", "{1:2}")
    ugyldig("berre komma", ",")
    ugyldig("sann med søppel", "truex")

    hvis feil_tal == 0 {
        skriv("=== ALLE TESTAR BESTÅTT ===\n")
        returner 0
    }
    skriv("=== " + tekst(feil_tal) + " FEIL ===\n")
    returner 1
}
