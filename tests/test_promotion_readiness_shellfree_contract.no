bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/native_runtime_gap_promotion_readiness_v3003.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "[\"run\", root + \"/\" + verktøy]"))
    assert(t.inneholder(src, "\"PATH\": \"/nonexistent\""))
    assert(t.inneholder(src, "dist_changed\", \"usann"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "sh -c"))
    assert(ikkje t.inneholder(src, "test -f"))
    skriv("test_promotion_readiness_shellfree_contract OK")
    returner 0
}
