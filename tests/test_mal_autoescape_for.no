# Regresjon for std/mal.no (FA-122):
#   (a) autoescape som STANDARD for interpolerte verdiar
#   (b) |rå (raw/safe) slepp gjennom uendra
#   (c) @for over liste itererer faktisk (var broten: _hent_verdi stringifiserte
#       lista, så typen vart alltid "tekst" og løkka køyrde aldri)
bruk std.mal som mal

funksjon start() -> heltall {
    # (a) Autoescape som standard — <script> skal bli escapa
    la ctx: ordbok_tekst = {}
    ctx["namn"] = "<script>alert(1)</script>"
    assert_eq(mal.gjengi("Hei {{namn}}", ctx), "Hei &lt;script&gt;alert(1)&lt;/script&gt;")

    # & og " blir òg escapa
    la ctx_amp: ordbok_tekst = {}
    ctx_amp["v"] = "a & \"b\" < c"
    assert_eq(mal.gjengi("{{v}}", ctx_amp), "a &amp; &quot;b&quot; &lt; c")

    # (b) |rå slepp rå HTML gjennom
    assert_eq(mal.gjengi("{{namn|rå}}", ctx), "<script>alert(1)</script>")
    assert_eq(mal.gjengi("{{namn|raw}}", ctx), "<script>alert(1)</script>")
    assert_eq(mal.gjengi("{{namn|safe}}", ctx), "<script>alert(1)</script>")

    # Filter + autoescape: resultatet av |stor skal framleis escapast
    assert_eq(mal.gjengi("{{namn|stor}}", ctx), "&lt;SCRIPT&gt;ALERT(1)&lt;/SCRIPT&gt;")

    # (c) @for over liste av ordbøker — alle element skal komme ut, escapa
    la rader: liste<ordbok_tekst> = []
    la a: ordbok_tekst = {}
    a["tittel"] = "Ein"
    legg_til(rader, a)
    la b: ordbok_tekst = {}
    b["tittel"] = "To & <b>"
    legg_til(rader, b)
    la ctx2: ordbok_tekst = {}
    ctx2["rader"] = rader
    assert_eq(
        mal.gjengi("{{@for r i rader}}<li>{{r.tittel}}</li>{{@slutt}}", ctx2),
        "<li>Ein</li><li>To &amp; &lt;b&gt;</li>")

    # @for over liste av skalarar
    la tags: liste<tekst> = []
    legg_til(tags, "x")
    legg_til(tags, "y")
    legg_til(tags, "z")
    la ctx3: ordbok_tekst = {}
    ctx3["tags"] = tags
    assert_eq(mal.gjengi("{{@for t i tags}}[{{t}}]{{@slutt}}", ctx3), "[x][y][z]")

    skriv("test_mal_autoescape_for OK\n")
    returner 0
}
