// Postgres-utvidingar batch 3: vindusfunksjonar LAG/LEAD/FIRST_VALUE/LAST_VALUE/NTH_VALUE/NTILE.
// Golden = dokumentert PostgreSQL default-ramme-semantikk.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE sal (id INTEGER, avd TEXT, namn TEXT, belop INTEGER)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (1, 'A', 'Ada', 100)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (2, 'A', 'Bo', 100)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (3, 'A', 'Cy', 80)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (4, 'B', 'Di', 200)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (5, 'B', 'Ed', 150)")

    // LAG (default offset 1) — partisjon A: Cy(80),Ada(100),Bo(100); B: Ed(150),Di(200)
    assert_eq(sql.query_rader(db, "SELECT namn, LAG(belop) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|80\nBo|100\nCy|\nDi|150\nEd|")
    // LEAD
    assert_eq(sql.query_rader(db, "SELECT namn, LEAD(belop) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|100\nBo|\nCy|100\nDi|\nEd|200")
    // LAG med offset 2 og default -1
    assert_eq(sql.query_rader(db, "SELECT namn, LAG(belop, 2, -1) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|-1\nBo|80\nCy|-1\nDi|-1\nEd|-1")
    // FIRST_VALUE — fyrste i partisjonen
    assert_eq(sql.query_rader(db, "SELECT namn, FIRST_VALUE(namn) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|Cy\nBo|Cy\nCy|Cy\nDi|Ed\nEd|Ed")
    // LAST_VALUE — default-ramme = gjeldande rad (Postgres-quirk)
    assert_eq(sql.query_rader(db, "SELECT namn, LAST_VALUE(namn) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|Ada\nBo|Bo\nCy|Cy\nDi|Di\nEd|Ed")
    // NTH_VALUE(namn, 2) — NULL til ramma når rad 2
    assert_eq(sql.query_rader(db, "SELECT namn, NTH_VALUE(namn, 2) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|Ada\nBo|Ada\nCy|\nDi|Di\nEd|")
    // NTILE(2) — A: 3 rader→2/1, B: 2 rader→1/1
    assert_eq(sql.query_rader(db, "SELECT namn, NTILE(2) OVER (PARTITION BY avd ORDER BY belop) FROM sal ORDER BY namn"),
        "Ada|1\nBo|2\nCy|1\nDi|2\nEd|1")

    returner 0
}
