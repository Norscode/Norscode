bruk std.prosess som prosess
bruk std.sched som sched

funksjon start() -> heiltall {
    la policy = prosess.ny_policy("async-test")
    prosess.tillat_alle(policy)
    prosess.aktiver_køyring(policy)

    la signal_plan = prosess.start_plan("/bin/sleep 30")
    la signal_handle = prosess.start_async_trygt(policy, signal_plan, "ubrukt")
    assert_eq(signal_handle["status"], "kjorer")
    assert(prosess.async_signal(signal_handle, 15))
    assert_eq(signal_handle["status"], "signal")
    assert_eq(prosess.async_exit_code(signal_handle), 143)
    prosess.native_async_lukk(signal_handle)

    la plan = prosess.start_plan("/usr/bin/printf async-ok")
    prosess.med_timeout(plan, 5)
    la handle = prosess.start_async_trygt(policy, plan, "ubrukt")
    assert_eq(handle["status"], "kjorer")
    assert(prosess.async_pid(handle) > 0)
    la i: heiltall = 0
    mens i < 500 og prosess.async_status(handle) == "kjorer" {
        prosess.køyr("/bin/sleep 0.01")
        i = i + 1
    }
    assert_eq(prosess.async_status(handle), "ferdig")
    assert_eq(prosess.async_exit_code(handle), 0)
    assert_eq(prosess.async_les_stdout(handle), "async-ok")
    assert_eq(prosess.async_les_stdout(handle), "")
    assert_eq(prosess.async_les_stderr(handle), "")
    prosess.native_async_lukk(handle)

    la scheduler = sched.ny()
    la future_plan = prosess.start_plan("/usr/bin/printf future-ok")
    la future_handle = prosess.start_async_med_future(scheduler, policy, future_plan, "ubrukt")
    la j: heiltall = 0
    mens j < 500 og prosess.async_poll_future(scheduler, future_handle) == "ventende" {
        prosess.køyr("/bin/sleep 0.01")
        j = j + 1
    }
    assert_eq(sched.future_status(scheduler, future_handle["future_id"]), "ferdig")
    la resultat = builtin.json_parse(sched.future_resultat(scheduler, future_handle["future_id"]))
    assert_eq(resultat["exit_code"], "0")
    assert_eq(resultat["stdout"], "future-ok")
    prosess.native_async_lukk(future_handle)

    skriv("test_prosess_async OK")
    returner 0
}
