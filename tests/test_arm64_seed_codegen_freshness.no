bruk tools.build_arm64_seed som byggjar
bruk selfhost.native_execution.codegen_prebuilt som cgp

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la vert = cgp.vert_plattform()
    hvis vert != "macos-arm64" og vert != "linux-x86_64" {
        skriv("test_arm64_seed_codegen_freshness: krev køyrbar lokal codegen på macOS ARM64 eller Linux x86_64\n")
        returner 0
    }
    la kjelde = ""
    for rel i cgp.binær_stiar(vert, vert) {
        hvis kjelde == "" og builtin.fil_finnes(root + "/" + rel) { kjelde = root + "/" + rel }
    }
    assert(kjelde != "")
    la kandidatrot = root + "/build/arm64-provenance-" + builtin.random_hex(8)
    builtin.mkdir_p(kandidatrot + "/bootstrap")
    // Eit ekte, køyrbart Norscode-codegen-artefakt, men utan proveniens for den
    // oppgjevne ARM64-kryssruta. Han må avvisast før nokon prosess blir starta.
    for os i ["linux", "macos"] {
        la uattestert = kandidatrot + "/bootstrap/native_codegen_" + os + "-arm64_on_linux-x86_64.elf"
        builtin.fil_skriv_binær(uattestert, builtin.fil_les_binær(kjelde))
        builtin.fil_sett_kjorbar(uattestert)
        assert_eq(cgp.vel(kandidatrot, os + "-arm64", "linux-x86_64")["status"], "stale")
    }
    la ncb = kandidatrot + "/probe.ncb.json"
    builtin.fil_skriv(ncb, builtin.json_stringify({"entry": "prove.start", "functions": {
        "prove.start": {"params": [], "code": [["PUSH_CONST", 0], ["RETURN"]]}
    }}))
    la ut = kandidatrot + "/kandidat"
    la felt = ["NORSCODE_ROOT", "NORSCODE_NATIVE_BIN", "NC_ARM64_OS", "NC_ARM64_OUT", "NORSCODE_SEED_NCB", "NC_ARM64_GC", "NC_ARM64_KREV_LIK"]
    la før = []
    for f i felt { legg_til(før, miljo_hent(f)) }
    miljo_sett("NORSCODE_ROOT", kandidatrot)
    miljo_sett("NORSCODE_NATIVE_BIN", root + "/dist/norscode_native")
    la resultat = []
    prøv {
        for os i ["linux", "macos"] {
            miljo_sett("NC_ARM64_OS", os)
            miljo_sett("NC_ARM64_OUT", ut + "-" + os)
            miljo_sett("NORSCODE_SEED_NCB", ncb)
            miljo_sett("NC_ARM64_GC", "0")
            miljo_sett("NC_ARM64_KREV_LIK", "0")
            legg_til(resultat, byggjar.start())
        }
    } fang (e) {
        // Restore før kontrollane, også når byggjaren kastar.
        legg_til(resultat, tekst(e))
    }
    la i = 0
    mens i < lengde(felt) { miljo_sett(felt[i], før[i]) i = i + 1 }
    assert_eq(resultat, [1, 1])
    assert(ikkje builtin.fil_finnes(ut + "-linux"))
    assert(ikkje builtin.fil_finnes(ut + "-macos"))
    skriv("test_arm64_seed_codegen_freshness OK\n")
    returner 0
}
