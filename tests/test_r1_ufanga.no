# R1 / F11: ufanga unntak blir rapporterte som «Type: melding», også når
# unntaket er ei ordbok eller ein struktur-instans (før: «[verdi]»), og
# `fang (e: MinFeil)` fangar ein struktur-instans (VM-en les __type__).
# Vertsprogramma (nc_main/vm_executor) skriv «ERROR: <vm_ufanga_tekst>» til
# stderr via vm.vm_skriv_ufanga; her testar vi tekstforma og typematchinga
# gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon ncb_av(kjelde: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
}

funksjon utfor(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(ncb_av(kjelde)))
}

# Køyr eit program som kastar ufanga, og returner rapportteksten for unntaket.
funksjon ufanga_rapport(kjelde: tekst) -> tekst {
    prøv {
        vm.køyr_ncb(ncb_av(kjelde))
    } fang (e) {
        returner vm.vm_ufanga_tekst(e)
    }
    returner "INGEN-UNNTAK"
}

funksjon start() -> heiltall {
    # Tekst-unntak tre nivå ned: uendra tekst.
    la p_tekst = "funksjon n3() -> heiltall { kast \"EigenFeil: djupt nede\" }\n" +
        "funksjon n2() -> heiltall { returner n3() + 1 }\n" +
        "funksjon start() -> heiltall { returner n2() }\n"
    assert_eq(ufanga_rapport(p_tekst), "EigenFeil: djupt nede")

    # Ordbok-unntak: type + melding.
    la p_ordbok = "funksjon start() -> heiltall {\n" +
        "    kast {\"type\": \"ValideringsFeil\", \"melding\": \"felt x manglar\"}\n" +
        "}\n"
    assert_eq(ufanga_rapport(p_ordbok), "ValideringsFeil: felt x manglar")

    # Struktur-instans: typen kjem frå __type__.
    la p_struktur = "struktur MinFeil {\n    melding\n    kode\n}\n" +
        "funksjon start() -> heiltall {\n" +
        "    la f = MinFeil()\n" +
        "    f.melding = \"noko gjekk gale\"\n" +
        "    f.kode = 7\n" +
        "    kast f\n" +
        "}\n"
    assert_eq(ufanga_rapport(p_struktur), "MinFeil: noko gjekk gale")

    # Struktur utan melding: felta blir viste.
    la p_felt = "struktur KodeFeil {\n    kode\n}\n" +
        "funksjon start() -> heiltall {\n" +
        "    la f = KodeFeil()\n" +
        "    f.kode = 7\n" +
        "    kast f\n" +
        "}\n"
    assert_eq(ufanga_rapport(p_felt), "KodeFeil: kode=7")

    # Årsakskjede i ordbok-unntak.
    la p_årsak = "funksjon start() -> heiltall {\n" +
        "    kast {\"type\": \"TenestFeil\", \"melding\": \"kunne ikkje lagre\", \"årsak\": \"IOFeil: disk full\"}\n" +
        "}\n"
    assert_eq(ufanga_rapport(p_årsak), "TenestFeil: kunne ikkje lagre\nForårsaka av: IOFeil: disk full")

    # Andre verdiar: typenamn + verdi.
    assert_eq(vm.vm_ufanga_tekst(42), "heiltall: 42")

    # Typa fang på struktur-instans (p03c) og på ordbok med type-felt.
    la p_fang = "struktur MinFeil {\n    melding\n    kode\n}\n" +
        "funksjon start() -> tekst {\n" +
        "    la f = MinFeil()\n" +
        "    f.kode = 7\n" +
        "    la ut = \"\"\n" +
        "    prøv {\n" +
        "        prøv { kast f } fang (e: MinFeil) { ut = \"fanga-typa kode=\" + tekst(e.kode) }\n" +
        "    } fang (e) { ut = \"fall-gjennom\" }\n" +
        "    prøv {\n" +
        "        prøv { kast {\"type\": \"VFeil\", \"melding\": \"m\"} } fang (e: VFeil) { ut = ut + \";ordbok-typa\" }\n" +
        "    } fang (e) { ut = ut + \";ordbok-fall-gjennom\" }\n" +
        "    prøv {\n" +
        "        prøv { kast f } fang (e: AnnaFeil) { ut = ut + \";feil-type-fanga\" }\n" +
        "    } fang (e) { ut = ut + \";ytre\" }\n" +
        "    returner ut\n" +
        "}\n"
    assert_eq(utfor(p_fang), "fanga-typa kode=7;ordbok-typa;ytre")

    skriv("test_r1_ufanga OK\n")
    returner 0
}
