// R3 trinn 8 (3.1): kompilatoren lagrar signaturen til rutehandlarane i
// rutemetadata — "params" (namn, type, standardverdi), "modellar" (strukturane
// parametrane og returtypen viser til, transitivt) og respons-$ref for ein
// strukturreturtype. Køyrer KJELDE-kompilatoren (selfhost.kompiler) på
// tests/fixtures/r3_signatur_app.no, så han testar greina sin kompilator utan reseed.
//
// Felttypane i struktur er tomme ("") til typesystemet (R3 spor A) lagrar dei på
// Felt-noden; testen godtek begge delar for felta.

bruk selfhost.kompiler som kompiler

funksjon _rute(rh, fn_kort: tekst) {
    la i = 0
    mens i < lengde(rh) {
        hvis rh[i]["function"] == "__main__." + fn_kort { returner rh[i] }
        i = i + 1
    }
    kast "fann ikkje ruta " + fn_kort
}

funksjon _p(r, i: heltall) -> tekst {
    la p = r["params"][i]
    la s = tekst(p["namn"]) + ":" + tekst(p["type"])
    hvis p["har_standard"] { s = s + "=" + tekst(p["standard"]) }
    returner s
}

funksjon _felt_namn(m) -> tekst {
    la ut = []
    la i = 0
    mens i < lengde(m["felt"]) {
        legg_til(ut, tekst(m["felt"][i]["namn"]))
        i = i + 1
    }
    returner builtin.join(ut, ",")
}

funksjon start() -> heltall {
    // bruk-linjene blir tekne bort: kjelde-kompilatoren ville elles tolke heile
    // std/web.no i VM-en (svært tregt). Rutemarkørane blir kjende att på namnet
    // (".route", ".use_dependency" ...), så metadataen blir den same.
    la linjer = builtin.split(fil_les("tests/fixtures/r3_signatur_app.no"), "\n")
    la kjelde = ""
    la li = 0
    mens li < lengde(linjer) {
        hvis ikkje builtin.starts_with(linjer[li], "bruk ") { kjelde = kjelde + linjer[li] + "\n" }
        li = li + 1
    }
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la rh = ncb["route_handlers"]

    la hent = _rute(rh, "hent_person")
    assert_eq(lengde(hent["params"]), 3)
    assert_eq(_p(hent, 0), "ctx:")
    assert_eq(_p(hent, 1), "id:heltall")
    assert_eq(_p(hent, 2), "detaljar:boolsk=" + tekst(usann))
    assert_eq(hent["response_type"], "PersonUt")
    assert_eq(builtin.join(nøkler(hent["modellar"]), ","), "PersonUt")
    assert_eq(_felt_namn(hent["modellar"]["PersonUt"]), "id,namn,aktiv")
    // Standardverdien til eit strukturfelt er med (literal).
    la aktiv = hent["modellar"]["PersonUt"]["felt"][2]
    assert(aktiv["har_standard"])
    assert(aktiv["standard"] == sann)
    assert_eq(hent["response_schema"]["$ref"], "#/components/schemas/PersonUt")
    assert_eq(hent["responses"]["200"]["content"]["application/json"]["schema"]["$ref"], "#/components/schemas/PersonUt")

    la sok = _rute(rh, "sok")
    assert_eq(_p(sok, 0), "q:tekst")
    assert_eq(_p(sok, 1), "n:heltall=10")
    assert_eq(lengde(nøkler(sok["modellar"])), 0)

    // Strukturparameter: Person og (transitivt via feltet adresse) Adresse — når
    // felttypane finst. Person er alltid med.
    la lag = _rute(rh, "lag_person")
    assert_eq(_p(lag, 1), "p:Person")
    assert(finnes_nøkkel(lag["modellar"], "Person"))
    assert_eq(_felt_namn(lag["modellar"]["Person"]), "namn,alder,adresse")
    la alder = lag["modellar"]["Person"]["felt"][1]
    assert(alder["har_standard"])
    assert_eq(tekst(alder["standard"]), "0")
    la adr_type = tekst(lag["modellar"]["Person"]["felt"][2]["type"])
    hvis adr_type == "Adresse" { assert(finnes_nøkkel(lag["modellar"], "Adresse")) }

    la to = _rute(rh, "to_kroppar")
    assert_eq(_p(to, 0), "a:Adresse")
    assert_eq(_p(to, 1), "p:Person")
    assert(finnes_nøkkel(to["modellar"], "Adresse"))

    la gamal = _rute(rh, "gamal")
    assert_eq(lengde(gamal["params"]), 1)
    assert_eq(_p(gamal, 0), "ctx:")
    assert_eq(gamal["response_schema"]["type"], "string")

    // Generisk returtype: tekstforma frå typesystemet ("liste<PersonUt>") når parseren
    // gjev typeuttrykk, elles grunnamnet "liste".
    la pl = _rute(rh, "personliste")
    assert(builtin.starts_with(tekst(pl["return_type"]), "liste"))
    assert(builtin.starts_with(_p(pl, 1), "t:liste"))
    assert(builtin.starts_with(_p(pl, 2), "merke:tekst"))
    hvis tekst(pl["return_type"]) == "liste<PersonUt>" {
        assert(finnes_nøkkel(pl["modellar"], "PersonUt"))
        assert_eq(pl["response_schema"]["items"]["$ref"], "#/components/schemas/PersonUt")
    }

    skriv("test_r3_signaturmetadata OK\n")
    returner 0
}
