bruk std.http_download som download
bruk std.bytes som bytes

funksjon start() -> heiltall {
    la https = download._parse_url("https://example.test:8443/path?q=1")
    assert(https["status"] == "ok")
    assert(https["secure"] == "sann")
    assert(https["host"] == "example.test")
    assert(https["port"] == "8443")
    assert(https["path"] == "/path?q=1")
    assert(download._parse_url("file:///tmp/no")["status"] == "feil")
    assert(download._parse_url("https://user@example.test/no")["status"] == "feil")

    la header = "HTTP/1.1 302 Found\r\nLocation: /asset.bin\r\nContent-Length: 0\r\n\r\n"
    assert(download._statuskode(header) == 302)
    assert(download._header_verdi(header, "location") == "/asset.bin")
    assert(download._redirect_url(https, "/asset.bin") == "https://example.test:8443/asset.bin")
    assert(download._hex_tal("10") == 16)
    assert(download._hex_tal("ff") == 255)
    assert(download._hex_tal("zz") == -1)
    la hex_bytes = download._hex_bytes("410042ff")
    assert(lengde(hex_bytes) == 4)
    assert(hex_bytes[0] == 65)
    assert(hex_bytes[1] == 0)
    assert(hex_bytes[2] == 66)
    assert(hex_bytes[3] == 255)

    la sti = "build/test-http-download-core.bin"
    builtin.fil_skriv_binær(sti, bytes.tom())
    assert(download._skriv_hex(sti, "00017fff", 0, 4) == 4)
    la lese = bytes.til_liste(builtin.fil_les_binær(sti))
    assert(lengde(lese) == 4)
    assert(lese[0] == 0 og lese[1] == 1 og lese[2] == 127 og lese[3] == 255)
    assert(download._skriv_hex(sti, "aa", 4, 4) == -1)
    skriv("test_http_download_core OK\n")
    returner 0
}
