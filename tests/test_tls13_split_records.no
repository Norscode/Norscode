# Regresjon: `stopp` vart brukt som om det var `bryt` i std.tls13_session og
# std.x509. Når ein TLS-record kom delt over to lesingar, stoppa ikkje lykkja i
# _split_records, og indekseringa gjekk utanfor bufferen
# («IndeksFeil: indeks 1448 utanfor lista (lengde 1448)»).
bruk std.tls13_session som sess
bruk std.x509 som x509

funksjon _rec(type: heiltall, n: heiltall, fyll: heiltall) -> liste_heiltall {
    la r: liste_heiltall = [type, 3, 3, (n >> 8) & 255, n & 255]
    la i = 0
    mens i < n { legg_til(r, (fyll + i) & 255) i = i + 1 }
    returner r
}

funksjon _saman(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    for x i a { legg_til(ut, x) }
    for x i b { legg_til(ut, x) }
    returner ut
}

funksjon _prefiks(a: liste_heiltall, n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < n { legg_til(ut, a[i]) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    la r1 = _rec(23, 3, 10)
    la r2 = _rec(23, 2000, 40)

    # Heile records: begge kjem ut, ingen rest.
    la heil = sess._split_records(_saman(r1, r2))
    assert_eq(lengde(heil["records"]), 2)
    assert_eq(lengde(heil["rest"]), 0)

    # Buffer sluttar midt i record 2 (som ei 1448-byte TCP-lesing): record 1 ut,
    # resten av bufferen ventar på meir data.
    la buf = _prefiks(_saman(r1, r2), 1448)
    la delt = sess._split_records(buf)
    assert_eq(lengde(delt["records"]), 1)
    assert_eq(lengde(delt["records"][0]), 8)
    assert_eq(lengde(delt["rest"]), 1448 - 8)
    assert_eq(delt["rest"][0], 23)

    # Buffer sluttar midt i record-headeren.
    la hdr = sess._split_records(_saman(r1, [23, 3]))
    assert_eq(lengde(hdr["records"]), 1)
    assert_eq(lengde(hdr["rest"]), 2)

    # Berre ein ufullstendig record: ingenting ut, alt i rest.
    la berre = sess._split_records(_prefiks(r2, 100))
    assert_eq(lengde(berre["records"]), 0)
    assert_eq(lengde(berre["rest"]), 100)

    # _klient_prosesser_hs: ufullstendig handshake-melding → «ventande», bufferen urørd.
    la s = {"hs_buf": [8, 0, 0, 10, 1, 2], "transcript": []}
    la hs_r = sess._klient_prosesser_hs(s)
    assert_eq(hs_r["status"], "ventande")
    assert_eq(lengde(s["hs_buf"]), 6)

    # x509.crl_revoked_serials: ugyldig oppføring i revokedCertificates → bryt,
    # serienummera før blir returnerte.
    la crl: liste_heiltall = [48, 20, 48, 18,
        2, 1, 1,              # versjon
        48, 0,                # signaturalgoritme
        48, 0,                # utferdar
        23, 0,                # thisUpdate
        48, 7,                # revokedCertificates
        48, 3, 2, 1, 5,       # oppføring: serie 05
        4, 0]                 # ikkje ein SEQUENCE → stopp parsinga
    la serie = x509.crl_revoked_serials(crl)
    assert_eq(lengde(serie), 1)
    assert_eq(serie[0], "05")

    skriv("test_tls13_split_records OK")
    returner 0
}
