// Fase 1: GROUP BY + HAVING (via query_rader). Golden frå sqlite3 3.51.0.
// Grupper sorterast på gruppenøkkel (SQLite default), aggregat per gruppe,
// HAVING filtrerer grupper på aggregat-samanlikning.

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")
    assert_eq(db.execute(h, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')"), 1)

    // COUNT per gruppe (default rekkefølge = sortert på gruppenøkkel)
    assert_eq(db.query_rader(h, "SELECT by, COUNT(*) FROM folk GROUP BY by"), "Bergen|1\nOslo|3")
    assert_eq(db.query_rader(h, "SELECT by, COUNT(*) FROM folk GROUP BY by ORDER BY by"), "Bergen|1\nOslo|3")

    // SUM per gruppe
    assert_eq(db.query_rader(h, "SELECT by, SUM(alder) FROM folk GROUP BY by ORDER BY by"), "Bergen|29\nOslo|133")

    // Fleire aggregat i same gruppe
    assert_eq(db.query_rader(h, "SELECT by, MIN(alder), MAX(alder) FROM folk GROUP BY by ORDER BY by"), "Bergen|29|29\nOslo|37|55")

    // HAVING på aggregat
    assert_eq(db.query_rader(h, "SELECT by, COUNT(*) FROM folk GROUP BY by HAVING COUNT(*) > 1"), "Oslo|3")
    assert_eq(db.query_rader(h, "SELECT by, SUM(alder) FROM folk GROUP BY by HAVING SUM(alder) > 100"), "Oslo|133")

    assert(db.close(h))
    returner 0
}
