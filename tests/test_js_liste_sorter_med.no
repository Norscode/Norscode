// Regresjon (Java-paritet F40): std.js_liste.sorter_med (List.sort(Comparator)).
// Før fiksen var sorter_med innsetjingssortering (O(n²) samanlikningar:
// 5000 element tok 6,2 min på VM-en). No: stabil flettesortering, og ein
// lambda-komparator blir kalla direkte (utan builtin.ncb_call_fn).
// Talet på komparatorkall er vakta: n log2 n, ikkje n²/4.
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.js_liste som jsl

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon lj(l) -> tekst {
    la r = ""
    for x i l { r = r + tekst(x) + "," }
    returner r
}

funksjon synkande(a, b) -> heiltall { returner b - a }

// Komparator som tel kall i ei delt liste.
funksjon tel_cmp(teljar: liste_heltall, a, b) -> heiltall {
    teljar[0] = teljar[0] + 1
    returner a - b
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]

    sjekk(feil, "namn-komparator", lj(jsl.sorter_med([3, 1, 2, 5], "__main__.synkande")), "5,3,2,1,")
    sjekk(feil, "lambda", lj(jsl.sorter_med([3, 1, 2, 5, 4], fun(a, b) -> a - b)), "1,2,3,4,5,")
    sjekk(feil, "tom", lj(jsl.sorter_med([], fun(a, b) -> a - b)), "")
    sjekk(feil, "eitt", lj(jsl.sorter_med([7], fun(a, b) -> a - b)), "7,")

    // Stabilitet: like nøklar beheld innbyrdes rekkjefølgje.
    la folk = [{"n": "Kari", "a": 40}, {"n": "Ola", "a": 25}, {"n": "Per", "a": 33}, {"n": "Anne", "a": 25}, {"n": "Liv", "a": 33}]
    la s = jsl.sorter_med(folk, fun(p, q) -> p["a"] - q["a"])
    la namn = ""
    for p i s { namn = namn + p["n"] + "," }
    sjekk(feil, "stabil", namn, "Ola,Anne,Per,Liv,Kari,")
    sjekk(feil, "inndata urørt", folk[0]["n"], "Kari")

    // Tal på samanlikningar for n = 512 pseudo-tilfeldige: flettesortering
    // brukar høgst n·log2(n) = 4608; innsetjing ville brukt ~65 000.
    la n = 512
    la l = []
    la x = 12345
    la i = 0
    mens i < n {
        x = (x * 1103515245 + 12345) % 2147483648
        legg_til(l, x % 1000)
        i = i + 1
    }
    la teljar: liste_heltall = [0]
    la sortert = jsl.sorter_med(l, fun(a, b) -> tel_cmp(teljar, a, b))
    la ok = lengde(sortert) == n
    i = 1
    mens i < lengde(sortert) {
        hvis sortert[i - 1] > sortert[i] { ok = usann }
        i = i + 1
    }
    sjekk(feil, "sortert 512", tekst(ok), "sann")
    sjekk(feil, "samanlikningar <= n log n", tekst(teljar[0] <= 4608) + " (" + tekst(teljar[0]) + ")", "sann (" + tekst(teljar[0]) + ")")

    // Allereie sortert inndata: n-1 samanlikningar.
    la stigande = []
    i = 0
    mens i < 256 {
        legg_til(stigande, i)
        i = i + 1
    }
    la t2: liste_heltall = [0]
    jsl.sorter_med(stigande, fun(a, b) -> tel_cmp(t2, a, b))
    sjekk(feil, "sortert inndata", tekst(t2[0]), "255")

    hvis feil[0] == 0 { skriv("test_js_liste_sorter_med OK\n") }
    returner feil[0]
}
