// Fase 7h: JOIN-komplett — multi-vilkår ON, 3+ tabellar, RIGHT/FULL/CROSS, aliasar.
// Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE ansatt (id INTEGER, navn TEXT, avd_id INTEGER, by TEXT)")
    sql.exec(db, "INSERT INTO ansatt (id, navn, avd_id, by) VALUES (1, 'Ada', 10, 'Oslo')")
    sql.exec(db, "INSERT INTO ansatt (id, navn, avd_id, by) VALUES (2, 'Linus', 20, 'Oslo')")
    sql.exec(db, "INSERT INTO ansatt (id, navn, avd_id, by) VALUES (3, 'Bjørn', 10, 'Bergen')")
    sql.exec(db, "INSERT INTO ansatt (id, navn, avd_id, by) VALUES (4, 'Kari', 99, 'Oslo')")
    sql.exec(db, "CREATE TABLE avd (id INTEGER, namn TEXT, by TEXT)")
    sql.exec(db, "INSERT INTO avd (id, namn, by) VALUES (10, 'Utvikling', 'Oslo')")
    sql.exec(db, "INSERT INTO avd (id, namn, by) VALUES (20, 'Salg', 'Oslo')")
    sql.exec(db, "INSERT INTO avd (id, namn, by) VALUES (30, 'HR', 'Bergen')")
    sql.exec(db, "CREATE TABLE by_land (by TEXT, land TEXT)")
    sql.exec(db, "INSERT INTO by_land (by, land) VALUES ('Oslo', 'NO')")
    sql.exec(db, "INSERT INTO by_land (by, land) VALUES ('Bergen', 'NO')")

    // Multi-vilkår ON (a.avd_id=d.id AND a.by=d.by) — berre same-by-matchar
    assert_eq(sql.query_rader(db, "SELECT a.navn FROM ansatt a JOIN avd d ON a.avd_id = d.id AND a.by = d.by ORDER BY a.navn"), "Ada\nLinus")
    // 3 tabellar (kjeda joins) m/ aliasar
    assert_eq(sql.query_rader(db, "SELECT a.navn, d.namn, l.land FROM ansatt a JOIN avd d ON a.avd_id = d.id JOIN by_land l ON a.by = l.by ORDER BY a.navn"),
        "Ada|Utvikling|NO\nBjørn|Utvikling|NO\nLinus|Salg|NO")
    // LEFT JOIN — Kari (avd 99) får tom avd
    assert_eq(sql.query_rader(db, "SELECT a.navn, d.namn FROM ansatt a LEFT JOIN avd d ON a.avd_id = d.id ORDER BY a.navn"),
        "Ada|Utvikling\nBjørn|Utvikling\nKari|\nLinus|Salg")
    // RIGHT JOIN — HR (ingen ansatt) med. 3 matchar + 1 umatcha avd = 4
    assert_eq(sql.query_int(db, "SELECT count(*) FROM ansatt a RIGHT JOIN avd d ON a.avd_id = d.id"), 4)
    // FULL JOIN — 3 matchar + Kari + HR = 5
    assert_eq(sql.query_int(db, "SELECT count(*) FROM ansatt a FULL JOIN avd d ON a.avd_id = d.id"), 5)
    // CROSS JOIN — 3 × 2 = 6
    assert_eq(sql.query_int(db, "SELECT count(*) FROM avd CROSS JOIN by_land"), 6)
    // Komma-join (implisitt CROSS) — 3 × 2 = 6
    assert_eq(sql.query_int(db, "SELECT count(*) FROM avd, by_land"), 6)

    returner 0
}
