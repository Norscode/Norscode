bruk std.syslog som syslog
bruk std.tekst som t

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_SYSLOG_ABI_LIVE") != "1" {
        skriv("test_syslog_abi_live: krev eksplisitt kandidatattestasjon\n")
        returner 0
    }
    la state = syslog.openlog("norscode-abi-test", 1, 8)
    syslog.info(state, "system-log-live-marker")
    la recent = syslog.les_siste(10)
    assert(lengde(recent) >= 1)
    assert(t.inneholder(recent[lengde(recent) - 1], "system-log-live-marker"))
    la found = syslog.søk_logg("LIVE-MARKER", 5)
    assert(lengde(found) == 1)
    syslog.closelog(state)
    skriv("test_syslog_abi_live OK")
    returner 0
}
