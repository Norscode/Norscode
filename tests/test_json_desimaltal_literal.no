// JSON-tal → rett type. Flyttal skal bli desimaltall, heiltal skal FRAMLEIS
// vere heiltal — det er den lettaste måten å øydeleggje noko på her.
funksjon sjekk(namn: tekst, v, venta_type: tekst, venta_tekst: tekst) -> heltall {
    la ty = builtin.type(v)
    la tx = tekst(v)
    hvis ty == venta_type og tx == venta_tekst { skriv("  OK   " + namn + " → " + ty + " " + tx + "\n") }
    ellers { skriv("  FEIL " + namn + " → " + ty + " " + tx + ", venta " + venta_type + " " + venta_tekst + "\n") }
    returner 0
}
funksjon j(s: tekst) { returner builtin.json_parse_raw(s) }
funksjon start() -> heltall {
    skriv("--- flyttal ---\n")
    sjekk("3.5",    j("3.5"),    "desimaltall", "3.5")
    sjekk("-2.5",   j("-2.5"),   "desimaltall", "-2.5")
    sjekk("0.1",    j("0.1"),    "desimaltall", "0.1")
    sjekk("1e5",    j("1e5"),    "desimaltall", "100000")
    sjekk("2.5e-3", j("2.5e-3"), "desimaltall", "0.0025")
    sjekk("1.5E2",  j("1.5E2"),  "desimaltall", "150")
    skriv("--- heiltal må vere urørte ---\n")
    sjekk("42",  j("42"),  "heltall", "42")
    sjekk("-7",  j("-7"),  "heltall", "-7")
    sjekk("0",   j("0"),   "heltall", "0")
    skriv("--- i struktur ---\n")
    la n = j("{\"n\":{\"m\":2.5}}")
    sjekk("{n:{m:2.5}}", n["n"]["m"], "desimaltall", "2.5")
    la l = j("[1, 2.5, 3]")
    sjekk("[1,2.5,3][0]", l[0], "heltall", "1")
    sjekk("[1,2.5,3][1]", l[1], "desimaltall", "2.5")
    sjekk("[1,2.5,3][2]", l[2], "heltall", "3")
    returner 0
}
