// Globale modulvariablar må behalde initialisatorane sine gjennom fragmentkjeda.
bruk tools.omgang6b_modules som modular
bruk tools.regenerate_omgang6b_fragments_safe som regen
bruk tools.build_omgang6b_compiler_ncb som byggjar
bruk selfhost.kompiler som kompiler
bruk selfhost.elf_compile_driver som drivar

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/fragment_metadata_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(base + "/ncb")
    builtin.mkdir_p(base + "/outer")
    builtin.mkdir_p(base + "/inner")
    la før = miljo_hent("NORSCODE_FRAGMENT_SOURCE_NATIVE")
    miljo_sett("NORSCODE_FRAGMENT_SOURCE_NATIVE", "1")
    la specs = modular.spesifikasjonar()
    la i = 0
    for spec i specs {
        la felt = builtin.split(spec, "|")
        la src = felt[2] + ".ncb.json"
        builtin.fil_skriv(base + "/ncb/" + src, kompiler.kompiler_fil(
            "la tilstand = " + tekst_fra_heltall(i + 10) + "\nfunksjon start() { returner tilstand + 1 }\n", felt[1]))
        assert(regen.rewrite_one(base + "/ncb", base + "/outer", base + "/inner", src, felt[1]))
        i = i + 1
    }
    miljo_sett("NORSCODE_FRAGMENT_SOURCE_NATIVE", før)
    assert(byggjar.bygg_frå_fragment(base + "/inner", base + "/compiler.ncb.json"))
    la før_dir = miljo_hent("NORSCODE_OMGANG6B_FRAGMENT_DIR")
    miljo_sett("NORSCODE_OMGANG6B_FRAGMENT_DIR", base + "/inner")
    drivar.bygg_omgang6b_bundle(base + "/driver.ncb.json")
    miljo_sett("NORSCODE_OMGANG6B_FRAGMENT_DIR", før_dir)
    assert_eq(builtin.fil_les(base + "/driver.ncb.json"), builtin.fil_les(base + "/compiler.ncb.json"))
    la ncb = builtin.json_parse_raw(builtin.fil_les(base + "/compiler.ncb.json"))
    assert(har_nokkel(ncb, "module_initializers"))
    assert(har_nokkel(ncb, "global_names"))
    assert_eq(lengde(ncb["module_initializers"]), lengde(specs))
    i = 0
    for spec i specs {
        la felt = builtin.split(spec, "|")
        assert_eq(ncb["module_initializers"][i], felt[1] + ".__module_init__")
        assert_eq(ncb["global_names"][felt[1]][0], "tilstand")
        assert(har_nokkel(ncb["functions"], ncb["module_initializers"][i]))
        i = i + 1
    }
    // Begge canonical feltrekkjefølgjene og legacy __main__-omdøyping.
    la legacy = {"functions": {}, "module_initializers": ["__main__.__module_init__"],
        "global_names": {"__main__": ["g"]}}
    builtin.fil_skriv(base + "/legacy.ncb.json", builtin.json_skriv(legacy))
    la omdøypt = modular.metadata_fra_fil(base + "/legacy.ncb.json", "probe.modul")
    assert_eq(omdøypt["module_initializers"][0], "probe.modul.__module_init__")
    assert_eq(omdøypt["global_names"]["probe.modul"][0], "g")
    // Metadata frå ein seed-bunt må ikkje kopiere root-initialisatoren inn i alle modular.
    assert_eq(lengde(modular.metadata_for_modul(legacy, "probe.modul")["module_initializers"]), 0)
    builtin.fil_skriv(base + "/manglar.ncb.json", "{\"functions\":{}}")
    la avvist = usann
    prøv { modular.metadata_fra_fil(base + "/manglar.ncb.json", "probe.modul") }
    fang (e) { avvist = builtin.contains(tekst(e), "manglar modulmetadata") }
    assert(avvist)
    skriv("test_selfhost_fragment_metadata OK\n")
    returner 0
}
