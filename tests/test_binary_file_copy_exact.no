funksjon start() -> heiltall {
    la kjelde = "build/test-binary-file-copy-source.bin"
    la mål = "build/test-binary-file-copy-target.bin"
    la venta = builtin.bytes_from_list([0, 1, 2, 255, 128, 65])
    builtin.fil_skriv_binær(kjelde, venta)
    la lesen = builtin.fil_les_binær(kjelde)
    skriv("binary-copy type=" + type(lesen) + " len=" + tekst_fra_heiltall(lengde(lesen)) + "\n")
    assert(lengde(lesen) == 6)
    la byte_liste = builtin.bytes_to_list(lesen)
    assert(lengde(byte_liste) == 6)
    assert(byte_liste[0] == 0 og byte_liste[1] == 1 og byte_liste[2] == 2)
    assert(byte_liste[3] == 255 og byte_liste[4] == 128 og byte_liste[5] == 65)
    builtin.fil_skriv_binær(mål, lesen)
    assert(builtin.fil_les_binær(mål) == venta)
    builtin.fil_append(mål, "XY")
    la med_append = builtin.bytes_to_list(builtin.fil_les_binær(mål))
    assert(lengde(med_append) == 8)
    assert(med_append[0] == 0 og med_append[5] == 65)
    assert(med_append[6] == 88 og med_append[7] == 89)
    skriv("test_binary_file_copy_exact OK\n")
    returner 0
}
