// FK ON DELETE/UPDATE-aksjonar (CASCADE / SET NULL / RESTRICT). Golden = sqlite3 3.51.0.
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")
    assert_eq(sql.exec(db, "CREATE TABLE p (pk TEXT PRIMARY KEY)"), 0)
    assert_eq(sql.exec(db, "CREATE TABLE cu (cid INTEGER PRIMARY KEY, pref TEXT REFERENCES p(pk) ON UPDATE CASCADE)"), 0)
    assert_eq(sql.exec(db, "CREATE TABLE cc (cid INTEGER PRIMARY KEY, pref TEXT REFERENCES p(pk) ON DELETE CASCADE)"), 0)
    assert_eq(sql.exec(db, "CREATE TABLE cn (cid INTEGER PRIMARY KEY, pref TEXT REFERENCES p(pk) ON DELETE SET NULL)"), 0)
    assert_eq(sql.exec(db, "INSERT INTO p VALUES ('U')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO p VALUES ('D')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO cu VALUES (6, 'U')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO cc VALUES (1, 'D')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO cc VALUES (2, 'D')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO cn VALUES (4, 'D')"), 1)

    // ON UPDATE CASCADE: p.pk U -> Z, cu.pref følgjer med
    assert_eq(sql.exec(db, "UPDATE p SET pk='Z' WHERE pk='U'"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM cu WHERE pref='Z'"), 1)

    // ON DELETE CASCADE + SET NULL: slett p.pk='D'
    assert_eq(sql.exec(db, "DELETE FROM p WHERE pk='D'"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM cc"), 0)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM cn WHERE pref IS NULL"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM p"), 1)

    // RESTRICT / NO ACTION: slett forelder med barn → blokkert (exec -1)
    assert_eq(sql.exec(db, "CREATE TABLE pr (pk TEXT PRIMARY KEY)"), 0)
    assert_eq(sql.exec(db, "CREATE TABLE cr (cid INTEGER PRIMARY KEY, pref TEXT REFERENCES pr(pk) ON DELETE RESTRICT)"), 0)
    assert_eq(sql.exec(db, "INSERT INTO pr VALUES ('X')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO cr VALUES (1, 'X')"), 1)
    assert_eq(sql.exec(db, "DELETE FROM pr WHERE pk='X'"), 0 - 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM pr"), 1)

    skriv("test_norsdb_fk_cascade OK\n")
    returner 0
}
