bruk std.imaplib som imap

funksjon start() -> heiltall {
    la body = "N1 OK fake\r\nSubject: hei\r\n"
    la response = "* 1 FETCH (UID 42 FLAGS (\\Seen \\Flagged) BODY[] {" + tekst_fra_heltall(lengde(body)) + "}\r\n" + body + ")\r\nN1 OK FETCH complete\r\n"
    assert(imap._tag_status(response, "N1") == "OK")
    assert(imap._tag_status(builtin.slice(response, 0, lengde(response) - 3), "N1") == "")
    assert(imap._tag_status("N2 NO denied\r\n", "N2") == "NO")

    la flags = imap._flags(response)
    assert(lengde(flags) == 2)
    assert(flags[0] == "\\Seen")
    assert(flags[1] == "\\Flagged")
    assert(imap._felt(response, "Subject") == "hei")

    la c = imap._ny_klient("localhost", 993, sann, usann, "")
    assert(ikkje imap.store_flags(c, "42", "INVALID", ["\\Seen"]))
    assert(ikkje imap.store_flags(c, "42\r\nN9 LOGOUT", "+FLAGS.SILENT", ["\\Seen"]))
    assert(ikkje imap.sett_grenser(c, 1, 1024))
    assert(imap.sett_grenser(c, 5000, 1048576))

    skriv("test_imaplib_parser_uid OK\n")
    returner 0
}
