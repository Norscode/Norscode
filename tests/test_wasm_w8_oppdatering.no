# W8 (WASM-sporet): oppdateringsflyten og CSP-en til service workeren i den installerbare
# deltakar-demoen, ende til ende i headless Chrome. Chrome-stega er VALFRIE (SKIP utan Chrome;
# NC_CHROME=<sti>).
#
# Testbygget (tests/fixtures/wasm_deltakarar_pwa_testklient.no, NC_WASM_SW=1) blir servert i fire
# versjonar etter kvarandre, med same Chrome-profil (serve-inngangane B, C og CSP er kopiar av
# den genererte, med ein annan app eller ein annan CSP på sw.js):
#   A    steg=u1: workeren er klar (første installasjon)
#   B    steg=u2: berre teksten på offline-sida er endra (ny versjon, ventar på klikk): «ventar»
#        med meldinga og knappen, to cachar; klikk på «Oppdater» → skipWaiting → «aktivert», og
#        den gamle cachen er sletta. Omlastinga (full navigasjon) er slått av i testbygget:
#        headless Chrome dumpar ikkje DOM-en etter ein navigasjon; avgjerda er testa i VM-en
#   C    steg=u4: ny versjon med automatisk aktivering når det berre finst éi fane: «aktivert»
#        utan klikk, og den førre cachen er sletta
#   CSP  steg=u5 med ein fersk profil: sw.js med standard-CSP (utan 'wasm-unsafe-eval'): workeren
#        kan ikkje kompilere sw.wasm, blir aldri aktiv, og ingen cache blir laga; Chrome
#        rapporterer CSP-brotet frå sw.js; utan nett etterpå får profilen ingenting («Page load
#        failed»). Den positive kontrollen er steg u1 (same bygg med csp_wasm på sw.js).
# Versjonen, sw.js og cachenamnet følgjer konfigurasjonen (sjå òg tests/test_wasm_w8.no).
bruk std.wasm_nettlesar som benk
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon rot() -> tekst { returner "build/wasm/test_w8_oppd" }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

funksjon linjer(l: liste) -> tekst {
    returner builtin.join(l, "\n") + "\n"
}

funksjon krev_lik(namn: tekst, r: ordbok, venta: tekst) -> heltall {
    hvis r["logg"] != venta {
        skriv(namn + ": skil seg frå fasiten, " + kh.skilnad(r["logg"], venta) + "\nFekk:\n" + r["logg"] + "\nFasit:\n" + venta + "\n")
        assert(usann)
    }
    hvis r["uncaught"] og ikkje berre_csp_frå_sw(r["konsoll"]) {
        skriv(namn + ": «Uncaught» i konsollen:\n" + r["konsoll"] + "\n")
        assert(usann)
    }
    returner 0
}

# Er alle «Uncaught» i konsollen CSP-brotet frå sw.js (steg u5, der det er venta: K blir avvist før
# nokon hending har lagt til ein handterar)? Uncaught frå sida er aldri greitt.
funksjon berre_csp_frå_sw(konsoll: tekst) -> bool {
    la l = builtin.split(konsoll, "\n")
    la i = 0
    la n = 0
    mens i < lengde(l) {
        hvis inneheld(l[i], "Uncaught") {
            hvis ikkje (inneheld(l[i], "Content Security") og inneheld(l[i], "/sw.js")) { returner usann }
            n = n + 1
        }
        i = i + 1
    }
    returner n > 0 og tillat_csp_frå_sw
}

la tillat_csp_frå_sw: bool = usann

# Ein kopi av serve-inngangen med `frå` bytt ut med `ny` (må finnast éin gong).
funksjon variant(namn: tekst, frå: tekst, ny: tekst) -> tekst {
    la kjelde = fil_les(hjelp.root() + "/" + rot() + "/testbygg/serve.no")
    assert(inneheld(kjelde, frå))
    la sti = rot() + "/testbygg/" + namn + ".no"
    fil_skriv(hjelp.root() + "/" + sti, builtin.replace(kjelde, frå, ny))
    returner sti
}

funksjon lista() -> tekst {
    returner "lasta: 10 deltakarar | status=10 deltakarar. | feil= | lokal=Lista blir ikkje lagra på eininga."
}

funksjon ein_cache() -> liste {
    returner ["cachar: 1", "cache nc-<16 hex>", "  /", "  /_nc/app.wasm?v=*", "  /_nc/ikon-192.png?v=*", "  /_nc/ikon-512.png?v=*",
              "  /_nc/ikon-maskable.png?v=*", "  /_nc/nc.js", "  /_nc/offline", "  /_nc/sw.wasm?v=*", "  /manifest.webmanifest",
              "  /nyheiter", "  /stil.css", "  /test"]
}

funksjon to_cachar() -> liste {
    la c = ein_cache()
    la ut = ["cachar: 2"]
    la r = 0
    mens r < 2 {
        la i = 1
        mens i < lengde(c) {
            legg_til(ut, c[i])
            i = i + 1
        }
        r = r + 1
    }
    returner ut
}

funksjon med(a: liste, b: liste) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(a) {
        legg_til(ut, a[i])
        i = i + 1
    }
    i = 0
    mens i < lengde(b) {
        legg_til(ut, b[i])
        i = i + 1
    }
    returner ut
}

funksjon start_serve(økt: ordbok, app: tekst, port: tekst) -> heltall {
    la s = benk.start_serve(økt, app, port)
    hvis s["status"] != "kjorer" { skriv("nc serve starta ikkje (" + app + "):\n" + tekst(s["ut"]) + "\n") }
    assert_eq(s["status"], "kjorer")
    returner 0
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())
    la ut = hjelp.bygg_sw_app("tests/fixtures/wasm_deltakarar_pwa_testklient.no", rot() + "/testbygg", sann, "tests/fixtures/wasm_deltakarar_pwa_testapp.no")
    assert(inneheld(ut, "SW: sw.wasm "))
    la app_a = "tests.fixtures.wasm_deltakarar_pwa_testapp som app"
    la serve_b = variant("serve_b", app_a, "tests.fixtures.wasm_deltakarar_pwa_testapp_b som app")
    la serve_c = variant("serve_c", app_a, "tests.fixtures.wasm_deltakarar_pwa_testapp_c som app")
    la sw_kall = "pwa.sw_svar(app.pwa_konfig(), _nc_pwa_info())"
    la serve_csp = variant("serve_csp", sw_kall, "pwa.sw_svar_med_csp(app.pwa_konfig(), _nc_pwa_info(), ws.csp_standard())")
    hvis benk.finn_chrome() == "" {
        skriv("test_wasm_w8_oppdatering OK (bygg og serve-variantar; SKIP Chrome: fann ikkje Chrome/Chromium, set NC_CHROME=<sti>)\n")
        returner 0
    }
    la økt = benk.ny_økt("test_w8_oppd")
    utsett {
        benk.rydd(økt)
    }
    la u = "http://127.0.0.1:48396"
    la same = {"profil": "eining", "behald_profil": sann}
    # ── A ──
    start_serve(økt, hjelp.serve_inngang(rot() + "/testbygg"), "48396")
    krev_lik("u1 (versjon A)", benk.last_side(økt, u + "/test?steg=u1", same), linjer(med(med(
        ["steg u1", "sw registrert, kontrollert=usann", "sw klar, aktiv=sann", lista()], ein_cache()), ["ferdig"])))
    benk.stopp_serve(økt)
    # ── B: ventar på klikk ──
    # Den virtuelle tida i Chrome må vare lenger: nettlesaren ser etter den nye versjonen og
    # installerer han medan sida ventar (60 s virtuelt, om lag 8 s verkeleg).
    start_serve(økt, serve_b, "48396")
    la lang = {"profil": "eining", "behald_profil": sann, "virtuell_ms": 60000}
    la r2 = benk.last_side(økt, u + "/test?steg=u2", lang)
    krev_lik("u2 (versjon B)", r2, linjer(med(med(med(med([
        "steg u2", "sw registrert, kontrollert=sann", "sw klar, aktiv=sann", lista(),
        "sw ventar: kontrollert=sann ventar=sann aktiv=sann | Ein ny versjon er klar. | knapp synleg=sann"],
        to_cachar()), ["cachar medan den nye ventar: 2, den gamle er med: sann", "klikkar «Oppdater»",
        "sw aktivert etter klikket | sida blir lasta på nytt: sann"]), ein_cache()), ["den gamle cachen er sletta: sann", "ferdig"])))
    benk.stopp_serve(økt)
    # ── C: automatisk aktivering med éi fane ──
    start_serve(økt, serve_c, "48396")
    la r4 = benk.last_side(økt, u + "/test?steg=u4", lang)
    krev_lik("u4 (versjon C)", r4, linjer(med(med([
        "steg u4", "sw registrert, kontrollert=sann", "sw klar, aktiv=sann", lista(),
        "sw aktivert utan klikk | Ein ny versjon er teken i bruk. Han blir lasta neste gong du opnar sida. | knapp synleg=usann"],
        ein_cache()), ["den førre cachen er sletta: sann", "ferdig"])))
    benk.stopp_serve(økt)
    skriv("oppdatering: B venta til klikket og vart teken i bruk då (" + tekst(r2["ms"]) + " ms); C vart teken i bruk utan klikk med éi fane; gamle cachar sletta\n")
    # ── CSP utan 'wasm-unsafe-eval' på sw.js ──
    start_serve(økt, serve_csp, "48396")
    la fersk = {"profil": "csp", "behald_profil": sann}
    tillat_csp_frå_sw = sann
    la r5 = benk.last_side(økt, u + "/test?steg=u5", fersk)
    krev_lik("u5 (sw.js utan 'wasm-unsafe-eval')", r5, linjer([
        "steg u5", "sw registrert, kontrollert=usann", lista(),
        "u5: etter 300 pulsar: aktiv=usann installerer=usann ventar=usann kontrollert=usann", "cachar: 0", "ferdig"]))
    hvis ikkje (inneheld(r5["konsoll"], "wasm-unsafe-eval") eller inneheld(r5["konsoll"], "Content Security Policy")) {
        skriv("venta eit CSP-brot frå sw.js i konsollen:\n" + r5["konsoll"] + "\n")
        assert(usann)
    }
    benk.stopp_serve(økt)
    la off = benk.last_side(økt, u + "/test?steg=u5", {"profil": "csp", "grense_ms": 20000})
    assert(off["side_feila"])
    skriv("CSP: utan 'wasm-unsafe-eval' på sw.js vart workeren aldri aktiv (CSP-brot frå sw.js i konsollen), og utan nett fekk profilen ingenting\n")
    skriv("test_wasm_w8_oppdatering OK\n")
    returner 0
}
