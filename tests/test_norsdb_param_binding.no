// Fase 0: parameter-binding (?-plassholdarar) med escaping mot SQL-injeksjon.
// Verifiserer round-trip av verdiar, at injeksjonsforsøk lagrast som ren tekst,
// apostrof-håndtering, og at ? inne i strenglitteralar ikkje bindast.

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")
    assert_eq(db.execute(h, "CREATE TABLE users (id INTEGER, name TEXT, note TEXT)"), 0)

    // Bundet INSERT + bundet SELECT (id auto-tildelt: 1)
    assert_eq(db.execute_bundet(h, "INSERT INTO users (name, note) VALUES (?, ?)", ["Ada", "hei"]), 1)
    assert_eq(db.query_text_bundet(h, "SELECT name FROM users WHERE id = ?", ["1"]), "Ada")
    assert_eq(db.query_text_bundet(h, "SELECT note FROM users WHERE name = ?", ["Ada"]), "hei")

    // Injeksjonsforsøk: verdien skal lagrast ordrett, tabellen skal overleve (id: 2)
    la ondsinnet = "x'); DROP TABLE users;--"
    assert_eq(db.execute_bundet(h, "INSERT INTO users (name) VALUES (?)", [ondsinnet]), 1)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM users"), 2)
    assert_eq(db.query_text_bundet(h, "SELECT name FROM users WHERE id = ?", ["2"]), ondsinnet)

    // Apostrof i verdi (O'Brien) skal round-trippe (id: 3)
    assert_eq(db.execute_bundet(h, "INSERT INTO users (name) VALUES (?)", ["O'Brien"]), 1)
    assert_eq(db.query_text_bundet(h, "SELECT name FROM users WHERE id = ?", ["3"]), "O'Brien")

    // ? inne i strenglitteral skal IKKJE bindast; berre den ytre ? bindast (id: 4)
    assert_eq(db.execute_bundet(h, "INSERT INTO users (name, note) VALUES ('q?', ?)", ["z"]), 1)
    assert_eq(db.query_text_bundet(h, "SELECT name FROM users WHERE id = ?", ["4"]), "q?")
    assert_eq(db.query_text_bundet(h, "SELECT note FROM users WHERE id = ?", ["4"]), "z")

    assert(db.close(h))
    returner 0
}
