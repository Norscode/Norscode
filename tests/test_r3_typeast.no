# R3 / F28: strukturert type-AST. Parseren held typeargument (liste<T>,
# ordbok<K,V>), valfri-markør (T?), funksjonstypar (funksjon(A) -> B),
# generiske typeparametrar på funksjon/struktur (med grense) og felttypar på
# struktur. Typane blir lagra som «types»-metadata i NCB (docs/TYPEMETADATA.md)
# og er erased ved køyring: utypa kode får ingen ny nøkkel. Køyrer gjennom
# KJELDE-kompilator + KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon ncb_av(kjelde: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
}

funksjon start() -> heltall {
    la kjelde = "funksjon fyrste<T>(l: liste<T>) -> T {\n    returner l[0]\n}\n"
    kjelde = kjelde + "funksjon bruk_fn(f: funksjon(heltall) -> heltall, v: heltall) -> heltall {\n    returner f(v)\n}\n"
    kjelde = kjelde + "funksjon maks<T: Samanliknbar, U implementerer Form>(a: T, b: U?) -> ordbok<tekst, liste<ordbok<tekst, heltall>>> {\n    returner {}\n}\n"
    kjelde = kjelde + "funksjon nøsta(a: ordbok<tekst, liste<tekst>>, b: liste<liste<heltall>>, c: heltall) -> heltall {\n    returner c\n}\n"
    kjelde = kjelde + "funksjon utypa(a, b) {\n    returner a\n}\n"
    kjelde = kjelde + "struktur Boks<T> {\n    verdi: T\n    n: heltall = 2\n    fri\n}\n"
    kjelde = kjelde + "struktur Rein { a, b }\n"
    kjelde = kjelde + "funksjon start() -> heltall {\n    la b = Boks()\n    b.verdi = 3\n    la d = funksjon(y: heltall) -> heltall { returner y * 2 }\n    la m: ordbok<tekst, heltall>? = ingenting\n    returner fyrste([7, 8]) * 100 + bruk_fn(d, 5) * 10 + b.verdi + b.n\n}\n"
    la ncb = ncb_av(kjelde)
    la fns = ncb["functions"]

    // Køyring: typane er erased.
    assert_eq(tekst(vm.køyr_ncb(ncb)), "805")

    la f = fns["__main__.fyrste"]["types"]
    assert_eq(f["returns"], "T")
    assert_eq(f["params"][0]["type"], "liste<T>")
    assert_eq(f["params"][0]["type_ast"]["kind"], "apply")
    assert_eq(f["params"][0]["type_ast"]["args"][0]["name"], "T")
    assert_eq(f["type_params"][0]["name"], "T")

    la g = fns["__main__.bruk_fn"]["types"]
    assert_eq(g["params"][0]["type"], "funksjon(heltall)->heltall")
    assert_eq(g["params"][0]["type_ast"]["kind"], "function")
    assert_eq(g["params"][0]["type_ast"]["returns"]["name"], "heltall")

    la m = fns["__main__.maks"]["types"]
    assert_eq(m["type_params"][0]["bound"], "Samanliknbar")
    assert_eq(m["type_params"][1]["bound"], "Form")
    assert_eq(m["params"][1]["type"], "U?")
    assert_eq(m["params"][1]["type_ast"]["kind"], "optional")
    assert_eq(m["returns"], "ordbok<tekst,liste<ordbok<tekst,heltall>>>")

    la n = fns["__main__.nøsta"]["types"]
    assert_eq(n["params"][0]["type"], "ordbok<tekst,liste<tekst>>")
    assert_eq(n["params"][1]["type"], "liste<liste<heltall>>")
    assert_eq(n["params"][2]["type"], "heltall")

    assert_eq(har_nokkel(fns["__main__.utypa"], "types"), usann)
    assert_eq(har_nokkel(fns["__main__.Rein"], "types"), usann)

    la s = fns["__main__.Boks"]["types"]
    assert_eq(s["type_params"][0]["name"], "T")
    assert_eq(s["fields"][0]["type"], "T")
    assert_eq(s["fields"][1]["type"], "heltall")
    assert_eq(s["fields"][1]["has_default"], sann)
    assert_eq(s["fields"][2]["type"], null)

    // Lambda-hjelparen ber typane sine.
    la fk = nøkler(fns)
    la lambda_typa = 0
    la i = 0
    mens i < lengde(fk) {
        hvis builtin.contains(fk[i], "lambda") og har_nokkel(fns[fk[i]], "types") { lambda_typa = lambda_typa + 1 }
        i = i + 1
    }
    assert_eq(lambda_typa, 1)
    skriv("typeast ok\n")
    returner 0
}
