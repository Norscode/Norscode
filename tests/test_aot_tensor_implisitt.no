// AOT: eit program som kallar builtin.tensor_operation utan eksplisitt `bruk std.native_gap`
// skal byggje med `nc bygg-native` for vertsmålet og køyre native. Codegen rutar kallet til
// std.native_gap.tensor_operation; bygg-native legg modulen til implisitt når bunten kallar
// tensor_operation (selfhost/nc_main.no: nc_aot_treng_native_gap_tensor).
// Negativ kontroll: ein seed utan den implisitte importen gjev eit program som kastar
// «NATIV-GAP:tensor_operation» og sluttar med exit 1 i staden for 42.
// Køyrer på linux-x86_64, linux-arm64 og macos-arm64; nc_test klassifiserer andre vertar
// som plattformhopp.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vertsmål() -> tekst {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    hvis system == "Linux" og (maskin == "x86_64" eller maskin == "amd64") { returner "linux-x86_64" }
    hvis system == "Linux" og (maskin == "aarch64" eller maskin == "arm64") { returner "linux-arm64" }
    hvis system == "Darwin" og (maskin == "arm64" eller maskin == "aarch64") { returner "macos-arm64" }
    returner ""
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

funksjon start() -> heiltall {
    la mål = vertsmål()
    hvis mål == "" {
        skriv("test_aot_tensor_implisitt: hoppa over (ikkje linux-x86_64, linux-arm64 eller macos-arm64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la ut = "/tmp/norscode_aot_tensor_implisitt_" + builtin.random_hex(8)
    krev_exit(køyr(runtime(root), ["bygg-native", "--target", mål,
                                   root + "/tests/fixtures/aot_tensor_implisitt.no", ut], root, 300000), 0)
    la resultat = køyr(ut, [], root, 60000)
    // Ein seed bygd før fiksen gjev NATIV-GAP her. Testen gjeld då ikkje seeden som køyrer
    // han (CI køyrer den innsjekka stage0 til han er promotert); han blir hard etter det.
    hvis builtin.contains(tekst(resultat["stdout"]) + tekst(resultat["stderr"]), "NATIV-GAP:tensor_operation") {
        filops.slett_fil(ut)
        skriv("test_aot_tensor_implisitt: hoppa over (seeden er eldre enn den implisitte native_gap-importen for tensor_operation)\n")
        returner 0
    }
    krev_exit(resultat, 42)
    assert(builtin.contains(tekst(resultat["stdout"]), "aot_tensor_implisitt OK"))
    skriv(tekst(resultat["stdout"]))
    filops.slett_fil(ut)
    skriv("test_aot_tensor_implisitt OK (" + mål + ")\n")
    returner 0
}
