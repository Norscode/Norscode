bruk std.auth_mfa som mfa
bruk std.base32 som base32

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"]) + "/build/auth-mfa-test-v1"
    la relativ = "state.json"
    la full = root + "/" + relativ
    builtin.mkdir_p(root)
    prøv { hvis builtin.fil_finnes(full) { builtin.fil_slett(full) } } fang (e) {}

    la secret_tekst = "12345678901234567890123456789012"
    la secret = base32.kod_bytes(base32.tekst_til_bytes(secret_tekst), usann)
    la uri = mfa.start_enrollment(root, relativ, "brukar-7", secret, "Norscode", "ada", 1000)
    assert(builtin.contains(uri, "otpauth://totp/Norscode:ada"))
    assert(ikkje builtin.contains(builtin.fil_les(full), secret))
    assert(ikkje mfa.aktiv(root, relativ, "brukar-7"))
    assert(lengde(mfa.aktiver(root, relativ, "brukar-7", secret, "00000000", 59, 8)) == 0)
    la recovery = mfa.aktiver(root, relativ, "brukar-7", secret, "46119246", 59, 8)
    assert(lengde(recovery) == 8)
    assert(mfa.aktiv(root, relativ, "brukar-7"))
    assert(mfa.verifiser_totp(root, relativ, "brukar-7", secret, "46119246", 59))
    assert(ikkje mfa.verifiser_totp(root, relativ, "brukar-7", secret, "46119247", 59))
    assert(mfa.bruk_recovery(root, relativ, "brukar-7", recovery[0]))
    assert(ikkje mfa.bruk_recovery(root, relativ, "brukar-7", recovery[0]))
    assert(ikkje builtin.contains(builtin.fil_les(full), recovery[1]))

    la challenge = mfa.utsted_innloggingsutfordring(root, relativ, "brukar-7", 59000, 60000)
    assert(challenge != "")
    assert(mfa.fullfor_innloggingsutfordring(root, relativ, challenge, secret, "00000000", 59000) == "")
    assert(mfa.fullfor_innloggingsutfordring(root, relativ, challenge, secret, "46119246", 59000) == "brukar-7")
    assert(mfa.fullfor_innloggingsutfordring(root, relativ, challenge, secret, "46119246", 59000) == "")

    la expired = mfa.utsted_innloggingsutfordring(root, relativ, "brukar-7", 59000, 1000)
    assert(mfa.fullfor_innloggingsutfordring(root, relativ, expired, secret, "46119246", 61001) == "")

    la locked = mfa.utsted_innloggingsutfordring(root, relativ, "brukar-7", 59000, 60000)
    la n: heiltall = 0
    mens n < 5 {
        assert(mfa.fullfor_innloggingsutfordring(root, relativ, locked, secret, "00000000", 59000) == "")
        n = n + 1
    }
    assert(mfa.fullfor_innloggingsutfordring(root, relativ, locked, secret, "46119246", 59000) == "")

    assert(mfa.deaktiver(root, relativ, "brukar-7") == 1)
    assert(ikkje mfa.aktiv(root, relativ, "brukar-7"))

    prøv { builtin.fil_slett(full) } fang (e) {}
    skriv("test_auth_mfa_enrollment_recovery OK")
    returner 0
}
