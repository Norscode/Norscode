# W4 (WASM-sporet): skjema-demoen (examples/wasm_skjema/) ende til ende i headless Chrome,
# og paritetskorpuset for fjern_nokkel og tid_ms. Chrome-stega er VALFRIE (SKIP utan Chrome).
#
#   1. Korpus (kh.køyr_korpus): tests/wasm_korpus/w4_ordbok.no i VM-en mot fasiten, bygd med
#      CLI-en og køyrd i Chrome med identisk utskrift, utan «Uncaught».
#   2. Demo i testbygg: tests/fixtures/wasm_skjema_testklient.no startar den ekte klienten og
#      køyrer brukarsteg gjennom testkrokane (test_skriv, test_send, test_klikk, test_tast), som
#      sender ekte hendingar gjennom lastaren. Loggen i #nc-logg må vere lik fasiten:
#        - reglane (gyldig_namn, gyldig_epost, treff) gjev same tekst som i VM-en;
#        - filter «ber» og «BER» gjev 7 treff; live validering av namn og e-post med
#          aria-invalid og lagre-knappen av/på; send legg til «Åse Berg» (8 treff) og tømer
#          feltet; delegert klikk fjernar Berit; data-nc-klikk til ein funksjon som ikkje er
#          delegert gjer ingenting (negativ kontroll); Escape tømer filteret (50 treff);
#          localStorage har lista; to tekstverdiar (også eit desimaltal) i éin vertsfunksjon;
#          65 542 bytar tekst frå DOM-en (minnet veks); handtaka blir gjenbrukte.
#      Etter tidtakaren (1,5 s, virtuell tid) er statusmeldinga borte, og DOM-en har 50 rader,
#      data-ms frå tid_ms og knappar med data-nc-klikk="fjern" (sett_handlar).
#   3. Demo i produksjonsbygg (utan testkrokar): «/?q=ber» gjev 7 treff og 7 rader
#      (hent_parameter); «/» gjev 50. NEGATIV KONTROLL: same side med standard-CSP
#      («/kontroll/streng-csp?q=ber») blir ikkje køyrd: «–» og ingen rader.
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_chrome_hjelp som ch
bruk tests.fixtures.wasm_korpus_hjelp som kh
bruk examples.wasm_skjema.klient som skjema

funksjon rot() -> tekst { returner "build/wasm/test_w4_chrome" }

# Fasiten for reglane, rekna i VM-en med den same klientkoden.
funksjon reglar_fasit() -> tekst {
    la namn = ["", " ", "A", "Al", "  Bo  ", "Åse"]
    la epost = ["", "a", "@b.no", "a@b", "a@.no", "a@b.", "a@b.no", "a b@c.no", "  x@y.z  "]
    la ut = ""
    la i = 0
    mens i < lengde(namn) {
        ut = ut + "namn «" + namn[i] + "»: " + skjema.gyldig_namn(namn[i]) + "\n"
        i = i + 1
    }
    i = 0
    mens i < lengde(epost) {
        ut = ut + "epost «" + epost[i] + "»: " + skjema.gyldig_epost(epost[i]) + "\n"
        i = i + 1
    }
    ut = ut + "treff: " + tekst(skjema.treff("Herbert", "BER")) + " " + tekst(skjema.treff("Åse", "å")) + " " +
        tekst(skjema.treff("Åse", "Å")) + " " + tekst(skjema.treff("Ola", "")) + "\n"
    returner ut
}

funksjon steg_fasit() -> tekst {
    la l = [
        "start: 50 treff | namn= (false) | epost= | lagre=disabled | status=",
        "filter ber: 7 treff | namn= (false) | epost= | lagre=disabled | status=",
        "filter BER: 7 treff | namn= (false) | epost= | lagre=disabled | status=",
        "namn A: 7 treff | namn=Namnet må ha minst 2 teikn. (true) | epost= | lagre=disabled | status=",
        "epost åse@: 7 treff | namn= (false) | epost=E-postadressa manglar eit domene som eksempel.no. | lagre=disabled | status=",
        "gyldig: 7 treff | namn= (false) | epost= | lagre= | status=",
        "send: 8 treff | namn= (false) | epost= | lagre=disabled | status=La til Åse Berg.",
        "namn-feltet: «»",
        "fjern 3: 7 treff | namn= (false) | epost= | lagre=disabled | status=Fjerna Berit.",
        "falsk: 7 treff | namn= (false) | epost= | lagre=disabled | status=Fjerna Berit.",
        "tast a: 7 treff | namn= (false) | epost= | lagre=disabled | status=Fjerna Berit.",
        "escape: 50 treff | namn= (false) | epost= | lagre=disabled | status=Fjerna Berit.",
        "lagra: 50 namn, sann usann",
        "lokalt: 2.5 v2 «»",
        "stor: 65542 sann",
        "handtak små: sann"
    ]
    returner builtin.join(l, "\n") + "\n"
}

funksjon tal_av(t: tekst, nål: tekst) -> heltall {
    la n = 0
    la rest = t
    la p = builtin.index_of(rest, nål)
    mens p >= 0 {
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
        p = builtin.index_of(rest, nål)
    }
    returner n
}

funksjon krev_ikkje(d: tekst, nål: tekst, kva: tekst) -> heltall {
    hvis builtin.index_of(d, nål) >= 0 {
        skriv(kva + ": fann «" + nål + "» i DOM-en, venta at han mangla:\n" + d + "\n")
        assert(usann)
    }
    returner 0
}

funksjon krev_tal(d: tekst, nål: tekst, n: heltall, kva: tekst) -> heltall {
    hvis tal_av(d, nål) != n {
        skriv(kva + ": venta " + tekst(n) + " × «" + nål + "», fann " + tekst(tal_av(d, nål)) + "\n")
        assert(usann)
    }
    returner 0
}

# Bygg (med serve-inngang), start nc serve og dump sidene. Gjev [{"dom", "konsoll"}, …].
funksjon køyr(chrome: tekst, kjelde: tekst, app: tekst, namn: tekst, testbygg: bool, port: tekst, stiar: liste) -> liste {
    la ut = rot() + "/" + namn
    hjelp.bygg_klient_app(kjelde, ut, testbygg, app)
    la s = ch.start_serve(hjelp.serve_inngang(ut), port)
    hvis s["status"] != "kjorer" {
        skriv("nc serve for " + namn + " starta ikkje:\n" + tekst(s["ut"]) + "\n")
        assert(usann)
    }
    la dumpar = []
    la i = 0
    mens i < lengde(stiar) {
        la profil = hjelp.root() + "/" + ut + "/profil-" + tekst(i)
        ch.rydd_profil(profil)
        legg_til(dumpar, ch.dump_med_konsoll(chrome, "http://127.0.0.1:" + port + stiar[i], profil))
        ch.rydd_profil(profil)
        i = i + 1
    }
    ch.stopp(s)
    returner dumpar
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())
    # ── 1. Korpus (VM, bygg, Chrome) ──
    la k = kh.køyr_korpus("test_wasm_w4_chrome", rot() + "/korpus", ["w4_ordbok"], [], "48351", {})
    hvis ikkje k["chrome"] {
        # Utan Chrome: demoen blir framleis bygd (validert av CLI-en)
        hjelp.bygg_klient_app("tests/fixtures/wasm_skjema_testklient.no", rot() + "/demo_testbygg", sann, "tests/fixtures/wasm_skjema_testapp.no")
        hjelp.bygg_klient_app("examples/wasm_skjema/klient.no", rot() + "/demo_prod", usann, "examples/wasm_skjema/app.no")
        returner 0
    }
    la chrome = ch.finn_chrome()

    # ── 2. Demo i testbygg ──
    la t = køyr(chrome, "tests/fixtures/wasm_skjema_testklient.no", "tests/fixtures/wasm_skjema_testapp.no", "demo_testbygg", sann, "48352", ["/test"])
    la d = t[0]["dom"]
    ch.krev(d, "</html>", "demo")
    la logg = ch.logg_frå_dom(d)
    la fasit = reglar_fasit() + steg_fasit()
    hvis logg != fasit {
        skriv("demo: loggen skil seg frå fasiten, " + kh.skilnad(logg, fasit) + "\nChrome:\n" + logg + "\nFasit:\n" + fasit + "\n")
        assert(usann)
    }
    hvis builtin.index_of(t[0]["konsoll"], "Uncaught") >= 0 {
        skriv("demo: konsollen har «Uncaught»:\n" + t[0]["konsoll"] + "\n")
        assert(usann)
    }
    ch.krev(d, "50 treff</output>", "demo sluttilstand")
    ch.krev(d, "<output id=\"nc-resultat\" data-ms=\"", "demo tid_ms")
    ch.krev(d, "<span id=\"status\" role=\"status\"></span>", "demo tidtakar")
    ch.krev(d, "<strong>Åse Berg</strong>", "demo send")
    krev_ikkje(d, "<strong>Berit</strong>", "demo fjern")
    krev_tal(d, "<li>", 50, "demo rader")
    krev_tal(d, "data-nc-klikk=\"fjern\"", 50, "demo sett_handlar")
    skriv("demo (testbygg): " + tekst(tal_av(logg, "\n")) + " logglinjer lik fasiten, 50 rader, tidtakaren køyrde\n")

    # ── 3. Demo i produksjonsbygg, med negativ kontroll ──
    la p = køyr(chrome, "examples/wasm_skjema/klient.no", "examples/wasm_skjema/app.no", "demo_prod", usann, "48353",
                ["/?q=ber", "/", "/kontroll/streng-csp?q=ber"])
    ch.krev(p[0]["dom"], "7 treff</output>", "prod ?q=ber")
    krev_tal(p[0]["dom"], "<li>", 7, "prod ?q=ber")
    ch.krev(p[0]["dom"], "<strong>Bergljot</strong>", "prod ?q=ber")
    ch.krev(p[1]["dom"], "50 treff</output>", "prod /")
    krev_tal(p[1]["dom"], "<li>", 50, "prod /")
    # Negativ kontroll: sida er lasta, men WASM vart stoppa av CSP-en
    ch.krev(p[2]["dom"], "</html>", "negativ kontroll")
    ch.krev(p[2]["dom"], "<output id=\"nc-resultat\">–</output>", "negativ kontroll")
    krev_tal(p[2]["dom"], "<li>", 0, "negativ kontroll")
    la pi = 0
    mens pi < 2 {
        hvis builtin.index_of(p[pi]["konsoll"], "Uncaught") >= 0 {
            skriv("prod: konsollen har «Uncaught»:\n" + p[pi]["konsoll"] + "\n")
            assert(usann)
        }
        pi = pi + 1
    }

    skriv("test_wasm_w4_chrome OK\n")
    returner 0
}
