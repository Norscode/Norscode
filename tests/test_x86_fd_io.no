// Relay X5 (os-x86-io) punkt 4 og 6: fd_les/fd_skriv/les_stdin, fil_les på eit røyr
// (/dev/stdin, ikkje-søkbar → les til EOF), fil_les på st_size-0-filer (/proc) og
// fil_prøv_skriv (0 eller −errno, aldri unntak) på linux-x86_64. Byggjer
// tests/fixtures/aot_x86_fd_io.no éin gong og køyrer han i fem modusar (AOT_FD_MODUS)
// med stdin frå prosess-ABI-en (eit røyr). Kvar modus krev exit 42.
// Berre på Linux x86-64-vert (elles hoppa over). Manuelt på macOS: sjå fiksturen.

bruk std.filops som filops
bruk std.runtime.process_abi som process_abi
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    returner system == "Linux" og (maskin == "x86_64" eller maskin == "amd64")
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

// Køyr ELF-en med stdin (eitt røyr frå prosess-ABI-en; feltet kan ikkje ha linjeskift).
funksjon køyr_modus(elf: tekst, modus: tekst, stdin: tekst) -> ordbok_tekst {
    la req = process_abi.request(elf, [], "/tmp", stdin, 60000, 1048576)
    process_abi.sett_sandbox(req, "none", 0, 64, sann)
    process_abi.sett_environment(req, {"AOT_FD_MODUS": modus})
    returner builtin.process_spawn_argv(req)
}

funksjon start() -> heiltall {
    hvis ikkje vert_linux_x86_64() {
        skriv("test_x86_fd_io: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la elf = "/tmp/norscode_x86_fd_io_" + builtin.random_hex(8)
    krev_exit(prosess.køyr(runtime(root), ["bygg-native", "--target", "linux-x86_64",
                                           root + "/tests/fixtures/aot_x86_fd_io.no", elf], root, {
        "NORSCODE_CMD": "", "NORSCODE_FILE": "", "NORSCODE_OUTPUT": "", "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, 900000), 0)
    la inn = "linje1 æøå slutt"
    la r1 = køyr_modus(elf, "stdin", inn)
    krev_exit(r1, 42)
    assert(builtin.contains(tekst(r1["stdout"]), "[" + inn + "]"))
    la r2 = køyr_modus(elf, "fdles", inn)
    krev_exit(r2, 42)
    assert(builtin.contains(tekst(r2["stdout"]), "[" + inn + "]"))
    la r3 = køyr_modus(elf, "devstdin", inn)
    krev_exit(r3, 42)
    assert(builtin.contains(tekst(r3["stdout"]), "[" + inn + "]"))
    krev_exit(køyr_modus(elf, "proc", ""), 42)
    krev_exit(køyr_modus(elf, "fil", ""), 42)
    filops.slett_fil(elf)
    skriv("test_x86_fd_io OK\n")
    returner 0
}
