bruk std.getpass som gp

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_TERMINAL_ABI_LIVE") != "1" {
        skriv("test_terminal_abi_live: krev eksplisitt kandidatattestasjon\n")
        returner 0
    }
    la tty = builtin.terminal_operation({
        "abi": "norscode-terminal-v1",
        "operation": "is_tty"
    })
    assert(tty["status"] == "ok")
    # Testporten køyrer med pipe, så skjult input skal feile lukka.
    assert(heltall_fra_tekst(tekst(tty["value"])) == 0)

    la hidden = builtin.terminal_operation({
        "abi": "norscode-terminal-v1",
        "operation": "readline",
        "prompt": "skal-ikkje-visast",
        "hidden": "1"
    })
    assert(hidden["status"] == "feil")
    assert(gp.getpass("skal-ikkje-visast") == "")
    assert(gp.getuser() != "")

    skriv("test_terminal_abi_live OK")
    returner 0
}
