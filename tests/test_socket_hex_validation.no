bruk std.socket som socket

funksjon start() -> heiltall {
    # Ugyldig hex skal avvisast foer native socket-dispatch, utan å sende
    # byte eller tolke ufullstendige par som null.
    assert(socket._gyldige_hex_bytes(""))
    assert(socket._gyldige_hex_bytes("00017f80ff"))
    assert(socket._gyldige_hex_bytes("AaBbCcDdEeFf"))
    assert(ikkje socket._gyldige_hex_bytes("0"))
    assert(ikkje socket._gyldige_hex_bytes("abc"))
    assert(ikkje socket._gyldige_hex_bytes("0g"))
    assert(ikkje socket._gyldige_hex_bytes("G0"))
    assert(ikkje socket._gyldige_hex_bytes("0 0"))
    assert(ikkje socket._gyldige_hex_bytes("00\n"))

    la tcp_odd = socket.native_skriv_hex({}, "abc")
    assert_eq(tcp_odd["status"], "feil")
    assert_eq(tcp_odd["error"], "ugyldig hex-payload")
    la tcp_bad = socket.native_skriv_hex({}, "0g")
    assert_eq(tcp_bad["status"], "feil")
    assert_eq(tcp_bad["error"], "ugyldig hex-payload")
    la udp_odd = socket.native_udp_skriv({}, "f", "127.0.0.1", 53)
    assert_eq(udp_odd["status"], "feil")
    assert_eq(udp_odd["error"], "ugyldig hex-payload")
    la udp_bad = socket.native_udp_skriv({}, "ZZ", "127.0.0.1", 53)
    assert_eq(udp_bad["status"], "feil")
    assert_eq(udp_bad["error"], "ugyldig hex-payload")
    skriv("test_socket_hex_validation OK")
    returner 0
}
