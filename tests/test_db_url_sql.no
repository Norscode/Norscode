bruk std.db_url som db

// Reine SQL-hjelparar i std.db_url: _er_lesing (retry-sikkerheit) og _til_dollar (?-plasshaldar vs JSONB-operatorar).

funksjon _test_er_lesing() {
    assert(db._er_lesing("SELECT 1"))
    assert(db._er_lesing("  show server_version"))
    assert(db._er_lesing("WITH x AS (SELECT 1) SELECT * FROM x"))
    // Skrivande CTE er ikkje lesing
    assert(ikkje db._er_lesing("WITH x AS (INSERT INTO t(a) VALUES (1) RETURNING a) SELECT * FROM x"))
    assert(ikkje db._er_lesing("with x as (update t set a = 1 returning a) select * from x"))
    assert(ikkje db._er_lesing("WITH x AS (DELETE FROM t RETURNING a) SELECT * FROM x"))
    assert(ikkje db._er_lesing("WITH x AS (SELECT 1) MERGE INTO t USING x ON true WHEN MATCHED THEN DO NOTHING"))
    // Nøkkelord inne i strengliteral eller som del av eit ord tel ikkje
    assert(db._er_lesing("WITH x AS (SELECT 'insert into y' AS s) SELECT * FROM x"))
    assert(db._er_lesing("WITH x AS (SELECT updated_at, deleted FROM t) SELECT * FROM x"))
    assert(ikkje db._er_lesing("INSERT INTO t VALUES (1)"))
    assert(ikkje db._er_lesing("UPDATE t SET a = 1"))
    // Batch: alle setningar må vere lesing
    assert(ikkje db._er_lesing("SELECT 1; INSERT INTO audit VALUES (1)"))
    assert(ikkje db._er_lesing("SHOW x; DELETE FROM t"))
    assert(db._er_lesing("SELECT 1; SELECT 2;"))
    assert(db._er_lesing("SELECT 'a;b'"))
    assert(ikkje db._er_lesing("SELECT 'x'; UPDATE t SET a = 1"))
}

funksjon _test_del_setningar() {
    assert_eq(lengde(db._del_setningar("INSERT INTO t VALUES ('a;b'); SELECT 1;")), 2)
    assert_eq(db._del_setningar("INSERT INTO t VALUES ('a;b'); SELECT 1;")[0], "INSERT INTO t VALUES ('a;b')")
    assert_eq(lengde(db._del_setningar("CREATE FUNCTION f() RETURNS int AS $$ BEGIN RETURN 1; END; $$ LANGUAGE plpgsql; SELECT 2")), 2)
    assert_eq(lengde(db._del_setningar("SELECT $tag$a;b$tag$; SELECT 2")), 2)
    assert_eq(lengde(db._del_setningar("SELECT 1 -- a;b\n; SELECT 2")), 2)
    assert_eq(lengde(db._del_setningar("SELECT 1 /* a;b */; SELECT 2")), 2)
    assert_eq(lengde(db._del_setningar("SELECT \"a;b\"; SELECT 2")), 2)
    assert_eq(lengde(db._del_setningar("SELECT E'a\\';b'; SELECT 2")), 2)
    assert_eq(lengde(db._del_setningar("SELECT $1; SELECT $2")), 2)
}

funksjon _test_til_dollar() {
    assert_eq(db._til_dollar("SELECT 1"), "SELECT 1")
    assert_eq(db._til_dollar("INSERT INTO t (a, b) VALUES (?, ?)"), "INSERT INTO t (a, b) VALUES ($1, $2)")
    assert_eq(db._til_dollar("SELECT * FROM t WHERE id = ? AND n > ? LIMIT ? OFFSET ?"), "SELECT * FROM t WHERE id = $1 AND n > $2 LIMIT $3 OFFSET $4")
    assert_eq(db._til_dollar("UPDATE t SET a=?, b = ? WHERE id=?"), "UPDATE t SET a=$1, b = $2 WHERE id=$3")
    assert_eq(db._til_dollar("SELECT a || ? FROM t WHERE x IN (?, ?)"), "SELECT a || $1 FROM t WHERE x IN ($2, $3)")
    assert_eq(db._til_dollar("SELECT ?"), "SELECT $1")
    assert_eq(db._til_dollar("SELECT 1 WHERE a LIKE ? AND NOT ?"), "SELECT 1 WHERE a LIKE $1 AND NOT $2")
    // JSONB-operatorar blir ståande
    assert_eq(db._til_dollar("SELECT data ? 'key' FROM t WHERE id = ?"), "SELECT data ? 'key' FROM t WHERE id = $1")
    assert_eq(db._til_dollar("SELECT * FROM t WHERE data ?| array['a','b'] AND id = ?"), "SELECT * FROM t WHERE data ?| array['a','b'] AND id = $1")
    assert_eq(db._til_dollar("SELECT * FROM t WHERE data ?& array['a'] AND id = ?"), "SELECT * FROM t WHERE data ?& array['a'] AND id = $1")
    assert_eq(db._til_dollar("SELECT * FROM t WHERE (data) ? 'k' AND j->'x' ? ?"), "SELECT * FROM t WHERE (data) ? 'k' AND j->'x' ? $1")
    assert_eq(db._til_dollar("SELECT \"d\" ? 'k' FROM t"), "SELECT \"d\" ? 'k' FROM t")
    // E-strengar: \' er escape, så ? etter literalen er plasshaldar
    assert_eq(db._til_dollar("SELECT E'a\\'b', ?"), "SELECT E'a\\'b', $1")
    // ? i strengar og identifikatorar blir aldri rørt
    assert_eq(db._til_dollar("SELECT '?' , \"?\" FROM t WHERE a = ?"), "SELECT '?' , \"?\" FROM t WHERE a = $1")
    assert_eq(db._til_dollar("SELECT 'it''s ?' WHERE a = ?"), "SELECT 'it''s ?' WHERE a = $1")
}

funksjon start() -> heiltall {
    _test_er_lesing()
    _test_del_setningar()
    _test_til_dollar()
    skriv("test_db_url_sql OK\n")
    returner 0
}
