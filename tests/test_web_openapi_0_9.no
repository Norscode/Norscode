bruk std.web som web
bruk std.tekst som t

// Fase 0.9: OpenAPI-generatoren. To ruter på same sti (GET+POST) skal samlast
// i eitt path-item; path-param skal kome frå rute-mønsteret med rett type;
// operationId skal vere unik; skjemaet skal vere gyldig JSON (3.1).

funksjon liste_varer(ctx: ordbok_tekst) -> liste_tekst {
    web.route("GET /varer/{id:int}")
    la side = web.request_query_int(ctx, "side")
    returner ["a"]
}

funksjon lag_vare(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /varer/{id:int}")
    la navn = web.request_json_field_or(ctx, "navn", "x")
    returner web.response_builder(200, {}, "ok")
}

funksjon dok_sider(ctx: ordbok_tekst) -> ordbok_tekst {
    // Dokumentasjonsrute skal skjulast frå skjemaet.
    web.route("GET /openapi.json")
    returner web.response_builder(200, {}, "{}")
}

funksjon start() -> heltall {
    la oppsett: ordbok = {}
    oppsett["tittel"] = "Bokhandel \"X\""
    oppsett["versjon"] = "3.2.1"
    oppsett["beskriving"] = "Eit API med \"hermeteikn\""
    la tagmap: ordbok = {}
    tagmap["standard"] = "Hovudruter"
    oppsett["tags"] = tagmap
    la eks: ordbok = {}
    eks["lag_vare"] = "{\"navn\":\"Bok\"}"
    oppsett["eksempel"] = eks

    la spec = web.openapi_json_med(oppsett)

    // 1) Gyldig JSON som parsar med json_parse_raw (escaping av " i tittel/beskriving).
    assert(json_er_gyldig(spec))
    la parsed = builtin.json_parse_raw(spec)
    assert_eq(builtin.type(parsed), "ordbok")

    // 2) OpenAPI 3.1.
    assert_eq(tekst(parsed["openapi"]), "3.1.0")

    // 3) Metadata frå oppsett (tittel/versjon/beskriving), med escaping.
    la info = parsed["info"]
    assert_eq(tekst(info["title"]), "Bokhandel \"X\"")
    assert_eq(tekst(info["version"]), "3.2.1")
    assert_eq(tekst(info["description"]), "Eit API med \"hermeteikn\"")

    // 4) Dokumentasjonsruta er skjult.
    la paths = parsed["paths"]
    assert(ikkje finnes_nøkkel(paths, "/openapi.json"))

    // 5) GET+POST samla i eitt path-item på /varer/{id}.
    assert(finnes_nøkkel(paths, "/varer/{id}"))
    la item = paths["/varer/{id}"]
    assert(finnes_nøkkel(item, "get"))
    assert(finnes_nøkkel(item, "post"))

    // 6) Path-param frå mønsteret, in:path, type integer.
    la getop = item["get"]
    la params = getop["parameters"]
    la fann_path_param = usann
    la j: heltall = 0
    mens j < lengde(params) {
        la p = params[j]
        hvis tekst(p["name"]) == "id" og tekst(p["in"]) == "path" {
            fann_path_param = sann
            assert_eq(tekst(p["required"]), "sann")
            la sch = p["schema"]
            assert_eq(tekst(sch["type"]), "integer")
        }
        j = j + 1
    }
    assert(fann_path_param)

    // query-param side skal òg vere med (in:query).
    assert(t.inneholder(spec, "\"name\":\"side\",\"in\":\"query\""))

    // 7) Unik operationId per operasjon.
    assert_eq(tekst(getop["operationId"]), "liste_varer")
    la postop = item["post"]
    assert_eq(tekst(postop["operationId"]), "lag_vare")

    // 8) requestBody-eksempel frå oppsett["eksempel"].
    assert(t.inneholder(spec, "\"example\":{\"navn\":\"Bok\"}"))

    // 9) Topp-nivå tags med beskriving.
    assert(t.inneholder(spec, "\"tags\":[{\"name\":\"standard\",\"description\":\"Hovudruter\"}]"))

    // 10) response_schema brukt: GET returnerer liste_tekst → array.
    la resp200 = getop["responses"]["200"]
    la respschema = resp200["content"]["application/json"]["schema"]
    assert_eq(tekst(respschema["type"]), "array")

    returner 0
}
