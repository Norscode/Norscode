# W6 (WASM-sporet): asynk nett via tilbakekall — std/wasm_nett.no (fetch mot same opphav),
# hjelparen Q i lastaren og deltakar-demoen examples/wasm_deltakarar/.
#
# Utan nettlesar (alle plattformer):
#   1. Paritetskorpuset w6_nett (kh.køyr_korpus): dei reine funksjonane (validering,
#      førespurnad-JSON, konvolutten, klassifisering, HentFeil) gjev fasiten i VM-en, og same
#      utskrift i Chrome når han finst.
#   2. Stubbane kastar i VM-en; ugyldige førespurnader kastar HentFeil før noko blir sendt.
#   3. Demo-reglane og feilmeldingane i VM-en (same kode som i WASM): prosentkoding (rundtur
#      med æøå, øydelagd koding), validering av lista, feilmelding() for kvar feilart.
#   4. Tenaren (nc serve utan sokkel): GET gjev standardlista; POST lagrar og set ein
#      HttpOnly-informasjonskapsel; GET med «Cookie» (stor forbokstav, som frå nettlesaren)
#      gjev den lagra lista; ugyldig JSON, feil form og 61 deltakarar gjev 400 med feila;
#      ein øydelagd kapsel gjev standardlista.
#   5. Bygg: nett-klientane importerer hent_start og hent_svar og eksporterer __hent_ferdig;
#      demo-lastaren er under taket.
# Med Chrome (valfri, SKIP utan; NC_CHROME=<sti>), via nettlesar-benken (std/wasm_nettlesar.no):
#   6. tests/fixtures/wasm_w6_nett_testklient.no: ti førespurnader og offline, loggen lik fasiten
#      (sende-rekkjefølgje trass i at avbrot og tidsavbrot kjem først, ok/status/json/avbrote/
#      tidsavbrot/nettverk, tilbakekall som kastar gjev ERROR-linje), ingen «Uncaught», og nc
#      serve er avslutta av /api/stopp.
#   7. Demoen i testbygg: lasting, legg til, lagre, hent att (lagra på tenaren), fjern, avvist
#      av tenaren (400) og offline, loggen lik fasiten, ingen «Uncaught».
#   8. Demoen i produksjonsbygg: «/» viser dei 10 frå tenaren når sida er ferdig.
bruk std.wasm_nett som nett
bruk std.wasm_nettlesar som benk
bruk examples.wasm_deltakarar.reglar som reglar
bruk examples.wasm_deltakarar.klient som demo
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_korpus_hjelp som kh
bruk tests.fixtures.wasm_serve_hjelp som sh

funksjon rot() -> tekst { returner "build/wasm/test_w6" }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

funksjon tal_av(t: tekst, nål: tekst) -> heltall {
    la n = 0
    la rest = t
    la p = builtin.index_of(rest, nål)
    mens p >= 0 {
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
        p = builtin.index_of(rest, nål)
    }
    returner n
}

funksjon krev_lik(namn: tekst, fekk: tekst, venta: tekst) -> heltall {
    hvis fekk != venta {
        skriv(namn + ": skil seg frå fasiten, " + kh.skilnad(fekk, venta) + "\nFekk:\n" + fekk + "\nFasit:\n" + venta + "\n")
        assert(usann)
    }
    returner 0
}

funksjon nett_fasit() -> tekst {
    la l = [
        "ugyldig: HentFeil: ugyldig førespurnad: URL-en må vere ein sti på same opphav («/…»): http://anna.no/x",
        "ugyldig: HentFeil: ugyldig førespurnad: GET kan ikkje ha kropp",
        "sende: ventande=6",
        "avbryt 3: sann usann usann",
        "1: ok 200 kropp=«sein»",
        "2: ok 200 json={\"hei\":\"verda\",\"tal\":[1,2.5,\"æ\"],\"tom\":{},\"null\":null} x-nc-svar=ja",
        "3: feil avbrote 0 GET /api/tekst",
        "4: ok 201 json={\"fekk\":{\"namn\":\"Åse \\\"B\\\"\",\"tal\":[1,2.5,-3],\"ja\":true},\"metode\":\"post\",\"header\":\"hei\",\"type\":\"application/json\"}",
        "5: feil status 404 GET /api/404 kropp={\"feil\":\"finst ikkje\"}",
        "5: fanga HentFeil: status GET /api/404: status 404",
        "6: feil tidsavbrot 0 GET /api/sakte",
        "fase 2: ventande=0",
        "7: feil json 200 GET /api/ugyldig_json melding=JSON: uventa teikn: i",
        "ERROR: Uventa i tilbakekallet til {\"hei\":\"verda\",\"tal\":[1,2.5,\"æ\"],\"tom\":{},\"null\":null}",
        "ERROR: HentFeil: status GET /api/500: status 500",
        "10: ok 200 kropp=«rå tekst",
        "linje 2 æøå»",
        "fase 3: ventande=0",
        "stopp: feil nettverk 0",
        "etter stopp: feil nettverk 0 HentFeil: nettverk GET /api/ok: nettverksfeil (TypeError)"
    ]
    returner builtin.join(l, "\n") + "\n"
}

funksjon demo_fasit() -> tekst {
    la rader = " | første=Aksel | siste="
    la l = [
        "start: – | status=Hentar deltakarlista … | lagre=disabled | aria-busy=true",
        "lasta: 10 deltakarar | status=10 deltakarar. | feil= (skjult) | ulagra skjult | lagre=" + rader + "Åse",
        "skjema: E-postadressa manglar eit domene som eksempel.no.",
        "lagt til: 11 deltakarar | status=10 deltakarar. | feil= (skjult) | ulagra synleg | lagre=" + rader + "Ny Person",
        "lagrar: 11 deltakarar | status=Lagrar … | feil= (skjult) | ulagra synleg | lagre=disabled" + rader + "Ny Person",
        "lagra: 11 deltakarar | status=Lagra 11 deltakarar. | feil= (skjult) | ulagra skjult | lagre=" + rader + "Ny Person",
        "henta att: 11 deltakarar | status=11 deltakarar. | feil= (skjult) | ulagra skjult | lagre=" + rader + "Ny Person",
        "fjerna: 10 deltakarar | status=11 deltakarar. | feil= (skjult) | ulagra synleg | lagre=" + rader + "Ny Person",
        "avvist: 10 deltakarar | status= | feil=Kunne ikkje lagre: Deltakar 1: Namnet må ha minst 2 teikn. Deltakar 1: E-postadressa manglar namn før @. (synleg) | ulagra synleg | lagre=" + rader + "Ny Person",
        "hentar offline: 10 deltakarar | status=Hentar deltakarlista … | feil= (skjult) | ulagra synleg | lagre=disabled" + rader + "Ny Person",
        "offline: 10 deltakarar | status= | feil=Kunne ikkje hente lista: fekk ikkje kontakt med tenaren. (synleg) | ulagra synleg | lagre=" + rader + "Ny Person",
        "ferdig"
    ]
    returner builtin.join(l, "\n") + "\n"
}

# ── 2 ──
funksjon stubbar_og_validering() -> heltall {
    la stubb = ""
    prøv {
        nett.hent("/api/ok", fun(s) -> 0, fun(f) -> 0)
    } fang (e) {
        stubb = tekst(e)
    }
    assert(inneheld(stubb, "wasm_vert.hent_start finst berre i nettlesaren"))
    la ugyldig = ""
    prøv {
        nett.send(nett.førespurnad("TRACE", "/api"), fun(s) -> 0, fun(f) -> 0)
    } fang (e: HentFeil) {
        ugyldig = tekst(e)
    }
    assert_eq(ugyldig, "HentFeil: ugyldig førespurnad: ukjend metode TRACE (GET, POST, PUT, PATCH, DELETE, HEAD)")
    assert_eq(nett.ventande(), 0)
    returner 0
}

# ── 3 ──
funksjon demo_reglar() -> heltall {
    la s = "[{\"namn\":\"Åse Berg\",\"epost\":\"a@b.no\"}] ;,=%"
    la k = reglar.prosent_kod(s)
    assert(ikkje inneheld(k, ";") og ikkje inneheld(k, " ") og ikkje inneheld(k, ","))
    assert(inneheld(k, "%C3%85se%20Berg"))
    assert_eq(reglar.prosent_dekod(k), s)
    assert_eq(reglar.prosent_dekod("%ZZ"), "")
    assert_eq(reglar.prosent_dekod("abc%4"), "")
    assert_eq(lengde(reglar.valider_liste(reglar.standardliste())), 0)
    assert_eq(reglar.valider_liste("x")[0], "Deltakarane må vere ei liste.")
    la f = reglar.valider_liste([{"namn": "A", "epost": "x"}, {"namn": "Bo"}])
    assert_eq(builtin.join(f, " "), "Deltakar 1: Namnet må ha minst 2 teikn. Deltakar 1: E-postadressa manglar namn før @. Deltakar 2: manglar namn eller e-post.")
    assert_eq(builtin.json_stringify(reglar.liste_frå_kapsel(reglar.kapsel_for([{"namn": "Bo", "epost": "bo@b.no"}]))), "[{\"namn\":\"Bo\",\"epost\":\"bo@b.no\"}]")
    assert_eq(lengde(reglar.liste_frå_kapsel("%5Bikkje")), 10)
    # feilmelding() for kvar art (same kode køyrer i WASM)
    la st400 = {"art": "status", "status": 400, "kropp": "{\"feil\":[\"A.\",\"B.\"]}", "melding": "status 400"}
    assert_eq(demo.feilmelding("Kunne ikkje lagre", st400), "Kunne ikkje lagre: A. B.")
    st400["kropp"] = "ikkje json"
    assert_eq(demo.feilmelding("Kunne ikkje lagre", st400), "Kunne ikkje lagre: tenaren avviste førespurnaden (status 400).")
    assert_eq(demo.feilmelding("X", {"art": "status", "status": 503, "kropp": "", "melding": ""}), "X: tenaren svara med status 503.")
    assert_eq(demo.feilmelding("X", {"art": "nettverk", "status": 0, "melding": ""}), "X: fekk ikkje kontakt med tenaren.")
    assert_eq(demo.feilmelding("X", {"art": "tidsavbrot", "status": 0, "melding": ""}), "X: tenaren svara ikkje i tide.")
    assert_eq(demo.feilmelding("X", {"art": "json", "status": 200, "melding": ""}), "X: ugyldig svar frå tenaren.")
    assert_eq(builtin.json_stringify(demo.til_tenaren([{"id": 3, "namn": "a", "epost": "b"}])), "[{\"namn\":\"a\",\"epost\":\"b\"}]")
    skriv("demo-reglar og feilmeldingar OK (VM)\n")
    returner 0
}

# ── 4 ──
funksjon tenaren(app: tekst) -> heltall {
    la json = [["Content-Type", "application/json"]]
    la ein = "{\"deltakarar\":[{\"namn\":\" Åse Berg \",\"epost\":\"a@b.no\"}]}"
    la kapsel = reglar.kapsel_for([{"namn": "Åse Berg", "epost": "a@b.no"}])
    la mange = []
    la i = 0
    mens i < 61 {
        legg_til(mange, {"namn": "N" + tekst(i), "epost": "n@b.no"})
        i = i + 1
    }
    la reqs = [
        sh.førespurnad("/api/deltakarar"),
        sh.førespurnad_med("POST", "/api/deltakarar", json, ein),
        sh.førespurnad_med("GET", "/api/deltakarar", [["Cookie", "a=1; nc_deltakarar=" + kapsel + "; b=2"]], ""),
        sh.førespurnad_med("POST", "/api/deltakarar", json, "{ikkje"),
        sh.førespurnad_med("POST", "/api/deltakarar", json, "{\"x\":1}"),
        sh.førespurnad_med("POST", "/api/deltakarar", json, builtin.json_stringify({"deltakarar": mange})),
        sh.førespurnad_med("GET", "/api/deltakarar", [["Cookie", "nc_deltakarar=%ZZ"]], "")
    ]
    la r = sh.serve(app, reqs)
    la svar = r["svar"]
    assert_eq(svar[0]["status"], "200")
    assert(builtin.starts_with(sh.hdr(svar[0], "content-type"), "application/json"))
    assert_eq(sh.hdr(svar[0], "cache-control"), "no-store")
    assert_eq(svar[0]["body"], builtin.json_stringify({"deltakarar": reglar.standardliste()}))
    assert_eq(svar[1]["status"], "200")
    assert_eq(svar[1]["body"], "{\"lagra\":1,\"deltakarar\":[{\"namn\":\"Åse Berg\",\"epost\":\"a@b.no\"}]}")
    la sc = sh.hdr(svar[1], "set-cookie")
    assert(builtin.starts_with(sc, "nc_deltakarar=" + kapsel + ";"))
    assert(inneheld(sc, "HttpOnly") og inneheld(sc, "SameSite=Strict") og inneheld(sc, "Path=/"))
    assert_eq(svar[2]["body"], "{\"deltakarar\":[{\"namn\":\"Åse Berg\",\"epost\":\"a@b.no\"}]}")
    assert_eq(svar[3]["status"], "400")
    assert_eq(svar[3]["body"], "{\"feil\":[\"Ugyldig JSON: JSON: uventa teikn: i\"]}")
    assert_eq(sh.hdr(svar[3], "set-cookie"), "")
    assert_eq(svar[4]["status"], "400")
    assert(inneheld(svar[4]["body"], "Venta {"))
    assert_eq(svar[5]["status"], "400")
    assert_eq(svar[5]["body"], "{\"feil\":[\"Høgst 60 deltakarar (fekk 61).\"]}")
    assert_eq(svar[6]["body"], svar[0]["body"])
    skriv("tenaren: " + tekst(lengde(reqs)) + " førespurnader OK (" + tekst(r["ms"]) + " ms)\n")
    returner 0
}

funksjon har(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon krev_bygg_nett(linje: tekst, kva: tekst) -> heltall {
    la imp = hjelp.liste_felt(linje, "importar")
    la eksp = hjelp.liste_felt(linje, "eksportar")
    la ok = har(imp, "hent_start") og har(imp, "hent_svar") og har(eksp, "__hent_ferdig") og har(imp, "slepp")
    hvis ikkje ok {
        skriv(kva + ": manglar nett-importane eller __hent_ferdig: " + linje + "\n")
        assert(usann)
    }
    returner 0
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())
    # ── 1. Korpus (VM mot fasit, bygg, Chrome) ──
    la k = kh.køyr_korpus("test_wasm_w6", rot() + "/korpus", ["w6_nett"], [], "48361", {})
    # ── 2–3 ──
    stubbar_og_validering()
    demo_reglar()
    assert_eq(nett.førespurnad("GET", "/")["tidsgrense_ms"], 8000)
    # ── 5. Bygg (serve-inngangane blir brukte i 4 og i Chrome-stega) ──
    la l_nett = hjelp.bygg_klient_app("tests/fixtures/wasm_w6_nett_testklient.no", rot() + "/nett", sann, "tests/fixtures/wasm_w6_nett_testapp.no")
    krev_bygg_nett(l_nett, "testklienten")
    la l_prod = hjelp.bygg_klient_app("examples/wasm_deltakarar/klient.no", rot() + "/demo_prod", usann, "examples/wasm_deltakarar/app.no")
    krev_bygg_nett(l_prod, "demoen")
    la lastar = fil_les(hjelp.root() + "/" + rot() + "/demo_prod/nc.js")
    skriv("demo: " + l_prod + "\n")
    assert(lengde(lastar) <= 2560)
    assert(ikkje inneheld(lastar, "test_"))
    # ── 4. Tenaren utan sokkel ──
    tenaren(hjelp.serve_inngang(rot() + "/demo_prod"))

    hvis ikkje k["chrome"] {
        returner 0
    }
    la økt = benk.ny_økt("test_w6")
    # ── 6. Nett-testklienten ──
    la s = benk.start_serve(økt, hjelp.serve_inngang(rot() + "/nett"), "48362")
    assert_eq(s["status"], "kjorer")
    la r = benk.last_side(økt, "http://127.0.0.1:48362/test", {})
    krev_lik("nett-testklienten", r["logg"], nett_fasit())
    assert(ikkje r["uncaught"])
    assert(inneheld(r["dom"], "<output id=\"nc-resultat\">ferdig</output>"))
    # /api/stopp avslutta tenaren (offline-steget)
    la t0 = builtin.tid_ms()
    mens benk.serve_køyrer(s) og builtin.tid_ms() - t0 < 5000 { }
    assert(ikkje benk.serve_køyrer(s))
    skriv("nett-testklienten: " + tekst(tal_av(r["logg"], "\n")) + " logglinjer lik fasiten, ingen «Uncaught», tenaren stoppa (" + tekst(r["ms"]) + " ms)\n")
    # ── 7. Demoen i testbygg ──
    hjelp.bygg_klient_app("tests/fixtures/wasm_deltakarar_testklient.no", rot() + "/demo_test", sann, "tests/fixtures/wasm_deltakarar_testapp.no")
    benk.start_serve(økt, hjelp.serve_inngang(rot() + "/demo_test"), "48363")
    la d = benk.last_side(økt, "http://127.0.0.1:48363/test", {})
    krev_lik("demoen (testbygg)", d["logg"], demo_fasit())
    assert(ikkje d["uncaught"])
    # ── 8. Demoen i produksjonsbygg ──
    benk.start_serve(økt, hjelp.serve_inngang(rot() + "/demo_prod"), "48364")
    la p = benk.last_side(økt, "http://127.0.0.1:48364/", {})
    assert(inneheld(p["dom"], "<output id=\"nc-resultat\">10 deltakarar</output>"))
    assert(inneheld(p["dom"], "role=\"status\" aria-live=\"polite\">10 deltakarar.</span>"))
    assert(inneheld(p["dom"], "<ul id=\"liste\" aria-busy=\"false\">"))
    assert_eq(tal_av(p["dom"], "<li>"), 10)
    assert_eq(tal_av(p["dom"], "data-nc-klikk=\"fjern\""), 10)
    assert(ikkje p["uncaught"])
    la ry = benk.rydd(økt)
    assert_eq(ry["attverande"], 0)
    skriv("demoen: testbygg lik fasiten, produksjon viser 10 frå tenaren\n")
    skriv("test_wasm_w6 OK\n")
    returner 0
}
