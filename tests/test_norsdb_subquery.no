bruk std.db som db

// M4: FROM-subquery-støtte i std.norsdb (std-lag, rører ikkje vm-kjernen).
//
// SELECT ... FROM ( <subquery> ) [alias] ... — indre spørjing blir køyrd,
// materialisert som midlertidig tabell og den ytre spørjinga skriven om.
// Dekker filter på subquery-kolonne, COUNT, nøsta subquery, ORDER/LIMIT på
// ytre, projeksjons-avgrensing, og at normale spørjingar er uendra.
//
// MERK: db-testar krev korrekt precompilert vm-NCB (`vm_active_functions`).
// Verifisert lokalt via `./bin/nc run`; køyrer i CI med gyldig NCB.

funksjon start() -> heiltall {
    la h = db.open(":memory:")
    assert_eq(db.execute(h, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    db.execute(h, "INSERT INTO folk (navn, alder, by) VALUES ('Ada', 37, 'Oslo')")
    db.execute(h, "INSERT INTO folk (navn, alder, by) VALUES ('Linus', 55, 'Bergen')")
    db.execute(h, "INSERT INTO folk (navn, alder, by) VALUES ('Grace', 30, 'Oslo')")
    db.execute(h, "INSERT INTO folk (navn, alder, by) VALUES ('Alan', 41, 'Oslo')")
    db.execute(h, "INSERT INTO folk (navn, alder, by) VALUES ('Edsger', 28, 'Bergen')")

    // COUNT over subquery-resultat.
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM (SELECT navn, alder FROM folk WHERE alder >= 30)"), 4)

    // Ytre WHERE på ein kolonne subquery eksponerer.
    assert_eq(db.query_text(h, "SELECT navn FROM (SELECT navn, alder, by FROM folk WHERE by = 'Oslo') WHERE alder > 40"), "Alan")

    // Nøsta subquery (to nivå).
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM (SELECT navn FROM (SELECT navn, alder, by FROM folk WHERE alder >= 30) WHERE by = 'Oslo')"), 3)

    // ORDER BY + LIMIT på den ytre spørjinga.
    assert_eq(db.query_text(h, "SELECT navn FROM (SELECT navn, alder FROM folk WHERE alder >= 30) ORDER BY alder DESC LIMIT 1"), "Linus")

    // Subquery med alias.
    assert_eq(db.query_text(h, "SELECT navn FROM (SELECT navn, alder FROM folk WHERE by = 'Bergen') AS b WHERE alder > 50"), "Linus")

    // Projeksjons-avgrensing: 'by' er ikkje projisert, så den er skjult utanfor.
    assert_eq(db.query_text(h, "SELECT by FROM (SELECT navn FROM folk WHERE alder >= 30)"), "")

    // Normal spørjing utan subquery er uendra.
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE id = 1"), "Ada")
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk"), 5)

    db.close(h)
    skriv("test_norsdb_subquery: OK (8 assertar)\n")
    returner 0
}
