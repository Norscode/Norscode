# R1 / F01 + F19: for-lykkja itererer ei ordbok over nøklane og ein tekst per teikn
# (UTF-8-skalar), ikkje per byte. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # Tekst: eitt steg per teikn, også for 2-, 3- og 4-byte-teikn.
    la p_tekst = "funksjon start() -> tekst {\n" +
        "    la ut = \"\"\n" +
        "    la n = 0\n" +
        "    for c i \"hå€😀z\" {\n" +
        "        ut = ut + \"<\" + c + \">\"\n" +
        "        n = n + 1\n" +
        "    }\n" +
        "    returner ut + tekst(n)\n" +
        "}\n"
    assert_eq(utfor(p_tekst), "<h><å><€><😀><z>5")

    # Ordbok: nøklane, ikkje ingenting.
    la p_ordbok = "funksjon start() -> tekst {\n" +
        "    la o = {\"b\": 1, \"a\": 2}\n" +
        "    la ut = \"\"\n" +
        "    for k i o { ut = ut + k + \"=\" + tekst(o[k]) + \";\" }\n" +
        "    returner ut\n" +
        "}\n"
    la r = utfor(p_ordbok)
    assert(r == "b=1;a=2;" eller r == "a=2;b=1;")

    # Liste: uendra, og fortsett/bryt verkar med det nye steget.
    la p_liste = "funksjon start() -> tekst {\n" +
        "    la ut = \"\"\n" +
        "    for x i [1, 2, 3, 4, 5] {\n" +
        "        hvis x == 2 { fortsett }\n" +
        "        hvis x == 5 { bryt }\n" +
        "        ut = ut + tekst(x)\n" +
        "    }\n" +
        "    returner ut\n" +
        "}\n"
    assert_eq(utfor(p_liste), "134")

    # fortsett i tekst-lykkja hoppar til neste teikn, ikkje neste byte.
    la p_fortsett = "funksjon start() -> tekst {\n" +
        "    la ut = \"\"\n" +
        "    for c i \"æøå\" {\n" +
        "        hvis c == \"ø\" { fortsett }\n" +
        "        ut = ut + c\n" +
        "    }\n" +
        "    returner ut\n" +
        "}\n"
    assert_eq(utfor(p_fortsett), "æå")

    # Tom tekst og tom ordbok: kroppen køyrer ikkje.
    la p_tom = "funksjon start() -> tekst {\n" +
        "    la n = 0\n" +
        "    for c i \"\" { n = n + 1 }\n" +
        "    for k i {} { n = n + 10 }\n" +
        "    returner tekst(n)\n" +
        "}\n"
    assert_eq(utfor(p_tom), "0")
    returner 0
}
