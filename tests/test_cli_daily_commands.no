bruk tools.process_runner som prosess

funksjon repo_root() -> tekst {
    prøv {
        la root = miljo_hent("NORSCODE_ROOT")
        hvis root != "" { returner root }
    } fang (e) {}
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon krev_ok(argv: liste_tekst, namn: tekst) {
    la root = repo_root()
    la resultat = prosess.køyr(root + "/bin/nc", argv, root, {}, 120000)
    hvis ikkje prosess.ok(resultat) {
        kast namn + " feilet: " + tekst(resultat["stderr"])
    }
    hvis builtin.contains(tekst(resultat["stdout"]), "Sikkerheitsfeil: manglar capability") {
        kast namn + " manglar runtime-capability"
    }
}

funksjon start() -> heiltall {
    krev_ok(["doctor"], "nc doctor")
    krev_ok(["format", "tests/test_nc_main_smoke.no"], "nc format")
    krev_ok(["lint", "tests/test_nc_main_smoke.no", "--check"], "nc lint --check")
    skriv("test_cli_daily_commands OK")
    returner 0
}
