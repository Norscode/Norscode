bruk std.db som db

funksjon start() -> heiltall {
    assert_eq(db.backend(), "norsdb-pure-v1")
    la status = db.status()
    assert_eq(status["external_runtime"], "false")
    assert_eq(status["sqlite"], "optional-adapter")

    la handle = db.open(":memory:")
    assert(db.ping(handle))
    assert_eq(db.execute(handle, "CREATE TABLE users (id INTEGER, name TEXT, age INTEGER)"), 0)
    assert_eq(db.execute(handle, "INSERT INTO users (name, age) VALUES ('Ada', 37)"), 1)
    assert_eq(db.execute(handle, "INSERT INTO users (name, age) VALUES ('Linus', 55)"), 1)
    assert_eq(db.query_int(handle, "SELECT COUNT(*) FROM users"), 2)
    assert_eq(db.query_text(handle, "SELECT name FROM users WHERE id = 1"), "Ada")

    assert(db.begin(handle))
    assert_eq(db.execute(handle, "UPDATE users SET age = 38 WHERE id = 1"), 1)
    assert(db.rollback(handle))
    assert_eq(db.query_text(handle, "SELECT age FROM users WHERE id = 1"), "37")
    assert(db.close(handle))

    la p = db.pool(":memory:", 2)
    assert_eq(db.pool_size(p), 1)
    la conn = db.pool_acquire(p)
    assert(db.ping(conn))
    assert(db.close(conn))
    assert_eq(db.pool_size(p), 1)
    assert(db.pool_close(p))
    returner 0
}
