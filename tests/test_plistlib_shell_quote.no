bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/plistlib.no")
    assert(t.inneholder(src, "norscode-property-list-v1"))
    assert(t.inneholder(src, "builtin.property_list_operation"))
    assert(t.inneholder(src, "\"operation\": operation"))
    assert(t.inneholder(src, "_er_binær_plist(sti)"))
    assert(t.inneholder(src, "request[\"data\"] = format_xml(data)"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "plutil "))
    skriv("test_plistlib_shell_quote OK")
    returner 0
}
