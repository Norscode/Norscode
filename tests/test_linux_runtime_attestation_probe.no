// Samla probe for ekte Linux-attestasjon. Éi kompilering held ARM64-lana
// praktisk utan å redusere ABI-dekninga.
//
// NORSCODE_LINUX_PROBE_SECTION (core | argon2id | tls, standard all) lèt driveren
// køyre kvar del i sin eigen prosess. På fersk seed går bump-heapen ikkje attende
// til fri-lista: TLS-matrisa åleine brukar ~715 MB (målt), og argon2id(64 MiB) i
// same prosess skyv heapen over SOFT_LIMIT (0x3C600000) → collect-storm uansett
// rekkjefølgje (TLS etter Argon2id: >45 min i attestasjonen; Argon2id etter TLS:
// ikkje ferdig på 15 min). Kvar del for seg er rask. Dekninga er den same.

bruk tests.test_native_filesystem_management som filesystem
bruk tests.test_process_os_sandbox som sandbox
bruk tests.test_native_network_event_loop som network
bruk tests.test_native_tls_event_loop som tls

funksjon seksjon() -> tekst {
    la del = ""
    prøv { del = builtin.miljo_hent("NORSCODE_LINUX_PROBE_SECTION") } fang (e) { del = "" }
    hvis del == "" { returner "all" }
    returner del
}

funksjon start() -> heiltall {
    la del = seksjon()
    hvis del != "all" og del != "core" og del != "argon2id" og del != "tls" {
        skriv("ukjend NORSCODE_LINUX_PROBE_SECTION: " + del + "\n")
        returner 2
    }
    hvis del == "all" eller del == "core" {
        assert_eq(filesystem.start(), 0)
        assert_eq(sandbox.start(), 0)
        assert_eq(network.start(), 0)

        la tråd = builtin.thread_spawn({
            "abi": "norscode-native-thread-v1",
            "operation": "spawn",
            "fn": "thread.noop",
            "args": {},
            "name": "linux-attestation",
            "stack_bytes": "65536"
        })
        assert_eq(tråd["status"], "started")
        la ferdig = builtin.thread_join({
            "abi": "norscode-native-thread-v1",
            "operation": "join",
            "handle": tråd["handle"],
            "thread_id": tråd["thread_id"],
            "timeout_ms": "5000"
        })
        assert_eq(ferdig["status"], "finished")
    }
    hvis del == "all" eller del == "argon2id" {
        assert_eq(builtin.argon2id("password", "somesalt", 65536, 2, 1, 32),
            "09316115d5cf24ed5a15a31a3ba326e5cf32edc24702987c02b6566f61913cf7")
    }
    hvis del == "all" eller del == "tls" {
        assert_eq(tls.start(), 0)
    }
    skriv("test_linux_runtime_attestation_probe OK\n")
    returner 0
}
