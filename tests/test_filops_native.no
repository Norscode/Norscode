bruk std.filops som fo

funksjon start() -> heltall {
    la rot = ".norscode/test-filops-" + builtin.random_hex(8)
    assert(fo.lag_katalogar(rot + "/a/b"))
    builtin.fil_skriv(rot + "/a/b/data.bin", "abc\u0000def")

    la katalog_ok = fo.katalog_finnes(rot + "/a")
    assert(katalog_ok)
    la fil_ok = fo.fil_finnes(rot + "/a/b/data.bin")
    assert(fil_ok)
    la storleik_verdi = fo.fil_storleik(rot + "/a/b/data.bin")
    assert(storleik_verdi > 0)
    assert(fo.kopier2(rot + "/a/b/data.bin", rot + "/kopi.bin"))
    assert(fo.fil_storleik(rot + "/kopi.bin") == fo.fil_storleik(rot + "/a/b/data.bin"))
    assert(fo.kopier_tre(rot + "/a", rot + "/tre"))
    assert(fo.fil_finnes(rot + "/tre/b/data.bin"))
    assert(fo.flytt(rot + "/kopi.bin", rot + "/flytta.bin"))
    assert(ikkje fo.fil_finnes(rot + "/kopi.bin"))
    assert(fo.fil_finnes(rot + "/flytta.bin"))

    la filer = fo.walk(rot)
    assert(lengde(filer) == 3)
    assert(lengde(fo.glob(rot + "/*.bin")) == 1)
    assert(lengde(fo.glob_rekursiv(rot, "*.bin")) == 3)
    assert(fo.normaliser_sti("a/./b/../c") == "a/c")
    assert(fo.relativ_sti("/a/b", "/a/c/d") == "../c/d")

    la tmp = fo.midlertidig_fil("filops-")
    assert(tmp != "")
    assert(fo.fil_finnes(tmp))
    assert(fo.slett_fil(tmp))
    la sletta = fo.slett_tre(rot)
    hvis miljo_hent("NORSCODE_REQUIRE_NATIVE_RMDIR") == "1" {
        assert(sletta)
        assert(ikkje builtin.fil_finnes(rot))
    }

    skriv("test_filops_native OK")
    returner 0
}
