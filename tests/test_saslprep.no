bruk std.saslprep som sp

// SASLprep (RFC 4013): kjende svar. Strengar er bytestrengar; hjelparen s() bygger dei frå bytes.

funksjon s(bytes: liste_heiltall) -> tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(bytes) { legg_til(ut, builtin.chr(bytes[i])) i = i + 1 }
    returner builtin.join(ut, "")
}

funksjon start() -> heiltall {
    // Utskrivbart ASCII er uendra
    assert_eq(sp.saslprep("user"), "user")
    assert_eq(sp.saslprep("hemmeleg-pw 123!"), "hemmeleg-pw 123!")
    // Norske bokstavar er allereie NFKC (æ, ø, å har ingen dekomponering)
    assert_eq(sp.saslprep("blåbær"), "blåbær")
    assert_eq(sp.saslprep("Ærlig Østen Åse"), "Ærlig Østen Åse")
    // RFC 4013 §3-eksempla
    assert_eq(sp.saslprep(s([73, 194, 173, 88])), "IX")                 // soft hyphen blir fjerna
    assert_eq(sp.saslprep(s([97, 194, 160, 98])), "a b")                // NBSP -> mellomrom
    assert_eq(sp.saslprep(s([194, 170])), "a")                          // ª -> a (NFKC)
    // Fullbreidd og ligaturar (NFKC)
    assert_eq(sp.saslprep(s([239, 188, 161, 239, 188, 162])), "AB")
    assert_eq(sp.saslprep(s([239, 172, 129])), "fi")
    assert_eq(sp.saslprep(s([194, 178])), "2")
    // Dekomponert å (a + ring) blir samansett
    assert_eq(sp.saslprep(s([97, 204, 138])), s([195, 165]))
    assert_eq(sp.saslprep(s([69, 204, 129])), s([195, 137]))
    // Ideografisk mellomrom -> U+0020
    assert_eq(sp.saslprep(s([97, 227, 128, 128, 98])), "a b")
    // Feil: forbode teikn, ugyldig UTF-8, bidi -> strikt gir ok=usann, saslprep() gir rått passord
    la ctl = s([97, 7, 195, 165])
    assert(ikkje sp.saslprep_strikt(ctl)["ok"])
    assert_eq(sp.saslprep(ctl), ctl)
    la ugyldig = s([97, 255, 98])
    assert(ikkje sp.saslprep_strikt(ugyldig)["ok"])
    assert_eq(sp.saslprep(ugyldig), ugyldig)
    la privat = s([239, 163, 128])           // U+F8C0 (private use)
    assert(ikkje sp.saslprep_strikt(privat)["ok"])
    la bidi = s([97, 215, 144])              // latin a + hebraisk alef
    assert(ikkje sp.saslprep_strikt(bidi)["ok"])
    assert(sp.saslprep_strikt(s([215, 144, 215, 145]))["ok"])   // berre hebraisk
    skriv("test_saslprep OK\n")
    returner 0
}
