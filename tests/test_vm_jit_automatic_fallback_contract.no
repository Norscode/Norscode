funksjon krev(kjelde: tekst, nål: tekst) {
    hvis ikkje builtin.contains(kjelde, nål) { skriv("Manglar JIT-kontrakt: " + nål + "\n") }
    assert(builtin.contains(kjelde, nål))
}

funksjon start() -> heiltall {
    la vm = fil_les("selfhost/vm.no")
    la testkøyrar = fil_les("tools/nc_test.no")

    // Varme funksjonar blir valde automatisk gjennom ein målbar terskel.
    krev(vm, "la threshold: heiltall = 50")
    krev(vm, "miljo_hent(\"NORSCODE_VM_JIT_THRESHOLD\")")
    krev(vm, ">= threshold")
    krev(vm, "\"operation\": \"compile\"")
    krev(vm, "vm_metric_inc(functions, \"jit_compiles\")")

    // Både kompilatorfeil og køyringsfeil går tilbake til vanleg VM-kall.
    krev(vm, "entry[\"eligible\"] = \"usann\"")
    krev(vm, "vm_metric_inc(functions, \"jit_compile_failures\")")
    krev(vm, "entry[\"handle\"] = \"\"")
    krev(vm, "vm_metric_inc(functions, \"jit_deoptimizations\")")
    krev(vm, "hvis jit_result[\"used\"] == \"sann\"")
    krev(vm, "hvis løyst_namn != \"\" og lengde(try_stack) == 0")

    // Den levande testflata senkar terskelen kontrollert og krev jit.execute.
    krev(testkøyrar, "pure_run[\"NORSCODE_VM_JIT_THRESHOLD\"] = \"2\"")
    krev(testkøyrar, "p[\"capabilities\"] = \"jit.execute\"")

    skriv("test_vm_jit_automatic_fallback_contract OK")
    returner 0
}
