# W2 (WASM-sporet): lowringa av unnatak, closures og metodekall, utan nettlesar.
#
# Kjeldene blir skrivne til build/wasm/test_w2/ og bygde med tools/nc_wasm.no (barne-
# prosessar i VM-fastmodus; CLI-en validerer modulen med stakk- og typesjekken før han
# skriv han). Testen ser på bytane:
#   1. Eit program utan unnatak har ingen tag-seksjon, ingen elementseksjon og ingen
#      unnatak-atom (tree-shaking), og init kallar start() direkte.
#   2. prøv/fang med jokertype: tag-seksjonen (13) finst, uhandtert er med men ikkje
#      unntak_passar, kast-atomet er ikkje med (THROW blir `throw` direkte), og init
#      startar med try_table (catch $nc_unntak).
#   3. Typa fang tek med unntak_passar og unntak_type.
#   4. Innebygde feil: atomet «kast» er nøyaktig `local.get 0; throw 0` (unnatak, ikkje
#      trap), og div-atomet kallar det.
#   5. Closures: deklarativt elementsegment med éin funksjon per lambda-hjelpar, og
#      $lambda-typen {funcref, (ref null $arr)} i typeseksjonen.
#   6. Metodekall (builtin.ncb_call_fn) utan closures: ingen elementseksjon, men $lambda-
#      typen (dispatcharen testar på closures) og taggen (ukjend metode kastar).
#   7. Fail-closed: bryt ut av ei prøv-blokk og utsett i ei lykkje gjev kompileringsfeil
#      (tests/test_wasm_w0.no sjekkar rapporten frå feil_ustotta.no).
bruk tests.fixtures.wasm_test_hjelp som hjelp

funksjon inneheld(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon indeks(l: liste, x: tekst) -> heltall {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner i }
        i = i + 1
    }
    returner -1
}

funksjon har_id(ids: liste, id: heltall) -> bool {
    la i = 0
    mens i < lengde(ids) {
        hvis ids[i] == id { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon like_lister(x: liste, y: liste) -> bool {
    hvis lengde(x) != lengde(y) { returner usann }
    la i = 0
    mens i < lengde(x) {
        hvis x[i] != y[i] { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon byrjar_med(x: liste, y: liste) -> bool {
    hvis lengde(x) < lengde(y) { returner usann }
    la i = 0
    mens i < lengde(y) {
        hvis x[i] != y[i] { returner usann }
        i = i + 1
    }
    returner sann
}

# Finst bytesekvensen y i x?
funksjon har_sekvens(x: liste, y: liste) -> bool {
    la i = 0
    mens i + lengde(y) <= lengde(x) {
        la j = 0
        mens j < lengde(y) og x[i + j] == y[j] { j = j + 1 }
        hvis j == lengde(y) { returner sann }
        i = i + 1
    }
    returner usann
}

# Skriv kjelda, bygg ho (validert av CLI-en) og gjev {"atom", "importar", "bytar", "ids"}.
funksjon bygg(namn: tekst, src: tekst) -> ordbok {
    la sti = "build/wasm/test_w2/" + namn + ".no"
    fil_skriv(hjelp.root() + "/" + sti, src)
    la mappe = "build/wasm/test_w2/" + namn
    la linje = hjelp.bygg_klient(sti, mappe, usann)
    la b = hjelp.les_bytar(mappe + "/app.wasm")
    returner {"atom": hjelp.liste_felt(linje, "atom"), "importar": hjelp.liste_felt(linje, "importar"),
              "bytar": b, "ids": hjelp.seksjons_idar(b)}
}

funksjon start() -> heltall {
    hjelp.mkdir("build/wasm/test_w2")
    la lambda_type = [95, 2, 112, 0, 99, 4, 0]
    la init_try = [0, 2, 64, 2, 109, 31, 64, 1, 0, 0, 0]

    # ── 1. Utan unnatak ──
    la u = bygg("utan_unntak", "funksjon start() -> heltall {\n    la l = [1, 2]\n    skriv(tekst(lengde(l) + 1))\n    returner 0\n}\n")
    assert(ikkje har_id(u["ids"], 13))
    assert(ikkje har_id(u["ids"], 9))
    assert(ikkje inneheld(u["atom"], "uhandtert"))
    assert(ikkje inneheld(u["atom"], "kast"))
    assert(ikkje har_sekvens(hjelp.seksjon_innhald(u["bytar"], 1), lambda_type))
    la uk = hjelp.kroppar(u["bytar"])
    assert(ikkje byrjar_med(uk[lengde(uk) - 1], init_try))
    assert_eq(uk[lengde(uk) - 1][0], 0)
    assert_eq(uk[lengde(uk) - 1][1], 16)

    # ── 2. prøv/fang med jokertype ──
    la f = bygg("fang_utypa", "funksjon start() -> heltall {\n    prøv {\n        kast \"A: b\"\n    } fang (e) {\n        skriv(e)\n    }\n    returner 0\n}\n")
    assert(har_id(f["ids"], 13))
    assert_eq(hjelp.seksjon_innhald(f["bytar"], 13)[0], 1)
    assert(inneheld(f["atom"], "uhandtert"))
    assert(ikkje inneheld(f["atom"], "unntak_passar"))
    assert(ikkje inneheld(f["atom"], "kast"))
    la fk = hjelp.kroppar(f["bytar"])
    assert(byrjar_med(fk[lengde(fk) - 1], init_try))
    # start() har try_table rundt dispatch-lykkja og throw for THROW
    la startk = fk[lengde(fk) - 2]
    assert(har_sekvens(startk, [2, 109, 31, 64, 1, 0, 0, 0]))
    assert(har_sekvens(startk, [8, 0]))

    # ── 3. Typa fang ──
    la t = bygg("fang_typa", "funksjon start() -> heltall {\n    prøv {\n        kast \"A: b\"\n    } fang (e: A) {\n        skriv(e)\n    }\n    returner 0\n}\n")
    assert(inneheld(t["atom"], "unntak_passar"))
    assert(inneheld(t["atom"], "unntak_type"))

    # ── 4. Innebygde feil blir unnatak ──
    la d = bygg("innebygd", "funksjon start() -> heltall {\n    la x = 0\n    prøv {\n        skriv(tekst(5 / x))\n    } fang (e: DivisjonMedNull) {\n        skriv(e)\n    }\n    returner 0\n}\n")
    assert(inneheld(d["atom"], "div"))
    assert(inneheld(d["atom"], "kast"))
    la dk = hjelp.kroppar(d["bytar"])
    la ki = indeks(d["atom"], "kast")
    assert(ki >= 0)
    assert(like_lister(dk[ki], [0, 32, 0, 8, 0, 11]))
    # div-atomet kallar kast (funksjonsindeks = importar + posisjonen i atomlista)
    la di = indeks(d["atom"], "div")
    assert(har_sekvens(dk[di], [16, lengde(d["importar"]) + ki]))

    # ── 5. Closures ──
    la c = bygg("closure", "funksjon start() -> heltall {\n    la k = 2\n    la f = fun(x) -> x * k\n    la g = fun(x) -> x + 1\n    skriv(tekst(f(3) + g(4)))\n    returner 0\n}\n")
    assert(har_id(c["ids"], 9))
    la el = hjelp.seksjon_innhald(c["bytar"], 9)
    # éitt deklarativt segment (flagg 3, elemkind 0) med to funksjonar
    assert(like_lister([el[0], el[1], el[2], el[3]], [1, 3, 0, 2]))
    assert(har_sekvens(hjelp.seksjon_innhald(c["bytar"], 1), lambda_type))
    # CALL_VALUE blir ref.cast (ref $fnN) + call_ref $fnN (0xfb 0x16 t 0x14 t)
    la ck = hjelp.kroppar(c["bytar"])
    la har_call_ref = usann
    la ci = 0
    mens ci < lengde(ck) {
        la kb = ck[ci]
        la bi = 0
        mens bi + 4 < lengde(kb) {
            hvis kb[bi] == 251 og kb[bi + 1] == 22 og kb[bi + 3] == 20 og kb[bi + 4] == kb[bi + 2] { har_call_ref = sann }
            bi = bi + 1
        }
        ci = ci + 1
    }
    assert(har_call_ref)

    # ── 6. Metodekall utan closures ──
    la m = bygg("metode", "struktur P {\n    x: heltall\n}\n\nfunksjon P.dobbel(self) -> heltall {\n    returner self.x * 2\n}\n\nfunksjon start() -> heltall {\n    la p = P()\n    p.x = 4\n    skriv(tekst(p.dobbel()))\n    returner 0\n}\n")
    assert(ikkje har_id(m["ids"], 9))
    assert(har_id(m["ids"], 13))
    assert(har_sekvens(hjelp.seksjon_innhald(m["bytar"], 1), lambda_type))
    assert(inneheld(m["atom"], "tekst_lik"))

    skriv("test_wasm_w2 OK\n")
    returner 0
}
