// R2 / F23: macOS arm64 AOT — køyretidsfeil som fangbare unnatak med VM-tekst
// (tests/fixtures/arm64_kjoretidsfeil.no): DivisjonMedNull/ModuloMedNull (heiltal og
// desimaltal), IndeksFeil på liste (les og skriv, negativ indeks), «Ugyldig heiltall» og
// assert/assert_eq som kast, med typa fang. arm64_ufanga_kjoretidsfeil.no: utan prøv/kast i
// programmet blir feilen eit ufanga unnatak (stderr, exit 1) — før fekk p09d «ETTER x=0».
// Køyrer berre på macOS arm64 (linux-arm64 går gjennom tools/arm64_diff_lane.no).

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_macos_arm64() -> bool {
    la system = miljo_hent("NORSCODE_CI_SYSTEM")
    la maskin = miljo_hent("NORSCODE_CI_ARCH")
    hvis system == "" { system = miljo_hent("RUNNER_OS") }
    hvis maskin == "" { maskin = miljo_hent("RUNNER_ARCH") }
    hvis system == "" eller maskin == "" {
        prøv {
            la info = builtin.system_info()
            hvis system == "" { system = tekst(info["system"]) }
            hvis maskin == "" { maskin = tekst(info["machine"]) }
        } fang (e) {}
    }
    la macos = system == "macOS" eller system == "MacOS" eller system == "Darwin" eller system == "darwin"
    la arm64 = maskin == "ARM64" eller maskin == "arm64" eller maskin == "aarch64"
    returner macos og arm64
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon fasit() -> tekst {
    returner "A div=3 div=-3 fanga [DivisjonMedNull: divisjon med null ved __main__.del]\n" +
        "B fanga [ModuloMedNull: modulo med null ved __main__.mod]\n" +
        "C fanga [DivisjonMedNull: divisjon med null ved __main__.start]\n" +
        "D typa DivisjonMedNull\n" +
        "E typa ModuloMedNull\n" +
        "F l[0]=10 l[2]=30\n" +
        "G fanga [IndeksFeil: indeks 3 utanfor lista (lengde 3) ved __main__.start]\n" +
        "H fanga [IndeksFeil: indeks -1 utanfor lista (lengde 3) ved __main__.start]\n" +
        "I typa [IndeksFeil: indeks 5 utanfor lista (lengde 3) ved __main__.start]\n" +
        "J fanga [IndeksFeil: indeks -2 utanfor lista (lengde 3) ved __main__.start]\n" +
        "K l=10,21,30 n=3\n" +
        "L bytes 7,9 ute=ingenting\n" +
        "M [123][-45][0][0][9223372036854775807]\n" +
        "N kast: Ugyldig heiltall: abc\n" +
        "N kast: Ugyldig heiltall: 12x\n" +
        "N kast: Ugyldig heiltall: \n" +
        "N kast: Ugyldig heiltall:  12\n" +
        "O fanga [assert feilet]\n" +
        "P fanga [assert_eq feilet: 1 != 2]\n" +
        "Q fanga [assert_eq feilet: a != b]\n" +
        "R ferdig\n"
}

funksjon bygg(root: tekst, nc: tekst, kjelde: tekst, binær: tekst) -> heiltall {
    la miljø = {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_GC_ALLOC": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    krev_exit(prosess.køyr_med_grenser(nc, ["bygg-native", "--target", "macos-arm64", kjelde, binær], root, miljø, 900000, 0, 1024), 0)
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_macos_arm64() { returner 0 }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la id = builtin.random_hex(8)
    la nc = runtime(root)
    la b1 = "/tmp/norscode_macho_kjoretidsfeil_" + id
    bygg(root, nc, root + "/tests/fixtures/arm64_kjoretidsfeil.no", b1)
    la r1 = prosess.køyr(b1, [], root, {}, 60000)
    krev_exit(r1, 0)
    hvis tekst(r1["stdout"]) != fasit() {
        prosess.skriv_resultat(r1)
        assert_eq(tekst(r1["stdout"]), fasit())
    }
    filops.slett_fil(b1)
    la b2 = "/tmp/norscode_macho_ufanga_" + id
    bygg(root, nc, root + "/tests/fixtures/arm64_ufanga_kjoretidsfeil.no", b2)
    la r2 = prosess.køyr(b2, [], root, {}, 60000)
    krev_exit(r2, 1)
    assert_eq(tekst(r2["stdout"]), "før\n")
    hvis ikkje builtin.contains(tekst(r2["stderr"]), "DivisjonMedNull: divisjon med null ved __main__.del") {
        prosess.skriv_resultat(r2)
        assert(usann)
    }
    filops.slett_fil(b2)
    skriv("test_macho_arm64_aot_kjoretidsfeil OK\n")
    returner 0
}
