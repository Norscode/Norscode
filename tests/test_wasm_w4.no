# W4 (WASM-sporet): vertsfunksjonar, atom og rt-cache.
#
#   1. Fail-closed: vertskall som ikkje er trygge eller ikkje finst, gjev kompileringsfeil
#      med samla rapport (on…/href/style/data-nc- i sett_attr, attributtnamn som ikkje er
#      konstant, lag("script"), ukjend hending, deleger til ein funksjon som ikkje finst,
#      tilbakekall med parametrar, tekst som millisekund, testkrok utan testbygg), og CLI-en
#      skriv ingen app.wasm.
#   2. Ein klient med dei nye vegane (tests/fixtures/wasm_w4_vert.no) får atoma
#      til_minne_ved (to tekstverdiar), frå_minne (tekst frå DOM-en), tid_ms og fjern_nokkel,
#      importane lagre_lokalt, hent_verdi, deleger og den interne nå_ms, og tilbakekallet
#      blir eksportert som _fjern. Teljaren (W0) har ingen av dei nye atoma.
#   3. rt-cachen: bygg utan cache, kald og varm cache gjev byte-identisk modul; den varme
#      brukar alle rt-funksjonane frå cachen; ein oppføring med annan NCB-kode blir lowra på
#      nytt; ein øydelagd kropp med rett kode blir brukt (og modulen avvist av validatoren),
#      som viser at cachen faktisk blir lesen. Filnamnet er sha256 over backend-kjeldene og
#      endrar seg når éi av dei endrar seg.
#   4. Stubbane i VM-en kastar med ei melding som peikar på nettlesaren.
bruk std.wasm_vert som vert
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tools.nc_wasm som cli

funksjon rot() -> tekst { returner "build/wasm/test_w4" }

funksjon inneheld(t: tekst, nål: tekst) -> bool { returner builtin.index_of(t, nål) >= 0 }

funksjon i_liste(l: liste, x: tekst) -> bool {
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]) == x { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon krev_i(l: liste, x: tekst, kva: tekst) -> heltall {
    hvis ikkje i_liste(l, x) {
        skriv(kva + ": venta " + x + " i " + builtin.join(l, ",") + "\n")
        assert(usann)
    }
    returner 0
}

# Køyr tools/nc_wasm.no med eksplisitt miljø. Gjev {"exit", "stdout"}.
funksjon cli_køyr(kjelde: tekst, ut: tekst, cache: tekst, cache_mappe: tekst) -> ordbok {
    hjelp.mkdir(ut)
    la m = hjelp.grunnmiljø(hjelp.root())
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = hjelp.root() + "/tools/nc_wasm.no"
    m["NORSCODE_VM_FAST"] = "1"
    m["NC_WASM_KJELDE"] = kjelde
    m["NC_WASM_NCB"] = ""
    m["NC_WASM_UT"] = ut
    m["NC_WASM_APP"] = ""
    m["NC_WASM_TESTBYGG"] = ""
    m["NC_WASM_PREFIKS"] = ""
    m["NC_WASM_RT_CACHE"] = cache
    m["NC_WASM_RT_CACHE_MAPPE"] = cache_mappe
    la r = hjelp.køyr_nc(m, 300000)
    returner {"exit": r["exit"], "stdout": r["stdout"] + r["stderr"]}
}

funksjon wasm_linje(o: tekst) -> tekst {
    la p = builtin.index_of(o, "WASM: ")
    hvis p < 0 {
        skriv("fann ikkje WASM-linja:\n" + o + "\n")
        assert(usann)
    }
    la l = builtin.slice(o, p, lengde(o))
    la nl = builtin.index_of(l, "\n")
    la bs = builtin.index_of(l, "\\")
    hvis bs >= 0 og (nl < 0 eller bs < nl) { nl = bs }
    hvis nl >= 0 { l = builtin.slice(l, 0, nl) }
    returner l
}

funksjon slett(sti: tekst) -> heltall {
    hvis builtin.fil_finnes(hjelp.root() + "/" + sti) { builtin.fil_slett(hjelp.root() + "/" + sti) }
    returner 0
}

funksjon start() -> heltall {
    hjelp.mkdir(rot())

    # ── 1. Fail-closed ──
    la ust = rot() + "/ustotta"
    slett(ust + "/app.wasm")
    la r = cli_køyr("tests/fixtures/wasm_w4_ustotta.no", ust, "0", "")
    la o = r["stdout"]
    assert(r["exit"] != 0)
    la venta = [
        "WASM-kompilering feila (11 feil)",
        "sett_attr: attributtet «onclick» er ikkje på lista over trygge attributt",
        "sett_attr: attributtet «href» er ikkje på lista",
        "sett_attr: attributtet «data-nc-klikk» er ikkje på lista",
        "sett_attr: attributtet «style» er ikkje på lista",
        "argument 2 til sett_attr må vere ein tekstkonstant i kjelda",
        "lag: taggen «script» er ikkje på lista over trygge taggar",
        "lytt: ukjend hending «hover» (støtta: klikk, input, endring, send, tast)",
        "deleger: finn ikkje funksjonen finst_ikkje i modulen __main__",
        "lytt: funksjonen med_param kan ikkje ha parametrar",
        "argument 1 til etter må vere eit heltal, ikkje tekst",
        "vertsfunksjonen test_skriv finst berre i testbygg (NC_WASM_TESTBYGG=1)"
    ]
    la vi = 0
    mens vi < lengde(venta) {
        hvis ikkje inneheld(o, venta[vi]) {
            skriv("fail-closed: fann ikkje «" + venta[vi] + "» i rapporten:\n" + o + "\n")
            assert(usann)
        }
        vi = vi + 1
    }
    assert(ikkje builtin.fil_finnes(hjelp.root() + "/" + ust + "/app.wasm"))

    # ── 2. Dei nye vegane i ein ekte modul ──
    la lv = hjelp.bygg_klient("tests/fixtures/wasm_w4_vert.no", rot() + "/vert", usann)
    la atom = hjelp.liste_felt(lv, "atom")
    la imp = hjelp.liste_felt(lv, "importar")
    la eks = hjelp.liste_felt(lv, "eksportar")
    krev_i(atom, "til_minne_ved", "atom")
    krev_i(atom, "frå_minne", "atom")
    krev_i(atom, "tid_ms", "atom")
    krev_i(atom, "fjern_nokkel", "atom")
    krev_i(imp, "lagre_lokalt", "importar")
    krev_i(imp, "hent_verdi", "importar")
    krev_i(imp, "deleger", "importar")
    krev_i(imp, "hending_data", "importar")
    krev_i(imp, "nå_ms", "importar")
    krev_i(eks, "_fjern", "eksportar")
    krev_i(eks, "m", "eksportar")
    la lt = hjelp.bygg_klient("examples/wasm_teljar/klient.no", rot() + "/teljar", usann)
    la at = hjelp.liste_felt(lt, "atom")
    assert(ikkje i_liste(at, "til_minne_ved") og ikkje i_liste(at, "frå_minne") og ikkje i_liste(at, "tid_ms"))
    krev_i(hjelp.liste_felt(lt, "eksportar"), "_klikk", "teljar")

    # ── 3. rt-cachen ──
    la cm = rot() + "/rt_cache"
    la kjelde = "tests/fixtures/wasm_w3_sha.no"
    la cache_fil = cli.rt_cache_sti(hjelp.root(), cm)
    slett(builtin.slice(cache_fil, lengde(hjelp.root()) + 1, lengde(cache_fil)))
    la a = cli_køyr(kjelde, rot() + "/rt_av", "0", cm)
    assert_eq(a["exit"], 0)
    la la_ = wasm_linje(a["stdout"])
    # rt_cache=<treff>/<talet på std.*-funksjonar i modulen> (sha256_hex og std.sha256)
    la rc = hjelp.felt(la_, "rt_cache")
    assert(builtin.starts_with(rc, "0/"))
    la n_rt = heltall_fra_tekst(builtin.slice(rc, 2, lengde(rc)))
    assert(n_rt >= 3)
    assert(ikkje builtin.fil_finnes(cache_fil))
    la bytar_a = fil_les(hjelp.root() + "/" + rot() + "/rt_av/app.wasm")
    la k = cli_køyr(kjelde, rot() + "/rt_kald", "", cm)
    assert_eq(k["exit"], 0)
    assert_eq(hjelp.felt(wasm_linje(k["stdout"]), "rt_cache"), "0/" + tekst(n_rt))
    assert(builtin.fil_finnes(cache_fil))
    assert_eq(fil_les(hjelp.root() + "/" + rot() + "/rt_kald/app.wasm"), bytar_a)
    la v = cli_køyr(kjelde, rot() + "/rt_varm", "", cm)
    assert_eq(v["exit"], 0)
    assert_eq(hjelp.felt(wasm_linje(v["stdout"]), "rt_cache"), tekst(n_rt) + "/" + tekst(n_rt))
    assert_eq(fil_les(hjelp.root() + "/" + rot() + "/rt_varm/app.wasm"), bytar_a)
    skriv("rt-cache: " + tekst(n_rt) + " rt-funksjonar, kald 0/" + tekst(n_rt) + ", varm " + tekst(n_rt) + "/" + tekst(n_rt) + ", byte-identisk\n")
    # Ei oppføring med annan kode blir lowra på nytt (og cachen retta)
    la c = builtin.json_parse_raw(fil_les(cache_fil))
    la q = tekst(nøkler(c)[0])
    c[q]["kode"] = "endra"
    fil_skriv(cache_fil, builtin.json_stringify(c))
    la e = cli_køyr(kjelde, rot() + "/rt_endra", "", cm)
    assert_eq(e["exit"], 0)
    assert_eq(hjelp.felt(wasm_linje(e["stdout"]), "rt_cache"), tekst(n_rt - 1) + "/" + tekst(n_rt))
    assert_eq(fil_les(hjelp.root() + "/" + rot() + "/rt_endra/app.wasm"), bytar_a)
    # Ein øydelagd kropp med rett kode blir brukt: validatoren avviser modulen
    la c2 = builtin.json_parse_raw(fil_les(cache_fil))
    la q2 = tekst(nøkler(c2)[0])
    c2[q2]["kropp"] = [[0, 11]]
    fil_skriv(cache_fil, builtin.json_stringify(c2))
    la od = cli_køyr(kjelde, rot() + "/rt_oydelagd", "", cm)
    assert(od["exit"] != 0)
    assert(inneheld(od["stdout"], "validatoren avviste modulen"))
    slett(builtin.slice(cache_fil, lengde(hjelp.root()) + 1, lengde(cache_fil)))
    # Filnamnet følgjer kjeldene til backenden
    la kopi = rot() + "/rot_kopi"
    hjelp.mkdir(kopi + "/std")
    la kj = cli.backend_kjelder()
    la ki = 0
    mens ki < lengde(kj) {
        fil_skriv(hjelp.root() + "/" + kopi + "/" + kj[ki], fil_les(hjelp.root() + "/" + kj[ki]))
        ki = ki + 1
    }
    la namn_a = cli.rt_cache_sti(hjelp.root() + "/" + kopi, cm)
    assert_eq(builtin.slice(namn_a, lengde(namn_a) - 22, lengde(namn_a)), builtin.slice(cache_fil, lengde(cache_fil) - 22, lengde(cache_fil)))
    fil_skriv(hjelp.root() + "/" + kopi + "/std/wasm_atom.no", fil_les(hjelp.root() + "/std/wasm_atom.no") + "\n# endra\n")
    la namn_b = cli.rt_cache_sti(hjelp.root() + "/" + kopi, cm)
    assert(builtin.slice(namn_b, lengde(namn_b) - 22, lengde(namn_b)) != builtin.slice(namn_a, lengde(namn_a) - 22, lengde(namn_a)))

    # ── 4. Stubbane i VM-en ──
    la melding = ""
    prøv {
        vert.hent_verdi(0)
    } fang (feil) {
        melding = tekst(feil)
    }
    assert(inneheld(melding, "wasm_vert.hent_verdi finst berre i nettlesaren"))

    skriv("test_wasm_w4 OK\n")
    returner 0
}
