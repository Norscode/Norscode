bruk tools.embed_release_ncb som embed

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/test-embed-idempotent-base.bin"
    la gen1 = root + "/build/test-embed-idempotent-gen1.bin"
    la gen2 = root + "/build/test-embed-idempotent-gen2.bin"
    la changed = root + "/build/test-embed-idempotent-changed.bin"
    la expected_changed = root + "/build/test-embed-idempotent-expected-changed.bin"
    builtin.mkdir_p("build")
    builtin.fil_skriv_binær(base, builtin.bytes_from_list([0, 1, 2, 255, 128, 65]))
    la namn = ["compiler"]
    la payload = ["{\"format\":\"ncb-v1\",\"entry\":\"x.start\",\"functions\":{}}"]
    assert(embed.stream_embed(base, gen1, namn, payload) == 0)
    assert(embed.stream_embed(gen1, gen2, namn, payload) == 0)
    la a = builtin.fil_les_binær(gen1)
    la b = builtin.fil_les_binær(gen2)
    assert(builtin.sha256_bytes(a) == builtin.sha256_bytes(b))
    assert(embed.eksisterande_text_image_start(gen1, builtin.fil_les_binær(gen1)) == 6)
    la payload2 = ["{\"format\":\"ncb-v1\",\"entry\":\"x.start\",\"functions\":{\"x.start\":{\"code\":[]}}}"]
    assert(embed.stream_embed(gen1, changed, namn, payload2) == 0)
    assert(embed.stream_embed(base, expected_changed, namn, payload2) == 0)
    assert(builtin.sha256_bytes(builtin.fil_les_binær(changed)) ==
           builtin.sha256_bytes(builtin.fil_les_binær(expected_changed)))
    assert(embed.eksisterande_text_image_start(changed, builtin.fil_les_binær(changed)) == 6)
    skriv("test_embed_release_ncb_idempotent OK\n")
    returner 0
}
