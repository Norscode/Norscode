bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/stat.no")
    assert(t.inneholder(src, "norscode-native-filesystem-v1"))
    assert(t.inneholder(src, "native_fs.native_stat_sti(sti)"))
    assert(t.inneholder(src, "native_fs.native_sett_modus_sti(sti, mode)"))
    assert(t.inneholder(src, "funksjon _octal_til_int(s: tekst) -> heltall"))
    assert(t.inneholder(src, "returner builtin.fil_finnes(sti)"))
    assert(t.inneholder(src, "Eigarskifte krev privilegium"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "stat -c"))
    assert(ikkje t.inneholder(src, "stat -f"))

    skriv("test_stat_native_abi OK")
    returner 0
}
