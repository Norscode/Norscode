bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/normalize_pe_reproducible.no")
    assert(t.inneholder(src, "sett_u32(bytes, pe + 8, 0)"))
    assert(t.inneholder(src, "sett_u32(bytes, entry + 4, 0)"))
    assert(t.inneholder(src, "NORSCODE-PE-V1!!"))
    assert(t.inneholder(src, "norscode.pdb"))
    assert(t.inneholder(src, "rva_til_fil"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_normalize_pe_reproducible OK\n")
    returner 0
}
