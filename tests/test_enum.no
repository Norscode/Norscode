# M9 — enum: variantane blir heiltalskonstantar (0, 1, 2, ...) og Farge.RAUD
# løysast til konstanten på kompileringstid. Køyrer gjennom KJELDE-kompilator+VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # Variantverdiar 0, 1, 2
    la p1 = "enum Farge { RAUD, GRON, BLA }\n" +
        "funksjon start() -> heltall { returner Farge.RAUD * 100 + Farge.GRON * 10 + Farge.BLA }\n"
    assert_eq(utfor(p1), "12")

    # Bruk i variabel og samanlikning
    la p2 = "enum Dag { MAN, TYS, ONS }\n" +
        "funksjon start() -> heltall {\n" +
        "    la d = Dag.TYS\n" +
        "    hvis d == Dag.TYS { returner 100 }\n" +
        "    returner 0\n" +
        "}\n"
    assert_eq(utfor(p2), "100")

    # Match på enum-verdi
    la p3 = "enum Retning { NORD, SOR, AUST, VEST }\n" +
        "funksjon start() -> heltall {\n" +
        "    la r = Retning.AUST\n" +
        "    match r {\n" +
        "        case Retning.NORD { returner 1 }\n" +
        "        case Retning.AUST { returner 3 }\n" +
        "        case _ { returner 0 }\n" +
        "    }\n" +
        "}\n"
    assert_eq(utfor(p3), "3")

    skriv("test_enum OK\n")
    returner 0
}
