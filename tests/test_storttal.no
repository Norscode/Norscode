# Test for std.storttal (signert BigInteger oppå std.bigint).
# Fasitane for store tal er rekna med bc (sjå kommentarane). Eksplisitte
# samanlikningar (ikkje assert), så testen òg feilar i native AOT.
bruk std.storttal som st

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

funksjon _t(x) -> tekst {
    returner st.til_tekst(x)
}

funksjon _kastar_tekst(t: tekst) -> tekst {
    prøv {
        la x = st.fra_tekst(t)
        returner "ok:" + st.til_tekst(x)
    } fang (e) {
        returner tekst(e)
    }
}

funksjon _fakultet(n: heiltall) -> ordbok {
    la r = st.ein()
    la i = 2
    mens i <= n {
        r = st.gonger(r, i)
        i = i + 1
    }
    returner r
}

funksjon _tekst(res: ordbok) {
    _sjekk(res, "0", _t(st.fra_tekst("0")), "0")
    _sjekk(res, "-0", _t(st.fra_tekst("-0")) + "|" + tekst(st.forteikn(st.fra_tekst("-0"))), "0|0")
    _sjekk(res, "leiande nullar", _t(st.fra_tekst("-000123")), "-123")
    _sjekk(res, "pluss-teikn", _t(st.fra_tekst("+5")), "5")
    _sjekk(res, "9 siffer grense", _t(st.fra_tekst("1000000000")), "1000000000")
    _sjekk(res, "rundtur stort", _t(st.fra_tekst("-123456789012345678901234567890123456789")), "-123456789012345678901234567890123456789")
    _sjekk(res, "ugyldig bokstav", _kastar_tekst("12a"), "TalformatFeil: ugyldig heiltal: \"12a\"")
    _sjekk(res, "ugyldig tom", _kastar_tekst(""), "TalformatFeil: ugyldig heiltal: \"\"")
    _sjekk(res, "ugyldig berre minus", _kastar_tekst("-"), "TalformatFeil: ugyldig heiltal: \"-\"")
    _sjekk(res, "ugyldig mellomrom", _kastar_tekst("1 2"), "TalformatFeil: ugyldig heiltal: \"1 2\"")
    _sjekk(res, "ugyldig dobbel minus", _kastar_tekst("--1"), "TalformatFeil: ugyldig heiltal: \"--1\"")

    _sjekk(res, "fra_heiltall 0/neg", _t(st.fra_heiltall(0)) + "," + _t(st.fra_heiltall(-65536)) + "," + _t(st.fra_heiltall(65535)), "0,-65536,65535")
    la min_l = -9223372036854775807 - 1
    _sjekk(res, "fra_heiltall min long", _t(st.fra_heiltall(min_l)), "-9223372036854775808")
    _sjekk(res, "fra_heiltall maks long", _t(st.fra_heiltall(9223372036854775807)), "9223372036854775807")
    _sjekk(res, "til_heiltall maks", tekst(st.til_heiltall("9223372036854775807")), "9223372036854775807")
    _sjekk(res, "til_heiltall min", tekst(st.til_heiltall("-9223372036854775808") == min_l), "sann")
    _sjekk(res, "til_heiltall -42", tekst(st.til_heiltall(st.fra_tekst("-42"))), "-42")
    la overflyt = "nei"
    prøv { st.til_heiltall("9223372036854775808") } fang (e) { overflyt = tekst(e) }
    _sjekk(res, "til_heiltall overflyt", overflyt, "OverflytFeil: 9223372036854775808 får ikkje plass i 64-bit heiltall")

    # Radix.
    _sjekk(res, "hex", st.til_tekst_radix(255, 16) + "," + st.til_tekst_radix(-255, 16), "ff,-ff")
    _sjekk(res, "fra hex", _t(st.fra_tekst_radix("-FF", 16)) + "," + _t(st.fra_tekst_radix("7fffffffffffffff", 16)), "-255,9223372036854775807")
    _sjekk(res, "2^64 hex", st.til_tekst_radix(st.pow(2, 64), 16), "10000000000000000")
    _sjekk(res, "binær", st.til_tekst_radix(10, 2) + "," + _t(st.fra_tekst_radix("101010", 2)), "1010,42")
    _sjekk(res, "radix 36", st.til_tekst_radix(35, 36) + "," + _t(st.fra_tekst_radix("zz", 36)), "z,1295")
    _sjekk(res, "hex-siffer i desimal er feil", _kastar_tekst("1f"), "TalformatFeil: ugyldig heiltal: \"1f\"")
}

funksjon _aritmetikk(res: ordbok) {
    la a = st.fra_tekst("12345678901234567890")
    la b = st.fra_tekst("-98765432109876543210")
    # bc: 12345678901234567890 * -98765432109876543210
    la p = st.gonger(a, b)
    _sjekk(res, "gonger stort", _t(p), "-1219326311370217952237463801111263526900")
    _sjekk(res, "deling eksakt", _t(st.deling(p, a)), "-98765432109876543210")
    _sjekk(res, "deling neg/neg", _t(st.deling(p, b)), "12345678901234567890")
    _sjekk(res, "pluss blanda", _t(st.pluss(a, b)), "-86419753208641975320")
    _sjekk(res, "minus", _t(st.minus(a, b)), "111111111011111111100")
    _sjekk(res, "minus til null", _t(st.minus(a, a)) + "|" + tekst(st.er_null(st.minus(a, a))), "0|sann")
    _sjekk(res, "pluss med 0", _t(st.pluss(0, b)) + "," + _t(st.pluss(a, 0)), "-98765432109876543210,12345678901234567890")
    _sjekk(res, "gonger med 0", _t(st.gonger(a, 0)) + "|" + tekst(st.forteikn(st.gonger(b, 0))), "0|0")
    _sjekk(res, "10^40-1+1", _t(st.pluss(st.minus(st.pow(10, 40), 1), 1)), "10000000000000000000000000000000000000000")
    _sjekk(res, "mellombels borrow", _t(st.minus("100000000000000000000", 1)), "99999999999999999999")

    # Java-semantikk for deling: avkorta mot null, rest har forteiknet til a, mod >= 0.
    _sjekk(res, "-7/2", _t(st.deling(-7, 2)) + " rest " + _t(st.rest(-7, 2)) + " mod " + _t(st.mod(-7, 2)), "-3 rest -1 mod 1")
    _sjekk(res, "7/-2", _t(st.deling(7, -2)) + " rest " + _t(st.rest(7, -2)), "-3 rest 1")
    _sjekk(res, "-7/-2", _t(st.deling(-7, -2)) + " rest " + _t(st.rest(-7, -2)), "3 rest -1")
    _sjekk(res, "0/5", _t(st.deling(0, 5)) + " rest " + _t(st.rest(0, 5)), "0 rest 0")
    _sjekk(res, "3/5", _t(st.deling(3, 5)) + " rest " + _t(st.rest(3, 5)), "0 rest 3")
    la null_div = "nei"
    prøv { st.deling(a, 0) } fang (e) { null_div = tekst(e) }
    _sjekk(res, "deling med null", null_div, "DivisjonMedNull: divisjon med null (storttal)")
    la neg_mod = "nei"
    prøv { st.mod(5, -3) } fang (e) { neg_mod = tekst(e) }
    _sjekk(res, "mod negativ modulus", neg_mod, "ArgumentFeil: modulus må vere positiv, fekk -3")

    # Stor deling mot bc: (2^521-1) / 3^100 og rest, begge forteikn.
    la mersenne = st.minus(st.pow(2, 521), 1)
    _sjekk(res, "2^521-1", _t(mersenne), "6864797660130609714981900799081393217269435300143305409394463459185543183397656052122559640661454554977296311391480858037121987999716643812574028291115057151")
    la tre100 = st.pow(3, 100)
    _sjekk(res, "3^100", _t(tre100), "515377520732011331036461129765621272702107522001")
    la dm = st.divmod(mersenne, tre100)
    _sjekk(res, "stor kvotient", _t(dm["kvotient"]), "13319940012867194317744337585842475020037946875128312582653325277263722344598381049287364650226054955336948384")
    _sjekk(res, "stor rest", _t(dm["rest"]), "324926025993936046527473948278478020403633660767")
    la ndm = st.divmod(st.neg(mersenne), tre100)
    _sjekk(res, "stor negativ divmod", _t(ndm["kvotient"]) + "|" + _t(ndm["rest"]), "-13319940012867194317744337585842475020037946875128312582653325277263722344598381049287364650226054955336948384|-324926025993936046527473948278478020403633660767")
    la tilbake = st.pluss(st.gonger(ndm["kvotient"], tre100), ndm["rest"])
    _sjekk(res, "q*b+r == a", tekst(st.er_lik(tilbake, st.neg(mersenne))), "sann")

    # Potens, fakultet, gcd, modpow.
    _sjekk(res, "2^100", _t(st.pow(2, 100)), "1267650600228229401496703205376")
    _sjekk(res, "(-2)^63", _t(st.pow(-2, 63)), "-9223372036854775808")
    _sjekk(res, "(-3)^4 og x^0", _t(st.pow(-3, 4)) + "," + _t(st.pow(-3, 5)) + "," + _t(st.pow(0, 0)) + "," + _t(st.pow(-7, 0)), "81,-243,1,1")
    _sjekk(res, "30!", _t(_fakultet(30)), "265252859812191058636308480000000")
    _sjekk(res, "52!", _t(_fakultet(52)), "80658175170943878571660636856403766975289505440883277824000000000000")
    _sjekk(res, "gcd små", _t(st.gcd(462, 1071)) + "," + _t(st.gcd(-462, 1071)) + "," + _t(st.gcd(0, -5)) + "," + _t(st.gcd(0, 0)), "21,21,5,0")
    _sjekk(res, "gcd(2^100, 6^50)", _t(st.gcd(st.pow(2, 100), st.pow(6, 50))), "1125899906842624")
    _sjekk(res, "gcd(52!, 3^100) = 3^23", _t(st.gcd(_fakultet(52), tre100)), "94143178827")
    _sjekk(res, "gcd med primtal", _t(st.gcd(_fakultet(52), mersenne)), "1")
    _sjekk(res, "modpow", _t(st.modpow(4, 13, 497)) + "," + _t(st.modpow(-2, 3, 5)) + "," + _t(st.modpow(7, 0, 13)) + "," + _t(st.modpow(7, 5, 1)), "445,2,1,0")
    la neg_e = "nei"
    prøv { st.pow(2, -1) } fang (e) { neg_e = tekst(e) }
    _sjekk(res, "negativ eksponent", neg_e, "ArgumentFeil: negativ eksponent -1")
}

funksjon _samanlikn(res: ordbok) {
    _sjekk(res, "samanlikn", tekst(st.samanlikn(-5, 3)) + tekst(st.samanlikn(-5, -7)) + tekst(st.samanlikn(0, 0)) + tekst(st.samanlikn("100000000000000000000", "99999999999999999999")), "-1101")
    _sjekk(res, "samanlikn neg stor", tekst(st.samanlikn("-100000000000000000000", "-99999999999999999999")), "-1")
    _sjekk(res, "er_lik", tekst(st.er_lik("-0", 0)) + tekst(st.er_lik(st.fra_tekst("42"), 42)) + tekst(st.er_lik(1, -1)), "sannsannusann")
    _sjekk(res, "min/maks", _t(st.min(-3, 2)) + "," + _t(st.maks(-3, 2)), "-3,2")
    _sjekk(res, "abs/neg/forteikn", _t(st.abs(-9)) + "," + _t(st.neg(-9)) + "," + _t(st.neg(0)) + "," + tekst(st.forteikn(-9)) + tekst(st.forteikn(9)), "9,9,0,-11")
    _sjekk(res, "er_storttal", tekst(st.er_storttal(st.ein())) + tekst(st.er_storttal(1)), "sannusann")
    la typefeil = "nei"
    prøv { st.fra([1]) } fang (e) { typefeil = tekst(e) }
    _sjekk(res, "fra liste kastar", typefeil, "TypeFeil: kan ikkje gjere liste om til storttal")
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}
    _tekst(res)
    _aritmetikk(res)
    _samanlikn(res)
    hvis res["feil"] != 0 {
        skriv("test_storttal FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_storttal OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
