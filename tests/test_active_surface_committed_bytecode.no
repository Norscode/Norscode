bruk tools.no_c_python_active_surface som flate
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.tekst som t

// JSON-avvikling J6 (rapportmodus): committed_bytecode-sjekken i active-surface
// må kunne seie både ja og nei — namnemønster, innhaldsmønster og eksklusjonar.
funksjon start() -> heiltall {
    // Namnemønster.
    assert(flate.bytekode_namn("/r/bootstrap/precompiled/vm.ncb.json"))
    assert(flate.bytekode_namn("/r/bootstrap/precompiled/vm.ncb.json.bak_v798"))
    assert(flate.bytekode_namn("/r/bootstrap/precompiled_fragments_inner/parser.functions.json"))
    assert(flate.bytekode_namn("/r/build/bootstrap_compiler_bundle.ncb"))
    assert(flate.bytekode_namn("/r/x/modul.ncbin"))
    assert(ikkje flate.bytekode_namn("/r/vscode-norscode/package.json"))
    assert(ikkje flate.bytekode_namn("/r/tests/ir_snapshot_cases.json"))
    assert(ikkje flate.bytekode_namn("/r/selfhost/ncb_serde.no"))
    // Filer utan ending (t.d. ein feilskriven «-o»-output) blir innhaldssjekka.
    assert(flate.utan_ending("/r/-o"))
    assert(flate.utan_ending("/r/tests/test_json"))
    assert(ikkje flate.utan_ending("/r/tests/ir_snapshot_cases.json"))
    assert(ikkje flate.utan_ending("/r/.gitignore"))
    assert(flate.bytekode_kandidat_for_innhald("/r/-o"))
    assert(ikkje flate.bytekode_kandidat_for_innhald("/r/README.md"))

    // Innhaldsmønster (fyrste 64 byte).
    assert(flate.bytekode_innhald("{\"format\":\"ncb-v1\",\"entry\":\"a.start\"}"))
    assert(flate.bytekode_innhald("{\"format\":\"norscode-bytecode-v1\",\"entry\":\"__main__.start\"}"))
    assert(flate.bytekode_innhald("{\n  \"format\": \"norscode-bytecode-v1\",\n"))
    assert(flate.bytekode_innhald(builtin.chr(147) + "NCB" + builtin.chr(1)))
    assert(ikkje flate.bytekode_innhald("{\"name\":\"norscode\",\"version\":\"1.0.0\"}"))
    assert(ikkje flate.bytekode_innhald("{\"format\":\"sigstore\"}"))
    assert(ikkje flate.bytekode_innhald(""))

    // Heile vandringa på eit lite tre: to treff, éin ekskludert, éin legitim JSON.
    la temp = runtime_fs.native_tempområde("build", "bytekode-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    assert(filops.lag_katalogar(base + "/a"))
    assert(filops.lag_katalogar(base + "/b"))
    assert(filops.lag_katalogar(base + "/docs"))
    fil_skriv(base + "/a/modul.ncb.json", "{}")
    fil_skriv(base + "/b/skjult.json", "{\"format\":\"ncb-v1\",\"entry\":\"x.start\",\"functions\":{}}")
    fil_skriv(base + "/b/pakke.json", "{\"name\":\"demo\"}")
    assert(filops.lag_katalogar(base + "/c"))
    fil_skriv(base + "/c/kompilert_utan_ending", "{\"format\":\"norscode-bytecode-v1\",\"entry\":\"__main__.start\"}")
    fil_skriv(base + "/c/LISENS", "Apache License\n")
    fil_skriv(base + "/docs/doc.ncb.json", "{}")
    assert(filops.lag_katalogar(base + "/build/v9400"))
    assert(filops.lag_katalogar(base + "/build/anna"))
    fil_skriv(base + "/build/v9400/bunt.ncb.json", "{}")
    fil_skriv(base + "/build/anna/generert.ncb.json", "{}")
    la treff = flate.collect_committed_bytecode(base)
    // build/ er generert og blir ikkje talt, bortsett frå den spora build/v9400.
    assert_eq(lengde(treff), 4)
    la samla = treff[0] + "|" + treff[1] + "|" + treff[2] + "|" + treff[3]
    assert(t.inneholder(samla, "/a/modul.ncb.json"))
    assert(t.inneholder(samla, "/b/skjult.json"))
    assert(t.inneholder(samla, "/c/kompilert_utan_ending"))
    assert(t.inneholder(samla, "/build/v9400/bunt.ncb.json"))
    assert(ikkje t.inneholder(samla, "generert.ncb.json"))
    assert(ikkje t.inneholder(samla, "pakke.json"))
    assert(ikkje t.inneholder(samla, "LISENS"))
    assert(ikkje t.inneholder(samla, "doc.ncb.json"))
    la per_katalog = flate.bytekode_per_katalog(base, treff)
    assert_eq(lengde(per_katalog), 4)
    assert_eq(per_katalog[0], "  a: 1")
    assert_eq(per_katalog[1], "  b: 1")
    assert_eq(per_katalog[2], "  build/v9400: 1")
    assert_eq(per_katalog[3], "  c: 1")
    assert(filops.slett_tre(base))

    // Porten står i active-surface og er framleis rapportmodus som standard.
    la src = fil_les("tools/no_c_python_active_surface.no")
    assert(t.inneholder(src, "la bytekode = berre_spora(root, collect_committed_bytecode(root), flate)"))
    assert(t.inneholder(src, "la bk = berre_spora(root, collect_committed_bytecode(root), flate)"))
    assert(t.inneholder(src, "MERK: committed_bytecode: "))
    assert(t.inneholder(src, "env(\"NORSCODE_BYTECODE_GATE\") == \"hard\""))
    // J1c: med git-indeks-flate tel berre spora filer (ein generert, gitignorert payload på
    // same sti er ikkje committa); ein spora payload blir framleis fanga. Utan indeks: alt.
    la funne = ["/r/bootstrap/precompiled/vm.ncb.json", "/r/selfhost/vm_executor.ncb.json",
                "/r/build/v9400/hybrid_compiler_bundle_v9400.ncb.json"]
    la indeksflate = ["m\tgit-indeks", "f\tbuild/v9400/hybrid_compiler_bundle_v9400.ncb.json", "f\tselfhost/vm.no"]
    la spora = flate.berre_spora("/r", funne, indeksflate)
    assert_eq(lengde(spora), 1)
    assert_eq(spora[0], "/r/build/v9400/hybrid_compiler_bundle_v9400.ncb.json")
    la committa_vm = ["m\tgit-indeks", "f\tbootstrap/precompiled/vm.ncb.json"]
    assert_eq(lengde(flate.berre_spora("/r", funne, committa_vm)), 1)
    assert_eq(flate.berre_spora("/r", funne, committa_vm)[0], "/r/bootstrap/precompiled/vm.ncb.json")
    assert_eq(lengde(flate.berre_spora("/r", funne, ["m\tfilsystem", "f\tselfhost/vm.no"])), 3)

    skriv("test_active_surface_committed_bytecode OK\n")
    returner 0
}
