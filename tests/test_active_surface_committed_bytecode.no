bruk tools.no_c_python_active_surface som flate
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops
bruk std.tekst som t

// JSON-avvikling J6 (rapportmodus): committed_bytecode-sjekken i active-surface
// må kunne seie både ja og nei — namnemønster, innhaldsmønster og eksklusjonar.
funksjon start() -> heiltall {
    // Namnemønster.
    assert(flate.bytekode_namn("/r/bootstrap/precompiled/vm.ncb.json"))
    assert(flate.bytekode_namn("/r/bootstrap/precompiled/vm.ncb.json.bak_v798"))
    assert(flate.bytekode_namn("/r/bootstrap/precompiled_fragments_inner/parser.functions.json"))
    assert(flate.bytekode_namn("/r/build/bootstrap_compiler_bundle.ncb"))
    assert(flate.bytekode_namn("/r/x/modul.ncbin"))
    assert(ikkje flate.bytekode_namn("/r/vscode-norscode/package.json"))
    assert(ikkje flate.bytekode_namn("/r/tests/ir_snapshot_cases.json"))
    assert(ikkje flate.bytekode_namn("/r/selfhost/ncb_serde.no"))

    // Innhaldsmønster (fyrste 64 byte).
    assert(flate.bytekode_innhald("{\"format\":\"ncb-v1\",\"entry\":\"a.start\"}"))
    assert(flate.bytekode_innhald("{\"format\":\"norscode-bytecode-v1\",\"entry\":\"__main__.start\"}"))
    assert(flate.bytekode_innhald("{\n  \"format\": \"norscode-bytecode-v1\",\n"))
    assert(flate.bytekode_innhald(builtin.chr(147) + "NCB" + builtin.chr(1)))
    assert(ikkje flate.bytekode_innhald("{\"name\":\"norscode\",\"version\":\"1.0.0\"}"))
    assert(ikkje flate.bytekode_innhald("{\"format\":\"sigstore\"}"))
    assert(ikkje flate.bytekode_innhald(""))

    // Heile vandringa på eit lite tre: to treff, éin ekskludert, éin legitim JSON.
    la temp = runtime_fs.native_tempområde("build", "bytekode-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    assert(filops.lag_katalogar(base + "/a"))
    assert(filops.lag_katalogar(base + "/b"))
    assert(filops.lag_katalogar(base + "/docs"))
    fil_skriv(base + "/a/modul.ncb.json", "{}")
    fil_skriv(base + "/b/skjult.json", "{\"format\":\"ncb-v1\",\"entry\":\"x.start\",\"functions\":{}}")
    fil_skriv(base + "/b/pakke.json", "{\"name\":\"demo\"}")
    fil_skriv(base + "/docs/doc.ncb.json", "{}")
    la treff = flate.collect_committed_bytecode(base)
    assert_eq(lengde(treff), 2)
    assert(t.inneholder(treff[0] + "|" + treff[1], "/a/modul.ncb.json"))
    assert(t.inneholder(treff[0] + "|" + treff[1], "/b/skjult.json"))
    la per_katalog = flate.bytekode_per_katalog(base, treff)
    assert_eq(lengde(per_katalog), 2)
    assert_eq(per_katalog[0], "  a: 1")
    assert_eq(per_katalog[1], "  b: 1")
    assert(filops.slett_tre(base))

    // Porten står i active-surface og er framleis rapportmodus som standard.
    la src = fil_les("tools/no_c_python_active_surface.no")
    assert(t.inneholder(src, "la bytekode = collect_committed_bytecode(root)"))
    assert(t.inneholder(src, "MERK: committed_bytecode: "))
    assert(t.inneholder(src, "env(\"NORSCODE_BYTECODE_GATE\") == \"hard\""))
    skriv("test_active_surface_committed_bytecode OK\n")
    returner 0
}
