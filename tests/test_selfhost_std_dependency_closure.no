// Kvar `bruk`-import i ein manifest-modul (tools/omgang6b_modules.no) må sjølv vere i
// manifestet. Manglar ein modul (t.d. std.p256 som std.ecdsa_p256 importerer), blir kall til
// han uløyste i kompilator-NCB-en, og den strenge builtin-porten stoppar selfcompile
// («UVENTA std.p256.ecdsa_verifiser/5»).
bruk tools.gen0_omgang6b_fragments som gen0

funksjon start() -> heiltall {
    la modular = {}
    la kjelder = []
    for spec i gen0.modulspesifikasjonar() {
        la felt = builtin.split(spec, "|")
        modular[felt[1]] = sann
        legg_til(kjelder, felt[0])
    }
    la manglar = []
    for sti i kjelder {
        for linje i builtin.split(builtin.fil_les(sti), "\n") {
            hvis builtin.starts_with(linje, "bruk ") {
                la rest = builtin.trim(builtin.slice(linje, 5, lengde(linje)))
                la namn = builtin.split(rest, " ")[0]
                hvis ikkje har_nokkel(modular, namn) { legg_til(manglar, sti + " -> " + namn) }
            }
        }
    }
    hvis lengde(manglar) > 0 {
        skriv("Manglande manifest-modular:\n" + builtin.join(manglar, "\n") + "\n")
        returner 1
    }
    skriv("test_selfhost_std_dependency_closure OK\n")
    returner 0
}
