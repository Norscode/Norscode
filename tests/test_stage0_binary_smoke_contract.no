bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/stage0_binary_smoke.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "NORSCODE_CMD"))
    assert(t.inneholder(src, "exit_code"))
    assert(t.inneholder(src, "!= 7"))
    assert(ikkje t.inneholder(src, "printf"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    skriv("test_stage0_binary_smoke_contract OK\n")
    returner 0
}

