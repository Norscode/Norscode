bruk std.locale som lok

funksjon start() -> heiltall {
    la expected = builtin.miljo_hent("NORSCODE_TEST_LOCALE_EXPECTED")
    hvis expected == "" {
        expected = "nb_NO.UTF-8"
        la parsed_pure = lok.getdefaultlocale_for(expected)
        assert(parsed_pure["lokal"] == "nb_NO")
        assert(parsed_pure["encoding"] == "UTF-8")
        la info_pure = lok.localeconv_for(expected)
        assert(info_pure["desimalteikn"] == ",")
        assert(info_pure["valutasymbol"] == "kr")
        skriv("test_locale_native_environment OK (rein eksplisitt lokal)\n")
        returner 0
    }
    assert(lok.getlocale() == expected)
    la parsed = lok.getdefaultlocale()
    assert(parsed["lokal"] == "nb_NO")
    assert(parsed["encoding"] == "UTF-8")
    la info = lok.localeconv()
    assert(info["desimalteikn"] == ",")
    assert(info["valutasymbol"] == "kr")
    skriv("test_locale_native_environment OK")
    returner 0
}
