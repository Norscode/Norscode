bruk selfhost.kompiler som komp

funksjon start() -> heiltall {
    la kjelde = "funksjon probe() -> heiltall { returner 3 }\nfunksjon start() -> heiltall {\n    41\n    probe()\n    returner 7\n}\n"
    la ncb = komp.kompiler_fil(kjelde, "__main__")
    assert(ikkje builtin.contains(ncb, "[\"PUSH_CONST\",41],[\"POP\"]"))
    assert(builtin.contains(ncb, "[\"CALL\",\"__main__.probe\",0],[\"POP\"]"))
    assert(builtin.contains(ncb, "[\"PUSH_CONST\",7],[\"RETURN\"]"))
    skriv("test_bytecode_unused_literal_stack OK")
    returner 0
}
