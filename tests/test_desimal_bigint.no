// Regresjon (Java-paritet F40): std.desimal med mantisse på std.bigint
// (java.math.BigDecimal). Før fiksen var mantissen eit 64-bit heltall som
// flaut stille over: 12345678901.5 × 98765432101.5 gav -3471979182005315.35.
// Fasitane er kontrollerte med bc(1).
// Ingen assert (no-op i AOT): feil blir talde og gitt som returverdi.
bruk std.desimal som des

funksjon sjekk(feil: liste_heltall, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "], venta [" + venta + "]\n")
        feil[0] = feil[0] + 1
    }
}

funksjon start() -> heiltall {
    la feil: liste_heltall = [0]
    la a = des.frå_tekst("12345678901.5")
    la b = des.frå_tekst("98765432101.5")
    sjekk(feil, "stor gonger", des.til_tekst(des.gonger(a, b)), "1219326311293019356502.25")
    sjekk(feil, "stor gonger negativ", des.til_tekst(des.gonger(des.neg(a), b)), "-1219326311293019356502.25")

    // Liten veg uendra
    sjekk(feil, "0.1+0.2", des.til_tekst(des.pluss(des.frå_tekst("0.1"), des.frå_tekst("0.2"))), "0.3")
    sjekk(feil, "10/3", des.til_tekst(des.dele(des.frå_tekst("10"), des.frå_tekst("3"), 10)), "3.3333333333")
    sjekk(feil, "avrund 2.675", des.til_tekst_n(des.frå_tekst("2.675"), 2), "2.68")
    sjekk(feil, "til_tekst_n utan punktum", des.til_tekst_n(des.frå_tekst("5"), 2), "5.00")
    sjekk(feil, "liten form", tekst(lengde(des.pluss(des.frå_tekst("1.5"), des.frå_tekst("2.25")))), "2")

    // Store tal gjennom heile API-et
    la s = des.frå_tekst("123456789012345678901234567890.123")
    sjekk(feil, "frå_tekst/til_tekst", des.til_tekst(s), "123456789012345678901234567890.123")
    sjekk(feil, "pluss", des.til_tekst(des.pluss(s, des.frå_tekst("0.877"))), "123456789012345678901234567891.000")
    sjekk(feil, "minus til null", des.til_tekst(des.minus(s, s)) + "/" + tekst(des.er_null(des.minus(s, s))), "0.000/sann")
    sjekk(feil, "blanda forteikn", des.til_tekst(des.pluss(des.neg(s), des.frå_tekst("1"))), "-123456789012345678901234567889.123")
    sjekk(feil, "dele", des.til_tekst(des.dele(s, des.frå_tekst("3"), 3)), "41152263004115226300411522630.041")
    sjekk(feil, "avrund", des.til_tekst(des.avrund(s, 1)), "123456789012345678901234567890.1")
    sjekk(feil, "golv negativ", des.til_tekst(des.golv(des.neg(s))), "-123456789012345678901234567891")
    sjekk(feil, "tak", des.til_tekst(des.tak(s)), "123456789012345678901234567891")
    sjekk(feil, "samanlikn", tekst(des.samanlikn(s, a)) + tekst(des.samanlikn(a, s)) + tekst(des.samanlikn(s, s)), "1-10")
    sjekk(feil, "er_større/neg", tekst(des.er_større(a, des.neg(s))) + tekst(des.er_negativ(des.neg(s))), "sannsann")
    sjekk(feil, "2^100", des.til_tekst(des.potens(des.frå_tekst("2"), 100)), "1267650600228229401496703205376")
    sjekk(feil, "1.1^20", des.til_tekst(des.potens(des.frå_tekst("1.1"), 20)), "6.72749994932560009201")
    sjekk(feil, "modulo", des.til_tekst(des.modulo(des.frå_tekst("100000000000000000000007"), des.frå_tekst("10"))), "7")

    // Normaliserer tilbake til liten form når resultatet får plass
    la tilbake = des.dele(des.gonger(a, b), b, 1)
    sjekk(feil, "normalisert", des.til_tekst(tilbake) + "/" + tekst(lengde(tilbake)), "12345678901.5/2")

    // mantisse() kastar for store tal i staden for å gi feil verdi
    la kasta = usann
    prøv { des.mantisse(s) } fang (e) { kasta = sann }
    sjekk(feil, "mantisse kastar", tekst(kasta), "sann")

    hvis feil[0] == 0 { skriv("test_desimal_bigint OK\n") }
    returner feil[0]
}
