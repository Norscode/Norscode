# Regresjon: _sjekk_tillit krev at kvar utferdar (anker/mellomsertifikat) er CA med keyCertSign og pathLen.
# Sertifikata er openssl-genererte ECDSA-P256 (gyldige ca. 2026-10 .. 2034).
bruk std.tls13_klient som tls

funksjon _har(s: tekst, del: tekst) -> boolsk {
    returner builtin.index_of(s, del) >= 0
}

funksjon _test_ca_krav() {
    la no = "2027-01-01T00:00:00Z"
    la root = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    la mid = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    la leaf = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    la cam = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    la leaf2 = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    la nk = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    la leaf3 = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n")[0]
    # Forfalska kjede: mid er vanleg sluttbrukar-cert (CA:FALSE) under rota, signerer leaf -> avvist.
    la r1 = tls._sjekk_tillit([leaf, mid], [root], no)
    assert(r1 != "")
    assert(_har(r1, "CA"))
    # Ekte CA-mellomsertifikat (CA:TRUE, pathlen 0, keyCertSign) er OK.
    assert_eq(tls._sjekk_tillit([leaf2, cam], [root], no), "")
    # CA=true men keyUsage utan keyCertSign -> avvist.
    la r3 = tls._sjekk_tillit([leaf3, nk], [root], no)
    assert(_har(r3, "keyCertSign"))
    # Anker som ikkje er CA kan ikkje utferde (mid signerer leaf, mid er anker).
    la r4 = tls._sjekk_tillit([leaf], [mid], no)
    assert(_har(r4, "CA"))
    # Direkte frå rota (CA) er OK; pinning av leaf er framleis OK.
    assert_eq(tls._sjekk_tillit([mid], [root], no), "")
    assert_eq(tls._sjekk_tillit([leaf], [leaf], no), "")
    # pathLen 0: eit ekstra mellomsertifikat under cam er over grensa.
    la r5 = tls._sjekk_tillit([leaf2, mid, cam], [root], no)
    assert(r5 != "")
    # Anker med pathLen 0: eitt mellomsertifikat under ankeret er over grensa; pathLen 1 tillèt det.
    la ar0 = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\nMIIBgjCCASigAwIBAgIUW0/27x2qGtpcYGkUe8e4sCYDa6gwCgYIKoZIzj0EAwIw\nDTELMAkGA1UEAwwCUlAwHhcNMjYxMDE5MTcyNTIyWhcNMzUwMTA1MTcyNTIyWjAN\nMQswCQYDVQQDDAJSUDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABFzlXcOrqHYG\nKuCSa7NIU8vvpUsItVYB9l+d0nC5hLbGx/rjZlbArQ7VWWWzmYUNJtcZJJFheL0X\nNk8Rf9saO0GjZjBkMB0GA1UdDgQWBBQUQVRkM/cOta25AFhO2TSm2XeccTAfBgNV\nHSMEGDAWgBQUQVRkM/cOta25AFhO2TSm2XeccTASBgNVHRMBAf8ECDAGAQH/AgEA\nMA4GA1UdDwEB/wQEAwICBDAKBggqhkjOPQQDAgNIADBFAiEA3gHvGLd50FM/h9iV\nB2hxP+DL5pAkC5Lv3wXoDup6qsoCIESEsA+bKvm6YKYOT0dK9ughUbAg+MW87aFz\nzwy9n1Mt\n-----END CERTIFICATE-----\n")[0]
    la ar1 = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\nMIIBgTCCASigAwIBAgIUDIGFzHnjWqCwyZSuCC4jF9dfhRAwCgYIKoZIzj0EAwIw\nDTELMAkGA1UEAwwCUlAwHhcNMjYxMDE5MTcyNTIyWhcNMzUwMTA1MTcyNTIyWjAN\nMQswCQYDVQQDDAJSUDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABFzlXcOrqHYG\nKuCSa7NIU8vvpUsItVYB9l+d0nC5hLbGx/rjZlbArQ7VWWWzmYUNJtcZJJFheL0X\nNk8Rf9saO0GjZjBkMB0GA1UdDgQWBBQUQVRkM/cOta25AFhO2TSm2XeccTAfBgNV\nHSMEGDAWgBQUQVRkM/cOta25AFhO2TSm2XeccTASBgNVHRMBAf8ECDAGAQH/AgEB\nMA4GA1UdDwEB/wQEAwICBDAKBggqhkjOPQQDAgNHADBEAiBQSwd3oAuMbx+GXxVs\n1LDIqVl/+oriYbc03mkkjjAf9QIgEUmpWu5uDpayuj6PmcT5yM2W4ri+sHkwf/fV\njJsXjbE=\n-----END CERTIFICATE-----\n")[0]
    la am = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\nMIIBfzCCASWgAwIBAgIUYsS0XpV4SyPTUdFK7qU8D5nu/XQwCgYIKoZIzj0EAwIw\nDTELMAkGA1UEAwwCUlAwHhcNMjYxMDE5MTcyNTIyWhcNMzUwMTA1MTcyNTIyWjAN\nMQswCQYDVQQDDAJNUDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABJnRdII5MiOv\nz8DB0aBEw+c0yFU52FYRoRyYWYaA2fles+PsnycYoHHajuM/aLWEHnrhGS6BeJxv\ngJBv8YY8z3WjYzBhMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgIEMB0G\nA1UdDgQWBBSnWbn47SvqOW46FgQRueIjLpEKcDAfBgNVHSMEGDAWgBQUQVRkM/cO\nta25AFhO2TSm2XeccTAKBggqhkjOPQQDAgNIADBFAiAE0HsR8dT3yqzrGSrgL8Q0\n/TK2HGFSvErgKuH2UqSMfgIhAJQAn2LeYJMf9IV4Y3eThF+N+4Ogc+j3WkJFs5E6\nID+w\n-----END CERTIFICATE-----\n")[0]
    la al = tls.pem_sertifikat("-----BEGIN CERTIFICATE-----\nMIIBdjCCAR2gAwIBAgIUAroCBVdU9miR3+4bDoYZ2DpdGvQwCgYIKoZIzj0EAwIw\nDTELMAkGA1UEAwwCTVAwHhcNMjYxMDE5MTcyNTIyWhcNMzUwMTA1MTcyNTIyWjAQ\nMQ4wDAYDVQQDDAVsZWFmcDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABFsuTS4e\njnSh9Yz5YWpg3X9qRLSdIhQ4Mk1i9mPx5DuLCj7I89XLmZlG7fQ5ydZm98jV4Gb+\nihBCRur/GUOnG6+jWDBWMBQGA1UdEQQNMAuCCXguZXhhbXBsZTAdBgNVHQ4EFgQU\n9HciQTnoHO1hNMNHBKGTLADTTJUwHwYDVR0jBBgwFoAUp1m5+O0r6jluOhYEEbni\nIy6RCnAwCgYIKoZIzj0EAwIDRwAwRAIgHPYrvhSW2Z3ywlqY8XDZCnIQ9phZC0ru\nzVdUa5GwgikCIH/s/0QuJeowXv1fdiXxTTaK0RQecd9MXSpwGYAY0gf6\n-----END CERTIFICATE-----\n")[0]
    assert(_har(tls._sjekk_tillit([al, am], [ar0], no), "pathLen"))
    assert_eq(tls._sjekk_tillit([al, am], [ar1], no), "")
}

funksjon start() -> heiltall {
    _test_ca_krav()
    skriv("test_tls13_klient_ca OK")
    returner 0
}
