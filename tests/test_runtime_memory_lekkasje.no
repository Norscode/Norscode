bruk std.runtime_memory som minne

// Regresjon: sweep må fjerne metadata for frigjorde objekt. Før vaks heap-ordboka med
// ~10 nøklar per frigjort objekt (og "freed_ids" vaks kvadratisk), slik at ein VM-køyring
// som lagar mange lister/ordbøker nådde GC-taket på 1 GiB.

funksjon sjekk(namn: tekst, ok: bool) {
    hvis ikkje ok {
        skriv("FEIL runtime_memory_lekkasje: " + namn + "\n")
        assert(ok)
    }
}

funksjon start() -> heiltall {
    la h = minne.ny_heap()
    la baseline = lengde(nøkler(h))
    la rot = minne.alloker(h, "liste", 32)
    sjekk("rot", minne.legg_rot(h, rot))
    la runde: heiltall = 0
    mens runde < 5 {
        la i: heiltall = 0
        mens i < 200 {
            minne.alloker(h, "liste", 32)
            i = i + 1
        }
        la gc = minne.collect(h)
        sjekk("frigjort", gc["freed"] == "200")
        runde = runde + 1
    }
    sjekk("berre roten lever", minne.samandrag(h)["alive"] == "1")
    sjekk("rota lever", minne.objekt_levande(h, rot))
    sjekk("ordboka veks ikkje", lengde(nøkler(h)) < baseline + 40)
    sjekk("freed_ids tom", h["freed_ids"] == "|")
    returner 0
}

start()
