bruk std.desktop_render som r
la s = r.ny_scene(1200, 800)
hvis s["valid"] != "sann" { kast "scene" }
hvis ikkje r.rektangel(s, 0, 0, 300, 800, "#102030") { kast "sidebar" }
hvis ikkje r.rektangel(s, 300, 0, 900, 800, "#ffffff") { kast "editor" }
hvis ikkje r.tekstlinje(s, 320, 20, 400, 28, "#ffffff", "Norscode Studio") { kast "text" }
hvis s["count"] != "3" { kast "count" }
la c = r.kommando(s, 2)
hvis c["type"] != "text" eller c["text"] != "Norscode Studio" { kast "command" }
hvis r.rektangel(s, 1100, 0, 200, 100, "#000000") { kast "bounds" }
hvis r.rektangel(s, 0, 0, 100, 100, "#nothex") { kast "color" }
hvis r.tekstlinje(s, -1, 0, 100, 20, "#000000", "bad") { kast "negative" }
hvis r.kommando(s, 3)["ok"] != "usann" { kast "out of range" }
hvis r.ny_scene(0, 100)["valid"] != "usann" { kast "invalid scene" }
skriv("desktop render OK")
