funksjon start() -> heiltall {
    la args: liste_tekst = []
    prøv {
        la svar = builtin.argv_operation({
            "abi": "norscode-argv-v1",
            "operation": "get"
        })
        assert(svar["status"] == "ok")
        args = svar["argv"]
    } fang (e) {
        hvis miljo_hent("NORSCODE_EXPECT_ARGV_PROBE") == "1" {
            skriv("native argv manglar: " + tekst(e) + "\n")
            returner 2
        }
        returner 0
    }
    la i: heiltall = 0
    mens i < lengde(args) {
        skriv("argv[" + tekst_fra_heltall(i) + "]=" + tekst(args[i]) + "\n")
        i = i + 1
    }
    hvis miljo_hent("NORSCODE_EXPECT_ARGV_PROBE") == "1" {
        la funne = usann
        i = 0
        mens i < lengde(args) {
            hvis args[i] == "norscode-argv-probe" { funne = sann }
            i = i + 1
        }
        assert(funne)
    }
    returner 0
}
