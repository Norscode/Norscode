# W9: synk-klienten (std/synk_klient.no) gjev same resultat i VM-en og som WebAssembly.
# Korpusprogrammet tests/wasm_korpus/synk_klient.no køyrer klienten i testmodus mot ein liten
# NSP/1-tenar i Norscode (optimistisk skriving, hugs, sidevis pull, offline og backoff, konflikt,
# 409, 410, 401, 403 csrf, avvist op, klient_eigar, to faner med leiarskifte, polling med 304,
# logg_ut og brukarbyte). Det blir køyrt i VM-en mot fasiten, bygt med tools/nc_wasm.no (validert)
# og, når Chrome finst, køyrt i nettlesaren med krav om identisk utskrift (SKIP utan Chrome).
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon start() -> heltall {
    la r = kh.køyr_korpus("test_synk_klient_wasm", "build/wasm/test_synk_klient_korpus", ["synk_klient"], [], "48381", {})
    skriv("storleik: synk_klient=" + tekst(r["storleik"]["synk_klient"]) + " byte\n")
    skriv("test_synk_klient_wasm OK\n")
    returner 0
}
