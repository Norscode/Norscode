bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/filecmp.no")
    assert(t.inneholder(src, "Modulen startar ingen eksterne prosessar"))
    assert(t.inneholder(src, "bruk std.md5 som md5_hash"))
    assert(t.inneholder(src, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(src, "md5_hash.hash_bytes(builtin.fil_les_binær(filsti))"))
    assert(t.inneholder(src, "native_fs.native_stat_sti(sti)"))
    assert(t.inneholder(src, "native_fs.native_list(sti, \"\")"))
    assert(t.inneholder(src, "builtin.fil_finnes(sti)"))
    assert(t.inneholder(src, "la venstre = builtin.split(builtin.fil_les(fil1), \"\\n\")"))

    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "diff -q "))
    assert(ikkje t.inneholder(src, "md5sum "))
    assert(ikkje t.inneholder(src, "md5 -q "))
    assert(ikkje t.inneholder(src, "find "))
    assert(ikkje t.inneholder(src, "stat -c "))
    assert(ikkje t.inneholder(src, "stat -f "))
    assert(ikkje t.inneholder(src, "ls -1 "))

    skriv("test_filecmp_shell_quote OK")
    returner 0
}
