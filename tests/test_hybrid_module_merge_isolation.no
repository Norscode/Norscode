bruk tools.compile_with_hybrid_bundle_v9400 som hybrid

funksjon start() -> heiltall {
    la merged = {"functions": {}}
    merged["functions"]["modul.a"] = {"module": "modul", "code": ["old"]}
    merged["functions"]["anna.b"] = {"module": "anna", "code": ["live"]}

    la fragment = {"functions": {}}
    fragment["functions"]["modul.a"] = {"module": "modul", "code": ["new"]}
    fragment["functions"]["anna.b"] = {"module": "anna", "code": ["stale"]}
    hybrid.merge_fragment(merged, fragment, "modul")

    la modul_fn = merged["functions"]["modul.a"]
    la anna_fn = merged["functions"]["anna.b"]
    assert_eq(modul_fn["code"][0], "new")
    assert_eq(anna_fn["code"][0], "live")
    assert(hybrid.fragment_har_modul(merged, "modul"))
    assert(hybrid.fragment_har_modul(merged, "anna"))
    assert(ikkje hybrid.fragment_har_modul(merged, "manglar"))

    la eigarar = {"functions": {}}
    eigarar["functions"]["modul.feil"] = {"module": "anna", "code": []}
    // Eit kvalifisert namn er ikkje bevis for faktisk moduleigarskap.
    assert(ikkje hybrid.fragment_har_modul(eigarar, "modul"))
    eigarar["functions"]["ukvalifisert"] = {"module": "modul", "code": []}
    // Den eldre alias-/ukvalifiserte forma må framleis finnast, også når
    // ein misvisande kvalifisert nøkkel står tidlegare i kartet.
    assert(hybrid.fragment_har_modul(eigarar, "modul"))
    assert(hybrid.fragment_har_modul(eigarar, "anna"))
    assert(ikkje hybrid.fragment_har_modul({"functions": {}}, "modul"))
    skriv("test_hybrid_module_merge_isolation OK")
    returner 0
}
