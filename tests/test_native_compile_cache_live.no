bruk tools.process_runner som prosess

funksjon køyr(runtime: tekst, root: tekst, kjelde: tekst, ut: tekst, modul: tekst) -> ordbok_tekst {
    returner prosess.køyr(runtime, ["compile", kjelde, ut], root, {
        "NORSCODE_ROOT": root,
        "NORSCODE_MODULE": modul,
        "NORSCODE_NATIVE_TOOL_CACHE": "1",
        "NORSCODE_NATIVE_TOOL_CACHE_TRACE": "on",
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, 120000)
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la runtime = tekst(info["executable"])
    la root = tekst(info["cwd"])
    la id = builtin.random_hex(12)
    la dir = root + "/build/native-compile-cache-live-" + id
    builtin.mkdir_p(dir)
    la kjelde = dir + "/probe.no"
    la a1 = dir + "/a1.ncb.json"
    la a2 = dir + "/a2.ncb.json"
    la b1 = dir + "/b1.ncb.json"
    fil_skriv(kjelde, "bruk std.tekst som t\nfunksjon start() -> heiltall { assert(t.trim(\" x \" ) == \"x\") returner " + tekst_fra_heltall(lengde(id)) + " }\n")

    la første = køyr(runtime, root, kjelde, a1, "cache_a")
    la andre = køyr(runtime, root, kjelde, a2, "cache_a")
    la anna_modul = køyr(runtime, root, kjelde, b1, "cache_b")
    hvis ikkje prosess.ok(første) eller ikkje prosess.ok(andre) eller ikkje prosess.ok(anna_modul) {
        prosess.skriv_resultat(første)
        prosess.skriv_resultat(andre)
        prosess.skriv_resultat(anna_modul)
    }
    hvis ikkje builtin.contains(tekst(første["stdout"]), "[native-tool-cache] bom") { skriv("første=" + tekst(første["stdout"]) + "\n") }
    hvis ikkje builtin.contains(tekst(andre["stdout"]), "[native-tool-cache] treff") { skriv("andre=" + tekst(andre["stdout"]) + "\n") }
    hvis ikkje builtin.contains(tekst(anna_modul["stdout"]), "[native-tool-cache] bom") { skriv("anna=" + tekst(anna_modul["stdout"]) + "\n") }
    assert(prosess.ok(første) og prosess.ok(andre) og prosess.ok(anna_modul))
    assert(builtin.contains(tekst(første["stdout"]), "[native-tool-cache] bom"))
    assert(builtin.contains(tekst(andre["stdout"]), "[native-tool-cache] treff"))
    assert(builtin.contains(tekst(anna_modul["stdout"]), "[native-tool-cache] bom"))
    assert(builtin.sha256_bytes(fil_les_binær(a1)) == builtin.sha256_bytes(fil_les_binær(a2)))
    assert(builtin.sha256_bytes(fil_les_binær(a1)) != builtin.sha256_bytes(fil_les_binær(b1)))
    assert(builtin.json_parse_raw(fil_les(a1))["entry"] == "cache_a.start")
    assert(builtin.json_parse_raw(fil_les(b1))["entry"] == "cache_b.start")
    skriv("test_native_compile_cache_live OK")
    returner 0
}
