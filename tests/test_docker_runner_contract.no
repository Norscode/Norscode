bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/docker_runner.no")
    assert(t.inneholder(src, "builtin.replace(tekst(resultat[\"stdout\"]), \"\\\\n\", \"\\n\")"))
    assert(t.inneholder(src, "returner builtin.trim(stdout)"))
    assert(t.inneholder(src, "prosess.køyr(docker, [\"start\", container]"))
    assert(ikkje t.inneholder(src, "sh -c"))
    skriv("test_docker_runner_contract OK\n")
    returner 0
}
