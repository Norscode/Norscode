bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("selfhost/nc_main.no")

    assert(t.inneholder(src, "funksjon modulnamn_fra_importfil(import_fil: tekst) -> tekst"))
    assert(t.inneholder(src, "la kanonisk_modul = modulnamn_fra_importfil(import_fil)"))
    assert(t.inneholder(src, "\"\\\"builtin.\" + alias + \".\", \"\\\"\" + kanonisk_modul + \".\""))
    assert(t.inneholder(src, "\"\\\"\" + alias + \".\", \"\\\"\" + kanonisk_modul + \".\""))
    assert(t.inneholder(src, "kø_str = kø_str + modul0 + \"=\" + _resolve_import_sti(src_sti, fil0)"))
    assert(t.inneholder(src, "legg_til(kø, t_modul + \"=\" + t_resolved)"))

    skriv("test_native_bundle_canonical_import_names OK")
    returner 0
}
