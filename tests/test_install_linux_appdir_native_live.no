bruk tools.install_linux_appdir_core som installer
bruk std.zip som zip
bruk std.sha256 som sha256
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la temp = runtime_fs.native_tempområde("build", "linux-appdir-install-")
    assert(temp["status"] == "created")
    la base_rel = temp["relative"]
    la base = root + "/build/" + base_rel
    la arkiv = base + "/Fixture.AppDir.tar.gz"
    la prefix = base + "/prefix"

    la ark = zip.ny_tar()
    assert(zip.tar_legg_til_bytes(ark, "Fixture.AppDir/AppRun",
                                  builtin.bytes_from_list([78, 67, 45, 65, 80, 80])) == 0)
    assert(zip.tar_sett_modus(ark, "Fixture.AppDir/AppRun", 493) == 0)
    assert(zip.tar_legg_til_bytes(ark, "Fixture.AppDir/payload.txt",
                                  builtin.bytes_from_list([114, 101, 97, 100, 121])) == 0)
    assert(zip.tar_skriv_gzip(ark, arkiv))
    builtin.fil_skriv(arkiv + ".sha256",
                      sha256.hash_bytes(builtin.fil_les_binær(arkiv)) + "\n")

    assert(installer.installer(arkiv, prefix, root) == 0)
    assert(builtin.fil_les(prefix + "/current/payload.txt") == "ready")
    assert(builtin.fil_les(prefix + "/bin/norscode-app") == "NC-APP")
    la modus = runtime_fs.native_stat_sti(prefix + "/versions/Fixture.AppDir/AppRun")
    assert(modus["status"] == "ok")
    assert((heltall_fra_tekst(modus["mode"]) & 511) == 493)

    assert(filops.slett_tre(base))
    skriv("test_install_linux_appdir_native_live OK")
    returner 0
}
