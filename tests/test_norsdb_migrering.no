// Cutover: migrering av gamalt JSON-.db-format → binær motor, så open via adapter.
// Trygt: rører berre temp-filer, ikkje produksjon.

bruk std.norsdb_db som db

funksjon start() -> heltall {
    la json_sti = "/tmp/norsdb_migr_test.json"
    la bin_sti = "/tmp/norsdb_migr_test.bin"
    hvis builtin.fil_finnes(json_sti) { builtin.fil_slett(json_sti) }
    hvis builtin.fil_finnes(bin_sti + ".cp") { builtin.fil_slett(bin_sti + ".cp") }
    hvis builtin.fil_finnes(bin_sti + ".wal") { builtin.fil_slett(bin_sti + ".wal") }

    // Skriv ei JSON-.db i det gamle formatet (schema utan 'id', rader med 'id').
    la json = "{\"_tables\":{\"folk\":{\"schema\":[{\"namn\":\"navn\",\"type\":\"TEXT\"},{\"namn\":\"alder\",\"type\":\"INTEGER\"}],\"rows\":[{\"navn\":\"Ada\",\"alder\":\"37\",\"id\":\"1\"},{\"navn\":\"Linus\",\"alder\":\"55\",\"id\":\"2\"}],\"next_id\":3}},\"_path\":\"x\",\"_in_tx\":false}"
    builtin.fil_skriv(json_sti, json)

    // Migrer
    assert_eq(db.migrer_json(json_sti, bin_sti), 2)

    // Opne binær-fila via adapter og verifiser innhaldet
    la h = db.open(bin_sti)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk"), 2)
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE id = 1"), "Ada")
    assert_eq(db.query_text(h, "SELECT alder FROM folk WHERE id = 2"), "55")
    assert(db.close(h))

    // Rydd opp
    builtin.fil_slett(json_sti)
    hvis builtin.fil_finnes(bin_sti + ".cp") { builtin.fil_slett(bin_sti + ".cp") }
    hvis builtin.fil_finnes(bin_sti + ".wal") { builtin.fil_slett(bin_sti + ".wal") }
    returner 0
}
