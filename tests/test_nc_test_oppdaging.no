// F38: `nc test` køyrer test-blokker (`test "namn" { ... }`) og test_*-funksjonar med
// rapport per test og assert-melding (tools/nc_test_oppdaging.no + tools/nc_test.no).
//
// Del 1 testar oppdaginga direkte (kjelde-førefilter, testplan og køyrar-installasjon på
// syntetiske NCB-ar, oppfølgingssegment, tolking av rapportlinjer og segment). Del 2
// køyrer `bin/nc test` som underprosess på tests/fixtures/nc_test/ og sjekkar utskrift og
// exit-kode. Før F38 gav testblokker.no «OK: Alle testar bestått» (falsk grønt), og
// testfunksjonar_utan_start.no køyrde ingenting. Etter granskinga: grensesnitt_start.no
// (grensesnitt-metoden start lurte førefilteret → falsk grønt) og fatal_i_blokk.no (ein
// ufangbar feil stoppa resten av testane).
bruk tools.nc_test_oppdaging som oppdaging
bruk tools.process_runner som prosess

funksjon repo_root() -> tekst {
    prøv {
        la root = miljo_hent("NORSCODE_ROOT")
        hvis root != "" { returner root }
    } fang (e) {}
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon sjekk(feil: liste_tekst, vilkår: bool, melding: tekst) -> heiltall {
    hvis ikkje vilkår {
        legg_til(feil, melding)
        skriv("FEIL: " + melding + "\n")
    }
    returner 0
}

funksjon inneheld(t: tekst, del: tekst) -> bool {
    returner builtin.index_of(t, del) >= 0
}

// ── Del 1: oppdaging utan underprosess ──────────────────────────────────────────

funksjon funksjon_def(namn: tekst, params, linje: heiltall) {
    la def = {}
    def["name"] = namn
    def["module"] = "__main__"
    def["params"] = params
    def["is_async"] = usann
    def["code"] = [["PUSH_CONST", 0], ["RETURN"]]
    def["source_lines"] = [linje]
    returner def
}

funksjon lag_testblokk(namn: tekst, modul: tekst) {
    la t = {}
    t["name"] = namn
    t["module"] = modul
    t["kind"] = "test"
    t["params"] = []
    t["code"] = [["PUSH_CONST", 0], ["RETURN"]]
    returner t
}

funksjon sjekk_førefilter(feil: liste_tekst) -> heiltall {
    sjekk(feil, oppdaging.kjelde_kan_ha_testar("funksjon start() {}\ntest \"a\" {\n}\n"),
          "førefilter: test-blokk ved sida av start() skal gje treff")
    sjekk(feil, oppdaging.kjelde_kan_ha_testar("test\"a\" {\n}\n"),
          "førefilter: test-blokk fyrst i fila, utan mellomrom, skal gje treff")
    sjekk(feil, oppdaging.kjelde_kan_ha_testar("funksjon test_a() {\n}\n"),
          "førefilter: test_*-funksjon utan start() skal gje treff")
    sjekk(feil, oppdaging.kjelde_kan_ha_testar("test_a() {\n    assert_eq(1, 2)\n}\n"),
          "førefilter: test_*-funksjon i kortform (utan `funksjon`) skal gje treff")
    // Gransking F38: eit innrykka `funksjon start(` i eit grensesnitt gav falsk bom. start()
    // blir ikkje lenger vurdert i kjelda; NCB-en avgjer.
    sjekk(feil, oppdaging.kjelde_kan_ha_testar("grensesnitt Motor {\n    funksjon start(self) -> heltall\n}\nfunksjon test_ok() {\n}\n"),
          "førefilter: test_*-funksjon ved sida av grensesnitt-metoden start skal gje treff")
    sjekk(feil, oppdaging.kjelde_kan_ha_testar("funksjon test_a() {\n}\nfunksjon start() -> heiltall {\n    returner 0\n}\n"),
          "førefilter: test_*-funksjon MED start() gjev treff (NCB-en avgjer)")
    sjekk(feil, ikkje oppdaging.kjelde_kan_ha_testar("funksjon start() -> heiltall {\n    la s = \"test \\\"x\\\"\"\n    returner 0\n}\n"),
          "førefilter: vanleg test utan blokker skal ikkje gje treff")
    sjekk(feil, ikkje oppdaging.kjelde_kan_ha_testar("funksjon start() -> heiltall {\n    min_test_x()\n    la testar = attest_y(1)\n    returner 0\n}\n"),
          "førefilter: namn som berre inneheld test/test_ skal ikkje gje treff")
    returner 0
}

funksjon sjekk_installasjon(feil: liste_tekst) -> heiltall {
    // (a) Vanleg start()-test utan blokker: NCB-en skal vere urørd.
    la vanleg_fn = {}
    vanleg_fn["__main__.start"] = funksjon_def("start", [], 1)
    la vanleg = {"entry": "__main__.start", "tests": [], "functions": vanleg_fn}
    sjekk(feil, oppdaging.installer_koyrar(vanleg) == 0, "vanleg test: ingen køyrar")
    sjekk(feil, tekst(vanleg["entry"]) == "__main__.start", "vanleg test: entry urørd")

    // (b) Blokker i hovudmodulen blir køyrde; blokker frå importerte modular ikkje.
    la blokker_fn = {}
    blokker_fn["__main__.start"] = funksjon_def("start", [], 1)
    la blokker = {"entry": "__main__.start", "functions": blokker_fn}
    blokker["tests"] = [lag_testblokk("a", "__main__"), lag_testblokk("frå modul", "std.anna"), lag_testblokk("b", "__main__")]
    sjekk(feil, oppdaging.installer_koyrar(blokker) == 2, "blokker: 2 testar i hovudmodulen")
    sjekk(feil, tekst(blokker["entry"]) == "__main__.__nc_testkoyrar__", "blokker: entry er køyraren")
    sjekk(feil, finnes_nøkkel(blokker["functions"], "__main__.__nc_testblokk_0__"), "blokker: blokk 0 er funksjon")
    sjekk(feil, finnes_nøkkel(blokker["functions"], "__main__.__nc_testblokk_1__"), "blokker: blokk 1 er funksjon")
    sjekk(feil, ikkje finnes_nøkkel(blokker["functions"], "__main__.__nc_testblokk_2__"), "blokker: importert blokk ikkje med")
    sjekk(feil, finnes_nøkkel(blokker["functions"], "__main__.start"), "blokker: start() finst framleis")
    la koyrar = blokker["functions"]["__main__.__nc_testkoyrar__"]
    la kode = koyrar["code"]
    la kallar_start = usann
    la i: heiltall = 0
    mens i < lengde(kode) {
        la ins = kode[i]
        hvis tekst(ins[0]) == "CALL" og tekst(ins[1]) == "__main__.start" { kallar_start = sann }
        i = i + 1
    }
    sjekk(feil, kallar_start, "blokker: køyraren kallar start()")

    // (c) test_*-funksjonar utan start(): berre toppnivå, utan parametrar, i kjeldeorden.
    la fn_fn = {}
    fn_fn["__main__.test_seinare"] = funksjon_def("test_seinare", [], 9)
    fn_fn["__main__.test_fyrst"] = funksjon_def("test_fyrst", [], 3)
    fn_fn["__main__.test_med_param"] = funksjon_def("test_med_param", ["x"], 5)
    fn_fn["__main__.hjelp"] = funksjon_def("hjelp", [], 1)
    la fn = {"entry": "__main__.start", "tests": [], "functions": fn_fn}
    sjekk(feil, oppdaging.installer_koyrar(fn) == 2, "test_*: 2 funksjonar oppdaga")
    la rekkjefølgje = oppdaging.testfunksjonar(fn, "__main__")
    sjekk(feil, lengde(rekkjefølgje) == 2, "test_*: to i planen")
    hvis lengde(rekkjefølgje) == 2 {
        sjekk(feil, tekst(rekkjefølgje[0]) == "__main__.test_fyrst", "test_*: kjeldeorden (fyrst)")
        sjekk(feil, tekst(rekkjefølgje[1]) == "__main__.test_seinare", "test_*: kjeldeorden (seinare)")
    }

    // (d) test_*-funksjonar MED start(): konservativt — ikkje køyrde.
    la ms_fn = {}
    ms_fn["__main__.start"] = funksjon_def("start", [], 1)
    ms_fn["__main__.test_hjelpar"] = funksjon_def("test_hjelpar", [], 5)
    la med_start = {"entry": "__main__.start", "tests": [], "functions": ms_fn}
    sjekk(feil, oppdaging.installer_koyrar(med_start) == 0, "test_* med start(): ingen køyrar")

    // (e) Ein metode som heiter start (grensesnitt/struktur) er ikkje start() for fila.
    la gs_fn = {}
    gs_fn["__main__.Motor.start"] = funksjon_def("start", ["self"], 2)
    gs_fn["__main__.test_ok"] = funksjon_def("test_ok", [], 5)
    gs_fn["__main__.test_skal_feile"] = funksjon_def("test_skal_feile", [], 9)
    la gs = {"entry": "__main__.test_ok", "tests": [], "functions": gs_fn}
    sjekk(feil, oppdaging.installer_koyrar(gs) == 2, "grensesnitt-metoden start: begge test_* køyrde")

    // (f) Oppfølgingssegment etter ein fatal feil: same plan, frå test nr. 2, utan start().
    la seg_fn = {}
    seg_fn["__main__.start"] = funksjon_def("start", [], 1)
    la seg_ncb = {"entry": "__main__.start", "functions": seg_fn}
    seg_ncb["tests"] = [lag_testblokk("a", "__main__"), lag_testblokk("b", "__main__"), lag_testblokk("c", "__main__")]
    la plan = oppdaging.installer_koyrar_segment(seg_ncb, 2, usann)
    sjekk(feil, lengde(plan) == 3, "segment: heile planen (3) blir returnert")
    hvis lengde(plan) == 3 { sjekk(feil, tekst(plan[1]) == "b", "segment: plan i kjeldeorden") }
    la seg_kode = seg_ncb["functions"]["__main__.__nc_testkoyrar__"]["code"]
    la kallar_start2 = usann
    la merke: liste_tekst = []
    i = 0
    mens i < lengde(seg_kode) {
        la ins = seg_kode[i]
        hvis tekst(ins[0]) == "CALL" og tekst(ins[1]) == "__main__.start" { kallar_start2 = sann }
        hvis tekst(ins[0]) == "PUSH_CONST" og builtin.type(ins[1]) == "tekst" og builtin.starts_with(tekst(ins[1]), "[nc-test] @") {
            legg_til(merke, tekst(ins[1]))
        }
        i = i + 1
    }
    sjekk(feil, ikkje kallar_start2, "segment: start() blir ikkje køyrd på nytt")
    sjekk(feil, lengde(merke) == 1, "segment: berre test nr. 2 (eitt framdriftsmerke)")
    hvis lengde(merke) == 1 { sjekk(feil, tekst(merke[0]) == "[nc-test] @2\n", "segment: merket er @2") }
    returner 0
}

funksjon sjekk_segmenttolking(feil: liste_tekst) -> heiltall {
    la plan: liste_tekst = ["a", "b", "c"]
    // Fatal feil midt i test b: b blir FEIL med feillinja, neste segment frå c.
    la s1 = oppdaging.tolk_segment("[nc-test] @0\n[nc-test] OK: a\n[nc-test] @1\nnoko utskrift\n", "1",
                                   "ERROR: Ukjent variabel: x", plan)
    sjekk(feil, ikkje s1["ferdig"], "segment: krasj er ikkje ferdig")
    sjekk(feil, s1["neste"] == 2, "segment: krasj i b → neste er 2")
    la r1 = s1["rapport"]
    sjekk(feil, lengde(r1) == 2, "segment: krasj gjev to rapportlinjer")
    hvis lengde(r1) == 2 {
        sjekk(feil, tekst(r1[0]) == "OK: a", "segment: OK-linja før krasjet")
        sjekk(feil, tekst(r1[1]) == "FEIL: b — ERROR: Ukjent variabel: x", "segment: krasja test blir FEIL")
    }
    // Fullført segment: oppsummeringa er med, men ikkje i rapporten.
    la s2 = oppdaging.tolk_segment("[nc-test] @2\n[nc-test] OK: c\n[nc-test] 1/1 bestått\n", "0", "", plan)
    sjekk(feil, s2["ferdig"], "segment: oppsummering → ferdig")
    sjekk(feil, s2["neste"] == 3, "segment: ferdig → neste er lengda av planen")
    sjekk(feil, lengde(s2["rapport"]) == 1, "segment: oppsummeringa er ikkje i rapporten")
    // start() avslutta med exit 0 (grønt før F38): notert, testane frå 0 i ny prosess.
    la s3 = oppdaging.tolk_segment("[nc-test] @start\nfør exit\n", "0", "", plan)
    sjekk(feil, s3["neste"] == 0, "segment: start() exit 0 → neste er 0")
    sjekk(feil, ikkje inneheld_prefiks(s3["rapport"], "FEIL: "), "segment: start() exit 0 er ikkje FEIL")
    // start() døydde med feilkode: FEIL på start(), testane køyrer likevel.
    la s4 = oppdaging.tolk_segment("[nc-test] @start\n", "3", "", plan)
    sjekk(feil, s4["neste"] == 0 og inneheld_prefiks(s4["rapport"], "FEIL: start() — "), "segment: start() exit 3 er FEIL")
    // Tidsavbrot: FEIL, og ikkje køyr vidare.
    la s5 = oppdaging.tolk_segment("[nc-test] @0\n", "124", "", plan)
    sjekk(feil, s5["neste"] == -1 og inneheld_prefiks(s5["rapport"], "FEIL: a — tidsavbrot"), "segment: tidsavbrot stoppar")
    // Prosessen døydde før køyraren starta (t.d. modul-init): FEIL, ikkje køyr vidare.
    la s6 = oppdaging.tolk_segment("", "1", "ERROR: modul-init braka", plan)
    sjekk(feil, s6["neste"] == -1 og inneheld_prefiks(s6["rapport"], "FEIL: testkøyraren starta ikkje"), "segment: ingen merke → stopp")
    // Ein test som heiter «3/4 bestått» er ikkje ei oppsummering.
    sjekk(feil, oppdaging.oppsummering(["OK: 3/4 bestått", "@1"])[1] == -1, "oppsummering: OK-linje/merke tel ikkje")
    returner 0
}

funksjon inneheld_prefiks(linjer, prefiks: tekst) -> bool {
    la i: heiltall = 0
    mens i < lengde(linjer) {
        hvis builtin.starts_with(tekst(linjer[i]), prefiks) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon sjekk_rapporttolking(feil: liste_tekst) -> heiltall {
    la ut = "start\n[nc-test] OK: a\n[nc-test] FEIL: b — assert_eq feilet: 4 != 5\n[nc-test] 1/2 bestått\n[vm] entry returned\n"
    la linjer = oppdaging.rapportlinjer(ut)
    sjekk(feil, lengde(linjer) == 3, "rapport: tre linjer")
    hvis lengde(linjer) == 3 {
        sjekk(feil, tekst(linjer[1]) == "FEIL: b — assert_eq feilet: 4 != 5", "rapport: FEIL-linja")
    }
    la oppsum = oppdaging.oppsummering(linjer)
    sjekk(feil, oppsum[0] == 1 og oppsum[1] == 2, "rapport: oppsummering 1/2")
    // Escapa linjeskift (prosess-ABI-en på somme vertar).
    la esc = oppdaging.rapportlinjer("[nc-test] OK: a\\n[nc-test] 1/1 bestått\\n")
    sjekk(feil, lengde(esc) == 2, "rapport: escapa linjeskift gjev to linjer")
    hvis lengde(esc) == 2 { sjekk(feil, tekst(esc[0]) == "OK: a", "rapport: escapa OK-linje") }
    la ingen = oppdaging.oppsummering(oppdaging.rapportlinjer("[nc-test] OK: a\n"))
    sjekk(feil, ingen[1] == -1, "rapport: manglande oppsummering blir -1")
    returner 0
}

// ── Del 2: `bin/nc test` som underprosess ───────────────────────────────────────

funksjon nc_test(root: tekst, filer: liste_tekst) {
    la liste = ""
    la i: heiltall = 0
    mens i < lengde(filer) {
        liste = liste + root + "/tests/fixtures/nc_test/" + tekst(filer[i]) + "\n"
        i = i + 1
    }
    // Nullstill alt ein testshard kan ha arva (einskildfil, shard, lane-filter, framgang),
    // so barnet køyrer nøyaktig fixture-lista.
    la miljø = {
        "NORSCODE_ROOT": root,
        "NC_NATIVE": root + "/dist/norscode_native",
        "NC_TEST_FILE": "",
        "NC_TEST_FILES": liste,
        "NC_TEST_LIST_FILE": "",
        "NC_TEST_BERRE_UTSETTE": "",
        "NC_TEST_SHARD": "",
        "NC_TEST_SHARDS": "",
        "NC_TEST_ALL": "1",
        "NC_SLOW_TESTS": "",
        "NC_TEST_TMPDIR": "",
        "NC_TEST_PROGRESS_FILE": "",
        "NC_VERBOSE": "",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write,thread.spawn",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    returner prosess.køyr(root + "/bin/nc", ["test"], root, miljø, 600000)
}

funksjon exit_kode(res) -> heiltall {
    prøv { returner heltall_fra_tekst(tekst(res["exit_code"])) } fang (e) { returner -1 }
    returner -1
}

funksjon sjekk_underprosess(feil: liste_tekst, root: tekst) -> heiltall {
    // (a) Blanda: to feilande filer med test-testar, éi grøn med blokker, éi med
    //     test_*-hjelparar under start(), éi der start() avsluttar før blokkene, éi med
    //     fatale (ufangbare) feil i blokker, og éi med ein grensesnitt-metode som heiter start.
    la res = nc_test(root, ["testblokker.no", "testfunksjonar_utan_start.no", "testblokker_gronne.no",
                            "testfunksjonar_med_start.no", "start_avsluttar.no", "fatal_i_blokk.no",
                            "grensesnitt_start.no"])
    la ut = tekst(res["stdout"]) + "\n" + tekst(res["stderr"])
    sjekk(feil, exit_kode(res) != 0, "blanda: exit-koden skal vere ≠ 0 (var " + tekst(exit_kode(res)) + ")")
    sjekk(feil, inneheld(ut, "OK: dobbel gir rett svar"), "blanda: test-blokk OK rapportert")
    sjekk(feil, inneheld(ut, "FEIL: denne skal feile — assert_eq feilet: 4 != 5"),
          "blanda: test-blokk FEIL med assert-melding")
    sjekk(feil, inneheld(ut, "OK: test_ok"), "blanda: test_ok rapportert")
    sjekk(feil, inneheld(ut, "FEIL: test_feil — assert_eq feilet: 1 != 2"), "blanda: test_feil med assert-melding")
    sjekk(feil, inneheld(ut, "OK: les modulglobal"), "blanda: modulglobal lesen frå test-blokk")
    sjekk(feil, inneheld(ut, "OK testblokker_gronne"), "blanda: grøn blokk-fil er grøn")
    sjekk(feil, ikkje inneheld(ut, "test_ikkje_sjolvstendig"), "blanda: test_* under start() ikkje køyrd")
    sjekk(feil, ikkje inneheld(ut, "FEIL testfunksjonar_med_start"), "blanda: fil med start() og test_*-hjelparar grøn")
    // start() → builtin.exit(0): notert, og blokka køyrer likevel (og feilar).
    sjekk(feil, inneheld(ut, "FEIL start_avsluttar"), "blanda: start() som avsluttar før blokkene er raud")
    sjekk(feil, inneheld(ut, "start() avslutta prosessen (exit 0)"), "blanda: exit frå start() notert")
    sjekk(feil, inneheld(ut, "FEIL: blokk etter exit — assert_eq feilet: 1 != 2"),
          "blanda: blokka etter exit i start() køyrd i ny prosess")
    // Fatale feil: kvar blir FEIL på sin test, og testen etter køyrer framleis.
    sjekk(feil, inneheld(ut, "FEIL fatal_i_blokk"), "blanda: fil med fatale feil er raud")
    sjekk(feil, inneheld(ut, "FEIL: ukjent variabel — ERROR: Ukjent variabel: finst_ikkje_nokon_stad"),
          "blanda: ufangbar VM-feil blir FEIL på testen med feillinja")
    sjekk(feil, inneheld(ut, "FEIL: avsluttar prosessen — prosessen avslutta (exit 0)"),
          "blanda: builtin.exit(0) i ein test er FEIL")
    sjekk(feil, inneheld(ut, "OK: etter fatale feil"), "blanda: testen etter dei fatale feila køyrd")
    // Gransking F38: grensesnitt-metoden start gav falsk grønt (førefilteret hoppa over fila).
    sjekk(feil, inneheld(ut, "FEIL grensesnitt_start"), "blanda: grensesnitt-metoden start er ikkje start()")
    sjekk(feil, inneheld(ut, "FEIL: test_skal_feile — assert_eq feilet: 1 != 2"),
          "blanda: test_* ved sida av grensesnitt-metoden start køyrd")
    sjekk(feil, inneheld(ut, "Test-blokker/test_*-funksjonar: 7/13 bestått"), "blanda: sum 7/13 over filene")
    sjekk(feil, inneheld(ut, "FEIL: Testane feilet (5 av 7)"), "blanda: 5 av 7 filer raude")
    sjekk(feil, inneheld(ut, "Totalt:   7"), "blanda: fil-totalen er uendra (7)")
    hvis lengde(feil) > 0 {
        skriv("--- utskrift frå nc test (blanda) ---\n")
        prosess.skriv_resultat(res)
    }

    // (b) Berre grøne filer: exit 0 og same OK-format som CI les.
    la før = lengde(feil)
    la gronn = nc_test(root, ["testblokker_gronne.no", "testfunksjonar_med_start.no"])
    la gut = tekst(gronn["stdout"]) + "\n" + tekst(gronn["stderr"])
    sjekk(feil, exit_kode(gronn) == 0, "grøn: exit-koden skal vere 0 (var " + tekst(exit_kode(gronn)) + ")")
    sjekk(feil, inneheld(gut, "OK: Alle testar bestått (2/2)"), "grøn: OK-linja CI les")
    sjekk(feil, inneheld(gut, "Test-blokker/test_*-funksjonar: 2/2 bestått"), "grøn: sum 2/2")
    hvis lengde(feil) > før {
        skriv("--- utskrift frå nc test (grøn) ---\n")
        prosess.skriv_resultat(gronn)
    }
    returner 0
}

funksjon start() -> heiltall {
    la feil: liste_tekst = []
    sjekk_førefilter(feil)
    sjekk_installasjon(feil)
    sjekk_rapporttolking(feil)
    sjekk_segmenttolking(feil)
    sjekk_underprosess(feil, repo_root())
    hvis lengde(feil) > 0 {
        skriv("test_nc_test_oppdaging: " + tekst_fra_heltall(lengde(feil)) + " feil\n")
        returner 1
    }
    skriv("test_nc_test_oppdaging OK\n")
    returner 0
}
