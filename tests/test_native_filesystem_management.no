bruk std.runtime_filesystem som fs

funksjon start() -> heiltall {
    fs.native_slett("build", "runtime-fs-copy.txt")
    fs.native_slett("build", "runtime-fs-moved.txt")

    la kjelde = fs.opne_native("build", "runtime-fs-copy.txt", "write")
    assert(kjelde["status"] == "open")
    assert(fs.native_skriv(kjelde, "kopier-flytt")["status"] == "ok")
    assert(fs.native_lukk(kjelde)["status"] == "closed")

    la kopiert = fs.native_kopier_fil("build", "runtime-fs-copy.txt", "runtime-fs-copied.txt")
    assert(kopiert["status"] == "copied")
    assert(kopiert["value"] == "12")

    la flytta = fs.native_flytt_fil("build", "runtime-fs-copied.txt", "runtime-fs-moved.txt")
    assert(flytta["status"] == "moved")
    assert(fs.opne_native("build", "runtime-fs-copied.txt", "read")["status"] == "feil")

    la les = fs.opne_native("build", "runtime-fs-moved.txt", "read")
    assert(les["status"] == "open")
    assert(fs.native_les(les, 64)["data"] == "kopier-flytt")
    fs.native_lukk(les)

    assert(fs.native_slett("build", "runtime-fs-copy.txt")["status"] == "deleted")
    assert(fs.native_slett("build", "runtime-fs-moved.txt")["status"] == "deleted")

    la temp = fs.native_tempområde("build", "runtime-fs-temp-")
    assert(temp["status"] == "created")
    assert(fs.native_er_katalog("build", temp["relative"]))
    la rmdir = fs.native_slett_mappe("build", temp["relative"])
    assert(rmdir["status"] == "deleted" eller rmdir["status"] == "feil")

    skriv("test_native_filesystem_management OK")
    returner 0
}
