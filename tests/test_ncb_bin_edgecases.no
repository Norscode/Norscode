// Kant-tilfelle for det binære NCB-codec-et (ncb_bin): tomme kontainerar, nøsta
// tomme, fleir-byte varintar, negative (zigzag), djup nøsting, stor kart med
// unicode-nøklar, og vanskelege strengar. Hermetisk, rein VM.

bruk selfhost.ncb_bin som bin

funksjon rt(v) { returner bin.bin_decode(bin.bin_encode(v)) }
funksjon eq(a, b) -> boolsk { returner builtin.json_skriv(a) == builtin.json_skriv(b) }

funksjon start() -> heiltall {
    hvis ikkje eq(rt([]), []) { returner 1 }
    hvis ikkje eq(rt({}), {}) { returner 2 }
    hvis ikkje eq(rt([[], {}, [[]]]), [[], {}, [[]]]) { returner 3 }

    // fleir-byte varintar: kryssar 7/14/21-bit-grensene
    la big = [0, 127, 128, 16383, 16384, 2097151, 2097152, 1000000000]
    hvis ikkje eq(rt(big), big) { returner 4 }

    // negative (zigzag)
    la neg = [-1, -127, -128, -16384, -1000000000]
    hvis ikkje eq(rt(neg), neg) { returner 5 }

    // djup nøsting
    la deep = [1]
    la k = 0
    mens k < 50 { deep = [deep] k = k + 1 }
    hvis ikkje eq(rt(deep), deep) { returner 6 }

    // stor kart, unicode-nøklar, negative verdiar
    la m = {}
    la i = 0
    mens i < 200 { m["nøkkel_æøå_" + tekst(i)] = i * 3 - 7 i = i + 1 }
    hvis ikkje eq(rt(m), m) { returner 7 }

    // strengar: tom, unicode, hermetegn/backslash, kontroll, emoji
    la strs = ["", "æøå", "a\"b\\c", "line1\nline2\ttab", "😀emoji"]
    hvis ikkje eq(rt(strs), strs) { returner 8 }

    // bool
    hvis ikkje eq(rt([sann, usann]), [sann, usann]) { returner 9 }

    skriv("test_ncb_bin_edgecases: OK\n")
    returner 42
}
