// F39: `nc lint` køyrer typesjekk (selfhost/compiler/typecheck.no) og AST-reglar
// (ubrukt variabel, re-deklarasjon, uoppnåeleg kode) via selfhost/linter_kjerne.no.
// Testen køyrer `bin/nc lint` som underprosess på fixturane i tests/fixtures/lint_*.no
// og krev regelnamn, posisjonar og exit-kode (1 berre ved error-nivå).
bruk tools.process_runner som prosess

funksjon repo_root() -> tekst {
    prøv {
        la root = miljo_hent("NORSCODE_ROOT")
        hvis root != "" { returner root }
    } fang (e) {}
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon lint(root: tekst, fil: tekst, flagg: tekst) {
    la argv: liste_tekst = ["lint", fil]
    hvis flagg != "" { legg_til(argv, flagg) }
    returner prosess.køyr(root + "/bin/nc", argv, root, {}, 120000)
}

funksjon utdata(res) -> tekst {
    returner tekst(res["stdout"]) + tekst(res["stderr"])
}

funksjon krev(res, bit: tekst, namn: tekst) -> heiltall {
    hvis builtin.contains(utdata(res), bit) { returner 0 }
    skriv("FEIL " + namn + ": manglar «" + bit + "» i utdata:\n" + utdata(res) + "\n")
    returner 1
}

funksjon krev_ikkje(res, bit: tekst, namn: tekst) -> heiltall {
    hvis ikkje builtin.contains(utdata(res), bit) { returner 0 }
    skriv("FEIL " + namn + ": uventa «" + bit + "» i utdata:\n" + utdata(res) + "\n")
    returner 1
}

funksjon krev_exit(res, kode: heiltall, namn: tekst) -> heiltall {
    la faktisk = heltall_fra_tekst(tekst(res["exit_code"]))
    hvis tekst(res["status"]) == "ferdig" og faktisk == kode { returner 0 }
    skriv("FEIL " + namn + ": venta exit " + tekst(kode) + ", fekk status=" + tekst(res["status"]) +
          " exit=" + tekst(res["exit_code"]) + "\n" + utdata(res) + "\n")
    returner 1
}

funksjon start() -> heiltall {
    la root = repo_root()
    la feil = 0

    // Typefeil er error-nivå: exit 1, alle seks med posisjon.
    la r1 = lint(root, "tests/fixtures/lint_typefeil.no", "")
    feil = feil + krev_exit(r1, 1, "typefeil exit")
    feil = feil + krev(r1, "error type-error: Typefeil 7:20 - argument 1 til tar_tal() er tekst, venta tal", "argumenttype")
    feil = feil + krev(r1, "Typefeil 8:5 - la c: heltall får tekst", "la-type")
    feil = feil + krev(r1, "Typefeil 13:5 - returnerer tekst, funksjonen er deklarert tal", "returtype")
    // `tekst eller tekst` har operandtypen tekst (ikkje bool).
    feil = feil + krev(r1, "Typefeil 16:5 - returnerer tekst, funksjonen er deklarert tal", "eller-operandtype")
    // Same typa `la w: tekst` i begge greiner / éin utypa `la` i ei grein:
    // typen er kjend, så fleirdeklarasjons-regelen skal ikkje skjule feilen.
    feil = feil + krev(r1, "Typefeil 25:22 - argument 1 til tar_tal() er tekst, venta tal", "grein med same type")
    feil = feil + krev(r1, "Typefeil 32:22 - argument 1 til tar_tal() er tekst, venta tal", "éin la i grein")
    feil = feil + krev(r1, "(6 funn: 6 feil", "tal på typefeil")

    // AST-reglar er åtvaringar: exit 0 (òg med --check).
    la r2 = lint(root, "tests/fixtures/lint_ast_reglar.no", "--check")
    feil = feil + krev_exit(r2, 0, "ast-reglar exit")
    feil = feil + krev(r2, "warning unused-variable: Ubrukt variabel: ikkje_brukt (linje 4, kolonne 5)", "ubrukt variabel")
    feil = feil + krev(r2, "warning redeclaration: Re-deklarasjon av x i same scope", "re-deklarasjon")
    feil = feil + krev(r2, "(linje 9, kolonne 5)", "re-deklarasjon posisjon")
    feil = feil + krev(r2, "warning unreachable-code: ", "uoppnåeleg kode")
    feil = feil + krev(r2, "(linje 14, kolonne 5)", "uoppnåeleg posisjon")
    feil = feil + krev(r2, "warning type-change: Typeendring 18:5", "typeendring")
    // `la` er funksjonsskopa: indre `la y` / nøsta `for i` skriv over den ytre
    // variabelen (åtvaring), men y er lesen etter blokka og er ikkje ubrukt.
    feil = feil + krev(r2, "Re-deklarasjon av y i indre blokk: la er funksjonsskopa, så dette skriv over y frå linje 29 (linje 31, kolonne 9)", "indre re-deklarasjon")
    feil = feil + krev(r2, "Re-deklarasjon av i i indre blokk: la er funksjonsskopa, så dette skriv over i frå linje 37 (linje 38, kolonne 9)", "nøsta for-variabel")
    feil = feil + krev_ikkje(r2, "Ubrukt variabel: y", "y lesen etter blokka")
    feil = feil + krev(r2, "(6 funn: 0 feil, 6 åtvaringar)", "tal på AST-funn")
    feil = feil + krev_ikkje(r2, "_med_vilje", "understrek-namn")
    feil = feil + krev_ikkje(r2, "Ubrukt variabel: ignorert", "ignorert-namn")
    feil = feil + krev_ikkje(r2, "error ", "ingen feil-nivå")

    // Vanleg kode (samanlikningar i boolske funksjonar, varargs, lambda,
    // prøv/fang, for-løkke, `x eller ""`-standardverdiar, variablar lesne etter
    // blokka dei er deklarerte i, `la v` i søskenblokker med ulik type) skal
    // ikkje gje funn.
    la r3 = lint(root, "tests/fixtures/lint_rein.no", "")
    feil = feil + krev_exit(r3, 0, "rein exit")
    feil = feil + krev(r3, "(0 funn)", "rein utan funn")

    hvis feil > 0 {
        skriv("test_lint_typesjekk FEIL (" + tekst(feil) + ")\n")
        returner 1
    }
    skriv("test_lint_typesjekk OK\n")
    returner 0
}
