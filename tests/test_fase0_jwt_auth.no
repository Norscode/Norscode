// Fase 0.11-regresjon: std/jwt.no (HS256), std/httpauth.no (HTTPBasic + API-nøkkel,
// konstant tid) og std/signert_okt.no (signert cookie-økt med ekte HMAC-SHA256).
// Nye modular → ingen konflikt. EdDSA/ES256 blir dekt av test_fase0_jwt_asym.no
// (haldne utanfor denne raske testen fordi dei reine-VM-primitiva er tunge).

bruk std.jwt som jwt
bruk std.httpauth som httpauth
bruk std.signert_okt som okt
bruk std.web som web
bruk std.base64 som base64

funksjon start() -> heltall {
    // ── JWT HS256 ──
    la payload = "{\"sub\":\"ada\",\"iss\":\"min-id\",\"aud\":\"min-app\",\"exp\":1999999999,\"nbf\":1}"
    la t = jwt.sign_hs256(payload, "hemmeleg")
    // Kanonisk HS256-header
    assert(builtin.starts_with(t, "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9."))
    assert_eq(jwt.header_alg(t), "HS256")
    assert_eq(jwt.verify_hs256(t, "hemmeleg"), payload)

    // Feil hemmeleg → JwtFeil
    la bad: boolsk = usann
    prøv { jwt.verify_hs256(t, "feil") } fang (e) { bad = sann assert(builtin.starts_with(tekst(e), "JwtFeil")) }
    assert(bad)

    // Alg-forvirring: eit token signert HS256 blir avvist når ein krev EdDSA-header
    // (verify_hs256 krev alg==HS256; ES/Ed-verify krev si eiga). Her: manipulert alg.
    assert(jwt.valider_claims(payload, "min-id", "min-app"))

    // exp passert → JwtFeil
    la utlopt = jwt.sign_hs256("{\"exp\":1}", "h")
    la exp_feil: boolsk = usann
    prøv { jwt.verify_hs256_claims(utlopt, "h", "", "") } fang (e) { exp_feil = sann }
    assert(exp_feil)

    // nbf i framtida → JwtFeil
    la nbf_feil: boolsk = usann
    prøv { jwt.valider_claims("{\"nbf\":1999999999}", "", "") } fang (e) { nbf_feil = sann }
    assert(nbf_feil)

    // feil iss / aud → JwtFeil
    la iss_feil: boolsk = usann
    prøv { jwt.valider_claims(payload, "annan", "") } fang (e) { iss_feil = sann }
    assert(iss_feil)
    la aud_feil: boolsk = usann
    prøv { jwt.valider_claims(payload, "", "annan") } fang (e) { aud_feil = sann }
    assert(aud_feil)

    // aud som array
    assert(jwt.valider_claims("{\"aud\":[\"a\",\"min-app\",\"b\"]}", "", "min-app"))

    // ── HTTP Basic (konstant tid) ──
    la hdr: ordbok_tekst = {}
    hdr["authorization"] = "Basic " + base64.kod("ada:l0sen")
    la bctx = web.request_context("get", "/x", {}, hdr, "")
    assert(httpauth.verify_basic(bctx, "ada", "l0sen"))
    assert(ikkje httpauth.verify_basic(bctx, "ada", "gal"))
    assert(ikkje httpauth.verify_basic(bctx, "eve", "l0sen"))
    assert_eq(web.response_status(httpauth.basic_utfordring("R")), 401)
    // utan Authorization → ingen credentials
    assert(ikkje httpauth.verify_basic(web.request_context("get", "/x", {}, {}, ""), "ada", "l0sen"))

    // ── API-nøkkel (konstant tid, heile settet) ──
    la h2: ordbok_tekst = {}
    h2["x-api-key"] = "k2"
    la kctx = web.request_context("get", "/x", {}, h2, "")
    assert(httpauth.verify_api_key(kctx, ["k1", "k2", "k3"], "x-api-key"))
    assert(ikkje httpauth.verify_api_key(kctx, ["k1", "k3"], "x-api-key"))
    // tom nøkkel → aldri gyldig
    assert(ikkje httpauth.verify_api_key(web.request_context("get", "/x", {}, {}, ""), ["k1"], "x-api-key"))

    // ── Signert cookie-økt (ekte HMAC-SHA256) ──
    la data: ordbok_tekst = {}
    data["bruker"] = "ada"
    data["rolle"] = "admin"
    la c = okt.signer_okt(data, "HEMMELEG", 3600)
    la lest = okt.les_okt(c, "HEMMELEG")
    assert_eq(okt.hent(lest, "bruker"), "ada")
    assert_eq(okt.hent(lest, "rolle"), "admin")
    // signatur er full HMAC-SHA256 (64 hex-teikn)
    la dot = builtin.index_of(c, ".")
    assert_eq(lengde(builtin.slice(c, dot + 1, lengde(c))), 64)
    // tukling → OktFeil
    la tukla = builtin.slice(c, 0, lengde(c) - 1) + "X"
    la tf: boolsk = usann
    prøv { okt.les_okt(tukla, "HEMMELEG") } fang (e) { tf = sann assert(builtin.starts_with(tekst(e), "OktFeil")) }
    assert(tf)
    // feil hemmeleg → ugyldig
    assert(ikkje okt.gyldig(c, "ANNA"))
    assert(okt.gyldig(c, "HEMMELEG"))

    skriv("test_fase0_jwt_auth OK")
    returner 0
}
