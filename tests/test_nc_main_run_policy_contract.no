bruk std.tekst som t

// Flytta frå test_splice_native_argv_dispatch_contract.no (sletta saman med C-æra-verktøyet
// tools/maint/splice_native_argv_dispatch.no i F0.3): nc_main eig run-policyen for barn.
funksjon start() -> heiltall {
    la main = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(main, "funksjon nc_run_policy() -> heiltall"))
    assert(t.inneholder(main, "NORSCODE_VM_TARGET_CAPABILITIES"))
    assert(t.inneholder(main, "NORSCODE_VM_TARGET_DISK_ROOT"))
    assert(t.inneholder(main, "nc_run_policy()"))
    skriv("test_nc_main_run_policy_contract OK")
    returner 0
}
