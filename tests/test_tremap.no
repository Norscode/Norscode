# Test for std.tremap (sortert kart, AVL-tre med komparator).
# Sjekkar gjev eksplisitte samanlikningar (ikkje assert) slik at testen òg
# feilar i native AOT, der assert er no-op.
bruk std.tremap som tm

funksjon _lj(l) -> tekst {
    la s = ""
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { s = s + "," }
        s = s + tekst(l[i])
        i = i + 1
    }
    returner s
}

funksjon _vis(v) -> tekst {
    hvis builtin.type(v) == "ingenting" { returner "<ingenting>" }
    returner tekst(v)
}

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

funksjon _etter_lengd(a, b) -> heiltall {
    la d = lengde(a) - lengde(b)
    hvis d != 0 { returner d }
    returner tm.naturleg(a, b)
}

funksjon _tel_par(akk: ordbok, k, v) {
    akk["s"] = akk["s"] + tekst(k) + ":" + tekst(v) + ";"
}

funksjon _tomt_tre(res: ordbok) {
    la t = tm.ny()
    _sjekk(res, "tom storleik", tekst(tm.storleik(t)), "0")
    _sjekk(res, "tom er_tom", tekst(tm.er_tom(t)), "sann")
    _sjekk(res, "tom hent", _vis(tm.hent(t, 1)), "<ingenting>")
    _sjekk(res, "tom hent_eller", tekst(tm.hent_eller(t, 1, "std")), "std")
    _sjekk(res, "tom finnes", tekst(tm.finnes(t, 1)), "usann")
    _sjekk(res, "tom fjern", tekst(tm.fjern(t, 1)), "usann")
    _sjekk(res, "tom første", _vis(tm.første(t)), "<ingenting>")
    _sjekk(res, "tom siste", _vis(tm.siste(t)), "<ingenting>")
    _sjekk(res, "tom ta_første", _vis(tm.ta_første(t)), "<ingenting>")
    _sjekk(res, "tom golv", _vis(tm.golv(t, 5)), "<ingenting>")
    _sjekk(res, "tom tak", _vis(tm.tak(t, 5)), "<ingenting>")
    _sjekk(res, "tom nøklar", _lj(tm.nøklar(t)), "")
    _sjekk(res, "tom område", _lj(tm.område(t, 0, 10)), "")
    _sjekk(res, "tom til_tekst", tm.til_tekst(t), "{}")
    _sjekk(res, "tom invariant", tm.sjekk_invariant(t), "")
}

funksjon _grunnleggjande(res: ordbok) {
    la t = tm.ny()
    _sjekk(res, "set ny 30", tekst(tm.set(t, 30, "tretti")), "sann")
    tm.set(t, 10, "ti")
    tm.set(t, 50, "femti")
    tm.set(t, 0, "null")
    tm.set(t, -20, "minus tjue")
    tm.set(t, 40, "førti")
    # Duplikatnøkkel: erstattar verdien, storleiken står.
    _sjekk(res, "set duplikat", tekst(tm.set(t, 30, "TRETTI")), "usann")
    _sjekk(res, "storleik", tekst(tm.storleik(t)), "6")
    _sjekk(res, "hent duplikat", tekst(tm.hent(t, 30)), "TRETTI")
    _sjekk(res, "hent 0", tekst(tm.hent(t, 0)), "null")
    _sjekk(res, "hent negativ", tekst(tm.hent(t, -20)), "minus tjue")
    _sjekk(res, "finnes 0", tekst(tm.finnes(t, 0)), "sann")
    _sjekk(res, "finnes 35", tekst(tm.finnes(t, 35)), "usann")
    _sjekk(res, "nøklar sortert", _lj(tm.nøklar(t)), "-20,0,10,30,40,50")
    _sjekk(res, "verdiar", _lj(tm.verdiar(t)), "minus tjue,null,ti,TRETTI,førti,femti")
    _sjekk(res, "synkande", _lj(tm.nøklar_synkande(t)), "50,40,30,10,0,-20")
    _sjekk(res, "første", tekst(tm.første(t)), "-20")
    _sjekk(res, "siste", tekst(tm.siste(t)), "50")
    _sjekk(res, "golv 35", _vis(tm.golv(t, 35)), "30")
    _sjekk(res, "golv 30", _vis(tm.golv(t, 30)), "30")
    _sjekk(res, "golv -21", _vis(tm.golv(t, -21)), "<ingenting>")
    _sjekk(res, "tak 35", _vis(tm.tak(t, 35)), "40")
    _sjekk(res, "tak 40", _vis(tm.tak(t, 40)), "40")
    _sjekk(res, "tak 51", _vis(tm.tak(t, 51)), "<ingenting>")
    _sjekk(res, "lågare 30", _vis(tm.lågare(t, 30)), "10")
    _sjekk(res, "lågare -20", _vis(tm.lågare(t, -20)), "<ingenting>")
    _sjekk(res, "høgare 30", _vis(tm.høgare(t, 30)), "40")
    _sjekk(res, "høgare 50", _vis(tm.høgare(t, 50)), "<ingenting>")
    _sjekk(res, "område [0,40)", _lj(tm.område(t, 0, 40)), "0,10,30")
    _sjekk(res, "område_inkl [0,40]", _lj(tm.område_inkl(t, 0, 40)), "0,10,30,40")
    _sjekk(res, "område [5,9) tomt", _lj(tm.område(t, 5, 9)), "")
    _sjekk(res, "hovud <10", _lj(tm.hovud(t, 10)), "-20,0")
    _sjekk(res, "hale >=10", _lj(tm.hale(t, 10)), "10,30,40,50")
    la akk = {"s": ""}
    tm.for_kvar(t, fun(k, v) -> _tel_par(akk, k, v))
    _sjekk(res, "for_kvar", akk["s"], "-20:minus tjue;0:null;10:ti;30:TRETTI;40:førti;50:femti;")
    _sjekk(res, "til_tekst", tm.til_tekst(t), "{-20=minus tjue, 0=null, 10=ti, 30=TRETTI, 40=førti, 50=femti}")
    la p = tm.par(t)
    _sjekk(res, "par[1]", tekst(p[1][0]) + "=" + tekst(p[1][1]), "0=null")

    # Kopi er uavhengig.
    la k = tm.kopi(t)
    tm.set(k, 99, "ny")
    tm.fjern(k, 0)
    _sjekk(res, "kopi endra", _lj(tm.nøklar(k)), "-20,10,30,40,50,99")
    _sjekk(res, "original urørt", _lj(tm.nøklar(t)), "-20,0,10,30,40,50")

    _sjekk(res, "fjern 10", tekst(tm.fjern(t, 10)), "sann")
    _sjekk(res, "fjern 10 igjen", tekst(tm.fjern(t, 10)), "usann")
    _sjekk(res, "ta_første", tekst(tm.ta_første(t)), "-20")
    _sjekk(res, "ta_siste", tekst(tm.ta_siste(t)), "50")
    _sjekk(res, "etter fjerning", _lj(tm.nøklar(t)), "0,30,40")
    _sjekk(res, "storleik etter", tekst(tm.storleik(t)), "3")
    _sjekk(res, "invariant", tm.sjekk_invariant(t), "")
    tm.tøm(t)
    _sjekk(res, "tøm", tekst(tm.storleik(t)) + "|" + _lj(tm.nøklar(t)), "0|")
    tm.set(t, 7, "sju")
    _sjekk(res, "etter tøm", tm.til_tekst(t), "{7=sju}")
}

funksjon _tekst_og_komparator(res: ordbok) {
    la t = tm.ny()
    tm.set(t, "pære", 3)
    tm.set(t, "eple", 1)
    tm.set(t, "banan", 2)
    tm.set(t, "ål", 4)
    tm.set(t, "ærfugl", 5)
    tm.set(t, "øks", 6)
    # Kodepunktorden som Java String.compareTo: å (U+E5) < æ (U+E6) < ø (U+F8).
    _sjekk(res, "tekstnøklar", _lj(tm.nøklar(t)), "banan,eple,pære,ål,ærfugl,øks")
    _sjekk(res, "tekst golv", _vis(tm.golv(t, "f")), "eple")

    la s = tm.ny_synkande()
    tm.set(s, 1, "a")
    tm.set(s, 3, "c")
    tm.set(s, 2, "b")
    _sjekk(res, "synkande tre", _lj(tm.nøklar(s)), "3,2,1")
    _sjekk(res, "synkande første", tekst(tm.første(s)), "3")
    _sjekk(res, "synkande golv(2)", _vis(tm.golv(s, 2)), "2")

    # Komparator: lengd først, så alfabetisk. "ab" og "ba" er ulike nøklar.
    la c = tm.ny_med(fun(a, b) -> _etter_lengd(a, b))
    tm.set(c, "ccc", 1)
    tm.set(c, "a", 2)
    tm.set(c, "ba", 3)
    tm.set(c, "ab", 4)
    tm.set(c, "dddd", 5)
    _sjekk(res, "komparator nøklar", _lj(tm.nøklar(c)), "a,ab,ba,ccc,dddd")
    _sjekk(res, "komparator tak", _vis(tm.tak(c, "zz")), "ccc")

    # Komparator som gjer nøklar like (berre lengd): duplikat erstattar.
    la l = tm.ny_med(fun(a, b) -> lengde(a) - lengde(b))
    tm.set(l, "xx", 1)
    _sjekk(res, "komparator-duplikat", tekst(tm.set(l, "yy", 2)), "usann")
    _sjekk(res, "komparator-duplikat verdi", tekst(tm.hent(l, "zz")) + "|" + tekst(tm.storleik(l)), "2|1")
}

# Deterministisk pseudotilfeldig test mot eit referansesett.
funksjon _tilfeldig(res: ordbok) {
    la t = tm.ny()
    la ref = {}
    la x = 12345
    la i = 0
    la brot = ""
    mens i < 400 {
        x = (x * 1103515245 + 12345) % 2147483648
        la k = (x / 65536) % 101 - 50
        la nøkkel = "k" + tekst(k)
        hvis (x / 8) % 3 == 0 {
            la var_der = har_nokkel(ref, nøkkel)
            la fjerna = tm.fjern(t, k)
            hvis var_der != fjerna { brot = "fjern " + tekst(k) + " gav " + tekst(fjerna) }
            hvis var_der { fjern_nokkel(ref, nøkkel) }
        } ellers {
            la var_ny = ikkje har_nokkel(ref, nøkkel)
            la ny_n = tm.set(t, k, k * 10)
            hvis var_ny != ny_n { brot = "set " + tekst(k) + " gav " + tekst(ny_n) }
            ref[nøkkel] = sann
        }
        hvis i % 50 == 0 {
            la inv = tm.sjekk_invariant(t)
            hvis inv != "" { brot = "invariant ved steg " + tekst(i) + ": " + inv }
        }
        i = i + 1
    }
    _sjekk(res, "tilfeldig operasjonar", brot, "")
    _sjekk(res, "tilfeldig invariant", tm.sjekk_invariant(t), "")
    # Forventa nøklar i sortert rekkjefølgje frå referansen.
    la venta = []
    la k2 = -50
    mens k2 <= 50 {
        hvis har_nokkel(ref, "k" + tekst(k2)) { legg_til(venta, k2) }
        k2 = k2 + 1
    }
    _sjekk(res, "tilfeldig nøklar", _lj(tm.nøklar(t)), _lj(venta))
    _sjekk(res, "tilfeldig storleik", tekst(tm.storleik(t)), tekst(lengde(venta)))
    la vs_ok = sann
    la j = 0
    mens j < lengde(venta) {
        hvis tm.hent(t, venta[j]) != venta[j] * 10 { vs_ok = usann }
        j = j + 1
    }
    _sjekk(res, "tilfeldig verdiar", tekst(vs_ok), "sann")

    # Stigande innsetjing (verste fall for ubalansert tre) held høgda låg.
    la s = tm.ny()
    la n = 0
    mens n < 500 {
        tm.set(s, n, n)
        n = n + 1
    }
    _sjekk(res, "stigande invariant", tm.sjekk_invariant(s), "")
    _sjekk(res, "stigande høgd <= 1.44 log2", tekst(s["h"][s["rot"]] <= 13), "sann")
    # Fjern annankvar: friliste blir gjenbrukt.
    n = 0
    mens n < 500 {
        tm.fjern(s, n)
        n = n + 2
    }
    n = 1000
    mens n < 1100 {
        tm.set(s, n, n)
        n = n + 1
    }
    _sjekk(res, "gjenbruk arena", tekst(lengde(s["k"])), "500")
    _sjekk(res, "gjenbruk storleik", tekst(tm.storleik(s)), "350")
    _sjekk(res, "gjenbruk invariant", tm.sjekk_invariant(s), "")
    _sjekk(res, "gjenbruk område", _lj(tm.område(s, 495, 1003)), "495,497,499,1000,1001,1002")
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}
    _tomt_tre(res)
    _grunnleggjande(res)
    _tekst_og_komparator(res)
    _tilfeldig(res)
    hvis res["feil"] != 0 {
        skriv("test_tremap FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_tremap OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
