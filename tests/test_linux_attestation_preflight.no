// Release-porten må avvise bortfall av den faktiske ARM64-kandidatkjeda.
bruk tools.release_preflight som preflight
bruk std.filops som filops

funksjon start() -> heiltall {
    la root = preflight.rot()
    la ci = fil_les(root + "/.github/workflows/ci.yml")
    la driver = fil_les(root + "/tools/linux_runtime_attestation.no")
    la tmp = root + "/build/linux-attestation-preflight-" + tekst(builtin.tid_ms())
    assert(filops.lag_katalogar(tmp + "/.github/workflows"))
    assert(filops.lag_katalogar(tmp + "/tools"))
    la ci_sti = tmp + "/.github/workflows/ci.yml"
    la driver_sti = tmp + "/tools/linux_runtime_attestation.no"
    fil_skriv(ci_sti, ci)
    fil_skriv(driver_sti, driver)
    assert_eq(preflight.krev_linux_runtime_attestasjon(tmp), 0)

    // Ingen grøn rapport utan ekte ARM64-runner, fersk kandidat, signatur og
    // obligatorisk samling. Kvar negativ kontroll endrar berre éin eigenskap.
    la frå = ["runner: ubuntu-24.04-arm", "source: build/arm64/nc_main_arm64",
               "subject-path: reports/linux-runtime-attestation-",
               "NORSCODE_REQUIRE_LINUX_ARM64_ATTESTATION: \"1\""]
    la erstatning = ["runner: ubuntu-24.04", "source: bootstrap/stage0/norscode-linux-arm64",
               "subject-path: reports/ubunden-",
               "NORSCODE_REQUIRE_LINUX_ARM64_ATTESTATION: \"0\""]
    la i = 0
    mens i < lengde(frå) {
        fil_skriv(ci_sti, builtin.replace(ci, frå[i], erstatning[i]))
        assert(preflight.krev_linux_runtime_attestasjon(tmp) > 0)
        i = i + 1
    }
    fil_skriv(ci_sti, ci)
    fil_skriv(driver_sti, builtin.replace(driver, "[\"core\", \"argon2id\", \"tls\"]", "[\"core\", \"tls\"]"))
    assert(preflight.krev_linux_runtime_attestasjon(tmp) > 0)
    fil_skriv(driver_sti, builtin.replace(driver, "prosess" + ".køyr(native, argument,", "prosess" + ".køyr(native, [],"))
    assert(preflight.krev_linux_runtime_attestasjon(tmp) > 0)
    fil_skriv(driver_sti, driver + "\n// NORSCODE_LINUX_ATTESTATION_REPORT_ONLY\n")
    assert(preflight.krev_linux_runtime_attestasjon(tmp) > 0)
    fil_skriv(driver_sti, driver + "\n// NORSCODE_LINUX_ATTESTATION_DIRECT\n")
    assert(preflight.krev_linux_runtime_attestasjon(tmp) > 0)
    assert(filops.slett_tre(tmp))
    skriv("test_linux_attestation_preflight OK\n")
    returner 0
}
