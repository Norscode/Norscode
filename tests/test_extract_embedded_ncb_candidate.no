// Kandidatuttrekk må bevare alle payload-byte, støtte begge NCB-trailarar og
// avvise feil utan å overskrive ei tidlegare utfil eller kandidatfila.
bruk tools.extract_embedded_ncb_candidate som uttrekk

funksjon kandidat(sti: tekst, markør: tekst, payload, storleik: heiltall) {
    builtin.fil_skriv_binær(sti, builtin.bytes_from_list([127, 69, 76, 70, 0, 255]))
    builtin.fil_append_binær(sti, payload)
    builtin.fil_append(sti, markør)
    la felt: liste_heiltall = []
    la i = 0
    mens i < 8 { legg_til(felt, (storleik >> (i * 8)) & 255) i = i + 1 }
    builtin.fil_append_binær(sti, builtin.bytes_from_list(felt))
}

funksjon start() -> heiltall {
    la inn = "build/test-extract-candidate.bin"
    la ut = "build/test-extract-candidate.ncb"
    la verdiar: liste_heiltall = []
    la i = 0
    mens i < 256 { legg_til(verdiar, i) i = i + 1 }
    la payload = builtin.bytes_from_list(verdiar)
    for markør i ["NORSCODE_NCB_V1", "NORSCODE_NCB_V2"] {
        kandidat(inn, markør, payload, lengde(payload))
        la original = builtin.fil_les_binær(inn)
        assert_eq(uttrekk.trekk_ut(inn, ut), 0)
        la lest = builtin.fil_les_binær(ut)
        assert_eq(type_av(lest), "bytes")
        assert_eq(lengde(lest), 256)
        assert(lest == payload)
        assert(builtin.fil_les_binær(inn) == original)
        assert_eq(uttrekk.trekk_ut(inn, inn), 2)
        assert(builtin.fil_les_binær(inn) == original)
    }
    la bevart = builtin.fil_les_binær(ut)
    kandidat(inn, "NORSCODE_NCB_V3", payload, lengde(payload))
    assert_eq(uttrekk.trekk_ut(inn, ut), 1)
    assert(builtin.fil_les_binær(ut) == bevart)
    for storleik i [0, 1048576, -1] {
        kandidat(inn, "NORSCODE_NCB_V2", payload, storleik)
        assert_eq(uttrekk.trekk_ut(inn, ut), 1)
        assert(builtin.fil_les_binær(ut) == bevart)
    }
    builtin.fil_skriv_binær(inn, builtin.bytes_from_list([1, 2, 3]))
    assert_eq(uttrekk.trekk_ut(inn, ut), 1)
    assert(builtin.fil_les_binær(ut) == bevart)
    assert_eq(uttrekk.trekk_ut("", ut), 2)
    assert_eq(uttrekk.trekk_ut(inn, ""), 2)
    skriv("test_extract_embedded_ncb_candidate OK\n")
    returner 0
}
