# R1 / F06: valfri namnesjekk ved kompilering (NORSCODE_STRICT_NAMN=1).
# Udefinert namn brukt som verdi, toppnivåfunksjon deklarert to gonger og
# `la x` to gonger i same blokk gjev kompileringsfeil med linje:kolonne.
# Utan flagget er kompileringa uendra. Køyrer gjennom KJELDE-kompilatoren.

bruk selfhost.kompiler som kompiler

funksjon kompiler_feil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner ""
}

funksjon start() -> heiltall {
    la udef = "funksjon start() -> heltall {\n" +
        "    hvis usann {\n" +
        "        la b = ukjend_variabel + 1\n" +
        "    }\n" +
        "    returner 0\n" +
        "}\n"
    la dupl_fn = "funksjon f(a: heltall) -> heltall { returner 1 }\n" +
        "funksjon f(a: tekst) -> tekst { returner \"to\" }\n" +
        "funksjon start() -> heltall { returner f(1) }\n"
    la dupl_la = "funksjon start() -> heltall {\n" +
        "    la x = 1\n" +
        "    la x = 2\n" +
        "    returner x\n" +
        "}\n"
    # Gyldige former som ikkje skal gje feil: modulglobal, struktur, enum,
    # importalias, gammal-stil tilordning, for-/fang-variabel, lambda-fangst,
    # destrukturering og la i kvar sin grein.
    la gyldig = "bruk std.tekst som t\n" +
        "la G = 3\n" +
        "struktur P { x }\n" +
        "enum E { A, B }\n" +
        "funksjon P.m(self) { returner self.x }\n" +
        "funksjon start() {\n" +
        "    la p = P()\n" +
        "    p.x = G\n" +
        "    x = 4\n" +
        "    for k i [1] { x = x + k }\n" +
        "    prøv { kast \"a\" } fang (e) { x = x + lengde(e) }\n" +
        "    la f = fun(y) -> y + x\n" +
        "    la [a, b] = [1, 2]\n" +
        "    hvis sann { la z = 1 } ellers { la z = 2 }\n" +
        "    returner tekst(f(1) + a + b + z + E.B) + builtin.type(p)\n" +
        "}\n"

    # Utan flagget: alle kompilerer (bakoverkompatibelt).
    miljo_sett("NORSCODE_STRICT_NAMN", "0")
    assert_eq(kompiler_feil(udef), "")
    assert_eq(kompiler_feil(dupl_fn), "")
    assert_eq(kompiler_feil(dupl_la), "")

    miljo_sett("NORSCODE_STRICT_NAMN", "1")
    la e1 = kompiler_feil(udef)
    la e2 = kompiler_feil(dupl_fn)
    la e3 = kompiler_feil(dupl_la)
    la e4 = kompiler_feil(gyldig)
    miljo_sett("NORSCODE_STRICT_NAMN", "0")
    assert(builtin.index_of(e1, "Namnefeil 3:16 - ukjent namn 'ukjend_variabel'") >= 0)
    assert(builtin.index_of(e2, "funksjonen 'f' er deklarert fleire gonger") >= 0)
    assert(builtin.index_of(e3, "Namnefeil 3:5 - 'x' er alt deklarert med la i same blokk") >= 0)
    assert_eq(e4, "")
    returner 0
}
