bruk std.openapi som openapi
bruk std.tekst som t

// Fase 0.9: dokumentasjonssida i std/openapi.no skal vere JS-fri — ingen
// ekstern/CDN-lasta JavaScript (i tråd med sjølvstende).

funksjon start() -> heltall {
    la html = openapi.docs_placeholder_html("/openapi.json")
    // Ingen script-taggar og ingen CDN-referansar.
    assert(ikkje t.inneholder(html, "<script"))
    assert(ikkje t.inneholder(html, "cdn"))
    assert(ikkje t.inneholder(html, "swagger-ui"))
    assert(ikkje t.inneholder(html, "redoc.standalone"))
    // Men ho lenkjer til det maskinlesbare skjemaet.
    assert(t.inneholder(html, "/openapi.json"))
    assert(t.inneholder(html, "Fase 1"))
    returner 0
}
