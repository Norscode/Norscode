funksjon start() -> heiltall {
    la src = fil_les("selfhost/vm.no")
    assert(builtin.contains(src, "returner builtin.pbkdf2_sha256(args[0], args[1], args[2], args[3])"))
    assert(builtin.contains(src, "returner builtin.argon2id(args[0], args[1], args[2], args[3], args[4], args[5])"))
    assert(builtin.contains(src, "returner builtin.acme_sign(args[0], args[1], args[2])"))
    assert(builtin.contains(src, "returner builtin.acme_verify(args[0], args[1], args[2], args[3])"))
    assert(builtin.contains(src, "returner builtin.dns_lookup(args[0], args[1])"))
    assert(builtin.contains(src, "returner builtin.miljo_sett(args[0], args[1])"))
    skriv("test_vm_security_builtin_forwarding OK\n")
    returner 0
}
