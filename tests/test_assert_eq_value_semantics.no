// assert_eq skal bruke same verdi-/typesemantikk som == og returnere 0 som VM-en.
funksjon avviser(a, b) -> bool {
    prøv { assert_eq(a, b) }
    fang (e) { returner builtin.starts_with(tekst(e), "assert_eq feilet:") }
    returner usann
}
funksjon start() -> heiltall {
    assert(avviser(1, sann))
    assert(avviser(sann, 1))
    assert(avviser(0, null))
    assert(avviser(null, 0))
    assert(avviser("1", 1))
    assert(avviser([1, 2], [1, 3]))
    assert(avviser(builtin.bytes_from_list([0, 255]), builtin.bytes_from_list([0, 254])))
    assert_eq([1, "blåbær", [2, 3]], [1, "blåbær", [2, 3]])
    assert_eq(builtin.bytes_from_list([0, 255, 128]), builtin.bytes_from_list([0, 255, 128]))
    assert_eq(null, null)
    assert_eq(3.5, 3.5)
    assert_eq(1, 3.5 - 2.5)
    assert(assert_eq("same", "same") == 0)
    skriv("test_assert_eq_value_semantics OK\n")
    returner 0
}
