// Fase 7a/7c: uttrykk / funksjonar / CASE / konkat i SELECT-kolonnar (beregna kolonnar).
// Golden = ekte sqlite3 3.51.0. query_rader gjev "|"-delt rad, "\n"-delt sett.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')")
    sql.exec(db, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')")

    // Aritmetikk i kolonne
    assert_eq(sql.query_rader(db, "SELECT navn, alder + 1 FROM folk WHERE id = 1"), "Ada|38")
    // Funksjonar i kolonne
    assert_eq(sql.query_rader(db, "SELECT upper(navn), lower(by) FROM folk WHERE id = 1"), "ADA|oslo")
    // Konkat i kolonne
    assert_eq(sql.query_rader(db, "SELECT navn || ' ' || by FROM folk WHERE id = 1"), "Ada Oslo")
    // Fleire beregna kolonnar + rein kolonne, over alle rader
    assert_eq(sql.query_rader(db, "SELECT navn, alder * 2, by FROM folk ORDER BY id"),
        "Ada|74|Oslo\nLinus|110|Oslo\nBjørn|58|Bergen\nAlan|82|Oslo")
    // CASE i kolonne
    assert_eq(sql.query_rader(db, "SELECT case when alder > 40 then 'gml' else 'ung' end FROM folk ORDER BY id"),
        "ung\ngml\nung\ngml")
    // Stjerne + beregna kolonne
    assert_eq(sql.query_rader(db, "SELECT *, alder + 1 FROM folk WHERE id = 1"), "1|Ada|37|Oslo|38")
    // GROUP BY med rein kolonne + aggregat (regresjon)
    assert_eq(sql.query_rader(db, "SELECT by, count(*), sum(alder) FROM folk GROUP BY by ORDER BY by"),
        "Bergen|1|29\nOslo|3|133")
    // Rein SELECT * (regresjon)
    assert_eq(sql.query_rader(db, "SELECT * FROM folk WHERE id = 1"), "1|Ada|37|Oslo")
    // query_text = første verdi i første rad
    assert_eq(sql.query_text(db, "SELECT upper(navn), by FROM folk WHERE id = 1"), "ADA")

    returner 0
}
