// Fase 7j: REAL/desimal + type-affinity + NULL-propagering. Fiksar G1 (AVG→desimal).
// Golden = ekte sqlite3 3.51.0. REAL formaterast som SQLite (15 sig. siffer, alltid ".").

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la rad = {"x": "2.5", "n": "10", "t": "hei", "tom": ""}

    // REAL-aritmetikk + heiltal-vs-real-divisjon
    assert_eq(sql.evaluer_uttrykk("7 / 2", rad), "3")        // heiltalsdivisjon
    assert_eq(sql.evaluer_uttrykk("7.0 / 2", rad), "3.5")    // real-divisjon
    assert_eq(sql.evaluer_uttrykk("2.5 + 1", rad), "3.5")
    assert_eq(sql.evaluer_uttrykk("x * 2", rad), "5.0")      // x=2.5 (real)
    assert_eq(sql.evaluer_uttrykk("n * 2", rad), "20")       // n=10 (heiltal)
    assert_eq(sql.evaluer_uttrykk("10 % 3", rad), "1")

    // NULL-propagering (aritmetikk med NULL → NULL) + divisjon med 0 → NULL
    assert_eq(sql.evaluer_uttrykk("n + NULL", rad), "")
    assert_eq(sql.evaluer_uttrykk("5 / 0", rad), "")

    // ROUND (IEEE-avrunding, alltid REAL)
    assert_eq(sql.evaluer_uttrykk("round(3.14159, 2)", rad), "3.14")
    assert_eq(sql.evaluer_uttrykk("round(2.5)", rad), "3.0")
    assert_eq(sql.evaluer_uttrykk("round(3.7)", rad), "4.0")

    // TYPEOF (affinity frå verdi-form)
    assert_eq(sql.evaluer_uttrykk("typeof(5)", rad), "integer")
    assert_eq(sql.evaluer_uttrykk("typeof(2.5)", rad), "real")
    assert_eq(sql.evaluer_uttrykk("typeof('x')", rad), "text")

    // printf %f
    assert_eq(sql.evaluer_uttrykk("printf('%.2f', 3.14159)", rad), "3.14")
    assert_eq(sql.evaluer_uttrykk("printf('%.0f', 2.5)", rad), "3")

    // Aggregat mot tabell: AVG→real (G1), SUM real vs int, MIN/MAX behald real
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE m (id INTEGER, x REAL, n INTEGER)")
    sql.exec(db, "INSERT INTO m (id, x, n) VALUES (1, 2.5, 10)")
    sql.exec(db, "INSERT INTO m (id, x, n) VALUES (2, 1.5, 20)")
    sql.exec(db, "INSERT INTO m (id, x, n) VALUES (3, 4.0, 30)")
    assert_eq(sql.query_text(db, "SELECT avg(n) FROM m"), "20.0")           // AVG alltid real
    assert_eq(sql.query_text(db, "SELECT avg(x) FROM m"), "2.66666666666667")
    assert_eq(sql.query_text(db, "SELECT sum(x) FROM m"), "8.0")            // real-sum
    assert_eq(sql.query_text(db, "SELECT sum(n) FROM m"), "60")             // int-sum
    assert_eq(sql.query_text(db, "SELECT min(x) FROM m"), "1.5")
    assert_eq(sql.query_text(db, "SELECT max(x) FROM m"), "4.0")

    returner 0
}
