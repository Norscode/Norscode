// Test for std.formater: printf/String.format-stil formatering med kjende fasitverdiar.
// Kvar sjekk tel feil sjølv (assert er no-op i AOT), og start() returnerer talet på feil.
bruk std.formater som fmt

funksjon sjekk(namn: tekst, fått: tekst, venta: tekst) -> heiltall {
    hvis fått == venta {
        returner 0
    }
    skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
    returner 1
}

funksjon f(mønster: tekst, args) -> tekst {
    returner fmt.formater(mønster, args)
}

// Forventar at formater kastar ein FormatFeil som inneheld `del`.
funksjon sjekk_feil(mønster: tekst, args, del: tekst) -> heiltall {
    la melding: tekst = ""
    la kasta: boolsk = usann
    prøv {
        la r = fmt.formater(mønster, args)
        melding = r
    } fang (e: FormatFeil) {
        kasta = sann
        melding = tekst(e)
    }
    hvis ikkje kasta {
        skriv("FEIL " + mønster + ": venta FormatFeil, fekk [" + melding + "]\n")
        returner 1
    }
    hvis builtin.starts_with(melding, "FormatFeil: ") og builtin.index_of(melding, del) >= 0 {
        returner 0
    }
    skriv("FEIL " + mønster + ": feilmelding [" + melding + "] manglar [" + del + "]\n")
    returner 1
}

funksjon test_oppgåvefasit() -> heiltall {
    returner sjekk("fasit", f("%05.1f|%-4s|%x", [3.14159, "ab", 255]), "003.1|ab  |ff")
}

funksjon test_heiltall() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("d", f("%d", [42]), "42")
    feil = feil + sjekk("i", f("%i", [7]), "7")
    feil = feil + sjekk("breidd", f("[%5d]", [42]), "[   42]")
    feil = feil + sjekk("venstre", f("[%-5d]", [42]), "[42   ]")
    feil = feil + sjekk("nullfyll neg", f("%05d", [-42]), "-0042")
    feil = feil + sjekk("pluss", f("%+d %+d", [5, -5]), "+5 -5")
    feil = feil + sjekk("mellomrom", f("[% d]", [5]), "[ 5]")
    feil = feil + sjekk("gruppe", f("%,d", [1234567]), "1,234,567")
    feil = feil + sjekk("gruppe neg", f("%,d", [-1234567]), "-1,234,567")
    feil = feil + sjekk("gruppe liten", f("%,d", [999]), "999")
    feil = feil + sjekk("parentes", f("%(d", [-5]), "(5)")
    feil = feil + sjekk("minst", f("%d", [-9223372036854775807 - 1]), "-9223372036854775808")
    feil = feil + sjekk("smal breidd", f("%2d", [12345]), "12345")
    returner feil
}

funksjon test_basar() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("x", f("%x", [255]), "ff")
    feil = feil + sjekk("X", f("%X", [255]), "FF")
    feil = feil + sjekk("#x", f("%#x", [255]), "0xff")
    feil = feil + sjekk("08X", f("%08X", [48879]), "0000BEEF")
    feil = feil + sjekk("#06x", f("%#06x", [255]), "0x00ff")
    feil = feil + sjekk("x neg", f("%x", [-1]), "ffffffffffffffff")
    feil = feil + sjekk("x minst", f("%x", [-9223372036854775807 - 1]), "8000000000000000")
    feil = feil + sjekk("x null", f("%x", [0]), "0")
    feil = feil + sjekk("o", f("%o", [8]), "10")
    feil = feil + sjekk("#o", f("%#o", [8]), "010")
    feil = feil + sjekk("o neg", f("%o", [-1]), "1777777777777777777777")
    feil = feil + sjekk("b", f("%b", [5]), "101")
    feil = feil + sjekk("08b", f("%08b", [5]), "00000101")
    feil = feil + sjekk("#b", f("%#b", [6]), "0b110")
    feil = feil + sjekk("b bool", f("%b|%B|%b", [sann, usann, null]), "sann|USANN|usann")
    feil = feil + sjekk("x breidd venstre", f("[%-6x]", [171]), "[ab    ]")
    returner feil
}

funksjon test_desimal() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk(".2f", f("%.2f", [3.14159]), "3.14")
    feil = feil + sjekk("f standard", f("%f", [1.5]), "1.500000")
    feil = feil + sjekk("halv opp .0f", f("%.0f", [2.5]), "3")
    feil = feil + sjekk("halv opp 0.125", f("%.2f", [0.125]), "0.13")
    feil = feil + sjekk("halv opp 0.25", f("%.1f", [0.25]), "0.3")
    feil = feil + sjekk("eksakt 1.005", f("%.2f", [1.005]), "1.00")
    feil = feil + sjekk("eksakt 2.675", f("%.2f", [2.675]), "2.67")
    feil = feil + sjekk("0.005", f("%.2f", [0.005]), "0.01")
    feil = feil + sjekk("breidd", f("[%10.3f]", [3.14159]), "[     3.142]")
    feil = feil + sjekk("venstre", f("[%-10.1f]", [2.25]), "[2.3       ]")
    feil = feil + sjekk("gruppe", f("%,.2f", [1234567.891]), "1,234,567.89")
    feil = feil + sjekk("pluss", f("%+.1f", [2.0]), "+2.0")
    feil = feil + sjekk("neg", f("%.3f", [-1.5]), "-1.500")
    feil = feil + sjekk("neg null", f("%.1f", [-0.0]), "-0.0")
    feil = feil + sjekk("neg nullfyll", f("%08.2f", [-3.5]), "-0003.50")
    feil = feil + sjekk("parentes", f("%(.1f", [-2.5]), "(2.5)")
    feil = feil + sjekk("heiltall som f", f("%f", [5]), "5.000000")
    feil = feil + sjekk("alt .0f", f("%#.0f", [3.0]), "3.")
    feil = feil + sjekk("stort 1e20", f("%.1f", [100000000000000000000.0]), "100000000000000000000.0")
    feil = feil + sjekk("1e23 eksakt", f("%.0f", [100000000000000000000000.0]), "99999999999999991611392")
    feil = feil + sjekk("lite", f("%.3f", [0.0000000001]), "0.000")
    feil = feil + sjekk("0.1 med 20", f("%.20f", [0.1]), "0.10000000000000000555")
    feil = feil + sjekk("avrund heil", f("%.2f", [9.999]), "10.00")
    la nan = builtin.desimal_frå_bits(9221120237041090560)
    la inf = builtin.desimal_frå_bits(9218868437227405312)
    la minf = builtin.desimal_frå_bits(-4503599627370496)
    feil = feil + sjekk("NaN", f("%f", [nan]), "NaN")
    feil = feil + sjekk("inf", f("%f|%+f", [inf, inf]), "Infinity|+Infinity")
    feil = feil + sjekk("-inf breidd", f("[%10f]", [minf]), "[ -Infinity]")
    returner feil
}

funksjon test_vitskapleg() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("e", f("%e", [12345.678]), "1.234568e+04")
    feil = feil + sjekk(".2e", f("%.2e", [0.000123]), "1.23e-04")
    feil = feil + sjekk("E", f("%E", [1.0]), "1.000000E+00")
    feil = feil + sjekk(".0e", f("%.0e", [5.0]), "5e+00")
    feil = feil + sjekk("e overlaup", f("%.2e", [9.999]), "1.00e+01")
    feil = feil + sjekk("e null", f("%e", [0.0]), "0.000000e+00")
    feil = feil + sjekk("e stor", f("%.3e", [1e100]), "1.000e+100")
    feil = feil + sjekk("e subnormal", f("%.3e", [builtin.desimal_frå_bits(1)]), "4.941e-324")
    feil = feil + sjekk("e neg", f("%.1e", [-0.5]), "-5.0e-01")
    feil = feil + sjekk("e heiltall", f("%.2e", [1500]), "1.50e+03")
    returner feil
}

funksjon test_tekst_og_teikn() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk("s", f("%s", ["hei"]), "hei")
    feil = feil + sjekk("S", f("%S", ["hei"]), "HEI")
    feil = feil + sjekk(".2s", f("%.2s", ["hallo"]), "ha")
    feil = feil + sjekk("unicode venstre", f("[%-6s]", ["æøå"]), "[æøå   ]")
    feil = feil + sjekk("unicode høgre", f("[%6s]", ["æøå"]), "[   æøå]")
    feil = feil + sjekk("unicode kutt", f("%.2s", ["æøå"]), "æø")
    feil = feil + sjekk("null", f("%s", [null]), "null")
    feil = feil + sjekk("bool", f("%s/%s", [sann, usann]), "sann/usann")
    feil = feil + sjekk("heiltall som s", f("%s", [42]), "42")
    feil = feil + sjekk("desimal som s", f("%s", [1.5]), "1.5")
    feil = feil + sjekk("c", f("%c%c", [65, "ø"]), "Aø")
    feil = feil + sjekk("c utf8", f("%c|%c|%c", [230, 8364, 128512]), "æ|€|😀")
    feil = feil + sjekk("c breidd", f("[%3c]", [66]), "[  B]")
    feil = feil + sjekk("prosent", f("100%%", []), "100%")
    feil = feil + sjekk("linjeskift", f("a%nb", []), "a\nb")
    feil = feil + sjekk("ingen spes", f("berre tekst", []), "berre tekst")
    feil = feil + sjekk("tom", f("", []), "")
    feil = feil + sjekk("indeks", f("%2$s %1$s", ["verd", "hei"]), "hei verd")
    feil = feil + sjekk("relativ", f("%s %<s %s", ["a", "b"]), "a a b")
    feil = feil + sjekk("blanda indeks", f("%2$s %s %s", ["a", "b"]), "b a b")
    feil = feil + sjekk("ikkje liste", f("<%d>", 5), "<5>")
    feil = feil + sjekk("overflødig", f("%s", ["a", "b"]), "a")
    returner feil
}

funksjon test_feil() -> heiltall {
    la feil: heiltall = 0
    feil = feil + sjekk_feil("%d %d", [1], "manglar argument 2")
    feil = feil + sjekk_feil("%s", [], "manglar argument 1")
    feil = feil + sjekk_feil("%q", [1], "ukjend konvertering")
    feil = feil + sjekk_feil("%D", [1], "ukjend konvertering")
    feil = feil + sjekk_feil("%d", ["tekst"], "krev heiltall")
    feil = feil + sjekk_feil("%x", [1.5], "krev heiltall")
    feil = feil + sjekk_feil("%f", ["x"], "krev desimaltall")
    feil = feil + sjekk_feil("%-d", [1], "manglar breidd")
    feil = feil + sjekk_feil("%-05d", [1], "kan ikkje brukast saman")
    feil = feil + sjekk_feil("%.2d", [1], "presisjon")
    feil = feil + sjekk_feil("%+x", [1], "forteiknsflagg")
    feil = feil + sjekk_feil("%05s", ["a"], "flagget '0'")
    feil = feil + sjekk_feil("abc%", [], "ufullstendig")
    feil = feil + sjekk_feil("%<s", ["a"], "førre argument")
    feil = feil + sjekk_feil("%c", ["ab"], "eitt teikn")
    returner feil
}

funksjon start() -> heiltall {
    la feil: heiltall = 0
    feil = feil + test_oppgåvefasit()
    feil = feil + test_heiltall()
    feil = feil + test_basar()
    feil = feil + test_desimal()
    feil = feil + test_vitskapleg()
    feil = feil + test_tekst_og_teikn()
    feil = feil + test_feil()
    hvis fmt.skrivf("test_formater: %d feil%n", [feil]) != 0 {
        feil = feil + 1
    }
    returner feil
}
