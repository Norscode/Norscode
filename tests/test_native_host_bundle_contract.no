funksjon start() -> heiltall {
    la src = fil_les("tools/build_native_host_bundle.no")
    assert(builtin.contains(src, "tekst(main[\"entry\"]) != \"selfhost.nc_main.start\""))
    assert(builtin.contains(src, "nc_main-modulen har feil entry"))
    assert(builtin.contains(src, "build/l5/compiler_v1.ncb.json"))
    assert(builtin.contains(src, "funksjon slå_saman_hovud_utan_compiler_overstyring"))
    assert(builtin.contains(src, "builtin.starts_with(namn, \"selfhost.nc_main.\") eller ikkje finnes_nøkkel(dest, namn)"))
    assert(builtin.contains(src, "selfhost.nc_main.start"))
    assert(builtin.contains(src, "slå_saman_hovud_utan_compiler_overstyring(functions, main[\"functions\"])"))
    assert(builtin.contains(src, "NORSCODE_HOST_SEMANTIC_NCB"))
    assert(builtin.contains(src, "NORSCODE_HOST_AST_NCB"))
    assert(builtin.contains(src, "NORSCODE_HOST_OVERLAY_PREFIX"))
    assert(builtin.contains(src, "funksjon slå_saman_prefiks"))
    assert(builtin.contains(src, "funksjon slå_saman_metadata"))
    assert(builtin.contains(src, "module_initializers"))
    assert(builtin.contains(src, "global_names"))
    assert(builtin.contains(src, "dest_initializers"))
    assert(builtin.contains(src, "real_semantic_analyser"))
    assert(builtin.contains(src, "real_semantic_has_errors"))
    assert(builtin.contains(src, "real_semantic_validate_program"))
    assert(builtin.contains(src, "builtin.json_stringify(compiler)"))
    assert(ikkje builtin.contains(src, "exec_prosess"))
    assert(ikkje builtin.contains(src, "python"))
    assert(ikkje builtin.contains(src, "jq "))
    skriv("test_native_host_bundle_contract OK")
    returner 0
}
