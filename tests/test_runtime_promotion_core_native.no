bruk tools.runtime_promotion_core som promotion
bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk std.sha256 som sha256
bruk std.tempfile som tempfile

funksjon start() -> heiltall {
    la temp = tempfile.ny_tempkatalog("norscode_promotion_core_")
    la root = tempfile.sti(temp)
    builtin.mkdir_p(root + "/candidate")
    builtin.mkdir_p(root + "/active")
    builtin.fil_skriv_binær(root + "/candidate/norscode", [0, 1, 2, 3, 255, 10])
    builtin.fil_skriv_binær(root + "/active/norscode", [9, 8, 7, 0, 6])
    assert(native_fs.native_sett_modus_sti(root + "/candidate/norscode", 493)["status"] == "ok")
    assert(native_fs.native_sett_modus_sti(root + "/active/norscode", 493)["status"] == "ok")

    la gammal_hash = sha256.hash_bytes(builtin.fil_les_binær(root + "/active/norscode"))
    la ny_hash = sha256.hash_bytes(builtin.fil_les_binær(root + "/candidate/norscode"))
    la promoted = promotion.promoter(root, "candidate/norscode", "active/norscode",
                                      "rollback", "fixture")
    skriv("promotion-status=" + tekst(promoted["status"]) + ":" + tekst(promoted["error"]) + "\n")
    assert(promoted["status"] == "promoted")
    assert(promoted["candidate_sha256"] == ny_hash)
    assert(promoted["target_before_sha256"] == gammal_hash)
    assert(promoted["target_after_sha256"] == ny_hash)
    assert(promoted["rollback_sha256"] == gammal_hash)
    assert(filops.fil_finnes(root + "/" + promoted["rollback_relative"]))
    assert(filops.fil_finnes(root + "/" + promoted["manifest_relative"]))
    assert(sha256.hash_bytes(builtin.fil_les_binær(root + "/active/norscode")) == ny_hash)
    la stat = native_fs.native_stat_sti(root + "/active/norscode")
    assert(stat["status"] == "ok")
    assert((heltall_fra_tekst(tekst(stat["mode"])) & 511) == 493)

    la rollback_rel = tekst(promoted["rollback_relative"])
    la restored = promotion.gjenopprett(root, "active/norscode", rollback_rel, gammal_hash)
    skriv("rollback-status=" + tekst(restored["status"]) + ":" + tekst(restored["error"]) + "\n")
    assert(restored["status"] == "restored")
    assert(sha256.hash_bytes(builtin.fil_les_binær(root + "/active/norscode")) == gammal_hash)

    # Ein manipulert rollback blir avvist før målet blir endra.
    builtin.fil_skriv(root + "/" + rollback_rel, "manipulert")
    la before_reject = sha256.hash_bytes(builtin.fil_les_binær(root + "/active/norscode"))
    la rejected = promotion.gjenopprett(root, "active/norscode", rollback_rel, gammal_hash)
    skriv("rejected-status=" + tekst(rejected["status"]) + ":" + tekst(rejected["error"]) + "\n")
    assert(rejected["status"] == "feil")
    assert(rejected["error"] == "rollback-artefakt er ikkje verifisert")
    assert(sha256.hash_bytes(builtin.fil_les_binær(root + "/active/norscode")) == before_reject)

    tempfile.slett(temp)
    skriv("test_runtime_promotion_core_native OK\n")
    returner 0
}
