bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("selfhost/nc_main.no")
    assert(t.inneholder(src, "funksjon nc_dirname(sti: tekst) -> tekst"))
    assert(t.inneholder(src, "builtin.replace(sti, \"\\\\\", \"/\")"))
    assert(t.inneholder(src, "funksjon nc_absolutt_normalisert_sti(sti: tekst, cwd: tekst) -> tekst"))
    assert(t.inneholder(src, "builtin.replace(cwd, \"\\\\\", \"/\")"))
    assert(t.inneholder(src, "fjern(ut, lengde(ut) - 1)"))
    assert(t.inneholder(src, "funksjon nc_repo_root_fra_executable(executable_sti: tekst, cwd: tekst) -> tekst"))
    assert(t.inneholder(src, "nc_absolutt_normalisert_sti(executable_sti, cwd)"))
    assert(t.inneholder(src, "la kandidat = nc_dirname(nc_dirname(absolutt))"))
    assert(t.inneholder(src, "kandidat + \"/selfhost/nc_main.no\""))
    assert(t.inneholder(src, "kandidat + \"/tools/nc_test.no\""))
    assert(t.inneholder(src, "tekst(system[\"executable\"]), tekst(system[\"cwd\"])"))
    skriv("test_native_cli_executable_root_contract OK")
    returner 0
}
