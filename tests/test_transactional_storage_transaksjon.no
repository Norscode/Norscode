// Den offentlege boolske fasaden må skilje commit (1) frå rollback/avvising (0).
bruk std.transactional_storage som storage
bruk std.db som db

funksjon start() -> heiltall {
    la h = storage.opne(":memory:")
    assert(storage.migrer(h, "CREATE TABLE konto (id INTEGER, saldo INTEGER); INSERT INTO konto (id, saldo) VALUES (1, 100)"))
    assert(storage.transaksjon(h, "UPDATE konto SET saldo = 90 WHERE id = 1"))
    assert_eq(db.query_text(h, "SELECT saldo FROM konto WHERE id = 1"), "90")
    assert(storage.transaksjon(h, "CREATE TABLE hendelse (tekst TEXT)"))
    assert(ikke storage.transaksjon(h, "UPDATE konto SET saldo = 7 WHERE id = 1; BOGUS STATEMENT"))
    assert_eq(db.query_text(h, "SELECT saldo FROM konto WHERE id = 1"), "90")
    assert(ikke storage.transaksjon(h, "INSRT INTO konto (id, saldo) VALUES (2, 20)"))
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM konto"), 1)
    assert(storage.begin(h))
    db.execute(h, "UPDATE konto SET saldo = 80 WHERE id = 1")
    assert(ikke storage.transaksjon(h, "DELETE FROM konto"))
    assert(storage.rollback(h))
    assert_eq(db.query_text(h, "SELECT saldo FROM konto WHERE id = 1"), "90")
    assert(storage.lukk(h))
    skriv("test_transactional_storage_transaksjon OK\n")
    returner 0
}
