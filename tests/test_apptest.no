# Fase 1 (bølgje 2, 1.5) for std/apptest.no: in-process testklient over apptenar.
# get/post med json=/data=/files= (multipart), query, cookie-jar som held cookie mellom
# kall, og lifespan (oppstart/nedstenging). Gjer apptenar-appar testbare som TestClient.
bruk std.web som web
bruk std.apptenar som app
bruk std.apptest som tk

la _state: ordbok = {"startet": 0, "stengt": 0}

# ─── Handlarar ───────────────────────────────────────────────────────────────

funksjon h_login(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /login")
    returner {"set_cookie": "sid=xyz123; Path=/; HttpOnly", "body": "logga inn"}
}

funksjon h_me(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /me")
    returner {"sid": app.cookie(ctx, "sid")}
}

funksjon h_echo_json(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /echo")
    la inn = builtin.json_parse(ctx["__body__"])
    # Rein data-ordbok (ingen respons-nøklar) → auto-JSON (200).
    returner {"mottok": inn["namn"], "ct": app.header(ctx, "content-type")}
}

funksjon h_form(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /form")
    returner {"kropp": ctx["__body__"], "ct": app.header(ctx, "content-type")}
}

funksjon _jn(b: bool) -> tekst { hvis b { returner "ja" }  returner "nei" }

funksjon h_upload(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /upload")
    la kropp = ctx["__body__"]
    returner {"har_fil": _jn(builtin.index_of(kropp, "innhald-i-fila") >= 0),
              "har_filnamn": _jn(builtin.index_of(kropp, "prov.txt") >= 0),
              "multipart": _jn(builtin.starts_with(app.header(ctx, "content-type"), "multipart/form-data"))}
}

funksjon h_q(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /q")
    returner {"x": ctx["__query__"]["x"]}
}

# ─── Lifespan ────────────────────────────────────────────────────────────────

funksjon app_oppstart() -> heltall { _state["startet"] = _state["startet"] + 1  returner 0 }
funksjon app_nedstenging() -> heltall { _state["stengt"] = _state["stengt"] + 1  returner 0 }

# ─── Testar ──────────────────────────────────────────────────────────────────

funksjon test_json_body() -> heltall {
    la kl = tk.klient({"logg": "ingen"})
    la r = tk.post(kl, "/echo", {"json": {"namn": "sykkel"}})
    assert_eq(tk.status(r), 200)
    assert_eq(tk.json(r)["mottok"], "sykkel")
    assert_eq(tk.json(r)["ct"], "application/json")
    skriv("1.5 testklient: json= set Content-Type og kropp, json() parsar svaret\n")
    returner 0
}

funksjon test_form_data() -> heltall {
    la kl = tk.klient({"logg": "ingen"})
    la r = tk.post(kl, "/form", {"data": {"a": "1", "b": "to tre"}})
    assert_eq(tk.status(r), 200)
    assert_eq(tk.json(r)["kropp"], "a=1&b=to%20tre")
    assert_eq(tk.json(r)["ct"], "application/x-www-form-urlencoded")
    skriv("1.5 testklient: data= gjev form-urlencoded kropp (URL-koda verdiar)\n")
    returner 0
}

funksjon test_multipart_fil() -> heltall {
    la kl = tk.klient({"logg": "ingen"})
    la r = tk.post(kl, "/upload", {"data": {"tittel": "x"},
           "files": [{"felt": "fil", "filnamn": "prov.txt", "innhald": "innhald-i-fila", "type": "text/plain"}]})
    assert_eq(tk.status(r), 200)
    assert_eq(tk.json(r)["har_fil"], "ja")
    assert_eq(tk.json(r)["har_filnamn"], "ja")
    assert_eq(tk.json(r)["multipart"], "ja")
    skriv("1.5 testklient: files= gjev multipart/form-data med filnamn og innhald\n")
    returner 0
}

funksjon test_cookie_jar() -> heltall {
    la kl = tk.klient({"logg": "ingen"})
    # Fyrste kall set cookie via Set-Cookie.
    la inn = tk.get(kl, "/login", {})
    assert_eq(tk.status(inn), 200)
    assert(builtin.index_of(tk.header(inn, "set-cookie"), "sid=xyz123") >= 0)
    # Andre kall sender cookien automatisk (jar held han mellom kalla).
    la me = tk.get(kl, "/me", {})
    assert_eq(tk.json(me)["sid"], "xyz123")
    skriv("1.5 testklient: cookie-jar held cookie mellom to kall\n")
    returner 0
}

funksjon test_query() -> heltall {
    la kl = tk.klient({"logg": "ingen"})
    la r = tk.get(kl, "/q", {"query": {"x": "42"}})
    assert_eq(tk.json(r)["x"], "42")
    skriv("1.5 testklient: query= blir lagt til som spørjestreng\n")
    returner 0
}

funksjon test_lifespan() -> heltall {
    la kl = tk.klient({"logg": "ingen"})
    _state["startet"] = 0
    _state["stengt"] = 0
    tk.oppstart(kl, "app_oppstart")
    assert_eq(_state["startet"], 1)
    assert_eq(_state["stengt"], 0)
    tk.nedstenging(kl, "app_nedstenging")
    assert_eq(_state["stengt"], 1)
    skriv("1.5 testklient: lifespan oppstart/nedstenging kallar hookane\n")
    returner 0
}
