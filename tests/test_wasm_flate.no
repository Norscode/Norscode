# tests/test_wasm_flate.no — W11 flate-ratchet for WASM-sporet.
#
# Del 2 (Norscode → WebAssembly) genererer .js-lastarar og .wasm-modular, men INGENTING av det
# skal committast: alt generert ligg berre under build/wasm/ og blir laga på nytt av CLI-en.
# Denne testen er ein ratchet som feiler om noko av det siv inn i git eller om lastarbudsjetta
# blir sprengde:
#
#   1. Ingen SPORA (git-tracked) .js eller .wasm nokon stad i repoet.
#   2. Ingen spora .png utanfor frontend/ (WASM-/PWA-ikona blir genererte, aldri committa;
#      frontend/assets/ har nettstad-ikona og er utanfor WASM-flata).
#   3. Ingenting under build/wasm/ er spora (generert output berre der).
#   4. Ingen spora .py/.c/.h/.js/.wasm/.png på WASM-flata (std/wasm*, std/synk*, std/apptenar*,
#      examples/wasm_*, tests/*wasm*, tests/*synk*) — jf. AGENTS.md (selvstendig utan C/Python).
#   5. Lastarbudsjett-ratchet: tak-konstantane i tests/fixtures/wasm_lastar_sjekk.no er uendra.
#      Sjølve byte-målinga av lastarane står i tests/test_wasm_lastar.no; her held vi taket fast
#      så ingen kan løyse ei budsjettsprenging ved å heve taket.
#
# Git-stega køyrer «git ls-files» med pathspec-ar som skal gje TOM utdata; ei ikkje-tom utdata
# er lista over syndarane. Utan git (exit 127 frå /usr/bin/env) blir git-stega SKIP; budsjett-
# ratchet (steg 5) køyrer alltid.
bruk tools.process_runner som prosess
bruk tests.fixtures.wasm_test_hjelp som hjelp
bruk tests.fixtures.wasm_lastar_sjekk som ls

# «git ls-files» med gitte pathspec-ar. Gjev {"skip": bool, "ut": tekst} der "ut" er den trimma
# utdata (tom = ingen spora treff). skip=sann når git ikkje finst.
funksjon git_spora(root: tekst, args: liste) -> ordbok {
    la argv = ["ls-files", "--"]
    la i = 0
    mens i < lengde(args) { legg_til(argv, tekst(args[i]))  i = i + 1 }
    la r = prosess.køyr_program("git", argv, root, {}, 30000)
    la kode = tekst(r[0])
    hvis kode == "127" { returner {"skip": sann, "ut": ""} }
    returner {"skip": usann, "ut": builtin.trim(tekst(r[1]))}
}

funksjon krev_ingen(root: tekst, args: liste, skildring: tekst) -> heltall {
    la r = git_spora(root, args)
    hvis r["skip"] { returner 1 }
    hvis r["ut"] != "" {
        skriv("flate-brot (" + skildring + "): spora filer som ikkje skal vere i git:\n" + r["ut"] + "\n")
        assert(usann)
    }
    returner 0
}

funksjon start() -> heltall {
    la root = hjelp.root()

    # ── Git-ratchet ──
    la git_køyrde = 0
    git_køyrde = git_køyrde + krev_ingen(root, ["*.js", "*.wasm"], "ingen spora .js/.wasm")
    git_køyrde = git_køyrde + krev_ingen(root, ["*.png", ":!frontend/"], "ingen spora .png utanfor frontend/")
    git_køyrde = git_køyrde + krev_ingen(root, ["build/wasm"], "ingenting spora under build/wasm/")
    git_køyrde = git_køyrde + krev_ingen(root, [
        "std/wasm_*.py", "std/wasm_*.c", "std/wasm_*.h",
        "std/synk*.py", "std/synk*.c", "std/synk*.h",
        "std/apptenar*.py", "std/apptenar*.c", "std/apptenar*.h",
        "examples/wasm_*/*.py", "examples/wasm_*/*.c", "examples/wasm_*/*.h",
        "examples/wasm_*/*.js", "examples/wasm_*/*.wasm", "examples/wasm_*/*.png"], "ingen framandspråk på WASM-flata")
    hvis git_køyrde == 0 {
        skriv("flate-ratchet: SKIP git (fann ikkje git; set /usr/bin/env-git for git-stega)\n")
    } ellers {
        skriv("flate-ratchet: git-flata er rein (ingen spora .js/.wasm/.png/.py/.c/.h utanom frontend/)\n")
    }

    # ── Budsjett-ratchet (byte-tak på lastarmalane) ──
    assert_eq(ls.tak_teljar(), 600)
    assert_eq(ls.tak_eitt_import(), 400)
    assert_eq(ls.tak_fullt(), 2560)
    assert_eq(ls.tak_nett(), 448)
    assert_eq(ls.tak_lager(), 1280)
    assert_eq(ls.tak_pwa(), 736)
    assert_eq(ls.tak_pwa_test(), 384)
    assert_eq(ls.tak_sw(), 1792)
    assert_eq(ls.tak_synk(), 704)
    assert_eq(ls.tak_øy(), 2048)
    skriv("budsjett-ratchet: lastartaka er uendra (fullt=2560, sw=1792, pwa=736, synk=704, øy=2048)\n")

    skriv("test_wasm_flate OK\n")
    returner 0
}
