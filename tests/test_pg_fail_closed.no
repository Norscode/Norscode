# std.pg er fail-closed (FA-132): builtin.pg_connect m.fl. finst ikkje, og
# open() kunne gje "null" stilt på seedar med null-fallback for ukjende kall.
# No kastar alle operasjonar som treng ein tenar ein tydeleg PG-feil, utan
# DSN/passord i meldinga. Ein ekte drivar (rein Norscode) er trinn 10.
bruk std.pg som pg

funksjon _kastar(fn: tekst) -> tekst {
    la melding = ""
    prøv {
        hvis fn == "open" { pg.open("host=db port=5432 dbname=app user=ola password=hemmeleg") }
        hvis fn == "open_url" { pg.open_url("postgresql://ola:hemmeleg@db:5432/app") }
        hvis fn == "open_cfg" { pg.open_cfg("db", 5432, "app", "ola", "hemmeleg") }
        hvis fn == "execute" { pg.execute("c", "SELECT 1", []) }
        hvis fn == "query" { pg.query("c", "SELECT 1", []) }
        hvis fn == "query_int" { pg.query_int("c", "SELECT 1") }
        hvis fn == "begin" { pg.begin("c") }
        melding = "INGEN FEIL"
    } fang (e) {
        melding = tekst(e)
    }
    returner melding
}

funksjon start() -> heltall {
    assert(ikkje pg.tilgjengeleg())
    assert(ikkje pg.er_tilkopla("c"))
    assert_eq(pg.close("c"), 0)
    la ops = ["open", "open_url", "open_cfg", "execute", "query", "query_int", "begin"]
    la i = 0
    mens i < lengde(ops) {
        la m = _kastar(ops[i])
        hvis ikkje builtin.starts_with(m, "PG-feil: PostgreSQL er ikkje støtta") {
            skriv(ops[i] + " gav: " + m + "\n")
        }
        assert(builtin.starts_with(m, "PG-feil: PostgreSQL er ikkje støtta"))
        assert(builtin.index_of(m, "hemmeleg") < 0)
        assert(builtin.index_of(m, "trinn 10") >= 0)
        i = i + 1
    }
    skriv("test_pg_fail_closed OK\n")
    returner 0
}
