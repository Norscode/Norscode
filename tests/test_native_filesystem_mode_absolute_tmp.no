bruk std.filops som filops
bruk std.runtime_filesystem som fs

funksjon start() -> heiltall {
    la sti = "/tmp/norscode_mode_" + builtin.random_hex(8)
    builtin.fil_skriv_binær(sti, [0x7f, 0x45, 0x4c, 0x46])
    la resultat = fs.native_sett_modus_sti(sti, 493)
    hvis resultat["status"] != "ok" { skriv(builtin.json_stringify(resultat) + "\n") }
    assert_eq(resultat["status"], "ok")
    filops.slett_fil(sti)
    skriv("test_native_filesystem_mode_absolute_tmp OK")
    returner 0
}
