# ECDSA P-256 verifikasjon - mot ekte openssl-generert nøkkel/signatur (SHA-256).
bruk std.ecdsa_p256 som ec
bruk std.bigint som bn
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _bn(h: tekst) -> liste_heiltall {
    la bytes: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(bytes, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner bn.fra_bytes(bytes)
}
funksjon start() -> heiltall {
    la qx = _bn("8cafbade9a196dd57b8013b852cc719b27f673e27d7e9f6172156a8e4f06a6ee")
    la qy = _bn("c485a6dce17c64d52e2e96ac3b6f29585a37565794123233b4d75c5b58955e74")
    la r = _bn("26c0cfab86015531797fe3cf3bed60b94aae840326f19fac0f769bb22db6551c")
    la s = _bn("e822a8087bd86f0269608a6c3457e8fa828942266326d0052b0869e4b8e70ee8")
    la h = _bn("e0615976b2e52d89c4da04025c38e94194e87d837d66d720168b3a806ad20d9a")

    # (1) Gyldig signatur -> aksept.
    assert_eq(ec.ecdsa_verify(qx, qy, h, r, s), sann)

    # (2) r utanfor [1, n-1] -> avvist (billig range-kontroll).
    assert_eq(ec.ecdsa_verify(qx, qy, h, [0], s), usann)
    assert_eq(ec.ecdsa_verify(qx, qy, h, ec.N(), s), usann)
    # (3) s = 0 -> avvist.
    assert_eq(ec.ecdsa_verify(qx, qy, h, r, [0]), usann)

    assert_eq(ec.status()["kurve"], "secp256r1")
    skriv("test_ecdsa_p256 OK")
    returner 0
}
