# F44: nc repl — fleirlinjeinnskriving, definisjonar i økta, :type, :hjelp, historikk.
# Rein logikk testa direkte; heile løkka via NORSCODE_REPL_SCRIPT mot stage0-binæren
# (readline-ABI manglar i committed seed, jf. «stage0 manglar versjonert stdin-linje-ABI»).

bruk tools.nc_repl som repl
bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    assert(repl.er_ufullstendig("funksjon f() {"))
    assert(repl.er_ufullstendig("f(1,"))
    assert(repl.er_ufullstendig("la x = [1,"))
    assert(repl.er_ufullstendig("la x = 1 + \\"))
    assert(ikkje repl.er_ufullstendig("funksjon f() { returner 1 }"))
    assert(repl.er_definisjon("la x = 5"))
    assert(repl.er_definisjon("funksjon f() { returner 1 }"))
    assert(ikkje repl.er_definisjon("1 + 2"))
    assert_inneholder(repl.bygg_type("la x = 5\n", "x"), "builtin.type(x)")

    # Heile løkka: definisjonar overlever mellom linjer, :type, fleirlinje, historikk.
    prøv { builtin.mkdir("build/f44") } fang (e) { }
    builtin.fil_skriv("build/f44/repl_skript.txt", "la x = 5\nfunksjon dobl(n: heltall) -> heltall {\n  returner n * 2\n}\ndobl(x) + 1\n:type \"a\"\n:historikk\n:hjelp\n")
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la r = prosess.køyr_liste(root + "/bin/nc", ["run", root + "/tools/nc_repl.no"], root, {
        "NORSCODE_REPL_SCRIPT": "build/f44/repl_skript.txt", "NORSCODE_ROOT": root,
        "NORSCODE_REPL_TMP_PREFIX": root + "/build/f44/repl", "NORSCODE_REPL_LINE": ""}, 300000)
    builtin.fil_skriv("build/f44/repl_ut.txt", r[1] + r[2])
    assert_eq(r[0], "0")
    assert_inneholder(r[1], "=> 11")
    assert_inneholder(r[1], ": tekst")
    assert_inneholder(r[1], "  1  la x = 5")
    assert_inneholder(r[1], ":type uttrykk")
    returner 0
}
