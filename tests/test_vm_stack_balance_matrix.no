bruk selfhost.vm som vm

funksjon program() -> ordbok_tekst {
    la rå = "{\"format\":\"norscode-bytecode-v1\",\"entry\":\"__main__.start\",\"functions\":{" +
        "\"__main__.helper\":{\"name\":\"helper\",\"module\":\"__main__\",\"params\":[\"x\"],\"is_async\":false,\"code\":[" +
        "[\"LOAD_NAME\",\"x\"],[\"PUSH_CONST\",1],[\"BINARY_ADD\"],[\"RETURN\"]]}," +
        "\"__main__.start\":{\"name\":\"start\",\"module\":\"__main__\",\"params\":[],\"is_async\":false,\"code\":[" +
        "[\"PUSH_CONST\",\"verdi\"],[\"PUSH_CONST\",41],[\"BUILD_MAP\",1],[\"STORE_NAME\",\"m\"]," +
        "[\"LOAD_NAME\",\"m\"],[\"PUSH_CONST\",\"verdi\"],[\"INDEX_GET\"]," +
        "[\"CALL\",\"__main__.helper\",1],[\"RETURN\"]]}}}"
    returner builtin.json_parse_raw(rå)
}

funksjon start() -> heiltall {
    la i = 0
    mens i < 64 {
        assert(vm.køyr_ncb(program()) == 42)
        i = i + 1
    }
    skriv("test_vm_stack_balance_matrix OK")
    returner 0
}
