// Regresjon: begge Windows-vertane maa starte kvar kjeldefil direkte.
// Exit 0 eller "nc help" er IKKJE prov paa at testassertane vart koeyrde.
bruk tools.windows_runtime_attestation som attest
bruk std.filops som filops

funksjon svar(status: tekst, kode: tekst, output: tekst) -> ordbok_tekst {
    returner {"status": status, "exit_code": kode, "stdout": output, "stderr": ""}
}

funksjon start() -> heiltall {
    la namn = "tests/test_windows_process_appcontainer.no"
    la direkte = attest.test_argv("C:/Norscode", namn, sann)
    assert_eq(lengde(direkte), 2)
    assert_eq(direkte[0], "run")
    assert_eq(direkte[1], "C:/Norscode/tests/test_windows_process_appcontainer.no")

    la eldre = attest.test_argv("C:/Norscode", namn, usann)
    assert_eq(lengde(eldre), 2)
    assert_eq(eldre[0], "run")
    assert_eq(eldre[1], "C:/Norscode/tests/test_windows_process_appcontainer.no")

    la prosess_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", namn)
    assert_eq(prosess_miljø["NORSCODE_CMD"], "run")
    assert_eq(prosess_miljø["NORSCODE_FILE"], "C:/Norscode/tests/test_windows_process_appcontainer.no")
    assert(ikkje builtin.contains(prosess_miljø["NORSCODE_VM_CAPABILITIES"], "net.tcp"))
    assert_eq(prosess_miljø["NORSCODE_VM_DISK_ROOT"], "C:/Norscode,.")
    assert_eq(prosess_miljø["NORSCODE_VM_TARGET_DISK_ROOT"], "C:/Norscode,.")
    // Explicit child environments replace the inherited block on the old
    // Windows host. Preserve the two paths required by the AppContainer test.
    la systemroot = attest.env("SystemRoot")
    hvis systemroot == "" { systemroot = attest.env("SYSTEMROOT") }
    hvis systemroot != "" { assert_eq(prosess_miljø["SystemRoot"], systemroot) }
    ellers { assert(ikkje finnes_nøkkel(prosess_miljø, "SystemRoot")) }
    la localappdata = attest.env("LOCALAPPDATA")
    hvis localappdata != "" { assert_eq(prosess_miljø["LOCALAPPDATA"], localappdata) }
    ellers { assert(ikkje finnes_nøkkel(prosess_miljø, "LOCALAPPDATA")) }
    la nett_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", "tests/test_windows_native_network.no")
    assert(builtin.contains(nett_miljø["NORSCODE_VM_CAPABILITIES"], "net.tcp"))
    assert_eq(nett_miljø["NORSCODE_VM_TARGET_CAPABILITIES"], nett_miljø["NORSCODE_VM_CAPABILITIES"])
    assert_eq(nett_miljø["NORSCODE_VM_NET_SCOPE"], "127.0.0.1")
    assert_eq(nett_miljø["NORSCODE_VM_TARGET_NET_SCOPE"], "127.0.0.1")
    la iocp_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", "tests/test_windows_iocp_scheduler.no")
    assert_eq(iocp_miljø["NORSCODE_VM_NET_SCOPE"], "127.0.0.1")
    la tls_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", "tests/test_windows_schannel_client.no")
    assert_eq(tls_miljø["NORSCODE_VM_NET_SCOPE"], "104.16.124.96")
    assert_eq(tls_miljø["NORSCODE_VM_TARGET_NET_SCOPE"], "104.16.124.96")

    assert_eq(attest.test_markor(namn), "test_windows_process_appcontainer OK")
    assert_eq(attest.test_markor("tests/test_argon2_native.no"), "test_argon2_native OK")
    assert_eq(attest.test_markor("tests/mangler_fil"), "")

    // Both modes reject the exact false-green output observed on the legacy
    // host, as well as help, missing markers, failed exits and timeouts.
    for modus i [usann, sann] {
        assert(attest.test_bestatt(svar("ferdig", "0", "test_windows_process_appcontainer OK"), namn, modus))
        assert(ikkje attest.test_bestatt(svar("ferdig", "0", ""), namn, modus))
        assert(ikkje attest.test_bestatt(svar("ferdig", "0", "=== nc_main.no selftest ===\ntest OK\n"), namn, modus))
        assert(ikkje attest.test_bestatt(svar("ferdig", "0", "Norscode 0.1.0 - nc help"), namn, modus))
        assert(ikkje attest.test_bestatt(svar("ferdig", "0", "Kompilerer og koeyrer tests/test_*.no"), namn, modus))
        assert(ikkje attest.test_bestatt(svar("ferdig", "1", "test_windows_process_appcontainer OK"), namn, modus))
        assert(ikkje attest.test_bestatt(svar("timeout", "124", "test_windows_process_appcontainer OK"), namn, modus))
    }

    // Exercise the real dispatcher, not just its generated argument/map.
    // Deliberately stale argv and environment must still reach our fixture.
    la root = attest.env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = attest.env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = tekst(builtin.system_info()["executable"]) }
    la rel = "build/attestation-dispatch-" + tekst(builtin.tid_ms())
    assert(filops.lag_katalogar(root + "/" + rel))
    la fixture = rel + "/test_attestation_dispatch_probe.no"
    la sti = root + "/" + fixture
    la feil_miljø = {"NORSCODE_CMD": "selftest", "NORSCODE_FILE": root + "/does-not-exist.no"}
    fil_skriv(sti, "funksjon start() -> heiltall { skriv(\"test_attestation_dispatch_probe OK\\n\") returner 0 }\n")
    assert(attest.køyr(root, native, ["selftest"], feil_miljø, fixture))
    fil_skriv(sti, "funksjon start() -> heiltall { skriv(\"=== nc_main.no selftest ===\\ntest OK\\n\") returner 0 }\n")
    assert(ikkje attest.køyr(root, native, ["selftest"], feil_miljø, fixture))
    fil_skriv(sti, "funksjon start() -> heiltall { skriv(\"test_attestation_dispatch_probe OK\\n\") returner 23 }\n")
    assert(ikkje attest.køyr(root, native, ["selftest"], feil_miljø, fixture))
    assert(filops.slett_tre(root + "/" + rel))

    skriv("test_windows_attestation_direct_dispatch OK\n")
    returner 0
}
