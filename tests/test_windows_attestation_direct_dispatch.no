// Regresjon: CRT-fri Windows-attestasjon maa starte kvar kjeldefil direkte.
// Exit 0 eller "nc help" er IKKJE prov paa at testassertane vart koeyrde.
bruk tools.windows_runtime_attestation som attest

funksjon svar(status: tekst, kode: tekst, output: tekst) -> ordbok_tekst {
    returner {"status": status, "exit_code": kode, "stdout": output, "stderr": ""}
}

funksjon start() -> heiltall {
    la namn = "tests/test_windows_process_appcontainer.no"
    la direkte = attest.test_argv("C:/Norscode", namn, sann)
    assert_eq(lengde(direkte), 2)
    assert_eq(direkte[0], "run")
    assert_eq(direkte[1], "C:/Norscode/tests/test_windows_process_appcontainer.no")

    la eldre = attest.test_argv("C:/Norscode", namn, usann)
    assert_eq(lengde(eldre), 1)
    assert_eq(eldre[0], "test")

    la prosess_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", namn)
    assert(ikkje builtin.contains(prosess_miljø["NORSCODE_VM_CAPABILITIES"], "net.tcp"))
    assert_eq(prosess_miljø["NORSCODE_VM_DISK_ROOT"], "C:/Norscode,.")
    assert_eq(prosess_miljø["NORSCODE_VM_TARGET_DISK_ROOT"], "C:/Norscode,.")
    la nett_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", "tests/test_windows_native_network.no")
    assert(builtin.contains(nett_miljø["NORSCODE_VM_CAPABILITIES"], "net.tcp"))
    assert_eq(nett_miljø["NORSCODE_VM_TARGET_CAPABILITIES"], nett_miljø["NORSCODE_VM_CAPABILITIES"])
    assert_eq(nett_miljø["NORSCODE_VM_NET_SCOPE"], "127.0.0.1")
    assert_eq(nett_miljø["NORSCODE_VM_TARGET_NET_SCOPE"], "127.0.0.1")
    la iocp_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", "tests/test_windows_iocp_scheduler.no")
    assert_eq(iocp_miljø["NORSCODE_VM_NET_SCOPE"], "127.0.0.1")
    la tls_miljø = attest.test_miljø("C:/Norscode", "C:/Norscode/nc.exe", "tests/test_windows_schannel_client.no")
    assert_eq(tls_miljø["NORSCODE_VM_NET_SCOPE"], "104.16.124.96")
    assert_eq(tls_miljø["NORSCODE_VM_TARGET_NET_SCOPE"], "104.16.124.96")

    assert_eq(attest.test_markor(namn), "test_windows_process_appcontainer OK")
    assert_eq(attest.test_markor("tests/test_argon2_native.no"), "test_argon2_native OK")
    assert_eq(attest.test_markor("tests/mangler_fil"), "")

    // Kun eksplisitt sluttmarkor ETTER alle assertane er nok til full attestasjon.
    assert(attest.test_bestatt(svar("ferdig", "0", "test_windows_process_appcontainer OK"), namn, sann))
    assert(ikkje attest.test_bestatt(svar("ferdig", "0", "Norscode 0.1.0 - nc help"), namn, sann))
    assert(ikkje attest.test_bestatt(svar("ferdig", "0", "Kompilerer og koeyrer tests/test_*.no"), namn, sann))
    assert(ikkje attest.test_bestatt(svar("ferdig", "1", "test_windows_process_appcontainer OK"), namn, sann))
    assert(ikkje attest.test_bestatt(svar("timeout", "124", "test_windows_process_appcontainer OK"), namn, sann))

    // Committed stage0 brukar framleis den eksisterande nc test-kontrakten.
    assert(attest.test_bestatt(svar("ferdig", "0", ""), namn, usann))
    assert(ikkje attest.test_bestatt(svar("ferdig", "1", ""), namn, usann))

    skriv("test_windows_attestation_direct_dispatch OK\n")
    returner 0
}
