# 4.1: HTTPFeil-hierarkiet i std/apptenar (kast i handlar -> statuskode + {"detail": ...}),
# eigne feilhandterarar per type (app.feilhandterar), og grensesnitt-basert fang utan arv.
# Køyrer i same prosess via app.handsam_rå (ingen socket), som test_apptenar_fase1.
bruk std.web som web
bruk std.apptenar som app
bruk std.httpfeil
bruk std.httpfeil_handterar som hf

funksjon r_funnet(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /funnet")
    kast IkkjeFunnet("Fann ikkje")
}
funksjon r_generell(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /generell")
    kast HTTPFeil(418, "tekanne")
}
funksjon r_input(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /input")
    kast UgyldigInput({"felt": "namn", "krav": ["påkravd"]})
}
funksjon r_auth(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /auth")
    kast IkkjeAutorisert("logg inn", {"www-authenticate": "Bearer"})
}
funksjon r_forbode(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /forbode")
    kast Forbode("ikkje din")
}
funksjon r_konflikt(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /konflikt")
    kast Konflikt("dobbel")
}
funksjon r_server(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /server")
    kast ServerFeil("kaput")
}
funksjon r_gammal(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /gammal")
    app.http_feil(404, "gammal stil")
    returner {"nå": "aldri"}
}
funksjon r_valid(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /valid")
    app.valideringsfeil("namn er påkravd")
    returner {"nå": "aldri"}
}
funksjon r_krasj(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /krasj")
    kast "gale internt"
}
funksjon r_ok(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /ok")
    returner {"ok": sann}
}

funksjon svar(rå: tekst) -> ordbok {
    la t = app.handsam_rå(rå)
    la slutt = builtin.index_of(t, "\r\n\r\n")
    la linjer = builtin.split(builtin.slice(t, 0, slutt), "\r\n")
    la h = {}
    la i = 1
    mens i < lengde(linjer) {
        la k = builtin.index_of(linjer[i], ":")
        h[builtin.lower(builtin.slice(linjer[i], 0, k))] = builtin.trim(builtin.slice(linjer[i], k + 1, lengde(linjer[i])))
        i = i + 1
    }
    returner {"status": heltall_fra_tekst(builtin.split(linjer[0], " ")[1]), "h": h,
              "body": builtin.slice(t, slutt + 4, lengde(t))}
}

funksjon get(sti: tekst) -> ordbok {
    returner svar("GET " + sti + " HTTP/1.1\r\nHost: x\r\n\r\n")
}

funksjon hdr(r: ordbok, namn: tekst) -> tekst {
    hvis har_nokkel(r["h"], namn) { returner r["h"][namn] }
    returner ""
}

funksjon _reset() -> heltall {
    app.nullstill({"logg": "ingen"})
    hf.feilhandterarar_nullstill()
    returner 0
}

funksjon test_undertypar_standardsvar() -> heltall {
    _reset()
    la a = get("/funnet")
    assert_eq(a["status"], 404)
    assert_eq(hdr(a, "content-type"), "application/json; charset=utf-8")
    assert_eq(a["body"], "{\"detail\":\"Fann ikkje\"}")
    la g = get("/generell")
    assert_eq(g["status"], 418)
    assert_eq(g["body"], "{\"detail\":\"tekanne\"}")
    la i = get("/input")
    assert_eq(i["status"], 400)
    assert_eq(i["body"], "{\"detail\":{\"felt\":\"namn\",\"krav\":[\"påkravd\"]}}")
    la u = get("/auth")
    assert_eq(u["status"], 401)
    assert_eq(hdr(u, "www-authenticate"), "Bearer")
    assert_eq(u["body"], "{\"detail\":\"logg inn\"}")
    assert_eq(get("/forbode")["status"], 403)
    assert_eq(get("/konflikt")["status"], 409)
    la s = get("/server")
    assert_eq(s["status"], 500)
    assert_eq(s["body"], "{\"detail\":\"kaput\"}")
    skriv("4.1 undertypar: statuskode + {\"detail\"} for alle seks + generell\n")
    returner 0
}

funksjon test_feilhandterar_eksakt_og_rot() -> heltall {
    _reset()
    app.feilhandterar("IkkjeFunnet", fun(req, feil) -> {"status": 404, "body": "{\"finst_ikkje\":\"" + tekst(feil.detalj) + "\"}", "content_type": "application/json; charset=utf-8", "headers": {"X-Handterar": "eksakt"}})
    la a = get("/funnet")
    assert_eq(a["status"], 404)
    assert_eq(a["body"], "{\"finst_ikkje\":\"Fann ikkje\"}")
    assert_eq(hdr(a, "x-handterar"), "eksakt")
    # andre typar er uendra (ingen arv: IkkjeFunnet-handlaren rører ikkje Forbode)
    assert_eq(get("/forbode")["body"], "{\"detail\":\"ikkje din\"}")
    # rota HTTPFeil tek alle andre; eksakt type vinn framleis
    app.feilhandterar("HTTPFeil", fun(req, feil) -> {"rot": feil.status()})
    la r = get("/forbode")
    assert_eq(r["status"], 403)
    assert_eq(r["body"], "{\"rot\":403}")
    assert_eq(get("/funnet")["body"], "{\"finst_ikkje\":\"Fann ikkje\"}")
    assert_eq(get("/generell")["status"], 418)
    # handlaren får req
    app.feilhandterar("Konflikt", fun(req, feil) -> {"status": 409, "body": tekst(req["__path__"])})
    assert_eq(get("/konflikt")["body"], "/konflikt")
    skriv("4.1 feilhandterar: eksakt type vinn over rota, req med, ingen arv\n")
    returner 0
}

funksjon test_handterar_som_kastar_gjev_500() -> heltall {
    _reset()
    app.feilhandterar("Forbode", fun(req, feil) -> 1 / 0)
    la r = get("/forbode")
    assert_eq(r["status"], 500)
    assert(builtin.index_of(r["body"], "Intern feil") >= 0)
    assert_eq(get("/ok")["status"], 200)
    skriv("4.1 handlar som kastar: 500, tenaren lever\n")
    returner 0
}

funksjon test_uendra_oppforsel() -> heltall {
    _reset()
    la g = get("/gammal")
    assert_eq(g["status"], 404)
    assert_eq(g["body"], "{\"detail\":\"gammal stil\"}")
    assert_eq(get("/valid")["status"], 422)
    la k = get("/krasj")
    assert_eq(k["status"], 500)
    assert(builtin.index_of(k["body"], "gale internt") < 0)
    assert_eq(get("/ok")["status"], 200)
    assert_eq(get("/finnesikkje")["status"], 404)
    assert_eq(svar("POST /ok HTTP/1.1\r\nHost: x\r\n\r\n")["status"], 405)
    skriv("4.1 uendra: http_feil, 422, 500 utan lekkasje, 404, 405\n")
    returner 0
}

funksjon fang_rot(k: heiltall) -> tekst {
    prøv {
        hvis k == 0 { kast IkkjeFunnet("a") }
        hvis k == 1 { kast Forbode("b") }
        hvis k == 2 { kast HTTPFeil(418, "c") }
        hvis k == 3 { kast "AnnaFeil: x" }
    } fang (e: HTTPFeil) {
        returner "rot:" + tekst(e.status()) + ":" + typenamn(e)
    } fang (e) {
        returner "andre"
    }
    returner "ingen"
}

funksjon fang_berre_funnet(k: heiltall) -> tekst {
    prøv {
        prøv {
            hvis k == 0 { kast IkkjeFunnet("a") }
            hvis k == 1 { kast Forbode("b") }
        } fang (e: IkkjeFunnet) {
            returner "funnet"
        }
    } fang (e) {
        returner "ytre"
    }
    returner "ingen"
}

funksjon test_fang_grensesnitt_utan_arv() -> heltall {
    assert_eq(fang_rot(0), "rot:404:IkkjeFunnet")
    assert_eq(fang_rot(1), "rot:403:Forbode")
    assert_eq(fang_rot(2), "rot:418:HTTPFeilGenerell")
    assert_eq(fang_rot(3), "andre")
    assert_eq(fang_berre_funnet(0), "funnet")
    assert_eq(fang_berre_funnet(1), "ytre")
    skriv("4.1 fang (e: HTTPFeil) fangar alle undertypar; fang (e: IkkjeFunnet) berre sin eigen\n")
    returner 0
}

funksjon test_detalj_bool_json() -> heltall {
    assert_eq(feil_respons(IkkjeFunnet(sann, null))["body"], "{\"detail\":true}")
    assert_eq(feil_respons(IkkjeFunnet(usann, null))["body"], "{\"detail\":false}")
    assert_eq(detalj_json([sann, usann, 1, "x"]), "[true,false,1,\"x\"]")
    assert_eq(detalj_json({"ok": sann, "n": {"v": usann}}), "{\"ok\":true,\"n\":{\"v\":false}}")
    returner 0
}
