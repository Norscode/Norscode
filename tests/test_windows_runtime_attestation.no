bruk std.tekst som t
bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la src = fil_les("tools/windows_runtime_attestation.no")
    la backend = fil_les("archive/legacy_c_backend/nc_windows_backend.c")
    la native_main = fil_les("archive/legacy_c_backend/nc_native_main.c")
    assert(t.inneholder(src, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(src, "bruk std.sha256 som sha256"))
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "builtin.system_info()"))
    assert(t.inneholder(src, "builtin.sha256_bytes(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(src, "native_fs.native_lag_mappe(root, \"reports\")"))
    assert(t.inneholder(src, "prosess.køyr(native, argv, root, miljø, 600000)"))
    assert(t.inneholder(src, "NORSCODE_SOURCE_COMMIT"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "bash.exe"))
    assert(ikkje t.inneholder(src, "awk"))
    assert(ikkje t.inneholder(src, "mkdir -p"))
    assert(ikkje t.inneholder(src, "git rev-parse"))
    assert(t.inneholder(backend, "if (sandbox_profile && strcmp(sandbox_profile, \"none\"))"))
    assert(t.inneholder(backend, "JOB_OBJECT_LIMIT_ACTIVE_PROCESS"))
    assert(t.inneholder(native_main, "BCryptOpenAlgorithmProvider"))
    assert(t.inneholder(native_main, "BCRYPT_SHA256_ALGORITHM"))
    assert(t.inneholder(native_main, "BCryptFinishHash"))
    assert(t.inneholder(native_main, "BCryptDestroyHash"))

    la native = tekst(builtin.system_info()["executable"])
    la root = tekst(builtin.system_info()["cwd"])
    la res = prosess.køyr(native, ["run", "tools/windows_runtime_attestation.no"], root,
        {"NORSCODE_ROOT": root}, 30000)
    hvis builtin.contains(tekst(res["stdout"]), "krev faktisk Windows-host") {
        assert_eq(tekst(res["exit_code"]), "2")
    }
    skriv("test_windows_runtime_attestation OK")
    returner 0
}
