bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/publish_runtime_artifact.no")
    assert(t.inneholder(src, "NORSCODE_PUBLISH_RUNTIME_SOURCE"))
    assert(t.inneholder(src, "NORSCODE_PUBLISH_RUNTIME_OUTPUT"))
    assert(t.inneholder(src, "builtin.sha256_bytes(bytes)"))
    assert(t.inneholder(src, "sha256.hash_bytes"))
    assert(t.inneholder(src, "filops.kopier2"))
    assert(t.inneholder(src, "builtin.fil_sett_kjorbar(mål)"))
    assert(ikkje t.inneholder(src, "/bin/chmod"))
    assert(ikkje t.inneholder(src, "sha256sum"))
    assert(ikkje t.inneholder(src, "shasum"))
    skriv("test_publish_runtime_artifact_contract OK\n")
    returner 0
}
