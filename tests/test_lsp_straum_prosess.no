// Ende-til-ende: `nc run selfhost/lsp/straum.no` som barneprosess. Prosess-ABI-en
// tillèt ikkje linjeskift i stdin, så meldingane går som rå, samanhengande
// JSON-objekt på éi linje (straum.no godtek det i tillegg til Content-Length).
// Barnet les stdin i VM via batch-reserven (fil_les("/dev/stdin")) — berre der
// seeden les ei pipe (macOS); på Linux-seeden blir testen hoppa over. Den
// ekte strøyminga er testa av tests/aot_lsp_straum_drivar.no.
bruk tools.process_runner som prosess
bruk std.runtime.process_abi som process_abi
bruk selfhost.lsp.straum som s

funksjon repo_root() -> tekst {
    prøv {
        la root = miljo_hent("NORSCODE_ROOT")
        hvis root != "" { returner root }
    } fang (e) {}
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon er_macos() -> boolsk {
    prøv { returner tekst(builtin.system_info()["system"]) == "Darwin" } fang (e) { returner usann }
    returner usann
}

funksjon kjor(root: tekst, stdin: tekst) {
    la exe = root + "/bin/nc"
    la argv = ["run", root + "/selfhost/lsp/straum.no"]
    la disk = root + ",.,/tmp,/private/tmp,/dev/stdin"
    la miljø = {}
    miljø["NORSCODE_VM_DISK_ROOT"] = disk
    miljø["NORSCODE_VM_TARGET_DISK_ROOT"] = disk
    miljø["NORSCODE_VM_CAPABILITIES"] = "env.read,env.write,disk.read"
    miljø["NORSCODE_VM_TARGET_CAPABILITIES"] = "env.read,env.write,disk.read"
    la req = process_abi.request(exe, argv, root, stdin, 240000, 33554432)
    process_abi.sett_sandbox(req, "none", 4294967296, 1024, sann)
    process_abi.sett_environment(req, prosess.nc_miljø_frå_argv(exe, argv, miljø))
    returner builtin.process_spawn_argv(req)
}

funksjon start() -> heiltall {
    hvis ikkje er_macos() {
        skriv("test_lsp_straum_prosess: hoppa over (stdin-pipe via /dev/stdin berre på macOS-seeden)\n")
        returner 0
    }
    la uri = "file:///tmp/lsp_prosess.no"
    la kjelde = "// Doble talet.\nfunksjon dobl(x: heltall) -> heltall {\n    returner x * 2\n}\nfunksjon start() {\n    la y: heltall = dobl(\"a\")\n}\n"
    la inn = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}"
    inn = inn + "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\",\"version\":1,\"text\":" + s.lsp_js_tekst(kjelde) + "}}}"
    inn = inn + "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":5,\"character\":21}}}"
    inn = inn + "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}"
    inn = inn + "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}"
    la res = kjor(repo_root(), inn)
    la ut = tekst(res["stdout"])
    la feil = 0
    la krav = [
        "\"id\":1,\"result\":{\"capabilities\"",
        "\"method\":\"textDocument/publishDiagnostics\"",
        "\"code\":\"type-error\"",
        "\"start\":{\"line\":5,\"character\":25}",
        "funksjon dobl(x: heltall) -> heltall",
        "Doble talet.",
        "\"id\":3,\"result\":null"
    ]
    la i = 0
    mens i < lengde(krav) {
        hvis ikkje builtin.contains(ut, krav[i]) {
            skriv("FEIL manglar «" + krav[i] + "» i:\n" + ut + tekst(res["stderr"]) + "\n")
            feil = feil + 1
        }
        i = i + 1
    }
    hvis tekst(res["status"]) != "ferdig" eller heltall_fra_tekst(tekst(res["exit_code"])) != 0 {
        skriv("FEIL exit: status=" + tekst(res["status"]) + " kode=" + tekst(res["exit_code"]) + "\n" + tekst(res["stderr"]) + "\n")
        feil = feil + 1
    }
    hvis feil > 0 { returner 1 }
    skriv("test_lsp_straum_prosess OK\n")
    returner 0
}
