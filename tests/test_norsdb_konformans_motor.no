// Konformans-herding av den nye binære motoren: bredt batteri som stressar
// KOMBINASJONAR av features. Golden = ekte sqlite3 3.51.0. Fangar integrasjonsbugs.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE ans (id INTEGER, navn TEXT, avd TEXT, lonn INTEGER)")
    sql.exec(db, "INSERT INTO ans (id, navn, avd, lonn) VALUES (1, 'Ada', 'Tech', 700)")
    sql.exec(db, "INSERT INTO ans (id, navn, avd, lonn) VALUES (2, 'Linus', 'Tech', 900)")
    sql.exec(db, "INSERT INTO ans (id, navn, avd, lonn) VALUES (3, 'Bjørn', 'Salg', 500)")
    sql.exec(db, "INSERT INTO ans (id, navn, avd, lonn) VALUES (4, 'Alan', 'Tech', -100)")
    sql.exec(db, "INSERT INTO ans (id, navn, avd, lonn) VALUES (5, 'Eve', 'Salg', 500)")
    sql.exec(db, "CREATE TABLE avd (kode TEXT, byen TEXT)")
    sql.exec(db, "INSERT INTO avd (kode, byen) VALUES ('Tech', 'Oslo')")
    sql.exec(db, "INSERT INTO avd (kode, byen) VALUES ('Salg', 'Bergen')")

    // 1 negativ tal
    assert_eq(sql.query_rader(db, "SELECT navn FROM ans WHERE lonn < 0"), "Alan")
    // 2 AND
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE avd = 'Tech' AND lonn > 600"), 2)
    // 3 ORDER DESC + LIMIT
    assert_eq(sql.query_rader(db, "SELECT navn FROM ans ORDER BY lonn DESC LIMIT 2"), "Linus\nAda")
    // 4 GROUP + HAVING + ORDER
    assert_eq(sql.query_rader(db, "SELECT avd, COUNT(*) FROM ans GROUP BY avd HAVING COUNT(*) >= 2 ORDER BY avd"), "Salg|2\nTech|3")
    // 5 GROUP + SUM
    assert_eq(sql.query_rader(db, "SELECT avd, SUM(lonn) FROM ans GROUP BY avd ORDER BY avd"), "Salg|1000\nTech|1500")
    // 6 JOIN + WHERE (kvalifisert) + ORDER
    assert_eq(sql.query_rader(db, "SELECT ans.navn, avd.byen FROM ans JOIN avd ON ans.avd = avd.kode WHERE avd.byen = 'Oslo' ORDER BY ans.navn"), "Ada|Oslo\nAlan|Oslo\nLinus|Oslo")
    // 7 IN
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn IN (500, 900)"), 3)
    // 8 NOT IN
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE avd NOT IN ('Salg')"), 3)
    // 9 LIKE med _
    assert_eq(sql.query_rader(db, "SELECT navn FROM ans WHERE navn LIKE '_l%'"), "Alan")
    // 10 BETWEEN (inkl. negativ grense-test)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE lonn BETWEEN 0 AND 600"), 2)
    // 11 tom mengde
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE avd = 'Ukjent'"), 0)
    // 12 skalar-aggregat kvar for seg (multi-agg i éin SELECT er ikkje støtta enno)
    assert_eq(sql.query_int(db, "SELECT MIN(lonn) FROM ans"), -100)
    assert_eq(sql.query_int(db, "SELECT MAX(lonn) FROM ans"), 900)
    assert_eq(sql.query_int(db, "SELECT AVG(lonn) FROM ans"), 500)
    // Multi-aggregat i éin SELECT (G5 fiksa) + skalar-agg via query_rader
    assert_eq(sql.query_rader(db, "SELECT MIN(lonn), MAX(lonn), SUM(lonn) FROM ans"), "-100|900|2500")
    assert_eq(sql.query_rader(db, "SELECT COUNT(*) FROM ans"), "5")

    // 13 indeks + equality gjev same som skann
    sql.exec(db, "CREATE INDEX idx_avd ON ans (avd)")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ans WHERE avd = 'Tech'"), 3)
    assert_eq(sql.query_rader(db, "SELECT navn FROM ans WHERE avd = 'Salg' ORDER BY navn"), "Bjørn\nEve")

    returner 0
}
