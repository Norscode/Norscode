# M9 — grensesnitt: kompilerings-kontraktsjekk. Struktur som implementerer eit
# grensesnitt må ha alle metodane, elles kompileringsfeil. Køyrer via KJELDE-
# kompilator (berre kompilering, ingen nested VM — lettare/mindre flaky).

bruk selfhost.kompiler som kompiler

funksjon kompilerer(kjelde: tekst) -> bool {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner usann
    }
    returner sann
}

funksjon start() -> heiltall {
    # Gyldig: Sirkel implementerer Form OG har areal
    la gyldig = "grensesnitt Form { funksjon areal(self) -> heltall }\n" +
        "struktur Sirkel implementerer Form { r }\n" +
        "funksjon Sirkel.areal(self) -> heltall { returner self.r * self.r }\n" +
        "funksjon start() -> heltall { returner 0 }\n"
    assert(kompilerer(gyldig))

    # Ugyldig: implementerer Form men manglar areal → kompileringsfeil
    la ugyldig = "grensesnitt Form { funksjon areal(self) -> heltall }\n" +
        "struktur Kvadrat implementerer Form { s }\n" +
        "funksjon start() -> heltall { returner 0 }\n"
    assert(ikkje kompilerer(ugyldig))

    # Fleire metodar: manglar ein av to
    la delvis = "grensesnitt Dyr { funksjon lyd(self) -> tekst\n funksjon bein(self) -> heltall }\n" +
        "struktur Hund implementerer Dyr { namn }\n" +
        "funksjon Hund.lyd(self) -> tekst { returner \"voff\" }\n" +
        "funksjon start() -> heltall { returner 0 }\n"
    assert(ikkje kompilerer(delvis))

    # Komplett implementasjon av fleir-metode-grensesnitt
    la komplett = "grensesnitt Dyr { funksjon lyd(self) -> tekst\n funksjon bein(self) -> heltall }\n" +
        "struktur Hund implementerer Dyr { namn }\n" +
        "funksjon Hund.lyd(self) -> tekst { returner \"voff\" }\n" +
        "funksjon Hund.bein(self) -> heltall { returner 4 }\n" +
        "funksjon start() -> heltall { returner 0 }\n"
    assert(kompilerer(komplett))

    skriv("test_grensesnitt OK\n")
    returner 0
}
