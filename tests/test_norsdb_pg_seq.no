// Postgres-utvidingar batch 5: sekvensar (CREATE/DROP SEQUENCE, nextval/currval/setval).
// Sekvensar er ikkje-transaksjonelle (som i Postgres).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")

    // START WITH 10 INCREMENT BY 5
    sql.exec(db, "CREATE SEQUENCE s START WITH 10 INCREMENT BY 5")
    assert_eq(sql.query_text(db, "SELECT nextval('s')"), "10")
    assert_eq(sql.query_text(db, "SELECT nextval('s')"), "15")
    assert_eq(sql.query_text(db, "SELECT currval('s')"), "15")
    assert_eq(sql.query_text(db, "SELECT setval('s', 100)"), "100")
    assert_eq(sql.query_text(db, "SELECT nextval('s')"), "105")

    // Standard sekvens (start 1, inc 1)
    sql.exec(db, "CREATE SEQUENCE s2")
    assert_eq(sql.query_text(db, "SELECT nextval('s2')"), "1")
    assert_eq(sql.query_text(db, "SELECT nextval('s2')"), "2")

    // currval før nextval på fersk sekvens → NULL (tom tekst)
    sql.exec(db, "CREATE SEQUENCE s3")
    assert_eq(sql.query_text(db, "SELECT currval('s3')"), "")

    // DROP SEQUENCE
    sql.exec(db, "DROP SEQUENCE s2")
    assert_eq(sql.query_text(db, "SELECT nextval('s2')"), "")

    // Sekvens brukt som id-kjelde i INSERT
    sql.exec(db, "CREATE SEQUENCE id_seq START WITH 1")
    sql.exec(db, "CREATE TABLE t (id INTEGER, namn TEXT)")
    sql.exec(db, "INSERT INTO t (id, namn) VALUES (nextval('id_seq'), 'a')")
    sql.exec(db, "INSERT INTO t (id, namn) VALUES (nextval('id_seq'), 'b')")
    assert_eq(sql.query_rader(db, "SELECT id, namn FROM t ORDER BY id"), "1|a\n2|b")

    returner 0
}
