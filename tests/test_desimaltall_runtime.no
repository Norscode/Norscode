// Regresjonsvakt for desimaltal på ein runtime/seed.
//
// BAKGRUNN (2026-09-10): den ferske x86-seeden bestod heile harness-subsettet,
// men hadde INGEN fungerande flyttalsstøtte. Ingen test fanga det, fordi ingen
// test faktisk rekna med desimaltal — dei strukturelle testane les kjeldetekst,
// og dei funksjonelle brukte heiltal. Målt på fersk seed mot committed seed,
// same fil, same køyring:
//
//     uttrykk            committed      fersk seed
//     3.5                3.5            3          ← stille trunkering
//     0.1                0.1            0
//     3.5 + 2.5          6              5
//     builtin.desimaltall("3.5")        SIGSEGV (rc=139)
//
// Rota er at x86 sin RT_JSON_PARSE er ein FAST adresse (4205248) inn i den
// frosne C-æra-blobben, og den parsaren les eit desimaltal som heiltal og
// stoppar på punktumet. NCB-konstantar går gjennom nettopp den parsaren.
// ARM64/Mach-O har ein handemittert emit_json_parse_routine() som er retta
// (6d68492); x86 kan ikkje rettast før Fase C.3 erstattar blobben med atomics.
//
// Denne testen skal køyrast på KANDIDATRUNTIMEN før ein seed blir promotert.
// Han er med vilje fri for strukturelle kjeldesjekkar: han REKNAR, slik at
// berre ein runtime som faktisk kan desimaltal består.

funksjon assert(vilkår: bool, melding: tekst) -> heltall {
    hvis ikkje vilkår {
        skriv("[FAIL] " + melding + "\n")
        kast "test_desimaltall_runtime: " + melding
    }
    returner 0
}

funksjon start() -> heltall {
    // A: literal frå kjelde → NCB-konstant → parse ved lasting.
    la a = 3.5
    assert(builtin.type(a) == "desimaltall",
        "literal 3.5 skal ha type desimaltall, fekk " + builtin.type(a))
    assert(tekst(a) == "3.5", "literal 3.5 skal vere 3.5, fekk " + tekst(a))

    la liten = 0.1
    assert(tekst(liten) == "0.1", "literal 0.1 skal vere 0.1, fekk " + tekst(liten))
    assert(liten != 0, "0.1 skal ikkje bli 0 (trunkering)")

    // B: aritmetikk skal halde desimaldelen.
    la halv = 0.5
    la kvart = 0.25
    assert(tekst(halv + kvart) == "0.75",
        "0.5 + 0.25 skal vere 0.75, fekk " + tekst(halv + kvart))
    assert(tekst(a + 2.5) == "6", "3.5 + 2.5 skal vere 6, fekk " + tekst(a + 2.5))

    // C: konvertering frå tekst. Denne SEGFAULTA på den ferske seeden.
    la frå_tekst = builtin.desimaltall("2.5")
    assert(builtin.type(frå_tekst) == "desimaltall",
        "desimaltall(\"2.5\") skal gje desimaltall, fekk " + builtin.type(frå_tekst))
    assert(tekst(frå_tekst) == "2.5",
        "desimaltall(\"2.5\") skal vere 2.5, fekk " + tekst(frå_tekst))

    // D: rundtur gjennom JSON — same veg som NCB-konstantar går.
    la js = builtin.json_stringify({"x": halv})
    assert(js == "{\"x\":0.5}", "stringify av 0.5 skal vere {\"x\":0.5}, fekk " + js)
    la att = builtin.json_parse_raw(js)
    assert(builtin.type(att["x"]) == "desimaltall",
        "json_parse_raw skal gje desimaltall tilbake, fekk " + builtin.type(att["x"]))
    assert(tekst(att["x"]) == "0.5",
        "json_parse_raw rundtur skal vere 0.5, fekk " + tekst(att["x"]))

    // E: nøsta desimal — den ferske seeden gav {"m":2} for {"m":2.5}.
    la nøsta = builtin.json_parse_raw("{\"n\":{\"m\":2.5}}")
    assert(tekst(nøsta["n"]["m"]) == "2.5",
        "nøsta 2.5 skal overleve parse, fekk " + tekst(nøsta["n"]["m"]))

    skriv("test_desimaltall_runtime OK\n")
    returner 0
}
