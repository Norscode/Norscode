// Fase 4b: INNER/LEFT JOIN i det frittståande SQL-laget. Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, by_id INTEGER)")
    sql.exec(db, "CREATE TABLE byer (id INTEGER, namn TEXT)")
    sql.exec(db, "INSERT INTO folk (id, navn, by_id) VALUES (1, 'Ada', 1)")
    sql.exec(db, "INSERT INTO folk (id, navn, by_id) VALUES (2, 'Linus', 1)")
    sql.exec(db, "INSERT INTO folk (id, navn, by_id) VALUES (3, 'Bjørn', 2)")
    sql.exec(db, "INSERT INTO folk (id, navn, by_id) VALUES (4, 'Eve', 9)")
    sql.exec(db, "INSERT INTO byer (id, namn) VALUES (1, 'Oslo')")
    sql.exec(db, "INSERT INTO byer (id, namn) VALUES (2, 'Bergen')")

    // INNER JOIN
    assert_eq(sql.query_rader(db, "SELECT folk.navn, byer.namn FROM folk JOIN byer ON folk.by_id = byer.id"), "Ada|Oslo\nLinus|Oslo\nBjørn|Bergen")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM folk JOIN byer ON folk.by_id = byer.id"), 3)

    // INNER JOIN + WHERE på høgre tabell
    assert_eq(sql.query_rader(db, "SELECT folk.navn FROM folk JOIN byer ON folk.by_id = byer.id WHERE byer.namn = 'Oslo'"), "Ada\nLinus")

    // LEFT JOIN — Eve (by_id 9) har ingen match → tom namn
    assert_eq(sql.query_rader(db, "SELECT folk.navn, byer.namn FROM folk LEFT JOIN byer ON folk.by_id = byer.id"), "Ada|Oslo\nLinus|Oslo\nBjørn|Bergen\nEve|")

    returner 0
}
