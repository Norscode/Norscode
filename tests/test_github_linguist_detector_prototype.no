// Eksperimentell Norscode-deteksjon, ikkje Linguist sin offisielle heuristikk.
// Les line for line og krev samanhengande kodekjenneteikn, ikkje berre ord i prosa.
bruk std.tekst som t

funksjon kode_linje(tekstlinje: tekst) -> bool {
    la linje = t.trim(tekstlinje)
    hvis linje == "" { returner usann }
    hvis t.starter_med(linje, "#") eller t.starter_med(linje, "//") { returner usann }
    hvis t.starter_med(linje, "\"") eller t.starter_med(linje, "'") { returner usann }
    returner sann
}

funksjon funksjonsdeklarasjon(linje: tekst) -> bool {
    hvis ikkje t.starter_med(linje, "funksjon ") { returner usann }
    la open = t.finn(linje, "(")
    la close = t.finn(linje, ")")
    hvis open <= 9 eller close <= open { returner usann }
    // Typa blokk, kompakt blokk eller historisk slutt-syntaks.
    returner t.slutter_med(linje, "{") eller t.slutter_med(linje, ")") eller t.slutter_med(linje, ":")
}

funksjon ser_ut_som_norscode(kjelde: tekst) -> bool {
    la linjer = t.splitt(kjelde, "\n")
    la signatur = usann
    la blokk = usann
    la retur = usann
    la i = 0
    mens i < lengde(linjer) {
        la linje = t.trim(linjer[i])
        hvis kode_linje(linje) {
            hvis funksjonsdeklarasjon(linje) { signatur = sann }
            hvis t.inneholder(linje, "{") eller linje == "slutt" { blokk = sann }
            hvis t.starter_med(linje, "returner ") eller t.inneholder(linje, "{ returner ") {
                retur = sann
            }
        }
        i = i + 1
    }
    returner signatur og blokk og retur
}

funksjon start() -> heiltall {
    // Ekte kjelder, både krøllparentesar og historisk 'slutt'.
    assert(ser_ut_som_norscode(fil_les("compiler/compiler.no")) == sann)
    assert(ser_ut_som_norscode(fil_les("std/tomllib.no")) == sann)
    assert(ser_ut_som_norscode(fil_les("std/ghash.no")) == sann)
    assert(ser_ut_som_norscode(fil_les("toolchain/norspkg/cache.no")) == sann)

    // Små positive døme for begge blokkstilane.
    assert(ser_ut_som_norscode("funksjon dobbel(x: heiltall) -> heiltall {\n    returner x + x\n}") == sann)
    assert(ser_ut_som_norscode("funksjon svar()\n    returner 42\nslutt") == sann)

    // Vanleg norsk tekst, kommentarar og strengar er ikkje programkode.
    assert(ser_ut_som_norscode("Dette er en vanlig tekstfil på norsk.") == usann)
    assert(ser_ut_som_norscode("# Kontaktinformasjon\nhttps://eksempel.no") == usann)
    assert(ser_ut_som_norscode("En funksjon brukes for å beskrive formål.") == usann)
    assert(ser_ut_som_norscode("Vennligst returner varen innen fristen.") == usann)
    assert(ser_ut_som_norscode("En pakke kan brukes til transport.") == usann)
    assert(ser_ut_som_norscode("funksjon start() er nevnt i denne teksten, men ingen programblokk finnes. returner varen.") == usann)
    assert(ser_ut_som_norscode("# funksjon falsk() {\n# returner 1\n# }") == usann)
    assert(ser_ut_som_norscode("// funksjon falsk() {\n// returner 1\n// }") == usann)
    assert(ser_ut_som_norscode("\"funksjon falsk() {\"\n\"returner 1\"") == usann)
    assert(ser_ut_som_norscode("funksjon omtale()\nDette er en { klamme.\nVennligst returner pakken.") == usann)
    assert(ser_ut_som_norscode("funksjon tom() {\n    skriv(\"hei\")\n}") == usann)

    skriv("test_github_linguist_detector_prototype OK")
    returner 0
}
