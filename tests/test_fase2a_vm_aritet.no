# Fase 2a / 2.1: aritetskontroll i bytekode-kall.
# Eit dynamisk kall (builtin.ncb_call_fn) til ein 2-param-funksjon med FEIL tal
# argument gav SIGSEGV før fiksen (arg_verdiar[pi] utanfor lista). No skal det gje
# eit FANGBART unntak. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # For få argument (1 til ein 2-param-fn) → fangbart unntak, ikkje krasj.
    la p_underflow = "funksjon add(a: heltall, b: heltall) -> heltall { returner a + b }\n" +
        "funksjon start() -> tekst {\n" +
        "    prøv {\n" +
        "        la r = builtin.ncb_call_fn(\"__main__.add\", 5)\n" +
        "        returner \"INGEN-FEIL\"\n" +
        "    } fang (e) {\n" +
        "        returner \"FANGA\"\n" +
        "    }\n" +
        "}\n"
    assert_eq(utfor(p_underflow), "FANGA")

    # For mange argument (3 til ein 2-param-fn) → også fangbart.
    la p_overflow = "funksjon add(a: heltall, b: heltall) -> heltall { returner a + b }\n" +
        "funksjon start() -> tekst {\n" +
        "    prøv {\n" +
        "        la r = builtin.ncb_call_fn(\"__main__.add\", 5, 6, 7)\n" +
        "        returner \"INGEN-FEIL\"\n" +
        "    } fang (e) {\n" +
        "        returner \"FANGA\"\n" +
        "    }\n" +
        "}\n"
    assert_eq(utfor(p_overflow), "FANGA")

    # Rett aritet skal framleis fungere som før.
    la p_ok = "funksjon add(a: heltall, b: heltall) -> heltall { returner a + b }\n" +
        "funksjon start() -> heltall { returner builtin.ncb_call_fn(\"__main__.add\", 5, 7) }\n"
    assert_eq(utfor(p_ok), "12")

    skriv("test_fase2a_vm_aritet OK\n")
    returner 0
}
