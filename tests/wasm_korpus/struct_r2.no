# WASM-korpus (W2, R2): resten av R2-objektmodellen. Konstruktør med posisjonelle argument
# og standardverdi (__antal__), typenamn, er_instans for struktur, grensesnitt og ikkje-
# strukturar, skjulte merke i nøkler/verdier/lengde/for/json_stringify, fangbar MetodeFeil
# (ukjend metode, ingenting- og heiltal-mottakar), ArgumentFeil ved feil aritet, closure i eit
# felt kalla som metode, metodenamn over blokkgrenser (og/eller i argumentet), ein struktur
# som unnatak fanga på typenamnet, og R2/F08: blanda + og fangbar TypeFeil for - * / % og
# unær minus på ikkje-tal. Fasiten er VM-utskrifta til R2-seeden.
#= p: 3 7 10
#= q: 1 5 2 3
#= typenamn: Punkt heltall tekst liste ordbok boolsk
#= instans: sann usann sann usann usann sann
#= nøklar: 2 x y | verdier: 3 7 | for: x y
#= json: {"x":3,"y":7}
#= fanga: MetodeFeil: Punkt har ingen metode finst_ikkje()
#= fanga: MetodeFeil: kan ikkje kalle metoden x() på ingenting
#= fanga: MetodeFeil: heiltall har ingen metode lengd()
#= fanga: ArgumentFeil: Aritetsfeil ved dynamisk kall til __main__.Punkt.sum: forventa 1 argument, fekk 2
#= closure: 5 8
#= velg: 3 0 3
#= feil: Rute 9
#= blanda: 1x x2.5 sann!
#= TypeFeil: operatoren - krev tal, fekk tekst og heiltall
#= TypeFeil: operatoren + krev tal eller tekst, fekk null og heiltall
#= TypeFeil: operatoren * krev tal, fekk liste og heiltall
#= TypeFeil: operatoren / krev tal, fekk tekst og heiltall
#= TypeFeil: operatoren % krev tal, fekk Punkt og heiltall
#= TypeFeil: unær - krev eit tal, fekk tekst

grensesnitt Form {
    funksjon areal(self) -> heltall
}

struktur Punkt {
    x: heltall
    y: heltall = 7
}

struktur Rute implementerer Form {
    s: heltall
}

struktur Teljar {
    n: heltall = 1
    skritt: heltall = 2
}

funksjon Punkt.sum(self) -> heltall {
    returner self.x + self.y
}

funksjon Rute.areal(self) -> heltall {
    returner self.s * self.s
}

# Metodenamnet står før argumenta; `og`/`eller` i eit argument lagar nye blokker i NCB-en
funksjon Punkt.velg(self, b) -> heltall {
    hvis b { returner self.x }
    returner 0
}

funksjon typefeil(f) -> heltall {
    prøv {
        f()
    } fang (e: TypeFeil) {
        skriv(tekst(e) + "\n")
    }
    returner 0
}

funksjon start() -> heltall {
    la p = Punkt(3)
    skriv("p: " + tekst(p.x) + " " + tekst(p.y) + " " + tekst(p.sum()) + "\n")
    la t = Teljar()
    la t2 = Teljar(5)
    skriv("q: " + tekst(t.n) + " " + tekst(t2.n) + " " + tekst(t2.skritt) + " " + tekst(t.n + t.skritt) + "\n")
    skriv("typenamn: " + typenamn(p) + " " + typenamn(5) + " " + typenamn("a") + " " + typenamn([1]) + " " +
          typenamn({"a": 1}) + " " + typenamn(sann) + "\n")
    la r = Rute(3)
    skriv("instans: " + tekst(er_instans(r, Form)) + " " + tekst(er_instans(p, Form)) + " " + tekst(er_instans(r, Rute)) + " " +
          tekst(er_instans(5, Rute)) + " " + tekst(er_instans({"__type__": "Rute"}, Rute)) + " " + tekst(er_instans(p, Punkt)) + "\n")
    la nk = nøkler(p)
    la vs = verdier(p)
    la iter = ""
    for k i p {
        iter = iter + " " + k
    }
    skriv("nøklar: " + tekst(lengde(nk)) + " " + nk[0] + " " + nk[1] + " | verdier: " + tekst(vs[0]) + " " + tekst(vs[1]) + " | for:" + iter + "\n")
    skriv("json: " + json_stringify(p) + "\n")
    prøv {
        p.finst_ikkje()
    } fang (e) {
        skriv("fanga: " + tekst(e) + "\n")
    }
    la n = ingenting
    prøv {
        n.x()
    } fang (e: MetodeFeil) {
        skriv("fanga: " + tekst(e) + "\n")
    }
    prøv {
        la tal = 5
        tal.lengd()
    } fang (e: MetodeFeil) {
        skriv("fanga: " + tekst(e) + "\n")
    }
    prøv {
        skriv(tekst(p.sum(1)))
    } fang (e) {
        skriv("fanga: " + tekst(e) + "\n")
    }
    la k = 3
    la d = {"op": fun(a, b) -> a + b, "gong": fun(a) -> a * k}
    skriv("closure: " + tekst(d.op(2, 3)) + " " + tekst(d.gong(2) + 2) + "\n")
    la a = sann
    skriv("velg: " + tekst(p.velg(a og p.x > 2)) + " " + tekst(p.velg(usann og a)) + " " + tekst(p.velg(usann eller a)) + "\n")
    prøv {
        kast Rute(9)
    } fang (e: Rute) {
        skriv("feil: " + typenamn(e) + " " + tekst(e.s) + "\n")
    }
    skriv("blanda: " + (1 + "x") + " " + ("x" + 2.5) + " " + (sann + "!") + "\n")
    typefeil(fun() -> "x" - 1)
    typefeil(fun() -> ingenting + 1)
    typefeil(fun() -> [1] * 2)
    typefeil(fun() -> "x" / 0)
    typefeil(fun() -> p % 2)
    typefeil(fun() -> -"a")
    returner 0
}
