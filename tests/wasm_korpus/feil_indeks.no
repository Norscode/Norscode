# WASM-korpus (W1): indeks utanfor lista stoppar programmet med same feiltekst som VM-en.
#= l[2] = 30
#= ERROR: IndeksFeil: indeks 3 utanfor lista (lengde 3) ved __main__.hent

funksjon hent(l: liste, i: heltall) {
    returner l[i]
}

funksjon start() -> heltall {
    la l = [10, 20, 30]
    skriv("l[2] = " + tekst(hent(l, 2)) + "\n")
    skriv("l[3] = " + tekst(hent(l, 3)) + "\n")
    returner 0
}
