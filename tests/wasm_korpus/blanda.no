# WASM-korpus (W1): blanda typar der VM-en har definert åtferd på både macOS-arm64 og
# Linux-x86-64: tekst + x er konkatenering med tekst(x), heiltal + desimaltall, ordna
# samanlikning (null tel som 0 mot tal; ulike typar er aldri mindre/større), likskap
# (1 == 1.0, men 1 != "1" og sann != 1), sanningsverdiar og type().
# Kombinasjonar der VM-ane er usamde (1 + "x", sann + 1, "" og 0.0 som sanning, heiltalsnøklar
# i ordbøker) er ikkje med; sjå docs/WASM_KLIENT.md.
#= a1 x2.5 xsann x x[verdi] 3.5
#= <: sann usann usann sann usann usann
#= <=: sann sann usann
#= ==: sann usann usann usann sann sann usann sann
#= ikkje: sann sann sann usann usann usann usann
#= type: heltall desimaltall tekst boolsk ingenting liste ordbok
#= tekst: sann usann || [verdi] [verdi]
#= heltall(sann) = 1, heltall(7) = 7
#= hvis: ja nei nei ja

funksjon b(v: bool) -> tekst {
    returner tekst(v)
}

funksjon lt(x, y) -> tekst {
    returner tekst(x < y)
}

funksjon ik(x) -> tekst {
    returner tekst(ikkje x)
}

funksjon ja(x) -> tekst {
    hvis x {
        returner "ja"
    }
    returner "nei"
}

funksjon start() -> heltall {
    la n = null
    skriv("a" + 1 + " " + ("x" + 2.5) + " " + ("x" + sann) + " " + ("x" + n) + " " + ("x" + [1]) + " " + tekst(1 + 2.5) + "\n")
    skriv("<: " + lt(1, 2.5) + " " + lt(1, "x") + " " + lt("x", 1) + " " + lt(n, 1) + " " + lt(sann, 2) + " " +
          lt([1], [2]) + "\n")
    skriv("<=: " + b(n <= n) + " " + b(2 <= 2.0) + " " + b(-1 >= n) + "\n")
    la d = {"a": 1}
    la d2 = d
    skriv("==: " + b(1 == 1.0) + " " + b(1 == "1") + " " + b(sann == 1) + " " + b(n == 0) + " " + b(n == null) +
          " " + b(d == d2) + " " + b(d == {"a": 1}) + " " + b("ab" == "a" + "b") + "\n")
    skriv("ikkje: " + ik(0) + " " + ik(n) + " " + ik(usann) + " " + ik([]) + " " + ik("a") + " " + ik({}) + " " + ik(1) + "\n")
    skriv("type: " + builtin.type(1) + " " + builtin.type(1.5) + " " + builtin.type("") + " " + builtin.type(sann) + " " +
          builtin.type(n) + " " + builtin.type([]) + " " + builtin.type({}) + "\n")
    skriv("tekst: " + tekst(sann) + " " + tekst(usann) + " |" + tekst(n) + "| " + tekst([1]) + " " + tekst({"a": 1}) + "\n")
    skriv("heltall(sann) = " + tekst(heltall(sann)) + ", heltall(7) = " + tekst(heltall(7)) + "\n")
    skriv("hvis: " + ja(1) + " " + ja(0) + " " + ja(n) + " " + ja("x") + "\n")
    returner 0
}
