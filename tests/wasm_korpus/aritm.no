# WASM-korpus (W0): heiltalsaritmetikk, rekursjon, store tal (boks-vegen), divisjon og
# rest med negative tal (trunkerande som i VM-en), bitoperasjonar, samanlikningar,
# og/eller/ikkje, ein modulglobal og kall. Verdiane blir skrivne inn i sida med
# sett_tekst; tests/test_wasm_w0_chrome.no samanliknar dei med VM-en (same funksjonar).
bruk std.wasm_vert som vert

la n_kall: heltall = 0

funksjon fak(n: heltall) -> heltall {
    n_kall = n_kall + 1
    hvis n <= 1 {
        returner 1
    }
    returner n * fak(n - 1)
}

funksjon kall_tal() -> heltall {
    returner n_kall
}

funksjon deling() -> heltall {
    returner (-7 / 2) * 1000 + (-7 % 3) * 100 + (7 % -3) * 10 + 7 / 2
}

funksjon bitar() -> heltall {
    la a = (1 << 40) | 5
    returner (a ^ 3) + ((a >> 38) & 7) - (-9 >> 1)
}

funksjon logikk(a: heltall, b: heltall) -> heltall {
    hvis a > 0 og b > 0 {
        returner 1
    } ellers hvis a > 0 eller b > 0 {
        returner 2
    } ellers hvis ikkje (a == b) {
        returner 3
    }
    returner 4
}

funksjon logikk_kode() -> heltall {
    returner logikk(1, 1) * 1000 + logikk(1, 0) * 100 + logikk(0, 0) * 10 + logikk(-1, -2)
}

funksjon grenser() -> heltall {
    # Rundt i31-grensa: 2^30 - 1 er i31, 2^30 er boks; summen må vere eksakt.
    la små = 1073741823
    la stor = små + 1
    la lik = 0
    hvis stor - 1 == små { lik = 1 }
    hvis stor != små { lik = lik + 10 }
    hvis stor >= små og små <= stor og ikkje (stor < små) { lik = lik + 100 }
    returner stor * 4 + lik - -1073741824
}

funksjon start() -> heltall {
    vert.sett_tekst(vert.finn("h1"), fak(20))
    vert.sett_tekst(vert.finn("main > p"), deling())
    vert.sett_tekst(vert.finn("#knapp"), bitar())
    vert.sett_tekst(vert.finn("#ut"), logikk_kode())
    vert.sett_tekst(vert.finn("#sum"), grenser())
    vert.sett_tekst(vert.finn("a"), kall_tal())
    returner 0
}
