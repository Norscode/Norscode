# WASM-korpus (W2): endeleg-rekkjefølgja. endeleg køyrer ved returner inne i prøv og fang
# (returverdien blir halden), nøsta endeleg ved returner (indre før ytre), unnatak gjennom
# endeleg i to rammer før fang i kallaren, endeleg etter normal flyt, og endeleg før ein ytre
# fang. Fasiten er lik på macOS- og Linux-VM-en.
#= a prøv 3
#= a endeleg 3
#= a(3) = 6
#= a prøv -3
#= a fang AFeil: negativ
#= a endeleg -3
#= a(-3) = -1
#= b indre
#= b indre endeleg
#= b ytre endeleg
#= b() = 7
#= c kastar
#= c endeleg
#= d endeleg
#= start fanga CFeil: frå c
#= e() = 11
#= endeleg før ytre fang
#= ytre Indre: x

funksjon a(x: heltall) -> heltall {
    prøv {
        skriv("a prøv " + tekst(x) + "\n")
        hvis x > 0 {
            returner x * 2
        }
        kast "AFeil: negativ"
    } fang (e) {
        skriv("a fang " + e + "\n")
        returner -1
    } endeleg {
        skriv("a endeleg " + tekst(x) + "\n")
    }
    returner 0
}

funksjon b() -> heltall {
    prøv {
        prøv {
            skriv("b indre\n")
            returner 7
        } endeleg {
            skriv("b indre endeleg\n")
        }
    } endeleg {
        skriv("b ytre endeleg\n")
    }
    returner 0
}

funksjon c() -> heltall {
    prøv {
        skriv("c kastar\n")
        kast "CFeil: frå c"
    } endeleg {
        skriv("c endeleg\n")
    }
    returner 0
}

funksjon d() -> heltall {
    prøv {
        c()
    } endeleg {
        skriv("d endeleg\n")
    }
    returner 1
}

funksjon e() -> heltall {
    la r = 0
    prøv {
        r = 1
    } fang (f) {
        r = 2
    } endeleg {
        r = r + 10
    }
    returner r
}

funksjon start() -> heltall {
    skriv("a(3) = " + tekst(a(3)) + "\n")
    skriv("a(-3) = " + tekst(a(-3)) + "\n")
    skriv("b() = " + tekst(b()) + "\n")
    prøv {
        d()
    } fang (x: CFeil) {
        skriv("start fanga " + x + "\n")
    }
    skriv("e() = " + tekst(e()) + "\n")
    prøv {
        prøv {
            kast "Indre: x"
        } endeleg {
            skriv("endeleg før ytre fang\n")
        }
    } fang (x) {
        skriv("ytre " + x + "\n")
    }
    returner 0
}
