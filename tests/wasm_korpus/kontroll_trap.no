# WASM-korpus, KONTROLL (ikkje paritet, ingen fasit): liste − tal har ikkje definert
# oppførsel i VM-en, og i WASM er det ein rein trap som når JavaScript som «Uncaught (in
# promise) RuntimeError». tests/test_wasm_korpus_chrome.no brukar programmet som positiv
# kontroll: konsollsjekken for «Uncaught» må slå ut her, elles diskriminerer han ikkje.
funksjon start() -> heltall {
    skriv("før\n")
    la l = [1]
    skriv(tekst(l - 1) + "\n")
    returner 0
}
