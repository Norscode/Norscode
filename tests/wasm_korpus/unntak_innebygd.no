# WASM-korpus (W2): innebygde feil er fangbare Norscode-unnatak med same tekst som VM-en:
# DivisjonMedNull og ModuloMedNull (typa), IndeksFeil ved lesing (typa) og skriving,
# Ugyldig heiltall, og ein typa handterar som ikkje passar, slik at feilen går til den ytre.
# Fasiten er lik på macOS- og Linux-VM-en.
#= 1: DivisjonMedNull: divisjon med null ved __main__.del
#= 2: ModuloMedNull: modulo med null ved __main__.rest
#= 3: IndeksFeil: indeks 3 utanfor lista (lengde 3) ved __main__.hent
#= 4: IndeksFeil: indeks -1 utanfor lista (lengde 3) ved __main__.start
#= 5: Ugyldig heiltall: 12x
#= 6: ytre DivisjonMedNull: divisjon med null ved __main__.del

funksjon del(a: heltall, b: heltall) -> heltall {
    returner a / b
}

funksjon rest(a: heltall, b: heltall) -> heltall {
    returner a % b
}

funksjon hent(l, i: heltall) {
    returner l[i]
}

funksjon start() -> heltall {
    prøv {
        del(1, 0)
    } fang (e: DivisjonMedNull) {
        skriv("1: " + e + "\n")
    }
    prøv {
        rest(5, 0)
    } fang (e: ModuloMedNull) {
        skriv("2: " + e + "\n")
    }
    la l = [1, 2, 3]
    prøv {
        skriv(tekst(hent(l, 3)) + "\n")
    } fang (e: IndeksFeil) {
        skriv("3: " + e + "\n")
    }
    prøv {
        l[-1] = 9
    } fang (e) {
        skriv("4: " + e + "\n")
    }
    prøv {
        skriv(tekst(heltall("12x")) + "\n")
    } fang (e) {
        skriv("5: " + e + "\n")
    }
    prøv {
        prøv {
            del(1, 0)
        } fang (e: ModuloMedNull) {
            skriv("feil handterar\n")
        }
    } fang (e: DivisjonMedNull) {
        skriv("6: ytre " + e + "\n")
    }
    returner 0
}
