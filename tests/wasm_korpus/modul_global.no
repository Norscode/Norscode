# WASM-korpus (W2, R2/F14): globalar på tvers av modular og toppnivå-setningar.
# mb.NAMN/mb.teljar blir LOAD_GLOBAL NAMN modul, mb.teljar = … og mb.teljar += … blir
# STORE_GLOBAL med modulnamn; modulen tests.fixtures.wasm_r2_modul er berre nådd gjennom
# globalane sine. tests.fixtures.wasm_r2_sideverknad blir importert utan å brukast, men
# toppnivå-setninga hennar køyrer (som i VM-en). Hovudmodulen har ein struktur i ein global og
# ei toppnivå-setning; initialiseringane køyrer i avhengnadsrekkjefølgje før start().
#= init modul
#= init sideverknad
#= init hovud 6
#= modb 10
#= 16 6 2
#= 3

bruk tests.fixtures.wasm_r2_modul som mb
bruk tests.fixtures.wasm_r2_sideverknad som sv

struktur Boks {
    v: heltall
}

funksjon Boks.dobbel(self) -> heltall {
    returner self.v * 2
}

la boks = Boks(3)
skriv("init hovud " + tekst(boks.dobbel()) + "\n")

funksjon start() -> heltall {
    skriv(mb.NAMN + " " + tekst(mb.teljar) + "\n")
    mb.teljar = mb.teljar + 5
    mb.teljar += 1
    skriv(tekst(mb.teljar) + " " + tekst(boks.dobbel()) + " " + tekst(lengde(mb.liste)) + "\n")
    legg_til(mb.liste, 4)
    skriv(tekst(lengde(mb.liste)) + "\n")
    returner 0
}
