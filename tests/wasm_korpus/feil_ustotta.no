# WASM-korpus (W0), NEGATIV: alt her ligg utanfor W0-subsettet og skal gje
# kompileringsfeil (fail-closed), med alle funna i éin rapport.
bruk std.wasm_vert som vert

funksjon flyttal() -> heltall {
    la x = 2.5
    returner 1
}

funksjon liste() -> heltall {
    la l = [1, 2]
    returner 0
}

funksjon tekst_verdi() -> heltall {
    la s = "hei"
    returner 0
}

funksjon ukjend_builtin() -> heltall {
    returner builtin.lengde_ukjend(3)
}

funksjon start() -> heltall {
    flyttal()
    liste()
    tekst_verdi()
    ukjend_builtin()
    vert.test_klikk(vert.finn("#knapp"))
    vert.lytt_klikk(vert.finn("#knapp"), "finst_ikkje")
    returner 0
}
