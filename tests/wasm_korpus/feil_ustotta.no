# WASM-korpus, NEGATIV: alt her ligg utanfor subsettet som er støtta (W1) og skal gje
# kompileringsfeil (fail-closed), med alle funna i éin rapport: hopp ut av ei prøv-blokk
# (bryt) og utsett i ei lykkje (W2: unnatakstilstanden ville vere ulik der vegane møtest),
# ukjende builtins (også område, som VM-en heller ikkje har), ein vertsfunksjon med tekst
# som ikkje er ein konstant i kjelda, test_klikk utanfor testbygg og lytt_klikk til ein
# funksjon som ikkje finst.
bruk std.wasm_vert som vert

funksjon bryt_i_prøv() -> heltall {
    la i = 0
    mens i < 3 {
        prøv {
            hvis i == 1 {
                bryt
            }
        } fang (e) {
            returner 2
        }
        i = i + 1
    }
    returner i
}

funksjon utsett_i_lykkje() -> heltall {
    la i = 0
    mens i < 2 {
        utsett {
            skriv("x")
        }
        i = i + 1
    }
    returner i
}

funksjon omraade() -> heltall {
    la s = 0
    for i i område(0, 3) {
        s = s + i
    }
    returner s
}

funksjon ukjend_builtin() -> heltall {
    returner builtin.lengde_ukjend(3)
}

funksjon ikkje_konstant() -> heltall {
    la sel = "#knapp"
    returner vert.finn(sel)
}

funksjon start() -> heltall {
    bryt_i_prøv()
    utsett_i_lykkje()
    omraade()
    ukjend_builtin()
    ikkje_konstant()
    vert.test_klikk(vert.finn("#knapp"))
    vert.lytt_klikk(vert.finn("#knapp"), "finst_ikkje")
    builtin.ukjend()
    returner 0
}
