# WASM-korpus (W1): lister. BUILD_LIST, indeks les/skriv, legg_til med vekst, lengde,
# for-lykkje, strukturell likskap, nøsta lister, utsnitt, og lister som argument og retur.
#= [1, 2, 3] lengde 3, sum 6
#= etter l[0] = 9: 9 2 3
#= legg_til: lengde 1003, l[1002] = 999, sum 499514
#= lik: sann usann usann sann
#= nøsta: 3 x 2
#= utsnitt: 2 [20, 30]
#= tekst(liste) = [verdi], type = liste
#= tom: 0
#= snudd: [3, 2, 1]
#= kvadrat: [1, 4, 9, 16]
#= blanda: [1, a, 2.5, sann, ]

funksjon vis(l: liste) -> tekst {
    la ut = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { ut = ut + ", " }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut + "]"
}

funksjon snu(l: liste) -> liste {
    la ut = []
    la i = lengde(l) - 1
    mens i >= 0 {
        legg_til(ut, l[i])
        i = i - 1
    }
    returner ut
}

funksjon kvadrat(l: liste) -> liste {
    la ut = []
    for x i l {
        legg_til(ut, x * x)
    }
    returner ut
}

funksjon b(v: bool) -> tekst {
    returner tekst(v)
}

funksjon start() -> heltall {
    la l = [1, 2, 3]
    la s = 0
    for x i l {
        s = s + x
    }
    skriv(vis(l) + " lengde " + tekst(lengde(l)) + ", sum " + tekst(s) + "\n")
    l[0] = 9
    skriv("etter l[0] = 9: " + tekst(l[0]) + " " + tekst(l[1]) + " " + tekst(l[2]) + "\n")
    la i = 0
    mens i < 1000 {
        legg_til(l, i)
        i = i + 1
    }
    la sum = 0
    for v i l {
        sum = sum + v
    }
    skriv("legg_til: lengde " + tekst(lengde(l)) + ", l[1002] = " + tekst(l[1002]) + ", sum " + tekst(sum) + "\n")
    skriv("lik: " + b([1, [2, "a"]] == [1, [2, "a"]]) + " " + b([1, 2] == [1, 3]) + " " + b([1, 2] == [1, 2, 3]) +
          " " + b([] == []) + "\n")
    la n = [[1, 2, 3], ["x", "y"]]
    skriv("nøsta: " + tekst(lengde(n[0])) + " " + n[1][0] + " " + tekst(lengde(n[1])) + "\n")
    la u = builtin.slice([10, 20, 30], 1, 3)
    skriv("utsnitt: " + tekst(lengde(u)) + " " + vis(u) + "\n")
    skriv("tekst(liste) = " + tekst(l) + ", type = " + builtin.type(l) + "\n")
    skriv("tom: " + tekst(lengde([])) + "\n")
    skriv("snudd: " + vis(snu([1, 2, 3])) + "\n")
    skriv("kvadrat: " + vis(kvadrat([1, 2, 3, 4])) + "\n")
    skriv("blanda: " + vis([1, "a", 2.5, sann, null]) + "\n")
    returner 0
}
