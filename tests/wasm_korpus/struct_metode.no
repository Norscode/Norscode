# WASM-korpus (W2): strukturar og metodar slik kompilatoren lowrar dei i dag: Type() gjev ei
# ordbok med «__type__», felt er nøklar, p.metode(args) blir builtin.ncb_call_fn(modul + "." +
# p["__type__"] + ".metode", p, args…). Metode som endrar self og kallar ein annan metode,
# dispatch på to typar med same metodenamn, nøkkelrekkjefølgja og ei liste med blanda
# strukturar. Fasiten er lik på macOS- og Linux-VM-en.
#= sum: 7
#= flytt: 37 (13, 24)
#= kvadrat: 25 kvadrat 5
#= type: ordbok Punkt Kvadrat
#= nøklar: 3 __type__ x y
#= total: 64

struktur Punkt {
    x: heltall
    y: heltall
}

struktur Kvadrat {
    s: heltall
}

funksjon Punkt.sum(self) -> heltall {
    returner self.x + self.y
}

funksjon Punkt.flytt(self, dx: heltall, dy: heltall) -> heltall {
    self.x = self.x + dx
    self.y = self.y + dy
    returner self.sum()
}

funksjon Punkt.vis(self) -> tekst {
    returner "(" + tekst(self.x) + ", " + tekst(self.y) + ")"
}

funksjon Kvadrat.sum(self) -> heltall {
    returner self.s * self.s
}

funksjon Kvadrat.vis(self) -> tekst {
    returner "kvadrat " + tekst(self.s)
}

funksjon nytt_punkt(x: heltall, y: heltall) {
    la p = Punkt()
    p.x = x
    p.y = y
    returner p
}

funksjon start() -> heltall {
    la p = nytt_punkt(3, 4)
    skriv("sum: " + tekst(p.sum()) + "\n")
    skriv("flytt: " + tekst(p.flytt(10, 20)) + " " + p.vis() + "\n")
    la q = Kvadrat()
    q.s = 5
    skriv("kvadrat: " + tekst(q.sum()) + " " + q.vis() + "\n")
    skriv("type: " + builtin.type(p) + " " + p["__type__"] + " " + q["__type__"] + "\n")
    la nk = nøkler(p)
    skriv("nøklar: " + tekst(lengde(nk)) + " " + nk[0] + " " + nk[1] + " " + nk[2] + "\n")
    la former = [p, q, nytt_punkt(1, 1)]
    la total = 0
    la i = 0
    mens i < lengde(former) {
        la f = former[i]
        total = total + f.sum()
        i = i + 1
    }
    skriv("total: " + tekst(total) + "\n")
    returner 0
}
