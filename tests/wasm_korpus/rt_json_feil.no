# WASM-korpus (W3): ugyldig JSON kastar fangbart frå std.wasm_rt.json_parse (som
# builtin.json_parse_raw blir kopla til i WASM). Programmet kallar rt-funksjonen direkte, så
# same Norscode-kode køyrer i VM-en og i nettlesaren (VM-en sin json_parse_raw kastar ikkje).
# Feiltekstane følgjer selfhost/json.no («JSON: uavslutta streng», «JSON: uventa teikn: X»),
# og «JSON: …» kan fangast typa med fang (e: JSON). Gyldig input gjev same verdi som builtinen.
#= 0: JSON: uventa slutt
#= 1: JSON: uventa slutt
#= 2: JSON: uventa slutt
#= 3: JSON: uventa teikn: x
#= 4: JSON: uavslutta streng
#= 5: JSON: uventa teikn: 2
#= 6: JSON: uventa teikn: 1
#= 7: JSON: uventa teikn: 2
#= 8: JSON: uventa slutt
#= 9: JSON: uventa teikn: a
#= 10: JSON: uventa teikn: 1
#= 11: JSON: uventa slutt
#= 12: JSON: uventa slutt
#= 13: JSON: ugyldig escape: \x
#= 14: JSON: ugyldig \u-escape
#= 15: JSON: uventa teikn: ]
#= 16: JSON: uventa teikn: }
#= 17: JSON: uventa teikn: æ
#= 18: JSON: uventa slutt
#= 19: JSON: uavslutta streng
#= 20: JSON: uventa slutt
#= 21: JSON: uventa teikn: ]
#= ytre: JSON: uventa teikn: }
#= tekst: JSON: uventa slutt
#= lik {"a":[1,2.5,"x"],"b":{"c":null}}
#= lik [true,false]
#= lik "æ\n"
#= lik -12
#= lik 6.02e23
bruk std.wasm_rt som rt

funksjon prøv_les(s: tekst) -> tekst {
    prøv {
        returner "ok " + json_stringify(rt.json_parse(s))
    } fang (e: JSON) {
        returner tekst(e)
    }
}

funksjon ytre(s: tekst) -> tekst {
    # Unnataket går gjennom to rammer utan handterar
    returner rt.json_skriv(rt.json_parse(s))
}

funksjon start() -> heltall {
    la inn = ["", "[1,", "{\"a\": ", "x", "\"abc", "1 2", "{\"a\" 1}", "[1 2]", "tru", "{a:1}", "01", "1.", "-",
              "\"\\x\"", "\"\\u12G4\"", "[1,]", "{\"a\":1,}", "æ", "1e", "\"\\u00", "nul", "[]]"]
    la i = 0
    mens i < lengde(inn) {
        skriv(tekst(i) + ": " + prøv_les(inn[i]) + "\n")
        i = i + 1
    }
    prøv {
        skriv(ytre("{\"a\":[1,2,}") + "\n")
    } fang (e) {
        skriv("ytre: " + tekst(e) + "\n")
    }
    # Feilen er tekst (fang (e: tekst) fangar han òg), og ein annan type slepp han forbi
    prøv {
        prøv {
            rt.json_parse("[")
        } fang (e: heiltall) {
            skriv("feil handterar\n")
        }
    } fang (e: tekst) {
        skriv("tekst: " + tekst(e) + "\n")
    }
    # Gyldig: same verdi som builtin.json_parse_raw
    la gyldige = ["{\"a\":[1,2.5,\"x\"],\"b\":{\"c\":null}}", " [ true , false ] ", "\"\\u00e6\\n\"", "-12", "6.02e23"]
    la j = 0
    mens j < lengde(gyldige) {
        la a = rt.json_skriv(rt.json_parse(gyldige[j]))
        la b = json_stringify(builtin.json_parse_raw(gyldige[j]))
        hvis a == b {
            skriv("lik " + a + "\n")
        } ellers {
            skriv("ULIK " + a + " / " + b + "\n")
        }
        j = j + 1
    }
    returner 0
}
