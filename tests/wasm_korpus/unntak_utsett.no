# WASM-korpus (W2): utsett. Blokkene køyrer i omvend rekkjefølgje ved returner (verdien blir
# halden), og ved eit unnatak før det går vidare til kallaren, ramme for ramme. Fasiten er
# lik på macOS- og Linux-VM-en.
#= f kropp
#= f utsett 2
#= f utsett 1
#= f() = 5
#= g utsett 1
#= g(1) = 2
#= g utsett -1
#= h utsett
#= fanga GFeil: -1

funksjon f() -> heltall {
    utsett {
        skriv("f utsett 1\n")
    }
    utsett {
        skriv("f utsett 2\n")
    }
    skriv("f kropp\n")
    returner 5
}

funksjon g(x: heltall) -> heltall {
    utsett {
        skriv("g utsett " + tekst(x) + "\n")
    }
    hvis x < 0 {
        kast "GFeil: " + tekst(x)
    }
    returner x + 1
}

funksjon h() -> heltall {
    utsett {
        skriv("h utsett\n")
    }
    returner g(-1)
}

funksjon start() -> heltall {
    skriv("f() = " + tekst(f()) + "\n")
    skriv("g(1) = " + tekst(g(1)) + "\n")
    prøv {
        h()
    } fang (e: GFeil) {
        skriv("fanga " + e + "\n")
    }
    returner 0
}
