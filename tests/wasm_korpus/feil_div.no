# WASM-korpus (W1): deling på null stoppar programmet med same feiltekst som VM-en
# (DivisjonMedNull … ved <funksjon>); utskrifta før feilen kjem med.
#= før
#= ERROR: DivisjonMedNull: divisjon med null ved __main__.del

funksjon del(a: heltall, b: heltall) -> heltall {
    returner a / b
}

funksjon start() -> heltall {
    skriv("før\n")
    skriv(tekst(del(10, 0)) + "\n")
    skriv("etter\n")
    returner 0
}
