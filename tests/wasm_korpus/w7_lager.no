# WASM-korpus (W7): dei reine funksjonane i std/wasm_lager.no — skjema og validering, nøklar,
# op-ane som JSON til lastaren (put med nøkkelsti, auto-nøkkel og eksplisitt nøkkel, indeksverdiar
# frå nøsta stiar, område, grense), transaksjonsmodus og omfang, JSON utan rå kontrollteikn,
# konvolutten frå lastaren, feilklassar, resultat (verdiar attende like, auto-nøkkel sett inn,
# øydelagd lagra verdi), LagerFeil kasta og fanga, og databasenamn per brukar (sha256).
#= skjema: «»
#= skjema: «skjemaet må vere ei liste av lager»
#= skjema: «ugyldig lagernamn «a b»»
#= skjema: «lageret «a» står to gonger»
#= skjema: «ugyldig nøkkelsti «1x» i «a»»
#= skjema: «lager_auto «a» må ha ein nøkkelsti utan punktum»
#= skjema: «indeksen «i» står to gonger i «a»»
#= skjema: «ugyldig indeksnamn «æ» i «a»»
#= skjema: «lager 1 er ikkje laga med lager.lager»
#= {"s":{"dok":{"a":false,"x":{"type":false,"post":true}},"logg":{"a":true,"x":{}},"kv":{"a":false,"x":{}}},"f":["gamal"]}
#= {"n":"nc-x","v":3,"s":{"dok":{"a":false,"x":{"type":false,"post":true}},"logg":{"a":true,"x":{}},"kv":{"a":false,"x":{}}},"f":["gamal"]}
#= nøklar: sann sann sann usann sann sann sann sann usann usann usann usann
#= {"s":"dok","m":"put","a":[{"k":7,"v":"{\"id\":7,\"type\":\"brev\",\"adresse\":{\"post\":\"0150\",\"by\":\"Oslo\"},\"tal\":[1,2.0],\"tekst\":\"æ\\\"ø\\\\å\"}","i":{"type":"brev","post":"0150"}}]}
#= {"s":"dok","m":"put","a":[{"k":"x","v":"{\"id\":\"x\",\"type\":5,\"adresse\":\"ikkje ordbok\"}","i":{"type":5}}]}
#= {"s":"dok","m":"put","a":[{"k":1,"v":"{\"id\":1,\"type\":true}","i":{}}]}
#= {"s":"logg","m":"put","a":[{"v":"{\"tekst\":\"utan nr\"}","i":{}}]}
#= {"s":"logg","m":"put","a":[{"k":4,"v":"{\"nr\":4,\"tekst\":\"med nr\"}","i":{}}]}
#= {"s":"kv","m":"put","a":[{"k":"nøkkel","v":"[1,\"to\"]","i":{}}]}
#= {"s":"dok","q":["only",7],"m":"get","a":[null]}
#= {"s":"dok","q":["bound",1,"z",false,true],"m":"delete","a":[null]}
#= {"s":"dok","q":["only","x"],"m":"delete","a":[null]}
#= {"s":"dok","q":["lowerBound",3,true],"m":"getAll","a":[null,10]}
#= {"s":"dok","m":"getAll","a":[null]}
#= {"s":"dok","q":["upperBound","m",false],"m":"getAllKeys","a":[null,2]}
#= {"s":"dok","m":"count","a":[null]}
#= {"s":"kv","m":"clear","a":[]}
#= {"s":"dok","x":"type","q":["only","brev"],"m":"getAll","a":[null]}
#= {"s":"dok","x":"post","q":["bound","01","01￿",false,false],"m":"count","a":[null]}
#= {"s":"dok","x":"post","q":["only","0150"],"m":"get","a":[null]}
#= LagerFeil data: verdien har ingen gyldig nøkkel i «id»: 
#= LagerFeil data: verdien har ingen gyldig nøkkel i «id»: 9007199254740992
#= LagerFeil data: put til lageret «ukjent», som ikkje er i skjemaet
#= LagerFeil data: put til lageret «gamal», som ikkje er i skjemaet
#= LagerFeil data: lageret «kv» har ingen nøkkelsti: bruk put_med_nøkkel
#= LagerFeil data: lageret «dok» har nøkkelsti «id»: bruk put
#= LagerFeil data: ugyldig nøkkel: sann
#= LagerFeil data: ugyldig nøkkel i området: 
#= LagerFeil data: området må vere laga med lager.lik/frå/opp_til/mellom/prefiks
#= LagerFeil data: grensa må vere eit heiltal ≥ 0
#= ingen feil
#= LagerFeil data: ugyldig indeksnamn «ikkje gyldig»
#= LagerFeil data: ugyldig lagernamn «ikkje-gyldig»
#= LagerFeil data: slett går berre på lageret, ikkje på ein indeks
#= LagerFeil data: ukjend op «ukjend»
#= {"h":0,"s":["dok","kv"],"m":"readonly","o":[{"s":"dok","m":"count","a":[null]},{"s":"kv","q":["only","a"],"m":"get","a":[null]},{"s":"dok","m":"getAll","a":[null]}]}
#= {"h":0,"s":["dok","kv","logg"],"m":"readwrite","o":[{"s":"dok","m":"count","a":[null]},{"s":"kv","m":"put","a":[{"k":"a","v":"1","i":{}}]},{"s":"logg","m":"clear","a":[]}]}
#= ["b","a"]
#= tom batch: data: ein batch må ha minst éin op
#= {"t":"a\u0001b\u001f\n\t\u0000ø"}
#= rundtur: sann, uendra utan kontrollteikn: sann
#= {"id":4,"namn":"","melding":"","data":[1,null,[]]}
#= {"id":5,"namn":"ConstraintError","melding":"Key already exists","data":null}
#= {"id":6,"namn":"blocked","melding":"","data":null}
#= feilklassar: blokkert/blokkert versjon/versjon kvote/kvote data/data data/data open/transaksjon open/transaksjon open/transaksjon open/transaksjon open/transaksjon
#= ok sann: [3,{"id":7,"type":"brev","adresse":{"post":"0150","by":"Oslo"},"tal":[1,2.0],"tekst":"æ\"ø\\å"},null,[{"tekst":"a","nr":3},{"nr":99,"tekst":"b"}],[7,"x"],2,null,null]
#= verdien attende lik: sann
#= øydelagd: usann data ugyldig lagra verdi: JSON: uventa teikn: i
#= kvote: usann {"type":"LagerFeil","art":"kvote","id":11,"op":"køyr","database":"test","namn":"QuotaExceededError","melding":"full"}
#= LagerFeil: kvote køyr test: QuotaExceededError: full
#= fanga LagerFeil: kvote køyr test: QuotaExceededError: full
#= fanga ordboka: kvote QuotaExceededError
#= nc-app-06f70cad6ae70a0a nc-app-07d5cf69a356013c nc-app-e3b0c44298fc1c14
#= ulike: sann, same: sann, uid ikkje i namnet: sann
bruk std.wasm_lager som lager
bruk std.wasm_rt som rt

funksjon j(v) -> tekst {
    returner builtin.json_stringify(v)
}

funksjon skjema() -> liste {
    returner [lager.lager("dok", "id", [lager.indeks("type", "type", usann), lager.indeks("post", "adresse.post", sann)]),
              lager.lager_auto("logg", "nr", []),
              lager.lager("kv", "", []),
              lager.fjerna("gamal")]
}

funksjon db() -> ordbok {
    returner lager.test_db("test", skjema())
}

funksjon data_feil(o: ordbok) -> heltall {
    prøv {
        lager.op_js(skjema(), o)
        skriv("ingen feil\n")
    } fang (e: LagerFeil) {
        skriv("LagerFeil " + e["art"] + ": " + e["melding"] + "\n")
    }
    returner 0
}

funksjon skjemafeil(s) -> heltall {
    skriv("skjema: «" + lager.valider_skjema(s) + "»\n")
    returner 0
}

funksjon start() -> heltall {
    # ── Skjema ──
    skjemafeil(skjema())
    skjemafeil("x")
    skjemafeil([lager.lager("a b", "", [])])
    skjemafeil([lager.lager("a", "", []), lager.lager("a", "", [])])
    skjemafeil([lager.lager("a", "1x", [])])
    skjemafeil([lager.lager_auto("a", "x.y", [])])
    skjemafeil([lager.lager("a", "id", [lager.indeks("i", "x", usann), lager.indeks("i", "y", usann)])])
    skjemafeil([lager.lager("a", "id", [lager.indeks("æ", "x", usann)])])
    skjemafeil([{"namn": "a"}])
    skriv(j(lager.skjema_json(skjema())) + "\n")
    skriv(lager.opne_json("nc-x", 3, skjema()) + "\n")
    # ── Nøklar ──
    la k = [0, -9007199254740991, 9007199254740991, 9007199254740992, 2.5, 0.0, "", "å", sann, null, [1], {}]
    la ks = ""
    la i = 0
    mens i < lengde(k) {
        ks = ks + " " + tekst(lager.er_nøkkel(k[i]))
        i = i + 1
    }
    skriv("nøklar:" + ks + "\n")
    # ── Op-ar ──
    la v = {"id": 7, "type": "brev", "adresse": {"post": "0150", "by": "Oslo"}, "tal": [1, 2.0], "tekst": "æ\"ø\\å"}
    skriv(j(lager.op_js(skjema(), lager.op_put("dok", v))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_put("dok", {"id": "x", "type": 5, "adresse": "ikkje ordbok"}))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_put("dok", {"id": 1, "type": sann}))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_put("logg", {"tekst": "utan nr"}))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_put("logg", {"nr": 4, "tekst": "med nr"}))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_put_med_nøkkel("kv", "nøkkel", [1, "to"]))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_hent("dok", 7))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_slett("dok", lager.mellom(1, "z", usann, sann)))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_slett("dok", "x"))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_liste("dok", lager.frå(3, sann), 10))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_liste("dok", null, 0))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_nøklar("dok", lager.opp_til("m", usann), 2))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_tel("dok", null))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_tøm("kv"))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_indeks_liste("dok", "type", lager.lik("brev"), 0))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_indeks_tel("dok", "post", lager.prefiks("01")))) + "\n")
    skriv(j(lager.op_js(skjema(), lager.op_indeks_hent("dok", "post", "0150"))) + "\n")
    # Feil med ein gong (og ein gyldig desimalnøkkel, som ikkje er ein feil)
    data_feil(lager.op_put("dok", {"type": "utan id"}))
    data_feil(lager.op_put("dok", {"id": 9007199254740992}))
    data_feil(lager.op_put("ukjent", {"id": 1}))
    data_feil(lager.op_put("gamal", {"id": 1}))
    data_feil(lager.op_put("kv", "utan nøkkel"))
    data_feil(lager.op_put_med_nøkkel("dok", 1, {}))
    data_feil(lager.op_put_med_nøkkel("kv", sann, {}))
    data_feil(lager.op_hent("dok", null))
    data_feil(lager.op_liste("dok", {"x": 1}, 0))
    data_feil(lager.op_liste("dok", null, -1))
    data_feil(lager.op_slett("dok", 2.5))
    data_feil(lager.op_indeks_liste("dok", "ikkje gyldig", null, 0))
    data_feil(lager.op_indeks_liste("ikkje-gyldig", "type", null, 0))
    la sl = lager.op_slett("dok", 1)
    sl["indeks"] = "type"
    data_feil(sl)
    data_feil({"op": "ukjend", "lager": "dok", "indeks": "", "område": null})
    # ── Batch ──
    la d = db()
    skriv(lager.batch_json(d, [lager.op_tel("dok", null), lager.op_hent("kv", "a"), lager.op_liste("dok", null, 0)]) + "\n")
    skriv(lager.batch_json(d, [lager.op_tel("dok", null), lager.op_put_med_nøkkel("kv", "a", 1), lager.op_tøm("logg")]) + "\n")
    skriv(j(lager.omfang([lager.op_tel("b", null), lager.op_tel("a", null), lager.op_tel("b", null)])) + "\n")
    prøv {
        lager.batch_json(d, [])
    } fang (e: LagerFeil) {
        skriv("tom batch: " + e["art"] + ": " + e["melding"] + "\n")
    }
    # ── JSON utan rå kontrollteikn ──
    la ctl = "a" + builtin.chr(1) + "b" + builtin.chr(31) + "\n\t" + builtin.chr(0) + "ø"
    la tj = lager.json_trygg(builtin.json_stringify({"t": ctl}))
    skriv(tj + "\n")
    skriv("rundtur: " + tekst(rt.json_parse(tj)["t"] == ctl) + ", uendra utan kontrollteikn: " + tekst(lager.json_trygg("[\"æ\\n\"]") == "[\"æ\\n\"]") + "\n")
    # ── Konvolutt, feilklassar og resultat ──
    skriv(j(lager.tolk_konvolutt("[4,0,0,[1,null,[]]]")) + "\n")
    skriv(j(lager.tolk_konvolutt("[5,\"ConstraintError\",\"Key already exists\"]")) + "\n")
    skriv(j(lager.tolk_konvolutt("[6,\"blocked\",null]")) + "\n")
    la namn = ["blocked", "VersionError", "QuotaExceededError", "DataError", "DataCloneError", "UnknownError", "NotFoundError", "ReferenceError", "InvalidStateError", "AbortError"]
    la fa = ""
    i = 0
    mens i < lengde(namn) {
        fa = fa + " " + lager.feil_art(namn[i], "opne") + "/" + lager.feil_art(namn[i], "køyr")
        i = i + 1
    }
    skriv("feilklassar:" + fa + "\n")
    la ops = [lager.op_put("logg", {"tekst": "a"}), lager.op_hent("dok", 7), lager.op_hent("dok", 8), lager.op_liste("logg", null, 0),
              lager.op_nøklar("dok", null, 0), lager.op_tel("dok", null), lager.op_slett("dok", 7), lager.op_tøm("kv")]
    la post_dok = {"k": 7, "v": builtin.json_stringify(v), "i": {"type": "brev"}}
    la post_logg1 = {"k": 3, "v": "{\"tekst\":\"a\"}", "i": {}}
    la post_logg2 = {"k": 4, "v": "{\"nr\":99,\"tekst\":\"b\"}", "i": {}}
    la kv = builtin.json_stringify([9, 0, 0, [3, post_dok, null, [post_logg1, post_logg2], [7, "x"], 2, null, null]])
    la r = lager.batch_resultat(d, ops, lager.tolk_konvolutt(kv))
    skriv("ok " + tekst(r["ok"]) + ": " + j(r["verdi"]) + "\n")
    skriv("verdien attende lik: " + tekst(j(r["verdi"][1]) == j(v)) + "\n")
    la øyd = builtin.json_stringify([10, 0, 0, [null, {"k": 7, "v": "{ikkje json", "i": {}}]])
    la r2 = lager.batch_resultat(d, [lager.op_tel("dok", null), lager.op_hent("dok", 7)], lager.tolk_konvolutt(øyd))
    skriv("øydelagd: " + tekst(r2["ok"]) + " " + r2["verdi"]["art"] + " " + r2["verdi"]["melding"] + "\n")
    la r3 = lager.batch_resultat(d, ops, lager.tolk_konvolutt("[11,\"QuotaExceededError\",\"full\"]"))
    skriv("kvote: " + tekst(r3["ok"]) + " " + j(r3["verdi"]) + "\n")
    skriv(lager.feil_tekst(r3["verdi"]) + "\n")
    prøv {
        lager.kast_feil(r3["verdi"])
    } fang (e: LagerFeil) {
        skriv("fanga " + tekst(e) + "\n")
    }
    prøv {
        kast r3["verdi"]
    } fang (e: LagerFeil) {
        skriv("fanga ordboka: " + e["art"] + " " + e["namn"] + "\n")
    }
    # ── Databasenamn per brukar ──
    la a = lager.brukar_db_namn("nc-app", "ola@eksempel.no")
    la b = lager.brukar_db_namn("nc-app", "kari@eksempel.no")
    skriv(a + " " + b + " " + lager.brukar_db_namn("nc-app", "") + "\n")
    skriv("ulike: " + tekst(a != b) + ", same: " + tekst(a == lager.brukar_db_namn("nc-app", "ola@eksempel.no")) + ", uid ikkje i namnet: " + tekst(ikkje builtin.contains(a, "ola")) + "\n")
    returner 0
}
