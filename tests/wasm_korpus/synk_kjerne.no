# Paritetsprogram (A7/W9): std/synk_kjerne.no i VM-en og som WASM gjev same utskrift.
# HLC, samanfletting (også i ulik rekkjefølgje), validering, JSON og ETag.
bruk std.synk_kjerne som k

funksjon lcg(x: heltall) -> heltall {
    returner (x * 1103515245 + 12345) % 2147483648
}

funksjon vis_dok(namn: tekst, d: ordbok) -> heltall {
    skriv(namn + " " + k.json_kanonisk(d) + " sletta=" + tekst(k.dok_sletta(d)) + "\n")
    returner 0
}

# Bruk op-ane i rekkjefølgja `orden` og gjev dokumentet.
funksjon køyr_ops(ops: liste, orden: liste) {
    la d = null
    la i = 0
    mens i < lengde(orden) {
        la op = ops[orden[i]]
        d = k.bruk_op(d, op, op["hlc"])["dok"]
        i = i + 1
    }
    returner d
}

funksjon start() -> heltall {
    # ── HLC ──
    la h = k.hlc_lag(1790000000000, 3, "c7")
    skriv("hlc " + h + "\n")
    skriv("send bak " + k.hlc_send(h, 1789999999000, "c7") + "\n")
    skriv("send fram " + k.hlc_send(h, 1790000000500, "c7") + "\n")
    skriv("motta lik ms " + k.hlc_motta(h, k.hlc_lag(1790000000000, 9, "s"), 1780000000000, "c7") + "\n")
    skriv("motta fjern nyare " + k.hlc_motta(h, k.hlc_lag(1790000005000, 2, "s"), 1780000000000, "c7") + "\n")
    skriv("motta klokke nyast " + k.hlc_motta(h, k.hlc_lag(1790000005000, 2, "s"), 1790000009000, "c7") + "\n")
    skriv("teljar-overflyt " + k.hlc_send(k.hlc_lag(5, 99999, "a"), 1, "a") + "\n")
    skriv("klem " + k.hlc_klem(k.hlc_lag(1790000600000, 1, "x"), 1790000000000, 60000) + "\n")
    skriv("ikkje klem " + k.hlc_klem(k.hlc_lag(1790000030000, 1, "x"), 1790000000000, 60000) + "\n")
    skriv("klem 90 s " + k.hlc_klem(k.hlc_lag(1790000090000, 2, "x"), 1790000000000, 60000) + "\n")
    skriv("ugyldig " + tekst(k.hlc_gyldig("1790000000000:0:x")) + tekst(k.hlc_gyldig("001790000000000:00000:x y")) + tekst(k.hlc_gyldig(h)) + "\n")
    skriv("samanlikn " + tekst(k.hlc_samanlikn(h, "")) + tekst(k.hlc_samanlikn("", h)) + tekst(k.hlc_samanlikn(h, h)) +
          tekst(k.hlc_samanlikn(k.hlc_lag(1, 0, "a"), k.hlc_lag(1, 0, "b"))) + "\n")
    # Klokka 5 min bak, men har motteke ein nyare verdi: neste redigering vinn.
    la tenar = k.hlc_lag(1790000300000, 0, "srv")
    la klient = k.hlc_motta("", tenar, 1790000000000, "treg")
    la redig = k.hlc_send(klient, 1790000000100, "treg")
    skriv("treg klokke vinn " + tekst(k.hlc_samanlikn(redig, tenar) > 0) + " " + redig + "\n")

    # ── Samanfletting ──
    la h1 = k.hlc_lag(100, 0, "a")
    la h2 = k.hlc_lag(200, 0, "b")
    la h3 = k.hlc_lag(300, 0, "a")
    la d1 = k.bruk_op(null, {"op": "put", "felt": {"tittel": "Kjøp mjølk", "ferdig": usann}}, h2)
    vis_dok("put", d1["dok"])
    la d2 = k.bruk_op(d1["dok"], {"op": "put", "felt": {"tittel": "eldre", "pri": 2}}, h1)
    vis_dok("eldre put", d2["dok"])
    skriv("endra " + tekst(d2["endra"]) + "\n")
    la d3 = k.bruk_op(d2["dok"], {"op": "put", "felt": {"tittel": "eldre", "pri": 2}}, h1)
    skriv("idempotent endra=" + tekst(d3["endra"]) + "\n")
    la d4 = k.bruk_op(d3["dok"], {"op": "del"}, k.hlc_lag(250, 0, "c"))
    vis_dok("del mellom", d4["dok"])
    la d5 = k.bruk_op(d4["dok"], {"op": "del"}, h3)
    vis_dok("del alt", d5["dok"])
    la d6 = k.bruk_op(d5["dok"], {"op": "put", "felt": {"tittel": "for gammal"}}, h2)
    skriv("put eldre enn del endra=" + tekst(d6["endra"]) + "\n")
    la d7 = k.bruk_op(d5["dok"], {"op": "put", "felt": {"tittel": "oppatt"}}, k.hlc_lag(400, 0, "b"))
    vis_dok("gjenoppliva", d7["dok"])
    skriv("endring " + k.endring_json(7, "oppg", "a1", d5["dok"]) + "\n")
    skriv("endring " + k.endring_json(8, "oppg", "a1", d7["dok"]) + "\n")

    # ── Konvergens: 12 tilfeldige op-ar i tre rekkjefølgjer ──
    la ops = []
    la x = 42
    la felt = ["a", "b", "c"]
    la i = 0
    mens i < 12 {
        x = lcg(x)
        la ms = 1000 + (x % 50)
        x = lcg(x)
        la node = "n" + tekst(x % 3)
        x = lcg(x)
        la hl = k.hlc_lag(ms, i, node)
        hvis x % 5 == 0 {
            legg_til(ops, {"op": "del", "hlc": hl})
        } ellers {
            la f = {}
            f[felt[x % 3]] = "v" + tekst(i)
            x = lcg(x)
            hvis x % 2 == 0 { f[felt[x % 3]] = i }
            legg_til(ops, {"op": "put", "felt": f, "hlc": hl})
        }
        i = i + 1
    }
    la fram = []
    la bak = []
    la blanda = []
    i = 0
    mens i < 12 {
        legg_til(fram, i)
        legg_til(bak, 11 - i)
        legg_til(blanda, (i * 5) % 12)
        i = i + 1
    }
    la a = k.json_kanonisk(køyr_ops(ops, fram))
    la b = k.json_kanonisk(køyr_ops(ops, bak))
    la c = k.json_kanonisk(køyr_ops(ops, blanda))
    skriv("konvergens " + tekst(a == b og b == c) + " " + a + "\n")
    # Dobbel bruk av alle op-ar endrar ingenting
    la dobbel = []
    i = 0
    mens i < 12 {
        legg_til(dobbel, i)
        legg_til(dobbel, i)
        i = i + 1
    }
    skriv("dobbel lik " + tekst(k.json_kanonisk(køyr_ops(ops, dobbel)) == a) + "\n")

    # ── Validering ──
    la reg = {"oppg": {"felt": {"tittel": "tekst", "ferdig": "bool", "pri": "heltall", "vekt": "tal"}, "maks_byte": 60}}
    la hv = k.hlc_lag(1790000000000, 0, "c1")
    la gyldig = {"seq": 1, "op": "put", "s": "oppg", "id": "a-1", "hlc": hv, "felt": {"tittel": "x", "ferdig": sann, "vekt": 1.5}}
    skriv("gyldig [" + k.valider_op(gyldig, reg) + "]\n")
    skriv("del [" + k.valider_op({"seq": 2, "op": "del", "s": "oppg", "id": "a-1", "hlc": hv}, reg) + "]\n")
    skriv("null-verdi [" + k.valider_op({"seq": 2, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {"pri": null}}, reg) + "]\n")
    skriv("seq " + k.valider_op({"seq": 0, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {"pri": 1}}, reg) + "\n")
    skriv("op " + k.valider_op({"seq": 1, "op": "flytt", "s": "oppg", "id": "a", "hlc": hv}, reg) + "\n")
    skriv("samling " + k.valider_op({"seq": 1, "op": "put", "s": "ukjend", "id": "a", "hlc": hv, "felt": {"pri": 1}}, reg) + "\n")
    skriv("id " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a/b", "hlc": hv, "felt": {"pri": 1}}, reg) + "\n")
    skriv("hlc " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a", "hlc": "1:2:3", "felt": {"pri": 1}}, reg) + "\n")
    skriv("felt tom " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {}}, reg) + "\n")
    skriv("dunder " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {"__del__": 1}}, reg) + "\n")
    skriv("ukjent " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {"farge": "raud"}}, reg) + "\n")
    skriv("type " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {"pri": "høg"}}, reg) + "\n")
    skriv("stor " + k.valider_op({"seq": 1, "op": "put", "s": "oppg", "id": "a", "hlc": hv, "felt": {"tittel": "0123456789012345678901234567890123456789012345678901234567890123456789"}}, reg) + "\n")

    # ── JSON og kontrollteikn ──
    skriv("json " + k.json({"t": "a\"b\\c\nd\te", "l": [1, 2.0, -0.5, sann, null], "æ": "ø"}) + "\n")
    skriv("kanonisk " + k.json_kanonisk({"b": 1, "a": {"d": [{"z": 1, "y": 2}], "c": 2}}) + "\n")
    skriv("kontroll " + tekst(k.kontrollteikn_ok("{\"a\":\"\\u00e6\\n\\u0009\"}")) + tekst(k.kontrollteikn_ok("{\"a\":\"\\u001f\"}")) +
          tekst(k.kontrollteikn_ok("{\"a\":\"\\\\u0001\"}")) + tekst(k.kontrollteikn_ok("{\"a\":\"" + builtin.chr(2) + "\"}")) + "\n")
    skriv("etag " + k.pull_etag("e1", "ab12", 42, 0, 500) + "\n")
    skriv("namn " + tekst(k.trygt_namn("a.b:c-d_9", 64)) + tekst(k.trygt_namn("æ", 64)) + tekst(k.trygt_namn("", 64)) + "\n")
    returner 0
}

# Fasit (VM, NORSCODE_VM_FAST=1):
#= hlc 001790000000000:00003:c7
#= send bak 001790000000000:00004:c7
#= send fram 001790000000500:00000:c7
#= motta lik ms 001790000000000:00010:c7
#= motta fjern nyare 001790000005000:00003:c7
#= motta klokke nyast 001790000009000:00000:c7
#= teljar-overflyt 000000000000006:00000:a
#= klem 001790000060000:00001:x
#= ikkje klem 001790000030000:00001:x
#= klem 90 s 001790000060000:00002:x
#= ugyldig usannusannsann
#= samanlikn 1-10-1
#= treg klokke vinn sann 001790000300000:00002:treg
#= put {"data":{"ferdig":false,"tittel":"Kjøp mjølk"},"del":"","hlc":{"ferdig":"000000000000200:00000:b","tittel":"000000000000200:00000:b"}} sletta=usann
#= eldre put {"data":{"ferdig":false,"pri":2,"tittel":"Kjøp mjølk"},"del":"","hlc":{"ferdig":"000000000000200:00000:b","pri":"000000000000100:00000:a","tittel":"000000000000200:00000:b"}} sletta=usann
#= endra sann
#= idempotent endra=usann
#= del mellom {"data":{},"del":"000000000000250:00000:c","hlc":{}} sletta=sann
#= del alt {"data":{},"del":"000000000000300:00000:a","hlc":{}} sletta=sann
#= put eldre enn del endra=usann
#= gjenoppliva {"data":{"tittel":"oppatt"},"del":"000000000000300:00000:a","hlc":{"tittel":"000000000000400:00000:b"}} sletta=usann
#= endring {"v":7,"s":"oppg","id":"a1","dok":null,"del":"000000000000300:00000:a"}
#= endring {"v":8,"s":"oppg","id":"a1","dok":{"tittel":"oppatt"},"hlc":{"tittel":"000000000000400:00000:b"},"del":"000000000000300:00000:a"}
#= konvergens sann {"data":{"b":"v3","c":6},"del":"000000000001040:00010:n2","hlc":{"b":"000000000001042:00003:n2","c":"000000000001043:00006:n1"}}
#= dobbel lik sann
#= gyldig []
#= del []
#= null-verdi []
#= seq seq
#= op op
#= samling samling
#= id id
#= hlc hlc
#= felt tom felt
#= dunder felt_namn:__del__
#= ukjent felt_ukjent:farge
#= type felt_type:pri
#= stor for_stor
#= json {"t":"a\"b\\c\nd\te","l":[1,2.0,-0.5,true,null],"æ":"ø"}
#= kanonisk {"a":{"c":2,"d":[{"y":2,"z":1}]},"b":1}
#= kontroll sannusannsannusann
#= etag "e1:ab12:42:0:500"
#= namn sannusannusann
