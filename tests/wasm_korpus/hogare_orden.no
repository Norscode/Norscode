# WASM-korpus (W2): høgareordens funksjonar skrivne i Norscode: kart, filter, fold og ei
# innsetjingssortering med samanlikningsclosure (tal stigande/synkande, tekst bytevis),
# kjeding av filter og kart, og at originallista er urørt. Fasiten er lik på macOS- og
# Linux-VM-en.
#= kvadrat: [25, 9, 64, 1, 81, 4, 49]
#= over 4: [5, 8, 9, 7]
#= sum: 35
#= stigande: [1, 2, 3, 5, 7, 8, 9]
#= synkande: [9, 8, 7, 5, 3, 2, 1]
#= ord: [banan, eple, fiken, pære]
#= lengder: [5, 4, 5, 5]
#= partal: [p8, p2]
#= original: [5, 3, 8, 1, 9, 2, 7]

funksjon kart(l, f) {
    la ut = []
    la i = 0
    mens i < lengde(l) {
        legg_til(ut, f(l[i]))
        i = i + 1
    }
    returner ut
}

funksjon filter(l, p) {
    la ut = []
    for x i l {
        hvis p(x) {
            legg_til(ut, x)
        }
    }
    returner ut
}

funksjon fold(l, start, f) {
    la acc = start
    for x i l {
        acc = f(acc, x)
    }
    returner acc
}

funksjon sorter(l, mindre) {
    la ut = []
    for x i l {
        legg_til(ut, x)
    }
    la i = 1
    mens i < lengde(ut) {
        la j = i
        mens j > 0 og mindre(ut[j], ut[j - 1]) {
            la t = ut[j]
            ut[j] = ut[j - 1]
            ut[j - 1] = t
            j = j - 1
        }
        i = i + 1
    }
    returner ut
}

funksjon vis(l) -> tekst {
    la ut = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 {
            ut = ut + ", "
        }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut + "]"
}

funksjon start() -> heltall {
    la tal = [5, 3, 8, 1, 9, 2, 7]
    skriv("kvadrat: " + vis(kart(tal, fun(x) -> x * x)) + "\n")
    la grense = 4
    skriv("over " + tekst(grense) + ": " + vis(filter(tal, fun(x) -> x > grense)) + "\n")
    skriv("sum: " + tekst(fold(tal, 0, fun(a, b) -> a + b)) + "\n")
    skriv("stigande: " + vis(sorter(tal, fun(a, b) -> a < b)) + "\n")
    skriv("synkande: " + vis(sorter(tal, fun(a, b) -> a > b)) + "\n")
    la ord = ["pære", "eple", "banan", "fiken"]
    skriv("ord: " + vis(sorter(ord, fun(a, b) -> a < b)) + "\n")
    skriv("lengder: " + vis(kart(ord, fun(s) -> lengde(s))) + "\n")
    la par = kart(filter(tal, fun(x) -> x % 2 == 0), fun(x) -> "p" + tekst(x))
    skriv("partal: " + vis(par) + "\n")
    skriv("original: " + vis(tal) + "\n")
    returner 0
}
