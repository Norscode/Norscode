# WASM-korpus (W7): køa i std/wasm_lager.no utan IndexedDB. Batchar blir registrerte med
# test_registrer og konvoluttane (slik lastaren lagar dei: [id, feilnamn, melding, data])
# leverte med test_motta i ei anna rekkjefølgje enn dei vart sende. Tilbakekalla skal kome i
# rekkjefølgja førespurnadene vart gjorde, eitt per førespurnad; eit ok- eller
# feil-tilbakekall som kastar, gjev «ERROR: …» og stoppar ikkje dei neste; manglande
# feil-tilbakekall gjev «ERROR: LagerFeil: …»; ein ukjend id og eit andre svar på same id blir
# ignorerte; eit tilbakekall kan gjere ein ny førespurnad medan køa blir levert.
#= ventande: 5
#= 3 kom: levert 0, ventande 5
#= 5 kom: levert 0, ventande 5
#= 4 kom: levert 0, ventande 5
#= 2 kom: levert 0, ventande 5
#= 1: ok [1]
#= 2: feil transaksjon ConstraintError
#= ERROR: kasta i feil 2
#= 3: ok [{"id":1,"namn":"Åse"}]
#= ERROR: kasta i ok 3
#= ERROR: LagerFeil: kvote køyr test: QuotaExceededError: full
#= 5: ok [[{"t":"x","nr":1},{"t":"y","nr":9}],2]
#= 1 kom: levert 5, ventande 0
#= ukjend id kom: levert 0, ventande 0
#= 1 på nytt kom: levert 0, ventande 0
#= 6: ok [null]
#= 6 registrerte 7, ventande 1
#= 6 kom: levert 1, ventande 1
#= 7: feil transaksjon InvalidStateError
#= 7 kom: levert 1, ventande 0
bruk std.wasm_lager som lager

la d: ordbok = {}

funksjon j(v) -> tekst {
    returner builtin.json_stringify(v)
}

funksjon ok_logg(nr: heltall, r) -> heltall {
    skriv(tekst(nr) + ": ok " + j(r) + "\n")
    returner 0
}

funksjon feil_logg(nr: heltall, f: ordbok) -> heltall {
    skriv(tekst(nr) + ": feil " + f["art"] + " " + f["namn"] + "\n")
    returner 0
}

funksjon ok_kast(nr: heltall, r) -> heltall {
    ok_logg(nr, r)
    kast "kasta i ok " + tekst(nr)
}

funksjon feil_kast(nr: heltall, f: ordbok) -> heltall {
    feil_logg(nr, f)
    kast "kasta i feil " + tekst(nr)
}

funksjon ny_frå(r) -> heltall {
    ok_logg(6, r)
    lager.test_registrer(d, [lager.op_tel("dok", null)], fun(x) -> ok_logg(7, x), fun(f) -> feil_logg(7, f))
    skriv("6 registrerte 7, ventande " + tekst(lager.ventande()) + "\n")
    returner 0
}

funksjon kom(namn: tekst, k: tekst) -> heltall {
    la n = lager.test_motta(k)
    skriv(namn + " kom: levert " + tekst(n) + ", ventande " + tekst(lager.ventande()) + "\n")
    returner 0
}

funksjon post(k, v) -> ordbok {
    returner {"k": k, "v": j(v), "i": {}}
}

funksjon start() -> heltall {
    d = lager.test_db("test", [lager.lager("dok", "id", []), lager.lager_auto("logg", "nr", [])])
    lager.test_registrer(d, [lager.op_put("dok", {"id": 1})], fun(r) -> ok_logg(1, r), fun(f) -> feil_logg(1, f))
    lager.test_registrer(d, [lager.op_put("dok", {"id": 2}), lager.op_put("dok", {"id": 3})], fun(r) -> ok_logg(2, r), fun(f) -> feil_kast(2, f))
    lager.test_registrer(d, [lager.op_hent("dok", 1)], fun(r) -> ok_kast(3, r), fun(f) -> feil_logg(3, f))
    lager.test_registrer(d, [lager.op_put("logg", {"t": "x"})], fun(r) -> ok_logg(4, r), null)
    lager.test_registrer(d, [lager.op_liste("logg", null, 0), lager.op_tel("logg", null)], fun(r) -> ok_logg(5, r), fun(f) -> feil_logg(5, f))
    skriv("ventande: " + tekst(lager.ventande()) + "\n")
    kom("3", j([3, 0, 0, [post(1, {"id": 1, "namn": "Åse"})]]))
    kom("5", j([5, 0, 0, [[post(1, {"t": "x"}), post(2, {"t": "y", "nr": 9})], 2]]))
    kom("4", j([4, "QuotaExceededError", "full", null]))
    kom("2", j([2, "ConstraintError", "Key already exists", null]))
    kom("1", j([1, 0, 0, [1]]))
    kom("ukjend id", j([99, 0, 0, []]))
    kom("1 på nytt", j([1, "AbortError", null, null]))
    lager.test_registrer(d, [lager.op_hent("dok", 2)], fun(r) -> ny_frå(r), fun(f) -> feil_logg(6, f))
    kom("6", j([6, 0, 0, [null]]))
    kom("7", j([7, "InvalidStateError", "The database connection is closing.", null]))
    returner 0
}
