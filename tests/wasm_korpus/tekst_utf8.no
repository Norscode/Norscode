# WASM-korpus (W1): tekst som verdi. Strengar er UTF-8-bytar som i VM-en, så `lengde`
# tel bytar («blåbær» = 8), indeksering og utsnitt er bytebaserte, og samanlikning er
# bytevis (å > z). tekst(heiltal) og heltall(tekst) med overflyt som i VM-en.
#= blåbær 8
#= blåbærsyltetøy 17
#= s[0]=b s[1]=l
#= bl|å|bær|blåbær||
#= char_code: 195 98 0, chr: A
#= tekst: 42 -7 heltall: 124 -45 7766279631452241919
#= a<b sann, b<ab usann, å<z usann, ab<=ab sann, Z<a sann, ab>a sann
#= lik: sann usann usann sann
#= tom: 0, type: tekst
#= argument: <blåbær>
#= snudd: rabab
#= lang: 2000 xyxy

funksjon ramme(s: tekst) -> tekst {
    returner "<" + s + ">"
}

funksjon gjenta(s: tekst, n: heltall) -> tekst {
    la ut = ""
    la i = 0
    mens i < n {
        ut = ut + s
        i = i + 1
    }
    returner ut
}

# Snur ein ASCII-tekst byte for byte (utsnitta held seg på teiknsgrenser her).
funksjon snu_ascii(s: tekst) -> tekst {
    la ut = ""
    la i = lengde(s) - 1
    mens i >= 0 {
        ut = ut + builtin.slice(s, i, i + 1)
        i = i - 1
    }
    returner ut
}

funksjon b(v: bool) -> tekst {
    returner tekst(v)
}

funksjon start() -> heltall {
    la s = "blåbær"
    skriv(s + " " + tekst(lengde(s)) + "\n")
    la t = s + "syltetøy"
    skriv(t + " " + tekst(lengde(t)) + "\n")
    skriv("s[0]=" + s[0] + " s[1]=" + s[1] + "\n")
    skriv(builtin.slice(s, 0, 2) + "|" + builtin.slice(s, 2, 4) + "|" + builtin.slice(s, 4, 99) + "|" +
          builtin.slice(s, -3, 8) + "|" + builtin.slice(s, 5, 2) + "|\n")
    skriv("char_code: " + tekst(builtin.char_code("å")) + " " + tekst(builtin.char_code("bå")) + " " +
          tekst(builtin.char_code("")) + ", chr: " + builtin.chr(65) + "\n")
    skriv("tekst: " + tekst(42) + " " + tekst_fra_heltall(-7) + " heltall: " + tekst(heltall("123") + 1) + " " +
          tekst(heltall_fra_tekst("-45")) + " " + tekst(heltall("99999999999999999999")) + "\n")
    skriv("a<b " + b("a" < "b") + ", b<ab " + b("b" < "ab") + ", å<z " + b("å" < "z") + ", ab<=ab " + b("ab" <= "ab") +
          ", Z<a " + b("Z" < "a") + ", ab>a " + b("ab" > "a") + "\n")
    skriv("lik: " + b(s == "blåbær") + " " + b(s == "blåbæ") + " " + b(s != "blåbær") + " " + b("" == "") + "\n")
    skriv("tom: " + tekst(lengde("")) + ", type: " + builtin.type(s) + "\n")
    skriv("argument: " + ramme(s) + "\n")
    skriv("snudd: " + snu_ascii("babar") + "\n")
    la lang = gjenta("xy", 1000)
    skriv("lang: " + tekst(lengde(lang)) + " " + builtin.slice(lang, 1996, 2000) + "\n")
    returner 0
}
