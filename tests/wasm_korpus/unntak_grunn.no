# WASM-korpus (W2): kast og fang. Tekstunnatak, typa fang med «Type: …»-prefiks (NullDeling,
# Djup), feil type som fell gjennom til ytre handterar, unnatak gjennom seks rammer,
# omkast frå ein fang-blokk, strukturert unnatak (ordbok med «type»), fang (e: tekst) med og
# utan kolon, og prøv/fang inne i ei lykkje. Fasiten er lik på macOS- og Linux-VM-en.
#= før
#= fanga Enkel: hei
#= 5
#= typa: NullDeling: 7 / 0
#= ytre fanga NettFeil: brote
#= gjennom 6 rammer: Djup: botn nådd
#= omkast fanga: NullDeling: 3 / 0
#= ytre: Omkasta: NullDeling: 3 / 0
#= ordbok: namn
#= tekst: utan kolon
#= tekst2: :kolon først
#= lykkje: 32
#= slutt

funksjon del(a: heltall, b: heltall) -> heltall {
    hvis b == 0 {
        kast "NullDeling: " + tekst(a) + " / 0"
    }
    returner a / b
}

funksjon djup(n: heltall) -> heltall {
    hvis n == 0 {
        kast "Djup: botn nådd"
    }
    returner djup(n - 1) + 1
}

funksjon omkast(x: heltall) -> heltall {
    prøv {
        returner del(x, 0)
    } fang (e) {
        skriv("omkast fanga: " + e + "\n")
        kast "Omkasta: " + e
    }
    returner 0
}

funksjon start() -> heltall {
    prøv {
        skriv("før\n")
        kast "Enkel: hei"
        skriv("aldri\n")
    } fang (e) {
        skriv("fanga " + e + "\n")
    }
    prøv {
        skriv(tekst(del(10, 2)) + "\n")
        skriv(tekst(del(7, 0)) + "\n")
    } fang (e: NullDeling) {
        skriv("typa: " + e + "\n")
    }
    prøv {
        prøv {
            kast "NettFeil: brote"
        } fang (e: FilFeil) {
            skriv("feil handterar\n")
        }
        skriv("aldri\n")
    } fang (e) {
        skriv("ytre fanga " + e + "\n")
    }
    prøv {
        djup(5)
    } fang (e: Djup) {
        skriv("gjennom 6 rammer: " + e + "\n")
    }
    prøv {
        omkast(3)
    } fang (e: Omkasta) {
        skriv("ytre: " + e + "\n")
    }
    la feil = {}
    feil["type"] = "ValideringsFeil"
    feil["felt"] = "namn"
    prøv {
        kast feil
    } fang (e: ValideringsFeil) {
        skriv("ordbok: " + e["felt"] + "\n")
    }
    prøv {
        kast "utan kolon"
    } fang (e: tekst) {
        skriv("tekst: " + e + "\n")
    }
    prøv {
        kast ":kolon først"
    } fang (e: tekst) {
        skriv("tekst2: " + e + "\n")
    }
    la n = 0
    la i = 0
    mens i < 5 {
        prøv {
            hvis i % 2 == 1 {
                kast "Oddetal: " + tekst(i)
            }
            n = n + 10
        } fang (e) {
            n = n + 1
        }
        i = i + 1
    }
    skriv("lykkje: " + tekst(n) + "\n")
    skriv("slutt\n")
    returner 0
}
