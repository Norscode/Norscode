# WASM-korpus (W3): builtin.sha256 (hex over UTF-8-bytane). I WASM er det std/sha256.no,
# kompilert som han er via std.wasm_rt.sha256_hex. Kjende vektorar (FIPS 180-4: «abc», tom,
# 448- og 896-bits meldingane), UTF-8, og lengder rundt paddinggrensene (55, 56, 63, 64, 65
# byte) og fleire blokker (1000 byte). Fasiten er lik på begge VM-ane.
#= abc ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
#= tom e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
#= 448 248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1
#= 896 cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1
#= blåbær 6f1a4baa8c1c7537ba678df617a5e9256abcacb1056256b2e6f7d91c983ac531
#= 55 9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318
#= 56 b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a
#= 63 7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34
#= 64 ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb
#= 65 635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0
#= 1000 41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3
#= json f84fb37abde027dc9d06e496c0031f35e47645525496ad3b5ece66c5fc6303aa

funksjon gjenta(s: tekst, n: heltall) -> tekst {
    la ut = ""
    la i = 0
    mens i < n {
        ut = ut + s
        i = i + 1
    }
    returner ut
}

funksjon start() -> heltall {
    skriv("abc " + sha256("abc") + "\n")
    skriv("tom " + sha256("") + "\n")
    skriv("448 " + sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") + "\n")
    skriv("896 " + sha256("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") + "\n")
    skriv("blåbær " + sha256("blåbær") + "\n")
    la n = [55, 56, 63, 64, 65, 1000]
    la i = 0
    mens i < lengde(n) {
        skriv(tekst(n[i]) + " " + sha256(gjenta("a", n[i])) + "\n")
        i = i + 1
    }
    skriv("json " + sha256(json_stringify({"uid": "brukar-1", "æ": [1, 2]})) + "\n")
    returner 0
}
