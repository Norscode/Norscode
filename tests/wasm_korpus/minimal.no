# WASM-korpus (W0): minste klientmodul, brukt som byte-eksakt fasit i test_wasm_w0.
# Ingen vertsfunksjonar (ingen importar, ikkje noko minne): éin global, ein konstant-
# addisjon via atomet «add» og start().
la svar: heltall = 0

funksjon start() -> heltall {
    svar = 40 + 2
    returner svar
}
