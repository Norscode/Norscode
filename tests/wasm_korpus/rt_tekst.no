# WASM-korpus (W3): tekstfunksjonane frå runtime-biblioteket std/wasm_rt.no. I VM-en er dei
# builtins; i WASM er dei vanleg Norscode som backenden kompilerer. Bytebasert som VM-en
# (UTF-8), tomme tekstar, tomme felt, overlapp og kantar. starts_with/ends_with med tom
# prefiks på ikkje-tom tekst er utelatne (macOS-VM-en gjev sann, Linux-VM-en usann), og
# store/små bokstavar blir berre testa på korte tekstar (Linux-stage0 heng på lower over
# 256 byte).
#= split: [a|b||c|] [] [98|108|195|165] [|] [a|b|c] [blåbær|øl] [|a]
#= join: a, b | a | æåø 1-x
#= trim: <x y> <> <x> <æ ø>
#= erstatt: bbb ba abc blaabær aa <> <> æoå x
#= starter: sann usann usann sann
#= slutter: sann usann sann usann
#= inneheld: sann sann usann sann sann
#= finn: 2 0 -1 0 4 0 -1 3
#= små: abc ÆØÅ Ü éÉ xyz @az[`
#= store: ABC æøå ü éÉ XYZ ß@[`{
#= kjede: KOMMA-SEPARERT-LISTE
#= verdier: [1|[verdi]|x] []

funksjon vis(l) -> tekst {
    la ut = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 {
            ut = ut + "|"
        }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut + "]"
}

# Bytane i kvar del (split per byte deler UTF-8-teikn; delane er ikkje gyldig UTF-8 åleine).
funksjon koder(l) -> tekst {
    la ut = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 {
            ut = ut + "|"
        }
        ut = ut + tekst(builtin.char_code(l[i]))
        i = i + 1
    }
    returner ut + "]"
}

funksjon ramme(s: tekst) -> tekst {
    returner "<" + s + ">"
}

funksjon b(x: bool) -> tekst {
    hvis x {
        returner "sann"
    }
    returner "usann"
}

funksjon start() -> heltall {
    skriv("split: " + vis(split("a,b,,c,", ",")) + " " + vis(split("", "")) + " " +
          koder(split("blå", "")) + " " + vis(split("abc", "abc")) + " " + vis(split("aXYbXYc", "XY")) + " " +
          vis(split("blåbær,øl", ",")) + " " + vis(split("aaa", "aa")) + "\n")
    skriv("join: " + join(["a", "b"], ", ") + " " + join(["", ""], "|") + " " + join(["a"], ",") + " " +
          join([], ",") + "|" + " " + join(["æ", "ø"], "å") + " " + join(["1", "x"], "-") + "\n")
    skriv("trim: " + ramme(trim("  \t\n x y \r\n ")) + " " + ramme(trim("")) + " " +
          ramme(trim(builtin.chr(11) + builtin.chr(12) + "x" + builtin.chr(11))) + " " + ramme(tekst_trim(" æ ø ")) + "\n")
    skriv("erstatt: " + tekst_erstatt("aaa", "a", "b") + " " + tekst_erstatt("aaa", "aa", "b") + " " +
          tekst_erstatt("abc", "", "x") + " " + replace("blåbær", "å", "aa") + " " + tekst_erstatt("aaaa", "aa", "a") + " " +
          ramme(tekst_erstatt("", "a", "b")) + " " + ramme(tekst_erstatt("abab", "ab", "")) + " " +
          tekst_erstatt("æøå", "ø", "o") + " " + tekst_erstatt("x", "xy", "z") + "\n")
    skriv("starter: " + b(starts_with("abc", "ab")) + " " + b(starts_with("abc", "abcd")) + " " +
          b(starts_with("", "a")) + " " + b(tekst_starter_med("blåbær", "blå")) + "\n")
    skriv("slutter: " + b(ends_with("abc", "bc")) + " " + b(ends_with("abc", "abcd")) + " " +
          b(ends_with("", "")) + " " + b(tekst_slutter_med("blåbær", "bå")) + "\n")
    skriv("inneheld: " + b(contains("abc", "b")) + " " + b(contains("abc", "")) + " " + b(contains("abc", "x")) + " " +
          b(contains("", "")) + " " + b(tekst_inneholder("blåbær", "åb")) + "\n")
    skriv("finn: " + tekst(index_of("abcabc", "c")) + " " + tekst(index_of("abc", "")) + " " + tekst(index_of("abc", "x")) + " " +
          tekst(index_of("", "")) + " " + tekst(index_of("blåbær", "bær")) + " " + tekst(index_of("aaa", "aa")) + " " +
          tekst(index_of("ab", "abc")) + " " + tekst(tekst_indeks("x.y.z", ".z")) + "\n")
    skriv("små: " + tekst_til_liten("ABC ÆØÅ Ü éÉ xyz") + " " + tekst_til_liten("@AZ[`") + "\n")
    skriv("store: " + tekst_til_store("abc æøå ü éÉ XYZ") + " " + tekst_til_store("ß@[`{") + "\n")
    skriv("kjede: " + join(split(tekst_til_store(trim("  komma,separert,liste ")), ","), "-") + "\n")
    skriv("verdier: " + vis(verdier({"b": 1, "a": [2], "c": "x"})) + " " + vis(verdier({})) + "\n")
    returner 0
}
