# WASM-korpus (W4): fjern_nokkel og tid_ms. fjern_nokkel fjernar nøkkelen og held
# rekkjefølgja til resten; ein manglande nøkkel er ein no-op, og ein nøkkel som kjem
# attende, hamnar sist. Begge skrivemåtane (fjern_nokkel og fjern_nøkkel) gjev 0, som i
# VM-en. tid_ms() er millisekund sidan epoken og aukar ikkje baklengs.
#= fjern b: a,c,d 3 r=0
#= manglar: a,c,d 3 r=0
#= attende: a,c,d,b 4 b=9
#= fjern_nøkkel: c,d,b 3 c=3
#= alle bort: 0 tom=sann
#= tal: 1,2 lengde 2 har 3: usann
#= i lykkje: k1,k3,k5,k7,k9 5
#= tid: sann sann

funksjon kommaliste(l: liste) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { ut = ut + "," }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut
}

funksjon start() -> heltall {
    la d = {"a": 1, "b": 2, "c": 3, "d": 4}
    la r = fjern_nokkel(d, "b")
    skriv("fjern b: " + kommaliste(nøkler(d)) + " " + tekst(lengde(d)) + " r=" + tekst(r) + "\n")
    r = fjern_nokkel(d, "zz")
    skriv("manglar: " + kommaliste(nøkler(d)) + " " + tekst(lengde(d)) + " r=" + tekst(r) + "\n")
    d["b"] = 9
    skriv("attende: " + kommaliste(nøkler(d)) + " " + tekst(lengde(d)) + " b=" + tekst(d["b"]) + "\n")
    fjern_nøkkel(d, "a")
    skriv("fjern_nøkkel: " + kommaliste(nøkler(d)) + " " + tekst(lengde(d)) + " c=" + tekst(d["c"]) + "\n")
    fjern_nokkel(d, "c")
    fjern_nokkel(d, "d")
    fjern_nokkel(d, "b")
    skriv("alle bort: " + tekst(lengde(d)) + " tom=" + tekst(lengde(nøkler(d)) == 0) + "\n")
    la t = {"1": "x", "2": "y", "3": "z"}
    fjern_nokkel(t, "3")
    skriv("tal: " + kommaliste(nøkler(t)) + " lengde " + tekst(lengde(t)) + " har 3: " + tekst(finnes_nøkkel(t, "3")) + "\n")
    la m = {}
    la i = 0
    mens i < 10 {
        m["k" + tekst(i)] = i
        i = i + 1
    }
    i = 0
    mens i < 10 {
        fjern_nokkel(m, "k" + tekst(i))
        i = i + 2
    }
    skriv("i lykkje: " + kommaliste(nøkler(m)) + " " + tekst(lengde(m)) + "\n")
    la t1 = builtin.tid_ms()
    la t2 = builtin.tid_ms()
    skriv("tid: " + tekst(t1 > 1600000000000) + " " + tekst(t2 >= t1) + "\n")
    returner 0
}
