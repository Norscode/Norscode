# WASM-korpus (W1): desimaltall. Blanda heiltal/desimaltall gjev desimaltall, heiltal/heiltal
# er trunkerande, og tekst(desimaltall) er den kortaste sifferstrengen med VM-en sine reglar
# (heiltalsverdi utan «.0», fast form for 10^-5 < |x| < 10^17, elles «1e20», «1.25e-5»).
#= 1+2.5=3.5 2.5+1=3.5
#= 7.0/2=3.5 7/2=3 1/3.0=0.3333333333333333
#= 0.1+0.2=0.30000000000000004
#= 1e20=1e20 1e16=10000000000000000 1.5e16=15000000000000000 1e17=1e17
#= 0.0001=0.0001 0.0000125=1.25e-5 0.0000001=1e-7 0.001=0.001
#= 123.456=123.456 -1.5=-1.5 2.5*2=5 3-0.5=2.5
#= -(2.5)=-2.5 7.5%2=1.5 -7.5%2=-1.5
#= stor: inf -inf
#= 2^53: 9007199254740992 9007199254740992
#= 1.5<2 sann, 2<1.5 usann, 2.5==2.5 sann, 1==1.0 sann, 2.5>=2.5 sann
#= type: desimaltall, sum: 5.5
#= 1.7976931348623157e308 5e-7 -0.00012

funksjon halv(x) {
    returner x / 2
}

funksjon sum(l: liste) {
    la s = 0.0
    la i = 0
    mens i < lengde(l) {
        s = s + l[i]
        i = i + 1
    }
    returner s
}

funksjon b(v: bool) -> tekst {
    returner tekst(v)
}

funksjon start() -> heltall {
    skriv("1+2.5=" + tekst(1 + 2.5) + " 2.5+1=" + tekst(2.5 + 1) + "\n")
    skriv("7.0/2=" + tekst(7.0 / 2) + " 7/2=" + tekst(7 / 2) + " 1/3.0=" + tekst(1 / 3.0) + "\n")
    skriv("0.1+0.2=" + tekst(0.1 + 0.2) + "\n")
    skriv("1e20=" + tekst(100000000000000000000.0) + " 1e16=" + tekst(10000000000000000.0) +
          " 1.5e16=" + tekst(15000000000000000.0) + " 1e17=" + tekst(100000000000000000.0) + "\n")
    skriv("0.0001=" + tekst(0.0001) + " 0.0000125=" + tekst(0.0000125) + " 0.0000001=" + tekst(0.0000001) +
          " 0.001=" + tekst(0.001) + "\n")
    skriv("123.456=" + tekst(123.456) + " -1.5=" + tekst(-1.5) + " 2.5*2=" + tekst(2.5 * 2) + " 3-0.5=" + tekst(3 - 0.5) + "\n")
    la x = 2.5
    skriv("-(2.5)=" + tekst(-x) + " 7.5%2=" + tekst(7.5 % 2) + " -7.5%2=" + tekst(-7.5 % 2) + "\n")
    la e = 1e300
    skriv("stor: " + tekst(e * e) + " " + tekst(0.0 - e * e) + "\n")
    la to53 = 9007199254740992.0
    skriv("2^53: " + tekst(to53) + " " + tekst(to53 + 1) + "\n")
    skriv("1.5<2 " + b(1.5 < 2) + ", 2<1.5 " + b(2 < 1.5) + ", 2.5==2.5 " + b(2.5 == 2.5) + ", 1==1.0 " + b(1 == 1.0) +
          ", 2.5>=2.5 " + b(2.5 >= 2.5) + "\n")
    skriv("type: " + builtin.type(halv(3.0)) + ", sum: " + tekst(sum([1, 2.5, 2])) + "\n")
    skriv(tekst(1.7976931348623157e308) + " " + tekst(0.0000005) + " " + tekst(-0.00012) + "\n")
    returner 0
}
