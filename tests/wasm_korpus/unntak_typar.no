# WASM-korpus (W2): typa fang av verdiar som ikkje er tekst. Typen er vm_type_name i
# selfhost/vm.no: liste, bool, kart (ordbok utan «type» og closure), desimaltall, heiltall
# (ikkje «heltall») og null. Ein handterar for heiltall slepp tekst og lister vidare til den
# ytre. Fasiten er lik på macOS- og Linux-VM-en.
#= liste 2
#= bool
#= kart 1
#= desimaltall 5
#= heiltall 8
#= null
#= closure som kart
#= anna heiltall anna

funksjon klassifiser(v) -> tekst {
    prøv {
        prøv {
            kast v
        } fang (e: heiltall) {
            returner "heiltall"
        }
    } fang (e) {
        returner "anna"
    }
    returner "?"
}

funksjon start() -> heltall {
    prøv {
        kast [1, 2]
    } fang (e: liste) {
        skriv("liste " + tekst(lengde(e)) + "\n")
    }
    prøv {
        kast sann
    } fang (e: bool) {
        skriv("bool\n")
    }
    prøv {
        kast {"a": 1}
    } fang (e: kart) {
        skriv("kart " + tekst(e["a"]) + "\n")
    }
    prøv {
        kast 2.5
    } fang (e: desimaltall) {
        skriv("desimaltall " + tekst(e * 2) + "\n")
    }
    prøv {
        kast 7
    } fang (e: heiltall) {
        skriv("heiltall " + tekst(e + 1) + "\n")
    }
    prøv {
        kast null
    } fang (e: null) {
        skriv("null\n")
    }
    prøv {
        kast fun(x) -> x
    } fang (e: kart) {
        skriv("closure som kart\n")
    }
    skriv(klassifiser("x") + " " + klassifiser(3) + " " + klassifiser([3]) + "\n")
    returner 0
}
