# WASM-korpus (W8): dei reine funksjonane i service workeren (std/wasm_sw.no) og statusen på
# sida (std/wasm_pwa_klient.no) — validering av konfigurasjonen workeren får, planen for
# førespurnader (cache først for ?v=, nett først for app-skalet, berre nett for private ruter
# og ukjende navigasjonar, forbi for andre metodar, opphav og private fetch), kva svar som kan
# lagrast (2xx utan 206, basic, ikkje omdirigert, utan Cache-Control private/no-store), install-
# planen, rydding av gamle cachar, skip- og auto-meldinga (skipWaiting ved klikk, eller
# automatisk med éi fane når konfigurasjonen tillèt det), kill switch og statusen frå sw_status.
# Same kode køyrer i VM-en og i WASM.
#= konfig 0: «»
#= konfig 1: «v (versjonen) manglar»
#= konfig 2: «c (cachenamnet) må byrje med nc-»
#= konfig 3: «p[1] er ikkje ein absolutt sti»
#= konfig 4: «offline-sida /finst-ikkje er ikkje precacha»
#= konfig 5: «immutable /stil.css har ingen ?v=»
#= konfig 6: «den private ruta /mi-side?x=1 kan ikkje precachast»
#= konfig 7: «offline-ruta /ukjend er ikkje precacha»
#= konfig 8: «a manglar eller er ikkje sann/usann»
#= konfig 9: «x manglar eller er ikkje ei liste»
#= konfig: «konfigurasjonen er ikkje eit objekt»
#= SwFeil: konfigurasjonen er ikkje gyldig JSON: JSON: uventa s | SwFeil: konfigurasjonen er ikkje eit objekt | SwFeil: c (cachenamnet) må byrje med nc-
#= tolka: nc-0123456789abcdef 5 usann
#= GET / navigate → nett n=/ lagre o=/_nc/offline
#= GET /?steg=2#x navigate → nett n=/ lagre o=/_nc/offline
#= GET /stil.css no-cors → nett n=/stil.css lagre
#= GET /_nc/app.wasm?v=111111111111 cors → cache n=/_nc/app.wasm?v=111111111111 lagre
#= GET /_nc/app.wasm?v=999999999999 cors → forbi
#= GET /_nc/app.wasm cors → forbi
#= GET /api/deltakarar cors → forbi
#= GET /api/ navigate → berre o=/_nc/offline
#= GET /mi-side navigate → berre o=/_nc/offline
#= GET /mi-side/profil navigate → berre o=/_nc/offline
#= GET /mi-sidex navigate → berre o=/_nc/offline
#= GET /mi-sidex cors → forbi
#= POST / navigate → forbi
#= HEAD /stil.css no-cors → forbi
#= GET /ukjend navigate → berre o=/_nc/offline
#= GET /ukjend.png no-cors → forbi
#= GET /_nc/offline navigate → nett n=/_nc/offline lagre o=/_nc/offline
#= anna opphav → forbi
#= prefiks utan / → forbi
#= sti_i: «/x?y» «» «»
#= lagre: sann sann sann usann usann usann usann usann usann usann usann usann usann usann sann usann usann usann
#= install: {"c":"nc-0123456789abcdef","u":["/","/stil.css","/_nc/offline","/_nc/app.wasm?v=111111111111","/_nc/sw.wasm?v=222222222222"]}
#= auto, éi fane tillate: sann sann usann usann
#= auto, ikkje tillate: usann
#= rydd: ["nc-gamal","nc-"]
#= melding: sann usann usann usann
#= av: forbi | {"c":"nc-0123456789abcdef","u":[]} auto=sann | ["nc-0123456789abcdef","nc-gamal"]
#= status «registrert 0000»: registrert k=usann i=usann v=usann a=usann
#= status «klar 1001»: klar k=sann i=usann v=usann a=sann
#= status «ventar 1011»: ventar k=sann i=usann v=sann a=sann
#= status «aktivert 1001»: aktivert k=sann i=usann v=usann a=sann
#= status «feil SecurityError 0000»: feil SecurityError k=usann i=usann v=usann a=usann
#= status «ustøtta 0000»: ustøtta k=usann i=usann v=usann a=usann
#= status «ingen»: ingen k=usann i=usann v=usann a=usann
#= status «»:  k=usann i=usann v=usann a=usann
bruk std.wasm_sw som sw
bruk std.wasm_pwa_klient som pk

funksjon konfig() -> ordbok {
    returner {"v": "abc", "c": "nc-0123456789abcdef",
              "p": ["/", "/stil.css", "/_nc/offline", "/_nc/app.wasm?v=111111111111", "/_nc/sw.wasm?v=222222222222"],
              "i": ["/_nc/app.wasm?v=111111111111", "/_nc/sw.wasm?v=222222222222"],
              "r": ["/", "/stil.css", "/_nc/offline"], "x": ["/api/", "/mi-side"], "o": "/_nc/offline", "a": usann, "av": usann}
}

funksjon med(felt: tekst, verdi) -> ordbok {
    la k = konfig()
    k[felt] = verdi
    returner k
}

funksjon q(m: tekst, sti: tekst, modus: tekst) -> ordbok {
    returner {"m": m, "u": "http://127.0.0.1:8080" + sti, "n": modus, "o": "http://127.0.0.1:8080"}
}

funksjon plan(k: ordbok, f: ordbok) -> tekst {
    la p = sw.rute(k, f)
    la t = tekst(p["k"])
    hvis p["n"] != "" { t = t + " n=" + tekst(p["n"]) }
    hvis p["l"] { t = t + " lagre" }
    hvis p["o"] != "" { t = t + " o=" + tekst(p["o"]) }
    returner t
}

funksjon b(x: bool) -> tekst {
    hvis x { returner "sann" }
    returner "usann"
}

funksjon start() -> heltall {
    # ── Konfigurasjonen ──
    la gale = [konfig(), med("v", ""), med("c", "anna-1"), med("p", ["/", "//x"]), med("o", "/finst-ikkje"),
               med("i", ["/stil.css"]), med("p", ["/", "/stil.css", "/_nc/offline", "/_nc/app.wasm?v=111111111111", "/_nc/sw.wasm?v=222222222222", "/mi-side?x=1"]),
               med("r", ["/ukjend"]), med("a", 1), med("x", "ikkje ei liste")]
    la i = 0
    mens i < lengde(gale) {
        skriv("konfig " + tekst(i) + ": «" + sw.valider_konfig(gale[i]) + "»\n")
        i = i + 1
    }
    skriv("konfig: «" + sw.valider_konfig([1]) + "»\n")
    la feil = []
    la tekstar = ["{\"v\":", "[1,2]", builtin.json_stringify(med("c", "x"))]
    la ti = 0
    mens ti < lengde(tekstar) {
        prøv {
            sw.tolk_konfig(tekstar[ti])
            legg_til(feil, "ingen feil")
        } fang (e: SwFeil) {
            legg_til(feil, builtin.slice(tekst(e), 0, 60))
        }
        ti = ti + 1
    }
    skriv(builtin.join(feil, " | ") + "\n")
    la k = sw.tolk_konfig(builtin.json_stringify(konfig()))
    skriv("tolka: " + k["c"] + " " + tekst(lengde(k["p"])) + " " + b(k["a"]) + "\n")

    # ── Planar ──
    la f = [q("GET", "/", "navigate"), q("GET", "/?steg=2#x", "navigate"), q("GET", "/stil.css", "no-cors"),
            q("GET", "/_nc/app.wasm?v=111111111111", "cors"), q("GET", "/_nc/app.wasm?v=999999999999", "cors"),
            q("GET", "/_nc/app.wasm", "cors"), q("GET", "/api/deltakarar", "cors"), q("GET", "/api/", "navigate"),
            q("GET", "/mi-side", "navigate"), q("GET", "/mi-side/profil", "navigate"), q("GET", "/mi-sidex", "navigate"),
            q("GET", "/mi-sidex", "cors"), q("POST", "/", "navigate"), q("HEAD", "/stil.css", "no-cors"),
            q("GET", "/ukjend", "navigate"), q("GET", "/ukjend.png", "no-cors"), q("GET", "/_nc/offline", "navigate")]
    la fi = 0
    mens fi < lengde(f) {
        skriv(f[fi]["m"] + " " + builtin.slice(f[fi]["u"], lengde("http://127.0.0.1:8080"), lengde(f[fi]["u"])) + " " + f[fi]["n"] + " → " + plan(k, f[fi]) + "\n")
        fi = fi + 1
    }
    skriv("anna opphav → " + plan(k, {"m": "GET", "u": "http://127.0.0.1:9090/", "n": "navigate", "o": "http://127.0.0.1:8080"}) + "\n")
    skriv("prefiks utan / → " + plan(k, {"m": "GET", "u": "http://127.0.0.1:80800/", "n": "navigate", "o": "http://127.0.0.1:8080"}) + "\n")
    skriv("sti_i: «" + sw.sti_i("http://a/x?y#z", "http://a") + "» «" + sw.sti_i("http://ab/x", "http://a") + "» «" + sw.sti_i("http://a", "http://a") + "»\n")

    # ── Lagring ──
    la svar = [{"s": 200, "t": "basic", "r": usann, "c": null}, {"s": 200, "t": "basic", "r": usann, "c": "no-cache"},
               {"s": 204, "t": "basic", "r": usann, "c": "public, max-age=60"}, {"s": 206, "t": "basic", "r": usann, "c": null},
               {"s": 304, "t": "basic", "r": usann, "c": null}, {"s": 403, "t": "basic", "r": usann, "c": null},
               {"s": 500, "t": "basic", "r": usann, "c": null}, {"s": 200, "t": "opaque", "r": usann, "c": null},
               {"s": 200, "t": "cors", "r": usann, "c": null}, {"s": 200, "t": "basic", "r": sann, "c": null},
               {"s": 200, "t": "basic", "r": usann, "c": "private"}, {"s": 200, "t": "basic", "r": usann, "c": "Private, max-age=0"},
               {"s": 200, "t": "basic", "r": usann, "c": "max-age=60, NO-STORE"}, {"s": 200, "t": "basic", "r": usann, "c": "private=\"set-cookie\""},
               {"s": 200, "t": "basic", "r": usann, "c": "no-storex"}, {"s": 200, "t": "basic"}, {"s": "200", "t": "basic", "r": usann, "c": null}]
    la l = []
    la si = 0
    mens si < lengde(svar) {
        legg_til(l, b(sw.kan_lagre(svar[si])))
        si = si + 1
    }
    skriv("lagre: " + builtin.join(l, " ") + " " + b(sw.kan_lagre(null)) + "\n")

    # ── Install, rydd, melding ──
    skriv("install: " + builtin.json_stringify(sw.installer_plan(k)) + "\n")
    la ka = med("a", sann)
    skriv("auto, éi fane tillate: " + b(sw.melding_plan(ka, {"m": "nc-auto", "k": 0})["s"]) + " " + b(sw.melding_plan(ka, {"m": "nc-auto", "k": 1})["s"]) + " " +
          b(sw.melding_plan(ka, {"m": "nc-auto", "k": 2})["s"]) + " " + b(sw.melding_plan(ka, {"m": "nc-auto"})["s"]) + "\n")
    skriv("auto, ikkje tillate: " + b(sw.melding_plan(k, {"m": "nc-auto", "k": 1})["s"]) + "\n")
    skriv("rydd: " + builtin.json_stringify(sw.rydd_plan(k, ["nc-gamal", "nc-0123456789abcdef", "anna-cache", "nc-"])) + "\n")
    skriv("melding: " + b(sw.melding_plan(k, {"m": "nc-skip", "k": 3})["s"]) + " " + b(sw.melding_plan(k, {"m": "skip", "k": 1})["s"]) + " " +
          b(sw.melding_plan(k, null)["s"]) + " " + b(sw.melding_plan(k, "nc-skip")["s"]) + "\n")

    # ── Kill switch ──
    la av = med("av", sann)
    skriv("av: " + plan(av, q("GET", "/", "navigate")) + " | " + builtin.json_stringify(sw.installer_plan(av)) + " auto=" + b(sw.melding_plan(av, {"m": "nc-auto", "k": 3})["s"]) + " | " +
          builtin.json_stringify(sw.rydd_plan(av, ["nc-0123456789abcdef", "nc-gamal", "anna"])) + "\n")

    # ── Status på sida ──
    la st = ["registrert 0000", "klar 1001", "ventar 1011", "aktivert 1001", "feil SecurityError 0000", "ustøtta 0000", "ingen", ""]
    la sti = 0
    mens sti < lengde(st) {
        la s = pk.tolk_status(st[sti])
        skriv("status «" + st[sti] + "»: " + s["hending"] + " k=" + b(s["kontrollert"]) + " i=" + b(s["installerer"]) + " v=" + b(s["ventar"]) + " a=" + b(s["aktiv"]) + "\n")
        sti = sti + 1
    }
    returner 0
}
