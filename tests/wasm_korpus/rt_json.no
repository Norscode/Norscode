# WASM-korpus (W3): JSON frå runtime-biblioteket std/wasm_rt.no. json_stringify er
# selfhost/json.no sin json_skriv (kompakt, innsetjingsrekkjefølgje, berre " \ \n \r \t
# escapa, «.0» på heiltalsverdige desimaltal); json_parse_raw gjev typa verdiar. Rundtur
# (json_stringify(json_parse_raw(s)) == s) for 20 NSP/1-liknande dokument i kanonisk form,
# ikkje-kanonisk input (mellomrom, \u-escape, surrogatpar, \/), tal (wrap, eksponent, -0),
# duplikatnøklar og djup nøsting.
#= {"x":[1,2.0,2.5,"a\"b\\c\nd\te\rf"],"y":null,"z":{},"b":true,"u":false}
#= [] {} "blåbær" null 42 -7.0 0.1 1e20
#= [[],[[]],{"a":{"b":{}}}]
#= rundtur: 20/20
#= {"a":[1,25.0,"æ☃"],"b":true,"c":"/"}
#= typar: ordbok liste heltall desimaltall tekst boolsk ingenting
#= surrogat: 240,159,152,128 😀!
#= escape: 8,12,10,13,9,34,92,47
#= tal: 100 0 -6101065172474983726 0.0015 -0.5 42
#= duplikat: {"a":3,"b":2}
#= djup: sann 481
#= endra: [1,2,3,4] 5

funksjon b(x: bool) -> tekst {
    hvis x {
        returner "sann"
    }
    returner "usann"
}

funksjon koder(s: tekst) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(s) {
        hvis i > 0 {
            ut = ut + ","
        }
        ut = ut + tekst(builtin.char_code(builtin.slice(s, i, i + 1)))
        i = i + 1
    }
    returner ut
}

funksjon dokument() -> liste {
    returner [
        "{\"v\":1,\"type\":\"hei\",\"klient\":\"k-7f3a\",\"epoke\":3}",
        "{\"v\":1,\"type\":\"push\",\"ops\":[{\"id\":\"op-1\",\"store\":\"oppgaver\",\"nøkkel\":\"o1\",\"hlc\":\"0000017f2a3b-0001-k7\",\"doc\":{\"tittel\":\"Kjøp blåbær\",\"ferdig\":false,\"prioritet\":2}}]}",
        "{\"v\":1,\"type\":\"push_svar\",\"ok\":[\"op-1\",\"op-2\"],\"avvist\":[]}",
        "{\"v\":1,\"type\":\"pull\",\"cursor\":\"c-000123\",\"grense\":100}",
        "{\"v\":1,\"type\":\"pull_svar\",\"cursor\":\"c-000124\",\"endringar\":[{\"store\":\"notat\",\"nøkkel\":\"n9\",\"slett\":true,\"hlc\":\"0000017f2a3c-0000-s\"}],\"meir\":false}",
        "{\"v\":1,\"type\":\"feil\",\"kode\":409,\"feil\":\"hol i sekvensen\",\"frå\":17,\"til\":19}",
        "{\"v\":1,\"type\":\"feil\",\"kode\":410,\"feil\":\"epoke utgått\",\"epoke\":4}",
        "{\"tekst\":\"sitat \\\"inne\\\" og \\\\ skråstrek\"}",
        "{\"linjer\":\"a\\nb\\r\\nc\\td\"}",
        "{\"tal\":[0,-1,1073741823,1073741824,-1073741825,9223372036854775807,-9223372036854775807]}",
        "{\"desimal\":[0.5,-2.25,2.0,1000000.0,0.001,1e20,1.5e-7,3.141592653589793]}",
        "{\"tom\":{},\"tomliste\":[],\"null\":null,\"sann\":true,\"usann\":false}",
        "[[[[[[[[[[1]]]]]]]]]]",
        "[{\"a\":[{\"b\":[{\"c\":[]}]}]},{\"d\":{\"e\":{\"f\":\"g\"}}}]",
        "{\"emoji\":\"😀\",\"snømann\":\"☃\",\"æøå\":\"ÆØÅ\"}",
        "[\"\",\"\",\"x\"]",
        "{\"z\":1,\"a\":2,\"m\":3}",
        "{\"etag\":\"W/\\\"x7\\\"\",\"sti\":\"/api/synk/v1\"}",
        "{\"v\":1,\"type\":\"leiar\",\"fane\":\"f-2\",\"las\":\"nc-synk-9a8b7c6d5e4f3a2b\"}",
        "[1,\"to\",3.5,null,true,{\"seks\":[7]}]"
    ]
}

funksjon start() -> heltall {
    skriv(json_stringify({"x": [1, 2.0, 2.5, "a\"b\\c\nd\te\rf"], "y": null, "z": {}, "b": sann, "u": usann}) + "\n")
    skriv(json_stringify([]) + " " + json_stringify({}) + " " + json_stringify("blåbær") + " " + json_stringify(null) + " " +
          json_stringify(42) + " " + json_stringify(-7.0) + " " + json_stringify(0.1) + " " + json_stringify(1.0e20) + "\n")
    skriv(json_stringify([[], [[]], {"a": {"b": {}}}]) + "\n")
    # Rundtur
    la docs = dokument()
    la ok = 0
    la i = 0
    mens i < lengde(docs) {
        la s = docs[i]
        la r = json_stringify(builtin.json_parse_raw(s))
        hvis r == s {
            ok = ok + 1
        } ellers {
            skriv("rundtur " + tekst(i) + ": " + r + "\n")
        }
        i = i + 1
    }
    skriv("rundtur: " + tekst(ok) + "/" + tekst(lengde(docs)) + "\n")
    # Ikkje-kanonisk input
    la v = builtin.json_parse_raw(" { \"a\" : [ 1 , 2.5e1 , \"\\u00e6\\u2603\" ] ,\n\t\"b\" : true , \"c\" : \"\\/\" } ")
    skriv(json_stringify(v) + "\n")
    skriv("typar: " + builtin.type(v) + " " + builtin.type(v["a"]) + " " + builtin.type(v["a"][0]) + " " +
          builtin.type(v["a"][1]) + " " + builtin.type(v["a"][2]) + " " + builtin.type(v["b"]) + " " +
          builtin.type(builtin.json_parse_raw("null")) + "\n")
    skriv("surrogat: " + koder(builtin.json_parse_raw("\"\\ud83d\\ude00\"")) + " " + builtin.json_parse_raw("\"\\uD83D\\uDE00!\"") + "\n")
    skriv("escape: " + koder(builtin.json_parse_raw("\"\\b\\f\\n\\r\\t\\\"\\\\\\/\"")) + "\n")
    skriv("tal: " + tekst(builtin.json_parse_raw("1e2")) + " " + tekst(builtin.json_parse_raw("-0")) + " " +
          tekst(builtin.json_parse_raw("12345678901234567890")) + " " + tekst(builtin.json_parse_raw("1.5E-3")) + " " +
          tekst(builtin.json_parse_raw("-0.5")) + " " + tekst(builtin.json_parse_raw("  42  ")) + "\n")
    skriv("duplikat: " + json_stringify(builtin.json_parse_raw("{\"a\":1,\"b\":2,\"a\":3}")) + "\n")
    la djup = ""
    la d = 0
    mens d < 60 {
        djup = djup + "{\"n\":["
        d = d + 1
    }
    djup = djup + "0"
    d = 0
    mens d < 60 {
        djup = djup + "]}"
        d = d + 1
    }
    skriv("djup: " + b(json_stringify(builtin.json_parse_raw(djup)) == djup) + " " + tekst(lengde(djup)) + "\n")
    la tal_liste = builtin.json_parse_raw("[1,2,3]")
    legg_til(tal_liste, 4)
    skriv("endra: " + json_stringify(tal_liste) + " " + tekst(tal_liste[0] + tal_liste[3]) + "\n")
    returner 0
}
