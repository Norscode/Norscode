# WASM-korpus (W2): eit unnatak som ingen fangar. endeleg i funksjonen som kastar og utsett i
# start() køyrer først, så blir feilen skriven som «ERROR: <tekst>» som i VM-en (exit ≠ 0 i
# VM-en; i nettlesaren utan «Uncaught»). Fasiten er lik på macOS- og Linux-VM-en.
#= før
#= indre endeleg
#= start utsett
#= ERROR: Uventa: indre feil

funksjon indre() -> heltall {
    prøv {
        kast "Uventa: indre feil"
    } endeleg {
        skriv("indre endeleg\n")
    }
    returner 0
}

funksjon start() -> heltall {
    utsett {
        skriv("start utsett\n")
    }
    skriv("før\n")
    indre()
    skriv("etter\n")
    returner 0
}
