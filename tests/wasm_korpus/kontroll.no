# WASM-korpus (W0): nøsta mens-lykkjer, hvis/ellers hvis, tidleg retur frå ei lykkje,
# og/eller som verdi over etikettar, bool-verdiar i lokale og globalar.
bruk std.wasm_vert som vert

la sist_funne: bool = usann

funksjon første_delar(n: heltall) -> heltall {
    la d = 2
    mens d * d <= n {
        hvis n % d == 0 {
            sist_funne = sann
            returner d
        }
        d = d + 1
    }
    sist_funne = usann
    returner n
}

funksjon primtal_under(grense: heltall) -> heltall {
    la tal = 0
    la n = 2
    mens n < grense {
        la er_primtal = første_delar(n) == n
        hvis er_primtal og ikkje sist_funne {
            tal = tal + 1
        }
        n = n + 1
    }
    returner tal
}

funksjon klassar(grense: heltall) -> heltall {
    la a = 0
    la b = 0
    la c = 0
    la i = 0
    mens i < grense {
        la j = 0
        mens j < 3 {
            hvis (i + j) % 3 == 0 {
                a = a + 1
            } ellers hvis (i + j) % 3 == 1 eller i == j {
                b = b + 1
            } ellers {
                c = c + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    returner a * 10000 + b * 100 + c
}

funksjon start() -> heltall {
    vert.sett_tekst(vert.finn("#ut"), primtal_under(100))
    vert.sett_tekst(vert.finn("#sum"), klassar(20))
    returner 0
}
