# WASM-korpus (W1): ordbøker. Innsetjingsrekkjefølgja er den same som i VM-en (ein
# overskriven nøkkel held plassen sin), nøkler(), finnes_nøkkel, lengde, manglande nøkkel
# gjev null, for-lykkje over nøkler(d), og ordbøker som argument og retur.
# `for k i d` direkte les d[0], d[1], … i VM-en på denne greina (compileren emitterer ikkje
# for_iterabel), og det gjer WASM òg: tekstnøklar gjev null.
#= nøkler: b,a,c,z
#= d[a] = 5, d[q] = , type null: ingenting
#= har a: sann, har q: usann, lengde: 4
#= verdiar: 1 5 3 0
#= direkte: 4 x ingenting
#= dup: 1 2
#= teljing: e=3 l=2 b=1 ø=1 s=1
#= nøsta: 42 [verdi]
#= tom: 0

funksjon kommaliste(l: liste) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { ut = ut + "," }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut
}

funksjon tel(ord: liste) -> ordbok {
    la d = {}
    for o i ord {
        hvis finnes_nøkkel(d, o) {
            d[o] = d[o] + 1
        } ellers {
            d[o] = 1
        }
    }
    returner d
}

funksjon start() -> heltall {
    la d = {"b": 1, "a": 2, "c": 3}
    d["a"] = 5
    d["z"] = 0
    skriv("nøkler: " + kommaliste(nøkler(d)) + "\n")
    skriv("d[a] = " + tekst(d["a"]) + ", d[q] = " + tekst(d["q"]) + ", type null: " + builtin.type(d["q"]) + "\n")
    skriv("har a: " + tekst(finnes_nøkkel(d, "a")) + ", har q: " + tekst(finnes_nøkkel(d, "q")) + ", lengde: " +
          tekst(lengde(d)) + "\n")
    la ut = "verdiar:"
    for k i nøkler(d) {
        ut = ut + " " + tekst(d[k])
    }
    skriv(ut + "\n")
    la n = 0
    la typar = ""
    for k i d {
        n = n + 1
        typar = builtin.type(k)
    }
    skriv("direkte: " + tekst(n) + " x " + typar + "\n")
    la dup = {"x": 1, "x": 2}
    skriv("dup: " + tekst(lengde(dup)) + " " + tekst(dup["x"]) + "\n")
    la t = tel(["e", "l", "e", "b", "ø", "s", "e", "l"])
    la tu = "teljing:"
    for k i nøkler(t) {
        tu = tu + " " + k + "=" + tekst(t[k])
    }
    skriv(tu + "\n")
    la nøsta = {"indre": {"svar": 42}, "liste": [1]}
    skriv("nøsta: " + tekst(nøsta["indre"]["svar"]) + " " + tekst(nøsta["liste"]) + "\n")
    skriv("tom: " + tekst(lengde({})) + "\n")
    returner 0
}
