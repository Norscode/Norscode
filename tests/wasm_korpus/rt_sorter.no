# WASM-korpus (W3): sortering og tekst_til_liste frå std/wasm_rt.no (ingen builtin i VM-en,
# så programmet kallar rt-funksjonane direkte og same kode køyrer i VM-en og nettlesaren).
# rt.sorter er ei stabil flettesortering med samanlikningsclosure (negativ → a før b);
# rt.sortert brukar `<`. Stabilitet på like nøklar, fanga variablar i komparatoren, tomme og
# eittelements lister, og at originalen er urørt.
#= stigande: [0 1 2 3 3 5 5 7 8 9]
#= synkande: [9 8 7 5 5 3 3 2 1 0]
#= sortert: [0 1 2 3 3 5 5 7 8 9]
#= original: [5 3 8 1 9 2 7 3 5 0]
#= tom: [] ein: [42]
#= ord: [Eple banan eple fiken pære zebra ål]
#= lengd: [ål eple Eple pære banan fiken zebra]
#= alder: [Ola:25 Åse:25 Siri:25 Kari:30 Per:30 Nils:30 Ivar:40]
#= alder ned: [Ivar:40 Kari:30 Per:30 Nils:30 Ola:25 Åse:25 Siri:25]
#= 200: sann 0 100 200
#= teikn: [b l å b æ r] [a 😀 ☃ b] 0 3
bruk std.wasm_rt som rt

funksjon vis(l) -> tekst {
    la ut = "["
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 {
            ut = ut + " "
        }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut + "]"
}

funksjon person(namn: tekst, alder: heltall) -> ordbok {
    returner {"namn": namn, "alder": alder}
}

funksjon namn_av(l) -> tekst {
    la ut = []
    la i = 0
    mens i < lengde(l) {
        legg_til(ut, tekst(l[i]["namn"]) + ":" + tekst(l[i]["alder"]))
        i = i + 1
    }
    returner vis(ut)
}

funksjon start() -> heltall {
    la tal = [5, 3, 8, 1, 9, 2, 7, 3, 5, 0]
    skriv("stigande: " + vis(rt.sorter(tal, fun(a, b) -> a - b)) + "\n")
    skriv("synkande: " + vis(rt.sorter(tal, fun(a, b) -> b - a)) + "\n")
    skriv("sortert: " + vis(rt.sortert(tal)) + "\n")
    skriv("original: " + vis(tal) + "\n")
    skriv("tom: " + vis(rt.sorter([], fun(a, b) -> a - b)) + " ein: " + vis(rt.sortert([42])) + "\n")
    la ord = ["pære", "eple", "banan", "fiken", "Eple", "ål", "zebra"]
    skriv("ord: " + vis(rt.sortert(ord)) + "\n")
    skriv("lengd: " + vis(rt.sorter(ord, fun(a, b) -> lengde(a) - lengde(b))) + "\n")
    la folk = [person("Kari", 30), person("Ola", 25), person("Per", 30), person("Åse", 25), person("Ivar", 40),
               person("Siri", 25), person("Nils", 30)]
    skriv("alder: " + namn_av(rt.sorter(folk, fun(a, b) -> a["alder"] - b["alder"])) + "\n")
    la retning = -1
    skriv("alder ned: " + namn_av(rt.sorter(folk, fun(a, b) -> retning * (a["alder"] - b["alder"]))) + "\n")
    la mange = []
    la i = 0
    mens i < 200 {
        legg_til(mange, (i * 37) % 101)
        i = i + 1
    }
    la s = rt.sortert(mange)
    la ok = sann
    i = 1
    mens i < lengde(s) {
        hvis s[i - 1] > s[i] {
            ok = usann
        }
        i = i + 1
    }
    skriv("200: " + tekst(ok) + " " + tekst(s[0]) + " " + tekst(s[199]) + " " + tekst(lengde(s)) + "\n")
    skriv("teikn: " + vis(rt.tekst_til_liste("blåbær")) + " " + vis(rt.tekst_til_liste("a😀☃b")) + " " +
          tekst(lengde(rt.tekst_til_liste(""))) + " " + tekst(lengde(rt.tekst_til_liste("ÆØÅ"))) + "\n")
    returner 0
}
