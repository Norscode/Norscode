# WASM-korpus (W1): heiltal over i31-grensa (i64-boks), rekursjon, lykkjer, overflyt med
# wrap, trunkerande divisjon og rest, og skriv(x) via vertsfunksjonen logg.
# Fasiten (linjene med «#=») er kjende verdiar; tests/test_wasm_w1.no krev at VM-en gjev
# nøyaktig dette, og tests/test_wasm_korpus_chrome.no at WASM i Chrome gjev det same.
#= fak(20) = 2432902008176640000
#= fak(12) = 479001600
#= sum 1..1000 = 500500
#= fib(30) = 832040
#= 2^62 = 4611686018427387904
#= maks + 1 = -9223372036854775808
#= 3037000500^2 = -9223372036709301616
#= -7/2 = -3, -7%3 = -1, 7%-3 = 1
#= 1073741823 + 1 = 1073741824
#= -(1073741824) = -1073741824, -1073741825 < -1073741824: sann
#= bitar: 1099511627781 6 16

funksjon fak(n: heltall) -> heltall {
    hvis n <= 1 {
        returner 1
    }
    returner n * fak(n - 1)
}

funksjon fib(n: heltall) -> heltall {
    la a = 0
    la b = 1
    la i = 0
    mens i < n {
        la t = a + b
        a = b
        b = t
        i = i + 1
    }
    returner a
}

funksjon sum_til(n: heltall) -> heltall {
    la s = 0
    la i = 1
    mens i <= n {
        s = s + i
        i = i + 1
    }
    returner s
}

funksjon potens(g: heltall, e: heltall) -> heltall {
    la r = 1
    la i = 0
    mens i < e {
        r = r * g
        i = i + 1
    }
    returner r
}

funksjon start() -> heltall {
    skriv("fak(20) = " + tekst(fak(20)) + "\n")
    skriv("fak(12) = " + tekst(fak(12)) + "\n")
    skriv("sum 1..1000 = " + tekst(sum_til(1000)) + "\n")
    skriv("fib(30) = " + tekst(fib(30)) + "\n")
    skriv("2^62 = " + tekst(potens(2, 62)) + "\n")
    la maks = 9223372036854775807
    skriv("maks + 1 = " + tekst(maks + 1) + "\n")
    la s = 3037000500
    skriv("3037000500^2 = " + tekst(s * s) + "\n")
    la a = -7
    skriv("-7/2 = " + tekst(a / 2) + ", -7%3 = " + tekst(a % 3) + ", 7%-3 = " + tekst(7 % (0 - 3)) + "\n")
    la g = 1073741823
    skriv("1073741823 + 1 = " + tekst(g + 1) + "\n")
    la h = g + 1
    skriv("-(1073741824) = " + tekst(-h) + ", -1073741825 < -1073741824: " + tekst(-h - 1 < -h) + "\n")
    la x = (1 << 40) | 5
    skriv("bitar: " + tekst(x) + " " + tekst((x ^ 3) & 7) + " " + tekst(x >> 38 << 2) + "\n")
    returner 0
}
