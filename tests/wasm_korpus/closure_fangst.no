# WASM-korpus (W2): closures. Fangst er by-value (endring etter BUILD_LAMBDA syner ikkje), ein
# teljar-closure med delt tilstand i ei ordbok (to uavhengige teljarar), closures returnerte
# frå funksjonar, komposisjon via builtin.ncb_call_fn, closures i ei liste, fleire fangarar,
# closure som byggjer ein closure, og type(closure) = ordbok som i VM-en. Fasiten er lik på
# macOS- og Linux-VM-en.
#= by-value: 11
#= teljar: 3 1
#= adderar: 6 8
#= komponert: 25
#= liste: 8 6 2
#= ncb_call_fn: 10
#= fleire: 324
#= nøsta: 42
#= type: ordbok

funksjon lag_teljar() {
    la tilstand = {"n": 0}
    returner fun() -> auk(tilstand)
}

funksjon auk(t) -> heltall {
    t["n"] = t["n"] + 1
    returner t["n"]
}

funksjon lag_adderar(k: heltall) {
    returner fun(x) -> x + k
}

funksjon lag_komponert(f, g) {
    returner fun(x) -> builtin.ncb_call_fn(f, builtin.ncb_call_fn(g, x))
}

funksjon start() -> heltall {
    la x = 10
    la f = fun(y) -> x + y
    x = 100
    skriv("by-value: " + tekst(f(1)) + "\n")
    la t1 = lag_teljar()
    la t2 = lag_teljar()
    t1()
    t1()
    skriv("teljar: " + tekst(t1()) + " " + tekst(t2()) + "\n")
    la add5 = lag_adderar(5)
    la add7 = lag_adderar(7)
    skriv("adderar: " + tekst(add5(1)) + " " + tekst(add7(1)) + "\n")
    la dobbel = fun(v) -> v * 2
    la k = lag_komponert(add5, dobbel)
    skriv("komponert: " + tekst(k(10)) + "\n")
    la fs = [add5, dobbel, fun(v) -> v - 1]
    la i = 0
    la ut = "liste:"
    mens i < lengde(fs) {
        la g = fs[i]
        ut = ut + " " + tekst(g(3))
        i = i + 1
    }
    skriv(ut + "\n")
    skriv("ncb_call_fn: " + tekst(builtin.ncb_call_fn(add7, 3)) + "\n")
    la a = 2
    la b = 3
    la c = 4
    la fleire = fun(p, q) -> a * p + b * q + c
    skriv("fleire: " + tekst(fleire(10, 100)) + "\n")
    la ytre = fun(n) -> builtin.ncb_call_fn(lag_adderar(n), a)
    skriv("nøsta: " + tekst(ytre(40)) + "\n")
    skriv("type: " + builtin.type(f) + "\n")
    returner 0
}
