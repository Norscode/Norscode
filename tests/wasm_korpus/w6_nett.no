# WASM-korpus (W6): dei reine funksjonane i std/wasm_nett.no, som køyrer likt i VM-en og i
# nettlesaren: validering av førespurnader, førespurnaden som JSON til lastaren, tolking av
# konvolutten frå lastaren (headerar som JSON, kropp med linjeskift), klassifisering av svar
# (2xx, status, nettverk, tidsavbrot, avbrote, json) og HentFeil som fangbart unnatak.
#= valider /api/ok GET: «»
#= valider http://x/ GET: «URL-en må vere ein sti på same opphav («/…»): http://x/»
#= valider //x GET: «URL-en må vere ein sti på same opphav («/…»): //x»
#= valider /a b GET: «URL-en har mellomrom eller linjeskift»
#= valider /api FETCH: «ukjend metode FETCH (GET, POST, PUT, PATCH, DELETE, HEAD)»
#= kropp på GET: «GET kan ikkje ha kropp»
#= tidsgrense 0: «tidsgrensa må vere 1–600000 ms»
#= header med linjeskift: «headeren x-a har linjeskift»
#= header med kolon: «ugyldig headernamn «a:b»»
#= json: {"i":7,"u":"/api/liste","method":"POST","headers":{"content-type":"application/json","accept":"application/json","x-nc":"1"},"body":"{\"namn\":\"Åse\",\"tal\":[1,2.5]}","t":8000}
#= get: {"i":8,"u":"/api/x?q=1","method":"GET","headers":{},"body":null,"t":250}
#= konvolutt: 12 200 «x-nc-svar»=«ja» kropp=«a
#= b æ» feilnamn=«»
#= konvolutt feil: 13 0 feilnamn=«TimeoutError» kropp=«»
#= 200: ok json=[1,{"a":null}]
#= 204: ok kropp=«»
#= 299: ok
#= 300: status 300 status 300
#= 404: status 404 status 404 kropp=«{"feil":"x"}»
#= 0 TimeoutError: tidsavbrot 0 ingen svar innan 8000 ms
#= 0 AbortError: avbrote 0 avbrote
#= 0 TypeError: nettverk 0 nettverksfeil (TypeError)
#= ugyldig json: json 200 JSON: uventa teikn: i kropp=«ikkje json»
#= tekst: HentFeil: status POST /api/liste: status 404
#= fanga: HentFeil: status POST /api/liste: status 404
bruk std.wasm_nett som nett

funksjon vis_valider(url: tekst, metode: tekst) -> heltall {
    skriv("valider " + url + " " + metode + ": «" + nett.valider(nett.førespurnad(metode, url)) + "»\n")
    returner 0
}

funksjon konv(status: tekst, tredje: tekst, kropp: tekst) -> tekst {
    returner builtin.join(["12", status, tredje, kropp], "\n")
}

funksjon vis_resultat(namn: tekst, f: ordbok, k: tekst) -> heltall {
    la r = nett.resultat(f, nett.tolk_konvolutt(k))
    la v = r["verdi"]
    hvis r["ok"] {
        la x = ""
        hvis finnes_nøkkel(v, "json") { x = " json=" + builtin.json_stringify(v["json"]) }
        hvis v["status"] == 204 { x = " kropp=«" + v["kropp"] + "»" }
        skriv(namn + ": ok" + x + "\n")
    } ellers {
        la x2 = ""
        hvis v["kropp"] != "" { x2 = " kropp=«" + v["kropp"] + "»" }
        skriv(namn + ": " + v["art"] + " " + tekst(v["status"]) + " " + v["melding"] + x2 + "\n")
    }
    returner 0
}

funksjon start() -> heltall {
    vis_valider("/api/ok", "GET")
    vis_valider("http://x/", "GET")
    vis_valider("//x", "GET")
    vis_valider("/a b", "GET")
    vis_valider("/api", "FETCH")
    skriv("kropp på GET: «" + nett.valider(nett.med_tekst(nett.førespurnad("GET", "/a"), "x", "text/plain")) + "»\n")
    skriv("tidsgrense 0: «" + nett.valider(nett.med_tidsgrense(nett.førespurnad("GET", "/a"), 0)) + "»\n")
    skriv("header med linjeskift: «" + nett.valider(nett.med_header(nett.førespurnad("GET", "/a"), "X-A", "1\n2")) + "»\n")
    skriv("header med kolon: «" + nett.valider(nett.med_header(nett.førespurnad("GET", "/a"), "a:b", "1")) + "»\n")

    la f = nett.med_header(nett.med_json(nett.førespurnad("POST", "/api/liste"), {"namn": "Åse", "tal": [1, 2.5]}), "X-NC", 1)
    skriv("json: " + nett.førespurnad_json(7, f) + "\n")
    skriv("get: " + nett.førespurnad_json(8, nett.med_tidsgrense(nett.førespurnad("GET", "/api/x?q=1"), 250)) + "\n")

    la k = nett.tolk_konvolutt(builtin.join(["12", "200", "{\"x-nc-svar\":\"ja\",\"content-type\":\"text/plain\"}", "a\nb æ"], "\n"))
    skriv("konvolutt: " + tekst(k["id"]) + " " + tekst(k["status"]) + " «" + nøkler(k["headerar"])[0] + "»=«" + k["headerar"]["x-nc-svar"] +
          "» kropp=«" + k["kropp"] + "» feilnamn=«" + k["feilnamn"] + "»\n")
    la k2 = nett.tolk_konvolutt(builtin.join(["13", "0", "TimeoutError", ""], "\n"))
    skriv("konvolutt feil: " + tekst(k2["id"]) + " " + tekst(k2["status"]) + " feilnamn=«" + k2["feilnamn"] + "» kropp=«" + k2["kropp"] + "»\n")

    la g = nett.førespurnad("GET", "/a")
    la gj = nett.forvent_json(nett.førespurnad("GET", "/a"))
    vis_resultat("200", gj, konv("200", "{}", "[1,{\"a\":null}]"))
    vis_resultat("204", g, konv("204", "{}", ""))
    vis_resultat("299", g, konv("299", "{}", "x"))
    vis_resultat("300", g, konv("300", "{}", ""))
    vis_resultat("404", gj, konv("404", "{\"content-type\":\"application/json\"}", "{\"feil\":\"x\"}"))
    vis_resultat("0 TimeoutError", g, konv("0", "TimeoutError", ""))
    vis_resultat("0 AbortError", g, konv("0", "AbortError", ""))
    vis_resultat("0 TypeError", g, konv("0", "TypeError", ""))
    vis_resultat("ugyldig json", gj, konv("200", "{}", "ikkje json"))

    la r = nett.resultat(f, nett.tolk_konvolutt(konv("404", "{}", "")))
    skriv("tekst: " + nett.feil_tekst(r["verdi"]) + "\n")
    prøv {
        nett.kast_feil(r["verdi"])
    } fang (e: HentFeil) {
        skriv("fanga: " + tekst(e) + "\n")
    }
    returner 0
}
