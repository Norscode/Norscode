# WASM-korpus (W6): køa i std/wasm_nett.no utan nettverk. Førespurnader blir registrerte med
# test_registrer og konvoluttane leverte med test_motta i ei anna rekkjefølgje enn dei vart
# sende. Tilbakekalla skal kome i sende-rekkjefølgja, eitt per førespurnad; eit ok- eller
# feil-tilbakekall som kastar, gjev «ERROR: …» og stoppar ikkje dei neste; manglande
# feil-tilbakekall gjev «ERROR: HentFeil: …»; ein ukjend id blir ignorert; eit tilbakekall kan
# sende ein ny førespurnad medan køa blir levert.
#= ventande: 5
#= 3 kom: levert 0, ventande 5
#= 5 kom: levert 0, ventande 5
#= avbryt 4: sann usann
#= 4 kom: levert 0, ventande 5
#= 2 kom: levert 0, ventande 5
#= 1: ok 200 a
#= ERROR: kasta i ok 1
#= 2: feil status
#= ERROR: kasta i feil 2
#= 3: ok 200 c
#= ERROR: HentFeil: avbrote GET /x: avbrote
#= 5: feil tidsavbrot
#= 1 kom: levert 5, ventande 0
#= ukjend id kom: levert 0, ventande 0
#= 6: ok 200 f (sender 7)
#= 6 kom: levert 1, ventande 1
#= 7: ok 200 g
#= 7 kom: levert 1, ventande 0
#= avbryt ferdig 7: usann
bruk std.wasm_nett som nett

funksjon ok_logg(nr: heltall, s: ordbok) -> heltall {
    skriv(tekst(nr) + ": ok " + tekst(s["status"]) + " " + s["kropp"] + "\n")
    returner 0
}

funksjon feil_logg(nr: heltall, f: ordbok) -> heltall {
    skriv(tekst(nr) + ": feil " + f["art"] + "\n")
    returner 0
}

funksjon ok_kast(nr: heltall, s: ordbok) -> heltall {
    ok_logg(nr, s)
    kast "kasta i ok " + tekst(nr)
}

funksjon feil_kast(nr: heltall, f: ordbok) -> heltall {
    feil_logg(nr, f)
    kast "kasta i feil " + tekst(nr)
}

funksjon sender_ny(s: ordbok) -> heltall {
    skriv("6: ok " + tekst(s["status"]) + " " + s["kropp"] + " (sender 7)\n")
    nett.test_registrer(nett.førespurnad("GET", "/y"), fun(t) -> ok_logg(7, t), fun(f) -> feil_logg(7, f))
    returner 0
}

funksjon konv(id: heltall, status: heltall, tredje: tekst, kropp: tekst) -> tekst {
    returner builtin.join([tekst(id), tekst(status), tredje, kropp], "\n")
}

funksjon kom(namn: tekst, k: tekst) -> heltall {
    la n = nett.test_motta(k)
    skriv(namn + " kom: levert " + tekst(n) + ", ventande " + tekst(nett.ventande()) + "\n")
    returner n
}

funksjon start() -> heltall {
    la g = nett.førespurnad("GET", "/x")
    la id1 = nett.test_registrer(g, fun(s) -> ok_kast(1, s), fun(f) -> feil_logg(1, f))
    la id2 = nett.test_registrer(g, fun(s) -> ok_logg(2, s), fun(f) -> feil_kast(2, f))
    la id3 = nett.test_registrer(g, fun(s) -> ok_logg(3, s), fun(f) -> feil_logg(3, f))
    la id4 = nett.test_registrer(g, fun(s) -> ok_logg(4, s), null)
    la id5 = nett.test_registrer(g, fun(s) -> ok_logg(5, s), fun(f) -> feil_logg(5, f))
    skriv("ventande: " + tekst(nett.ventande()) + "\n")
    kom("3", konv(id3, 200, "{}", "c"))
    kom("5", konv(id5, 0, "TimeoutError", ""))
    skriv("avbryt 4: " + tekst(nett.avbryt(id4)) + " " + tekst(nett.avbryt(id4)) + "\n")
    kom("4", konv(id4, 0, "AbortError", ""))
    kom("2", konv(id2, 404, "{}", ""))
    kom("1", konv(id1, 200, "{}", "a"))
    kom("ukjend id", konv(99, 200, "{}", "x"))
    la id6 = nett.test_registrer(g, fun(s) -> sender_ny(s), fun(f) -> feil_logg(6, f))
    kom("6", konv(id6, 200, "{}", "f"))
    kom("7", konv(id6 + 1, 200, "{}", "g"))
    skriv("avbryt ferdig 7: " + tekst(nett.avbryt(id6 + 1)) + "\n")
    returner 0
}
