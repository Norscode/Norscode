bruk selfhost.http_response som http

funksjon start() -> heiltall {
    la svar = http.response_to_http({
        "status": 201,
        "body": "hei",
        "content_type": "text/plain",
        "server": "Norscode",
        "cache_control": "no-store",
        "headers": {"X-Trace": "norsk"}
    })
    assert(builtin.starts_with(svar, "HTTP/1.1 201 Created\r\n"))
    assert(builtin.contains(svar, "Content-Type: text/plain\r\n"))
    assert(builtin.contains(svar, "Server: Norscode\r\n"))
    assert(builtin.contains(svar, "Cache-Control: no-store\r\n"))
    assert(builtin.contains(svar, "X-Trace: norsk\r\n"))
    assert(builtin.contains(svar, "Content-Length: 3\r\n"))
    assert(builtin.ends_with(svar, "\r\n\r\nhei"))

    la head = http.response_to_http({"status": 200, "body": "skjult", "__head__": sann})
    assert(builtin.contains(head, "Content-Length: 6\r\n"))
    assert(ikkje builtin.ends_with(head, "skjult"))

    la tom = http.response_to_http({"status": 204, "body": "skal ikkje ut"})
    assert(builtin.starts_with(tom, "HTTP/1.1 204 No Content\r\n"))
    assert(ikkje builtin.contains(tom, "Content-Length:"))
    assert(ikkje builtin.ends_with(tom, "skal ikkje ut"))
    returner 0
}
