# R2 / F08: konsistent blanda aritmetikk i VM-en (avgjerd: Java-semantikk).
# tal + tal og tekst + tekst som før; er éin side av + tekst, blir den andre
# konvertert med tekst() (1 + "x" = "1x"). - * / % og unær - på ikkje-tal, og
# + utan tekst på ikkje-tal, kastar ein fangbar TypeFeil i staden for å gje
# ein heap-adresse. Den valfrie strenge typesjekken (NORSCODE_STRICT_TYPAR)
# melder det same statisk. Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.lexer.lexer_m1 som lexer
bruk selfhost.parser som parser
bruk selfhost.compiler.typecheck som tc
bruk selfhost.compiler.semantic som sem

funksjon typefeil_for(kjelde: tekst) -> tekst {
    la ast = parser.parse_program(lexer.lex(kjelde))
    la tabell = {}
    sem.sem_populer_typar(tabell, ast)
    prøv { tc.kt_koyr(tabell, ast) } fang (e) { }
    la liste = tabell["typefeil"]
    hvis lengde(liste) > 0 { returner tekst(liste[0]) }
    returner ""
}

funksjon start() -> heiltall {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les("tests/fixtures/r2_aritmetikk.no"), "__main__"))
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "a+b=1x/tekst;b+a=x1;des=3.5+v2.5;bool=s=sann;løkke=0xy;tal=5,12,4,1;" +
        "TypeFeil: operatoren - krev tal, fekk heiltall og tekst;" +
        "TypeFeil: operatoren * krev tal, fekk tekst og bool;" +
        "TypeFeil: operatoren / krev tal, fekk liste og heiltall;" +
        "TypeFeil: operatoren % krev tal, fekk heiltall og null;" +
        "TypeFeil: operatoren + krev tal eller tekst, fekk bool og heiltall;" +
        "TypeFeil: operatoren + krev tal eller tekst, fekk liste og liste;" +
        "TypeFeil: unær - krev eit tal, fekk tekst")

    # Statisk (valfri streng typesjekk): kjende ikkje-tal-typar blir melde.
    assert(builtin.contains(typefeil_for("funksjon start() -> heltall { la e = 5 - \"x\" returner 0 }\n"), "operatoren - krev tal, fekk tal og tekst"))
    assert(builtin.contains(typefeil_for("funksjon start() -> heltall { la e = \"a\" * sann returner 0 }\n"), "operatoren * krev tal, fekk tekst og bool"))
    assert(builtin.contains(typefeil_for("funksjon start() -> heltall { la e = sann + 1 returner 0 }\n"), "operatoren + krev tal eller tekst, fekk bool og tal"))
    # 1 + "x" er lovleg (tekst), og ukjende typar blir aldri melde.
    assert_eq(typefeil_for("funksjon start() -> heltall { la e = 1 + \"x\" returner 0 }\n"), "")
    assert_eq(typefeil_for("funksjon f(a, b) -> heltall { returner a - b }\nfunksjon start() -> heltall { returner 0 }\n"), "")
    returner 0
}
