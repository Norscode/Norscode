// Fase 7f: CTE — WITH (ikkje-rekursiv, fleire) + WITH RECURSIVE. Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (1, 'Ada', 37)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (2, 'Linus', 55)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (3, 'Bjørn', 29)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (4, 'Alan', 41)")

    // Enkel CTE
    assert_eq(sql.query_rader(db, "WITH voksne AS (SELECT navn, alder FROM folk WHERE alder > 35) SELECT navn FROM voksne ORDER BY navn"), "Ada\nAlan\nLinus")
    // CTE + aggregat
    assert_eq(sql.query_rader(db, "WITH v AS (SELECT alder FROM folk WHERE alder > 35) SELECT count(*), avg(alder) FROM v"), "3|44.3333333333333")
    // To CTE-ar + UNION
    assert_eq(sql.query_rader(db, "WITH a AS (SELECT navn FROM folk WHERE alder > 50), b AS (SELECT navn FROM folk WHERE alder < 30) SELECT navn FROM a UNION SELECT navn FROM b ORDER BY navn"), "Bjørn\nLinus")
    // Rekursiv CTE (teljar 1..5)
    assert_eq(sql.query_rader(db, "WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM cnt WHERE n < 5) SELECT n FROM cnt"), "1\n2\n3\n4\n5")
    // Rekursiv CTE + sum
    assert_eq(sql.query_int(db, "WITH RECURSIVE cnt(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM cnt WHERE n < 5) SELECT sum(n) FROM cnt"), 15)

    returner 0
}
