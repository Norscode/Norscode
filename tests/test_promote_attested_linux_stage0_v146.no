bruk std.tekst som t

funksjon start() -> heiltall {
    la src = builtin.fil_les("tools/promote_attested_linux_stage0_v146.no")
    assert(t.inneholder(src, "060e6df82da728d72ff5d75c4a39de6d3627a7dcf61d846efba8ca03042763b1"))
    assert(t.inneholder(src, "github_run=\" + release_run()"))
    assert(t.inneholder(src, "strict_run=\" + strict_run()"))
    assert(t.inneholder(src, "strict_gate=green"))
    assert(t.inneholder(src, "promoted=false"))
    assert(t.inneholder(src, "godkjenn kritisk runtime-promotering"))
    assert(t.inneholder(src, "promotion.promoter"))
    assert(t.inneholder(src, "promotion.gjenopprett"))
    assert(t.inneholder(src, "bootstrap/stage0/rollback"))
    assert(t.inneholder(src, "stage0_manifest.skriv_manifest"))
    skriv("✓ Linux v146-promotering er fail-closed på release, strict, hash og rollback\n")
    returner 0
}
