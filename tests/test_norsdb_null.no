// Full 3-verdi NULL (sentinel). Skil NULL frå '' — golden = sqlite3 3.51.0.
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")
    assert_eq(sql.exec(db, "CREATE TABLE t (navn TEXT, by TEXT)"), 0)
    assert_eq(sql.exec(db, "INSERT INTO t VALUES ('Ada', 'Oslo')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO t VALUES ('Eve', NULL)"), 1)
    assert_eq(sql.exec(db, "INSERT INTO t VALUES ('Zoe', '')"), 1)

    assert_eq(sql.query_text(db, "SELECT typeof(NULL)"), "null")
    assert_eq(sql.query_text(db, "SELECT typeof('')"), "text")
    // NULL skilt frå '' i WHERE
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t WHERE by IS NULL"), 1)
    assert_eq(sql.query_text(db, "SELECT navn FROM t WHERE by IS NULL"), "Eve")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t WHERE by = ''"), 1)
    assert_eq(sql.query_text(db, "SELECT navn FROM t WHERE by = ''"), "Zoe")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t WHERE by IS NOT NULL"), 2)
    // COUNT(col) hoppar over NULL, tel ''
    assert_eq(sql.query_int(db, "SELECT COUNT(by) FROM t"), 2)
    // NULL-propagering (typeof for å skilje NULL frå '')
    assert_eq(sql.query_text(db, "SELECT typeof(NULL + 1)"), "null")
    assert_eq(sql.query_text(db, "SELECT typeof('a' || NULL)"), "null")
    // COALESCE: hoppar NULL, men '' er ein verdi
    assert_eq(sql.query_text(db, "SELECT COALESCE(NULL, 'x')"), "x")
    assert_eq(sql.query_text(db, "SELECT COALESCE('', 'x')"), "")
    // NULL = 1 er aldri sann (rad ekskludert)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM t WHERE by = 'X' OR NULL = 1"), 0)


    // LEFT JOIN: umatcha høgre-kolonnar → NULL (ikkje "")
    assert_eq(sql.exec(db, "CREATE TABLE ja (id INTEGER)"), 0)
    assert_eq(sql.exec(db, "CREATE TABLE jb (id INTEGER, v TEXT)"), 0)
    sql.exec(db, "INSERT INTO ja VALUES (1)")
    sql.exec(db, "INSERT INTO ja VALUES (2)")
    sql.exec(db, "INSERT INTO jb VALUES (1, 'x')")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ja LEFT JOIN jb ON ja.id = jb.id WHERE jb.v IS NULL"), 1)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM ja LEFT JOIN jb ON ja.id = jb.id WHERE jb.v IS NOT NULL"), 1)

    skriv("test_norsdb_null OK\n")
    returner 0
}
