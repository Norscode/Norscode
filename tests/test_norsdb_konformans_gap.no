// Konformans for tidlegare dokumenterte gap (docs/NORSDB_KONFORMANS_GAP.md).
// Golden = ekte sqlite3 3.51.0. Denne suiten VERIFISERER at gap G2 (rowid-alias)
// og strftime %f (fraksjons-sekund) no matchar SQLite.
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")

    // ── G2: berre INTEGER PRIMARY KEY (rowid-alias) auto-tildeler ────────
    // Vanleg `id INTEGER` (utan PK): utelaten id → NULL (som SQLite),
    // IKKJE auto-inkrement.
    sql.exec(db, "CREATE TABLE a (id INTEGER, n TEXT)")
    assert_eq(sql.exec(db, "INSERT INTO a (n) VALUES ('x')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO a (n) VALUES ('y')"), 1)
    // sqlite3: begge id er NULL.
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM a WHERE id IS NULL"), 2)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM a WHERE id IS NOT NULL"), 0)
    // Eksplisitt id skal framleis stå.
    assert_eq(sql.exec(db, "INSERT INTO a (id, n) VALUES (5, 'z')"), 1)
    assert_eq(sql.query_text(db, "SELECT n FROM a WHERE id = 5"), "z")

    // INTEGER PRIMARY KEY (kolonne-form) = rowid-alias → auto 1,2.
    sql.exec(db, "CREATE TABLE b (id INTEGER PRIMARY KEY, n TEXT)")
    assert_eq(sql.exec(db, "INSERT INTO b (n) VALUES ('a')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO b (n) VALUES ('b')"), 1)
    assert_eq(sql.query_text(db, "SELECT n FROM b WHERE id = 1"), "a")
    assert_eq(sql.query_text(db, "SELECT n FROM b WHERE id = 2"), "b")

    // Tabell-nivå PRIMARY KEY(id) med INTEGER = rowid-alias → auto 1,2.
    sql.exec(db, "CREATE TABLE c (id INTEGER, n TEXT, PRIMARY KEY(id))")
    assert_eq(sql.exec(db, "INSERT INTO c (n) VALUES ('p')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO c (n) VALUES ('q')"), 1)
    assert_eq(sql.query_text(db, "SELECT n FROM c WHERE id = 1"), "p")
    assert_eq(sql.query_text(db, "SELECT n FROM c WHERE id = 2"), "q")

    // Ikkje-alias PK (namn er ikkje 'id') auto-tildeler heller ikkje andre kolonnar.
    sql.exec(db, "CREATE TABLE d (kode INTEGER PRIMARY KEY, n TEXT)")
    assert_eq(sql.exec(db, "INSERT INTO d (n) VALUES ('m')"), 1)
    assert_eq(sql.query_text(db, "SELECT kode FROM d WHERE n = 'm'"), "1")

    // ── strftime %f: fraksjons-sekund med ekte millisekund ──────────────
    // Ingen fraksjon → SS.000 (uendra).
    assert_eq(sql.query_text(db, "SELECT strftime('%f', '2026-08-22 14:30:15')"), "15.000")
    // Med fraksjon → SS.SSS.
    assert_eq(sql.query_text(db, "SELECT strftime('%f', '2024-03-10 08:09:56.789')"), "56.789")
    assert_eq(sql.query_text(db, "SELECT strftime('%f', '2024-03-10 08:09:56.5')"), "56.500")
    assert_eq(sql.query_text(db, "SELECT strftime('%f', '2024-03-10 08:09:56.25')"), "56.250")
    // Full format med %f.
    assert_eq(sql.query_text(db, "SELECT strftime('%H:%M:%f', '2024-03-10 08:09:56.789')"), "08:09:56.789")
    // Fraksjon overlever heiltals-sekund-modifikator.
    assert_eq(sql.query_text(db, "SELECT strftime('%f', '2024-03-10 08:09:56.789', '+1 second')"), "57.789")
    // 'start of day' nullstiller fraksjonen.
    assert_eq(sql.query_text(db, "SELECT strftime('%f', '2024-03-10 08:09:56.789', 'start of day')"), "00.000")
    // datetime()/time() droppar fraksjon (heiltals-sekund).
    assert_eq(sql.query_text(db, "SELECT datetime('2024-03-10 08:09:56.789')"), "2024-03-10 08:09:56")
    assert_eq(sql.query_text(db, "SELECT time('2024-03-10 08:09:56.789')"), "08:09:56")

    skriv("test_norsdb_konformans_gap OK\n")
    returner 0
}
