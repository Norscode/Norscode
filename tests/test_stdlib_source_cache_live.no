bruk tools.process_runner som prosess

funksjon kompiler(runtime: tekst, root: tekst, stdlib_cache: tekst, ut: tekst) -> ordbok_tekst {
    returner prosess.køyr(runtime,
        ["compile", root + "/tests/fixtures/performance_compile_probe.no", ut],
        root, {
            "NORSCODE_ROOT": root,
            "NORSCODE_NATIVE_TOOL_CACHE": "0",
            "NORSCODE_USE_PRECOMPILED_SELFHOST": "0",
            "NORSCODE_USE_PRECOMPILED_STDLIB": stdlib_cache,
            "NORSCODE_STDLIB_CACHE_TRACE": "1",
            "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
            "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
        }, 120000)
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la runtime = tekst(info["executable"])
    la root = tekst(info["cwd"])
    la dir = root + "/build/stdlib-source-cache-live-" + builtin.random_hex(12)
    builtin.mkdir_p(dir)
    la source_out = dir + "/source.ncb.json"
    la cache_out = dir + "/cache.ncb.json"
    la source = kompiler(runtime, root, "0", source_out)
    la cache = kompiler(runtime, root, "1", cache_out)
    hvis ikkje prosess.ok(source) eller ikkje prosess.ok(cache) {
        prosess.skriv_resultat(source)
        prosess.skriv_resultat(cache)
    }
    hvis ikkje builtin.contains(tekst(cache["stdout"]), "[stdlib-cache] hit std/sha256.no") eller
       ikkje builtin.contains(tekst(cache["stdout"]), "[stdlib-cache] hit std/tekst.no") {
        prosess.skriv_resultat(cache)
    }
    assert(prosess.ok(source) og prosess.ok(cache))
    assert(ikkje builtin.contains(tekst(source["stdout"]), "[stdlib-cache] hit"))
    assert(builtin.contains(tekst(cache["stdout"]), "[stdlib-cache] hit std/sha256.no"))
    assert(builtin.contains(tekst(cache["stdout"]), "[stdlib-cache] hit std/tekst.no"))
    assert(builtin.sha256_bytes(fil_les_binær(source_out)) ==
           builtin.sha256_bytes(fil_les_binær(cache_out)))
    skriv("test_stdlib_source_cache_live OK")
    returner 0
}
