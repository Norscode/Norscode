# R3 / F18-regresjon: `asynk` rett før `funksjon` blir berre ASYNC når det
# ikkje er eit importalias eller modulsegment. `bruk std.asynk som asynk`
# (eller `bruk std.asynk`) med `funksjon` på neste linje vart lese som
# nøkkelordet ASYNC og gav parserfeil. Køyrer gjennom KJELDE-lexer/-kompilator
# og KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.lexer.lexer_m1 som lexer

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon token_typar(kjelde: tekst) -> tekst {
    la tokens = lexer.lex(kjelde)
    la ut = []
    la i = 0
    mens i < lengde(tokens) {
        legg_til(ut, tokens[i]["type"])
        i = i + 1
    }
    returner builtin.join(ut, " ")
}

funksjon start() -> heiltall {
    # Alias `som asynk` + funksjon på neste linje.
    la alias_kjelde = "bruk std.asynk som asynk\nfunksjon start() -> heiltall {\n    returner 7\n}\n"
    assert(ikkje builtin.contains(token_typar(alias_kjelde), "ASYNC"))
    assert_eq(køyr(alias_kjelde), "7")
    # Modulsegment `std.asynk` utan alias.
    la sti_kjelde = "bruk std.asynk\nfunksjon start() -> heiltall {\n    returner 8\n}\n"
    assert(ikkje builtin.contains(token_typar(sti_kjelde), "ASYNC"))
    assert_eq(køyr(sti_kjelde), "8")
    # `asynk funksjon` er framleis ein asynkron funksjon.
    assert(builtin.contains(token_typar("asynk funksjon f() -> heiltall { returner 1 }\n"), "ASYNC FUNKSJON"))
    returner 0
}
