# X.509-kjedevalidering i rein Norscode (RFC 5280) - Ed25519-signaturkjede.
# Byggjer ein root-CA + leaf, validerer kjeda og køyrer negative fail-closed-testar.
bruk std.x509_chain som chain
bruk std.x509 som x509
bruk std.ed25519 som eddsa
funksjon _seed(base: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < 32 { legg_til(ut, (base + i * 11) & 255) i = i + 1 }
    returner ut
}
funksjon start() -> heiltall {
    la ca_seed = _seed(3)
    la leaf_seed = _seed(60)
    la ca_pub = eddsa.public_key(ca_seed)
    la leaf_pub = eddsa.public_key(leaf_seed)

    # Root-CA (sjølvsignert): issuer == subject == "Norscode Root CA".
    la root = chain.bygg_ed25519_cert({
        "serial": [1], "issuer_cn": "Norscode Root CA", "subject_cn": "Norscode Root CA",
        "not_before": "250101000000Z", "not_after": "350101000000Z",
        "subject_pub": ca_pub, "dns": [], "issuer_seed": ca_seed
    })
    # Leaf signert av root, SAN dNSName norscode.example + *.norscode.no.
    la leaf = chain.bygg_ed25519_cert({
        "serial": [2], "issuer_cn": "Norscode Root CA", "subject_cn": "norscode.example",
        "not_before": "250101000000Z", "not_after": "270101000000Z",
        "subject_pub": leaf_pub, "dns": ["norscode.example", "*.norscode.no"], "issuer_seed": ca_seed
    })

    # Fingerprint på root for trust store.
    la root_meta = x509.les_der(root)
    assert_eq(root_meta["status"], "ok")
    la trust = [root_meta["fingerprint_sha256"]]

    # Merk: Ed25519 er tungt i pure VM; denne testen held seg til éin full aksept +
    # dei billige fail-closed-kontrollane (som feilar før signaturkostnad), for å
    # halde seg innanfor sandkasse-tidsbudsjettet. Tukla-signatur og trust-anchor-
    # avvising med full signaturverifikasjon er dekt i RSA-/ECDSA-kjedetestane.

    # (1) Gyldig kjede -> godkjent (full Ed25519-verifikasjon av leaf-link + anker).
    la r = chain.valider_kjede([leaf, root], trust, "norscode.example", "2026-08-07T12:00:00Z")
    assert_eq(r["gyldig"], sann)

    # (2) Feil vertsnamn -> avvist (billig, før signatur).
    la r3 = chain.valider_kjede([leaf, root], trust, "ondsinnet.example", "2026-08-07T12:00:00Z")
    assert_eq(r3["gyldig"], usann)

    # (3) Utløpt -> avvist (billig, før signatur).
    la r4 = chain.valider_kjede([leaf, root], trust, "norscode.example", "2028-01-02T00:00:00Z")
    assert_eq(r4["gyldig"], usann)

    # (4) Ikkje gyldig enno -> avvist (billig, før signatur).
    la r5 = chain.valider_kjede([leaf, root], trust, "norscode.example", "2024-12-31T00:00:00Z")
    assert_eq(r5["gyldig"], usann)

    # (5) Wildcard-hostmatch (rein logikk, ingen signaturkostnad).
    assert_eq(chain.host_matcher("api.norscode.no", "*.norscode.no"), sann)
    assert_eq(chain.host_matcher("norscode.no", "*.norscode.no"), usann)

    assert_eq(chain.status()["abi"], "norscode-x509-chain-v1")
    skriv("test_x509_chain_ed25519 OK")
    returner 0
}
