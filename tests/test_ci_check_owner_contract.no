bruk std.tekst som t

funksjon start() -> heiltall {
    la runner = fil_les("tools/ci_shell_runner.no")
    la owner = fil_les("tools/ci_check_source.no")
    la workflow = fil_les(".github/workflows/ci.yml")

    assert(t.inneholder(runner, "hvis cmd == \"check\" { returner \"tools/ci_check_source.no\" }"))
    assert(t.inneholder(owner, "builtin.kompiler_fil(builtin.fil_les(src), \"__main__\")"))
    assert(ikkje t.inneholder(owner, "bruk selfhost.kompiler"))
    assert(t.inneholder(owner, "builtin.argv_operation"))
    assert(t.inneholder(runner, "barn_miljø[\"NORSCODE_CI_CHECK_FILE\"] = argument[1]"))
    assert(t.inneholder(workflow, "NORSCODE_VM_CI_COMMAND: \"./bin/nc check app.no\""))
    assert(ikkje t.inneholder(workflow,
        "name: Kontroller app-syntaks\n        continue-on-error: true"))
    assert(ikkje t.inneholder(workflow, "timeout-minutes: 5"))
    skriv("test_ci_check_owner_contract OK\n")
    returner 0
}
