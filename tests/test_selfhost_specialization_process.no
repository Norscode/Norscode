// Samanlikn fersk-prosess-spesialisering med den lokale referansen og krev ekte ELF.
bruk tools.selfcompile_stage0_elf som bygg

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la dir = root + "/build/specialization_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(dir)
    la kode = []
    for namn i ["NORSCODE_GEN1_SOURCE_FILE", "NORSCODE_GEN1_OUTPUT_FILE", "NORSCODE_GEN1_MODULE", "NORSCODE_GEN1_PROGRESS_FILE"] {
        legg_til(kode, ["PUSH_CONST", namn])
        legg_til(kode, ["CALL", "builtin.miljo_hent", 1])
        legg_til(kode, ["POP"])
    }
    legg_til(kode, ["PUSH_CONST", 0])
    legg_til(kode, ["RETURN"])
    la bunt = {"format": "norscode-bytecode-v1", "entry": "probe.start", "module_initializers": [], "global_names": {}, "functions": {
        "probe.start": {"params": [], "code": kode},
        "probe.keep": {"params": [], "code": [["PUSH_CONST", 9], ["RETURN"]]}
    }}
    la base = dir + "/base.ncb.json"
    builtin.fil_skriv(base, builtin.json_skriv(bunt))
    la elf = bygg.spesialiser_gen1_source_executor_lokalt(root, base, dir, "selfhost/parser.no", "selfhost.parser", "parser.ncb.json")
    assert(elf != "")
    la venta_ncb = builtin.fil_les(dir + "/executor-parser.ncb.json")
    la venta_sha = bygg.sha256_for(elf)
    assert(lengde(venta_sha) == 64)
    assert_eq(bygg.spesialiser_gen1_source_executor(root, base, dir, "selfhost/parser.no", "selfhost.parser", "parser.ncb.json"), elf)
    assert_eq(builtin.fil_les(dir + "/executor-parser.ncb.json"), venta_ncb)
    assert_eq(bygg.sha256_for(elf), venta_sha)
    // Fleire separate barn må få eigne konstantar, ikkje arve førre modul.
    for modul i ["probe.a", "probe.b", "probe.c"] {
        la namn = modul + ".ncb.json"
        assert(bygg.spesialiser_gen1_source_executor(root, base, dir, "selfhost/json.no", modul, namn) != "")
        la ncb = builtin.json_parse_raw(builtin.fil_les(dir + "/executor-" + namn))
        assert_eq(ncb["functions"]["probe.start"]["code"][4][1], modul)
        assert(har_nokkel(ncb["functions"], "probe.keep"))
    }
    // Barnet må feile på ufullstendig binding, sjølv om gamal ELF ligg att.
    bunt["functions"]["probe.start"]["code"] = [["PUSH_CONST", 0], ["RETURN"]]
    builtin.fil_skriv(base, builtin.json_skriv(bunt))
    assert_eq(bygg.spesialiser_gen1_source_executor(root, base, dir, "selfhost/parser.no", "selfhost.parser", "parser.ncb.json"), "")
    skriv("test_selfhost_specialization_process OK\n")
    returner 0
}
