bruk std.prosess som prosess

funksjon start() -> heiltall {
    la policy = prosess.ny_policy("async-environment-attestation")
    prosess.tillat_alle(policy)
    prosess.aktiver_køyring(policy)

    la plan = prosess.start_argv_plan("/usr/bin/env", [])
    plan = prosess.med_timeout(plan, 10)
    plan = prosess.med_maks_output(plan, 8192)
    plan = prosess.med_sandbox(plan, "none", 0, 64, usann)
    plan = prosess.med_miljø(plan, {
        "PATH": "/nonexistent",
        "NC_ASYNC_ENV_PROBE": "norscode-native"
    })
    la handle = prosess.start_argv_async_trygt(policy, plan)
    skriv("async spawn status=" + tekst(handle["status"]) + "\n")
    assert_eq(handle["status"], "kjorer")
    la ferdig = prosess.native_async_vent(handle, 10000)
    skriv("async wait status=" + tekst(ferdig["status"]) + " exit=" + tekst(ferdig["exit_code"]) + "\n")
    assert_eq(ferdig["status"], "ferdig")
    assert_eq(heltall_fra_tekst(ferdig["exit_code"]), 0)
    la output = prosess.native_async_les(handle)
    skriv("async stdout=" + tekst(output["stdout"]) + "\n")
    skriv("async stderr=" + tekst(output["stderr"]) + "\n")
    assert(builtin.index_of(output["stdout"], "PATH=/nonexistent") >= 0)
    assert(builtin.index_of(output["stdout"], "NC_ASYNC_ENV_PROBE=norscode-native") >= 0)
    assert(builtin.index_of(output["stdout"], "HOME=") < 0)
    assert_eq(prosess.native_async_lukk(handle)["status"], "ferdig")
    skriv("test_process_async_environment OK\n")
    returner 0
}
