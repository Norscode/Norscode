bruk std.runtime.process_abi som process_abi
bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la runtime = tekst(info["executable"])
    la root = tekst(info["cwd"])
    la resultat = prosess.køyr(runtime, ["run", "tests/fixtures/process_metrics_child.no"], root, {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read",
        "NORSCODE_VM_DISK_ROOT": root,
        "PATH": "/nonexistent"
    }, 30000)
    assert(prosess.ok(resultat))
    assert(process_abi.gyldig_resultat(resultat))
    assert(prosess.veggtid_ms(resultat) >= 0)
    assert(prosess.minnetopp_bytes(resultat) > 0)
    returner 0
}
