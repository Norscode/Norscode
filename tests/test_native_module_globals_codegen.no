bruk selfhost.native_execution.native_codegen_v2 som codegen

funksjon tel_mønster(bytes, mønster) -> heiltall {
    la treff: heiltall = 0
    la i: heiltall = 0
    mens i + lengde(mønster) <= lengde(bytes) {
        la lik = sann
        la j: heiltall = 0
        mens j < lengde(mønster) {
            hvis bytes[i + j] != mønster[j] { lik = usann }
            j = j + 1
        }
        hvis lik { treff = treff + 1 }
        i = i + 1
    }
    returner treff
}

funksjon u64_le(verdi: heiltall) {
    la bytes = []
    la i: heiltall = 0
    mens i < 8 {
        legg_til(bytes, (verdi >> (i * 8)) & 255)
        i = i + 1
    }
    returner bytes
}

funksjon start() -> heiltall {
    la ncb = fil_les("tests/fixtures/native_codegen_module_globals_probe.ncb.json")
    la elf = codegen.kompiler_v2(ncb)
    assert_eq(elf[0], 127)
    assert_eq(elf[1], 69)
    assert_eq(elf[2], 76)
    assert_eq(elf[3], 70)

    // Første globalslot er host-ABI + 16. Både STORE_GLOBAL og LOAD_GLOBAL
    // skal materialisere den same absolutte slotadressa i maskinkoden.
    la slot = codegen.HOST_ABI_VA() + 16
    assert(tel_mønster(elf, u64_le(slot)) >= 2)
    // _start skal i tillegg ha to rel32-kall etter heap-init: initializer og
    // deretter probe.start. Levande Linux-køyring verifiserer returverdien 42.
    returner 0
}
