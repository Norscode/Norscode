bruk selfhost.native_execution.native_codegen_v2 som codegen

funksjon tel_mønster(bytes, mønster) -> heiltall {
    la treff: heiltall = 0
    la i: heiltall = 0
    mens i + lengde(mønster) <= lengde(bytes) {
        la lik = sann
        la j: heiltall = 0
        mens j < lengde(mønster) {
            hvis bytes[i + j] != mønster[j] { lik = usann }
            j = j + 1
        }
        hvis lik { treff = treff + 1 }
        i = i + 1
    }
    returner treff
}

funksjon u64_le(verdi: heiltall) {
    la bytes = []
    la i: heiltall = 0
    mens i < 8 {
        legg_til(bytes, (verdi >> (i * 8)) & 255)
        i = i + 1
    }
    returner bytes
}

// Minimal modul «probe» med éin modulglobal (answer = 41) og start = answer + 1.
// Bygd som data i testen i staden for ein committa NCB-fikstur (JSON-avvikling J1d).
funksjon probe_ncb() -> tekst {
    la ncb = {
        "format": "ncb-v1",
        "entry": "probe.start",
        "module_initializers": ["probe.__module_init__"],
        "global_names": {"probe": ["answer"]},
        "imports": [],
        "route_handlers": [],
        "functions": {
            "probe.__module_init__": {
                "name": "__module_init__", "module": "probe", "params": [],
                "is_async": usann, "module_init": sann,
                "code": [["PUSH_CONST", 41], ["STORE_GLOBAL", "answer"], ["PUSH_CONST", null], ["RETURN"]],
                "source_lines": [], "source_columns": []
            },
            "probe.start": {
                "name": "start", "module": "probe", "params": [], "is_async": usann,
                "code": [["LOAD_GLOBAL", "answer"], ["PUSH_CONST", 1], ["BINARY_ADD"], ["RETURN"]],
                "source_lines": [], "source_columns": []
            }
        }
    }
    returner json_skriv(ncb)
}

funksjon start() -> heiltall {
    la ncb = probe_ncb()
    assert(builtin.contains(ncb, "STORE_GLOBAL") og builtin.contains(ncb, "probe.__module_init__"))
    la elf = codegen.kompiler_v2(ncb)
    assert_eq(elf[0], 127)
    assert_eq(elf[1], 69)
    assert_eq(elf[2], 76)
    assert_eq(elf[3], 70)

    // Første globalslot er host-ABI + 16. Både STORE_GLOBAL og LOAD_GLOBAL
    // skal materialisere den same absolutte slotadressa i maskinkoden.
    la slot = codegen.HOST_ABI_VA() + 16
    assert(tel_mønster(elf, u64_le(slot)) >= 2)
    // _start skal i tillegg ha to rel32-kall etter heap-init: initializer og
    // deretter probe.start. Levande Linux-køyring verifiserer returverdien 42.
    returner 0
}
