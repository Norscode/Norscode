bruk std.runtime_filesystem som fs

funksjon start() -> heiltall {
    la temp = fs.native_tempområde("build", "temp-fallback-")
    assert_eq(temp["status"], "created")
    assert_inneholder(temp["relative"], "temp-fallback-")
    la slett = fs.native_slett_mappe("build", temp["relative"])
    assert_eq(slett["status"], "deleted")
    skriv("test_runtime_filesystem_temp_fallback OK")
    returner 0
}
