    assert(t.inneholder(src, "stdlib-cache har levande source/cache-test"))
    assert(t.inneholder(src, "native compile-cache bind modulnamn i nøkkelen"))
    assert(t.inneholder(src, "native compile brukar innhaldsadressert cache"))
    assert(t.inneholder(src, "native compile normaliserer cacheartefakt før publisering"))
    assert(t.inneholder(src, "native compile-cache har levande modul- og trefftest"))
    assert(t.inneholder(src, "NCB har Norscode-eigd straumformat"))
    assert(t.inneholder(src, "NCB-straumformat har versjonert ABI"))
    assert(t.inneholder(src, "NCB-straumformat har stabil magic"))
    assert(t.inneholder(src, "NCB-straumskrivar brukar native fil-ABI"))
    assert(t.inneholder(src, "NCB-straumlesar støttar lat funksjonsmaterialisering"))
    assert(t.inneholder(src, "bundler har eksplisitt NCB-straumval"))
    assert(t.inneholder(src, "bundler skriv NCB gjennom straumformatet"))
    assert(t.inneholder(src, "VM-executor les stor NCB late gjennom straumformatet"))
    assert(t.inneholder(src, "VM materialiserer late funksjonar ved fyrste bruk"))
    assert(t.inneholder(src, "VM erstattar lat funksjon med materialisert verdi"))
    assert(t.inneholder(src, "NCB-straumformat har levande rundturstest"))
    assert(t.inneholder(src, "NCB-straummaling har deterministisk fixturebyggjar"))
    assert(t.inneholder(src, "NCB-straummaling er Norscode-eigd"))
    assert(t.inneholder(src, "NCB-straummaling har versjonert rapport"))
    assert(t.inneholder(src, "NCB-straummaling feilar lukka ved regresjon"))

    skriv("test_release_preflight OK")
    returner 0
}
