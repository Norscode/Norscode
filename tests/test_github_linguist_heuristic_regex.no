// Kontrollerer REGEX-mønstra i Linguist-forslaget med Norscode sin regex-motor.
// GitHub sin Ruby/PCRE-klassifisering må fortsatt testast separat upstream.
bruk std.regex som re
bruk std.tekst som t

funksjon oppdag(kjelde: tekst, f: tekst, r: tekst, s: tekst, kompakt: tekst, gjerde: tekst) -> bool {
    // Ingen dokumentasjon med inngjerda kodeblokker skal bli Norscode.
    hvis re.samsvar(kjelde, "(?m)" + gjerde) { returner usann }
    la fleirlinje = re.samsvar(kjelde, "(?m)" + f) og re.samsvar(kjelde, "(?m)" + r) og re.samsvar(kjelde, "(?m)" + s)
    returner fleirlinje eller re.samsvar(kjelde, "(?m)" + kompakt)
}

funksjon sjekk(ok: bool, namn: tekst) -> heiltall {
    hvis ikkje ok {
        skriv("FEIL " + namn + "\n")
        returner 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la funksjon_mønster = "^[ \\t]*funksjon[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\([^\\r\\n)]*\\)(?:[ \\t]*->[ \\t]*[^\\r\\n{}]+)?[ \\t]*(?:\\{|:)?[ \\t]*$"
    la retur_mønster = "^[ \\t]+returner[ \\t]+[^\\s\\r\\n]"
    la slutt_mønster = "^[ \\t]*(?:\\}|slutt)[ \\t]*$"
    la kompakt_mønster = "^[ \\t]*funksjon[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\([^\\r\\n)]*\\)(?:[ \\t]*->[ \\t]*[^\\r\\n{}]+)?[ \\t]*\\{[ \\t]*returner[ \\t]+[^\\r\\n{}]+[ \\t]*\\}[ \\t]*$"
    la gjerde_mønster = "^[ \\t]*```"
    la utkast = fil_les("docs/04-how-to-guides/linguist-proposal/norscode-heuristics.yml")
    la feil = 0

    feil = feil + sjekk(t.inneholder(utkast, funksjon_mønster), "funksjonsmønster finst i YAML")
    feil = feil + sjekk(t.inneholder(utkast, retur_mønster), "returmønster finst i YAML")
    feil = feil + sjekk(t.inneholder(utkast, slutt_mønster), "sluttmønster finst i YAML")
    feil = feil + sjekk(t.inneholder(utkast, kompakt_mønster), "kompaktmønster finst i YAML")
    feil = feil + sjekk(t.inneholder(utkast, gjerde_mønster), "gjerde-regel finst i YAML")
    feil = feil + sjekk(oppdag("pakke compiler\nfunksjon init_runtime() -> CompilerRuntimeState {\n    returner 0\n}\n", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "positiv 1")
    feil = feil + sjekk(oppdag("funksjon svar()\n    returner 42\nslutt\n", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "positiv 2")
    feil = feil + sjekk(oppdag("funksjon dobbel(x: heiltall) -> heiltall {\n    la y = x + x\n    returner y\n}\n", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "positiv 3")
    feil = feil + sjekk(ikkje oppdag("Dette er en vanlig norsk tekstfil med e-post eksempel.no.", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 1")
    feil = feil + sjekk(ikkje oppdag("# funksjon feil() {\n# returner 1\n# }", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 2")
    feil = feil + sjekk(ikkje oppdag("// funksjon feil() {\n// returner 1\n// }", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 3")
    feil = feil + sjekk(ikkje oppdag("Vennligst returner pakken før mandag.", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 4")
    feil = feil + sjekk(ikkje oppdag("funksjon forklaring() er skrevet i dokumentet.\nSkriv returner i notatene.\n}", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 5")
    feil = feil + sjekk(ikkje oppdag("funksjon tom() {\n    skriv(\"ok\")\n}", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 6")
    feil = feil + sjekk(ikkje oppdag("Notat: funksjon x() { returner 2 }", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 7")
    feil = feil + sjekk(ikkje oppdag("\"funksjon x() {\"\n\"returner 3\"\n\"}\"", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ 8")

    feil = feil + sjekk(oppdag("funksjon svar() { returner 42 }", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "positiv kompakt")
    feil = feil + sjekk(oppdag("funksjon svar() -> heiltall { returner 42 }", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "positiv kompakt typa")
    feil = feil + sjekk(ikkje oppdag("# Notat\n```norscode\nfunksjon test() {\n    returner 1\n}\n```\nDette er tekst.", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ dokumentert kode")
    feil = feil + sjekk(ikkje oppdag("```norscode\nfunksjon test() { returner 1 }\n```\n", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ kompakt kodegjerde")
    feil = feil + sjekk(ikkje oppdag("Det er en funksjon med kode.\nfunksjon svar() { returner 42 }\n```\n", funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "negativ kodegjerde etter koden")

    hvis feil != 0 {
        skriv("test_github_linguist_heuristic_regex FEIL " + tekst(feil) + "\n")
        returner 1
    }
    skriv("test_github_linguist_heuristic_regex OK\n")
    returner 0
}
