// tests/test_os_k0_boot.no — Norscode OS K0: byggjekjede + QEMU-sele.
//
// Byggjer os/kjerne/hei.no til eit GC-modus linux-x86_64-ELF, pakkar det med den
// Norscode-emitterte trampolinen i «ivrig» modus (K0: heap/stakk identitetskarta med
// 2 MiB-sider) og bootar biletet i qemu-system-x86_64 -m 2G. Krev «Hei frå Norscode OS»
// over COM1 og exit 0 via isa-debug-exit (QEMU-status 1).
// Hoppar reint over (rc 0, med grunn) når qemu-system-x86_64 manglar.

bruk os.boot.byggjar som byggjar
bruk os.boot.qemu som qemu

funksjon start() -> heiltall {
    la q = qemu.finn_qemu()
    hvis q == "" {
        skriv("HOPPA: qemu-system-x86_64 finst ikkje (set OS_QEMU eller installer QEMU)\n")
        returner 0
    }
    la r = byggjar.bygg_kjerne("os/kjerne/hei.no", "build/os/test_k0.img", "ivrig")
    hvis r["feil"] != "" { skriv("FEIL (bygg): " + r["feil"] + "\n") }
    assert_eq(r["feil"], "")
    skriv("bilete " + r["bilete"] + " (" + r["bilete_bytes"] + " B)\n")
    la root = byggjar.rot()
    la k = qemu.køyr(q, r["bilete"], "2G", 120000, root + "/build/os/test_k0.serie.txt", root + "/build/os/test_k0.debugcon.txt")
    skriv("status=" + k["status"] + " qemu=" + k["qemu_kode"] + " kjerne=" + k["kjerne_kode"] + " ms=" + k["ms"] + "\n")
    skriv("seriell: " + k["serie"])
    skriv("debugcon: " + k["debugcon"])
    assert_eq(k["status"], "ferdig")
    assert_eq(k["qemu_kode"], "1")
    assert_eq(k["kjerne_kode"], "0")
    assert_eq(k["serie"], "Hei frå Norscode OS\n")
    assert(builtin.index_of(k["debugcon"], "[kjerne] exit=0000000000000000") >= 0)
    skriv("OK: K0 bootar i QEMU\n")
    returner 0
}
