// Linux arm64 AOT: kjelde/importar -> statisk AArch64 ELF.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(heltall_fra_tekst(tekst(resultat["exit_code"])), kode)
    }
    returner 0
}

funksjon docker_køyr(root: tekst, namn: tekst) -> ordbok_tekst {
    la docker = miljo_hent("NORSCODE_DOCKER_BIN")
    hvis docker == "" { docker = "docker" }
    returner køyr(docker, ["run", "--platform", "linux/arm64", "--rm", "-v", "/private/tmp:/work:ro", "alpine:3.20", "/work/" + namn], root, 180000)
}

funksjon verifiser_køyring(root: tekst, binær: tekst, namn: tekst, kode: heiltall, native: boolsk) -> heiltall {
    hvis native {
        krev_exit(køyr(binær, [], root, 30000), kode)
    } ellers hvis miljo_hent("NORSCODE_VERIFY_LINUX_DOCKER") == "1" {
        krev_exit(docker_køyr(root, namn), kode)
    }
    returner 0
}

funksjon bygg_og_verifiser(root: tekst, nc: tekst, namn: tekst, kjelde: tekst, kode: heiltall, native: boolsk) -> heiltall {
    la binær = "/tmp/" + namn
    krev_exit(køyr(nc, ["bygg-native", "--target", "linux-arm64", kjelde, binær], root, 180000), 0)
    la bytes = builtin.fil_les_binær(binær)
    assert(lengde(bytes) > 4096)
    assert_eq(bytes[0], 0x7F)
    assert_eq(bytes[1], 0x45)
    assert_eq(bytes[2], 0x4C)
    assert_eq(bytes[3], 0x46)
    assert_eq(bytes[18], 183)
    verifiser_køyring(root, binær, namn, kode, native)
    filops.slett_fil(binær)
    returner 0
}

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la info = builtin.system_info()
    la maskin = tekst(info["machine"])
    la native = tekst(info["system"]) == "Linux" og (maskin == "aarch64" eller maskin == "arm64")
    la nc = runtime(root)
    la id = builtin.random_hex(8)

    bygg_og_verifiser(root, nc, "norscode_linux_arm_aot_" + id, root + "/tests/fixtures/macos_aot_std_math.no", 49, native)
    bygg_og_verifiser(root, nc, "norscode_linux_arm_control_" + id, root + "/tests/fixtures/macos_aot_std_math_control.no", 10, native)
    bygg_og_verifiser(root, nc, "norscode_linux_arm_common_ops_" + id, root + "/tests/fixtures/aot_common_integer_ops.no", 11, native)
    returner 0
}
