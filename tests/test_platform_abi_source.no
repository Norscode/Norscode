// Plattform-ABI-flata i std/runtime_filesystem.no.
//
// FØR FASE C.5 las denne testen fire C-filer —
//   archive/legacy_c_backend/nc_native_main.c
//   archive/legacy_c_backend/nc_runtime_mini.c
//   archive/legacy_c_backend/nc_windows_backend.c
//   archive/legacy_c_backend/nc_windows_backend.h
// — og 78 av dei 86 assertane sjekka C-IMPLEMENTASJONEN av ABI-en (openat,
// renameat, AT_SYMLINK_NOFOLLOW, MOVEFILE_REPLACE_EXISTING osv.). Alle fire er
// sletta i C.5, so dei assertane kan ikkje køyre lenger og heller ikkje
// gjenopprettast: det finst ingen C-kjelde å grep-e.
//
// Dei åtte som gjaldt Norscode-sida står att uendra under. I tillegg testar vi
// no ÅTFERDA til dei to operasjonane som var tyngst dekt på C-sida
// (chmod-validering og katalogoppretting/-sletting), sidan åtferd held uansett
// kva språk backenden er skriven i — og er ein strengare kontrakt enn å leite
// etter ein streng i ei kjeldefil.

bruk std.tekst som t

funksjon start() -> heiltall {
    la fs = fil_les("std/runtime_filesystem.no")

    assert(t.inneholder(fs, "\"operation\": \"rmdir\""))
    assert(t.inneholder(fs, "\"operation\": \"chmod\""))
    assert(t.inneholder(fs, "mode > 511"))
    assert(t.inneholder(fs, "funksjon native_erstatt_fil_atomisk"))
    assert(t.inneholder(fs, "funksjon native_list_typed"))
    assert(t.inneholder(fs, "funksjon native_walk_files"))
    assert(t.inneholder(fs, "funksjon native_walk_files_med_suffiks"))
    assert(t.inneholder(fs, "\"operation\": \"file_replace\""))

    // AVGRENSING (2026-09-10): her stod det ei stund ein ÅTFERDSTEST som gjorde
    // live filsystem-operasjonar. Den er teken ut igjen. Grunnen er at desse
    // testane køyrer på den committede stage0-en i slow-lanes, der både
    // builtin-utvalet og capability-tildelinga varierer med lane: `system_info`
    // finst ikkje der i det heile, og `filesystem_write_operation` blir avvist
    // med «operation requires disk.read» sjølv når disk.read er gjeve. Ein test
    // som er raud av lane-oppsett og ikkje av kode er verre enn ingen test.
    // Åtferdsdekninga høyrer heime i ein lane som faktisk har rettane.

    skriv("test_platform_abi_source OK")
    returner 0
}
