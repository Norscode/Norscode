bruk std.tekst som t

funksjon tel(haystack: tekst, needle: tekst) -> heiltall {
    returner lengde(builtin.split(haystack, needle)) - 1
}

funksjon start() -> heiltall {
    la native = fil_les("archive/legacy_c_backend/nc_native_main.c")
    la runtime = fil_les("archive/legacy_c_backend/nc_runtime_mini.c")
    la windows = fil_les("archive/legacy_c_backend/nc_windows_backend.c")
    la windows_h = fil_les("archive/legacy_c_backend/nc_windows_backend.h")
    la fs = fil_les("std/runtime_filesystem.no")

    # POSIX-operasjonane går relativt til eit verifisert kataloghandtak.
    assert(t.inneholder(native, "static int nc_rmdir_beneath"))
    assert(t.inneholder(native, "unlinkat(dirfd,part,AT_REMOVEDIR)"))
    assert(t.inneholder(native, "static int nc_chmod_beneath"))
    assert(t.inneholder(native, "nc_open_beneath(root,relative,O_RDONLY,0)"))
    assert(t.inneholder(native, "fchmod(fd,mode)"))
    assert(t.inneholder(native, "static int nc_regular_file_replace_beneath"))
    assert(t.inneholder(native, "renameat(source_parent, source_name, target_parent, target_name)"))

    # Windows-operasjonane brukar validerte handtak og reparse-sikker opning.
    assert(t.inneholder(windows_h, "ncw_directory_delete"))
    assert(t.inneholder(windows_h, "ncw_file_set_mode"))
    assert(t.inneholder(windows_h, "NcwPathStat"))
    assert(t.inneholder(windows_h, "ncw_path_stat"))
    assert(t.inneholder(windows_h, "ncw_file_replace"))
    assert(t.inneholder(windows, "FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT"))
    assert(t.inneholder(windows, "ncw_verify_open_handle(handle, root"))
    assert(t.inneholder(windows, "SetFileInformationByHandle(handle, FileDispositionInfo"))
    assert(t.inneholder(windows, "SetFileInformationByHandle(handle, FileBasicInfo"))
    assert(t.inneholder(windows, "GetFileInformationByHandleEx(handle, FileStandardInfo"))
    assert(t.inneholder(windows, "MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH"))

    # ABI-dispatch og Norscode-standardbibliotek må eksponere dei same operasjonane.
    assert(t.inneholder(native, "if (!strcmp(operation,\"rmdir\"))"))
    assert(t.inneholder(native, "if (!strcmp(operation,\"chmod\"))"))
    assert(t.inneholder(native, "if (!strcmp(operation, \"path_stat\"))"))
    assert(t.inneholder(native, "!strcmp(operation, \"list_typed\")"))
    assert(t.inneholder(native, "fstatat(dirfd, entry->d_name"))
    assert(t.inneholder(native, "!strcmp(operation, \"walk_files\")"))
    assert(t.inneholder(native, "nc_walk_files_beneath"))
    assert(t.inneholder(native, "buffer->count >= 200000"))
    assert(t.inneholder(native, "nc_walk_files_matches_suffix"))
    assert(t.inneholder(native, "if (!strcmp(operation,\"file_replace\"))"))
    assert(t.inneholder(native, "fstat(fd, &st)"))
    assert(t.inneholder(fs, "\"operation\": \"rmdir\""))
    assert(t.inneholder(fs, "\"operation\": \"chmod\""))
    assert(t.inneholder(fs, "mode > 511"))
    assert(t.inneholder(fs, "funksjon native_erstatt_fil_atomisk"))
    assert(t.inneholder(fs, "funksjon native_list_typed"))
    assert(t.inneholder(fs, "funksjon native_walk_files"))
    assert(t.inneholder(fs, "funksjon native_walk_files_med_suffiks"))
    assert(t.inneholder(fs, "\"operation\": \"file_replace\""))

    # Interaktiv stdin har avgrensa linjelengd og finst i alle VM-dispatchbanar.
    assert(t.inneholder(runtime, "static NcVal *nc_builtin_readline"))
    assert(t.inneholder(runtime, "linje overskrid 65535 byte"))
    assert(t.inneholder(runtime, "fgetc(stdin)"))
    assert(tel(native, "!strcmp(builtin, \"readline\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"readline\")") == 1)
    assert(tel(native, "!strcmp(cn,\"readline\")") == 1)

    # Skjult passordinput går gjennom ein eigen terminal-ABI og gjenopprettar ekko.
    assert(t.inneholder(native, "norscode-terminal-v1"))
    assert(t.inneholder(native, "static int nc_terminal_set_echo"))
    assert(t.inneholder(native, "tcsetattr(STDIN_FILENO, TCSAFLUSH"))
    assert(t.inneholder(native, "SetConsoleMode(input, mode)"))
    assert(tel(native, "!strcmp(builtin, \"terminal_operation\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"terminal_operation\")") == 1)
    assert(tel(native, "!strcmp(cn,\"terminal_operation\")") == 1)

    # Systeminfo samlar uname/CPU/minne/køyrbar sti i éin versjonert ABI.
    assert(t.inneholder(native, "norscode-system-info-v1"))
    assert(t.inneholder(native, "GetNativeSystemInfo"))
    assert(t.inneholder(native, "GlobalMemoryStatusEx"))
    assert(t.inneholder(native, "uname(&uts)"))
    assert(t.inneholder(native, "sysconf(_SC_NPROCESSORS_ONLN)"))
    assert(t.inneholder(native, "sysctlbyname(\"hw.memsize\""))
    assert(t.inneholder(native, "sysinfo(&memory_info)"))
    assert(tel(native, "!strcmp(builtin, \"system_info\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"system_info\")") == 1)
    assert(tel(native, "!strcmp(cn,\"system_info\")") == 1)

    # PATH-oppslag er process.exec-beskytta og opnar ikkje generell disk.read.
    assert(t.inneholder(native, "norscode-system-v1"))
    assert(t.inneholder(native, "resolve_executable"))
    assert(t.inneholder(native, "SearchPathA"))
    assert(t.inneholder(native, "access(candidate, X_OK)"))
    assert(t.inneholder(native, "!strcmp(name, \"system_operation\")"))
    assert(tel(native, "!strcmp(builtin, \"system_operation\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"system_operation\")") == 1)
    assert(tel(native, "!strcmp(cn,\"system_operation\")") == 1)

    # OS-logg og binær plist ligg bak smale, versjonerte plattform-ABI-ar.
    assert(t.inneholder(native, "norscode-system-log-v1"))
    assert(t.inneholder(native, "ReportEventA"))
    assert(t.inneholder(native, "syslog(facility | priority"))
    assert(tel(native, "!strcmp(builtin, \"system_log_operation\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"system_log_operation\")") == 1)
    assert(tel(native, "!strcmp(cn,\"system_log_operation\")") == 1)
    assert(t.inneholder(native, "norscode-property-list-v1"))
    assert(t.inneholder(native, "CFPropertyListCreateWithData"))
    assert(t.inneholder(native, "kCFPropertyListBinaryFormat_v1_0"))
    assert(tel(native, "!strcmp(builtin, \"property_list_operation\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"property_list_operation\")") == 1)
    assert(tel(native, "!strcmp(cn,\"property_list_operation\")") == 1)

    # OS-argument blir kopierte inn gjennom ein versjonert, lesebeskytta ABI
    # og er tilgjengelege i alle VM-dispatchbanar.
    assert(t.inneholder(native, "norscode-argv-v1"))
    assert(t.inneholder(native, "g_main_argc = argc"))
    assert(t.inneholder(native, "g_main_argv = argv"))
    assert(tel(native, "!strcmp(builtin, \"argv_operation\")") == 1)
    assert(tel(native, "!strcmp(builtin_name, \"argv_operation\")") == 1)
    assert(tel(native, "!strcmp(cn,\"argv_operation\")") == 1)

    skriv("test_platform_abi_source OK")
    returner 0
}
