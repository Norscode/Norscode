# Stream-image (NORSCODE_NCB_TEXT_V1) via bytes-vegen. hent_stream_bytes,
# stream_har_image og har_image_bytes brukte builtin.bytes_slice_to_text, ein
# C-æra-vertsbuiltin: «Ukjent innebygd funksjon» i VM-en og stille null i AOT,
# så hent_stream_bytes kunne aldri lukkast (R2). No bytes.utsnitt_til_tekst.
bruk selfhost.native_execution.embedded_ncb_image som image

funksjon desimal20(v: heiltall) -> tekst {
    la t = tekst_fra_heltall(v)
    mens lengde(t) < 20 { t = "0" + t }
    returner t
}

# base + payload + manifest + 20-sifra manifestlengd + stream-magic.
funksjon bygg_stream(base: liste_heiltall, namn: tekst, payload: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    image.kopier(ut, base)
    la start = lengde(ut)
    image.kopier(ut, image.tekst_til_bytes(payload))
    la manifest = "{\"payloads\":{\"" + namn + "\":{\"start\":" + tekst_fra_heltall(start) +
        ",\"length\":" + tekst_fra_heltall(lengde(payload)) + "}}}"
    image.kopier(ut, image.tekst_til_bytes(manifest))
    image.kopier(ut, image.tekst_til_bytes(desimal20(lengde(manifest))))
    image.kopier(ut, image.tekst_til_bytes(image.stream_magic()))
    returner ut
}

funksjon start() -> heiltall {
    la feil: heiltall = 0
    la base: liste_heiltall = [0x7F, 0x45, 0x4C, 0x46, 2, 1, 1, 0]
    la vm_ncb = "{\"format\":\"norscode-bytecode-v1\",\"entry\":\"vm.start\",\"functions\":{}}"
    la bin = bygg_stream(base, "vm", vm_ncb)

    hvis ikkje image.stream_har_image(bin) {
        skriv("FEIL stream_har_image(bytes) gav usann\n")
        feil = feil + 1
    }
    la via_bytes = ""
    prøv { via_bytes = image.hent_stream_bytes(bin, "vm") } fang (e) { via_bytes = "KAST:" + tekst(e) }
    hvis via_bytes != vm_ncb {
        skriv("FEIL hent_stream_bytes: " + tekst(via_bytes) + "\n")
        feil = feil + 1
    }
    # Kryssjekk mot den eldre tekstvegen (bytes_til_tekst) på same image.
    hvis image.hent_stream_tekst(bin, "vm") != vm_ncb {
        skriv("FEIL hent_stream_tekst gav anna payload\n")
        feil = feil + 1
    }
    la ukjent = ""
    prøv { ukjent = image.hent_stream_bytes(bin, "compiler") } fang (e) { ukjent = "KAST:" + tekst(e) }
    # Må kaste (meldinga varierer: C-æra-seedar gjev «Ugyldig heiltall» for manglande nøkkel).
    hvis ikkje builtin.starts_with(ukjent, "KAST:") {
        skriv("FEIL ukjent payload: " + ukjent + "\n")
        feil = feil + 1
    }

    # Skadd sluttmarkør skal avvisast.
    la skadd = bygg_stream(base, "vm", vm_ncb)
    skadd[lengde(skadd) - 1] = 0
    hvis image.stream_har_image(skadd) {
        skriv("FEIL skadd stream-magic vart godteken\n")
        feil = feil + 1
    }

    # har_image_bytes (bytes-vegen for record-image) på eit bygd image.
    la packed = image.bygg(base, ["vm"], [vm_ncb])
    hvis ikkje image.har_image_bytes(packed) {
        skriv("FEIL har_image_bytes gav usann\n")
        feil = feil + 1
    }
    packed[lengde(packed) - 1] = 0
    hvis image.har_image_bytes(packed) {
        skriv("FEIL har_image_bytes godtok skadd magic\n")
        feil = feil + 1
    }

    hvis feil > 0 {
        skriv("test_embedded_ncb_stream_image FEIL (" + tekst_fra_heltall(feil) + ")\n")
        returner 1
    }
    skriv("test_embedded_ncb_stream_image OK\n")
    returner 0
}
