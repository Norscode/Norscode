bruk std.zip som zip
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "tar-mode-")
    assert(temp["status"] == "created")
    la rot = "build/" + temp["relative"]
    la arkiv = rot + "/mode.tar"
    la ut = rot + "/ut"

    la ark = zip.ny_tar()
    assert(zip.tar_legg_til_bytes(ark, "AppRun", builtin.bytes_from_list([78, 67])) == 0)
    assert(zip.tar_sett_modus(ark, "AppRun", 493) == 0)
    assert(zip.tar_skriv(ark, arkiv))
    assert(zip.tar_pakk_ut(arkiv, ut))

    la stat = runtime_fs.native_stat_sti(ut + "/AppRun")
    assert(stat["status"] == "ok")
    assert((heltall_fra_tekst(stat["mode"]) & 511) == 493)

    assert(filops.slett_tre(rot))
    skriv("test_tar_mode_roundtrip OK")
    returner 0
}
