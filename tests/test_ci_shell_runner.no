bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la res = prosess.køyr(root + "/bin/nc",
        ["run", root + "/tools/ci_shell_runner.no"], root,
        {"NORSCODE_ROOT": root,
         "NORSCODE_VM_CI_RUN_FILE": root + "/tests/fixtures/ci_shell_direct_command.txt"}, 300000)
    assert(prosess.ok(res))
    assert_inneholder(tekst(res["stdout"]), "nc_main.no selftest")
    la child_env = prosess.køyr(root + "/bin/nc",
        ["run", root + "/tools/ci_shell_runner.no"], root,
        {"NORSCODE_ROOT": root,
         "NORSCODE_VM_CI_CHILD_EXECUTABLE": "./bin/nc",
         "NORSCODE_VM_CI_CHILD_CMD": "selftest"}, 300000)
    assert(prosess.ok(child_env))
    assert_inneholder(tekst(child_env["stdout"]), "nc_main.no selftest")
    la target_policy = prosess.køyr(root + "/bin/nc",
        ["run", root + "/tools/ci_shell_runner.no"], root,
        {"NORSCODE_ROOT": root,
         "NORSCODE_VM_CI_COMMAND": "./bin/nc run tests/fixtures/ci_env_write_probe.no",
         "NORSCODE_VM_CI_CHILD_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
         "NORSCODE_VM_CI_CHILD_DISK_ROOT": root + ",.,/tmp,/private/tmp",
         "NORSCODE_VM_TARGET_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
         "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write"}, 300000)
    assert(prosess.ok(target_policy))
    assert_inneholder(tekst(target_policy["stdout"]), "ci env.write target-policy OK")
    la system = tekst(builtin.system_info()["system"])
    la stage0_rel = "./bootstrap/stage0/norscode-linux-x86_64"
    la seed_platform = "linux-x86_64"
    hvis system == "Darwin" {
        stage0_rel = "./bootstrap/stage0/norscode-macos-arm64"
        seed_platform = "macos-arm64"
    }
    hvis system == "Windows" {
        stage0_rel = "./bootstrap/stage0/norscode-windows-x86_64.exe"
        seed_platform = "windows-x86_64"
    }
    la committed = prosess.køyr(root + builtin.slice(stage0_rel, 1, lengde(stage0_rel)), [], root,
        {"NORSCODE_ROOT": root,
         "NORSCODE_CMD": "run",
         "NORSCODE_FILE": root + "/tools/ci_shell_runner.no",
         "NORSCODE_VM_CI_COMMAND": stage0_rel + " verify-seed",
         "NORSCODE_SEED_PLATFORM": seed_platform,
         "NORSCODE_ENABLE_EXEC_PROSESS": "1",
         "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
         "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"}, 300000)
    assert(prosess.ok(committed))
    assert_inneholder(tekst(committed["stdout"]), "Seed-only verifikasjon: BESTÅTT")
    la src = builtin.fil_les("tools/ci_shell_runner.no")
    assert_inneholder(src, "builtin.process_spawn_argv(req)")
    assert(ikkje builtin.contains(src, "exec_prosess("))
    assert_inneholder(src, "forboden_shellsyntaks")
    assert_inneholder(src, "RUNNER_TEMP")
    assert_inneholder(src, "native_fs.native_list(temp, \"\")")
    assert_inneholder(src, "NORSCODE_VM_CI_CHILD_CMD")
    assert_inneholder(src, "NORSCODE_VM_CI_CHILD_FILE")
    assert_inneholder(src, "NORSCODE_VM_CI_CHILD_EXECUTABLE")
    assert_inneholder(src, "NORSCODE_VM_CI_COMMAND")
    assert_inneholder(src, "NORSCODE_VM_CI_CHILD_CAPABILITIES")
    assert_inneholder(src, "NORSCODE_VM_CI_CHILD_DISK_ROOT")
    assert_inneholder(src, "barn_miljø[\"NORSCODE_VM_TARGET_CAPABILITIES\"] = barn_caps")
    assert_inneholder(src, "barn_miljø[\"NORSCODE_VM_TARGET_DISK_ROOT\"] = barn_disk")
    assert_inneholder(src, "NORSCODE_VM_CI_DIRECT_OWNER")
    assert_inneholder(src, "arm64_tls_bygg.start()")
    assert_inneholder(src, "shellsyntaks i bunden kommando")
    assert_inneholder(src, "funksjon er_norscode_executable(sti: tekst) -> boolsk")
    assert_inneholder(src, "funksjon cli_verktøysti(cmd: tekst) -> tekst")
    assert_inneholder(src, "tools/verify_seed_only.no")
    assert_inneholder(src, "tools/ci_check_source.no")
    assert_inneholder(src, "funksjon barnemiljø() -> ordbok_tekst")
    assert_inneholder(src, "NORSCODE_TEMP_FORCE_FALLBACK")
    assert_inneholder(src, "NORSCODE_USE_PRECOMPILED_STDLIB")
    assert_inneholder(src, "NORSCODE_RUN_CACHE")
    assert_inneholder(src, "kopier_miljø(miljø, namn[i])")
    assert_inneholder(src, "barn_miljø[\"NORSCODE_CMD\"] = barn_cmd")
    assert_inneholder(src, "barn_miljø[\"NORSCODE_CI_CHECK_FILE\"] = argument[1]")
    assert_inneholder(src, "req = prosess.sett_environment(req, barn_miljø)")
    assert_inneholder(src, "sett_sandbox(req, \"none\", 4294967296, 1024, sann)")
    assert_inneholder(src, "[CI-BARN] status=")
    skriv("test_ci_shell_runner OK")
    returner 0
}
