# Test for std.prioritetsko (binær heap med komparator, FIFO ved lik prioritet).
# Eksplisitte samanlikningar (ikkje assert), så testen òg feilar i native AOT.
bruk std.prioritetsko som pk

funksjon _lj(l) -> tekst {
    la s = ""
    la i = 0
    mens i < lengde(l) {
        hvis i > 0 { s = s + "," }
        s = s + tekst(l[i])
        i = i + 1
    }
    returner s
}

funksjon _vis(v) -> tekst {
    hvis builtin.type(v) == "ingenting" { returner "<ingenting>" }
    returner tekst(v)
}

funksjon _sjekk(res: ordbok, namn: tekst, fått: tekst, venta: tekst) {
    hvis fått != venta {
        skriv("FEIL " + namn + ": fekk [" + fått + "] venta [" + venta + "]\n")
        res["feil"] = res["feil"] + 1
    }
    res["n"] = res["n"] + 1
}

funksjon _namn(postar) -> tekst {
    la s = ""
    la i = 0
    mens i < lengde(postar) {
        hvis i > 0 { s = s + "," }
        s = s + postar[i]["namn"]
        i = i + 1
    }
    returner s
}

funksjon _tom(res: ordbok) {
    la q = pk.ny()
    _sjekk(res, "tom er_tom", tekst(pk.er_tom(q)) + "|" + tekst(pk.storleik(q)), "sann|0")
    _sjekk(res, "tom topp", _vis(pk.topp(q)), "<ingenting>")
    _sjekk(res, "tom pop", _vis(pk.pop(q)), "<ingenting>")
    la fanga = "nei"
    prøv {
        pk.pop_eller_kast(q)
    } fang (e) {
        fanga = tekst(e)
    }
    _sjekk(res, "tom pop_eller_kast", fanga, "TomtFeil: prioritetskøa er tom")
    _sjekk(res, "tom til_sortert_liste", _lj(pk.til_sortert_liste(q)), "")
}

funksjon _naturleg(res: ordbok) {
    la q = pk.ny()
    for x i [5, -3, 0, 12, 5, -3, 7, 0, 100, -50] {
        pk.dytt(q, x)
    }
    _sjekk(res, "storleik", tekst(pk.storleik(q)), "10")
    _sjekk(res, "topp", tekst(pk.topp(q)), "-50")
    _sjekk(res, "topp fjernar ikkje", tekst(pk.storleik(q)), "10")
    _sjekk(res, "til_sortert_liste", _lj(pk.til_sortert_liste(q)), "-50,-3,-3,0,0,5,5,7,12,100")
    _sjekk(res, "til_sortert_liste urørt", tekst(pk.storleik(q)), "10")
    _sjekk(res, "inneheld", tekst(pk.inneheld(q, 7)) + tekst(pk.inneheld(q, 8)), "sannusann")
    _sjekk(res, "fjern 5 (ein av to)", tekst(pk.fjern(q, 5)), "sann")
    _sjekk(res, "fjern 99", tekst(pk.fjern(q, 99)), "usann")
    _sjekk(res, "pop x3", tekst(pk.pop(q)) + "," + tekst(pk.pop(q)) + "," + tekst(pk.pop(q)), "-50,-3,-3")
    _sjekk(res, "tøm_til_liste", _lj(pk.tøm_til_liste(q)), "0,0,5,7,12,100")
    _sjekk(res, "tom etter tøm_til_liste", tekst(pk.er_tom(q)), "sann")

    la m = pk.ny_maks()
    pk.dytt(m, 3)
    pk.dytt(m, 9)
    pk.dytt(m, -1)
    pk.dytt(m, 9)
    _sjekk(res, "maks", _lj(pk.tøm_til_liste(m)), "9,9,3,-1")

    la t = pk.frå_liste(["pære", "eple", "ål", "banan", "øks", "ærfugl"])
    _sjekk(res, "tekst heapify", _lj(pk.tøm_til_liste(t)), "banan,eple,pære,ål,ærfugl,øks")
}

funksjon _komparator(res: ordbok) {
    # Postar etter prioritet; lik prioritet kjem ut i innsetjingsrekkjefølgje (FIFO).
    la q = pk.ny_med(fun(a, b) -> a["pri"] - b["pri"])
    pk.dytt(q, {"namn": "c1", "pri": 3})
    pk.dytt(q, {"namn": "a1", "pri": 1})
    pk.dytt(q, {"namn": "c2", "pri": 3})
    pk.dytt(q, {"namn": "b1", "pri": 2})
    pk.dytt(q, {"namn": "a2", "pri": 1})
    pk.dytt(q, {"namn": "c3", "pri": 3})
    pk.dytt(q, {"namn": "a3", "pri": 1})
    _sjekk(res, "topp post", pk.topp(q)["namn"], "a1")
    _sjekk(res, "komparator + FIFO", _namn(pk.tøm_til_liste(q)), "a1,a2,a3,b1,c1,c2,c3")

    # Heapify med komparator (lengste tekst først).
    la l = pk.frå_liste_med(["bb", "a", "dddd", "ccc"], fun(a, b) -> lengde(b) - lengde(a))
    _sjekk(res, "frå_liste_med", _lj(pk.tøm_til_liste(l)), "dddd,ccc,bb,a")
}

# Pseudotilfeldig blanding av dytt/pop mot ein sortert referanse.
funksjon _tilfeldig(res: ordbok) {
    la q = pk.ny()
    la ref = []
    la x = 777
    la i = 0
    la brot = ""
    mens i < 300 {
        x = (x * 1103515245 + 12345) % 2147483648
        la v = (x / 65536) % 41 - 20
        hvis (x / 4) % 3 == 0 {
            la p = pk.pop(q)
            # Referanse: minste element fjernast.
            hvis lengde(ref) == 0 {
                hvis builtin.type(p) != "ingenting" { brot = "pop på tom gav " + tekst(p) }
            } ellers {
                la mi = 0
                la j = 1
                mens j < lengde(ref) {
                    hvis ref[j] < ref[mi] { mi = j }
                    j = j + 1
                }
                hvis p != ref[mi] { brot = "pop gav " + _vis(p) + " venta " + tekst(ref[mi]) }
                la ny_ref = []
                j = 0
                mens j < lengde(ref) {
                    hvis j != mi { legg_til(ny_ref, ref[j]) }
                    j = j + 1
                }
                ref = ny_ref
            }
        } ellers {
            pk.dytt(q, v)
            legg_til(ref, v)
        }
        hvis pk.storleik(q) != lengde(ref) { brot = "storleik " + tekst(pk.storleik(q)) + " venta " + tekst(lengde(ref)) }
        i = i + 1
    }
    _sjekk(res, "tilfeldig", brot, "")
    la sortert = pk.tøm_til_liste(q)
    la ok = sann
    la k = 1
    mens k < lengde(sortert) {
        hvis sortert[k - 1] > sortert[k] { ok = usann }
        k = k + 1
    }
    _sjekk(res, "tilfeldig sortert rest", tekst(ok) + "|" + tekst(lengde(sortert)), "sann|" + tekst(lengde(ref)))
}

# sann viss xs (heap-rekkjefølgje frå til_liste) held min-heap-eigenskapen,
# eller maks-heap-eigenskapen når maks er sann.
funksjon _er_heap(xs, maks: bool) -> bool {
    la i = 1
    mens i < lengde(xs) {
        la p = (i - 1) / 2
        hvis maks {
            hvis xs[p] < xs[i] { returner usann }
        } ellers {
            hvis xs[p] > xs[i] { returner usann }
        }
        i = i + 1
    }
    returner sann
}

# Innsetjingssortering (referanse), stigande.
funksjon _sorter(xs) -> liste {
    la ut = []
    for x i xs {
        legg_til(ut, x)
        la j = lengde(ut) - 1
        mens j > 0 og ut[j - 1] > ut[j] {
            la t = ut[j]
            ut[j] = ut[j - 1]
            ut[j - 1] = t
            j = j - 1
        }
    }
    returner ut
}

funksjon _snu(xs) -> liste {
    la ut = []
    la i = lengde(xs) - 1
    mens i >= 0 {
        legg_til(ut, xs[i])
        i = i - 1
    }
    returner ut
}

funksjon _neste(tilstand: ordbok) -> heiltall {
    tilstand["x"] = (tilstand["x"] * 1103515245 + 12345) % 2147483648
    returner tilstand["x"] / 65536
}

# Heapify frå liste må byrje på siste indre node (n / 2 - 1). Byrjar ho éin for
# tidleg, blir noden rett over det siste bladet aldri sila ned.
funksjon _heapify(res: ordbok) {
    la q = pk.frå_liste([5, 9, 6, 1])
    _sjekk(res, "heapify siste indre node", _vis(pk.topp(q)) + "|" + tekst(_er_heap(pk.til_liste(q), usann)), "1|sann")
    _sjekk(res, "heapify siste indre node sortert", _lj(pk.til_sortert_liste(q)), "1,5,6,9")

    la tilstand = {"x": 4242}
    la brot = ""
    la n = 1
    mens n <= 16 {
        la xs = []
        la i = 0
        mens i < n {
            legg_til(xs, _neste(tilstand) % 41 - 20)
            i = i + 1
        }
        la venta = _sorter(xs)
        la mi = pk.frå_liste(xs)
        hvis ikkje _er_heap(pk.til_liste(mi), usann) { brot = brot + " min-heap n=" + tekst(n) }
        hvis pk.topp(mi) != venta[0] { brot = brot + " min-topp n=" + tekst(n) }
        hvis _lj(pk.tøm_til_liste(mi)) != _lj(venta) { brot = brot + " min-rekkjefølgje n=" + tekst(n) }
        la ma = pk.frå_liste_med(xs, fun(a, b) -> b - a)
        hvis ikkje _er_heap(pk.til_liste(ma), sann) { brot = brot + " maks-heap n=" + tekst(n) }
        hvis _lj(pk.tøm_til_liste(ma)) != _lj(_snu(venta)) { brot = brot + " maks-rekkjefølgje n=" + tekst(n) }
        n = n + 1
    }
    _sjekk(res, "heapify tilfeldige lister n=1..16", brot, "")
}

# fjern(q, x) flyttar det siste elementet inn på plassen til x. Er det mindre
# enn forelderen der, må det silast OPP, ikkje berre ned.
funksjon _fjern_vilkårleg(res: ordbok) {
    la q = pk.frå_liste([1, 10, 2, 11, 12, 3, 4])
    _sjekk(res, "fjern: gyldig heap urørt av heapify", _lj(pk.til_liste(q)), "1,10,2,11,12,3,4")
    _sjekk(res, "fjern 11", tekst(pk.fjern(q, 11)), "sann")
    _sjekk(res, "fjern 11 silar 4 opp", _lj(pk.til_liste(q)), "1,4,2,10,12,3")
    _sjekk(res, "fjern 11 rekkjefølgje", _lj(pk.tøm_til_liste(q)), "1,2,3,4,10,12")

    # Tilfeldig: dytt, fjern vilkårlege element og pop mot ein referanse, med
    # heap-sjekk etter kvar fjerning.
    la tilstand = {"x": 99}
    la q2 = pk.ny()
    la ref = []
    la brot = ""
    la runde = 0
    mens runde < 30 {
        la i = 0
        mens i < 8 {
            la v = _neste(tilstand) % 61 - 30
            pk.dytt(q2, v)
            legg_til(ref, v)
            i = i + 1
        }
        i = 0
        mens i < 3 {
            la j = _neste(tilstand) % lengde(ref)
            la v = ref[j]
            hvis ikkje pk.fjern(q2, v) { brot = brot + " fjern(" + tekst(v) + ")=usann" }
            ref[j] = ref[lengde(ref) - 1]
            fjern_siste(ref)
            hvis ikkje _er_heap(pk.til_liste(q2), usann) { brot = brot + " heap brote etter fjern(" + tekst(v) + ") i runde " + tekst(runde) }
            i = i + 1
        }
        i = 0
        mens i < 2 {
            la mi = 0
            la j = 1
            mens j < lengde(ref) {
                hvis ref[j] < ref[mi] { mi = j }
                j = j + 1
            }
            la p = pk.pop(q2)
            hvis p != ref[mi] { brot = brot + " pop gav " + _vis(p) + " venta " + tekst(ref[mi]) }
            ref[mi] = ref[lengde(ref) - 1]
            fjern_siste(ref)
            i = i + 1
        }
        hvis pk.storleik(q2) != lengde(ref) { brot = brot + " storleik i runde " + tekst(runde) }
        runde = runde + 1
    }
    _sjekk(res, "fjern tilfeldig mot referanse", brot, "")
    _sjekk(res, "fjern tilfeldig rest", _lj(pk.tøm_til_liste(q2)), _lj(_sorter(ref)))
}

funksjon start() -> heiltall {
    la res = {"feil": 0, "n": 0}
    _tom(res)
    _naturleg(res)
    _komparator(res)
    _tilfeldig(res)
    _heapify(res)
    _fjern_vilkårleg(res)
    hvis res["feil"] != 0 {
        skriv("test_prioritetsko FEIL: " + tekst(res["feil"]) + " av " + tekst(res["n"]) + " sjekkar\n")
        returner 1
    }
    skriv("test_prioritetsko OK (" + tekst(res["n"]) + " sjekkar)\n")
    returner 0
}
