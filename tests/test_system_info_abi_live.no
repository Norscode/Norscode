bruk std.platform som platform
bruk std.prosess som prosess

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_SYSTEM_INFO_ABI_LIVE") != "1" {
        skriv("test_system_info_abi_live: krev eksplisitt kandidatattestasjon\n")
        returner 0
    }
    la info = builtin.system_info()
    assert(info["abi"] == "norscode-system-info-v1")
    assert(info["status"] == "ok")
    assert(info["system"] == "Darwin")
    assert(tekst(info["node"]) != "")
    assert(tekst(info["release"]) != "")
    assert(tekst(info["machine"]) == "arm64")
    assert(heltall_fra_tekst(tekst(info["cpu_count"])) > 0)
    assert(heltall_fra_tekst(tekst(info["total_memory_bytes"])) > 0)
    assert(tekst(info["executable"]) != "")

    assert(platform.system() == "Darwin")
    assert(platform.er_macos())
    assert(platform.tal_cpu() > 0)
    assert(platform.total_ram_mb() > 0)
    assert(platform.executable_path() != "")

    la resolved = builtin.system_operation({
        "abi": "norscode-system-v1",
        "operation": "resolve_executable",
        "name": "echo"
    })
    assert(resolved["status"] == "ok")
    assert(tekst(resolved["path"]) != "")
    assert(prosess.kommando_finnes("echo"))
    la echo = prosess.køyr("echo system-abi")
    assert(prosess.er_ok(echo))
    assert(builtin.trim(prosess.stdout(echo)) == "system-abi")

    la policy = prosess.ny_policy("environment-live")
    prosess.tillat_alle(policy)
    prosess.aktiver_køyring(policy)
    la env_plan = prosess.start_argv_plan("/usr/bin/env", [])
    prosess.med_miljø(env_plan, {"NORSCODE_ABI_TEST": "miljø-ok"})
    prosess.med_sandbox(env_plan, "none", 536870912, 64, usann)
    la env_result = prosess.start_argv_trygt(policy, env_plan)
    assert(prosess.er_ok(env_result))
    assert(builtin.index_of(prosess.stdout(env_result), "NORSCODE_ABI_TEST=miljø-ok") >= 0)
    skriv("test_system_info_abi_live OK")
    returner 0
}
