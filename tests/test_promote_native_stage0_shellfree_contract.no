bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/promote_native_stage0_v3001.no")
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "bruk tools.runtime_promotion_core som promotion"))
    assert(t.inneholder(src, "promotion.promoter(root, candidate_rel"))
    assert(t.inneholder(src, "promotion.gjenopprett(root"))
    assert(t.inneholder(src, "[DRY-RUN] ingen filer vart endra"))
    assert(t.inneholder(src, "\"PATH\": \"/nonexistent\""))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "sh -c"))
    assert(ikkje t.inneholder(src, "cp "))
    assert(ikkje t.inneholder(src, "chmod +x"))
    assert(ikkje t.inneholder(src, "mkdir -p"))
    skriv("test_promote_native_stage0_shellfree_contract OK\n")
    returner 0
}
