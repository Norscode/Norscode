# X.509-kjedevalidering med ekte RSA-signert kjede (sha256WithRSAEncryption).
# Root + leaf generert med openssl/cryptography (2048-bit RSA), validert i rein Norscode.
bruk std.x509_chain som chain
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon start() -> heiltall {
    la root = _b("")
    la leaf = _b("")
    la trust = ["ba01c6e1a4b65ab7d85b01aa44c6675eae5a4d7a6476736f9a83c12019f5b0f0"]

    # (1) Gyldig RSA-kjede -> godkjent.
    la r = chain.valider_kjede([leaf, root], trust, "norscode.example", "2026-06-01T12:00:00Z")
    assert_eq(r["gyldig"], sann)

    # (2) Feil vertsnamn -> avvist (før signaturkostnad).
    la r2 = chain.valider_kjede([leaf, root], trust, "angrep.example", "2026-06-01T12:00:00Z")
    assert_eq(r2["gyldig"], usann)

    # (3) Tukla leaf-signatur -> RSA-verifikasjon feilar (fail-closed).
    la t: liste_heiltall = []
    la i = 0
    mens i < lengde(leaf) { legg_til(t, leaf[i]) i = i + 1 }
    t[lengde(t) - 1] = t[lengde(t) - 1] ^ 1
    la r3 = chain.valider_kjede([t, root], trust, "norscode.example", "2026-06-01T12:00:00Z")
    assert_eq(r3["gyldig"], usann)

    assert_eq(chain.status()["sig"], "ed25519+rsa-sha256")
    skriv("test_x509_chain_rsa OK")
    returner 0
}
