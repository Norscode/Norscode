# W2 (WASM-sporet): paritetskorpuset for unnatak, endeleg/utsett, innebygde feil, uhandterte
# unnatak, closures, høgareordens funksjonar og strukturmetodar (kh.korpus_w2()). Same tre steg
# som tests/test_wasm_korpus_chrome.no (VM mot fasit, bygg med uhandtert-atomet, Chrome med
# identisk utskrift og utan «Uncaught», med negative og positive kontrollar). Delt ut frå
# test_wasm_korpus_chrome i W5, så kvar test held seg under tidsgrensa i standard-VM-en.
bruk tests.fixtures.wasm_korpus_hjelp som kh

funksjon start() -> heltall {
    la r = kh.køyr_korpus("test_wasm_korpus_w2", "build/wasm/test_korpus_w2", kh.korpus_w2(), kh.korpus_w2(), "48332", {})
    hvis r["chrome"] {
        skriv("test_wasm_korpus_w2 OK\n")
    }
    returner 0
}
