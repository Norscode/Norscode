# R3 / F31: `privat` på funksjonar, globalar/konstantar og strukturfelt er
# berre synleg i modulen sin. Bruk frå ein annan modul er ein
# kompileringsfeil: alias.f(), ukvalifisert f(), `fra M bruk f`, alias.f som
# verdi, alias.NAMN (les/skriv) og v.felt når v har ein kjend strukturtype
# frå den andre modulen (konstruktør, alias.T(...) eller importert funksjon
# med returtypen T). Innanfor modulen verkar alt som før. Køyrer gjennom
# KJELDE-kompilator og KJELDE-VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk selfhost.bundler som bundler

la M = "tests.fixtures.r3_privat"

funksjon køyr(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    la mncb = builtin.json_parse_raw(kompiler.kompiler_fil(fil_les("tests/fixtures/r3_privat.no"), M))
    la inits = []
    bundler.slå_saman_funksjonar(ncb["functions"], mncb["functions"])
    bundler.slå_saman_modulmetadata(inits, ncb["global_names"], mncb)
    bundler.slå_saman_modulmetadata(inits, ncb["global_names"], ncb)
    ncb["module_initializers"] = inits
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon feil(kjelde: tekst) -> tekst {
    prøv {
        kompiler.kompiler_fil(kjelde, "__main__")
    } fang (e) {
        returner tekst(e)
    }
    returner "KOMPILERTE"
}

funksjon prog(kropp: tekst) -> tekst {
    returner "bruk tests.fixtures.r3_privat som bank\nfunksjon start() -> tekst {\n" + kropp + "\n}\n"
}

funksjon start() -> heiltall {
    # Offentleg API verkar; modulen brukar sine eigne private namn fritt.
    assert_eq(køyr(prog("    la k = bank.ny_konto()\n    returner tekst(bank.offentleg()) + \"|\" + tekst(bank.saldo(k)) + \"|\" + k.eigar + \"|\" + bank.OPEN")), "1235|10|Ada|open")

    # Privat funksjon: kvalifisert, ukvalifisert, fra-import og som verdi.
    assert_eq(feil(prog("    returner tekst(bank.intern_hemmeleg())")), "Tilgangsfeil linje 3: funksjonen " + M + ".intern_hemmeleg er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil("bruk tests.fixtures.r3_privat\nfunksjon start() -> heiltall {\n    returner intern_hemmeleg()\n}\n"), "Tilgangsfeil linje 3: funksjonen " + M + ".intern_hemmeleg er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil("fra tests.fixtures.r3_privat bruk intern_hemmeleg\nfunksjon start() -> heiltall {\n    returner 0\n}\n"), "Tilgangsfeil linje 1: funksjonen " + M + ".intern_hemmeleg er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil(prog("    la f = bank.intern_hemmeleg\n    returner \"\"")), "Tilgangsfeil linje 3: funksjonen " + M + ".intern_hemmeleg er privat og kan ikkje brukast utanfor modulen sin")

    # Private globalar og konstantar: lesing og skriving.
    assert_eq(feil(prog("    returner tekst(bank.teljar)")), "Tilgangsfeil linje 3: globalen " + M + ".teljar er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil(prog("    bank.teljar = 99\n    returner \"\"")), "Tilgangsfeil linje 3: globalen " + M + ".teljar er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil(prog("    returner tekst(bank.HEMMELEG)")), "Tilgangsfeil linje 3: globalen " + M + ".HEMMELEG er privat og kan ikkje brukast utanfor modulen sin")

    # Privat felt på verdi med kjend strukturtype (returtype, konstruktør).
    assert_eq(feil(prog("    la k = bank.ny_konto()\n    returner tekst(k.saldo)")), "Tilgangsfeil linje 4: feltet " + M + ".Konto.saldo er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil(prog("    la k = bank.Konto()\n    k.saldo = 999999\n    returner \"\"")), "Tilgangsfeil linje 4: feltet " + M + ".Konto.saldo er privat og kan ikkje brukast utanfor modulen sin")
    assert_eq(feil(prog("    la k = bank.ny_konto()\n    k.saldo += 1\n    returner \"\"")), "Tilgangsfeil linje 4: feltet " + M + ".Konto.saldo er privat og kan ikkje brukast utanfor modulen sin")
    # Offentlege felt og omtilordna variablar er framleis lovlege.
    assert_eq(feil(prog("    la k = bank.ny_konto()\n    k.eigar = \"Per\"\n    k = {\"saldo\": 1}\n    returner tekst(k.saldo)")), "KOMPILERTE")

    # `privat` er framleis eit vanleg namn (parameter / variabel).
    assert_eq(køyr("funksjon f(privat: boolsk) -> tekst {\n    hvis privat { returner \"p\" }\n    returner \"o\"\n}\nfunksjon start() -> tekst {\n    la privat = sann\n    returner f(privat) + f(usann)\n}\n"), "po")
    returner 0
}
