// Dato/tid-funksjonar (date/time/datetime/strftime/unixepoch + modifikatorar).
// Golden = ekte sqlite3 3.51.0. Fikserte input → deterministisk.
bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne(":memory:")

    // Ekstraksjon frå ISO-datetime
    assert_eq(sql.query_text(db, "SELECT date('2026-08-22 14:30:15')"), "2026-08-22")
    assert_eq(sql.query_text(db, "SELECT time('2026-08-22 14:30:15')"), "14:30:15")
    assert_eq(sql.query_text(db, "SELECT datetime('2026-08-22 14:30:15')"), "2026-08-22 14:30:15")

    // Modifikatorar
    assert_eq(sql.query_text(db, "SELECT date('2026-08-22', '+1 day')"), "2026-08-23")
    assert_eq(sql.query_text(db, "SELECT date('2026-08-31', '+1 month')"), "2026-10-01")
    assert_eq(sql.query_text(db, "SELECT date('2026-01-15', 'start of month')"), "2026-01-01")
    assert_eq(sql.query_text(db, "SELECT date('2026-08-22', '-1 year')"), "2025-08-22")

    // Skotår
    assert_eq(sql.query_text(db, "SELECT date('2024-02-28', '+1 day')"), "2024-02-29")
    assert_eq(sql.query_text(db, "SELECT date('2023-02-28', '+1 day')"), "2023-03-01")

    // strftime-format
    assert_eq(sql.query_text(db, "SELECT strftime('%Y/%m/%d %H:%M', '2026-08-22 14:30:15')"), "2026/08/22 14:30")
    assert_eq(sql.query_text(db, "SELECT strftime('%j', '2026-08-22')"), "234")
    assert_eq(sql.query_text(db, "SELECT strftime('%w', '2026-08-22')"), "6")
    assert_eq(sql.query_text(db, "SELECT strftime('%s', '2026-08-22 00:00:00')"), "1787356800")

    // unixepoch-modifikator
    assert_eq(sql.query_text(db, "SELECT datetime(1000000000, 'unixepoch')"), "2001-09-09 01:46:40")

    skriv("test_norsdb_dato OK\n")
    returner 0
}
