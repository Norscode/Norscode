bruk tools.unified_bootstrap_verifier som unified
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "unified-bootstrap-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    assert(filops.lag_katalogar(base + "/build"))
    assert(filops.lag_katalogar(base + "/reports"))
    builtin.fil_skriv_binær(base + "/build/compiler_stage1", builtin.bytes_from_list([0, 255, 1]))
    builtin.fil_skriv_binær(base + "/build/compiler_stage2", builtin.bytes_from_list([0, 255, 1]))
    builtin.fil_skriv(base + "/reports/backend_a.txt", "A\nB\n")
    builtin.fil_skriv(base + "/reports/backend_b.txt", "A\nB\n")
    builtin.fil_skriv(base + "/reports/symbols_a.txt", "x\n")
    builtin.fil_skriv(base + "/reports/symbols_b.txt", "x\n")
    la report = base + "/reports/unified.txt"
    assert(unified.verifiser(base, report))
    la body = builtin.fil_les(report)
    assert(builtin.index_of(body, "Compiler equivalence: OK") >= 0)
    assert(builtin.index_of(body, "Bootstrap diff report: OK") >= 0)
    assert(builtin.index_of(body, "Backend ordering: OK") >= 0)
    assert(builtin.index_of(body, "Semantic diff: OK") >= 0)
    assert(builtin.index_of(body, "Bootstrap artifact collection: OK") >= 0)
    assert(filops.slett_tre(base))
    skriv("test_unified_bootstrap_native_live OK")
    returner 0
}
