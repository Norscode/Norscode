bruk selfhost.native_execution.native_codegen_v2 som codegen

funksjon start() -> heiltall {
    assert(codegen.er_strukturkonstruktør("builtin.ASTNode", 0))
    assert(codegen.er_strukturkonstruktør("builtin.AotResultat", 0))
    assert(ikkje codegen.er_strukturkonstruktør("builtin.astNode", 0))
    assert(ikkje codegen.er_strukturkonstruktør("builtin.ASTNode", 1))
    assert(ikkje codegen.er_strukturkonstruktør("selfhost.parser.ASTNode", 0))
    skriv("test_native_struct_constructor_codegen OK\n")
    returner 0
}
