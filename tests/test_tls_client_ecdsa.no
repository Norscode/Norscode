# TLS 1.3-KLIENT mot ein EKTE tenar (openssl s_server, ECDSA-sert). Verifiserer at
# native_gap-klienten fullfører handshake + verifiserer X.509 ECDSA CertificateVerify.
funksjon env(n: tekst) -> tekst { prøv { returner builtin.miljo_hent(n) } fang (e) { returner "" } }
funksjon start() -> heiltall {
    la host = env("NC_TLS_HOST") hvis host == "" { host = "127.0.0.1" }
    la port_s = env("NC_TLS_PORT") hvis port_s == "" { port_s = "14443" }
    la port = heltall_fra_tekst(port_s)
    la k = builtin.network_operation({"operation": "tls_connect", "host": host, "port": port, "hostname": "localhost"})
    skriv("connect: " + k["status"] + "\n")
    hvis k["status"] != "connected" { skriv("feil: " + k["error"] + "\n") returner 1 }
    la hs = {"status": "ventande"}
    la n = 0
    mens hs["status"] != "connected" og n < 600 {
        hs = builtin.network_operation({"operation": "tls_handshake", "handle": k["handle"]})
        hvis hs["status"] == "feil" { skriv("handshake-feil: " + hs["error"] + "\n") returner 1 }
        n = n + 1
    }
    skriv("handshake: " + hs["status"] + " (rundar " + tekst(n) + ")\n")
    hvis hs["status"] != "connected" { returner 1 }
    skriv("tls=" + hs["tls_version"] + " cipher=" + hs["cipher"] + " verified=" + tekst(hs["peer_verified"]) + " subject=" + hs["peer_subject"] + "\n")
    hvis hs["peer_verified"] != sann { skriv("IKKJE verifisert\n") returner 1 }
    # Send ein HTTP-liknande request + les svar (openssl s_server ekko / -www).
    builtin.network_operation({"operation": "write", "handle": k["handle"], "data": "GET / HTTP/1.0\r\n\r\n"})
    la rd = {"status": "ventande"}
    n = 0
    mens rd["status"] == "ventande" og n < 400 {
        rd = builtin.network_operation({"operation": "read", "handle": k["handle"], "max": "512"})
        n = n + 1
    }
    skriv("svar-status=" + rd["status"] + " lengd=" + tekst(rd["value"]) + "\n")
    skriv("TLS_CLIENT_ECDSA_OK\n")
    returner 0
}
