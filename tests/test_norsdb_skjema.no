// Fase 7k: ALTER TABLE (ADD/RENAME) + CREATE VIEW + CREATE TRIGGER. Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")

    // ALTER TABLE ADD COLUMN — gamle rader får tom (NULL) for ny kolonne
    sql.exec(db, "CREATE TABLE t (id INTEGER, n TEXT)")
    sql.exec(db, "INSERT INTO t (id, n) VALUES (1, 'a')")
    sql.exec(db, "ALTER TABLE t ADD COLUMN c INTEGER")
    sql.exec(db, "INSERT INTO t (id, n, c) VALUES (2, 'b', 9)")
    assert_eq(sql.query_rader(db, "SELECT id, n, c FROM t ORDER BY id"), "1|a|\n2|b|9")

    // ALTER TABLE RENAME TO + RENAME COLUMN
    sql.exec(db, "ALTER TABLE t RENAME TO t2")
    sql.exec(db, "ALTER TABLE t2 RENAME COLUMN n TO navn")
    assert_eq(sql.query_rader(db, "SELECT id, navn FROM t2 ORDER BY id"), "1|a\n2|b")

    // VIEW
    sql.exec(db, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (1, 'Ada', 37)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (2, 'Bo', 20)")
    sql.exec(db, "INSERT INTO folk (id, navn, alder) VALUES (3, 'Cy', 50)")
    sql.exec(db, "CREATE VIEW voksne AS SELECT navn FROM folk WHERE alder >= 30")
    assert_eq(sql.query_rader(db, "SELECT navn FROM voksne ORDER BY navn"), "Ada\nCy")
    // VIEW med ekstra WHERE i spørjinga
    assert_eq(sql.query_int(db, "SELECT count(*) FROM voksne"), 2)

    // TRIGGER: AFTER INSERT loggfører NEW-verdi
    sql.exec(db, "CREATE TABLE hend (id INTEGER, kilde TEXT)")
    sql.exec(db, "CREATE TABLE logg (tekst TEXT)")
    sql.exec(db, "CREATE TRIGGER trg AFTER INSERT ON hend BEGIN INSERT INTO logg (tekst) VALUES ('ny:' || NEW.kilde); END")
    sql.exec(db, "INSERT INTO hend (id, kilde) VALUES (1, 'web')")
    sql.exec(db, "INSERT INTO hend (id, kilde) VALUES (2, 'api')")
    assert_eq(sql.query_rader(db, "SELECT tekst FROM logg"), "ny:web\nny:api")

    // TRIGGER: AFTER DELETE bruker OLD
    sql.exec(db, "CREATE TRIGGER trg_del AFTER DELETE ON hend BEGIN INSERT INTO logg (tekst) VALUES ('slett:' || OLD.kilde); END")
    sql.exec(db, "DELETE FROM hend WHERE id = 1")
    assert_eq(sql.query_int(db, "SELECT count(*) FROM logg WHERE tekst = 'slett:web'"), 1)

    returner 0
}
