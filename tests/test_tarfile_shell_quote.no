bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/tarfile.no")
    la zip = fil_les("std/zip.no")
    assert(t.inneholder(src, "bruk std.zip som tar"))
    assert(t.inneholder(src, "tar.tar_les_pure(sti)"))
    assert(t.inneholder(src, "tar.tar_pakk_ut"))
    assert(t.inneholder(src, "funksjon _trygt_namn"))
    assert(t.inneholder(zip, "funksjon _tar_checksum_ok"))
    assert(ikkje t.inneholder(src, "builtin.exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "tar -tf"))
    assert(ikkje t.inneholder(src, "rm -rf"))
    skriv("test_tarfile_shell_quote OK")
    returner 0
}
