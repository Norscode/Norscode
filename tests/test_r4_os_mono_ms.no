// rA-os punkt 7: mono_ms() (std.native_gap) på VM (nc run/test). Utan sys6 (VM) og på mål utan
// clock_gettime-syscall (macOS) fell han tilbake på tid_ms(); på AOT-Linux er det
// clock_gettime(CLOCK_MONOTONIC). AOT-dekning: tests/test_x86_ra_os.no (aot_x86_klokke).
bruk std.native_gap som g

funksjon start() -> heiltall {
    la a = g.mono_ms()
    assert_eq(builtin.type(a), "heltall")
    assert(a > 0)
    la b = g.mono_ms()
    assert(b >= a)
    vent.sov(30)
    la c = g.mono_ms()
    assert(c - b >= 20)
    assert(c - b < 5000)
    skriv("test_r4_os_mono_ms OK\n")
    returner 0
}
