// Fase 4: fil-livssyklus + crash-recovery. Beviser at rader overlever "krasj":
// gjenoppretting frå WAL (ingen checkpoint) og frå checkpoint (WAL tømt), og at
// nye writes etter checkpoint går til ny WAL og også overlever.

bruk std.norsdb_motor som motor

funksjon start() -> heltall {
    la sti = "/tmp/norsdb_db_recovery_test"
    // Reint utgangspunkt
    motor.logg_tøm(sti + ".wal")
    hvis builtin.fil_finnes(sti + ".cp") { builtin.fil_slett(sti + ".cp") }

    // ── Åpne, opprett, sett inn — alt går til WAL. Så "krasj" (gløym db). ──
    la db = motor.db_åpne(sti)
    motor.db_opprett_tabell(db, "folk", [{"navn": "navn", "tag": motor.tag_tekst()}])
    motor.db_sett_inn(db, "folk", ["Ada"])
    motor.db_sett_inn(db, "folk", ["Linus"])

    // ── Gjenåpne → recovery frå WAL (ingen checkpoint enno) ──────────
    la db2 = motor.db_åpne(sti)
    assert_eq(motor.db_tel(db2, "folk"), 2)
    assert_eq(motor.db_hent(db2, "folk", 1)["navn"], "Ada")
    assert_eq(motor.db_hent(db2, "folk", 2)["navn"], "Linus")

    // ── Checkpoint → WAL skal tømmast ────────────────────────────────
    motor.db_checkpoint(db2)
    assert(builtin.fil_finnes(sti + ".wal") == usann)

    // ── Gjenåpne → recovery frå CHECKPOINT ───────────────────────────
    la db3 = motor.db_åpne(sti)
    assert_eq(motor.db_tel(db3, "folk"), 2)
    assert_eq(motor.db_hent(db3, "folk", 2)["navn"], "Linus")

    // ── Ny write etter checkpoint → ny WAL, overlever gjenåpning ──────
    la r = motor.db_sett_inn(db3, "folk", ["Bjørn"])
    assert_eq(r, 3)                              // next_rowid bevart gjennom checkpoint
    la db4 = motor.db_åpne(sti)
    assert_eq(motor.db_tel(db4, "folk"), 3)      // checkpoint(2) + WAL(1)
    assert_eq(motor.db_hent(db4, "folk", 3)["navn"], "Bjørn")

    // Rydd opp
    motor.logg_tøm(sti + ".wal")
    hvis builtin.fil_finnes(sti + ".cp") { builtin.fil_slett(sti + ".cp") }
    returner 0
}
