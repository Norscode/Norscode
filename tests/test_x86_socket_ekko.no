// Relay X5 (os-x86-io) punkt 1: socket_* på linux-x86_64 er ekte syscall (std.native_gap
// over builtin.sys6), ikkje null-fallback. Byggjer tests/fixtures/aot_x86_socket_ekko.no
// (TCP-ekko over loopback i éin ELF: socket/setsockopt/bind/listen/getsockname/connect/
// accept/poll/send/recv/close + feilkontrakt) og krev exit 42. Byggjeloggen skal ikkje
// melde «ukjent kall builtin.socket_».
// Berre på Linux x86-64-vert (elles hoppa over). Manuelt på macOS: byggje med
// `./bin/nc bygg-native --target linux-x86_64 …` og køyre i Docker linux/amd64.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    returner system == "Linux" og (maskin == "x86_64" eller maskin == "amd64")
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_linux_x86_64() {
        skriv("test_x86_socket_ekko: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la elf = "/tmp/norscode_x86_socket_ekko_" + builtin.random_hex(8)
    la bygg = køyr(runtime(root), ["bygg-native", "--target", "linux-x86_64",
                                   root + "/tests/fixtures/aot_x86_socket_ekko.no", elf], root, 900000)
    krev_exit(bygg, 0)
    assert(ikkje builtin.contains(tekst(bygg["stdout"]) + tekst(bygg["stderr"]), "ukjent kall builtin.socket_"))
    la r = køyr(elf, [], root, 60000)
    krev_exit(r, 42)
    assert(builtin.contains(tekst(r["stdout"]), "aot_x86_socket_ekko OK"))
    filops.slett_fil(elf)
    skriv("test_x86_socket_ekko OK\n")
    returner 0
}
