bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/linux_random_hex_rebuild_check_v733.no")

    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "funksjon vis_binærtreff(sti: tekst, needle: tekst, label: tekst) -> bool"))
    assert(t.inneholder(src, "builtin.bytes_to_text(builtin.fil_les_binær(sti))"))
    assert(t.inneholder(src, "prosess.køyr(root + \"/bin/nc\", argv, root, {}, 600000)"))
    assert(t.inneholder(src, "builtin.system_info()"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "strings "))
    assert(ikkje t.inneholder(src, "uname -"))
    assert(ikkje t.inneholder(src, "| grep -n 'random_hex'"))
    assert(ikkje t.inneholder(src, "| head -20"))

    skriv("test_linux_random_hex_rebuild_no_grep_head OK")
    returner 0
}
