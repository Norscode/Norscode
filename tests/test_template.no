# M10 — template-strengar f"hei {n}". Lexeren transformerer til
# ("" + "hei " + tekst(n) + ...). Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    # Enkel interpolasjon
    la p1 = "funksjon start() -> tekst {\n" +
        "    la n: heltall = 42\n" +
        "    returner f\"svar er {n}\"\n" +
        "}\n"
    assert_eq(utfor(p1), "svar er 42")

    # Fleire interpolasjonar + uttrykk
    la p2 = "funksjon start() -> tekst {\n" +
        "    la a: heltall = 3\n" +
        "    la b: heltall = 4\n" +
        "    returner f\"{a} + {b} = {a + b}\"\n" +
        "}\n"
    assert_eq(utfor(p2), "3 + 4 = 7")

    # Utan interpolasjon
    la p3 = "funksjon start() -> tekst { returner f\"berre tekst\" }\n"
    assert_eq(utfor(p3), "berre tekst")

    # Funksjonskall i interpolasjon
    la p4 = "funksjon dbl(x: heltall) -> heltall { returner x * 2 }\n" +
        "funksjon start() -> tekst {\n" +
        "    returner f\"dobbelt av 5 er {dbl(5)}\"\n" +
        "}\n"
    assert_eq(utfor(p4), "dobbelt av 5 er 10")

    skriv("test_template OK\n")
    returner 0
}
