# ECDSA P-256-signering mot RFC 6979 A.2.5 (P-256, SHA-256): offentleg nøkkel,
# deterministisk k, r og s for "sample" og "test", verifikasjon, avvising av
# tukla signatur og DER-koding. Tung (fleire skalarmultiplikasjonar): køyr native.
bruk std.ecdsa_p256 som ec
bruk std.bigint som bn
bruk std.tls13_keyschedule som ks

funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _hexbytes(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon _hex(b: liste_heiltall) -> tekst {
    la s = "0123456789abcdef" la ut = "" la i = 0
    mens i < lengde(b) { ut = ut + builtin.slice(s, b[i] / 16, b[i] / 16 + 1) + builtin.slice(s, b[i] % 16, b[i] % 16 + 1) i = i + 1 }
    returner ut
}
funksjon _bnhex(v: liste_heiltall) -> tekst { returner _hex(bn.til_bytes(v, 32)) }
funksjon _strbytes(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(s) { legg_til(ut, builtin.char_code(builtin.slice(s, i, i+1)) & 255) i = i + 1 }
    returner ut
}
funksjon sjekk(namn: tekst, fekk: tekst, venta: tekst, feil: liste_heiltall) -> heiltall {
    hvis fekk == venta { skriv("  OK   " + namn + "\n") returner 0 }
    skriv("  FEIL " + namn + "\n    fekk  " + fekk + "\n    venta " + venta + "\n")
    feil[0] = feil[0] + 1
    returner 1
}
funksjon ja(b: boolsk) -> tekst { hvis b { returner "sann" } returner "usann" }

funksjon start() -> heiltall {
    la feil: liste_heiltall = [0]
    la d = _hexbytes("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
    la q = ec.offentleg_nokkel(d)
    sjekk("Ux", _bnhex(q["x"]), "60fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6", feil)
    sjekk("Uy", _bnhex(q["y"]), "7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299", feil)

    la h1 = ks.transcript_hash(_strbytes("sample"))
    sjekk("k(sample)", _bnhex(ec.rfc6979_k(d, h1)), "a6e3c57dd01abe90086538398355dd4c3b17aa873382b0f24d6129493d8aad60", feil)
    la s1 = ec.ecdsa_sign(d, h1)
    sjekk("r(sample)", _bnhex(s1["r"]), "efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716", feil)
    sjekk("s(sample)", _bnhex(s1["s"]), "f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8", feil)
    sjekk("verify(sample)", ja(ec.ecdsa_verify(q["x"], q["y"], bn.fra_bytes(h1), s1["r"], s1["s"])), "sann", feil)

    la h2 = ks.transcript_hash(_strbytes("test"))
    la s2 = ec.ecdsa_sign(d, h2)
    sjekk("r(test)", _bnhex(s2["r"]), "f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367", feil)
    sjekk("s(test)", _bnhex(s2["s"]), "019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083", feil)

    # Signaturen for "sample" skal ikkje gjelde for "test".
    sjekk("avvis feil melding", ja(ec.ecdsa_verify(q["x"], q["y"], bn.fra_bytes(h2), s1["r"], s1["s"])), "usann", feil)

    # DER: s(test) byrjar med 0x01, så INTEGER s får ingen null-prefiks (32 byte);
    # r(sample) byrjar med 0xef, så INTEGER r får null-prefiks (33 byte).
    la der = ec.signatur_der(s1["r"], s1["s"])
    skriv("  DER(sample) = " + _hex(der) + "\n")
    sjekk("DER-hovud", _hex([der[0], der[2], der[3]]), "300221", feil)

    hvis feil[0] == 0 { skriv("test_ecdsa_p256_sign OK\n") returner 0 }
    skriv("test_ecdsa_p256_sign: " + tekst_fra_heiltall(feil[0]) + " feil\n")
    returner 1
}
