bruk std.argon2id som argon
bruk std.argon2id_pure som pure

funksjon start() -> heiltall {
    la faktisk = argon.hash("password", "somesalt", 8, 1, 1, 32)
    la direkte = pure.hash_pure("password", "somesalt", 8, 1, 1, 32)
    assert(faktisk == direkte)
    assert(argon.verifiser("password", "somesalt", 8, 1, 1, faktisk))
    assert(ikkje argon.verifiser("feil", "somesalt", 8, 1, 1, faktisk))
    assert(argon.status()["status"] == "pure-standard")
    assert(argon.status()["native"] == "explicit-optional-adapter")
    skriv("test_argon2id_standard OK")
    returner 0
}
