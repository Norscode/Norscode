// norscodeos-x86_64: safepoint utan GC-modus må ikkje utløyse kollektoren. Paritet-safepointet
// (flagg AV) kallar gc_collect_native når teljaren når terskelen OG bump−sist ≥ port; kollektoren
// skriv bitmap på GC_BITMAP_VA 0x40600000, som ligg utanfor det 64 MiB store heap-segmentet kjerna
// mappar → ring-3-#PF (OS-funn: HTTP-økt nr. 239, terskel 2^31). Rettinga: stubben er ein no-op på
// norscodeos-x86_64 utan GC-modus. Testen bygg tests/fixtures/nos_x86/safepoint_utan_gc.no med
// NC_SAFEPOINT_TERSKEL=1000 (bundle → codegen-ELF frå NC_NOS_CODEGEN, elles
// bootstrap/native_codegen_x86_64.elf, NC_TARGET=norscodeos-x86_64) og krev exit 42. Berre Linux
// x86-64-vert (elles hoppa over). Er ELF-en eldre enn rettinga, ignorerer han env-en (exit 42 utan
// kollektor-prøve); er han mellom env-støtta og rettinga, gjev testen SIGSEGV (139).

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = ""
    la maskin = ""
    prøv {
        la info = builtin.system_info()
        system = tekst(info["system"])
        maskin = tekst(info["machine"])
    } fang (e) {}
    returner system == "Linux" og (maskin == "x86_64" eller maskin == "amd64")
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la m: ordbok_tekst = {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    la nokkel = nøkler(miljø)
    la i: heiltall = 0
    mens i < lengde(nokkel) { m[nokkel[i]] = miljø[nokkel[i]]  i = i + 1 }
    returner prosess.køyr(executable, argv, root, m, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_linux_x86_64() {
        skriv("test_x86_safepoint_nos: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la cg = miljo_hent("NC_NOS_CODEGEN")
    hvis cg == "" { cg = root + "/bootstrap/native_codegen_x86_64.elf" }
    la merke = builtin.random_hex(8)
    la ncb = "/tmp/norscode_x86_safepoint_nos_" + merke + ".ncb.json"
    la elf = "/tmp/norscode_x86_safepoint_nos_" + merke + ".elf"
    krev_exit(køyr(runtime(root), ["bundle", "--output", ncb, root + "/tests/fixtures/nos_x86/safepoint_utan_gc.no"],
                   root, {}, 300000), 0)
    krev_exit(køyr(cg, [], root, {"NC_TARGET": "norscodeos-x86_64", "NC_INPUT": ncb, "NC_OUTPUT": elf,
                                  "NORSCODE_GC_ALLOC": "", "NC_SAFEPOINT_TERSKEL": "1000"}, 600000), 0)
    assert(builtin.fil_sett_kjorbar(elf))
    la r = køyr(elf, [], root, {}, 60000)
    krev_exit(r, 42)
    assert(builtin.contains(tekst(r["stdout"]), "safepoint_utan_gc OK"))
    filops.slett_fil(ncb)
    filops.slett_fil(elf)
    skriv("test_x86_safepoint_nos OK\n")
    returner 0
}
