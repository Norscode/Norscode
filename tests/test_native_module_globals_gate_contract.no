bruk std.tekst som t

// Kilde-kontrakt: modul-globals JSON-gate i native_codegen_v2.
//
// Regresjonsvern for fiksen der `bygg_runtime_v2` tidlegare kalla dei seks
// `patch_legacy_json_literal`-kalla ubetinga og kasta «venta 1 legacy
// JSON-literal, fann 0» for minimale program (modul-globals utan JSON-op).
// Fiksen gater kalla på `json_runtime_present`, som igjen kjem frå den
// ikkje-muterande hjelparen `har_legacy_json_literal`.
//
// Denne testen les kjelda (ikkje codegen-løypa), så han er rask og treng
// ikkje den bundla NCB-en. Han feilar dersom nokon fjernar gaten eller flyttar
// patch-kalla ut av `hvis json_runtime_present`-blokka.

funksjon _pos(src: tekst, del: tekst) -> heiltall {
    returner builtin.index_of(src, del)
}

funksjon start() -> heiltall {
    la src = fil_les("selfhost/native_execution/native_codegen_v2.no")

    // 1. Den ikkje-muterande gate-hjelparen finst og returnerer boolsk.
    assert(t.inneholder(src, "funksjon har_legacy_json_literal(bytes, peikar_låg: heiltall) -> boolsk"))

    // 2. json_runtime_present blir rekna ut frå hjelparen for alle seks pekarane.
    assert(t.inneholder(src, "la json_runtime_present = har_legacy_json_literal(bytes, 0x33)"))
    assert(t.inneholder(src, "har_legacy_json_literal(bytes, 0x35)"))
    assert(t.inneholder(src, "har_legacy_json_literal(bytes, 0x37)"))
    assert(t.inneholder(src, "har_legacy_json_literal(bytes, 0x39)"))
    assert(t.inneholder(src, "har_legacy_json_literal(bytes, 0x64)"))
    assert(t.inneholder(src, "har_legacy_json_literal(bytes, 0x66)"))

    // 3. Gate-blokka finst.
    assert(t.inneholder(src, "hvis json_runtime_present {"))

    // 4. Alle seks patch-kalla ligg INNANFOR gate-blokka:
    //    gate-open < kvart patch-kall < neste steg (patch_u64_verdi ...).
    la gate = _pos(src, "hvis json_runtime_present {")
    la etter = _pos(src, "patch_u64_verdi(bytes, 4199472")
    assert(gate >= 0)
    assert(etter > gate)

    la kall: liste<tekst> = [
        "patch_legacy_json_literal(bytes, 0x33, 0x5B, 1)",
        "patch_legacy_json_literal(bytes, 0x35, 0x5D, 1)",
        "patch_legacy_json_literal(bytes, 0x37, 0x7B, 1)",
        "patch_legacy_json_literal(bytes, 0x39, 0x7D, 1)",
        "patch_legacy_json_literal(bytes, 0x64, 0x2C, 2)",
        "patch_legacy_json_literal(bytes, 0x66, 0x3A, 1)"
    ]
    la i: heiltall = 0
    mens i < lengde(kall) {
        la p = _pos(src, kall[i])
        assert(p > gate)
        assert(p < etter)
        i = i + 1
    }

    skriv("test_native_module_globals_gate_contract: OK\n")
    returner 0
}
