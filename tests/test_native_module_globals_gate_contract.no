bruk std.tekst som t

// Kilde-kontrakt: runtime-inngangane i native_codegen_v2 etter Fase C.3.
//
// Tidlegare verna denne testen JSON-gaten rundt dei seks
// `patch_legacy_json_literal`-kalla i `bygg_runtime_v2` (modul-globals utan
// JSON-op kasta «venta 1 legacy JSON-literal, fann 0»). Fase C.3 fjerna heile
// den frosne C-æra-blobben (rt_hex_del0–6) og dermed legacy-literalane som
// gaten patcha. Kontrakten no: ingen legacy JSON-literal-patching att, og
// runtime-inngangane er ein fast entry-tabell med int3-slottar som feilar
// lukka dersom nokon står upatcha.
//
// Testen les kjelda (ikkje codegen-løypa), så han er rask og treng ikkje den
// bundla NCB-en.

funksjon start() -> heiltall {
    la src = fil_les("selfhost/native_execution/native_codegen_v2.no")

    // 1. Legacy JSON-literal-patchinga og den frosne blobben er borte.
    assert(ikkje t.inneholder(src, "patch_legacy_json_literal("))
    assert(ikkje t.inneholder(src, "har_legacy_json_literal("))
    assert(ikkje t.inneholder(src, "funksjon rt_hex_"))

    // 2. Faste 16 B-slottar @TEXT_VA, initialisert til int3.
    assert(t.inneholder(src, "funksjon RT_SLOT(idx: heiltall) -> heiltall { returner TEXT_VA() + idx * 16 }"))
    assert(t.inneholder(src, "funksjon bygg_runtime_v2(argv_store_va: heiltall) -> liste {"))
    la bygg = builtin.index_of(src, "funksjon bygg_runtime_v2(argv_store_va: heiltall) -> liste {")
    la int3 = builtin.index_of(src, "legg_til(bytes, 0xCC)")
    assert(int3 > bygg)

    // 3. Slottane blir fylte via sett_rt_inngang, og ein upatcha slot feilar lukka.
    assert(t.inneholder(src, "funksjon sett_rt_inngang(bytes, rt_va: heiltall, target: heiltall)"))
    assert(t.inneholder(src, ") er upatcha\""))

    skriv("test_native_module_globals_gate_contract: OK\n")
    returner 0
}
