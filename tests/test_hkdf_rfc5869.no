# HKDF (RFC 5869) over HMAC-SHA256 - offisielle testvektorar.
bruk std.hkdf som hkdf

funksjon _rep(v: heiltall, n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < n { legg_til(ut, v) i = i + 1 }
    returner ut
}
funksjon _seq(start: heiltall, n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < n { legg_til(ut, (start + i) & 255) i = i + 1 }
    returner ut
}
funksjon _hx(x: heiltall) -> tekst {
    la c = "0123456789abcdef"
    returner builtin.slice(c, (x >> 4) & 15, ((x >> 4) & 15) + 1) + builtin.slice(c, x & 15, (x & 15) + 1)
}
funksjon _hex(b: liste_heiltall) -> tekst {
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 }
    returner ut
}

funksjon start() -> heiltall {
    # Case 1 (SHA-256)
    la ikm1 = _rep(11, 22)
    la salt1 = _seq(0, 13)
    la info1 = _seq(240, 10)
    la prk1 = hkdf.extract(salt1, ikm1)
    assert_eq(_hex(prk1), "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    assert_eq(_hex(hkdf.expand(prk1, info1, 42)), "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")

    # Case 3 (SHA-256, tom salt og info)
    la ikm3 = _rep(11, 22)
    la prk3 = hkdf.extract([], ikm3)
    assert_eq(_hex(prk3), "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")
    assert_eq(_hex(hkdf.hkdf([], ikm3, [], 42)), "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8")

    assert_eq(hkdf.status()["abi"], "norscode-hkdf-v1")
    skriv("test_hkdf_rfc5869 OK")
    returner 0
}
