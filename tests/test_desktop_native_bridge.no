bruk std.desktop_native_bridge som bro
bruk std.desktop_render som grafikk
la b = bro.ny_bru("macos-arm64")
hvis bro.klar(b) { kast "native ikkje implementert" }
la s = grafikk.ny_scene(800, 600)
hvis ikkje grafikk.rektangel(s, 0, 0, 800, 600, "#102030") { kast "teikning" }
hvis ikkje grafikk.tekstlinje(s, 10, 10, 200, 30, "#ffffff", "Norscode") { kast "tekst" }
la p = bro.planlegg_batch(b, s, 0, 2)
hvis p["ok"] != "sann" eller p["count"] != "2" { kast "batch" }
hvis p["command.1.type"] != "text" eller p["command.1.text"] != "Norscode" { kast "payload" }
hvis p["native_executed"] != "usann" { kast "uriktig native paastand" }
hvis bro.planlegg_batch(b, s, -1, 1)["ok"] != "usann" { kast "negative" }
hvis bro.planlegg_batch(b, s, 0, 257)["ok"] != "usann" { kast "grense" }
hvis bro.planlegg_batch(b, s, 1, 2)["ok"] != "usann" { kast "overflyt" }
la u = bro.ny_bru("ukjent")
hvis bro.planlegg_batch(u, s, 0, 1)["ok"] != "usann" { kast "plattform" }
skriv("desktop native bridge OK")
