bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/no_c_python_active_surface.no")

    assert(t.inneholder(src, "funksjon collect_c_hits(root: tekst) -> liste_tekst"))
    assert(t.inneholder(src, "funksjon sortert_unik(verdiar: liste_tekst) -> liste_tekst"))
    assert(t.inneholder(src, "funksjon collect_ref_files(root: tekst) -> liste_tekst"))
    assert(t.inneholder(src, "funksjon ref_file_allowed(root: tekst, fil: tekst) -> bool"))
    assert(t.inneholder(src, "funksjon fil_ref_hits(fil: tekst) -> tekst"))
    assert(t.inneholder(src, "data = builtin.fil_les(fil)"))
    assert(t.inneholder(src, "funksjon linje_har_ref(line: tekst) -> bool"))
    assert(t.inneholder(src, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(src, "native_fs.native_list(sti, \"\")"))
    assert(t.inneholder(src, "funksjon walk_files_filtrert(startar: liste_tekst, skip_build: bool,"))
    assert(t.inneholder(src, "native_fs.native_walk_files_filtrert("))
    assert(t.inneholder(src, "funksjon collect_forbidden_shelltext(root: tekst) -> liste_tekst"))
    assert(t.inneholder(src, "funksjon kjeldekode_utan_tekst(data: tekst) -> tekst"))
    assert(t.inneholder(src, "funksjon har_legacy_kall_token(data: tekst, mønster: tekst) -> boolsk"))
    assert(t.inneholder(src, "legacy_tekstprosess_unntak(root, filer[i])"))
    assert(t.inneholder(src, "tokenmedviten null-port finn ingen legacy tekstprosess-kall"))
    assert(t.inneholder(src, "ingen backupkjelder i aktiv repositoryflate"))
    assert(t.inneholder(src, "collect_active_backup_hits"))
    assert(t.inneholder(src, "forboden shelltekst i aktiv kjerneflate"))
    assert(t.inneholder(src, "build_linux_x86_64_stage0_docker_v3601.no"))
    assert(t.inneholder(src, "builtin.contains(data, \"ncb_to_c\")"))
    assert(t.inneholder(src, "bruk std.liste som liste"))
    assert(t.inneholder(src, "liste.sorter_tekst(verdiar)"))
    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon shell("))
    assert(ikkje t.inneholder(src, "find \" + shell("))
    assert(ikkje t.inneholder(src, "while IFS= read -r rel"))
    assert(ikkje t.inneholder(src, "printf '%s/%s"))
    assert(ikkje t.inneholder(src, "printf '%s\\n'"))
    assert(ikkje t.inneholder(src, "| sort"))
    assert(ikkje t.inneholder(src, "sort -u"))
    assert(ikkje t.inneholder(src, "xargs rg"))
    assert(ikkje t.inneholder(src, "command -v rg"))
    assert(ikkje t.inneholder(src, "rg -n --with-filename"))
    assert(ikkje t.inneholder(src, "rg -n 'ncb_to_c'"))
    assert(ikkje t.inneholder(src, "rg -n 'tools/start(project|app)"))
    assert(t.inneholder(src, "funksjon shell_baseline_bad(root: tekst)"))
    assert(t.inneholder(src, "Feil: nye aktive .sh-filer er ikkje tillatne:"))
    assert(t.inneholder(src, "returner collect_active_shell(root)"))
    assert(t.inneholder(src, "reports/shell-surface-inventory.json"))
    assert(t.inneholder(src, "funksjon ci_shell_count(root: tekst) -> heiltall"))
    assert(t.inneholder(src, "funksjon ci_shell_baseline(root: tekst) -> heiltall"))
    assert(t.inneholder(src, "returner 0"))
    assert(t.inneholder(src, "shell-eksekverte run-blokker; fase-3-baseline er 0"))
    assert(t.inneholder(src, "funksjon ci_outer_command_env_bad(root: tekst) -> liste_tekst"))
    assert(t.inneholder(src, "NORSCODE_VM_CI_CHILD_CMD/FILE"))
    assert(t.inneholder(src, "CI kan kapre custom-shell stage0"))
    assert(t.inneholder(src, "NORSCODE_FILE: tools/ci_shell_runner.no"))
    assert(t.inneholder(src, "funksjon ci_child_binding_count(root: tekst, felt: tekst) -> heiltall"))
    assert(t.inneholder(src, "CI-barnekommandoar har eksplisitt executable"))
    assert(t.inneholder(src, "funksjon ci_run_block_count(root: tekst) -> heiltall"))
    assert(t.inneholder(src, "CI-run-blokker er deterministisk bundne"))

    skriv("test_active_surface_no_printf_lists OK")
    returner 0
}
