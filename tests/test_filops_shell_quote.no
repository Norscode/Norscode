bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("std/filops.no")

    assert(t.inneholder(src, "Norscode-eigde høgnivå filoperasjonar"))
    assert(t.inneholder(src, "bruk std.runtime_filesystem som native_fs"))
    assert(t.inneholder(src, "native_fs.native_list"))
    assert(t.inneholder(src, "native_fs.native_stat_sti"))
    assert(t.inneholder(src, "native_fs.native_sett_modus_sti"))
    assert(t.inneholder(src, "native_fs.native_slett_mappe"))
    assert(t.inneholder(src, "builtin.fil_les_binær"))
    assert(t.inneholder(src, "builtin.fil_skriv_binær"))
    assert(t.inneholder(src, "builtin.mkdir_p"))
    assert(t.inneholder(src, "builtin.random_hex"))
    assert(t.inneholder(src, "funksjon kopier_tre"))
    assert(t.inneholder(src, "funksjon slett_tre"))
    assert(t.inneholder(src, "funksjon walk"))
    assert(t.inneholder(src, "funksjon glob"))

    assert(ikkje t.inneholder(src, "exec_prosess"))
    assert(ikkje t.inneholder(src, "funksjon _shell("))
    assert(ikkje t.inneholder(src, "rm -rf"))
    assert(ikkje t.inneholder(src, "mkdir -p"))
    assert(ikkje t.inneholder(src, "find "))
    assert(ikkje t.inneholder(src, "realpath "))
    assert(ikkje t.inneholder(src, "mktemp "))
    assert(ikkje t.inneholder(src, "cp -"))
    assert(ikkje t.inneholder(src, "mv "))

    skriv("test_filops_native_surface OK")
    returner 0
}
