// A2: plattformtabellane i std/native_sys.no. Reine tabellsjekkar (ingen systemkall), so
// testen går på alle vertar og seedar:
//  * linux-arm64 har den generiske syscall-ABI-en (include/uapi/asm-generic/unistd.h) og
//    manglar dei gamle kalla (open/poll/dup2/fork/epoll_wait/…);
//  * _nr_kompat-erstatningane finst på målet;
//  * flagg- og layout-tabellane for arm64 er EIGNE (ikkje arva frå x86-64) og pinna
//    literalt her; nøkkelsetta er like på begge mål, og dei kjende arm64-avvika
//    (AUDIT_ARCH, FORK_A1, O_DIRECTORY/O_NOFOLLOW/O_DIRECT/O_LARGEFILE, upakka
//    epoll_event på 16 B) må skilje seg frå x86-verdien;
//  * kvart systemkall std/native_gap.no slår opp med _nr() finst på BEGGE Linux-måla
//    (unnateke dei som er gata med _har_nr), og kvart _nr_kompat()-namn kan løysast —
//    ein ny x86-berre-syscall i native_gap feilar her i staden for på arm64-runnaren;
//  * macos-arm64 (M1): Darwin-tabellane er pinna literalt; Linux-berre kall og flagg
//    (ppoll/epoll/futex/seccomp/rt_sig*/pipe2/clone) finst ikkje der, og native_gap når
//    dei berre bak _har_nr/_har_flagg-vakter — alt anna native_gap slår opp må finnast.
bruk std.native_sys som nsys

funksjon har(m, k: tekst) -> boolsk {
    returner finnes_nøkkel(m, k)
}

funksjon i_liste(l, v: tekst) -> boolsk {
    for e i l { hvis tekst(e) == v { returner sann } }
    returner usann
}

// Tabellen er nøyaktig `venta`: same nøklar, same verdiar.
funksjon lik_tabell(namn: tekst, faktisk, venta) -> heiltall {
    for n i nøkler(venta) {
        la nt = tekst(n)
        hvis ikkje finnes_nøkkel(faktisk, nt) { kast namn + ": manglar «" + nt + "»" }
        hvis faktisk[nt] != venta[nt] {
            kast namn + ": «" + nt + "» er " + tekst(faktisk[nt]) + ", venta " + tekst(venta[nt])
        }
    }
    for n i nøkler(faktisk) {
        hvis ikkje finnes_nøkkel(venta, tekst(n)) { kast namn + ": upinna nøkkel «" + tekst(n) + "» (pin verdien i testen)" }
    }
    returner 0
}

// Kvar nøkkel i x86-tabellen finst i arm64-tabellen og omvendt.
funksjon lik_nokkelsett(namn: tekst, x86, arm) -> heiltall {
    for n i nøkler(x86) {
        hvis ikkje finnes_nøkkel(arm, tekst(n)) { kast namn + ": «" + tekst(n) + "» finst for linux-x86_64 men ikkje linux-arm64" }
    }
    for n i nøkler(arm) {
        hvis ikkje finnes_nøkkel(x86, tekst(n)) { kast namn + ": «" + tekst(n) + "» finst for linux-arm64 men ikkje linux-x86_64" }
    }
    returner 0
}

// Alle namn som står i `<prefiks>"namn")` i teksten.
funksjon namn_etter(t: tekst, prefiks: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la rest = t
    la i = builtin.index_of(rest, prefiks)
    mens i >= 0 {
        rest = builtin.slice(rest, i + lengde(prefiks), lengde(rest))
        la slutt = builtin.index_of(rest, "\"")
        hvis slutt > 0 { legg_til(ut, builtin.slice(rest, 0, slutt)) }
        i = builtin.index_of(rest, prefiks)
    }
    returner ut
}

funksjon start() -> heiltall {
    la a = nsys._linux_arm64_nr()
    la x = nsys._linux_x86_64_nr()

    // asm-generic/unistd.h (64-bit: __NR_ppoll = 73, ikkje ppoll_time64 = 414)
    assert_eq(a["read"], 63)
    assert_eq(a["write"], 64)
    assert_eq(a["openat"], 56)
    assert_eq(a["close"], 57)
    assert_eq(a["ppoll"], 73)
    assert_eq(a["mmap"], 222)
    assert_eq(a["munmap"], 215)
    assert_eq(a["mprotect"], 226)
    assert_eq(a["clone"], 220)
    assert_eq(a["execve"], 221)
    assert_eq(a["exit"], 93)
    assert_eq(a["exit_group"], 94)
    assert_eq(a["wait4"], 260)
    assert_eq(a["pipe2"], 59)
    assert_eq(a["dup3"], 24)
    assert_eq(a["epoll_create1"], 20)
    assert_eq(a["epoll_ctl"], 21)
    assert_eq(a["epoll_pwait"], 22)
    assert_eq(a["socket"], 198)
    assert_eq(a["bind"], 200)
    assert_eq(a["listen"], 201)
    assert_eq(a["accept"], 202)
    assert_eq(a["connect"], 203)
    assert_eq(a["getsockname"], 204)
    assert_eq(a["sendto"], 206)
    assert_eq(a["recvfrom"], 207)
    assert_eq(a["setsockopt"], 208)
    assert_eq(a["shutdown"], 210)
    assert_eq(a["kill"], 129)
    assert_eq(a["fcntl"], 25)
    assert_eq(a["getpid"], 172)
    assert_eq(a["gettid"], 178)
    assert_eq(a["futex"], 98)
    assert_eq(a["prctl"], 167)
    assert_eq(a["seccomp"], 277)
    assert_eq(a["getrandom"], 278)
    assert_eq(a["rt_sigprocmask"], 135)
    assert_eq(a["rt_sigtimedwait"], 137)
    assert_eq(a["chdir"], 49)
    assert_eq(a["nanosleep"], 101)

    // Gamle kall som berre finst bak __ARCH_WANT_* (ikkje på arm64).
    for n i ["open", "poll", "dup2", "fork", "epoll_wait", "creat", "link", "unlink",
             "symlink", "chmod", "mkdir", "rmdir", "rename", "mknod", "pipe"] {
        hvis har(a, n) { kast "linux-arm64 skal ikkje ha systemkallet " + n }
    }
    // … men x86-64 har dei native_gap brukar.
    for n i ["open", "poll", "dup2", "fork", "epoll_wait"] { assert(har(x, n)) }
    assert_eq(x["getrandom"], 318)              // arch/x86/entry/syscalls/syscall_64.tbl
    assert_eq(x["seccomp"], 317)
    assert_eq(x["prctl"], 157)

    // Kompat: fork → clone(SIGCHLD,…), dup2 → dup3(…,0), epoll_wait → epoll_pwait(…,NULL,0).
    la k = nsys._kompat_linux_arm64()
    assert_eq(k["fork"], "clone")
    assert_eq(k["dup2"], "dup3")
    assert_eq(k["epoll_wait"], "epoll_pwait")
    for n i nøkler(k) { assert(har(a, tekst(k[n]))) }

    // Flagg: arm64-tabellen er EIGEN (ikkje arva frå x86-64), og kvar verdi er pinna
    // literalt her, uavhengig av x86-tabellen, so ein feil delt verdi eller ein x86-nøkkel
    // som lek over, gjev NEI. Kjelder: sjå std/native_sys.no.
    la fa = nsys._linux_arm64_flagg()
    la fx = nsys._linux_x86_64_flagg()
    la venta_fa = {
        "O_WRONLY": 1, "O_RDWR": 2, "O_CREAT": 64, "O_TRUNC": 512, "O_NONBLOCK": 2048,
        "O_CLOEXEC": 524288, "F_GETFL": 3, "F_SETFL": 4,
        "O_DIRECTORY": 16384, "O_NOFOLLOW": 32768, "O_DIRECT": 65536, "O_LARGEFILE": 131072,
        "AT_FDCWD": 0 - 100,
        "AT_REMOVEDIR": 512, "AT_SYMLINK_NOFOLLOW": 256, "DT_DIR": 4, "DT_REG": 8, "DT_LNK": 10,
        "PROT_READ": 1, "PROT_WRITE": 2, "PROT_EXEC": 4, "MAP_PRIVATE": 2, "MAP_ANONYMOUS": 32,
        "WNOHANG": 1, "SIGKILL": 9, "SIGUSR1": 10, "SIGPIPE": 13, "SIGTERM": 15, "SIGCHLD": 17,
        "SIG_BLOCK": 0, "SIG_UNBLOCK": 1, "SIG_SETMASK": 2, "CLONE_TRAAD": 69376, "FORK_A1": 17,
        "AF_UNIX": 1, "AF_INET": 2, "SOCK_STREAM": 1, "SOCK_DGRAM": 2, "SOL_SOCKET": 1,
        "SO_REUSEADDR": 2, "SO_RCVTIMEO": 20, "SO_SNDTIMEO": 21, "MSG_NOSIGNAL": 16384,
        "SHUT_RDWR": 2,
        "EPOLL_CLOEXEC": 524288, "EPOLL_CTL_ADD": 1, "EPOLL_CTL_DEL": 2, "EPOLL_CTL_MOD": 3,
        "EPOLLIN": 1, "EPOLLOUT": 4, "EPOLLERR": 8, "EPOLLHUP": 16,
        "POLLIN": 1, "POLLOUT": 4, "POLLERR": 8, "POLLHUP": 16, "POLLNVAL": 32,
        "FUTEX_WAIT": 0, "FUTEX_WAKE": 1,
        "PR_SET_NO_NEW_PRIVS": 38, "SECCOMP_SET_MODE_FILTER": 1, "AUDIT_ARCH": 3221225655,
        "SECCOMP_RET_KILL_PROCESS": 2147483648, "SECCOMP_RET_ERRNO": 327680,
        "SECCOMP_RET_ALLOW": 2147418112, "BPF_LD_W_ABS": 32, "BPF_JEQ_K": 21,
        "BPF_JSET_K": 69, "BPF_RET_K": 6
    }
    lik_tabell("linux-arm64-flagg", fa, venta_fa)
    // Same nøkkelsett på begge mål: ein ny x86-nøkkel utan arm64-verdi feilar her (og
    // _flagg() kastar på arm64) i staden for å arve x86-verdien.
    lik_nokkelsett("flagg", fx, fa)
    // Dei kjende arm64-avvika i fcntl (arch/arm64/include/uapi/asm/fcntl.h vs asm-generic):
    assert_eq(fx["AUDIT_ARCH"], 3221225534)     // 0xC000003E = AUDIT_ARCH_X86_64
    assert_eq(fx["FORK_A1"], 0)                 // fork(2) les ingen argument
    assert_eq(fx["O_DIRECT"], 16384)            // 040000 (asm-generic)
    assert_eq(fx["O_LARGEFILE"], 32768)         // 0100000
    assert_eq(fx["O_DIRECTORY"], 65536)         // 0200000
    assert_eq(fx["O_NOFOLLOW"], 131072)         // 0400000
    for n i ["O_DIRECTORY", "O_NOFOLLOW", "O_DIRECT", "O_LARGEFILE", "AUDIT_ARCH", "FORK_A1"] {
        hvis fa[n] == fx[n] { kast "linux-arm64-flagget " + n + " har x86-64-verdien (" + tekst(fx[n]) + ")" }
    }

    // Layout: òg eigen arm64-tabell, pinna literalt. epoll_event er pakka (12 B) berre på x86-64.
    la lay_arm = nsys._linux_arm64_layout()
    la lay_x86 = nsys._linux_x86_64_layout()
    la venta_lay = {
        "sockaddr_in.storleik": 16, "sockaddr_in.len": -1, "sockaddr_in.family": 0,
        "sockaddr_in.port": 2, "sockaddr_in.addr": 4,
        "epoll_event.storleik": 16, "epoll_event.events": 0, "epoll_event.data": 8,
        "pollfd.storleik": 8, "pollfd.fd": 0, "pollfd.events": 4, "pollfd.revents": 6,
        "timespec.storleik": 16, "timespec.sec": 0, "timespec.nsec": 8,
        "timeval.storleik": 16, "timeval.sec": 0, "timeval.usec": 8,
        "rusage.storleik": 144, "rusage.maxrss": 32, "rusage.maxrss_skala": 1024,
        "seccomp_data.nr": 0, "seccomp_data.arch": 4, "seccomp_data.args": 16,
        "sock_fprog.storleik": 16, "sock_fprog.len": 0, "sock_fprog.filter": 8,
        "sigset.storleik": 8, "wstatus.storleik": 8,
        "stat.storleik": 128, "stat.dev": 0, "stat.dev_breidd": 8, "stat.ino": 8, "stat.nlink": 20,
        "stat.nlink_breidd": 4, "stat.mode": 16, "stat.mode_breidd": 4, "stat.uid": 24, "stat.gid": 28,
        "stat.size": 48, "stat.atime": 72,
        "stat.mtime": 88, "stat.ctime": 104,
        "dirent64.reclen": 16, "dirent64.type": 18, "dirent64.name": 19
    }
    lik_tabell("linux-arm64-layout", lay_arm, venta_lay)
    lik_nokkelsett("layout", lay_x86, lay_arm)
    assert_eq(lay_x86["epoll_event.storleik"], 12)
    assert_eq(lay_x86["epoll_event.data"], 4)
    // struct stat skil seg: x86-64 har nlink u64 @16 og mode @24 (arch/x86 stat.h).
    assert_eq(lay_x86["stat.storleik"], 144)
    assert_eq(lay_x86["stat.nlink"], 16)
    assert_eq(lay_x86["stat.nlink_breidd"], 8)
    assert_eq(lay_x86["stat.mode"], 24)
    assert_eq(lay_x86["stat.uid"], 28)
    assert_eq(lay_x86["stat.gid"], 32)
    assert_eq(x["getdents64"], 217)
    assert_eq(x["newfstatat"], 262)
    assert_eq(a["getdents64"], 61)
    assert_eq(a["newfstatat"], 79)


    // Statisk: syscall-namna native_gap brukar, finst på begge Linux-måla.
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la kjelde = builtin.fil_les(root + "/std/native_gap.no")
    // Berre bak ei _har_nr-vakt: "open" (seccomp-lista), og macOS-greinene "poll" (utan
    // ppoll) og "ulock_wait"/"ulock_wake" (utan futex) — sjå Darwin-sjekken under.
    la gata = ["open", "poll", "ulock_wait", "ulock_wake"]
    la nr_namn = namn_etter(kjelde, "nsys._nr(\"")
    assert(lengde(nr_namn) > 20)
    for n i nr_namn {
        la nt = tekst(n)
        la er_gata = usann
        for g i gata { hvis g == nt { er_gata = sann } }
        hvis ikkje er_gata {
            hvis ikkje har(x, nt) { kast "native_gap: _nr(\"" + nt + "\") manglar i linux-x86_64-tabellen" }
            hvis ikkje har(a, nt) { kast "native_gap: _nr(\"" + nt + "\") manglar i linux-arm64-tabellen (bruk _nr_kompat eller *at-varianten)" }
        }
    }
    la kompat_namn = namn_etter(kjelde, "nsys._nr_kompat(\"")
    assert(lengde(kompat_namn) >= 3)
    for n i kompat_namn {
        la nt = tekst(n)
        assert(har(x, nt))
        assert(har(a, nt) eller har(k, nt))
    }
    // Flagga native_gap slår opp, finst på Linux (nøkkelsetta er like over) — unnateke dei
    // macOS-berre flagga, som berre blir nådde bak ei vakt (_har_flagg, eller greinene utan
    // pipe2/futex).
    la berre_darwin_flagg = ["F_SETFD", "FD_CLOEXEC", "F_SETNOSIGPIPE", "SO_NOSIGPIPE",
                             "UL_COMPARE_AND_WAIT", "ULF_WAKE_ALL"]
    la flagg_namn = namn_etter(kjelde, "nsys._flagg(\"")
    assert(lengde(flagg_namn) > 20)
    for n i flagg_namn {
        la nt = tekst(n)
        hvis ikkje i_liste(berre_darwin_flagg, nt) og ikkje har(fx, nt) {
            kast "native_gap: _flagg(\"" + nt + "\") manglar i Linux-tabellane"
        }
    }

    // ── macos-arm64 (M1): xnu bsd/kern/syscalls.master og bsd/sys/*.h ──
    la m = nsys._macos_arm64_nr()
    assert_eq(m["exit"], 1)
    assert_eq(m["fork"], 2)
    assert_eq(m["read"], 3)
    assert_eq(m["write"], 4)
    assert_eq(m["close"], 6)
    assert_eq(m["wait4"], 7)
    assert_eq(m["chdir"], 12)
    assert_eq(m["getpid"], 20)
    assert_eq(m["accept"], 30)
    assert_eq(m["kill"], 37)
    assert_eq(m["pipe"], 42)
    assert_eq(m["execve"], 59)
    assert_eq(m["munmap"], 73)
    assert_eq(m["mprotect"], 74)
    assert_eq(m["dup2"], 90)
    assert_eq(m["fcntl"], 92)
    assert_eq(m["socket"], 97)
    assert_eq(m["connect"], 98)
    assert_eq(m["bind"], 104)
    assert_eq(m["setsockopt"], 105)
    assert_eq(m["listen"], 106)
    assert_eq(m["sendto"], 133)
    assert_eq(m["shutdown"], 134)
    assert_eq(m["mmap"], 197)
    assert_eq(m["poll"], 230)
    assert_eq(m["getdirentries64"], 344)
    assert_eq(m["thread_selfid"], 372)
    assert_eq(m["openat"], 463)
    assert_eq(m["renameat"], 465)
    assert_eq(m["fchmodat"], 467)
    assert_eq(m["fstatat64"], 470)
    assert_eq(m["unlinkat"], 472)
    assert_eq(m["symlinkat"], 474)
    assert_eq(m["ulock_wait"], 515)
    assert_eq(m["ulock_wake"], 516)
    // Linux-kall som ikkje finst på Darwin. native_gap når dei berre bak vaktene under.
    la berre_linux = ["ppoll", "epoll_create1", "epoll_ctl", "epoll_wait", "epoll_pwait", "futex",
                      "prctl", "seccomp", "rt_sigprocmask", "rt_sigtimedwait", "pipe2", "clone",
                      "dup3", "getdents64", "newfstatat", "gettid"]
    for n i berre_linux {
        hvis har(m, n) { kast "macos-arm64 skal ikkje ha systemkallet " + n }
    }
    for v i ["nsys._har_nr(\"ppoll\")", "nsys._har_nr(\"futex\")", "nsys._har_nr(\"seccomp\")",
             "nsys._har_nr(\"rt_sigprocmask\")", "nsys._har_nr(\"epoll_create1\")", "nsys._har_nr(\"pipe2\")"] {
        hvis builtin.index_of(kjelde, v) < 0 { kast "native_gap manglar vakta " + v }
    }
    la km = nsys._kompat_macos_arm64()
    assert_eq(km["getdents64"], "getdirentries64")
    assert_eq(km["newfstatat"], "fstatat64")
    assert_eq(km["gettid"], "thread_selfid")
    assert_eq(km["pipe2"], "pipe")
    for n i nøkler(km) { assert(har(m, tekst(km[n]))) }
    for n i nr_namn {
        la nt = tekst(n)
        hvis ikkje i_liste(berre_linux, nt) og ikkje har(m, nt) {
            kast "native_gap: _nr(\"" + nt + "\") manglar i macos-arm64-tabellen (vakt med _har_nr)"
        }
    }
    for n i kompat_namn {
        la nt = tekst(n)
        hvis ikkje i_liste(berre_linux, nt) og ikkje har(m, nt) og ikkje har(km, nt) {
            kast "native_gap: _nr_kompat(\"" + nt + "\") kan ikkje løysast på macos-arm64"
        }
    }
    la fm = nsys._macos_arm64_flagg()
    la venta_fm = {
        "O_WRONLY": 1, "O_RDWR": 2, "O_NONBLOCK": 4, "O_APPEND": 8, "O_CREAT": 512,
        "O_TRUNC": 1024, "O_EXCL": 2048, "O_NOFOLLOW": 256, "O_DIRECTORY": 1048576,
        "O_CLOEXEC": 16777216, "F_GETFD": 1, "F_SETFD": 2, "F_GETFL": 3, "F_SETFL": 4,
        "FD_CLOEXEC": 1, "F_GETPATH": 50, "F_SETNOSIGPIPE": 73,
        "AT_FDCWD": 0 - 2, "AT_SYMLINK_NOFOLLOW": 32, "AT_REMOVEDIR": 128,
        "DT_DIR": 4, "DT_REG": 8, "DT_LNK": 10,
        "PROT_READ": 1, "PROT_WRITE": 2, "PROT_EXEC": 4, "MAP_PRIVATE": 2, "MAP_ANONYMOUS": 4096,
        "MAP_JIT": 2048,
        "WNOHANG": 1, "SIGKILL": 9, "SIGUSR1": 30, "SIGPIPE": 13, "SIGTERM": 15, "SIGCHLD": 20,
        "SIG_BLOCK": 1, "SIG_UNBLOCK": 2, "SIG_SETMASK": 3, "FORK_A1": 0,
        "AF_UNIX": 1, "AF_INET": 2, "SOCK_STREAM": 1, "SOCK_DGRAM": 2, "SOL_SOCKET": 65535,
        "SO_REUSEADDR": 4, "SO_SNDTIMEO": 4101, "SO_RCVTIMEO": 4102, "SO_ERROR": 4103,
        "SO_NOSIGPIPE": 4130, "MSG_NOSIGNAL": 0, "SHUT_RDWR": 2,
        "POLLIN": 1, "POLLOUT": 4, "POLLERR": 8, "POLLHUP": 16, "POLLNVAL": 32,
        "UL_COMPARE_AND_WAIT": 1, "ULF_WAKE_ALL": 256
    }
    lik_tabell("macos-arm64-flagg", fm, venta_fm)
    // Linux-berre flagg (epoll, futex, seccomp/BPF, clone-trådar) blir berre nådde bak vaktene.
    la berre_linux_flagg = ["EPOLL_CLOEXEC", "EPOLL_CTL_ADD", "EPOLL_CTL_DEL", "EPOLL_CTL_MOD",
                            "EPOLLIN", "EPOLLOUT", "EPOLLERR", "EPOLLHUP", "FUTEX_WAIT", "FUTEX_WAKE",
                            "CLONE_TRAAD", "PR_SET_NO_NEW_PRIVS", "SECCOMP_SET_MODE_FILTER",
                            "AUDIT_ARCH", "SECCOMP_RET_KILL_PROCESS", "SECCOMP_RET_ERRNO",
                            "SECCOMP_RET_ALLOW", "BPF_LD_W_ABS", "BPF_JEQ_K", "BPF_JSET_K", "BPF_RET_K"]
    for n i flagg_namn {
        la nt = tekst(n)
        hvis ikkje i_liste(berre_linux_flagg, nt) og ikkje har(fm, nt) {
            kast "native_gap: _flagg(\"" + nt + "\") manglar i macos-arm64-tabellen"
        }
    }
    hvis builtin.index_of(kjelde, "nsys._har_flagg(\"CLONE_TRAAD\")") < 0 { kast "native_gap manglar vakta for CLONE_TRAAD" }
    la em = nsys._macos_errno()
    lik_nokkelsett("errno", nsys._linux_errno(), em)
    assert_eq(em["EAGAIN"], 35)
    assert_eq(em["ETIMEDOUT"], 60)
    assert_eq(em["EINVAL"], 22)
    la lm = nsys._macos_arm64_layout()
    la venta_lm = {
        "sockaddr_in.storleik": 16, "sockaddr_in.len": 0, "sockaddr_in.family": 1,
        "sockaddr_in.port": 2, "sockaddr_in.addr": 4,
        "pollfd.storleik": 8, "pollfd.fd": 0, "pollfd.events": 4, "pollfd.revents": 6,
        "timespec.storleik": 16, "timespec.sec": 0, "timespec.nsec": 8,
        "timeval.storleik": 16, "timeval.sec": 0, "timeval.usec": 8,
        "rusage.storleik": 144, "rusage.maxrss": 32, "rusage.maxrss_skala": 1,
        "sigset.storleik": 4, "wstatus.storleik": 8,
        "stat.storleik": 144, "stat.dev": 0, "stat.dev_breidd": 4, "stat.mode": 4,
        "stat.mode_breidd": 2, "stat.nlink": 6, "stat.nlink_breidd": 2, "stat.ino": 8,
        "stat.uid": 16, "stat.gid": 20, "stat.size": 96, "stat.atime": 32, "stat.mtime": 48,
        "stat.ctime": 64,
        "dirent64.reclen": 16, "dirent64.type": 20, "dirent64.name": 21
    }
    lik_tabell("macos-arm64-layout", lm, venta_lm)
    // Same strukturar som Linux, unnateke dei Linux-berre (epoll_event, seccomp_data, sock_fprog).
    for n i nøkler(lay_x86) {
        la nt = tekst(n)
        la linux_berre = builtin.starts_with(nt, "epoll_event.") eller builtin.starts_with(nt, "seccomp_data.") eller builtin.starts_with(nt, "sock_fprog.")
        hvis ikkje linux_berre og ikkje har(lm, nt) { kast "macos-arm64-layout manglar «" + nt + "»" }
    }

    // Dynamisk (berre når VM-en har builtin.native_target, dvs. gjeldande vm.no):
    // tabellen som blir vald, svarar til verten.
    la mål = ""
    prøv { mål = tekst(builtin.native_target()) } fang (e) { mål = "" }
    hvis mål == "linux-x86_64" {
        assert_eq(nsys._nr_kompat("fork"), 57)
        assert_eq(nsys._nr_kompat("dup2"), 33)
    }
    hvis mål == "linux-arm64" {
        assert_eq(nsys._nr_kompat("fork"), 220)
        assert_eq(nsys._nr_kompat("dup2"), 24)
        assert_eq(nsys._nr_kompat("epoll_wait"), 22)
    }
    hvis mål == "macos-arm64" {
        assert_eq(nsys._nr_kompat("fork"), 2)
        assert_eq(nsys._nr_kompat("dup2"), 90)
        assert_eq(nsys._nr_kompat("pipe2"), 42)
        assert_eq(nsys._nr_kompat("getdents64"), 344)
        assert(ikkje nsys._har_nr("futex"))
    }
    returner 0
}
