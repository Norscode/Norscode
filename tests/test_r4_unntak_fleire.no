# R4 / F32: multi-catch, fleire fang-klausular, unntakshierarki. Køyrer gjennom
# KJELDE-kompilator + VM (sjå docs/UNNTAK.md).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon start() -> heiltall {
    la p1 = "funksjon start() -> tekst {\n" +
        "    la s = \"\"\n" +
        "    prøv { kast \"AFeil: x\" } fang (e: AFeil eller BFeil) { s = s + \"1\" }\n" +
        "    prøv { kast \"BFeil: x\" } fang (e: AFeil eller BFeil) { s = s + \"2\" }\n" +
        "    returner s\n" +
        "}\n"
    assert_eq(utfor(p1), "12")
    returner 0
}
