# R4 / F32: multi-catch (fang (e: A eller B)), fleire fang-klausular på same
# prøv (første samsvar vinn, ingen samsvar → vidare), unntakshierarki
# (Unntak som rot, VerdiFeil/TypeFeil/IndeksFeil/… som undertypar) og
# grensesnitt som rot for brukarunntak. Køyrer gjennom KJELDE-kompilator + VM.
# Programmet ligg i tests/fixtures/r4_fleire.no; sjå docs/UNNTAK.md.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon køyr(kjelde: tekst) -> tekst {
    returner tekst(vm.køyr_ncb(builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))))
}

funksjon start() -> heiltall {
    la delar = builtin.split(køyr(fil_les("tests/fixtures/r4_fleire.no")), "|")
    assert_eq(lengde(delar), 17)
    # multi-catch: A og B fanga inne, C går til ytre fang
    assert_eq(delar[0], "inne:AFeil: a")
    assert_eq(delar[1], "inne:BFeil: b")
    assert_eq(delar[2], "ytre:CFeil: c")
    # første samsvar vinn; IndeksFeil-klausul; fang-alt tek resten (DivisjonMedNull)
    assert_eq(delar[3], "A")
    assert_eq(delar[4], "BC")
    assert_eq(delar[5], "BC")
    assert_eq(delar[6], "idx")
    assert_eq(delar[7], "resten")
    # ingen samsvar → unntaket går vidare, endeleg køyrer éin gong, så ytre fang
    assert_eq(delar[8], "vidare:CFeil: c[endeleg,ytre]")
    # hierarki: kvar innebygd type fanga av rett klausul, rota Unntak fangar resten
    assert_eq(delar[9], "TypeFeil,IndeksFeil,ArgumentFeil,MetodeFeil,DivisjonMedNull,ModuloMedNull,VerdiFeil,Unntak,")
    # VerdiFeil er forelder til DivisjonMedNull/ModuloMedNull/ValideringsFeil, ikkje TypeFeil
    assert_eq(delar[10], "VVV-")
    # grensesnitt som rot: berre strukturar som implementerer FeilRot
    assert_eq(delar[11], "rot:7:ValFeil,rot:9:NettFeil,andre,andre")
    assert_eq(delar[12], "VA:ValFeil,VA:Annan,rot")
    # er_instans mot Unntak, innebygde typar og grensesnitt; unntak_type
    assert_eq(delar[13], "UT/TypeFeil,UV/DivisjonMedNull,URF/ValFeil,UR/NettFeil,U/Annan,U/AFeil")
    # unntak i ei klausul blir ikkje fanga av ei søsterklausul
    assert_eq(delar[14], "ytre:NyFeil: frå-klausul")
    # bryt/fortsett frå klausular i ei løkke
    assert_eq(delar[15], "ab.c.ab")
    # same variabelnamn i fleire klausular
    assert_eq(delar[16], "AFeil: 1BFeil: 2")
    returner 0
}
