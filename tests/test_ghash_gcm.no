bruk std.aes som aes
bruk std.ghash som gh

// Kjent-svar-test: GHASH mot NIST GCM Test Case 2 (McGrew/Viega, SP 800-38D).
//
// GHASH verifiseres via GCM-tag-formelen: T = GHASH_H(C ‖ lenblock) XOR E_K(J0).
// H = E_K(0) og E_K(J0) beregnes med den FIPS-197-verifiserte std.aes, så
// GHASH-korrektheten (gf_mul + akkumulering + reduksjon) bindes til den kjente
// NIST-taggen. Test Case 2: K=0, IV=0^96, P=0^128.
//   H  = 66e94bd4ef8a2c3b884cfa59ca342b2e
//   C  = 0388dace60b6a392f328c2b971b2fe78
//   T  = ab6e47d42cec13bdf53a67b21257bddf
// (Fler-blokk/padding-stien re-verifiseres ende-til-ende i AES-GCM-laget.)

funksjon _bytes(hex: tekst) -> liste_heiltall {
    la s = "0123456789abcdef"
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(hex) {
        legg_til(ut, builtin.index_of(s, builtin.slice(hex, i, i + 1)) * 16
            + builtin.index_of(s, builtin.slice(hex, i + 1, i + 2)))
        i = i + 2
    }
    returner ut
}

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la s = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i < lengde(bytes) {
        la b = bytes[i] % 256
        ut = ut + builtin.slice(s, (b / 16) % 16, (b / 16) % 16 + 1) + builtin.slice(s, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon _xor(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la u: liste_heiltall = []
    la i = 0
    mens i < lengde(a) { legg_til(u, a[i] ^ b[i]) i = i + 1 }
    returner u
}

funksjon start() -> heiltall {
    la zero = _bytes("00000000000000000000000000000000")

    // H = E_K(0) — bekrefter oppsett + AES for null-nøkkel.
    la h = aes.aes128_encrypt_block(zero, zero)
    assert(_hex(h) == "66e94bd4ef8a2c3b884cfa59ca342b2e")

    // GHASH-input: C ‖ lenblock (AAD-bit=0, C-bit=128=0x80). To blokker.
    la input = _bytes("0388dace60b6a392f328c2b971b2fe78"
        + "00000000000000000000000000000080")
    la ej0 = aes.aes128_encrypt_block(zero, _bytes("00000000000000000000000000000001"))
    la tag = _xor(gh.ghash(h, input), ej0)
    assert(_hex(tag) == "ab6e47d42cec13bdf53a67b21257bddf")

    // gf_mul med null gir null (sanity).
    assert(_hex(gh.gf_mul(h, zero)) == "00000000000000000000000000000000")

    skriv("test_ghash_gcm: OK\n")
    returner 0
}
