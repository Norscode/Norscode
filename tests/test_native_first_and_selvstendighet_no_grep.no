bruk std.tekst som t

funksjon start() -> heiltall {
    la native_first = fil_les("tools/enforce_native_first.no")
    assert(builtin.contains(native_first, "funksjon fil_inneheld(sti: tekst, needle: tekst) -> bool"))
    assert(builtin.contains(native_first, "funksjon har_legacy_test_fallback(sti: tekst) -> bool"))
    assert(builtin.contains(native_first, "builtin.index_of(builtin.fil_les(sti), needle)"))
    assert(builtin.contains(native_first, "hvis ikkje fil_finst(root + \"/dist/norscode_native\")"))
    assert(ikkje builtin.contains(native_first, "hvis ikkje executable(root + \"/dist/norscode_native\")"))
    assert(ikkje builtin.contains(native_first, "test -x "))
    assert(builtin.contains(native_first, "ikkje fil_finst(root + \"/tools/nc_test.no\")"))
    assert(builtin.contains(native_first, "fil_finst(root + \"/tools/nc_test.sh\")"))
    assert(builtin.contains(native_first, "har_legacy_test_fallback(root + \"/archive/legacy_shell/tools/nc_test.sh\")"))
    assert(ikkje builtin.contains(native_first, "grep \" + shell(pattern)"))
    assert(ikkje builtin.contains(native_first, "python\\\\|minimal_vm"))
    assert(builtin.contains(native_first, "builtin.system_info()[\"cwd\"]"))
    assert(ikkje builtin.contains(native_first, "exec_prosess"))
    assert(ikkje builtin.contains(native_first, "kommando(\"pwd\")"))

    la selv = fil_les("tools/verify_selvstendighet.no")
    assert(builtin.contains(selv, "process_abi.request(native, [], root"))
    assert(builtin.contains(selv, "builtin.process_spawn_argv(req)"))
    assert(ikkje builtin.contains(selv, "exec_prosess"))
    assert(ikkje builtin.contains(selv, "sh -c"))
    assert(ikkje builtin.contains(selv, "| grep ."))

    skriv("test_native_first_and_selvstendighet_no_grep OK")
    returner 0
}
