funksjon start() -> heiltall {
    la src = fil_les("selfhost/nc_main.no")
    assert(builtin.contains(src, "funksjon nc_bundle_cli(argv: liste_tekst) -> heiltall"))
    assert(builtin.contains(src, "funksjon nc_bundle_fleire_direkte"))
    assert(builtin.contains(src, "hvis lengde(filer) == 1"))
    assert(builtin.contains(src, "returner nc_compile(filer[0], ut)"))
    assert(builtin.contains(src, "hvis lengde(filer) > 1"))
    assert(builtin.contains(src, "returner nc_bundle_fleire_direkte(filer, ut)"))
    assert(builtin.contains(src, "slå_saman_funksjonar(alle_fns, ncb[\"functions\"])"))
    skriv("test_native_cli_bundle_direct OK\n")
    returner 0
}
