bruk std.md5 som md5

funksjon start() -> heiltall {
    assert(md5.hash("") == "d41d8cd98f00b204e9800998ecf8427e")
    assert(md5.hash("a") == "0cc175b9c0f1b6a831c399e269772661")
    assert(md5.hash("abc") == "900150983cd24fb0d6963f7d28e17f72")
    assert(md5.hash("message digest") == "f96b697d7cb7938d525a2f31aaf161d0")
    assert(md5.hash("abcdefghijklmnopqrstuvwxyz") == "c3fcd3d76192e4007dfb496cca67e13b")
    skriv("test_md5_vectors OK")
    returner 0
}
