# M10 — spread i liste-literalar: [...a, b], [0, ...a, ...b]. Køyrer gjennom
# KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk std.tekst som t

funksjon utfor_tekst(kjelde: tekst) -> tekst {
    la ncb_json = kompiler.kompiler_fil(kjelde, "__main__")
    la ncb = builtin.json_parse_raw(ncb_json)
    la r = vm.køyr_ncb(ncb)
    returner tekst(r)
}

funksjon start() -> heiltall {
    # [...a, 3] → 1+2+3 = 6, lengde 3
    la p1 = "funksjon start() -> heltall {\n" +
        "    la a = [1, 2]\n" +
        "    la b = [...a, 3]\n" +
        "    returner b[0] * 100 + b[1] * 10 + b[2]\n" +
        "}\n"
    assert_eq(utfor_tekst(p1), "123")

    # [0, ...a, ...c] → lengde 5, sum riktig
    la p2 = "funksjon start() -> heltall {\n" +
        "    la a = [1, 2]\n" +
        "    la c = [3, 4]\n" +
        "    la b = [0, ...a, ...c]\n" +
        "    returner lengde(b) * 1000 + b[0] * 100 + b[2] * 10 + b[4]\n" +
        "}\n"
    # lengde 5, b[0]=0, b[2]=2, b[4]=4 → 5000 + 0 + 20 + 4 = 5024
    assert_eq(utfor_tekst(p2), "5024")

    # [...a] åleine → kopi
    la p3 = "funksjon start() -> heltall {\n" +
        "    la a = [7, 8, 9]\n" +
        "    la b = [...a]\n" +
        "    returner lengde(b) * 10 + b[2]\n" +
        "}\n"
    assert_eq(utfor_tekst(p3), "39")

    # vanleg liste utan spread er uendra
    la p4 = "funksjon start() -> heltall {\n" +
        "    la b = [5, 6, 7]\n" +
        "    returner lengde(b) * 10 + b[0]\n" +
        "}\n"
    assert_eq(utfor_tekst(p4), "35")

    skriv("test_spread OK\n")
    returner 0
}
