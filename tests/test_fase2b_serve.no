# Fase 2 bølgje (b): serve-integrasjonstest (2.3/2.4/2.6/2.8).
#
# RESEED-GATED: importerer selfhost.nc_main, bundlar fikstur-appen med
# nc_reload_bundle, set opp runtime (nc_serve_init_runtime) og køyrer
# serve_handle_one direkte (same veg som nc_serve, utan socket). Lokalt treff
# dette GC-veggen (nc_main er heile lukkingsmodulen); testen VIL køyre grønt på
# ein fersk seed med bølgje-(b)-endringane.

bruk selfhost.nc_main

funksjon har(s: tekst, sub: tekst) -> boolsk {
    returner builtin.contains(s, sub)
}

funksjon krev(namn: tekst, resp: tekst, sub: tekst) {
    hvis ikkje har(resp, sub) {
        kast "FEIL " + namn + ": fann ikkje '" + sub + "' i svaret:\n" + resp
    }
}

funksjon start() -> heltall {
    la rs = nc_reload_bundle("tests/fixtures/fase2b_serve_app.no", "__main__")
    hvis ikkje rs["ok"] {
        kast "bundle feila: " + tekst(rs["error"])
    }
    la ncb = json_parse_raw(tekst(rs["ncb_json"]))
    # 2.3: set opp functions-metadata + modulglobalar + caps.
    nc_serve_init_runtime(ncb)

    # 2.4: vakt kortsluttar med 401 + WWW-Authenticate når token manglar.
    la r401 = serve_handle_one(ncb, "GET /hemmeleg HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("guard-401", r401, "401")
    krev("guard-www-auth", r401, "WWW-Authenticate")
    # response-mw køyrer på ALLE svar (òg 401).
    krev("resp-mw-paa-401", r401, "X-Fase2b")

    # 2.4: vakt slepp gjennom med token → 200.
    la r200 = serve_handle_one(ncb, "GET /hemmeleg HTTP/1.1\r\nAuthorization: Bearer t\r\n\r\n")
    krev("guard-pass-200", r200, "200")

    # 2.4 DI + request-mw-ctx + 2.6 auto-JSON på /heim.
    la rheim = serve_handle_one(ncb, "GET /heim HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("di-verdi", rheim, "DB-handle")
    krev("request-mw-bruker", rheim, "ada")
    krev("auto-json-ct", rheim, "application/json")
    krev("resp-mw-header", rheim, "X-Fase2b")

    # 2.8: OPTIONS på ukjend sti → 404 (ikkje 204).
    la ropt = serve_handle_one(ncb, "OPTIONS /finnesikkje HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("options-ukjend-404", ropt, "404")

    # 2.8: OPTIONS på kjend sti → 204 + Allow.
    la ropt2 = serve_handle_one(ncb, "OPTIONS /heim HTTP/1.1\r\nHost: x\r\n\r\n")
    krev("options-kjend-204", ropt2, "204")
    krev("options-allow", ropt2, "Allow")

    skriv("test_fase2b_serve OK\n")
    returner 0
}
