bruk selfhost.native_execution.native_codegen_v2 som codegen
bruk std.prosess som system_prosess
bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon docker_køyr(namn: tekst, miljø: ordbok_tekst) -> tekst {
    la docker = system_prosess.finn_kjorbar("docker")
    hvis docker == "" { kast "Docker manglar" }
    la argv: liste_tekst = ["run", "--platform", "linux/amd64", "--rm"]
    la nøklar = builtin.nøkler(miljø)
    la i = 0
    mens i < lengde(nøklar) {
        legg_til(argv, "-e")
        legg_til(argv, nøklar[i] + "=" + tekst(miljø[nøklar[i]]))
        i = i + 1
    }
    legg_til(argv, "-v")
    legg_til(argv, "/private/tmp:/work:ro")
    legg_til(argv, "alpine:3.20")
    legg_til(argv, "/work/" + namn)
    la resultat = prosess.køyr(docker, argv, tekst(builtin.system_info()["cwd"]), {}, 120000)
    returner tekst(resultat["exit_code"])
}

