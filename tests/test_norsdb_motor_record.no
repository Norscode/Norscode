// Fase 1: binært record-format — round-trip av verdiar og rader.
// Verifiserer type-tagging (INTEGER/TEXT/REAL/BLOB/NULL), lengde-framing og at
// fleire rader etter kvarandre kan dekodast (grunnlag for WAL/checkpoint i Fase 3).

bruk std.norsdb_motor som motor

funksjon start() -> heltall {
    // ── Verdi round-trip per type ────────────────────────────────────
    la e1 = motor.enc_verdi(motor.tag_int(), "37")
    la d1 = motor.dec_verdi(e1, 0)
    assert_eq(d1["tag"], motor.tag_int())
    assert_eq(d1["verdi"], "37")
    assert_eq(d1["neste"], lengde(e1))

    la e2 = motor.enc_verdi(motor.tag_tekst(), "Bjørn")
    la d2 = motor.dec_verdi(e2, 0)
    assert_eq(d2["tag"], motor.tag_tekst())
    assert_eq(d2["verdi"], "Bjørn")

    la e3 = motor.enc_verdi(motor.tag_null(), "")
    la d3 = motor.dec_verdi(e3, 0)
    assert_eq(d3["tag"], motor.tag_null())
    assert_eq(d3["neste"], 1)

    la e4 = motor.enc_verdi(motor.tag_real(), "40.5")
    la d4 = motor.dec_verdi(e4, 0)
    assert_eq(d4["tag"], motor.tag_real())
    assert_eq(d4["verdi"], "40.5")

    // Type-skilje: INTEGER, TEXT og REAL har ulik tag (grunnlaget som fiksar G1/G3)
    assert(motor.tag_int() != motor.tag_tekst())
    assert(motor.tag_real() != motor.tag_int())

    // ── Rad round-trip med blanda typar inkl. NULL ───────────────────
    la tags = [motor.tag_int(), motor.tag_tekst(), motor.tag_int(), motor.tag_null()]
    la verdiar = ["1", "Ada", "37", ""]
    la er = motor.enc_rad(tags, verdiar)
    la dr = motor.dec_rad(er, 0)
    assert_eq(lengde(dr["verdiar"]), 4)
    assert_eq(dr["verdiar"][0], "1")
    assert_eq(dr["verdiar"][1], "Ada")
    assert_eq(dr["verdiar"][2], "37")
    assert_eq(dr["tags"][3], motor.tag_null())
    assert_eq(dr["neste"], lengde(er))

    // ── Fleire rader etter kvarandre: neste-peikaren skal treffe rett ─
    la strøm: liste<heltall> = []
    la a = motor.enc_rad([motor.tag_int()], ["10"])
    la b = motor.enc_rad([motor.tag_tekst()], ["hei"])
    la i: heltall = 0
    mens i < lengde(a) { legg_til(strøm, a[i]); i = i + 1 }
    i = 0
    mens i < lengde(b) { legg_til(strøm, b[i]); i = i + 1 }
    la r1 = motor.dec_rad(strøm, 0)
    assert_eq(r1["verdiar"][0], "10")
    la r2 = motor.dec_rad(strøm, r1["neste"])
    assert_eq(r2["verdiar"][0], "hei")
    assert_eq(r2["neste"], lengde(strøm))

    returner 0
}
