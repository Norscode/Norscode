// Heile CRL-/OCSP-matrisa blir kompilert og køyrd som native Norscode.
// Dei signerte vektorane og alle byteavkortingane ligg uendra i proben.
// Rein VM-tolking av alle Ed25519-signeringane gjekk over 1200 s på både
// Linux og macOS. Dette er ein kryptoregresjon, ikkje ein VM-bokhaldstest.
bruk tools.process_runner som prosess
bruk tools.refresh_native_codegen som rapport
bruk std.filops som filops
bruk selfhost.native_execution.codegen_prebuilt som cgp

funksjon krev_ok(r) {
    hvis ikkje prosess.ok(r) {
        prosess.skriv_resultat(r)
        assert_eq(tekst(r["status"]) + "/" + tekst(r["exit_code"]), "ferdig/0")
    }
}

funksjon køyr_codegen(root: tekst, runtime: tekst, target: tekst, env: ordbok) -> ordbok {
    la val = cgp.vel(root, target, cgp.vert_plattform())
    hvis tekst(val["status"]) == "ok" {
        returner prosess.køyr(tekst(val["sti"]), [], root, env, 300000)
    }
    // Windows og Linux ARM64 har ikkje ein committa codegen for eigen vert.
    // Køyr den same .no-kjelda i Norscode-VM-en; resultatet er framleis ein
    // ekte native probe. NC_TARGET vel òg PE i native_codegen_v2.start().
    // bygg-native sin eldre Windows-fallback avviser dette før kjelda blir
    // køyrd, so bruk den dokumenterte NC_INPUT/NC_OUTPUT-inngangen direkte.
    la kjelde = cgp.codegen_kjelde(target)
    assert(kjelde != "")
    skriv("x509-revocation: kjelde-codegen for " + target + ": " + tekst(val["melding"]) + "\n")
    la barn = {}
    for nøkkel i nøkler(env) { barn[nøkkel] = env[nøkkel] }
    barn["NORSCODE_CMD"] = "run"
    barn["NORSCODE_FILE"] = root + "/" + kjelde
    // Tolka heilprogram-codegen treng meir minne enn sjølve kryptoproben.
    // Same eksplisitte grense som test_linux_arm64_aot_cli, med eiga tidsgrense.
    barn["NORSCODE_PROCESS_MAX_MEMORY_BYTES"] = "12884901888"
    returner prosess.køyr_med_grenser(runtime, ["run", root + "/" + kjelde],
        root, barn, 900000, 12884901888, 64)
}

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la runtime = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis runtime == "" { runtime = tekst(builtin.system_info()["executable"]) }
    la info = builtin.system_info()
    la system = tekst(info["system"])
    la maskin = builtin.lower(tekst(info["machine"]))
    la target = ""
    hvis system == "Windows" og (maskin == "amd64" eller maskin == "x86_64" eller maskin == "x64") { target = "windows-x86_64" }
    hvis system == "Darwin" og (maskin == "arm64" eller maskin == "aarch64") { target = "macos-arm64" }
    hvis system == "Linux" {
        hvis maskin == "amd64" eller maskin == "x86_64" { target = "linux-x86_64" }
        hvis maskin == "arm64" eller maskin == "aarch64" { target = "linux-arm64" }
    }
    assert(target != "")
    la ut = root + "/build/x509-revocation-probe-" + tekst(builtin.tid_ms())
    hvis builtin.starts_with(target, "windows-") { ut = ut + ".exe" }
    la kjelde = ut + ".no"
    la ncb = ut + ".ncb.json"
    // Eksplisitt AOT-bunt gjer rapportflagget uavhengig av ein eldre nc_main
    // som ikkje vidaresender NC_BUILTIN_REPORT frå bygg-native til codegen.
    // Proben er uendra; denne inngangen legg berre til AOT-runtime-importane.
    la inngang = "bruk tests.fixtures.x509_revocation_native_probe som probe\n" +
        "bruk std.desimaltall_tekst som desimal\n"
    hvis target == "linux-x86_64" eller target == "windows-x86_64" {
        inngang = inngang + "bruk std.native_gap som native_gap\n"
    }
    builtin.fil_skriv(kjelde, inngang + "funksjon start() -> heiltall { returner probe.start() }\n")
    la env = {"NORSCODE_ROOT": root, "NORSCODE_CMD": "", "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "", "NORSCODE_GC_ALLOC": "1", "NC_BUILTIN_REPORT": "1",
        "NC_BUILTIN_KVITLISTE": "", "NORSCODE_VM_FAST": "1",
        "NORSCODE_NATIVE_TOOL_CACHE": "0", "NORSCODE_VM_HOSTED": "0",
        "NORSCODE_USE_PRECOMPILED_SELFHOST": "0", "NORSCODE_USE_PRECOMPILED_STDLIB": "0",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"}
    krev_ok(prosess.køyr(runtime, ["bundle", "--output", ncb, kjelde], root, env, 300000))
    assert(builtin.fil_finnes(ncb))
    env["NC_INPUT"] = ncb
    env["NC_OUTPUT"] = ut
    env["NC_TARGET"] = target
    la bygd = køyr_codegen(root, runtime, target, env)
    krev_ok(bygd)
    la bygglogg = tekst(bygd["stdout"]) + tekst(bygd["stderr"])
    // x86 har uventa=; ARM64 har stubba=. Den felles rapportlesaren krev
    // nøyaktig éin rapport og null uløyste/uventa, utan plattformgissing.
    prosess.skriv_resultat(bygd)
    rapport.krev_nullrapportar(bygglogg, 1)
    assert(ikkje builtin.contains(bygglogg, "STOPPA    "))
    // Denne reine kryptoproben skal ikkje byggje på NATIV-GAP-stubbar.
    hvis builtin.contains(bygglogg, "stubba=") { assert_eq(rapport.rapport_tal(bygglogg, "stubba"), 0) }
    assert(builtin.fil_finnes(ut))
    assert(builtin.fil_sett_kjorbar(ut))
    la r = prosess.køyr(ut, [], root, env, 600000)
    krev_ok(r)
    prosess.skriv_resultat(r)
    assert(builtin.contains(tekst(r["stdout"]), "test_x509_revocation OK"))
    filops.slett_fil(ut)
    filops.slett_fil(ncb)
    filops.slett_fil(kjelde)
    skriv("test_x509_revocation OK\n")
    returner 0
}
