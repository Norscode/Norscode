// std.bytes.utsnitt_til_tekst: kalla builtin.bytes_slice_to_text, som verken VM-en
// eller native_codegen_v2 kjenner (null-fallback i R1-byggloggen). Eksplisitte
// exit-kodar i tillegg til assert, så testen kan seie nei òg der assert er no-op.
bruk std.bytes som bytes

funksjon start() -> heiltall {
    // "hei æøå" i UTF-8
    la buf = bytes.fra_liste([104, 101, 105, 32, 195, 166, 195, 184, 195, 165])
    la a = bytes.utsnitt_til_tekst(buf, 0, 3)
    hvis a != "hei" { skriv("feil prefiks: " + a + "\n") returner 1 }
    la b = bytes.utsnitt_til_tekst(buf, 4, 6)
    hvis b != "æøå" { skriv("feil UTF-8-utsnitt: " + b + "\n") returner 2 }
    la tom = bytes.utsnitt_til_tekst(buf, 10, 0)
    hvis lengde(tom) != 0 { returner 3 }
    la kasta = usann
    prøv { bytes.utsnitt_til_tekst(buf, 8, 3) } fang (e) { kasta = sann }
    hvis ikkje kasta { skriv("utsnitt utanfor bufferen vart ikkje avvist\n") returner 4 }
    assert_eq(a, "hei")
    skriv("test_bytes_utsnitt_til_tekst OK\n")
    returner 0
}
