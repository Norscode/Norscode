# M3 — lambdaer og closures ende-til-ende gjennom KJELDE-kompilatoren og
# KJELDE-VM-en. Verifiserer at BUILD_LAMBDA fangar frie variablar og at
# CALL_VALUE kallar closure-verdien med capture bunde som lokale.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk std.tekst som t

funksjon kompiler_og_køyr(kjelde: tekst) -> heltall {
    la ncb_json = kompiler.kompiler_fil(kjelde, "__main__")
    la ncb = builtin.json_parse_raw(ncb_json)
    returner vm.køyr_ncb(ncb)
}

funksjon ncb_for(kjelde: tekst) -> tekst {
    returner kompiler.kompiler_fil(kjelde, "__main__")
}

funksjon start() -> heiltall {
    # ── Grunnleggjande closure: fangar lokal x ───────────────────────────────
    la prog1 = "funksjon start() -> heltall {\n" +
        "    la x: heltall = 3\n" +
        "    la f = fun(y: heltall) -> x + y\n" +
        "    returner f(4)\n" +
        "}\n"
    # Kompilatoren skal emittere BUILD_LAMBDA med x i capture-lista
    la ncb1 = ncb_for(prog1)
    assert(t.inneholder(ncb1, "BUILD_LAMBDA"))
    assert(t.inneholder(ncb1, "CALL_VALUE"))
    assert_eq(kompiler_og_køyr(prog1), 7)

    # ── Capture er by-value: endring av x etterpå påverkar ikkje closuren ─────
    la prog2 = "funksjon start() -> heltall {\n" +
        "    la x: heltall = 10\n" +
        "    la f = fun(y: heltall) -> x + y\n" +
        "    x = 100\n" +
        "    returner f(1)\n" +
        "}\n"
    assert_eq(kompiler_og_køyr(prog2), 11)

    # ── Lambda utan capture ──────────────────────────────────────────────────
    la prog3 = "funksjon start() -> heltall {\n" +
        "    la dobbel = fun(n: heltall) -> n * 2\n" +
        "    returner dobbel(21)\n" +
        "}\n"
    assert_eq(kompiler_og_køyr(prog3), 42)

    # ── Fleire captures ──────────────────────────────────────────────────────
    la prog4 = "funksjon start() -> heltall {\n" +
        "    la a: heltall = 5\n" +
        "    la b: heltall = 7\n" +
        "    la sum = fun(c: heltall) -> a + b + c\n" +
        "    returner sum(1)\n" +
        "}\n"
    assert_eq(kompiler_og_køyr(prog4), 13)

    # ── M3-follow-on: closure gjennom builtin.ncb_call_fn (som std/js_* gjer) ──
    la prog5 = "funksjon start() -> heltall {\n" +
        "    la f = fun(n: heltall) -> n * 2\n" +
        "    returner builtin.ncb_call_fn(f, 21)\n" +
        "}\n"
    assert_eq(kompiler_og_køyr(prog5), 42)

    # ncb_call_fn med capture
    la prog6 = "funksjon start() -> heltall {\n" +
        "    la k: heltall = 100\n" +
        "    la f = fun(n: heltall) -> n + k\n" +
        "    returner builtin.ncb_call_fn(f, 5)\n" +
        "}\n"
    assert_eq(kompiler_og_køyr(prog6), 105)

    # ncb_call_fn med funksjonsnamn (tekst) skal framleis virke
    la prog7 = "funksjon dobbel(n: heltall) -> heltall { returner n * 2 }\n" +
        "funksjon start() -> heltall {\n" +
        "    returner builtin.ncb_call_fn(\"__main__.dobbel\", 21)\n" +
        "}\n"
    assert_eq(kompiler_og_køyr(prog7), 42)

    skriv("test_lambda_closure OK\n")
    returner 0
}
