// Fase 7a/7b: uttrykks-evaluator — aritmetikk (m/ presedens), ||, funksjonar, CASE,
// samanlikning. Frittståande verifisering (integrasjon i SELECT/WHERE er neste steg).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la rad = {"navn": "Ada", "alder": "37", "by": "Oslo"}

    // Aritmetikk + presedens
    assert_eq(sql.evaluer_uttrykk("alder + 3", rad), "40")
    assert_eq(sql.evaluer_uttrykk("alder * 2", rad), "74")
    assert_eq(sql.evaluer_uttrykk("(alder - 7) / 3", rad), "10")
    assert_eq(sql.evaluer_uttrykk("2 + 3 * 4", rad), "14")
    assert_eq(sql.evaluer_uttrykk("(2 + 3) * 4", rad), "20")

    // Streng-konkat
    assert_eq(sql.evaluer_uttrykk("navn || ' (' || by || ')'", rad), "Ada (Oslo)")

    // Funksjonar
    assert_eq(sql.evaluer_uttrykk("upper(navn)", rad), "ADA")
    assert_eq(sql.evaluer_uttrykk("lower(by)", rad), "oslo")
    assert_eq(sql.evaluer_uttrykk("length(navn)", rad), "3")
    assert_eq(sql.evaluer_uttrykk("substr(navn, 2, 2)", rad), "da")
    assert_eq(sql.evaluer_uttrykk("abs(0 - alder)", rad), "37")
    assert_eq(sql.evaluer_uttrykk("coalesce('', navn)", rad), "Ada")
    assert_eq(sql.evaluer_uttrykk("replace(by, 'slo', 'X')", rad), "OX")
    assert_eq(sql.evaluer_uttrykk("cast(alder as real)", rad), "37")

    // Samanlikning → 1/0
    assert_eq(sql.evaluer_uttrykk("alder > 30", rad), "1")
    assert_eq(sql.evaluer_uttrykk("alder = 37", rad), "1")
    assert_eq(sql.evaluer_uttrykk("navn = 'Bob'", rad), "0")

    // CASE
    assert_eq(sql.evaluer_uttrykk("case when alder > 40 then 'gammal' else 'ung' end", rad), "ung")
    assert_eq(sql.evaluer_uttrykk("case when by = 'Oslo' then 'hovudstad' else 'anna' end", rad), "hovudstad")

    // Nøsta uttrykk i funksjon
    assert_eq(sql.evaluer_uttrykk("upper(navn || '-' || by)", rad), "ADA-OSLO")

    returner 0
}
