bruk std.runtime_filesystem_native som fs

funksjon les(h, maks: heiltall) {
    returner fs.read_operation({"operation": "read_binary", "handle": h["handle"], "max": tekst_fra_heiltall(maks)})
}
funksjon start() -> heiltall {
    la namn = "binary-handle-" + tekst_fra_heiltall(builtin.tid_ms()) + ".bin"
    la sti = "build/" + namn
    builtin.fil_skriv_binær(sti, builtin.bytes_from_list([0, 255, 17, 64, 128, 10]))
    la h = fs.read_operation({"operation": "open", "root": "build", "relative": namn, "mode": "read"})
    assert_eq(h["status"], "open")
    // Handtaket har eit bilete frå open. Ei seinare filendring skal ikkje
    // få binærlesaren til å opne stien om att eller skifte underliggjande data.
    builtin.fil_skriv_binær(sti, builtin.bytes_from_list([9, 9]))
    la a = les(h, 2)
    assert_eq(a["status"], "ok")
    assert_eq(a["value"], 2)
    assert_eq(a["data_bytes"], builtin.bytes_from_list([0, 255]))
    la tekstbit = fs.read_operation({"operation": "read", "handle": h["handle"], "max": "1"})
    assert_eq(builtin.char_code(tekstbit["data"]), 17)
    la b = les(h, 8)
    assert_eq(b["value"], 3)
    assert_eq(b["data_bytes"], builtin.bytes_from_list([64, 128, 10]))
    assert_eq(les(h, 1)["value"], 0)
    fs.read_operation({"operation": "seek", "handle": h["handle"], "position": "1"})
    assert_eq(les(h, 0)["value"], 0)
    assert_eq(les(h, 1)["data_bytes"], builtin.bytes_from_list([255]))
    assert_eq(les(h, 0 - 1)["status"], "feil")
    assert_eq(les(h, 1)["data_bytes"], builtin.bytes_from_list([17]))
    fs.read_operation({"operation": "seek", "handle": h["handle"], "position": "1"})
    assert_eq(les(h, 9223372036854775807)["value"], 5)
    fs.read_operation({"operation": "seek", "handle": h["handle"], "position": "100"})
    assert_eq(les(h, 8)["value"], 0)
    assert_eq(fs.fh_hent(h)["pos"], 100)
    assert_eq(fs.read_operation({"operation": "read", "handle": h["handle"], "max": "1"})["value"], 0)
    assert_eq(fs.fh_hent(h)["pos"], 100)
    assert_eq(fs.read_operation({"operation": "close", "handle": h["handle"]})["status"], "closed")
    assert_eq(les(h, 1)["status"], "feil")
    la w = fs.write_operation({"operation": "open", "root": "build", "relative": namn, "mode": "write"})
    assert_eq(w["status"], "open")
    assert_eq(les(w, 1)["status"], "feil")
    assert_eq(fs.write_operation({"operation": "close", "handle": w["handle"]})["status"], "closed")
    skriv("test_filesystem_binary_handle_backend OK\n")
    returner 0
}
