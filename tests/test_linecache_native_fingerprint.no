bruk std.linecache som lc

funksjon start() -> heiltall {
    # Hald testen uavhengig av om det innchecka stage0-ankerets eldre
    # mkdir_p-ABI er materialisert. Sjølve fingeravtrykkstesten treng berre ei
    # fil i den eksisterande arbeidsrota.
    la sti = "linecache-native-fingerprint.tmp"
    prøv { builtin.fil_slett(sti) } fang (e) { }
    builtin.fil_skriv(sti, "første\n")

    la cache = lc.ny_cache()
    la alle_første = lc.getlines(cache, sti)
    la første = alle_første[0]
    assert(første == "første\n")
    assert(lc.er_bufra(cache, sti))

    # Same lengd, anna innhald: storleik åleine ville ikkje oppdaga endringa.
    builtin.fil_skriv(sti, "andre!\n")
    lc.checkcache(cache)
    assert(ikkje lc.er_bufra(cache, sti))
    la andre = lc.getline(cache, sti, 1)
    assert(andre == "andre!\n")

    prøv { builtin.fil_slett(sti) } fang (e) { }
    lc.checkcache(cache)
    assert(ikkje lc.er_bufra(cache, sti))
    skriv("test_linecache_native_fingerprint OK")
    returner 0
}
