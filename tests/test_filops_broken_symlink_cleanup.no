bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "broken-link-")
    assert(temp["status"] == "created")
    la rot = "build/" + temp["relative"]
    assert(runtime_fs.native_lag_mappe(rot, "target")["status"] == "ok")
    assert(runtime_fs.native_erstatt_symbolsk_lenke(rot, "current", "target")["status"] == "ok")
    assert(runtime_fs.native_slett_mappe(rot, "target")["status"] == "deleted")
    assert(filops.slett_tre(rot))
    skriv("test_filops_broken_symlink_cleanup OK")
    returner 0
}
