// Fase 2b / R1: re-implementasjon av den statiske typesjekken (#182) mot dagens
// selfhost. Testen dekkjer to lag:
//
//   1) Den strenge typesjekken (selfhost/compiler/typecheck.no via
//      sem.sem_populer_typar + tc.kt_koyr). Dette er reseed-UAVHENGIG: det
//      køyrer frå kjelde her og no, og slår fast reglane og brukarvala
//      (1+"x" = konkatenering, truthiness lovleg, ukjend type aldri rapportert).
//
//   2) At analyser_program UTAN NORSCODE_STRICT_TYPAR ikkje endrar åtferd
//      (ingen kast). Sjølve innkoplinga (flagg PÅ => kast) blir aktiv i den
//      bakte seed-kompilatoren fyrst etter reseed; via kjelde-kjeda (nc run av
//      ei fil som importerer semantic) er ho allereie verifisert manuelt.
bruk selfhost.lexer.lexer_m1 som lexer
bruk selfhost.parser som parser
bruk selfhost.compiler.typecheck som tc
bruk selfhost.compiler.semantic som sem

// Fyrste typefeil for ei kjelde ("" = ingen typefeil). Nyttar den SAME
// tabell-populeringa som analyser_program sitt strenge pass.
funksjon typefeil_for(kjelde: tekst) -> tekst {
    la ast = parser.parse_program(lexer.lex(kjelde))
    la tabell = {}
    sem.sem_populer_typar(tabell, ast)
    prøv { tc.kt_koyr(tabell, ast) } fang (e) { }
    la liste = tabell["typefeil"]
    hvis lengde(liste) > 0 { returner tekst(liste[0]) }
    returner ""
}

funksjon krev_inneheld(fasit: tekst, bit: tekst, namn: tekst) -> heiltall {
    hvis builtin.contains(fasit, bit) { returner 0 }
    skriv("FEIL " + namn + ": venta «" + bit + "», fekk «" + fasit + "»\n")
    returner 1
}

funksjon krev_tom(fasit: tekst, namn: tekst) -> heiltall {
    hvis fasit == "" { returner 0 }
    skriv("FEIL " + namn + ": venta ingen typefeil, fekk «" + fasit + "»\n")
    returner 1
}

funksjon start() -> heiltall {
    la feil = 0

    // ── Typefeil som SKAL rapporterast ───────────────────────────────────────
    // Argument-type mot deklarert parameter.
    la a = typefeil_for("funksjon tar_tal(x: heltall) -> heltall { returner x }\nfunksjon start() -> heltall { la r = tar_tal(\"tekst\") returner 0 }\n")
    feil = feil + krev_inneheld(a, "argument 1 til tar_tal() er tekst, venta tal", "arg-type")

    // Tildeling mot deklarert la-type.
    la b = typefeil_for("funksjon start() -> heltall { la c: heltall = \"hei\" returner 0 }\n")
    feil = feil + krev_inneheld(b, "la c: heltall får tekst", "la-type")

    // Returtype mot deklarert returtype.
    la c = typefeil_for("funksjon f() -> heltall { returner \"hei\" }\n")
    feil = feil + krev_inneheld(c, "returnerer tekst, funksjonen er deklarert tal", "retur-type")

    // ── Brukarval: desse skal IKKJE vere typefeil ────────────────────────────
    // 1+"x" er konkatenering, ikkje typefeil.
    la d = typefeil_for("funksjon f() -> tekst { returner 1 + \"x\" }\n")
    feil = feil + krev_tom(d, "1+tekst konkatenering")

    // `hvis 5` / truthiness er lovleg (sjekken kastar ikkje på det).
    la e = typefeil_for("funksjon f() -> heltall { hvis 5 { returner 1 } returner 0 }\n")
    feil = feil + krev_tom(e, "truthiness hvis-tal")

    // Ukjend/utypa: dynamisk kode gjev ingen falsk positiv.
    la f = typefeil_for("funksjon tar_tal(x: heltall) -> heltall { returner x }\nfunksjon start() -> heltall { la u = les_input() la r = tar_tal(u) returner 0 }\n")
    feil = feil + krev_tom(f, "ukjend-type ikkje rapportert")

    // Standardverdi-idiomet `x eller \"\"` gjev tekst, ikkje typefeil.
    la g = typefeil_for("funksjon f(s: tekst) -> tekst { la t: tekst = s eller \"\" returner t }\n")
    feil = feil + krev_tom(g, "eller-standardverdi")

    // Gyldig program heilt utan typefeil.
    la h = typefeil_for("funksjon add(x: heltall, y: heltall) -> heltall { returner x + y }\nfunksjon start() -> heltall { returner add(1, 2) }\n")
    feil = feil + krev_tom(h, "gyldig program")

    // ── Bakoverkompatibilitet: analyser_program kastar ALDRI utan flagget ────
    // (NORSCODE_STRICT_TYPAR er ikkje sett under vanleg `nc test`.)
    la typefeil_ast = parser.parse_program(lexer.lex("funksjon tar_tal(x: heltall) -> heltall { returner x }\nfunksjon start() -> heltall { la r = tar_tal(\"tekst\") returner 0 }\n"))
    prøv {
        sem.analyser_program(typefeil_ast)
    } fang (ex) {
        feil = feil + 1
        skriv("FEIL flagg-av: analyser_program kasta utan NORSCODE_STRICT_TYPAR: " + tekst(ex) + "\n")
    }

    hvis feil > 0 {
        skriv("test_fase2b_r1_typesjekk FEIL (" + tekst(feil) + ")\n")
        returner 1
    }
    skriv("test_fase2b_r1_typesjekk OK\n")
    returner 0
}
