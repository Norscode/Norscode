// Tekst frå ein handlar: HTML blir text/html, anna tekst text/plain; ordbøker og null uendra.
bruk selfhost.http_response som http

funksjon start() -> heiltall {
    la h = http.normaliser_svar("<!doctype html><html><body>hei</body></html>")
    assert(tekst(h["status"]) == "200")
    assert(h["content_type"] == "text/html; charset=utf-8")
    assert(builtin.starts_with(h["body"], "<!doctype"))
    la h2 = http.normaliser_svar("  \n<HTML lang='no'><p>x</p></HTML>")
    assert(h2["content_type"] == "text/html; charset=utf-8")
    la t = http.normaliser_svar("berre tekst")
    assert(t["content_type"] == "text/plain; charset=utf-8")
    assert(t["body"] == "berre tekst")
    la t2 = http.normaliser_svar("<svg></svg>")
    assert(t2["content_type"] == "text/plain; charset=utf-8")
    assert(http.normaliser_svar(null) == null)
    la d = {"status": 201, "body": "x", "content_type": "application/json"}
    la d2 = http.normaliser_svar(d)
    assert(tekst(d2["status"]) == "201" og d2["content_type"] == "application/json")
    // Serialisering: text/html-svaret får rett Content-Type.
    la ut = http.response_to_http(h)
    assert(builtin.contains(ut, "Content-Type: text/html; charset=utf-8\r\n"))
    skriv("test_http_response_normaliser OK\n")
    returner 0
}
