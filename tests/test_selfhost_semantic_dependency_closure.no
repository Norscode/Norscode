// Kontroller faktiske CALL-instruksjonar frå kjeldekompilatoren mot Gen0-manifestet.
bruk tools.gen0_omgang6b_fragments som gen0
bruk selfhost.kompiler som kompiler

funksjon start() -> heiltall {
    la modular = {}
    for spec i gen0.modulspesifikasjonar() {
        la felt = builtin.split(spec, "|")
        modular[felt[1]] = sann
    }
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(
        builtin.fil_les("selfhost/compiler/semantic.no"), "selfhost.compiler.semantic"))
    la fns = ncb["functions"]
    la kontrollert = 0
    for namn i nøkler(fns) {
        for instr i fns[namn]["code"] {
            hvis instr[0] == "CALL" og builtin.starts_with(tekst(instr[1]), "selfhost.compiler.") {
                la delar = builtin.split(tekst(instr[1]), ".")
                la modul = builtin.join(builtin.slice(delar, 0, lengde(delar) - 1), ".")
                hvis ikkje har_nokkel(modular, modul) {
                    skriv("Manglande selfhost-avhengigheit: " + tekst(instr[1]) + "\n")
                    returner 1
                }
                kontrollert = kontrollert + 1
            }
        }
    }
    assert(kontrollert > 0)
    skriv("test_selfhost_semantic_dependency_closure OK\n")
    returner 0
}
