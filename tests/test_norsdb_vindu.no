// Fase 7g: vindusfunksjonar — ROW_NUMBER/RANK/DENSE_RANK + aggregat OVER (PARTITION BY … ORDER BY …).
// Golden = ekte sqlite3 3.51.0.

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE sal (id INTEGER, avd TEXT, namn TEXT, belop INTEGER)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (1, 'A', 'Ada', 100)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (2, 'A', 'Bo', 100)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (3, 'A', 'Cy', 80)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (4, 'B', 'Di', 200)")
    sql.exec(db, "INSERT INTO sal (id, avd, namn, belop) VALUES (5, 'B', 'Ed', 150)")

    // ROW_NUMBER (global ORDER BY belop DESC), utdata sortert på namn
    assert_eq(sql.query_rader(db, "SELECT namn, ROW_NUMBER() OVER (ORDER BY belop DESC) FROM sal ORDER BY namn"),
        "Ada|3\nBo|4\nCy|5\nDi|1\nEd|2")
    // RANK (ties → same rank, gap)
    assert_eq(sql.query_rader(db, "SELECT namn, RANK() OVER (ORDER BY belop DESC) FROM sal ORDER BY namn"),
        "Ada|3\nBo|3\nCy|5\nDi|1\nEd|2")
    // DENSE_RANK (ties → same, ingen gap)
    assert_eq(sql.query_rader(db, "SELECT namn, DENSE_RANK() OVER (ORDER BY belop DESC) FROM sal ORDER BY namn"),
        "Ada|3\nBo|3\nCy|4\nDi|1\nEd|2")
    // PARTITION BY + ROW_NUMBER
    assert_eq(sql.query_rader(db, "SELECT namn, ROW_NUMBER() OVER (PARTITION BY avd ORDER BY belop DESC) FROM sal ORDER BY namn"),
        "Ada|1\nBo|2\nCy|3\nDi|1\nEd|2")
    // SUM OVER partisjon (heile partisjon)
    assert_eq(sql.query_rader(db, "SELECT namn, SUM(belop) OVER (PARTITION BY avd) FROM sal ORDER BY namn"),
        "Ada|280\nBo|280\nCy|280\nDi|350\nEd|350")
    // COUNT(*) OVER partisjon
    assert_eq(sql.query_rader(db, "SELECT namn, COUNT(*) OVER (PARTITION BY avd) FROM sal ORDER BY namn"),
        "Ada|3\nBo|3\nCy|3\nDi|2\nEd|2")

    returner 0
}
