// Sjølv-verifiserande testprogram for binær-NCB → native ARM64-lykkja.
// Byggjast via BEGGE format (binær + JSON) i CI; skal gje exit 42 nativt.
// Øvar tal (zigzag), negative, liste, streng, og ein null-konstant (regresjon
// for null→0-bugen i det binære formatet).

funksjon sum_liste(xs: liste_heiltall) -> heiltall {
    la s = 0
    for x i xs { s = s + x }
    returner s
}

funksjon start() -> heiltall {
    la xs = [10, -3, 20, 0, 15]      // sum = 42
    la s = sum_liste(xs)

    // streng-røyndom
    la t = "æøå-NCB"
    hvis lengde(t) <= 0 { returner 1 }

    // null-konstant må vere null (ikkje 0) etter binær round-trip i codegen-lesaren
    la n = builtin.json_parse_raw("null")
    hvis builtin.type(n) != "ingenting" { returner 2 }

    returner s
}
