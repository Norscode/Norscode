# R1 / F07: aritetskontroll i direkte CALL, CALL_VALUE (lambda) og dynamisk
# ncb_call_fn. For få argument gav SIGSEGV (exit 139) og for mange vart stilt
# ignorerte. No skal begge gje eit FANGBART unntak med typen ArgumentFeil, medan
# standardargument og varargs (fylte/pakka på kallstaden) framleis verkar.
# Køyrer gjennom KJELDE-kompilator + VM.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utfor(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon fang_prog(kall: tekst) -> tekst {
    returner "funksjon to(a: heltall, b: heltall) -> heltall { returner a + b }\n" +
        "funksjon utypa(a, b) { returner b }\n" +
        "funksjon start() -> tekst {\n" +
        "    la fv = fun(a, b) -> a + b\n" +
        "    prøv {\n" +
        "        la r = " + kall + "\n" +
        "        returner \"INGEN-FEIL\"\n" +
        "    } fang (e: ArgumentFeil) {\n" +
        "        returner \"FANGA:\" + tekst(e)\n" +
        "    }\n" +
        "}\n"
}

funksjon sjekk_fanga(kall: tekst, namn: tekst, forventa: tekst, fekk: tekst) -> heiltall {
    la r = utfor(fang_prog(kall))
    skriv(kall + " -> " + r + "\n")
    assert(builtin.starts_with(r, "FANGA:ArgumentFeil: Aritetsfeil ved "))
    assert(builtin.index_of(r, namn) > 0)
    assert(builtin.index_of(r, "forventa " + forventa + " argument, fekk " + fekk) > 0)
    returner 0
}

funksjon start() -> heiltall {
    # Direkte CALL: for få og for mange.
    sjekk_fanga("to(1)", "__main__.to", "2", "1")
    sjekk_fanga("to(1, 2, 3)", "__main__.to", "2", "3")
    sjekk_fanga("utypa(1)", "__main__.utypa", "2", "1")
    # CALL_VALUE (lambda): for få og for mange.
    sjekk_fanga("fv(1)", "__lambda", "2", "1")
    sjekk_fanga("fv(1, 2, 3)", "__lambda", "2", "3")
    # Dynamisk ncb_call_fn: typen er no ArgumentFeil òg her.
    sjekk_fanga("builtin.ncb_call_fn(\"__main__.to\", 5)", "dynamisk kall til __main__.to", "2", "1")

    # Ufanga aritetsfeil i ein djupare ramme vert ruta til forelderen sin fang.
    la p_djup = "funksjon to(a, b) { returner a + b }\n" +
        "funksjon mellom() { returner to(1) }\n" +
        "funksjon start() -> tekst {\n" +
        "    prøv { mellom() } fang (e: ArgumentFeil) { returner \"YTRE\" }\n" +
        "    returner \"INGEN-FEIL\"\n" +
        "}\n"
    assert_eq(utfor(p_djup), "YTRE")

    # Standardargument og varargs er framleis lovlege (fylte på kallstaden).
    la p_ok = "funksjon med_std(a: heltall, b: heltall = 10) -> heltall { returner a + b }\n" +
        "funksjon va(a, ...rest) { returner a + lengde(rest) }\n" +
        "funksjon to(a, b) { returner a + b }\n" +
        "funksjon start() -> tekst {\n" +
        "    la fv = fun(a, b) -> a * b\n" +
        "    returner tekst(med_std(1)) + \",\" + tekst(med_std(1, 2)) + \",\" + tekst(va(1)) + \",\" +\n" +
        "        tekst(va(1, 2, 3)) + \",\" + tekst(to(2, 3)) + \",\" + tekst(fv(2, 3)) + \",\" +\n" +
        "        tekst(builtin.ncb_call_fn(\"__main__.to\", 4, 5))\n" +
        "}\n"
    assert_eq(utfor(p_ok), "11,3,1,3,5,6,9")

    skriv("test_r1_aritet OK\n")
    returner 0
}
