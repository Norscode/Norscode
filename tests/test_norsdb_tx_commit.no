// Regresjonstest for funn #1: transaction() skal committe gyldige transaksjonar
// som set inn 0 rader (rein UPDATE / DDL / DELETE), og berre rulla tilbake ved
// reelt ugyldig SQL. Tidlegare committa transaction() kun når det vart sett inn
// minst éi rad, så reine UPDATE/DDL-transaksjonar vart feilaktig rulla tilbake.

bruk std.db som db

funksjon start() -> heltall {
    la handle = db.open(":memory:")
    assert(db.ping(handle))
    assert_eq(db.execute(handle, "CREATE TABLE users (id INTEGER, name TEXT, age INTEGER)"), 0)
    assert_eq(db.execute(handle, "INSERT INTO users (name, age) VALUES ('Ada', 37)"), 1)
    assert_eq(db.execute(handle, "INSERT INTO users (name, age) VALUES ('Linus', 55)"), 1)

    // Funn #1: rein UPDATE-transaksjon skal committe (0 innsette rader er ikkje feil).
    assert_eq(db.transaction(handle, "UPDATE users SET age = 99 WHERE id = 1"), 1)
    assert_eq(db.query_text(handle, "SELECT age FROM users WHERE id = 1"), "99")

    // Funn #1: rein DDL-transaksjon skal committe.
    assert_eq(db.transaction(handle, "CREATE TABLE logg (id INTEGER, tekst TEXT)"), 1)
    assert_eq(db.execute(handle, "INSERT INTO logg (tekst) VALUES ('ok')"), 1)
    assert_eq(db.query_int(handle, "SELECT COUNT(*) FROM logg"), 1)

    // Funn #1: rein DELETE-transaksjon skal committe.
    assert_eq(db.transaction(handle, "DELETE FROM users WHERE id = 2"), 1)
    assert_eq(db.query_int(handle, "SELECT COUNT(*) FROM users"), 1)

    // Regresjonsvern (jf. test_db.no): reelt ugyldig SQL skal rulla tilbake og gje 0.
    assert_eq(db.transaction(handle, "INSRT INTO users (name) VALUES ('X')"), 0)
    assert_eq(db.query_int(handle, "SELECT COUNT(*) FROM users"), 1)

    // Atomisitet: gyldig UPDATE + ugyldig setning => heile transaksjonen rullar tilbake.
    assert_eq(db.transaction(handle, "UPDATE users SET age = 1 WHERE id = 1; BOGUS STATEMENT"), 0)
    assert_eq(db.query_text(handle, "SELECT age FROM users WHERE id = 1"), "99")

    assert(db.close(handle))
    returner 0
}
