// Linux x86-64 AOT, F3.2: byggjer tests/fixtures/aot_prosess_stress.no (stresstesten for
// spawn-motoren i std.native_gap) med bygg-native og køyrer binæren. I motsetnad til
// test_native_process_stress (VM-vegen, seeden sin baka motor) testar dette motoren frå
// kjelda på greina, so porten verkar òg før seed-promotering. Negativ kontroll: med den
// gamle rå spawn-rutina i codegen (base 0d6da00) døyr binæren av SIGPIPE / heng.
// Berre på Linux x86-64-vert (andre vertar: hoppa, exit 0).

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon runtime(root: tekst) -> tekst {
    la sti = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis sti != "" { returner sti }
    prøv {
        sti = tekst(builtin.system_info()["executable"])
        hvis sti != "" { returner sti }
    } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon vert_linux_x86_64() -> boolsk {
    la system = miljo_hent("NORSCODE_CI_SYSTEM")
    la maskin = miljo_hent("NORSCODE_CI_ARCH")
    hvis system == "" { system = miljo_hent("RUNNER_OS") }
    hvis maskin == "" { maskin = miljo_hent("RUNNER_ARCH") }
    hvis system == "" eller maskin == "" {
        prøv {
            la info = builtin.system_info()
            hvis system == "" { system = tekst(info["system"]) }
            hvis maskin == "" { maskin = tekst(info["machine"]) }
        } fang (e) {}
    }
    la linux = system == "Linux" eller system == "linux"
    la x64 = maskin == "X64" eller maskin == "x64" eller maskin == "x86_64" eller maskin == "amd64"
    returner linux og x64
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, {
        "NORSCODE_CMD": "",
        "NORSCODE_FILE": "",
        "NORSCODE_OUTPUT": "",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, timeout_ms)
}

funksjon krev_exit(resultat: ordbok_tekst, kode: heiltall) -> heiltall {
    hvis tekst(resultat["status"]) != "ferdig" eller heltall_fra_tekst(tekst(resultat["exit_code"])) != kode {
        prosess.skriv_resultat(resultat)
        assert_eq(tekst(resultat["status"]) + "/" + tekst(resultat["exit_code"]), "ferdig/" + tekst_fra_heltall(kode))
    }
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje vert_linux_x86_64() {
        skriv("test_linux_x86_64_aot_prosess_stress: hoppa over (ikkje Linux x86-64)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la binær = "/tmp/norscode_aot_prosess_stress_" + builtin.random_hex(8)
    krev_exit(køyr(runtime(root), ["bygg-native", "--target", "linux-x86_64",
                                   root + "/tests/fixtures/aot_prosess_stress.no", binær], root, 180000), 0)
    la resultat = køyr(binær, [], root, 60000)
    krev_exit(resultat, 42)
    assert(builtin.contains(tekst(resultat["stdout"]), "test_native_process_stress OK"))
    assert(builtin.contains(tekst(resultat["stdout"]), "stress: feilformer"))
    filops.slett_fil(binær)
    skriv("test_linux_x86_64_aot_prosess_stress OK\n")
    returner 0
}
