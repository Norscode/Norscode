// The CI builder must finish repeated hashes of full native artifacts within
// the seed VM's existing heap. No larger heap or substituted hash host is used.
bruk tools.build_ci_runtime_candidate som builder
bruk std.filops som filops
bruk std.runtime_filesystem som runtime_fs

funksjon avviser(sti: tekst) -> boolsk {
    prøv { builder.hash(sti) } fang (e) { returner sann }
    returner usann
}

funksjon start() -> heiltall {
    assert(filops.lag_katalogar("build"))
    la temp = runtime_fs.native_tempområde("build", "ci-runtime-hash-")
    assert_eq(temp["status"], "created")
    la root = tekst(builtin.system_info()["cwd"]) + "/build/" + temp["relative"]
    la sti = root + "/artifact"
    la innhald = "a" + builtin.chr(0) + "z"
    la i = 0
    mens i < 21 { innhald = innhald + innhald i = i + 1 }
    builtin.fil_skriv(sti, innhald)
    la venta = tekst(builtin.sha256_bytes(builtin.fil_les_binær(sti)))
    // Each artifact is 6 MiB. Their boxed byte lists must not accumulate in
    // the long-lived builder before it can finish and write build.json.
    i = 0
    mens i < 12 {
        assert_eq(builder.hash(sti), venta)
        i = i + 1
    }
    // The process identity, not an unverified environment override, selects
    // the hash host. An inherited input NCB must not replace the helper either.
    la før_native = builder.env("NORSCODE_NATIVE_BIN")
    la før_ncb = builder.env("NORSCODE_NCB_FILE")
    builtin.miljo_sett("NORSCODE_NATIVE_BIN", root + "/untrusted-host")
    builtin.miljo_sett("NORSCODE_NCB_FILE", root + "/untrusted.ncb.json")
    assert_eq(builder.hash(sti), venta)
    builtin.miljo_sett("NORSCODE_NATIVE_BIN", før_native)
    builtin.miljo_sett("NORSCODE_NCB_FILE", før_ncb)
    // The entire file matters, including bytes after embedded NUL.
    builtin.fil_skriv(sti, builtin.slice(innhald, 0, lengde(innhald) - 1) + "x")
    assert(builder.hash(sti) != venta)
    builtin.fil_skriv(root + "/empty", "")
    assert_eq(builder.hash(root + "/empty"), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assert(avviser(root + "/missing"))
    assert(avviser(root))
    assert(filops.slett_tre(root))
    skriv("test_ci_runtime_candidate_hash OK\n")
    returner 0
}
