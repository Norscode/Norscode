// Fase 2: B-tre (portert frå NorsDB/norsdb_index.nors). Verifiserer innsetting med
// node-splitting, søk (treff + fråvær), og at in-order gjev sortert rekkefølge.

bruk std.norsdb_motor som motor

funksjon start() -> heltall {
    la rot = motor.btre_ny()

    // Sett inn 100 nøklar i stokka rekkefølge (bijeksjon (i*37+11)%100 over 0..99).
    // Med grad 8 (maks 15 nøklar/node) tvingar dette fleire node-splittar + rot-split.
    la i: heltall = 0
    mens i < 100 {
        la nøkkel = (i * 37 + 11) % 100
        rot = motor.btre_sett_inn(rot, nøkkel, nøkkel * 10)
        i = i + 1
    }

    // Søk: kvar nøkkel gjev rett data.
    i = 0
    mens i < 100 {
        assert_eq(motor.btre_søk(rot, i), i * 10)
        i = i + 1
    }

    // Fråverande nøklar → -1.
    assert_eq(motor.btre_søk(rot, 100), -1)
    assert_eq(motor.btre_søk(rot, 250), -1)

    // In-order = sortert 0..99.
    la orden = motor.btre_i_orden(rot)
    assert_eq(lengde(orden), 100)
    assert_eq(orden[0], 0)
    assert_eq(orden[99], 99)
    i = 0
    mens i < 99 {
        assert(orden[i] < orden[i + 1])
        i = i + 1
    }

    // Treet er ikkje lenger eit blad (splittar har skjedd).
    assert(rot["blad"] == usann)

    returner 0
}
