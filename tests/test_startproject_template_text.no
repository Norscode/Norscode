bruk std.tekst som t

funksjon start() -> heiltall {
    la variantar = ["base", "auth", "admin", "full"]
    la i = 0
    mens i < lengde(variantar) {
        la orm = fil_les("tools/startproject_templates/" + variantar[i] + "/tests/test_stack_orm_query.no")
        assert(t.inneholder(orm, "INSERT INTO konto (namn) VALUES ('rulles_tilbake');"))
        assert(ikkje t.inneholder(orm, "INSERT INTO konto (namn) VALUES ('midlertidig');"))
        i = i + 1
    }
    la admin = fil_les("tools/startproject_templates/admin/tests/test_stack_admin.no")
    la full = fil_les("tools/startproject_templates/full/tests/test_stack_admin.no")
    assert(t.inneholder(admin, "scaffold_test_conn"))
    assert(t.inneholder(full, "scaffold_test_conn"))
    assert(ikkje t.inneholder(admin, "registrer_modellar(register, \"dummy\")"))
    assert(ikkje t.inneholder(full, "registrer_modellar(register, \"dummy\")"))

    skriv("test_startproject_template_text OK")
    returner 0
}
