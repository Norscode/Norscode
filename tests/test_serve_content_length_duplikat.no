# Request smuggling: to Content-Length-hovud (òg eit ikkje-numerisk) gir tvetydig ramming og må
# avvisast (-2) i staden for at første verdien vinn. Importerer selfhost.nc_main (tung lukking).
bruk selfhost.nc_main

funksjon start() -> heltall {
    la ein = "POST /x HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\nhallo"
    assert_eq(serve_request_content_length(ein), 5)
    la ingen = "GET /x HTTP/1.1\r\nHost: a\r\n\r\n"
    assert_eq(serve_request_content_length(ingen), 0)
    la dobbel = "POST /x HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 3\r\n\r\nhallo"
    assert_eq(serve_request_content_length(dobbel), -2)
    la lik = "POST /x HTTP/1.1\r\nContent-Length: 5\r\ncontent-length: 5\r\n\r\nhallo"
    assert_eq(serve_request_content_length(lik), -2)
    la rar = "POST /x HTTP/1.1\r\nContent-Length: abc\r\n\r\n"
    assert_eq(serve_request_content_length(rar), -2)
    skriv("test_serve_content_length_duplikat OK")
    returner 0
}
