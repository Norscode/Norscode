bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/maint/inject_vm_lex_c.no")
    assert(t.inneholder(src, "norscode-vm-builtin-lex-v1"))
    assert(t.inneholder(src, "lexer_m1.lex"))
    assert(t.inneholder(src, "selfhost.lexer.lexer_m1.lex"))
    assert(t.inneholder(src, "nc_fn_selfhost_vm_vm_map_har_nokkel"))
    assert(t.inneholder(src, "nc_fn_selfhost_vm_k__yr_funksjon"))
    assert(t.inneholder(src, "lex-inject krev separat base/utfil"))
    skriv("test_inject_vm_lex_c_contract OK")
    returner 0
}
