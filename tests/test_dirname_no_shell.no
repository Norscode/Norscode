bruk std.tekst som t

funksjon krev_norscode_dirname(sti: tekst) {
    la src = fil_les(sti)
    assert(t.inneholder(src, "bruk std.path som path"))
    assert(t.inneholder(src, "path.dirname("))
    assert(ikkje t.inneholder(src, "mkdir -p $(dirname"))
}

funksjon krev_lokal_dirname(sti: tekst) {
    la src = fil_les(sti)
    assert(t.inneholder(src, "funksjon dirname(sti: tekst) -> tekst"))
    assert(t.inneholder(src, "dirname(output)"))
    assert(ikkje t.inneholder(src, "bruk std.path som path"))
    assert(ikkje t.inneholder(src, "path.dirname("))
    assert(ikkje t.inneholder(src, "mkdir -p $(dirname"))
}

funksjon start() -> heiltall {
    la hybrid = fil_les("tools/build_hybrid_compiler_bundle_v9400.no")
    assert(t.inneholder(hybrid, "funksjon dirname(sti: tekst) -> tekst"))
    assert(t.inneholder(hybrid, "dirname(out_path)"))
    assert(ikkje t.inneholder(hybrid, "bruk std.path som path"))
    assert(ikkje t.inneholder(hybrid, "path.dirname("))
    la omgang6b = fil_les("tools/build_omgang6b_compiler_ncb.no")
    assert(t.inneholder(omgang6b, "funksjon dirname(sti: tekst) -> tekst"))
    assert(t.inneholder(omgang6b, "dirname(out)"))
    assert(ikkje t.inneholder(omgang6b, "bruk std.path som path"))
    assert(ikkje t.inneholder(omgang6b, "path.dirname("))
    krev_lokal_dirname("tools/docker-build-linux.no")
    la fetch = fil_les("tools/fetch_stage0_seed.no")
    assert(t.inneholder(fetch, "funksjon dirname(sti: tekst) -> tekst"))
    assert(t.inneholder(fetch, "dirname(dest)"))
    assert(ikkje t.inneholder(fetch, "bruk std.path som path"))
    assert(ikkje t.inneholder(fetch, "path.dirname("))
    la ncb_to_elf = fil_les("tools/ncb_to_elf.no")
    assert(t.inneholder(ncb_to_elf, "bruk std.filops som filops"))
    assert(t.inneholder(ncb_to_elf, "filops.katalog(out_abs)"))
    assert(t.inneholder(ncb_to_elf, "filops.lag_katalogar(out_dir)"))
    assert(ikkje t.inneholder(ncb_to_elf, "bruk std.path som path"))
    assert(ikkje t.inneholder(ncb_to_elf, "path.dirname("))

    la native = fil_les("tools/build_norscode_native.no")
    assert(ikkje t.inneholder(native, "mkdir -p $(dirname"))
    assert(ikkje t.inneholder(native, "path.dirname("))
    assert(ikkje t.inneholder(native, "bruk std.path som path"))

    skriv("test_dirname_no_shell OK")
    returner 0
}
