# R2 / F20: éin strukturrepresentasjon. Konstruktøren er ein kompilert
# funksjon «modul.Namn» som merkjer instansen med __struktur__ (modulkvalifisert)
# og __type__ (kort); mott.metode() blir CALL builtin.kall_metode med eksakt
# oppslag på "<__struktur__>.metode" — ingen fuzzy siste-segment-fallback.
# Manglande metode / ingenting-mottakar gjev fangbar MetodeFeil, og merka
# lekk ikkje i nøkler/lengde/for/json. Køyrer gjennom KJELDE-kompilator + VM;
# modulane blir kompilerte kvar for seg og slegne saman som bundlaren gjer.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon ncb_av(sti: tekst, modul: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(fil_les(sti), modul))
}

funksjon slå_saman(ncb, m) -> heiltall {
    la fk = nøkler(m["functions"])
    la i = 0
    mens i < lengde(fk) {
        ncb["functions"][fk[i]] = m["functions"][fk[i]]
        i = i + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la ncb = ncb_av("tests/fixtures/r2_struktur.no", "__main__")
    slå_saman(ncb, ncb_av("tests/fixtures/r2_konto_a.no", "tests.fixtures.r2_konto_a"))
    slå_saman(ncb, ncb_av("tests/fixtures/r2_konto_b.no", "tests.fixtures.r2_konto_b"))
    la r = tekst(vm.køyr_ncb(ncb))
    assert_eq(r, "total=19;rektangel=10;flytt=11/11;kven=AB;nøkler=[x,y] lengde=2;for=2;json={\"x\":11,\"y\":2};tom=[x,y];ordbok=2;op=5;MetodeFeil: Bil har ingen metode areal();MetodeFeil: Punkt har ingen metode dobbel();MetodeFeil: kan ikkje kalle metoden areal() på ingenting;MetodeFeil: heiltall har ingen metode areal();fang=m1")
    returner 0
}
