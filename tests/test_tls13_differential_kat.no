# Differensial-KAT: reproduserer HEILE RFC 8448-løyndomstreet (Simple 1-RTT) frå
# rå meldingsbytes + ECDHE-løyndom, og samanliknar kvart mellomsteg mot RFC-verdiane.
# Referansesida er dei autoritative RFC 8448-vektorane (same eigenskap som differensial-
# testing mot OpenSSL sjekkar: identisk transkript og identiske avleidingar). Live
# OpenSSL-interop krev OpenSSL-adapteren/host og er eit eksplisitt oppfølgingspunkt.
bruk std.tls13_keyschedule som ks
bruk std.tls13_record som rec
funksjon _hx(v: heiltall) -> tekst { la c = "0123456789abcdef" returner builtin.slice(c,(v>>4)&15,((v>>4)&15)+1) + builtin.slice(c,v&15,(v&15)+1) }
funksjon _hex(b: liste_heiltall) -> tekst { la ut = "" la i = 0 mens i < lengde(b) { ut = ut + _hx(b[i]) i = i + 1 } returner ut }
funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _b(h: tekst) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(ut, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner ut
}
funksjon _saman(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(a) { legg_til(ut, a[i]) i = i + 1 }
    i = 0
    mens i < lengde(b) { legg_til(ut, b[i]) i = i + 1 }
    returner ut
}
funksjon start() -> heiltall {
    # RFC 8448 ClientHello (196) og ServerHello (90) - rå handshake-meldingar.
    la CH = _b("")
    la SH = _b("020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304")

    # Transkript-hash H(CH || SH) rekna av vår SHA-256 => må matche RFC 8448.
    la th_hs = ks.transcript_hash(_saman(CH, SH))
    assert_eq(_hex(th_hs), "860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")

    # ECDHE delt løyndom (IKM til handshake-extract) frå RFC 8448.
    la shared = _b("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")

    # --- Løyndomstre (RFC 8446 §7), samanlikna steg for steg mot RFC 8448 ---
    la early = ks.early_secret([])
    assert_eq(_hex(early), "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a")
    la derived1 = ks.derive_secret(early, "derived", ks.transcript_hash([]))
    assert_eq(_hex(derived1), "6f2615a108c702c5678f54fc9dbab69716c076189c48250cebeac3576c3611ba")
    la hs = ks.handshake_secret(derived1, shared)
    assert_eq(_hex(hs), "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac")
    la c_hs = ks.derive_secret(hs, "c hs traffic", th_hs)
    assert_eq(_hex(c_hs), "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21")
    la s_hs = ks.derive_secret(hs, "s hs traffic", th_hs)
    assert_eq(_hex(s_hs), "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38")
    la derived2 = ks.derive_secret(hs, "derived", ks.transcript_hash([]))
    assert_eq(_hex(derived2), "43de77e0c77713859a944db9db2590b53190a65b3ee2e4f12dd7a0bb7ce254b4")
    la master = ks.master_secret(derived2)
    assert_eq(_hex(master), "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919")

    # Trafikk-nøkkel/IV frå s_hs => IV må matche RFC (suite-uavhengig).
    la tk = rec.traffic_keys(s_hs)
    assert_eq(_hex(tk["iv"]), "5d313eb2671276ee13000b30")

    # Applikasjonstrafikk: bruk RFC sin transkript-hash H(CH..ServerFinished) som inngang
    # og verifiser at derive_secret gjev nett RFC-verdiane for c/s ap traffic.
    la th_ap = _b("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
    la c_ap = ks.derive_secret(master, "c ap traffic", th_ap)
    assert_eq(_hex(c_ap), "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5")
    la s_ap = ks.derive_secret(master, "s ap traffic", th_ap)
    assert_eq(_hex(s_ap), "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643")

    skriv("test_tls13_differential_kat OK")
    returner 0
}
