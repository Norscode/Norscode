// Windows PE skal bruke den eksisterande, kjeldeferske x86-generatoren.
// Valet må halde fram med å avvise stale kjelder og feil kryssprovenance.
bruk selfhost.native_execution.codegen_prebuilt som cgp
bruk std.filops som filops

funksjon start() -> heiltall {
    la linux = cgp.binær_stiar("windows-x86_64", "linux-x86_64")
    assert_eq(linux[1], "bootstrap/native_codegen_x86_64.elf")
    la mac = cgp.binær_stiar("windows-x86_64", "macos-arm64")
    assert_eq(mac[1], "bootstrap/native_codegen_linux-x86_64_on_macos-arm64.macho")
    assert(cgp.er_vert_codegen("windows-x86_64", "linux-x86_64"))
    assert(ikkje cgp.er_vert_codegen("windows-x86_64", "macos-arm64"))
    assert(ikkje cgp.tolka_tillaten("windows-x86_64"))
    la root = tekst(builtin.system_info()["cwd"])
    la val = cgp.vel(root, "windows-x86_64", "linux-x86_64")
    assert_eq(tekst(val["status"]), "ok")
    assert_eq(tekst(val["rel"]), "bootstrap/native_codegen_x86_64.elf")

    la tmp = root + "/build/windows-codegen-selection-" + builtin.random_hex(8)
    assert(filops.lag_katalogar(tmp + "/bootstrap"))
    // Eit målspesifikt namn er ingen grunn til å hoppe over kryssprovenance.
    fil_skriv(tmp + "/" + linux[0], "unverified cross generator")
    fil_skriv(tmp + "/bootstrap/native_codegen_x86_64.elf", "host generator")
    assert_eq(tekst(cgp.vel(tmp, "windows-x86_64", "linux-x86_64")["status"]), "stale")
    assert(filops.slett_tre(tmp))
    skriv("test_windows_codegen_selection OK\n")
    returner 0
}
