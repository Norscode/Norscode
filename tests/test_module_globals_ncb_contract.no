funksjon krav(ok: boolsk, namn: tekst) -> heiltall {
    hvis ikkje ok { kast "manglar modulglobal kontrakt: " + namn }
    returner 0
}

funksjon start() -> heiltall {
    la compiler = fil_les("selfhost/compiler/ir_to_bytecode.no")
    la vm = fil_les("selfhost/vm.no")
    la generator = fil_les("archive/legacy_c_backend/ncb_to_c.no")
    la runtime = fil_les("archive/legacy_c_backend/nc_runtime_mini.c")
    la native_main = fil_les("archive/legacy_c_backend/nc_native_main.c")
    la bundler = fil_les("selfhost/bundler.no")
    la nc_main = fil_les("selfhost/nc_main.no")

    krav(builtin.contains(compiler, "module_initializers"), "compiler module_initializers")
    krav(builtin.contains(compiler, "global_names"), "compiler global_names")
    krav(builtin.contains(compiler, "STORE_GLOBAL"), "compiler STORE_GLOBAL")
    krav(builtin.contains(compiler, "LOAD_GLOBAL"), "compiler LOAD_GLOBAL")
    krav(builtin.contains(compiler, "førre_lokale"), "lambda local scope")
    krav(builtin.contains(compiler, "decoded-v1"), "compiler string encoding")
    krav(builtin.contains(vm, "vm_initialiser_modular"), "VM initializer")
    krav(builtin.contains(vm, "__vm_globals__"), "VM globals")
    krav(builtin.contains(generator, "nc_global_store"), "generator store")
    krav(builtin.contains(generator, "nc_global_load"), "generator load")
    krav(builtin.contains(generator, "NC_NCB_PARSER_DECODED"), "generator parser encoding mode")
    krav(builtin.contains(generator, "nc_run_generated_module_initializers"), "generator initializer hook")
    krav(builtin.contains(native_main, "NC_HAS_GENERATED_MODULE_INITIALIZERS"), "native main initializer hook")
    krav(builtin.contains(runtime, "NC_MAX_MODULE_GLOBALS"), "runtime table")
    krav(builtin.contains(runtime, "nc_gc_mark_value(g_module_global_values[i])"), "runtime GC root")
    krav(builtin.contains(bundler, "slå_saman_modulmetadata"), "bundler metadata")
    krav(builtin.contains(bundler, "init[ii] = modul_namn + \".__module_init__\""), "bundler initializer rename")
    krav(builtin.contains(bundler, "hvis ikkje finst { legg_til(alle_initializers, init[i]) }"), "bundler initializer dedupe")
    krav(builtin.contains(nc_main, "bundler.slå_saman_modulmetadata(alle_initializers, alle_global_names, mod_ncb)"), "run bundle import metadata")
    krav(builtin.contains(nc_main, "bundle[\"module_initializers\"] = alle_initializers"), "run bundle initializer output")
    skriv("module globals NCB contract OK")
    returner 0
}
