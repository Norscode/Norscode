bruk std.runtime_filesystem som fs
bruk std.filops som filops
bruk std.zip som zip
bruk tools.release_tar_gzip_stream_v1 som tar_gzip

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_REQUIRE_BINARY_FILESYSTEM_LIVE") != "1" {
        skriv("test_release_tar_gzip_binary_stream: krev eksplisitt kandidatattestasjon")
        returner 0
    }
    la temp = fs.native_tempområde("build", "release-tar-gzip-stream-")
    assert(temp["status"] == "created")
    la rot = "build/" + temp["relative"]
    la src = rot + "/src"
    assert(fs.native_lag_mappe(".", src + "/sub")["status"] == "ok")
    builtin.fil_skriv(src + "/hello.txt", "norscode stream")
    builtin.fil_skriv_binær(src + "/sub/data.bin",
        builtin.bytes_from_list([0, 255, 17, 64, 128, 10]))
    assert(tar_gzip.binærstraum_støtta(src + "/sub/data.bin"))
    la filer: liste_tekst = ["hello.txt", "sub/data.bin"]
    la modusar: ordbok_tekst = {"hello.txt": "493", "sub/data.bin": "420"}
    la arkiv_a = rot + "/a.tar.gz"
    la arkiv_b = rot + "/b.tar.gz"
    assert(tar_gzip.lag_tar_gzip(arkiv_a, src, filer, modusar))
    assert(tar_gzip.lag_tar_gzip(arkiv_b, src, filer, modusar))
    assert(builtin.fil_les_binær(arkiv_a) == builtin.fil_les_binær(arkiv_b))
    la ut = rot + "/ut"
    assert(zip.tar_pakk_ut(arkiv_a, ut))
    assert(builtin.fil_les(ut + "/hello.txt") == "norscode stream")
    assert(builtin.fil_les_binær(ut + "/sub/data.bin") ==
        builtin.bytes_from_list([0, 255, 17, 64, 128, 10]))
    la stat = fs.native_stat_sti(ut + "/hello.txt")
    assert(stat["status"] == "ok")
    assert((heltall_fra_tekst(tekst(stat["mode"])) & 511) == 493)
    assert(filops.slett_tre(rot))
    skriv("test_release_tar_gzip_binary_stream OK")
    returner 0
}
