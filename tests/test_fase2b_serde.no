# Fase 2 bølgje (b) / 2.6: auto-JSON + 422/500-mapping.
#
# RESEED-GATED: importerer selfhost.nc_main og kallar nc_serve_til_json /
# feil_frå_unntak direkte. Lokal kjøring treff GC-veggen på committa seed;
# testen VIL køyre grønt på ein fersk seed med bølgje-(b)-endringane. Logikken
# er lokalt stadfesta via eit frittståande utdrag (scratchpad/t26.no, grøn).

bruk selfhost.nc_main

funksjon sjekk(namn: tekst, a: tekst, b: tekst) {
    hvis a != b { kast "FEIL " + namn + ": '" + a + "' != '" + b + "'" }
}

funksjon start() -> heltall {
    # data-ordbok: interne __-nøklar vert filtrerte
    sjekk("dict", nc_serve_til_json({"navn": "Ada", "__intern__": "skjul", "n": 3}, 0), "{\"navn\":\"Ada\",\"n\":3}")
    # liste
    sjekk("liste", nc_serve_til_json([1, 2, 3], 0), "[1,2,3]")
    # __rå_json__-innpakking lagt inn uendra
    sjekk("raa", nc_serve_til_json({"__rå_json__": "{\"x\":1}"}, 0), "{\"x\":1}")
    # bytes → base64
    sjekk("bytes", nc_serve_til_json(builtin.bytes_from_list([65, 66, 67]), 0), "\"QUJD\"")
    # nøsting
    sjekk("nest", nc_serve_til_json({"a": [true, null]}, 0), "{\"a\":[true,null]}")

    # ValideringsFeil → 422 i Fase 0/1-format
    la f422 = feil_frå_unntak("ValideringsFeil: feltet manglar")
    sjekk("422-status", tekst(f422["status"]), "422")
    sjekk("422-body", tekst(f422["body"]), "{\"detail\":[{\"type\":\"value_error\",\"loc\":[\"body\"],\"msg\":\"feltet manglar\",\"input\":\"\"}]}")

    # http_feil-ordbok → status + {"detail": ...}
    la fh = feil_frå_unntak({"__httpfeil__": sann, "status": 418, "detalj": "te"})
    sjekk("http-status", tekst(fh["status"]), "418")
    sjekk("http-body", tekst(fh["body"]), "{\"detail\":\"te\"}")

    # generisk unntak → 500 utan å lekke meldinga (NC_SERVE_DEBUG ikkje sett)
    la f500 = feil_frå_unntak("hemmeleg intern feil")
    sjekk("500-status", tekst(f500["status"]), "500")
    sjekk("500-body", tekst(f500["body"]), "Intern feil")

    skriv("test_fase2b_serde OK\n")
    returner 0
}
