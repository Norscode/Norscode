// Punkt 5d: ORDER BY via indeks / rowid / topp-k skal gje nøyaktig same svar som
// full sortering, i SQL-orden (NULL < tal < tekst, tal-bevisst, også desimaltal og
// negative), med like nøklar i innsetjingsrekkjefølgje. Pluss INTEGER PRIMARY KEY:
// eksplisitt id → neste auto-id er størst+1, NULL gjev auto-id, fleire rader i éin
// INSERT, og oppslag på id (tal-bevisst).

bruk std.norsdb_sql som sql

funksjon start() -> heltall {
    la db = sql.opne("")
    sql.exec(db, "CREATE TABLE m (id INTEGER PRIMARY KEY, s INTEGER, r REAL, t TEXT)")
    // Fleire rader i éin INSERT.
    assert_eq(sql.exec(db, "INSERT INTO m (s, r, t) VALUES (3, 2.5, 'b'), (1, -0.5, 'a'), (2, 10.25, 'c')"), 3)
    sql.exec(db, "INSERT INTO m (s, r, t) VALUES (1, 2.25, NULL)")
    sql.exec(db, "INSERT INTO m (s, r, t) VALUES (-7, -3, '10')")
    sql.exec(db, "INSERT INTO m (s, r, t) VALUES (NULL, 2.5, '9')")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM m"), 6)

    // REAL sorterer numerisk (før: utvalssortering med heiltalsparsing).
    assert_eq(sql.query_rader(db, "SELECT r FROM m ORDER BY r"), "-3\n-0.5\n2.25\n2.5\n2.5\n10.25")
    // NULL fyrst; like nøklar (s=1: id 2 og 4) i innsetjingsorden — også ved DESC.
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s"), "6\n5\n2\n4\n3\n1")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s DESC"), "1\n3\n2\n4\n5\n6")
    // Blanda tal/tekst: NULL fyrst, så tal (numerisk: 9 < 10), så tekst.
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY t"), "4\n6\n5\n2\n1\n3")

    // Topp-k (LIMIT/OFFSET) == snitt av full sortering.
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s DESC LIMIT 3"), "1\n3\n2")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s LIMIT 2 OFFSET 2"), "2\n4")

    // Same svar med indeks (indeks-skann i orden, stopp etter LIMIT).
    sql.exec(db, "CREATE INDEX ix_s ON m (s)")
    sql.exec(db, "CREATE INDEX ix_r ON m (r)")
    assert_eq(sql.query_rader(db, "SELECT r FROM m ORDER BY r"), "-3\n-0.5\n2.25\n2.5\n2.5\n10.25")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s"), "6\n5\n2\n4\n3\n1")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s DESC"), "1\n3\n2\n4\n5\n6")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s DESC LIMIT 3"), "1\n3\n2")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s LIMIT 2 OFFSET 2"), "2\n4")
    assert_eq(sql.query_rader(db, "SELECT id FROM m WHERE t != 'x' ORDER BY s DESC LIMIT 2"), "1\n3")
    // Indeksen følgjer UPDATE/DELETE.
    sql.exec(db, "UPDATE m SET s = 100 WHERE id = 6")
    sql.exec(db, "DELETE FROM m WHERE id = 3")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY s DESC LIMIT 2"), "6\n1")
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM m WHERE s >= 1"), 4)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM m WHERE s < 2"), 3)
    assert_eq(sql.query_int(db, "SELECT COUNT(*) FROM m WHERE s BETWEEN -10 AND 1"), 3)

    // ORDER BY primærnøkkel (rowid-orden).
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY id DESC LIMIT 2"), "6\n5")
    assert_eq(sql.query_rader(db, "SELECT id FROM m ORDER BY id"), "1\n2\n4\n5\n6")

    // ── INTEGER PRIMARY KEY ──────────────────────────────────────────
    sql.exec(db, "CREATE TABLE p (id INTEGER PRIMARY KEY, v TEXT)")
    assert_eq(sql.exec(db, "INSERT INTO p (id, v) VALUES (2, 'to')"), 1)
    // Auto-id etter eksplisitt id 2 → 3 (før: 2 → UNIQUE-feil).
    assert_eq(sql.exec(db, "INSERT INTO p (v) VALUES ('tre')"), 1)
    assert_eq(sql.query_text(db, "SELECT id FROM p WHERE v = 'tre'"), "3")
    // NULL → auto-id.
    assert_eq(sql.exec(db, "INSERT INTO p (id, v) VALUES (NULL, 'fire')"), 1)
    assert_eq(sql.query_text(db, "SELECT id FROM p WHERE v = 'fire'"), "4")
    assert_eq(sql.exec(db, "INSERT INTO p (id, v) VALUES (100, 'hundre')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO p (v) VALUES ('etter')"), 1)
    assert_eq(sql.query_text(db, "SELECT id FROM p WHERE v = 'etter'"), "101")
    assert_eq(sql.exec(db, "INSERT INTO p (id, v) VALUES (3, 'dup')"), -1)
    // Oppslag på id er tal-bevisst.
    assert_eq(sql.query_text(db, "SELECT v FROM p WHERE id = 3"), "tre")
    assert_eq(sql.query_text(db, "SELECT v FROM p WHERE id = '3'"), "tre")
    assert_eq(sql.query_text(db, "SELECT v FROM p WHERE id = 3.0"), "tre")
    assert_eq(sql.query_text(db, "SELECT v FROM p WHERE id = 99"), "")
    // UPDATE av id: rada blir funnen på ny id, og gamal id er ledig.
    assert_eq(sql.exec(db, "UPDATE p SET id = 50 WHERE id = 4"), 1)
    assert_eq(sql.query_text(db, "SELECT v FROM p WHERE id = 50"), "fire")
    assert_eq(sql.query_text(db, "SELECT v FROM p WHERE id = 4"), "")
    assert_eq(sql.exec(db, "INSERT INTO p (id, v) VALUES (50, 'dup')"), -1)
    assert_eq(sql.exec(db, "INSERT INTO p (id, v) VALUES (4, 'ny fire')"), 1)
    assert_eq(sql.query_rader(db, "SELECT id FROM p ORDER BY id"), "2\n3\n4\n50\n100\n101")
    assert_eq(sql.query_text(db, "SELECT last_insert_rowid()"), "4")

    // UNIQUE tillèt fleire NULL (SQLite), men ikkje like verdiar.
    sql.exec(db, "CREATE TABLE u (k TEXT UNIQUE)")
    assert_eq(sql.exec(db, "INSERT INTO u (k) VALUES (NULL)"), 1)
    assert_eq(sql.exec(db, "INSERT INTO u (k) VALUES (NULL)"), 1)
    assert_eq(sql.exec(db, "INSERT INTO u (k) VALUES ('x')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO u (k) VALUES ('x')"), -1)
    assert_eq(sql.exec(db, "UPDATE u SET k = 'y' WHERE k = 'x'"), 1)
    assert_eq(sql.exec(db, "INSERT INTO u (k) VALUES ('x')"), 1)
    assert_eq(sql.exec(db, "INSERT INTO u (k) VALUES ('y')"), -1)
    returner 0
}
