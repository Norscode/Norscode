// Verifiser den faktiske paritetsporten på den eldre Linux-bootstrapen.
bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon stor_fil(sti: tekst, siste: tekst) {
    la blokk: tekst = "A"
    la i: heiltall = 0
    mens i < 24 { blokk = blokk + blokk i = i + 1 }
    fil_skriv(sti, blokk)
    builtin.fil_append(sti, builtin.slice(blokk, 0, 8388608))
    builtin.fil_append(sti, siste)
}

funksjon sjekk(root: tekst, a: tekst, b: tekst, kode: tekst, markør: tekst) {
    la svar = prosess.køyr(root + "/bootstrap/stage0/norscode-linux-x86_64", [], root, {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tools/verify_identical_files.no",
        "NORSCODE_COMPARE_FILE_A": a,
        "NORSCODE_COMPARE_FILE_B": b,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read",
        "NORSCODE_VM_TARGET_CAPABILITIES": "env.read,disk.read",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_VM_TARGET_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }, 120000)
    prosess.skriv_resultat(svar)
    assert_eq(tekst(svar["status"]), "ferdig")
    assert_eq(tekst(svar["exit_code"]), kode)
    assert(builtin.contains(tekst(svar["stdout"]), markør))
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la maskin = tekst(info["machine"])
    hvis tekst(info["system"]) != "Linux" eller (maskin != "x86_64" og maskin != "amd64") {
        skriv("test_verify_identical_files_large: hoppa over (Linux x86-64-bootstrap)\n")
        returner 0
    }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la dir = "/tmp/norscode_paritet_" + builtin.random_hex(8)
    assert(filops.lag_katalogar(dir))
    la a = dir + "/a.bin"
    la b = dir + "/b.bin"
    stor_fil(a, "A")
    assert(filops.kopier2(a, b))
    // Uavhengig SHA-256-fasit for 25 165 825 ASCII A-byte.
    sjekk(root, a, b, "0", "OK: filene er byte-identiske sha256=eea6bf9db762588fb676f68870c3ca8ae4c93a535504a537e08d669d0b39abaa")
    stor_fil(b, "B")
    assert_eq(filops.fil_storleik(a), filops.fil_storleik(b))
    sjekk(root, a, b, "1", "FEIL: filene er ikkje byte-identiske")
    sjekk(root, a, dir + "/manglar.bin", "1", "FEIL:")
    sjekk(root, a, "", "2", "FEIL: begge samanlikningsfiler må vere sette")
    assert(filops.slett_tre(dir))
    skriv("test_verify_identical_files_large OK\n")
    returner 0
}
