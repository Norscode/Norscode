bruk std.prosess som prosess
bruk std.tekst som t

funksjon sjekk(namn: tekst, ok: bool) {
    hvis ikkje ok {
        skriv("FEIL prosess: " + namn + "\n")
        assert(ok)
    }
}

funksjon start() -> heiltall {
    la policy = prosess.ny_policy("runtime")
    la plan = prosess.start_plan("/bin/echo hei")

    sjekk("deny by default", ikkje prosess.policy_tillater(policy, "/bin/echo hei"))
    assert_eq(prosess.tørrkøyr(policy, plan)["action"], "reject")

    sjekk("tillat echo", prosess.tillat(policy, "echo"))
    assert_eq(policy["allowlist"], "|echo|")
    sjekk("policy tillater echo", prosess.policy_tillater(policy, "/bin/echo hei"))
    sjekk("shell er separat avvist", ikkje prosess.policy_tillater(policy, "echo hei; rm fil"))
    sjekk("shell kan ikkje aktiverast", ikkje prosess.tillat_shell(policy))
    assert_eq(policy["allow_shell"], "av")
    sjekk("shell er alltid avvist", ikkje prosess.policy_tillater(policy, "echo hei; echo der"))
    sjekk("valider plan", prosess.valider_plan(policy, plan))

    prosess.med_timeout(plan, 5)
    prosess.med_maks_output(plan, 4096)
    assert_eq(plan["timeout_seconds"], "5")
    assert_eq(plan["max_output_bytes"], "4096")
    assert(prosess.valider_plan(policy, plan))
    la dry = prosess.tørrkøyr(policy, plan)
    assert_eq(dry["action"], "would_start")
    assert_eq(dry["timeout_seconds"], "5")
    assert_eq(dry["max_output_bytes"], "4096")

    la res = prosess.start_trygt(policy, plan)
    sjekk("dry-run er ok", prosess.er_ok(res))
    sjekk("dry-run stdout", t.inneholder(prosess.stdout(res), "dry-run"))
    assert_eq(prosess.vent(res), 0)

    # Tekstplanar skal avvise ugyldige og overstore tal alt i dry-run.
    la tekst_grenser = prosess.start_plan("/bin/echo hei")
    tekst_grenser["timeout_seconds"] = "ikkje-tal"
    assert(ikkje prosess.valider_plan(policy, tekst_grenser))
    assert_eq(prosess.tørrkøyr(policy, tekst_grenser)["action"], "reject")
    tekst_grenser["timeout_seconds"] = "030"
    assert(ikkje prosess.valider_plan(policy, tekst_grenser))
    tekst_grenser["timeout_seconds"] = "2147484"
    assert(ikkje prosess.valider_plan(policy, tekst_grenser))
    tekst_grenser["timeout_seconds"] = "30"
    tekst_grenser["max_output_bytes"] = "9999999999999999999"
    assert(ikkje prosess.valider_plan(policy, tekst_grenser))
    tekst_grenser["max_output_bytes"] = "2147483648"
    assert(ikkje prosess.valider_plan(policy, tekst_grenser))
    tekst_grenser["max_output_bytes"] = "1048576"
    assert(prosess.valider_plan(policy, tekst_grenser))
    assert_eq(prosess.tørrkøyr(policy, tekst_grenser)["action"], "would_start")

    la argv_policy = prosess.ny_policy("argv")
    assert(prosess.tillat(argv_policy, "printf"))
    la argv_plan = prosess.start_argv_plan("/usr/bin/printf", ["%s|%s", "hei; dette er eitt argument", "x y"])
    assert(prosess.valider_argv_plan(argv_policy, argv_plan))
    assert(prosess.er_ok(prosess.start_argv_trygt(argv_policy, argv_plan)))
    prosess.aktiver_køyring(argv_policy)
    la argv_backend = prosess.start_argv_trygt(argv_policy, argv_plan)
    assert(prosess.er_ok(argv_backend))
    sjekk("argv backend køyrer shell-fritt", prosess.stdout(argv_backend) == "hei; dette er eitt argument|x y")
    sjekk("argv backend har separat stderr", prosess.stderr(argv_backend) == "")

    # Ikkje slepp ugyldig miljø vidare til native async-prosessmotor.
    # Her må feilen returnerast før det blir oppretta ein barneprosess.
    la async_ugyldig = prosess.start_argv_plan("/usr/bin/printf", ["x"])
    prosess.med_miljø(async_ugyldig, {"UGYLDIG=NOKKEL": "verdi"})
    assert(ikkje prosess.valider_argv_plan(argv_policy, async_ugyldig))
    la avvist_async = prosess.start_argv_async_trygt(argv_policy, async_ugyldig)
    assert_eq(avvist_async["status"], "feil")
    assert_eq(avvist_async["error"], "argv-prosess avvist av policy")
    assert_eq(prosess.returkode(prosess.start_argv_trygt(argv_policy, async_ugyldig)), -1)
    # Verifiser også fail-closed på miljøverdiar med kontrollteikn.
    la miljø_nul = prosess.start_argv_plan("/usr/bin/printf", ["x"])
    prosess.med_miljø(miljø_nul, {"NC_TEST": "ok" + builtin.chr(10) + "BAD=1"})
    assert(ikkje prosess.valider_argv_plan(argv_policy, miljø_nul))
    assert_eq(prosess.start_argv_async_trygt(argv_policy, miljø_nul)["status"], "feil")
    la miljø_ok = prosess.start_argv_plan("/usr/bin/printf", ["x"])
    prosess.med_miljø(miljø_ok, {"NC_TEST": "ok"})
    assert(prosess.valider_argv_plan(argv_policy, miljø_ok))

    # Tidlegare kunne ein skrivefeil i sandboxnamn behalde default "none".
    # Det skal no avvisast baade ved planvalidering og sync/async start.
    la ugyldig_sandbox = prosess.start_argv_plan("/usr/bin/printf", ["x"])
    prosess.med_sandbox(ugyldig_sandbox, "no-netwrok", 268435456, 32, usann)
    assert_eq(ugyldig_sandbox["sandbox"], "no-netwrok")
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldig_sandbox))
    assert_eq(prosess.returkode(prosess.start_argv_trygt(argv_policy, ugyldig_sandbox)), -1)
    assert_eq(prosess.start_argv_async_trygt(argv_policy, ugyldig_sandbox)["status"], "feil")
    la gyldig_sandbox = prosess.start_argv_plan("/usr/bin/printf", ["x"])
    prosess.med_sandbox(gyldig_sandbox, "no-network", 268435456, 32, usann)
    assert(prosess.valider_argv_plan(argv_policy, gyldig_sandbox))

    # Store/ikkje-kanoniske tal skal avvisast før sekund->ms og
    # andre heiltallskonverteringar ved native prosessstart.
    la ugyldige_grenser = prosess.start_argv_plan("/usr/bin/printf", ["x"])
    ugyldige_grenser["timeout_seconds"] = "9999999999999999999"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["timeout_seconds"] = "2147484"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["timeout_seconds"] = "030"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["timeout_seconds"] = "30"
    ugyldige_grenser["max_output_bytes"] = "2147483648"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["max_output_bytes"] = "4096"
    ugyldige_grenser["max_memory_bytes"] = "8589934593"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["max_memory_bytes"] = "536870912"
    ugyldige_grenser["max_open_files"] = "4097"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["max_open_files"] = "64"
    ugyldige_grenser["cwd"] = "bad" + builtin.chr(10) + "path"
    assert(ikkje prosess.valider_argv_plan(argv_policy, ugyldige_grenser))
    ugyldige_grenser["cwd"] = ""
    assert(prosess.valider_argv_plan(argv_policy, ugyldige_grenser))

    # Eksakt allowlist vernar mot basename-kollisjon i til dømes /tmp.
    la strict_policy = prosess.ny_policy("strict-argv")
    assert(prosess.tillat(strict_policy, "printf"))
    la trusted = prosess.start_argv_plan("/usr/bin/printf", ["ok"])
    la untrusted = prosess.start_argv_plan("/tmp/printf", ["ok"])
    assert(prosess.valider_argv_plan(strict_policy, trusted))
    assert(prosess.valider_argv_plan(strict_policy, untrusted))
    assert(prosess.krev_eksakte_programstiar(strict_policy))
    # Kommandoar som bruker PATH skal ikkje omgå streng argv-allowlist.
    assert(ikkje prosess.policy_tillater(strict_policy, "/usr/bin/printf x"))
    assert(ikkje prosess.er_ok(prosess.start_trygt(strict_policy, prosess.start_plan("/usr/bin/printf x"))))
    assert(ikkje prosess.valider_argv_plan(strict_policy, trusted))
    assert(ikkje prosess.valider_argv_plan(strict_policy, untrusted))
    assert(ikkje prosess.tillat_programsti(strict_policy, "printf"))
    assert(ikkje prosess.tillat_programsti(strict_policy, "/tmp/../usr/bin/printf"))
    assert(ikkje prosess.tillat_programsti(strict_policy, "/tmp/|printf"))
    assert(prosess.tillat_programsti(strict_policy, "/usr/bin/printf"))
    assert(prosess.valider_argv_plan(strict_policy, trusted))
    assert(ikkje prosess.valider_argv_plan(strict_policy, untrusted))
    assert_eq(prosess.returkode(prosess.start_argv_trygt(strict_policy, untrusted)), -1)
    assert_eq(prosess.start_argv_async_trygt(strict_policy, untrusted)["status"], "feil")
    assert(prosess.er_ok(prosess.start_argv_trygt(strict_policy, trusted)))

    la shell_policy = prosess.ny_policy("shell-guard")
    assert(prosess.tillat(shell_policy, "echo"))
    prosess.aktiver_køyring(shell_policy)
    la argv_tekst = prosess.start_trygt(shell_policy, prosess.start_plan("/bin/echo hei"))
    assert(prosess.er_ok(argv_tekst))
    sjekk("kommandotekst blir strukturert argv", t.inneholder(prosess.stdout(argv_tekst), "hei"))

    la farleg = prosess.start_plan("rm -rf /")
    la avvist = prosess.start_trygt(policy, farleg)
    sjekk("avvis farleg kommando", ikkje prosess.er_ok(avvist))
    sjekk("avvis grunn", t.inneholder(prosess.stderr(avvist), "policy"))

    # Ingen ugyldig async wait/signal request skal naa native dispatch.
    assert_eq(prosess.native_async_vent({}, -1)["status"], "feil")
    assert_eq(prosess.native_async_vent({"handle": "h1"}, -1)["error"], "ugyldig async wait request")
    assert_eq(prosess.native_async_vent({"handle": "h1"}, 2147483648)["status"], "feil")
    assert_eq(prosess.native_async_signal({"handle": "h1"}, 0)["status"], "feil")
    assert_eq(prosess.native_async_signal({"handle": "h1"}, 16)["status"], "feil")
    assert_eq(prosess.native_async_signal({}, 15)["status"], "feil")

    la kill = prosess.drep_plan(123)
    assert_eq(kill["action"], "kill")
    assert_eq(kill["requires_policy"], "sann")

    la status = prosess.produksjonsstatus()
    assert_eq(status["status"], "delvis")
    sjekk("status sikkerheit", t.inneholder(status["sikkerheit"], "deny-by-default"))

    skriv("test_prosess OK")
    returner 0
}
