bruk tools.generate_build_embed_c som embed
bruk std.runtime_filesystem som runtime_fs
bruk std.filops som filops

funksjon start() -> heiltall {
    la temp = runtime_fs.native_tempområde("build", "embed-live-")
    assert(temp["status"] == "created")
    la base = "build/" + temp["relative"]
    la input = base + "/input.ncb"
    la output = base + "/output.c"
    builtin.fil_skriv_binær(input, builtin.bytes_from_list([0, 255, 16, 65]))
    assert(embed.ncb_embed_to_c(input, output, "fixture_size", "fixture_data"))
    la body = builtin.fil_les(output)
    assert(builtin.index_of(body, "const size_t fixture_size = 4;") >= 0)
    assert(builtin.index_of(body, "const uint8_t fixture_data[4]") >= 0)
    assert(builtin.index_of(body, "0x00, 0xff, 0x10, 0x41") >= 0)
    assert(builtin.index_of(body, "generate_build_embed_c.no") >= 0)
    assert(filops.slett_tre(base))
    skriv("test_generate_build_embed_c_native_live OK")
    returner 0
}
