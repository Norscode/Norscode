# Fase 0.2-regresjon: builtin.tekst_saman fanst ikkje som innebygd funksjon, so
# alle std-modular som kalla `tekst_saman(...)` krasja (SIGSEGV under `nc serve`,
# "Ukjent innebygd funksjon: builtin.tekst_saman" under `nc run`) så snart ein
# tekstsamanslåings-funksjon vart kalla. Fiksen byter kvart kallsted til
# builtin.join med identisk semantikk.
#
# Denne testen kallar representative, reine funksjonar i modular som tidlegare
# krasja. Mutasjonsprov: byt éin `builtin.join(` attende til `tekst_saman(` i
# ein av desse modulane og testen feiler med same krasj som før fiksen.

bruk std.rest som rest
bruk std.innstillingar som innstillingar
bruk std.oauth som oauth
bruk std.eksport som eksport

funksjon start() -> heiltall {
    # rest: valideringsfeil-body byggjer JSON med join
    la feil: ordbok_tekst = {}
    feil["namn"] = "påkravd"
    la r = rest.validerings_feil(feil)
    assert_eq(tekst(r["status"]), "422")
    assert_eq(tekst(r["body"]), "{\"feil\":\"Valideringsfeil\",\"detaljar\":{\"namn\":\"påkravd\"}}")

    # innstillingar: til_json byggjer objekt med join
    la s: ordbok_tekst = {}
    s["namn"] = "Ada"
    assert_eq(innstillingar.til_json(s), "{\"namn\":\"Ada\"}")

    # oauth: autoriser-URL byggjer query-streng med join (ingen nettverk, pkce av)
    la cfg: ordbok_tekst = {}
    cfg["auth_url"] = "https://id.example/authorize"
    cfg["client_id"] = "abc"
    cfg["redirect_uri"] = "https://app.example/cb"
    cfg["scopes"] = "openid"
    la url = oauth.autoriser_url(cfg, "xyz")
    assert(builtin.starts_with(url, "https://id.example/authorize?"))
    assert(builtin.contains(url, "state=xyz"))
    assert(builtin.contains(url, "client_id=abc"))

    # eksport: CSV byggjer linjer med join
    la rad: ordbok_tekst = {}
    rad["a"] = "1"
    rad["b"] = "2"
    la rader: liste<ordbok_tekst> = [rad]
    la kol: liste<tekst> = ["a", "b"]
    la csv = eksport.til_csv(rader, kol)
    assert(builtin.contains(csv, "a,b"))
    assert(builtin.contains(csv, "1,2"))

    skriv("fase0.2 join-krasj-regresjon OK")
    returner 0
}
