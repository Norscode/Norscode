# M2 — interne køyretidsfeil skal vere fangbare guest-unntak, ikkje avbrot.
#
# Før denne endringa kasta VM-en rett til verten ved divisjon med null, og den
# native indekseringa avbraut prosessen ved indeks utanfor lista. Ein indeksfeil
# i éin HTTP-request tok dermed ned heile serveren.

# NB: kalla MÅ vere kvalifiserte (vm.køyr_funksjon). Eit ukvalifisert
# `køyr_funksjon(...)` blir kompilert til `builtin.køyr_funksjon` og treffer
# VM-en som ligg i stage0-binæren — ikkje selfhost/vm.no-kjelda denne testen
# skal dekke.
bruk selfhost.vm som vm

funksjon køyr(code: liste) -> tekst {
    prøv {
        vm.køyr_funksjon("__main__.probe", [], {"__main__.probe": {"params": [], "code": code}}, 0)
    } fang (e) {
        returner "UHANDTERT:" + tekst(e)
    }
    returner "ingen feil"
}

# Bytekode som gjer <uttrykk> inne i prøv/fang og returnerer 1 ved fangst.
funksjon fang_rundt(kropp: liste) -> liste {
    la kode: liste = [["TRY_BEGIN", "__catch__"]]
    la i: heltall = 0
    mens i < lengde(kropp) {
        legg_til(kode, kropp[i])
        i = i + 1
    }
    legg_til(kode, ["TRY_END"])
    legg_til(kode, ["PUSH_CONST", 0])
    legg_til(kode, ["RETURN"])
    legg_til(kode, ["LABEL", "__catch__"])
    legg_til(kode, ["TRY_END"])
    legg_til(kode, ["PUSH_CONST", 1])
    legg_til(kode, ["RETURN"])
    returner kode
}

funksjon resultat_av(kropp: liste) -> heltall {
    returner vm.køyr_funksjon("__main__.probe", [],
        {"__main__.probe": {"params": [], "code": fang_rundt(kropp)}}, 0)
}

funksjon start() -> heiltall {
    # ── Divisjon med null ────────────────────────────────────────────────────
    la div_ufanga = køyr([["PUSH_CONST", 1], ["PUSH_CONST", 0], ["BINARY_DIV"], ["RETURN"]])
    assert(builtin.index_of(div_ufanga, "DivisjonMedNull") >= 0)
    # ... men den skal kunne fangast
    assert_eq(resultat_av([["PUSH_CONST", 1], ["PUSH_CONST", 0], ["BINARY_DIV"], ["POP"]]), 1)

    # ── Modulo med null ──────────────────────────────────────────────────────
    assert_eq(resultat_av([["PUSH_CONST", 1], ["PUSH_CONST", 0], ["BINARY_MOD"], ["POP"]]), 1)

    # ── Indeks utanfor lista ─────────────────────────────────────────────────
    la les_utanfor: liste = [["PUSH_CONST", 1], ["PUSH_CONST", 2], ["BUILD_LIST", 2],
                             ["PUSH_CONST", 9], ["INDEX_GET"], ["POP"]]
    assert_eq(resultat_av(les_utanfor), 1)

    la negativ: liste = [["PUSH_CONST", 1], ["BUILD_LIST", 1],
                         ["PUSH_CONST", 0 - 1], ["INDEX_GET"], ["POP"]]
    assert_eq(resultat_av(negativ), 1)

    la skriv_utanfor: liste = [["PUSH_CONST", 1], ["BUILD_LIST", 1],
                               ["PUSH_CONST", 5], ["PUSH_CONST", 7], ["INDEX_SET"], ["POP"]]
    assert_eq(resultat_av(skriv_utanfor), 1)

    # ── Gyldige operasjonar skal ikkje slå ut ────────────────────────────────
    assert_eq(resultat_av([["PUSH_CONST", 6], ["PUSH_CONST", 3], ["BINARY_DIV"], ["POP"]]), 0)
    assert_eq(resultat_av([["PUSH_CONST", 1], ["PUSH_CONST", 2], ["BUILD_LIST", 2],
                           ["PUSH_CONST", 1], ["INDEX_GET"], ["POP"]]), 0)

    # Feilmeldinga skal seie kva som gjekk gale
    la idx_ufanga = køyr([["PUSH_CONST", 1], ["BUILD_LIST", 1], ["PUSH_CONST", 9], ["INDEX_GET"], ["RETURN"]])
    assert(builtin.index_of(idx_ufanga, "IndeksFeil") >= 0)
    assert(builtin.index_of(idx_ufanga, "lengde 1") >= 0)

    # Uhandterte unntak skal bere kallstacken
    assert(builtin.index_of(idx_ufanga, "ved __main__.probe") >= 0)
    assert(builtin.index_of(div_ufanga, "ved __main__.probe") >= 0)

    skriv("test_vm_fangbare_feil OK\n")
    returner 0
}
