// Seed-bundle-modus må laste også implisitte native avhengigheiter frå manifestet.
bruk tools.gen0_omgang6b_fragments som gen0

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la base = root + "/build/seed_manifest_" + tekst_fra_heltall(builtin.tid_ms())
    builtin.mkdir_p(base)
    la bunt = base + "/compiler.ncb.json"
    assert(gen0.gen0_seed_bundle(root, bunt))
    la ncb = builtin.json_parse_raw(builtin.fil_les(bunt))
    la fns = ncb["functions"]
    la namn = nøkler(fns)
    for spec i gen0.modulspesifikasjonar() {
        la felt = builtin.split(spec, "|")
        la finst = usann
        for fn_namn i namn {
            hvis builtin.starts_with(fn_namn, felt[1] + ".") { finst = sann }
        }
        hvis ikkje finst { skriv("Seed-bunten manglar " + felt[1] + "\n") returner 1 }
    }
    // Wrapperen skal ikkje overskrive den verkelege driver-entryen med eit sjølvkall.
    la ekte_entry = usann
    for instr i fns["selfhost.elf_compile_driver.start"]["code"] {
        hvis instr[0] == "CALL" og instr[1] == "selfhost.elf_compile_driver.bundle_modus" { ekte_entry = sann }
    }
    assert(ekte_entry)
    skriv("test_selfhost_seed_bundle_manifest OK\n")
    returner 0
}
