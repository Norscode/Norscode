bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/install_vm_loader_fixtures.no")
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "filops.kopier2"))
    assert(t.inneholder(src, "vm_plugin_tampered.ncb.json"))
    assert(t.inneholder(src, "vm_trust.json"))
    assert(ikkje t.inneholder(src, "cp "))
    skriv("test_install_vm_loader_fixtures_contract OK\n")
    returner 0
}

