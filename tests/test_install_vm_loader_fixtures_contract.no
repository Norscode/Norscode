bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/install_vm_loader_fixtures.no")
    // Fiksturane blir genererte frå Norscode-kjelde med den aktive runtimen
    // (JSON-avvikling J1d), ikkje kopierte frå committa bytekode.
    assert(t.inneholder(src, "bruk std.filops som filops"))
    assert(t.inneholder(src, "bruk tools.process_runner som prosess"))
    assert(t.inneholder(src, "\"NORSCODE_CMD\": \"compile\""))
    assert(t.inneholder(src, "\"NORSCODE_NCB_BINARY\": \"0\""))
    assert(t.inneholder(src, "\"NORSCODE_RUN_CMD\": \"\""))
    assert(t.inneholder(src, "tests/fixtures/vm_loader/"))
    assert(t.inneholder(src, "vm_plugin_tampered.ncb.json"))
    assert(t.inneholder(src, "vm_trust.json"))
    assert(t.inneholder(src, "hash_tekst(fil_les("))
    assert(t.inneholder(src, "builtin.sha256(data)"))
    assert(t.inneholder(src, "funksjon sikre(root: tekst, native: tekst) -> heiltall"))
    assert(ikkje t.inneholder(src, "filops.kopier2(\"tests/fixtures/vm_loader/"))
    assert(ikkje t.inneholder(src, "cp "))

    // Kjeldene finst; committa plugin-bytekode og trust-store gjer ikkje.
    assert(fil_finnes("tests/fixtures/vm_loader/vm_plugin_v1.no"))
    assert(fil_finnes("tests/fixtures/vm_loader/vm_plugin_v2.no"))
    assert(fil_finnes("tests/fixtures/vm_loader/vm_plugin_disk.no"))
    assert(ikkje fil_finnes("tests/fixtures/vm_loader/vm_plugin_v1.ncb.json"))
    assert(ikkje fil_finnes("tests/fixtures/vm_loader/vm_plugin_v2.ncb.json"))
    assert(ikkje fil_finnes("tests/fixtures/vm_loader/vm_plugin_disk.ncb.json"))
    assert(ikkje fil_finnes("tests/fixtures/vm_loader/vm_plugin_tampered.ncb.json"))
    assert(ikkje fil_finnes("tests/fixtures/vm_loader/vm_trust.json"))

    // Testløparen brukar same generator før loader-testane.
    la runner = fil_les("tools/nc_test.no")
    assert(t.inneholder(runner, "bruk tools.install_vm_loader_fixtures som vm_loader_fixtures"))
    assert(t.inneholder(runner, "vm_loader_fixtures.sikre(root, absolutt_native(root, native))"))
    assert(ikkje t.inneholder(runner, "/tests/fixtures/vm_loader/\" + namn[i]"))
    skriv("test_install_vm_loader_fixtures_contract OK\n")
    returner 0
}
