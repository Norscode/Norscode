bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/selfcompile_stage0_elf.no")
    assert(t.inneholder(src, "bygg_source_only_gen2"))
    assert(t.inneholder(src, "NORSCODE_FRAGMENT_SOURCE_NATIVE"))
    assert(t.inneholder(src, "NORSCODE_OM6B_SOURCE_NCB"))
    assert(t.inneholder(src, "start_kjeldefragment(root: tekst, gen1_source_elf: tekst"))
    assert(t.inneholder(src, "kjeldefragment_miljø(root: tekst)"))
    assert(t.inneholder(src, "spesialiser_gen1_source_executor"))
    assert(t.inneholder(src, "bygg_gen1_source_executor"))
    assert(t.inneholder(src, "gen1_pipeline_binding"))
    assert(t.inneholder(src, "reparer_gen1_lexer_text_index"))
    assert(t.inneholder(src, "reparer_gen1_loop_pop"))
    assert(t.inneholder(src, "[\"CALL\", \"builtin.fjern_siste\", 1]"))
    assert(t.inneholder(src, "[\"DUP\"]"))
    assert(t.inneholder(src, "[\"CALL\", \"builtin.slice\", 3]"))
    la native_codegen = fil_les("selfhost/native_execution/native_codegen_v2.no")
    assert(t.inneholder(native_codegen, "ellers hvis op == \"DUP\""))
    assert(t.inneholder(native_codegen, "funksjon er_strukturkonstruktør"))
    assert(t.inneholder(native_codegen, "builtin.starts_with(fn_nm, \"builtin.\")"))
    assert(t.inneholder(native_codegen, "hvis er_strukturkonstruktør(fn_nm, nargs)"))
    assert(t.inneholder(native_codegen, "call_rel32(buf, RT_MAP_NEW(), code_va)"))
    assert(t.inneholder(native_codegen, "emit_int_order_compare_inline"))
    assert(t.inneholder(native_codegen, "builtin.ends_with(fn_nm, \".char_code\")"))
    assert(t.inneholder(native_codegen, "vtype == \"heltall\""))
    assert(t.inneholder(native_codegen, "emit_jz_bool_placeholder"))
    assert(t.inneholder(src, "tools/gen1_source_entry.no"))
    assert(t.inneholder(src, "entry_miljø[\"NORSCODE_CMD\"] = \"compile\""))
    assert(t.inneholder(src, "entry_miljø[\"NORSCODE_OUTPUT\"] = entry_ncb"))
    assert(t.inneholder(src, "entry_fns[entry_src]"))
    assert(t.inneholder(src, "instr[1] = bunden"))
    assert(t.inneholder(src, "entry_code[ci] = instr"))
    assert(t.inneholder(src, "entry_fn[\"code\"] = entry_code"))
    assert(t.inneholder(src, "bygg_source_only_gen2(root, source_executor_ncb"))
    la entry_src = fil_les("tools/gen1_source_entry.no")
    assert(t.inneholder(entry_src, "lexer.lex(kjelde)"))
    assert(t.inneholder(entry_src, "entry-parse-start"))
    assert(t.inneholder(entry_src, "parser.parse_program(tokens)"))
    assert(t.inneholder(entry_src, "entry-codegen-start"))
    assert(t.inneholder(entry_src, "codegen.kompiler_til_ncb_json(ast, modul_namn)"))
    assert(t.inneholder(entry_src, "fil_skriv(output_sti, ncb)"))
    assert(t.inneholder(src, "process_abi.async_spawn_request(gen1_source_elf"))
    assert(t.inneholder(src, "process_abi.async_spawn_request"))
    assert(t.inneholder(src, "process_abi.async_wait_request"))
    assert(t.inneholder(src, "3600000, 33554432"))
    assert(t.inneholder(src, "process_abi.async_operation(\"close\""))
    assert(t.inneholder(src, "Gen1-kjeldekompileringar køyrer deterministisk parallelt"))
    assert(t.inneholder(src, "process_abi.request(executable, argv, cwd, \"\", timeout_ms, 33554432)"))
    assert(t.inneholder(src, "req = process_abi.sett_sandbox(req, \"none\", 0, 1024, usann)"))
    assert(ikkje t.inneholder(src, "miljø[\"NORSCODE_CMD\"] = \"run-ncb-pure\""))
    assert(t.inneholder(src, "\"NORSCODE_GEN1_SOURCE_FILE\": root + \"/\" + source_rel"))
    assert(t.inneholder(src, "\"NORSCODE_GEN1_OUTPUT_FILE\": out_sti"))
    assert(t.inneholder(src, "\"NORSCODE_GEN1_MODULE\": module_name"))
    assert(t.inneholder(src, "miljø[\"NORSCODE_RUN_CACHE\"] = \"0\""))
    assert(t.inneholder(src, "miljø[\"NORSCODE_VM_FAST\"] = \"1\""))
    assert(t.inneholder(src, "\"NORSCODE_GEN1_PROGRESS_FILE\": progress_sti"))
    assert(t.inneholder(src, "hvis erstatta != 4"))
    assert(t.inneholder(src, "executor-"))
    assert(t.inneholder(src, "miljø[\"NORSCODE_VM_TARGET_CAPABILITIES\"] = \"env.read,disk.read,disk.write\""))
    assert(t.inneholder(src, "Siste compiler-safe-point"))
    assert(t.inneholder(src, "miljø[\"NORSCODE_BUNDLE_ARGS\"] = \"\""))
    assert(t.inneholder(src, "miljø[\"NORSCODE_OM6B_SOURCE_NCB\"] = \"\""))
    assert(t.inneholder(src, "miljø[\"PATH\"] = \"/nonexistent\""))
    assert(ikkje t.inneholder(src, "builtin.ncb_call_fn(\"selfhost.vm.vm_runtime_init\""))
    assert(t.inneholder(src, "req = process_abi.sett_environment(req, miljø)"))
    assert(ikkje t.inneholder(src, "builtin.miljo_sett(miljø_nøklar"))
    assert(ikkje t.inneholder(src, "bootstrap/precompiled_fragments_inner"))
    assert(t.inneholder(entry_src, "miljo_hent(\"NORSCODE_GEN1_SOURCE_FILE\")"))
    assert(ikkje t.inneholder(entry_src, "miljo_hent(\"NORSCODE_FILE\")"))
    assert(t.inneholder(entry_src, "miljo_hent(\"NORSCODE_GEN1_OUTPUT_FILE\")"))
    assert(t.inneholder(entry_src, "miljo_hent(\"NORSCODE_GEN1_MODULE\")"))
    assert(t.inneholder(entry_src, "miljo_hent(\"NORSCODE_GEN1_PROGRESS_FILE\")"))

    la fragment = fil_les("tools/regenerate_omgang6b_fragments_safe.no")
    assert(t.inneholder(fragment, "NORSCODE_FRAGMENT_NCB_DIR"))
    assert(t.inneholder(fragment, "trekk_ut_native_funksjonar"))

    // J2: fikspunktet har ingen committa fragment. Gen0 blir generert frå kjelde
    // med seeden, og porten er tre generasjonar: Gen2 == Gen3 (NCB og ELF).
    assert(ikkje fil_finnes("bootstrap/precompiled_fragments_inner/elf_compile_driver.functions.json"))
    assert(ikkje fil_finnes("bootstrap/precompiled_fragments_inner/lexer_m1.functions.json"))
    assert(ikkje t.inneholder(fragment, "root + \"/bootstrap/precompiled_fragments"))
    assert(t.inneholder(fragment, "NORSCODE_FRAGMENT_BUNDLE"))
    assert(t.inneholder(fragment, "la prefiks = modul_namn + \".\""))
    la gen0 = fil_les("tools/gen0_omgang6b_fragments.no")
    assert(t.inneholder(gen0, "tools/gen1_source_entry.no"))
    assert(t.inneholder(gen0, "tools/regenerate_omgang6b_fragments_safe.no"))
    assert(t.inneholder(gen0, "regen[\"NORSCODE_FRAGMENT_SOURCE_NATIVE\"] = \"1\""))
    assert(t.inneholder(gen0, "regen[\"NORSCODE_FRAGMENT_BUNDLE\"] = bunt"))
    assert(t.inneholder(gen0, "/build/6b/fragments_gen0"))
    assert(t.inneholder(gen0, "filops.slett_fil(inner_dir + \"/\" + namn)"))
    la bygg = fil_les("tools/build_omgang6b_compiler_ncb.no")
    assert(t.inneholder(bygg, "fragment_dir = root + \"/build/6b/fragments_gen0\""))
    assert(ikkje t.inneholder(bygg, "bootstrap/precompiled_fragments_inner"))
    assert(t.inneholder(src, "la gen0_dir = lag_gen0_fragment(root)"))
    assert(t.inneholder(src, "build_omgang6b_ncb_frå(root, gen1_ncb, gen0_dir)"))
    assert(t.inneholder(src, "bygg_gen1_source_executor(root, gen2_ncb,"))
    assert(t.inneholder(src, "la ncb_lik = filer_identiske(gen2_ncb, gen3_ncb)"))
    assert(t.inneholder(src, "la elf_lik = filer_identiske(gen2_elf, gen3_elf)"))
    assert(t.inneholder(src, "hvis ikkje ncb_lik eller ikkje elf_lik { returner 1 }"))
    assert(t.inneholder(src, "[MERK] Gen1 ELF != Gen2 ELF"))
    // Gen1-ELF-en blir berre køyrd i source-only-modus: drivaren sin bundle-args-veg
    // (hard sti til bootstrap/precompiled_fragments_inner) blir aldri nådd av porten.
    assert(t.inneholder(src, "\"NORSCODE_OM6B_SOURCE_NCB\": source_bundle"))
    assert(ikkje t.inneholder(src, "\"NORSCODE_BUNDLE_ARGS\": bundle"))
    assert(ikkje t.inneholder(src, "\"NORSCODE_OM6B_PRESET\""))
    // SHA-256 i staden for liste-== på store binærlister.
    assert(t.inneholder(src, "returner ha == sha256_for(b)"))
    la verify = fil_les("tools/verify_omgang6b.no")
    assert(t.inneholder(verify, "tools/gen0_omgang6b_fragments.no"))
    assert(t.inneholder(verify, "selfcompile_env[\"NORSCODE_OMGANG6B_FRAGMENT_DIR\"] = gen0_dir"))
    assert(t.inneholder(verify, "preset_rot + \"/bootstrap/precompiled_fragments_inner\""))
    skriv("test_selfcompile_source_only_contract OK")
    returner 0
}
