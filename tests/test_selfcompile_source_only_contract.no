bruk std.tekst som t

funksjon start() -> heiltall {
    la src = fil_les("tools/selfcompile_stage0_elf.no")
    assert(t.inneholder(src, "bygg_source_only_gen2"))
    assert(t.inneholder(src, "NORSCODE_FRAGMENT_SOURCE_NATIVE"))
    assert(t.inneholder(src, "NORSCODE_OM6B_SOURCE_NCB"))
    assert(t.inneholder(src, "bruk selfhost.vm som vm"))
    assert(t.inneholder(src, "vm.køyr_funksjon"))
    assert(t.inneholder(src, "selfhost.kompiler.kompiler_fil"))
    assert(t.inneholder(src, "vm.vm_runtime_init(gen1_fns, sann)"))
    assert(ikkje t.inneholder(src, "builtin.ncb_call_fn(\"selfhost.vm.vm_runtime_init\""))
    assert(t.inneholder(src, "req = process_abi.sett_environment(req, miljø)"))
    assert(ikkje t.inneholder(src, "bootstrap/precompiled_fragments_inner"))

    la fragment = fil_les("tools/regenerate_omgang6b_fragments_safe.no")
    assert(t.inneholder(fragment, "NORSCODE_FRAGMENT_NCB_DIR"))
    assert(t.inneholder(fragment, "trekk_ut_native_funksjonar"))
    skriv("test_selfcompile_source_only_contract OK")
    returner 0
}
