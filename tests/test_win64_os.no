bruk selfhost.native_execution.win64_os som os
bruk selfhost.native_execution.pe_emitter som pe
bruk selfhost.native_execution.win64_asm som asm

funksjon start() -> heiltall {
    la image = os.bygg_os_demo_pe("os ok\n")
    fil_skriv_binær("build/test-win64-os.exe", image)
    la info = pe.beskriv_pe(image)
    assert_eq(info["maskin"], 34404)
    assert_eq(lengde(info["seksjonar"]), 4)
    assert_eq(info["seksjonar"][2]["namn"], ".osdata")
    // OSTAB-seksjonen har OSTAB_LEN 8-byte slottar.
    assert_eq(info["seksjonar"][2]["vsize"], os.OSTAB_LEN() * 8)
    // Begge DLL-ane er importerte, og getrandom går via ADVAPI32.
    assert(finnes_nøkkel(info["importar"], "KERNEL32.dll!WriteFile"))
    assert(finnes_nøkkel(info["importar"], "KERNEL32.dll!ExitProcess"))
    assert(finnes_nøkkel(info["importar"], "ADVAPI32.dll!SystemFunction036"))
    // emit_os_call gjev nett 7 byte (call qword [abs32]) — same storleik som «mov eax,nr; syscall».
    la a = asm.ny()
    os.emit_os_call(a, os.NR_WRITE(), 4198400)
    assert_eq(lengde(asm.ferdig(a)), 7)
    skriv("test_win64_os OK")
    returner 0
}
