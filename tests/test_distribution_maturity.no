bruk std.tekst som t
bruk std.shutil som shutil

funksjon krev(sti: tekst) -> heiltall {
    hvis fil_finnes(sti) {
        returner 0
    }
    skriv("Manglar distribusjonsbevis: " + sti)
    returner 1
}

funksjon ingen_tools_sh() -> heiltall {
    // Ei aktiv shell-bru er berre tillaten når ho har ein same-namn Norscode-eigar.
    la filer = shutil.listdir("tools")
    la i: heiltall = 0
    mens i < lengde(filer) {
        la namn: tekst = filer[i]
        hvis t.slutter_med(namn, ".sh") {
            la eigar = "tools/" + builtin.slice(namn, 0, lengde(namn) - 3) + ".no"
            hvis ikkje builtin.fil_finnes(eigar) {
                skriv("Uønskt shell-wrapper utan Norscode-eigar i tools/: tools/" + namn)
                returner 1
            }
        }
        i = i + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la feil = 0

    // POSIX-webbootstrap er arkivert; aktiv installasjon er Norscode-eigd.
    assert(ikkje fil_finnes("tools/install"))
    feil = feil + krev("archive/legacy_shell/tools/install.sh")
    feil = feil + krev("tools/install.ps1")
    feil = feil + krev("tools/install-release.no")
    feil = feil + krev("tools/build_stage0_release_assets.no")
    feil = feil + krev("tools/hosting_runtime_gate_v3610.no")
    feil = feil + krev("tools/windows_runtime_attestation.no")
    feil = feil + krev("tools/acme_pebble_issuance_gate.no")
    feil = feil + krev("tools/acme_dns01_server.no")
    feil = feil + krev(".github/workflows/linux-app-release.yml")
    feil = feil + krev(".github/workflows/macos-app-release.yml")
    feil = feil + krev(".github/workflows/windows-app-release.yml")
    feil = feil + krev(".github/workflows/ci.yml")
    feil = feil + krev("docs/05-development/SELFHOST_RELEASE_CHECKLIST.md")
    feil = feil + krev("bootstrap/stage0/norscode-linux-x86_64")
    feil = feil + krev("bootstrap/stage0/norscode-macos-arm64")
    feil = feil + ingen_tools_sh()

    assert_eq(feil, 0)

    la windows_installer = fil_les("tools/install.ps1")
    assert(t.inneholder(windows_installer, "Norscode-first bridge: eigaren ligg i tools/install.no."))
    assert(t.inneholder(windows_installer, "PowerShell-delen er avgrensa Windows-bootstrap"))
    assert(t.inneholder(windows_installer, "nc build-windows-app-layout"))
    assert(t.inneholder(windows_installer, "Ingen Windows app-pakke tilgjengeleg i siste release."))
    assert(ikkje t.inneholder(windows_installer, "tools\\build-bootstrap-binary.sh"))
    assert(ikkje t.inneholder(windows_installer, "Windows native binary"))

    la linux = fil_les(".github/workflows/linux-app-release.yml")
    la macos = fil_les(".github/workflows/macos-app-release.yml")
    la windows = fil_les(".github/workflows/windows-app-release.yml")
    la ci = fil_les(".github/workflows/ci.yml")
    la windows_gate = fil_les("tools/windows_runtime_cross_compile_gate.no")
    la platform_gate = fil_les("tools/platform_readiness_v3600.no")
    la acme_ci = fil_les("tools/acme_pebble_ci.no")

    assert(t.inneholder(linux, "./bin/nc feature-check app.no"))
    assert(t.inneholder(linux, "./bin/nc verify-seed"))
    assert(t.inneholder(linux, ".sha256"))
    assert(t.inneholder(macos, "./bin/nc feature-check app.no"))
    assert(t.inneholder(macos, "./bin/nc verify-seed"))
    assert(t.inneholder(macos, "tools/hosting_runtime_gate_v3610.no"))
    assert(t.inneholder(macos, ".sha256"))
    assert(t.inneholder(windows, ".sha256"))
    assert(t.inneholder(windows, "norscode_native_windows_x86_64.exe"))
    assert(t.inneholder(windows, "tools/windows_runtime_cross_compile_gate.no"))
    assert(t.inneholder(windows, "tools/package-windows-app.no"))
    assert(t.inneholder(windows_gate, "build/v3009/native_candidate_gc.c"))
    assert(t.inneholder(windows_gate, "norscode_native_windows_x86_64.exe"))
    assert(t.inneholder(windows_gate, "finn_program(\"zig\")"))
    assert(t.inneholder(windows_gate, "env(\"PATH\")"))
    assert(t.inneholder(ci, "${{ runner.temp }},/tmp,/private/tmp"))
    assert(t.inneholder(windows, "norscode-windows-*.zip"))
    assert(t.inneholder(windows, "tools/windows_runtime_attestation.no"))
    assert(t.inneholder(windows, "actions/attest-build-provenance@v3"))
    assert(t.inneholder(ci, "NORSCODE_NATIVE_BIN: ${{ github.workspace }}/build/windows/norscode_native_windows_x86_64.exe"))
    assert(t.inneholder(ci, "TMPDIR: /tmp"))
    assert(t.inneholder(ci, "tools/windows_runtime_attestation.no"))
    assert(t.inneholder(ci, "actions/attest-build-provenance@v3"))
    assert(t.inneholder(ci, "all-platform-runtime-attestation:"))
    assert(t.inneholder(ci, "name: Samla signert plattformreadiness"))
    assert(t.inneholder(ci, "NORSCODE_REQUIRE_LINUX_ATTESTATION: \"1\""))
    assert(t.inneholder(platform_gate, "NORSCODE_WINDOWS_CANDIDATE"))
    assert(t.inneholder(ci, "run: ./bootstrap/stage0/norscode-linux-arm64"))
    assert(t.inneholder(ci, "tools/build_linux_arm64_tls_attestation_candidate.no"))
    assert(t.inneholder(ci, "NORSCODE_NATIVE_BIN: ${{ github.workspace }}/build/linux-arm64-attested/norscode-linux-arm64-tls"))
    assert(t.inneholder(platform_gate, "verifiser_github_attestasjon"))
    assert(t.inneholder(platform_gate, "/opt/homebrew/bin/gh"))
    assert(t.inneholder(platform_gate, "C:/Program Files/GitHub CLI/gh.exe"))
    assert(t.inneholder(platform_gate, "root = builtin.replace(root, \"\\\\\", \"/\")"))
    assert(t.inneholder(ci, "NORSCODE_WINDOWS_CANDIDATE: ${{ github.workspace }}/build/windows/norscode_native_windows_x86_64.exe"))
    assert(t.inneholder(ci, "tools/acme_pebble_issuance_gate.no"))
    assert(t.inneholder(ci, "tools/acme_pebble_ci.no"))
    assert(t.inneholder(acme_ci, "ghcr.io/letsencrypt/pebble@sha256:ddf230642b1a584f519f32e347de1b05a6e4c1f6c35c1863b33effeab5f78199"))
    assert(t.inneholder(acme_ci, "tools/acme_dns01_server.no"))
    assert(t.inneholder(acme_ci, "NORSCODE_RUN_CACHE=0"))
    assert(t.inneholder(acme_ci, "NODE_BIN=/nonexistent"))
    assert(t.inneholder(acme_ci, "mens forsøk < 360"))
    assert(t.inneholder(acme_ci, "NORSCODE_ACME_DNS_VALUE_FILE=/acme/value"))
    assert(t.inneholder(acme_ci, "-dnsserver"))

    skriv("test_distribution_maturity OK")
    returner 0
}
