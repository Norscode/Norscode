// Fase 1: BETWEEN, NOT LIKE, NOT IN, IS NULL / IS NOT NULL. Golden frå sqlite3 3.51.0.
// NOT IN/NOT LIKE testast på data UTAN null-rad (SQLite ekskluderer NULL frå NOT IN;
// streng-motoren kan ikkje skilje NULL frå ""). IS NULL testast etter at ein rad utan
// 'by' er sett inn. Divergens dokumentert i docs/NORSDB_KONFORMANS_GAP.md (G3).

bruk std.db som db

funksjon start() -> heltall {
    la h = db.open(":memory:")
    assert_eq(db.execute(h, "CREATE TABLE folk (id INTEGER, navn TEXT, alder INTEGER, by TEXT)"), 0)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (1, 'Ada', 37, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (2, 'Linus', 55, 'Oslo')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (3, 'Bjørn', 29, 'Bergen')"), 1)
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder, by) VALUES (4, 'Alan', 41, 'Oslo')"), 1)

    // ── BETWEEN (inklusiv) ───────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE alder BETWEEN 30 AND 45"), 2)  // Ada, Alan
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE alder BETWEEN 29 AND 55"), 4)  // alle
    // BETWEEN sin AND skal ikkje forvekslast med connector-AND
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE alder BETWEEN 30 AND 45 AND by = 'Oslo'"), 2)

    // ── NOT LIKE / NOT IN ────────────────────────────────────────────
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE navn NOT LIKE 'A%'"), 2)   // Linus, Bjørn
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by NOT IN ('Oslo')"), 1)    // Bjørn
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE alder NOT IN (37, 55)"), 2) // Bjørn, Alan

    // ── IS NULL / IS NOT NULL (etter innsetjing av rad utan 'by') ─────
    assert_eq(db.execute(h, "INSERT INTO folk (id, navn, alder) VALUES (5, 'Eve', 50)"), 1)
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by IS NULL"), 1)
    assert_eq(db.query_text(h, "SELECT navn FROM folk WHERE by IS NULL"), "Eve")
    assert_eq(db.query_int(h, "SELECT COUNT(*) FROM folk WHERE by IS NOT NULL"), 4)

    assert(db.close(h))
    returner 0
}
