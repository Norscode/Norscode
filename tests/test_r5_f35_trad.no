# R5 / F35: trådar med lambdakropp (closure-fangst), typa resultat, unntak gjennom
# join med stakkspor frå tråden, avbrot (tråd.avbryt() → AvbruttFeil ved sov, join,
# kanal-/lås-venting, vent) og re-entrant lås. Programmet ligg i
# tests/fixtures/r5_f35_trad.no og køyrer gjennom KJELDE-kompilator + VM
# (tests/helpers/r5_bunt.no slår saman std.samtid/std.kanal inn i NCB-en).

bruk selfhost.vm som vm
bruk tests.helpers.r5_bunt som bunt

funksjon rapport_kart(rå: tekst) {
    la kart = {}
    for linje i builtin.split(rå, "|") {
        la eq = builtin.index_of(linje, "=")
        kart[builtin.slice(linje, 0, eq)] = builtin.slice(linje, eq + 1, lengde(linje))
    }
    returner kart
}

funksjon krev(kart, nøkkel: tekst, venta: tekst) -> heiltall {
    hvis ikkje har_nokkel(kart, nøkkel) { kast "manglar rapportlinje " + nøkkel }
    assert_eq(kart[nøkkel], venta)
    returner 0
}

funksjon start() -> heiltall {
    la kjelde = fil_les("tests/fixtures/r5_f35_trad.no")
    la ncb = bunt.bygg_ncb(kjelde)
    la k = rapport_kart(tekst(vm.køyr_ncb(ncb)))

    # (a) closure-fangst: verdien ved oppretting, delt liste, tekst.
    krev(k, "a1_verdi_ved_oppretting", "42")
    krev(k, "a2_delt_liste", "1")
    krev(k, "a3_tekst", "hei verda")

    # (b) typa resultat og unntak gjennom join.
    krev(k, "b1_heiltall", "heltall")
    krev(k, "b2_liste", "3")
    krev(k, "b3_ordbok", "1to")
    krev(k, "b4_ingenting", "sann")
    krev(k, "b5_type", "VerdiFeil")
    krev(k, "b6_stakk_topp_er_trådramme", "djup")
    krev(k, "b7_stakk_har_ikkje_join_staden", "nei")
    krev(k, "b8_struktur_unntak", "42")
    krev(k, "b9_join_to_gonger", "55")

    # (c) avbrot.
    krev(k, "c1_ikkje_avbroten_enno", "usann")
    krev(k, "c2_fanga_avbrot", "avbroten")
    krev(k, "c3_raskt", "sann")
    krev(k, "c4_ufanga_gjennom_join", "AvbruttFeil")
    krev(k, "c5_kanal_avbrot", "kanal-avbroten")
    krev(k, "c6_kanal_brukbar_etterpå", "ei-melding")
    krev(k, "c7_poll_og_nullstilling", "sann,ja,usann")
    krev(k, "c8_avbrot_etter_ferdig", "1")

    # (d) re-entrant lås.
    krev(k, "d1_djupn", "3")
    krev(k, "d2_andre_tråd_blokkerer_framleis", "usann")
    krev(k, "d3_djupn_etter_to", "1")
    krev(k, "d4_ventar_får_låsen_etter_siste", "sann")
    krev(k, "d5_djupn_null", "0")
    krev(k, "d6_tråd_djupn", "210")
    krev(k, "d7_lås_avbrot", "lås-avbroten")
    krev(k, "d8_lås_fri_etterpå", "sann")
    skriv("test_r5_f35_trad OK\n")
    returner 0
}
