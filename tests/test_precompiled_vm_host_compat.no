bruk std.tekst som t
bruk tools.materialize_runtime_payloads som payloads

// Kontrollerer dei GENERERTE runtime-payloadane (J1c): bootstrap/precompiled/vm.ncb.json og
// selfhost/vm_executor.ncb.json er gitignorerte og blir laga av
// tools/materialize_runtime_payloads.no (CI: éin gong per køyring; testløparen genererer
// dei før denne testen når dei manglar). Manglar dei likevel, feilar testen med ei tydeleg
// melding — han blir aldri grøn utan å ha sjekka innhaldet.
funksjon les_payload(sti: tekst) -> tekst {
    hvis ikkje fil_finnes(sti) {
        skriv("FEIL: " + sti + " manglar. Generer han med: ./bin/nc run tools/materialize_runtime_payloads.no\n")
        assert(usann)
    }
    returner fil_les(sti)
}

// Modulglobalar i payloadane (f3vmac funn 2): C-æra-executoren (macOS-/Windows-stage0) har ikkje
// LOAD_GLOBAL («Stack underflow» når vm_executor-payloaden les ein modulglobal). Disiplinen gjeld
// heile lukkinga, ikkje berre vm.no: modular med globalar må stå her med namn. Tillatne:
//   vm-executor: selfhost.vm (vertsstyrt — globalane bur i vertens baka VM) og handtabellen i
//     std.runtime_filesystem_native (berre programvare-fallbacken; C-æra-verten serverer
//     opne_native med eigne native filhandtak, og pure-lana køyrer er_stream_fil på kvar test).
//     Windows- og POSIX-fallbackane ligg bak same ABI-grense. POSIX brukar
//     std.native_sys sine late plattformtabellar; ingen syscall/tabellfunksjon
//     skal kunne nåast frå executor-koden. Dei namngjevne globalane nedanfor
//     er berre tillatne når den faktiske NCB-en ikkje har kall/referansar inn i den
//     native lukkinga frå andre modular. Executor-host-testen forgiftar alle desse
//     funksjonane og køyrer både JSON og NCB-stream gjennom verts-executoren.
//   vm: berre vm.no (__main__) sjølv; at den varme vegen ikkje les dei (vm_green_på_i), er
//     køyretidsporten i tests/test_precompiled_vm_payload_run.no.
// Returnerer «modul.namn» for kvar global som ikkje er tillaten ("*" = alle i modulen).
funksjon modulglobal_brot(ncb, tillatne: ordbok_tekst) -> liste_tekst {
    la brot: liste_tekst = []
    hvis ikkje finnes_nøkkel(ncb, "global_names") { legg_til(brot, "(manglar global_names)")  returner brot }
    la g = ncb["global_names"]
    la modular = nøkler(g)
    la i: heiltall = 0
    mens i < lengde(modular) {
        la modul = tekst(modular[i])
        la namn = g[modul]
        la tillate = ""
        hvis finnes_nøkkel(tillatne, modul) { tillate = "," + tekst(tillatne[modul]) + "," }
        la j: heiltall = 0
        mens j < lengde(namn) {
            la n = tekst(namn[j])
            hvis tillate != ",*," og builtin.index_of(tillate, "," + n + ",") < 0 { legg_til(brot, modul + "." + n) }
            j = j + 1
        }
        i = i + 1
    }
    returner brot
}

funksjon executor_tillatne() -> ordbok_tekst {
    returner {"selfhost.vm": "*", "std.runtime_filesystem_native": "_fh_tabell,_fh_neste,_fs_event_backend",
        "std.windows_filesystem": "_filer,_operasjonar,_neste_fil,_neste_operasjon",
        "std.windows_abi": "_ids,_args,_last_error",
        "std.native_sys": "_ns_mal,_ns_nr,_ns_flagg,_ns_errno,_ns_layout,_ns_kompat"}
}

funksjon native_fallback(namn: tekst) -> boolsk {
    returner builtin.starts_with(namn, "std.runtime_filesystem_native.") eller
        builtin.starts_with(namn, "std.runtime_filesystem_posix.") eller
        builtin.starts_with(namn, "std.native_sys.") eller
        builtin.starts_with(namn, "std.windows_filesystem.") eller
        builtin.starts_with(namn, "std.windows_abi.")
}

// Kontroller heile funksjonstabellen, ikkje berre statiske CALL frå entry.
// Også ein funksjonsreferanse lasta som tekst skal avvisast utanfor fallbacken.
funksjon fallback_grense_brot(ncb) -> liste_tekst {
    la brot: liste_tekst = []
    hvis ikkje finnes_nøkkel(ncb, "functions") { legg_til(brot, "(manglar functions)") returner brot }
    la fns = ncb["functions"]
    for namn i nøkler(fns) {
        hvis ikkje native_fallback(tekst(namn)) {
            la fn = fns[namn]
            hvis finnes_nøkkel(fn, "__ncb_lazy_json__") { fn = builtin.json_parse_raw(fn["__ncb_lazy_json__"]) }
            hvis ikkje finnes_nøkkel(fn, "code") { legg_til(brot, tekst(namn) + ": manglar code") }
            ellers {
                for op i fn["code"] {
                    for operand i op {
                        hvis builtin.type(operand) == "tekst" og native_fallback(tekst(operand)) {
                            legg_til(brot, tekst(namn) + " -> " + tekst(operand))
                        }
                    }
                }
            }
        }
    }
    returner brot
}

funksjon start() -> heiltall {
    la vm_src = fil_les("selfhost/vm.no")
    la vm_ncb = les_payload("bootstrap/precompiled/vm.ncb.json")
    la ex_ncb = les_payload("selfhost/vm_executor.ncb.json")

    assert(t.inneholder(vm_src, "Fil-eksistens må treffast tidleg for precompiled VM under eldre host-VM."))
    assert(t.inneholder(vm_src, "hvis namn == \"builtin.fil_finnes\" eller namn == \"fil_finnes\" eller namn == \"builtin.sti_exists\""))
    assert(t.inneholder(vm_src, "returner _rt_fil_finnes(args[0])"))
    // INDEX_SET skal balansere operandstacken. Den tidlegare cachen mangla
    // POP og utløyste stack overflow i djup L5b.
    assert(t.inneholder(vm_ncb, "[\"INDEX_SET\"],[\"POP\"]"))
    assert(ikkje t.inneholder(vm_ncb, "[\"CALL\",\"builtin.finnes_nøkkel\",2]"))
    // Importert runtime brukar det stabile har_nokkel-aliaset; VM-dispatchen
    // over garanterer kompatibiliteten i staden for å forby legitime kall.
    assert(t.inneholder(vm_ncb, "[\"CALL\",\"builtin.har_nokkel\",2]"))
    // Same kontroll som generatoren: kvar INDEX_SET står i paret [INDEX_SET],[POP]
    // (den frosne macOS-C-æra-verten krev stakkbalansen), og payloaden er komplett JSON.
    assert_eq(payloads.payload_feil(vm_ncb), "")
    assert_eq(payloads.payload_feil(ex_ncb), "")
    assert(ikkje t.inneholder(ex_ncb, "[\"CALL\",\"builtin.finnes_nøkkel\",2]"))
    // Porten må kunne seie nei: ein avkorta payload og ein med INDEX_SET utan POP blir avviste.
    assert(payloads.payload_feil(builtin.slice(vm_ncb, 0, lengde(vm_ncb) - 2)) != "")
    assert(payloads.payload_feil(tekst_erstatt(vm_ncb, "[\"INDEX_SET\"],[\"POP\"]", "[\"INDEX_SET\"]")) != "")

    // Modulglobal-kontrakten på dei faktiske payloadane, og at han kan seie nei.
    la vm_brot = modulglobal_brot(builtin.json_parse_raw(vm_ncb), {"__main__": "*"})
    la executor = builtin.json_parse_raw(ex_ncb)
    la grense_brot = fallback_grense_brot(executor)
    hvis lengde(grense_brot) > 0 {
        skriv("FEIL: native fallback er tilgjengeleg for verts-executoren: " + builtin.join(grense_brot, ",") + "\n")
        assert(usann)
    }
    la ex_brot = modulglobal_brot(executor, executor_tillatne())
    hvis lengde(vm_brot) > 0 eller lengde(ex_brot) > 0 {
        skriv("FEIL: nye modulglobalar i payloadane (C-æra-executoren har ikkje LOAD_GLOBAL): vm=" +
              builtin.join(vm_brot, ",") + " vm-executor=" + builtin.join(ex_brot, ",") + "\n")
        assert(usann)
    }
    assert_eq(lengde(modulglobal_brot(builtin.json_parse_raw("{\"global_names\":{\"selfhost.ncb_bin\":[\"x\"]}}"), executor_tillatne())), 1)
    assert_eq(lengde(modulglobal_brot(builtin.json_parse_raw("{\"global_names\":{\"std.runtime_filesystem_native\":[\"_fh_tabell\",\"ny\"]}}"), executor_tillatne())), 1)
    assert_eq(lengde(modulglobal_brot(builtin.json_parse_raw("{\"global_names\":{\"selfhost.vm\":[\"a\"],\"selfhost.json\":[]}}"), executor_tillatne())), 0)
    assert_eq(lengde(modulglobal_brot(builtin.json_parse_raw("{}"), executor_tillatne())), 1)
    assert_eq(lengde(modulglobal_brot({"global_names": {"std.windows_abi": ["_ids", "ny"]}}, executor_tillatne())), 1)
    assert_eq(lengde(modulglobal_brot({"global_names": {"std.native_sys": ["_ns_mal", "ny"]}}, executor_tillatne())), 1)
    assert_eq(lengde(fallback_grense_brot({"functions": {"__main__.start": {"code": [["CALL", "std.windows_filesystem.read_operation", 1]]}}})), 1)
    assert_eq(lengde(fallback_grense_brot({"functions": {"__main__.start": {"code": [["PUSH_CONST", "std.windows_abi.call"]]}}})), 1)
    assert_eq(lengde(fallback_grense_brot({"functions": {"__main__.start": {"code": [["CALL", "std.runtime_filesystem_posix.opne", 3]]}}})), 1)
    assert_eq(lengde(fallback_grense_brot({"functions": {"selfhost.ncb_serde.les": {"code": [["PUSH_CONST", "std.native_sys._nr"]]}}})), 1)
    assert_eq(lengde(fallback_grense_brot({"functions": {"std.runtime_filesystem_native.read_operation": {"code": [["CALL", "std.windows_filesystem.read_operation", 1]]}}})), 0)
    assert_eq(lengde(fallback_grense_brot({"functions": {"std.runtime_filesystem_posix.opne": {"code": [["CALL", "std.native_sys._nr", 1]]}}})), 0)
    assert_eq(lengde(fallback_grense_brot({})), 1)

    skriv("test_precompiled_vm_host_compat OK")
    returner 0
}
