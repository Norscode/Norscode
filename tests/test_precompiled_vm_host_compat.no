bruk std.tekst som t
bruk tools.materialize_runtime_payloads som payloads

// Kontrollerer dei GENERERTE runtime-payloadane (J1c): bootstrap/precompiled/vm.ncb.json og
// selfhost/vm_executor.ncb.json er gitignorerte og blir laga av
// tools/materialize_runtime_payloads.no (CI: éin gong per køyring; testløparen genererer
// dei før denne testen når dei manglar). Manglar dei likevel, feilar testen med ei tydeleg
// melding — han blir aldri grøn utan å ha sjekka innhaldet.
funksjon les_payload(sti: tekst) -> tekst {
    hvis ikkje fil_finnes(sti) {
        skriv("FEIL: " + sti + " manglar. Generer han med: ./bin/nc run tools/materialize_runtime_payloads.no\n")
        assert(usann)
    }
    returner fil_les(sti)
}

funksjon start() -> heiltall {
    la vm_src = fil_les("selfhost/vm.no")
    la vm_ncb = les_payload("bootstrap/precompiled/vm.ncb.json")
    la ex_ncb = les_payload("selfhost/vm_executor.ncb.json")

    assert(t.inneholder(vm_src, "Fil-eksistens må treffast tidleg for precompiled VM under eldre host-VM."))
    assert(t.inneholder(vm_src, "hvis namn == \"builtin.fil_finnes\" eller namn == \"fil_finnes\" eller namn == \"builtin.sti_exists\""))
    assert(t.inneholder(vm_src, "returner _rt_fil_finnes(args[0])"))
    // INDEX_SET skal balansere operandstacken. Den tidlegare cachen mangla
    // POP og utløyste stack overflow i djup L5b.
    assert(t.inneholder(vm_ncb, "[\"INDEX_SET\"],[\"POP\"]"))
    assert(ikkje t.inneholder(vm_ncb, "[\"CALL\",\"builtin.finnes_nøkkel\",2]"))
    // Importert runtime brukar det stabile har_nokkel-aliaset; VM-dispatchen
    // over garanterer kompatibiliteten i staden for å forby legitime kall.
    assert(t.inneholder(vm_ncb, "[\"CALL\",\"builtin.har_nokkel\",2]"))
    // Same kontroll som generatoren: kvar INDEX_SET står i paret [INDEX_SET],[POP]
    // (den frosne macOS-C-æra-verten krev stakkbalansen), og payloaden er komplett JSON.
    assert_eq(payloads.payload_feil(vm_ncb), "")
    assert_eq(payloads.payload_feil(ex_ncb), "")
    assert(ikkje t.inneholder(ex_ncb, "[\"CALL\",\"builtin.finnes_nøkkel\",2]"))
    // Porten må kunne seie nei: ein avkorta payload og ein med INDEX_SET utan POP blir avviste.
    assert(payloads.payload_feil(builtin.slice(vm_ncb, 0, lengde(vm_ncb) - 2)) != "")
    assert(payloads.payload_feil(tekst_erstatt(vm_ncb, "[\"INDEX_SET\"],[\"POP\"]", "[\"INDEX_SET\"]")) != "")

    skriv("test_precompiled_vm_host_compat OK")
    returner 0
}
