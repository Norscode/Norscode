funksjon start() -> heiltall {
    la src = fil_les("tools/compile_with_hybrid_bundle_v9400.no")
    assert(builtin.contains(src, "NORSCODE_HYBRID_SOURCE_BUNDLE"))
    assert(builtin.contains(src, "NORSCODE_HYBRID_SOURCE_DIR"))
    assert(builtin.contains(src, "merge_source_dir_modul(merged, source_dir, import_mod)"))
    assert(builtin.contains(src, "source-part-count.txt"))
    assert(builtin.contains(src, "NORSCODE_HYBRID_ROOT_NCB_SHA256"))
    assert(builtin.contains(src, "NORSCODE_HYBRID_ROOT_SOURCE_SHA256"))
    assert(builtin.contains(src, "root-cache eller kjelde har feil SHA-256"))
    assert(builtin.contains(src, "root-NCB manglar eigarmodulen"))
    assert(builtin.contains(src, "fragment_har_modul(source_bundle, import_mod)"))
    assert(builtin.contains(src, "merge_fragment(merged, fragment, import_mod)"))
    assert(builtin.contains(src, "source-bundle manglar functions"))
    skriv("test_hybrid_source_bundle_contract OK")
    returner 0
}
