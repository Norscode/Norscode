# F44: linjedekning. Teljaren i VM-en er av som standard (ingen __vm_dekning__) og
# gjev då uendra køyring; køyr_ncb_dekning markerer nøyaktig dei linjene som vart
# køyrde, og rapportfunksjonane i tools/nc_coverage.no reknar prosent/manglande linjer.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm
bruk tools.nc_coverage som dekn

funksjon ncb_av(kjelde: tekst) {
    returner builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
}

funksjon j(l) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(l) {
        ut = ut + tekst_fra_heltall(l[i]) + ","
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la kjelde = "funksjon pluss(a: heltall, b: heltall) -> heltall {\n    returner a + b\n}\nfunksjon ubrukt() -> heltall {\n    returner 5\n}\nfunksjon start() -> heltall {\n    la x = pluss(1, 2)\n    hvis x > 5 {\n        returner 9\n    }\n    returner 0\n}\n"
    miljo_sett("NORSCODE_VM_FAST", "0")

    # Av som standard: ingen teljar, same resultat.
    la ncb0 = ncb_av(kjelde)
    assert_eq(vm.køyr_ncb(ncb0), 0)
    assert(ikkje finnes_nøkkel(ncb0["functions"], "__vm_dekning__"))

    # På: eksakt sett av køyrde linjer (stor-grena, linje 10, og ubrukt, linje 5, er ikkje køyrt).
    la ncb = ncb_av(kjelde)
    la res = vm.køyr_ncb_dekning(ncb)
    assert_eq(res["resultat"], 0)
    la d = dekn.samle(ncb["functions"], res["dekning"])
    la kjor = dekn.sorterte_tal(d["kjorbare"]["__main__"])
    la dekt = dekn.sorterte_tal(d["dekte"]["__main__"])
    assert_eq(j(kjor), "2,5,8,9,10,12,")
    assert_eq(j(dekt), "2,8,9,12,")

    la rader = dekn.rapport_rader(d, "x.no", ".", usann)
    assert_eq(lengde(rader), 1)
    assert_eq(rader[0]["dekte"], 4)
    assert_eq(rader[0]["kjorbare"], 6)
    assert_eq(rader[0]["prosent"], 67)
    assert_eq(rader[0]["manglar"], "5, 10")
    assert_eq(dekn.område_tekst([3, 4, 5, 9, 11, 12]), "3-5, 9, 11-12")

    # Samanslåing er union (to køyringar dekker kvar si grein).
    la a = {"kjorbare": {"m": {"1": "1", "2": "1"}}, "dekte": {"m": {"1": "1"}}}
    la b = {"kjorbare": {"m": {"1": "1", "2": "1"}}, "dekte": {"m": {"2": "1"}}}
    la u = dekn.slå_saman(a, b)
    assert_eq(j(dekn.sorterte_tal(u["dekte"]["m"])), "1,2,")
    returner 0
}
