# Kompilat utan filending (t.d. `nc build tests/test_x.no` → tests/test_x) skal aldri
# sporast i tests/ eller examples/. Alle sporte filer der har filending; katalogar blir
# re-inkluderte slik at git framleis vandrar dei. Blokka MÅ stå øvst: siste treff vinn,
# så dei globale reglane under (.DS_Store, *.log, *.c, tmp/, cache/ …) og dei meir
# spesifikke tests/-reglane skal framleis overstyre negasjonane her.
/tests/**/*
!/tests/**/
!/tests/**/*.*
/examples/**/*
!/examples/**/
!/examples/**/*.*

.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store
__MACOSX/

# IDE
.vscode/
.idea/

# Temp / Debug
tmp/
tmp_*
debug_*
*.tmp
*.bak
*.bak.*
*.old
*.diff
*.log

# Desktop / Local IDE
.claude/
desktop_ide/
dist_desktop_ide/
vscode-norscode/
!vscode-norscode/
!vscode-norscode/package.json
!vscode-norscode/language-configuration.json
!vscode-norscode/syntaxes/
!vscode-norscode/syntaxes/**
!vscode-norscode/file-icons/
!vscode-norscode/file-icons/**
!vscode-norscode/snippets/
!vscode-norscode/snippets/**
LOCAL_IDE.md
Norscode IDE.spec

# Build outputs / generated artifacts. Ingen committa bytekode under build/
# (JSON-avvikling J0): dei tidlegare !build/*.ncb-unntaka er fjerna.
build/*
dist/
release/
release-artifacts/
artifacts/
cache/
*.egg-info/
.norsklang/
.norcode/
*.o
*.out
*.so
*.dll
*.dylib
*.exe
*.wasm
*.ll
*.bc

# Generated compiler outputs
*.c

# Generated C test outputs
tests/*.c
tests/**/*.c
!tests/**/*.no

# Generated test artifacts
tests/*.ncb.json
tests/*.nast.json
tests/*.shast.json
tests/*.shast.ncb.json
test_route*.no
test_web_routes*.no
norscode_db_integration_test.db
norscode_fil_test.txt
norscode_lagring_test.json
norscode_pool_test.db
# Runtime-output frå examples/testar (skal aldri sporast)
/*.db
/*.db.cp
/norscode_fil_og_objekt*.txt
/norscode_file_object.txt

# NCB-cache (generert av selfhost-ncb-build-cache / run_chain --write-cache)
**/*.chain.ncb.json

# Generated docs / repro files
docs/*.tmp
repro.no
/reports/norscode-completion-v1.json
# CI downloads platform evidence into these ephemeral paths before the
# release gate checks the tracked source tree.  The evidence is verified by
# the gate and must not masquerade as a source change.
/reports/windows-runtime-attestation.json
/attestations/

# Optional local binaries
app
tests/test_assert
tests/test_assert_eq
tests/test_elif
tests/test_for
tests/test_if
tests/test_math
tests/test_selfhost
tests/test_text
tests/test_while
tests/test_dependency_import
# bootstrap/c/*.c — berre lokalt ved REGEN=1 (sjå bootstrap/c/README.md)
!bootstrap/kompiler.ncb.json
# Stage-0 binærer (seed) — kan committast per plattform
bootstrap/stage0/*
!bootstrap/stage0/README.md
!bootstrap/stage0/norscode-macos-arm64
!bootstrap/stage0/norscode-linux-x86_64
!bootstrap/stage0/norscode-linux-arm64
!bootstrap/stage0/norscode-windows-x86_64.exe
!bootstrap/stage0/SHA256SUMS
tools/c_minimal_vm/
tools/export_ncbb_as*.py

# Regenerert utdata (tools/regenerate_omgang6b_fragments_safe.no). Sidan J2 skal heller ikkje
# *_inner vere committa: Gen0 blir generert til build/6b/fragments_gen0.
bootstrap/precompiled_fragments/
bootstrap/precompiled_fragments_inner/
