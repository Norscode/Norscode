// scripts/dev-setup.no — utvikleroppsett for lokal Norscode checkout

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon bygg_bootstrap(root: tekst) -> bool {
    la resultat = prosess.køyr(root + "/bin/nc", ["build-bootstrap-binary"],
        root, {}, 600000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }

    hvis fil_finst(root + "/dist/norscode_native") {
        linje("dist/norscode_native er allereie materialisert.")
    } ellers {
        hvis ikkje bygg_bootstrap(root) { returner 1 }
    }

    linje("")
    linje("Norscode er klar.")
    linje("Kjør CLI med: ./bin/nc run app.no")
    linje("")
    linje("Tips:")
    linje("  ./bin/nc run app.no          # kjør en Norscode-fil")
    linje("  ./bin/nc build app.no ut.elf # bygg til native binary")
    linje("  ./bin/nc test                # kjør tester")
    linje("")
    linje("For å jobbe på kompilatoren selv: bruk native bootstrap-verktøyene i tools/")
    returner 0
}
