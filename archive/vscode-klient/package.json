{
  "name": "norscode",
  "displayName": "Norscode",
  "description": "Norscode language support (syntax, snippets, language server)",
  "publisher": "norscode",
  "version": "0.3.0",
  "icon": "file-icons/norscode.svg",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:norscode"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "norscode",
        "aliases": [
          "Norscode",
          "norscode"
        ],
        "extensions": [
          ".no"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "norscode",
        "scopeName": "source.norscode",
        "path": "./syntaxes/norscode.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "norscode-file-icons",
        "label": "Norscode File Icons",
        "path": "./file-icons/norscode-file-icons.json"
      }
    ],
    "snippets": [
      {
        "language": "norscode",
        "path": "./snippets/norscode.json"
      }
    ],
    "configurationDefaults": {
      "[norscode]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            {
              "scope": "variable.other.readwrite.norscode",
              "settings": {
                "foreground": "#9CDCFE"
              }
            },
            {
              "scope": [
                "storage.type.norscode",
                "support.type.norscode"
              ],
              "settings": {
                "foreground": "#4EC9B0",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "entity.name.type.norscode",
              "settings": {
                "foreground": "#4FC1FF",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "entity.name.function.norscode",
              "settings": {
                "foreground": "#DCDCAA"
              }
            },
            {
              "scope": "string.quoted.double.norscode",
              "settings": {
                "foreground": "#CE9178"
              }
            }
          ]
        }
      }
    },
    "commands": [
      {
        "command": "norscode.restartServer",
        "title": "Norscode: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Norscode",
      "properties": {
        "norscode.server.command": {
          "type": "string",
          "default": "nc",
          "description": "Køyrbar fil for Norscode CLI (t.d. ./bin/nc)."
        },
        "norscode.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Argument til tenaren. Før `nc lsp` rutar til straum.no kan ['run', 'selfhost/lsp/straum.no'] brukast."
        },
        "norscode.server.env": {
          "type": "object",
          "default": {},
          "description": "Ekstra miljøvariablar for tenaren."
        }
      }
    }
  },
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0"
  }
}
