        builtin_kart["builtin.bytes_new"] = "nc_builtin_bytes_new"
        builtin_kart["builtin.bytes_from_list"] = "nc_builtin_bytes_from_list"
        builtin_kart["builtin.bytes_to_list"] = "nc_builtin_bytes_to_list"
        builtin_kart["builtin.bytes_to_text"] = "nc_builtin_bytes_to_text"
        builtin_kart["builtin.bytes_slice_to_text"] = "nc_builtin_bytes_slice_to_text"
        builtin_kart["builtin.feil"] = "nc_builtin_feil"
        builtin_kart["builtin.json_parse"] = "nc_json_parse_from_ncval"
        builtin_kart["builtin.index_of"] = "nc_builtin_index_of"
        builtin_kart["builtin.contains_any"] = "nc_builtin_contains_any"
        builtin_kart["builtin.system_info"] = "nc_builtin_system_info"
        builtin_kart["builtin.system_operation"] = "nc_builtin_system_operation"
        builtin_kart["builtin.lower"] = "nc_builtin_lower"
        builtin_kart["builtin.upper"] = "nc_builtin_upper"
        builtin_kart["builtin.tekst_til_liten"] = "nc_builtin_lower"
        builtin_kart["builtin.tekst_til_store"] = "nc_builtin_upper"
        builtin_kart["builtin.type"] = "nc_builtin_type"
        builtin_kart["builtin.type_av"] = "nc_builtin_type"
        builtin_kart["builtin.fjern_nokkel"] = "nc_builtin_fjern_nokkel"
        builtin_kart["builtin.exit"] = "nc_builtin_exit"
        builtin_kart["builtin.n"] = "nc_builtin_n"
        builtin_kart["builtin.fil_append"] = "nc_builtin_fil_append"
        builtin_kart["builtin.atomic_operation"] = "nc_builtin_atomic_operation"
        builtin_kart["builtin.jit_operation"] = "nc_builtin_jit_operation"
        builtin_kart["builtin.process_spawn_argv"] = "nc_builtin_process_spawn_argv"
        builtin_kart["builtin.process_operation"] = "nc_builtin_process_operation"
        builtin_kart["builtin.argv_operation"] = "nc_builtin_argv_operation"
        builtin_kart["builtin.filesystem_read_operation"] = "nc_builtin_filesystem_read_operation"
        builtin_kart["builtin.filesystem_write_operation"] = "nc_builtin_filesystem_write_operation"
        builtin_kart["builtin.network_operation"] = "nc_builtin_network_operation"
        builtin_kart["builtin.thread_spawn"] = "nc_builtin_thread_spawn"
        builtin_kart["builtin.thread_join"] = "nc_builtin_thread_join"
        builtin_kart["builtin.thread_sync"] = "nc_builtin_thread_sync"
        builtin_kart["builtin.thread_current_id"] = "nc_builtin_thread_current_id"
        builtin_kart["builtin.mkdir_p"] = "nc_builtin_mkdir_p"
        builtin_kart["builtin.random_hex"] = "nc_builtin_random_hex"
        builtin_kart["builtin.sha256"] = "nc_builtin_sha256"
        builtin_kart["builtin.sha256_bytes"] = "nc_builtin_sha256_bytes"
        builtin_kart["builtin.pbkdf2_sha256"] = "nc_builtin_pbkdf2_sha256"
        builtin_kart["builtin.argon2id"] = "nc_builtin_argon2id"
        builtin_kart["builtin.acme_sign"] = "nc_builtin_acme_sign"
        builtin_kart["builtin.acme_verify"] = "nc_builtin_acme_verify"
        builtin_kart["builtin.dns_lookup"] = "nc_builtin_dns_lookup"
        builtin_kart["builtin.resolve_host"] = "nc_builtin_dns_lookup"
        builtin_kart["builtin.exec_prosess"] = "nc_builtin_exec_prosess"
        builtin_kart["builtin.tid_ms"] = "nc_builtin_tid_ms"
        builtin_kart["builtin.now_ms"] = "nc_builtin_tid_ms"
        builtin_kart["builtin.tid_no"] = "nc_builtin_tid_no"
        builtin_kart["builtin.tid"] = "nc_builtin_tid_no"
        builtin_kart["builtin.timestamp"] = "nc_builtin_tid_no"
        builtin_kart["builtin.unix_timestamp"] = "nc_builtin_tid_no"
        builtin_kart["builtin.now"] = "nc_builtin_now_iso"
        builtin_kart["builtin.now_iso"] = "nc_builtin_now_iso"
        // builtin.builtin.* (dobbel prefiks frå selfhost/vm.no delegering)
        builtin_kart["builtin.builtin.starts_with"] = "nc_builtin_starts_with"
        builtin_kart["builtin.builtin.ends_with"] = "nc_builtin_ends_with"
        builtin_kart["builtin.builtin.contains"] = "nc_builtin_contains"
        builtin_kart["builtin.builtin.system_info"] = "nc_builtin_system_info"
        builtin_kart["builtin.builtin.system_operation"] = "nc_builtin_system_operation"
        builtin_kart["builtin.builtin.split"] = "nc_builtin_split"
        builtin_kart["builtin.builtin.join"] = "nc_builtin_join"
        builtin_kart["builtin.builtin.trim"] = "nc_builtin_trim"
        builtin_kart["builtin.builtin.replace"] = "nc_builtin_replace"
        builtin_kart["builtin.builtin.slice"] = "nc_builtin_slice"
        builtin_kart["builtin.builtin.json_stringify"] = "nc_builtin_json_stringify"
        builtin_kart["builtin.builtin.index_of"] = "nc_builtin_index_of"
        builtin_kart["builtin.builtin.lower"] = "nc_builtin_lower"
        builtin_kart["builtin.builtin.upper"] = "nc_builtin_upper"
        builtin_kart["builtin.builtin.tekst_til_liten"] = "nc_builtin_lower"
        builtin_kart["builtin.builtin.tekst_til_store"] = "nc_builtin_upper"
        builtin_kart["builtin.builtin.type"] = "nc_builtin_type"
        builtin_kart["builtin.builtin.fjern_nokkel"] = "nc_builtin_fjern_nokkel"
        builtin_kart["builtin.builtin.exit"] = "nc_builtin_exit"
        builtin_kart["builtin.builtin.n"] = "nc_builtin_n"
        builtin_kart["builtin.builtin.fil_append"] = "nc_builtin_fil_append"
        builtin_kart["builtin.builtin.random_hex"] = "nc_builtin_random_hex"
        builtin_kart["builtin.builtin.sha256"] = "nc_builtin_sha256"
        builtin_kart["builtin.builtin.sha256_bytes"] = "nc_builtin_sha256_bytes"
        builtin_kart["builtin.builtin.exec_prosess"] = "nc_builtin_exec_prosess"
        builtin_kart["builtin.builtin.tid_ms"] = "nc_builtin_tid_ms"
        builtin_kart["builtin.builtin.now_ms"] = "nc_builtin_tid_ms"
        builtin_kart["builtin.builtin.tid_no"] = "nc_builtin_tid_no"
        builtin_kart["builtin.builtin.tid"] = "nc_builtin_tid_no"
        builtin_kart["builtin.builtin.timestamp"] = "nc_builtin_tid_no"
        builtin_kart["builtin.builtin.unix_timestamp"] = "nc_builtin_tid_no"
        builtin_kart["builtin.builtin.now"] = "nc_builtin_now_iso"
        builtin_kart["builtin.builtin.now_iso"] = "nc_builtin_now_iso"
        builtin_kart["builtin.builtin.fil_finnes"] = "nc_builtin_fil_finnes"
        builtin_kart["builtin.builtin.miljo_hent"] = "nc_builtin_miljo_hent"
        builtin_kart["builtin.builtin.miljo_finnes"] = "nc_builtin_miljo_finnes"
        builtin_kart["builtin.builtin.exec_prosess"] = "nc_builtin_exec_prosess"
        builtin_kart["builtin.builtin.desimaltall"] = "nc_builtin_desimaltall"
        builtin_kart["builtin.builtin.nøkkel_finnes"] = "nc_builtin_finnes_nokkel"
        builtin_kart["builtin.nøkkel_finnes"] = "nc_builtin_finnes_nokkel"
        builtin_kart["builtin.json_parse_raw"] = "nc_json_parse_from_ncval"
        builtin_kart["builtin.builtin.json_parse_raw"] = "nc_json_parse_from_ncval"
        builtin_kart["builtin.fil_skriv_binær"] = "nc_builtin_fil_skriv_binary"
        builtin_kart["builtin.builtin.fil_skriv_binær"] = "nc_builtin_fil_skriv_binary"
        builtin_kart["builtin.char_code"] = "nc_builtin_char_code"
        builtin_kart["builtin.builtin.char_code"] = "nc_builtin_char_code"
        builtin_kart["builtin.chr"] = "nc_builtin_chr"
        builtin_kart["builtin.builtin.chr"] = "nc_builtin_chr"
        builtin_kart["builtin.socket_new"] = "nc_builtin_socket_new"
        builtin_kart["builtin.socket_connect"] = "nc_builtin_socket_connect"
        builtin_kart["builtin.socket_bind"] = "nc_builtin_socket_bind"
        builtin_kart["builtin.socket_listen"] = "nc_builtin_socket_listen"
        builtin_kart["builtin.socket_accept"] = "nc_builtin_socket_accept"
        builtin_kart["builtin.socket_send"] = "nc_builtin_socket_send"
        builtin_kart["builtin.socket_send_bytes"] = "nc_builtin_socket_send_bytes"
        builtin_kart["builtin.socket_recv"] = "nc_builtin_socket_recv"
        builtin_kart["builtin.socket_recv_bytes"] = "nc_builtin_socket_recv_bytes"
        builtin_kart["builtin.socket_close"] = "nc_builtin_socket_close"
        builtin_kart["builtin.socket_settimeout"] = "nc_builtin_socket_settimeout"
        builtin_kart["builtin.builtin.socket_new"] = "nc_builtin_socket_new"
        builtin_kart["builtin.builtin.socket_connect"] = "nc_builtin_socket_connect"
        builtin_kart["builtin.builtin.socket_bind"] = "nc_builtin_socket_bind"
        builtin_kart["builtin.builtin.socket_listen"] = "nc_builtin_socket_listen"
        builtin_kart["builtin.builtin.socket_accept"] = "nc_builtin_socket_accept"
        builtin_kart["builtin.builtin.socket_send"] = "nc_builtin_socket_send"
        builtin_kart["builtin.builtin.socket_send_bytes"] = "nc_builtin_socket_send_bytes"
        builtin_kart["builtin.builtin.socket_recv"] = "nc_builtin_socket_recv"
        builtin_kart["builtin.builtin.socket_recv_bytes"] = "nc_builtin_socket_recv_bytes"
        builtin_kart["builtin.builtin.socket_close"] = "nc_builtin_socket_close"
        builtin_kart["builtin.builtin.socket_settimeout"] = "nc_builtin_socket_settimeout"
        }

        // Bruk ip i variabelnamn for å unngå kollisjonar
        la suf = ncb_safe_num_text(ip)

        // Sjekk om det er ein kjend builtin
        hvis finnes_nøkkel(builtin_kart, fn_namn) {
            la c_builtin = builtin_kart[fn_namn]
            la ut_kall: tekst = "  { "
            la ai: heltall = nargs_int - 1
            mens ai >= 0 {
                ut_kall = ut_kall + "NcVal *_a" + suf + "_" + ncb_safe_num_text(ai) + "=nc_pop(&sp,stack); "
                ai = ai - 1
            }
            ut_kall = ut_kall + "nc_push(&sp,stack," + c_builtin + "("
            la bi: heltall = 0
            mens bi < nargs_int {
                hvis bi > 0 { ut_kall = ut_kall + "," }
                ut_kall = ut_kall + "_a" + suf + "_" + ncb_safe_num_text(bi)
                bi = bi + 1
            }
            ut_kall = ut_kall + ")); }\n"
            returner ut_kall
        }

        // Struktur-konstruktørar (stor forbokstav) → tom ordbok
        la rein_namn: tekst = fn_namn
        hvis builtin.starts_with(fn_namn, "builtin.") {
            rein_namn = builtin.slice(fn_namn, 8, lengde(fn_namn))
        }
        la første_rein = builtin.slice(rein_namn, 0, 1)
        hvis første_rein >= "A" og første_rein <= "Z" {
            returner "  nc_push(&sp,stack,nc_map_new()); /* struct " + fn_namn + " */\n"
        }

        // Intern funksjon — løys fuzzy namn og bruk block-scope med ip-suffix
        la løyst = fn_namn
        hvis ikkje finnes_nøkkel(functions, fn_namn) {
            løyst = løys_funksjon(fn_namn, functions)
        }
        la c_fn = sanitiser_namn(løyst)
        la ut_kall2: tekst = "  { "
        la ai2: heltall = nargs_int - 1
        mens ai2 >= 0 {
            ut_kall2 = ut_kall2 + "NcVal *_c" + suf + "_" + ncb_safe_num_text(ai2) + "=nc_pop(&sp,stack); "
            ai2 = ai2 - 1
        }
        hvis nargs_int > 0 {
            ut_kall2 = ut_kall2 + "NcVal *_arr" + suf + "[]={"
            la bi2: heltall = 0
            mens bi2 < nargs_int {
                hvis bi2 > 0 { ut_kall2 = ut_kall2 + "," }
                ut_kall2 = ut_kall2 + "_c" + suf + "_" + ncb_safe_num_text(bi2)
                bi2 = bi2 + 1
            }
            ut_kall2 = ut_kall2 + "}; nc_push(&sp,stack," + c_fn + "(_arr" + suf + "," + nargs + ")); }\n"
        } ellers {
            ut_kall2 = ut_kall2 + "nc_push(&sp,stack," + c_fn + "(NULL,0)); }\n"
        }
        returner ut_kall2
    }

    hvis op == "THROW" {
        returner "  { NcVal *e=nc_pop(&sp,stack); nc_throw(nc_to_str_raw(e)); }\n"
    }

    // Ukjent — kommenter ut
    returner "  /* TODO: " + op + " */\n"
}

// Stream-variant: vanlege builtin-kall kan avleiast direkte frå namnet.
// Den tunge alias-tabellen i opcode_til_c vert berre brukt for særnamn.
funksjon opcode_til_c_stream(instr: liste<tekst>, functions: ordbok<tekst, tekst>,
                             ip: heiltall, builtin_kart: ordbok<tekst, tekst>,
                             legacy_escape: boolsk) -> tekst {
    hvis instr[0] != "CALL" { returner opcode_til_c(instr, functions, ip, builtin_kart, legacy_escape) }
    la fn_namn: tekst = instr[1]
    // Builtins har fleire C-signaturfamiliar og historiske alias. Den
    // eksplisitte hovudbana handterer begge korrekt; stream-snøggvegen er
    // berre trygg for vanlege interne Norscode-funksjonar.
    hvis builtin.starts_with(fn_namn, "builtin.") {
        returner opcode_til_c(instr, functions, ip, builtin_kart, legacy_escape)
    }
    hvis builtin.starts_with(fn_namn, "builtin.builtin.") { fn_namn = builtin.slice(fn_namn, 8, lengde(fn_namn)) }
    la nargs_int: heiltall = 0
    hvis lengde(instr) > 2 { nargs_int = instr[2] }
    la suf = ncb_safe_num_text(ip)
    la c_builtin: tekst = ""
    la direkte: boolsk = usann
    hvis builtin.starts_with(fn_namn, "builtin.") {
        la base = builtin.slice(fn_namn, 8, lengde(fn_namn))
        hvis base == "nøkler" eller base == "nøkkel_finnes" eller base == "finnes_nøkkel" {
            c_builtin = "nc_builtin_"
            hvis base == "nøkler" { c_builtin = "nc_builtin_nokler" }
            ellers { c_builtin = "nc_builtin_finnes_nokkel" }
            direkte = sann
        } ellers hvis ikkje builtin.contains(base, "ø") og ikkje builtin.contains(base, "å") og ikkje builtin.contains(base, "æ") {
            la san = sanitiser_namn(base)
            c_builtin = "nc_builtin_" + builtin.slice(san, 6, lengde(san))
            direkte = sann
            hvis base == "heiltall" eller base == "heiltall_fra_tekst" { c_builtin = "nc_builtin_heltall" }
            hvis base == "tekst_fra_heiltall" { c_builtin = "nc_builtin_tekst_fra_heiltall" }
            hvis base == "json_parse" eller base == "json_parse_raw" { c_builtin = "nc_json_parse_from_ncval" }
            hvis base == "tekst_til_liten" { c_builtin = "nc_builtin_lower" }
            hvis base == "tekst_til_store" { c_builtin = "nc_builtin_upper" }
            hvis base == "tid_no" eller base == "tid" eller base == "timestamp" eller base == "unix_timestamp" { c_builtin = "nc_builtin_tid_no" }
            // Desse runtimeinngangane brukar den generiske (NcVal **, int)-
            // signaturen. La den ordinære CALL-bana byggje argumentarrayen.
            hvis base == "ncb_call_fn" eller base == "ncb_route_handlers" eller
               base == "tensor_operation" {
                direkte = usann
            }
        }
    }
    hvis direkte {
        la ut: tekst = "  { "
        la ai: heiltall = nargs_int - 1
        mens ai >= 0 {
            ut = ut + "NcVal *_a" + suf + "_" + ncb_safe_num_text(ai) + "=nc_pop(&sp,stack); "
            ai = ai - 1
        }
        ut = ut + "nc_push(&sp,stack," + c_builtin + "("
        la bi: heiltall = 0
        mens bi < nargs_int {
            hvis bi > 0 { ut = ut + "," }
            ut = ut + "_a" + suf + "_" + ncb_safe_num_text(bi)
            bi = bi + 1
        }
        returner ut + ")); }\n"
    }
    hvis finnes_nøkkel(functions, fn_namn) {
        la ut2: tekst = "  { "
        la ai2: heiltall = nargs_int - 1
        mens ai2 >= 0 {
            ut2 = ut2 + "NcVal *_c" + suf + "_" + ncb_safe_num_text(ai2) + "=nc_pop(&sp,stack); "
            ai2 = ai2 - 1
        }
        hvis nargs_int > 0 {
            ut2 = ut2 + "NcVal *_arr" + suf + "[]={"
            la bi2: heiltall = 0
            mens bi2 < nargs_int {
                hvis bi2 > 0 { ut2 = ut2 + "," }
                ut2 = ut2 + "_c" + suf + "_" + ncb_safe_num_text(bi2)
                bi2 = bi2 + 1
            }
            returner ut2 + "}; nc_push(&sp,stack," + sanitiser_namn(fn_namn) + "(_arr" + suf + "," + ncb_safe_num_text(nargs_int) + ")); }\n"
        }
        returner ut2 + "nc_push(&sp,stack," + sanitiser_namn(fn_namn) + "(NULL,0)); }\n"
    }
    returner opcode_til_c(instr, functions, ip, builtin_kart, legacy_escape)
}

// ─── Generer C for éin funksjon ──────────────────────────────────────────────

funksjon generer_funksjon(fn_namn: tekst, fn_def: ordbok<tekst, tekst>,
                          functions: ordbok<tekst, tekst>, builtin_kart: ordbok<tekst, tekst>) -> tekst {
    la params = fn_def["params"]
    la kode = fn_def["code"]
    la c_namn = sanitiser_namn(fn_namn)
    // ncbj_les dekodar RFC 8259 nøyaktig éin gong for både gamle og nye
    // funksjonar. Eit ekstra legacy-pass ville øydeleggje backslash-literal.
    la legacy_escape = usann

    // Funksjonssignatur
    la ut: tekst = "static NcVal *" + c_namn + "(NcVal **args, int nargs) {\n"
    ut = ut + "  const char *_nc_module = \"" + fn_def["module"] + "\";\n"
    // Heap-allokerte stacks for å unngå stack overflow ved djup rekursjon
    ut = ut + "  NcVal **stack = calloc(512,sizeof(NcVal*)); int sp=0;\n"
    ut = ut + "  NcVal **vars = calloc(2048,sizeof(NcVal*)); char **varnames = calloc(2048,sizeof(char*)); int nvars=0;\n"
    ut = ut + "  NcGcFrame _gc_frame; nc_gc_frame_enter(&_gc_frame,stack,&sp,vars,&nvars);\n"
    ut = ut + "  jmp_buf *_try_saved=calloc(32,sizeof(jmp_buf)); NcGcFrame **_try_boundaries=calloc(32,sizeof(NcGcFrame*)); int _try_depth=0;\n"

    // Last inn parametrar
    la pi: heltall = 0
    mens pi < lengde(params) {
        la pnm: tekst = params[pi]
        ut = ut + "  nc_store(vars,varnames,&nvars,\"" + pnm + "\",nargs>" + ncb_safe_num_text(pi) + "?args[" + ncb_safe_num_text(pi) + "]:nc_nil());\n"
        pi = pi + 1
    }
    ut = ut + "\n"

    // Generer kode
    la ip: heltall = 0
    mens ip < lengde(kode) {
        la instr = kode[ip]
        ut = ut + opcode_til_c(instr, functions, ip, builtin_kart, legacy_escape)
        hvis instr[0] != "RETURN" og instr[0] != "LABEL" {
            ut = ut + "  nc_gc_safepoint();\n"
        }
        ip = ip + 1
    }

    ut = ut + "  { int _i; NcVal *_ret=nc_nil(); while(_try_depth>0){ _try_depth--; memcpy(&g_err_jmp,&_try_saved[_try_depth],sizeof(jmp_buf)); g_err_gc_boundary=_try_boundaries[_try_depth]; } nc_gc_frame_leave(&_gc_frame); for(_i=0;_i<nvars;_i++) free(varnames[_i]); free(_try_saved); free(_try_boundaries); free(varnames); free(vars); free(stack); return _ret; }\n}\n\n"
    returner ut
}

funksjon generer_funksjon_stream(output_sti: tekst, fn_namn: tekst,
                                 fn_def: ordbok<tekst, tekst>,
                                 functions: ordbok<tekst, tekst>,
                                 builtin_kart: ordbok<tekst, tekst>) -> bool {
    la params = fn_def["params"]
    la kode = fn_def["code"]
    la c_namn = sanitiser_namn(fn_namn)
    // Same eintydige parserkontrakt som ikkje-streamande materialisering.
    la legacy_escape = usann
    prøv {
        builtin.fil_append(output_sti, "static NcVal *" + c_namn + "(NcVal **args, int nargs) {\n  const char *_nc_module = \"" + fn_def["module"] + "\";\n")
        builtin.fil_append(output_sti, "  NcVal **stack = calloc(512,sizeof(NcVal*)); int sp=0;\n  NcVal **vars = calloc(2048,sizeof(NcVal*)); char **varnames = calloc(2048,sizeof(char*)); int nvars=0;\n  NcGcFrame _gc_frame; nc_gc_frame_enter(&_gc_frame,stack,&sp,vars,&nvars);\n  jmp_buf *_try_saved=calloc(32,sizeof(jmp_buf)); NcGcFrame **_try_boundaries=calloc(32,sizeof(NcGcFrame*)); int _try_depth=0;\n")
        la pi: heiltall = 0
        mens pi < lengde(params) {
            builtin.fil_append(output_sti, "  nc_store(vars,varnames,&nvars,\"" + params[pi] + "\",nargs>" + ncb_safe_num_text(pi) + "?args[" + ncb_safe_num_text(pi) + "]:nc_nil());\n")
            pi = pi + 1
        }
        builtin.fil_append(output_sti, "\n")
        la ip: heiltall = 0
        la kodeblokk: tekst = ""
        mens ip < lengde(kode) {
            la instr = kode[ip]
            // Buffer eit avgrensa tal instruksjonar før disk-append. Dette
            // reduserer native-kall og mengda kortliva strengobjekt i pure VM,
            // utan å halde heile funksjonen eller C-fila i minnet.
            kodeblokk = kodeblokk + opcode_til_c_stream(instr, functions, ip, builtin_kart, legacy_escape)
            hvis instr[0] != "RETURN" og instr[0] != "LABEL" { kodeblokk = kodeblokk + "  nc_gc_safepoint();\n" }
            // Samle ei avgrensa, men vesentleg større blokk per append. Å opne
            // og lukke målfilen for kvar åttande instruksjon gjorde store
            // selfhost-bundlar unødvendig mange gonger tregare.
            hvis (ip + 1) % 256 == 0 {
                builtin.fil_append(output_sti, kodeblokk)
                kodeblokk = ""
            }
            ip = ip + 1
        }
        hvis kodeblokk != "" { builtin.fil_append(output_sti, kodeblokk) }
        builtin.fil_append(output_sti, "  { int _i; NcVal *_ret=nc_nil(); while(_try_depth>0){ _try_depth--; memcpy(&g_err_jmp,&_try_saved[_try_depth],sizeof(jmp_buf)); g_err_gc_boundary=_try_boundaries[_try_depth]; } nc_gc_frame_leave(&_gc_frame); for(_i=0;_i<nvars;_i++) free(varnames[_i]); free(_try_saved); free(_try_boundaries); free(varnames); free(vars); free(stack); return _ret; }\n}\n\n")
        returner sann
    } fang (e) {
        skriv("Klarte ikkje skrive funksjon stream: " + fn_namn + ": " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}

// ─── Hovudgenerator ───────────────────────────────────────────────────────────

funksjon generer_c_frå_ncb(ncb: ordbok<tekst, tekst>) -> tekst {
    la ut: tekst = c_runtime_header()
    la fns = ncb["functions"]
    la nk = nøkler(fns)
    la builtin_kart: ordbok<tekst, tekst> = {}

    // Forhandsdeklarasjonar
    ut = ut + "/* ── Forhandsdeklarasjonar ── */\n"
    ut = ut + "static NcVal *nc_builtin_socket_listen(NcVal *host_v, NcVal *port_v);\n"
    ut = ut + "static NcVal *nc_builtin_socket_accept(NcVal *srv_v);\n"
    ut = ut + "static NcVal *nc_builtin_socket_read(NcVal *conn_v, NcVal *max_v);\n"
    ut = ut + "static NcVal *nc_builtin_socket_write(NcVal *conn_v, NcVal *data_v);\n"
    ut = ut + "static NcVal *nc_builtin_socket_close(NcVal *conn_v);\n"
    la i: heltall = 0
    mens i < lengde(nk) {
        la fn_namn: tekst = nk[i]
        ut = ut + "static NcVal *" + sanitiser_namn(fn_namn) + "(NcVal **args, int nargs);\n"
        i = i + 1
    }
    ut = ut + "\n"

    // Funksjonsdefinisjonar
    ut = ut + "/* ── Funksjonsdefinisjonar ── */\n"
    i = 0
    mens i < lengde(nk) {
        la fn_namn: tekst = nk[i]
        ut = ut + generer_funksjon(fn_namn, fns[fn_namn], fns, builtin_kart)
        i = i + 1
    }

    // Dispatch-tabell for host-sida
    ut = ut + "/* ── Dispatch-tabell for maintainer-host ── */\n"
    ut = ut + "typedef struct { const char *name; NcVal *(*fn)(NcVal **, int); } NcDispatch;\n"
    ut = ut + "static NcDispatch nc_dispatch[] = {\n"
    i = 0
    mens i < lengde(nk) {
        la fn_namn: tekst = nk[i]
        ut = ut + "  {\"" + fn_namn + "\", " + sanitiser_namn(fn_namn) + "},\n"
        i = i + 1
    }
    ut = ut + "  {NULL, NULL}\n"
    ut = ut + "};\n\n"

    // main() — finn best inngangspunkt
    la fns = ncb["functions"]
    la entry_fn: tekst = ""
    // Prioriter: selfhost.nc_main.start > selfhost.main.start > selfhost.kompiler.start
    hvis finnes_nøkkel(fns, "selfhost.nc_main.start") {
        entry_fn = "selfhost.nc_main.start"
    } ellers hvis finnes_nøkkel(fns, "selfhost.main.start") {
        entry_fn = "selfhost.main.start"
    } ellers hvis finnes_nøkkel(fns, "selfhost.kompiler.start") {
        entry_fn = "selfhost.kompiler.start"
    } ellers {
        la nk2 = nøkler(fns)
        la ei: heltall = 0
        mens ei < lengde(nk2) {
            la k2: tekst = nk2[ei]
            hvis builtin.ends_with(k2, ".start") og entry_fn == "" {
                entry_fn = k2
            }
            ei = ei + 1
        }
    }
    ut = ut + "/* Inngangspunkt: " + entry_fn + " */\n"
    ut = ut + "#define NC_HAS_GENERATED_MODULE_INITIALIZERS 1\n"
    ut = ut + "static void nc_run_generated_module_initializers(void) {\n"
    hvis finnes_nøkkel(ncb, "module_initializers") {
        la hook_initializers = ncb["module_initializers"]
        la hi: heiltall = 0
        mens hi < lengde(hook_initializers) {
            ut = ut + "  " + sanitiser_namn(hook_initializers[hi]) + "(NULL, 0);\n"
            hi = hi + 1
        }
    }
    ut = ut + "}\n"
    ut = ut + "int main(int argc, char **argv) {\n"
    ut = ut + "  if (setjmp(g_err_jmp)) { fprintf(stderr, \"nc-vm feil: %s" +
        builtin.chr(92) + "n\", g_err_msg); return 1; }\n"
    ut = ut + "  nc_run_generated_module_initializers();\n"
    ut = ut + "  " + sanitiser_namn(entry_fn) + "(NULL, 0);\n"
    ut = ut + "  return 0;\n"
    ut = ut + "}\n"

    returner ut
}

// Same generator, but writes bounded chunks. The old implementation kept the
// complete generated C file in one VM string; current bootstrap images can be
// large enough for that to exhaust the selfhost heap before fil_skriv().
funksjon generer_c_stream(ncb: ordbok<tekst, tekst>, output_sti: tekst) -> bool {
    prøv {
        la fns = ncb["functions"]
        la nk = nøkler(fns)
        la funksjon_start: heiltall = 0
        la funksjon_slutt: heiltall = lengde(nk)
        prøv {
            la start_tekst = miljo_hent("NC_NCB_FUNCTION_START")
            hvis start_tekst != "" {
                funksjon_start = ncb_parse_nonnegative(start_tekst, "NC_NCB_FUNCTION_START")
            }
        } fang (e) { kast "ugyldig NC_NCB_FUNCTION_START" }
        prøv {
            la slutt_tekst = miljo_hent("NC_NCB_FUNCTION_END")
            hvis slutt_tekst != "" {
                funksjon_slutt = ncb_parse_nonnegative(slutt_tekst, "NC_NCB_FUNCTION_END")
            }
        } fang (e) { kast "ugyldig NC_NCB_FUNCTION_END" }
        hvis funksjon_start < 0 { funksjon_start = 0 }
        hvis funksjon_slutt > lengde(nk) { funksjon_slutt = lengde(nk) }
        hvis funksjon_start > funksjon_slutt { kast "ugyldig NCB-funksjonsintervall" }
        la builtin_kart: ordbok<tekst, tekst> = {}
        builtin.fil_skriv(output_sti, c_runtime_header())
        builtin.fil_append(output_sti, "/* ── Forhandsdeklarasjonar ── */\n")
        builtin.fil_append(output_sti, "static NcVal *nc_builtin_socket_listen(NcVal *host_v, NcVal *port_v);\n")
        builtin.fil_append(output_sti, "static NcVal *nc_builtin_socket_accept(NcVal *srv_v);\n")
        builtin.fil_append(output_sti, "static NcVal *nc_builtin_socket_read(NcVal *conn_v, NcVal *max_v);\n")
        builtin.fil_append(output_sti, "static NcVal *nc_builtin_socket_write(NcVal *conn_v, NcVal *data_v);\n")
        builtin.fil_append(output_sti, "static NcVal *nc_builtin_socket_close(NcVal *conn_v);\n")
        la deklarasjonar: tekst = ""
        la i: heiltall = 0
        mens i < lengde(nk) {
            deklarasjonar = deklarasjonar + "static NcVal *" + sanitiser_namn(nk[i]) + "(NcVal **args, int nargs);\n"
            i = i + 1
            hvis i % 64 == 0 {
                builtin.fil_append(output_sti, deklarasjonar)
                deklarasjonar = ""
            }
        }
        hvis deklarasjonar != "" { builtin.fil_append(output_sti, deklarasjonar) }
        builtin.fil_append(output_sti, "\n/* ── Funksjonsdefinisjonar ── */\n")
        i = funksjon_start
        mens i < funksjon_slutt {
            hvis ikkje generer_funksjon_stream(output_sti, nk[i], fns[nk[i]], fns, builtin_kart) { returner usann }
            i = i + 1
        }
        builtin.fil_append(output_sti, "/* ── Dispatch-tabell for maintainer-host ── */\ntypedef struct { const char *name; NcVal *(*fn)(NcVal **, int); } NcDispatch;\nstatic NcDispatch nc_dispatch[] = {\n")
        i = 0
        mens i < lengde(nk) {
            builtin.fil_append(output_sti, "  {\"" + nk[i] + "\", " + sanitiser_namn(nk[i]) + "},\n")
            i = i + 1
        }
        builtin.fil_append(output_sti, "  {NULL, NULL}\n};\n\n")
        la entry_fn: tekst = ""
        hvis finnes_nøkkel(fns, "selfhost.nc_main.start") { entry_fn = "selfhost.nc_main.start" }
        ellers hvis finnes_nøkkel(fns, "selfhost.main.start") { entry_fn = "selfhost.main.start" }
        ellers hvis finnes_nøkkel(fns, "selfhost.kompiler.start") { entry_fn = "selfhost.kompiler.start" }
        ellers {
            la ei: heiltall = 0
            mens ei < lengde(nk) { hvis builtin.ends_with(nk[ei], ".start") og entry_fn == "" { entry_fn = nk[ei] } ei = ei + 1 }
        }
        la main_kode = "/* Inngangspunkt: " + entry_fn + " */\n#define NC_HAS_GENERATED_MODULE_INITIALIZERS 1\nstatic void nc_run_generated_module_initializers(void) {\n"
        hvis finnes_nøkkel(ncb, "module_initializers") {
            la initializers = ncb["module_initializers"]
            la ii: heiltall = 0
            mens ii < lengde(initializers) {
                main_kode = main_kode + "  " + sanitiser_namn(initializers[ii]) + "(NULL, 0);\n"
                ii = ii + 1
            }
        }
        main_kode = main_kode + "}\nint main(int argc, char **argv) {\n  if (setjmp(g_err_jmp)) { fprintf(stderr, \"nc-vm feil: %s" +
            builtin.chr(92) + "n\", g_err_msg); return 1; }\n  nc_run_generated_module_initializers();\n  " +
            sanitiser_namn(entry_fn) + "(NULL, 0);\n  return 0;\n}\n"
        builtin.fil_append(output_sti, main_kode)
        returner sann
    } fang (e) {
        skriv("Klarte ikkje skrive C-stream: " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}

// ─── Inngangspunkt ───────────────────────────────────────────────────────────

funksjon start() {
    prøv {
        hvis miljo_hent("NC_NCB_JSON_SELFTEST") == "1" {
            ncbj_selftest()
            returner
        }
    } fang (e) { kast e }
    la input_sti = miljo_hent("NC_NCB_INPUT")
    la output_sti = miljo_hent("NC_C_OUTPUT")

    hvis input_sti == "" {
        input_sti = "bootstrap/kompiler.ncb.json"
    }
    hvis output_sti == "" {
        output_sti = "dist/norscode_generated.c"
    }

    skriv("Les " + input_sti + "...\n")
    la ncb_json = fil_les(input_sti)
    // Bruk same Norscode-parser på committed stage0 og kandidatar. Den gamle
    // native json_parse_raw-brua i committed stage0 dekodar enkelte
    // backslash-literal eitt steg for mykje og kan elles materialisere ein
    // kompilator som skriv ugyldig NCB-JSON.
    la ncb = ncbj_les(ncb_json)

    la fns = ncb["functions"]
    // Committed VM-hostar leverer historisk eitt rått JSON-escape-lag,
    // medan den native AOT-parseren leverer ferdig dekoda strengverdiar.
    // I rå hostmodus må alle funksjonar dekodast éin gong. I native modus
    // blir decoded-v1-markøren per funksjon respektert, slik at legacy og nye
    // modular trygt kan blandast i same bundle.
    hvis miljo_hent("NC_NCB_PARSER_DECODED") != "1" {
        la fn_namn = nøkler(fns)
        la fi: heiltall = 0
        mens fi < lengde(fn_namn) {
            la fn = fns[fn_namn[fi]]
            fn["string_encoding"] = "legacy-raw-v1"
            fi = fi + 1
        }
    }
    skriv("Funksjonar: " + ncb_safe_num_text(lengde(nøkler(fns))) + "\n")

    skriv("Genererer C...\n")
    skriv("Skriv " + output_sti + " i stream-modus...\n")
    hvis ikkje generer_c_stream(ncb, output_sti) { returner }
    skriv("Done: C-kode stream-skriven\n")
}
