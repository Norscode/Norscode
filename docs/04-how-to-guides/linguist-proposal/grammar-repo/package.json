{
  "name": "norscode-grammar",
  "displayName": "Norscode Grammar",
  "description": "Standalone TextMate grammar source for Norscode .no files",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "norscode",
        "aliases": [
          "Norscode"
        ],
        "extensions": [
          ".no"
        ]
      }
    ],
    "grammars": [
      {
        "language": "norscode",
        "scopeName": "source.norscode",
        "path": "./syntaxes/norscode.tmLanguage.json"
      }
    ]
  }
}
