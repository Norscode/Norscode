bruk std.socket som socket
bruk std.sched som sched
bruk std.tls_http som tls

funksjon par(listener: ordbok_tekst, client: ordbok_tekst) -> tekst {
    la al = sched.ny()
    la af = socket.native_accept_async(al, listener, 60000)
    sched.run(al, 60000)
    la server = sched.future_resultat(al, af)
    la hs = sched.ny()
    la cf = socket.native_tls_handshake_async(hs, client, 120000)
    la sf = socket.native_tls_handshake_async(hs, server, 120000)
    la t0 = builtin.now_ms()
    la p = sched.run(hs, 150000)
    la dt = builtin.now_ms() - t0
    returner "p=" + tekst(p) + " ms=" + tekst(dt) + " c=" + sched.future_status(hs, cf) + ":" + sched.future_feil(hs, cf) + " s=" + sched.future_status(hs, sf) + ":" + sched.future_feil(hs, sf)
}
funksjon start() -> heiltall {
    la cert = "tests/fixtures/tls/localhost-ed25519.crt"
    la key = "tests/fixtures/tls/localhost-ed25519.key"
    la srv = tls.ny_secure_server(0, tls.load_cert_file(cert), tls.load_key_file(key))
    tls.lytt_secure(srv)
    la l = srv["listener"]
    la port = heltall_fra_tekst(l["port"])
    skriv("GOOD " + par(l, socket.native_tls_tilkoble("127.0.0.1", port, "localhost", cert)) + "\n")
    skriv("BAD " + par(l, socket.native_tls_tilkoble("127.0.0.1", port, "wrong.example", cert)) + "\n")
    returner 0
}
