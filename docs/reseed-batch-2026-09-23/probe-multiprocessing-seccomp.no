bruk std.runtime.process_abi som process_abi
funksjon prøv_ein(sb: tekst, mem: heiltall, nf: heiltall) {
    la req = process_abi.request("/usr/bin/printf", ["%s", "x"], "", "", 5000, 4096)
    process_abi.sett_sandbox(req, sb, mem, nf, usann)
    la svar = builtin.process_spawn_argv(req)
    skriv(sb + " mem=" + tekst(mem) + " nf=" + tekst(nf) + " -> exit=" + tekst(svar["exit_code"]) + " out=" + tekst(svar["stdout"]) + " backend=" + tekst(svar["sandbox_backend"]) + "\n")
}
funksjon start() -> heiltall {
    prøv_ein("none", 0, 0)
    prøv_ein("none", 268435456, 64)
    prøv_ein("no-network", 0, 0)
    prøv_ein("no-network", 4294967296, 1024)
    prøv_ein("no-network", 268435456, 64)
    returner 0
}
