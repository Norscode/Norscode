bruk std.native_gap som ng

funksjon hx(v: heiltall) -> tekst {
    la d = "0123456789abcdef"
    la ut = ""
    la i: heiltall = 0
    mens i < 8 {
        la b = builtin.raw_load8(v + i)
        ut = ut + builtin.slice(d, b / 16, b / 16 + 1) + builtin.slice(d, b % 16, b % 16 + 1)
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la scratch = builtin.sys6(9, 0, 65536, 3, 34, -1, 0)
    la r = ng._pg_bpf(scratch, "no-network")
    la prog: heiltall = r[0]
    la n = builtin.raw_load64(prog)
    skriv("len=" + tekst(n) + " prog=" + hx(prog) + " filt=" + hx(prog + 8) + "\n")
    la filt = builtin.raw_load64(prog + 8)
    la i: heiltall = 0
    mens i < n {
        skriv(tekst(i) + " " + hx(filt + i * 8) + "\n")
        i = i + 1
    }
    returner 0
}
