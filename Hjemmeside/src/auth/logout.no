bruk std.web som web
bruk std.sesjon som sesjon

funksjon utfør(ctx: ordbok_tekst, conn: tekst) -> ordbok_tekst {
    la _ = ctx
    la _ = conn
    la body = "<!doctype html><html lang=\"no\"><head><meta charset=\"utf-8\"><title>Logga ut</title></head><body><p>Du er logga ut. <a href=\"/\">Til hovudsida</a>.</p></body></html>"
    returner web.response_builder(302, {"content-type": "text/html; charset=utf-8", "set-cookie": "session=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0", "location": "/"}, body)
}
