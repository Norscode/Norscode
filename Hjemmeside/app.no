funksjon route_admin_action(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("POST /admin/{tabell}/action")
    la app = _web_app()
    hvis ikkje stack.admin_tilgang(app["conn"], ctx) {
        la nekt = stack.admin_nektet(app["conn"], ctx)
        la _ = stack.lukk(app)
        returner nekt
    }
    la svar = stack.admin_action(app["conn"], app["register"], ctx)
    la _ = stack.lukk(app)
    returner svar
}

