# native_metal_gpu_gate.no - faktisk Metal compute-gate på macOS

bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon køyr(executable: tekst, argv: liste_tekst, cwd: tekst, miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, cwd, miljø, timeout_ms)
}

funksjon feiltekst(res: ordbok_tekst) -> tekst {
    hvis tekst(res["stderr"]) != "" { returner tekst(res["stderr"]) }
    returner tekst(res["error"])
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    hvis builtin.lower(tekst(info["system"])) != "darwin" {
        skriv("[SKIP] Metal GPU-gate krev macOS\n")
        returner 0
    }
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la cc = env("NORSCODE_METAL_CC")
    hvis cc == "" { cc = "/usr/bin/clang" }
    la source = root + "/tools/native_metal_gpu_smoke.m"
    la output = root + "/build/native-metal-gpu-smoke"
    la build = køyr(cc, ["-O2", "-fobjc-arc", source, "-framework", "Foundation", "-framework", "Metal", "-o", output], root, {}, 120000)
    hvis ikkje prosess.ok(build) {
        skriv("[FAIL] Metal GPU smoke-kompilering: " + feiltekst(build) + "\n")
        returner 1
    }
    la run = køyr(output, [], root, {}, 120000)
    hvis ikkje prosess.ok(run) {
        skriv("[FAIL] Metal GPU compute: " + feiltekst(run) + "\n")
        returner 1
    }
    skriv(tekst(run["stdout"]))

    # Dette er ei eksplisitt Fase 5-overgangsløype fram til native codegen
    # eig Objective-C/Metal-hostmaterialiseringa. Ho brukar likevel aldri shell.
    la root_runtime = root + "/build/native-metal-runtime"
    la runtime_source = root + "/build/v3009/native_candidate_gc.c"
    la runtime_build = køyr(cc, ["-O2", "-ObjC", "-pthread", runtime_source, "-lsqlite3", "-ldl", "-framework", "Foundation", "-framework", "Metal", "-o", root_runtime], root, {}, 600000)
    hvis ikkje prosess.ok(runtime_build) {
        skriv("[FAIL] Norscode Metal ABI-kompilering: " + feiltekst(runtime_build) + "\n")
        returner 1
    }
    la runtime_test = køyr(root + "/bin/nc", ["test"], root, {"NC_NATIVE": root_runtime, "NC_TEST_FILE": "tests/test_tensor_metal_backend.no"}, 600000)
    hvis ikkje prosess.ok(runtime_test) {
        skriv("[FAIL] Norscode Metal tensor-ABI: " + feiltekst(runtime_test) + "\n")
        returner 1
    }
    skriv(tekst(runtime_test["stdout"]))
    la media_test = køyr(root + "/bin/nc", ["test"], root, {"NC_NATIVE": root_runtime, "NC_TEST_FILE": "tests/test_media_diffusion_backend.no"}, 600000)
    hvis ikkje prosess.ok(media_test) {
        skriv("[FAIL] Norscode Metal diffusjon-ABI: " + feiltekst(media_test) + "\n")
        returner 1
    }
    skriv(tekst(media_test["stdout"]))
    returner 0
}
