// Genererer VS Code-klienten for Norscode LSP til archive/vscode-klient/.
//
// Klienten er JavaScript (Node), og JS høyrer ikkje heime i aktiv Norscode-flate
// (tools/active_surface_allowlist.txt, kategori «framandspråk»). Difor ligg
// KJELDA her, i Norscode, og den genererte utgåva under archive/ (unnateke).
//
//   nc run tools/lag_vscode_klient.no          skriv archive/vscode-klient/
//   LAG_KLIENT_SJEKK=1 nc run tools/lag_vscode_klient.no   feilar viss utgåva er utdatert
//
// Utdata:
//   archive/vscode-klient/extension.js   klient (vscode-languageclient, stdio)
//   archive/vscode-klient/package.json   manifest = vscode-norscode/package.json
//                                        + main, avhengnad, innstillingar
//   archive/vscode-klient/README.md      bruk
// Resten (grammatikk, snippets, ikon, språkkonfig) bles kopiert frå vscode-norscode/
// ved pakking (sjå README).

bruk selfhost.lsp.straum som s

funksjon rot() -> tekst {
    prøv {
        la r = tekst(miljo_hent("NORSCODE_ROOT"))
        hvis r != "" og r != "." { returner r }
    } fang (e) {}
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

la UT_MAPPE = rot() + "/archive/vscode-klient"

// ─── Pen JSON-utskrift ───────────────────────────────────────────────────────

funksjon pen(v, innrykk: tekst) -> tekst {
    la t = type(v)
    hvis t == "liste" {
        hvis lengde(v) == 0 { returner "[]" }
        la delar = []
        la i = 0
        mens i < lengde(v) {
            legg_til(delar, innrykk + "  " + pen(v[i], innrykk + "  "))
            i = i + 1
        }
        returner "[\n" + builtin.join(delar, ",\n") + "\n" + innrykk + "]"
    }
    hvis t == "ordbok" {
        la ks = nøkler(v)
        hvis lengde(ks) == 0 { returner "{}" }
        la delar = []
        la j = 0
        mens j < lengde(ks) {
            legg_til(delar, innrykk + "  " + s.lsp_js_tekst(tekst(ks[j])) + ": " + pen(v[ks[j]], innrykk + "  "))
            j = j + 1
        }
        returner "{\n" + builtin.join(delar, ",\n") + "\n" + innrykk + "}"
    }
    returner s.lsp_js(v)
}

// ─── extension.js ────────────────────────────────────────────────────────────

funksjon extension_js() -> tekst {
    la l = []
    legg_til(l, "// GENERERT av tools/lag_vscode_klient.no — ikkje rediger for hand.")
    legg_til(l, "// Norscode språkklient: startar tenaren (`nc lsp`) over stdio og kopla han til VS Code.")
    legg_til(l, "'use strict';")
    legg_til(l, "const path = require('path');")
    legg_til(l, "const vscode = require('vscode');")
    legg_til(l, "const { LanguageClient, TransportKind } = require('vscode-languageclient/node');")
    legg_til(l, "")
    legg_til(l, "let client;")
    legg_til(l, "")
    legg_til(l, "function tenarAlternativ(folder) {")
    legg_til(l, "  const cfg = vscode.workspace.getConfiguration('norscode');")
    legg_til(l, "  const command = cfg.get('server.command', 'nc');")
    legg_til(l, "  const args = cfg.get('server.args', ['lsp']);")
    legg_til(l, "  const cwd = folder ? folder.uri.fsPath : undefined;")
    legg_til(l, "  const env = Object.assign({}, process.env, cfg.get('server.env', {}));")
    legg_til(l, "  if (cwd && !env.NORSCODE_ROOT) env.NORSCODE_ROOT = cwd;")
    legg_til(l, "  // Tenaren les filer (moduloppslag) under prosjektrota.")
    legg_til(l, "  if (cwd && !env.NORSCODE_VM_DISK_ROOT) env.NORSCODE_VM_DISK_ROOT = cwd + ',/tmp,/private/tmp';")
    legg_til(l, "  const run = { command, args, options: { cwd, env }, transport: TransportKind.stdio };")
    legg_til(l, "  return { run, debug: run };")
    legg_til(l, "}")
    legg_til(l, "")
    legg_til(l, "function activate(context) {")
    legg_til(l, "  const folder = vscode.workspace.workspaceFolders && vscode.workspace.workspaceFolders[0];")
    legg_til(l, "  const clientOptions = {")
    legg_til(l, "    documentSelector: [{ scheme: 'file', language: 'norscode' }, { scheme: 'untitled', language: 'norscode' }],")
    legg_til(l, "    synchronize: { fileEvents: vscode.workspace.createFileSystemWatcher('**/*.no') },")
    legg_til(l, "    outputChannelName: 'Norscode Language Server',")
    legg_til(l, "  };")
    legg_til(l, "  client = new LanguageClient('norscode', 'Norscode Language Server', tenarAlternativ(folder), clientOptions);")
    legg_til(l, "  context.subscriptions.push(vscode.commands.registerCommand('norscode.restartServer', async () => {")
    legg_til(l, "    if (client) await client.stop();")
    legg_til(l, "    client = new LanguageClient('norscode', 'Norscode Language Server', tenarAlternativ(folder), clientOptions);")
    legg_til(l, "    await client.start();")
    legg_til(l, "  }));")
    legg_til(l, "  return client.start();")
    legg_til(l, "}")
    legg_til(l, "")
    legg_til(l, "function deactivate() {")
    legg_til(l, "  return client ? client.stop() : undefined;")
    legg_til(l, "}")
    legg_til(l, "")
    legg_til(l, "module.exports = { activate, deactivate };")
    returner builtin.join(l, "\n") + "\n"
}

// ─── package.json ────────────────────────────────────────────────────────────

funksjon pakke_json() {
    la m = json_parse_raw(fil_les(rot() + "/vscode-norscode/package.json"))
    m["main"] = "./extension.js"
    m["version"] = "0.3.0"
    m["description"] = "Norscode language support (syntax, snippets, language server)"
    m["activationEvents"] = ["onLanguage:norscode"]
    m["dependencies"] = { "vscode-languageclient": "^9.0.1" }
    m["devDependencies"] = { "@types/vscode": "^1.80.0", "@vscode/vsce": "^3.0.0" }
    la c = m["contributes"]
    c["commands"] = [{ command: "norscode.restartServer", title: "Norscode: Restart Language Server" }]
    c["configuration"] = {
        title: "Norscode",
        properties: {
            "norscode.server.command": {
                type: "string",
                default: "nc",
                description: "Køyrbar fil for Norscode CLI (t.d. ./bin/nc)."
            },
            "norscode.server.args": {
                type: "array",
                items: { type: "string" },
                default: ["lsp"],
                description: "Argument til tenaren. Før `nc lsp` rutar til straum.no kan ['run', 'selfhost/lsp/straum.no'] brukast."
            },
            "norscode.server.env": {
                type: "object",
                default: {},
                description: "Ekstra miljøvariablar for tenaren."
            }
        }
    }
    m["contributes"] = c
    returner m
}

// ─── README ──────────────────────────────────────────────────────────────────

funksjon readme_tekst() -> tekst {
    la l = []
    legg_til(l, "# Norscode VS Code-klient (generert)")
    legg_til(l, "")
    legg_til(l, "Denne mappa er GENERERT av `tools/lag_vscode_klient.no`. Ikkje rediger ho for hand:")
    legg_til(l, "endre generatoren og køyr `nc run tools/lag_vscode_klient.no`. JavaScript høyrer ikkje")
    legg_til(l, "heime i aktiv Norscode-flate (AGENTS.md, `framandspråk`), og `archive/` er unnateke.")
    legg_til(l, "")
    legg_til(l, "Innhald: `extension.js` (klient med `vscode-languageclient`), `package.json` (manifest =")
    legg_til(l, "`vscode-norscode/package.json` + main/avhengnad/innstillingar).")
    legg_til(l, "")
    legg_til(l, "## Pakking og installasjon")
    legg_til(l, "")
    legg_til(l, "```sh")
    legg_til(l, "mkdir -p /tmp/norscode-vsix && cp -R vscode-norscode/. /tmp/norscode-vsix/")
    legg_til(l, "cp archive/vscode-klient/extension.js archive/vscode-klient/package.json /tmp/norscode-vsix/")
    legg_til(l, "cd /tmp/norscode-vsix && npm install && npx vsce package")
    legg_til(l, "code --install-extension norscode-*.vsix")
    legg_til(l, "```")
    legg_til(l, "")
    legg_til(l, "Innstillingar: `norscode.server.command` (standard `nc`), `norscode.server.args`")
    legg_til(l, "(standard `[\"lsp\"]`), `norscode.server.env`. Sjå docs/LSP.md.")
    returner builtin.join(l, "\n") + "\n"
}

funksjon skriv_eller_sjekk(sti: tekst, innhald: tekst, sjekk: boolsk) -> boolsk {
    hvis sjekk {
        la gammal = ""
        prøv { gammal = fil_les(sti) } fang (e) { gammal = "" }
        hvis gammal != innhald {
            skriv("UTDATERT: " + sti + "\n")
            returner usann
        }
        returner sann
    }
    builtin.fil_skriv(sti, innhald)
    skriv("skreiv " + sti + "\n")
    returner sann
}

funksjon start() -> heiltall {
    la sjekk = tekst(miljo_hent("LAG_KLIENT_SJEKK")) == "1"
    hvis ikkje sjekk {
        prøv { builtin.mkdir_p(UT_MAPPE) } fang (e) {}
    }
    la ok = sann
    hvis ikkje skriv_eller_sjekk(UT_MAPPE + "/extension.js", extension_js(), sjekk) { ok = usann }
    hvis ikkje skriv_eller_sjekk(UT_MAPPE + "/package.json", pen(pakke_json(), "") + "\n", sjekk) { ok = usann }
    hvis ikkje skriv_eller_sjekk(UT_MAPPE + "/README.md", readme_tekst(), sjekk) { ok = usann }
    hvis ok { returner 0 }
    returner 1
}
