bruk selfhost.ncb_stream som stream
bruk selfhost.ncb_serde som serde

funksjon start() -> heiltall {
    la inn = miljo_hent("NORSCODE_NCB_STREAM_FIXTURE_INPUT")
    la json_ut = miljo_hent("NORSCODE_NCB_STREAM_FIXTURE_JSON")
    la stream_ut = miljo_hent("NORSCODE_NCB_STREAM_FIXTURE_STREAM")
    hvis inn == "" eller json_ut == "" eller stream_ut == "" { returner 2 }
    la ncb = serde.les_fil(inn)
    ncb["entry"] = "benchmark.start"
    ncb["functions"]["benchmark.start"] = {
        "name": "start",
        "module": "benchmark",
        "params": [],
        "is_async": usann,
        "code": [["PUSH_CONST", 0], ["RETURN"]]
    }
    fil_skriv(json_ut, builtin.json_skriv(ncb))
    la resultat = stream.skriv_fil(stream_ut, ncb)
    skriv("build_ncb_stream_benchmark_fixture: " + resultat["records"] + " postar\n")
    returner 0
}
