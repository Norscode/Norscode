// tools/build-bootstrap-binary.no — shellfri materialisering av native bootstrap

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon systemfelt(namn: tekst) -> tekst {
    prøv { returner tekst(builtin.system_info()[namn]) } fang (e) { returner "" }
    returner ""
}

funksjon platform_name() -> tekst {
    la os = systemfelt("system")
    la arch = systemfelt("machine")
    hvis os == "Darwin" {
        hvis arch == "arm64" { returner "macos-arm64" }
        hvis arch == "x86_64" { returner "macos-x86_64" }
        returner ""
    }
    hvis os == "Linux" {
        hvis arch == "x86_64" eller arch == "amd64" { returner "linux-x86_64" }
        hvis arch == "aarch64" eller arch == "arm64" { returner "linux-arm64" }
        returner ""
    }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = systemfelt("cwd") }
    la out = root + "/dist/norscode_native"
    hvis fil_finst(out) {
        skriv("dist/norscode_native er allereie materialisert.\n")
        returner 0
    }
    la platform = platform_name()
    hvis platform == "" {
        skriv("Feil: ukjend plattform for stage0-seed\n")
        returner 1
    }
    la seed = root + "/bootstrap/stage0/norscode-" + platform
    hvis ikkje fil_finst(seed) {
        skriv("Feil: manglar bootstrap/stage0/norscode-" + platform + "\n")
        skriv("Køyr: ./bin/nc fetch-stage0-seed " + platform + "\n")
        returner 1
    }
    hvis ikkje filops.lag_katalogar(root + "/dist") {
        skriv("Feil: klarte ikkje lage dist-mappa\n")
        returner 1
    }
    hvis fil_finst(out) og ikkje filops.slett_fil(out) {
        skriv("Feil: klarte ikkje rydde gammal runtime\n")
        returner 1
    }
    hvis ikkje filops.kopier2(seed, out) {
        skriv("Feil: klarte ikkje kopiere stage0-seed\n")
        returner 1
    }
    la modus = native_fs.native_sett_modus_sti(out, 493)
    hvis modus["status"] != "ok" {
        filops.slett_fil(out)
        skriv("Feil: filesystem-ABI kunne ikkje setje køyrbar modus\n")
        returner 1
    }
    skriv("dist/norscode_native <- bootstrap/stage0/norscode-" + platform + "\n")
    skriv("Klar: native runtime er materialisert utan C/Python.\n")
    returner 0
}
