// tools/nc_repl.no — Norscode-eigd REPL utan shellkommandoar

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon feil_resultat(melding: tekst) -> liste_tekst {
    la r: liste_tekst = []
    legg_til(r, "1")
    legg_til(r, "")
    legg_til(r, melding)
    returner r
}

funksjon run_file(native: tekst, root: tekst, tmpfile: tekst) -> liste_tekst {
    la req: ordbok_tekst = {
        "abi": "norscode-process-spawn-v1",
        "executable": native,
        "args": [],
        "cwd": root,
        "stdin": "",
        "timeout_ms": "30000",
        "max_output_bytes": "1048576",
        "sandbox": "none",
        "max_memory_bytes": "536870912",
        "max_open_files": "64",
        "inherit_env": "1",
        "environment": {
            "NORSCODE_CMD": "run",
            "NORSCODE_FILE": tmpfile,
            "NORSCODE_ROOT": root
        },
        "capture_stdout": "sann",
        "capture_stderr": "sann"
    }
    prøv {
        la svar = builtin.process_spawn_argv(req)
        la r: liste_tekst = []
        legg_til(r, tekst(svar["exit_code"]))
        legg_til(r, tekst(svar["stdout"]))
        legg_til(r, tekst(svar["stderr"]) + tekst(svar["error"]))
        returner r
    } fang (e) {
        returner feil_resultat(tekst(e))
    }
}

funksjon ok(res: liste_tekst) -> bool {
    returner res[0] == "0"
}

funksjon felt(res: liste_tekst, idx: heiltall) -> tekst {
    hvis lengde(res) > idx { returner res[idx] }
    returner ""
}

funksjon skriv_fil(path: tekst, body: tekst) -> bool {
    prøv {
        builtin.fil_skriv(path, body)
        returner sann
    } fang (e) {
        returner usann
    }
}

funksjon slett_fil(path: tekst) -> heiltall {
    prøv { builtin.fil_slett(path) } fang (e) { }
    returner 0
}

// ── F44: økt-tilstand, fleirlinjeinnskriving, :kommandoar ─────────────────────────

funksjon tell_tegn(t: tekst, tegn: tekst) -> heiltall {
    la n = 0
    la i = 0
    mens i < lengde(t) {
        hvis builtin.slice(t, i, i + 1) == tegn { n = n + 1 }
        i = i + 1
    }
    returner n
}

// Ufullstendig innskriving: opne parentesar/klammer/hakeparentesar, eller avslutta med «\».
funksjon er_ufullstendig(t: tekst) -> bool {
    hvis builtin.ends_with(builtin.trim(t), "\\") { returner sann }
    hvis tell_tegn(t, "{") > tell_tegn(t, "}") { returner sann }
    hvis tell_tegn(t, "(") > tell_tegn(t, ")") { returner sann }
    hvis tell_tegn(t, "[") > tell_tegn(t, "]") { returner sann }
    returner usann
}

// Definisjonar (held i økta) vs. uttrykk (evaluert og skrive ut).
funksjon er_definisjon(t: tekst) -> bool {
    la r = builtin.trim(t)
    hvis builtin.starts_with(r, "la ") eller builtin.starts_with(r, "konst ") { returner sann }
    hvis builtin.starts_with(r, "bruk ") eller builtin.starts_with(r, "funksjon ") { returner sann }
    hvis builtin.starts_with(r, "struktur ") eller builtin.starts_with(r, "enum ") { returner sann }
    hvis builtin.starts_with(r, "grensesnitt ") eller builtin.starts_with(r, "async funksjon ") { returner sann }
    hvis builtin.starts_with(r, "asynk funksjon ") eller builtin.starts_with(r, "privat funksjon ") { returner sann }
    hvis builtin.starts_with(r, "privat asynk funksjon ") eller builtin.starts_with(r, "privat async funksjon ") { returner sann }
    hvis builtin.starts_with(r, "privat la ") eller builtin.starts_with(r, "privat konst ") { returner sann }
    returner usann
}

funksjon fjern_fortsetjing(t: tekst) -> tekst {
    la r = builtin.trim(t)
    hvis builtin.ends_with(r, "\\") { returner builtin.slice(r, 0, lengde(r) - 1) }
    returner t
}

// Programmet som blir køyrt for eit uttrykk: økta (definisjonar) + start() som skriv uttrykket.
funksjon bygg_uttrykk(økt: tekst, uttrykk: tekst) -> tekst {
    returner økt + "funksjon start() -> heiltall {\n    la _res = " + uttrykk + "\n    skriv(tekst_fra_heltall(_res))\n    returner 0\n}\n"
}

funksjon bygg_uttrykk_tekst(økt: tekst, uttrykk: tekst) -> tekst {
    returner økt + "funksjon start() -> heiltall {\n    skriv(" + uttrykk + ")\n    returner 0\n}\n"
}

// `:type uttrykk` — typenamnet til uttrykket.
funksjon bygg_type(økt: tekst, uttrykk: tekst) -> tekst {
    returner økt + "funksjon start() -> heiltall {\n    skriv(builtin.type(" + uttrykk + "))\n    returner 0\n}\n"
}

funksjon bygg_definisjon_test(økt: tekst, def: tekst) -> tekst {
    returner økt + def + "\nfunksjon start() -> heiltall {\n    returner 0\n}\n"
}

// Innskriving: NORSCODE_REPL_SCRIPT (fil, éi linje per innskriving) har prioritet over terminalen —
// gjer REPL-løkka testbar og køyrbar utan stdin-ABI. Slutt på skript gjev tom linje (= avslutt).
la _skript = {"linjer": [], "pos": 0, "på": "usann"}

funksjon last_skript() -> heiltall {
    la f = env("NORSCODE_REPL_SCRIPT")
    hvis f != "" og builtin.fil_finnes(f) {
        _skript["linjer"] = builtin.split(builtin.fil_les(f), "\n")
        _skript["på"] = "sann"
    }
    returner 0
}

funksjon les_inn(prompt: tekst) -> tekst {
    hvis tekst(_skript["på"]) == "sann" {
        la p = _skript["pos"]
        hvis p >= lengde(_skript["linjer"]) { returner "" }
        _skript["pos"] = p + 1
        skriv(prompt + _skript["linjer"][p] + "\n")
        returner _skript["linjer"][p]
    }
    returner builtin.readline(prompt)
}

// Barnet skriv «[vm] entry returned» etter programutdata; ikkje vis det i REPL-en.
funksjon rens(t: tekst) -> tekst {
    returner builtin.trim(builtin.replace(t, "[vm] entry returned", ""))
}

funksjon repl_hjelp() -> heiltall {
    skriv("Norscode REPL\n")
    skriv("  uttrykk                 evaluer og skriv ut (t.d. 1 + 2, \"a\" + \"b\")\n")
    skriv("  la x = 5                definisjonar blir haldne i økta (òg funksjon/struktur/bruk)\n")
    skriv("  fleire linjer           ufullstendig innskriving (opne { ( [ eller avslutta med \\) held fram\n")
    skriv("  :type uttrykk           typen til uttrykket\n")
    skriv("  :økt                    vis definisjonane i økta;  :nullstill  tøm økta\n")
    skriv("  :historikk              tidlegare linjer;  !N  køyr linje N på nytt\n")
    skriv("  :hjelp                  denne oversikta;  :avslutt (eller exit/tom linje)\n")
    returner 0
}

funksjon evaluer_med(native: tekst, root: tekst, prefix: tekst, program: tekst) -> liste_tekst {
    la tmpfile = prefix + "_expr.no"
    slett_fil(tmpfile)
    hvis ikkje skriv_fil(tmpfile, program) { returner feil_resultat("kunne ikkje skrive " + tmpfile) }
    la res = run_file(native, root, tmpfile)
    slett_fil(tmpfile)
    returner res
}

// Evaluer eitt uttrykk mot økta. Prøver heiltals-/verdiforma først, så tekstforma.
funksjon evaluer_linje(native: tekst, root: tekst, prefix: tekst, økt: tekst, line: tekst) -> heiltall {
    la res = evaluer_med(native, root, prefix, bygg_uttrykk(økt, line))
    hvis ok(res) {
        skriv("=> " + rens(felt(res, 1)) + "\n")
        returner 0
    }
    la res2 = evaluer_med(native, root, prefix, bygg_uttrykk_tekst(økt, line))
    hvis ok(res2) {
        skriv("=> " + rens(felt(res2, 1)) + "\n")
        returner 0
    }
    skriv("Feil: " + felt(res2, 1) + felt(res2, 2) + "\n")
    returner 1
}

// Ei kommando (:...) eller definisjon; returnerer ny økt-tekst i ut["økt"], og om løkka skal slutte.
funksjon handter(native: tekst, root: tekst, prefix: tekst, økt: tekst, innskriving: tekst) {
    la t = builtin.trim(innskriving)
    la ut = {"økt": økt, "slutt": "usann"}
    hvis t == ":" { returner ut }
    hvis t == ":hjelp" eller t == ":h" eller t == ":?" {
        repl_hjelp()
        returner ut
    }
    hvis t == ":avslutt" eller t == ":q" eller t == "exit" eller t == "avslutt" {
        ut["slutt"] = "sann"
        returner ut
    }
    hvis t == ":nullstill" {
        ut["økt"] = ""
        skriv("økta er tømd\n")
        returner ut
    }
    hvis t == ":økt" {
        hvis økt == "" { skriv("(tom økt)\n") } ellers { skriv(økt) }
        returner ut
    }
    hvis builtin.starts_with(t, ":type ") {
        la uttrykk = builtin.trim(builtin.slice(t, 6, lengde(t)))
        la res = evaluer_med(native, root, prefix, bygg_type(økt, uttrykk))
        hvis ok(res) { skriv(": " + rens(felt(res, 1)) + "\n") }
        ellers { skriv("Feil: " + felt(res, 1) + felt(res, 2) + "\n") }
        returner ut
    }
    hvis builtin.starts_with(t, ":") {
        skriv("ukjend kommando " + t + " (skriv :hjelp)\n")
        returner ut
    }
    hvis er_definisjon(t) {
        // Godta definisjonen berre om økta + definisjonen framleis kompilerer og køyrer.
        la res = evaluer_med(native, root, prefix, bygg_definisjon_test(økt, t))
        hvis ok(res) {
            ut["økt"] = økt + t + "\n"
            skriv("ok\n")
        } ellers {
            skriv("Feil: " + felt(res, 1) + felt(res, 2) + "\n")
        }
        returner ut
    }
    evaluer_linje(native, root, prefix, økt, t)
    returner ut
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la native = root + "/dist/norscode_native"
    hvis ikkje builtin.fil_finnes(native) {
        skriv("Feil: treng dist/norscode_native. Køyr: ./bin/nc fetch-stage0-seed\n")
        returner 1
    }
    la prefix = env("NORSCODE_REPL_TMP_PREFIX")
    hvis prefix == "" { prefix = "/tmp/norscode_repl" }
    la line = env("NORSCODE_REPL_LINE")
    hvis line != "" {
        la h = handter(native, root, prefix, "", line)
        returner 0
    }

    last_skript()
    la økt = ""
    la historikk: liste_tekst = []
    skriv("Norscode REPL — :hjelp for oversikt\n")
    mens sann {
        la input = ""
        prøv {
            input = les_inn("norscode> ")
        } fang (e) {
            skriv("Feil: stage0 manglar versjonert stdin-linje-ABI: " + tekst(e) + "\n")
            returner 1
        }
        hvis input == "" { returner 0 }
        // !N køyrer linje N frå historikken på nytt.
        hvis builtin.starts_with(input, "!") og lengde(input) > 1 {
            la n = heltall_fra_tekst(builtin.slice(input, 1, lengde(input)))
            hvis n >= 1 og n <= lengde(historikk) {
                input = historikk[n - 1]
                skriv(input + "\n")
            } ellers {
                skriv("ingen historikklinje " + builtin.slice(input, 1, lengde(input)) + "\n")
                input = ":"
            }
        }
        hvis input == ":historikk" {
            la hi = 0
            mens hi < lengde(historikk) {
                skriv("  " + tekst_fra_heltall(hi + 1) + "  " + historikk[hi] + "\n")
                hi = hi + 1
            }
        } ellers {
            // Fleirlinjeinnskriving: hald fram til alle parentesar er lukka.
            mens er_ufullstendig(input) {
                la fortsetjing = ""
                prøv { fortsetjing = les_inn("........> ") } fang (e) { fortsetjing = "" }
                hvis fortsetjing == "" { bryt }
                input = fjern_fortsetjing(input) + "\n" + fortsetjing
            }
            hvis builtin.trim(input) != "" og ikkje builtin.starts_with(input, ":") { legg_til(historikk, input) }
            la r = handter(native, root, prefix, økt, input)
            økt = tekst(r["økt"])
            hvis tekst(r["slutt"]) == "sann" { returner 0 }
        }
    }
    returner 0
}
