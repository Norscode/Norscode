// tools/platform_runtime_attestation.no — commit- og hashbunden plattformkvittering
//
// 2026-09-10: migrert bort frå `exec_prosess` (legacy tekstprosess-kall) til den
// strukturerte prosess-ABI-en. Den gamle forma bygde SHELL-STRENGAR («cd <root> &&
// git …», «shasum -a 256 <sti>») med manuell quoting, som er nettopp det
// aktiv-flate-porten avviser. To av kalla trong ikkje prosess i det heile:
//   shasum/sha256sum → builtin.sha256_bytes(fil_les_binær(...))  (rein Norscode)
//   pwd              → builtin.system_info()["cwd"]
// Resten (git) går no som eksplisitt executable + argv med `cwd` som parameter,
// i staden for eit «cd … &&»-prefiks.

bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

// git med eksplisitt argv og arbeidskatalog — ingen shell, ingen quoting.
//
// TO FELLER som begge er verifiserte ved KØYRING, ikkje berre `nc check`:
// 1. Den strukturerte ABI-en gjer med vilje ikkje PATH-oppslag, so eit bart
//    «git» gjev exit 127. Vi prøver kandidatar til éin svarar. Vi kan IKKJE
//    sondere med fil_finnes: disk-capability-en dekkjer repoet, so
//    fil_finnes("/usr/bin/git") blir avvist med «path outside disk scope».
// 2. Stage0 gjev stdout med ESCAPA linjeskift — `git rev-parse HEAD` er 42
//    teikn (40 + literal «\n» som to teikn) og `trim` fjernar det ikkje.
funksjon program_kandidatar(namn: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    prøv {
        la sti = env("PATH")
        hvis sti != "" {
            for mappe i builtin.split(sti, ":") {
                hvis mappe != "" { legg_til(ut, mappe + "/" + namn) }
            }
        }
    } fang (e) { }
    legg_til(ut, "/usr/bin/" + namn)
    legg_til(ut, "/opt/homebrew/bin/" + namn)
    legg_til(ut, "/usr/local/bin/" + namn)
    returner ut
}

funksjon manglar_program(res: ordbok_tekst) -> bool {
    hvis tekst(res["status"]) == "feil" { returner sann }
    returner heltall_fra_tekst(tekst(res["exit_code"])) == 127
}

funksjon ut_tekst(res: ordbok_tekst) -> tekst {
    returner builtin.trim(builtin.replace(tekst(res["stdout"]), "\\n", "\n"))
}

la GIT_STI: tekst = ""

funksjon git(root: tekst, argv: liste_tekst) -> ordbok_tekst {
    hvis GIT_STI != "" {
        prøv { returner prosess.køyr(GIT_STI, argv, root, {}, 60000) }
        fang (e) { returner {"status": "feil", "exit_code": "1", "stdout": "", "stderr": tekst(e)} }
    }
    for k i program_kandidatar("git") {
        la res = {"status": "feil", "exit_code": "1", "stdout": "", "stderr": ""}
        prøv { res = prosess.køyr(k, argv, root, {}, 60000) } fang (e) { }
        hvis ikkje manglar_program(res) {
            GIT_STI = k
            returner res
        }
    }
    returner {"status": "feil", "exit_code": "127", "stdout": "", "stderr": "fann ikkje git"}
}

funksjon git_ok(res: ordbok_tekst) -> bool { returner prosess.ok(res) }

// Rein Norscode-hash: ingen shasum/sha256sum-prosess.
funksjon sha256(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon arbeidskatalog() -> tekst {
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = arbeidskatalog() }
    la platform = env("NORSCODE_ATTEST_PLATFORM")
    la arch = env("NORSCODE_ATTEST_ARCH")
    la runtime = env("NORSCODE_ATTEST_RUNTIME")
    la gate = env("NORSCODE_ATTEST_GATE_STATUS")
    la output = env("NORSCODE_ATTEST_OUTPUT")
    hvis output == "" { output = root + "/reports/" + platform + "-" + arch + "-runtime-attestation.json" }
    hvis platform == "" eller arch == "" eller runtime == "" eller gate != "verified" {
        skriv("[FAIL] plattformattestasjon krev platform, arch, runtime og verified gate\n")
        returner 2
    }
    la hash = sha256(runtime)
    hvis hash == "" { skriv("[FAIL] plattformattestasjon manglar runtime/hash\n") returner 1 }
    // Same fail-closed kontrakt som før: både arbeidstre og indeks må vere reine.
    hvis ikkje git_ok(git(root, ["diff", "--quiet"])) eller
       ikkje git_ok(git(root, ["diff", "--cached", "--quiet"])) {
        skriv("[FAIL] plattformattestasjon nektar endra spora kjelder\n")
        returner 1
    }
    la rapport: ordbok_tekst = {}
    rapport["schema"] = "norscode-platform-runtime-attestation-v1"
    rapport["status"] = "verified"
    rapport["platform"] = platform
    rapport["architecture"] = arch
    rapport["source_commit"] = ut_tekst(git(root, ["rev-parse", "HEAD"]))
    rapport["runtime_sha256"] = hash
    rapport["gate_status"] = gate
    rapport["repository"] = env("GITHUB_REPOSITORY")
    rapport["workflow"] = env("GITHUB_WORKFLOW")
    rapport["run_id"] = env("GITHUB_RUN_ID")
    prøv {
        builtin.mkdir_p(root + "/reports")
        builtin.fil_skriv(output, builtin.json_skriv(rapport) + "\n")
    } fang (e) { returner 1 }
    skriv("[OK] plattformattestasjon: " + output + "\n")
    returner 0
}
