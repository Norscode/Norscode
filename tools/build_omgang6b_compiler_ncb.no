// tools/build_omgang6b_compiler_ncb.no — kompilator-kjede + ELF driver (Omgang 6b)

bruk std.filops som filops
bruk tools.omgang6b_modules som modular

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) {}
    returner ""
}

funksjon dirname(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) < 2 { returner "." }
    la ut = ""
    la i = 0
    mens i < lengde(delar) - 1 {
        hvis i > 0 { ut = ut + "/" }
        ut = ut + delar[i]
        i = i + 1
    }
    hvis ut == "" { returner "/" }
    returner ut
}

funksjon les_fragment(inner_dir: tekst, namn: tekst) -> tekst {
    returner builtin.fil_les(inner_dir + "/" + namn + ".functions.json")
}

funksjon bygg_frå_fragment(inner_dir: tekst, out: tekst) -> bool {
    la funksjonsjson = ""
    la specs = modular.spesifikasjonar()
    la i = 0
    mens i < lengde(specs) {
        la felt = builtin.split(specs[i], "|")
        hvis i > 0 { funksjonsjson = funksjonsjson + "," }
        funksjonsjson = funksjonsjson + les_fragment(inner_dir, felt[2])
        i = i + 1
    }

    la bundle = "{\"format\":\"ncb-v1\",\"entry\":\"selfhost.elf_compile_driver.start\",\"imports\":[],\"route_handlers\":{},\"dependency_providers\":{},\"guard_providers\":{},\"request_middlewares\":[],\"response_middlewares\":[],\"error_middlewares\":[],\"startup_hooks\":[],\"shutdown_hooks\":[],\"tests\":{},\"functions\":{" + funksjonsjson + modular.metadata_slutt(inner_dir)
    prøv {
        builtin.fil_skriv(out, bundle)
        returner sann
    } fang (e) {
        skriv("Feil: kunne ikkje skrive Omgang6b stage-0 NCB: " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}

funksjon bundle_args() -> tekst {
    la args: liste_tekst = []
    for spec i modular.spesifikasjonar() {
        la felt = builtin.split(spec, "|")
        legg_til(args, felt[1] + "=" + felt[0])
    }
    returner builtin.join(args, " ")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la out = env("NORSCODE_OMGANG6B_NCB_OUT")
    hvis out == "" { out = root + "/build/6b/compiler_stage0.ncb.json" }

    hvis ikkje filops.lag_katalogar(dirname(out)) { returner 1 }

    // J2: ingen committa fragment. Standard er Gen0-fragmenta som
    // tools/gen0_omgang6b_fragments.no genererer frå kjelde med seeden.
    la fragment_dir = env("NORSCODE_OMGANG6B_FRAGMENT_DIR")
    hvis fragment_dir == "" { fragment_dir = root + "/build/6b/fragments_gen0" }
    prøv {
        hvis ikkje builtin.fil_finnes(fragment_dir + "/elf_compile_driver.functions.json") {
            skriv("Feil: manglar Omgang 6b-fragment i " + fragment_dir +
                  " — generer Gen0 frå kjelde først: nc run tools/gen0_omgang6b_fragments.no\n")
            returner 1
        }
    } fang (e) {}
    hvis ikkje bygg_frå_fragment(fragment_dir, out) { returner 1 }

    linje("✓ Omgang 6b stage-0 NCB: " + out + " (" + bytes(out) + " bytes)")
    returner 0
}
