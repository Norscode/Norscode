// tools/build_omgang6b_compiler_ncb.no — kompilator-kjede + ELF driver (Omgang 6b)

bruk std.filops som filops

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) {}
    returner ""
}

funksjon dirname(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) < 2 { returner "." }
    la ut = ""
    la i = 0
    mens i < lengde(delar) - 1 {
        hvis i > 0 { ut = ut + "/" }
        ut = ut + delar[i]
        i = i + 1
    }
    hvis ut == "" { returner "/" }
    returner ut
}

funksjon les_fragment(inner_dir: tekst, namn: tekst) -> tekst {
    returner builtin.fil_les(inner_dir + "/" + namn + ".functions.json")
}

funksjon bygg_frå_fragment(inner_dir: tekst, out: tekst) -> bool {
    la funksjonsjson = ""
    funksjonsjson = funksjonsjson + les_fragment(inner_dir, "lexer_m1")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "parser")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "semantic")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "ir_to_bytecode")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "json")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "kompiler")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "bundler")
    funksjonsjson = funksjonsjson + "," + les_fragment(inner_dir, "elf_compile_driver")

    la bundle = "{\"format\":\"ncb-v1\",\"entry\":\"selfhost.elf_compile_driver.start\",\"imports\":[],\"route_handlers\":{},\"dependency_providers\":{},\"guard_providers\":{},\"request_middlewares\":[],\"response_middlewares\":[],\"error_middlewares\":[],\"startup_hooks\":[],\"shutdown_hooks\":[],\"tests\":{},\"functions\":{" + funksjonsjson + "}}"
    prøv {
        builtin.fil_skriv(out, bundle)
        returner sann
    } fang (e) {
        skriv("Feil: kunne ikkje skrive Omgang6b stage-0 NCB: " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}

funksjon bundle_args() -> tekst {
    returner "selfhost.lexer.lexer_m1=selfhost/lexer/lexer_m1.no " +
        "selfhost.parser=selfhost/parser.no " +
        "selfhost.compiler.semantic=selfhost/compiler/semantic.no " +
        "selfhost.compiler.ir_to_bytecode=selfhost/compiler/ir_to_bytecode.no " +
        "selfhost.json=selfhost/json.no " +
        "selfhost.kompiler=selfhost/kompiler.no " +
        "selfhost.bundler=selfhost/bundler.no " +
        "selfhost.elf_compile_driver=selfhost/elf_compile_driver.no"
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la out = env("NORSCODE_OMGANG6B_NCB_OUT")
    hvis out == "" { out = root + "/build/6b/compiler_stage0.ncb.json" }

    hvis ikkje filops.lag_katalogar(dirname(out)) { returner 1 }

    hvis ikkje bygg_frå_fragment(root + "/bootstrap/precompiled_fragments_inner", out) { returner 1 }

    linje("✓ Omgang 6b stage-0 NCB: " + out + " (" + bytes(out) + " bytes)")
    returner 0
}
