// tools/materialize_runtime_payloads.no — generer runtime-payloadane frå kjelde (J1c, PLAN F1.1).
//
// Dei to NCB-payloadane var tidlegare committa. No blir dei genererte her og er gitignorerte:
//   vm           selfhost/vm.no          → bootstrap/precompiled/vm.ncb.json
//   vm-executor  selfhost/vm_executor.no → selfhost/vm_executor.ncb.json
// Stiane er dei same som før fordi dei er baka inn i seedane (selfhost/vm_executor.no les
// vm-stien når NORSCODE_VM_NCB manglar, og Windows-exe-en sin vm-executor-payload har han
// som streng). Seedane kan ikkje endrast før neste reseed.
//
// Steg per payload (same som den manuelle regen-oppskrifta):
//   1. `compile <kjelde> <ut>` med den aktive runtimen, som JSON-NCB (NORSCODE_NCB_BINARY=0):
//      C-æra-vertane (macOS/Windows-stage0) les berre JSON.
//   2. tools/ncb_normalize_builtin_aliases_v802.no på <ut> (stabile builtin-aliasar).
//   3. Kontroll: JSON-objekt med entry og functions, og kvar INDEX_SET står i paret
//      [INDEX_SET],[POP]. Den frosne macOS-C-æra-verten krev stakkbalansen.
//   4. <ut>.srchash: kjeldehash (første linje) + sha256 av <ut>.
//
// Kjeldehashen er sha256 over import-lukkinga av kjelda (alle `bruk`-modular, transitivt),
// normaliseringsverktøyet og dette verktøyet. Ein payload blir hoppa over når <ut> finst,
// er gyldig, og markøren stemmer både mot kjeldene og mot <ut>.
//
// Bruk:  ./bin/nc run tools/materialize_runtime_payloads.no
//   NORSCODE_PAYLOADS=vm,vm-executor   kva payloadar (standard: begge)
//   NORSCODE_PAYLOADS_FORCE=1          generer sjølv om markøren stemmer
//   NORSCODE_PAYLOADS_CHECK=1          berre kontroller (exit 1 om nokon manglar eller er utdatert)
//   NC_NATIVE / NORSCODE_NATIVE_BIN    runtimen som kompilerer (standard dist/norscode_native)

bruk std.filops som filops
bruk std.sha256 som sha256
bruk tools.process_runner som prosess

funksjon miljø_verdi(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon absolutt(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    hvis builtin.starts_with(sti, "./") { returner root + "/" + builtin.slice(sti, 2, lengde(sti)) }
    returner root + "/" + sti
}

funksjon finn_native(root: tekst) -> tekst {
    la frå_env = miljø_verdi("NC_NATIVE")
    hvis frå_env == "" { frå_env = miljø_verdi("NORSCODE_NATIVE_BIN") }
    hvis frå_env != "" { returner absolutt(root, frå_env) }
    hvis builtin.fil_finnes(root + "/dist/norscode_native") { returner root + "/dist/norscode_native" }
    returner root + "/bin/nc"
}

// SHA-256 over tekst: den innebygde (rask på alle seedar) med std.sha256 som reserve.
funksjon hash_tekst(data: tekst) -> tekst {
    prøv { returner builtin.sha256(data) }
    fang (e) { returner sha256.hash(data) }
    returner sha256.hash(data)
}

funksjon alle_namn() -> liste_tekst {
    returner ["vm", "vm-executor"]
}

funksjon kjelde_rel(namn: tekst) -> tekst {
    hvis namn == "vm" { returner "selfhost/vm.no" }
    hvis namn == "vm-executor" { returner "selfhost/vm_executor.no" }
    returner ""
}

funksjon ut_rel(namn: tekst) -> tekst {
    hvis namn == "vm" { returner "bootstrap/precompiled/vm.ncb.json" }
    hvis namn == "vm-executor" { returner "selfhost/vm_executor.ncb.json" }
    returner ""
}

funksjon ut_sti(root: tekst, namn: tekst) -> tekst {
    returner root + "/" + ut_rel(namn)
}

funksjon markør_sti(root: tekst, namn: tekst) -> tekst {
    returner ut_sti(root, namn) + ".srchash"
}

funksjon tel_tekst(src: tekst, needle: tekst) -> heiltall {
    hvis needle == "" { returner 0 }
    returner lengde(builtin.split(src, needle)) - 1
}

// Modulfila til ein `bruk`/`importer`-linje, eller "" når ho ikkje finst i repoet.
funksjon import_fil(root: tekst, linje: tekst) -> tekst {
    la rest = ""
    hvis builtin.starts_with(linje, "bruk ") {
        rest = builtin.trim(builtin.slice(linje, 5, lengde(linje)))
    } ellers hvis builtin.starts_with(linje, "importer ") {
        rest = builtin.trim(builtin.slice(linje, 9, lengde(linje)))
    }
    hvis rest == "" { returner "" }
    hvis builtin.ends_with(rest, ";") { rest = builtin.slice(rest, 0, lengde(rest) - 1) }
    la som_idx = builtin.index_of(rest, " som ")
    hvis som_idx >= 0 { rest = builtin.trim(builtin.slice(rest, 0, som_idx)) }
    la basis = builtin.replace(rest, ".", "/")
    // .no fyrst: den frosne macOS-C-æra-seeden svarar ja på fil_finnes for eit ikkje-
    // eksisterande «.nors»-alias, og då ville namna (og kjeldehashen) skilje seg frå Linux.
    hvis builtin.fil_finnes(root + "/" + basis + ".no") { returner basis + ".no" }
    hvis builtin.fil_finnes(root + "/" + basis + ".nors") { returner basis + ".nors" }
    returner ""
}

// Import-lukkinga av kjelda (repo-relative stiar, sortert i besøksrekkjefølgje).
funksjon import_lukking(root: tekst, start_rel: tekst) -> liste_tekst {
    la kø: liste_tekst = [start_rel]
    la besøkt = {}
    la ut: liste_tekst = []
    la indeks: heiltall = 0
    mens indeks < lengde(kø) {
        la sti = kø[indeks]
        indeks = indeks + 1
        hvis finnes_nøkkel(besøkt, sti) { fortsett }
        besøkt[sti] = sann
        legg_til(ut, sti)
        la kjelde = ""
        prøv { kjelde = fil_les(root + "/" + sti) } fang (e) { kjelde = "" }
        la linjer = builtin.split(kjelde, "\n")
        la i: heiltall = 0
        mens i < lengde(linjer) {
            la dep = import_fil(root, builtin.trim(linjer[i]))
            hvis dep != "" og ikkje finnes_nøkkel(besøkt, dep) { legg_til(kø, dep) }
            i = i + 1
        }
    }
    returner ut
}

funksjon kjeldehash(root: tekst, namn: tekst) -> tekst {
    la filer = import_lukking(root, kjelde_rel(namn))
    legg_til(filer, "tools/ncb_normalize_builtin_aliases_v802.no")
    legg_til(filer, "tools/materialize_runtime_payloads.no")
    la manifest = "norscode-runtime-payload-v1|" + namn + "|" + ut_rel(namn) + "\n"
    la i: heiltall = 0
    mens i < lengde(filer) {
        la innhald = ""
        prøv { innhald = fil_les(root + "/" + filer[i]) } fang (e) { innhald = "" }
        manifest = manifest + filer[i] + ":" + hash_tekst(innhald) + "\n"
        i = i + 1
    }
    returner hash_tekst(manifest)
}

// "" = gyldig payload; elles grunnen til at han ikkje er det.
funksjon payload_feil(data: tekst) -> tekst {
    la n = lengde(data)
    hvis n < 64 { returner "for kort (" + tekst_fra_heltall(n) + " teikn)" }
    la tt = builtin.trim(data)
    hvis builtin.slice(tt, 0, 1) != "{" { returner "ikkje eit JSON-objekt" }
    hvis builtin.slice(tt, lengde(tt) - 1, lengde(tt)) != "}" { returner "avkorta JSON (manglar avsluttande })" }
    hvis builtin.index_of(data, "\"entry\":") < 0 { returner "manglar entry" }
    hvis builtin.index_of(data, "\"functions\":") < 0 { returner "manglar functions" }
    la is_tal = tel_tekst(data, "[\"INDEX_SET\"]")
    la par_tal = tel_tekst(data, "[\"INDEX_SET\"],[\"POP\"]")
    hvis is_tal == 0 { returner "ingen INDEX_SET (uventa for VM-kjelda)" }
    hvis is_tal != par_tal {
        returner "stakkubalanse: " + tekst_fra_heltall(is_tal) + " INDEX_SET, men " +
            tekst_fra_heltall(par_tal) + " [INDEX_SET],[POP]-par"
    }
    returner ""
}

funksjon les_eller_tom(sti: tekst) -> tekst {
    prøv {
        hvis builtin.fil_finnes(sti) { returner fil_les(sti) }
    } fang (e) { returner "" }
    returner ""
}

funksjon markør_tekst(kjelde: tekst, data: tekst, native: tekst) -> tekst {
    returner kjelde + "\n" + "sha256=" + hash_tekst(data) + "\n" + "runtime=" + native + "\n"
}

// Gyldig og oppdatert: <ut> finst og er gyldig, markøren sin kjeldehash er `kjelde`,
// og markøren sin sha256 er hashen av <ut> slik fila ligg no.
funksjon er_oppdatert(root: tekst, namn: tekst, kjelde: tekst) -> boolsk {
    la data = les_eller_tom(ut_sti(root, namn))
    hvis data == "" eller payload_feil(data) != "" { returner usann }
    la linjer = builtin.split(les_eller_tom(markør_sti(root, namn)), "\n")
    hvis lengde(linjer) < 2 { returner usann }
    hvis builtin.trim(linjer[0]) != kjelde { returner usann }
    returner builtin.trim(linjer[1]) == "sha256=" + hash_tekst(data)
}

// Eksplisitt barnemiljø. Alle kommandoval er sette (òg til tom verdi), så arva
// NORSCODE_CMD/NORSCODE_RUN_*/NORSCODE_MODULE frå ein CI-orkestrator eller testløparen
// ikkje kan styre barnet.
funksjon barnemiljø(root: tekst) -> ordbok_tekst {
    returner {
        "TMPDIR": "/tmp",
        "NORSCODE_ROOT": root,
        "NORSCODE_MODULE": "",
        "NORSCODE_IMPORT_BASE": "",
        "NORSCODE_RUN_CMD": "",
        "NORSCODE_RUN_FILE": "",
        "NORSCODE_RUN_DIRECT_HOST": "0",
        "NORSCODE_HOST_NCB_FILE": "",
        "NORSCODE_NCB_FILE": "",
        "NORSCODE_VM_SOURCE": "0",
        "NORSCODE_NCB_BINARY": "0",
        "NORSCODE_NCB_LEGACY_HOST": "",
        "NORSCODE_USE_PRECOMPILED_SELFHOST": "",
        "NORSCODE_VM_FAST": "1",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
}

funksjon køyr_barn(native: tekst, argv: liste_tekst, root: tekst, miljø: ordbok_tekst,
                   timeout_ms: heiltall, kva: tekst) -> boolsk {
    la res = prosess.køyr_liste(native, argv, root, miljø, timeout_ms)
    hvis tekst(res[0]) != "0" {
        skriv("[FEIL] " + kva + " feila (exit " + tekst(res[0]) + ")\n")
        skriv(tekst(res[1]) + "\n" + tekst(res[2]) + "\n")
        returner usann
    }
    returner sann
}

// Kompiler, normaliser og kontroller éin payload. Ved feil blir både <ut> og markøren
// fjerna, så ein halvskriven payload aldri ser gyldig ut.
funksjon generer(root: tekst, native: tekst, namn: tekst, kjelde: tekst) -> boolsk {
    la ut = ut_sti(root, namn)
    la markør = markør_sti(root, namn)
    hvis ikkje filops.lag_katalogar(filops.katalog(ut)) {
        skriv("[FEIL] kunne ikkje lage katalogen til " + ut + "\n")
        returner usann
    }
    filops.slett_fil(markør)
    filops.slett_fil(ut)
    la start_ms = builtin.tid_ms()
    skriv("[payload] " + namn + ": kompilerer " + kjelde_rel(namn) + " → " + ut_rel(namn) + "\n")
    hvis ikkje køyr_barn(native, ["compile", kjelde_rel(namn), ut], root, barnemiljø(root), 2400000,
                        "compile " + kjelde_rel(namn)) {
        filops.slett_fil(ut)
        returner usann
    }
    la før = les_eller_tom(ut)
    la is_før = tel_tekst(før, "[\"INDEX_SET\"],[\"POP\"]")
    la norm = barnemiljø(root)
    norm["NORSCODE_NCB_NORMALIZE_IN"] = ut
    norm["NORSCODE_NCB_NORMALIZE_OUT"] = ut
    hvis ikkje køyr_barn(native, ["run", "tools/ncb_normalize_builtin_aliases_v802.no"], root, norm, 900000,
                        "normalisering av " + ut_rel(namn)) {
        filops.slett_fil(ut)
        returner usann
    }
    la data = les_eller_tom(ut)
    la feil = payload_feil(data)
    hvis feil == "" og tel_tekst(data, "[\"INDEX_SET\"],[\"POP\"]") != is_før {
        feil = "normaliseringa endra INDEX_SET/POP-talet (" + tekst_fra_heltall(is_før) + " → " +
            tekst_fra_heltall(tel_tekst(data, "[\"INDEX_SET\"],[\"POP\"]")) + ")"
    }
    hvis feil != "" {
        skriv("[FEIL] " + ut_rel(namn) + ": " + feil + "\n")
        filops.slett_fil(ut)
        returner usann
    }
    fil_skriv(markør, markør_tekst(kjelde, data, native))
    skriv("[payload] " + namn + ": OK " + tekst_fra_heltall(lengde(data)) + " teikn, INDEX_SET/POP=" +
          tekst_fra_heltall(is_før) + ", sha256=" + hash_tekst(data) + ", " +
          tekst_fra_heltall(builtin.tid_ms() - start_ms) + " ms\n")
    returner sann
}

// Full kontroll + generering ved behov. Returnerer sann når payloaden er gyldig etterpå.
funksjon materialiser(root: tekst, native: tekst, namn: tekst, force: boolsk) -> boolsk {
    hvis kjelde_rel(namn) == "" {
        skriv("[FEIL] ukjend payload: " + namn + "\n")
        returner usann
    }
    la kjelde = kjeldehash(root, namn)
    hvis ikkje force og er_oppdatert(root, namn, kjelde) {
        skriv("[payload] " + namn + ": oppdatert (kjeldehash " + builtin.slice(kjelde, 0, 16) + "), hoppar over\n")
        returner sann
    }
    returner generer(root, native, namn, kjelde)
}

// For forbrukarar (testløparen, pakke- og kandidatverktøy): generer berre når <ut> manglar
// eller er ugyldig. Kjeldehashen blir ikkje rekna ut her, så ein payload som CI har
// materialisert på ein annan plattform blir brukt som han er.
funksjon sikre_finst(root: tekst, native: tekst, namn: tekst) -> boolsk {
    la data = les_eller_tom(ut_sti(root, namn))
    hvis data != "" og payload_feil(data) == "" { returner sann }
    skriv("[payload] " + ut_rel(namn) + " manglar eller er ugyldig; genererer frå kjelde\n")
    returner generer(root, native, namn, kjeldehash(root, namn))
}

funksjon sikre_alle(root: tekst, native: tekst) -> boolsk {
    la namn = alle_namn()
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis ikkje sikre_finst(root, native, namn[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon valde_namn() -> liste_tekst {
    la spes = builtin.trim(miljø_verdi("NORSCODE_PAYLOADS"))
    hvis spes == "" { returner alle_namn() }
    la ut: liste_tekst = []
    la delar = builtin.split(spes, ",")
    la i: heiltall = 0
    mens i < lengde(delar) {
        la d = builtin.trim(delar[i])
        hvis d != "" { legg_til(ut, d) }
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la root = miljø_verdi("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la native = finn_native(root)
    la namn = valde_namn()
    la berre_sjekk = miljø_verdi("NORSCODE_PAYLOADS_CHECK") == "1"
    la force = miljø_verdi("NORSCODE_PAYLOADS_FORCE") == "1"
    la feil: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis kjelde_rel(namn[i]) == "" {
            skriv("[FEIL] ukjend payload: " + namn[i] + " (kjende: vm, vm-executor)\n")
            feil = feil + 1
        } ellers hvis berre_sjekk {
            hvis er_oppdatert(root, namn[i], kjeldehash(root, namn[i])) {
                skriv("[OK] " + ut_rel(namn[i]) + " er oppdatert\n")
            } ellers {
                skriv("[FEIL] " + ut_rel(namn[i]) + " manglar, er ugyldig eller utdatert mot kjeldene\n")
                feil = feil + 1
            }
        } ellers hvis ikkje materialiser(root, native, namn[i], force) {
            feil = feil + 1
        }
        i = i + 1
    }
    hvis feil > 0 { returner 1 }
    hvis ikkje berre_sjekk { skriv("[OK] runtime-payloadane er genererte frå kjelde\n") }
    returner 0
}
