// tools/bootstrap_wrapper.no — strukturert kompatibilitetsbru for bootstrap

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon executable(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon køyr(executable_sti: tekst, argv: liste_tekst, cwd: tekst,
              miljø: ordbok_tekst) -> heiltall {
    la res = prosess.køyr(executable_sti, argv, cwd, miljø, 3600000)
    prosess.skriv_resultat(res)
    hvis prosess.ok(res) { returner 0 }
    returner heltall_fra_tekst(tekst(res["exit_code"]))
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = root + "/dist/norscode_native"
    hvis ikkje executable(native) {
        linje("norscode: norscode_native ikkje funnen: " + native)
        linje("Køyr: ./bin/nc fetch-stage0-seed")
        returner 1
    }

    hvis env("NORCODE_BOOTSTRAP_CLI") != "" {
        la cmd = env("NORCODE_ARG0")
        hvis cmd == "" { cmd = "selfcheck" }
        hvis cmd == "selfcheck" eller cmd == "test" eller cmd == "identity" eller
           cmd == "release" eller cmd == "release-targets" {
            returner køyr(root + "/bin/nc", ["selfcheck"], root, {})
        }
        hvis cmd == "help" eller cmd == "--help" eller cmd == "-h" {
            returner køyr(root + "/bin/nc", ["help"], root, {})
        }
        returner køyr(root + "/bin/nc", [cmd], root, {})
    }

    hvis env("NORCODE_BOOTSTRAP_VM") != "" {
        la cmd2 = env("NORCODE_CMD")
        hvis cmd2 == "" { cmd2 = "run" }
        la src = env("NORCODE_SRC")
        la out = env("NORCODE_OUT")
        hvis cmd2 == "run" og src != "" {
            returner køyr(native, [], root, {"NORSCODE_CMD": "run", "NORSCODE_FILE": src})
        }
        hvis cmd2 == "build" og src != "" og out != "" {
            returner køyr(native, [], root, {
                "NORSCODE_CMD": "compile", "NORSCODE_FILE": src, "NORSCODE_OUTPUT": out,
                "NORSCODE_ROOT": root
            })
        }
        linje("norscode: ugyldig NORCODE_CMD=" + cmd2)
        returner 1
    }

    la arg1 = env("NORSCODE_BOOTSTRAP_ARG1")
    returner køyr(native, [], root, {"NORSCODE_CMD": "run", "NORSCODE_FILE": arg1})
}
