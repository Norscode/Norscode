// tools/selfhost_phase0_verify.no — fase-0-policy i Norscode

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk tools.verify_norscode_surface_ownership som ownership

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}
funksjon env(namn: tekst) -> tekst {
    prøv {
        returner miljo_hent(namn)
    } fang (e) {
        returner ""
    }
    returner ""
}
funksjon aktive_røter(root: tekst) -> liste_tekst {
    returner [
        root + "/README.md",
        root + "/.github/workflows",
        root + "/bin",
        root + "/tools",
        root + "/docs/05-development/SELFHOST_FALLBACK_CONTRACT.md",
        root + "/docs/05-development/SELFHOST_CI_GATES.md",
        root + "/docs/05-development/SELFHOST_RELEASE_CHECKLIST.md",
        root + "/docs/README.md",
        root + "/docs/INDEX.md",
        root + "/docs/SELFHOST_HANDLINGSPLAN.md",
        root + "/docs/STATUS.md"
    ]
}

funksjon inneheld(haystack: tekst, needle: tekst) -> bool {
    returner builtin.index_of(haystack, needle) >= 0
}

funksjon sluttar_med(verdi: tekst, suffiks: tekst) -> bool {
    la v = builtin.split(verdi, "")
    la s = builtin.split(suffiks, "")
    hvis lengde(s) > lengde(v) { returner usann }
    la start = lengde(v) - lengde(s)
    returner builtin.join(builtin.slice(v, start, lengde(v)), "") == suffiks
}

funksjon rel_sti(root: tekst, sti: tekst) -> tekst {
    hvis inneheld(sti, root + "/") {
        returner builtin.replace(sti, root + "/", "")
    }
    returner sti
}

funksjon basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) == 0 { returner sti }
    returner delar[lengde(delar) - 1]
}

funksjon fase0_skip_fil(sti: tekst) -> bool {
    la namn = basename(sti)
    hvis namn == "selfhost_phase0_verify.sh" { returner sann }
    hvis namn == "selfhost_phase0_verify.no" { returner sann }
    hvis namn == "enforce_native_first.sh" { returner sann }
    hvis namn == "enforce_native_first.no" { returner sann }
    hvis namn == "nc_test.sh" { returner sann }
    hvis namn == "nc_test.no" { returner sann }
    returner usann
}

funksjon aktive_filer(root: tekst) -> liste_tekst {
    la filer: liste_tekst = []
    la røter = aktive_røter(root)
    la i = 0
    mens i < lengde(røter) {
        la sti = røter[i]
        hvis filops.fil_finnes(sti) {
            hvis ikkje fase0_skip_fil(sti) { legg_til(filer, sti) }
        } ellers hvis filops.katalog_finnes(sti) {
            la under: liste_tekst = []
            la relativ = rel_sti(root, sti)
            la walk = native_fs.native_walk_files(root, relativ)
            hvis walk["status"] == "ok" {
                la native_filer = builtin.split(walk["data"], "\n")
                la wi = 0
                mens wi < lengde(native_filer) {
                    la native_rel = builtin.trim(native_filer[wi])
                    hvis native_rel != "" { legg_til(under, root + "/" + native_rel) }
                    wi = wi + 1
                }
            } ellers {
                // Kompatibilitetsbane for committed stage0 fram til kandidaten
                // er fullverifisert og kan promoterast kontrollert.
                under = filops.walk_med_ignore(sti, ["/.git/"])
            }
            la j = 0
            mens j < lengde(under) {
                hvis ikkje fase0_skip_fil(under[j]) { legg_til(filer, under[j]) }
                j = j + 1
            }
        }
        i = i + 1
    }
    returner filer
}

funksjon blokkere() -> liste_tekst {
    la b: liste_tekst = []
    legg_til(b, "main.py")
    legg_til(b, "compile.py")
    legg_til(b, "docker buildx build")
    legg_til(b, "Dockerfile.linux-build")
    legg_til(b, "setup.py")
    legg_til(b, "test_web_dependency.no")
    legg_til(b, "Bygg dist/norscode for normal bruk, eller bruk ./bin/bootstrap.")
    legg_til(b, "dist/norcode-bootstrap-compile")
    returner b
}

funksjon sjekk_fil(root: tekst, sti: tekst, mønster: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les(sti)
        hvis inneheld(innhald, mønster) {
            returner rel_sti(root, sti) + ": " + mønster
        }
    } fang (e) {
        returner ""
    }
    returner ""
}

funksjon check_active_surface(root: tekst) -> tekst {
    la filer = aktive_filer(root)
    la mønster = blokkere()
    la treff: liste_tekst = []
    la i = 0
    mens i < lengde(filer) {
        prøv {
            // Les kvar fil éin gong og køyr alle literal i eitt runtimekall.
            la innhald = builtin.fil_les(filer[i])
            la funn = builtin.contains_any(innhald, mønster)
            la j = 0
            mens j < lengde(funn) {
                legg_til(treff, rel_sti(root, filer[i]) + ": " + funn[j])
                j = j + 1
            }
        } fang (e) { }
        i = i + 1
    }
    returner builtin.join(treff, "\n")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    root = filops.absolutt_sti(root)
    hvis env("NORSCODE_PHASE0_OWNERSHIP_DONE") != "1" {
        // Same eigarlogikk som `nc surface-ownership`, eitt samla repopass.
        hvis env("NORSCODE_PHASE0_TRACE") == "on" { linje("[phase0] ownership start") }
        hvis ikkje ownership.samla_eigarskap_gate(root) { returner 1 }
        hvis env("NORSCODE_PHASE0_TRACE") == "on" { linje("[phase0] ownership ferdig") }
    }
    hvis env("NORSCODE_PHASE0_TRACE") == "on" { linje("[phase0] blokkarskann start") }
    la hits = check_active_surface(root)
    hvis env("NORSCODE_PHASE0_TRACE") == "on" { linje("[phase0] blokkarskann ferdig") }
    hvis hits != "" {
        linje("Fase 0-verifisering feila: historiske blokkere finst framleis i aktiv flate.")
        linje(hits)
        returner 1
    }
    linje("Fase 0-verifisering: OK")
    linje("Aktiv flate er fri for kjende historiske fase-0-blokkere.")
    returner 0
}
