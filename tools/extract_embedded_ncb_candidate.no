// Trekk den versjonerte NCB-traileren frå ein separat kandidatbinær.
// Verktøyet endrar aldri kandidaten eller aktiv runtime.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trekk_ut(inn: tekst, ut: tekst) -> heiltall {
    hvis inn == "" eller ut == "" eller inn == ut { returner 2 }
    // Hald kandidatfila som bytes. Ei per-byte-løkke over ein stor NCB under
    // VM-en kan bruke heile tidsbudsjettet til testporten før AOT-bygginga.
    la raw = builtin.fil_les_binær(inn)
    hvis lengde(raw) < 23 { returner 1 }
    la n: heiltall = 0
    la i: heiltall = 0
    mens i < 8 {
        n = n | (raw[lengde(raw) - 8 + i] << (i * 8))
        i = i + 1
    }
    // F3.6: «NORSCODE_NCB_V2» (binær NCB) eller «NORSCODE_NCB_V1» (JSON). Payloaden
    // blir skriven ut uendra; lesarane (serde.les_fil) er dual-format.
    la markør = "NORSCODE_NCB_V2"
    la start_pos = lengde(raw) - 8 - lengde(markør) - n
    hvis n <= 0 eller start_pos < 0 { returner 1 }
    la lik = sann
    la mi: heiltall = 0
    mens mi < lengde(markør) {
        hvis raw[start_pos + n + mi] != builtin.char_code(markør[mi]) { lik = usann }
        mi = mi + 1
    }
    hvis ikkje lik {
        markør = "NORSCODE_NCB_V1"
        mi = 0
        mens mi < lengde(markør) {
            hvis raw[start_pos + n + mi] != builtin.char_code(markør[mi]) { returner 1 }
            mi = mi + 1
        }
    }
    builtin.fil_skriv_binær(ut, builtin.slice(raw, start_pos, start_pos + n))
    skriv("[OK] innebygd kandidat-NCB trekt ut, bytes=" + tekst(n) + "\n")
    returner 0
}

funksjon start() -> heiltall {
    returner trekk_ut(env("NC_EXTRACT_ELF"), env("NC_EXTRACT_NCB"))
}
