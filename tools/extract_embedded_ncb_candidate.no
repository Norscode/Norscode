// Trekk den versjonerte NCB-traileren frå ein separat kandidatbinær.
// Verktøyet endrar aldri kandidaten eller aktiv runtime.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la inn = env("NC_EXTRACT_ELF")
    la ut = env("NC_EXTRACT_NCB")
    hvis inn == "" eller ut == "" eller inn == ut { returner 2 }
    la raw = builtin.bytes_to_list(builtin.fil_les_binær(inn))
    hvis lengde(raw) < 23 { returner 1 }
    la n: heiltall = 0
    la i: heiltall = 0
    mens i < 8 {
        n = n | (raw[lengde(raw) - 8 + i] << (i * 8))
        i = i + 1
    }
    la markør = "NORSCODE_NCB_V1"
    la start_pos = lengde(raw) - 8 - lengde(markør) - n
    hvis n <= 0 eller start_pos < 0 { returner 1 }
    la mi: heiltall = 0
    mens mi < lengde(markør) {
        hvis raw[start_pos + n + mi] != builtin.char_code(markør[mi]) { returner 1 }
        mi = mi + 1
    }
    la payload: liste_heiltall = []
    la pi: heiltall = 0
    mens pi < n {
        legg_til(payload, raw[start_pos + pi])
        pi = pi + 1
    }
    builtin.fil_skriv_binær(ut, builtin.bytes_from_list(payload))
    skriv("[OK] innebygd kandidat-NCB trekt ut, bytes=" + tekst(n) + "\n")
    returner 0
}
