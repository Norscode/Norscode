// tools/fetch_stage0_seed.no — hent eller verifiser stage0-seed utan shelltekst

bruk std.filops som filops
bruk std.http som http
bruk std.prosess som system_prosess
bruk std.runtime_filesystem som native_fs
bruk std.tempfile som tempfile
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) { returner "" }
    returner ""
}

funksjon byte_status(sti: tekst) -> tekst {
    la n = env("NORSCODE_STAGE0_SEED_BYTES")
    hvis n == "" { n = bytes(sti) }
    hvis n == "" { returner "storleik ukjent" }
    returner n + " bytes"
}

funksjon dirname(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) <= 1 { returner "." }
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(delar) - 1 { legg_til(ut, delar[i]) i = i + 1 }
    la res = builtin.join(ut, "/")
    hvis res == "" og builtin.starts_with(sti, "/") { returner "/" }
    hvis res == "" { returner "." }
    returner res
}

funksjon json_strengverdi_etter(src: tekst, key: tekst, start: heiltall) -> tekst {
    la keypat = "\"" + key + "\""
    la rest = builtin.slice(src, start, lengde(src))
    la key_rel = builtin.index_of(rest, keypat)
    hvis key_rel < 0 { returner "" }
    la etter_key = start + key_rel + lengde(keypat)
    rest = builtin.slice(src, etter_key, lengde(src))
    la kolon_rel = builtin.index_of(rest, ":")
    hvis kolon_rel < 0 { returner "" }
    la etter_kolon = etter_key + kolon_rel + 1
    rest = builtin.slice(src, etter_kolon, lengde(src))
    la start_sitat_rel = builtin.index_of(rest, "\"")
    hvis start_sitat_rel < 0 { returner "" }
    la verdi_start = etter_kolon + start_sitat_rel + 1
    rest = builtin.slice(src, verdi_start, lengde(src))
    la slutt_sitat_rel = builtin.index_of(rest, "\"")
    hvis slutt_sitat_rel < 0 { returner "" }
    returner builtin.slice(src, verdi_start, verdi_start + slutt_sitat_rel)
}

funksjon finn_download_url_med_match(json: tekst, asset: tekst, eksakt: bool) -> tekst {
    la pos = 0
    la namepat = "\"name\""
    mens pos < lengde(json) {
        la rest = builtin.slice(json, pos, lengde(json))
        la rel = builtin.index_of(rest, namepat)
        hvis rel < 0 { returner "" }
        la name_pos = pos + rel
        la namn = json_strengverdi_etter(json, "name", name_pos)
        hvis (eksakt og namn == asset) eller ((ikkje eksakt) og builtin.starts_with(namn, asset)) {
            la url = json_strengverdi_etter(json, "browser_download_url", name_pos)
            hvis url != "" og url != "null" { returner url }
        }
        pos = name_pos + lengde(namepat)
    }
    returner ""
}

funksjon finn_download_url(json: tekst, asset: tekst) -> tekst {
    hvis json == "" { returner "" }
    la url = finn_download_url_med_match(json, asset, sann)
    hvis url != "" { returner url }
    returner finn_download_url_med_match(json, asset, falsk)
}

funksjon platform_name() -> tekst {
    la info = builtin.system_info()
    la os = tekst(info["system"])
    la arch = tekst(info["machine"])
    hvis os == "Darwin" {
        hvis arch == "arm64" { returner "macos-arm64" }
        hvis arch == "x86_64" { returner "macos-x86_64" }
    }
    hvis os == "Linux" {
        hvis arch == "x86_64" eller arch == "amd64" { returner "linux-x86_64" }
        hvis arch == "aarch64" eller arch == "arm64" { returner "linux-arm64" }
    }
    hvis os == "Windows" og (arch == "x86_64" eller arch == "amd64") { returner "windows-x86_64" }
    returner ""
}

funksjon hent_release_json(url: tekst, token: tekst) -> tekst {
    la headers: ordbok_tekst = {"Accept": "application/vnd.github+json"}
    hvis token != "" { headers["Authorization"] = "Bearer " + token }
    prøv {
        la response = http.get(url, headers, {}, 30000)
        hvis http.response_ok(response) { returner http.response_text(response) }
    } fang (e) {}
    returner ""
}

funksjon last_ned_binær(url: tekst, token: tekst, mål: tekst, root: tekst) -> boolsk {
    la curl = system_prosess.finn_kjorbar("curl")
    hvis curl == "" { returner usann }
    la argv: liste_tekst = ["-fsSL", "-L", "--output", mål, "-H", "Accept: application/octet-stream"]
    hvis token != "" { legg_til(argv, "-H") legg_til(argv, "Authorization: Bearer " + token) }
    legg_til(argv, url)
    returner prosess.ok(prosess.køyr(curl, argv, root, {}, 300000))
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la platform = env("NORSCODE_STAGE0_PLATFORM")
    hvis platform == "" { platform = platform_name() }
    hvis platform == "" { linje("Feil: ukjent plattform") returner 1 }
    la suffix = ""
    hvis builtin.starts_with(platform, "windows-") { suffix = ".exe" }
    la dest = root + "/bootstrap/stage0/norscode-" + platform + suffix
    hvis ikkje filops.lag_katalogar(dirname(dest)) { returner 1 }
    hvis fil_finst(dest) {
        linje("✓ stage0-seed finst: " + dest + " (" + byte_status(dest) + ")")
        returner 0
    }

    la repo = env("NORSCODE_RELEASE_REPO")
    hvis repo == "" { repo = env("GITHUB_REPOSITORY") }
    hvis repo == "" { repo = "Norscode/Norscode" }
    la asset_name = "norscode-" + platform + suffix
    la token = env("GITHUB_TOKEN")
    hvis token == "" { token = env("GH_TOKEN") }
    linje("Hentar " + asset_name + " frå " + repo + " ...")
    la release_json = hent_release_json("https://api.github.com/repos/" + repo + "/releases/latest", token)
    hvis release_json == "" { linje("Feil: kunne ikkje hente release-info") returner 1 }
    la download_url = finn_download_url(release_json, asset_name)
    hvis download_url == "" eller download_url == "null" {
        linje("Feil: ingen release-asset " + asset_name)
        linje("Legg fil i bootstrap/stage0/ eller publiser ein release.")
        returner 1
    }

    la tmp_obj = tempfile.ny_tempfil("nc_seed_", ".bin")
    la tmp = tempfile.sti(tmp_obj)
    hvis ikkje last_ned_binær(download_url, token, tmp, root) eller ikkje filops.flytt(tmp, dest) {
        tempfile.slett(tmp_obj)
        linje("Feil: kunne ikkje laste ned seed")
        returner 1
    }
    native_fs.native_sett_modus_sti(dest, 493)

    la smoke_obj = tempfile.ny_tempfil("nc_seed_smoke_", ".no")
    la smoke = tempfile.sti(smoke_obj)
    builtin.fil_skriv(smoke, "funksjon start() { returner 0 }\n")
    la smoke_result = prosess.køyr(dest, [], root,
        {"NORSCODE_CMD": "run", "NORSCODE_FILE": smoke}, 30000)
    tempfile.slett(smoke_obj)
    hvis ikkje prosess.ok(smoke_result) {
        filops.slett_fil(dest)
        linje("Feil: nedlasta seed feila røyktest")
        returner 1
    }
    linje("✓ stage0-seed: " + dest + " (" + byte_status(dest) + ")")
    returner 0
}
