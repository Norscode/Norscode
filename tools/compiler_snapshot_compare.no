// Prosessfri samanlikning av kompilatorsnapshots.

bruk std.liste som liste
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon sha256_for(sti: tekst) -> tekst {
    prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon relative_filer(root: tekst) -> liste_tekst {
    la full = filops.walk(root)
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(full) {
        legg_til(ut, filops.relativ_sti(root, full[i]))
        i = i + 1
    }
    liste.sorter_tekst(ut)
    returner ut
}

funksjon hash_samanlikning(snap_a: tekst, snap_b: tekst) -> tekst {
    la filer_a = relative_filer(snap_a)
    la filer_b = relative_filer(snap_b)
    la sett_a = {}
    la i = 0
    mens i < lengde(filer_a) { sett_a[filer_a[i]] = "1" i = i + 1 }
    la body = ""
    i = 0
    mens i < lengde(filer_a) {
        la relative = filer_a[i]
        la file_a = snap_a + "/" + relative
        la file_b = snap_b + "/" + relative
        hvis builtin.fil_finnes(file_b) {
            hvis sha256_for(file_a) == sha256_for(file_b) { body = body + "MATCH " + relative + "\n" }
            ellers { body = body + "DIFF  " + relative + "\n" }
        } ellers {
            body = body + "MISSING IN SNAPSHOT_B: " + relative + "\n"
        }
        i = i + 1
    }
    i = 0
    mens i < lengde(filer_b) {
        hvis ikkje har_nokkel(sett_a, filer_b[i]) {
            body = body + "MISSING IN SNAPSHOT_A: " + filer_b[i] + "\n"
        }
        i = i + 1
    }
    returner body
}

funksjon samanlikn(snap_a: tekst, snap_b: tekst, report: tekst) -> bool {
    hvis ikkje filops.katalog_finnes(snap_a) eller ikkje filops.katalog_finnes(snap_b) { returner usann }
    hvis ikkje filops.lag_katalogar(filops.katalog(report)) { returner usann }
    la body = "=== Compiler Snapshot Comparison ===\n\n" +
        "Snapshot A: " + snap_a + "\n" +
        "Snapshot B: " + snap_b + "\n\n" +
        "File inventory and hash comparison:\n" +
        hash_samanlikning(snap_a, snap_b)
    builtin.fil_skriv(report, body)
    returner sann
}

funksjon start() -> heiltall {
    la snap_a = env("NORSCODE_SNAPSHOT_A")
    la snap_b = env("NORSCODE_SNAPSHOT_B")
    hvis snap_a == "" eller snap_b == "" {
        linje("Usage: NORSCODE_SNAPSHOT_A=<snapshot_dir_a> NORSCODE_SNAPSHOT_B=<snapshot_dir_b> ./bin/nc run tools/compiler_snapshot_compare.no")
        returner 1
    }
    hvis ikkje samanlikn(snap_a, snap_b, "reports/compiler_snapshot_compare_report.txt") {
        linje("Missing snapshot directory")
        returner 1
    }
    linje("Snapshot comparison report written to: reports/compiler_snapshot_compare_report.txt")
    returner 0
}
