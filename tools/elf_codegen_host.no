// tools/elf_codegen_host.no — entrypoint for ein PRECOMPILED codegen-bundle.
//
// Føremål: køyre den native ARM64 ELF-codegen-en via `run-ncb-pure` (vm.no sin
// GC-aktiverte tolk) i staden for `nc run` med kjelde-rekompilering (stage0 sin
// native tolk utan effektiv GC, som toppar ~10-11 GB uansett inputstorleik).
// Når denne modulen + heile codegen-grafen er materialisert til éin NCB og
// køyrd med run-ncb-pure, held vm.no sin GC minnet bunde (som L5b-barna på
// ~300 MB) — det er vegen til å byggje full nc_main-ELF innanfor budsjett.
//
// Miljø:
//   NC_ELF_NCB — inn-bundle (NCB JSON) som skal kompilerast til ELF
//   NC_ELF_BIN — ut-sti for Linux ARM64 ELF-binæren

bruk selfhost.native_execution.elf_arm64_codegen som elfcg
bruk selfhost.ncb_serde som serde

funksjon start() -> heiltall {
    la inn = miljo_hent("NC_ELF_NCB")
    la ut = miljo_hent("NC_ELF_BIN")
    hvis inn == "" eller ut == "" {
        skriv("elf_codegen_host: NC_ELF_NCB og NC_ELF_BIN er påkravde\n")
        returner 2
    }
    skriv("[codegen-host] les " + inn + "\n")
    la p = serde.les_fil(inn)
    skriv("[codegen-host] kompilerer → " + ut + "\n")
    la r = elfcg.kompiler_ncb(p, ut)
    hvis tekst(r["ok"]) != "sann" {
        skriv("[codegen-host] KOMPILERINGSFEIL: " + tekst(r["error"]) + "\n")
        returner 1
    }
    skriv("[codegen-host] ELF OK: " + ut + "\n")
    returner 0
}
