// tools/probes/spawn_atom_kat.no — KAT for F2.1 (S1): emit_process_spawn_linux_x86_64.
//
// Før den frosne 1 999 B-blobben (rt_hex_process_spawn_linux_x86_64) vart sletta, viste
// ein tidlegare versjon av denne proben at emitteren er byte-lik blobben ETTER dei tre
// patchane (RT_MAP_KEYS @+0x13e, RT_MAP_GET @+0x184, envp-disp32 @+0x219): 1 999 B,
// 0 avvik, sha256(hex) = 000ec992…55a8 med dagens layout (TEXT_VA 0x401000, HEAP_VA 0x780000).
// No held proben den eigenskapen fast utan blobben:
//   1. dei tre symbolske felta har verdiane RT_MAP_KEYS(), RT_MAP_GET() og HEAP_VA()+ENVP_OFFSET();
//   2. med dei tre felta nulla er sha256(hex) lik blobben sin (layout-uavhengig fasit).
// Emitteren startar på offset 37 for å prøve at etikett-fiksinga er posisjonsuavhengig.
// Bruk: NORSCODE_ROOT=. ./bin/nc run tools/probes/spawn_atom_kat.no   (exit 0 = OK)
bruk selfhost.native_execution.native_codegen_v2 som cg
bruk selfhost.native_execution.heap_layout som hl

funksjon til_hex(b, fra_i: heiltall, til_i: heiltall) -> tekst {
    la siffer = "0123456789abcdef"
    la ut: liste_tekst = []
    la i: heiltall = fra_i
    mens i < til_i {
        la v: heiltall = b[i]
        legg_til(ut, builtin.slice(siffer, v >> 4, (v >> 4) + 1) + builtin.slice(siffer, v & 15, (v & 15) + 1))
        i = i + 1
    }
    returner builtin.join(ut, "")
}

// Les n LE-byte frå b[pos..] og returner verdien.
funksjon les_le(b, pos: heiltall, n: heiltall) -> heiltall {
    la v: heiltall = 0
    la i: heiltall = n - 1
    mens i >= 0 {
        v = (v << 8) | b[pos + i]
        i = i - 1
    }
    returner v
}

funksjon felt(b, base: heiltall, off: heiltall, prefiks, n: heiltall, venta: heiltall, namn: tekst) -> heiltall {
    la i: heiltall = 0
    mens i < lengde(prefiks) {
        hvis b[base + off + i] != prefiks[i] {
            skriv("spawn_atom_kat FEIL: " + namn + ": uventa opkode ved +" + tekst_fra_heltall(off) + "\n")
            returner 1
        }
        i = i + 1
    }
    la p = base + off + lengde(prefiks)
    la v = les_le(b, p, n)
    hvis v != venta {
        skriv("spawn_atom_kat FEIL: " + namn + " = " + tekst_fra_heltall(v) + ", venta " + tekst_fra_heltall(venta) + "\n")
        returner 1
    }
    i = 0
    mens i < n { b[p + i] = 0
    i = i + 1 }
    returner 0
}

funksjon start() -> heiltall {
    la base: heiltall = 37
    la ny: liste = []
    la p: heiltall = 0
    mens p < base { legg_til(ny, 204)
    p = p + 1 }
    cg.emit_process_spawn_linux_x86_64(ny)
    la n = lengde(ny) - base
    skriv("spawn_atom_kat: " + tekst_fra_heltall(n) + " B emittert\n")
    hvis n != 1999 {
        skriv("spawn_atom_kat FEIL: venta 1999 B\n")
        returner 1
    }
    la f: heiltall = 0
    f = f + felt(ny, base, 318, [72, 184], 8, cg.RT_MAP_KEYS(), "RT_MAP_KEYS")
    f = f + felt(ny, base, 388, [72, 184], 8, cg.RT_MAP_GET(), "RT_MAP_GET")
    f = f + felt(ny, base, 533, [72, 139, 4, 37], 4, hl.HEAP_VA("linux-x86_64") + hl.ENVP_OFFSET(), "envp-slot")
    hvis f != 0 { returner 1 }
    la sha = builtin.sha256(til_hex(ny, base, lengde(ny)))
    la fasit = "50b1cddad455a89d6932ae70ac9c7c1e6e66b3e67f0a63df95aef85392e77d77"
    skriv("spawn_atom_kat: sha256(hex, felt nulla) = " + sha + "\n")
    hvis sha != fasit {
        skriv("spawn_atom_kat FEIL: venta " + fasit + "\n")
        returner 1
    }
    skriv("spawn_atom_kat OK: byte-lik den tidlegare frosne blobben (1999 B, 3 symbolske felt)\n")
    returner 0
}
