// tools/probes/c3_atomics_kat.no — KAT-probe for Fase C.3 (frosne RT_*-rutiner → atomics).
// Skriv eitt deterministisk «nøkkel=verdi»-spor per operasjon slik at utdata frå
// (a) committed seed (VM/frosen runtime) og (b) fersk codegen (atomics) kan diffast
// byte for byte. Exit 0 = alle interne assertar heldt; utdata er sjølve KAT-en.
//
// Bruk (Docker linux/amd64): sh archive/legacy_shell/tools/gc_probe_run.sh tools/probes/c3_atomics_kat.no

la feil_tal = 0

funksjon sjekk(namn: tekst, fekk, venta) {
    la f = tekst(fekk)
    la v = tekst(venta)
    hvis f == v {
        skriv(namn + "=" + f + "\n")
    } ellers {
        skriv("FEIL " + namn + ": fekk «" + f + "» venta «" + v + "»\n")
        feil_tal = feil_tal + 1
    }
}

funksjon start() {
    // ── aritmetikk / samanlikning ─────────────────────────────────────────────
    la a = 7
    la b = -3
    sjekk("sub", a - b, 10)
    sjekk("mul", a * b, -21)
    sjekk("div", 17 / 5, 3)
    sjekk("div_neg", -17 / 5, -3)
    sjekk("mod", 17 % 5, 2)
    sjekk("mod_neg", -17 % 5, -2)
    sjekk("neg", -a, -7)
    sjekk("lt_int", 3 < 5, sann)
    sjekk("lt_int2", 5 < 3, usann)
    sjekk("gt_int", 5 > 3, sann)
    sjekk("le_int", 5 <= 5, sann)
    sjekk("ge_int", 4 >= 5, usann)
    sjekk("lt_str", "abc" < "abd", sann)
    sjekk("lt_str_prefix", "ab" < "abc", sann)
    sjekk("lt_str_eq", "abc" < "abc", usann)
    sjekk("le_str_eq", "abc" <= "abc", sann)
    sjekk("gt_str", "b" > "abc", sann)
    sjekk("eq_int", 5 == 5, sann)
    sjekk("ne_int", 5 != 5, usann)
    sjekk("eq_str", "hei" == "hei", sann)
    sjekk("eq_str2", "hei" == "hai", usann)
    sjekk("eq_str_len", "hei" == "heia", usann)
    sjekk("ne_str", "x" != "y", sann)
    sjekk("eq_bool", sann == sann, sann)
    sjekk("not_true", ikkje sann, usann)
    sjekk("not_zero", ikkje 0, sann)
    sjekk("not_str", ikkje "", sann)
    sjekk("not_str2", ikkje "a", usann)
    la l0 = []
    sjekk("truthy_tomliste", ikkje l0, usann)

    // ── lengde / lister ───────────────────────────────────────────────────────
    la l = [1, 2, 3]
    sjekk("lengde_liste", lengde(l), 3)
    sjekk("lengde_str", lengde("æøå"), 6)
    sjekk("lengde_tom", lengde(""), 0)
    legg_til(l, 4)
    sjekk("legg_til", tekst(l[3]) + "/" + tekst(lengde(l)), "4/4")
    la i = 0
    mens i < 20 {
        legg_til(l, i * 10)
        i = i + 1
    }
    sjekk("legg_til_vekst", tekst(lengde(l)) + ":" + tekst(l[4]) + ":" + tekst(l[23]), "24:0:190")
    la p = fjern_siste(l)
    sjekk("fjern_siste", tekst(p) + "/" + tekst(lengde(l)), "190/23")
    fjern_siste(l)
    sjekk("fjern_siste2", lengde(l), 22)
    la s = builtin.slice(l, 1, 4)
    sjekk("slice_liste", tekst(lengde(s)) + ":" + tekst(s[0]) + ":" + tekst(s[2]), "3:2:0")
    la s2 = builtin.slice(l, 20, 99)
    sjekk("slice_klamra", lengde(s2), 2)
    la s3 = builtin.slice(l, 5, 2)
    sjekk("slice_tom", lengde(s3), 0)
    l[0] = 99
    sjekk("index_set_liste", l[0], 99)
    la nested = [[1, 2], [3, [4, 5]]]
    sjekk("nested", nested[1][1][1], 5)

    // ── ordbok ────────────────────────────────────────────────────────────────
    la m = {"a": 1, "b": 2}
    m["c"] = 3
    sjekk("map_get", m["c"], 3)
    sjekk("map_len", lengde(m), 3)
    la ks = nøkler(m)
    sjekk("nokler", tekst(lengde(ks)) + ":" + ks[0] + ks[1] + ks[2], "3:abc")
    la vs = verdier(m)
    sjekk("verdier", tekst(vs[0]) + tekst(vs[1]) + tekst(vs[2]), "123")
    sjekk("finnes_nokkel", finnes_nøkkel(m, "b"), sann)
    sjekk("finnes_nokkel2", finnes_nøkkel(m, "z"), usann)
    fjern_nøkkel(m, "b")
    la ks2 = nøkler(m)
    sjekk("fjern_nokkel", tekst(lengde(ks2)) + ":" + ks2[0] + ks2[1], "2:ac")
    la stor = {}
    i = 0
    mens i < 40 {
        stor["k" + tekst(i)] = i * i
        i = i + 1
    }
    sjekk("map_stor", tekst(stor["k17"]) + "/" + tekst(lengde(nøkler(stor))) + "/" + nøkler(stor)[39], "289/40/k39")
    la tomm = {}
    sjekk("nokler_tom", lengde(nøkler(tomm)), 0)

    // ── strengar ──────────────────────────────────────────────────────────────
    sjekk("concat", "abc" + "æøå", "abcæøå")
    sjekk("concat_tom", "" + "", "")
    sjekk("concat_int", "n=" + 42, "n=42")
    sjekk("int_add_str", 42 + "x", "42x")
    sjekk("itos", tekst_fra_heltall(1234567890123), "1234567890123")
    sjekk("itos_neg", tekst_fra_heltall(-5), "-5")
    sjekk("itos_null", tekst_fra_heltall(0), "0")
    sjekk("itos_min", tekst_fra_heltall(-9223372036854775807 - 1), "-9223372036854775808")
    sjekk("stoi", heltall_fra_tekst("12345"), 12345)
    sjekk("stoi_neg", heltall_fra_tekst("-77"), -77)
    sjekk("stoi_tom", heltall_fra_tekst(""), 0)
    sjekk("stoi_sopp", heltall_fra_tekst("12ab"), 12)
    sjekk("stoi_bokstav", heltall_fra_tekst("abc"), 0)
    la deler = builtin.split("a,b,,c", ",")
    sjekk("split", tekst(lengde(deler)) + ":" + deler[0] + "|" + deler[1] + "|" + deler[2] + "|" + deler[3], "4:a|b||c")
    la deler2 = builtin.split("a,", ",")
    sjekk("split_hale", tekst(lengde(deler2)) + ":" + deler2[0] + "|" + deler2[1], "2:a|")
    la deler3 = builtin.split("", ",")
    sjekk("split_tom", tekst(lengde(deler3)) + ":" + deler3[0], "1:")
    la deler4 = builtin.split("xyz", "")
    sjekk("split_teikn", tekst(lengde(deler4)) + ":" + deler4[0] + deler4[1] + deler4[2], "3:xyz")
    la deler5 = builtin.split("ab::cd::", "::")
    sjekk("split_fleir", tekst(lengde(deler5)) + ":" + deler5[0] + "|" + deler5[1] + "|" + deler5[2], "3:ab|cd|")
    la deler6 = builtin.split("æ,ø", ",")
    sjekk("split_utf8", deler6[0] + "+" + deler6[1], "æ+ø")
    sjekk("replace", builtin.replace("aXbXc", "X", "--"), "a--b--c")
    sjekk("replace_tom_ny", builtin.replace("aXbXc", "X", ""), "abc")
    sjekk("replace_ingen", builtin.replace("abc", "X", "y"), "abc")
    sjekk("replace_tom_gamal", builtin.replace("abc", "", "y"), "abc")
    sjekk("replace_utf8", builtin.replace("æøå", "ø", "OE"), "æOEå")
    sjekk("replace_overlapp", builtin.replace("aaaa", "aa", "b"), "bb")
    sjekk("type_int", builtin.type_av(1), "heltall")
    sjekk("type_str", builtin.type_av("x"), "tekst")
    sjekk("type_liste", builtin.type_av([]), "liste")
    sjekk("type_map", builtin.type_av({}), "ordbok")
    sjekk("type_bool", builtin.type_av(sann), "boolsk")
    sjekk("type_null", builtin.type_av(null), "ingenting")
    sjekk("index_str", "hei"[1], "e")
    sjekk("index_str_oob", "hei"[7], "")
    sjekk("tekst_bool", tekst(sann), "sann")

    // ── json_parse_raw ────────────────────────────────────────────────────────
    la j = builtin.json_parse_raw("{\"a\": [1, 2, {\"b\": \"x\\ny\"}], \"c\": true, \"d\": null, \"e\": -42, \"f\": \"æøå\"}")
    sjekk("json_a1", j["a"][1], 2)
    sjekk("json_b", j["a"][2]["b"], "x\ny")
    sjekk("json_c", j["c"], sann)
    sjekk("json_d", j["d"] == null, sann)
    sjekk("json_e", j["e"], -42)
    sjekk("json_f", j["f"], "æøå")
    sjekk("json_keys", nøkler(j)[0] + nøkler(j)[4], "af")
    la j2 = builtin.json_parse_raw("  [ ]  ")
    sjekk("json_tomliste", lengde(j2), 0)
    la j3 = builtin.json_parse_raw("{}")
    sjekk("json_tommap", lengde(nøkler(j3)), 0)
    la j4 = builtin.json_parse_raw("\"a\\\"b\\\\c\\/d\\td\"")
    sjekk("json_escapes", j4, "a\"b\\c/d\td")
    la j5 = builtin.json_parse_raw("12.75")
    sjekk("json_desimal", j5, 12)
    la j6 = builtin.json_parse_raw("[1e3, false, \"\"]")
    sjekk("json_eksp", tekst(j6[0]) + "/" + tekst(j6[1]) + "/" + tekst(lengde(j6[2])), "1/usann/0")
    la j7 = builtin.json_parse_raw("[[[[1]]]]")
    sjekk("json_nosta", j7[0][0][0][0], 1)

    // ── miljø / fil ───────────────────────────────────────────────────────────
    sjekk("miljo_tom", miljo_hent("NORSCODE_C3_FINST_IKKJE_XYZ"), "")
    sjekk("miljo_finnes_ikkje", miljo_finnes("NORSCODE_C3_FINST_IKKJE_XYZ"), usann)
    sjekk("miljo_path", lengde(miljo_hent("PATH")) > 0, sann)
    sjekk("miljo_finnes_path", miljo_finnes("PATH"), sann)
    miljo_sett("NORSCODE_C3_OVERLAY", "ja")
    sjekk("miljo_overlay", miljo_hent("NORSCODE_C3_OVERLAY"), "ja")
    la sti = "/tmp/c3_probe_" + tekst(builtin.now_ms()) + ".txt"
    fil_skriv(sti, "linje1\nlinje2 æøå\n")
    sjekk("fil_les", fil_les(sti), "linje1\nlinje2 æøå\n")
    fil_skriv_binær(sti, [72, 105, 10])
    sjekk("fil_binar", fil_les(sti), "Hi\n")
    fil_skriv(sti, "")
    sjekk("fil_tom", fil_les(sti), "")
    fil_slett(sti)
    sjekk("fil_manglar", fil_finnes(sti), usann)

    skriv("feil_tal=" + tekst(feil_tal) + "\n")
    hvis feil_tal > 0 { stopp(1) }
    stopp(0)
}
