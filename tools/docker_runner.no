// Strukturert Docker-overgang for Norscode-eigde plattformprober.
// Modulen byggjer aldri shelltekst; alle kall brukar executable/argv.

bruk std.prosess som system_prosess
bruk tools.process_runner som prosess

funksjon finn() -> tekst { returner system_prosess.finn_kjorbar("docker") }

funksjon tilgjengeleg(docker: tekst, cwd: tekst) -> boolsk {
    hvis docker == "" { returner usann }
    returner prosess.ok(prosess.køyr(docker, ["info"], cwd, {}, 30000))
}

funksjon opprett(docker: tekst, cwd: tekst, vertsrot: tekst,
                  platform: tekst, image: tekst, tag: tekst) -> tekst {
    la resultat = prosess.køyr(docker,
        ["create", "--platform", platform, "--label", "norscode.owner=" + tag,
         "-v", vertsrot + ":/work", "-w", "/work", image,
         "/bin/sleep", "infinity"], cwd, {}, 120000)
    hvis ikkje prosess.ok(resultat) {
        prosess.skriv_resultat(resultat)
        returner ""
    }
    // Eldre stage0 serialiserer prosesslinjeskift som dei bokstavlege teikna
    // "\\n". Ein container-ID må normaliserast før han blir brukt som argv.
    la stdout = builtin.replace(tekst(resultat["stdout"]), "\\n", "\n")
    stdout = builtin.replace(stdout, "\\r", "\r")
    returner builtin.trim(stdout)
}

funksjon opprett_ubuntu(docker: tekst, cwd: tekst, vertsrot: tekst,
                         platform: tekst, tag: tekst) -> tekst {
    returner opprett(docker, cwd, vertsrot, platform, "ubuntu:24.04", tag)
}

funksjon start(docker: tekst, cwd: tekst, container: tekst) -> boolsk {
    la resultat = prosess.køyr(docker, ["start", container], cwd, {}, 30000)
    hvis prosess.ok(resultat) { returner sann }
    prosess.skriv_resultat(resultat)
    returner usann
}

funksjon køyr_i(docker: tekst, cwd: tekst, container: tekst,
                 argv: liste_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la args: liste_tekst = ["exec", container]
    la i = 0
    mens i < lengde(argv) { legg_til(args, argv[i]) i = i + 1 }
    returner prosess.køyr(docker, args, cwd, {}, timeout_ms)
}

funksjon installer_pakkar(docker: tekst, cwd: tekst, container: tekst,
                           pakkar: liste_tekst) -> boolsk {
    la update = køyr_i(docker, cwd, container, ["apt-get", "update"], 600000)
    hvis ikkje prosess.ok(update) {
        prosess.skriv_resultat(update)
        returner usann
    }
    la argv: liste_tekst = ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y"]
    la i = 0
    mens i < lengde(pakkar) { legg_til(argv, pakkar[i]) i = i + 1 }
    la install = køyr_i(docker, cwd, container, argv, 600000)
    hvis prosess.ok(install) { returner sann }
    prosess.skriv_resultat(install)
    returner usann
}

funksjon installer_sqlite_runtime(docker: tekst, cwd: tekst,
                                   container: tekst) -> boolsk {
    returner installer_pakkar(docker, cwd, container, ["libsqlite3-0"])
}

funksjon fjern(docker: tekst, cwd: tekst, container: tekst) -> heiltall {
    hvis container != "" { prosess.køyr(docker, ["rm", "-f", container], cwd, {}, 30000) }
    returner 0
}
