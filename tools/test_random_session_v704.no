// tools/test_random_session_v704.no — røykprøve for random-session-endepunkt

bruk std.http som http

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hent(url: tekst, cookie: tekst) -> tekst {
    la headers: ordbok_tekst = {}
    hvis cookie != "" { headers["Cookie"] = cookie }
    la res = http.get(url, headers, {}, 10000)
    skriv(res + "\n")
    hvis http.response_status(res) < 200 eller http.response_status(res) >= 400 { returner "" }
    returner res
}

funksjon session_cookie(response: tekst) -> tekst {
    la cookie = http.response_header(response, "set-cookie")
    la semikolon = builtin.index_of(cookie, ";")
    hvis semikolon >= 0 { cookie = builtin.slice(cookie, 0, semikolon) }
    returner cookie
}

funksjon start() -> heiltall {
    la port = env("NORSCODE_RANDOM_SESSION_PORT")
    hvis port == "" { port = "8118" }
    la base = "http://127.0.0.1:" + port

    linje("== login demo ==")
    la login = hent(base + "/random-login-demo", "")
    hvis login == "" { returner 1 }
    la cookie = session_cookie(login)
    hvis cookie == "" { returner 1 }
    linje("")
    linje("== status ==")
    hvis hent(base + "/random-status", cookie) == "" { returner 1 }
    linje("")
    linje("== admin ==")
    hvis hent(base + "/random-admin", cookie) == "" { returner 1 }
    linje("")
    linje("== logout ==")
    hvis hent(base + "/random-logout", cookie) == "" { returner 1 }
    linje("")
    linje("== status etter logout ==")
    hvis hent(base + "/random-status", "") == "" { returner 1 }
    returner 0
}
