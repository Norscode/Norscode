// Shellfri native runtime-gap-port.

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon executable(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis sti == "" { returner root + "/dist/norscode_native" }
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon køyr_probe(root: tekst, bin_path: tekst, probe: tekst) -> ordbok_tekst {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "PATH": "/nonexistent"
    }
    returner prosess.køyr(bin_path, ["run", probe], root, miljø, 120000)
}

funksjon samla_output(resultat: ordbok_tekst) -> tekst {
    returner tekst(resultat["stdout"]) + tekst(resultat["stderr"])
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la bin_path = abs_sti(root, env("NORSCODE_NATIVE_GAP_BIN"))
    hvis ikkje executable(bin_path) {
        linje("[FAIL] native-binær manglar eller er ikkje køyrbar: " + bin_path)
        returner 1
    }

    linje("== native runtime gap gate v3001 ==")
    linje("binær: " + bin_path)
    la runtime = køyr_probe(root, bin_path, root + "/tests/native_runtime_gap_probe_v3001.no")
    la upload = køyr_probe(root, bin_path, root + "/tests/opplasting_mappe_gap_probe.no")
    la out = samla_output(runtime) + samla_output(upload)
    hvis ikkje prosess.ok(runtime) eller ikkje prosess.ok(upload) {
        skriv(out)
        linje("[FAIL] minst éin runtime-gap-probe feila")
        returner 1
    }
    hvis builtin.index_of(out, "FEIL") >= 0 {
        skriv(out)
        linje("[FAIL] runtime-gap står att i aktiv binær")
        returner 1
    }
    hvis builtin.index_of(out, "random_hex OK") < 0 {
        linje("[FAIL] random_hex vart ikkje verifisert")
        returner 1
    }
    hvis builtin.index_of(out, "mappe_opprett OK") < 0 {
        linje("[FAIL] mappe_opprett vart ikkje verifisert")
        returner 1
    }
    hvis builtin.index_of(out, "opplasting_mappe OK") < 0 {
        linje("[FAIL] opplasting_mappe vart ikkje verifisert")
        returner 1
    }
    linje("[OK] runtime-gap gate er grønn for " + bin_path)
    returner 0
}
