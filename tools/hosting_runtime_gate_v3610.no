// Samla release-gate for DNS, ACME, mailserver, domenehost og brannmur.

bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    la bin = env("NORSCODE_HOSTING_RUNTIME_BIN")
    hvis root == "" eller bin == "" {
        skriv("[FAIL] NORSCODE_ROOT og NORSCODE_HOSTING_RUNTIME_BIN er påkravde\n")
        returner 1
    }
    la testar = [
        "tests/test_tls_acme_contract.no",
        "tests/test_dns_zone_validation.no",
        "tests/test_domenehost_security_contract.no",
        "tests/test_future_hosting_foundation.no"
    ]
    la i: heiltall = 0
    mens i < lengde(testar) {
        la testfil = testar[i]
        la miljø = {
            "NC_TEST_FILE": testfil,
            "NC_NATIVE": bin,
            "NC_VERBOSE": "1",
            "NORSCODE_ROOT": root,
            "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write,net.dns,net.listen,net.connect,net.tls",
            "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
        }
        la res = prosess.køyr(root + "/bin/nc", ["test"], root, miljø, 600000)
        hvis ikkje prosess.ok(res) eller builtin.index_of(tekst(res["stdout"]), "Alle testar bestått") < 0 {
            skriv("[FAIL] hosting gate: " + testfil + "\n")
            prosess.skriv_resultat(res)
            returner 1
        }
        skriv("[OK] " + testfil + "\n")
        i = i + 1
    }
    skriv("[OK] hosting runtime gate v3610 er grøn\n")
    returner 0
}
