// Shellfri, kontrollert runtime-promotering med eksplisitt godkjenning.
bruk std.filops som filops
bruk std.platform som platform
bruk std.sha256 som sha256
bruk tools.process_runner som prosess
bruk tools.runtime_promotion_core som promotion

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon rot() -> tekst {
    la r = env("NORSCODE_ROOT")
    hvis r != "" { returner r }
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon relativ_sti(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner filops.relativ_sti(root, sti) }
    returner filops.normaliser_sti(sti)
}

funksjon stage0_relativ() -> tekst {
    la os = platform.system()
    la arch = builtin.lower(platform.maskin())
    hvis os == "Darwin" og arch == "arm64" { returner "bootstrap/stage0/norscode-macos-arm64" }
    hvis os == "Darwin" og (arch == "x86_64" eller arch == "amd64") { returner "bootstrap/stage0/norscode-macos-x86_64" }
    hvis os == "Linux" og (arch == "x86_64" eller arch == "amd64") { returner "bootstrap/stage0/norscode-linux-x86_64" }
    hvis os == "Linux" og (arch == "aarch64" eller arch == "arm64") { returner "bootstrap/stage0/norscode-linux-arm64" }
    hvis platform.er_windows() { returner "bootstrap/stage0/norscode-windows-x86_64.exe" }
    returner ""
}

funksjon hash_fil(sti: tekst) -> tekst {
    hvis sti == "" eller ikkje filops.fil_finnes(sti) { returner "missing" }
    la bytes = builtin.fil_les_binær(sti)
    prøv { returner builtin.sha256_bytes(bytes) } fang (e) { }
    prøv { returner sha256.hash_bytes(bytes) } fang (e2) { returner "error" }
    returner "error"
}

funksjon miljø(root: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.",
        "PATH": "/nonexistent"
    }
}

funksjon køyr(host: tekst, root: tekst, fil: tekst,
              ekstra: ordbok_tekst, timeout: heiltall) -> ordbok_tekst {
    la m = miljø(root)
    la keys = builtin.nøkler(ekstra)
    la i: heiltall = 0
    mens i < lengde(keys) { la k = tekst(keys[i]); m[k] = tekst(ekstra[k]); i = i + 1 }
    returner prosess.køyr(host, ["run", root + "/" + fil], root, m, timeout)
}

funksjon har(r: ordbok_tekst, markør: tekst) -> boolsk {
    returner builtin.index_of(tekst(r["stdout"]) + tekst(r["stderr"]), markør) >= 0
}

funksjon grønn(r: ordbok_tekst, markør: tekst) -> boolsk {
    returner prosess.ok(r) og har(r, markør)
}

funksjon no_line(key: tekst, value: tekst) -> tekst {
    la v = builtin.replace(value, "\n", " ")
    v = builtin.replace(v, "\"", "'")
    returner "controlled_runtime_promotion(\"" + key + "\", \"" + v + "\")\n"
}

funksjon rapport(root: tekst, candidate: tekst, stage0: tekst, status: tekst,
                 decision: tekst, before_dist: tekst, after_dist: tekst,
                 before_stage0: tekst, after_stage0: tekst,
                 candidate_status: tekst, active_before: tekst,
                 active_after: tekst, dry_run: boolsk) -> boolsk {
    la body = no_line("schema", "norscode.controlled_runtime_promotion.v3005")
    body = body + no_line("status", status) + no_line("decision", decision)
    body = body + no_line("candidate", candidate) + no_line("candidate_gate_status", candidate_status)
    body = body + no_line("active_runtime_gate_before", active_before)
    body = body + no_line("active_runtime_gate_after", active_after)
    body = body + no_line("dist_sha256_before", before_dist) + no_line("dist_sha256_after", after_dist)
    body = body + no_line("stage0", stage0) + no_line("stage0_sha256_before", before_stage0)
    body = body + no_line("stage0_sha256_after", after_stage0)
    body = body + no_line("confirm_required", "godkjenn kritisk runtime-promotering")
    hvis dry_run { body = body + no_line("dry_run", "1") } ellers { body = body + no_line("dry_run", "0") }
    body = body + no_line("updated_at_ms", tekst_fra_heltall(builtin.now_ms()))
    prøv { fil_skriv(root + "/docs/controlled_runtime_promotion_v3005.no", body) } fang (e) { returner usann }
    skriv(body)
    returner sann
}

funksjon gjenopprett(root: tekst, target: tekst, r: ordbok_tekst) -> boolsk {
    la rollback = tekst(r["rollback_relative"])
    la hash = tekst(r["rollback_sha256"])
    hvis rollback == "" eller hash == "" { returner usann }
    returner promotion.gjenopprett(root, target, rollback, hash)["status"] == "restored"
}

funksjon start() -> heiltall {
    la root = rot()
    la candidate_input = env("NORSCODE_PROMOTION_CANDIDATE")
    hvis candidate_input == "" { candidate_input = "build/v3010/norscode_native_macos_arm64_v3010" }
    la candidate = abs_sti(root, candidate_input)
    la candidate_rel = relativ_sti(root, candidate_input)
    la dist_rel = "dist/norscode_native"
    la dist = root + "/" + dist_rel
    la stage_rel = stage0_relativ()
    la stage = abs_sti(root, stage_rel)
    la dry_run = builtin.lower(env("NORSCODE_PROMOTION_DRY_RUN")) == "sann" eller env("NORSCODE_PROMOTION_DRY_RUN") == "1"
    la before_dist = hash_fil(dist)
    la before_stage = hash_fil(stage)
    hvis candidate_rel == "" eller builtin.starts_with(candidate_rel, "../") eller
       ikkje filops.fil_finnes(candidate) eller stage_rel == "" { returner 2 }

    la gap_env: ordbok_tekst = {"NORSCODE_NATIVE_GAP_BIN": candidate}
    la candidate_gate = køyr(candidate, root, "tools/native_runtime_gap_gate_v3001.no", gap_env, 600000)
    la fs_gate = køyr(candidate, root, "tests/test_native_filesystem_list.no", {}, 300000)
    la media_env: ordbok_tekst = {"NORSCODE_MEDIA_RUNTIME_BIN": candidate}
    la media_gate = køyr(candidate, root, "tools/native_media_runtime_gate_v3010.no", media_env, 1200000)
    la active_env: ordbok_tekst = {"NORSCODE_NATIVE_GAP_BIN": dist}
    la active_gate = køyr(candidate, root, "tools/native_runtime_gap_gate_v3001.no", active_env, 600000)
    la readiness_env: ordbok_tekst = {"NORSCODE_PROMOTION_CANDIDATE": candidate}
    la readiness = køyr(candidate, root, "tools/native_runtime_gap_promotion_readiness_v3003.no", readiness_env, 1200000)
    la dry_dist_env: ordbok_tekst = {"NORSCODE_PROMOTE_CANDIDATE": candidate_rel, "NORSCODE_PROMOTE_DIST": "1", "NORSCODE_PROMOTE_STAGE0": "0", "NORSCODE_PROMOTE_DRY_RUN": "1"}
    la dry_stage_env: ordbok_tekst = {"NORSCODE_PROMOTE_CANDIDATE": candidate_rel, "NORSCODE_PROMOTE_DIST": "0", "NORSCODE_PROMOTE_STAGE0": "1", "NORSCODE_PROMOTE_DRY_RUN": "1"}
    la dry_dist = køyr(candidate, root, "tools/promote_native_stage0_v3001.no", dry_dist_env, 600000)
    la dry_stage = køyr(candidate, root, "tools/promote_native_stage0_v3001.no", dry_stage_env, 600000)

    la candidate_ok = grønn(candidate_gate, "runtime-gap gate er grønn") og
        grønn(fs_gate, "native filesystem.list OK") og
        grønn(media_gate, "native media runtime gate v3010 er grønn")
    // Process-ABI-en kan bevare JSON-escape rundt sitatteikn i nøsta stdout.
    // Beslutningsverdiane er eintydige og blir derfor matcha direkte.
    la readiness_ok = grønn(readiness, "ready_for_controlled_promotion") eller
        grønn(readiness, "already_promoted_or_active_green")
    la dry_ok = grønn(dry_dist, "[DRY-RUN] ingen filer vart endra") og
        grønn(dry_stage, "[DRY-RUN] ingen filer vart endra")
    la active_before = "red_detected"
    hvis grønn(active_gate, "runtime-gap gate er grønn") { active_before = "green" }
    hvis ikkje candidate_ok eller ikkje readiness_ok eller ikkje dry_ok {
        la kandidatstatus = "red"
        hvis candidate_ok { kandidatstatus = "green" }
        rapport(root, candidate, stage, "red", "preflight_failed_no_promotion", before_dist, hash_fil(dist), before_stage, hash_fil(stage), kandidatstatus, active_before, "not_run", dry_run)
        prosess.skriv_resultat(candidate_gate); prosess.skriv_resultat(fs_gate); prosess.skriv_resultat(media_gate); prosess.skriv_resultat(readiness)
        returner 1
    }
    hvis dry_run {
        rapport(root, candidate, stage, "green", "dry_run_green_no_promotion", before_dist, hash_fil(dist), before_stage, hash_fil(stage), "green", active_before, "not_run", sann)
        returner 0
    }
    hvis env("NORSCODE_PROMOTION_CONFIRM") != "godkjenn kritisk runtime-promotering" {
        rapport(root, candidate, stage, "blocked", "missing_exact_confirmation", before_dist, hash_fil(dist), before_stage, hash_fil(stage), "green", active_before, "not_run", usann)
        returner 2
    }

    la dist_result = promotion.promoter(root, candidate_rel, dist_rel, "build/verified-rollback/runtime-promotion", "controlled-dist")
    hvis dist_result["status"] != "promoted" { returner 1 }
    la stage_result = promotion.promoter(root, candidate_rel, stage_rel, "build/verified-rollback/runtime-promotion", "controlled-stage0")
    hvis stage_result["status"] != "promoted" { gjenopprett(root, dist_rel, dist_result); returner 1 }
    la after_gate = køyr(candidate, root, "tools/native_runtime_gap_gate_v3001.no", {"NORSCODE_NATIVE_GAP_BIN": dist}, 600000)
    hvis ikkje grønn(after_gate, "runtime-gap gate er grønn") {
        gjenopprett(root, dist_rel, dist_result)
        gjenopprett(root, stage_rel, stage_result)
        rapport(root, candidate, stage, "red", "post_gate_failed_rolled_back", before_dist, hash_fil(dist), before_stage, hash_fil(stage), "green", active_before, "red", usann)
        returner 1
    }
    rapport(root, candidate, stage, "green", "controlled_promotion_complete", before_dist, hash_fil(dist), before_stage, hash_fil(stage), "green", active_before, "green", usann)
    returner 0
}
