// Shellfri, kontrollert promotering av ein fullt verifisert native-kandidat.

bruk std.filops som filops
bruk std.platform som platform
bruk tools.process_runner som prosess
bruk tools.runtime_promotion_core som promotion

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon les_fil_trygt(sti: tekst) -> tekst {
    prøv { returner builtin.fil_les(sti) } fang (e) { returner "" }
    returner ""
}

funksjon argfil_verdi(namn: tekst) -> tekst {
    la path = env("NORSCODE_PROMOTE_ARGS_FILE")
    hvis path == "" { path = "/tmp/norscode_promote_native_stage0_v3001.env" }
    la prefix = namn + "="
    la linjer = builtin.split(les_fil_trygt(path), "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) {
        hvis builtin.starts_with(linjer[i], prefix) {
            returner builtin.trim(builtin.slice(linjer[i], lengde(prefix), lengde(linjer[i])))
        }
        i = i + 1
    }
    returner ""
}

funksjon env_eller_arg(namn: tekst, arg_namn: tekst) -> tekst {
    la v = env(namn)
    hvis v != "" { returner v }
    returner argfil_verdi(arg_namn)
}

funksjon flagg_på(v: tekst) -> boolsk {
    la normal = builtin.lower(builtin.trim(v))
    returner normal == "1" eller normal == "sann" eller normal == "true"
}

funksjon candidate_relativ(root: tekst, sti: tekst) -> tekst {
    hvis sti == "" { returner "" }
    hvis builtin.starts_with(sti, "/") { returner filops.relativ_sti(root, sti) }
    returner filops.normaliser_sti(sti)
}

funksjon platform_name() -> tekst {
    la os = platform.system()
    la arch = builtin.lower(platform.maskin())
    hvis os == "Darwin" og arch == "arm64" { returner "macos-arm64" }
    hvis os == "Darwin" og (arch == "x86_64" eller arch == "amd64") { returner "macos-x86_64" }
    hvis os == "Linux" og (arch == "x86_64" eller arch == "amd64") { returner "linux-x86_64" }
    hvis os == "Linux" og (arch == "aarch64" eller arch == "arm64") { returner "linux-arm64" }
    hvis platform.er_windows() og (arch == "x86_64" eller arch == "amd64") { returner "windows-x86_64" }
    returner ""
}

funksjon gate_ok(root: tekst, candidate: tekst) -> boolsk {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_NATIVE_GAP_BIN": candidate,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "PATH": "/nonexistent"
    }
    la resultat = prosess.køyr(candidate,
        ["run", root + "/tools/native_runtime_gap_gate_v3001.no"],
        root, miljø, 300000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat) og
        builtin.index_of(tekst(resultat["stdout"]), "[OK] runtime-gap gate er grønn") >= 0
}

funksjon skriv_promotion_resultat(label: tekst, r: ordbok_tekst) -> boolsk {
    hvis r["status"] != "promoted" {
        linje("Feil: " + label + "-promotering feila: " + tekst(r["error"]))
        returner usann
    }
    linje("[OK] " + label + " kandidat_sha256=" + tekst(r["candidate_sha256"]))
    hvis tekst(r["rollback_relative"]) != "" {
        linje("[OK] verifisert rollback=" + tekst(r["rollback_relative"]))
        linje("[OK] rollback_sha256=" + tekst(r["rollback_sha256"]))
    }
    linje("[OK] promotion_manifest=" + tekst(r["manifest_relative"]))
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la candidate_rel = candidate_relativ(root,
        env_eller_arg("NORSCODE_PROMOTE_CANDIDATE", "candidate"))
    la promote_dist = flagg_på(env_eller_arg("NORSCODE_PROMOTE_DIST", "dist"))
    la promote_stage0 = flagg_på(env_eller_arg("NORSCODE_PROMOTE_STAGE0", "stage0"))
    la dry_run = flagg_på(env_eller_arg("NORSCODE_PROMOTE_DRY_RUN", "dry_run"))
    hvis candidate_rel == "" eller builtin.starts_with(candidate_rel, "../") {
        linje("Feil: kandidaten må liggje under eksplisitt NORSCODE_ROOT")
        returner 2
    }
    la candidate = root + "/" + candidate_rel
    hvis ikkje filops.fil_finnes(candidate) {
        linje("Feil: kandidat finst ikkje: " + candidate)
        returner 2
    }
    hvis ikkje promote_dist og ikkje promote_stage0 {
        linje("Feil: vel --dist og/eller --stage0")
        returner 2
    }

    linje("== v3001 shellfri native/stage0 promotion gate ==")
    linje("candidate: " + candidate)
    hvis ikkje gate_ok(root, candidate) { returner 1 }
    la plattform = platform_name()
    hvis promote_stage0 og plattform == "" {
        linje("Feil: ukjend plattform")
        returner 1
    }
    hvis dry_run {
        linje("[DRY-RUN] runtime-gap-gate er grønn")
        hvis promote_dist { linje("[DRY-RUN] ville promotert atomisk til dist/norscode_native") }
        hvis promote_stage0 { linje("[DRY-RUN] ville promotert atomisk til bootstrap/stage0/norscode-" + plattform) }
        linje("[DRY-RUN] ville bevart førre runtime som SHA-256-verifisert rollback-artefakt")
        linje("[DRY-RUN] ingen filer vart endra")
        returner 0
    }

    la rollback_dir = "build/verified-rollback/runtime-promotion"
    la dist_resultat: ordbok_tekst = {}
    hvis promote_dist {
        dist_resultat = promotion.promoter(root, candidate_rel, "dist/norscode_native",
                                            rollback_dir, "dist-norscode-native")
        hvis ikkje skriv_promotion_resultat("dist/norscode_native", dist_resultat) { returner 1 }
    }
    hvis promote_stage0 {
        la suffix = ""
        hvis builtin.starts_with(plattform, "windows-") { suffix = ".exe" }
        la target = "bootstrap/stage0/norscode-" + plattform + suffix
        la stage0_resultat = promotion.promoter(root, candidate_rel, target,
                                                rollback_dir, "stage0-" + plattform)
        hvis ikkje skriv_promotion_resultat(target, stage0_resultat) {
            hvis promote_dist og tekst(dist_resultat["rollback_relative"]) != "" {
                la restored = promotion.gjenopprett(root, "dist/norscode_native",
                    tekst(dist_resultat["rollback_relative"]), tekst(dist_resultat["rollback_sha256"]))
                hvis restored["status"] == "restored" { linje("[OK] dist vart rulla tilbake etter stage0-feil") }
                ellers { linje("[KRITISK] automatisk dist-rollback feila: " + tekst(restored["error"])) }
            }
            returner 1
        }
    }
    linje("[OK] v3001 atomisk promotering ferdig etter runtime-gap-gate")
    returner 0
}
