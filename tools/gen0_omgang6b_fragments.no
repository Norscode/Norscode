// tools/gen0_omgang6b_fragments.no — Gen0-fragment for Omgang 6b frå KJELDE med seeden (J2)
//
// Erstattar dei tidlegare committa bootstrap/precompiled_fragments_inner/*.functions.json.
// Fragmenta for dei åtte kompilatormodulane blir genererte til build/6b/fragments_gen0/
// (overstyr med NORSCODE_OMGANG6B_GEN0_DIR) og sende vidare til
// tools/build_omgang6b_compiler_ncb.no via NORSCODE_OMGANG6B_FRAGMENT_DIR.
//
// Gen0 treng ikkje vere eit fikspunkt. tools/selfcompile_stage0_elf.no byggjer
// Gen1 = ELF(Gen0), Gen2 = Gen1(kjelde), Gen3 = ELF(Gen2)(kjelde) og krev Gen2 == Gen3.
//
// To modusar (NORSCODE_OMGANG6B_GEN0_MODE):
//   kjelde       Seeden køyrer kjeldekompilatoren (tools/gen1_source_entry.no) éin gong per
//                modul og skriv per-modul-NCB med endeleg modulnamn. Fragmenta blir skorne
//                ut som tekst (NORSCODE_FRAGMENT_SOURCE_NATIVE=1), byte for byte slik
//                kompilatoren skreiv dei. Standard på Linux x86-64 (fersk sjølvhosta seed).
//   seed-bundle  Éin `nc compile selfhost/elf_compile_driver.no` med den innebygde
//                kompilatoren til seeden. Bunten har alle åtte modulane, og
//                regenerate_omgang6b_fragments_safe.no deler han per modulprefiks
//                (NORSCODE_FRAGMENT_BUNDLE). Standard elles: C-æra-seedane (macOS, Windows,
//                linux-arm64) tolkar kjeldekompilatoren altfor sakte (lexer_m1 > 15 min).

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon bytes(sti: tekst) -> heiltall {
    prøv { returner lengde(builtin.fil_les_binær(sti)) } fang (e) { returner 0 }
    returner 0
}

funksjon nc_miljø(root: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_ROOT": root,
        "NORSCODE_RUN_CACHE": "0"
    }
}

funksjon run_nc_med_miljø(root: tekst, argv: liste_tekst, miljø: ordbok_tekst,
                           timeout_ms: heiltall) -> boolsk {
    la resultat = prosess.køyr_med_grenser(root + "/bin/nc", argv, root,
        miljø, timeout_ms, 0, 1024)
    prosess.skriv_resultat(resultat)
    hvis prosess.ok(resultat) { returner sann }
    linje("[FEIL] nc status=" + tekst(resultat["status"]) + " exit=" +
          tekst(resultat["exit_code"]) + " error=" + tekst(resultat["error"]))
    returner usann
}

// kjelde|modul|fragmentnamn — same rekkjefølgje som build_omgang6b_compiler_ncb.no.
funksjon modulspesifikasjonar() -> liste_tekst {
    returner builtin.split(
        "selfhost/lexer/lexer_m1.no|selfhost.lexer.lexer_m1|lexer_m1\n" +
        "selfhost/parser.no|selfhost.parser|parser\n" +
        "selfhost/compiler/semantic.no|selfhost.compiler.semantic|semantic\n" +
        "selfhost/compiler/ir_to_bytecode.no|selfhost.compiler.ir_to_bytecode|ir_to_bytecode\n" +
        "selfhost/json.no|selfhost.json|json\n" +
        "selfhost/kompiler.no|selfhost.kompiler|kompiler\n" +
        "selfhost/bundler.no|selfhost.bundler|bundler\n" +
        "selfhost/elf_compile_driver.no|selfhost.elf_compile_driver|elf_compile_driver",
        "\n")
}

funksjon standard_modus() -> tekst {
    la valt = env("NORSCODE_OMGANG6B_GEN0_MODE")
    hvis valt != "" { returner valt }
    la os = env("RUNNER_OS")
    la arch = builtin.lower(env("RUNNER_ARCH"))
    hvis os == "" eller arch == "" {
        // C-æra-seedar kan mangle system_info. Då er seed-bundle det trygge valet.
        prøv {
            la info = builtin.system_info()
            hvis os == "" { os = tekst(info["system"]) }
            hvis arch == "" { arch = builtin.lower(tekst(info["machine"])) }
        } fang (e) { }
    }
    hvis os == "Linux" og (arch == "x64" eller arch == "x86_64" eller arch == "amd64") {
        returner "kjelde"
    }
    returner "seed-bundle"
}

funksjon gen0_kjelde(root: tekst, ncb_dir: tekst) -> boolsk {
    la specs = modulspesifikasjonar()
    la i = 0
    mens i < lengde(specs) {
        la delar = builtin.split(specs[i], "|")
        la ut = ncb_dir + "/" + delar[2] + ".ncb.json"
        filops.slett_fil(ut)
        la miljø = nc_miljø(root)
        miljø["NORSCODE_CMD"] = "run"
        miljø["NORSCODE_FILE"] = root + "/tools/gen1_source_entry.no"
        miljø["NORSCODE_GEN1_SOURCE_FILE"] = root + "/" + delar[0]
        miljø["NORSCODE_GEN1_OUTPUT_FILE"] = ut
        miljø["NORSCODE_GEN1_MODULE"] = delar[1]
        miljø["NORSCODE_GEN1_PROGRESS_FILE"] = ut + ".progress"
        hvis ikkje run_nc_med_miljø(root, ["run", root + "/tools/gen1_source_entry.no"], miljø, 1800000) {
            linje("  [FEIL] Gen0 kjeldekompilering feila for " + delar[0])
            returner usann
        }
        hvis bytes(ut) == 0 {
            linje("  [FEIL] Gen0 kjeldekompilering skreiv ikkje " + ut)
            returner usann
        }
        linje("  [OK] Gen0 " + delar[0] + " -> " + delar[2] + ".ncb.json (" +
              tekst_fra_heltall(bytes(ut)) + " bytes)")
        i = i + 1
    }
    returner sann
}

funksjon gen0_seed_bundle(root: tekst, bunt: tekst) -> boolsk {
    filops.slett_fil(bunt)
    la kjelde = root + "/selfhost/elf_compile_driver.no"
    la miljø = nc_miljø(root)
    miljø["NORSCODE_CMD"] = "compile"
    miljø["NORSCODE_FILE"] = kjelde
    miljø["NORSCODE_OUTPUT"] = bunt
    miljø["NORSCODE_MODULE"] = "selfhost.elf_compile_driver"
    hvis ikkje run_nc_med_miljø(root, ["compile", kjelde, bunt], miljø, 1800000) {
        linje("  [FEIL] Gen0 seed-kompilering av selfhost/elf_compile_driver.no feila")
        returner usann
    }
    hvis bytes(bunt) == 0 {
        linje("  [FEIL] Gen0 seed-kompilering skreiv ikkje " + bunt)
        returner usann
    }
    linje("  [OK] Gen0 seed-bunt " + bunt + " (" + tekst_fra_heltall(bytes(bunt)) + " bytes)")
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la inner_dir = env("NORSCODE_OMGANG6B_GEN0_DIR")
    hvis inner_dir == "" { inner_dir = root + "/build/6b/fragments_gen0" }
    la work = root + "/build/6b/gen0"
    la ncb_dir = work + "/ncb"
    la outer_dir = work + "/fragments"
    la bunt = work + "/elf_compile_driver_bundle.ncb.json"
    la modus = standard_modus()
    hvis modus != "kjelde" og modus != "seed-bundle" {
        linje("[FEIL] ukjend NORSCODE_OMGANG6B_GEN0_MODE=" + modus + " (kjelde|seed-bundle)")
        returner 2
    }
    hvis ikkje filops.lag_katalogar(ncb_dir) eller ikkje filops.lag_katalogar(outer_dir) eller
       ikkje filops.lag_katalogar(inner_dir) { returner 1 }
    // Gamle fragment må aldri overleve ei mislukka generering.
    la specs = modulspesifikasjonar()
    la i = 0
    mens i < lengde(specs) {
        la spec_delar = builtin.split(specs[i], "|")
        la namn = spec_delar[2] + ".functions.json"
        filops.slett_fil(inner_dir + "/" + namn)
        filops.slett_fil(outer_dir + "/" + namn)
        i = i + 1
    }

    linje("Gen0 Omgang 6b-fragment frå kjelde (modus " + modus + ") -> " + inner_dir)
    la regen = nc_miljø(root)
    regen["NORSCODE_FRAGMENT_NCB_DIR"] = ncb_dir
    regen["NORSCODE_FRAGMENT_OUTER_DIR"] = outer_dir
    regen["NORSCODE_FRAGMENT_INNER_DIR"] = inner_dir
    hvis modus == "kjelde" {
        hvis ikkje gen0_kjelde(root, ncb_dir) { returner 1 }
        regen["NORSCODE_FRAGMENT_SOURCE_NATIVE"] = "1"
    } ellers {
        hvis ikkje gen0_seed_bundle(root, bunt) { returner 1 }
        regen["NORSCODE_FRAGMENT_BUNDLE"] = bunt
    }
    regen["NORSCODE_CMD"] = "run"
    regen["NORSCODE_FILE"] = root + "/tools/regenerate_omgang6b_fragments_safe.no"
    hvis ikkje run_nc_med_miljø(root, ["run", root + "/tools/regenerate_omgang6b_fragments_safe.no"], regen, 900000) {
        linje("  [FEIL] Gen0 fragment-regenerering feila")
        returner 1
    }
    i = 0
    mens i < lengde(specs) {
        la spec_delar = builtin.split(specs[i], "|")
        la namn = spec_delar[2] + ".functions.json"
        hvis bytes(inner_dir + "/" + namn) == 0 {
            linje("  [FEIL] Gen0 manglar fragment " + namn)
            returner 1
        }
        i = i + 1
    }
    linje("✓ Gen0 Omgang 6b-fragment: " + inner_dir + " (modus " + modus + ")")
    returner 0
}
