// Operational branch only. Compile a CRT-free Windows uploader with the
// byte-verified Linux host, source-built native_codegen_v2 and explicit closure.
// No Windows execution, network, credentials, refs or repository changes here.
bruk tools.build_ci_runtime_candidate som build
bruk tools.build_windows_seed som windows
bruk tools.verify_arm_blob_windows_inputs som inputs
bruk selfhost.native_execution.codegen_prebuilt som codegen

funksjon krev(ok: boolsk, melding: tekst) {
    hvis ikkje ok { kast "Windows blob uploader build: " + melding }
}

funksjon start() -> heiltall {
    la root = build.env("NORSCODE_ROOT")
    krev(root != "", "NORSCODE_ROOT required")
    krev(build.env("GITHUB_TOKEN") == "", "build must not receive an upload token")
    krev(inputs.start() == 0, "downloaded host verification failed")
    la native = root + "/dist/norscode_native"
    krev(build.hash(native) == "392ede4ea2b2298fef3307e2f33a7d06942b674e5786cc93ec68d74081662d38",
        "prepared compiler hash differs")
    la out = root + "/build/arm-blob-stage"
    builtin.mkdir_p(out)
    la miljø = build.grunnmiljø(root)
    miljø["NORSCODE_VM_HOSTED"] = "0"
    miljø["NORSCODE_VM_FAST"] = "1"
    la cg_ncb = out + "/windows-codegen.ncb.json"
    build.køyr(root, out, "compile-windows-codegen", native,
        ["build", "selfhost/native_execution/native_codegen_v2.no", cg_ncb], miljø, 900000)
    la cg = out + "/windows-codegen.elf"
    build.bygg_native(root, out, root + "/bootstrap/native_codegen_x86_64.elf",
        cg_ncb, cg, "build-windows-codegen")
    la ncb = out + "/stage_blobs_windows.ncb.json"
    build.køyr(root, out, "compile-windows-uploader", native,
        ["build", "tools/stage_verified_arm_blobs_windows.no", ncb], miljø, 900000)
    la exe = out + "/stage_blobs.exe"
    la aot = build.grunnmiljø(root)
    aot["NC_INPUT"] = ncb
    aot["NC_OUTPUT"] = exe
    aot["NC_TARGET"] = "windows-x86_64"
    aot["NC_NATIVE_SYMBOL_MAP"] = exe + ".symbols"
    la logg = build.køyr(root, out, "build-windows-uploader", cg, [], aot, 900000)
    skriv(logg)
    krev(builtin.contains(logg, "BUILTIN-RAPPORT uløyste=0 uventa=0"), "unresolved builtin gate failed")
    krev(windows.pe_crt_fri(exe) == "", "Windows uploader imports a C runtime")
    la bytes = builtin.fil_les_binær(exe)
    la manifest = {
        "schema": "norscode-windows-arm-blob-uploader-v1",
        "staging_commit": build.env("GITHUB_SHA"),
        "source_head": "19ee05039d6b72a0a9986d1afc31a963d67b504c",
        "compiler_sha256": build.hash(native),
        "windows_adapter_sha256": build.hash(root + "/build/windows/nc_main_freestanding_win.exe"),
        "codegen_source_sha256": codegen.srchash(root, "windows-x86_64"),
        "codegen_dependencies_sha256": codegen.depshash(root, "windows-x86_64"),
        "uploader_ncb_sha256": build.hash(ncb),
        "uploader_sha256": builtin.sha256_bytes(bytes),
        "uploader_size": lengde(bytes),
        "unresolved_builtins": 0, "unexpected_builtins": 0, "crt_free": sann
    }
    fil_skriv(out + "/windows-build.json", builtin.json_skriv(manifest) + "\n")
    skriv("OK: kjeldebygd CRT-fri Windows-opplastar, " + tekst(lengde(bytes)) + " byte\n")
    returner 0
}
