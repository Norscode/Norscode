// Reproduserbar Windows x86_64 ABI-gate for native runtime.
// Dette er en vedlikehaldsgate; normal Norscode-køyring brukar ikkje C-kompilering.

bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon kommando(executable: tekst, argv: liste_tekst, cwd: tekst,
                  miljø: ordbok_tekst) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, cwd, miljø, 600000)
}

funksjon feilmelding(res: ordbok_tekst) -> tekst {
    la feil = tekst(res["stderr"])
    hvis feil == "" { feil = tekst(res["error"]) }
    hvis feil == "" { feil = tekst(res["stdout"]) }
    returner feil
}

funksjon ok(res: ordbok_tekst) -> boolsk { returner prosess.ok(res) }

// process.exec brukar ei eksplisitt executable-fil og skal ikkje delegere
// PATH-oppslag til eit shell. Finn verktøyet deterministisk i det arva PATH-et
// og send absolutt sti vidare til den strukturerte prosess-ABI-en.
funksjon finn_program(namn: tekst) -> tekst {
    la sti = env("PATH")
    hvis sti == "" { returner namn }
    la skilje = ":"
    hvis builtin.index_of(sti, ";") >= 0 { skilje = ";" }
    la mapper = builtin.split(sti, skilje)
    for mappe i mapper {
        hvis mappe != "" {
            la kandidat = mappe + "/" + namn
            prøv { hvis builtin.fil_finnes(kandidat) { returner kandidat } } fang (e) { }
        }
    }
    returner namn
}

funksjon normaliser_pe(nc_bin: tekst, root: tekst, sti: tekst) -> boolsk {
    la normal = sti + ".normalized"
    la miljø: ordbok_tekst = {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tools/normalize_pe_reproducible.no",
        "NORSCODE_ROOT": root,
        "NORSCODE_PE_INPUT": sti,
        "NORSCODE_PE_OUTPUT": normal
    }
    la resultat = kommando(nc_bin, [], root, miljø)
    hvis ikkje ok(resultat) { skriv(feilmelding(resultat) + "\n") returner usann }
    prøv { builtin.fil_skriv_binær(sti, builtin.fil_les_binær(normal)) } fang (e) { returner usann }
    returner sann
}

// Verifiser PE32+ direkte i Norscode. Windows-gaten skal ikkje vere avhengig
// av at Git Bash tilfeldigvis har unix-verktøyet `file` installert.
funksjon er_pe64(sti: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        hvis lengde(bytes) < 64 { returner usann }
        hvis bytes[0] != 0x4D eller bytes[1] != 0x5A { returner usann }
        la pe = bytes[60] | (bytes[61] << 8) | (bytes[62] << 16) | (bytes[63] << 24)
        hvis pe < 0 eller pe + 26 > lengde(bytes) { returner usann }
        hvis bytes[pe] != 0x50 eller bytes[pe + 1] != 0x45 eller
           bytes[pe + 2] != 0 eller bytes[pe + 3] != 0 { returner usann }
        la maskin = bytes[pe + 4] | (bytes[pe + 5] << 8)
        la magic = bytes[pe + 24] | (bytes[pe + 25] << 8)
        returner maskin == 0x8664 og magic == 0x20B
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la zig = env("NORSCODE_ZIG")
    hvis zig == "" { zig = finn_program("zig") }
    // Windows-checkout kan ikkje stole på at Git materialiserer bin/nc-lenkja.
    // Bruk den eksplisitte, attesterbare stage0-/kandidatbinæren som starta
    // verktøyet, og bruk bin/nc berre som lokal reserve.
    la nc_bin = env("NORSCODE_NATIVE_BIN")
    hvis nc_bin == "" { nc_bin = root + "/bin/nc" }
    la source = root + "/build/v3009/native_candidate_gc.c"
    la argon_source = root + "/archive/legacy_c_backend/nc_argon2_zig.zig"
    la backend = root + "/archive/legacy_c_backend/nc_windows_backend.c"
    la smoke = root + "/archive/legacy_c_backend/nc_windows_appcontainer_smoke.c"
    la backend_smoke = root + "/archive/legacy_c_backend/nc_windows_backend_smoke.c"
    la standard_dir = root + "/build/windows"
    la publish_dir = env("NORSCODE_WINDOWS_OUT_DIR")
    hvis publish_dir == "" { publish_dir = standard_dir }
    // /Brepro avleier PE-identiteten frå linkerinput. Bruk derfor den same
    // kanoniske arbeidsstien også når to kandidatar blir publiserte til kvar
    // si mappe; elles ville objektstien åleine endre CodeView-identiteten.
    la work_dir = root + "/build/windows-repro-work"
    la out = work_dir + "/norscode_native_windows_x86_64.o"
    la backend_out = work_dir + "/nc_windows_backend_x86_64.o"
    la smoke_out = work_dir + "/nc_windows_appcontainer_smoke_x86_64.o"
    la backend_smoke_out = work_dir + "/nc_windows_backend_smoke_x86_64.o"
    la exe = work_dir + "/norscode_native_windows_x86_64.exe"
    la argon_obj = work_dir + "/nc_argon2_zig_windows_x86_64.o"
    la smoke_exe = work_dir + "/nc_windows_appcontainer_smoke_x86_64.exe"
    la backend_smoke_exe = work_dir + "/nc_windows_backend_smoke_x86_64.exe"
    hvis ikkje builtin.mappe_opprett(work_dir) eller ikkje builtin.mappe_opprett(publish_dir) {
        skriv("Windows-utmappe kunne ikkje opprettast: " + publish_dir + "\n")
        returner 1
    }
    la arva_miljø: ordbok_tekst = {}
    la build_argon = kommando(zig, [
        "build-obj", argon_source, "-target", "x86_64-windows-gnu",
        "-O", "ReleaseFast", "-fsingle-threaded", "-femit-bin=" + argon_obj
    ], root, arva_miljø)
    hvis ikkje ok(build_argon) {
        skriv("Windows Zig Argon2id cross-compile feilet: " + feilmelding(build_argon) + "\n")
        returner 1
    }
    la include_dir = root + "/archive/legacy_c_backend"
    la build = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2", "-c",
        source, "-I", include_dir, "-o", out], root, arva_miljø)
    hvis ikkje ok(build) {
        skriv("Windows cross-compile feilet: " + feilmelding(build) + "\n")
        returner 1
    }
    la build_backend = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2", "-c",
        backend, "-I", include_dir, "-o", backend_out], root, arva_miljø)
    hvis ikkje ok(build_backend) {
        skriv("Windows backend cross-compile feilet: " + feilmelding(build_backend) + "\n")
        returner 1
    }
    la build_smoke = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2", "-c",
        smoke, "-I", include_dir, "-o", smoke_out], root, arva_miljø)
    hvis ikkje ok(build_smoke) {
        skriv("Windows AppContainer-smoke cross-compile feilet: " + feilmelding(build_smoke) + "\n")
        returner 1
    }
    la build_backend_smoke = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2", "-c",
        backend_smoke, "-I", include_dir, "-o", backend_smoke_out], root, arva_miljø)
    hvis ikkje ok(build_backend_smoke) {
        skriv("Windows backend-smoke cross-compile feilet: " + feilmelding(build_backend_smoke) + "\n")
        returner 1
    }
    // LLD /Brepro avleier PE-tidsstempel og CodeView-identitet frå innhaldet.
    la link = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2",
        "-DNC_ENABLE_ZIG_ARGON2", source, backend, argon_obj, "-I", include_dir,
        "-lws2_32", "-lbcrypt", "-ladvapi32", "-luserenv", "-lshell32", "-luser32",
        "-lntdll", "-lsecur32", "-lcrypt32", "-Wl,/Brepro", "-o", exe], root, arva_miljø)
    hvis ikkje ok(link) {
        skriv("Windows native executable-lenking feilet: " + feilmelding(link) + "\n")
        returner 1
    }
    la link_smoke = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2",
        smoke, backend, "-I", include_dir, "-lws2_32", "-lbcrypt", "-ladvapi32",
        "-luserenv", "-lshell32", "-luser32", "-lntdll", "-lsecur32", "-lcrypt32",
        "-Wl,/Brepro", "-o", smoke_exe], root, arva_miljø)
    hvis ikkje ok(link_smoke) {
        skriv("Windows AppContainer-smoke-lenking feilet: " + feilmelding(link_smoke) + "\n")
        returner 1
    }
    la link_backend_smoke = kommando(zig, ["cc", "-target", "x86_64-windows-gnu", "-O2",
        backend_smoke, backend, "-I", include_dir, "-lws2_32", "-lbcrypt", "-ladvapi32",
        "-luserenv", "-lshell32", "-luser32", "-lntdll", "-lsecur32", "-lcrypt32",
        "-Wl,/Brepro", "-o", backend_smoke_exe], root, arva_miljø)
    hvis ikkje ok(link_backend_smoke) {
        skriv("Windows backend-smoke-lenking feilet: " + feilmelding(link_backend_smoke) + "\n")
        returner 1
    }
    hvis ikkje normaliser_pe(nc_bin, root, exe) eller
       ikkje normaliser_pe(nc_bin, root, smoke_exe) eller
       ikkje normaliser_pe(nc_bin, root, backend_smoke_exe) {
        skriv("Windows PE-reproduserbarheitsnormalisering feilet\n")
        returner 1
    }
    // Kandidaten skal vere den same single-binary-flata som release brukar:
    // legg compiler/VM/executor-NCB inn i PE-fila før ho blir attestert.
    la embedded = exe + ".embedded.exe"
    la specs = "compiler=" + root + "/bootstrap/kompiler.ncb.json;" +
        "vm=" + root + "/bootstrap/precompiled/vm.ncb.json;" +
        "vm-executor=" + root + "/selfhost/vm_executor.ncb.json"
    la embed_miljø: ordbok_tekst = {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1", "NORSCODE_RUN_CACHE": "0",
        "NORSCODE_CMD": "run", "NORSCODE_FILE": root + "/tools/embed_release_ncb.no",
        "NORSCODE_ROOT": root, "NORSCODE_EMBED_STREAM": "1",
        "NORSCODE_EMBED_BASE": exe, "NORSCODE_EMBED_OUT": embedded,
        "NORSCODE_EMBED_SPECS": specs
    }
    la embed = kommando(nc_bin, [], root, embed_miljø)
    hvis ikkje ok(embed) {
        skriv("Windows single-binary NCB-embedding feilet: " + feilmelding(embed) + "\n")
        returner 1
    }
    prøv {
        // Aktiver embedded PE med Norscode-eigd binær I/O; ikkje bruk cp/shell
        // i sjølve release-/cross-build-kjeda.
        la embedded_bytes = builtin.fil_les_binær(embedded)
        builtin.fil_skriv_binær(exe, embedded_bytes)
    } fang (e) {
        skriv("Windows single-binary-kandidat kunne ikkje aktiverast: " + tekst(e) + "\n")
        returner 1
    }
    hvis ikkje er_pe64(exe) eller ikkje er_pe64(smoke_exe) eller ikkje er_pe64(backend_smoke_exe) {
        skriv("Windows PE32+ x86_64-verifikasjon feilet\n")
        returner 1
    }
    la final_exe = exe
    hvis publish_dir != work_dir {
        prøv {
            builtin.fil_skriv_binær(
                publish_dir + "/norscode_native_windows_x86_64.exe",
                builtin.fil_les_binær(exe)
            )
            builtin.fil_skriv_binær(
                publish_dir + "/norscode_native_windows_x86_64.exe.embedded.exe",
                builtin.fil_les_binær(embedded)
            )
            builtin.fil_skriv_binær(
                publish_dir + "/nc_windows_appcontainer_smoke_x86_64.exe",
                builtin.fil_les_binær(smoke_exe)
            )
            builtin.fil_skriv_binær(
                publish_dir + "/nc_windows_backend_smoke_x86_64.exe",
                builtin.fil_les_binær(backend_smoke_exe)
            )
            final_exe = publish_dir + "/norscode_native_windows_x86_64.exe"
        } fang (e) {
            skriv("Windows-kandidat kunne ikkje publiserast: " + tekst(e) + "\n")
            returner 1
        }
    }
    skriv("[OK] Windows x86_64 native ABI compile/link (runtime, IOCP/SChannel, AppContainer): " + final_exe + "\n")
    returner 0
}
