// tools/package-linux-app.no — Norscode-eigd Linux AppDir/tarball
//
// AppImage ligg bak eit eksplisitt, valfritt appimagetool-adapterval. Standard-
// og all-flyten startar aldri eksterne pakkeprosessar.

bruk std.filops som filops
bruk std.platform som platform
bruk std.prosess som prosess
bruk std.runtime_filesystem som native_fs
bruk std.liste som lister
bruk tools.release_tar_gzip_stream_v1 som tar_gzip_stream

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon skriv_fil(sti: tekst, innhald: tekst) -> bool {
    prøv {
        builtin.fil_skriv(sti, innhald)
        returner sann
    } fang (e) {
        linje("Feil: klarte ikkje skrive " + sti + ": " + tekst(e))
        returner usann
    }
    returner usann
}

funksjon toml_version_fra_innhald(innhald: tekst) -> tekst {
    la linjer = builtin.split(innhald, "\n")
    la i = 0
    mens i < lengde(linjer) {
        la line = builtin.trim(linjer[i])
        hvis builtin.starts_with(line, "version") {
            la delar = builtin.split(line, "\"")
            hvis lengde(delar) >= 3 { returner builtin.trim(delar[1]) }
        }
        i = i + 1
    }
    returner ""
}

funksjon repo_version(root: tekst) -> tekst {
    la toml = root + "/norcode.toml"
    hvis fil_finst(toml) {
        la v = toml_version_fra_innhald(builtin.fil_les(toml))
        hvis v != "" { returner v }
    }
    returner "1.0"
}

funksjon sha256_skriv(sti: tekst) -> bool {
    prøv {
        // Hash-builtin-en er del av Norscode-runtime-ABI-en og tek imot
        // kompakt NC_BYTES utan å materialisere ein heiltalsverdi per byte.
        // Rein kryptobackend blir godkjend separat i fase 7.
        la hash = builtin.sha256_bytes(builtin.fil_les_binær(sti))
        returner skriv_fil(sti + ".sha256", hash + "\n")
    } fang (e) {
        linje("Feil: SHA-256 feila for " + sti + ": " + tekst(e))
        returner usann
    }
    returner usann
}

funksjon forelder(sti: tekst) -> tekst {
    la deler = builtin.split(sti, "/")
    hvis lengde(deler) <= 1 { returner "." }
    returner builtin.join(builtin.slice(deler, 0, lengde(deler) - 1), "/")
}

funksjon kopier_fil_kompakt(kjelde: tekst, mål: tekst) -> bool {
    hvis ikkje filops.lag_katalogar(forelder(mål)) { returner usann }
    // Committed stage0 sin filesystem-v1 transporterer read/write-data som
    // tekst. Bruk NC_BYTES-banen for binærtrygg kopiering utan VM-heiltallsliste.
    returner filops.kopier2(kjelde, mål)
}

funksjon registrer_modus(modusar: ordbok_tekst, arkivnamn: tekst, kjelde: tekst) -> heiltall {
    la stat = native_fs.native_stat_sti(kjelde)
    hvis stat["status"] == "ok" {
        modusar[arkivnamn] = tekst_fra_heiltall(heltall_fra_tekst(tekst(stat["mode"])) & 511)
    }
    returner 0
}

funksjon kopier_runtime_element(modusar: ordbok_tekst, root: tekst, runtime_dir: tekst,
                                appdir: tekst, namn: tekst) -> bool {
    la kjelde = root + "/" + namn
    la mål = runtime_dir + "/" + namn
    hvis filops.katalog_finnes(kjelde) {
        la filer = filops.walk(kjelde)
        la i = 0
        mens i < lengde(filer) {
            la rel = filops.relativ_sti(kjelde, filer[i])
            registrer_modus(modusar, "Norscode.AppDir/" + filops.relativ_sti(appdir, mål) + "/" + rel, filer[i])
            hvis ikkje kopier_fil_kompakt(filer[i], mål + "/" + rel) { returner usann }
            i = i + 1
        }
    } ellers {
        registrer_modus(modusar, "Norscode.AppDir/" + filops.relativ_sti(appdir, mål), kjelde)
        hvis ikkje kopier_fil_kompakt(kjelde, mål) { returner usann }
    }
    returner sann
}

funksjon build_appdir(root: tekst, appdir: tekst, modusar: ordbok_tekst) -> bool {
    linje("[linux-package] bygg AppDir")
    hvis filops.katalog_finnes(appdir) og ikkje filops.slett_tre(appdir) { returner usann }
    la runtime_dir = appdir + "/usr/share/norscode/runtime"
    la katalogar = [
        appdir + "/usr/bin",
        appdir + "/usr/share/applications",
        appdir + "/usr/share/icons/hicolor/256x256/apps",
        runtime_dir,
        runtime_dir + "/bin",
        runtime_dir + "/dist"
    ]
    la i = 0
    mens i < lengde(katalogar) {
        hvis ikkje filops.lag_katalogar(katalogar[i]) { returner usann }
        i = i + 1
    }

    la native = root + "/dist/norscode_native"
    hvis ikkje kopier_fil_kompakt(native, appdir + "/usr/bin/norscode") {
        linje("Feil: kunne ikkje kopiere native runtime til AppDir")
        returner usann
    }
    registrer_modus(modusar, "Norscode.AppDir/usr/bin/norscode", native)
    hvis native_fs.native_sett_modus_sti(appdir + "/usr/bin/norscode", 493)["status"] != "ok" {
        linje("Merk: stage0 manglar chmod-ABI; TAR-metadata bevarer executable modus")
    }

    // AppImage startar AppRun direkte. Ein kopi av Norscode-binæren fjernar
    // behovet for ein generert shell-launcher.
    hvis ikkje kopier_fil_kompakt(native, appdir + "/AppRun") { returner usann }
    modusar["Norscode.AppDir/AppRun"] = "493"
    native_fs.native_sett_modus_sti(appdir + "/AppRun", 493)
    hvis ikkje kopier_fil_kompakt(native, runtime_dir + "/bin/nc") { returner usann }
    hvis ikkje kopier_fil_kompakt(native, runtime_dir + "/dist/norscode_native") { returner usann }
    modusar["Norscode.AppDir/usr/share/norscode/runtime/bin/nc"] = "493"
    modusar["Norscode.AppDir/usr/share/norscode/runtime/dist/norscode_native"] = "493"
    hvis ikkje skriv_fil(appdir + "/Norscode.desktop",
        "[Desktop Entry]\nType=Application\nName=Norscode\nExec=AppRun\nIcon=norscode\nCategories=Development;\nTerminal=true\n") {
        returner usann
    }

    la ikon = root + "/frontend/assets/icons/norscode-mark-256.png"
    hvis ikkje kopier_fil_kompakt(ikon, appdir + "/usr/share/icons/hicolor/256x256/apps/norscode.png") { returner usann }
    hvis ikkje kopier_fil_kompakt(ikon, appdir + "/norscode.png") { returner usann }

    // App-runtime skal ikkje innehalde committed stage0 eller rollbacklageret.
    // Tillitsankeret høyrer til utviklar-/bootstrapflyten, ikkje kvar AppDir.
    la element = ["selfhost", "std", "norcode.toml", "README.md", "LICENSE"]
    i = 0
    mens i < lengde(element) {
        linje("[linux-package] kopier runtime-element " + element[i])
        hvis ikkje kopier_runtime_element(modusar, root, runtime_dir, appdir, element[i]) {
            linje("Feil: kunne ikkje kopiere runtime-element " + element[i])
            returner usann
        }
        i = i + 1
    }
    hvis ikkje kopier_fil_kompakt(appdir + "/Norscode.desktop", appdir + "/usr/share/applications/Norscode.desktop") {
        returner usann
    }
    linje("Bygde AppDir: " + appdir)
    returner sann
}

funksjon package_tarball(build_dir: tekst, tarball: tekst, modusar: ordbok_tekst) -> bool {
    linje("[linux-package] skriv Norscode TAR.GZ")
    la filer_abs = filops.walk(build_dir)
    la filer: liste_tekst = []
    la i = 0
    mens i < lengde(filer_abs) {
        legg_til(filer, filops.relativ_sti(build_dir, filer_abs[i]))
        i = i + 1
    }
    lister.sorter_tekst(filer)
    hvis lengde(filer) > 0 og tar_gzip_stream.binærstraum_støtta(build_dir + "/" + filer[0]) {
        hvis ikkje tar_gzip_stream.lag_tar_gzip(tarball, build_dir, filer, modusar) {
            linje("Feil: Norscode binærstraum-TAR.GZ feila")
            returner usann
        }
        hvis ikkje sha256_skriv(tarball) { returner usann }
        linje("Bygde Linux AppDir-tarball med binær filesystem-ABI: " + tarball)
        returner sann
    }
    linje("Feil: runtime manglar filesystem-v1 read_binary; Linux release feilar lukka")
    returner usann
}

funksjon package_appimage_adapter(appdir: tekst, appimage_path: tekst) -> bool {
    hvis ikkje platform.er_linux() {
        linje("Feil: AppImage-adapteren krev Linux-host.")
        returner usann
    }
    la executable = prosess.finn_kjorbar("appimagetool")
    hvis executable == "" {
        linje("Feil: den valfrie AppImage-adapteren krev appimagetool.")
        returner usann
    }
    la policy = prosess.ny_policy("appimage")
    prosess.tillat(policy, "appimagetool")
    prosess.aktiver_køyring(policy)
    la plan = prosess.start_argv_plan(executable, [appdir, appimage_path])
    prosess.med_miljø(plan, {"ARCH": env("ARCH")})
    la res = prosess.start_argv_trygt(policy, plan)
    hvis ikkje prosess.er_ok(res) {
        linje("Feil: appimagetool: " + prosess.stderr(res))
        returner usann
    }
    hvis ikkje sha256_skriv(appimage_path) { returner usann }
    linje("Bygde AppImage: " + appimage_path)
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la format = env("NORSCODE_LINUX_PACKAGE_FORMAT")
    hvis format == "" { format = "all" }
    la version = env("NORSCODE_LINUX_PACKAGE_VERSION")
    hvis version == "" { version = repo_version(root) }
    la release_dir = env("NORSCODE_LINUX_PACKAGE_RELEASE_DIR")
    hvis release_dir == "" { release_dir = root + "/release-artifacts" }
    la build_dir = env("NORSCODE_LINUX_PACKAGE_BUILD_DIR")
    hvis build_dir == "" { build_dir = root + "/build/linux-app" }
    la appdir = build_dir + "/Norscode.AppDir"
    la tarball = release_dir + "/Norscode-linux-" + version + "-AppDir.tar.gz"
    la appimage_path = release_dir + "/Norscode-linux-" + version + ".AppImage"
    la modusar: ordbok_tekst = {}

    hvis ikkje filops.lag_katalogar(build_dir) eller ikkje filops.lag_katalogar(release_dir) { returner 1 }
    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        linje("Feil: manglar dist/norscode_native; stage0 må vere eksplisitt klargjord før pakking")
        returner 1
    }
    filops.slett_fil(tarball)
    filops.slett_fil(tarball + ".sha256")
    filops.slett_fil(appimage_path)
    filops.slett_fil(appimage_path + ".sha256")

    hvis format == "appdir" {
        hvis build_appdir(root, appdir, modusar) { returner 0 }
        returner 1
    }
    hvis format == "tarball" {
        hvis ikkje build_appdir(root, appdir, modusar) { returner 1 }
        hvis package_tarball(build_dir, tarball, modusar) { returner 0 }
        returner 1
    }
    hvis format == "appimage-adapter" {
        hvis ikkje build_appdir(root, appdir, modusar) { returner 1 }
        hvis package_appimage_adapter(appdir, appimage_path) { returner 0 }
        returner 1
    }
    hvis format == "all" {
        hvis ikkje build_appdir(root, appdir, modusar) { returner 1 }
        hvis ikkje package_tarball(build_dir, tarball, modusar) { returner 1 }
        returner 0
    }

    linje("Feil: ugyldig format " + format + " (bruk appdir, tarball, all eller eksplisitt appimage-adapter)")
    returner 1
}
