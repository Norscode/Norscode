// tools/package-linux-app.no — Norscode-eigd Linux AppDir/tarball/AppImage

bruk std.filops som filops
bruk std.shutil som shutil
bruk std.sha256 som sha256_bytes
bruk std.platform som platform
bruk std.prosess som prosess
bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon skriv_fil(sti: tekst, innhald: tekst) -> bool {
    prøv {
        builtin.fil_skriv(sti, innhald)
        returner sann
    } fang (e) {
        linje("Feil: klarte ikkje skrive " + sti + ": " + tekst(e))
        returner usann
    }
    returner usann
}

funksjon toml_version_fra_innhald(innhald: tekst) -> tekst {
    la linjer = builtin.split(innhald, "\n")
    la i = 0
    mens i < lengde(linjer) {
        la line = builtin.trim(linjer[i])
        hvis builtin.starts_with(line, "version") {
            la delar = builtin.split(line, "\"")
            hvis lengde(delar) >= 3 { returner builtin.trim(delar[1]) }
        }
        i = i + 1
    }
    returner ""
}

funksjon repo_version(root: tekst) -> tekst {
    la toml = root + "/norcode.toml"
    hvis fil_finst(toml) {
        la v = toml_version_fra_innhald(builtin.fil_les(toml))
        hvis v != "" { returner v }
    }
    returner "1.0"
}

funksjon sha256_skriv(sti: tekst) -> bool {
    prøv {
        la hash = sha256_bytes.hash_bytes(builtin.fil_les_binær(sti))
        returner skriv_fil(sti + ".sha256", hash + "\n")
    } fang (e) {
        linje("Feil: SHA-256 feila for " + sti + ": " + tekst(e))
        returner usann
    }
    returner usann
}

funksjon kopier_runtime_element(root: tekst, runtime_dir: tekst, namn: tekst) -> bool {
    la kjelde = root + "/" + namn
    la mål = runtime_dir + "/" + namn
    hvis filops.katalog_finnes(kjelde) { returner filops.kopier_tre(kjelde, mål) }
    returner filops.kopier2(kjelde, mål)
}

funksjon build_appdir(root: tekst, appdir: tekst) -> bool {
    hvis filops.katalog_finnes(appdir) og ikkje filops.slett_tre(appdir) { returner usann }
    la runtime_dir = appdir + "/usr/share/norscode/runtime"
    la katalogar = [
        appdir + "/usr/bin",
        appdir + "/usr/share/applications",
        appdir + "/usr/share/icons/hicolor/256x256/apps",
        runtime_dir
    ]
    la i = 0
    mens i < lengde(katalogar) {
        hvis ikkje filops.lag_katalogar(katalogar[i]) { returner usann }
        i = i + 1
    }

    la native = root + "/dist/norscode_native"
    hvis ikkje filops.kopier2(native, appdir + "/usr/bin/norscode") { returner usann }
    hvis native_fs.native_sett_modus_sti(appdir + "/usr/bin/norscode", 493)["status"] != "ok" { returner usann }

    // AppImage startar AppRun direkte. Ein kopi av Norscode-binæren fjernar
    // behovet for ein generert shell-launcher.
    hvis ikkje filops.kopier2(native, appdir + "/AppRun") { returner usann }
    hvis native_fs.native_sett_modus_sti(appdir + "/AppRun", 493)["status"] != "ok" { returner usann }
    hvis ikkje skriv_fil(appdir + "/Norscode.desktop",
        "[Desktop Entry]\nType=Application\nName=Norscode\nExec=AppRun\nIcon=norscode\nCategories=Development;\nTerminal=true\n") {
        returner usann
    }

    la ikon = root + "/frontend/assets/icons/norscode-mark-256.png"
    hvis ikkje filops.kopier2(ikon, appdir + "/usr/share/icons/hicolor/256x256/apps/norscode.png") { returner usann }
    hvis ikkje filops.kopier2(ikon, appdir + "/norscode.png") { returner usann }

    la element = ["bin", "bootstrap", "dist", "selfhost", "std", "norcode.toml", "README.md", "LICENSE"]
    i = 0
    mens i < lengde(element) {
        hvis ikkje kopier_runtime_element(root, runtime_dir, element[i]) { returner usann }
        i = i + 1
    }
    hvis ikkje filops.kopier2(appdir + "/Norscode.desktop", appdir + "/usr/share/applications/Norscode.desktop") {
        returner usann
    }
    linje("Bygde AppDir: " + appdir)
    returner sann
}

funksjon package_tarball(build_dir: tekst, tarball: tekst) -> bool {
    la base = builtin.slice(tarball, 0, lengde(tarball) - 7)
    la laga = shutil.make_archive(base, "gztar", build_dir)
    hvis laga != tarball { returner usann }
    hvis ikkje sha256_skriv(tarball) { returner usann }
    linje("Bygde Linux AppDir-tarball: " + tarball)
    returner sann
}

funksjon package_appimage(appdir: tekst, appimage_path: tekst) -> bool {
    hvis ikkje platform.er_linux() {
        linje("Merk: AppImage-bygging krev Linux-host.")
        returner usann
    }
    la executable = prosess.finn_kjorbar("appimagetool")
    hvis executable == "" {
        linje("Merk: appimagetool er ikkje installert; hoppar over AppImage.")
        returner usann
    }
    la policy = prosess.ny_policy("appimage")
    prosess.tillat(policy, "appimagetool")
    prosess.aktiver_køyring(policy)
    la plan = prosess.start_argv_plan(executable, [appdir, appimage_path])
    prosess.med_miljø(plan, {"ARCH": env("ARCH")})
    la res = prosess.start_argv_trygt(policy, plan)
    hvis ikkje prosess.er_ok(res) {
        linje("Feil: appimagetool: " + prosess.stderr(res))
        returner usann
    }
    hvis ikkje sha256_skriv(appimage_path) { returner usann }
    linje("Bygde AppImage: " + appimage_path)
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la format = env("NORSCODE_LINUX_PACKAGE_FORMAT")
    hvis format == "" { format = "all" }
    la version = env("NORSCODE_LINUX_PACKAGE_VERSION")
    hvis version == "" { version = repo_version(root) }
    la release_dir = env("NORSCODE_LINUX_PACKAGE_RELEASE_DIR")
    hvis release_dir == "" { release_dir = root + "/release-artifacts" }
    la build_dir = env("NORSCODE_LINUX_PACKAGE_BUILD_DIR")
    hvis build_dir == "" { build_dir = root + "/build/linux-app" }
    la appdir = build_dir + "/Norscode.AppDir"
    la tarball = release_dir + "/Norscode-linux-" + version + "-AppDir.tar.gz"
    la appimage_path = release_dir + "/Norscode-linux-" + version + ".AppImage"

    hvis ikkje filops.lag_katalogar(build_dir) eller ikkje filops.lag_katalogar(release_dir) { returner 1 }
    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        linje("Feil: manglar dist/norscode_native; stage0 må vere eksplisitt klargjord før pakking")
        returner 1
    }
    filops.slett_fil(tarball)
    filops.slett_fil(tarball + ".sha256")
    filops.slett_fil(appimage_path)
    filops.slett_fil(appimage_path + ".sha256")

    hvis format == "appdir" {
        hvis build_appdir(root, appdir) { returner 0 }
        returner 1
    }
    hvis format == "tarball" {
        hvis ikkje build_appdir(root, appdir) { returner 1 }
        hvis package_tarball(build_dir, tarball) { returner 0 }
        returner 1
    }
    hvis format == "appimage" {
        hvis ikkje build_appdir(root, appdir) { returner 1 }
        hvis package_appimage(appdir, appimage_path) { returner 0 }
        returner 1
    }
    hvis format == "all" {
        hvis ikkje build_appdir(root, appdir) { returner 1 }
        hvis ikkje package_tarball(build_dir, tarball) { returner 1 }
        package_appimage(appdir, appimage_path)
        returner 0
    }

    linje("Feil: ugyldig format " + format + " (bruk appdir, tarball, appimage eller all)")
    returner 1
}
