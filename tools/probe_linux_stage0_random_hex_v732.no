// tools/probe_linux_stage0_random_hex_v732.no — kartlegg Linux/stage0/random_hex utan å endre filer

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon inneheld(t: tekst, needle: tekst) -> bool {
    returner builtin.index_of(t, needle) >= 0
}

funksjon vis_strings_treff(sti: tekst, needle: tekst, maks: heiltall) -> heiltall {
    la delar = native_fs.native_sti_rot_relativ(sti)
    la h = native_fs.opne_native(tekst(delar["root"]), tekst(delar["relative"]), "read")
    hvis h["status"] != "open" {
        linje("[MANGLAR] " + sti)
        returner 0
    }
    la funne = usann
    la hale = ""
    prøv {
        la ferdig = usann
        mens ikkje ferdig og ikkje funne {
            la del = native_fs.native_les(h, 1048576)
            la data = tekst(del["data"])
            hvis data == "" { ferdig = sann }
            ellers {
                la vindauge = hale + data
                hvis inneheld(vindauge, needle) { funne = sann }
                la halelengde = lengde(needle) - 1
                hvis halelengde > 0 og lengde(vindauge) > halelengde {
                    hale = builtin.slice(vindauge, lengde(vindauge) - halelengde, lengde(vindauge))
                } ellers { hale = vindauge }
            }
        }
    } fang (e) {}
    native_fs.native_lukk(h)
    hvis funne { linje("[FUNNE] " + needle + " i " + sti) }
    ellers { linje("[IKKJE FUNNE] " + needle + " i " + sti) }
    returner 0
}

funksjon vis_fil_start(sti: tekst, maks: heiltall) -> heiltall {
    la data = fil_les_trygt(sti)
    hvis data == "" {
        linje("Kunne ikkje lese: " + sti)
        returner 0
    }
    la linjer = builtin.split(data, "\n")
    la i = 0
    mens i < lengde(linjer) og i < maks {
        skriv(linjer[i] + "\n")
        i = i + 1
    }
    returner 0
}

funksjon trim(t: tekst) -> tekst {
    returner builtin.trim(t)
}

funksjon fil_les_trygt(sti: tekst) -> tekst {
    prøv { returner builtin.fil_les(sti) } fang (e) { returner "" }
    returner ""
}

funksjon vis_binærinfo(sti: tekst) -> heiltall {
    prøv {
        la data = builtin.fil_les_binær(sti)
        linje(sti + ": " + tekst_fra_heiltall(lengde(data)) + " byte, sha256=" + builtin.sha256_bytes(data))
    } fang (e) { linje(sti + ": manglar") }
    returner 0
}

funksjon vis_stage0_filer() -> heiltall {
    la filer = filops.lista_katalog("bootstrap/stage0")
    la i = 0
    mens i < lengde(filer) {
        vis_binærinfo("bootstrap/stage0/" + filer[i])
        i = i + 1
    }
    returner 0
}

funksjon linje_treff(line: tekst, needles: liste_tekst) -> bool {
    la ni = 0
    mens ni < lengde(needles) {
        hvis inneheld(line, needles[ni]) { returner sann }
        ni = ni + 1
    }
    returner usann
}

funksjon har_fil(filer: liste_tekst, fil: tekst) -> bool {
    la i = 0
    mens i < lengde(filer) {
        hvis filer[i] == fil { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon søkefiler(mapper: tekst) -> liste_tekst {
    la filer: liste_tekst = []
    la delar = builtin.split(mapper, " ")
    la i = 0
    mens i < lengde(delar) {
        la mappe = trim(delar[i])
        hvis mappe != "" {
            la walk = native_fs.native_walk_files_med_suffiks(".", mappe, ".no")
            la linjer = builtin.split(tekst(walk["data"]), "\n")
            la li = 0
            mens walk["status"] == "ok" og li < lengde(linjer) {
                la fil = trim(linjer[li])
                hvis fil != "" og ikkje har_fil(filer, fil) {
                    legg_til(filer, fil)
                }
                li = li + 1
            }
        }
        i = i + 1
    }
    returner filer
}

funksjon vis_kildetreff(mapper: tekst, needles: liste_tekst, maks: heiltall) -> heiltall {
    la filer = søkefiler(mapper)
    la treff = 0
    la fi = 0
    mens fi < lengde(filer) og treff < maks {
        la rel = trim(filer[fi])
        hvis rel != "" {
            la data = fil_les_trygt(rel)
            hvis data != "" {
                la linjer = builtin.split(data, "\n")
                la li = 0
                mens li < lengde(linjer) og treff < maks {
                    hvis linje_treff(linjer[li], needles) {
                        skriv(rel + ":" + tekst(li + 1) + ":" + linjer[li] + "\n")
                        treff = treff + 1
                    }
                    li = li + 1
                }
            }
        }
        fi = fi + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    linje("== Plattform ==")
    linje("system=" + tekst(info["system"]))
    linje("machine=" + tekst(info["machine"]))

    linje("")
    linje("== Nåværende binary ==")
    vis_binærinfo("dist/norscode_native")
    vis_strings_treff("dist/norscode_native", "random_hex", 20)

    linje("")
    linje("== Stage0 seeds ==")
    vis_stage0_filer()
    vis_strings_treff("bootstrap/stage0/norscode-linux-x86_64", "random_hex", 20)
    vis_strings_treff("bootstrap/stage0/norscode-macos-arm64", "random_hex", 20)

    linje("")
    linje("== random_hex i kilde ==")
    la kilde_ord: liste_tekst = []
    legg_til(kilde_ord, "random_hex")
    legg_til(kilde_ord, "socket_listen")
    vis_kildetreff("selfhost std prosjekter/NorscodeWeb", kilde_ord, 200)

    linje("")
    linje("== build-løype ==")
    vis_fil_start("tools/build_norscode_native.no", 330)

    linje("")
    linje("== Konklusjon ==")
    linje("Hvis dist/norscode_native er stage0-kopi, må ny stage0 publiseres før random_hex virker i serve-runtime.")
    returner 0
}
