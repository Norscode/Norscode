// tools/python_dependency_audit.no — Python-audit i Norscode

bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}
funksjon env(namn: tekst) -> tekst {
    prøv {
        returner miljo_hent(namn)
    } fang (e) {
        returner ""
    }
    returner ""
}
funksjon trim(t: tekst) -> tekst {
    returner builtin.trim(t)
}

funksjon count_lines(data: tekst) -> heiltall {
    la t = trim(data)
    hvis t == "" { returner 0 }
    returner lengde(builtin.split(t, "\n"))
}

funksjon py_filer(filer: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la linjer = builtin.split(filer, "\n")
    la i = 0
    mens i < lengde(linjer) {
        la fil = trim(linjer[i])
        hvis fil != "" og builtin.ends_with(fil, ".py") {
            legg_til(ut, fil)
        }
        i = i + 1
    }
    returner ut
}

funksjon er_generert_eller_cache(relativ: tekst) -> boolsk {
    hvis relativ == "build" eller builtin.starts_with(relativ, "build/") { returner sann }
    hvis relativ == ".norscode" eller builtin.starts_with(relativ, ".norscode/") { returner sann }
    hvis relativ == ".git" eller builtin.starts_with(relativ, ".git/") { returner sann }
    hvis relativ == "release-artifacts" eller builtin.starts_with(relativ, "release-artifacts/") { returner sann }
    returner usann
}

funksjon alle_filer(root: tekst, under: tekst) -> tekst {
    la kø: liste_tekst = [under]
    la filer: liste_tekst = []
    la qi = 0
    mens qi < lengde(kø) {
        la katalog = kø[qi]
        la listing = native_fs.native_list(root, katalog)
        hvis listing["status"] == "ok" {
            la barn = builtin.split(listing["data"], "\n")
            la bi = 0
            mens bi < lengde(barn) {
                la namn = trim(barn[bi])
                hvis namn != "" {
                    la relativ = namn
                    hvis katalog != "" { relativ = katalog + "/" + namn }
                    hvis ikkje er_generert_eller_cache(relativ) {
                        hvis native_fs.native_list(root, relativ)["status"] == "ok" {
                            legg_til(kø, relativ)
                        } ellers hvis builtin.ends_with(relativ, ".py") {
                            legg_til(filer, relativ)
                        }
                    }
                }
                bi = bi + 1
            }
        }
        qi = qi + 1
    }
    la out = ""
    la i = 0
    mens i < lengde(filer) {
        out = out + filer[i] + "\n"
        i = i + 1
    }
    returner trim(out)
}

funksjon linjer_til_tekst(linjer: liste_tekst) -> tekst {
    la out = ""
    la i = 0
    mens i < lengde(linjer) {
        out = out + linjer[i] + "\n"
        i = i + 1
    }
    returner trim(out)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la output_dir = root + "/reports"
    la output_file = output_dir + "/python_dependency_report.txt"
    la laga = native_fs.native_lag_mappe(root, "reports")
    hvis laga["status"] != "ok" og ikkje fil_finnes(output_dir) {
        linje("Feil: kunne ikkje lage reports/")
        returner 1
    }

    la tools_py = linjer_til_tekst(py_filer(alle_filer(root, "tools")))
    la repo_py = linjer_til_tekst(py_filer(alle_filer(root, "")))
    la tools_count = count_lines(tools_py)
    la repo_count = count_lines(repo_py)

    la rapport = "=== Norscode Python-avhengnadsrapport ===\n\n"
    rapport = rapport + "Python-filer i tools/ (må vere 0 i normal flyt): " + tekst_fra_heltall(tools_count) + "\n"
    hvis tools_py != "" { rapport = rapport + tools_py + "\n" }
    rapport = rapport + "\nPython-filer i repo (ekskl. .git): " + tekst_fra_heltall(repo_count) + "\n"
    hvis repo_py != "" { rapport = rapport + repo_py + "\n" }
    rapport = rapport + "\nTip: Bruk ./bin/nc local-green for full normal/legacy-surface policy.\n"
    rapport = rapport + "Merk: rapporten kan innehalde Python i archive/scripts som er tillate per policy.\n"

    builtin.fil_skriv(output_file, rapport)
    linje("Python-audit skreiv rapport: reports/python_dependency_report.txt")

    hvis tools_count != 0 {
        linje("Feil: Python i tools/ er ikkje tillatt i normal flyt. Sjå reports/python_dependency_report.txt")
        returner 1
    }
    linje("OK: ingen Python i tools/")
    returner 0
}
