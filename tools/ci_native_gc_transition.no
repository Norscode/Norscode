// Avgrensa overgangslane for dei attverande native GC-C-probene.
// Prosessane er strukturerte; sjølve C-kjeldene blir fjerna i fase 5.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    la namn = delar[lengde(delar) - 1]
    returner builtin.slice(namn, 0, lengde(namn) - 2)
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst,
              miljø: ordbok_tekst) -> boolsk {
    la resultat = prosess.køyr(executable, argv, root, miljø, 180000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon start() -> heiltall {
    la root = "."
    prøv { root = builtin.miljo_hent("NORSCODE_ROOT") } fang (e) {}
    hvis root == "" { root = "." }
    la outdir = root + "/build/native-gc-tests"
    hvis ikkje filops.lag_katalogar(outdir) { returner 1 }
    la kjelder = [
        "tests/native_gc_blocked_thread.c",
        "tests/native_gc_exception_unwind.c",
        "tests/native_gc_generational.c",
        "tests/native_gc_lifecycle.c",
        "tests/native_gc_relocation.c",
        "tests/native_gc_threads.c"
    ]
    la i: heiltall = 0
    mens i < lengde(kjelder) {
        la ut = outdir + "/" + basename(kjelder[i])
        hvis ikkje køyr("/usr/bin/cc", ["-O2", "-std=c11", "-pthread", root + "/" + kjelder[i], "-o", ut], root, {}) {
            returner 1
        }
        hvis ikkje køyr(ut, [], root, {}) { returner 1 }
        i = i + 1
    }
    la asan = outdir + "/native_gc_relocation_asan"
    hvis ikkje køyr("/usr/bin/cc", ["-O1", "-g", "-fsanitize=address,undefined",
        "-fno-omit-frame-pointer", "-std=c11", "-pthread",
        root + "/tests/native_gc_relocation.c", "-o", asan], root, {}) { returner 1 }
    hvis ikkje køyr(asan, [], root, {"ASAN_OPTIONS": "halt_on_error=1"}) { returner 1 }
    skriv("Native GC-overgangsprober OK\n")
    returner 0
}

