// tools/completion_gate.no — autoritativ Norscode 1.0-sluttport

// 2026-09-10: migrert bort frå `exec_prosess` (legacy tekstprosess-kall) til den
// strukturerte prosess-ABI-en. Den gamle forma bygde shellstrengar av typen
// «cd <root> && <cmd>» og «shasum -a 256 <sti>» med manuell quoting — nettopp
// det aktiv-flate-porten avviser. Kallstadene her er heilt regelmessige
// (`./bin/nc <underkommando>` med eventuelle VAR=verdi-prefiks), so dei går rett
// over til executable + argv + miljøkart, med `cwd` som PARAMETER i staden for
// eit «cd … &&»-prefiks. To kall trong ikkje prosess i det heile:
//   shasum/sha256sum → builtin.sha256_bytes(fil_les_binær(...))
//   pwd              → builtin.system_info()["cwd"]

bruk std.runtime_status som runtime_status
bruk std.stdlib_status som stdlib_status
bruk selfhost.ncb_serde som serde
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

// Strukturert kall: eksplisitt executable, argv-liste, arbeidskatalog og
// miljø-overlay. Ingen shell, ingen quoting, ingen PATH-oppslag.
funksjon køyr(exe: tekst, argv: liste_tekst, cwd: tekst, miljø: ordbok_tekst) -> ordbok_tekst {
    prøv { returner prosess.køyr(exe, argv, cwd, miljø, 3600000) }
    fang (e) { returner {"status": "feil", "exit_code": "1", "stdout": "", "stderr": tekst(e)} }
}

funksjon inneheld(data: tekst, needle: tekst) -> bool {
    returner builtin.index_of(data, needle) >= 0
}

funksjon køyr_steg(root: tekst, rapport: ordbok_tekst, nøkkel: tekst, namn: tekst,
                   argv: liste_tekst, miljø: ordbok_tekst) -> bool {
    skriv("\n=== " + namn + " ===\n")
    la res = køyr(root + "/bin/nc", argv, root, miljø)
    hvis tekst(res["stdout"]) != "" { skriv(tekst(res["stdout"])) }
    hvis tekst(res["stderr"]) != "" { skriv(tekst(res["stderr"])) }
    hvis prosess.ok(res) {
        rapport[nøkkel] = "green"
        returner sann
    }
    rapport[nøkkel] = "red"
    skriv("[FAIL] " + namn + "\n")
    returner usann
}

// Rein Norscode-hash: ingen shasum/sha256sum-prosess.
funksjon sha256(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon git_rein(root: tekst) -> bool {
    la res = køyr("git", ["status", "--porcelain", "--untracked-files=all"], root, {})
    hvis ikkje prosess.ok(res) { returner usann }
    returner trim(tekst(res["stdout"])) == ""
}

funksjon attestasjon_ok(root: tekst, sti: tekst, platform: tekst, arch: tekst, commit: tekst) -> bool {
    hvis sti == "" { returner usann }
    prøv {
        la data = serde.les_fil(sti)
        hvis tekst(data["status"]) != "verified" { returner usann }
        hvis tekst(data["platform"]) != platform { returner usann }
        hvis arch != "" og tekst(data["architecture"]) != arch { returner usann }
        hvis tekst(data["source_commit"]) != commit { returner usann }
        la expected_hash = tekst(data["runtime_sha256"])
        hvis expected_hash == "" { returner usann }
        la candidate = attestasjon_runtime_path(root, platform, arch)
        hvis candidate == "" eller ikkje fil_finnes(candidate) { returner usann }
        hvis sha256(candidate) != expected_hash { returner usann }
        la repo = env("GITHUB_REPOSITORY")
        hvis repo == "" { returner usann }
        returner prosess.ok(køyr("gh", ["attestation", "verify", sti, "--repo", repo], root, {}))
    } fang (e) { returner usann }
    returner usann
}

funksjon attestasjon_runtime_path(root: tekst, platform: tekst, arch: tekst) -> tekst {
    la override = env("NORSCODE_" + builtin.tekst_til_store(platform) + "_" + builtin.tekst_til_store(arch) + "_RUNTIME")
    hvis override != "" { returner override }
    hvis platform == "macos" og arch == "arm64" { returner root + "/bootstrap/stage0/norscode-macos-arm64" }
    hvis platform == "linux" og arch == "x86_64" { returner root + "/dist/norscode_native" }
    hvis platform == "linux" og arch == "arm64" { returner root + "/bootstrap/stage0/norscode-linux-arm64" }
    hvis platform == "windows" { returner root + "/build/windows/norscode_native_windows_x86_64.exe" }
    returner ""
}

funksjon skriv_rapport(sti: tekst, rapport: ordbok_tekst) -> bool {
    prøv {
        builtin.mkdir_p("reports")
        builtin.fil_skriv(sti, builtin.json_stringify(rapport) + "\n")
        returner sann
    } fang (e) {
        skriv("[FAIL] kunne ikkje skrive sluttportrapport: " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." } }
    la modus = env("NORSCODE_COMPLETION_MODE")
    hvis modus != "local" og modus != "release" {
        skriv("bruk: ./bin/nc completion-gate --local|--release\n")
        returner 2
    }

    la rapport: ordbok_tekst = {}
    rapport["schema"] = "norscode-completion-gate-v1"
    rapport["mode"] = modus
    rapport["source_commit"] = trim(tekst(køyr("git", ["rev-parse", "HEAD"], root, {})["stdout"]))
    rapport["commit"] = rapport["source_commit"]
    rapport["runtime_sha256"] = sha256(root + "/dist/norscode_native")
    rapport["stage0_macos_sha256"] = sha256(root + "/bootstrap/stage0/norscode-macos-arm64")
    rapport["runtime_hashes"] = {"dist": rapport["runtime_sha256"], "stage0_macos": rapport["stage0_macos_sha256"]}
    rapport["working_tree_clean"] = "false"
    hvis git_rein(root) { rapport["working_tree_clean"] = "true" }

    la alle_ok = sann
    // VAR=verdi-prefiksa i dei gamle shellstrengane er no eksplisitte miljøkart.
    la tomt: ordbok_tekst = {}
    la t600: ordbok_tekst = {"TEST_TIMEOUT": "600"}
    la treg: ordbok_tekst = {"NC_SLOW_TESTS": "1", "SLOW_TEST_TIMEOUT": "600"}
    hvis ikkje køyr_steg(root, rapport, "local_green", "Streng lokal grønnliste", ["local-green", "--strict"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "normal_tests", "Normal testsuite", ["test"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "release_preflight", "Release-preflight", ["release-preflight", "--strict"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "active_surface", "Aktiv flate", ["active-surface"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "phase0", "Fase-0", ["phase0-verify"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "selvstendighet", "L1-L6 sjølvstendighet", ["selvstendighet"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "bootstrap", "Bootstrap-gate", ["selfhost-bootstrap-gate"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "l5_parity", "L5 byte-paritet", ["selfcompile-l5"], tomt) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "l5b_parity", "L5b byte-paritet", ["selfcompile-l5b"], t600) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "l5b_mini_parity", "L5b-mini byte-paritet", ["selfcompile-l5b-mini"], t600) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "slow_tests", "Langtidsflate", ["test"], treg) { alle_ok = usann }
    hvis ikkje køyr_steg(root, rapport, "user_journey", "Pakka brukarferd", ["run", "tools/release_user_journey.no"], tomt) { alle_ok = usann }

    // Stable machine-readable aliases for consumers of the versioned report.
    rapport["local_test_status"] = rapport["normal_tests"]
    rapport["slow_test_status"] = rapport["slow_tests"]
    rapport["user_journey_status"] = rapport["user_journey"]
    rapport["independence_status"] = rapport["selvstendighet"]
    rapport["bootstrap_parity_status"] = rapport["bootstrap"]

    la rt = runtime_status.samandrag()
    la std = stdlib_status.samandrag()
    rapport["runtime_stable"] = rt["stabil"]
    rapport["runtime_total"] = rt["total"]
    rapport["stdlib_stable"] = std["stabil"]
    rapport["stdlib_total"] = std["total"]
    rapport["runtime_status"] = "red"
    rapport["stdlib_status"] = "red"
    hvis rt["stabil"] == "22" og rt["total"] == "22" { rapport["runtime_status"] = "green" }
    hvis std["stabil"] == "61" og std["total"] == "61" { rapport["stdlib_status"] = "green" }
    hvis rapport["working_tree_clean"] != "true" {
        skriv("[FAIL] sluttport krev rein spora kjelde\n")
        alle_ok = usann
    }
    hvis rapport["runtime_status"] != "green" eller rapport["stdlib_status"] != "green" {
        skriv("[FAIL] sluttport krev runtime 22/22 og stdlib 61/61\n")
        alle_ok = usann
    }

    rapport["platform_status"] = "not_required_local"
    hvis modus == "release" {
        hvis rapport["working_tree_clean"] != "true" {
            skriv("[FAIL] release-sluttport krev rein spora kjelde\n")
            alle_ok = usann
        }
        hvis rapport["runtime_status"] != "green" eller rapport["stdlib_status"] != "green" {
            skriv("[FAIL] release-sluttport krev runtime 22/22 og stdlib 61/61\n")
            alle_ok = usann
        }
        la commit = rapport["source_commit"]
        la mac_ok = attestasjon_ok(root, env("NORSCODE_MACOS_ATTESTATION"), "macos", "arm64", commit)
        la linux_x64_ok = attestasjon_ok(root, env("NORSCODE_LINUX_X86_64_ATTESTATION"), "linux", "x86_64", commit)
        la linux_arm_ok = attestasjon_ok(root, env("NORSCODE_LINUX_ARM64_ATTESTATION"), "linux", "arm64", commit)
        la windows_ok = attestasjon_ok(root, env("NORSCODE_WINDOWS_ATTESTATION"), "windows", "", commit)
        rapport["production_ready_macos"] = tekst(mac_ok)
        rapport["production_ready_linux_x86_64"] = tekst(linux_x64_ok)
        rapport["production_ready_linux_arm64"] = tekst(linux_arm_ok)
        rapport["production_ready_windows"] = tekst(windows_ok)
        rapport["platform_attestations"] = {"macos_arm64": tekst(mac_ok), "linux_x86_64": tekst(linux_x64_ok), "linux_arm64": tekst(linux_arm_ok), "windows_x86_64": tekst(windows_ok)}
        hvis mac_ok og linux_x64_ok og linux_arm_ok og windows_ok {
            rapport["platform_status"] = "green"
            rapport["production_ready_all_platforms"] = "true"
        } ellers {
            rapport["platform_status"] = "red"
            rapport["production_ready_all_platforms"] = "false"
            alle_ok = usann
        }
    }

    rapport["overall"] = "red"
    hvis alle_ok { rapport["overall"] = "green" }
    la rapportsti = env("NORSCODE_COMPLETION_REPORT")
    hvis rapportsti == "" { rapportsti = root + "/reports/norscode-completion-v1.json" }
    hvis ikkje skriv_rapport(rapportsti, rapport) { returner 1 }
    skriv("\nSluttportrapport: " + rapportsti + "\n")
    skriv(builtin.json_stringify(rapport) + "\n")
    hvis ikkje alle_ok { returner 1 }
    skriv("=== Norscode completion gate: GREEN ===\n")
    returner 0
}
