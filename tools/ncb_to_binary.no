// tools/ncb_to_binary.no — konverter ein NCB (JSON eller binær) til det
// deterministiske BINÆRformatet. Brukt i CI for å produsere binær-NCB frå den
// gamle (JSON-only) seed-en, so heile binær→native-lykkja kan verifiserast.
// IN_NCB → OUT_NCB (binær med magic-header).
bruk selfhost.ncb_serde som serde

funksjon start() -> heiltall {
    la inn = miljo_hent("IN_NCB")
    la ut = miljo_hent("OUT_NCB")
    hvis inn == "" eller ut == "" { skriv("IN_NCB og OUT_NCB påkravde\n") returner 2 }
    la ncb = serde.deserialiser(builtin.fil_les_binary(inn))   // dual-format inn
    la bytes = serde.serialiser(ncb)                            // binær ut
    builtin.fil_skriv_binary(ut, bytes)
    skriv("binær NCB skrive: " + ut + " (" + tekst(lengde(bytes)) + " bytes)\n")
    returner 0
}
