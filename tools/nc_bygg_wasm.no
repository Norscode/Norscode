# nc_bygg_wasm.no — byggjer eit .wasm-modul frå ei Norscode-fil.
#
# Kompilerer fila, lowrar kvar heiltals-/parameter-funksjon til WASM, og skriv
# eit gyldig WebAssembly MVP-modul. Funksjonar som ikkje kan lowrast (kontroll-
# flyt, kall, strengar) blir hoppa over.
#
# Miljø: NORSCODE_WASM_SRC (kjeldefil), NORSCODE_WASM_OUT (utfil, standard ut.wasm)

bruk selfhost.kompiler som kompiler
bruk std.wasm_binary som w

funksjon kort_namn(fullt: tekst) -> tekst {
    la delar = builtin.split(fullt, ".")
    returner delar[lengde(delar) - 1]
}

funksjon start() -> heiltall {
    la src = miljo_hent("NORSCODE_WASM_SRC")
    la out = miljo_hent("NORSCODE_WASM_OUT")
    hvis src == "" {
        skriv("bruk: nc bygg-wasm <fil.no> [-o ut.wasm]\n")
        returner 2
    }
    hvis out == "" { out = "ut.wasm" }

    la kjelde = fil_les(src)
    la ncb_json = kompiler.kompiler_fil(kjelde, "__main__")
    la ncb = builtin.json_parse_raw(ncb_json)
    la fns = ncb["functions"]
    la namn_liste = builtin.nøkler(fns)

    la spekar = []
    la hoppa = 0
    la i = 0
    mens i < lengde(namn_liste) {
        la fnamn = tekst(namn_liste[i])
        hvis ikkje builtin.starts_with(kort_namn(fnamn), "__") {
            la fdef = fns[fnamn]
            prøv {
                la spek = w.spek_frå_ncb(kort_namn(fnamn), fdef["params"], fdef["code"])
                legg_til(spekar, spek)
            } fang (e) {
                hoppa = hoppa + 1
            }
        }
        i = i + 1
    }

    hvis lengde(spekar) == 0 {
        skriv("nc bygg-wasm: ingen lowrbare (heiltals-)funksjonar i " + src + "\n")
        returner 1
    }

    la modul = w.bygg_modul(spekar)
    builtin.fil_skriv_binær(out, modul)
    skriv("WASM skrive: " + out + " (" + tekst(lengde(modul)) + " byte, "
        + tekst(lengde(spekar)) + " funksjonar, " + tekst(hoppa) + " hoppa over)\n")
    returner 0
}
