// tools/x86_batch_host.no — driver for batch-x86_64-codegen (låg-minne).
//
// Køyrer éin fase av native_codegen_v2 sin batch-ELF-veg per prosess, styrt av
// NC_X86_MODE. run-ncb-pure gjev vm.no sin GC, og prosess-isolasjon per batch
// frigjer minnet, så toppminnet held seg på ~éin batch i staden for ~11 GB for
// heile programmet i eitt kall.
//
// Modus + miljø:
//   plan    : NC_X86_NCB → skriv total funksjonstal til NC_X86_OUT
//   measure : NC_X86_NCB, NC_X86_START, NC_X86_COUNT → sizes-JSON til NC_X86_OUT
//   emit    : NC_X86_NCB, NC_X86_SIZES, NC_X86_START, NC_X86_COUNT → rå bytes til NC_X86_OUT
//   link    : NC_X86_NCB, NC_X86_SIZES, NC_X86_FRAGS (kommaskilt) → ELF til NC_X86_BIN

bruk selfhost.native_execution.native_codegen_v2 som cg

funksjon env(n: tekst) -> tekst { prøv { returner miljo_hent(n) } fang (e) { returner "" } }

funksjon start() -> heiltall {
    la mode = env("NC_X86_MODE")
    la ncb_path = env("NC_X86_NCB")
    hvis ncb_path == "" { skriv("x86_batch_host: NC_X86_NCB påkravd\n") returner 2 }
    la ncb_json = builtin.fil_les(ncb_path)
    la ncb = builtin.json_parse_raw(ncb_json)

    hvis mode == "plan" {
        la plan = cg.ncval_x86_plan(ncb)
        la total = lengde(plan["order"])
        builtin.fil_skriv(env("NC_X86_OUT"), tekst_fra_heltall(total))
        skriv("[plan] " + tekst_fra_heltall(total) + " funksjonar\n")
        returner 0
    }
    hvis mode == "measure" {
        la start = heltall_fra_tekst(env("NC_X86_START"))
        la count = heltall_fra_tekst(env("NC_X86_COUNT"))
        la mres = cg.ncval_x86_measure(ncb, start, count)
        hvis mres["ok"] != "sann" { skriv("[measure FEIL] " + tekst(mres["error"]) + "\n") returner 1 }
        builtin.fil_skriv(env("NC_X86_OUT"), builtin.json_skriv(mres["sizes"]))
        skriv("[measure " + tekst_fra_heltall(start) + "] ok\n")
        returner 0
    }
    hvis mode == "emit" {
        la start = heltall_fra_tekst(env("NC_X86_START"))
        la count = heltall_fra_tekst(env("NC_X86_COUNT"))
        la sizes = builtin.json_parse_raw(builtin.fil_les(env("NC_X86_SIZES")))
        la eres = cg.ncval_x86_emit(ncb, sizes, start, count)
        hvis eres["ok"] != "sann" { skriv("[emit FEIL] " + tekst(eres["error"]) + "\n") returner 1 }
        builtin.fil_skriv_binær(env("NC_X86_OUT"), eres["bytes"])
        skriv("[emit " + tekst_fra_heltall(start) + "] bytes=" + tekst_fra_heltall(lengde(eres["bytes"])) + "\n")
        returner 0
    }
    hvis mode == "link" {
        la sizes = builtin.json_parse_raw(builtin.fil_les(env("NC_X86_SIZES")))
        la frag_paths = builtin.split(env("NC_X86_FRAGS"), ",")
        la frags: liste = []
        la i: heiltall = 0
        mens i < lengde(frag_paths) {
            legg_til(frags, builtin.fil_les_binær(frag_paths[i]))
            i = i + 1
        }
        la lres = cg.ncval_x86_link(ncb_json, ncb, sizes, frags)
        hvis lres["ok"] != "sann" { skriv("[link FEIL] " + tekst(lres["error"]) + "\n") returner 1 }
        builtin.fil_skriv_binær(env("NC_X86_BIN"), lres["elf"])
        skriv("[link] elf=" + tekst_fra_heltall(lengde(lres["elf"])) + " bytes\n")
        returner 0
    }
    skriv("x86_batch_host: ukjend NC_X86_MODE: " + mode + "\n")
    returner 2
}
