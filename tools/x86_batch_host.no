// tools/x86_batch_host.no — driver for batch-x86_64-codegen (låg-minne).
//
// Køyrer éin fase av native_codegen_v2 sin batch-ELF-veg per prosess, styrt av
// NC_X86_MODE. run-ncb-pure gjev vm.no sin GC, og prosess-isolasjon per batch
// frigjer minnet, så toppminnet held seg på ~éin batch i staden for ~11 GB for
// heile programmet i eitt kall.
//
// SETUP-CACHE: det tunge deterministiske oppsettet (samle_strenger + bygg_data +
// bygg_runtime over heile programmet) er ~10 min interpretert. `prep` byggjer det
// éin gong og serialiserer det; måle/emit/link LASTAR cachen i staden for å byggje
// på nytt, så per-batch-kostnaden fell til NCB-parse + kompilering av utsnittet.
//
// Modus + miljø:
//   prep    : NC_X86_NCB → NC_X86_CACHE (json) + NC_X86_RT (bin) + NC_X86_DATA (bin) + NC_X86_OUT (total)
//   measure : NC_X86_NCB, NC_X86_CACHE, NC_X86_START, NC_X86_COUNT → sizes-JSON til NC_X86_OUT
//   emit    : NC_X86_NCB, NC_X86_CACHE, NC_X86_SIZES, NC_X86_START, NC_X86_COUNT → rå bytes til NC_X86_OUT
//   link    : NC_X86_NCB, NC_X86_CACHE, NC_X86_RT, NC_X86_DATA, NC_X86_SIZES, NC_X86_FRAGS → ELF til NC_X86_BIN

bruk selfhost.native_execution.native_codegen_v2 som cg
bruk selfhost.ncb_serde som serde

funksjon env(n: tekst) -> tekst { prøv { returner miljo_hent(n) } fang (e) { returner "" } }

// Bygg eit oppsett-dict (utan rt/data_bytes) frå cache-json + parsa fns. Nok for
// måle/emit; link legg til rt + data_bytes.
funksjon oppsett_frå_cache(fns, cache) -> ordbok {
    returner {
        "fns": fns,
        "sorted": cache["sorted"],
        "rd_offs": cache["rd_offs"],
        "atomic_vas": cache["atomic_vas"],
        "global_vas": cache["global_vas"],
        "gc_safepoint_va": cache["gc_safepoint_va"],
        "rt_size": cache["rt_size"],
        "module_initializers": cache["module_initializers"],
        "start_fn": cache["start_fn"]
    }
}

funksjon start() -> heiltall {
    la mode = env("NC_X86_MODE")
    la ncb_path = env("NC_X86_NCB")
    hvis ncb_path == "" { skriv("x86_batch_host: NC_X86_NCB påkravd\n") returner 2 }
    la ncb_json = builtin.fil_les(ncb_path)
    la ncb = builtin.json_parse_raw(ncb_json)

    hvis mode == "prep" {
        la oppsett = cg.ncval_x86_setup(ncb)
        // Serialiser alt unntatt fns; rt/data_bytes som binær, resten som json.
        la cache = {
            "sorted": oppsett["sorted"],
            "rd_offs": oppsett["rd_offs"],
            "atomic_vas": oppsett["atomic_vas"],
            "global_vas": oppsett["global_vas"],
            "gc_safepoint_va": oppsett["gc_safepoint_va"],
            "rt_size": oppsett["rt_size"],
            "module_initializers": oppsett["module_initializers"],
            "start_fn": oppsett["start_fn"]
        }
        builtin.fil_skriv(env("NC_X86_CACHE"), builtin.json_skriv(cache))
        builtin.fil_skriv_binær(env("NC_X86_RT"), oppsett["rt"])
        builtin.fil_skriv_binær(env("NC_X86_DATA"), oppsett["data_bytes"])
        builtin.fil_skriv(env("NC_X86_OUT"), tekst_fra_heltall(lengde(oppsett["sorted"])))
        skriv("[prep] " + tekst_fra_heltall(lengde(oppsett["sorted"])) + " funksjonar, rt=" + tekst_fra_heltall(lengde(oppsett["rt"])) + " data=" + tekst_fra_heltall(lengde(oppsett["data_bytes"])) + "\n")
        returner 0
    }
    hvis mode == "measure" {
        la cache = serde.les_fil(env("NC_X86_CACHE"))
        la oppsett = oppsett_frå_cache(ncb["functions"], cache)
        la start = heltall_fra_tekst(env("NC_X86_START"))
        la count = heltall_fra_tekst(env("NC_X86_COUNT"))
        la mres = cg.ncval_x86_measure_with(oppsett, start, count)
        hvis mres["ok"] != "sann" { skriv("[measure FEIL] " + tekst(mres["error"]) + "\n") returner 1 }
        builtin.fil_skriv(env("NC_X86_OUT"), builtin.json_skriv(mres["sizes"]))
        skriv("[measure " + tekst_fra_heltall(start) + "] ok\n")
        returner 0
    }
    hvis mode == "emit" {
        la cache = serde.les_fil(env("NC_X86_CACHE"))
        la oppsett = oppsett_frå_cache(ncb["functions"], cache)
        la start = heltall_fra_tekst(env("NC_X86_START"))
        la count = heltall_fra_tekst(env("NC_X86_COUNT"))
        la sizes = serde.les_fil(env("NC_X86_SIZES"))
        la eres = cg.ncval_x86_emit_with(oppsett, sizes, start, count)
        hvis eres["ok"] != "sann" { skriv("[emit FEIL] " + tekst(eres["error"]) + "\n") returner 1 }
        builtin.fil_skriv_binær(env("NC_X86_OUT"), eres["bytes"])
        skriv("[emit " + tekst_fra_heltall(start) + "] bytes=" + tekst_fra_heltall(lengde(eres["bytes"])) + "\n")
        returner 0
    }
    hvis mode == "link" {
        la cache = serde.les_fil(env("NC_X86_CACHE"))
        la oppsett = oppsett_frå_cache(ncb["functions"], cache)
        oppsett["rt"] = builtin.fil_les_binær(env("NC_X86_RT"))
        oppsett["data_bytes"] = builtin.fil_les_binær(env("NC_X86_DATA"))
        la sizes = serde.les_fil(env("NC_X86_SIZES"))
        la frag_paths = builtin.split(env("NC_X86_FRAGS"), ",")
        la frags: liste = []
        la i: heiltall = 0
        mens i < lengde(frag_paths) {
            legg_til(frags, builtin.fil_les_binær(frag_paths[i]))
            i = i + 1
        }
        la lres = cg.ncval_x86_link_with(ncb_json, oppsett, sizes, frags)
        hvis lres["ok"] != "sann" { skriv("[link FEIL] " + tekst(lres["error"]) + "\n") returner 1 }
        builtin.fil_skriv_binær(env("NC_X86_BIN"), lres["elf"])
        skriv("[link] elf=" + tekst_fra_heltall(lengde(lres["elf"])) + " bytes\n")
        returner 0
    }
    skriv("x86_batch_host: ukjend NC_X86_MODE: " + mode + "\n")
    returner 2
}
