// tools/fixtures/diff_varargs.no — Omgang 5: varargs/rest-param differensial-fixtur.
// Testar M10 rest-param i native codegen: overskytande argument → liste.
// Forventa exit = 42.
funksjon sum_rest(fyrste: heiltall, ...resten) -> heiltall {
    la sum = fyrste
    la i = 0
    mens i < lengde(resten) {
        sum = sum + resten[i]
        i = i + 1
    }
    returner sum
}
funksjon start() -> heiltall {
    returner sum_rest(30, 10, 2)   // 30 + 10 + 2 = 42
}
