// tools/fixtures/diff_desimal_samanlikning.no — aotfloat: blanda desimal/heiltal-
// samanlikning og addisjon i AOT mot tolken. Forventa exit = 42 (tolk og AOT);
// elles 100 + nummeret på den første sjekken som feila (meldinga står på stdout).
//
// Rota (2026-09-26): codegen-typehintet «int» var flyt-ufølsamt (siste lagring i
// lineær kode vinn, og SUB/MUL/DIV gav alltid «int»), og COMPARE_LE/GE + BINARY_ADD
// valde då ein UVAKTA heiltalsveg over IEEE-bita til eit desimaltall: `1.75 >= 2`
// var sann i AOT. Same feil gjorde at codegen-ELF-en koda brøk-konstantar feil
// (desimal_ieee_bits: 3.5 → 4.0). Kvar sjekk under trefte ein av desse vegane.

funksjon feil(t, nr: heiltall, namn: tekst) -> heiltall {
    skriv("  [FEIL] sjekk " + tekst_fra_heltall(nr) + ": " + namn + "\n")
    hvis t["første"] == 0 { t["første"] = nr }
    returner 0
}

// `a` får hintet «int» frå `a = a / 2` (DIV) — den gamle vegen samanlikna bita.
funksjon halver_og_samanlikn(v) -> heiltall {
    la a = v
    a = a / 2
    hvis a >= 2 { returner 1 }
    returner 0
}

// `x` er «int» ved lagringa FØR løkka i lineær kode, men desimal frå 2. runde.
funksjon løkke_ge() -> heiltall {
    la x = 0
    la n = 0
    mens x < 3 {
        hvis x >= 1 { n = n + 1 }
        x = x + 0.75
    }
    returner n            // x: 0, 0.75, 1.5, 2.25 → 2
}

// `y` er «int» ved `y + 1`, men held desimaltal frå 2. runde (inline-ADD på bita).
funksjon løkke_add() {
    la y = 1
    la i = 0
    la sum = 0.0
    mens i < 3 {
        la z = y + 1
        sum = sum + z
        y = y * 0.5
        i = i + 1
    }
    returner sum          // 2 + 1.5 + 1.25 = 4.75
}

// LE med same felle, og negative verdiar.
funksjon løkke_le_neg() -> heiltall {
    la x = 0
    la n = 0
    mens x > 0 - 3 {
        hvis x <= 0 - 1 { n = n + 1 }
        x = x - 0.75
    }
    returner n            // x: 0, -0.75, -1.5, -2.25 → 2
}

funksjon start() -> heiltall {
    la t = {"første": 0}
    la a = 1.75
    hvis a >= 2 { feil(t, 1, "1.75 >= 2 skal vere usann") }
    hvis ikkje (a <= 2) { feil(t, 2, "1.75 <= 2 skal vere sann") }
    hvis ikkje (a > 1) { feil(t, 3, "1.75 > 1 skal vere sann") }
    hvis a < 1 { feil(t, 4, "1.75 < 1 skal vere usann") }
    hvis ikkje (2 >= a) { feil(t, 5, "2 >= 1.75 skal vere sann") }
    hvis 2 <= a { feil(t, 6, "2 <= 1.75 skal vere usann") }
    hvis a == 2 { feil(t, 7, "1.75 == 2 skal vere usann") }
    hvis ikkje (a != 2) { feil(t, 8, "1.75 != 2 skal vere sann") }
    hvis ikkje (2.0 == 2) { feil(t, 9, "2.0 == 2 skal vere sann") }
    hvis ikkje (2 >= 2.0) { feil(t, 10, "2 >= 2.0 skal vere sann") }
    hvis halver_og_samanlikn(3.5) != 0 { feil(t, 11, "3.5 / 2 >= 2 skal vere usann") }
    hvis halver_og_samanlikn(5) != 1 { feil(t, 12, "5 / 2 >= 2 (heiltalsdivisjon) skal vere sann") }
    hvis løkke_ge() != 2 { feil(t, 13, "løkke med x >= 1 over desimaltal skal telje 2") }
    hvis builtin.desimal_til_bits(løkke_add()) != 4617034042984890368 { feil(t, 14, "løkke med y + 1 over desimaltal skal gje 4.75") }
    hvis løkke_le_neg() != 2 { feil(t, 15, "løkke med x <= -1 over negative desimaltal skal telje 2") }
    // Negative og store verdiar.
    la n = 0 - 1.5
    hvis n >= 0 - 1 { feil(t, 16, "-1.5 >= -1 skal vere usann") }
    hvis ikkje (n <= 0 - 1) { feil(t, 17, "-1.5 <= -1 skal vere sann") }
    la stor = 10000000000.0 * 10000000000.0
    hvis ikkje (stor >= builtin.desimaltall("1e20")) { feil(t, 18, "1e10 * 1e10 >= desimaltall(\"1e20\") skal vere sann") }
    hvis stor <= 9223372036854775807 { feil(t, 19, "1e20 <= 2^63-1 skal vere usann") }
    la liten = 0.1 * 0.1
    hvis liten >= 0.011 { feil(t, 20, "0.01 >= 0.011 skal vere usann") }
    hvis ikkje (liten >= 0) { feil(t, 21, "0.01 >= 0 skal vere sann") }
    // Heiltalsvegen skal framleis vere heiltal.
    la k = 7
    la m = k + 5
    hvis ikkje (m >= 12) { feil(t, 22, "7 + 5 >= 12 skal vere sann") }
    hvis builtin.type(m) != "heltall" { feil(t, 23, "7 + 5 skal vere heiltal") }
    hvis t["første"] != 0 { returner 100 + t["første"] }
    returner 42
}
