// tools/fixtures/diff_hint_bakkant.no — a12fix: typehint som blir FEIL på bakkanten av ei
// løkke. Typehinta i x86-codegenen er flyt-ufølsame (typen ved den siste lagringa i lineær
// kode), so ein variabel som er tekst/bool i fyrste runde kan halde eit tal eller null i
// andre. aotfloat vakta heiltalssnarvegane; her er dei to som stod att:
//   * BINARY_ADD med «str»-hint konkatenerte alltid (VM: `2.5 + 1` = 3.5, AOT gav "2.51");
//   * JUMP_IF_FALSE med «bool»-hint las [rdi+8] utan null-/typesjekk (null → SIGSEGV).
// Forventa exit = 42 (tolk og AOT); elles 100 + nummeret på første sjekk som feila.

funksjon feil(t, nr: heiltall, namn: tekst, fekk: tekst) -> heiltall {
    skriv("  [FEIL] sjekk " + tekst_fra_heltall(nr) + ": " + namn + ", fekk «" + fekk + "»\n")
    hvis t["første"] == 0 { t["første"] = nr }
    returner 0
}

funksjon start() -> heiltall {
    la t = {"første": 0}
    // «str»-hint, desimaltal i andre runde.
    la y = "b"
    la j = 0
    la ut = ""
    mens j < 2 {
        la z = y + 1
        ut = ut + tekst(z) + ";"
        y = 2.5
        j = j + 1
    }
    hvis ut != "b1;3.5;" { feil(t, 1, "str-hint → desimaltal", ut) }
    // «str»-hint, heiltal i andre runde.
    la x = "a"
    la i = 0
    la ut2 = ""
    mens i < 2 {
        la z2 = x + 1
        ut2 = ut2 + tekst(z2) + ";"
        x = 5
        i = i + 1
    }
    hvis ut2 != "a1;6;" { feil(t, 2, "str-hint → heiltal", ut2) }
    // «str»-hint på høgre side: 1 + y.
    la w = "c"
    la k = 0
    la ut3 = ""
    mens k < 2 {
        la z3 = 1 + w
        ut3 = ut3 + tekst(z3) + ";"
        w = 4
        k = k + 1
    }
    hvis ut3 != "1c;5;" { feil(t, 3, "str-hint høgre → heiltal", ut3) }
    // «bool»-hint, null i andre runde (før: SIGSEGV i AOT).
    la ok = sann
    la m = 0
    la n = 0
    mens m < 2 {
        hvis ok { n = n + 1 }
        ok = null
        m = m + 1
    }
    hvis n != 1 { feil(t, 4, "bool-hint → null", tekst(n)) }
    // «bool»-hint, heiltal/tekst i andre runde (sanning som VM-en).
    la b2 = usann
    la p = 0
    la n2 = 0
    mens p < 3 {
        hvis b2 { n2 = n2 + 1 }
        hvis p == 0 { b2 = 7 } ellers { b2 = "" }
        p = p + 1
    }
    hvis n2 != 1 { feil(t, 5, "bool-hint → 7 / \"\"", tekst(n2)) }
    // Kontroll: ekte tekst + tekst og ekte bool er urørte.
    hvis "a" + "b" != "ab" { feil(t, 6, "tekst + tekst", "a" + "b") }
    la sann_v = 3 > 2
    la n3 = 0
    hvis sann_v { n3 = 1 }
    hvis n3 != 1 { feil(t, 7, "bool", tekst(n3)) }
    hvis t["første"] != 0 { returner 100 + t["første"] }
    returner 42
}
