// tools/fixtures/diff_closure.no — Omgang 3: closure/lambda differensial-fixtur.
//
// Køyrt gjennom tools/differensial_sele.no: tolk (vm.køyr_ncb) og AOT
// (bygg-native) må gje same exit-kode. Testar M3 closures i native codegen:
//   BUILD_LAMBDA (fanga variabel `base`) + CALL_VALUE (indirekte kall, 1 arg).
// Forventa exit = 42.

funksjon start() -> heiltall {
    la base: heiltall = 40
    // fanga `base` frå ytre ramme; kalla med eitt argument.
    la add = fun(y: heiltall) -> base + y
    la ein: heiltall = add(1)          // 41
    // nøsta closure som fangar ein lokal som sjølv er ein closure-resultat.
    la grunn: heiltall = ein
    la neste = fun() -> grunn + 1
    returner neste()                   // 42
}
