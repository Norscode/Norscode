// tools/fixtures/diff_metode.no — Omgang 4 oppgåve 2: metode-dispatch differensial.
//
// Testar M5 metode-dispatch i native codegen: p.sum() vs q.sum() må dispatche på
// STRUKTUR-TYPEN i køyretid (Punkt.sum vs Kvadrat.sum — same metodenamn, ulik
// type). Forventa exit = 42.
//
// MERK: metodesyntaksen `funksjon Type.metode(...)` parsar seed-frontenden IKKJE
// enno, så AOT-sida (`bygg-native`) + differensial-selen ventar på seed-rebuild
// med M5-frontenden. Tolk-sida (kjelde-kompilator via kompiler.kompiler_fil) og
// den strukturelle codegen-verifikasjonen dekkjer dispatch-logikken i mellomtida.

struktur Punkt { x y }
funksjon Punkt.sum(self) -> heiltall { returner self.x + self.y }

struktur Kvadrat { s }
funksjon Kvadrat.sum(self) -> heiltall { returner self.s * self.s }

funksjon start() -> heiltall {
    la p = Punkt()
    p.x = 20
    p.y = 22
    la q = Kvadrat()
    q.s = 0
    la a = p.sum()      // 42  → Punkt.sum
    la b = q.sum()      // 0   → Kvadrat.sum (ikkje Punkt.sum!)
    returner a + b      // 42
}
