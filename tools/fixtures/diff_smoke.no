// Differensial-røyk: rein heiltalsaritmetikk (garantert AOT-støtta) → 42.
// Skal gje IDENTISK resultat tolk vs AOT.
funksjon dobbel(x: heiltall) -> heiltall { returner x * 2 }
funksjon start() -> heiltall {
    la a: heiltall = 15
    la b: heiltall = dobbel(a)   // 30
    returner a - 3 + b           // 12 + 30 = 42
}
