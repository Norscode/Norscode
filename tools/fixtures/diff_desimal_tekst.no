// tools/fixtures/diff_desimal_tekst.no — aotfloat: tekst() og json_skriv/json_stringify
// av desimaltal i AOT mot tolken. Forventa exit = 42 (tolk og AOT); elles 100 +
// nummeret på den første sjekken som feila (meldinga står på stdout).
//
// Før: AOT-json_stringify skreiv desimaltal som null (det native atomet kjende ikkje
// type 6), `"x=" + 3.5` gav "x=" (to_text-atomet gav tom streng), og json_skriv(2.0)
// gav "2" — som les attende som HEILTAL, so typen gjekk tapt i kvar JSON-rundtur.
// No: to_text/json_stringify-atoma har ein krok til std.desimaltall_tekst, og
// JSON-forma av eit heiltalsverdig desimaltall er «2.0». tekst(2.0) er framleis "2".

funksjon feil(t, nr: heiltall, namn: tekst, fekk: tekst) -> heiltall {
    skriv("  [FEIL] sjekk " + tekst_fra_heltall(nr) + ": " + namn + ", fekk «" + fekk + "»\n")
    hvis t["første"] == 0 { t["første"] = nr }
    returner 0
}

funksjon lik(t, nr: heiltall, fekk: tekst, venta: tekst) -> heiltall {
    hvis fekk != venta { feil(t, nr, "venta «" + venta + "»", fekk) }
    returner 0
}

funksjon start() -> heiltall {
    la t = {"første": 0}
    la x = 3.5
    // tekst() (gap-rutinga til std.desimaltall_tekst.til_tekst_gap)
    lik(t, 1, tekst(x), "3.5")
    lik(t, 2, tekst(0.1), "0.1")
    lik(t, 3, tekst(2.0), "2")
    lik(t, 4, tekst(0 - 3.25), "-3.25")
    lik(t, 5, tekst(10000000000.0 * 10000000000.0), "1e20")
    lik(t, 6, tekst(0.1 + 0.2), "0.30000000000000004")
    lik(t, 7, tekst(1234.5678), "1234.5678")
    // Strengkonkatenering (to_text-atomet: krok for type 6)
    lik(t, 8, "x=" + x, "x=3.5")
    lik(t, 9, x + "b", "3.5b")
    lik(t, 10, "n=" + (0 - 0.25), "n=-0.25")
    // json_stringify / json_skriv (json_stringify-atomet: krok for type 6)
    lik(t, 11, builtin.json_stringify(x), "3.5")
    lik(t, 12, builtin.json_stringify([3.5, 2.0, 0.1, 0 - 2.25, 7]), "[3.5,2.0,0.1,-2.25,7]")
    lik(t, 13, json_skriv({"a": 1.5}), "{\"a\":1.5}")
    lik(t, 14, json_skriv([[0.5], {"b": 2.0}]), "[[0.5],{\"b\":2.0}]")
    lik(t, 15, builtin.json_stringify(0 - 2.0), "-2.0")
    // JSON-rundtur skal halde typen (2.0 → desimaltall, 2 → heiltal)
    la att = builtin.json_parse_raw(builtin.json_stringify([2.0, 2, 3.5]))
    lik(t, 16, builtin.type(att[0]), "desimaltall")
    lik(t, 17, builtin.type(att[1]), "heltall")
    hvis builtin.desimal_til_bits(att[2]) != 4615063718147915776 { feil(t, 18, "rundtur av 3.5 bit-eksakt", tekst(att[2])) }
    // Heiltal og tekst skal vere urørte
    lik(t, 19, builtin.json_stringify([1, "a", sann]), "[1,\"a\",true]")
    lik(t, 20, tekst(42), "42")
    hvis t["første"] != 0 { returner 100 + t["første"] }
    returner 42
}
