// tools/fixtures/diff_spread.no — Omgang 5 oppgåve 2: spread differensial-fixtur.
// Testar M10 spread i native codegen (builtin.utvid + legg_til). Forventa exit = 42.
funksjon start() -> heiltall {
    la a = [10, 20]
    la b = [...a, 12]        // [10, 20, 12] via utvid + legg_til
    returner b[0] + b[1] + b[2]   // 42
}
