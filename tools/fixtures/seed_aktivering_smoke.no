# Seed-aktiverings-smoke. Parsar på ALLE seedar, men treng M3-runtime for å
# KØYRE: på den gamle seeden feilar han med «ukjent opcode BUILD_LAMBDA»; på ein
# fersk seed/bundle bygd frå gjeldande kjelde skriv han «SEED-AKTIVERING OK» og
# returnerer 0. Ein presis ja/nei-indikator på om paritetsarbeidet (M1–M4) er
# aktivert. NB: M3 er lambda-VERDIAR (la f = fun(...) -> ...), ikkje berr
# funksjonsnamn som verdi (det er ikkje implementert).

funksjon start() -> heiltall {
    # M3 — lambda lagra i ein variabel og kalla (BUILD_LAMBDA + CALL_VALUE)
    la dobbel = fun(n: heiltall) -> n * 2
    assert(dobbel(21) == 42)

    # M3 — lambda med closure-capture av ein lokal variabel
    la k = 10
    la g = fun(y: heiltall) -> y + k
    assert(g(5) == 15)

    # M4 — ingenting som eigen type (gammal seed gjev "heltall" her)
    assert(builtin.type(ingenting) == "ingenting")

    skriv("SEED-AKTIVERING OK (M3 lambda + closure + M4 ingenting)\n")
    returner 0
}
