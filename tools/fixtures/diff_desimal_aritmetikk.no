// tools/fixtures/diff_desimal_aritmetikk.no — aotfloat: brøk-konstantar og
// aritmetikk med desimaltal i AOT mot tolken. Forventa exit = 42 (tolk og AOT);
// elles 100 + nummeret på den første sjekken som feila (meldinga står på stdout).
//
// Konstantane blir sjekka BIT-EKSAKT (builtin.desimal_til_bits mot IEEE-754-bita,
// rekna ut utanfor Norscode), ikkje via tekst/stringify: codegen-ELF-en koda før
// 3.5 som 4.0 og 0.1 som 0.125 (desimal_ieee_bits med den uvakta >=-samanlikninga),
// og `z == 8.75` var då «sann» fordi begge sider var like feil.
// Sjekk 20–22 fangar typetap i bunten: json_skriv skreiv 7.0 som «7», so
// PUSH_CONST 7.0 vart heiltalet 7 etter bygg-native sin bundle-rundtur (7.0 / 2 → 3).

funksjon feil(t, nr: heiltall, namn: tekst) -> heiltall {
    skriv("  [FEIL] sjekk " + tekst_fra_heltall(nr) + ": " + namn + "\n")
    hvis t["første"] == 0 { t["første"] = nr }
    returner 0
}

funksjon bits(v) -> heiltall { returner builtin.desimal_til_bits(v) }

funksjon start() -> heiltall {
    la t = {"første": 0}
    // Brøk-konstantar (desimal_ieee_bits i codegen-ELF-en).
    hvis bits(3.5) != 4615063718147915776 { feil(t, 1, "3.5") }
    hvis bits(0.1) != 4591870180066957722 { feil(t, 2, "0.1") }
    hvis bits(2.5) != 4612811918334230528 { feil(t, 3, "2.5") }
    hvis bits(8.75) != 4621115430147194880 { feil(t, 4, "8.75") }
    hvis bits(1.75) != 4610560118520545280 { feil(t, 5, "1.75") }
    hvis bits(0.5) != 4602678819172646912 { feil(t, 6, "0.5") }
    hvis bits(7.0) != 4619567317775286272 { feil(t, 7, "7.0") }
    hvis bits(123.456) != 4638387860618067575 { feil(t, 8, "123.456") }
    hvis bits(1234.5678) != 4653144502051863213 { feil(t, 9, "1234.5678") }
    hvis bits(0.0025) != 4567911030049346683 { feil(t, 10, "0.0025") }
    hvis bits(0.0 - 3.25) != 0 - 4608871268660281344 { feil(t, 11, "-3.25") }
    hvis bits(0 - 0.5) != 0 - 4620693217682128896 { feil(t, 12, "-0.5") }
    // Aritmetikk (xmm-atoma, blanda heiltal/desimal).
    la x = 3.5
    la y = x * 2.0
    hvis ikkje (y == 7.0) { feil(t, 13, "3.5 * 2.0 == 7.0") }
    hvis bits(y) != 4619567317775286272 { feil(t, 14, "3.5 * 2.0 bit-eksakt") }
    hvis bits(0.1 + 0.2) != 4599075939470750516 { feil(t, 15, "0.1 + 0.2 = 0.30000000000000004") }
    hvis bits(x * 2.5) != 4621115430147194880 { feil(t, 16, "3.5 * 2.5 = 8.75") }
    hvis bits(x + 1) != 4616752568008179712 { feil(t, 17, "3.5 + 1 = 4.5") }
    hvis bits(1.75 - 1) != 4604930618986332160 { feil(t, 18, "1.75 - 1 = 0.75") }
    hvis bits(1.75 / 2) != 4606056518893174784 { feil(t, 19, "1.75 / 2 = 0.875") }
    // Heiltalsverdige desimaltal skal overleve bundlen som desimaltal.
    la z = 7.0
    hvis builtin.type(z) != "desimaltall" { feil(t, 20, "7.0 skal ha type desimaltall") }
    hvis bits(z / 2) != 4615063718147915776 { feil(t, 21, "7.0 / 2 = 3.5") }
    la to = 2.0
    hvis bits(7 / to) != 4615063718147915776 { feil(t, 22, "7 / 2.0 = 3.5") }
    // Negative og store verdiar.
    la neg = 0 - x
    hvis bits(neg) != 0 - 4608308318706860032 { feil(t, 23, "-3.5 (UNARY/SUB)") }
    hvis bits(0 - neg) != 4615063718147915776 { feil(t, 24, "-(-3.5)") }
    la stor = 10000000000.0 * 10000000000.0
    hvis bits(stor) != 4906019910204099648 { feil(t, 25, "1e10 * 1e10 = 1e20") }
    hvis bits(stor / 3) != 4899047216157691989 { feil(t, 26, "1e20 / 3") }
    // Heiltalsaritmetikk skal framleis vere heiltal.
    hvis 7 / 2 != 3 { feil(t, 27, "7 / 2 == 3 (heiltal)") }
    hvis builtin.type(7 * 3) != "heltall" { feil(t, 28, "7 * 3 skal vere heiltal") }
    // a12fix: deling med ±0 i flyttal KASTAR (VM: DivisjonMedNull) — før gav AOT ±inf, og
    // tekst/json av inf krasja prosessen. Fanga av prøv/fang på begge sider.
    la null_d = 0.0
    la kasta = usann
    prøv { la q = 1.0 / null_d skriv("  q=" + tekst(q) + "\n") } fang (e) { kasta = builtin.contains(tekst(e), "DivisjonMedNull") }
    hvis ikkje kasta { feil(t, 29, "1.0 / 0.0 skal kaste DivisjonMedNull") }
    kasta = usann
    prøv { la q2 = 7 / null_d skriv("  q2=" + tekst(q2) + "\n") } fang (e) { kasta = builtin.contains(tekst(e), "DivisjonMedNull") }
    hvis ikkje kasta { feil(t, 30, "7 / 0.0 (blanda) skal kaste DivisjonMedNull") }
    // Modulo på desimaltal: fmod-semantikk (forteiknet til dividenden); ±0 kastar.
    hvis bits(5.5 % 2) != 4609434218613702656 { feil(t, 31, "5.5 % 2 = 1.5") }
    hvis bits((0 - 5.5) % 2) != 0 - 4613937818241073152 { feil(t, 32, "-5.5 % 2 = -1.5") }
    hvis bits(7 % 2.5) != 4611686018427387904 { feil(t, 33, "7 % 2.5 = 2.0") }
    kasta = usann
    prøv { la q3 = 1.5 % null_d skriv("  q3=" + tekst(q3) + "\n") } fang (e) { kasta = builtin.contains(tekst(e), "ModuloMedNull") }
    hvis ikkje kasta { feil(t, 34, "1.5 % 0.0 skal kaste ModuloMedNull") }
    // Konstantar som treng eksakt parsing (json_parse-atomet: krok til desimal_frå_tekst).
    hvis bits(2.2250738585072014e-308) != 4503599627370496 { feil(t, 35, "2.2250738585072014e-308 (minste normale)") }
    hvis bits(1.7976931348623157e308) != 9218868437227405311 { feil(t, 36, "1.7976931348623157e308 (største)") }
    hvis bits(5e-324) != 1 { feil(t, 37, "5e-324 (minste subnormale)") }
    hvis bits(123456789012345678.0) != 4862596447618666293 { feil(t, 38, "123456789012345678.0") }
    hvis bits(1e23) != 4950912855330343670 { feil(t, 39, "1e23") }
    hvis bits(9007199254740993.0) != 4845873199050653696 { feil(t, 40, "9007199254740993.0 (uavgjort → partal)") }
    hvis t["første"] != 0 { returner 100 + t["første"] }
    returner 42
}
