// tools/fixtures/diff_default.no — Omgang 5: standardargument differensial-fixtur.
// Testar M10 standardargument i native codegen: manglande argument → default.
// Forventa exit = 42.
funksjon med_default(a: heiltall, b: heiltall = 10) -> heiltall {
    returner a + b
}
funksjon start() -> heiltall {
    returner med_default(32)      // 32 + 10 = 42
}
