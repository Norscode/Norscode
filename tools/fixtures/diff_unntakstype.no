// tools/fixtures/diff_unntakstype.no — Omgang 6 (M6): typa-unnatak differensial.
// Testar fang (e: Type): rett type fangast, feil type propagerer til ytre handler.
// Forventa exit = 42.
//
// MERK: __throw_dispatch__-rutina si maskinkode-ENKODING er ikkje køyrt lokalt
// (strukturell codegen stadfestar berre kompilering) — Docker/CI ARM64-Linux er fasit.
funksjon start() -> heiltall {
    la sum: heiltall = 0
    // rett type fangast
    prøv { kast "FilFeil: mangler" } fang (e: FilFeil) { sum = sum + 10 }
    // feil type: indre FilFeil-handler fangar IKKJE NettFeil → ytre fangar
    prøv {
        prøv { kast "NettFeil: brote" } fang (e: FilFeil) { sum = sum + 999 }
    } fang (e) { sum = sum + 30 }
    // fang-alt
    prøv { kast "Kva: x" } fang (e) { sum = sum + 2 }
    returner sum      // 10 + 30 + 2 = 42
}
