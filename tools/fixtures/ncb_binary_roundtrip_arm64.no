// Sjølv-verifiserande testprogram for binær-NCB → native ARM64-lykkja.
// Byggjast via BEGGE format (binær + JSON) i CI; skal gje exit 42 nativt.
// Øvar tal (zigzag-varint), negative, nøsta liste, funksjonskall og streng —
// alt native-solid. (Codec-en sitt null-handtak er dekt av VM-testen
// test_ncb_serde_dualformat; det er runtime-semantikk, ikkje codec, og skal
// IKKJE avgjere denne native lykkja.)

funksjon sum_liste(xs: liste_heiltall) -> heiltall {
    la s = 0
    for x i xs { s = s + x }
    returner s
}

funksjon start() -> heiltall {
    la xs = [10, -3, 20, 0, 15]      // sum = 42 (negativ + null-element)
    la s = sum_liste(xs)

    // streng-røyndom (tvingar streng-konstantar gjennom NCB-round-trippen)
    la t = "æøå-NCB"
    hvis lengde(t) <= 0 { returner 1 }

    // nøsta struktur
    la nested = [[1, 2], [3]]
    hvis lengde(nested) != 2 { returner 2 }

    returner s
}
