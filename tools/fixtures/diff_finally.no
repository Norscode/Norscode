// tools/fixtures/diff_finally.no — Omgang 7: defer/finally differensial-fixtur.
// Testar prøv/endeleg i native codegen: finally køyrer på normal, return OG throw.
// Forventa exit = 42.
//
// MERK: __throw_dispatch__ + RETURN/THROW-gjennom-finally er handkoda maskinkode
// (strukturell codegen stadfestar kompilering) — Docker/CI ARM64-Linux er fasit.
funksjon med_finally(gjer_kast: bool) -> heiltall {
    la spor = 0
    prøv {
        hvis gjer_kast { kast "F: x" }
        returner 10
    } fang (e) {
        spor = 5
    } endeleg {
        spor = spor + 1     // køyrer alltid
    }
    returner spor
}

funksjon start() -> heiltall {
    la sum = 0
    // normal + return-gjennom-finally: returnerer 10, finally sette spor (ikkje synleg)
    sum = sum + med_finally(usann)      // 10
    // throw-gjennom-finally: fang set spor=5, finally spor=6, returner 6
    la a = 0
    prøv {
        prøv { kast "G: y" } endeleg { a = a + 30 }   // finally køyrer under throw
    } fang (e) { a = a + 2 }
    // a = 30 (finally) + 2 (fang) = 32
    returner sum + a       // 10 + 32 = 42
}
