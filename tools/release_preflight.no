// tools/release_preflight.no — lokal sjekk før release/GitHub
//
// Dette verktøyet publiserer ingenting. Det samlar dei viktigaste lokale
// release-bevisa slik at ein kan sjå kva som manglar før tag eller opplasting.

bruk tools.process_runner som prosess
bruk std.prosess som system_prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon krev_fil(sti: tekst, label: tekst) -> heiltall {
    hvis fil_finnes(sti) {
        linje("[OK] " + label + ": " + sti)
        returner 0
    }
    linje("[FEIL] " + label + " manglar: " + sti)
    returner 1
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon strict_git() -> bool {
    returner env("NORSCODE_RELEASE_PREFLIGHT_STRICT_GIT") == "1"
}

funksjon skip_git_tracking() -> bool {
    returner env("NORSCODE_RELEASE_PREFLIGHT_SKIP_GIT_TRACKING") == "1"
}

funksjon rot() -> tekst {
    la r = env("NORSCODE_ROOT")
    hvis r == "" { returner "." }
    returner r
}

funksjon sti(root: tekst, rel: tekst) -> tekst {
    hvis root == "." { returner rel }
    returner root + "/" + rel
}

funksjon krev_rel_fil(root: tekst, rel: tekst, label: tekst) -> heiltall {
    returner krev_fil(sti(root, rel), label)
}

funksjon merk_rel_ikkje_spora(root: tekst, rel: tekst, label: tekst) -> heiltall {
    hvis ikkje fil_finnes(sti(root, rel)) {
        returner 0
    }
    hvis skip_git_tracking() {
        returner 0
    }

    la git = system_prosess.finn_kjorbar("git")
    hvis git == "" {
        hvis strict_git() { returner 1 }
        linje("[MERK] kan ikkje kontrollere git-sporing utan git executable: " + rel)
        returner 0
    }
    la res = prosess.køyr(git, ["-C", root, "ls-files", "--error-unmatch", rel], root, {}, 30000)
    hvis prosess.ok(res) {
        linje("[OK] " + label + " er spora i git")
        returner 0
    }

    hvis strict_git() {
        linje("[FEIL] " + label + " finst lokalt, men er ikkje spora i git: " + rel)
        returner 1
    }

    linje("[MERK] " + label + " finst lokalt, men er ikkje spora i git: " + rel)
    returner 0
}

funksjon krev_rel_manglar_fil(root: tekst, rel: tekst, label: tekst) -> heiltall {
    la full = sti(root, rel)
    hvis fil_finnes(full) {
        linje("[FEIL] " + label + " finst framleis: " + rel)
        returner 1
    }
    linje("[OK] " + label)
    returner 0
}

funksjon krev_rel_innhald(root: tekst, rel: tekst, needle: tekst, label: tekst) -> heiltall {
    // bin/nc er no ein native binær/symlink. Historiske tekstkontraktar under
    // denne fila blir ignorerte her og er erstatta av native_cli_gate().
    hvis rel == "bin/nc" { returner 0 }
    la full = sti(root, rel)
    hvis ikkje fil_finnes(full) {
        linje("[FEIL] " + label + " manglar fil: " + rel)
        returner 1
    }
    la innhald = fil_les(full)
    hvis builtin.index_of(innhald, needle) >= 0 {
        linje("[OK] " + label)
        returner 0
    }
    linje("[FEIL] " + label + " manglar: " + needle)
    returner 1
}

funksjon krev_rel_utan_innhald(root: tekst, rel: tekst, needle: tekst, label: tekst) -> heiltall {
    hvis rel == "bin/nc" { returner 0 }
    la full = sti(root, rel)
    hvis ikkje fil_finnes(full) {
        linje("[FEIL] " + label + " manglar fil: " + rel)
        returner 1
    }
    la innhald = fil_les(full)
    hvis builtin.index_of(innhald, needle) >= 0 {
        linje("[FEIL] " + label + " har uønskt innhald: " + needle)
        returner 1
    }
    linje("[OK] " + label)
    returner 0
}

funksjon krev_rel_trygg_s_shell(root: tekst, rel: tekst, label: tekst) -> heiltall {
    la feil = 0
    feil = feil + krev_rel_innhald(root, rel, "builtin.replace(s, \"'\"", label + " shell-quotar apostrof")
    feil = feil + krev_rel_utan_innhald(root, rel, "returner \"'\" + s + \"'\"", label + " har ikkje rå s-shellquote")
    returner feil
}

funksjon krev_rel_standard_shellquote(root: tekst, rel: tekst, label: tekst) -> heiltall {
    returner krev_rel_utan_innhald(root, rel, "\"'\\\\''\"", label + " brukar standard shell-quote")
}

funksjon native_cli_gate(root: tekst) -> heiltall {
    la bin_sti = sti(root, "bin/nc")
    la dist_sti = sti(root, "dist/norscode_native")
    la eigar_sti = sti(root, "selfhost/nc_main.no")
    hvis ikkje fil_finnes(bin_sti) eller ikkje fil_finnes(dist_sti) eller ikkje fil_finnes(eigar_sti) {
        linje("[FEIL] native CLI manglar bin, dist eller Norscode-eigar")
        returner 1
    }
    prøv {
        la binær = builtin.fil_les_binær(bin_sti)
        la dist = builtin.fil_les_binær(dist_sti)
        hvis lengde(binær) < 4 eller lengde(binær) != lengde(dist) {
            linje("[FEIL] bin/nc er ikkje den promoterte native runtimen")
            returner 1
        }
        la magic_ok = (binær[0] == 207 og binær[1] == 250 og binær[2] == 237 og binær[3] == 254) eller
            (binær[0] == 127 og binær[1] == 69 og binær[2] == 76 og binær[3] == 70) eller
            (binær[0] == 77 og binær[1] == 90)
        hvis ikkje magic_ok {
            linje("[FEIL] bin/nc har ikkje Mach-O, ELF eller PE-signatur")
            returner 1
        }
        hvis builtin.sha256_bytes(binær) != builtin.sha256_bytes(dist) {
            linje("[FEIL] bin/nc og dist/norscode_native har ulik hash")
            returner 1
        }
    } fang (e) {
        linje("[FEIL] native CLI kunne ikkje lesast: " + tekst(e))
        returner 1
    }
    la eigar = fil_les(eigar_sti)
    hvis builtin.index_of(eigar, "la argv = native_argv()") < 0 eller
       builtin.index_of(eigar, "funksjon nc_direkte_verktøysti") < 0 eller
       builtin.index_of(eigar, "tools/local_green.no") < 0 eller
       builtin.index_of(eigar, "tools/verify_selvstendighet.no") < 0 {
        linje("[FEIL] selfhost/nc_main.no manglar native argv-/gate-dispatch")
        returner 1
    }
    hvis builtin.index_of(eigar, "exec sh") >= 0 eller builtin.index_of(eigar, "sh -c") >= 0 {
        linje("[FEIL] native CLI-eigar inneheld shell-dispatch")
        returner 1
    }
    linje("[OK] bin/nc er hash-identisk native dispatch eigd av selfhost/nc_main.no")
    returner 0
}

funksjon windows_stage0_kandidat_gate(root: tekst) -> heiltall {
    la stage0 = sti(root, "bootstrap/stage0/norscode-windows-x86_64.exe")
    la kandidat = sti(root, "build/windows/norscode_native_windows_x86_64.exe")
    hvis ikkje fil_finnes(stage0) eller ikkje fil_finnes(kandidat) {
        linje("[FEIL] Windows stage0/kandidat manglar for hash-konsistens")
        returner 1
    }
    prøv {
        la stage_bytes = builtin.fil_les_binær(stage0)
        la kandidat_bytes = builtin.fil_les_binær(kandidat)
        hvis lengde(stage_bytes) != lengde(kandidat_bytes) {
            linje("[FEIL] Windows stage0 og cross-kandidat har ulik storleik")
            returner 1
        }
        hvis builtin.sha256_bytes(stage_bytes) != builtin.sha256_bytes(kandidat_bytes) {
            linje("[FEIL] Windows stage0 og cross-kandidat er ikkje byte-identiske")
            returner 1
        }
    } fang (e) {
        linje("[FEIL] Windows stage0/kandidat kunne ikkje samanliknast: " + tekst(e))
        returner 1
    }
    linje("[OK] Windows stage0 er byte-identisk med cross-kandidaten")
    returner 0
}

funksjon start() -> heiltall {
    linje("=== Norscode release-preflight (lokal, ingen publisering) ===")

    la root = rot()
    la feil = 0

    feil = feil + krev_rel_fil(root, "bin/nc", "CLI")
    feil = feil + krev_rel_fil(root, "dist/norscode_native", "native køyretid")
    feil = feil + native_cli_gate(root)
    feil = feil + krev_rel_fil(root, "bootstrap/stage0/norscode-macos-arm64", "macOS stage0-frø")
    feil = feil + krev_rel_fil(root, "bootstrap/stage0/norscode-linux-x86_64", "Linux stage0-frø")
    feil = feil + krev_rel_fil(root, "bootstrap/stage0/norscode-windows-x86_64.exe", "Windows stage0-frø")
    feil = feil + windows_stage0_kandidat_gate(root)
    feil = feil + krev_rel_fil(root, "tools/package_release.no", "Norscode release-pakker")
    feil = feil + krev_rel_fil(root, "tools/install_release.no", "Norscode release-installasjon")
    feil = feil + krev_rel_fil(root, "tools/local_green.no", "samla lokal grønnliste")
    feil = feil + krev_rel_fil(root, "archive/legacy_shell/tools/local_green.sh", "lokal grønnliste-wrapper")
    feil = feil + krev_rel_manglar_fil(root, "tools/local_green.sh", "aktiv lokal grønnliste-wrapper er fjerna")
    feil = feil + krev_rel_fil(root, "selfhost/bootstrap_gate.no", "bootstrap-gate kjelde")
    feil = feil + krev_rel_fil(root, "selfhost/bootstrap_gate.ncb.json", "bootstrap-gate bytekode")
    feil = feil + krev_rel_fil(root, "tests/test_release_preflight.no", "release-preflight-test")
    feil = feil + krev_rel_fil(root, "tests/test_endringslogg_release_text.no", "endringslogg-teksttest")
    feil = feil + krev_rel_fil(root, "tests/test_local_green.no", "lokal grønnliste-test")
    feil = feil + krev_rel_fil(root, "tests/test_bootstrap_self_pure_text.no", "bootstrap-steg-C-test")
    feil = feil + krev_rel_fil(root, "tests/test_cli_maturity.no", "CLI-modenhetstest")
    feil = feil + merk_rel_ikkje_spora(root, "tools/release_preflight.no", "release-preflight-verktøy")
