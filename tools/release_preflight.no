    feil = feil + merk_rel_ikkje_spora(root, "archive/legacy_shell/tools/no_legacy_cvm.sh", "arkivert historisk C-VM-wrapper")
    feil = feil + merk_rel_ikkje_spora(root, "selfhost/bootstrap_gate.no", "bootstrap-gate kjelde")
