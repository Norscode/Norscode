// tools/verify_omgang6b.no — shellfri Omgang 6b.1 + 6b.2 + 6b.3-verifisering

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) { returner "0" }
    returner "0"
}

funksjon inneheld(data: tekst, needle: tekst) -> boolsk { returner builtin.index_of(data, needle) >= 0 }

funksjon fil_inneheld(sti: tekst, needle: tekst) -> boolsk {
    prøv { returner inneheld(builtin.fil_les(sti), needle) }
    fang (e) { returner usann }
    returner usann
}

funksjon les_fil_trygt(sti: tekst) -> tekst {
    prøv { returner builtin.fil_les(sti) } fang (e) { returner "" }
    returner ""
}

funksjon filer_identiske(a: tekst, b: tekst) -> boolsk {
    hvis ikkje fil_finst(a) eller ikkje fil_finst(b) { returner usann }
    returner builtin.fil_les_binær(a) == builtin.fil_les_binær(b)
}

funksjon nc_miljø(root: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_ROOT": root
    }
}

funksjon køyr(root: tekst, executable: tekst, argv: liste_tekst,
               miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    returner prosess.køyr(executable, argv, root, miljø, timeout_ms)
}

funksjon køyr_ok(root: tekst, executable: tekst, argv: liste_tekst,
                  miljø: ordbok_tekst, timeout_ms: heiltall) -> boolsk {
    la resultat = køyr(root, executable, argv, miljø, timeout_ms)
    prosess.skriv_resultat(resultat)
    hvis prosess.ok(resultat) { returner sann }
    linje("[FEIL] prosess status=" + tekst(resultat["status"]) +
          " exit=" + tekst(resultat["exit_code"]) +
          " error=" + tekst(resultat["error"]))
    returner usann
}

funksjon run_nc_med_miljø(root: tekst, argv: liste_tekst, miljø: ordbok_tekst,
                           timeout_ms: heiltall) -> boolsk {
    // Compiler-bundlebygg passerer førebels 4 GiB-profilen. Null let OS-et
    // handheve minne medan timeout, fd-tak og outputgrense framleis er eksplisitte.
    la resultat = prosess.køyr_med_grenser(root + "/bin/nc", argv, root,
        miljø, timeout_ms, 0, 1024)
    prosess.skriv_resultat(resultat)
    hvis prosess.ok(resultat) { returner sann }
    linje("[FEIL] nc status=" + tekst(resultat["status"]) +
          " exit=" + tekst(resultat["exit_code"]) +
          " error=" + tekst(resultat["error"]))
    returner usann
}

funksjon run_nc(root: tekst, argv: liste_tekst, timeout_ms: heiltall) -> boolsk {
    returner run_nc_med_miljø(root, argv, nc_miljø(root), timeout_ms)
}

funksjon run_ncb_to_elf(root: tekst, input: tekst, output: tekst) -> boolsk {
    la miljø = nc_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/ncb_to_elf.no"
    miljø["NORSCODE_NCB_TO_ELF_INPUT"] = input
    miljø["NORSCODE_NCB_TO_ELF_OUTPUT"] = output
    miljø["NORSCODE_USE_PRECOMPILED_SELFHOST"] = "0"
    returner køyr_ok(root, root + "/bin/nc", ["run", root + "/tools/ncb_to_elf.no"], miljø, 600000)
}

funksjon json_strengverdi_etter(src: tekst, key: tekst, start_pos: heiltall) -> tekst {
    la keypat = "\"" + key + "\""
    la rest = builtin.slice(src, start_pos, lengde(src))
    la key_rel = builtin.index_of(rest, keypat)
    hvis key_rel < 0 { returner "" }
    la etter_key = start_pos + key_rel + lengde(keypat)
    rest = builtin.slice(src, etter_key, lengde(src))
    la kolon_rel = builtin.index_of(rest, ":")
    hvis kolon_rel < 0 { returner "" }
    la etter_kolon = etter_key + kolon_rel + 1
    rest = builtin.slice(src, etter_kolon, lengde(src))
    la start_sitat_rel = builtin.index_of(rest, "\"")
    hvis start_sitat_rel < 0 { returner "" }
    la verdi_start = etter_kolon + start_sitat_rel + 1
    rest = builtin.slice(src, verdi_start, lengde(src))
    la slutt_sitat_rel = builtin.index_of(rest, "\"")
    hvis slutt_sitat_rel < 0 { returner "" }
    returner builtin.slice(src, verdi_start, verdi_start + slutt_sitat_rel)
}

funksjon tel_forekomstar(data: tekst, needle: tekst) -> heiltall {
    la pos = 0
    la count = 0
    mens pos < lengde(data) {
        la rel = builtin.index_of(builtin.slice(data, pos, lengde(data)), needle)
        hvis rel < 0 { returner count }
        count = count + 1
        pos = pos + rel + lengde(needle)
    }
    returner count
}

funksjon chunk_size() -> tekst {
    la v = env("NC_OM6B_CHUNK_SIZE")
    hvis v == "" { returner "65536" }
    returner v
}

funksjon heiltal_frå_tekst_trygt(t: tekst, fallback: heiltall) -> heiltall {
    prøv { returner builtin.heltall_fra_tekst(t) } fang (e) { returner fallback }
    returner fallback
}

funksjon pad3(n: heiltall) -> tekst {
    la s = tekst(n)
    mens lengde(s) < 3 { s = "0" + s }
    returner s
}

funksjon lag_ncb_chunks(src: tekst, out_dir: tekst, chunk: tekst) -> tekst {
    hvis filops.katalog_finnes(out_dir) og ikkje filops.slett_tre(out_dir) { returner "" }
    hvis ikkje filops.lag_katalogar(out_dir) { returner "" }
    la data = les_fil_trygt(src)
    hvis data == "" { linje("[FEIL] Kan ikkje lese NCB for chunking: " + src) returner "" }
    la storleik = heiltal_frå_tekst_trygt(chunk, 65536)
    hvis storleik <= 0 { storleik = 65536 }
    la pos = 0
    la nr = 0
    mens pos < lengde(data) {
        la slutt = pos + storleik
        hvis slutt > lengde(data) { slutt = lengde(data) }
        prøv { builtin.fil_skriv(out_dir + "/part_" + pad3(nr) + ".json", builtin.slice(data, pos, slutt)) }
        fang (e) { linje("[FEIL] Kan ikkje skrive chunk " + tekst(nr)) returner "" }
        nr = nr + 1
        pos = slutt
    }
    hvis nr == 0 { returner "" }
    returner tekst(nr)
}

funksjon ncb_entry(sti: tekst) -> tekst { returner json_strengverdi_etter(les_fil_trygt(sti), "entry", 0) }
funksjon ncb_function_count(sti: tekst) -> tekst { returner tekst(tel_forekomstar(les_fil_trygt(sti), "\":{\"name\"")) }

funksjon runtime_miljø(root: tekst, output: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/selfhost/elf_compile_driver.no",
        "NORSCODE_BUNDLE_OUTPUT": output,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_ROOT": root
    }
}

funksjon run_log(root: tekst, executable: tekst, argv: liste_tekst,
                  miljø: ordbok_tekst, logg: tekst, timeout_ms: heiltall) -> boolsk {
    la resultat = køyr(root, executable, argv, miljø, timeout_ms)
    la body = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    builtin.fil_skriv(logg, body)
    hvis prosess.ok(resultat) { returner sann }
    hvis body != "" { skriv(body) }
    returner usann
}

funksjon sett_executable(sti: tekst) -> boolsk {
    returner tekst(native_fs.native_sett_modus_sti(sti, 493)["status"]) == "ok"
}

funksjon main() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la info = builtin.system_info()
    la os = tekst(info["system"])
    la arch = tekst(info["machine"])
    la chunk = chunk_size()
    la build = root + "/build/6b"
    la chunk_dir = build + "/chunk_copy"
    la chunk_log = build + "/compiler_chunk_copy.log"
    la source_log = build + "/compiler_source_copy.log"
    la preset_log = build + "/compiler_preset_copy.log"

    linje("=== Omgang 6b: ELF stage-0 (6b.1 + 6b.2 + 6b.3) ===")
    linje("")
    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        hvis ikkje run_nc(root, ["fetch-stage0-seed"], 300000) { returner 1 }
    }
    hvis ikkje filops.lag_katalogar(build) { returner 1 }

    linje("1a. Host-ELF frå omgang6b_host.no...")
    hvis ikkje run_nc(root, ["bygg-native", "--target", "linux-x86_64", "tests/fixtures/omgang6b_host.no", "build/6b/host_v1.elf"], 600000) { returner 1 }
    hvis ikkje run_nc(root, ["bygg-native", "--target", "linux-x86_64", "tests/fixtures/omgang6b_host.no", "build/6b/host_v2.elf"], 600000) { returner 1 }
    hvis ikkje sett_executable(build + "/host_v1.elf") eller ikkje sett_executable(build + "/host_v2.elf") { returner 1 }
    hvis ikkje filer_identiske(build + "/host_v1.elf", build + "/host_v2.elf") {
        linje("  [FEIL] host ELF ikkje deterministisk")
        returner 1
    }
    linje("  [OK] host ELF deterministisk (" + bytes(build + "/host_v1.elf") + " bytes)")
    linje("")

    linje("1b. Stage-0 NCB (driver entry) → ELF...")
    la build_ncb_env = nc_miljø(root)
    build_ncb_env["NORSCODE_OMGANG6B_NCB_OUT"] = build + "/compiler_stage0.ncb.json"
    hvis ikkje run_nc_med_miljø(root, ["build-omgang6b-ncb"], build_ncb_env, 900000) { returner 1 }
    la entry = ncb_entry(build + "/compiler_stage0.ncb.json")
    hvis entry != "selfhost.elf_compile_driver.start" {
        linje("  [FEIL] entry er " + entry + ", forventa selfhost.elf_compile_driver.start")
        returner 1
    }
    hvis ikkje run_ncb_to_elf(root, build + "/compiler_stage0.ncb.json", build + "/compiler_v1.elf") { returner 1 }
    hvis ikkje run_ncb_to_elf(root, build + "/compiler_stage0.ncb.json", build + "/compiler_v2.elf") { returner 1 }
    hvis ikkje sett_executable(build + "/compiler_v1.elf") eller ikkje sett_executable(build + "/compiler_v2.elf") { returner 1 }
    hvis ikkje filer_identiske(build + "/compiler_v1.elf", build + "/compiler_v2.elf") {
        linje("  [FEIL] kompilator-ELF ikkje deterministisk")
        returner 1
    }
    linje("  [OK] stage-0 ELF deterministisk (" + bytes(build + "/compiler_v1.elf") + " bytes)")
    linje("")

    linje("1c. Transitional chunk-kopi via elf_compile_driver.no...")
    la chunk_i = lag_ncb_chunks(build + "/compiler_stage0.ncb.json", chunk_dir, chunk)
    hvis chunk_i == "" { returner 1 }
    filops.slett_fil(build + "/compiler_chunk_copy.ncb.json")
    filops.slett_fil(chunk_log)
    la chunk_env = runtime_miljø(root, build + "/compiler_chunk_copy.ncb.json")
    chunk_env["NORSCODE_OM6B_SOURCE_NCB_DIR"] = chunk_dir
    chunk_env["NORSCODE_OM6B_SOURCE_NCB_COUNT"] = chunk_i
    hvis ikkje run_log(root, root + "/dist/norscode_native", [], chunk_env, chunk_log, 600000) {
        linje("  [FEIL] chunk-kopi via elf_compile_driver.no feila")
        returner 1
    }
    hvis ikkje filer_identiske(build + "/compiler_stage0.ncb.json", build + "/compiler_chunk_copy.ncb.json") {
        linje("  [FEIL] chunk-kopi gav ulik NCB")
        returner 1
    }
    linje("  [OK] chunk-kopi rekonstruerer stage-0 NCB (" + chunk_i + " delar, " + chunk + " byte per del)")
    linje("")

    linje("1d. Direkte source-NCB via elf_compile_driver.no...")
    filops.slett_fil(build + "/compiler_source_copy.ncb.json")
    filops.slett_fil(source_log)
    la source_env = runtime_miljø(root, build + "/compiler_source_copy.ncb.json")
    source_env["NORSCODE_OM6B_SOURCE_NCB"] = build + "/compiler_stage0.ncb.json"
    hvis ikkje run_log(root, root + "/dist/norscode_native", [], source_env, source_log, 600000) {
        linje("  [FEIL] direkte source-NCB via elf_compile_driver.no feila")
        returner 1
    }
    hvis ikkje filer_identiske(build + "/compiler_stage0.ncb.json", build + "/compiler_source_copy.ncb.json") {
        linje("  [FEIL] direkte source-NCB gav ulik NCB")
        returner 1
    }
    linje("  [OK] direkte source-NCB rekonstruerer stage-0 NCB")
    linje("")

    hvis env("NC_OM6B_VERIFY_PRESET") == "1" {
        linje("1e. Ekte om6b preset-bundle via elf_compile_driver.no...")
        filops.slett_fil(build + "/compiler_preset_copy.ncb.json")
        filops.slett_fil(preset_log)
        la preset_env = runtime_miljø(root, build + "/compiler_preset_copy.ncb.json")
        preset_env["NORSCODE_OM6B_PRESET"] = "1"
        hvis ikkje run_log(root, root + "/dist/norscode_native", [], preset_env, preset_log, 900000) { returner 1 }
        hvis ikkje filer_identiske(build + "/compiler_stage0.ncb.json", build + "/compiler_preset_copy.ncb.json") { returner 1 }
        linje("  [OK] om6b preset-bundle rekonstruerer stage-0 NCB")
    } ellers { linje("1e. Hopp over ekte om6b preset-bundle (set NC_OM6B_VERIFY_PRESET=1 for eksplisitt preset-verifisering)") }
    linje("")

    hvis os == "Linux" og (arch == "x86_64" eller arch == "amd64") {
        linje("2. Køyr host-ELF på Linux...")
        la host = køyr(root, build + "/host_v1.elf", [], {}, 30000)
        prosess.skriv_resultat(host)
        hvis ikkje prosess.ok(host) eller ikkje inneheld(tekst(host["stdout"]), "6b-elf-host OK") { returner 1 }
        hvis env("NC_OM6B_RUN_STAGE0") == "1" {
            linje("3. Køyr stage-0 ELF (røyk-modus utan env)...")
            la cout = køyr(root, build + "/compiler_v1.elf", [], {}, 30000)
            prosess.skriv_resultat(cout)
            hvis ikkje prosess.ok(cout) eller ikkje inneheld(tekst(cout["stdout"]), "ELF compile driver") eller
               ikkje inneheld(tekst(cout["stdout"]), "inline compile") { returner 1 }
            linje("4. Kompiler eksternt .no via strukturert miljø...")
            filops.slett_fil(build + "/target.ncb.json")
            la compile_env = {
                "NORSCODE_FILE": root + "/tests/fixtures/omgang6b_target.no",
                "NORSCODE_OUTPUT": build + "/target.ncb.json",
                "NORSCODE_MODULE": "__main__"
            }
            la cout2 = køyr(root, build + "/compiler_v1.elf", [], compile_env, 120000)
            prosess.skriv_resultat(cout2)
            hvis ikkje prosess.ok(cout2) eller ikkje inneheld(tekst(cout2["stdout"]), "ELF compile:") { returner 1 }
            hvis ikkje fil_inneheld(build + "/target.ncb.json", "\"functions\":{") eller
               ikkje fil_inneheld(build + "/target.ncb.json", "start\":{") { returner 1 }
            linje("  [OK] target NCB: " + ncb_function_count(build + "/target.ncb.json") + " funksjonar")
        } ellers { linje("3–4. Hopp over stage-0 ELF runtime (set NC_OM6B_RUN_STAGE0=1 for djup smoke)") }
    } ellers { linje("2–4. Hopp over ELF-køyring (" + os + "/" + arch + " — krev Linux x86-64)") }
    linje("")

    linje("5. Stage-0/6b.3 sjølvkompilering (bundle-args først, så direkte source-ncb, så chunked source-ncb)...")
    hvis ikkje run_nc(root, ["selfcompile-stage0-elf"], 1200000) { returner 1 }
    linje("")
    linje("=== Omgang 6b.1 + 6b.2 + 6b.3: BESTÅTT ===")
    linje("NCB → ELF deterministisk; dyp stage-0 ELF runtime er opt-in med NC_OM6B_RUN_STAGE0=1.")
    linje("Merk: 6b.3 prøver no ekte NORSCODE_BUNDLE_ARGS først; ved Gen1 ELF-feil prøver han direkte source-NCB, og berre deretter chunked source-NCB.")
    linje("Merk: NC_OM6B_VERIFY_PRESET=1 verifiserer at preset-bundle rekonstruerer stage-0 NCB via elf_compile_driver.no.")
    returner 0
}

funksjon start() -> heiltall { returner main() }
