// tools/nc_test_oppdaging.no — testoppdaging for `nc test` (test-blokker og test_*-funksjonar).
//
// Kompilatoren legg `test "namn" { ... }`-blokker i ncb["tests"], men ingenting køyrde
// dei: `nc test` såg berre exit-koden til start(), so ein feilande test-blokk gav falsk
// grønt, og ei fil med berre test_*-funksjonar (utan start) køyrde ingenting.
//
// Denne modulen byggjer ein TESTKØYRAR direkte i bytekoden til den kompilerte test-NCB-en,
// utan ny kompilator og utan reseed (tools/nc_test.no køyrer frå kjelde):
//
//   * Kvar test-blokk i hovudmodulen blir ein vanleg funksjon
//     `<modul>.__nc_testblokk_<i>__` (koden er uendra; blokka har ingen parametrar).
//   * Ein ny inngang `<modul>.__nc_testkoyrar__` blir sett som ncb["entry"]. Han køyrer
//     start() som før når han finst, og deretter kvar test-blokk for seg i prøv/fang
//     (TRY_BEGIN "*"), so ein feil i éin test ikkje stoppar dei andre.
//   * test_*-funksjonar (toppnivå, utan parametrar, ikkje asynk) blir oppdaga og køyrde
//     BERRE når fila ikkje har start(). Med start() er dei hjelparar som start() kallar
//     sjølv (slik dei eksisterande testane er skrivne), og blir ikkje køyrde ein gong til.
//   * Utan test-blokker og utan (test_*-funksjonar utan start) blir NCB-en ikkje rørd:
//     vanlege testar køyrer byte-identisk som før.
//
// Semantikk per test: bestått når testen ikkje kastar og ikkje returnerer eit heiltal
// ulikt 0 eller usann. Assert-meldinga kjem frå unntaket (tekst(e), t.d.
// «assert_eq feilet: 4 != 5»).
//
// Utskrift frå køyraren (éi linje per hending, prefiksa so testløparen skil dei frå
// testen sin eigen utskrift):
//   [nc-test] OK: <namn>
//   [nc-test] FEIL: <namn> — <melding>
//   [nc-test] FEIL: start() — <melding>        (start() kasta eller returnerte ≠ 0)
//   [nc-test] <x>/<n> bestått                  (oppsummering; start() er ikkje med i n)
//
// Exit-kode (returverdien til køyraren): start() sin ikkje-null heiltalskode vinn; elles 1
// når minst éin test feila; elles start() sin returverdi (0/ingenting utan start).

bruk selfhost.ncb_serde som serde

funksjon markør() -> tekst {
    returner "[nc-test] "
}

funksjon koyrar_namn() -> tekst {
    returner "__nc_testkoyrar__"
}

// ── Kjelde-førefilter ───────────────────────────────────────────────────────────
// Billig tekstsjekk før NCB-en blir dekoda: berre filer som KAN ha test-blokker eller
// test_*-funksjonar utan start() treng køyraren. NCB-en avgjer endeleg (ein linje i ein
// fleirlinjestreng kan gje falsk treff her, aldri falsk bom).

funksjon _er_blokkstart(linje: tekst) -> bool {
    hvis ikkje builtin.starts_with(linje, "test") { returner usann }
    la rest = builtin.trim(builtin.slice(linje, 4, lengde(linje)))
    returner builtin.starts_with(rest, "\"")
}

funksjon _er_funksjon_med_prefiks(linje: tekst, prefiks: tekst) -> bool {
    la l = linje
    hvis builtin.starts_with(l, "offentleg ") { l = builtin.trim(builtin.slice(l, 10, lengde(l))) }
    hvis builtin.starts_with(l, "eksporter ") { l = builtin.trim(builtin.slice(l, 10, lengde(l))) }
    hvis ikkje builtin.starts_with(l, "funksjon ") { returner usann }
    la rest = builtin.trim(builtin.slice(l, 9, lengde(l)))
    returner builtin.starts_with(rest, prefiks)
}

funksjon kjelde_kan_ha_testar(kjelde: tekst) -> bool {
    la linjer = builtin.split(kjelde, "\n")
    la har_testfunksjon = usann
    la har_start = usann
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la linje = builtin.trim(tekst(linjer[i]))
        hvis _er_blokkstart(linje) { returner sann }
        hvis _er_funksjon_med_prefiks(linje, "test_") { har_testfunksjon = sann }
        hvis _er_funksjon_med_prefiks(linje, "start(") eller _er_funksjon_med_prefiks(linje, "start ") {
            har_start = sann
        }
        i = i + 1
    }
    returner har_testfunksjon og ikkje har_start
}

// ── Testplan frå NCB ────────────────────────────────────────────────────────────

funksjon hovudmodul(ncb) -> tekst {
    la entry = ""
    prøv { entry = tekst(ncb["entry"]) } fang (e) { entry = "" }
    la delar = builtin.split(entry, ".")
    hvis lengde(delar) < 2 { returner "__main__" }
    la ut = tekst(delar[0])
    la i: heiltall = 1
    mens i < lengde(delar) - 1 {
        ut = ut + "." + tekst(delar[i])
        i = i + 1
    }
    returner ut
}

funksjon _har(d, nøkkel: tekst) -> bool {
    prøv { returner finnes_nøkkel(d, nøkkel) } fang (e) { returner usann }
    returner usann
}

funksjon _fyrste_linje(def) -> heiltall {
    hvis _har(def, "source_lines") {
        la linjer = def["source_lines"]
        prøv {
            hvis lengde(linjer) > 0 { returner builtin.heltall_fra_tekst(tekst(linjer[0])) }
        } fang (e) { }
    }
    returner 1000000000
}

funksjon _er_asynk(def) -> bool {
    hvis ikkje _har(def, "is_async") { returner usann }
    returner tekst(def["is_async"]) == "sann" eller tekst(def["is_async"]) == "true"
}

funksjon _tal_parametrar(def) -> heiltall {
    hvis ikkje _har(def, "params") { returner 0 }
    la p = def["params"]
    prøv { returner lengde(p) } fang (e) { }
    returner 0
}

// test_*-funksjonar i hovudmodulen (toppnivå, 0 parametrar, ikkje asynk), sorterte
// etter kjeldelinje (so rapporten følgjer fila); utan source_lines kjem dei sist.
funksjon testfunksjonar(ncb, modul: tekst) -> liste_tekst {
    la funksjonar = ncb["functions"]
    la prefiks = modul + ".test_"
    la kandidatar = []
    for nøkkel i nøkler(funksjonar) {
        la k = tekst(nøkkel)
        hvis builtin.starts_with(k, prefiks) {
            la kort = builtin.slice(k, lengde(modul) + 1, lengde(k))
            la def = funksjonar[k]
            hvis builtin.index_of(kort, ".") < 0 og builtin.type(def) == "ordbok" og
               _tal_parametrar(def) == 0 og ikkje _er_asynk(def) {
                legg_til(kandidatar, {"k": k, "linje": _fyrste_linje(def)})
            }
        }
    }
    // Innstikksortering (få element).
    la i: heiltall = 1
    mens i < lengde(kandidatar) {
        la j: heiltall = i
        mens j > 0 og _før(kandidatar[j], kandidatar[j - 1]) {
            la tmp = kandidatar[j]
            kandidatar[j] = kandidatar[j - 1]
            kandidatar[j - 1] = tmp
            j = j - 1
        }
        i = i + 1
    }
    la ut: liste_tekst = []
    i = 0
    mens i < lengde(kandidatar) {
        legg_til(ut, tekst(kandidatar[i]["k"]))
        i = i + 1
    }
    returner ut
}

funksjon _før(a, b) -> bool {
    la linje_a: heiltall = a["linje"]
    la linje_b: heiltall = b["linje"]
    returner linje_a < linje_b
}

// Test-blokkene til hovudmodulen (ncb["tests"] kan òg innehalde blokker frå importerte
// modular etter bundling; dei høyrer til sin eigen modul og blir ikkje køyrde her).
funksjon testblokker(ncb, modul: tekst) -> liste {
    la ut = []
    hvis ikkje _har(ncb, "tests") { returner ut }
    la testar = ncb["tests"]
    hvis testar == null { returner ut }
    hvis builtin.type(testar) != "liste" { returner ut }
    la i: heiltall = 0
    mens i < lengde(testar) {
        la t = testar[i]
        hvis builtin.type(t) == "ordbok" og _har(t, "code") {
            la m = modul
            hvis _har(t, "module") { m = tekst(t["module"]) }
            hvis m == modul { legg_til(ut, t) }
        }
        i = i + 1
    }
    returner ut
}

// ── Bytekode for køyraren ───────────────────────────────────────────────────────

funksjon _op(kode, a: tekst) -> heiltall {
    legg_til(kode, [a])
    returner 0
}

funksjon _op1(kode, a: tekst, b) -> heiltall {
    legg_til(kode, [a, b])
    returner 0
}

funksjon _op2(kode, a: tekst, b, c) -> heiltall {
    legg_til(kode, [a, b, c])
    returner 0
}

funksjon _skriv_konst(kode, t: tekst) -> heiltall {
    _op1(kode, "PUSH_CONST", t)
    _op2(kode, "CALL", "builtin.skriv", 1)
    _op(kode, "POP")
    returner 0
}

// skriv(prefiks + tekst(<var>) + etter)
funksjon _skriv_med_verdi(kode, prefiks: tekst, var: tekst, etter: tekst) -> heiltall {
    _op1(kode, "PUSH_CONST", prefiks)
    _op1(kode, "LOAD_NAME", var)
    _op2(kode, "CALL", "builtin.tekst", 1)
    _op(kode, "BINARY_ADD")
    _op1(kode, "PUSH_CONST", etter)
    _op(kode, "BINARY_ADD")
    _op2(kode, "CALL", "builtin.skriv", 1)
    _op(kode, "POP")
    returner 0
}

funksjon _auk(kode, var: tekst) -> heiltall {
    _op1(kode, "LOAD_NAME", var)
    _op1(kode, "PUSH_CONST", 1)
    _op(kode, "BINARY_ADD")
    _op1(kode, "STORE_NAME", var)
    returner 0
}

// Hopp til `feil_label` når <var> er eit heiltal ≠ 0 eller usann; elles vidare.
funksjon _hopp_ved_feil_retur(kode, var: tekst, feil_label: tekst, base: tekst) -> heiltall {
    la ikkje_heiltal = base + "_ikkje_heiltal__"
    la vidare = base + "_retur_ok__"
    _op1(kode, "LOAD_NAME", var)
    _op2(kode, "CALL", "builtin.type", 1)
    _op1(kode, "PUSH_CONST", "heltall")
    _op(kode, "COMPARE_EQ")
    _op1(kode, "JUMP_IF_FALSE", ikkje_heiltal)
    _op1(kode, "LOAD_NAME", var)
    _op1(kode, "PUSH_CONST", 0)
    _op(kode, "COMPARE_EQ")
    _op1(kode, "JUMP_IF_FALSE", feil_label)
    _op1(kode, "JUMP", vidare)
    _op1(kode, "LABEL", ikkje_heiltal)
    _op1(kode, "LOAD_NAME", var)
    _op2(kode, "CALL", "builtin.type", 1)
    _op1(kode, "PUSH_CONST", "boolsk")
    _op(kode, "COMPARE_EQ")
    _op1(kode, "JUMP_IF_FALSE", vidare)
    _op1(kode, "LOAD_NAME", var)
    _op1(kode, "JUMP_IF_FALSE", feil_label)
    _op1(kode, "LABEL", vidare)
    returner 0
}

funksjon _emit_test(kode, indeks: heiltall, visningsnamn: tekst, fn: tekst) -> heiltall {
    la base = "__nct_" + tekst_fra_heltall(indeks)
    la fang_l = base + "_fang__"
    la retfeil_l = base + "_retfeil__"
    la ok_l = base + "_ok__"
    la slutt_l = base + "_slutt__"
    _op2(kode, "TRY_BEGIN", fang_l, "*")
    _op2(kode, "CALL", fn, 0)
    _op1(kode, "STORE_NAME", "__nc_r")
    _op(kode, "TRY_END")
    _hopp_ved_feil_retur(kode, "__nc_r", retfeil_l, base)
    _op1(kode, "JUMP", ok_l)
    _op1(kode, "LABEL", retfeil_l)
    _skriv_med_verdi(kode, markør() + "FEIL: " + visningsnamn + " — returnerte ", "__nc_r", "\n")
    _auk(kode, "__nc_feil")
    _op1(kode, "JUMP", slutt_l)
    _op1(kode, "LABEL", ok_l)
    _skriv_konst(kode, markør() + "OK: " + visningsnamn + "\n")
    _auk(kode, "__nc_ok")
    _op1(kode, "JUMP", slutt_l)
    _op1(kode, "LABEL", fang_l)
    _op(kode, "TRY_END")
    _op(kode, "LOAD_EXCEPTION")
    _op1(kode, "STORE_NAME", "__nc_e")
    _skriv_med_verdi(kode, markør() + "FEIL: " + visningsnamn + " — ", "__nc_e", "\n")
    _auk(kode, "__nc_feil")
    _op1(kode, "LABEL", slutt_l)
    returner 0
}

// Koden til køyraren. `testar` er par [visningsnamn, funksjonsnøkkel].
funksjon koyrar_kode(modul: tekst, har_start: bool, testar: liste) -> liste {
    la kode = []
    _op1(kode, "PUSH_CONST", 0)
    _op1(kode, "STORE_NAME", "__nc_ok")
    _op1(kode, "PUSH_CONST", 0)
    _op1(kode, "STORE_NAME", "__nc_feil")
    _op1(kode, "PUSH_CONST", 0)
    _op1(kode, "STORE_NAME", "__nc_start_r")
    hvis har_start {
        _op2(kode, "TRY_BEGIN", "__nct_start_fang__", "*")
        _op2(kode, "CALL", modul + ".start", 0)
        _op1(kode, "STORE_NAME", "__nc_start_r")
        _op(kode, "TRY_END")
        _hopp_ved_feil_retur(kode, "__nc_start_r", "__nct_start_retfeil__", "__nct_start")
        _op1(kode, "JUMP", "__nct_start_slutt__")
        _op1(kode, "LABEL", "__nct_start_retfeil__")
        _skriv_med_verdi(kode, markør() + "FEIL: start() — returnerte ", "__nc_start_r", "\n")
        _op1(kode, "JUMP", "__nct_start_slutt__")
        _op1(kode, "LABEL", "__nct_start_fang__")
        _op(kode, "TRY_END")
        _op(kode, "LOAD_EXCEPTION")
        _op1(kode, "STORE_NAME", "__nc_e")
        _skriv_med_verdi(kode, markør() + "FEIL: start() — ", "__nc_e", "\n")
        _op1(kode, "PUSH_CONST", 1)
        _op1(kode, "STORE_NAME", "__nc_start_r")
        _op1(kode, "LABEL", "__nct_start_slutt__")
    }
    la i: heiltall = 0
    mens i < lengde(testar) {
        _emit_test(kode, i, tekst(testar[i][0]), tekst(testar[i][1]))
        i = i + 1
    }
    _skriv_med_verdi(kode, markør(), "__nc_ok", "/" + tekst_fra_heltall(lengde(testar)) + " bestått\n")
    // Returverdi: start() sin ikkje-null heiltalskode (eller usann) vinn, so exit-koden er
    // som før; elles 1 ved testfeil; elles start() sin returverdi.
    _hopp_ved_feil_retur(kode, "__nc_start_r", "__nct_ret_start__", "__nct_ret")
    _op1(kode, "LOAD_NAME", "__nc_feil")
    _op1(kode, "PUSH_CONST", 0)
    _op(kode, "COMPARE_EQ")
    _op1(kode, "JUMP_IF_FALSE", "__nct_ret_1__")
    _op1(kode, "LOAD_NAME", "__nc_start_r")
    _op(kode, "RETURN")
    _op1(kode, "LABEL", "__nct_ret_start__")
    _op1(kode, "LOAD_NAME", "__nc_start_r")
    _op(kode, "RETURN")
    _op1(kode, "LABEL", "__nct_ret_1__")
    _op1(kode, "PUSH_CONST", 1)
    _op(kode, "RETURN")
    returner kode
}

funksjon _funksjonsdef(namn: tekst, modul: tekst, kode) {
    la def = {}
    def["name"] = namn
    def["module"] = modul
    def["params"] = []
    def["is_async"] = usann
    def["string_encoding"] = "decoded-v1"
    def["code"] = kode
    returner def
}

// Legg køyraren inn i `ncb` (muterer). Returnerer talet på testar køyraren eig, eller 0
// når fila ikkje treng køyrar (då er ncb urørd).
funksjon installer_koyrar(ncb) -> heiltall {
    hvis builtin.type(ncb) != "ordbok" eller ikkje _har(ncb, "functions") { returner 0 }
    la funksjonar = ncb["functions"]
    hvis builtin.type(funksjonar) != "ordbok" { returner 0 }
    la modul = hovudmodul(ncb)
    la har_start = _har(funksjonar, modul + ".start")
    la blokker = testblokker(ncb, modul)
    la testar = []
    la i: heiltall = 0
    mens i < lengde(blokker) {
        la b = blokker[i]
        la kort = "__nc_testblokk_" + tekst_fra_heltall(i) + "__"
        la def = _funksjonsdef(kort, modul, b["code"])
        hvis _har(b, "string_encoding") { def["string_encoding"] = b["string_encoding"] }
        funksjonar[modul + "." + kort] = def
        la namn = ""
        hvis _har(b, "name") { namn = tekst(b["name"]) }
        hvis namn == "" { namn = "test-blokk " + tekst_fra_heltall(i + 1) }
        legg_til(testar, [namn, modul + "." + kort])
        i = i + 1
    }
    hvis ikkje har_start {
        la fn = testfunksjonar(ncb, modul)
        i = 0
        mens i < lengde(fn) {
            la k = tekst(fn[i])
            legg_til(testar, [builtin.slice(k, lengde(modul) + 1, lengde(k)), k])
            i = i + 1
        }
    }
    hvis lengde(testar) == 0 { returner 0 }
    la namn = koyrar_namn()
    funksjonar[modul + "." + namn] = _funksjonsdef(namn, modul, koyrar_kode(modul, har_start, testar))
    ncb["entry"] = modul + "." + namn
    returner lengde(testar)
}

// ── Fil-inngang for testløparen ─────────────────────────────────────────────────

funksjon _vert_binær() -> bool {
    la v = 0
    prøv { v = builtin.ncb_binaer_versjon() } fang (e) { returner usann }
    returner v >= 1
}

// Les NCB-en på `ncb_sti`, installer køyraren og skriv resultatet til `ut_sti` i same
// format (binær inn → binær ut, JSON inn → JSON ut). Returnerer talet på testar (0 = fila
// treng ingen køyrar; ingenting blir skrive). Kastar ved lese-/skrivefeil, so kallaren kan
// feile testfila i staden for å hoppe stille over test-blokkene.
funksjon forbered_ncb(ncb_sti: tekst, ut_sti: tekst) -> heiltall {
    la t = builtin.fil_les(ncb_sti)
    la binær = serde.er_binaer_tekst(t)
    la ncb = null
    hvis binær og _vert_binær() {
        ncb = builtin.ncb_fra_tekst(t)
    } ellers {
        ncb = serde.deserialiser_tekst(t)
    }
    la tal = installer_koyrar(ncb)
    hvis tal == 0 { returner 0 }
    hvis binær {
        hvis _vert_binær() {
            builtin.fil_skriv(ut_sti, builtin.ncb_til_binaer(ncb))
        } ellers {
            builtin.fil_skriv(ut_sti, serde.serialiser_tekst(ncb))
        }
    } ellers {
        builtin.fil_skriv(ut_sti, json_skriv(ncb))
    }
    returner tal
}

// ── Tolking av utskrifta ────────────────────────────────────────────────────────
// Rapportlinjene til køyraren (utan markør). Prosess-ABI-en kan levere stdout med
// escapa linjeskift («\n» som to teikn); ei rapportlinje sluttar difor ved fyrste ekte
// linjeskift, fyrste escapa «\n» eller neste markør.
funksjon rapportlinjer(utskrift: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la m = markør()
    la rest = builtin.replace(utskrift, "\r", "")
    la pos = builtin.index_of(rest, m)
    mens pos >= 0 {
        rest = builtin.slice(rest, pos + lengde(m), lengde(rest))
        la slutt = lengde(rest)
        la nl = builtin.index_of(rest, "\n")
        hvis nl >= 0 og nl < slutt { slutt = nl }
        la esc = builtin.index_of(rest, "\\n")
        hvis esc >= 0 og esc < slutt { slutt = esc }
        la neste = builtin.index_of(rest, m)
        hvis neste >= 0 og neste < slutt { slutt = neste }
        legg_til(ut, builtin.slice(rest, 0, slutt))
        rest = builtin.slice(rest, slutt, lengde(rest))
        pos = builtin.index_of(rest, m)
    }
    returner ut
}

// Oppsummeringa «x/n bestått» → [x, n], eller [-1, -1] når køyraren ikkje kom så langt
// (t.d. at prosessen døydde eller start() avslutta prosessen før test-blokkene).
funksjon oppsummering(linjer: liste_tekst) -> liste_heiltall {
    la i: heiltall = lengde(linjer) - 1
    mens i >= 0 {
        la l = tekst(linjer[i])
        hvis builtin.ends_with(l, " bestått") og ikkje builtin.starts_with(l, "OK: ") og
           ikkje builtin.starts_with(l, "FEIL: ") {
            la tal = builtin.slice(l, 0, lengde(l) - lengde(" bestått"))
            la delar = builtin.split(tal, "/")
            hvis lengde(delar) == 2 {
                prøv {
                    returner [builtin.heltall_fra_tekst(builtin.trim(tekst(delar[0]))),
                              builtin.heltall_fra_tekst(builtin.trim(tekst(delar[1])))]
                } fang (e) { }
            }
        }
        i = i - 1
    }
    returner [-1, -1]
}

funksjon start() -> heiltall {
    skriv("tools/nc_test_oppdaging.no: bibliotek for tools/nc_test.no\n")
    returner 0
}
