// tools/verify_omgang6.no — shellfri Omgang 6: bygg-native → Linux ELF64

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk std.tempfile som tempfile
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    }
    fang (e) { returner "0" }
    returner "0"
}

funksjon skriv_fil(sti: tekst, innhald: tekst) -> boolsk {
    prøv { builtin.fil_skriv(sti, innhald) returner sann }
    fang (e) { returner usann }
    returner usann
}

funksjon filer_identiske(a: tekst, b: tekst) -> boolsk {
    hvis ikkje fil_finst(a) eller ikkje fil_finst(b) { returner usann }
    returner builtin.fil_les_binær(a) == builtin.fil_les_binær(b)
}

funksjon nc_miljø(root: tekst) -> ordbok_tekst {
    // Temp-katalogen (tempfile → TMPDIR, på macOS /var/folders/…) må ligge INNANFOR
    // disk-scopet barnet får, elles svarar seeden «Sikkerheitsfeil: … path outside
    // disk scope» på bygg-native (start() legg basen i NC_OM6_TMPBASE).
    la disk = root + ",.,/tmp,/private/tmp"
    la tmpbase = env("NC_OM6_TMPBASE")
    hvis tmpbase != "" { disk = disk + "," + tmpbase }
    returner {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": disk,
        "NORSCODE_ROOT": root
    }
}

// Committed Linux-stage0 manglar builtin.system_info → bruk GitHub Actions sine
// RUNNER_OS/RUNNER_ARCH (evt. NORSCODE_CI_SYSTEM/ARCH) fyrst, system_info elles.
funksjon plattform_system() -> tekst {
    la os = env("RUNNER_OS")
    hvis os == "" { os = env("NORSCODE_CI_SYSTEM") }
    hvis os == "" { prøv { os = tekst(builtin.system_info()["system"]) } fang (e) { os = "" } }
    hvis os == "macOS" { os = "Darwin" }
    returner os
}

funksjon plattform_maskin() -> tekst {
    la arch = builtin.lower(env("RUNNER_ARCH"))
    hvis arch == "" { arch = builtin.lower(env("NORSCODE_CI_ARCH")) }
    hvis arch == "" { prøv { arch = builtin.lower(tekst(builtin.system_info()["machine"])) } fang (e) { arch = "" } }
    hvis arch == "x64" { arch = "x86_64" }
    hvis arch == "aarch64" { arch = "arm64" }
    returner arch
}

// Barn av bin/nc må drivast via miljø-kontrakten (NORSCODE_CMD/NORSCODE_FILE):
// committed Linux-stage0 manglar argv-builtinane (argv → [] → selftest, exit 0
// utan å gjere noko), og miljøet vinn over argv i nc_main.start på alle seedar —
// utan eksplisitt NORSCODE_CMD/FILE arvar barnet FORELDRA sine (denne fila) og
// køyrer feil ting. Argv blir send med i tillegg (kontrakt/lesbarheit).
funksjon nc_verktøy_for(cmd: tekst) -> tekst {
    hvis cmd == "verify-seed" eller cmd == "seed-only" { returner "tools/verify_seed_only.no" }
    hvis cmd == "fetch-stage0-seed" { returner "tools/fetch_stage0_seed.no" }
    hvis cmd == "selfcompile-stage0-elf" { returner "tools/selfcompile_stage0_elf.no" }
    returner ""
}

funksjon absolutt(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon run_nc_miljø(root: tekst, argv: liste_tekst, miljø: ordbok_tekst, timeout_ms: heiltall) -> boolsk {
    la resultat = prosess.køyr(root + "/bin/nc", argv, root, miljø, timeout_ms)
    prosess.skriv_resultat(resultat)
    hvis prosess.ok(resultat) { returner sann }
    la kva = ""
    hvis lengde(argv) > 0 { kva = tekst(argv[0]) }
    linje("  [FEIL] nc " + kva + ": status=" + tekst(resultat["status"]) +
          " exit=" + tekst(resultat["exit_code"]) + " error=" + tekst(resultat["error"]))
    returner usann
}

funksjon run_nc(root: tekst, argv: liste_tekst, timeout_ms: heiltall) -> boolsk {
    la miljø = nc_miljø(root)
    la verktøy = ""
    hvis lengde(argv) > 0 { verktøy = nc_verktøy_for(tekst(argv[0])) }
    hvis verktøy != "" {
        miljø["NORSCODE_CMD"] = "run"
        miljø["NORSCODE_FILE"] = root + "/" + verktøy
    }
    returner run_nc_miljø(root, argv, miljø, timeout_ms)
}

// bygg-native (--target linux-x86_64) = compile → NCB, ncb_to_elf (native_codegen_v2)
// → ELF, executable-modus. Same to steg som archive/legacy_shell/tools/gc_probe_run.sh.
funksjon bygg_native(root: tekst, src: tekst, out: tekst) -> boolsk {
    la abs_src = absolutt(root, src)
    la abs_out = absolutt(root, out)
    la ncb = abs_out + ".ncb.json"
    la m1 = nc_miljø(root)
    m1["NORSCODE_CMD"] = "compile"
    m1["NORSCODE_FILE"] = abs_src
    m1["NORSCODE_OUTPUT"] = ncb
    hvis ikkje run_nc_miljø(root, ["compile", abs_src, ncb], m1, 600000) { returner usann }
    la m2 = nc_miljø(root)
    m2["NORSCODE_CMD"] = "run"
    m2["NORSCODE_FILE"] = root + "/tools/ncb_to_elf.no"
    m2["NORSCODE_NCB_TO_ELF_INPUT"] = ncb
    m2["NORSCODE_NCB_TO_ELF_OUTPUT"] = abs_out
    m2["NORSCODE_NATIVE_BIN"] = root + "/dist/norscode_native"
    hvis ikkje run_nc_miljø(root, ["run", "tools/ncb_to_elf.no"], m2, 600000) { returner usann }
    filops.slett_fil(ncb)
    hvis ikkje fil_finst(abs_out) { linje("  [FEIL] ncb_to_elf skreiv ikkje " + abs_out) returner usann }
    hvis ikkje gjer_kjørbar(abs_out) { linje("  [FEIL] klarte ikkje setje executable-modus på " + abs_out) returner usann }
    returner sann
}

funksjon linux_x86_64() -> boolsk {
    la system = plattform_system()
    la machine = plattform_maskin()
    returner system == "Linux" og (machine == "x86_64" eller machine == "amd64")
}

funksjon plattform() -> tekst {
    returner plattform_system() + "/" + plattform_maskin()
}

funksjon mode_match(mode: tekst, a: tekst) -> boolsk { returner mode == a eller mode == "all" }

// Executable-modus: runtime-filsystem-ABI-en fyrst (nyare seedar), elles
// builtin.fil_sett_kjorbar (committed Linux-stage0 manglar modus-ABI-en → «[verdi]»).
funksjon gjer_kjørbar(out: tekst) -> boolsk {
    prøv {
        la r = native_fs.native_sett_modus_sti(out, 493)
        hvis tekst(r["status"]) == "ok" { returner sann }
    } fang (e) { }
    prøv { returner builtin.fil_sett_kjorbar(out) } fang (e) { returner usann }
    returner usann
}

funksjon køyr_elf(root: tekst, out: tekst, forvent: tekst, label: tekst) -> boolsk {
    hvis ikkje gjer_kjørbar(out) {
        linje("  [FEIL] klarte ikkje setje executable-modus på ELF")
        returner usann
    }
    la resultat = prosess.køyr(out, [], root, {}, 30000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) {
        linje("  [FEIL] ELF exit code " + tekst(resultat["exit_code"]))
        returner usann
    }
    la run_out = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    hvis builtin.index_of(run_out, forvent) < 0 {
        linje("  [FEIL] manglar " + forvent)
        returner usann
    }
    linje("  [OK] " + label + " køyrer korrekt")
    linje("")
    returner sann
}

funksjon feil_rydd(tmp: ordbok_tekst, melding: tekst) -> heiltall {
    hvis melding != "" { linje(melding) }
    tempfile.slett_katalog(tmp)
    returner 1
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." } }
    la mode = env("NC_OM6_MODE")
    hvis mode == "" { mode = "all" }

    linje("=== Omgang 6: Native ELF (bygg-native) ===")
    linje("")
    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        hvis ikkje run_nc(root, ["verify-seed"], 300000) { returner 1 }
    }

    la tmp = tempfile.ny_tempkatalog("omgang6_")
    la base = tempfile.sti(tmp)
    miljo_sett("NC_OM6_TMPBASE", base)
    la src1 = base + "/src1.no"
    la src2 = base + "/src2.no"
    la src3 = base + "/src3.no"
    la src4 = base + "/src4.no"
    la src5 = base + "/src5.no"
    la out1 = base + "/elf1"
    la out2 = base + "/elf2"
    la out3 = base + "/elf3"
    la out4 = base + "/elf4"
    la out5 = base + "/elf5"
    la out6 = base + "/elf6"

    hvis ikkje skriv_fil(src1, "funksjon start() {\n  skriv(\"ELF-smoke OK\\n\")\n}\n") eller
       ikkje skriv_fil(src2, "funksjon start() {\n  la x: heltall = 6 * 7\n  skriv(tekst_fra_heltall(x))\n  skriv(\"\\n\")\n}\n") eller
       ikkje skriv_fil(src3, "funksjon start() {\n  la x: heltall = heltall_fra_tekst(\"42\")\n  skriv(tekst_fra_heltall(x))\n  skriv(\"\\n\")\n}\n") eller
       ikkje skriv_fil(src4, "funksjon f(a: tekst) {\n  skriv(type_av(a))\n  skriv(\"\\n\")\n}\nfunksjon start() {\n  f(\"abc\")\n}\n") eller
       ikkje skriv_fil(src5, "funksjon f(a: tekst, b: tekst) {\n  skriv(a + b)\n  skriv(\"\\n\")\n}\nfunksjon start() {\n  f(\"1\", \"2\")\n}\n") {
        returner feil_rydd(tmp, "  [FEIL] klarte ikkje skrive mellombelse kjeldefiler")
    }

    hvis mode_match(mode, "skriv") {
        linje("1. bygg-native (Gen1, skriv-smoke)...")
        hvis ikkje bygg_native(root, src1, out1) { returner feil_rydd(tmp, "") }
        la b1 = bytes(out1)
        linje("  [OK] " + b1 + " bytes")
        linje("")
        linje("2. bygg-native (Gen2, byte-determinisme, skriv-smoke)...")
        hvis ikkje bygg_native(root, src1, out2) { returner feil_rydd(tmp, "") }
        hvis ikkje filer_identiske(out1, out2) { returner feil_rydd(tmp, "  [FEIL] Gen1 og Gen2 ELF er ikkje identiske") }
        linje("  [OK] Gen1 == Gen2 (" + b1 + " bytes)")
        linje("")
    }

    hvis linux_x86_64() {
        hvis mode_match(mode, "skriv") og ikkje køyr_elf(root, out1, "ELF-smoke OK", "skriv-smoke") { returner feil_rydd(tmp, "") }
        hvis mode_match(mode, "int") {
            linje("4. bygg-native (Gen1, int-to-str smoke)...")
            hvis ikkje bygg_native(root, src2, out3) { returner feil_rydd(tmp, "") }
            la b3 = bytes(out3)
            linje("  [OK] " + b3 + " bytes")
            hvis env("NC_OM6_RUN_INT") == "1" {
                hvis ikkje køyr_elf(root, out3, "42", "int-to-str smoke") { returner feil_rydd(tmp, "") }
            } ellers { linje("  [OK] int-to-str bygg-native smoke er bygd (" + b3 + " bytes)") }
        }
        hvis mode == "str-to-int" eller mode_match(mode, "int") {
            linje("6. bygg-native (Gen1, str-to-int smoke)...")
            hvis ikkje bygg_native(root, src3, out4) { returner feil_rydd(tmp, "") }
            la b4 = bytes(out4)
            linje("  [OK] " + b4 + " bytes")
            hvis env("NC_OM6_RUN_INT") == "1" {
                hvis ikkje køyr_elf(root, out4, "42", "str-to-int smoke") { returner feil_rydd(tmp, "") }
            } ellers { linje("  [OK] str-to-int bygg-native smoke er bygd (" + b4 + " bytes)") }
        }
        hvis mode_match(mode, "type") {
            linje("8. bygg-native (Gen1, type_av parameter smoke)...")
            hvis ikkje bygg_native(root, src4, out5) { returner feil_rydd(tmp, "") }
            la b5 = bytes(out5)
            linje("  [OK] " + b5 + " bytes")
            hvis env("NC_OM6_RUN_INT") == "1" {
                hvis ikkje køyr_elf(root, out5, "tekst", "type_av parameter smoke") { returner feil_rydd(tmp, "") }
            } ellers { linje("  [OK] type_av bygg-native smoke er bygd (" + b5 + " bytes)") }
        }
        hvis mode_match(mode, "add") {
            linje("10. bygg-native (Gen1, tekst + tekst parameter smoke)...")
            hvis ikkje bygg_native(root, src5, out6) { returner feil_rydd(tmp, "") }
            la b6 = bytes(out6)
            linje("  [OK] " + b6 + " bytes")
            hvis env("NC_OM6_RUN_INT") == "1" {
                hvis ikkje køyr_elf(root, out6, "12", "tekst + tekst parameter smoke") { returner feil_rydd(tmp, "") }
            } ellers { linje("  [OK] tekst + tekst bygg-native smoke er bygd (" + b6 + " bytes)") }
        }
    } ellers {
        linje("3. Hopp over ELF-køyring (plattform " + plattform() + " — ELF er Linux x86-64)")
        linje("")
    }

    tempfile.slett_katalog(tmp)
    linje("=== Omgang 6: BESTÅTT ===")
    linje("bygg-native produserer deterministisk Linux ELF64 utan clang.")
    returner 0
}
