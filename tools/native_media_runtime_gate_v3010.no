// Shellfri bytes- og medieport for ein runtimekandidat.

bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon køyr_test(root: tekst, kandidat: tekst, testfil: tekst,
                   markør: tekst) -> boolsk {
    // Argv `run FIL` + miljø-kontrakten (NORSCODE_CMD/NORSCODE_FILE, som test-
    // harnessen): argv-handteringa varierer mellom seed-versjonar — Linux-stage0-
    // seeden køyrde selftest på `run FIL` («test OK» utan markør → FAIL), men
    // honorerer miljøet føre argv (verifisert i Docker linux/amd64).
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/" + testfil,
        "NORSCODE_VM_CAPABILITIES": "disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.",
        "PATH": "/nonexistent"
    }
    la resultat = prosess.køyr(kandidat, ["run", root + "/" + testfil],
                               root, miljø, 300000)
    hvis ikkje prosess.ok(resultat) eller
       builtin.index_of(tekst(resultat["stdout"]), markør) < 0 {
        prosess.skriv_resultat(resultat)
        returner usann
    }
    returner sann
}

funksjon krev(root: tekst, kandidat: tekst, testfil: tekst,
              markør: tekst, feil: tekst) -> boolsk {
    hvis køyr_test(root, kandidat, testfil, markør) { returner sann }
    skriv("[FAIL] " + feil + "\n")
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la kandidat = env("NORSCODE_MEDIA_RUNTIME_BIN")
    hvis kandidat == "" { kandidat = root + "/build/v3010/norscode_native_macos_arm64_v3010" }

    hvis ikkje krev(root, kandidat, "tests/test_native_bytes_runtime.no", "test_native_bytes_runtime OK", "native bytes eller binær fil-I/O") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_media_binary_read.no", "test_media_binary_read OK", "std.fil binær lesing") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_media_local.no", "test_media_local OK", "lokal PPM/WAV/Y4M-mediegenerering") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_model_runtime.no", "test_model_runtime OK", "lokal kvantisert modellruntime") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_qmodel_binary_file.no", "test_qmodel_binary_file OK", "binært qmodel-format og filinnlasting") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_model_registry.no", "test_model_registry OK", "avgrensa modellregister og livssyklus") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_model_trust.no", "test_model_trust OK", "SHA-256-verifisert modelltillit") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_sampling.no", "test_sampling OK", "deterministisk og avgrensa token-sampling") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_transformer.no", "test_transformer OK", "kvantisert kausal transformerblokk") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_text_generation.no", "test_text_generation OK", "lokal autoregressiv tekstgenerering") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_tokenizer.no", "test_tokenizer OK", "lokal tekst-tokenisering") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_tokenizer_bpe.no", "test_tokenizer_bpe OK", "BPE-vokabulartrening og tokenizerformat") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_text_model_bundle.no", "test_text_model_bundle OK", "NTM1 tekstmodellbundle i minne") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_text_model_bundle_file.no", "test_text_model_bundle_file OK", "NTM1 binær fil-roundtrip") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_text_model_registry.no", "test_text_model_registry OK", "verifisert NTM1-register og genereringslivssyklus") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_text_model_release.no", "test_text_model_release OK", "signert NTM1-utgjeving og atomisk oppgradering") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_model_server.no", "test_model_server OK", "bounded modellserver") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_media_neural.no", "test_media_neural OK", "nevralt styrt lokal mediegenerering") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_media_diffusion.no", "test_media_diffusion OK", "deterministisk CPU-diffusjon") { returner 1 }
    hvis ikkje krev(root, kandidat, "tests/test_http_binary.no", "test_http_binary OK", "HTTP/Base64-medieflyt") { returner 1 }
    skriv("[OK] native media runtime gate v3010 er grønn\n")
    returner 0
}
