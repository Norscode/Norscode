// Kontroller den kjende 19ee050-verten foer han faar koeyre i opplastingsjobben.
bruk std.sha256 som sha256

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { returner 2 }
    la data = builtin.fil_les_binær(root + "/build/arm-blob-stage/host/dist/norscode_native")
    hvis lengde(data) != 8853914 {
        skriv("FEIL: opplastingsverten har feil storleik\n")
        returner 1
    }
    la hash = ""
    prøv { hash = builtin.sha256_bytes(data) }
    fang (e) { hash = sha256.hash_bytes(data) }
    hvis hash != "392ede4ea2b2298fef3307e2f33a7d06942b674e5786cc93ec68d74081662d38" {
        skriv("FEIL: opplastingsverten har feil SHA-256\n")
        returner 1
    }
    skriv("OK: kjeldebunden Linux-vert, 8853914 byte, SHA-256 " + hash + "\n")
    returner 0
}
