// tools/verify_norscode_surface_ownership.no — samla eigarskapsgate

bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trace(melding: tekst) -> heiltall {
    hvis env("NORSCODE_PHASE0_TRACE") == "on" {
        linje("[phase0] " + melding)
    }
    returner 0
}

funksjon fil_inneheld(sti: tekst, needle: tekst) -> bool {
    prøv {
        returner builtin.index_of(builtin.fil_les(sti), needle) >= 0
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon startar_med(t: tekst, prefiks: tekst) -> bool {
    returner builtin.starts_with(t, prefiks)
}

funksjon sluttar_med(t: tekst, suffiks: tekst) -> bool {
    hvis lengde(t) < lengde(suffiks) { returner usann }
    returner builtin.slice(t, lengde(t) - lengde(suffiks), lengde(t)) == suffiks
}

funksjon aktiv_rel(sti: tekst) -> bool {
    hvis sti == "" { returner usann }
    hvis startar_med(sti, "archive/") { returner usann }
    hvis startar_med(sti, "ai_assistent") { returner usann }
    hvis startar_med(sti, "ai_assistent_bak_") { returner usann }
    hvis startar_med(sti, "tests_bak_") { returner usann }
    returner sann
}

funksjon har_eitt_suffiks(sti: tekst, suffiksar: liste_tekst) -> bool {
    la i = 0
    mens i < lengde(suffiksar) {
        hvis sluttar_med(sti, suffiksar[i]) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon traverser_katalog(rel: tekst) -> bool {
    hvis rel == ".norscode" eller startar_med(rel, ".norscode/") { returner usann }
    hvis rel == "build" { returner sann }
    hvis startar_med(rel, "build/") {
        hvis rel == "build/v3009" eller startar_med(rel, "build/v3009/") { returner sann }
        hvis rel == "build/v9630" eller startar_med(rel, "build/v9630/") { returner sann }
        hvis rel == "build/v9646" eller startar_med(rel, "build/v9646/") { returner sann }
        returner usann
    }
    returner sann
}

// `build/` er ei generert arbeidsflate, ikkje aktiv kjelde. Tre historiske,
// committed rotartefaktar blir framleis kontrollerte eksplisitt; vilkårlege
// kandidat-mellomfiler skal ikkje gjere eigarskapsgaten arbeidsmappeavhengig.
funksjon inkluder_bygg_rotfil(rel: tekst) -> bool {
    returner rel == "build/bootstrap_compiler_bundle_ncb_data.c" eller
             rel == "build/native_elf_compiler_bundle_ncb_data.c" eller
             rel == "build/runtime_before_hex_json_fix.c"
}

funksjon legg_til_walk_filer(root: tekst, relativ: tekst,
                              suffiksar: liste_tekst, ut: liste_tekst) -> bool {
    trace("walk start " + relativ)
    la walk = native_fs.native_walk_files_med_suffiks(
        root, relativ, builtin.join(suffiksar, ","))
    trace("walk ferdig " + relativ + ": status=" + tekst(walk["status"]) +
          " value=" + tekst(walk["value"]) + " error=" + tekst(walk["error"]))
    hvis walk["status"] != "ok" { returner usann }
    la filer = builtin.split(walk["data"], "\n")
    la i = 0
    mens i < lengde(filer) {
        la rel = builtin.trim(filer[i])
        hvis rel != "" og aktiv_rel(rel) og har_eitt_suffiks(rel, suffiksar) {
            legg_til(ut, rel)
        }
        i = i + 1
    }
    returner sann
}

funksjon liste_aktive_filer_walk_samla(root: tekst,
                                        suffiksar: liste_tekst) -> ordbok_tekst {
    la ut: liste_tekst = []
    trace("samla rotvandring start")
    la walk = native_fs.native_walk_files_filtrert(
        root, "", builtin.join(suffiksar, ","),
        "archive,.norscode,build,.git,ai_assistent*,tests_bak_*")
    trace("samla rotvandring ferdig: status=" + tekst(walk["status"]) +
          " value=" + tekst(walk["value"]) + " error=" + tekst(walk["error"]))
    hvis walk["status"] != "ok" { returner {"status": "feil", "filer": ut} }
    la filer = builtin.split(walk["data"], "\n")
    la i = 0
    mens i < lengde(filer) {
        la rel = builtin.trim(filer[i])
        hvis rel != "" og aktiv_rel(rel) og har_eitt_suffiks(rel, suffiksar) {
            legg_til(ut, rel)
        }
        i = i + 1
    }

    // Build blir pruna frå rotvandringa. Berre direkte artefaktar og dei tre
    // eksplisitt eigde historiske kandidatkatalogane blir tekne med.
    la build = native_fs.native_list_typed(root, "build")
    hvis build["status"] != "ok" { returner {"status": "feil", "filer": ut} }
    la records = builtin.split(build["data"], "\n")
    i = 0
    mens i < lengde(records) {
        la record = builtin.trim(records[i])
        hvis lengde(record) >= 3 og builtin.slice(record, 1, 2) == "\t" {
            la kind = builtin.slice(record, 0, 1)
            la namn = builtin.slice(record, 2, lengde(record))
            la brel = "build/" + namn
            hvis (kind == "f" eller kind == "l") og inkluder_bygg_rotfil(brel) og har_eitt_suffiks(brel, suffiksar) {
                legg_til(ut, brel)
            } ellers hvis kind == "d" og traverser_katalog(brel) {
                hvis ikkje legg_til_walk_filer(root, brel, suffiksar, ut) {
                    returner {"status": "feil", "filer": ut}
                }
            }
        }
        i = i + 1
    }
    returner {"status": "ok", "filer": ut}
}

funksjon liste_aktive_filer_walk(root: tekst, suffiksar: liste_tekst) -> ordbok_tekst {
    la ut: liste_tekst = []
    la top = native_fs.native_list_typed(root, "")
    hvis top["status"] != "ok" { returner {"status": "feil", "filer": ut} }
    la records = builtin.split(top["data"], "\n")
    la i = 0
    mens i < lengde(records) {
        la record = builtin.trim(records[i])
        hvis lengde(record) >= 3 og builtin.slice(record, 1, 2) == "\t" {
            la kind = builtin.slice(record, 0, 1)
            la namn = builtin.slice(record, 2, lengde(record))
            hvis aktiv_rel(namn) {
                hvis kind == "f" eller kind == "l" {
                    hvis har_eitt_suffiks(namn, suffiksar) { legg_til(ut, namn) }
                } ellers hvis kind == "d" {
                    trace("inventory katalog " + namn)
                    hvis namn == "build" {
                        la build = native_fs.native_list_typed(root, "build")
                        hvis build["status"] != "ok" { returner {"status": "feil", "filer": ut} }
                        la build_records = builtin.split(build["data"], "\n")
                        la bi = 0
                        mens bi < lengde(build_records) {
                            la br = builtin.trim(build_records[bi])
                            hvis lengde(br) >= 3 og builtin.slice(br, 1, 2) == "\t" {
                                la bk = builtin.slice(br, 0, 1)
                                la bn = builtin.slice(br, 2, lengde(br))
                                la brel = "build/" + bn
                                hvis (bk == "f" eller bk == "l") og inkluder_bygg_rotfil(brel) og har_eitt_suffiks(brel, suffiksar) {
                                    legg_til(ut, brel)
                                } ellers hvis bk == "d" og traverser_katalog(brel) {
                                    trace("inventory build-katalog " + brel)
                                    hvis ikkje legg_til_walk_filer(root, brel, suffiksar, ut) {
                                        returner {"status": "feil", "filer": ut}
                                    }
                                }
                            }
                            bi = bi + 1
                        }
                    } ellers hvis ikkje legg_til_walk_filer(root, namn, suffiksar, ut) {
                        returner {"status": "feil", "filer": ut}
                    }
                }
            }
        }
        i = i + 1
    }
    returner {"status": "ok", "filer": sorter_tekst(ut)}
}

funksjon liste_aktive_filer(root: tekst, suffiksar: liste_tekst) -> liste_tekst {
    la samla = liste_aktive_filer_walk_samla(root, suffiksar)
    hvis samla["status"] == "ok" { returner samla["filer"] }
    la rask = liste_aktive_filer_walk(root, suffiksar)
    hvis rask["status"] == "ok" { returner rask["filer"] }
    la ut: liste_tekst = []
    la kø: liste_tekst = [""]
    la qi = 0
    mens qi < lengde(kø) {
        la katalog = kø[qi]
        la listing = native_fs.native_list_typed(root, katalog)
        la typed = listing["status"] == "ok"
        hvis ikkje typed { listing = native_fs.native_list(root, katalog) }
        hvis listing["status"] == "ok" {
            la barn = builtin.split(listing["data"], "\n")
            la bi = 0
            mens bi < lengde(barn) {
                la record = builtin.trim(barn[bi])
                la kind = ""
                la namn = record
                hvis typed og lengde(record) >= 3 og builtin.slice(record, 1, 2) == "\t" {
                    kind = builtin.slice(record, 0, 1)
                    namn = builtin.slice(record, 2, lengde(record))
                }
                hvis namn != "" {
                    la rel = namn
                    hvis katalog != "" { rel = katalog + "/" + namn }
                    hvis rel != ".git" og aktiv_rel(rel) {
                        hvis kind == "d" {
                            hvis traverser_katalog(rel) { legg_til(kø, rel) }
                        } ellers hvis typed {
                            hvis kind == "f" og har_eitt_suffiks(rel, suffiksar) {
                                legg_til(ut, rel)
                            }
                        } ellers hvis native_fs.native_list(root, rel)["status"] == "ok" {
                            hvis traverser_katalog(rel) { legg_til(kø, rel) }
                        } ellers hvis har_eitt_suffiks(rel, suffiksar) {
                            legg_til(ut, rel)
                        }
                    }
                }
                bi = bi + 1
            }
        }
        qi = qi + 1
    }
    returner sorter_tekst(ut)
}

funksjon filtrer_suffiks(filer: liste_tekst, suffiksar: liste_tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(filer) {
        hvis har_eitt_suffiks(filer[i], suffiksar) { legg_til(ut, filer[i]) }
        i = i + 1
    }
    returner ut
}

funksjon sett_inn_sortert(liste: liste_tekst, verdi: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la sett = usann
    la i = 0
    mens i < lengde(liste) {
        hvis ikkje sett og verdi < liste[i] {
            legg_til(ut, verdi)
            sett = sann
        }
        legg_til(ut, liste[i])
        i = i + 1
    }
    hvis ikkje sett { legg_til(ut, verdi) }
    returner ut
}

funksjon sorter_tekst(liste: liste_tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(liste) {
        ut = sett_inn_sortert(ut, liste[i])
        i = i + 1
    }
    returner ut
}

funksjon utan_suffiks(sti: tekst, suffiks: tekst) -> tekst {
    hvis sluttar_med(sti, suffiks) { returner builtin.slice(sti, 0, lengde(sti) - lengde(suffiks)) }
    returner sti
}

funksjon same_liste(a: liste_tekst, b: liste_tekst) -> bool {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) {
        hvis a[i] != b[i] { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon liste_inneheld(liste: liste_tekst, verdi: tekst) -> bool {
    la i = 0
    mens i < lengde(liste) {
        hvis liste[i] == verdi { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon berre_forventa(actual: liste_tekst, expected: liste_tekst) -> bool {
    la i = 0
    mens i < lengde(actual) {
        hvis ikkje liste_inneheld(expected, actual[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon liste_til_tekst(liste: liste_tekst) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(liste) {
        hvis ut != "" { ut = ut + "\n" }
        ut = ut + liste[i]
        i = i + 1
    }
    returner ut
}

funksjon script_eigar_gate_med_filer(root: tekst, filer: liste_tekst) -> bool {
    la ok_gate = sann
    la i = 0
    mens i < lengde(filer) {
        la p = filer[i]
        la base = utan_suffiks(utan_suffiks(utan_suffiks(utan_suffiks(p, ".sh"), ".ps1"), ".js"), ".swift")
        hvis ikkje builtin.fil_finnes(root + "/" + base + ".no") {
            linje(p + " manglar " + base + ".no")
            ok_gate = usann
        }
        i = i + 1
    }
    hvis ok_gate { linje("OK: alle aktive .sh/.ps1/.js/.swift har same-namn .no-eigar") }
    ellers { linje("FEIL: alle aktive .sh/.ps1/.js/.swift har same-namn .no-eigar") }
    returner ok_gate
}

funksjon script_eigar_gate(root: tekst) -> bool {
    returner script_eigar_gate_med_filer(
        root, liste_aktive_filer(root, [".sh", ".ps1", ".js", ".swift"]))
}

funksjon script_markor_ok(root: tekst, rel: tekst) -> bool {
    la sti = root + "/" + rel
    hvis sluttar_med(rel, ".sh") {
        hvis fil_inneheld(sti, "Norscode-first wrapper") { returner sann }
        returner usann
    }
    hvis sluttar_med(rel, ".ps1") {
        hvis fil_inneheld(sti, "Norscode-first bridge") { returner sann }
        returner usann
    }
    returner sann
}

funksjon script_markor_gate_med_filer(root: tekst, filer: liste_tekst) -> bool {
    la ok_gate = sann
    la i = 0
    mens i < lengde(filer) {
        la p = filer[i]
        hvis ikkje script_markor_ok(root, p) {
            linje(p + " manglar Norscode-first markør/bridge eller eksplisitt unntak")
            ok_gate = usann
        }
        i = i + 1
    }
    hvis ok_gate { linje("OK: aktive .sh/.ps1-wrapperar har Norscode-first markør/bridge eller eksplisitt unntak") }
    ellers { linje("FEIL: aktive .sh/.ps1-wrapperar har Norscode-first markør/bridge eller eksplisitt unntak") }
    returner ok_gate
}

funksjon script_markor_gate(root: tekst) -> bool {
    returner script_markor_gate_med_filer(
        root, liste_aktive_filer(root, [".sh", ".ps1", ".js", ".swift"]))
}

funksjon c_overflate_gate_med_filer(root: tekst, actual: liste_tekst) -> bool {
    hvis lengde(actual) == 0 {
        linje("OK: C-rest er avgrensa til kjende genererte artefaktar")
        returner sann
    }
    la expected: ordbok_tekst = {}
    expected["build/bootstrap_compiler_bundle_ncb_data.c"] = "1"
    expected["build/native_elf_compiler_bundle_ncb_data.c"] = "1"
    expected["build/runtime_before_hex_json_fix.c"] = "1"
    expected["build/v3009/native_candidate_combined.c"] = "1"
    expected["build/v3009/native_argv_dispatch_candidate.c"] = "1"
    expected["build/v3009/native_full_host_argv_candidate.c"] = "1"
    expected["build/v3009/native_candidate_gc.c"] = "1"
    expected["build/v3009/native_gc_stress.c"] = "1"
    expected["build/v3009/norscode_generated.c"] = "1"
    expected["build/v3009/norscode_generated_argv_candidate.c"] = "1"
    expected["build/v3009/norscode_generated_argv_dispatch.c"] = "1"
    expected["build/v3009/norscode_generated_full_host_argv.c"] = "1"
    expected["build/v3009/norscode_generated_gc.c"] = "1"
    expected["build/v3009/norscode_generated_main_argv.c"] = "1"
    expected["build/v9630/native_candidate_linux.c"] = "1"
    expected["build/v9630/norscode_generated.c"] = "1"
    expected["build/v9646/native_candidate_linux_aarch64.c"] = "1"
    expected["build/v9646/native_candidate_linux_x86_64.c"] = "1"
    expected["build/v9646/native_candidate_macos.c"] = "1"
    expected["build/v9646/native_candidate_windows.c"] = "1"
    expected["build/v9646/norscode_generated.c"] = "1"
    expected["tests/fixtures/windows_process_fixture.c"] = "1"
    expected["tests/fixtures/windows_utf8_file_fixture.c"] = "1"
    expected["tests/native_gc_blocked_thread.c"] = "1"
    expected["tests/native_gc_exception_unwind.c"] = "1"
    expected["tests/native_gc_generational.c"] = "1"
    expected["tests/native_gc_lifecycle.c"] = "1"
    expected["tests/native_gc_relocation.c"] = "1"
    expected["tests/native_gc_threads.c"] = "1"
    expected["third_party/sqlite/sqlite3.c"] = "1"
    la berre_kjende = sann
    la ai = 0
    mens ai < lengde(actual) {
        hvis ikkje finnes_nøkkel(expected, actual[ai]) { berre_kjende = usann }
        ai = ai + 1
    }
    hvis berre_kjende {
        linje("OK: C-rest er avgrensa til kjende genererte artefaktar")
        returner sann
    }
    linje("FEIL: C-rest er avgrensa til kjende genererte artefaktar")
    linje("uventa C-overflate:")
    linje(liste_til_tekst(actual))
    returner usann
}

funksjon c_overflate_gate(root: tekst) -> bool {
    returner c_overflate_gate_med_filer(root, liste_aktive_filer(root, [".c"]))
}

funksjon krev_filmarkor(root: tekst, rel: tekst, needle: tekst) -> bool {
    hvis fil_inneheld(root + "/" + rel, needle) { returner sann }
    linje("FEIL: manglar markør i " + rel + ": " + needle)
    returner usann
}

funksjon krev_filmarkor_hvis_finnes(root: tekst, rel: tekst, needle: tekst) -> bool {
    hvis ikkje builtin.fil_finnes(root + "/" + rel) { returner sann }
    returner krev_filmarkor(root, rel, needle)
}

funksjon c_artifact_markorar_med_filer(root: tekst, c_filer: liste_tekst) -> bool {
    hvis lengde(c_filer) == 0 {
        linje("OK: ingen aktive C-artefaktar treng markørsjekk")
        returner sann
    }
    la ok_markor = sann
    hvis ikkje krev_filmarkor_hvis_finnes(root, "build/bootstrap_compiler_bundle_ncb_data.c", "Auto-generated by tools/generate_build_embed_c.no") { ok_markor = usann }
    hvis ikkje krev_filmarkor_hvis_finnes(root, "build/native_elf_compiler_bundle_ncb_data.c", "Auto-generated by tools/generate_build_embed_c.no") { ok_markor = usann }
    hvis ikkje krev_filmarkor_hvis_finnes(root, "build/v3009/norscode_generated.c", "Generert av archive/legacy_c_backend") { ok_markor = usann }
    hvis ikkje krev_filmarkor_hvis_finnes(root, "build/v3009/norscode_generated.c", "IKKJE REDIGER") { ok_markor = usann }
    hvis ikkje krev_filmarkor_hvis_finnes(root, "build/v3009/native_candidate_combined.c", "#include \"norscode_generated.c\"") { ok_markor = usann }
    hvis ok_markor { linje("OK: C-artefaktmarkørar er Norscode-verifiserte") }
    returner ok_markor
}

funksjon c_artifact_markorar(root: tekst) -> bool {
    returner c_artifact_markorar_med_filer(root, liste_aktive_filer(root, [".c"]))
}

funksjon samla_eigarskap_gate(root: tekst) -> bool {
    trace("ownership inventory start")
    la alle = liste_aktive_filer(root, [".sh", ".ps1", ".js", ".swift", ".c"])
    trace("ownership inventory ferdig: " + tekst_fra_heltall(lengde(alle)) + " relevante filer")
    la scripts = filtrer_suffiks(alle, [".sh", ".ps1", ".js", ".swift"])
    la c_filer = filtrer_suffiks(alle, [".c"])
    la ok_all = sann
    hvis ikkje script_eigar_gate_med_filer(root, scripts) { ok_all = usann }
    trace("script-eigar ferdig")
    hvis ikkje script_markor_gate_med_filer(root, scripts) { ok_all = usann }
    trace("script-markør ferdig")
    hvis ikkje c_overflate_gate_med_filer(root, c_filer) { ok_all = usann }
    trace("C-overflate ferdig")
    hvis ikkje c_artifact_markorar_med_filer(root, c_filer) { ok_all = usann }
    trace("C-markør ferdig")
    returner ok_all
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la ok_all = sann

    hvis ikkje samla_eigarskap_gate(root) { ok_all = usann }

    hvis ok_all {
        linje("=== Norscode surface ownership: BESTÅTT ===")
        returner 0
    }
    linje("=== Norscode surface ownership: FEILA ===")
    returner 1
}
