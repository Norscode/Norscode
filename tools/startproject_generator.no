// Native Norscode-malmotor for `nc startproject`.

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs

funksjon _sti(rot: tekst, rel: tekst) -> tekst {
    hvis builtin.ends_with(rot, "/") { returner rot + rel }
    returner rot + "/" + rel
}

funksjon _gyldig_namn(namn: tekst) -> bool {
    returner namn != "" og builtin.index_of(namn, "/") < 0 og
        builtin.index_of(namn, "\\") < 0 og builtin.index_of(namn, "..") < 0 og
        builtin.index_of(namn, "\n") < 0 og builtin.index_of(namn, "\r") < 0
}

funksjon _variant(auth: bool, admin: bool) -> tekst {
    hvis auth og admin { returner "full" }
    hvis auth { returner "auth" }
    hvis admin { returner "admin" }
    returner "base"
}

funksjon _skriv_malar(template_root: tekst, output: tekst, project: tekst,
                      db: tekst, root: tekst) -> bool {
    la filer = filops.walk(template_root)
    la i = 0
    mens i < lengde(filer) {
        la source = filer[i]
        la relative = builtin.slice(source, lengde(template_root) + 1, lengde(source))
        la target = _sti(output, relative)
        hvis ikkje filops.lag_katalogar(filops.katalog(target)) { returner usann }
        prøv {
            la body = builtin.fil_les(source)
            body = builtin.replace(body, "__PROJECT_NAME__", project)
            body = builtin.replace(body, "__DB_FILE__", db)
            body = builtin.replace(body, "__NORSCODE_ROOT__", root)
            builtin.fil_skriv(target, body)
        } fang (e) {
            returner usann
        }
        i = i + 1
    }
    returner sann
}

funksjon generer(root: tekst, output: tekst, project: tekst, db: tekst,
                 auth: bool, admin: bool) -> bool {
    hvis ikkje _gyldig_namn(project) eller root == "" eller output == "" { returner usann }
    la template_root = _sti(root, "tools/startproject_templates/" + _variant(auth, admin))
    hvis ikkje filops.katalog_finnes(template_root) { returner usann }
    hvis filops.katalog_finnes(output) og lengde(filops.lista_katalog(output)) > 0 { returner usann }
    hvis ikkje filops.lag_katalogar(output) { returner usann }
    hvis ikkje _skriv_malar(template_root, output, project, db, root) { returner usann }

    // Materialiser importtrea i prosjektet; ingen `ln`, shell eller ekstern prosess.
    la tre: liste_tekst = ["std", "selfhost", "runtime", "compiler"]
    la i = 0
    mens i < lengde(tre) {
        hvis ikkje filops.kopier_tre(_sti(root, tre[i]), _sti(output, tre[i])) { returner usann }
        i = i + 1
    }
    la mode = native_fs.native_sett_modus_sti(_sti(output, "bin/nc"), 493)
    hvis mode["status"] != "ok" { returner usann }
    returner sann
}

funksjon start() -> heiltall {
    skriv("startproject_generator: bruk tools/startproject.no\n")
    returner 2
}
