// tools/selfcompile_stage0_elf.no — shellfri Omgang 6b.3: Gen0 (kjelde) → Gen1 → Gen2 → Gen3, fikspunkt Gen2 == Gen3

bruk std.filops som filops
bruk std.liste som lister
bruk std.runtime.process_abi som process_abi
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon les_fil_trygt(sti: tekst) -> tekst {
    prøv { returner builtin.fil_les(sti) } fang (e) { returner "" }
    returner ""
}

funksjon skriv_fil_trygt(sti: tekst, innhald: tekst) -> boolsk {
    prøv { builtin.fil_skriv(sti, innhald) returner sann }
    fang (e) { returner usann }
    returner usann
}

funksjon append_fil_trygt(sti: tekst, innhald: tekst) -> boolsk {
    returner skriv_fil_trygt(sti, les_fil_trygt(sti) + innhald)
}

funksjon filer_identiske(a: tekst, b: tekst) -> boolsk {
    hvis ikkje fil_finst(a) eller ikkje fil_finst(b) { returner usann }
    // Liste-== på ~1,2M-element binærlister har gjeve falsk «ulik» på seed.
    // Lengd + SHA-256 (native atom) er påliteleg og like streng.
    la ba = bytes(a)
    hvis ba == "0" eller ba != bytes(b) { returner usann }
    la ha = sha256_for(a)
    hvis ha == "" { returner usann }
    returner ha == sha256_for(b)
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) { returner "0" }
    returner "0"
}

funksjon sha256_for(sti: tekst) -> tekst {
    hvis ikkje fil_finst(sti) { returner "" }
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon nc_miljø(root: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_ROOT": root
    }
}

funksjon run_nc_med_miljø(root: tekst, argv: liste_tekst, miljø: ordbok_tekst,
                           timeout_ms: heiltall) -> boolsk {
    la resultat = prosess.køyr_med_grenser(root + "/bin/nc", argv, root,
        miljø, timeout_ms, 0, 1024)
    prosess.skriv_resultat(resultat)
    hvis prosess.ok(resultat) { returner sann }
    linje("[FEIL] nc status=" + tekst(resultat["status"]) + " exit=" +
          tekst(resultat["exit_code"]) + " error=" + tekst(resultat["error"]))
    returner usann
}

funksjon run_nc(root: tekst, argv: liste_tekst, timeout_ms: heiltall) -> boolsk {
    returner run_nc_med_miljø(root, argv, nc_miljø(root), timeout_ms)
}

funksjon build_omgang6b_ncb_frå(root: tekst, output: tekst, fragment_dir: tekst) -> boolsk {
    la miljø = nc_miljø(root)
    miljø["NORSCODE_OMGANG6B_NCB_OUT"] = output
    hvis fragment_dir != "" { miljø["NORSCODE_OMGANG6B_FRAGMENT_DIR"] = fragment_dir }
    // Eldre committed runtime les kommandoen frå miljøet og ignorerer argv.
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/build_omgang6b_compiler_ncb.no"
    returner run_nc_med_miljø(root, ["build-omgang6b-ncb"], miljø, 900000)
}

// J2 [0/5]: Gen0-fragment frå kjelde med seeden (ingen committa fragment).
// Returnerer fragmentkatalogen, eller "" ved feil.
funksjon lag_gen0_fragment(root: tekst) -> tekst {
    la eksplisitt = env("NORSCODE_OMGANG6B_FRAGMENT_DIR")
    hvis eksplisitt != "" {
        linje("  [MERK] Brukar Gen0-fragment frå NORSCODE_OMGANG6B_FRAGMENT_DIR=" + eksplisitt +
              " (Gen0 == Gen2 er hard berre når katalogen har gen0_modus.txt = kjelde)")
        returner eksplisitt
    }
    la gen0_dir = root + "/build/6b/fragments_gen0"
    la miljø = nc_miljø(root)
    miljø["NORSCODE_OMGANG6B_GEN0_DIR"] = gen0_dir
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/gen0_omgang6b_fragments.no"
    hvis ikkje run_nc_med_miljø(root, ["run", root + "/tools/gen0_omgang6b_fragments.no"], miljø, 3600000) {
        linje("  [FEIL] Gen0-fragment kunne ikkje genererast frå kjelde")
        returner ""
    }
    returner gen0_dir
}

// Modusen Gen0 vart laga i, frå markøren som tools/gen0_omgang6b_fragments.no skriv
// («kjelde» eller «seed-bundle»). "" = ekstern katalog utan markør.
funksjon gen0_modus(gen0_dir: tekst) -> tekst {
    la markør = gen0_dir + "/gen0_modus.txt"
    hvis ikkje fil_finst(markør) { returner "" }
    returner builtin.trim(les_fil_trygt(markør))
}

funksjon gen0_opphav(modus: tekst) -> tekst {
    hvis modus == "kjelde" { returner "Gen0 = seeden sin VM køyrde kompilatoren frå kjelde" }
    hvis modus == "seed-bundle" { returner "Gen0 = den innebygde kompilatoren til seeden, som kan vere eldre enn kjelda" }
    returner "Gen0 kjem frå ein ekstern fragmentkatalog utan modusmarkør"
}

// I kjelde-modus er Gen0 ein uavhengig VM-referanse for kompilator(kjelde), og Gen2 er
// det same køyrt native. Eit avvik er då ein semantisk feil i VM- eller native-vegen
// (t.d. AOT-JSON-escaping, presedens-miskompilering), og porten seier nei. Opt-out når
// seed-VM-en er kjend eldre enn kjelda: NORSCODE_OMGANG6B_TOLERER_GEN0_DRIFT=1.
funksjon gen0_drift_er_feil(modus: tekst) -> boolsk {
    hvis modus != "kjelde" { returner usann }
    returner env("NORSCODE_OMGANG6B_TOLERER_GEN0_DRIFT") != "1"
}

// Berre for negative probar: NORSCODE_OMGANG6B_TEST_FEILINJEKSJON=gen0,gen3 legg eitt
// byte til Gen0- eller Gen3-NCB-en rett før samanlikninga. Kroken kan berre gjere ein
// grøn port raud, aldri omvendt.
funksjon feilinjeksjon(punkt: tekst, sti: tekst) -> heiltall {
    la valt = env("NORSCODE_OMGANG6B_TEST_FEILINJEKSJON")
    hvis valt == "" { returner 0 }
    la delar = builtin.split(valt, ",")
    la i = 0
    mens i < lengde(delar) {
        hvis builtin.trim(delar[i]) == punkt {
            append_fil_trygt(sti, " ")
            linje("  [TEST] feilinjeksjon " + punkt + ": la til eitt byte i " + sti)
            returner 1
        }
        i = i + 1
    }
    returner 0
}

funksjon gen1_pipeline_binding(logisk_namn: tekst) -> tekst {
    hvis builtin.ends_with(logisk_namn, ".lex") {
        returner "selfhost.lexer.lexer_m1.selfhost.lexer.lexer_m1.lex"
    }
    hvis builtin.ends_with(logisk_namn, ".parse_program") {
        returner "selfhost.parser.parse_program"
    }
    hvis builtin.ends_with(logisk_namn, ".kompiler_til_ncb_json") {
        returner "selfhost.compiler.ir_to_bytecode.kompiler_til_ncb_json"
    }
    returner ""
}

// Dei gamle juli-fragmenta har dobbelt-kvalifiserte lexer-namn. Berre dei treng
// reparer_gen1_lexer_text_index og bind_gen1_lexer_klassifisering.
funksjon har_juli_lexer_namn(fns) -> boolsk {
    la p = "selfhost.lexer.lexer_m1.selfhost.lexer.lexer_m1."
    returner fns[p + "er_bokstav"] != null og fns[p + "er_tall"] != null og
        fns[p + "er_operator_start"] != null og fns[p + "er_punctuation"] != null
}

funksjon reparer_gen1_lexer_text_index(fns) -> boolsk {
    // Omskrivinga har ingen typeinformasjon. Ho gjer KVAR INDEX_GET i lexer_m1 om til
    // slice(x, i, i+1), òg liste- og ordbok-indeksering (t.d. sub_tokens[k]["type"] i
    // les_fstring). Ferske fragment har INDEX_GET (35 i lexer_m1), og native codegen
    // handterer s[i] direkte, så dei skal ikkje omskrivast: Gen3 skal kompilerast av
    // Gen2, ikkje av ein patcha Gen2. Berre gamle juli-fragment blir normaliserte.
    hvis ikkje har_juli_lexer_namn(fns) { returner sann }
    la namn = nøkler(fns)
    la reparert = 0
    la ni = 0
    mens ni < lengde(namn) {
        hvis builtin.index_of(namn[ni], "selfhost.lexer.lexer_m1") >= 0 {
            la fn = fns[namn[ni]]
            la gammel = fn["code"]
            la ny = []
            la i = 0
            mens i < lengde(gammel) {
                hvis gammel[i][0] == "INDEX_GET" {
                    // Stack: [..., tekst, indeks]. DUP held startindeksen
                    // medan slutt=indeks+1 blir bygd for slice.
                    legg_til(ny, ["DUP"])
                    legg_til(ny, ["PUSH_CONST", 1])
                    legg_til(ny, ["BINARY_ADD"])
                    legg_til(ny, ["CALL", "builtin.slice", 3])
                    reparert = reparert + 1
                } ellers {
                    legg_til(ny, gammel[i])
                }
                i = i + 1
            }
            fn["code"] = ny
            fns[namn[ni]] = fn
        }
        ni = ni + 1
    }
    returner sann
}

funksjon bind_gen1_lexer_klassifisering(fns) -> boolsk {
    la bokstav = "selfhost.lexer.lexer_m1.selfhost.lexer.lexer_m1.er_bokstav"
    la tall = "selfhost.lexer.lexer_m1.selfhost.lexer.lexer_m1.er_tall"
    la operator = "selfhost.lexer.lexer_m1.selfhost.lexer.lexer_m1.er_operator_start"
    la punctuation = "selfhost.lexer.lexer_m1.selfhost.lexer.lexer_m1.er_punctuation"
    // Dei dobbelt-kvalifiserte namna er ein quirk i dei gamle juli-fragmenta.
    // Ferske (regenererte) fragment er enkelt-kvalifiserte og har allereie
    // korrekt-resolverte klassifiseringskall → inga rebinding trengst.
    hvis ikkje har_juli_lexer_namn(fns) { returner sann }
    la namn = nøkler(fns)
    la ni = 0
    mens ni < lengde(namn) {
        hvis builtin.index_of(namn[ni], "selfhost.lexer.lexer_m1") >= 0 {
            la fn = fns[namn[ni]]
            la kode = fn["code"]
            la ci = 0
            mens ci < lengde(kode) {
                la instr = kode[ci]
                hvis builtin.type(instr) == "liste" og lengde(instr) >= 2 og instr[0] == "CALL" {
                    hvis builtin.ends_with(tekst(instr[1]), ".er_bokstav") {
                        instr[1] = bokstav
                        kode[ci] = instr
                    } ellers hvis builtin.ends_with(tekst(instr[1]), ".er_tall") {
                        instr[1] = tall
                        kode[ci] = instr
                    } ellers hvis builtin.ends_with(tekst(instr[1]), ".er_operator_start") {
                        instr[1] = operator
                        kode[ci] = instr
                    } ellers hvis builtin.ends_with(tekst(instr[1]), ".er_punctuation") {
                        instr[1] = punctuation
                        kode[ci] = instr
                    }
                }
                ci = ci + 1
            }
            fn["code"] = kode
            fns[namn[ni]] = fn
        }
        ni = ni + 1
    }
    returner sann
}

funksjon reparer_gen1_loop_pop(fns) -> boolsk {
    // Det committed Gen1-fragmentet er éin builtin-generasjon eldre enn
    // kjelda: pop_loop brukar fjern_indeks(liste, lengde-1). Kjelda brukar no
    // fjern_siste(liste). Normaliser den eksakte gamle sekvensen før Gen1 blir
    // køyrd, slik at kandidaten og den levande kjelda har same semantikk.
    la namn = nøkler(fns)
    la reparert = 0
    la ni = 0
    mens ni < lengde(namn) {
        hvis builtin.ends_with(namn[ni], ".pop_loop") {
            la fn = fns[namn[ni]]
            la gammel = fn["code"]
            la ny = []
            la i = 0
            mens i < lengde(gammel) {
                hvis i + 3 < lengde(gammel) og gammel[i][0] == "LOAD_NAME" og
                   gammel[i][1] == "n" og gammel[i + 1][0] == "PUSH_CONST" og
                   gammel[i + 1][1] == 1 og gammel[i + 2][0] == "BINARY_SUB" og
                   gammel[i + 3][0] == "CALL" og
                   gammel[i + 3][1] == "builtin.fjern_indeks" {
                    legg_til(ny, ["CALL", "builtin.fjern_siste", 1])
                    reparert = reparert + 1
                    i = i + 4
                } ellers {
                    legg_til(ny, gammel[i])
                    i = i + 1
                }
            }
            fn["code"] = ny
            fns[namn[ni]] = fn
        }
        ni = ni + 1
    }
    // Som over: ferske fragment brukar allereie fjern_siste og treng inga
    // pop_loop-normalisering. Berre gamle juli-fragment treff; 0 treff er OK.
    returner sann
}

funksjon bygg_gen1_source_executor(root: tekst, gen1_ncb: tekst,
                                   executor_ncb: tekst,
                                   executor_elf: tekst) -> boolsk {
    la entry_ncb = root + "/build/6b/selfcompile/gen1_source_entry.ncb.json"
    la entry_miljø = nc_miljø(root)
    entry_miljø["NORSCODE_CMD"] = "compile"
    entry_miljø["NORSCODE_FILE"] = root + "/tools/gen1_source_entry.no"
    entry_miljø["NORSCODE_OUTPUT"] = entry_ncb
    hvis ikkje run_nc_med_miljø(root,
        ["compile", root + "/tools/gen1_source_entry.no", entry_ncb],
        entry_miljø, 300000) {
        linje("  [FEIL] Kunne ikkje kompilere Gen1 source-entry")
        returner usann
    }
    la bundle = builtin.json_parse_raw(les_fil_trygt(gen1_ncb))
    la fns = bundle["functions"]
    hvis fns == null { linje("  [FEIL] Gen1 manglar functions") returner usann }
    hvis ikkje reparer_gen1_lexer_text_index(fns) {
        linje("  [FEIL] Gen1 manglar komplett lexer for source-executor")
        returner usann
    }
    hvis ikkje bind_gen1_lexer_klassifisering(fns) { returner usann }
    hvis ikkje reparer_gen1_loop_pop(fns) {
        linje("  [FEIL] Gen1 loop-pop kunne ikkje normaliserast")
        returner usann
    }
    la entry_bundle = builtin.json_parse_raw(les_fil_trygt(entry_ncb))
    la entry_fns = entry_bundle["functions"]
    la entry_src = entry_bundle["entry"]
    hvis entry_fns == null eller entry_src == null eller entry_fns[entry_src] == null {
        linje("  [FEIL] Generert Gen1 source-entry er ugyldig")
        returner usann
    }
    la entry = "selfhost.elf_compile_driver.start"
    la entry_fn = entry_fns[entry_src]
    entry_fn["name"] = "start"
    entry_fn["module"] = "selfhost.elf_compile_driver"
    la entry_code = entry_fn["code"]
    la ci = 0
    mens ci < lengde(entry_code) {
        la instr = entry_code[ci]
        hvis builtin.type(instr) == "liste" og lengde(instr) >= 2 og
           instr[0] == "CALL" {
            la bunden = gen1_pipeline_binding(tekst(instr[1]))
            // Berre gamle juli-fragment treng den dobbelt-kvalifiserte rebinding-a.
            // Ferske fragment: mål finst ikkje under det gamle namnet → la kallet
            // stå (det resolverer nativt mot den enkelt-kvalifiserte fragment-fn).
            hvis bunden != "" og fns[bunden] != null {
                instr[1] = bunden
                entry_code[ci] = instr
            }
        }
        ci = ci + 1
    }
    entry_fn["code"] = entry_code
    fns[entry] = entry_fn
    bundle["entry"] = entry
    hvis ikkje skriv_fil_trygt(executor_ncb, builtin.json_skriv(bundle)) {
        linje("  [FEIL] Kunne ikkje skrive Gen1 source-executor NCB")
        returner usann
    }
    hvis ikkje ncb_to_elf(root, executor_ncb, executor_elf) { returner usann }
    linje("  [OK] Gen1 source-executor bruker komplette lexer/parser/codegen-fragment")
    returner sann
}

funksjon kjeldefragment_miljø(root: tekst) -> ordbok_tekst {
    la miljø = nc_miljø(root)
    miljø["PATH"] = "/nonexistent"
    miljø["NORSCODE_RUN_CACHE"] = "0"
    // Source-only-kompilering lagar svært mange mellombelse lister og kart.
    // Fast-modus slår berre av VM-en si profilerande skyggeheap; dei faktiske
    // verdiane er framleis eigde og frigjorde av den native runtimen.
    miljø["NORSCODE_VM_FAST"] = "1"
    miljø["NORSCODE_VM_TARGET_CAPABILITIES"] = "env.read,disk.read,disk.write"
    miljø["NORSCODE_VM_TARGET_DISK_ROOT"] = root + ",.,/tmp,/private/tmp"
    // Overstyr alle verdi-baserte bundleinngangar eksplisitt, slik at ingen
    // forelderpolicy kan velje bundlemodus i den lukka source-executoren.
    miljø["NORSCODE_BUNDLE_ARGS"] = ""
    miljø["NORSCODE_BUNDLE_OUTPUT"] = ""
    miljø["NORSCODE_OM6B_SOURCE_NCB"] = ""
    miljø["NORSCODE_OM6B_SOURCE_NCB_DIR"] = ""
    returner miljø
}

funksjon spesialiser_gen1_source_executor(root: tekst, base_ncb: tekst,
                                          ncb_dir: tekst, source_rel: tekst,
                                          module_name: tekst,
                                          out_name: tekst) -> tekst {
    la out_sti = ncb_dir + "/" + out_name
    la progress_sti = out_sti + ".progress"
    filops.slett_fil(progress_sti)
    la verdier = {
        "NORSCODE_GEN1_SOURCE_FILE": root + "/" + source_rel,
        "NORSCODE_GEN1_OUTPUT_FILE": out_sti,
        "NORSCODE_GEN1_MODULE": module_name,
        "NORSCODE_GEN1_PROGRESS_FILE": progress_sti
    }
    la bundle = builtin.json_parse_raw(les_fil_trygt(base_ncb))
    la entry = bundle["entry"]
    la fns = bundle["functions"]
    hvis entry == null eller fns == null eller fns[entry] == null { returner "" }
    la fn = fns[entry]
    la gammel = fn["code"]
    la ny = []
    la erstatta = 0
    la i = 0
    mens i < lengde(gammel) {
        hvis i + 1 < lengde(gammel) og gammel[i][0] == "PUSH_CONST" og
           gammel[i + 1][0] == "CALL" og
           gammel[i + 1][1] == "builtin.miljo_hent" og
           verdier[gammel[i][1]] != null {
            legg_til(ny, ["PUSH_CONST", verdier[gammel[i][1]]])
            erstatta = erstatta + 1
            i = i + 2
        } ellers {
            legg_til(ny, gammel[i])
            i = i + 1
        }
    }
    hvis erstatta != 4 { returner "" }
    fn["code"] = ny
    fns[entry] = fn
    bundle["functions"] = fns
    la kandidat_ncb = ncb_dir + "/executor-" + out_name
    la kandidat_elf = kandidat_ncb + ".elf"
    hvis ikkje skriv_fil_trygt(kandidat_ncb, builtin.json_skriv(bundle)) { returner "" }
    hvis ikkje ncb_to_elf(root, kandidat_ncb, kandidat_elf) { returner "" }
    returner kandidat_elf
}

funksjon start_kjeldefragment(root: tekst, gen1_source_elf: tekst,
                              ncb_dir: tekst, source_rel: tekst,
                              module_name: tekst, out_name: tekst) -> ordbok_tekst {
    la miljø = kjeldefragment_miljø(root)
    // Kvar prosess får berre det versjonerte environment-kartet under.
    // inherit_env=0 hindrar at forelderpolicy eller cacheval lekker mellom
    // dei parallelle kompileringane.
    // Committed stage0 bygde den minimale Gen1 source-executor-ELF-en frå
    // lexer/parser/codegen-fragmenta. Han køyrer den faste entryen direkte;
    // ingen CLI-dispatch, legacy host eller precompiled kjeldeartefaktar deltek.
    la req = process_abi.async_spawn_request(gen1_source_elf,
        [], root, "", 3600000, 33554432)
    req = process_abi.sett_sandbox(req, "none", 0, 1024, usann)
    req = process_abi.sett_environment(req, miljø)
    la handle = builtin.process_operation(req)
    handle["source_rel"] = source_rel
    handle["out_name"] = out_name
    handle["out_sti"] = ncb_dir + "/" + out_name
    handle["progress_sti"] = ncb_dir + "/" + out_name + ".progress"
    returner handle
}

funksjon vent_kjeldefragment(handle: ordbok_tekst) -> boolsk {
    hvis handle["status"] != "kjorer" {
        linje("  [FEIL] Kunne ikkje starte Gen1 NCB source-compile " +
              tekst(handle["source_rel"]) + ": " + tekst(handle["error"]))
        returner usann
    }
    la resultat = builtin.process_operation(
        process_abi.async_wait_request(handle["handle"], 3600000))
    la output = builtin.process_operation(
        process_abi.async_operation("read", handle["handle"]))
    hvis output["stdout"] != "" { skriv(output["stdout"]) }
    hvis output["stderr"] != "" { skriv(output["stderr"]) }
    builtin.process_operation(process_abi.async_operation("close", handle["handle"]))
    hvis resultat["status"] != "ferdig" eller
       heltall_fra_tekst(tekst(resultat["exit_code"])) != 0 {
        linje("  [FEIL] Gen1 NCB source-compile " + tekst(handle["source_rel"]) +
              " status=" + tekst(resultat["status"]) +
              " exit=" + tekst(resultat["exit_code"]))
        hvis fil_finst(handle["progress_sti"]) {
            linje("  [DIAG] Siste compiler-safe-point: " +
                  les_fil_trygt(handle["progress_sti"]))
        }
        returner usann
    }
    hvis ikkje fil_finst(handle["out_sti"]) eller bytes(handle["out_sti"]) == "0" {
        linje("  [FEIL] Gen1 NCB skreiv ikkje gyldig " + tekst(handle["out_name"]))
        returner usann
    }
    linje("  [OK] Gen1 NCB source-compile " + tekst(handle["source_rel"]) +
          " -> " + tekst(handle["out_name"]))
    returner sann
}

funksjon bygg_source_only_gen2(root: tekst, gen1_source_ncb: tekst,
                               output: tekst, base: tekst) -> boolsk {
    la ncb_dir = base + "/ncb"
    la outer_dir = base + "/fragments"
    la inner_dir = base + "/fragments_inner"
    hvis filops.katalog_finnes(base) og ikkje filops.slett_tre(base) { returner usann }
    hvis ikkje filops.lag_katalogar(ncb_dir) { returner usann }
    la specs = builtin.split(
        "selfhost/lexer/lexer_m1.no|selfhost.lexer.lexer_m1|lexer_m1.ncb.json\n" +
        "selfhost/parser.no|selfhost.parser|parser.ncb.json\n" +
        "selfhost/compiler/semantic.no|selfhost.compiler.semantic|semantic.ncb.json\n" +
        "selfhost/compiler/ir_to_bytecode.no|selfhost.compiler.ir_to_bytecode|ir_to_bytecode.ncb.json\n" +
        "selfhost/json.no|selfhost.json|json.ncb.json\n" +
        "selfhost/kompiler.no|selfhost.kompiler|kompiler.ncb.json\n" +
        "selfhost/bundler.no|selfhost.bundler|bundler.ncb.json\n" +
        "selfhost/elf_compile_driver.no|selfhost.elf_compile_driver|elf_compile_driver.ncb.json",
        "\n")
    // Kvar source-executor kan bruke mykje minne under parsing. Å starte alle
    // åtte samtidig overkøyrer standard GitHub-runneren og gav signal 139.
    // To isolerte prosessar held reell parallellisme utan å gjere resultatet
    // avhengig av runner-minnet. Jobtalet kan senkast, men aldri aukast over 2.
    la jobbar: heiltall = 2
    hvis env("NORSCODE_GEN1_SOURCE_JOBS") != "" {
        la ønskte = heltall_fra_tekst(env("NORSCODE_GEN1_SOURCE_JOBS"))
        hvis ønskte >= 1 og ønskte <= 2 { jobbar = ønskte }
    }
    la handles = []
    la alle_ok = sann
    linje("  [INFO] " + tekst_fra_heiltall(lengde(specs)) +
          " Gen1-kjeldekompileringar køyrer deterministisk parallelt, maks " +
          tekst_fra_heiltall(jobbar) + " samtidige")
    la i = 0
    mens i < lengde(specs) {
        la delar = builtin.split(specs[i], "|")
        hvis lengde(delar) != 3 { returner usann }
        la executor = spesialiser_gen1_source_executor(root, gen1_source_ncb,
            ncb_dir, delar[0], delar[1], delar[2])
        hvis executor == "" { returner usann }
        la handle = start_kjeldefragment(root, executor, ncb_dir,
                                         delar[0], delar[1], delar[2])
        hvis handle["status"] != "kjorer" {
            linje("  [FEIL] Async Gen1-start feila for " + delar[0])
            returner usann
        }
        legg_til(handles, handle)
        hvis lengde(handles) >= jobbar {
            la hi = 0
            mens hi < lengde(handles) {
                hvis ikkje vent_kjeldefragment(handles[hi]) { alle_ok = usann }
                hi = hi + 1
            }
            handles = []
        }
        i = i + 1
    }
    i = 0
    mens i < lengde(handles) {
        hvis ikkje vent_kjeldefragment(handles[i]) { alle_ok = usann }
        i = i + 1
    }
    hvis ikkje alle_ok { returner usann }

    la miljø = nc_miljø(root)
    miljø["NORSCODE_FRAGMENT_NCB_DIR"] = ncb_dir
    miljø["NORSCODE_FRAGMENT_OUTER_DIR"] = outer_dir
    miljø["NORSCODE_FRAGMENT_INNER_DIR"] = inner_dir
    miljø["NORSCODE_FRAGMENT_SOURCE_NATIVE"] = "1"
    miljø["NORSCODE_RUN_CACHE"] = "0"
    // Ein arva NORSCODE_FRAGMENT_BUNDLE ville vinne over NCB_DIR. Då kom Gen2- og
    // Gen3-fragmenta frå seed-bunten, og porten samanlikna bunten med seg sjølv.
    miljø["NORSCODE_FRAGMENT_BUNDLE"] = ""
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/regenerate_omgang6b_fragments_safe.no"
    hvis ikkje run_nc_med_miljø(root, ["run", root + "/tools/regenerate_omgang6b_fragments_safe.no"], miljø, 900000) {
        returner usann
    }
    returner build_omgang6b_ncb_frå(root, output, inner_dir)
}

funksjon ncb_to_elf(root: tekst, input: tekst, output: tekst) -> boolsk {
    la miljø = nc_miljø(root)
    miljø["NORSCODE_NCB_TO_ELF_INPUT"] = input
    miljø["NORSCODE_NCB_TO_ELF_OUTPUT"] = output
    miljø["NORSCODE_USE_PRECOMPILED_SELFHOST"] = "0"
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/tools/ncb_to_elf.no"
    // 2026-09-09: 10 min → 40 min. Tidsgrensene her vart kalibrerte for den
    // C-æra-bygde stage0-en. Ein SJØLV-HOSTA seed gjer same arbeidet ~2,5×
    // seinare på dei største bundlane (målt: std.admin 82 s → 205 s; små/
    // mellomstore er derimot raskare), så Gen1-codegen sprengde 600 s i CI
    // («[1/4] Gen1 ... status=timeout exit=124» etter 10 m 35 s). Arbeidet
    // FULLFØRER — grensa var for knapp, ikkje koden broten.
    // 2026-09-11: den YTRE grensa vart heva, men ncb_to_elf har si eiga grense for
    // AOT-barnet (aot_timeout_ms, 900 s) som framleis drap Gen1 etter 15 min i CI.
    // Den indre må liggje rett under den ytre, elles er den ytre utan verknad.
    miljø["NORSCODE_NCB_TO_ELF_TIMEOUT_MS"] = "2340000"
    returner run_nc_med_miljø(root, ["run", root + "/tools/ncb_to_elf.no"], miljø, 2400000)
}

funksjon køyr_lukka(executable: tekst, argv: liste_tekst, cwd: tekst,
                     miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la req = process_abi.request(executable, argv, cwd, "", timeout_ms, 33554432)
    // Behald dei returnerte requestverdiane eksplisitt. Eldre VM-generasjonar
    // garanterer ikkje referansemutasjon for ordbøker på tvers av modulkall.
    req = process_abi.sett_sandbox(req, "none", 0, 1024, usann)
    req = process_abi.sett_environment(req, miljø)
    returner builtin.process_spawn_argv(req)
}

funksjon første_forskjellar(sti_a: tekst, sti_b: tekst, maks: heiltall) -> tekst {
    la a = builtin.fil_les_binær(sti_a)
    la b = builtin.fil_les_binær(sti_b)
    la min_lengd = lengde(a)
    hvis lengde(b) < min_lengd { min_lengd = lengde(b) }
    la out = ""
    la funne = 0
    la i = 0
    mens i < min_lengd og funne < maks {
        hvis a[i] != b[i] {
            out = out + tekst_fra_heiltall(i + 1) + " " + tekst_fra_heiltall(a[i]) + " " + tekst_fra_heiltall(b[i]) + "\n"
            funne = funne + 1
        }
        i = i + 1
    }
    hvis funne < maks og lengde(a) != lengde(b) {
        out = out + "length " + tekst_fra_heiltall(lengde(a)) + " " + tekst_fra_heiltall(lengde(b)) + "\n"
    }
    hvis out == "" { returner "Ingen lesbare forskjellar funne\n" }
    returner out
}

funksjon siste_liner(data: tekst, maks: heiltall) -> tekst {
    la linjer = builtin.split(data, "\n")
    la start_pos = lengde(linjer) - maks
    hvis start_pos < 0 { start_pos = 0 }
    returner builtin.join(builtin.slice(linjer, start_pos, lengde(linjer)), "\n")
}

funksjon skriv_diagnose(root: tekst, modus: tekst, resultat: ordbok_tekst,
                         log_path: tekst, os: tekst, arch: tekst) -> boolsk {
    la base = root + "/build/6b/selfcompile"
    la diag = base + "/gen1_elf_diagnose.txt"
    la gen1_elf = base + "/gen1_compiler.elf"
    la aggregate = base + "/gen1_elf_bundle.log"
    la body = "modus=" + modus + "\nexit_code=" + tekst(resultat["exit_code"]) +
        "\nos=" + os + "\narch=" + arch + "\ngen1_elf=" + gen1_elf +
        "\nexecution=structured-argv\n"
    hvis fil_finst(gen1_elf) {
        body = body + "gen1_elf_bytes=" + bytes(gen1_elf) + "\n" +
            "gen1_elf_sha256=" + sha256_for(gen1_elf) + "\n"
    }
    hvis fil_finst(log_path) { body = body + "\n[log tail]\n" + siste_liner(les_fil_trygt(log_path), 80) + "\n" }
    hvis fil_finst(aggregate) og log_path != aggregate {
        body = body + "\n[aggregate log tail]\n" + siste_liner(les_fil_trygt(aggregate), 120) + "\n"
    }
    returner skriv_fil_trygt(diag, body)
}

funksjon chunk_liste(base: tekst) -> liste_tekst {
    la filer: liste_tekst = []
    la namn = filops.lista_katalog(base)
    la i = 0
    mens i < lengde(namn) {
        hvis builtin.starts_with(namn[i], "part_") og builtin.ends_with(namn[i], ".json") {
            legg_til(filer, base + "/" + namn[i])
        }
        i = i + 1
    }
    lister.sorter_tekst(filer)
    returner filer
}

funksjon slett_chunks(base: tekst) -> heiltall {
    la filer = chunk_liste(base)
    la i = 0
    mens i < lengde(filer) { filops.slett_fil(filer[i]) i = i + 1 }
    returner 0
}

funksjon chunk_finst(base: tekst) -> boolsk { returner lengde(chunk_liste(base)) > 0 }

funksjon samle_chunk_output(base: tekst, ut: tekst) -> boolsk {
    la filer = chunk_liste(base)
    hvis lengde(filer) == 0 { returner usann }
    la samla = ""
    la i = 0
    mens i < lengde(filer) { samla = samla + les_fil_trygt(filer[i]) i = i + 1 }
    returner skriv_fil_trygt(ut, samla)
}

funksjon koyr_gen1_elf(mode: tekst, mode_log: tekst, gen1_elf: tekst,
                        miljø: ordbok_tekst, aggregate_log: tekst,
                        attempts: tekst, root: tekst) -> ordbok_tekst {
    append_fil_trygt(aggregate_log, "\n=== " + mode + " ===\n")
    // Same kalibrering som ncb_to_elf over: sjølv-hosta Gen1-ELF treng meir tid.
    la resultat = køyr_lukka(gen1_elf, [], root, miljø, 1800000)
    la body = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    skriv_fil_trygt(mode_log, body)
    append_fil_trygt(aggregate_log, "exit_code=" + tekst(resultat["exit_code"]) + "\n" + body)
    append_fil_trygt(attempts, "mode=" + mode + " exit_code=" + tekst(resultat["exit_code"]) + " log=" + mode_log + "\n")
    hvis body != "" { skriv(body) }
    returner resultat
}

// Kompilatoren `compiler_elf` (elf_compile_driver) materialiserer det source-only
// kompilerte bundlet `source_bundle` til `ut_ncb`. Berre source-only-modus: env-en
// set aldri NORSCODE_BUNDLE_ARGS/NORSCODE_OM6B_PRESET, så drivaren sin gamle
// bundle-args-veg (hard relativ sti til dei gamle committa fragmenta) blir aldri nådd.
funksjon materialiser_frå_kjelde(root: tekst, base: tekst, merkelapp: tekst,
                                  compiler_elf: tekst, source_bundle: tekst,
                                  ut_ncb: tekst, mode_log: tekst, aggregate_log: tekst,
                                  attempts: tekst, os: tekst, arch: tekst) -> boolsk {
    filops.slett_fil(ut_ncb)
    slett_chunks(base)
    la miljø = {
        "PATH": "/nonexistent",
        "NORSCODE_CMD": "run",
        "NORSCODE_OM6B_SOURCE_NCB": source_bundle,
        "NORSCODE_BUNDLE_OUTPUT": ut_ncb,
        "NORSCODE_BUNDLE_ENTRY": "selfhost.elf_compile_driver.start"
    }
    linje("  [INFO] " + merkelapp + " skriv det source-only materialiserte bundlet...")
    la res = koyr_gen1_elf("source-only " + merkelapp, mode_log, compiler_elf, miljø, aggregate_log, attempts, root)
    hvis prosess.ok(res) {
        hvis fil_finst(ut_ncb) { linje("  [OK] " + merkelapp + " skreiv source-only NCB") }
        ellers hvis chunk_finst(base) {
            hvis ikkje samle_chunk_output(base, ut_ncb) { returner usann }
            linje("  [OK] " + merkelapp + " skreiv NCB via chunk-output")
        } ellers { linje("  [FEIL] " + merkelapp + " returnerte suksess utan output") returner usann }
    } ellers {
        la rc = tekst(res["exit_code"])
        hvis chunk_finst(base) {
            hvis ikkje samle_chunk_output(base, ut_ncb) { returner usann }
            linje("  [MERK] Source-only-kopi krasja med exit " + rc + ", men chunk-output vart skrive; brukar artefaktet")
        } ellers {
            skriv_diagnose(root, "source_only", res, mode_log, os, arch)
            linje("  [FEIL] Source-only-kopi feila med exit " + rc + " og " + merkelapp + " skreiv ikkje NCB")
            returner usann
        }
    }
    hvis ikkje fil_finst(ut_ncb) { linje("  [FEIL] " + ut_ncb + " ikkje skrive") returner usann }
    returner sann
}

funksjon main() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    // Committed Linux-stage0 kan mangle system_info. GitHub Actions gir dei
    // same plattformfelta eksplisitt, så bruk dei før den nyare ABI-en.
    la os = env("RUNNER_OS")
    la arch = builtin.lower(env("RUNNER_ARCH"))
    hvis arch == "x64" { arch = "x86_64" }
    hvis arch == "aarch64" { arch = "arm64" }
    hvis os == "" eller arch == "" {
        la info = builtin.system_info()
        hvis os == "" { os = tekst(info["system"]) }
        hvis arch == "" { arch = builtin.lower(tekst(info["machine"])) }
    }
    // J2 tre-generasjonsport (ingen committa fragment):
    //   Gen0 = fragment frå kjelde med seeden (tools/gen0_omgang6b_fragments.no)
    //   Gen1 = ELF(Gen0-NCB)
    //   Gen2 = Gen1(kjelde)              → Gen2 ELF = ELF(Gen2-NCB)
    //   Gen3 = ELF(Gen2)(kjelde)         → Gen3 ELF = ELF(Gen3-NCB)
    // Hard port: Gen2 == Gen3 (NCB og ELF). Gen0 == Gen2 (og Gen1 ELF == Gen2 ELF) er
    // hard når Gen0 er laga i kjelde-modus (sjå gen0_drift_er_feil). Elles er det [MERK]:
    // den innebygde kompilatoren i ein C-æra-seed kan vere eldre enn kjelda.
    // Merk: når Gen0 NCB == Gen2 NCB, er inputen til Gen3 byte-lik inputen til Gen2, og
    // Gen2 == Gen3 held då av determinisme. Tredje generasjon gjev berre ny informasjon
    // når Gen0 != Gen2. Diskrimineringa er samanliknaren (lengd + SHA-256) og
    // feilinjeksjonsprobane (NORSCODE_OMGANG6B_TEST_FEILINJEKSJON).
    la gen1_ncb = root + "/build/6b/compiler_stage0.ncb.json"
    la base = root + "/build/6b/selfcompile"
    la gen1_elf = base + "/gen1_compiler.elf"
    la source_executor_ncb = base + "/gen1_source_executor.ncb.json"
    la source_executor_elf = base + "/gen1_source_executor.elf"
    la gen2_ncb = base + "/gen2.ncb.json"
    la gen2_elf = base + "/gen2_compiler.elf"
    la gen2_source_executor_ncb = base + "/gen2_source_executor.ncb.json"
    la gen2_source_executor_elf = base + "/gen2_source_executor.elf"
    la gen3_ncb = base + "/gen3.ncb.json"
    la gen3_elf = base + "/gen3_compiler.elf"
    la gen1_log = base + "/gen1_elf_bundle.log"
    la preset_log = base + "/gen1_elf_preset.log"
    la gen2_log = base + "/gen2_elf_source.log"
    la attempts = base + "/gen1_elf_attempts.txt"
    la pass_marker = base + "/stage0_elf_passed.marker"

    hvis ikkje filops.lag_katalogar(base) { returner 1 }
    filops.slett_fil(pass_marker)
    filops.slett_fil(gen1_log)
    filops.slett_fil(preset_log)
    filops.slett_fil(gen2_log)
    filops.slett_fil(base + "/gen1_elf_source_ncb.log")
    filops.slett_fil(base + "/gen1_elf_chunked_source_ncb.log")
    filops.slett_fil(base + "/gen1_elf_diagnose.txt")
    filops.slett_fil(attempts)

    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        hvis ikkje run_nc(root, ["fetch-stage0-seed"], 300000) { returner 1 }
    }

    linje("=== Omgang 6b.3: stage-0 ELF sjølvkompilering (tre generasjonar) ===")
    linje("")
    linje("[0/5] Gen0: kompilatorfragment frå kjelde med seeden...")
    la gen0_dir = lag_gen0_fragment(root)
    hvis gen0_dir == "" { returner 1 }
    la g0_modus = gen0_modus(gen0_dir)
    la g0_hard = gen0_drift_er_feil(g0_modus)
    la g0_modus_tekst = g0_modus
    hvis g0_modus_tekst == "" { g0_modus_tekst = "ukjend (ekstern katalog)" }
    hvis g0_hard { linje("  [OK] Gen0-modus: " + g0_modus_tekst + "; Gen0 == Gen2 er ein hard port") }
    ellers { linje("  [OK] Gen0-modus: " + g0_modus_tekst + "; Gen0 == Gen2 er berre [MERK]") }
    linje("")
    linje("[1/5] Gen1: Gen0 NCB + Gen1 ELF = ELF(Gen0) (host)...")
    hvis ikkje build_omgang6b_ncb_frå(root, gen1_ncb, gen0_dir) { returner 1 }
    hvis ikkje ncb_to_elf(root, gen1_ncb, gen1_elf) { returner 1 }
    hvis ikkje bygg_gen1_source_executor(root, gen1_ncb,
                                         source_executor_ncb,
                                         source_executor_elf) { returner 1 }
    la b1 = bytes(gen1_elf)
    linje("  [OK] Gen1 ELF " + b1 + " bytes")
    linje("")

    hvis os != "Linux" eller (arch != "x86_64" og arch != "amd64") {
        linje("[2–5/5] Hopp over ELF→ELF (" + os + "/" + arch + " — krev Linux x86-64)")
        linje("")
        linje("=== Omgang 6b.3: DELVIS (host Gen1 bygd frå Gen0) ===")
        returner 0
    }
    hvis env("NC_OM6B_RUN_STAGE0") != "1" {
        linje("[2–5/5] Hopp over ELF→ELF runtime (set NC_OM6B_RUN_STAGE0=1 for djup smoke)")
        linje("")
        linje("=== Omgang 6b.3: DELVIS (Gen1 ELF bygd frå Gen0) ===")
        returner 0
    }

    linje("[2/5] Gen2 = Gen1(kjelde): kjelder kompilerte isolert av Gen1...")
    la source_bundle = base + "/source_only_gen2.ncb.json"
    hvis ikkje bygg_source_only_gen2(root, source_executor_ncb,
                                     source_bundle, base + "/source_only") { returner 1 }
    hvis ikkje materialiser_frå_kjelde(root, base, "Gen1 ELF", gen1_elf, source_bundle,
                                       gen2_ncb, preset_log, gen1_log, attempts, os, arch) { returner 1 }
    feilinjeksjon("gen0", gen1_ncb)
    la n1 = bytes(gen1_ncb)
    la n2 = bytes(gen2_ncb)
    linje("  [OK] Gen2 NCB " + n2 + " bytes (Gen0 NCB " + n1 + " bytes)")
    hvis filer_identiske(gen1_ncb, gen2_ncb) { linje("  [OK] Gen0 NCB == Gen2 NCB (VM-referansen og native Gen1 er samde)") }
    ellers hvis g0_hard {
        linje("  [FEIL] Gen0 NCB != Gen2 NCB (gen0=" + n1 + ", gen2=" + n2 + " bytes). " + gen0_opphav(g0_modus) +
              ", så avviket er ein semantisk feil i VM- eller native-vegen")
        skriv(første_forskjellar(gen1_ncb, gen2_ncb, 5))
        linje("  [HINT] Er seed-VM-en kjend eldre enn kjelda: NORSCODE_OMGANG6B_TOLERER_GEN0_DRIFT=1 (då avgjer Gen2 == Gen3 åleine)")
        returner 1
    } ellers { linje("  [MERK] Gen0 NCB != Gen2 NCB (" + gen0_opphav(g0_modus) + ") — Gen3 avgjer") }
    linje("")

    linje("[3/5] Gen2 ELF = ELF(Gen2 NCB) (native codegen)...")
    hvis ikkje ncb_to_elf(root, gen2_ncb, gen2_elf) { returner 1 }
    la b2 = bytes(gen2_elf)
    linje("  [OK] Gen2 ELF " + b2 + " bytes")
    hvis filer_identiske(gen1_elf, gen2_elf) { linje("  [OK] Gen1 ELF == Gen2 ELF (" + b1 + " bytes)") }
    ellers hvis g0_hard {
        linje("  [FEIL] Gen1 ELF != Gen2 ELF (gen1=" + b1 + ", gen2=" + b2 + " bytes), men Gen0 i kjelde-modus krev lik ELF")
        skriv(første_forskjellar(gen1_elf, gen2_elf, 5))
        returner 1
    } ellers { linje("  [MERK] Gen1 ELF != Gen2 ELF (gen1=" + b1 + ", gen2=" + b2 + " bytes) — Gen3 avgjer") }
    linje("")

    linje("[4/5] Gen3 = ELF(Gen2)(kjelde): kjelder kompilerte isolert av Gen2...")
    hvis ikkje bygg_gen1_source_executor(root, gen2_ncb,
                                         gen2_source_executor_ncb,
                                         gen2_source_executor_elf) { returner 1 }
    la source_bundle3 = base + "/source_only_gen3.ncb.json"
    hvis ikkje bygg_source_only_gen2(root, gen2_source_executor_ncb,
                                     source_bundle3, base + "/source_only_gen3") { returner 1 }
    hvis ikkje materialiser_frå_kjelde(root, base, "Gen2 ELF", gen2_elf, source_bundle3,
                                       gen3_ncb, gen2_log, gen1_log, attempts, os, arch) { returner 1 }
    hvis ikkje ncb_to_elf(root, gen3_ncb, gen3_elf) { returner 1 }
    feilinjeksjon("gen3", gen3_ncb)
    la n3 = bytes(gen3_ncb)
    la b3 = bytes(gen3_elf)
    linje("  [OK] Gen3 NCB " + n3 + " bytes, Gen3 ELF " + b3 + " bytes")
    linje("")

    linje("[5/5] Fikspunkt: Gen2 == Gen3 (NCB og ELF)...")
    la ncb_lik = filer_identiske(gen2_ncb, gen3_ncb)
    la elf_lik = filer_identiske(gen2_elf, gen3_elf)
    hvis ncb_lik { linje("  [OK] Gen2 NCB == Gen3 NCB (" + n2 + " bytes, sha256 " + sha256_for(gen2_ncb) + ")") }
    ellers {
        linje("  [FEIL] Gen2 NCB != Gen3 NCB (gen2=" + n2 + ", gen3=" + n3 + " bytes)")
        skriv(første_forskjellar(gen2_ncb, gen3_ncb, 5))
    }
    hvis elf_lik { linje("  [OK] Gen2 ELF == Gen3 ELF (" + b2 + " bytes, sha256 " + sha256_for(gen2_elf) + ")") }
    ellers {
        linje("  [FEIL] Gen2 ELF != Gen3 ELF (gen2=" + b2 + ", gen3=" + b3 + " bytes)")
        skriv(første_forskjellar(gen2_elf, gen3_elf, 5))
    }
    hvis ikkje ncb_lik eller ikkje elf_lik { returner 1 }
    hvis ikkje skriv_fil_trygt(pass_marker, "gen2==gen3\n") { returner 1 }
    linje("=== Omgang 6b.3: BESTÅTT (fikspunkt Gen2 == Gen3 frå kjelde, ingen committa fragment) ===")
    returner 0
}

funksjon start() -> heiltall { returner main() }
