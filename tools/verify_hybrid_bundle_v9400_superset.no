// tools/verify_hybrid_bundle_v9400_superset.no — legacy (v9400, J3)
//
// Erstattar tests/test_hybrid_compiler_bundle_repro.no (sletta i J1b saman med
// den committa bootstrap/precompiled). Den committa
// build/v9400/hybrid_compiler_bundle_v9400.ncb.json er kompilatoren til
// C-æra-macOS-seeden fram til J3. Porten byggjer hybridbunten på nytt frå den
// GENERERTE L5-cachen (tools/materialize_l5_precompiled.no) og krev same entry,
// at kvar funksjon i den committa bunten finst i den nybygde (superset), og dei
// to kjernefunksjonane. Køyrd av tools/selfcompile_l5b.no i cache-på-modus
// (selvstendighet 7a). Blir sletta saman med v9400 i J3.
//
// Miljø:
//   NORSCODE_HYBRID_PRECOMPILED_DIR  (påkravd) generert cachekatalog
//   NORSCODE_HYBRID_V9400_EXPECTED   (valfri) bunten det blir samanlikna mot
//   NORSCODE_HYBRID_BUNDLE_OUT       (valfri) kvar den nybygde bunten blir skriven

bruk tools.build_hybrid_compiler_bundle_v9400 som builder

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la katalog = env("NORSCODE_HYBRID_PRECOMPILED_DIR")
    hvis katalog == "" {
        linje("FEIL: NORSCODE_HYBRID_PRECOMPILED_DIR må peike på ein generert cachekatalog (tools/materialize_l5_precompiled.no)")
        returner 2
    }
    la expected_sti = env("NORSCODE_HYBRID_V9400_EXPECTED")
    hvis expected_sti == "" { expected_sti = root + "/build/v9400/hybrid_compiler_bundle_v9400.ncb.json" }
    la out = env("NORSCODE_HYBRID_BUNDLE_OUT")
    hvis out == "" { out = root + "/build/l5/hybrid_v9400_repro.ncb.json" }
    hvis builder.bygg(root, out, katalog + "/ir_to_bytecode.ncb.json") != 0 {
        linje("FEIL: hybridbunten kunne ikkje byggjast frå " + katalog)
        returner 1
    }
    la expected = builtin.json_parse_raw(builtin.fil_les(expected_sti))
    la actual = builtin.json_parse_raw(builtin.fil_les(out))
    la feil: heiltall = 0
    hvis tekst(actual["entry"]) != tekst(expected["entry"]) {
        linje("FEIL: entry " + tekst(actual["entry"]) + " != " + tekst(expected["entry"]))
        feil = feil + 1
    }
    la fns = actual["functions"]
    la ek = nøkler(expected["functions"])
    la manglar: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(ek) {
        hvis ikkje har_nokkel(fns, ek[i]) {
            manglar = manglar + 1
            hvis manglar <= 20 { linje("FEIL: manglar " + ek[i]) }
        }
        i = i + 1
    }
    feil = feil + manglar
    hvis ikkje har_nokkel(fns, "fresh.kompiler.kompiler_fil") {
        linje("FEIL: manglar fresh.kompiler.kompiler_fil")
        feil = feil + 1
    }
    hvis ikkje har_nokkel(fns, "fresh.ir.emit_uttrykk") {
        linje("FEIL: manglar fresh.ir.emit_uttrykk")
        feil = feil + 1
    }
    hvis feil != 0 {
        linje("hybrid-v9400-superset FEIL (" + tekst_fra_heltall(feil) + " feil, " + tekst_fra_heltall(manglar) + " manglande funksjonar)")
        returner 1
    }
    linje("hybrid-v9400-superset OK (" + tekst_fra_heltall(lengde(fns)) + " >= " + tekst_fra_heltall(lengde(ek)) + " funksjonar)")
    returner 0
}
