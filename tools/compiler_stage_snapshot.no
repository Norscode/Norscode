// Prosessfri kompilator-snapshot.

bruk std.liste som liste
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon sha256_for(sti: tekst) -> tekst {
    prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon hash_liste(root: tekst) -> tekst {
    la filer = filops.walk(root)
    liste.sorter_tekst(filer)
    la body = ""
    la i = 0
    mens i < lengde(filer) {
        la fil = filer[i]
        body = body + sha256_for(fil) + "  " + filops.relativ_sti(root, fil) + "\n"
        i = i + 1
    }
    returner body
}

funksjon lag_snapshot(root: tekst, output_dir: tekst) -> tekst {
    hvis ikkje filops.lag_katalogar(output_dir) { returner "" }
    la snapshot_dir = output_dir + "/snapshot_" + tekst_fra_heltall(builtin.tid_ms())
    hvis ikkje filops.lag_katalogar(snapshot_dir) { returner "" }
    la kandidatar = ["build/compiler_stage1", "build/compiler_stage2", "reports/bootstrap_diff_report.txt"]
    la i = 0
    mens i < lengde(kandidatar) {
        la kjelde = root + "/" + kandidatar[i]
        hvis filops.katalog_finnes(kjelde) {
            hvis ikkje filops.kopier_tre(kjelde, snapshot_dir + "/" + filops.filnamn(kjelde)) { returner "" }
        } ellers hvis builtin.fil_finnes(kjelde) {
            hvis ikkje filops.kopier2(kjelde, snapshot_dir + "/" + filops.filnamn(kjelde)) { returner "" }
        }
        i = i + 1
    }
    la body = "=== Compiler Snapshot Hashes ===\n\n" + hash_liste(snapshot_dir)
    builtin.fil_skriv(snapshot_dir + "/hashes.txt", body)
    returner snapshot_dir
}

funksjon start() -> heiltall {
    la root = "."
    prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) {}
    linje("Creating compiler stage snapshot...")
    la snapshot = lag_snapshot(root, root + "/reports/compiler_snapshots")
    hvis snapshot == "" { returner 1 }
    linje("Compiler snapshot created at: " + snapshot)
    returner 0
}
