// tools/os_pakk.no — pakkar eit Norscode linux-x86_64 AOT-ELF (GC-modus) til eit
// Norscode OS-bilete med den Norscode-emitterte trampolinen (os/boot/trampoline.no).
//
//   OS_ELF=build/os/k.elf OS_BILETE=build/os/k.img OS_MODUS=demand ./bin/nc run tools/os_pakk.no
//
// Skriv layouten som «nøkkel=verdi»-linjer. os/boot/byggjar.no køyrer dette som eigen
// prosess med NORSCODE_VM_FAST=1: pakkinga er tusenvis av små liste-operasjonar, og i ein
// VM-prosess med mange importerte modular og utan fast-modus tok ho 80+ s mot ~1 s her.

bruk os.boot.trampoline som tramp

funksjon miljø(namn: tekst) -> tekst {
    prøv { returner tekst(miljo_hent(namn)) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la elf_sti = miljø("OS_ELF")
    la bilete = miljø("OS_BILETE")
    la modus = miljø("OS_MODUS")
    hvis modus == "" { modus = "demand" }
    hvis elf_sti == "" eller bilete == "" {
        skriv("bruk: OS_ELF=<elf> OS_BILETE=<img> [OS_MODUS=demand|ivrig] nc run tools/os_pakk.no\n")
        returner 2
    }
    la info = tramp.bygg(builtin.fil_les_binær(elf_sti), modus, bilete)
    for k i nøkler(info) { skriv(k + "=" + tekst(info[k]) + "\n") }
    returner 0
}
