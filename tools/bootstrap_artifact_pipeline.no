// Prosessfri innsamling av bootstrap-artefaktar.

bruk std.liste som liste
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon sha256_for(sti: tekst) -> tekst {
    prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon hash_liste(root: tekst, filer: liste_tekst) -> tekst {
    la body = ""
    la i = 0
    mens i < lengde(filer) {
        la fil = filer[i]
        body = body + sha256_for(fil) + "  " + filops.relativ_sti(root, fil) + "\n"
        i = i + 1
    }
    returner body
}

funksjon samle_ein(kjelde: tekst, run_dir: tekst) -> bool {
    la mål = run_dir + "/" + filops.filnamn(kjelde)
    hvis filops.katalog_finnes(kjelde) { returner filops.kopier_tre(kjelde, mål) }
    hvis builtin.fil_finnes(kjelde) { returner filops.kopier2(kjelde, mål) }
    returner sann
}

funksjon samle(root: tekst, artifact_dir: tekst) -> tekst {
    hvis ikkje filops.lag_katalogar(artifact_dir) { returner "" }
    la run_dir = artifact_dir + "/run_" + tekst_fra_heltall(builtin.tid_ms())
    hvis ikkje filops.lag_katalogar(run_dir) { returner "" }

    la kandidatar = [
        "reports/bootstrap_diff_report.txt",
        "reports/semantic_diff_report.txt",
        "reports/backend_ordering_report.txt",
        "reports/compiler_snapshot_compare_report.txt",
        "reports/compiler_snapshots",
        "build/compiler_stage1",
        "build/compiler_stage2",
        "build/compiler_stage3"
    ]
    la i = 0
    mens i < lengde(kandidatar) {
        hvis ikkje samle_ein(root + "/" + kandidatar[i], run_dir) { returner "" }
        i = i + 1
    }

    la filer = filops.walk(run_dir)
    liste.sorter_tekst(filer)
    la inventar = ""
    i = 0
    mens i < lengde(filer) {
        inventar = inventar + filops.relativ_sti(run_dir, filer[i]) + "\n"
        i = i + 1
    }
    la body = "=== Bootstrap Artifact Inventory ===\n\n" +
        inventar +
        "\n=== Artifact Hashes ===\n\n" +
        hash_liste(run_dir, filer)
    builtin.fil_skriv(run_dir + "/artifact_manifest.txt", body)
    returner run_dir
}

funksjon start() -> heiltall {
    la root = "."
    prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) {}
    linje("Collecting bootstrap artifacts...")
    la run_dir = samle(root, root + "/reports/bootstrap_artifacts")
    hvis run_dir == "" { returner 1 }
    linje("Bootstrap artifact pipeline completed")
    linje("Artifacts stored in: " + run_dir)
    returner 0
}
