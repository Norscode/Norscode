// tools/run_runtime_phase3_v3900.no — shellfrie fase-3 runtime-probar

bruk std.filops som filops
bruk std.prosess som system_prosess
bruk std.tid som tid
bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon runtime_miljø(root: tekst, fil: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write,net.tcp",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": fil,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1"
    }
}

funksjon køyr_runtime(bin_path: tekst, root: tekst, fil: tekst,
                       ekstra: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la miljø = runtime_miljø(root, fil)
    hvis finnes_nøkkel(ekstra, "NORSCODE_NATIVE_GAP_BIN") {
        miljø["NORSCODE_NATIVE_GAP_BIN"] = tekst(ekstra["NORSCODE_NATIVE_GAP_BIN"])
    }
    returner prosess.køyr(bin_path, [], root, miljø, timeout_ms)
}

funksjon start_async(executable: tekst, args: liste_tekst, cwd: tekst,
                      miljø: ordbok_tekst, timeout_sek: heiltall) -> ordbok_tekst {
    la policy = system_prosess.ny_policy("runtime-phase3-async")
    system_prosess.tillat_alle(policy)
    system_prosess.aktiver_køyring(policy)
    la plan = system_prosess.start_argv_plan(executable, args)
    system_prosess.med_cwd(plan, cwd)
    system_prosess.med_miljø(plan, miljø)
    system_prosess.med_timeout(plan, timeout_sek)
    system_prosess.med_maks_output(plan, 16777216)
    system_prosess.med_sandbox(plan, "none", 4294967296, 256, sann)
    returner system_prosess.start_argv_async_trygt(policy, plan)
}

funksjon skriv_async_og_lukk(handle: ordbok_tekst, wait_ms: heiltall) -> boolsk {
    la ferdig = system_prosess.native_async_vent(handle, wait_ms)
    la output = system_prosess.native_async_les(handle)
    hvis finnes_nøkkel(output, "stdout") og tekst(output["stdout"]) != "" { skriv(tekst(output["stdout"])) }
    hvis finnes_nøkkel(output, "stderr") og tekst(output["stderr"]) != "" { skriv(tekst(output["stderr"])) }
    system_prosess.native_async_lukk(handle)
    returner tekst(ferdig["status"]) == "ferdig" og heiltall_fra_tekst(tekst(ferdig["exit_code"])) == 0
}

funksjon stans_async(handle: ordbok_tekst) -> heiltall {
    hvis finnes_nøkkel(handle, "handle") {
        system_prosess.native_async_signal(handle, 15)
        system_prosess.native_async_vent(handle, 5000)
        system_prosess.native_async_lukk(handle)
    }
    returner 0
}

funksjon run_socket_probe_host(root: tekst, bin_path: tekst, label: tekst) -> boolsk {
    la probe = root + "/tests/socket_runtime_probe_v3900.no"
    la klient = root + "/tools/socket_ping_v3900.no"
    la server = start_async(bin_path, [], root, runtime_miljø(root, probe), 20)
    hvis tekst(server["status"]) != "kjorer" {
        linje("[FAIL] " + label + ": kunne ikkje starte socket-server")
        returner usann
    }
    tid.sov(1000)
    la client = køyr_runtime(bin_path, root, klient, {}, 10000)
    hvis ikkje prosess.ok(client) {
        linje("[FAIL] " + label + ": Norscode socket-klient feila")
        prosess.skriv_resultat(client)
        stans_async(server)
        returner usann
    }
    la reply = builtin.trim(tekst(client["stdout"]))
    hvis ikkje skriv_async_og_lukk(server, 10000) { returner usann }
    hvis reply != "pong:ping" {
        linje("[FAIL] " + label + ": venta pong:ping, fekk " + reply)
        returner usann
    }
    linje("[OK] " + label + " socket roundtrip: " + reply)
    returner sann
}

funksjon container_env_args(root: tekst, fil: tekst) -> liste_tekst {
    returner [
        "env",
        "NORSCODE_ROOT=/work",
        "NORSCODE_VM_CAPABILITIES=env.read,process.exec,disk.read,disk.write,net.tcp",
        "NORSCODE_VM_DISK_ROOT=/work,.,/tmp",
        "NORSCODE_CMD=run",
        "NORSCODE_FILE=" + fil,
        "NORSCODE_ENABLE_EXEC_PROSESS=1",
        "/work/bootstrap/stage0/norscode-linux-x86_64"
    ]
}

funksjon run_linux_runtime_gap(docker: tekst, root: tekst, container: tekst) -> boolsk {
    la args: liste_tekst = [
        "env",
        "NORSCODE_ROOT=/work",
        "NORSCODE_VM_CAPABILITIES=env.read,process.exec,disk.read,disk.write,net.tcp",
        "NORSCODE_VM_DISK_ROOT=/work,.,/tmp",
        "NORSCODE_CMD=run",
        "NORSCODE_FILE=/work/tools/native_runtime_gap_gate_v3001.no",
        "NORSCODE_ENABLE_EXEC_PROSESS=1",
        "NORSCODE_NATIVE_GAP_BIN=/work/bootstrap/stage0/norscode-linux-x86_64",
        "/work/bootstrap/stage0/norscode-linux-x86_64"
    ]
    la resultat = docker_runner.køyr_i(docker, root, container, args, 300000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon run_linux_socket(docker: tekst, root: tekst, container: tekst) -> boolsk {
    la server_args: liste_tekst = ["exec", container]
    la server_inner = container_env_args(root, "/work/tests/socket_runtime_probe_v3900.no")
    la i = 0
    mens i < lengde(server_inner) { legg_til(server_args, server_inner[i]) i = i + 1 }
    la server = start_async(docker, server_args, root, {}, 30)
    hvis tekst(server["status"]) != "kjorer" {
        linje("[FAIL] linux_stage0: kunne ikkje starte socket-server")
        returner usann
    }
    tid.sov(1000)
    la client = docker_runner.køyr_i(docker, root, container,
        container_env_args(root, "/work/tools/socket_ping_v3900.no"), 15000)
    hvis ikkje prosess.ok(client) {
        prosess.skriv_resultat(client)
        stans_async(server)
        returner usann
    }
    la reply = builtin.trim(tekst(client["stdout"]))
    hvis ikkje skriv_async_og_lukk(server, 15000) { returner usann }
    hvis reply != "pong:ping" {
        linje("[FAIL] linux_stage0: venta pong:ping, fekk " + reply)
        returner usann
    }
    linje("[OK] linux_stage0 socket roundtrip: " + reply)
    returner sann
}

funksjon run_linux_probes(root: tekst) -> tekst {
    la docker = docker_runner.finn()
    hvis ikkje docker_runner.tilgjengeleg(docker, root) {
        linje("[SKIP] Docker er ikkje tilgjengeleg, så Linux-probar vart ikkje køyrde.")
        returner "skip"
    }
    la container = docker_runner.opprett_ubuntu(docker, root, root, "linux/amd64", "runtime-phase3-v3900")
    hvis container == "" eller ikkje docker_runner.start(docker, root, container) { returner "fail" }
    hvis ikkje docker_runner.installer_pakkar(docker, root, container, ["file", "perl", "libsqlite3-0"]) {
        docker_runner.fjern(docker, root, container)
        returner "fail"
    }
    linje("")
    linje("[3/4] Linux x86_64 stage0 runtime-gap (Docker)")
    hvis ikkje run_linux_runtime_gap(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner "fail"
    }
    linje("")
    linje("[4/4] Linux x86_64 stage0 socket probe (Docker)")
    la socket_ok = run_linux_socket(docker, root, container)
    docker_runner.fjern(docker, root, container)
    hvis socket_ok { returner "green" }
    linje("[WARN] Linux socket probe feila.")
    returner "pending"
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    hvis ikkje filops.lag_katalogar(root + "/build/v3900") { returner 1 }
    la bin_path = root + "/dist/norscode_native"
    la socket_status = "green"

    linje("== v3900 runtime phase 3 ==")
    linje("")
    linje("[1/4] macOS active dist runtime-gap")
    la gap = køyr_runtime(bin_path, root, root + "/tools/native_runtime_gap_gate_v3001.no",
        {"NORSCODE_NATIVE_GAP_BIN": bin_path}, 180000)
    prosess.skriv_resultat(gap)
    hvis ikkje prosess.ok(gap) { returner 1 }

    linje("")
    linje("[2/4] macOS active dist socket probe")
    hvis ikkje run_socket_probe_host(root, bin_path, "macos_dist") {
        socket_status = "pending"
        linje("[WARN] macOS socket probe feila.")
    }

    la linux_status = run_linux_probes(root)
    hvis linux_status == "fail" { returner 1 }
    hvis linux_status == "pending" { socket_status = "pending" }
    linje("")
    linje("[INFO] socket_status=" + socket_status)
    linje("")
    linje("[OK] v3900 runtime phase 3 probes ferdige.")
    returner 0
}
