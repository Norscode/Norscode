// tools/norscode_feature_gate.no — shellfri funksjonsport utan C/Python

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon executable(sti: tekst) -> bool { returner fil_finnes(sti) }

funksjon sluttar_med(t: tekst, ending: tekst) -> bool { returner ends_with(t, ending) }

funksjon køyr_nc(root: tekst, argv: liste_tekst) -> bool {
    la res = prosess.køyr(root + "/bin/nc", argv, root, {}, 3600000)
    hvis prosess.ok(res) { returner sann }
    prosess.skriv_resultat(res)
    returner usann
}

funksjon feature_filer() -> liste_tekst {
    la rå = split(env("NORSCODE_FEATURE_FILES"), "\n")
    la filer: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(rå) {
        la f = trim(rå[i])
        hvis f != "" { legg_til(filer, f) }
        i = i + 1
    }
    returner filer
}

funksjon sjekk_fil(root: tekst, fil: tekst) -> bool {
    hvis sluttar_med(fil, ".no") {
        hvis køyr_nc(root, ["check", fil]) {
            linje("  [OK] " + fil)
            returner sann
        }
        linje("  [FEIL] " + fil)
        returner usann
    }
    linje("  [HOPP] " + fil + " (ikkje .no)")
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    hvis ikkje executable(root + "/dist/norscode_native") {
        linje("Feil: treng dist/norscode_native. Køyr: ./bin/nc fetch-stage0-seed")
        returner 1
    }

    linje("=== Norscode feature-check (utan C/Python) ===")
    linje("")
    linje("1. Policyflate...")
    hvis ikkje køyr_nc(root, ["active-surface"]) { returner 1 }
    linje("  [OK] ingen aktiv C/Python-flate")
    linje("")
    linje("2. Seed/runtime...")
    hvis ikkje køyr_nc(root, ["verify-seed"]) { returner 1 }
    linje("  [OK] stage-0 seed og runtime")
    linje("")

    la filer = feature_filer()
    hvis lengde(filer) > 0 {
        linje("3. Sjekkar oppgitte Norscode-filer...")
        la i: heiltall = 0
        mens i < lengde(filer) {
            hvis ikkje sjekk_fil(root, filer[i]) { returner 1 }
            i = i + 1
        }
    } ellers {
        linje("3. Ingen filer oppgitt; køyrer normal testflate...")
        hvis ikkje køyr_nc(root, ["test"]) { returner 1 }
    }

    linje("")
    linje("=== Feature-check: BESTÅTT ===")
    returner 0
}
