// tools/release_user_journey.no — pakka installasjon, oppgradering og rollback

bruk std.filops som filops
bruk tools.process_runner som runner

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon ok(res: liste_tekst) -> bool { returner lengde(res) > 0 og tekst(res[0]) == "0" }

// Kvart steg er ein strukturert argv-prosess (prosess-ABI, ingen shell).
// Release-pakking og installerte runtime-køyringar får 2 t per steg.
funksjon prosess(executable: tekst, argv: liste_tekst, cwd: tekst, miljø: ordbok_tekst) -> liste_tekst {
    la res = runner.køyr_liste(executable, argv, cwd, miljø, 7200000)
    hvis lengde(res) > 1 og tekst(res[1]) != "" { skriv(tekst(res[1])) }
    hvis lengde(res) > 2 og tekst(res[2]) != "" { skriv(tekst(res[2])) }
    returner res
}

funksjon feila(namn: tekst) -> bool {
    skriv("[FAIL] brukarferd: " + namn + "\n")
    returner usann
}

funksjon køyr(namn: tekst, executable: tekst, argv: liste_tekst, cwd: tekst, miljø: ordbok_tekst) -> bool {
    skriv("[JOURNEY] " + namn + "\n")
    hvis ok(prosess(executable, argv, cwd, miljø)) { returner sann }
    returner feila(namn)
}

funksjon gjer_køyrbar(namn: tekst, stiar: liste_tekst) -> bool {
    skriv("[JOURNEY] " + namn + "\n")
    la i = 0
    mens i < lengde(stiar) {
        la sett = usann
        prøv { sett = builtin.fil_sett_kjorbar(stiar[i]) } fang (e) { sett = usann }
        hvis ikkje sett { returner feila(namn) }
        i = i + 1
    }
    returner sann
}

// Installert CLI skal ikkje sjå repo-/vertsbindingar. Tom verdi = unset for
// Norscode-runtimen (tilsvarar `env -u` i den tidlegare shellforma).
funksjon installert_miljø(prefix: tekst, base: tekst, host_tmp: tekst) -> ordbok_tekst {
    la m: ordbok_tekst = {}
    la fjern = ["NORSCODE_NATIVE_BIN", "NORSCODE_VM_REQUESTED_POLICY",
                "NORSCODE_VM_REQUESTED_CAPABILITIES", "NORSCODE_VM_REQUESTED_DISK_ROOT",
                "NORSCODE_VM_TARGET_CAPABILITIES", "NORSCODE_VM_TARGET_DISK_ROOT",
                "NORSCODE_NCB_FILE", "NORSCODE_HOST_NCB_FILE"]
    la i = 0
    mens i < lengde(fjern) {
        m[fjern[i]] = ""
        i = i + 1
    }
    m["TMPDIR"] = "/tmp"
    m["NORSCODE_USE_PRECOMPILED_SELFHOST"] = "0"
    m["NORSCODE_PACKAGED_TEST_FALLBACK"] = "1"
    m["NORSCODE_ROOT"] = prefix
    m["NORSCODE_VM_CAPABILITIES"] = "env.read,process.exec,thread.spawn,net.tcp,net.http,net.dns,disk.read,disk.write"
    m["NORSCODE_VM_DISK_ROOT"] = prefix + "," + prefix + "/current," + base + "," + host_tmp + ",/tmp,/private/tmp,."
    returner m
}

funksjon installert_ncb_miljø(prefix: tekst, base: tekst, host_tmp: tekst, ncb: tekst) -> ordbok_tekst {
    la m = installert_miljø(prefix, base, host_tmp)
    m["NORSCODE_CMD"] = "run"
    m["NORSCODE_FILE"] = prefix + "/current/selfhost/tooling/ncb_host_run_entry.no"
    m["NORSCODE_HOST_NCB_FILE"] = ncb
    returner m
}

funksjon build_miljø(prefix: tekst, base: tekst) -> ordbok_tekst {
    la m: ordbok_tekst = {}
    m["TMPDIR"] = "/tmp"
    m["NORSCODE_ENABLE_EXEC_PROSESS"] = "1"
    m["NORSCODE_USE_PRECOMPILED_SELFHOST"] = "0"
    m["NORSCODE_VM_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
    m["NORSCODE_VM_DISK_ROOT"] = prefix + "/current," + base + ",/tmp,/private/tmp,."
    m["NORSCODE_ROOT"] = prefix + "/current"
    returner m
}

// Embedding the compiler/VM image materializes the native executable as
// one large byte buffer.  Keep the ordinary gate memory ceiling for the
// rest of the journey, but give this release-only operation an explicit
// bounded headroom on CI runners.
funksjon release_miljø() -> ordbok_tekst {
    la m: ordbok_tekst = {}
    la grense = env("NORSCODE_RELEASE_PROCESS_MAX_MEMORY_BYTES")
    hvis grense == "" {
        m["NORSCODE_PROCESS_MAX_MEMORY_BYTES"] = "3221225472"
    } ellers {
        m["NORSCODE_RELEASE_PACKAGE_SHELL"] = "1"
        m["NORSCODE_PROCESS_MAX_MEMORY_BYTES"] = grense
    }
    returner m
}

funksjon native_build(root: tekst, prefix: tekst, base: tekst, project: tekst) -> bool {
    la namn = "native build"
    skriv("[JOURNEY] " + namn + "\n")
    la runtime = prefix + "/dist/norscode_native"
    la kompiler = build_miljø(prefix, base)
    kompiler["NORSCODE_CMD"] = "compile"
    kompiler["NORSCODE_FILE"] = project + "/app.no"
    kompiler["NORSCODE_OUTPUT"] = base + "/project.ncb"
    hvis ikkje ok(prosess(runtime, [], root, kompiler)) { returner feila(namn) }
    la codegen = build_miljø(prefix, base)
    codegen["NORSCODE_CMD"] = "run"
    codegen["NORSCODE_FILE"] = prefix + "/current/selfhost/tooling/ncb_host_run_entry.no"
    codegen["NORSCODE_HOST_NCB_FILE"] = prefix + "/current/selfhost/native_execution/native_codegen_v2.ncb.json"
    codegen["NC_INPUT"] = base + "/project.ncb"
    codegen["NC_OUTPUT"] = base + "/app-native"
    // Codegen-steget kan returnere ikkje-null etter å ha skrive binæren; ein
    // ikkje-tom app-native tel som bygd (som `|| test -s` i den gamle forma).
    hvis ok(prosess(runtime, [], root, codegen)) { returner sann }
    hvis filops.fil_storleik(base + "/app-native") > 0 { returner sann }
    returner feila(namn)
}

// Ei oppgradering med øydelagd sjekksum MÅ avvisast. Den gamle shellforma
// (`… && ! install; cp …`) returnerte berre exit-koden til siste `cp`, så
// avvisinga vart aldri faktisk kravd; her er ho eit hardt krav.
funksjon avvis_øydelagd(root: tekst, prefix: tekst, base: tekst, archive_b: tekst) -> bool {
    la namn = "avvis øydelagd oppgradering"
    skriv("[JOURNEY] " + namn + "\n")
    la sha = archive_b + ".sha256"
    la god = base + "/good.sha256"
    hvis ikkje filops.kopier2(sha, god) { returner feila(namn) }
    prøv { builtin.fil_skriv(sha, "invalid\n") } fang (e) { returner feila(namn) }
    la res = prosess(root + "/bin/nc", ["install-release", archive_b, "--prefix", prefix], root, {})
    la gjenoppretta = filops.kopier2(god, sha)
    hvis ok(res) {
        skriv("[FAIL] install-release godtok ei oppgradering med øydelagd sjekksum\n")
        returner feila(namn)
    }
    hvis ikkje gjenoppretta { returner feila(namn) }
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la run_id = builtin.random_hex(8)
    la base = root + "/build/completion-journey-" + run_id
    la prefix = base + "/install"
    la project = base + "/project"
    la version_a = "completion-a-" + run_id
    la version_b = "completion-b-" + run_id
    la archive_a = root + "/release-artifacts/norscode-language-" + version_a + ".tar.gz"
    la archive_b = root + "/release-artifacts/norscode-language-" + version_b + ".tar.gz"
    la host_tmp = env("TMPDIR")
    hvis host_tmp == "" { host_tmp = "/tmp" }
    prøv { builtin.mkdir_p(base) } fang (e) { returner 1 }

    la nc = root + "/bin/nc"
    la installert_nc = prefix + "/bin/nc"
    la installert_rt = prefix + "/dist/norscode_native"

    hvis ikkje køyr("pakk versjon A", nc, ["package-release", version_a], root, release_miljø()) { returner 1 }
    hvis ikkje køyr("installer versjon A", nc, ["install-release", archive_a, "--prefix", prefix], root, {}) { returner 1 }
    hvis ikkje gjer_køyrbar("gjer installert CLI køyrbar", [installert_nc, installert_rt]) { returner 1 }
    prøv { builtin.fil_skriv(prefix + "/journey-data.txt", "bevar-meg\n") } fang (e) { returner 1 }
    hvis ikkje køyr("nytt prosjekt", installert_nc, ["startproject", project, "--name", "completion"], root,
                    installert_miljø(prefix, base, host_tmp)) { returner 1 }
    hvis ikkje køyr("check", installert_nc, ["check", project + "/app.no"], root,
                    installert_miljø(prefix, base, host_tmp)) { returner 1 }
    la prosjekttest = installert_miljø(prefix, base, host_tmp)
    prosjekttest["NORSCODE_CMD"] = "run"
    prosjekttest["NORSCODE_FILE"] = project + "/tests/test_app.no"
    hvis ikkje køyr("prosjekttest", installert_rt, [], root, prosjekttest) { returner 1 }
    hvis ikkje native_build(root, prefix, base, project) { returner 1 }
    hvis ikkje køyr("web/API", installert_rt, [], root,
                    installert_ncb_miljø(prefix, base, host_tmp, prefix + "/current/tests/test_web_routes.ncb.json")) { returner 1 }
    hvis ikkje køyr("NorsDB CRUD/transaksjon/recovery", installert_rt, [], root,
                    installert_ncb_miljø(prefix, base, host_tmp, prefix + "/current/tests/test_db.ncb.json")) { returner 1 }

    hvis ikkje køyr("pakk versjon B", nc, ["package-release", version_b], root, release_miljø()) { returner 1 }
    hvis ikkje køyr("oppgrader til versjon B", nc, ["install-release", archive_b, "--prefix", prefix], root, {}) { returner 1 }
    hvis ikkje avvis_øydelagd(root, prefix, base, archive_b) { returner 1 }
    hvis ikkje køyr("rollback til versjon A", nc, ["install-release", archive_a, "--prefix", prefix], root, {}) { returner 1 }
    prøv {
        hvis trim(builtin.fil_les(prefix + "/journey-data.txt")) != "bevar-meg" { returner 1 }
    } fang (e) { returner 1 }
    hvis ikkje gjer_køyrbar("runtime etter rollback: køyrbar CLI", [installert_nc, installert_rt]) { returner 1 }
    hvis ikkje køyr("runtime etter rollback", installert_rt, [], root,
                    installert_ncb_miljø(prefix, base, host_tmp, prefix + "/current/tests/test_db.ncb.json")) { returner 1 }
    skriv("[OK] pakka brukarferd med oppgradering og rollback\n")
    returner 0
}
