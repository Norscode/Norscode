// Typebevarande råtekst-overlay av éin funksjon mellom to NCB-kandidatar.
// Skriv alltid ei ny fil og promoterer aldri runtime eller stage0.

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon tel_tekst(src: tekst, needle: tekst) -> heiltall {
    hvis needle == "" { returner 0 }
    returner lengde(builtin.split(src, needle)) - 1
}

funksjon objekt_slutt(raw: tekst, start: heiltall) -> heiltall {
    la djupn: heiltall = 0
    la i_streng = usann
    la escape = usann
    la i = start
    mens i < lengde(raw) {
        la c = raw[i]
        hvis i_streng {
            hvis escape { escape = usann }
            ellers hvis c == "\\" { escape = sann }
            ellers hvis c == "\"" { i_streng = usann }
        } ellers hvis c == "\"" { i_streng = sann }
        ellers hvis c == "{" { djupn = djupn + 1 }
        ellers hvis c == "}" {
            djupn = djupn - 1
            hvis djupn == 0 { returner i }
        }
        i = i + 1
    }
    returner -1
}

funksjon start() -> heiltall {
    la base_sti = env("NC_OVERLAY_BASE")
    la kjelde_sti = env("NC_OVERLAY_SOURCE")
    la ut_sti = env("NC_OVERLAY_OUT")
    la base_fn = env("NC_OVERLAY_BASE_FUNCTION")
    la kjelde_fn = env("NC_OVERLAY_SOURCE_FUNCTION")
    la fra_modul = env("NC_OVERLAY_FROM_MODULE")
    la til_modul = env("NC_OVERLAY_TO_MODULE")
    hvis base_sti == "" eller kjelde_sti == "" eller ut_sti == "" eller
       base_fn == "" eller kjelde_fn == "" eller base_sti == ut_sti {
        linje("[FAIL] manglar NC_OVERLAY_BASE/SOURCE/OUT eller funksjonsnamn")
        returner 2
    }

    la base = ""
    la kjelde = ""
    prøv {
        base = builtin.fil_les(base_sti)
        kjelde = builtin.fil_les(kjelde_sti)
    } fang (e) {
        linje("[FAIL] kan ikkje lese overlay-kandidatane")
        returner 1
    }

    la base_markor = "\"" + base_fn + "\":{"
    la kjelde_markor = "\"" + kjelde_fn + "\":{"
    hvis tel_tekst(base, base_markor) != 1 eller tel_tekst(kjelde, kjelde_markor) != 1 {
        linje("[FAIL] funksjonsmarkør må finnast nøyaktig ein gong i kvar NCB")
        returner 1
    }
    la base_pos = builtin.index_of(base, base_markor)
    la kjelde_pos = builtin.index_of(kjelde, kjelde_markor)
    la base_obj_start = base_pos + lengde(base_markor) - 1
    la kjelde_obj_start = kjelde_pos + lengde(kjelde_markor) - 1
    la base_obj_slutt = objekt_slutt(base, base_obj_start)
    la kjelde_obj_slutt = objekt_slutt(kjelde, kjelde_obj_start)
    hvis base_obj_slutt < base_obj_start eller kjelde_obj_slutt < kjelde_obj_start {
        linje("[FAIL] ubalansert funksjonsobjekt")
        returner 1
    }

    la definisjon = builtin.slice(kjelde, kjelde_obj_start, kjelde_obj_slutt + 1)
    hvis fra_modul != "" og til_modul != "" {
        definisjon = builtin.replace(definisjon, "\"" + fra_modul + ".", "\"" + til_modul + ".")
        definisjon = builtin.replace(definisjon,
            "\"module\":\"" + fra_modul + "\"",
            "\"module\":\"" + til_modul + "\"")
    }

    la prefiks = builtin.slice(base, 0, base_obj_start)
    la suffiks = builtin.slice(base, base_obj_slutt + 1, lengde(base))
    la resultat = prefiks + definisjon + suffiks
    hvis tel_tekst(resultat, base_markor) != 1 {
        linje("[FAIL] basefunksjonen vart ikkje bevart nøyaktig ein gong")
        returner 1
    }
    hvis lengde(resultat) <= 0 eller resultat[0] != "{" eller
       resultat[lengde(resultat) - 1] != "}" {
        linje("[FAIL] overlay-resultatet har ugyldig toppnivågrense")
        returner 1
    }

    builtin.fil_skriv(ut_sti, resultat)
    linje("[OK] råtekst-overlay: " + kjelde_fn + " -> " + base_fn)
    linje("[OK] skreiv kandidat utan promotering: " + ut_sti)
    returner 0
}
