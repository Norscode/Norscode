// Typebevarande råtekst-overlay av éin funksjon mellom to NCB-kandidatar.
// Skriv alltid ei ny fil og promoterer aldri runtime eller stage0.

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon tel_tekst(src: tekst, needle: tekst) -> heiltall {
    hvis needle == "" { returner 0 }
    returner lengde(builtin.split(src, needle)) - 1
}

funksjon har_tekst(verdiar, verdi: tekst) -> boolsk {
    la i = 0
    mens i < lengde(verdiar) {
        hvis tekst(verdiar[i]) == verdi { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon kallmål(fn) {
    la resultat = []
    la code = fn["code"]
    la i = 0
    mens i < lengde(code) {
        la ins = code[i]
        hvis lengde(ins) > 1 og ins[0] == "CALL" {
            la mål = tekst(ins[1])
            hvis ikkje har_tekst(resultat, mål) { legg_til(resultat, mål) }
        }
        i = i + 1
    }
    returner resultat
}

funksjon objekt_slutt(raw: tekst, start: heiltall) -> heiltall {
    la djupn: heiltall = 0
    la i_streng = usann
    la escape = usann
    la i = start
    mens i < lengde(raw) {
        la c = raw[i]
        hvis i_streng {
            hvis escape { escape = usann }
            ellers hvis c == "\\" { escape = sann }
            ellers hvis c == "\"" { i_streng = usann }
        } ellers hvis c == "\"" { i_streng = sann }
        ellers hvis c == "{" { djupn = djupn + 1 }
        ellers hvis c == "}" {
            djupn = djupn - 1
            hvis djupn == 0 { returner i }
        }
        i = i + 1
    }
    returner -1
}

funksjon start() -> heiltall {
    la base_sti = env("NC_OVERLAY_BASE")
    la kjelde_sti = env("NC_OVERLAY_SOURCE")
    la ut_sti = env("NC_OVERLAY_OUT")
    la base_fn = env("NC_OVERLAY_BASE_FUNCTION")
    la kjelde_fn = env("NC_OVERLAY_SOURCE_FUNCTION")
    la fra_modul = env("NC_OVERLAY_FROM_MODULE")
    la til_modul = env("NC_OVERLAY_TO_MODULE")
    la kall_fra = env("NC_OVERLAY_CALL_FROM")
    la kall_til = env("NC_OVERLAY_CALL_TO")
    la legg_til_fn = env("NC_OVERLAY_ADD_FUNCTION") == "1"
    la normaliser_kall = env("NC_OVERLAY_NORMALIZE_CALLS") == "1"
    la rå_kallmapping = env("NC_OVERLAY_RAW_CALL_MAPPING") == "1"
    hvis base_sti == "" eller kjelde_sti == "" eller ut_sti == "" eller
       base_fn == "" eller kjelde_fn == "" eller base_sti == ut_sti {
        linje("[FAIL] manglar NC_OVERLAY_BASE/SOURCE/OUT eller funksjonsnamn")
        returner 2
    }

    la base = ""
    la kjelde = ""
    prøv {
        base = builtin.fil_les(base_sti)
        kjelde = builtin.fil_les(kjelde_sti)
    } fang (e) {
        linje("[FAIL] kan ikkje lese overlay-kandidatane")
        returner 1
    }

    la base_markor = "\"" + base_fn + "\":{"
    la kjelde_markor = "\"" + kjelde_fn + "\":{"
    la base_treff = tel_tekst(base, base_markor)
    hvis ((legg_til_fn og base_treff != 0) eller
         (ikkje legg_til_fn og base_treff != 1)) eller
       tel_tekst(kjelde, kjelde_markor) != 1 {
        linje("[FAIL] funksjonsmarkør må finnast nøyaktig ein gong i kvar NCB")
        returner 1
    }
    la kjelde_pos = builtin.index_of(kjelde, kjelde_markor)
    la kjelde_obj_start = kjelde_pos + lengde(kjelde_markor) - 1
    la kjelde_obj_slutt = objekt_slutt(kjelde, kjelde_obj_start)
    la base_obj_start = 0
    la base_obj_slutt = -1
    hvis ikkje legg_til_fn {
        la base_pos = builtin.index_of(base, base_markor)
        base_obj_start = base_pos + lengde(base_markor) - 1
        base_obj_slutt = objekt_slutt(base, base_obj_start)
    }
    hvis (ikkje legg_til_fn og base_obj_slutt < base_obj_start) eller
       kjelde_obj_slutt < kjelde_obj_start {
        linje("[FAIL] ubalansert funksjonsobjekt")
        returner 1
    }

    la definisjon = builtin.slice(kjelde, kjelde_obj_start, kjelde_obj_slutt + 1)
    hvis normaliser_kall {
        la base_ncb = builtin.json_parse_raw(base)
        la kjelde_ncb = builtin.json_parse_raw(kjelde)
        la base_mål = kallmål(base_ncb["functions"][base_fn])
        la kjelde_mål = kallmål(kjelde_ncb["functions"][kjelde_fn])
        la ki = 0
        mens ki < lengde(kjelde_mål) {
            la feil_mål = tekst(kjelde_mål[ki])
            hvis builtin.starts_with(feil_mål, "builtin.") og
               ikkje har_tekst(base_mål, feil_mål) {
                la suffix = builtin.slice(feil_mål, 8, lengde(feil_mål))
                la funne = ""
                la treff = 0
                la bi = 0
                mens bi < lengde(base_mål) {
                    la kandidat = tekst(base_mål[bi])
                    hvis builtin.ends_with(kandidat, "." + suffix) {
                        funne = kandidat
                        treff = treff + 1
                    }
                    bi = bi + 1
                }
                hvis treff == 1 {
                    definisjon = builtin.replace(definisjon,
                        "[\"CALL\",\"" + feil_mål + "\"",
                        "[\"CALL\",\"" + funne + "\"")
                } ellers hvis treff > 1 {
                    linje("[FAIL] tvitydig CALL-normalisering: " + feil_mål)
                    returner 1
                }
            }
            ki = ki + 1
        }
    }
    hvis kall_fra != "" eller kall_til != "" {
        hvis kall_fra == "" eller kall_til == "" {
            linje("[FAIL] eksplisitt CALL-mapping krev både FROM og TO")
            returner 1
        }
        la kall_fra_liste = builtin.split(kall_fra, "|")
        la kall_til_liste = builtin.split(kall_til, "|")
        hvis lengde(kall_fra_liste) != lengde(kall_til_liste) {
            linje("[FAIL] eksplisitte CALL-mappingar har ulik lengd")
            returner 1
        }
        la kmi = 0
        mens kmi < lengde(kall_fra_liste) {
            la km_fra = kall_fra_liste[kmi]
            la km_til = kall_til_liste[kmi]
            hvis rå_kallmapping {
                hvis tel_tekst(definisjon, "[\"CALL\",\"" + km_fra + "\"") <= 0 eller
                   tel_tekst(base, "\"" + km_til + "\":{") != 1 {
                    linje("[FAIL] rå CALL-mapping samsvarer ikkje med kandidatane")
                    returner 1
                }
            } ellers {
                la base_ncb_map = builtin.json_parse_raw(base)
                la kjelde_ncb_map = builtin.json_parse_raw(kjelde)
                la kjelde_mål_map = kallmål(kjelde_ncb_map["functions"][kjelde_fn])
                hvis ikkje har_tekst(kjelde_mål_map, km_fra) eller
                   ikkje har_nokkel(base_ncb_map["functions"], km_til) {
                    linje("[FAIL] eksplisitt CALL-mapping samsvarer ikkje med kandidatane")
                    returner 1
                }
            }
            definisjon = builtin.replace(definisjon,
                "[\"CALL\",\"" + km_fra + "\"",
                "[\"CALL\",\"" + km_til + "\"")
            kmi = kmi + 1
        }
    }
    hvis fra_modul != "" og til_modul != "" {
        definisjon = builtin.replace(definisjon, "\"" + fra_modul + ".", "\"" + til_modul + ".")
        definisjon = builtin.replace(definisjon,
            "\"module\":\"" + fra_modul + "\"",
            "\"module\":\"" + til_modul + "\"")
    }

    la resultat = ""
    hvis legg_til_fn {
        la functions_markor = "\"functions\":{"
        hvis tel_tekst(base, functions_markor) != 1 {
            linje("[FAIL] toppnivå-functions må finnast nøyaktig ein gong")
            returner 1
        }
        la inn_pos = builtin.index_of(base, functions_markor) + lengde(functions_markor)
        la skilje = ""
        hvis base[inn_pos] != "}" { skilje = "," }
        resultat = builtin.slice(base, 0, inn_pos) +
            "\"" + base_fn + "\":" + definisjon + skilje +
            builtin.slice(base, inn_pos, lengde(base))
    } ellers {
        la prefiks = builtin.slice(base, 0, base_obj_start)
        la suffiks = builtin.slice(base, base_obj_slutt + 1, lengde(base))
        resultat = prefiks + definisjon + suffiks
    }
    hvis tel_tekst(resultat, base_markor) != 1 {
        linje("[FAIL] basefunksjonen vart ikkje bevart nøyaktig ein gong")
        returner 1
    }
    hvis lengde(resultat) <= 0 eller resultat[0] != "{" eller
       resultat[lengde(resultat) - 1] != "}" {
        linje("[FAIL] overlay-resultatet har ugyldig toppnivågrense")
        returner 1
    }

    builtin.fil_skriv(ut_sti, resultat)
    linje("[OK] råtekst-overlay: " + kjelde_fn + " -> " + base_fn)
    linje("[OK] skreiv kandidat utan promotering: " + ut_sti)
    returner 0
}
