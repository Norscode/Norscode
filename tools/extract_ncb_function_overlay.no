// Trekk ut éin verifisert NCB-funksjon som eit lite overlay. Dette lèt
// kandidatbygg byte ut ei enkelt kjeldefunksjon utan å regenerere eller
// overskrive committed precompiled-artifaktar.

funksjon tom() -> tekst { returner builtin.slice("x", 0, 0) }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner tom() }
    returner tom()
}

funksjon start() -> heiltall {
    la inn = env("NC_OVERLAY_INPUT")
    la ut = env("NC_OVERLAY_OUTPUT")
    la namn = env("NC_OVERLAY_FUNCTION")
    hvis inn == tom() eller ut == tom() eller namn == tom() {
        kast "funksjonsoverlay krev input, output og funksjonsnamn"
    }
    la kjelde = builtin.json_parse_raw(fil_les(inn))
    hvis ikkje finnes_nøkkel(kjelde["functions"], namn) {
        kast "funksjonsoverlay manglar kjeldefunksjon: " + namn
    }
    la funksjonar = {}
    funksjonar[namn] = kjelde["functions"][namn]
    la overlay = {
        "format": "ncb-v1",
        "entry": namn,
        "module_initializers": [],
        "global_names": {},
        "imports": [],
        "route_handlers": [],
        "functions": funksjonar
    }
    fil_skriv(ut, builtin.json_stringify(overlay))
    la kontroll = builtin.json_parse_raw(fil_les(ut))
    hvis lengde(nøkler(kontroll["functions"])) != 1 eller
       ikkje finnes_nøkkel(kontroll["functions"], namn) {
        kast "funksjonsoverlay feila etter skriving"
    }
    skriv("funksjonsoverlay OK: " + namn + "\n")
    returner 0
}
