// Norscode-eigd CI-matrise for GC, relokering, trådar og VM-røter.
// Kvar test blir køyrd isolert gjennom strukturert argv-prosesskøyring.
//
// 2026-09-24 (H4): `nc test` returnerer 0 òg når testen blir HOPPA over (ein
// fast-lane-timeout blir gjord om til SKIP), så exit-koden åleine gav «OK (8/8)» med
// test_runtime_memory aldri køyrd. Matrisa krev no at oppsummeringa seier nøyaktig
// éin bestått, null feila og null hoppa per test, og køyrer barnet i slow-modus
// (timeout = FEIL, ikkje SKIP) med romsleg tidsgrense. Alle testane blir køyrde
// sjølv om ein feilar, så loggen viser heile matrisa.

bruk tools.process_runner som prosess

// Per-test-grense i slow-modus (compile og køyring har kvar si). Slow-lana brukte
// ~260 s på test_runtime_memory på fersk Linux-seed (run 36014918036, shard 0).
funksjon slow_test_timeout_s() -> tekst { returner "480" }

// Heile barneprosessen (compile + køyring). Avgrensar éin hengande test til 12 min;
// heile matrisa er i tillegg avgrensa av CI-steget sitt tak (timeout-minutes: 45 i
// ci.yml), og slow-suiten etterpå køyrer uansett (`!cancelled()`).
funksjon prosess_timeout_ms() -> heiltall { returner 720000 }

// Talet etter «<felt>:» i oppsummeringa frå tools/nc_test.no, eller -1 om feltet
// manglar. Delar på sjølve feltnamnet og les sifra rett etter (etter trim), så
// escapa linjeskift i prosess-stdout ikkje spelar inn, og ingen indeksaritmetikk
// kan skilje bytes og teikn (feltnamnet «Bestått» er ikkje ASCII).
funksjon oppsummeringstal(ut: tekst, felt: tekst) -> heiltall {
    la delar = builtin.split(ut, felt + ":")
    hvis lengde(delar) != 2 { returner -1 }
    la rest = builtin.trim(delar[1])
    la j: heiltall = 0
    mens j < lengde(rest) og builtin.index_of("0123456789", builtin.slice(rest, j, j + 1)) >= 0 {
        j = j + 1
    }
    hvis j == 0 { returner -1 }
    returner heltall_fra_tekst(builtin.slice(rest, 0, j))
}

funksjon køyr_test(runtime: tekst, root: tekst, testfil: tekst) -> boolsk {
    skriv("[native-gc] " + testfil + "\n")
    la resultat = prosess.køyr_med_grenser(
        runtime,
        ["test", testfil],
        root,
        {"NC_SLOW_TESTS": "1", "SLOW_TEST_TIMEOUT": slow_test_timeout_s()},
        prosess_timeout_ms(),
        2147483648,
        128
    )
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) {
        skriv("FEIL: Norscode GC-matrisa: " + testfil + " feila (status=" +
              tekst(resultat["status"]) + " exit=" + tekst(resultat["exit_code"]) + ")\n")
        returner usann
    }
    la ut = tekst(resultat["stdout"])
    la bestått = oppsummeringstal(ut, "Bestått")
    la feila = oppsummeringstal(ut, "Feilet")
    la hoppa = oppsummeringstal(ut, "Hoppa")
    hvis bestått != 1 eller feila != 0 eller hoppa != 0 {
        skriv("FEIL: Norscode GC-matrisa krev éin bestått test for " + testfil +
              " (bestått=" + tekst(bestått) + " feila=" + tekst(feila) +
              " hoppa=" + tekst(hoppa) + "; -1 = manglar i oppsummeringa)\n")
        returner usann
    }
    returner sann
}

funksjon start() -> heiltall {
    la root = "."
    prøv { root = builtin.miljo_hent("NORSCODE_ROOT") } fang (e) {}
    hvis root == "" { root = "." }
    // CI lastar den verifiserte kandidaten her før slow-lane startar.
    // Bruk binæren direkte slik at matrisa ikkje går gjennom ein shellwrapper.
    la runtime = root + "/dist/norscode_native"
    // Dei to siste er AOT-GC-regresjonsportar (Linux x86-64): markøren følgjer ikkje falske
    // liste/map-objekt (fdda014, collect-stans) og fail-closed GC-innskriving i codegen (F3.8).
    la testar = [
        "tests/test_runtime_memory.no",
        "tests/test_runtime_gc_generational.no",
        "tests/test_runtime_memory_parallel_gc.no",
        "tests/test_runtime_memory_lock_lifecycle.no",
        "tests/test_thread_native_backend_lifecycle.no",
        "tests/test_native_gc_reference_graph.no",
        "tests/test_vm_gc_integration.no",
        "tests/test_vm_gc_root_dedup.no",
        "tests/test_native_gc_falsk_liste.no",
        "tests/test_native_codegen_gc_fix.no"
    ]
    la bestått: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(testar) {
        hvis køyr_test(runtime, root, testar[i]) { bestått = bestått + 1 }
        i = i + 1
    }
    la totalt = tekst(bestått) + "/" + tekst(lengde(testar))
    hvis bestått != lengde(testar) {
        skriv("FEIL: Norscode GC-matrise " + totalt + " bestått\n")
        returner 1
    }
    skriv("Norscode GC-matrise OK (" + totalt + " bestått, 0 hoppa)\n")
    returner 0
}
