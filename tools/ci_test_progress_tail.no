// tools/ci_test_progress_tail.no — skriv dei siste linjene i NC_TEST_PROGRESS_FILE.
// Siste «START» utan «DONE» = testen som køyrde då testlanen døydde. Erstattar
// det tidlegare bash-steget (`tail -60 … || echo`) i CI.

funksjon start() -> heiltall {
    la sti = ""
    prøv { sti = miljo_hent("NC_TEST_PROGRESS_FILE") } fang (e) { sti = "" }
    la data = ""
    prøv { data = builtin.fil_les(sti) } fang (e) { data = "" }
    hvis sti == "" eller data == "" {
        skriv("(ingen framgangsfil)\n")
        returner 0
    }
    la linjer = builtin.split(data, "\n")
    la slutt = lengde(linjer)
    hvis slutt > 0 og linjer[slutt - 1] == "" { slutt = slutt - 1 }
    la i = slutt - 60
    hvis i < 0 { i = 0 }
    mens i < slutt {
        skriv(linjer[i] + "\n")
        i = i + 1
    }
    returner 0
}
