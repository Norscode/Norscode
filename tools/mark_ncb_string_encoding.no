// Merkar NCB-funksjonar som er produserte av ein kompilator som leverer
// ferdig dekoda strengkonstantar. Overgangsverktøyet lèt ein bundle blande
// committed legacy-NCB og nye funksjonar utan heuristisk escape-gjetting.

funksjon env(namn: tekst) -> tekst {
    hvis miljo_finnes(namn) { returner miljo_hent(namn) }
    returner ""
}

funksjon start() -> heiltall {
    la inn = env("NC_NCB_INPUT")
    la ut = env("NC_NCB_OUTPUT")
    la prefiks = env("NC_NCB_FUNCTION_PREFIX")
    hvis inn == "" eller ut == "" { kast "NC_NCB_INPUT og NC_NCB_OUTPUT må vere sette" }

    la ncb = builtin.json_parse_raw(fil_les(inn))
    la functions = ncb["functions"]
    la namn = nøkler(functions)
    la i: heiltall = 0
    la merka: heiltall = 0
    mens i < lengde(namn) {
        la fn = functions[namn[i]]
        hvis prefiks == "" eller builtin.starts_with(namn[i], prefiks) {
            fn["string_encoding"] = "decoded-v1"
            merka = merka + 1
        }
        i = i + 1
    }
    fil_skriv(ut, builtin.json_stringify(ncb))
    skriv("Merka " + tekst_fra_heiltall(merka) + " NCB-funksjonar som decoded-v1\n")
    returner 0
}
