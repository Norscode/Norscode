// Shellfri samling av runtime-gap promotion-readiness.
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon rot() -> tekst {
    la r = env("NORSCODE_ROOT")
    hvis r != "" { returner r }
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon køyr_port(host: tekst, root: tekst, verktøy: tekst,
                   gap_bin: tekst) -> ordbok_tekst {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_NATIVE_GAP_BIN": gap_bin,
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.",
        "PATH": "/nonexistent"
    }
    returner prosess.køyr(host, ["run", root + "/" + verktøy],
                          root, miljø, 600000)
}

funksjon ut(resultat: ordbok_tekst) -> tekst {
    returner tekst(resultat["stdout"]) + tekst(resultat["stderr"])
}

funksjon har(resultat: ordbok_tekst, markør: tekst) -> boolsk {
    returner builtin.index_of(ut(resultat), markør) >= 0
}

funksjon status(resultat: ordbok_tekst, grønn: tekst) -> tekst {
    hvis prosess.ok(resultat) og har(resultat, grønn) { returner "green" }
    hvis har(resultat, "[FAIL]") eller har(resultat, "FEIL") eller
       har(resultat, "runtime-gap står att") { returner "red_detected" }
    returner "red_unknown"
}

funksjon rapportlinje(key: tekst, value: tekst) -> tekst {
    returner "promotion_readiness(\"" + key + "\", \"" + value + "\")\n"
}

funksjon start() -> heiltall {
    la root = rot()
    la candidate_rel = env("NORSCODE_PROMOTION_CANDIDATE")
    hvis candidate_rel == "" { candidate_rel = env("NORSCODE_NATIVE_GAP_BIN") }
    hvis candidate_rel == "" { candidate_rel = "build/v3010/norscode_native_macos_arm64_v3010" }
    la candidate = abs_sti(root, candidate_rel)
    la active = root + "/dist/norscode_native"
    la report = root + "/docs/native_mappe_opprett_promotion_readiness_v3003.no"
    hvis ikkje builtin.fil_finnes(candidate) { skriv("[FAIL] kandidat manglar: " + candidate + "\n"); returner 1 }

    la pure = køyr_port(candidate, root, "tools/native_runtime_gap_pure_vm_gate_v3002.no", candidate)
    la cli = køyr_port(candidate, root, "tools/native_runtime_gap_cli_gate_v3004.no", candidate)
    la candidate_gate = køyr_port(candidate, root, "tools/native_runtime_gap_gate_v3001.no", candidate)
    la active_gate = køyr_port(candidate, root, "tools/native_runtime_gap_gate_v3001.no", active)
    la pure_status = status(pure, "pure VM-kandidat er grønn")
    la cli_status = status(cli, "vanleg nc run er grønn")
    la candidate_status = status(candidate_gate, "runtime-gap gate er grønn")
    la active_status = status(active_gate, "runtime-gap gate er grønn")
    la decision = "not_ready"
    hvis pure_status == "green" og cli_status == "green" og candidate_status == "green" {
        hvis active_status == "green" { decision = "already_promoted_or_active_green" }
        ellers hvis active_status == "red_detected" { decision = "ready_for_controlled_promotion" }
    }

    la body = rapportlinje("schema", "norscode.native_gap_promotion_readiness.v3003")
    body = body + rapportlinje("pure_vm_gate_status", pure_status)
    body = body + rapportlinje("cli_gate_status", cli_status)
    body = body + rapportlinje("native_candidate", candidate)
    body = body + rapportlinje("native_candidate_gate_status", candidate_status)
    body = body + rapportlinje("active_runtime_gate_status", active_status)
    body = body + rapportlinje("dist_changed", "usann")
    body = body + rapportlinje("stage0_changed", "usann")
    body = body + rapportlinje("decision", decision)
    fil_skriv(report, body)
    skriv(body)
    hvis decision == "not_ready" { prosess.skriv_resultat(pure); prosess.skriv_resultat(cli); prosess.skriv_resultat(candidate_gate); prosess.skriv_resultat(active_gate); returner 1 }
    returner 0
}
