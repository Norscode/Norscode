// W6.2: CRT-fri Windows-spawn må vidareføre environment-map til CreateProcessW.
// Testar òg at no-network/JobObject/AppContainer IKKJE kan late som sandbox
// er aktiv før ein ekte Windows-implementasjon er klar. Fail-closed er obligatorisk.
bruk std.runtime.process_abi som abi

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    la native = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis root == "" eller native == "" {
        skriv("WIN-ENV-SPAWN-FEIL: manglar root/runtime\n")
        returner 1
    }
    la req = abi.request(native, [], root, "", 10000, 65536)
    req = abi.sett_environment(req, {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tests/fixtures/windows_process_env_child.no",
        "NORSCODE_WIN_ENV_PROBE": "W6_2",
        "NORSCODE_ROOT": root
    })
    la res = builtin.process_spawn_argv(req)
    skriv("WIN-ENV status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) +
          " out=[" + tekst(res["stdout"]) + "]\n")
    hvis tekst(res["status"]) != "ferdig" eller tekst(res["exit_code"]) != "0" eller
       ikkje builtin.contains(tekst(res["stdout"]), "WIN-ENV-OK") {
        skriv("WIN-ENV-SPAWN-FEIL\n")
        returner 1
    }
    skriv("WIN-ENV-SPAWN-OK\n")

    // Freestanding manglar enno AppContainer/JobObject. Denne requesten
    // MÅ bli avvist før oppstart, ikkje køyrast utan sandbox.
    la sandbox_req = abi.request(native, ["--version"], root, "", 10000, 65536)
    sandbox_req = abi.sett_sandbox(sandbox_req, "no-network", 268435456, 8, usann)
    la denied = builtin.process_spawn_argv(sandbox_req)
    hvis tekst(denied["status"]) != "feil" eller
       ikkje builtin.contains(tekst(denied["error_detail"]), "AppContainer") {
        skriv("WIN-SANDBOX-BYPASS-FEIL\n")
        returner 1
    }
    skriv("WIN-SANDBOX-FAIL-CLOSED-OK\n")
    returner 0
}
