// Bygg fleire NCB → ELF i EIN source-codegen-køyring (spar recompile).
// NC_ELF_SPECS = "ncb1:bin1,ncb2:bin2,..."
bruk selfhost.native_execution.elf_arm64_codegen som elfcg
bruk selfhost.ncb_serde som serde
funksjon start() -> heiltall {
    la specs = miljo_hent("NC_ELF_SPECS")
    la par = builtin.split(specs, ",")
    la i = 0
    mens i < lengde(par) {
        la kv = builtin.split(builtin.trim(par[i]), ":")
        hvis lengde(kv) == 2 {
            prøv {
                la p = serde.les_fil(kv[0])
                la r = elfcg.kompiler_ncb(p, kv[1])
                hvis tekst(r["ok"]) == "sann" { skriv("OK " + kv[1] + "\n") }
                ellers { skriv("FEIL " + kv[1] + ": " + tekst(r["error"]) + "\n") }
            } fang (e) { skriv("KAST " + kv[1] + ": " + tekst(e) + "\n") }
        }
        i = i + 1
    }
    returner 0
}
