// tools/smoke_helpdesk_api.no — Helpdesk API smoke in-process

bruk tools.process_runner som runner

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la nc_bin = root + "/bin/nc"
    la test_file = root + "/tests/test_helpdesk.no"

    linje("=== Helpdesk API smoke (in-prosess) ===")
    linje("Bruker testkjerne i " + test_file)

    hvis ikkje executable(nc_bin) {
        linje("feil: manglar " + nc_bin)
        returner 1
    }
    hvis ikkje fil_finst(test_file) {
        linje("feil: manglar testfila " + test_file)
        returner 1
    }

    la res = runner.køyr(nc_bin, ["test", test_file], root, {}, 300000)
    runner.skriv_resultat(res)
    hvis ikkje runner.ok(res) {
        linje("FEIL: helpdesk smoke feila (exit=" + tekst(res["exit_code"]) + ")")
        returner 1
    }

    linje("OK: helpdesk smoke bestod.")
    returner 0
}
