// Set filmodus for eit generert kandidatverktøy gjennom Norscode sin
// versjonerte filesystem-ABI. Verktøyet promoterer eller kopierer ingenting.

funksjon start() -> heiltall {
    la sti = ""
    prøv { sti = miljo_hent("NORSCODE_CANDIDATE_EXECUTABLE") } fang (e) { sti = "" }
    hvis sti == "" {
        skriv("[FAIL] NORSCODE_CANDIDATE_EXECUTABLE manglar\n")
        returner 2
    }
    hvis ikkje builtin.fil_finnes(sti) {
        skriv("[FAIL] kandidatfila finst ikkje: " + sti + "\n")
        returner 1
    }
    hvis ikkje builtin.fil_sett_kjorbar(sti) {
        skriv("[FAIL] filmodus-ABI kunne ikkje setje kandidaten køyrbar\n")
        returner 1
    }
    skriv("[OK] kandidatfila er køyrbar\n")
    returner 0
}
