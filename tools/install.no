// tools/install.no — shellfri lokal Norscode-installasjon

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon absolutt_relativ(sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/tmp/") og systemfelt("system") == "Darwin" {
        returner "private/tmp/" + builtin.slice(sti, 5, lengde(sti))
    }
    hvis builtin.starts_with(sti, "/") {
        returner builtin.slice(sti, 1, lengde(sti))
    }
    returner sti
}

funksjon utan_sluttstrek(sti: tekst) -> tekst {
    hvis lengde(sti) > 1 og builtin.ends_with(sti, "/") {
        returner builtin.slice(sti, 0, lengde(sti) - 1)
    }
    returner sti
}

funksjon install_scope() -> tekst {
    la scope = env("NORSCODE_INSTALL_SCOPE_ROOT")
    hvis scope == "" { scope = env("HOME") }
    returner utan_sluttstrek(scope)
}

funksjon under_scope(scope: tekst, sti: tekst) -> tekst {
    hvis scope == "/" { returner absolutt_relativ(sti) }
    hvis sti == scope { returner "." }
    hvis builtin.starts_with(sti, scope + "/") {
        returner builtin.slice(sti, lengde(scope) + 1, lengde(sti))
    }
    returner ""
}

funksjon forelder(sti: tekst) -> tekst {
    la teikn = builtin.split(sti, "")
    la sist: heiltall = -1
    la i: heiltall = 0
    mens i < lengde(teikn) {
        hvis teikn[i] == "/" { sist = i }
        i = i + 1
    }
    hvis sist < 0 { returner "." }
    hvis sist == 0 { returner "/" }
    returner builtin.join(builtin.slice(teikn, 0, sist), "")
}

funksjon lag_mappe(sti: tekst, feil: tekst) -> bool {
    prøv {
        builtin.mkdir_p(sti)
        returner sann
    } fang (e) {}
    linje(feil + ": " + sti)
    returner usann
}

funksjon erstatt_lenke(lenke: tekst, mål: tekst, feil: tekst) -> bool {
    la scope = install_scope()
    la relativ_lenke = under_scope(scope, lenke)
    la relativt_scope_mål = under_scope(scope, mål)
    hvis scope == "" eller relativ_lenke == "" eller relativt_scope_mål == "" {
        linje(feil + ": lenke og mål må ligge under NORSCODE_INSTALL_SCOPE_ROOT")
        returner usann
    }
    la relativt_mål = filops.relativ_sti(forelder(lenke), mål)
    la resultat = native_fs.native_erstatt_symbolsk_lenke(scope, relativ_lenke, relativt_mål)
    hvis resultat["status"] == "ok" { returner sann }
    linje(feil + ": " + tekst(resultat["error"]))
    returner usann
}

funksjon installer_launcher(sti: tekst, runtime_prefix: tekst) -> bool {
    returner erstatt_lenke(sti, runtime_prefix + "/current/bin/nc",
                           "Klarte ikkje publisere native launcher " + sti)
}

funksjon installer_launchere(bin_dir: tekst, runtime_prefix: tekst) -> bool {
    hvis ikkje lag_mappe(bin_dir, "Klarte ikkje lage bin-mappe") { returner usann }
    hvis ikkje installer_launcher(bin_dir + "/norscode", runtime_prefix) { returner usann }
    hvis ikkje installer_launcher(bin_dir + "/nc", runtime_prefix) { returner usann }
    returner sann
}

funksjon systemfelt(namn: tekst) -> tekst {
    prøv { returner tekst(builtin.system_info()[namn]) } fang (e) { returner "ukjend" }
    returner "ukjend"
}

funksjon platform() -> tekst {
    la os = systemfelt("system")
    la arch = systemfelt("machine")
    hvis os == "Darwin" og arch == "arm64" { returner "macos-arm64" }
    hvis os == "Darwin" og arch == "x86_64" { returner "macos-x86_64" }
    hvis os == "Linux" og (arch == "x86_64" eller arch == "amd64") { returner "linux-x86_64" }
    hvis os == "Linux" og (arch == "aarch64" eller arch == "arm64") { returner "linux-arm64" }
    returner os + "-" + arch
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = systemfelt("cwd") }
    la prefix = env("NORSCODE_INSTALL_PREFIX")
    hvis prefix == "" { prefix = env("HOME") + "/.local" }
    la runtime_prefix = prefix + "/share/norscode"
    la bin_dir = prefix + "/bin"
    la legacy_prefix = env("HOME") + "/.norscode"

    linje("Plattform oppdaget: " + platform())
    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        linje("Feil: lokal installasjon krev " + root + "/dist/norscode_native")
        returner 1
    }

    linje("Pre-bygd norscode_native funnet lokalt.")
    hvis ikkje lag_mappe(runtime_prefix + "/releases", "Klarte ikkje lage runtime-mappe") { returner 1 }
    hvis ikkje erstatt_lenke(runtime_prefix + "/current", root,
                             "Klarte ikkje oppdatere current-lenke") { returner 1 }
    hvis ikkje installer_launchere(bin_dir, runtime_prefix) { returner 1 }
    hvis ikkje installer_launchere(legacy_prefix + "/bin", runtime_prefix) { returner 1 }

    hvis env("NORSCODE_INSTALL_SKIP_FILE_ICONS") != "sann" og systemfelt("system") == "Darwin" {
        la nc = root + "/bin/nc"
        hvis fil_finst(nc) {
            la ikon = prosess.køyr(nc, ["install-macos-file-icons"], root, {}, 120000)
            hvis ikkje prosess.ok(ikon) {
                prosess.skriv_resultat(ikon)
                linje("Merk: filikon vart ikkje installerte")
            }
        }
    }

    linje("Installert: " + runtime_prefix + "/current")
    linje("Installert: " + bin_dir + "/norscode")
    linje("Legg til PATH: export PATH=\"" + bin_dir + ":$PATH\"")
    returner 0
}
