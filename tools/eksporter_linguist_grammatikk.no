// Eksporter Norscode TextMate-grammatikk som ei separat pakke.
// Ingen dublerte JSON-filer i Git-indeksen: all JSON blir generert under build/.
// Berre Norscode fil-I/O og katalogoppretting, utan Python/C/shell.

bruk std.tekst som t

funksjon feil(melding: tekst) -> heiltall {
    skriv("FEIL grammatikkeksport: " + melding + "\n")
    returner 1
}

funksjon start() -> heiltall {
    la ut = "build/norscode-linguist-grammar"
    la kjelde = "vscode-norscode/syntaxes/norscode.tmLanguage.json"
    la lesmeg = "docs/04-how-to-guides/linguist-proposal/grammar-repo/README.md"

    hvis ikkje fil_finnes(kjelde) { returner feil("originalgrammatikk manglar") }
    hvis ikkje fil_finnes("LICENSE") { returner feil("Apache-2.0-lisens manglar") }
    hvis ikkje fil_finnes(lesmeg) { returner feil("README manglar") }

    prøv {
        builtin.mkdir_p(ut + "/syntaxes")
    } fang (e) {
        returner feil("kunne ikkje lage eksportmappe: " + tekst(e))
    }

    // Medvite minimal manifest for script/add-grammar. Scope og filendelse
    // må vere identiske med kanonisk vscode-norscode-konfigurasjon.
    la manifest = "{\n" +
        "  \"name\": \"norscode-grammar\",\n" +
        "  \"displayName\": \"Norscode Grammar\",\n" +
        "  \"description\": \"TextMate grammar for Norscode .no files\",\n" +
        "  \"version\": \"0.1.0\",\n" +
        "  \"license\": \"Apache-2.0\",\n" +
        "  \"engines\": {\"vscode\": \"^1.80.0\"},\n" +
        "  \"contributes\": {\n" +
        "    \"languages\": [{\"id\": \"norscode\", \"aliases\": [\"Norscode\"], \"extensions\": [\".no\"]}],\n" +
        "    \"grammars\": [{\"language\": \"norscode\", \"scopeName\": \"source.norscode\", \"path\": \"./syntaxes/norscode.tmLanguage.json\"}]\n" +
        "  }\n" +
        "}\n"

    la original = fil_les(kjelde)
    la lisens = fil_les("LICENSE")
    la dokumentasjon = fil_les(lesmeg)
    hvis original == "" eller lisens == "" eller dokumentasjon == "" {
        returner feil("tom kjeldefil")
    }
    prøv {
        fil_skriv(ut + "/package.json", manifest)
        fil_skriv(ut + "/syntaxes/norscode.tmLanguage.json", original)
        fil_skriv(ut + "/LICENSE", lisens)
        fil_skriv(ut + "/README.md", dokumentasjon)
    } fang (e) {
        returner feil("skriving feila: " + tekst(e))
    }

    // Sjekk faktiske eksporterte filer, ikkje berre tekst i kjelda.
    hvis fil_les(ut + "/package.json") != manifest {
        returner feil("manifest vart ikkje skrive byte-eksakt")
    }
    hvis fil_les(ut + "/syntaxes/norscode.tmLanguage.json") != original {
        returner feil("eksportert grammatikk avvik frå original")
    }
    hvis fil_les(ut + "/LICENSE") != lisens {
        returner feil("eksportert lisens avvik frå original")
    }
    hvis fil_les(ut + "/README.md") != dokumentasjon {
        returner feil("eksportert README avvik frå original")
    }
    hvis ikkje t.inneholder(manifest, "\"source.norscode\"") eller
       ikkje t.inneholder(manifest, "\".no\"") eller
       ikkje t.inneholder(manifest, "\"Apache-2.0\"") {
        returner feil("manifest manglar språkidentitet eller lisens")
    }

    // Upstream-beredskap: kopier YAML-fragmenta inn i eksporten.
    // Dette endrar ikkje GitHub Linguist sin faktiske language-registry.
    la forslag_rot = "docs/04-how-to-guides/linguist-proposal/"
    la eksport_rot = "build/norscode-linguist-upstream/"
    la språkforslag = fil_les(forslag_rot + "norscode-language.yml")
    la heuristikkforslag = fil_les(forslag_rot + "norscode-heuristics.yml")
    hvis språkforslag == "" eller heuristikkforslag == "" {
        returner feil("manglande upstream YAML-fragment")
    }
    prøv {
        builtin.mkdir_p(eksport_rot)
        fil_skriv(eksport_rot + "norscode-language.yml", språkforslag)
        fil_skriv(eksport_rot + "norscode-heuristics.yml", heuristikkforslag)
    } fang (e) {
        returner feil("kunne ikkje eksportere upstream YAML-fragment: " + tekst(e))
    }
    hvis fil_les(eksport_rot + "norscode-language.yml") != språkforslag eller
       fil_les(eksport_rot + "norscode-heuristics.yml") != heuristikkforslag {
        returner feil("eksporterte upstream YAML-fragment avvik frå originalane")
    }

    // Ekte kjeldeeksempel for upstream samples/Norscode/.
    // Dei blir genererte under build/, slik at GitHub sin JSON-/fil-ratchet
    // ikkje blir påverka, og filene aldri driftar frå originalane.
    la sample_ut = "build/norscode-linguist-upstream/samples/Norscode"
    la kjelder: liste_tekst = [
        "compiler/compiler.no",
        "std/tomllib.no",
        "std/ghash.no",
        "toolchain/norspkg/cache.no"
    ]
    la namn: liste_tekst = [
        "compiler_runtime.no",
        "toml_parser.no",
        "ghash.no",
        "package_cache.no"
    ]
    prøv {
        builtin.mkdir_p(sample_ut)
    } fang (e) {
        returner feil("kunne ikkje lage samplestiar: " + tekst(e))
    }
    // PR-handlingar brukar PR-head-SHA, ikkje GitHub sin mellombelse merge-SHA.
    // Lokal eksport kan køyrast utan miljøvariabel, men blir då ikkje pinnet.
    la opphav_ref = "main"
    la revisjon_linje = "Source revision: unpinned (set NORSCODE_LINGUIST_SOURCE_SHA to the exact commit).\n"
    la kjelde_sha = ""
    prøv { kjelde_sha = miljo_hent("NORSCODE_LINGUIST_SOURCE_SHA") } fang (e) {}
    // Manglande PR-head-SHA skal ikkje godkjennast som sporbar CI-eksport.
    la ci = ""
    prøv { ci = miljo_hent("NC_CI") } fang (e) {}
    hvis ci == "1" og lengde(kjelde_sha) != 40 {
        returner feil("CI manglar 40-teikns kjeldecommit for Linguist-samples")
    }
    hvis lengde(kjelde_sha) == 40 {
        opphav_ref = kjelde_sha
        revisjon_linje = "Source commit (provided by caller): " + kjelde_sha + "\n"
    }

    la opphav = "# Norscode samples - provenance\n\n" +
        "These are unmodified copies of real Norscode source files.\n" +
        "Original repository: https://github.com/Norscode/Norscode\n" +
        "Declared repository license: Apache-2.0. Verify per-file notices before upstream submission.\n" +
        revisjon_linje +
        "All files here are from the same Norscode owner, not evidence of independent adoption.\n\n"
    la i = 0
    mens i < lengde(kjelder) {
        hvis ikkje fil_finnes(kjelder[i]) {
            returner feil("manglande sample-kjelde: " + kjelder[i])
        }
        la innhald = fil_les(kjelder[i])
        hvis innhald == "" { returner feil("tom sample-kjelde: " + kjelder[i]) }
        la maal = sample_ut + "/" + namn[i]
        prøv {
            fil_skriv(maal, innhald)
        } fang (e) {
            returner feil("sample-skriving feila: " + maal)
        }
        hvis fil_les(maal) != innhald {
            returner feil("sample avvik frå kjelda: " + kjelder[i])
        }
        opphav = opphav + "- `samples/Norscode/" + namn[i] + "`: " +
            "https://github.com/Norscode/Norscode/blob/" + opphav_ref + "/" + kjelder[i] + "\n"
        i = i + 1
    }
    la opphav_sti = "build/norscode-linguist-upstream/SAMPLE_ORIGINS.md"
    prøv {
        fil_skriv(opphav_sti, opphav)
    } fang (e) {
        returner feil("kunne ikkje skrive sample-opphav")
    }
    hvis fil_les(opphav_sti) != opphav {
        returner feil("sample-opphav vart ikkje skrive korrekt")
    }

    // Upstream test/test_heuristics.rb har assert_heuristics(...) og alt_name.
    // Eksporter to moteksempel som Text-fixtures, utan å påverke
    // Norscode sitt repositorium eller lage kunstig adopsjon.
    la text_ut = "build/norscode-linguist-upstream/test/fixtures/Generic/no/Text"
    prøv { builtin.mkdir_p(text_ut) } fang (e) {
        returner feil("kunne ikkje opprette Text-fixtures: " + tekst(e))
    }
    la prosa = "Referat frå teknisk møte\n" +
        "Den norske teksten omtaler funksjon og returner som vanlege ord.\n" +
        "Dette er ikkje eit Norscode-program.\n"
    la inngjerda = "# Dokumentasjon med innramma døme\n" +
        "Denne .no-fila er tekst og skal ikkje klassifiserast som Norscode.\n" +
        "\`\`\`norscode\n" +
        "funksjon svar() -> heiltall {\n" +
        "    returner 42\n" +
        "}\n" +
        "\`\`\`\n"
    prøv {
        fil_skriv(text_ut + "/plain_text.no", prosa)
        fil_skriv(text_ut + "/fenced_example.no", inngjerda)
    } fang (e) {
        returner feil("kunne ikkje skrive Text-fixtures: " + tekst(e))
    }
    hvis fil_les(text_ut + "/plain_text.no") != prosa eller
       fil_les(text_ut + "/fenced_example.no") != inngjerda {
        returner feil("Text-fixtures avvik frå kjeldeverdiane")
    }

    // Dette er berre ein Ruby-testSNUTT for github-linguist/linguist.
    // Ingen Ruby blir køyrd i Norscode sitt bygg eller produksjonsløp.
    la test_snutt = "  def test_no_by_heuristics\n" +
        "    assert_heuristics({\n" +
        "      \"Norscode\" => all_fixtures(\"Norscode\", \"*.no\"),\n" +
        "      \"Text\" => Dir.glob(\"#{fixtures_path}/Generic/no/Text/*\")\n" +
        "    }, alt_name=\"candidate.no\")\n" +
        "  end\n"
    la test_sti = "build/norscode-linguist-upstream/TEST_HEURISTICS_SNIPPET.txt"
    prøv { fil_skriv(test_sti, test_snutt) } fang (e) {
        returner feil("kunne ikkje skrive Linguist-testutdrag")
    }
    hvis fil_les(test_sti) != test_snutt {
        returner feil("Linguist-testutdrag avvik frå kjeldeverdien")
    }
    skriv("OK: to Text-fixtures og upstream assert_heuristics-utdrag eksportert\n")

    skriv("OK: 4 ekte Norscode-eksempel eksporterte til " + sample_ut + "\n")

    skriv("OK: Norscode-grammatikk eksportert til " + ut + "\n")
    returner 0
}
