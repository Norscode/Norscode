// Eksporter Norscode TextMate-grammatikk som ei separat pakke.
// Ingen dublerte JSON-filer i Git-indeksen: all JSON blir generert under build/.
// Berre Norscode fil-I/O og katalogoppretting, utan Python/C/shell.

bruk std.tekst som t

funksjon feil(melding: tekst) -> heiltall {
    skriv("FEIL grammatikkeksport: " + melding + "\n")
    returner 1
}

funksjon start() -> heiltall {
    la ut = "build/norscode-linguist-grammar"
    la kjelde = "vscode-norscode/syntaxes/norscode.tmLanguage.json"
    la lesmeg = "docs/04-how-to-guides/linguist-proposal/grammar-repo/README.md"

    hvis ikkje fil_finnes(kjelde) { returner feil("originalgrammatikk manglar") }
    hvis ikkje fil_finnes("LICENSE") { returner feil("Apache-2.0-lisens manglar") }
    hvis ikkje fil_finnes(lesmeg) { returner feil("README manglar") }

    prøv {
        builtin.mkdir_p(ut + "/syntaxes")
    } fang (e) {
        returner feil("kunne ikkje lage eksportmappe: " + tekst(e))
    }

    // Medvite minimal manifest for script/add-grammar. Scope og filendelse
    // må vere identiske med kanonisk vscode-norscode-konfigurasjon.
    la manifest = "{\n" +
        "  \"name\": \"norscode-grammar\",\n" +
        "  \"displayName\": \"Norscode Grammar\",\n" +
        "  \"description\": \"TextMate grammar for Norscode .no files\",\n" +
        "  \"version\": \"0.1.0\",\n" +
        "  \"license\": \"Apache-2.0\",\n" +
        "  \"engines\": {\"vscode\": \"^1.80.0\"},\n" +
        "  \"contributes\": {\n" +
        "    \"languages\": [{\"id\": \"norscode\", \"aliases\": [\"Norscode\"], \"extensions\": [\".no\"]}],\n" +
        "    \"grammars\": [{\"language\": \"norscode\", \"scopeName\": \"source.norscode\", \"path\": \"./syntaxes/norscode.tmLanguage.json\"}]\n" +
        "  }\n" +
        "}\n"

    la original = fil_les(kjelde)
    la lisens = fil_les("LICENSE")
    la dokumentasjon = fil_les(lesmeg)
    hvis original == "" eller lisens == "" eller dokumentasjon == "" {
        returner feil("tom kjeldefil")
    }
    prøv {
        fil_skriv(ut + "/package.json", manifest)
        fil_skriv(ut + "/syntaxes/norscode.tmLanguage.json", original)
        fil_skriv(ut + "/LICENSE", lisens)
        fil_skriv(ut + "/README.md", dokumentasjon)
    } fang (e) {
        returner feil("skriving feila: " + tekst(e))
    }

    // Sjekk faktiske eksporterte filer, ikkje berre tekst i kjelda.
    hvis fil_les(ut + "/package.json") != manifest {
        returner feil("manifest vart ikkje skrive byte-eksakt")
    }
    hvis fil_les(ut + "/syntaxes/norscode.tmLanguage.json") != original {
        returner feil("eksportert grammatikk avvik frå original")
    }
    hvis fil_les(ut + "/LICENSE") != lisens {
        returner feil("eksportert lisens avvik frå original")
    }
    hvis fil_les(ut + "/README.md") != dokumentasjon {
        returner feil("eksportert README avvik frå original")
    }
    hvis ikkje t.inneholder(manifest, "\"source.norscode\"") eller
       ikkje t.inneholder(manifest, "\".no\"") eller
       ikkje t.inneholder(manifest, "\"Apache-2.0\"") {
        returner feil("manifest manglar språkidentitet eller lisens")
    }

    skriv("OK: Norscode-grammatikk eksportert til " + ut + "\n")
    returner 0
}
