// tools/build_norscode_native.no — atomisk materialisering utan C/Python/shell

bruk std.filops som filops
bruk std.http som http
bruk std.prosess som system_prosess
bruk std.runtime_filesystem som native_fs
bruk std.tempfile som tempfile
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) { returner "0" }
    returner "0"
}

funksjon kilobytes(sti: tekst) -> tekst {
    prøv { returner tekst_fra_heiltall(lengde(builtin.fil_les_binær(sti)) / 1024) }
    fang (e) { returner "0" }
    returner "0"
}

funksjon sha256(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon platform_name() -> tekst {
    la info = builtin.system_info()
    la os = tekst(info["system"])
    la arch = tekst(info["machine"])
    hvis os == "Darwin" {
        hvis arch == "arm64" { returner "macos-arm64" }
        hvis arch == "x86_64" { returner "macos-x86_64" }
    }
    hvis os == "Linux" {
        hvis arch == "x86_64" eller arch == "amd64" { returner "linux-x86_64" }
        hvis arch == "aarch64" eller arch == "arm64" { returner "linux-arm64" }
    }
    hvis os == "Windows" og (arch == "x86_64" eller arch == "amd64") { returner "windows-x86_64" }
    returner ""
}

funksjon stage0_seed_path(root: tekst) -> tekst {
    la platform = platform_name()
    hvis platform == "" { returner "" }
    la suffix = ""
    hvis builtin.starts_with(platform, "windows-") { suffix = ".exe" }
    returner root + "/bootstrap/stage0/norscode-" + platform + suffix
}

funksjon same_bytes_as_stage0_seed(root: tekst, candidate: tekst) -> bool {
    la seed = stage0_seed_path(root)
    hvis seed == "" eller ikkje fil_finst(seed) { returner usann }
    la cand_sha = sha256(candidate)
    returner cand_sha != "" og cand_sha == sha256(seed)
}

funksjon smoke_enabled() -> bool {
    la v = env("NORSCODE_REQUIRE_SMOKE")
    hvis v == "" { v = "1" }
    returner v == "1"
}

funksjon runtime_gap_enabled() -> bool {
    la v = env("NORSCODE_REQUIRE_RUNTIME_GAP")
    hvis v == "" { v = "0" }
    returner v == "1"
}

funksjon filesystem_list_enabled() -> bool {
    returner env("NORSCODE_REQUIRE_FILESYSTEM_LIST") == "1"
}

funksjon kandidat_miljø(root: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
}

funksjon filesystem_list_check(root: tekst, candidate: tekst) -> bool {
    hvis ikkje filesystem_list_enabled() { returner sant }
    la test_path = root + "/tests/test_native_filesystem_list.no"
    hvis ikkje fil_finst(test_path) { linje("Feil: manglar native filesystem-list smoke") returner usann }
    linje("Køyrer native filesystem.list-smoke på kandidat")
    la miljø = kandidat_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = test_path
    la resultat = prosess.køyr(candidate, [], root, miljø, 120000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon smoke_ok(root: tekst, candidate: tekst) -> bool {
    hvis ikkje executable(candidate) { returner usann }
    la tmp_obj = tempfile.ny_tempfil("nc_smoke_", ".no")
    la tmp = tempfile.sti(tmp_obj)
    builtin.fil_skriv(tmp, "funksjon start() { returner 0 }\n")
    la miljø = kandidat_miljø(root)
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = tmp
    la resultat = prosess.køyr(candidate, [], root, miljø, 30000)
    tempfile.slett(tmp_obj)
    returner prosess.ok(resultat)
}

funksjon smoke_check(root: tekst, candidate: tekst) -> bool {
    hvis ikkje smoke_enabled() { linje("Dist-smoke er slått av (NORSCODE_REQUIRE_SMOKE=0)") returner sant }
    hvis smoke_ok(root, candidate) { returner sant }
    hvis env("CI") != "1" og same_bytes_as_stage0_seed(root, candidate) {
        linje("Dist-smoke feila lokalt, men binæren matcher committed stage-0-seed byte for byte.")
        linje("Held fram lokalt; CI krev framleis full smoke.")
        returner sant
    }
    returner usann
}

funksjon runtime_gap_check(root: tekst, candidate: tekst) -> bool {
    hvis ikkje runtime_gap_enabled() { returner sant }
    la gate = root + "/tools/native_runtime_gap_gate_v3001.no"
    la nc = root + "/bin/nc"
    hvis ikkje fil_finst(gate) eller ikkje fil_finst(nc) { returner usann }
    la miljø = kandidat_miljø(root)
    miljø["NORSCODE_NATIVE_GAP_BIN"] = candidate
    la resultat = prosess.køyr(nc, ["run", gate], root, miljø, 600000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon copy_stage0_binary(root: tekst, out: tekst) -> bool {
    la platform = platform_name()
    la stage0 = stage0_seed_path(root)
    hvis platform == "" eller stage0 == "" eller ikkje fil_finst(stage0) { returner usann }
    hvis ikkje filops.kopier2(stage0, out) { returner usann }
    native_fs.native_sett_modus_sti(out, 493)
    linje("kandidat <- bootstrap/stage0/norscode-" + platform + " (" + bytes(out) + " bytes)")
    returner sant
}

funksjon release_repo() -> tekst {
    la repo = env("NORSCODE_RELEASE_REPO")
    hvis repo != "" { returner repo }
    repo = env("GITHUB_REPOSITORY")
    hvis repo != "" { returner repo }
    returner "Norscode/Norscode"
}

funksjon token() -> tekst {
    la t = env("GITHUB_TOKEN")
    hvis t == "" { t = env("GH_TOKEN") }
    returner t
}

funksjon download_text(url: tekst) -> tekst {
    la headers: ordbok_tekst = {"Accept": "application/vnd.github+json"}
    la t = token()
    hvis t != "" { headers["Authorization"] = "Bearer " + t }
    prøv {
        la response = http.get(url, headers, {}, 30000)
        hvis http.response_ok(response) { returner http.response_text(response) }
    } fang (e) {}
    returner ""
}

funksjon json_strengverdi_etter(src: tekst, key: tekst, start: heiltall) -> tekst {
    la keypat = "\"" + key + "\""
    la rest = builtin.slice(src, start, lengde(src))
    la key_rel = builtin.index_of(rest, keypat)
    hvis key_rel < 0 { returner "" }
    la etter_key = start + key_rel + lengde(keypat)
    rest = builtin.slice(src, etter_key, lengde(src))
    la kolon_rel = builtin.index_of(rest, ":")
    hvis kolon_rel < 0 { returner "" }
    la etter_kolon = etter_key + kolon_rel + 1
    rest = builtin.slice(src, etter_kolon, lengde(src))
    la start_sitat_rel = builtin.index_of(rest, "\"")
    hvis start_sitat_rel < 0 { returner "" }
    la verdi_start = etter_kolon + start_sitat_rel + 1
    rest = builtin.slice(src, verdi_start, lengde(src))
    la slutt_sitat_rel = builtin.index_of(rest, "\"")
    hvis slutt_sitat_rel < 0 { returner "" }
    returner builtin.slice(src, verdi_start, verdi_start + slutt_sitat_rel)
}

funksjon finn_download_url_med_match(json: tekst, asset: tekst, eksakt: bool) -> tekst {
    la pos = 0
    la namepat = "\"name\""
    mens pos < lengde(json) {
        la rest = builtin.slice(json, pos, lengde(json))
        la rel = builtin.index_of(rest, namepat)
        hvis rel < 0 { returner "" }
        la name_pos = pos + rel
        la namn = json_strengverdi_etter(json, "name", name_pos)
        hvis (eksakt og namn == asset) eller ((ikkje eksakt) og builtin.starts_with(namn, asset)) {
            la url = json_strengverdi_etter(json, "browser_download_url", name_pos)
            hvis url != "" og url != "null" { returner url }
        }
        pos = name_pos + lengde(namepat)
    }
    returner ""
}

funksjon finn_download_url(json: tekst, asset: tekst) -> tekst {
    hvis json == "" { returner "" }
    la url = finn_download_url_med_match(json, asset, sant)
    hvis url != "" { returner url }
    returner finn_download_url_med_match(json, asset, usann)
}

funksjon download_binary(url: tekst, out: tekst, root: tekst) -> bool {
    la curl = system_prosess.finn_kjorbar("curl")
    hvis curl == "" { returner usann }
    la argv: liste_tekst = ["-fsSL", "-L", "--output", out, "-H", "Accept: application/octet-stream"]
    la t = token()
    hvis t != "" { legg_til(argv, "-H") legg_til(argv, "Authorization: Bearer " + t) }
    legg_til(argv, url)
    la resultat = prosess.køyr(curl, argv, root, {}, 300000)
    hvis ikkje prosess.ok(resultat) { returner usann }
    native_fs.native_sett_modus_sti(out, 493)
    returner sant
}

funksjon download_release_binary(root: tekst, out: tekst) -> bool {
    la platform = platform_name()
    hvis platform == "" { returner usann }
    la suffix = ""
    hvis builtin.starts_with(platform, "windows-") { suffix = ".exe" }
    la asset = "norscode-" + platform + suffix
    la json = download_text("https://api.github.com/repos/" + release_repo() + "/releases/latest")
    la download_url = finn_download_url(json, asset)
    hvis download_url == "" { returner usann }
    hvis download_binary(download_url, out, root) {
        linje("kandidat lasta ned frå release (" + bytes(out) + " bytes)")
        returner sant
    }
    returner usann
}

funksjon promoter_atomisk(root: tekst, kandidat_rel: tekst, mål_rel: tekst) -> boolsk {
    la resultat = native_fs.native_erstatt_fil_atomisk(root, kandidat_rel, mål_rel)
    returner resultat["status"] == "replaced"
}

funksjon main() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la out = root + "/dist/norscode_native"
    la target = out
    hvis filesystem_list_enabled() { target = root + "/build/norscode_native_filesystem_list_candidate" }
    hvis executable(target) og smoke_check(root, target) og runtime_gap_check(root, target) og filesystem_list_check(root, target) {
        linje("dist/norscode_native er allereie bygget (" + kilobytes(out) + " KB)")
        returner 0
    }
    hvis ikkje filops.lag_katalogar(root + "/dist") eller ikkje filops.lag_katalogar(root + "/build") { returner 1 }
    la kandidat_rel = "build/norscode_native_materialize_candidate"
    hvis filesystem_list_enabled() { kandidat_rel = "build/norscode_native_filesystem_list_candidate" }
    la kandidat = root + "/" + kandidat_rel
    filops.slett_fil(kandidat)
    hvis ikkje copy_stage0_binary(root, kandidat) og ikkje download_release_binary(root, kandidat) {
        la platform = platform_name()
        hvis platform == "" { platform = "?" }
        linje("=== Kunne ikkje skaffe norscode_native utan C/Python ===")
        linje("Legg norscode-" + platform + " i bootstrap/stage0/ eller publiser ein release med ferdig native seed.")
        returner 1
    }
    hvis ikkje smoke_check(root, kandidat) eller ikkje runtime_gap_check(root, kandidat) eller ikkje filesystem_list_check(root, kandidat) {
        filops.slett_fil(kandidat)
        linje("Feil: norscode_native-kandidat feila verifisering")
        returner 1
    }
    hvis ikkje filesystem_list_enabled() {
        hvis ikkje promoter_atomisk(root, kandidat_rel, "dist/norscode_native") {
            filops.slett_fil(kandidat)
            linje("Feil: atomisk promotering av norscode_native feila")
            returner 1
        }
    }
    linje("Klar: native runtime er verifisert og atomisk materialisert utan C/Python.")
    returner 0
}

funksjon start() -> heiltall { returner main() }
