// Klassifiser aktiv shellflate med Norscode sitt native filesystem-ABI.
//
// Rapporten er eit migreringsgrunnlag, ikkje ei allowlist. Nye aktive
// shellfiler skal framleis bli avviste når active-surface-policyen blir stramma.

bruk std.runtime_filesystem som native_fs

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon legg_tre_filer(root: tekst, relativ: tekst, ut) -> heiltall {
    la listing = native_fs.native_list(root, relativ)
    hvis listing["status"] != "ok" {
        hvis builtin.ends_with(relativ, ".sh") { legg_til(ut, relativ) }
        returner 0
    }
    la barn = builtin.split(listing["data"], "\n")
    la i: heiltall = 0
    mens i < lengde(barn) {
        la namn = builtin.trim(barn[i])
        hvis namn != "" {
            la sti = namn
            hvis relativ != "" { sti = relativ + "/" + namn }
            legg_tre_filer(root, sti, ut)
        }
        i = i + 1
    }
    returner 0
}

funksjon sortert(verdiar) {
    la pass: heiltall = 0
    mens pass < lengde(verdiar) {
        la i: heiltall = 0
        mens i + 1 < lengde(verdiar) - pass {
            hvis verdiar[i] > verdiar[i + 1] {
                la tmp = verdiar[i]
                verdiar[i] = verdiar[i + 1]
                verdiar[i + 1] = tmp
            }
            i = i + 1
        }
        pass = pass + 1
    }
    returner verdiar
}

funksjon inneheld_eitt(sti: tekst, ord) -> bool {
    la i: heiltall = 0
    mens i < lengde(ord) {
        hvis builtin.index_of(sti, ord[i]) >= 0 { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon kategori(sti: tekst) -> tekst {
    la låg = builtin.lower(sti)
    hvis inneheld_eitt(låg, ["windows", "linux", "macos", "docker", "notarize", "sign-"]) {
        returner "plattform"
    }
    hvis inneheld_eitt(låg, ["release", "package-", "install", "fetch_stage0", "backup_", "promote_", "promotion", "rollback_", "update_stage0"]) {
        returner "release"
    }
    hvis builtin.starts_with(låg, "tests/") eller
       inneheld_eitt(låg, ["/test_", "/smoke_", "/probe_", "/check_", "/verify_", "_gate", "_guard", "validator", "readiness", "status_"]) {
        returner "test"
    }
    hvis inneheld_eitt(låg, ["build", "compile", "bundle", "bootstrap", "regenerate", "refresh_", "generate_", "ncb_to_elf", "selfcompile"]) {
        returner "bygg"
    }
    returner "wrapper"
}

funksjon no_eigar(root: tekst, sti: tekst) -> tekst {
    la stem = builtin.slice(sti, 0, lengde(sti) - 3)
    la kandidat = stem + ".no"
    hvis fil_finst(root + "/" + kandidat) { returner kandidat }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la filer = []
    hvis fil_finst(root + "/package-release.sh") { legg_til(filer, "package-release.sh") }
    legg_tre_filer(root, "scripts", filer)
    legg_tre_filer(root, "tests", filer)
    legg_tre_filer(root, "tools", filer)
    filer = sortert(filer)

    la teljar = {"wrapper": 0, "test": 0, "bygg": 0, "release": 0, "plattform": 0}
    la med_eigar: heiltall = 0
    la postar = []
    la i: heiltall = 0
    mens i < lengde(filer) {
        la kat = kategori(filer[i])
        teljar[kat] = teljar[kat] + 1
        la eigar = no_eigar(root, filer[i])
        hvis eigar != "" { med_eigar = med_eigar + 1 }
        legg_til(postar, {"sti": filer[i], "kategori": kat, "no_eigar": eigar})
        i = i + 1
    }

    la rapport = {
        "schema": "norscode-shell-surface-v1",
        "total": lengde(filer),
        "med_no_eigar": med_eigar,
        "utan_no_eigar": lengde(filer) - med_eigar,
        "kategoriar": teljar,
        "filer": postar
    }
    la utfil = root + "/reports/shell-surface-inventory.json"
    prøv { builtin.mkdir_p(root + "/reports") } fang (e) {
        skriv("FEIL: kan ikkje opprette reports/: " + tekst(e) + "\n")
        returner 1
    }
    builtin.fil_skriv(utfil, builtin.json_stringify(rapport))
    skriv("Shellflate: " + tekst_fra_heiltall(lengde(filer)) + " filer\n")
    skriv("  wrapper=" + tekst_fra_heiltall(teljar["wrapper"]) +
          " test=" + tekst_fra_heiltall(teljar["test"]) +
          " bygg=" + tekst_fra_heiltall(teljar["bygg"]) +
          " release=" + tekst_fra_heiltall(teljar["release"]) +
          " plattform=" + tekst_fra_heiltall(teljar["plattform"]) + "\n")
    skriv("  med .no-eigar=" + tekst_fra_heiltall(med_eigar) +
          " utan .no-eigar=" + tekst_fra_heiltall(lengde(filer) - med_eigar) + "\n")
    skriv("Rapport: " + utfil + "\n")
    returner 0
}

