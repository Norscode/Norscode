// tools/selfcompile_native_elf.no — shellfri Omgang 6 A→B ELF sjølvkompilering

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) { returner "0" }
    returner "0"
}

funksjon første_forskjellar(sti_a: tekst, sti_b: tekst, maks: heiltall) -> tekst {
    la a = builtin.fil_les_binær(sti_a)
    la b = builtin.fil_les_binær(sti_b)
    la min_lengd = lengde(a)
    hvis lengde(b) < min_lengd { min_lengd = lengde(b) }
    la out = ""
    la funne = 0
    la i = 0
    mens i < min_lengd og funne < maks {
        hvis a[i] != b[i] {
            out = out + tekst_fra_heiltall(i + 1) + " " + tekst_fra_heiltall(a[i]) + " " + tekst_fra_heiltall(b[i]) + "\n"
            funne = funne + 1
        }
        i = i + 1
    }
    hvis funne < maks og lengde(a) != lengde(b) {
        out = out + "length " + tekst_fra_heiltall(lengde(a)) + " " + tekst_fra_heiltall(lengde(b)) + "\n"
    }
    hvis out == "" { returner "Ingen lesbare forskjellar funne\n" }
    returner out
}

funksjon filer_identiske(sti_a: tekst, sti_b: tekst) -> bool {
    hvis ikkje fil_finst(sti_a) eller ikkje fil_finst(sti_b) { returner usann }
    returner builtin.fil_les_binær(sti_a) == builtin.fil_les_binær(sti_b)
}

funksjon run(root: tekst, argv: liste_tekst, timeout_ms: heiltall) -> bool {
    la miljø = {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    la resultat = prosess.køyr(root + "/bin/nc", argv, root, miljø, timeout_ms)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon native_target() -> tekst {
    la info = builtin.system_info()
    la system = tekst(info["system"])
    la machine = tekst(info["machine"])
    hvis system == "Darwin" og (machine == "arm64" eller machine == "x86_64") { returner "linux-x86_64" }
    hvis system == "Linux" og (machine == "x86_64" eller machine == "amd64") { returner "linux-x86_64" }
    hvis system == "Linux" og (machine == "aarch64" eller machine == "arm64") { returner "linux-arm64" }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la src = root + "/tests/fixtures/omgang6_selfcompile.no"
    la v1 = root + "/build/omgang6/elf_v1"
    la v2 = root + "/build/omgang6/elf_v2"
    la target = native_target()
    hvis target == "" { linje("Feil: bygg-native manglar støtta mål for denne verten") returner 1 }
    hvis ikkje filops.lag_katalogar(root + "/build/omgang6") { returner 1 }
    hvis ikkje fil_finst(src) { linje("Feil: manglar " + src) returner 1 }
    hvis ikkje executable(root + "/dist/norscode_native") {
        linje("Manglar dist/norscode_native. Køyrer: ./bin/nc fetch-stage0-seed")
        hvis ikkje run(root, ["fetch-stage0-seed"], 300000) { returner 1 }
    }

    linje("=== Omgang 6 ELF sjølvkompilering ===")
    linje("")
    linje("[1/3] Gen1: bygg-native...")
    hvis ikkje run(root, ["bygg-native", "--target", target, src, v1], 600000) { returner 1 }
    la b1 = bytes(v1)
    linje("  [OK] " + b1 + " bytes")
    linje("")
    linje("[2/3] Gen2: bygg-native (same kilde)...")
    hvis ikkje run(root, ["bygg-native", "--target", target, src, v2], 600000) { returner 1 }
    la b2 = bytes(v2)
    linje("  [OK] " + b2 + " bytes")
    linje("")
    linje("[3/3] Byte-paritet Gen1 == Gen2...")
    hvis filer_identiske(v1, v2) {
        linje("  [OK] " + b1 + " bytes identiske")
        linje("")
        linje("=== Omgang 6 ELF sjølvkompilering: BESTÅTT ===")
        returner 0
    }
    linje("  [FEIL] ELF differ (v1=" + b1 + ", v2=" + b2 + " bytes)")
    skriv(første_forskjellar(v1, v2, 5))
    returner 1
}
