// tools/opcode_matrise.no — Omgang 2: opcode/builtin-støttematrise.
//
// Skannar tolk-VM-en + dei to AOT-backendane + kompilator-emisjonen og skriv
// ut kva opcodar kvar handterer: {emittert av kompilator} × {tolk, AOT-x86,
// AOT-arm64}. Reint fil-/streng-arbeid — importerer ikkje vm, køyrer raskt.
//
// Bruk:  ./bin/nc run tools/opcode_matrise.no

funksjon er_opcode(ord: tekst) -> bool {
    hvis lengde(ord) < 2 { returner usann }
    la i = 0
    mens i < lengde(ord) {
        la c = ord[i]
        hvis ikkje ((c >= "A" og c <= "Z") eller c == "_") { returner usann }
        i = i + 1
    }
    returner sann
}

// Ekstraher alle "STORE_KONSTANT" i linjer som inneheld ein markør.
funksjon opcodes_frå(sti: tekst, markør: tekst) -> ordbok {
    la sett: ordbok = {}
    la innhald = ""
    prøv { innhald = builtin.fil_les(sti) } fang (e) { returner sett }
    la linjer = builtin.split(innhald, "\n")
    la li = 0
    mens li < lengde(linjer) {
        la l = linjer[li]
        hvis builtin.contains(l, markør) {
            la j = 0
            mens j < lengde(l) {
                hvis l[j] == "\"" {
                    la k = j + 1
                    la ord = ""
                    mens k < lengde(l) og l[k] != "\"" {
                        ord = ord + l[k]
                        k = k + 1
                    }
                    hvis er_opcode(ord) { sett[ord] = sann }
                    j = k + 1
                } ellers {
                    j = j + 1
                }
            }
        }
        li = li + 1
    }
    returner sett
}

funksjon merke(sett: ordbok, op: tekst) -> tekst {
    hvis finnes_nøkkel(sett, op) { returner " JA " }
    returner "  . "
}

funksjon start() -> heiltall {
    la emit  = opcodes_frå("selfhost/compiler/ir_to_bytecode.no", "PUSH_CONST")
    // Kompilator-emisjon er spreidd; suppler med kjend union frå backendane.
    la tolk  = opcodes_frå("selfhost/vm.no", "op == \"")
    la x86   = opcodes_frå("selfhost/native_execution/native_codegen_v2.no", "op == \"")
    la arm   = opcodes_frå("selfhost/native_execution/macho_arm64_codegen.no", "op == \"")

    // Union av alle opcodar vi kjenner.
    la alle: ordbok = {}
    la kjelder = [tolk, x86, arm, emit]
    la ki = 0
    mens ki < lengde(kjelder) {
        la ks = builtin.nøkler(kjelder[ki])
        la kj = 0
        mens kj < lengde(ks) { alle[ks[kj]] = sann  kj = kj + 1 }
        ki = ki + 1
    }
    // Manuelt kjende M3-opcodar som kompilatoren emitterer.
    alle["BUILD_LAMBDA"] = sann
    alle["CALL_VALUE"] = sann

    la namn = builtin.nøkler(alle)
    // Enkel innsettingssortering (alfabetisk).
    la n = lengde(namn)
    la a = 0
    mens a < n {
        la b = a + 1
        mens b < n {
            hvis namn[b] < namn[a] {
                la t = namn[a]  namn[a] = namn[b]  namn[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }

    skriv("# Opcode-støttematrise (tolk vs AOT)\n\n")
    skriv("| opcode | TOLK | AOT-x86 | AOT-arm64 |\n")
    skriv("|---|:--:|:--:|:--:|\n")
    la mangel_aot = 0
    la i = 0
    mens i < lengde(namn) {
        la op = namn[i]
        skriv("| " + op + " |" + merke(tolk, op) + "|" + merke(x86, op) + "|" + merke(arm, op) + "|\n")
        hvis finnes_nøkkel(tolk, op) og ikkje (finnes_nøkkel(x86, op) og finnes_nøkkel(arm, op)) {
            mangel_aot = mangel_aot + 1
        }
        i = i + 1
    }
    skriv("\nTotalt opcodar: " + tekst(lengde(namn)) +
          " · tolk-støtta men ikkje full AOT: " + tekst(mangel_aot) + "\n")
    returner 0
}
