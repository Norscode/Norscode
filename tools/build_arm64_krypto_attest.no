// Byggjer den native ARM64 krypto/TLS-attestasjonsbinæren frå ei førkompilert NCB
// via Norscode sin eigen AArch64-codegen (elf_arm64_codegen) — ingen gcc, ingen
// OpenSSL. Køyr med NORSCODE_USE_PRECOMPILED_SELFHOST=0 så kjelde-codegen (med
// alle 2026-08-rettingane) blir brukt, ikkje den førbygde bundlen.
bruk selfhost.native_execution.elf_arm64_codegen som elfcg

funksjon start() -> heiltall {
    la ncb = miljo_hent("ATTEST_NCB")
    la ut = miljo_hent("ATTEST_ELF")
    hvis ncb == "" eller ut == "" { skriv("Set ATTEST_NCB og ATTEST_ELF\n") returner 2 }
    la parsed = builtin.json_parse_raw(builtin.fil_les(ncb))
    la r = elfcg.kompiler_ncb(parsed, ut)
    hvis r["ok"] != "sann" { skriv("ELF-bygg feila: " + tekst(r["error"]) + "\n") returner 1 }
    assert(builtin.fil_sett_kjorbar(ut))
    skriv("Native ARM64-ELF bygd: " + ut + "\n")
    returner 0
}
