// tools/ci_proc_diag.no — prosess- og diskdiagnose mellom CI-steg
//
// Native macOS på promoteringsgreina vart 7–9 gonger tregare i alle steg ETTER
// den parallelle testlana (media-gate 2270 s mot 307 s på main), medan stega før
// held normal fart. Dette steget viser kva som framleis køyrer og kor mykje disk
// cachen tek, slik at ein attlevande prosess eller ein oppblåst cache blir synleg.
// Prosess-ABI-en gjer ikkje PATH-oppslag, så systemprogramma blir starta med
// absolutt sti.

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon vis(tittel: tekst, program: tekst, argv: liste_tekst, root: tekst, maks_linjer: heiltall) -> heiltall {
    linje("== " + tittel)
    la res = prosess.køyr_liste(program, argv, root, {}, 60000)
    hvis res[0] != "0" {
        linje("  (exit " + res[0] + ") " + res[2])
        returner 0
    }
    la linjer = builtin.split(res[1], "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) og i < maks_linjer {
        linje("  " + tekst(linjer[i]))
        i = i + 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    // Sortert på CPU-del; dei øvste radene er det som et maskina mellom stega.
    vis("prosessar etter CPU", "/bin/ps", ["-Ao", "pid,ppid,pcpu,rss,etime,command", "-r"], root, 25)
    vis("prosessar etter minne", "/bin/ps", ["-Ao", "pid,ppid,pcpu,rss,etime,command", "-m"], root, 12)
    vis("diskbruk", "/usr/bin/du", ["-sh", root + "/build", root + "/.norscode", "/tmp"], root, 10)
    vis("ledig disk", "/bin/df", ["-h", root], root, 4)
    returner 0
}
