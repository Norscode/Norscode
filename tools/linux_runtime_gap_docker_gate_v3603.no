// Verifiser Linux-kandidat i faktisk Linux-container utan shelltekst.

bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la kandidat = env("NORSCODE_LINUX_CANDIDATE")
    hvis kandidat == "" {
        kandidat = root + "/build/v9646/norscode_native_linux_x86_64_embedded_payload"
        hvis ikkje builtin.fil_finnes(kandidat) {
            kandidat = root + "/build/v9630/norscode_native_linux_x86_64_embedded"
        }
    }
    la kandidat_rel = kandidat
    la prefix = root + "/"
    hvis builtin.starts_with(kandidat, prefix) {
        kandidat_rel = builtin.slice(kandidat, lengde(prefix), lengde(kandidat))
    }
    hvis kandidat_rel == "" eller builtin.starts_with(kandidat_rel, "/") {
        skriv("[FAIL] ugyldig Linux-kandidatsti\n")
        returner 1
    }
    la image = env("NORSCODE_DOCKER_IMAGE")
    hvis image == "" { image = "ubuntu:24.04" }
    la platform = env("NORSCODE_DOCKER_PLATFORM")
    hvis platform == "" { platform = "linux/amd64" }
    la docker = docker_runner.finn()
    hvis ikkje docker_runner.tilgjengeleg(docker, root) { skriv("[FAIL] Docker er ikkje tilgjengeleg\n") returner 1 }
    la container = docker_runner.opprett(docker, root, root, platform, image, "runtime-gap-v3603")
    hvis container == "" { returner 1 }
    hvis ikkje docker_runner.start(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    la argv: liste_tekst = [
        "env", "NORSCODE_CMD=run",
        "NORSCODE_FILE=/work/tools/native_runtime_gap_gate_v3001.no",
        "NORSCODE_ROOT=/work", "NORSCODE_NATIVE_GAP_BIN=/work/" + kandidat_rel,
        "NORSCODE_ENABLE_EXEC_PROSESS=1",
        "NORSCODE_VM_CAPABILITIES=env.read,process.exec,disk.read,disk.write,net.listen,net.connect,net.tcp,net.udp,net.dns",
        "NORSCODE_VM_DISK_ROOT=/work,.,/tmp,/private/tmp", "/work/" + kandidat_rel
    ]
    la resultat = docker_runner.køyr_i(docker, root, container, argv, 600000)
    prosess.skriv_resultat(resultat)
    docker_runner.fjern(docker, root, container)
    hvis ikkje prosess.ok(resultat) {
        skriv("[FAIL] Linux runtime-gap Docker-gate feila for " + platform + "\n")
        returner 1
    }
    skriv("[OK] Linux runtime-gap Docker-gate er grøn for " + platform + "\n")
    returner 0
}
