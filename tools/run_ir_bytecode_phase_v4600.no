// tools/run_ir_bytecode_phase_v4600.no — shellfri IR/bytecode compile- og runtimefase

bruk std.filops som filops
bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon has(sti: tekst, needle: tekst) -> bool {
    prøv { returner builtin.index_of(builtin.fil_les(sti), needle) >= 0 }
    fang (e) { returner usann }
    returner usann
}

funksjon skriv_logg(sti: tekst, resultat: ordbok_tekst) -> heiltall {
    la body = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    builtin.fil_skriv(sti, body)
    hvis body != "" { skriv(body) }
    returner 0
}

funksjon assert_ncb(sti: tekst) -> bool {
    returner has(sti, "\"entry\"") og has(sti, "\"functions\"")
}

funksjon base_no(src: tekst) -> tekst {
    la delar = builtin.split(src, "/")
    la base = delar[lengde(delar) - 1]
    hvis builtin.ends_with(base, ".no") { returner builtin.slice(base, 0, lengde(base) - 3) }
    returner base
}

funksjon compile_one(root: tekst, bin_path: tekst, src: tekst, tag: tekst) -> bool {
    la out_dir = root + "/build/v4600"
    la base = base_no(src)
    la out = out_dir + "/" + tag + "_" + base + ".ncb.json"
    la log = out_dir + "/" + tag + "_" + base + "_compile.log"
    la miljø = {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": root + "/" + src, "NORSCODE_OUTPUT": out
    }
    la resultat = prosess.køyr(bin_path, [], root, miljø, 180000)
    skriv_logg(log, resultat)
    hvis ikkje prosess.ok(resultat) eller ikkje builtin.fil_finnes(out) eller ikkje assert_ncb(out) { returner usann }
    linje("[OK] " + tag + " compile: " + src + " -> " + out)
    returner sann
}

funksjon valider_runtime(log: tekst, tag: tekst) -> boolsk {
    hvis ikkje has(log, "ir bytecode runtime v4600") { returner usann }
    hvis has(log, "SKAL_IKKJE") {
        linje("[FAIL] " + tag + " runtime fixture viste uoppnåeleg kode etter returner")
        returner usann
    }
    hvis ikkje has(log, "retur_utan_verdi OK") { returner usann }
    hvis ikkje has(log, "loop_test OK: 8") { returner usann }
    hvis ikkje has(log, "try_fang OK: fanga:boom") { returner usann }
    linje("[OK] " + tag + " runtime fixture grøn")
    returner sann
}

funksjon run_fixture(root: tekst, bin_path: tekst, tag: tekst) -> bool {
    la fixture = root + "/tests/fixtures/ir_bytecode_runtime_v4600.no"
    la log = root + "/build/v4600/" + tag + "_runtime.log"
    la miljø = {"NORSCODE_ROOT": root, "NORSCODE_CMD": "run", "NORSCODE_FILE": fixture}
    la resultat = prosess.køyr(bin_path, [], root, miljø, 120000)
    skriv_logg(log, resultat)
    hvis ikkje prosess.ok(resultat) { returner usann }
    returner valider_runtime(log, tag)
}

funksjon files() -> liste_tekst {
    returner ["selfhost/vm.no", "selfhost/bundler.no", "selfhost/nc_main.no"]
}

funksjon run_linux_docker(root: tekst, docker: tekst) -> bool {
    la container = docker_runner.opprett_ubuntu(docker, root, root, "linux/amd64", "ir-bytecode-v4600")
    hvis container == "" { returner usann }
    hvis ikkje docker_runner.start(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner usann
    }
    hvis ikkje docker_runner.installer_sqlite_runtime(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner usann
    }
    for src i files() {
        la base = base_no(src)
        la out = root + "/build/v4600/linux_stage0_" + base + ".ncb.json"
        la log = root + "/build/v4600/linux_stage0_" + base + "_compile.log"
        la argv: liste_tekst = [
            "env", "NORSCODE_ROOT=/work", "NORSCODE_CMD=compile",
            "NORSCODE_FILE=/work/" + src,
            "NORSCODE_OUTPUT=/work/build/v4600/linux_stage0_" + base + ".ncb.json",
            "/work/bootstrap/stage0/norscode-linux-x86_64"
        ]
        la resultat = docker_runner.køyr_i(docker, root, container, argv, 180000)
        skriv_logg(log, resultat)
        hvis ikkje prosess.ok(resultat) eller ikkje builtin.fil_finnes(out) eller ikkje assert_ncb(out) {
            docker_runner.fjern(docker, root, container)
            returner usann
        }
        linje("[OK] linux_stage0 compile: " + src + " -> " + out)
    }

    la runtime_log = root + "/build/v4600/linux_stage0_runtime.log"
    la runtime_argv: liste_tekst = [
        "env", "NORSCODE_ROOT=/work", "NORSCODE_CMD=run",
        "NORSCODE_FILE=/work/tests/fixtures/ir_bytecode_runtime_v4600.no",
        "/work/bootstrap/stage0/norscode-linux-x86_64"
    ]
    la runtime = docker_runner.køyr_i(docker, root, container, runtime_argv, 120000)
    skriv_logg(runtime_log, runtime)
    docker_runner.fjern(docker, root, container)
    hvis ikkje prosess.ok(runtime) { returner usann }
    returner valider_runtime(runtime_log, "linux_stage0")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    hvis ikkje filops.lag_katalogar(root + "/build/v4600") { returner 1 }

    linje("== v4600 ir/bytecode phase ==")
    linje("")
    linje("[1/3] macOS active dist large selfhost compile gate")
    for src i files() {
        hvis ikkje compile_one(root, root + "/dist/norscode_native", src, "macos_dist") { returner 1 }
    }
    linje("")
    linje("[2/3] macOS active dist IR runtime fixture")
    hvis ikkje run_fixture(root, root + "/dist/norscode_native", "macos_dist") { returner 1 }

    la docker = docker_runner.finn()
    hvis docker_runner.tilgjengeleg(docker, root) {
        linje("")
        linje("[3/3] Linux x86_64 stage0 compile+runtime gate (Docker)")
        hvis ikkje run_linux_docker(root, docker) { returner 1 }
    } ellers {
        linje("")
        linje("[SKIP] Docker er ikkje tilgjengeleg.")
    }
    linje("")
    linje("[OK] v4600 ir/bytecode phase ferdig.")
    returner 0
}
