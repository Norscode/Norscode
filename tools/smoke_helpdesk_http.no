// tools/smoke_helpdesk_http.no — Helpdesk HTTP runtime-smoke

bruk std.http som http

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon request(base: tekst, metode: tekst, path: tekst, headers: ordbok_tekst, body: tekst, timeout_ms: heiltall) -> tekst {
    prøv {
        returner http.request_full(metode, base + path, headers, {}, body, timeout_ms)
    } fang (e) {
        linje("FEIL: HTTP-kall til " + path + " feila: " + tekst(e))
        returner ""
    }
}

funksjon assert_status(namn: tekst, response: tekst, venta: heiltall) -> bool {
    la faktisk: heiltall = 0
    hvis response != "" { faktisk = http.response_status(response) }
    hvis faktisk == venta { returner sann }

    linje("FEIL: " + namn + " forventet status " + tekst_fra_heltall(venta) + ", fikk " + tekst_fra_heltall(faktisk))
    hvis response != "" {
        la body = http.response_text(response)
        hvis body != "" { linje("Svarkropp: " + body) }
    }
    returner usann
}

funksjon krev(namn: tekst, response: tekst, venta: heiltall) -> bool {
    returner assert_status(namn, response, venta)
}

funksjon start() -> heiltall {
    la base = env("NORSCODE_HELPDESK_BASE_URL")
    hvis base == "" { base = "http://127.0.0.1:4173" }

    la api = {"X-API-Key": "secret-helpdesk"}
    la admin = {"X-API-Key": "secret-helpdesk", "X-Role": "admin"}
    la agent = {"X-API-Key": "secret-helpdesk", "X-Role": "agent"}
    la agent_lena = {"X-API-Key": "secret-helpdesk", "X-Role": "agent", "X-user": "lena"}
    la user = {"X-Role": "user"}
    la json_agent = {"X-API-Key": "secret-helpdesk", "X-Role": "agent", "Content-Type": "application/json"}
    la json_agent_lena = {"X-API-Key": "secret-helpdesk", "X-Role": "agent", "X-user": "lena", "Content-Type": "application/json"}

    linje("=== Helpdesk HTTP smoke ===")
    linje("Base-url: " + base)

    la health = request(base, "GET", "/health", api, "", 2000)
    hvis health == "" {
        linje("FEIL: klarte ikkje nå " + base + "/health. Start server på 4173 først.")
        returner 1
    }

    hvis ikkje krev("health", health, 200) { returner 1 }
    hvis ikkje krev("tickets", request(base, "GET", "/tickets", api, "", 10000), 200) { returner 1 }
    hvis ikkje krev("tickets-invalid-sort", request(base, "GET", "/tickets?sort=bad-sort", admin, "", 10000), 400) { returner 1 }
    hvis ikkje krev("tickets-invalid-limit", request(base, "GET", "/tickets?limit=abc", admin, "", 10000), 400) { returner 1 }
    hvis ikkje krev("tickets-id-invalid", request(base, "GET", "/tickets/bad-id", agent_lena, "", 10000), 404) { returner 1 }

    hvis ikkje krev("admin-users", request(base, "GET", "/admin/users", api, "", 10000), 200) { returner 1 }
    hvis ikkje krev("admin-roles-user", request(base, "GET", "/admin/roles", user, "", 10000), 403) { returner 1 }
    hvis ikkje krev("admin-roles-no-auth", request(base, "GET", "/admin/roles", {}, "", 10000), 401) { returner 1 }
    hvis ikkje krev("admin-roles", request(base, "GET", "/admin/roles", api, "", 10000), 200) { returner 1 }
    hvis ikkje krev("agent-close-admin-ticket", request(base, "PATCH", "/admin/tickets/1", json_agent_lena, "{\"status\":\"closed\"}", 10000), 403) { returner 1 }
    hvis ikkje krev("admin-metrics", request(base, "GET", "/admin/metrics", api, "", 10000), 200) { returner 1 }
    hvis ikkje krev("admin-panel", request(base, "GET", "/admin/panel", api, "", 10000), 200) { returner 1 }
    hvis ikkje krev("admin-roles-user-repeat", request(base, "GET", "/admin/roles", user, "", 10000), 403) { returner 1 }
    hvis ikkje krev("agent-close-admin-ticket-no-user", request(base, "PATCH", "/admin/tickets/1", json_agent, "{\"status\":\"closed\"}", 10000), 403) { returner 1 }

    linje("OK: Helpdesk HTTP smoke klar")
    returner 0
}
