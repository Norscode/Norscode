// Kompiler éi levande kjeldefil med eksplisitt modulnamn utan å bundle
// importgrafen. Nyttig for isolerte kandidat-/regresjonsfragment.
bruk selfhost.kompiler som komp

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la src = env("NORSCODE_SINGLE_SRC")
    la out = env("NORSCODE_SINGLE_OUT")
    la modul = env("NORSCODE_SINGLE_MODULE")
    hvis src == "" eller out == "" eller modul == "" {
        skriv("[FAIL] NORSCODE_SINGLE_SRC/OUT/MODULE manglar\n")
        returner 2
    }
    la ncb = komp.kompiler_fil(fil_les(src), modul)
    builtin.fil_skriv(out, ncb)
    skriv("[OK] single-module " + modul + " -> " + out + "\n")
    returner 0
}
