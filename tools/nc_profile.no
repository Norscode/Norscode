// tools/nc_profile.no — `nc profile <fil.no> [--topp N] [--ut rapport.json] [--trace trace.json]` (F44).
//
// Køyrer programmet i VM-en (standardmodus, utan JIT) og skriv ein funksjonsprofil
// etter køyringa: kall, instruksjonar og vegg-tid (inkludert kalla funksjonar) per
// funksjon, sortert etter tid. Bygd på VM-ens eksisterande metrikkar
// (function_calls./function_instructions./function_wall_ms.) — ingen ny teljar.
// Tvinga standardmodus utan JIT går via køyr_ncb_dekning, so dei samme instruksjonane
// blir telt som i vanleg køyring. --trace skriv Chrome-trace (chrome://tracing).
//
// Argument frå NC_VERKTOY_ARGV (linjeskild).

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon args() -> liste_tekst {
    la rå = env("NC_VERKTOY_ARGV")
    la ut: liste_tekst = []
    hvis rå == "" { returner ut }
    la delar = builtin.split(rå, "\n")
    la i = 0
    mens i < lengde(delar) {
        hvis delar[i] != "" { legg_til(ut, delar[i]) }
        i = i + 1
    }
    returner ut
}

funksjon tal_av(kart, nøkkel: tekst) -> heiltall {
    hvis ikkje finnes_nøkkel(kart, nøkkel) { returner 0 }
    returner heltall_fra_tekst(tekst(kart[nøkkel]))
}

// → liste av {"fn","kall","instr","ms"} sortert etter ms (så instr) fallande.
funksjon profil_rader(metrics) -> liste {
    la rader = []
    la ks = nøkler(metrics)
    la pref = "function_calls."
    la i = 0
    mens i < lengde(ks) {
        la k = tekst(ks[i])
        hvis builtin.starts_with(k, pref) {
            la fn = builtin.slice(k, lengde(pref), lengde(k))
            legg_til(rader, {
                "fn": fn,
                "kall": tal_av(metrics, k),
                "instr": tal_av(metrics, "function_instructions." + fn),
                "ms": tal_av(metrics, "function_wall_ms." + fn)
            })
        }
        i = i + 1
    }
    la a = 0
    mens a < lengde(rader) {
        la b = a + 1
        mens b < lengde(rader) {
            hvis rader[b]["ms"] > rader[a]["ms"] eller (rader[b]["ms"] == rader[a]["ms"] og rader[b]["instr"] > rader[a]["instr"]) {
                la t = rader[a]
                rader[a] = rader[b]
                rader[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    returner rader
}

funksjon pad(t: tekst, n: heiltall) -> tekst {
    la ut = t
    mens lengde(ut) < n { ut = " " + ut }
    returner ut
}

funksjon formater(rader: liste, topp: heiltall, metrics) -> tekst {
    la ut = "Funksjonsprofil (tid er inkludert kalla funksjonar)\n"
    ut = ut + pad("kall", 10) + pad("instr", 12) + pad("ms", 8) + "  funksjon\n"
    la n = lengde(rader)
    hvis topp > 0 og topp < n { n = topp }
    la i = 0
    mens i < n {
        la r = rader[i]
        ut = ut + pad(tekst_fra_heltall(r["kall"]), 10) + pad(tekst_fra_heltall(r["instr"]), 12) +
            pad(tekst_fra_heltall(r["ms"]), 8) + "  " + tekst(r["fn"]) + "\n"
        i = i + 1
    }
    ut = ut + "Totalt: " + tekst_fra_heltall(tal_av(metrics, "instructions")) + " instruksjonar, " +
        tekst_fra_heltall(tal_av(metrics, "calls")) + " kall\n"
    returner ut
}

funksjon start() -> heiltall {
    la a = args()
    la fil = ""
    la topp = 20
    la ut_json = ""
    la trace = ""
    la i = 0
    mens i < lengde(a) {
        hvis a[i] == "--topp" og i + 1 < lengde(a) { topp = heltall_fra_tekst(a[i + 1])  i = i + 1 }
        ellers hvis a[i] == "--ut" og i + 1 < lengde(a) { ut_json = a[i + 1]  i = i + 1 }
        ellers hvis a[i] == "--trace" og i + 1 < lengde(a) { trace = a[i + 1]  i = i + 1 }
        ellers { fil = a[i] }
        i = i + 1
    }
    hvis fil == "" {
        skriv("bruk: nc profile <fil.no> [--topp N] [--ut rapport.json] [--trace trace.json]\n")
        returner 2
    }
    hvis ikkje builtin.fil_finnes(fil) {
        skriv("nc profile: finn ikkje fil " + fil + "\n")
        returner 2
    }
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(builtin.fil_les(fil), "__main__"))
    miljo_sett("NORSCODE_VM_FAST", "0")
    la res = vm.køyr_ncb_dekning(ncb)
    la functions = ncb["functions"]
    la metrics = functions["__vm_metrics__"]
    la rader = profil_rader(metrics)
    skriv(formater(rader, topp, metrics))
    hvis ut_json != "" { builtin.fil_skriv(ut_json, builtin.json_stringify(rader)) }
    hvis trace != "" {
        builtin.fil_skriv(trace, builtin.json_stringify({"traceEvents": functions["__vm_trace_events__"], "displayTimeUnit": "ms"}))
    }
    returner 0
}
