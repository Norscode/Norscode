// tools/nc_pkg.no — `nc pkg`: pakkehandtering med register og låsefil
//
// Argumenta kjem frå nc_main via NORSCODE_PKG_ARGV (eitt argument per linje).
// All logikk ligg i tools/pkg_kjerne.no. Sjå docs/PAKKER.md.

bruk tools.pkg_kjerne som pk

funksjon hjelp() -> heiltall {
    skriv("bruk: nc pkg <kommando> [argument]\n")
    skriv("  init [namn]                    opprett norcode.toml\n")
    skriv("  add <namn>[@krav]              legg til avhengnad (^1.2, ~1.2, >=1,<2, 1.2.3), løys, lås og installer\n")
    skriv("  remove <namn>                  fjern avhengnad\n")
    skriv("  install [--frozen]             installer eksakt etter norscode.lock (verifiserer sjekksum)\n")
    skriv("  update [namn]                  løys på nytt til nyaste tillatne versjonar\n")
    skriv("  publish                        pakk katalogen og last opp til registeret\n")
    skriv("  search [tekst]                 søk i registeret\n")
    skriv("  register-serve <mappe> [--port N] [--host H]   referanse-registertenar\n")
    skriv("  env                            skriv NORSCODE_PATH for installerte pakkar\n")
    skriv("flagg: --register <url|mappe>   (elles NORSCODE_PKG_REGISTER eller [registry] url)\n")
    returner 0
}

funksjon start() -> heiltall {
    la råe = builtin.split(pk.env("NORSCODE_PKG_ARGV"), "\n")
    la args: liste_tekst = []
    la i = 0
    mens i < lengde(råe) {
        hvis råe[i] != "" { legg_til(args, råe[i]) }
        i = i + 1
    }
    la prosjekt = pk.env("NORSCODE_PKG_PROSJEKT")
    hvis prosjekt == "" { prosjekt = "." }

    // flagg og posisjonsargument
    la pos: liste_tekst = []
    la reg_flagg = ""
    la frossen = usann
    la port = 8787
    la vert = "127.0.0.1"
    i = 0
    mens i < lengde(args) {
        la a = args[i]
        hvis a == "--register" og i + 1 < lengde(args) {
            reg_flagg = args[i + 1]
            i = i + 1
        } ellers hvis a == "--frozen" { frossen = sann }
        ellers hvis a == "--port" og i + 1 < lengde(args) {
            port = heltall_fra_tekst(args[i + 1])
            i = i + 1
        } ellers hvis a == "--host" og i + 1 < lengde(args) {
            vert = args[i + 1]
            i = i + 1
        } ellers { legg_til(pos, a) }
        i = i + 1
    }
    hvis lengde(pos) == 0 { returner hjelp() }
    la kmd = pos[0]
    prøv {
        hvis kmd == "help" eller kmd == "--help" eller kmd == "-h" { returner hjelp() }
        hvis kmd == "init" {
            la namn = ""
            hvis lengde(pos) > 1 { namn = pos[1] }
            ellers {
                namn = pk.env("NORSCODE_PKG_NAMN")
                hvis namn == "" { namn = "pakke" }
            }
            skriv(pk.pkg_init(prosjekt, namn) + "\n")
            returner 0
        }
        hvis kmd == "env" {
            skriv(".norscode/pakkar\n")
            returner 0
        }
        hvis kmd == "register-serve" {
            hvis lengde(pos) < 2 { skriv("bruk: nc pkg register-serve <mappe> [--port N]\n")
                returner 2 }
            pk.register_lytt_og_betjen(pos[1], vert, port)
            returner 0
        }
        la reg = pk.register_for(prosjekt, reg_flagg)
        hvis kmd == "search" {
            la q = ""
            hvis lengde(pos) > 1 { q = pos[1] }
            la rader = pk.pkg_søk(reg, q)
            la r = 0
            mens r < lengde(rader) {
                skriv(rader[r] + "\n")
                r = r + 1
            }
            returner 0
        }
        hvis kmd == "publish" {
            la r = pk.pkg_publiser(prosjekt, reg)
            skriv("publisert " + tekst(r["namn"]) + "@" + tekst(r["versjon"]) + " sha256=" + tekst(r["sha256"]) + "\n")
            returner 0
        }
        la ut: liste_tekst = []
        hvis kmd == "add" {
            hvis lengde(pos) < 2 { skriv("bruk: nc pkg add <namn>[@krav]\n")
                returner 2 }
            la namn = pos[1]
            la spec = ""
            la at = builtin.index_of(namn, "@")
            hvis at > 0 {
                spec = builtin.slice(namn, at + 1, lengde(namn))
                namn = builtin.slice(namn, 0, at)
            }
            ut = pk.pkg_add(prosjekt, reg, namn, spec)
        } ellers hvis kmd == "remove" {
            hvis lengde(pos) < 2 { skriv("bruk: nc pkg remove <namn>\n")
                returner 2 }
            ut = pk.pkg_remove(prosjekt, reg, pos[1])
        } ellers hvis kmd == "install" {
            ut = pk.pkg_installer(prosjekt, reg, frossen, usann, "")
        } ellers hvis kmd == "update" {
            la namn = ""
            hvis lengde(pos) > 1 { namn = pos[1] }
            ut = pk.pkg_installer(prosjekt, reg, usann, namn == "", namn)
        } ellers {
            skriv("ukjend kommando: nc pkg " + kmd + "\n")
            hjelp()
            returner 2
        }
        la k = 0
        mens k < lengde(ut) {
            skriv("installert " + ut[k] + "\n")
            k = k + 1
        }
        skriv(tekst(lengde(ut)) + " pakke(r) installert i .norscode/pakkar\n")
        returner 0
    } fang (e) {
        skriv("feil: " + tekst(e) + "\n")
        returner 1
    }
    returner 0
}
