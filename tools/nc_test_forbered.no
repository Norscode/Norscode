// tools/nc_test_forbered.no — byggjer testkøyrar-NCB-en (oppdaging.forbered_ncb) i ein
// kortliva prosess for tools/nc_test.no.
//
// Kvifor eigen prosess: forbered_ncb dekodar heile test-NCB-en og kodar han på nytt
// (builtin.ncb_til_binaer). Kodinga lagar store, veksande blokker som den native GC-en
// ikkje får attbrukt i ein langliva prosess (first-fit på fri-lista finn ikkje dei store
// hola), so bump kryp (målt: ~45 MB per kall for ein 2,8 MB test-NCB, exit 199 etter 23
// kall). Slow-shardane på ~250 testar nådde HARD_LIMIT («GC-heap full», exit 199) i sjølve
// løparen. Her døyr heapen med prosessen etter kvar test.
//
// Miljø (alle påkravde): NC_FORBERED_NCB (inn), NC_FORBERED_UT (testkøyrar-NCB ut),
// NC_FORBERED_FRA (første test i planen), NC_FORBERED_MED_START ("1"/"0").
// Planen blir skriven til <NC_FORBERED_UT>.plan, éin test per linje. Feil går til stdout
// som «ERROR: …» og exit 1 — kallaren behandlar det som at testkøyraren ikkje kunne byggjast.

bruk tools.nc_test_oppdaging som oppdaging

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la ncb = env("NC_FORBERED_NCB")
    la ut = env("NC_FORBERED_UT")
    la frå_tekst = env("NC_FORBERED_FRA")
    hvis ncb == "" eller ut == "" eller frå_tekst == "" {
        skriv("ERROR: NC_FORBERED_NCB, NC_FORBERED_UT og NC_FORBERED_FRA må vere sette\n")
        returner 1
    }
    la plan: liste_tekst = []
    prøv {
        plan = oppdaging.forbered_ncb(ncb, ut, heltall_fra_tekst(frå_tekst), env("NC_FORBERED_MED_START") == "1")
    } fang (e) {
        skriv("ERROR: " + tekst(e) + "\n")
        returner 1
    }
    builtin.fil_skriv(ut + ".plan", builtin.join(plan, "\n"))
    returner 0
}
