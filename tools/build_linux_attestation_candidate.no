// Bygg Linux single-binary-kandidat gjennom strukturert Norscode-prosess-ABI.

bruk tools.process_runner som prosess
bruk std.runtime_filesystem som native_fs

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon sluttmarkør(bytes, markør: tekst) -> boolsk {
    hvis lengde(bytes) < lengde(markør) { returner usann }
    la start = lengde(bytes) - lengde(markør)
    la i = 0
    mens i < lengde(markør) {
        hvis bytes[start + i] != (builtin.char_code(markør[i]) & 255) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon har_embedded_ncb(sti: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        returner sluttmarkør(bytes, "NORSCODE_NCB_IMAGE_V1") eller sluttmarkør(bytes, "NORSCODE_NCB_TEXT_V1")
    } fang (e) { returner usann }
    returner usann
}

funksjon bygg_probe(root: tekst, native: tekst, output: tekst) -> boolsk {
    hvis output == "" { returner sann }
    la miljø: ordbok_tekst = {
        "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": root + "/tests/test_linux_runtime_attestation_probe.no",
        "NORSCODE_OUTPUT": output,
        "NORSCODE_ROOT": root
    }
    la resultat = prosess.køyr(native, [], root, miljø, 900000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) { returner usann }
    prøv { returner lengde(builtin.fil_les_binær(output)) > 32 } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/dist/norscode_native" }
    la output = env("NORSCODE_LINUX_ATTESTATION_CANDIDATE")
    hvis output == "" { output = root + "/build/norscode_native_linux_attested" }
    la probe_output = env("NORSCODE_LINUX_ATTESTATION_NCB")
    la byggmappe = native_fs.native_lag_mappe(root, "build")
    hvis byggmappe["status"] != "created" og byggmappe["status"] != "ok" og byggmappe["status"] != "exists" {
        skriv("[FAIL] Linux-kandidat kunne ikkje lage build-mappa\n")
        returner 1
    }
    // Linux-stage0-ane er allereie single-binary med embedded compiler/VM.
    // På historisk ARM64-stage0 unngår dette ei unødvendig stor binærkopi som
    // den gamle filskrivaren ikkje kan materialisere.
    hvis env("NORSCODE_LINUX_CANDIDATE_ALREADY_EMBEDDED") == "1" og output == native {
        hvis ikkje bygg_probe(root, native, probe_output) {
            skriv("[FAIL] Linux-attestasjonsprobe kunne ikkje kompilerast\n")
            returner 1
        }
        skriv("[OK] Linux single-binary attestasjonskandidat er allereie materialisert\n")
        returner 0
    }
    la miljø: ordbok_tekst = {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tools/embed_release_ncb.no",
        "NORSCODE_ROOT": root,
        "NORSCODE_EMBED_BASE": native,
        "NORSCODE_EMBED_OUT": output,
        "NORSCODE_EMBED_STREAM": "1",
        "NORSCODE_EMBED_SPECS": "compiler=" + root + "/bootstrap/kompiler.ncb.json;vm=" +
            root + "/bootstrap/precompiled/vm.ncb.json;vm-executor=" + root + "/selfhost/vm_executor.ncb.json"
    }
    la resultat = prosess.køyr(native, [], root, miljø, 300000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) { returner 1 }
    prøv {
        la bytes = builtin.fil_les_binær(output)
        hvis lengde(bytes) < 32 { returner 1 }
    } fang (e) { returner 1 }
    hvis ikkje bygg_probe(root, output, probe_output) { returner 1 }
    skriv("[OK] Linux single-binary attestasjonskandidat er bygd\n")
    returner 0
}
