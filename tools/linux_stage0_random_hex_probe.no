// tools/linux_stage0_random_hex_probe.no — Linux-only random_hex planprobe

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon les_fil_trygt(sti: tekst) -> tekst {
    prøv {
        returner builtin.fil_les(sti)
    } fang (e) {
        returner ""
    }
    returner ""
}

funksjon inneheld(data: tekst, needle: tekst) -> bool {
    returner builtin.index_of(data, needle) >= 0
}

funksjon start() -> heiltall {
    la os = builtin.lower(tekst(builtin.system_info()["system"]))
    hvis os == "darwin" {
        linje("v850 skip: Linux-only probe (darwin not supported)")
        returner 0
    }

    la plan = "prosjekter/NorscodeWeb/app_linux_stage0_random_hex_plan_v731.no"
    la plan_body = les_fil_trygt(plan)
    hvis plan_body == "" {
        linje("Plan file not found: " + plan)
        returner 1
    }

    linje("v850: probing builtin.random_hex in stage0 Linux plan context")
    hvis inneheld(plan_body, "builtin.random_hex") {
        linje("found builtin.random_hex references")
        linje("v850: still references random_hex in plan script/examples")
    } ellers {
        linje("v850: no builtin.random_hex references")
    }

    linje("v850: DONE")
    returner 0
}
