// Fail-closed verifikasjon av den promoterte Linux x86_64-stage0-en før den
// strenge sjølvstendighetsporten. Stage0 og den materialiserte kopien i
// dist/norscode_native skal vere ELF64 x86-64, ha hashen som står i
// bootstrap/stage0/SHA256SUMS, og bere innebygd NCB (sjølv-hosta seed).

bruk tools.linux_runtime_attestation som att

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon forventa_hash(sums: tekst, rel: tekst) -> tekst {
    la linjer = builtin.split(sums, "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la delar = builtin.split(linjer[i], "  ")
        hvis lengde(delar) == 2 og delar[1] == rel og lengde(delar[0]) == 64 {
            returner delar[0]
        }
        i = i + 1
    }
    returner ""
}

funksjon er_elf64_x86(data) -> boolsk {
    returner lengde(data) >= 20 og data[0] == 127 og data[1] == 69 og
        data[2] == 76 og data[3] == 70 og data[4] == 2 og data[5] == 1 og
        data[18] == 62 og data[19] == 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la rel = "bootstrap/stage0/norscode-linux-x86_64"
    la sums_sti = root + "/bootstrap/stage0/SHA256SUMS"
    la kopi = root + "/dist/norscode_native"
    hvis ikkje builtin.fil_finnes(root + "/" + rel) eller ikkje builtin.fil_finnes(sums_sti) {
        skriv("[FAIL] Linux stage0 eller SHA256SUMS manglar\n")
        returner 1
    }
    la forventa = forventa_hash(builtin.fil_les(sums_sti), rel)
    hvis forventa == "" {
        skriv("[FAIL] SHA256SUMS har inga gyldig linje for " + rel + "\n")
        returner 1
    }
    la stier = [root + "/" + rel]
    hvis builtin.fil_finnes(kopi) { legg_til(stier, kopi) }
    la i: heiltall = 0
    mens i < lengde(stier) {
        la data = builtin.fil_les_binær(stier[i])
        hvis ikkje er_elf64_x86(data) {
            skriv("[FAIL] ikkje ELF64 x86-64: " + stier[i] + "\n")
            returner 1
        }
        la hash = builtin.sha256_bytes(data)
        hvis hash != forventa {
            skriv("[FAIL] hash avvik frå SHA256SUMS: " + stier[i] + " = " + hash + "\n")
            returner 1
        }
        hvis ikkje att.har_embedded_ncb(stier[i]) {
            skriv("[FAIL] manglar innebygd NCB (ikkje sjølv-hosta): " + stier[i] + "\n")
            returner 1
        }
        i = i + 1
    }
    skriv("[OK] promotert Linux stage0 er verifisert mot SHA256SUMS og ber innebygd NCB\n")
    skriv("stage0_sha256=" + forventa + "\n")
    returner 0
}
