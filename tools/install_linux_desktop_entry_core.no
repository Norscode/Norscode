// Prosessfri Linux desktop-entry-installasjon.

bruk std.filops som filops

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon desktop_med_exec(innhald: tekst, exec_path: tekst) -> tekst {
    la linjer = builtin.split(innhald, "\n")
    la out = ""
    la fann_exec = usann
    la i = 0
    mens i < lengde(linjer) {
        la line = linjer[i]
        hvis builtin.starts_with(line, "Exec=") {
            line = "Exec=" + exec_path
            fann_exec = sann
        }
        hvis i > 0 { out = out + "\n" }
        out = out + line
        i = i + 1
    }
    hvis ikkje fann_exec {
        hvis out != "" og ikkje builtin.ends_with(out, "\n") { out = out + "\n" }
        out = out + "Exec=" + exec_path + "\n"
    }
    returner out
}

funksjon har_felt(innhald: tekst, felt: tekst) -> bool {
    la linjer = builtin.split(innhald, "\n")
    la i = 0
    mens i < lengde(linjer) {
        hvis builtin.starts_with(builtin.trim(linjer[i]), felt + "=") { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon gyldig_desktop(innhald: tekst) -> bool {
    returner builtin.index_of(innhald, "[Desktop Entry]") >= 0 og
        har_felt(innhald, "Type") og har_felt(innhald, "Name") og
        har_felt(innhald, "Exec") og har_felt(innhald, "Icon")
}

funksjon installer(appdir_inn: tekst, prefix_inn: tekst, root: tekst) -> heiltall {
    la appdir = appdir_inn
    hvis appdir == "" { appdir = root + "/build/linux-app/Norscode.AppDir" }
    la prefix = prefix_inn
    hvis prefix == "" { prefix = env("HOME") + "/.local/share" }
    appdir = abs_sti(root, appdir)
    prefix = abs_sti(root, prefix)

    la desktop_src = appdir + "/usr/share/applications/Norscode.desktop"
    la icon_src = appdir + "/usr/share/icons/hicolor/256x256/apps/norscode.png"
    la desktop_dst_dir = prefix + "/applications"
    la icon_dst_dir = prefix + "/icons/hicolor/256x256/apps"
    la desktop_dst = desktop_dst_dir + "/Norscode.desktop"
    la icon_dst = icon_dst_dir + "/norscode.png"

    hvis ikkje fil_finst(desktop_src) {
        linje("Feil: manglar desktop-fil: " + desktop_src)
        linje("Bygg først med: ./bin/nc package-linux-app --format appdir")
        returner 1
    }
    hvis ikkje fil_finst(icon_src) {
        linje("Feil: manglar ikonfil: " + icon_src)
        returner 1
    }

    la desktop = desktop_med_exec(builtin.fil_les(desktop_src), appdir + "/AppRun")
    hvis ikkje gyldig_desktop(desktop) {
        linje("Feil: ugyldig Norscode desktop-entry")
        returner 1
    }
    hvis ikkje filops.lag_katalogar(desktop_dst_dir) eller
       ikkje filops.lag_katalogar(icon_dst_dir) {
        linje("Feil: klarte ikkje lage desktop-installasjonsmapper")
        returner 1
    }
    hvis ikkje filops.kopier2(icon_src, icon_dst) {
        linje("Feil: klarte ikkje kopiere ikon")
        returner 1
    }
    prøv { builtin.fil_skriv(desktop_dst, desktop) }
    fang (e) {
        linje("Feil: klarte ikkje skrive desktop-fil: " + tekst(e))
        returner 1
    }

    linje("Installert desktop entry: " + desktop_dst)
    linje("Installert ikon: " + icon_dst)
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    returner installer(env("NORSCODE_LINUX_DESKTOP_APPDIR"),
                       env("NORSCODE_LINUX_DESKTOP_PREFIX"), root)
}
