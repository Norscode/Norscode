// Strukturert, shellfri prosesshjelpar for Norscode-eigde verktøy.

bruk std.runtime.process_abi som process_abi

funksjon køyr(executable: tekst, argv: liste_tekst, cwd: tekst,
              miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la req = process_abi.request(executable, argv, cwd, "", timeout_ms, 33554432)
    // Selfhost-codegen materialiserer store NCB-grafer og passerer reelt
    // 2 GiB i kandidatverifikasjonen. Same eksplisitte 4 GiB-grense som den
    // parallelle testløparen hindrar falsk exit 126 utan å fjerne minnetaket.
    process_abi.sett_sandbox(req, "none", 4294967296, 1024, sann)
    process_abi.sett_environment(req, miljø)
    returner builtin.process_spawn_argv(req)
}

funksjon ok(resultat: ordbok_tekst) -> boolsk {
    returner tekst(resultat["status"]) == "ferdig" og
        heltall_fra_tekst(tekst(resultat["exit_code"])) == 0
}

funksjon veggtid_ms(resultat: ordbok_tekst) -> heiltall {
    hvis ikkje finnes_nøkkel(resultat, "wall_ms") { returner 0 }
    returner heltall_fra_tekst(tekst(resultat["wall_ms"]))
}

funksjon minnetopp_bytes(resultat: ordbok_tekst) -> heiltall {
    hvis ikkje finnes_nøkkel(resultat, "peak_rss_bytes") { returner 0 }
    returner heltall_fra_tekst(tekst(resultat["peak_rss_bytes"]))
}

funksjon skriv_resultat(resultat: ordbok_tekst) -> heiltall {
    la ut = tekst(resultat["stdout"])
    la feil = tekst(resultat["stderr"])
    hvis ut != "" { skriv(ut) }
    hvis feil != "" { skriv(feil) }
    returner 0
}
