// Strukturert, shellfri prosesshjelpar for Norscode-eigde verktøy.

bruk std.runtime.process_abi som process_abi

// Er `executable` ein Norscode-runtime (bin/nc, dist/norscode_native, stage0-seed)?
funksjon er_norscode_runtime(executable: tekst) -> boolsk {
    returner builtin.ends_with(executable, "/bin/nc") eller executable == "bin/nc" eller
        builtin.ends_with(executable, "/norscode_native") eller
        builtin.index_of(executable, "/norscode-linux-") >= 0 eller
        builtin.index_of(executable, "/norscode-macos-") >= 0 eller
        builtin.index_of(executable, "/norscode-windows-") >= 0
}

// Committed Linux-stage0 manglar argv-builtinane (argv → [] → selftest), og på alle
// seedar vinn miljøkontrakten (NORSCODE_CMD/NORSCODE_FILE) over argv i nc_main.start.
// Kallarar som spawnar runtimen med argv `run FIL` / `compile SRC UT` får difor
// kontrakten spegla i miljøet — utan å røre argv (kontrakttestar pinnar argv-forma).
// Kallarar som sjølve set NORSCODE_CMD blir ikkje rørte.
funksjon nc_miljø_frå_argv(executable: tekst, argv: liste_tekst, miljø: ordbok_tekst) -> ordbok_tekst {
    hvis ikkje er_norscode_runtime(executable) { returner miljø }
    hvis finnes_nøkkel(miljø, "NORSCODE_CMD") { returner miljø }
    hvis lengde(argv) < 2 { returner miljø }
    la cmd = tekst(argv[0])
    hvis cmd == "run" {
        miljø["NORSCODE_CMD"] = "run"
        miljø["NORSCODE_FILE"] = tekst(argv[1])
        returner miljø
    }
    hvis (cmd == "compile" eller cmd == "build") og lengde(argv) >= 3 {
        la ut = tekst(argv[2])
        hvis ut == "-o" og lengde(argv) >= 4 { ut = tekst(argv[3]) }
        miljø["NORSCODE_CMD"] = "compile"
        miljø["NORSCODE_FILE"] = tekst(argv[1])
        miljø["NORSCODE_OUTPUT"] = ut
        returner miljø
    }
    returner miljø
}

funksjon køyr_med_grenser(executable: tekst, argv: liste_tekst, cwd: tekst,
                          miljø: ordbok_tekst, timeout_ms: heiltall,
                          minne_bytes: heiltall, prosessar: heiltall) -> ordbok_tekst {
    la req = process_abi.request(executable, argv, cwd, "", timeout_ms, 33554432)
    process_abi.sett_sandbox(req, "none", minne_bytes, prosessar, sann)
    process_abi.sett_environment(req, nc_miljø_frå_argv(executable, argv, miljø))
    returner builtin.process_spawn_argv(req)
}

funksjon køyr(executable: tekst, argv: liste_tekst, cwd: tekst,
              miljø: ordbok_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    // Normalverktøy har ei eksplisitt 4 GiB-grense. Tunge bootstrap-eigarar
    // kan velje køyr_med_grenser med ei streng, dokumentert høgare grense.
    returner køyr_med_grenser(executable, argv, cwd, miljø, timeout_ms,
                              4294967296, 1024)
}

// [exit_code, stdout, stderr]-form for verktøy migrerte frå tekstprosess-kall.
// Ein Norscode-runtime starta med argv får NORSCODE_CMD/FILE/OUTPUT nullstilte
// (tom verdi = unset i nc_main.start) når argv ikkje sjølv gjev kontrakten:
// elles ville arva verdiar frå forelderen vinne over argv og starte
// forelderverktøyet rekursivt. `miljø` blir mutert; send eit ferskt kart.
funksjon køyr_liste(executable: tekst, argv: liste_tekst, cwd: tekst,
                    miljø: ordbok_tekst, timeout_ms: heiltall) -> liste_tekst {
    la m = nc_miljø_frå_argv(executable, argv, miljø)
    hvis er_norscode_runtime(executable) {
        hvis ikkje finnes_nøkkel(m, "NORSCODE_CMD") { m["NORSCODE_CMD"] = "" }
        hvis ikkje finnes_nøkkel(m, "NORSCODE_FILE") { m["NORSCODE_FILE"] = "" }
        hvis ikkje finnes_nøkkel(m, "NORSCODE_OUTPUT") { m["NORSCODE_OUTPUT"] = "" }
    }
    la res = {}
    prøv {
        // Minne 0 = OS-et eig grensa (som nc_regen_bootstrap): kallarane køyrer
        // heile testsuitar og release-pakking; timeout og fd-tak er eksplisitte.
        res = køyr_med_grenser(executable, argv, cwd, m, timeout_ms, 0, 1024)
    } fang (e) { returner ["1", "", tekst(e) + "\n"] }
    la kode = tekst(res["exit_code"])
    hvis tekst(res["status"]) != "ferdig" og kode == "0" { kode = "1" }
    la feil = tekst(res["stderr"])
    hvis finnes_nøkkel(res, "error") og tekst(res["error"]) != "" { feil = feil + tekst(res["error"]) + "\n" }
    returner [kode, tekst(res["stdout"]), feil]
}

// Prosess-ABI-en gjer ikkje PATH-oppslag, og VM-ens disk-sandkasse nektar
// fil_finnes utanfor NORSCODE_VM_DISK_ROOT (t.d. /usr/bin), så PATH kan ikkje
// slåast opp frå Norscode. Namngjevne systemprogram (git, gh, shasum) blir difor
// starta via /usr/bin/env, som slår opp i PATH utan shell; 127 = ikkje funne.
funksjon køyr_program(namn: tekst, argv: liste_tekst, cwd: tekst,
                      miljø: ordbok_tekst, timeout_ms: heiltall) -> liste_tekst {
    la full: liste_tekst = [namn]
    la i: heiltall = 0
    mens i < lengde(argv) {
        legg_til(full, argv[i])
        i = i + 1
    }
    returner køyr_liste("/usr/bin/env", full, cwd, miljø, timeout_ms)
}

// Fyrste linje av prosess-stdout. Prosess-ABI-en kan levere linjeskift escapa
// (bokstaveleg «\n», målt: `git rev-parse HEAD` → 40 + 3 teikn på macOS-stage0),
// så kutt ved fyrste ekte linjeskift, CR eller backslash — rett for
// einlinjeverdiar som git-SHA.
funksjon første_linje(t: tekst) -> tekst {
    la i: heiltall = 0
    mens i < lengde(t) {
        la c = builtin.slice(t, i, i + 1)
        hvis c == "\n" eller c == "\r" eller c == builtin.chr(92) { returner trim(builtin.slice(t, 0, i)) }
        i = i + 1
    }
    returner trim(t)
}

funksjon ok(resultat: ordbok_tekst) -> boolsk {
    returner tekst(resultat["status"]) == "ferdig" og
        heltall_fra_tekst(tekst(resultat["exit_code"])) == 0
}

funksjon veggtid_ms(resultat: ordbok_tekst) -> heiltall {
    hvis ikkje finnes_nøkkel(resultat, "wall_ms") { returner 0 }
    returner heltall_fra_tekst(tekst(resultat["wall_ms"]))
}

funksjon minnetopp_bytes(resultat: ordbok_tekst) -> heiltall {
    hvis ikkje finnes_nøkkel(resultat, "peak_rss_bytes") { returner 0 }
    returner heltall_fra_tekst(tekst(resultat["peak_rss_bytes"]))
}

funksjon skriv_resultat(resultat: ordbok_tekst) -> heiltall {
    la ut = tekst(resultat["stdout"])
    la feil = tekst(resultat["stderr"])
    hvis ut != "" { skriv(ut) }
    hvis feil != "" { skriv(feil) }
    returner 0
}
