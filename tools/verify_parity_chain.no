# Konsolidert kjelde-kjede-verifisering av paritetsarbeidet (M2/M4/M5/M10).
# Lastar selfhost.kompiler + selfhost.vm ÉIN gong og køyrer alle snippetene i
# same prosess — amortiserer den dyre vm.no-lastinga (~6 min / ~10 GB) til éi
# køyring i staden for fem. Kvar snippet blir kompilert av KJELDE-kompilatoren
# og køyrd på KJELDE-VM-en, så eit grønt resultat = funksjonen er rebuild-klar.

bruk selfhost.kompiler som kompiler
bruk selfhost.vm som vm

funksjon utf(kjelde: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(kompiler.kompiler_fil(kjelde, "__main__"))
    returner tekst(vm.køyr_ncb(ncb))
}

funksjon sjekk(namn: tekst, fekk: tekst, venta: tekst, feil_ref: liste) -> heiltall {
    hvis fekk == venta {
        skriv("  OK   " + namn + " = " + fekk + "\n")
    } ellers {
        skriv("  FEIL " + namn + " = " + fekk + " (venta " + venta + ")\n")
        legg_til(feil_ref, namn)
    }
    returner 0
}

funksjon start() -> heiltall {
    la feil = []
    skriv("== kjelde-kjede-verifisering M2/M4/M5/M10 ==\n")

    # M4 — ingenting som eigen type
    sjekk("M4 type(ingenting)",
        utf("funksjon start() -> tekst { returner builtin.type(ingenting) }\n"),
        "ingenting", feil)
    sjekk("M4 ingenting!=0",
        utf("funksjon start() -> tekst { hvis ingenting == 0 { returner \"lik\" } returner \"ulik\" }\n"),
        "ulik", feil)

    # M2 — fangbare køyretidsfeil (div med null skal fangast, ikkje drepe)
    sjekk("M2 fang div0",
        utf("funksjon start() -> tekst { prøv { la x = 1 / 0\n returner \"ingen\" } fang (e) { returner \"fanga\" } }\n"),
        "fanga", feil)
    sjekk("M2 fang indeks",
        utf("funksjon start() -> tekst { prøv { la a = [1]\n la y = a[9]\n returner \"ingen\" } fang (e) { returner \"fanga\" } }\n"),
        "fanga", feil)

    # M5 — struktur-metodar med dispatch
    la m5 = "struktur Punkt { x y }\n" +
        "funksjon Punkt.sum(self) -> heltall { returner self.x + self.y }\n" +
        "funksjon Punkt.flytt(self, dx) -> heltall { self.x = self.x + dx\n returner self.x }\n" +
        "struktur Kvadrat { s }\n" +
        "funksjon Kvadrat.sum(self) -> heltall { returner self.s * self.s }\n" +
        "funksjon start() -> heltall {\n" +
        "    la p = Punkt()\n    p.x = 3\n    p.y = 4\n" +
        "    la a = p.sum()\n" +
        "    la b = p.flytt(10)\n" +
        "    la q = Kvadrat()\n    q.s = 5\n    la c = q.sum()\n" +
        "    returner a * 10000 + b * 100 + c\n" +
        "}\n"
    # a=7, b=13, c=25  → 7*10000 + 13*100 + 25 = 71325
    sjekk("M5 metode+dispatch", utf(m5), "71325", feil)

    # M10 — destrukturering
    sjekk("M10 destrukturering",
        utf("funksjon start() -> heltall { la [a, b] = [3, 4]\n returner a * 10 + b }\n"),
        "34", feil)
    # M10 — spread
    sjekk("M10 spread",
        utf("funksjon start() -> heltall { la a = [1, 2]\n la b = [...a, 3]\n returner b[0]*100 + b[1]*10 + b[2] }\n"),
        "123", feil)
    # M10 — standardargument
    sjekk("M10 standardarg",
        utf("funksjon add(a: heltall, b: heltall = 10) -> heltall { returner a + b }\n" +
            "funksjon start() -> heltall { returner add(5) }\n"),
        "15", feil)

    skriv("\n")
    hvis lengde(feil) == 0 {
        skriv("ALLE GRØNE — M2/M4/M5/M10 rebuild-klare (M3 alt verifisert)\n")
        returner 0
    }
    skriv("FEILA: " + tekst(lengde(feil)) + " sjekk(ar)\n")
    returner 1
}
