// Strukturerte v6800 bundle-prober utan shell eller pipes.

bruk std.filops som filops
bruk std.runtime.process_abi som process_abi

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon run_probe(native: tekst, root: tekst, source: tekst, logg: tekst, precompiled: bool) -> bool {
    la req = process_abi.request(native, [], root, "", 120000, 1048576)
    process_abi.sett_sandbox(req, "none", 536870912, 32, usann)
    la miljo = {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": source,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    hvis ikkje precompiled { miljo["NORSCODE_USE_PRECOMPILED_SELFHOST"] = "0" }
    process_abi.sett_environment(req, miljo)
    la res = builtin.process_spawn_argv(req)
    builtin.fil_skriv(logg, res["stdout"] + res["stderr"])
    hvis res["stdout"] != "" { skriv(res["stdout"]) }
    hvis res["stderr"] != "" { skriv(res["stderr"]) }
    returner res["status"] == "ferdig" og heltall_fra_tekst(res["exit_code"]) == 0
}

funksjon køyr(root: tekst, native: tekst, outdir: tekst) -> bool {
    hvis ikkje filops.lag_katalogar(outdir) { returner usann }
    hvis ikkje run_probe(
        native,
        root,
        root + "/tests/fixtures/v6800/bundler_precompiled_probe_v6800.no",
        outdir + "/precompiled_probe.log",
        sann
    ) { returner usann }
    hvis ikkje run_probe(
        native,
        root,
        root + "/tests/fixtures/v6800/bundler_compile_probe_v6800.no",
        outdir + "/compile_probe.log",
        usann
    ) { returner usann }
    returner run_probe(
        native,
        root,
        root + "/tests/fixtures/v6800/bundler_single_module_probe_v6800.no",
        outdir + "/single_module_probe.log",
        sann
    )
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/dist/norscode_native" }
    hvis ikkje filops.fil_finnes(native) {
        linje("Feil: manglar native runtime: " + native)
        returner 1
    }
    hvis ikkje køyr(root, native, root + "/build/v6800") { returner 1 }
    returner 0
}
