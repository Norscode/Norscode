// Set saman deterministiske ncb_to_c-intervall utan å halde heile C-fila i minnet.
// Kvar batch må vere generert frå same komplette NCB; berre definisjonsintervallet
// kan variere. Fyrste batch eig felles runtime, prototypar, dispatch og main.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon utsnitt_mellom(src: tekst, start_marker: tekst, slutt_marker: tekst) -> tekst {
    la start = builtin.index_of(src, start_marker)
    hvis start < 0 { kast "manglar startmarkør: " + start_marker }
    start = start + lengde(start_marker)
    la relativ_slutt = builtin.index_of(builtin.slice(src, start, lengde(src)), slutt_marker)
    hvis relativ_slutt < 0 { kast "manglar sluttmarkør: " + slutt_marker }
    returner builtin.slice(src, start, start + relativ_slutt)
}

funksjon tel_definisjonar(src: tekst) -> heiltall {
    la marker = "static NcVal *nc_fn_"
    la cursor: heiltall = 0
    la tal: heiltall = 0
    mens cursor < lengde(src) {
        la relativ = builtin.index_of(builtin.slice(src, cursor, lengde(src)), marker)
        hvis relativ < 0 { bryt }
        tal = tal + 1
        cursor = cursor + relativ + lengde(marker)
    }
    returner tal
}

funksjon start() -> heiltall {
    la batch_tekst = env("NC_C_BATCH_FILES")
    la output = env("NC_C_OUTPUT")
    hvis batch_tekst == "" eller output == "" {
        kast "NC_C_BATCH_FILES og NC_C_OUTPUT må vere sette"
    }
    la batchar = builtin.split(batch_tekst, ",")
    hvis lengde(batchar) == 0 { kast "ingen C-batchar" }
    la def_marker = "/* ── Funksjonsdefinisjonar ── */\n"
    la dispatch_marker = "/* ── Dispatch-tabell for maintainer-host ── */"
    la fyrste_sti = builtin.trim(batchar[0])
    la fyrste = fil_les(fyrste_sti)
    la def_pos = builtin.index_of(fyrste, def_marker)
    la dispatch_pos = builtin.index_of(fyrste, dispatch_marker)
    hvis def_pos < 0 eller dispatch_pos < 0 eller dispatch_pos <= def_pos {
        kast "ugyldig fyrste C-batch"
    }
    builtin.fil_skriv(output, builtin.slice(fyrste, 0, def_pos + lengde(def_marker)))
    la totalt: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(batchar) {
        la sti = builtin.trim(batchar[i])
        hvis sti == "" { kast "tom batch-sti" }
        la src = fil_les(sti)
        la definisjonar = utsnitt_mellom(src, def_marker, dispatch_marker)
        builtin.fil_append(output, definisjonar)
        totalt = totalt + tel_definisjonar(definisjonar)
        i = i + 1
    }
    builtin.fil_append(output, builtin.slice(fyrste, dispatch_pos, lengde(fyrste)))
    la venta_tekst = env("NC_C_EXPECT_FUNCTIONS")
    hvis venta_tekst != "" {
        la venta = heiltall_fra_tekst(venta_tekst)
        hvis totalt != venta {
            kast "C-batchar gav " + tekst_fra_heiltall(totalt) +
                  " definisjonar, venta " + tekst_fra_heiltall(venta)
        }
    }
    skriv("compose-c-batches: " + tekst_fra_heiltall(totalt) +
          " definisjonar skrive til " + output + "\n")
    returner 0
}
