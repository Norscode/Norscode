// Erstatt eller legg til eit eksplisitt, komma-separert sett genererte
// C-funksjonar i ein separat kandidat. Tillitsankeret blir aldri endra.
bruk tools.maint.splice_native_argv_dispatch som splice

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la base_sti = env("NC_SPLICE_BASE")
    la ny_sti = env("NC_SPLICE_NEW")
    la ut_sti = env("NC_SPLICE_OUTPUT")
    la namn_tekst = env("NC_SPLICE_FUNCTIONS")
    hvis base_sti == "" eller ny_sti == "" eller ut_sti == "" eller namn_tekst == "" {
        kast "NC_SPLICE_BASE/NEW/OUTPUT/FUNCTIONS må vere sette"
    }
    hvis ut_sti == base_sti { kast "splice krev separat utfil" }

    la base = fil_les(base_sti)
    la ny = fil_les(ny_sti)
    la namn = builtin.split(namn_tekst, ",")
    la nye_prototypar = ""
    la nye_definisjonar = ""
    la erstatta: heiltall = 0
    la lagt_til: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(namn) {
        la fn = builtin.trim(namn[i])
        hvis fn != "" {
            la signatur = "static NcVal *" + fn + "(NcVal **args, int nargs) {"
            la proto = "static NcVal *" + fn + "(NcVal **args, int nargs);"
            la ny_def = splice.funksjonsdefinisjon(ny, fn)
            hvis builtin.contains(base, signatur) {
                base = splice.erstatt_ein(base, splice.funksjonsdefinisjon(base, fn), ny_def)
                erstatta = erstatta + 1
            } ellers {
                hvis ikkje builtin.contains(base, proto) {
                    nye_prototypar = nye_prototypar + proto + "\n"
                }
                nye_definisjonar = nye_definisjonar + ny_def
                lagt_til = lagt_til + 1
            }
        }
        i = i + 1
    }
    hvis erstatta + lagt_til == 0 { kast "ingen funksjonar valde" }
    hvis nye_prototypar != "" {
        la def_marker = "/* ── Funksjonsdefinisjonar ── */"
        base = splice.erstatt_ein(base, def_marker, nye_prototypar + "\n" + def_marker)
    }
    hvis nye_definisjonar != "" {
        la dispatch_marker = "/* ── Dispatch-tabell for maintainer-host ── */"
        base = splice.erstatt_ein(base, dispatch_marker, nye_definisjonar + dispatch_marker)
    }
    fil_skriv(ut_sti, base)
    skriv("multi-splice: " + tekst_fra_heiltall(erstatta) + " erstatta, " +
          tekst_fra_heiltall(lagt_til) + " nye\n")
    returner 0
}
