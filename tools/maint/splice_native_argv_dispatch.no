// Splice berre den verifiserte nc_main argv-dispatchen inn i den komplette
// genererte host-kandidaten. Dette unngår å regenerere/promotere stage0.

funksjon env(namn: tekst, standard: tekst) -> tekst {
    prøv {
        la verdi = miljo_hent(namn)
        hvis verdi != "" { returner verdi }
    } fang (e) { }
    returner standard
}

funksjon funksjonsdefinisjon(src: tekst, namn: tekst) -> tekst {
    la marker = "/* ── Funksjonsdefinisjonar ── */"
    la frå = builtin.index_of(src, marker)
    hvis frå < 0 { kast "manglar definisjonsmarkør" }
    la signatur = "static NcVal *" + namn + "(NcVal **args, int nargs) {"
    la rel = builtin.index_of(builtin.slice(src, frå, lengde(src)), signatur)
    hvis rel < 0 { kast "manglar funksjon: " + namn }
    la start = frå + rel
    la rest_start = start + lengde(signatur)
    la neste_rel = builtin.index_of(
        builtin.slice(src, rest_start, lengde(src)),
        "\nstatic NcVal *nc_fn_"
    )
    hvis neste_rel < 0 {
        neste_rel = builtin.index_of(
            builtin.slice(src, rest_start, lengde(src)),
            "\n/* ── Dispatch-tabell"
        )
    }
    hvis neste_rel < 0 { kast "manglar funksjonsgrense etter: " + namn }
    returner builtin.slice(src, start, rest_start + neste_rel + 1)
}

funksjon erstatt_ein(src: tekst, gammal: tekst, ny: tekst) -> tekst {
    la pos = builtin.index_of(src, gammal)
    hvis pos < 0 { kast "manglar splice-mål" }
    hvis builtin.index_of(builtin.slice(src, pos + lengde(gammal), lengde(src)), gammal) >= 0 {
        kast "splice-målet er ikkje eintydig"
    }
    returner builtin.slice(src, 0, pos) + ny +
        builtin.slice(src, pos + lengde(gammal), lengde(src))
}

funksjon nc_main_funksjonsnamn(src: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la sett: ordbok<tekst, boolsk> = {}
    la prefiks = "\nstatic NcVal *nc_fn_selfhost_nc_main_"
    la cursor: heiltall = 0
    mens cursor < lengde(src) {
        la rel = builtin.index_of(builtin.slice(src, cursor, lengde(src)), prefiks)
        hvis rel < 0 { bryt }
        la start = cursor + rel + 1 + lengde("static NcVal *")
        la paren_rel = builtin.index_of(builtin.slice(src, start, lengde(src)), "(")
        hvis paren_rel < 0 { kast "ugyldig nc_main-signatur" }
        la namn = builtin.slice(src, start, start + paren_rel)
        hvis ikkje finnes_nøkkel(sett, namn) {
            sett[namn] = sann
            legg_til(ut, namn)
        }
        cursor = start + paren_rel + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la base_sti = env("NC_SPLICE_BASE", "build/v3009/norscode_generated_gc.c")
    la ny_sti = env("NC_SPLICE_MAIN", "build/v3009/norscode_generated_main_argv.c")
    la ut_sti = env("NC_SPLICE_OUTPUT", "build/v3009/norscode_generated_argv_dispatch.c")
    la base = fil_les(base_sti)
    la ny = fil_les(ny_sti)

    la namn = nc_main_funksjonsnamn(ny)
    hvis lengde(namn) == 0 { kast "ny kandidat manglar selfhost.nc_main-funksjonar" }
    la nye_prototypar = ""
    la nye_definisjonar = ""
    la erstatta: heiltall = 0
    la lagt_til: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(namn) {
        la fn = namn[i]
        la signatur = "static NcVal *" + fn + "(NcVal **args, int nargs) {"
        la proto = "static NcVal *" + fn + "(NcVal **args, int nargs);"
        la ny_def = funksjonsdefinisjon(ny, fn)
        hvis builtin.contains(base, signatur) {
            base = erstatt_ein(base, funksjonsdefinisjon(base, fn), ny_def)
            erstatta = erstatta + 1
        } ellers {
            hvis ikkje builtin.contains(base, proto) { nye_prototypar = nye_prototypar + proto + "\n" }
            nye_definisjonar = nye_definisjonar + ny_def
            lagt_til = lagt_til + 1
        }
        i = i + 1
    }
    hvis nye_prototypar != "" {
        la def_marker = "/* ── Funksjonsdefinisjonar ── */"
        base = erstatt_ein(base, def_marker, nye_prototypar + "\n" + def_marker)
    }
    hvis nye_definisjonar != "" {
        la dispatch_marker = "/* ── Dispatch-tabell for maintainer-host ── */"
        base = erstatt_ein(base, dispatch_marker, nye_definisjonar + dispatch_marker)
    }

    fil_skriv(ut_sti, base)
    skriv("native argv-dispatch: " + tekst_fra_heltall(erstatta) +
          " erstatta, " + tekst_fra_heltall(lagt_til) +
          " nye, skrive til " + ut_sti + "\n")
    returner 0
}
