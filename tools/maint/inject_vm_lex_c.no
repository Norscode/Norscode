// Legg berre den verifiserte builtin.lex-grena inn i eksisterande, linkbar
// kall_innebygd-C. Dette unngår aliasdrift frå ein isolert full VM-overlay.
bruk tools.maint.splice_native_argv_dispatch som splice

funksjon env(namn: tekst, standard: tekst) -> tekst {
    prøv { la verdi = miljo_hent(namn)  hvis verdi != "" { returner verdi } } fang (e) { }
    returner standard
}

funksjon start() -> heiltall {
    la base_sti = env("NC_SPLICE_BASE", "")
    la ut_sti = env("NC_SPLICE_OUTPUT", "")
    hvis base_sti == "" eller ut_sti == "" eller base_sti == ut_sti { kast "lex-inject krev separat base/utfil" }
    la base = fil_les(base_sti)
    la fn = "nc_fn_selfhost_vm_kall_innebygd"
    la gammal = splice.funksjonsdefinisjon(base, fn)
    hvis builtin.contains(gammal, "/* norscode-vm-builtin-lex-v1 */") { kast "builtin.lex-grena finst alt" }
    la marker = "lbl_nc_fn___L1921__:;\n  nc_push(&sp, stack, nc_load(vars, varnames, nvars, \"namn\"));\n  nc_gc_safepoint();\n  nc_push(&sp, stack, nc_str(\"builtin.legg_til\"));"
    la gren = "lbl_nc_fn___L1921__:;\n  /* norscode-vm-builtin-lex-v1 */\n  {\n    NcVal *_lex_namn = nc_load(vars,varnames,nvars,\"namn\");\n    if (_lex_namn && _lex_namn->type == NC_STR && !strcmp(_lex_namn->s,\"builtin.lex\")) {\n      NcVal *_lex_active = nc_load(vars,varnames,nvars,\"active_functions\");\n      const char *_lex_keys[] = {\"lexer_m1.lex\",\"selfhost.lexer.lexer_m1.lex\"};\n      int _lex_key_i;\n      for (_lex_key_i=0; _lex_key_i<2; _lex_key_i++) {\n        NcVal *_lex_fn = nc_str(_lex_keys[_lex_key_i]);\n        nc_push(&sp,stack,_lex_fn);\n        NcVal *_lex_probe_args[] = {_lex_active,_lex_fn};\n        NcVal *_lex_has = nc_fn_selfhost_vm_vm_map_har_nokkel(_lex_probe_args,2);\n        if (nc_truthy(_lex_has)) {\n          NcVal *_lex_call_args[] = {_lex_fn,nc_load(vars,varnames,nvars,\"args\"),_lex_active,nc_int(0LL)};\n          NcVal *_ret = nc_fn_selfhost_vm_k__yr_funksjon(_lex_call_args,4);\n          nc_pop(&sp,stack);\n          int _i; while(_try_depth>0){ _try_depth--; memcpy(&g_err_jmp,&_try_saved[_try_depth],sizeof(jmp_buf)); g_err_gc_boundary=_try_boundaries[_try_depth]; }\n          nc_gc_frame_leave(&_gc_frame); for(_i=0;_i<nvars;_i++) free(varnames[_i]); free(_try_saved); free(_try_boundaries); free(varnames); free(vars); free(stack); return _ret;\n        }\n        nc_pop(&sp,stack);\n      }\n    }\n  }\n  nc_push(&sp, stack, nc_load(vars, varnames, nvars, \"namn\"));\n  nc_gc_safepoint();\n  nc_push(&sp, stack, nc_str(\"builtin.legg_til\"));"
    la ny = splice.erstatt_ein(gammal, marker, gren)
    fil_skriv(ut_sti, splice.erstatt_ein(base, gammal, ny))
    skriv("builtin.lex-C-gren skrive til " + ut_sti + "\n")
    returner 0
}
