// Lag ein liten, eksplisitt NCB-kandidat med berre namngjevne funksjonar.
// Brukt for avgrensa materialisering/spleising; original-NCB blir aldri endra.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la input = env("NC_SELECT_NCB_INPUT")
    la output = env("NC_SELECT_NCB_OUTPUT")
    la namn_tekst = env("NC_SELECT_NCB_FUNCTIONS")
    hvis input == "" eller output == "" eller namn_tekst == "" {
        kast "NC_SELECT_NCB_INPUT/OUTPUT/FUNCTIONS må vere sette"
    }
    hvis input == output { kast "select-ncb krev separat utfil" }
    la original = builtin.json_parse_raw(fil_les(input))
    la alle = original["functions"]
    la valde = {}
    la namn = builtin.split(namn_tekst, ",")
    la i: heiltall = 0
    mens i < lengde(namn) {
        la fn = builtin.trim(namn[i])
        hvis fn != "" {
            hvis ikkje finnes_nøkkel(alle, fn) { kast "manglar NCB-funksjon: " + fn }
            valde[fn] = alle[fn]
        }
        i = i + 1
    }
    hvis lengde(builtin.nøkler(valde)) == 0 { kast "ingen NCB-funksjonar valde" }
    original["functions"] = valde
    original["entry"] = builtin.trim(namn[0])
    original["tests"] = {}
    original["route_handlers"] = []
    original["dependency_providers"] = {}
    original["guard_providers"] = {}
    original["request_middlewares"] = []
    original["response_middlewares"] = []
    original["error_middlewares"] = []
    original["startup_hooks"] = []
    original["shutdown_hooks"] = []
    fil_skriv(output, builtin.json_skriv(original))
    skriv("select-ncb: " + tekst_fra_heltall(lengde(builtin.nøkler(valde))) +
          " funksjonar skrive til " + output + "\n")
    returner 0
}
