// Erstatt éin eksplisitt namngitt generert C-funksjon i ein separat kandidat.
bruk tools.maint.splice_native_argv_dispatch som splice

funksjon env(namn: tekst, standard: tekst) -> tekst {
    prøv {
        la verdi = miljo_hent(namn)
        hvis verdi != "" { returner verdi }
    } fang (e) { }
    returner standard
}

funksjon start() -> heiltall {
    la base_sti = env("NC_SPLICE_BASE", "")
    la ny_sti = env("NC_SPLICE_NEW", "")
    la ut_sti = env("NC_SPLICE_OUTPUT", "")
    la namn = env("NC_SPLICE_FUNCTION", "")
    hvis base_sti == "" eller ny_sti == "" eller ut_sti == "" eller namn == "" {
        kast "NC_SPLICE_BASE/NEW/OUTPUT/FUNCTION må vere sette"
    }
    hvis ut_sti == base_sti { kast "splice krev separat utfil" }
    la base = fil_les(base_sti)
    la ny = fil_les(ny_sti)
    la gammal_def = splice.funksjonsdefinisjon(base, namn)
    la ny_def = splice.funksjonsdefinisjon(ny, namn)
    la ut = splice.erstatt_ein(base, gammal_def, ny_def)
    fil_skriv(ut_sti, ut)
    skriv("splica " + namn + " til " + ut_sti + "\n")
    returner 0
}
