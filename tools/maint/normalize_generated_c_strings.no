// Normaliser eitt eventuelt ekstra JSON-escape-lag i genererte PUSH_CONST-
// strengar. Verktøyet rører berre nc_push(... nc_str("..."))-literalane i
// funksjonsdelen av generert C, og skriv resultatet separat.

funksjon env(namn: tekst, standard: tekst) -> tekst {
    prøv {
        la verdi = miljo_hent(namn)
        hvis verdi != "" { returner verdi }
    } fang (e) { }
    returner standard
}

funksjon unescape_ein_pass(t: tekst) -> tekst {
    la ut = ""
    la bs = builtin.chr(92)
    la i: heiltall = 0
    mens i < lengde(t) {
        la c = builtin.slice(t, i, i + 1)
        hvis c == bs og i + 1 < lengde(t) {
            la n = builtin.slice(t, i + 1, i + 2)
            hvis n == "n" { ut = ut + builtin.chr(10) }
            ellers hvis n == "t" { ut = ut + builtin.chr(9) }
            ellers hvis n == "r" { ut = ut + builtin.chr(13) }
            ellers hvis n == "b" { ut = ut + builtin.chr(8) }
            ellers hvis n == "f" { ut = ut + builtin.chr(12) }
            ellers hvis n == "0" { ut = ut + builtin.chr(0) }
            ellers hvis n == "\"" { ut = ut + builtin.chr(34) }
            ellers hvis n == bs { ut = ut + bs }
            ellers { ut = ut + bs + n }
            i = i + 2
        } ellers {
            ut = ut + c
            i = i + 1
        }
    }
    returner ut
}

funksjon c_escape(t: tekst) -> tekst {
    la bs = builtin.chr(92)
    la quote = builtin.chr(34)
    la s0 = builtin.replace(t, bs, bs + bs)
    la s1 = builtin.replace(s0, quote, bs + quote)
    la s2 = builtin.replace(s1, builtin.chr(10), bs + "n")
    la s3 = builtin.replace(s2, builtin.chr(9), bs + "t")
    la s4 = builtin.replace(s3, builtin.chr(13), bs + "r")
    returner builtin.replace(s4, builtin.chr(0), bs + "0")
}

funksjon normaliser_payload(payload: tekst) -> tekst {
    // Første pass tolkar C-literalet, andre pass fjernar eit eventuelt rått
    // JSON-lag. Re-escaping gjer operasjonen idempotent for korrekt C.
    returner c_escape(unescape_ein_pass(unescape_ein_pass(payload)))
}

funksjon finn_lukkesitat(src: tekst, start: heiltall) -> heiltall {
    la bs = builtin.chr(92)
    la quote = builtin.chr(34)
    la i = start
    mens i < lengde(src) {
        la c = builtin.slice(src, i, i + 1)
        hvis c == bs og i + 1 < lengde(src) { i = i + 2 }
        ellers hvis c == quote { returner i }
        ellers { i = i + 1 }
    }
    returner -1
}

funksjon start() -> heiltall {
    la input = env("NC_NORMALIZE_C_INPUT", "build/native_host_candidate.c")
    la output = env("NC_NORMALIZE_C_OUTPUT", "build/native_host_candidate_normalized.c")
    hvis ikkje fil_finnes(input) { kast "manglar generert C: " + input }
    hvis input == output { kast "normalisering krev separat utfil" }
    la src = fil_les(input)
    la def_marker = "/* ── Funksjonsdefinisjonar ── */"
    la def_pos = builtin.index_of(src, def_marker)
    hvis def_pos < 0 { kast "manglar funksjonsmarkør" }
    la marker = "nc_push(&sp, stack, nc_str(\""
    la cursor: heiltall = 0
    la søk: heiltall = def_pos
    la buffer = ""
    la tal: heiltall = 0
    builtin.fil_skriv(output, "")
    mens søk < lengde(src) {
        la rel = builtin.index_of(builtin.slice(src, søk, lengde(src)), marker)
        hvis rel < 0 { bryt }
        la funn = søk + rel
        la payload_start = funn + lengde(marker)
        la slutt = finn_lukkesitat(src, payload_start)
        hvis slutt < 0 { kast "manglar slutt på nc_str-literal" }
        buffer = buffer + builtin.slice(src, cursor, payload_start) +
                 normaliser_payload(builtin.slice(src, payload_start, slutt))
        cursor = slutt
        søk = slutt + 1
        tal = tal + 1
        hvis lengde(buffer) >= 1048576 {
            builtin.fil_append(output, buffer)
            buffer = ""
        }
    }
    buffer = buffer + builtin.slice(src, cursor, lengde(src))
    hvis buffer != "" { builtin.fil_append(output, buffer) }
    skriv("normaliserte " + tekst_fra_heiltall(tal) + " genererte C-strengar til " + output + "\n")
    returner 0
}
