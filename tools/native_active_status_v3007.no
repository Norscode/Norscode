// tools/native_active_status_v3007.no — prosessfri kandidat-/diststatus

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon executable(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon sha256(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis sti == "" { returner root + "/build/v3002/norscode_native_v3002" }
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon rapporter(sti: tekst, label: tekst, ok_melding: tekst,
                    warn_melding: tekst, sha_label: tekst) -> heiltall {
    hvis executable(sti) {
        linje(ok_melding)
        la h = sha256(sti)
        hvis h != "" { linje("[INFO] " + sha_label + "=" + h) }
    } ellers { linje(warn_melding) }
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la candidate = abs_sti(root, env("NORSCODE_NATIVE_STATUS_CANDIDATE"))
    la active = root + "/dist/norscode_native"

    linje("== v3007 native active status ==")
    linje("candidate: " + candidate)
    linje("active:    " + active)
    linje("")
    rapporter(candidate, "candidate", "[INFO] kandidat finst og er køyrbar", "[WARN] kandidat manglar eller er ikkje køyrbar", "kandidat sha256")
    rapporter(active, "active", "[INFO] aktiv dist finst og er køyrbar", "[WARN] aktiv dist manglar eller er ikkje køyrbar", "aktiv dist sha256")
    linje("")
    linje("[INFO] For kandidat-gate:")
    linje("  NORSCODE_NATIVE_GAP_BIN=" + candidate + " bin/nc run tools/native_runtime_gap_gate_v3001.no")
    linje("")
    linje("[INFO] For aktiv dist-gate:")
    linje("  NORSCODE_NATIVE_GAP_BIN=" + active + " bin/nc run tools/native_runtime_gap_gate_v3001.no")
    linje("")
    linje("[SAFE] Ingen filer vart endra.")
    linje("[SAFE] Ingen promotering vart utført.")
    returner 0
}
