// Trekk ut éin funksjon frå levande Norscode-kjelde til ein liten kandidatfil.
// Verktøyet skriv aldri over kjelda, runtime eller stage0. Føremålet er å
// kompilere og overlaye berre den endra funksjonen utan å serialisere ein heil,
// uendra selfhost-modul på nytt.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la inn = env("NC_SOURCE_INPUT")
    la ut = env("NC_SOURCE_OUTPUT")
    la namn = env("NC_SOURCE_FUNCTION")
    hvis inn == "" eller ut == "" eller namn == "" eller inn == ut {
        skriv("[FAIL] krev NC_SOURCE_INPUT/OUTPUT/FUNCTION\n")
        returner 2
    }

    la src = fil_les(inn)
    la markor = "funksjon " + namn + "("
    la start_pos = builtin.index_of(src, markor)
    hvis start_pos < 0 {
        skriv("[FAIL] finn ikkje funksjon: " + namn + "\n")
        returner 1
    }

    la i = start_pos
    la djupn = 0
    la har_kropp = usann
    la i_streng = usann
    la escape = usann
    la linjekommentar = usann
    la slutt_pos = -1
    mens i < lengde(src) {
        la c = src[i]
        hvis linjekommentar {
            hvis c == "\n" { linjekommentar = usann }
        } ellers hvis i_streng {
            hvis escape { escape = usann }
            ellers hvis c == "\\" { escape = sann }
            ellers hvis c == "\"" { i_streng = usann }
        } ellers hvis c == "\"" {
            i_streng = sann
        } ellers hvis c == "/" og i + 1 < lengde(src) og src[i + 1] == "/" {
            linjekommentar = sann
            i = i + 1
        } ellers hvis c == "{" {
            djupn = djupn + 1
            har_kropp = sann
        } ellers hvis c == "}" og har_kropp {
            djupn = djupn - 1
            hvis djupn == 0 {
                slutt_pos = i + 1
                bryt
            }
        }
        i = i + 1
    }
    hvis slutt_pos <= start_pos {
        skriv("[FAIL] ubalansert funksjonskropp: " + namn + "\n")
        returner 1
    }

    // Flerfil-bundle kompilerer kvar modul direkte og kan derfor ta med
    // bruk-linjene utan å traversere importgrafen. Éinfil-compile må halde dei
    // ute; vel eksplisitt med NC_SOURCE_INCLUDE_IMPORTS=1.
    la prefiks = ""
    hvis env("NC_SOURCE_INCLUDE_IMPORTS") == "1" {
        la linjer = builtin.split(src, "\n")
        la li = 0
        mens li < lengde(linjer) {
            la linje = builtin.trim(linjer[li])
            hvis builtin.starts_with(linje, "bruk ") {
                prefiks = prefiks + linje + "\n"
            }
            li = li + 1
        }
    }
    la funksjonstekst = builtin.slice(src, start_pos, slutt_pos)
    fil_skriv(ut, prefiks + funksjonstekst + "\n")
    skriv("[OK] kjeldefunksjon trekt ut: " + namn + "\n")
    returner 0
}
