// Minimal, generert entry for den mellombelse Gen1 source-executor-en.

bruk selfhost.kompiler

funksjon start() -> heiltall {
    la input_sti = miljo_hent("NORSCODE_FILE")
    la output_sti = miljo_hent("NORSCODE_OUTPUT")
    la modul_namn = miljo_hent("NORSCODE_MODULE")
    hvis input_sti == "" eller output_sti == "" eller modul_namn == "" {
        returner 2
    }
    la bytes = kompiler.kompiler_fil_til_disk(input_sti, output_sti, modul_namn)
    hvis bytes > 0 { returner 0 }
    returner 1
}
