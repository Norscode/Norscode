// Minimal, generert entry for den mellombelse Gen1 source-executor-en.

bruk selfhost.lexer.lexer_m1 som lexer
bruk selfhost.parser som parser
bruk selfhost.compiler.ir_to_bytecode som codegen

funksjon start() -> heiltall {
    // NORSCODE_FILE høyrer til den ytre runtime-dispatchen. Gen1-kjelda må
    // ha eit eige namn slik at CI-policy ikkje kan kapre run-ncb-pure-kallet.
    la input_sti = miljo_hent("NORSCODE_GEN1_SOURCE_FILE")
    la output_sti = miljo_hent("NORSCODE_GEN1_OUTPUT_FILE")
    la modul_namn = miljo_hent("NORSCODE_GEN1_MODULE")
    la progress_sti = miljo_hent("NORSCODE_GEN1_PROGRESS_FILE")
    hvis input_sti == "" eller output_sti == "" eller modul_namn == "" {
        returner 2
    }
    hvis progress_sti != "" { fil_skriv(progress_sti, "entry-read-start " + modul_namn) }
    la kjelde = fil_les(input_sti)
    hvis progress_sti != "" { fil_skriv(progress_sti, "entry-compile-start " + modul_namn) }
    // Den committed kompiler-fragmentkopien har historiske, trunkerte
    // importfunksjonar. Bruk dei komplette Gen1-fragmenta direkte. Det gamle
    // semantikkresultatet vart berre validert og aldri brukt av codegen.
    la tokens = lexer.lex(kjelde)
    hvis progress_sti != "" { fil_skriv(progress_sti, "entry-parse-start " + modul_namn) }
    la ast = parser.parse_program(tokens)
    hvis progress_sti != "" { fil_skriv(progress_sti, "entry-codegen-start " + modul_namn) }
    la ncb = codegen.kompiler_til_ncb_json(ast, modul_namn)
    hvis progress_sti != "" { fil_skriv(progress_sti, "entry-write-start " + modul_namn) }
    fil_skriv(output_sti, ncb)
    hvis lengde(ncb) > 0 { returner 0 }
    returner 1
}
