// tools/build_hybrid_compiler_bundle_v9400.no
//
// Bygg ein hybrid compiler-bundle med Norscode som eig transformasjonen.

bruk std.filops som filops
bruk selfhost.ncb_serde som serde

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon dirname(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) < 2 { returner "." }
    la ut = ""
    la i = 0
    mens i < lengde(delar) - 1 {
        hvis i > 0 { ut = ut + "/" }
        ut = ut + delar[i]
        i = i + 1
    }
    hvis ut == "" { returner "/" }
    returner ut
}

funksjon les_json(sti: tekst) {
    returner serde.les_fil(sti)
}

funksjon klon(v) {
    returner builtin.json_parse_raw(builtin.json_stringify(v))
}

funksjon base_namn(namn: tekst) -> tekst {
    la deler = builtin.split(namn, ".")
    returner deler[lengde(deler) - 1]
}

funksjon kjelde_prefiks(prefiks: tekst) -> tekst {
    hvis prefiks == "fresh.lexer" { returner "selfhost.lexer.lexer_m1." }
    hvis prefiks == "fresh.parser" { returner "selfhost.parser." }
    hvis prefiks == "fresh.semantic" { returner "selfhost.compiler.semantic." }
    hvis prefiks == "fresh.ir" { returner "selfhost.compiler.ir_to_bytecode." }
    returner "__main__."
}

funksjon patch_kall(code, prefiks: tekst) {
    la gammal_prefiks = kjelde_prefiks(prefiks)
    la i = 0
    mens i < lengde(code) {
        la ins = code[i]
        hvis lengde(ins) > 1 og ins[0] == "CALL" og builtin.type(ins[1]) == "tekst" og
            (builtin.starts_with(ins[1], "__main__.") eller builtin.starts_with(ins[1], gammal_prefiks)) {
            la kall_namn = ins[1]
            hvis builtin.starts_with(kall_namn, "__main__.") {
                kall_namn = builtin.slice(kall_namn, 9, lengde(kall_namn))
            } ellers {
                kall_namn = builtin.slice(kall_namn, lengde(gammal_prefiks), lengde(kall_namn))
            }
            ins[1] = prefiks + "." + kall_namn
            hvis ins[1] == "fresh.lexer.lexer_keyword_type_for" {
                ins[1] = "fresh.lexer.keyword_type_for"
            }
            code[i] = ins
        }
        i = i + 1
    }
    returner code
}

funksjon legg_modul(out_fns, prefiks: tekst, fil: tekst) -> bool {
    hvis ikkje fil_finst(fil) {
        linje("Manglar modul-NCB: " + fil)
        returner usann
    }
    la mod = les_json(fil)
    hvis ikkje har_nokkel(mod, "functions") {
        linje("Manglar functions i " + fil)
        returner usann
    }
    la fns = mod["functions"]
    la keys = builtin.nøkler(fns)
    la i = 0
    mens i < lengde(keys) {
        la key = keys[i]
        la base = base_namn(key)
        hvis prefiks == "fresh.lexer" og base == "lexer_keyword_type_for" {
            base = "keyword_type_for"
        }
        la full = prefiks + "." + base
        la fn = klon(fns[key])
        fn["name"] = base
        fn["module"] = prefiks
        hvis har_nokkel(fn, "code") {
            fn["code"] = patch_kall(fn["code"], prefiks)
        }
        out_fns[full] = fn
        i = i + 1
    }
    returner sann
}

funksjon legg_kompiler_fil(fns) -> heiltall {
    fns["fresh.kompiler.kompiler_fil"] = {
        "name": "kompiler_fil",
        "module": "fresh.kompiler",
        "params": ["kjelde_tekst", "modul_namn"],
        "is_async": usann,
        "code": [
            ["LOAD_NAME", "kjelde_tekst"], ["CALL", "fresh.lexer.lex", 1], ["STORE_NAME", "tokens"],
            ["LOAD_NAME", "tokens"], ["CALL", "fresh.parser.parse_program", 1], ["STORE_NAME", "ast"],
            ["LOAD_NAME", "ast"], ["CALL", "fresh.semantic.analyser_program", 1], ["STORE_NAME", "tabell"],
            ["LOAD_NAME", "ast"], ["LOAD_NAME", "modul_namn"], ["CALL", "fresh.ir.kompiler_til_ncb_json", 2], ["STORE_NAME", "ncb_json"],
            ["LOAD_NAME", "ncb_json"], ["RETURN"]
        ]
    }
    fns["fresh.entry.start"] = {
        "name": "start",
        "module": "fresh.entry",
        "params": [],
        "is_async": usann,
        "code": [["PUSH_CONST", 0], ["RETURN"]]
    }
    returner 0
}

funksjon bygg(root: tekst, out_path: tekst, ir_path: tekst) -> heiltall {
    hvis out_path == "" { out_path = root + "/build/v9400/hybrid_compiler_bundle_v9400.ncb.json" }
    hvis ir_path == "" { ir_path = root + "/build/v3002/ir_to_bytecode_source_check4.ncb.json" }
    la out = {
        "functions": {},
        "entry": "fresh.entry.start"
    }
    la fns = out["functions"]
    linje("[hybrid-bundle] lexer")
    hvis ikkje legg_modul(fns, "fresh.lexer", root + "/bootstrap/precompiled/lexer_m1.ncb.json") { returner 1 }
    linje("[hybrid-bundle] parser")
    hvis ikkje legg_modul(fns, "fresh.parser", root + "/bootstrap/precompiled/parser.ncb.json") { returner 1 }
    linje("[hybrid-bundle] semantic")
    hvis ikkje legg_modul(fns, "fresh.semantic", root + "/bootstrap/precompiled/semantic.ncb.json") { returner 1 }
    linje("[hybrid-bundle] ir")
    hvis ikkje legg_modul(fns, "fresh.ir", ir_path) { returner 1 }
    linje("[hybrid-bundle] entry")
    legg_kompiler_fil(fns)
    out["functions"] = fns
    // mkdir_p er idempotent, men eldre plattform-ABI-ar kan ikkje alltid
    // attestere ei eksisterande absolutt mappe som /tmp. Sjølve skrivinga er
    // den autoritative suksesskontrollen.
    filops.lag_katalogar(dirname(out_path))
    prøv { builtin.fil_skriv(out_path, builtin.json_stringify(out)) }
    fang (e) { returner 1 }
    linje(out_path)
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la out = env("NORSCODE_HYBRID_BUNDLE_OUT")
    la ir = env("NORSCODE_HYBRID_IR_NCB")
    returner bygg(root, out, ir)
}
