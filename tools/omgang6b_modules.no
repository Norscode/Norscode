// Felles, ordna manifest for Gen0, Gen2, Gen3 og ELF-drivaren.
// kjeldefil|modulnamn|fragmentnamn (utan ending). Behald dei åtte opphavlege
// modulane fyrst; legg avhengigheiter til i same manifest for alle generasjonar.
funksjon spesifikasjonar() -> liste_tekst {
    returner builtin.split(
        "selfhost/lexer/lexer_m1.no|selfhost.lexer.lexer_m1|lexer_m1\n" +
        "selfhost/parser.no|selfhost.parser|parser\n" +
        "selfhost/compiler/semantic.no|selfhost.compiler.semantic|semantic\n" +
        "selfhost/compiler/ir_to_bytecode.no|selfhost.compiler.ir_to_bytecode|ir_to_bytecode\n" +
        "selfhost/json.no|selfhost.json|json\n" +
        "selfhost/kompiler.no|selfhost.kompiler|kompiler\n" +
        "selfhost/bundler.no|selfhost.bundler|bundler\n" +
        "selfhost/elf_compile_driver.no|selfhost.elf_compile_driver|elf_compile_driver\n" +
        "selfhost/compiler/typecheck.no|selfhost.compiler.typecheck|typecheck\n" +
        "selfhost/compiler/namnesjekk.no|selfhost.compiler.namnesjekk|namnesjekk\n" +
        "tools/omgang6b_modules.no|tools.omgang6b_modules|omgang6b_modules", "\n")
}
