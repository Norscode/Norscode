// Felles, ordna manifest for Gen0, Gen2, Gen3 og ELF-drivaren.
// kjeldefil|modulnamn|fragmentnamn (utan ending). Behald dei åtte opphavlege
// modulane fyrst; legg avhengigheiter til i same manifest for alle generasjonar.
funksjon spesifikasjonar() -> liste_tekst {
    returner builtin.split(
        "selfhost/lexer/lexer_m1.no|selfhost.lexer.lexer_m1|lexer_m1\n" +
        "selfhost/parser.no|selfhost.parser|parser\n" +
        "selfhost/compiler/semantic.no|selfhost.compiler.semantic|semantic\n" +
        "selfhost/compiler/ir_to_bytecode.no|selfhost.compiler.ir_to_bytecode|ir_to_bytecode\n" +
        "selfhost/json.no|selfhost.json|json\n" +
        "selfhost/kompiler.no|selfhost.kompiler|kompiler\n" +
        "selfhost/bundler.no|selfhost.bundler|bundler\n" +
        "selfhost/elf_compile_driver.no|selfhost.elf_compile_driver|elf_compile_driver\n" +
        "selfhost/compiler/typecheck.no|selfhost.compiler.typecheck|typecheck\n" +
        "selfhost/compiler/namnesjekk.no|selfhost.compiler.namnesjekk|namnesjekk\n" +
        "tools/omgang6b_modules.no|tools.omgang6b_modules|omgang6b_modules\n" +
        "std/sha256.no|std.sha256|sha256\n" +
        "std/desimaltall_tekst.no|std.desimaltall_tekst|desimaltall_tekst\n" +
        "std/runtime_filesystem.no|std.runtime_filesystem|std_runtime_filesystem\n" +
        "std/sched.no|std.sched|std_sched\n" +
        "std/runtime_filesystem_native.no|std.runtime_filesystem_native|std_runtime_filesystem_native\n" +
        "tools/process_runner.no|tools.process_runner|tools_process_runner\n" +
        "std/runtime/process_abi.no|std.runtime.process_abi|std_runtime_process_abi\n" +
        "selfhost/ncb_stream.no|selfhost.ncb_stream|selfhost_ncb_stream\n" +
        "std/native_gap.no|std.native_gap|std_native_gap\n" +
        "std/tls13_session.no|std.tls13_session|std_tls13_session\n" +
        "std/tls13_handshake.no|std.tls13_handshake|std_tls13_handshake\n" +
        "std/tls13_keyschedule.no|std.tls13_keyschedule|std_tls13_keyschedule\n" +
        "std/hkdf.no|std.hkdf|std_hkdf\n" +
        "std/tls13_record.no|std.tls13_record|std_tls13_record\n" +
        "std/chacha20_poly1305.no|std.chacha20_poly1305|std_chacha20_poly1305\n" +
        "std/bytes.no|std.bytes|std_bytes\n" +
        "std/aes_gcm.no|std.aes_gcm|std_aes_gcm\n" +
        "std/aes.no|std.aes|std_aes\n" +
        "std/ghash.no|std.ghash|std_ghash\n" +
        "std/x25519.no|std.x25519|std_x25519\n" +
        "std/ed25519.no|std.ed25519|std_ed25519\n" +
        "std/sha512.no|std.sha512|std_sha512\n" +
        "std/x509.no|std.x509|std_x509\n" +
        "std/base64.no|std.base64|std_base64\n" +
        "std/rsa.no|std.rsa|std_rsa\n" +
        "std/bigint.no|std.bigint|std_bigint\n" +
        "std/ecdsa_p256.no|std.ecdsa_p256|std_ecdsa_p256\n" +
        "std/native_sys.no|std.native_sys|std_native_sys", "\n")
}

// Metadata blir halde skilt frå den store functions-teksten, så fragmenteringa
// ikkje treng å parse heile compiler-NCB-en til ein dyr VM-objektgraf.
funksjon metadata_for_modul(ncb, modul: tekst) {
    hvis ikkje har_nokkel(ncb, "module_initializers") eller ikkje har_nokkel(ncb, "global_names") {
        kast "Kompilatorfragment manglar modulmetadata: " + modul
    }
    la init = []
    for namn i ncb["module_initializers"] {
        hvis builtin.starts_with(namn, modul + ".") { legg_til(init, namn) }
    }
    la globalar = {}
    hvis har_nokkel(ncb["global_names"], modul) {
        globalar[modul] = ncb["global_names"][modul]
    }
    returner {"module_initializers": init, "global_names": globalar}
}

funksjon metadata_fra_fil(sti: tekst, modul: tekst) {
    la data = builtin.fil_les(sti)
    la start = builtin.index_of(data, "\"functions\":{")
    hvis start < 0 { kast "NCB manglar functions: " + sti }
    // Kjeldeformatet har metadata føre functions. Eldre canonical output kan
    // ha dei etter; parse berre den vesle metadata-delen i begge tilfelle.
    la ncb = builtin.json_parse_raw(builtin.slice(data, 0, start) + "\"functions\":{}}")
    la slutt = builtin.index_of(data, "},\"module_initializers\":")
    hvis slutt >= 0 {
        la etter = builtin.json_parse_raw("{" + builtin.slice(data, slutt + 2, lengde(data)))
        ncb["module_initializers"] = etter["module_initializers"]
        ncb["global_names"] = etter["global_names"]
    }
    // Berre ein per-modul-NCB skal få __main__ omdøypt. I ein seed-bunt
    // høyrer root-metadata ikkje til kvar av dei importerte modulane.
    hvis har_nokkel(ncb, "global_names") og har_nokkel(ncb["global_names"], "__main__") {
        ncb["global_names"][modul] = ncb["global_names"]["__main__"]
        la init = []
        for namn i ncb["module_initializers"] {
            hvis builtin.starts_with(namn, "__main__.") { namn = modul + builtin.slice(namn, 8, lengde(namn)) }
            legg_til(init, namn)
        }
        ncb["module_initializers"] = init
    }
    returner metadata_for_modul(ncb, modul)
}

funksjon metadata_slutt(fragment_dir: tekst) -> tekst {
    la init = []
    la globalar = {}
    for spec i spesifikasjonar() {
        la felt = builtin.split(spec, "|")
        la sti = fragment_dir + "/" + felt[2] + ".metadata.json"
        la meta = builtin.json_parse_raw(builtin.fil_les(sti))
        hvis ikkje har_nokkel(meta, "module_initializers") eller ikkje har_nokkel(meta, "global_names") {
            kast "Ugyldige fragmentmetadata: " + sti
        }
        for namn i meta["module_initializers"] { legg_til(init, namn) }
        for modul i nøkler(meta["global_names"]) { globalar[modul] = meta["global_names"][modul] }
    }
    returner "},\"module_initializers\":" + builtin.json_skriv(init) +
        ",\"global_names\":" + builtin.json_skriv(globalar) + "}"
}
