// tools/verify_selvstendighet.no — L1-L6 sjølvstendighetsgate i Norscode

bruk std.runtime_filesystem som native_fs
bruk std.runtime.process_abi som process_abi

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon strict_mode() -> bool {
    returner env("NORSCODE_SELVSTENDIGHET_STRICT") == "1"
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon native_bin(root: tekst) -> tekst {
    la kandidat = env("NORSCODE_NATIVE_BIN")
    hvis kandidat != "" { returner kandidat }
    kandidat = env("NC_NATIVE")
    hvis kandidat != "" { returner kandidat }
    returner root + "/dist/norscode_native"
}

funksjon basis_miljø(root: tekst, native: tekst) -> ordbok_tekst {
    la caps = env("NORSCODE_VM_CAPABILITIES")
    hvis caps == "" { caps = "env.read,env.write,process.exec,thread.spawn,net.tcp,net.http,net.dns,disk.read,disk.write,jit.execute" }
    la disk = env("NORSCODE_VM_DISK_ROOT")
    hvis disk == "" { disk = root + ",.," + root + "/build,/tmp,/private/tmp" }
    la tmp = env("TMPDIR")
    hvis tmp != "" og builtin.index_of("," + disk + ",", "," + tmp + ",") < 0 {
        disk = disk + "," + tmp
    }
    returner {
        "NORSCODE_ROOT": root,
        "NORSCODE_NATIVE_BIN": native,
        "NC_NATIVE": native,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": caps,
        "NORSCODE_VM_DISK_ROOT": disk,
        "NORSCODE_VM_TARGET_CAPABILITIES": caps,
        "NORSCODE_VM_TARGET_DISK_ROOT": disk
    }
}

funksjon eigar_sti(args: liste_tekst) -> tekst {
    hvis lengde(args) == 0 { returner "" }
    la cmd = tekst(args[0])
    hvis cmd == "python-audit" { returner "tools/python_dependency_audit.no" }
    hvis cmd == "active-surface" { returner "tools/no_c_python_active_surface.no" }
    hvis cmd == "no-legacy-cvm" { returner "tools/no_legacy_cvm.no" }
    hvis cmd == "selfhost-bootstrap-gate" { returner "selfhost/bootstrap_gate.no" }
    hvis cmd == "bootstrap-self" { returner "selfhost/bootstrap_self_pure.no" }
    hvis cmd == "selfcompile-l5" { returner "tools/selfcompile_l5.no" }
    hvis cmd == "selfcompile-l5b-mini" { returner "tools/selfcompile_l5b_mini.no" }
    hvis cmd == "selfcompile-l5b" { returner "tools/selfcompile_l5b.no" }
    hvis cmd == "verify-seed" { returner "tools/verify_seed_only.no" }
    hvis cmd == "test-parallel" { returner "tools/nc_test_parallel.no" }
    hvis cmd == "run-pure" og lengde(args) == 2 { returner tekst(args[1]) }
    returner ""
}

funksjon run_step(root: tekst, label: tekst, args: liste_tekst,
                  ekstra: ordbok_tekst) -> bool {
    linje(label)
    la native = native_bin(root)
    la miljø = basis_miljø(root, native)
    la ekstra_nøklar = nøkler(ekstra)
    la ei: heiltall = 0
    mens ei < lengde(ekstra_nøklar) {
        la nøkkel = tekst(ekstra_nøklar[ei])
        miljø[nøkkel] = tekst(ekstra[nøkkel])
        ei = ei + 1
    }
    la eigar = eigar_sti(args)
    hvis eigar == "" {
        linje("[FEIL] Ukjend strict-eigar for strukturert steg")
        returner usann
    }
    // Kvar strict-del startar den kjende .no-eigaren direkte. Dette verkar
    // også med committed stage0-ar utan dagens kommandoflate og argv-ABI.
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/" + eigar
    la req = process_abi.request(native, [], root, "", 7200000, 67108864)
    process_abi.sett_sandbox(req, "none", 8589934592, 4096, sann)
    process_abi.sett_environment(req, miljø)
    la res = builtin.process_spawn_argv(req)
    hvis tekst(res["status"]) == "ferdig" og heltall_fra_tekst(res["exit_code"]) == 0 {
        la ut = tekst(res["stdout"])
        la feil = tekst(res["stderr"])
        hvis ut != "" { skriv(ut) }
        hvis feil != "" { skriv(feil) }
        linje("")
        returner sann
    }
    la ut_feil = tekst(res["stdout"])
    la err_feil = tekst(res["stderr"])
    hvis ut_feil != "" { skriv(ut_feil) }
    hvis err_feil != "" { skriv(err_feil) }
    linje("")
    linje("[FEIL] " + label + " (status " + tekst(res["status"]) +
          ", exit " + tekst(res["exit_code"]) + ")")
    hvis tekst(res["exit_code"]) == "2" {
        linje("  Hint: exit 2 = oftast manglande fil ved cmp, eller bash-syntaxfeil i eit script.")
    }
    returner usann
}

funksjon tools_er_c_python_fri(root: tekst) -> bool {
    la kø: liste_tekst = ["tools"]
    la qi: heiltall = 0
    mens qi < lengde(kø) {
        la katalog = kø[qi]
        la listing = native_fs.native_list(root, katalog)
        hvis listing["status"] == "ok" {
            la barn = builtin.split(listing["data"], "\n")
            la bi: heiltall = 0
            mens bi < lengde(barn) {
                la namn = builtin.trim(barn[bi])
                hvis namn != "" {
                    la relativ = katalog + "/" + namn
                    la under = native_fs.native_list(root, relativ)
                    hvis under["status"] == "ok" {
                        legg_til(kø, relativ)
                    } ellers hvis builtin.ends_with(namn, ".c") eller
                               builtin.ends_with(namn, ".h") eller
                               builtin.ends_with(namn, ".py") {
                        returner usann
                    }
                }
                bi = bi + 1
            }
        }
        qi = qi + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la ingen: ordbok_tekst = {}

    hvis strict_mode() {
        linje("=== Norscode streng sjølvstendighet (full bevisflate) ===")
    } ellers {
        linje("=== Norscode sjølvstendighet (normalflate, L1-L6) ===")
    }
    linje("")

    hvis ikkje run_step(root, "0. Python-gate i tools/...", ["python-audit"], ingen) { returner 1 }
    hvis ikkje run_step(root, "0b. Ingen aktiv C/Python-flate...", ["active-surface"], ingen) { returner 1 }
    hvis ikkje run_step(root, "0c. Ingen historisk C-VM under tools/...", ["no-legacy-cvm"], ingen) { returner 1 }

    linje("1. Aktiv tools-flate har ingen C/Python-kjelder...")
    hvis tools_er_c_python_fri(root) {
        linje("  [OK] tools/ er C/Python-fri")
        linje("")
    } ellers {
        linje("  [FEIL] C/Python funne under tools/")
        returner 1
    }

    hvis ikkje executable(root + "/dist/norscode_native") {
        linje("  [FEIL] dist/norscode_native manglar. Normalflate skal ikkje bygge stage-0 her.")
        linje("         Materialiser frå seed/release med: ./bin/nc fetch-stage0-seed")
        returner 1
    }
    linje("2. Stage-0: dist/norscode_native finst alt (ingen rebuild i normalflate)")
    linje("")

    hvis ikkje run_step(root, "3. Selfhost bootstrap-gate (steg A+B)...", ["selfhost-bootstrap-gate"], ingen) { returner 1 }
    hvis ikkje run_step(root, "4. Bootstrap-self (steg C)...", ["bootstrap-self"], ingen) { returner 1 }
    hvis ikkje run_step(root, "5. L5 sjølvkompilering (Gen1 == Gen2)...", ["selfcompile-l5"], ingen) { returner 1 }

    hvis strict_mode() {
        hvis ikkje run_step(root, "6. L5b-mini VM-paritet...", ["selfcompile-l5b-mini"], ingen) { returner 1 }
        la cache_på: ordbok_tekst = {"NORSCODE_USE_PRECOMPILED_SELFHOST": "1"}
        hvis ikkje run_step(root, "7a. Full L5b VM-paritet med cache på...",
                            ["selfcompile-l5b"], cache_på) { returner 1 }
        la cache_av: ordbok_tekst = {"NORSCODE_USE_PRECOMPILED_SELFHOST": "0"}
        hvis ikkje run_step(root, "7b. Full L5b VM-paritet med cache av...",
                            ["selfcompile-l5b"], cache_av) { returner 1 }
        hvis ikkje run_step(root, "8. Stage-0 seed-integritet...", ["verify-seed"], ingen) { returner 1 }
        la kandidat = root + "/build/l5b/norscode_native_embedded"
        la payloadar = "compiler=" + root + "/build/l5/compiler_v1.ncb.json;vm=" + root + "/bootstrap/precompiled/vm.ncb.json"
        la embed_miljø: ordbok_tekst = {
            "NORSCODE_EMBED_BASE": native_bin(root),
            "NORSCODE_EMBED_OUT": kandidat,
            "NORSCODE_EMBED_STREAM": "1",
            "NORSCODE_EMBED_SPECS": payloadar
        }
        hvis ikkje run_step(root, "9. Bygg isolert single-binary-kandidat (ingen promotering)...", ["run-pure", "tools/embed_release_ncb.no"], embed_miljø) { returner 1 }
        la single_miljø: ordbok_tekst = {"NORSCODE_NATIVE_BIN": kandidat, "NC_NATIVE": kandidat}
        hvis ikkje run_step(root, "9b. Single-binary utan repo/NCB/PATH...", ["run-pure", "tools/single_binary_gate.no"], single_miljø) { returner 1 }
        hvis ikkje run_step(root, "10. Full normal testflate (8 deterministiske native shards)...", ["test-parallel"], ingen) { returner 1 }
        la slow_miljø: ordbok_tekst = {"NC_SLOW_TESTS": "1", "TEST_TIMEOUT": "600", "SLOW_TEST_TIMEOUT": "600"}
        hvis ikkje run_step(root, "11. Langsam testflate (8 deterministiske native shards)...", ["test-parallel"], slow_miljø) { returner 1 }
        linje("=== Streng sjølvstendighet: BESTÅTT ===")
        returner 0
    }

    linje("6. L5b og full testflate er ikkje del av kort normal verifisering.")
    linje("   Køyr full bevisflate med: ./bin/nc selvstendighet --strict")
    linje("")
    linje("=== Sjølvstendighet L1-L6 (normalflate): BESTÅTT ===")
    returner 0
}
