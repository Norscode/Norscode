// Reproduserbar Windows-kandidat utan C-, Zig- eller shellbygg.
// Committed PE-stage0 er plattformverten; payloadane som er genererte frå kjelde
// (tools/materialize_runtime_payloads.no, J1c) legg til ein ny autoritativ trailer.
// To uavhengige kandidatar må bli byte-identiske;
// dette er ikkje den separate Gen1→Gen2-selfhost-porten. Stage0-pariteten er paritetsporten i
// tools/verify_windows_stage0_parity.no (PE-prefiks + manifestform + payload == generert).

bruk tools.embed_release_ncb som embed
bruk tools.materialize_runtime_payloads som payloads
bruk tools.verify_windows_stage0_parity som paritet
bruk std.runtime_filesystem som native_fs
bruk std.sha256 som sha256

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hash_fil(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    returner ""
}

funksjon skriv_binær_kopi(kjelde: tekst, mål: tekst) -> boolsk {
    prøv {
        builtin.fil_skriv_binær(mål, builtin.fil_les_binær(kjelde))
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon er_pe64(sti: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        hvis lengde(bytes) < 64 eller bytes[0] != 0x4D eller bytes[1] != 0x5A { returner usann }
        la pe = bytes[60] | (bytes[61] << 8) | (bytes[62] << 16) | (bytes[63] << 24)
        hvis pe < 0 eller pe + 26 > lengde(bytes) { returner usann }
        la maskin = bytes[pe + 4] | (bytes[pe + 5] << 8)
        la magic = bytes[pe + 24] | (bytes[pe + 25] << 8)
        returner bytes[pe] == 0x50 og bytes[pe + 1] == 0x45 og
            bytes[pe + 2] == 0 og bytes[pe + 3] == 0 og
            maskin == 0x8664 og magic == 0x20B
    } fang (e) { returner usann }
    returner usann
}

funksjon sluttmarkør(sti: tekst, markør: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        hvis lengde(bytes) < lengde(markør) { returner usann }
        la start = lengde(bytes) - lengde(markør)
        la i = 0
        mens i < lengde(markør) {
            hvis bytes[start + i] != (builtin.char_code(markør[i]) & 255) { returner usann }
            i = i + 1
        }
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la base = env("NORSCODE_WINDOWS_STAGE0_BASE")
    hvis base == "" { base = root + "/bootstrap/stage0/norscode-windows-x86_64.exe" }
    la out = env("NORSCODE_WINDOWS_CANDIDATE")
    hvis out == "" { out = root + "/build/windows/norscode_native_windows_x86_64.exe" }
    la kandidat_b = out + ".candidate-b"
    // F1.2: «compiler»-payloaden (ein 795 B mini-bunt) er pensjonert; ingen runtime les han.
    la namn: liste_tekst = ["vm", "vm-executor"]
    la filer: liste_tekst = []
    la pi = 0
    mens pi < lengde(namn) {
        legg_til(filer, payloads.ut_sti(root, namn[pi]))
        pi = pi + 1
    }
    hvis ikkje payloads.sikre_alle(root, payloads.finn_native(root)) {
        skriv("[FAIL] runtime-payloadane kunne ikkje genererast frå kjelde\n")
        returner 1
    }
    la payloadar: liste_tekst = []
    la payload_lengder: liste_heiltall = []
    la payload_binær: liste = []
    hvis ikkje er_pe64(base) {
        skriv("[FAIL] committed Windows-stage0 er ikkje PE32+ x86_64\n")
        returner 1
    }
    la i = 0
    mens i < lengde(filer) {
        hvis ikkje builtin.fil_finnes(filer[i]) {
            skriv("[FAIL] Windows-kandidat manglar payload: " + filer[i] + "\n")
            returner 1
        }
        legg_til(payloadar, builtin.fil_les(filer[i]))
        la binær = builtin.fil_les_binær(filer[i])
        legg_til(payload_binær, binær)
        legg_til(payload_lengder, lengde(binær))
        i = i + 1
    }
    // Ein rein checkout har ikkje nødvendigvis build/ frå før. Lag begge
    // nivå eksplisitt fordi plattform-ABI-en medvite ikkje lagar foreldre.
    la bygg = native_fs.native_lag_mappe(root, "build")
    hvis bygg["status"] != "created" og bygg["status"] != "ok" og bygg["status"] != "exists" {
        skriv("[FAIL] kunne ikkje lage build-mappe for Windows-kandidat\n")
        returner 1
    }
    la laga = native_fs.native_lag_mappe(root, "build/windows")
    hvis laga["status"] != "created" og laga["status"] != "ok" og laga["status"] != "exists" {
        skriv("[FAIL] kunne ikkje lage Windows-kandidatmappe\n")
        returner 1
    }
    // Den tidlegare «kanonisk stage0»-snarvegen (kopier basen når alle payload-hashar
    // var dei committa) er borte: payloadane er no genererte, ikkje pinna.
    hvis embed.stream_embed_med_binær_lengder(base, out, namn, payloadar, payload_lengder, payload_binær) != 0 eller
       embed.stream_embed_med_binær_lengder(base, kandidat_b, namn, payloadar, payload_lengder, payload_binær) != 0 {
        skriv("[FAIL] Norscode-eigd Windows NCB-embedding feila\n")
        returner 1
    }
    la kandidat_a_hash = hash_fil(out)
    la kandidat_b_hash = hash_fil(kandidat_b)
    la base_hash = hash_fil(base)
    hvis kandidat_a_hash == "" eller kandidat_a_hash != kandidat_b_hash {
        skriv("[FAIL] Windows kandidat A/B er ikkje byte-identiske\n")
        returner 1
    }
    hvis ikkje er_pe64(out) eller
       (ikkje sluttmarkør(out, "NORSCODE_NCB_TEXT_V1") og
        ikkje sluttmarkør(out, "NORSCODE_NCB_IMAGE_V1")) {
        skriv("[FAIL] Windows-kandidaten manglar gyldig PE eller NCB-image\n")
        returner 1
    }
    // B4: paritet = PE-prefikset er byte-identisk med committa stage0, manifestforma er
    // lik (minus pensjonert «compiler») og kvar payload er den genererte fila. Som standard
    // blir her BERRE forma sjekka (billeg på C-æra-vertane som byggjer i CI og i release);
    // den fulle porten (tools/verify_windows_stage0_parity.no) køyrer som eigen Linux-jobb mot
    // kandidaten (ci.yml og windows-app-release.yml: windows-stage0-parity).
    // NORSCODE_REQUIRE_WINDOWS_STAGE0_PARITY=1 køyrer den fulle porten her òg, fail-closed.
    // Formsjekken er ikkje paritet: då blir windows_stage0_parity=unverified skrive, aldri true.
    la krev_paritet = env("NORSCODE_REQUIRE_WINDOWS_STAGE0_PARITY") == "1"
    la paritet_rapport: liste_tekst = []
    la paritet_brot: liste_tekst = []
    hvis krev_paritet {
        paritet_brot = paritet.verifiser(base, out, namn, filer, ["compiler"], paritet_rapport)
    } ellers {
        paritet_brot = paritet.verifiser_form(base, out, namn, ["compiler"])
    }
    la utan_brot = base_hash != "" og lengde(paritet_brot) == 0
    la pr = 0
    mens pr < lengde(paritet_brot) {
        skriv("windows_stage0_parity_brot=" + paritet_brot[pr] + "\n")
        pr = pr + 1
    }
    pr = 0
    mens pr < lengde(paritet_rapport) {
        skriv("windows_stage0_parity_rapport=" + paritet_rapport[pr] + "\n")
        pr = pr + 1
    }
    la kandidat_b_delar = native_fs.native_sti_rot_relativ(kandidat_b)
    native_fs.native_slett(kandidat_b_delar["root"], kandidat_b_delar["relative"])
    hvis krev_paritet og ikkje utan_brot {
        skriv("[FAIL] Windows stage0/kandidat har ikkje paritet (PE-prefiks/manifestform/payloadar)\n")
        skriv("windows_candidate_sha256=" + kandidat_a_hash + "\n")
        skriv("windows_stage0_sha256=" + base_hash + "\n")
        skriv("windows_stage0_parity=false\n")
        returner 1
    }
    skriv("[OK] Windows-kandidat er Norscode-eigd og byte-identisk kandidat A/B\n")
    skriv("windows_candidate_sha256=" + kandidat_a_hash + "\n")
    skriv("windows_stage0_sha256=" + base_hash + "\n")
    // Forma er ein naudsynt del av pariteten: formbrot gjev parity=false i begge modusar.
    hvis utan_brot { skriv("windows_stage0_form=true\n") } ellers { skriv("windows_stage0_form=false\n") }
    hvis krev_paritet {
        // Her har den fulle porten køyrt og funne null brot (elles returnerte vi over).
        skriv("windows_stage0_parity=true\n")
    } ellers hvis utan_brot {
        skriv("windows_stage0_parity=unverified\n")
    } ellers {
        skriv("windows_stage0_parity=false\n")
    }
    returner 0
}
