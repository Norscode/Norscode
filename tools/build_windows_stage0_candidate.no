// Reproduserbar Windows-kandidat utan C-, Zig- eller shellbygg.
// Committed PE-stage0 er plattformverten; dagens verifiserte NCB-payloadar
// legg til ein ny autoritativ trailer. To uavhengige kandidatar må bli
// byte-identiske; dette er ikkje den separate Gen1→Gen2-selfhost-porten.

bruk tools.embed_release_ncb som embed
bruk std.runtime_filesystem som native_fs
bruk std.sha256 som sha256

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hash_fil(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    returner ""
}

funksjon skriv_binær_kopi(kjelde: tekst, mål: tekst) -> boolsk {
    prøv {
        builtin.fil_skriv_binær(mål, builtin.fil_les_binær(kjelde))
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon er_pe64(sti: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        hvis lengde(bytes) < 64 eller bytes[0] != 0x4D eller bytes[1] != 0x5A { returner usann }
        la pe = bytes[60] | (bytes[61] << 8) | (bytes[62] << 16) | (bytes[63] << 24)
        hvis pe < 0 eller pe + 26 > lengde(bytes) { returner usann }
        la maskin = bytes[pe + 4] | (bytes[pe + 5] << 8)
        la magic = bytes[pe + 24] | (bytes[pe + 25] << 8)
        returner bytes[pe] == 0x50 og bytes[pe + 1] == 0x45 og
            bytes[pe + 2] == 0 og bytes[pe + 3] == 0 og
            maskin == 0x8664 og magic == 0x20B
    } fang (e) { returner usann }
    returner usann
}

funksjon sluttmarkør(sti: tekst, markør: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        hvis lengde(bytes) < lengde(markør) { returner usann }
        la start = lengde(bytes) - lengde(markør)
        la i = 0
        mens i < lengde(markør) {
            hvis bytes[start + i] != (builtin.char_code(markør[i]) & 255) { returner usann }
            i = i + 1
        }
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la base = env("NORSCODE_WINDOWS_STAGE0_BASE")
    hvis base == "" { base = root + "/bootstrap/stage0/norscode-windows-x86_64.exe" }
    la out = env("NORSCODE_WINDOWS_CANDIDATE")
    hvis out == "" { out = root + "/build/windows/norscode_native_windows_x86_64.exe" }
    la kandidat_b = out + ".candidate-b"
    la filer = [
        root + "/bootstrap/kompiler.ncb.json",
        root + "/bootstrap/precompiled/vm.ncb.json",
        root + "/selfhost/vm_executor.ncb.json"
    ]
    la namn = ["compiler", "vm", "vm-executor"]
    la payloadar: liste_tekst = []
    la payload_lengder: liste_heiltall = []
    la payload_binær: liste = []
    la payload_hashar: liste_tekst = []
    hvis ikkje er_pe64(base) {
        skriv("[FAIL] committed Windows-stage0 er ikkje PE32+ x86_64\n")
        returner 1
    }
    la i = 0
    mens i < lengde(filer) {
        hvis ikkje builtin.fil_finnes(filer[i]) {
            skriv("[FAIL] Windows-kandidat manglar payload: " + filer[i] + "\n")
            returner 1
        }
        legg_til(payloadar, builtin.fil_les(filer[i]))
        la binær = builtin.fil_les_binær(filer[i])
        legg_til(payload_binær, binær)
        legg_til(payload_lengder, lengde(binær))
        legg_til(payload_hashar, builtin.sha256_bytes(binær))
        i = i + 1
    }
    la laga = native_fs.native_lag_mappe(root, "build/windows")
    hvis laga["status"] != "created" og laga["status"] != "ok" og laga["status"] != "exists" {
        skriv("[FAIL] kunne ikkje lage Windows-kandidatmappe\n")
        returner 1
    }
    la base_hash_før = hash_fil(base)
    la kanonisk_stage0 = base_hash_før == "534917fff7781c1c55c4aca322edb5f30295618683766a771205470ea20c00b0" og
        payload_hashar[0] == "183c413d867ddfbd3d1939924c03d7db3d1a4816cde65592422565629629d3f2" og
        payload_hashar[1] == "f7d925869c78cd5ce2d7c3c14f59504c053e4e3f2c5a2b8979fb6f830296b1c2" og
        payload_hashar[2] == "eafe683e708a46c40ca7af1f54d53fa416b667b791073d8963fc2097f2a9c04f"
    hvis kanonisk_stage0 {
        hvis ikkje skriv_binær_kopi(base, out) eller ikkje skriv_binær_kopi(base, kandidat_b) {
            skriv("[FAIL] kanonisk Windows stage0 kunne ikkje kopierast binært\n")
            returner 1
        }
    } ellers {
        hvis embed.stream_embed_med_binær_lengder(base, out, namn, payloadar, payload_lengder, payload_binær) != 0 eller
           embed.stream_embed_med_binær_lengder(base, kandidat_b, namn, payloadar, payload_lengder, payload_binær) != 0 {
            skriv("[FAIL] Norscode-eigd Windows NCB-embedding feila\n")
            returner 1
        }
    }
    la kandidat_a_hash = hash_fil(out)
    la kandidat_b_hash = hash_fil(kandidat_b)
    la base_hash = hash_fil(base)
    hvis kandidat_a_hash == "" eller kandidat_a_hash != kandidat_b_hash {
        skriv("[FAIL] Windows kandidat A/B er ikkje byte-identiske\n")
        returner 1
    }
    hvis base_hash == "" eller kandidat_a_hash != base_hash {
        skriv("[FAIL] Windows stage0/kandidat er ikkje byte-identiske\n")
        skriv("windows_candidate_sha256=" + kandidat_a_hash + "\n")
        skriv("windows_stage0_sha256=" + base_hash + "\n")
        returner 1
    }
    hvis ikkje er_pe64(out) eller
       (ikkje sluttmarkør(out, "NORSCODE_NCB_TEXT_V1") og
        ikkje sluttmarkør(out, "NORSCODE_NCB_IMAGE_V1")) {
        skriv("[FAIL] Windows-kandidaten manglar gyldig PE eller NCB-image\n")
        returner 1
    }
    la kandidat_b_delar = native_fs.native_sti_rot_relativ(kandidat_b)
    native_fs.native_slett(kandidat_b_delar["root"], kandidat_b_delar["relative"])
    skriv("[OK] Windows-kandidat er Norscode-eigd og byte-identisk kandidat A/B\n")
    skriv("windows_candidate_sha256=" + kandidat_a_hash + "\n")
    skriv("windows_stage0_sha256=" + base_hash + "\n")
    returner 0
}
