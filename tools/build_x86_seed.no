// tools/build_x86_seed.no — bygg ein Linux x86_64 native nc_main-seed frå
// gjeldande kjelde utan bygg-native-CLI og utan fersk-codegen-self-boot.
//
// To steg, begge spawna med EKSPLISITT miljø (omgår ci_shell_runner-whitelista):
//   1) `dist compile selfhost/nc_main.no <ncb>` (NORSCODE_CMD UUSETT → argv-cmd)
//      → full-host NCB (bundlar heile den transitive importgrafen).
//   2) `dist run selfhost/native_execution/native_codegen_v2.no` med
//      NC_INPUT/NC_OUTPUT → native ELF. Codegen køyrer INTERPRETERT, så vi
//      unngår self-boot-segfaulten i native_codegen_v2 sine rt_hex-blobar.
//
// Verifisering (selftest + run-ncb-pure=42) skjer i eit eige CI bash-steg på
// den ferdige ELF-en.

bruk std.filops som filops
bruk std.runtime.process_abi som process_abi

funksjon linje(m: tekst) -> heiltall { skriv(m + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon bytes(sti: tekst) -> tekst {
    prøv { returner tekst_fra_heltall(lengde(builtin.fil_les_binær(sti))) } fang (e) { returner "0" }
}

funksjon spawn(native: tekst, argv: liste_tekst, root: tekst, miljø: ordbok_tekst,
               timeout_ms: heiltall) -> ordbok_tekst {
    la req = process_abi.request(native, argv, root, "", timeout_ms, 65536)
    process_abi.sett_sandbox(req, "none", 0, 64, usann)
    process_abi.sett_environment(req, miljø)
    la res = builtin.process_spawn_argv(req)
    hvis res["stdout"] != "" { skriv(res["stdout"]) }
    hvis res["stderr"] != "" { skriv(res["stderr"]) }
    returner res
}

funksjon ok(res: ordbok_tekst) -> boolsk {
    returner res["status"] == "ferdig" og heltall_fra_tekst(tekst(res["exit_code"])) == 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/dist/norscode_native" }
    hvis ikkje builtin.fil_finnes(native) { linje("Feil: manglar native runtime: " + native) returner 1 }

    la kjelde = root + "/selfhost/nc_main.no"
    la ncb = root + "/build/nc_main_full_x86.ncb.json"
    la elf = root + "/build/nc_main_x86_64_seed.elf"
    la codegen = root + "/selfhost/native_execution/native_codegen_v2.no"
    hvis ikkje filops.lag_katalogar(root + "/build") { returner 1 }

    la disk = root + ",.,/tmp,/private/tmp," + root + "/build"

    // ── Steg 1: kompiler nc_main → full-host NCB (argv-cmd, NORSCODE_CMD uusett) ──
    linje("[1/2] Kompilerer full nc_main → NCB ...")
    la komp_env = {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": disk
    }
    la r1 = spawn(native, ["compile", kjelde, ncb], root, komp_env, 1800000)
    hvis ikkje ok(r1) {
        linje("[FEIL] nc_main-kompilering feila: status=" + tekst(r1["status"]) +
              " exit=" + tekst(r1["exit_code"]) + " error=" + tekst(r1["error"]))
        returner 1
    }
    hvis ikkje builtin.fil_finnes(ncb) { linje("[FEIL] NCB ikkje skrive: " + ncb) returner 1 }
    linje("[OK] NCB " + bytes(ncb) + " bytes")

    // ── Steg 2: NCB → native ELF via interpretert native_codegen_v2 ──
    linje("[2/2] Native codegen (interpretert) NCB → ELF ...")
    la cg_env = {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": codegen,
        "NC_INPUT": ncb,
        "NC_OUTPUT": elf,
        "NC_NATIVE_SYMBOL_MAP": elf + ".symbols",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": disk
    }
    la r2 = spawn(native, [], root, cg_env, 1800000)
    hvis ikkje ok(r2) {
        linje("[FEIL] native codegen feila: status=" + tekst(r2["status"]) +
              " exit=" + tekst(r2["exit_code"]) + " error=" + tekst(r2["error"]))
        returner 1
    }
    hvis ikkje builtin.fil_finnes(elf) { linje("[FEIL] ELF ikkje skrive: " + elf) returner 1 }
    prøv { builtin.fil_sett_kjorbar(elf) } fang (e) {}
    linje("[OK] Native seed ELF " + bytes(elf) + " bytes → " + elf)
    linje("=== x86_64 nc_main native seed bygd ===")
    returner 0
}
