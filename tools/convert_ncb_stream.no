bruk selfhost.ncb_stream som stream

funksjon start() -> heiltall {
    la inn = miljo_hent("NORSCODE_NCB_STREAM_INPUT")
    la ut = miljo_hent("NORSCODE_NCB_STREAM_OUTPUT")
    hvis inn == "" eller ut == "" {
        skriv("Bruk: NORSCODE_NCB_STREAM_INPUT=<in.ncb.json> NORSCODE_NCB_STREAM_OUTPUT=<ut.ncbs> nc run tools/convert_ncb_stream.no\n")
        returner 2
    }
    la ncb = builtin.json_parse_raw(fil_les(inn))
    la resultat = stream.skriv_fil(ut, ncb)
    skriv("convert_ncb_stream: " + resultat["records"] + " postar, " + resultat["bytes"] + " byte\n")
    returner 0
}
