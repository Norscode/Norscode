// Kjor Windows-native smoke-tests pa ein faktisk Windows-host.
// Cross-compile-gaten kan kjorast pa macOS/Linux; denne gaten krev Windows.

bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon er_windows() -> boolsk {
    prøv {
        la system = builtin.lower(tekst(builtin.system_info()["system"]))
        returner builtin.contains(system, "windows") eller builtin.starts_with(system, "mingw") eller
            builtin.starts_with(system, "msys") eller builtin.starts_with(system, "cygwin")
    } fang (e) { returner usann }
    returner usann
}

funksjon kjor(root: tekst, sti: tekst, namn: tekst) -> heiltall {
    la res = prosess.køyr(sti, [], root, {}, 120000)
    hvis ikkje prosess.ok(res) {
        skriv("[FAIL] Windows " + namn + ": " + tekst(res["stderr"]) + "\n")
        returner 1
    }
    skriv(tekst(res["stdout"]))
    returner 0
}

funksjon start() -> heiltall {
    hvis ikkje er_windows() {
        skriv("[FAIL] Windows execution-gate krev faktisk Windows-host\n")
        returner 2
    }
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la smoke = env("NORSCODE_WINDOWS_BACKEND_SMOKE")
    hvis smoke == "" { smoke = root + "/build/windows/nc_windows_backend_smoke_x86_64.exe" }
    la app = env("NORSCODE_WINDOWS_APPCONTAINER_SMOKE")
    hvis app == "" { app = root + "/build/windows/nc_windows_appcontainer_smoke_x86_64.exe" }
    hvis kjor(root, smoke, "backend smoke") != 0 { returner 1 }
    hvis kjor(root, app, "AppContainer smoke") != 0 { returner 1 }
    skriv("[OK] Windows runtime execution-gate er grøn\n")
    returner 0
}
