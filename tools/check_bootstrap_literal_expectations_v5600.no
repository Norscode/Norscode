// Prosessfri kontroll av v5600 output-NCB-ar.

bruk std.filops som filops

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon require_file(path: tekst) -> bool {
    hvis filops.fil_finnes(path) { returner sann }
    linje("[FAIL] manglar output: " + path)
    returner usann
}

funksjon require_contains(path: tekst, needle: tekst) -> bool {
    hvis ikkje require_file(path) { returner usann }
    prøv {
        hvis builtin.index_of(builtin.fil_les(path), needle) >= 0 { returner sann }
    } fang (e) {
        linje("[FAIL] kan ikkje lese output: " + path)
        returner usann
    }
    linje("[FAIL] fann ikkje '" + needle + "' i " + path)
    returner usann
}

funksjon sjekk(outdir: tekst) -> bool {
    la krav = [
        ["list_literal.ncb.json", "BUILD_LIST"],
        ["empty_list.ncb.json", "BUILD_LIST"],
        ["map_literal.ncb.json", "BUILD_MAP"],
        ["index_expr.ncb.json", "INDEX_GET"],
        ["assignment_list.ncb.json", "BUILD_LIST"],
        ["assignment_map.ncb.json", "BUILD_MAP"],
        ["assignment_index.ncb.json", "INDEX_GET"]
    ]
    la i = 0
    mens i < lengde(krav) {
        hvis ikkje require_contains(outdir + "/" + krav[i][0], krav[i][1]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la outdir = env("OUTDIR")
    hvis outdir == "" { outdir = root + "/build/v5600/out" }
    hvis ikkje sjekk(outdir) { returner 1 }
    linje("[OK] bootstrap literal expectations passerte")
    returner 0
}
