// tools/verify_seed_only.no — shellfri seed-first verifikasjon i Norscode.
// Porten arbeider berre i eit mellombels område og endrar aldri dist/stage0.

bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon info_felt(info: ordbok_tekst, primær: tekst, legacy: tekst) -> tekst {
    hvis finnes_nøkkel(info, primær) { returner builtin.lower(tekst(info[primær])) }
    hvis finnes_nøkkel(info, legacy) { returner builtin.lower(tekst(info[legacy])) }
    returner ""
}

funksjon platform_name() -> tekst {
    la preset = env("NORSCODE_SEED_PLATFORM")
    hvis preset != "" { returner preset }
    la runner_os = builtin.lower(env("RUNNER_OS"))
    la runner_arch = builtin.lower(env("RUNNER_ARCH"))
    hvis runner_os == "macos" {
        hvis runner_arch == "arm64" eller runner_arch == "aarch64" { returner "macos-arm64" }
        hvis runner_arch == "x64" eller runner_arch == "x86_64" eller runner_arch == "amd64" { returner "macos-x86_64" }
    }
    hvis runner_os == "linux" {
        hvis runner_arch == "arm64" eller runner_arch == "aarch64" { returner "linux-arm64" }
        hvis runner_arch == "x64" eller runner_arch == "x86_64" eller runner_arch == "amd64" { returner "linux-x86_64" }
    }
    hvis runner_os == "windows" og
       (runner_arch == "x64" eller runner_arch == "x86_64" eller runner_arch == "amd64") {
        returner "windows-x86_64"
    }
    prøv {
        la info = builtin.system_info()
        la os = info_felt(info, "system", "os")
        la arch = info_felt(info, "machine", "arch")
        hvis builtin.contains(os, "mac") eller builtin.contains(os, "darwin") {
            hvis arch == "arm64" eller arch == "aarch64" { returner "macos-arm64" }
            hvis arch == "x86_64" eller arch == "amd64" { returner "macos-x86_64" }
        }
        hvis builtin.contains(os, "linux") {
            hvis arch == "arm64" eller arch == "aarch64" { returner "linux-arm64" }
            hvis arch == "x86_64" eller arch == "amd64" { returner "linux-x86_64" }
        }
        hvis builtin.contains(os, "windows") {
            hvis arch == "x86_64" eller arch == "amd64" { returner "windows-x86_64" }
        }
    } fang (e) {}
    returner "?"
}

funksjon rydd(tmp_rot: tekst, tmp_relativ: tekst) -> heiltall {
    prøv { native_fs.native_slett(tmp_rot, tmp_relativ + "/smoke.no") } fang (e) {}
    prøv { native_fs.native_slett(tmp_rot, tmp_relativ + "/norscode_seed") } fang (e) {}
    prøv { native_fs.native_slett_mappe(tmp_rot, tmp_relativ) } fang (e) {}
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la platform = platform_name()
    la suffix = ""
    hvis builtin.starts_with(platform, "windows-") { suffix = ".exe" }
    la stage0 = root + "/bootstrap/stage0/norscode-" + platform + suffix
    hvis ikkje fil_finst(stage0) {
        hvis env("VERIFY_SEED_ALLOW_MISSING") == "1" {
            linje("=== Seed-only: hoppa over (ingen stage0-seed for " + platform + ") ===")
            returner 0
        }
        linje("=== Seed-only: FEIL (ingen stage0-seed for " + platform + ") ===")
        returner 1
    }

    // Bruk ein eksplisitt gate-rot. Ambient macOS TMPDIR ligg under
    // /var/folders og er ikkje del av den avgrensa VM-diskpolicyen.
    la tmp_rot = env("NORSCODE_SEED_TMP_ROOT")
    hvis tmp_rot == "" { tmp_rot = "/tmp" }
    la tmp_resultat = native_fs.native_tempområde(tmp_rot, "nc_seed_only.")
    hvis tmp_resultat["status"] != "created" {
        linje("Klarte ikkje lage mellombels seed-område")
        returner 1
    }
    la tmp_relativ = tekst(tmp_resultat["relative"])
    la tmp_dir = tmp_rot + "/" + tmp_relativ
    la kandidat = tmp_dir + "/norscode_seed"
    la smoke = tmp_dir + "/smoke.no"

    prøv {
        // Kopien provar at committed seed er sjølvstendig utan å skrive til dist.
        builtin.fil_skriv_binær(kandidat, builtin.fil_les_binær(stage0))
        hvis ikkje builtin.fil_sett_kjorbar(kandidat) { kast "kunne ikkje setje seed-kopi køyrbar" }
        builtin.fil_skriv(smoke, "funksjon start() { returner 0 }\n")
        la miljø = {
            "CC": "__clang_not_allowed__",
            "PATH": "/nonexistent",
            "NORSCODE_ROOT": tmp_dir,
            "NORSCODE_CMD": "run",
            "NORSCODE_FILE": smoke,
            "NORSCODE_VM_CAPABILITIES": "env.read,disk.read",
            "NORSCODE_VM_DISK_ROOT": tmp_dir
        }
        la resultat = prosess.køyr(kandidat, [], tmp_dir, miljø, 30000)
        hvis ikkje prosess.ok(resultat) {
            prosess.skriv_resultat(resultat)
            rydd(tmp_rot, tmp_relativ)
            linje("=== Seed-only: FEIL (isolert seed-smoke) ===")
            returner 1
        }
    } fang (e) {
        rydd(tmp_rot, tmp_relativ)
        linje("=== Seed-only: FEIL (" + tekst(e) + ") ===")
        returner 1
    }

    rydd(tmp_rot, tmp_relativ)
    linje("[OK] committed seed køyrer isolert med CC/PATH deaktivert")
    linje("[OK] dist og stage0 vart ikkje endra")
    linje("")
    linje("=== Seed-only verifikasjon: BESTÅTT ===")
    returner 0
}
