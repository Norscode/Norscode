// Minimal, deterministisk ZIP-skrivar for releaseverktøy. Det versjonerte
// modulnamnet hindrar at active runtime maskerer levande kjelde med ein eldre,
// innebygd tools.zip_stored_writer.

bruk std.runtime_filesystem som fs

funksjon le(data: liste_heiltall, verdi: heiltall, breidde: heiltall) -> heiltall {
    la i = 0
    mens i < breidde {
        legg_til(data, (verdi >> (i * 8)) & 255)
        i = i + 1
    }
    returner 0
}

funksjon namn_bytes(namn: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(namn) {
        la kode = builtin.char_code(builtin.slice(namn, i, i + 1))
        hvis kode < 1 eller kode > 127 { returner [] }
        legg_til(ut, kode)
        i = i + 1
    }
    returner ut
}

funksjon trygt_namn(namn: tekst) -> boolsk {
    hvis namn == "" eller builtin.starts_with(namn, "/") eller
       builtin.index_of(namn, builtin.chr(92)) >= 0 eller builtin.index_of(namn, "\n") >= 0 {
        returner usann
    }
    la delar = builtin.split(namn, "/")
    la i = 0
    mens i < lengde(delar) {
        hvis delar[i] == "" eller delar[i] == "." eller delar[i] == ".." { returner usann }
        i = i + 1
    }
    returner lengde(namn_bytes(namn)) > 0
}

funksjon crc32(data: liste_heiltall) -> heiltall {
    la tabell: liste_heiltall = [0, 498536548, 997073096, 651767980,
        1994146192, 1802195444, 1303535960, 1342533948,
        3988292384, 4027552580, 3604390888, 3412177804,
        2607071920, 2262029012, 2685067896, 3183342108]
    la crc = 4294967295
    la i = 0
    mens i < lengde(data) {
        crc = crc ^ data[i]
        crc = (crc >> 4) ^ tabell[crc & 15]
        crc = (crc >> 4) ^ tabell[crc & 15]
        i = i + 1
    }
    returner crc ^ 4294967295
}

