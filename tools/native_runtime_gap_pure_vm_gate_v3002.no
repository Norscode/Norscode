// Shellfri runtime-gap-port via nc run-ncb-pure.
bruk std.tempfile som tempfile
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon rot() -> tekst {
    la r = env("NORSCODE_ROOT")
    hvis r != "" { returner r }
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon køyr(runtime: tekst, root: tekst, argv: liste_tekst) -> ordbok_tekst {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.",
        "PATH": "/nonexistent"
    }
    returner prosess.køyr(runtime, argv, root, miljø, 180000)
}

funksjon krev_ok(resultat: ordbok_tekst) -> boolsk {
    hvis prosess.ok(resultat) { returner sann }
    prosess.skriv_resultat(resultat)
    returner usann
}

funksjon start() -> heiltall {
    la root = rot()
    la runtime = env("NORSCODE_NATIVE_GAP_BIN")
    hvis runtime == "" { runtime = env("NORSCODE_NATIVE_BIN") }
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la runner = root + "/selfhost/tooling/ncb_pure_run_entry.no"
    la probe = root + "/tests/native_runtime_gap_probe_v3001.no"
    la upload = root + "/tests/opplasting_mappe_gap_probe.no"
    la temp = tempfile.ny_tempkatalog("norscode_pure_vm_gate_")
    la dir = tempfile.sti(temp)
    la probe_ncb = dir + "/probe.ncb.json"
    la upload_ncb = dir + "/upload.ncb.json"

    skriv("== native runtime gap pure VM gate v3002 ==\n")
    hvis ikkje builtin.fil_finnes(runtime) eller ikkje builtin.fil_finnes(runner) { tempfile.lukk(temp); returner 1 }
    hvis ikkje krev_ok(køyr(runtime, root, ["check", runner])) eller
       ikkje krev_ok(køyr(runtime, root, ["check", probe])) eller
       ikkje krev_ok(køyr(runtime, root, ["check", upload])) { tempfile.lukk(temp); returner 1 }
    hvis ikkje krev_ok(køyr(runtime, root, ["compile", probe, "-o", probe_ncb])) eller
       ikkje krev_ok(køyr(runtime, root, ["compile", upload, "-o", upload_ncb])) { tempfile.lukk(temp); returner 1 }

    la a = køyr(runtime, root, ["run-ncb-pure", probe_ncb])
    la b = køyr(runtime, root, ["run-ncb-pure", upload_ncb])
    la output = tekst(a["stdout"]) + tekst(a["stderr"]) +
                 tekst(b["stdout"]) + tekst(b["stderr"])
    tempfile.lukk(temp)
    hvis ikkje prosess.ok(a) eller ikkje prosess.ok(b) eller
       builtin.index_of(output, "PURE-VM ERROR") >= 0 eller
       builtin.index_of(output, "mappe_opprett OK") < 0 eller
       builtin.index_of(output, "opplasting_mappe OK") < 0 {
        skriv(output)
        skriv("[FAIL] pure VM-kandidat feila\n")
        returner 1
    }
    skriv("[OK] pure VM-kandidat er grønn for runtime-gap v3002\n")
    returner 0
}
