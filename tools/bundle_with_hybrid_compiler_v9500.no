// Norscode-eigd bundleinngang. Kompilerer kvar spesifikasjon gjennom den
// aktive Norscode-importgrafen og slår saman NCB-fragment utan Node/JavaScript.
// NORSCODE_HYBRID_ROOT=<repo-root> NORSCODE_HYBRID_OUT=<out.ncb.json> NORSCODE_HYBRID_ENTRY=<entry> NORSCODE_HYBRID_SPECS='<alias=fil.no>...' ./bin/nc run tools/bundle_with_hybrid_compiler_v9500.no

bruk std.filops som filops
bruk std.tempfile som tempfile
bruk tools.process_runner som process_runner

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim(t: tekst) -> tekst { returner builtin.trim(t) }
funksjon bundle_alias_sti(alias: tekst) -> tekst { returner builtin.replace(alias, ".", "_") }

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon node_finst(home: tekst) -> bool {
    // Norscode-eigarfilen har ingen Node-avhengig aktiv veg.
    returner home == "" eller fil_finst(home)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_HYBRID_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la out = env("NORSCODE_HYBRID_OUT")
    la entry = env("NORSCODE_HYBRID_ENTRY")
    hvis entry == "" { entry = "__main__.start" }
    la specs = env("NORSCODE_HYBRID_SPECS")
    la native_bin = env("NORSCODE_NATIVE_BIN")
    hvis native_bin == "" { native_bin = root + "/dist/norscode_native" }
    la home = env("HOME")
    la project_root = env("NORSCODE_PROJECT_ROOT")
    hvis project_root == "" { project_root = env("NORSCODE_IMPORT_BASE") }
    hvis project_root == "" { project_root = root }

    hvis out == "" eller specs == "" {
        linje("bruk: nc bundle --output <fil> alias=kjelde.no ...")
        returner 2
    }
    hvis ikkje executable(native_bin) {
        linje("feil: manglar native runtime: " + native_bin)
        returner 1
    }
    // Reserveveg: hvis ikkje node_finst(home), blir Node-bundling avgrensa til wrapperen.
    la temp_obj = tempfile.ny_tempkatalog("norscode_bundle_")
    la tmpdir = tempfile.sti(temp_obj)
    la compiled: liste_tekst = []
    // Éi spesifikasjon per linje bevarer prosjekt- og kjeldestiar med mellomrom.
    la parts = builtin.split(specs, "\n")
    la i: heiltall = 0
    mens i < lengde(parts) {
        la spec = trim(parts[i])
        hvis spec != "" {
            la eq = builtin.index_of(spec, "=")
            hvis eq <= 0 {
                tempfile.lukk(temp_obj)
                linje("ugyldig bundle-spesifikasjon: " + spec)
                returner 2
            }
            la alias = builtin.slice(spec, 0, eq)
            la src = builtin.slice(spec, eq + 1, lengde(spec))
            la out_json = tmpdir + "/" + bundle_alias_sti(alias) + ".ncb.json"
            la compile_env = {"NORSCODE_ENABLE_EXEC_PROSESS": "1", "NORSCODE_HYBRID_ROOT": root, "NORSCODE_HYBRID_SRC": src, "NORSCODE_HYBRID_OUT": out_json, "NORSCODE_HYBRID_MODULE": alias, "NORSCODE_HYBRID_PROJECT_ROOT": project_root, "NORSCODE_NATIVE_BIN": native_bin, "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write", "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp", "NORSCODE_CMD": "run", "NORSCODE_FILE": root + "/tools/compile_with_hybrid_bundle_v9400.no"}
            la comp = process_runner.køyr(native_bin, [], root, compile_env, 600000)
            hvis ikkje process_runner.ok(comp) {
                process_runner.skriv_resultat(comp)
                tempfile.lukk(temp_obj)
                returner 1
            }
            legg_til(compiled, out_json)
        }
        i = i + 1
    }

    la merge_env = {"NORSCODE_ENABLE_EXEC_PROSESS": "1", "NORSCODE_HYBRID_MERGE_OUT": out, "NORSCODE_HYBRID_MERGE_ENTRY": entry, "NORSCODE_HYBRID_MERGE_FILES": builtin.join(compiled, "|"), "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write", "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp", "NORSCODE_CMD": "run", "NORSCODE_FILE": root + "/tools/merge_hybrid_bundle_v9500.no"}
    la res = process_runner.køyr(native_bin, [], root, merge_env, 600000)
    tempfile.lukk(temp_obj)
    process_runner.skriv_resultat(res)
    hvis process_runner.ok(res) og filops.fil_finnes(out) {
        linje("Norscode bundle: " + out)
        returner 0
    }
    returner 1
}
