// tools/nc_regen_bootstrap.no — regenerer bootstrap-NCBs med bin/nc

bruk std.filops som filops
bruk std.tempfile som tempfile
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim(t: tekst) -> tekst {
    returner builtin.trim(t)
}

funksjon køyr(nc: tekst, argv: liste_tekst, root: tekst, miljø: ordbok_tekst) -> ordbok_tekst {
    // Dagens VM-kompilering passerer ABI-taket på 8 GiB. Null betyr at OS-et
    // eig minnegrensa; timeout, fd-tak og outputgrense er framleis eksplisitte.
    // Minneforbruket er ein målt fase-6-regresjon, ikkje ein shellreserve.
    returner prosess.køyr_med_grenser(nc, argv, root, miljø, 1200000,
                                      0, 1024)
}

funksjon run(nc: tekst, argv: liste_tekst, root: tekst, miljø: ordbok_tekst) -> bool {
    la res = køyr(nc, argv, root, miljø)
    prosess.skriv_resultat(res)
    hvis ikkje prosess.ok(res) {
        la detalj = ""
        hvis finnes_nøkkel(res, "error") { detalj = " error=" + tekst(res["error"]) }
        linje("✗ Prosess feilet: status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) + detalj)
    }
    returner prosess.ok(res)
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon lag_mappe(sti: tekst) -> bool {
    returner filops.lag_katalogar(sti)
}

funksjon bytes(sti: tekst) -> tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner tekst_fra_heltall(lengde(innhald))
    } fang (e) {}
    returner ""
}

funksjon temp_bundle_sti(root: tekst) -> tekst {
    la obj = tempfile.ny_tempfil("nc_bundle_", ".ncb.json")
    returner tempfile.sti(obj)
}

funksjon bundle_args() -> tekst {
    returner "selfhost.lexer.lexer_m1=selfhost/lexer/lexer_m1.no " +
        "selfhost.parser=selfhost/parser.no " +
        "selfhost.compiler.semantic=selfhost/compiler/semantic.no " +
        "selfhost.compiler.ir_to_bytecode=selfhost/compiler/ir_to_bytecode.no " +
        "selfhost.kompiler=selfhost/kompiler.no " +
        "selfhost.json=selfhost/json.no " +
        "selfhost.vm=selfhost/vm.no " +
        "selfhost.bundler=selfhost/bundler.no " +
        "selfhost.nc_main=selfhost/nc_main.no " +
        // Native AOT-backendane må liggje i bootstrap-bundlen slik at ein
        // sjølvstendig VM kan køyre både ELF- og Mach-O-testane utan å lese
        // modulane frå repoet etter oppstart.
        "selfhost.native_execution.macho_arm64_emitter=selfhost/native_execution/macho_arm64_emitter.no " +
        "selfhost.native_execution.macho_arm64_codegen=selfhost/native_execution/macho_arm64_codegen.no " +
        "selfhost.native_execution.elf_arm64_emitter=selfhost/native_execution/elf_arm64_emitter.no " +
        "selfhost.native_execution.elf_arm64_codegen=selfhost/native_execution/elf_arm64_codegen.no " +
        "selfhost.native_execution.embedded_ncb_image=selfhost/native_execution/embedded_ncb_image.no " +
        "selfhost.native_execution.embedded_runtime_entry=selfhost/native_execution/embedded_runtime_entry.no"
}

funksjon stdlib_modular() -> liste_tekst {
    la mods: liste_tekst = []
    legg_til(mods, "std/math.no")
    legg_til(mods, "std/tekst.no")
    legg_til(mods, "std/liste.no")
    legg_til(mods, "std/ordbok.no")
    legg_til(mods, "std/json.no")
    legg_til(mods, "std/feil.no")
    legg_til(mods, "std/env.no")
    legg_til(mods, "std/io.no")
    legg_til(mods, "std/fil.no")
    legg_til(mods, "std/log.no")
    legg_til(mods, "std/metrics.no")
    legg_til(mods, "std/path.no")
    legg_til(mods, "std/cache.no")
    legg_til(mods, "std/stil.no")
    legg_til(mods, "selfhost/common.no")
    legg_til(mods, "selfhost/ir_contract.no")
    legg_til(mods, "selfhost/compiler.no")
    legg_til(mods, "selfhost/compiler_bridge.no")
    returner mods
}

funksjon outnamn(mod: tekst) -> tekst {
    la name = builtin.replace(mod, "/", "_")
    hvis builtin.ends_with(name, ".no") {
        name = builtin.slice(name, 0, lengde(name) - 3) + ".ncb.json"
    }
    returner "bootstrap/stdlib/" + name
}

funksjon normaliser_ncb(root: tekst, nc: tekst, sti: tekst) -> bool {
    la miljø = {"NORSCODE_NCB_NORMALIZE_IN": sti, "NORSCODE_NCB_NORMALIZE_OUT": sti, "NORSCODE_ROOT": root}
    returner run(nc, ["run", "tools/ncb_normalize_builtin_aliases_v802.no"], root, miljø)
}

funksjon main() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la nc = root + "/bin/nc"
    la base_env = {"NORSCODE_ROOT": root, "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write", "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"}

    hvis ikkje executable(root + "/dist/norscode_native") {
        linje("✗ Trenger dist/norscode_native.")
        linje("  Last ned frå: https://github.com/Norscode/Norscode/releases")
        returner 1
    }

    hvis env("NORSCODE_REGEN_BOOTSTRAP_FULL") == "1" {
        linje("Genererer full bootstrap/kompiler.ncb.json...")
        la tmp = temp_bundle_sti(root)
        hvis tmp == "" { returner 1 }
        la args = builtin.split(bundle_args(), " ")
        legg_til(args, "--output")
        legg_til(args, tmp)
        la bundle_env = base_env
        bundle_env["NORSCODE_USE_PRECOMPILED_SELFHOST"] = "0"
        hvis ikkje run(nc, args, root, bundle_env) { returner 1 }
        hvis ikkje normaliser_ncb(root, nc, tmp) { returner 1 }
        hvis ikkje filops.kopier(tmp, root + "/bootstrap/kompiler.ncb.json") { returner 1 }
        filops.slett_fil(tmp)
        linje("✓ bootstrap/kompiler.ncb.json: " + bytes(root + "/bootstrap/kompiler.ncb.json") + " bytes")
    }

    linje("Oppdaterer VM-precompiled NCB...")
    hvis ikkje run(nc, ["compile", "selfhost/vm.no", "bootstrap/precompiled/vm.ncb.json"], root, base_env) { returner 1 }
    hvis ikkje normaliser_ncb(root, nc, root + "/bootstrap/precompiled/vm.ncb.json") { returner 1 }
    linje("✓ bootstrap/precompiled/vm.ncb.json")

    linje("Oppdaterer stdlib-NCBs...")
    hvis ikkje lag_mappe(root + "/bootstrap/stdlib") {
        linje("✗ Klarte ikkje opprette bootstrap/stdlib")
        returner 1
    }
    la ok_tal = 0
    for mod i stdlib_modular() {
        hvis fil_finst(root + "/" + mod) {
            la out = outnamn(mod)
            hvis prosess.ok(køyr(nc, ["compile", mod, out], root, base_env)) {
                ok_tal = ok_tal + 1
            }
        }
    }
    linje("✓ " + tekst(ok_tal) + " stdlib-NCBs oppdatert")

    linje("Oppdaterer stilark-precompiled NCB...")
    hvis ikkje run(nc, ["compile", "std/stil.no", "bootstrap/precompiled/stil.ncb.json"], root, base_env) { returner 1 }
    linje("✓ bootstrap/precompiled/stil.ncb.json")

    linje("Røyktesting...")
    la smoke_obj = tempfile.ny_tempfil("nc_regen_smoke_", ".no")
    la smoke = tempfile.sti(smoke_obj)
    builtin.fil_skriv(smoke, "funksjon start() { skriv(\"regen OK\") }\n")
    la res = køyr(nc, ["run", smoke], root, base_env)
    tempfile.lukk(smoke_obj)
    hvis prosess.ok(res) og trim(tekst(res["stdout"])) == "regen OK" {
        linje("✓ Røyktest bestått")
        linje("")
        linje("✓ Bootstrap regenerert!")
        returner 0
    }
    linje("✗ Røyktest feilet: " + trim(res_felt(res, 1)))
    returner 1
}

funksjon start() -> heiltall {
    returner main()
}
