// Minimal, deterministisk ZIP-skrivar for releaseverktøy. Eige modulnamn
// hindrar at committed stage0 maskerer kjelda med ein eldre std.zip-cache.

funksjon le(data: liste_heiltall, verdi: heiltall, breidde: heiltall) -> heiltall {
    la i = 0
    mens i < breidde {
        legg_til(data, (verdi >> (i * 8)) & 255)
        i = i + 1
    }
    returner 0
}

funksjon namn_bytes(namn: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(namn) {
        la kode = builtin.char_code(builtin.slice(namn, i, i + 1))
        hvis kode < 1 eller kode > 127 { returner [] }
        legg_til(ut, kode)
        i = i + 1
    }
    returner ut
}

funksjon trygt_namn(namn: tekst) -> boolsk {
    hvis namn == "" eller builtin.starts_with(namn, "/") eller
       builtin.index_of(namn, builtin.chr(92)) >= 0 eller builtin.index_of(namn, "\n") >= 0 {
        returner usann
    }
    la delar = builtin.split(namn, "/")
    la i = 0
    mens i < lengde(delar) {
        hvis delar[i] == "" eller delar[i] == "." eller delar[i] == ".." { returner usann }
        i = i + 1
    }
    returner lengde(namn_bytes(namn)) > 0
}

funksjon crc32(data: liste_heiltall) -> heiltall {
    la tabell: liste_heiltall = [0, 1996959894, 3993919788, 2567524794,
        124634137, 1886057615, 3915621685, 2657392035,
        249268274, 2044508324, 3772115230, 2547177864,
        162941995, 2125561021, 3887607047, 2428444049]
    la crc = 4294967295
    la i = 0
    mens i < lengde(data) {
        crc = crc ^ data[i]
        crc = (crc >> 4) ^ tabell[crc & 15]
        crc = (crc >> 4) ^ tabell[crc & 15]
        i = i + 1
    }
    returner crc ^ 4294967295
}

funksjon les_byte_liste(sti: tekst) -> liste_heiltall {
    la rå = builtin.fil_les_binær(sti)
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(rå) {
        legg_til(ut, rå[i])
        i = i + 1
    }
    returner ut
}

funksjon zip_skriv(sti: tekst, root: tekst, filer: liste_tekst) -> boolsk {
    prøv {
        skriv("[ZIP-stored] Start\n")
        la data: liste_heiltall = []
        la metadata = []
        la i = 0
        mens i < lengde(filer) {
            la namn = filer[i]
            skriv("[ZIP-stored] Les " + namn + "\n")
            hvis ikkje trygt_namn(namn) { returner usann }
            la namn_data = namn_bytes(namn)
            la innhald = les_byte_liste(root + "/" + namn)
            skriv("[ZIP-stored] Byte " + tekst_fra_heltall(lengde(innhald)) + "\n")
            hvis lengde(innhald) > 4294967295 { returner usann }
            la crc = crc32(innhald)
            skriv("[ZIP-stored] CRC ferdig\n")
            la offset = lengde(data)
            le(data, 67324752, 4)
            le(data, 20, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, crc, 4)
            le(data, lengde(innhald), 4)
            le(data, lengde(innhald), 4)
            le(data, lengde(namn_data), 2)
            le(data, 0, 2)
            la j = 0
            mens j < lengde(namn_data) { legg_til(data, namn_data[j]) j = j + 1 }
            j = 0
            mens j < lengde(innhald) { legg_til(data, innhald[j]) j = j + 1 }
            legg_til(metadata, {"name": namn, "crc": crc, "size": lengde(innhald), "offset": offset})
            i = i + 1
        }

        skriv("[ZIP-stored] Lokale postar ferdige\n")
        la central_start = lengde(data)
        i = 0
        mens i < lengde(metadata) {
            la namn_data = namn_bytes(tekst(metadata[i]["name"]))
            le(data, 33639248, 4)
            le(data, 20, 2)
            le(data, 20, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, heiltall_fra_tekst(tekst(metadata[i]["crc"])), 4)
            le(data, heiltall_fra_tekst(tekst(metadata[i]["size"])), 4)
            le(data, heiltall_fra_tekst(tekst(metadata[i]["size"])), 4)
            le(data, lengde(namn_data), 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 2)
            le(data, 0, 4)
            le(data, heiltall_fra_tekst(tekst(metadata[i]["offset"])), 4)
            la j = 0
            mens j < lengde(namn_data) { legg_til(data, namn_data[j]) j = j + 1 }
            i = i + 1
        }
        la central_size = lengde(data) - central_start
        le(data, 101010256, 4)
        le(data, 0, 2)
        le(data, 0, 2)
        le(data, lengde(metadata), 2)
        le(data, lengde(metadata), 2)
        le(data, central_size, 4)
        le(data, central_start, 4)
        le(data, 0, 2)
        skriv("[ZIP-stored] Skriv " + tekst_fra_heltall(lengde(data)) + " byte\n")
        builtin.fil_skriv_binær(sti, data)
        skriv("[ZIP-stored] Ferdig\n")
        returner sann
    } fang (e) {
        skriv("ZIPFeil: " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}
