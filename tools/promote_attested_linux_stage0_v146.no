// Kontrollert, shellfri promotering av den CI-attesterte Linux v146-kandidaten.

bruk std.filops som filops
bruk tools.runtime_promotion_core som promotion
bruk tools.update_stage0_manifest som stage0_manifest

funksjon kandidat_rel() -> tekst { returner "bootstrap/candidates/norscode-linux-x86_64-v146" }
funksjon manifest_rel() -> tekst { returner "bootstrap/candidates/linux-x86_64-v146.manifest" }
funksjon mål_rel() -> tekst { returner "bootstrap/stage0/norscode-linux-x86_64" }
funksjon kandidat_hash() -> tekst { returner "060e6df82da728d72ff5d75c4a39de6d3627a7dcf61d846efba8ca03042763b1" }
funksjon release_run() -> tekst { returner "30874650093" }
funksjon strict_run() -> tekst { returner "30875440594" }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hash_fil(sti: tekst) -> tekst {
    hvis ikkje filops.fil_finnes(sti) { returner "" }
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon manifest_grøn(root: tekst) -> boolsk {
    la sti = root + "/" + manifest_rel()
    hvis ikkje filops.fil_finnes(sti) { returner usann }
    la body = builtin.fil_les(sti)
    returner builtin.contains(body, "candidate_sha256=" + kandidat_hash()) og
        builtin.contains(body, "github_run=" + release_run()) og
        builtin.contains(body, "strict_gate=green") og
        builtin.contains(body, "strict_run=" + strict_run()) og
        builtin.contains(body, "strict_source_commit=04dd3781c0502c0d85564ed168a50b0d00703023") og
        builtin.contains(body, "promoted=false")
}

funksjon bevar_permanent_rollback(root: tekst, relativ: tekst, hash: tekst) -> boolsk {
    hvis relativ == "" eller hash == "" eller hash_fil(root + "/" + relativ) != hash {
        returner usann
    }
    la mappe = root + "/bootstrap/stage0/rollback"
    la mål = mappe + "/norscode-linux-x86_64." + hash
    hvis ikkje filops.lag_katalogar(mappe) eller
       ikkje filops.kopier2(root + "/" + relativ, mål) {
        returner usann
    }
    returner hash_fil(mål) == hash
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    hvis env("NORSCODE_PROMOTION_CONFIRM") != "godkjenn kritisk runtime-promotering" {
        skriv("Feil: manglar eksplisitt NORSCODE_PROMOTION_CONFIRM\n")
        returner 2
    }
    hvis hash_fil(root + "/" + kandidat_rel()) != kandidat_hash() {
        skriv("Feil: Linux v146-kandidathash avvik\n")
        returner 1
    }
    hvis ikkje manifest_grøn(root) {
        skriv("Feil: release- og strict-attestasjonen er ikkje grøn eller er frå feil køyring\n")
        returner 1
    }
    hvis env("NORSCODE_PROMOTE_DRY_RUN") == "1" {
        skriv("[DRY-RUN] Linux v146-kandidat, release og strict er eksakt attesterte\n")
        skriv("[DRY-RUN] committed stage0 er uendra\n")
        returner 0
    }

    la resultat = promotion.promoter(root, kandidat_rel(), mål_rel(),
        "build/verified-rollback/runtime-promotion", "stage0-linux-x86_64-v146")
    hvis tekst(resultat["status"]) != "promoted" {
        skriv("Feil: atomisk Linux-stage0-promotering feila: " + tekst(resultat["error"]) + "\n")
        returner 1
    }
    la rollback_rel = tekst(resultat["rollback_relative"])
    la rollback_hash = tekst(resultat["rollback_sha256"])
    hvis hash_fil(root + "/" + mål_rel()) != kandidat_hash() eller
       ikkje bevar_permanent_rollback(root, rollback_rel, rollback_hash) eller
       ikkje stage0_manifest.skriv_manifest(root) {
        la gjenoppretta = promotion.gjenopprett(root, mål_rel(), rollback_rel, rollback_hash)
        hvis tekst(gjenoppretta["status"]) == "restored" {
            stage0_manifest.skriv_manifest(root)
            skriv("Feil: sluttkontroll feila; Linux-stage0 vart rulla tilbake\n")
        } ellers {
            skriv("KRITISK: sluttkontroll og automatisk rollback feila\n")
        }
        returner 1
    }
    skriv("[OK] Linux v146-stage0 er atomisk promotert frå CI-attestert kandidat\n")
    skriv("[OK] stage0_sha256=" + kandidat_hash() + "\n")
    skriv("[OK] rollback_sha256=" + rollback_hash + "\n")
    returner 0
}
