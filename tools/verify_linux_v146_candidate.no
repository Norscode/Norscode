bruk std.tekst som tekstverk

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la rel = "bootstrap/candidates/norscode-linux-x86_64-v146"
    la sti = root + "/" + rel
    la manifest_sti = root + "/bootstrap/candidates/linux-x86_64-v146.manifest"
    hvis ikkje builtin.fil_finnes(sti) eller ikkje builtin.fil_finnes(manifest_sti) {
        skriv("[FAIL] Linux v146-kandidat eller manifest manglar\n")
        returner 1
    }
    la data = builtin.fil_les_binær(sti)
    hvis lengde(data) < 20 eller data[0] != 127 eller data[1] != 69 eller
       data[2] != 76 eller data[3] != 70 eller data[4] != 2 eller
       data[5] != 1 eller data[18] != 62 eller data[19] != 0 {
        skriv("[FAIL] Linux v146-kandidaten er ikkje ELF64 x86-64\n")
        returner 1
    }
    la hash = builtin.sha256_bytes(data)
    la forventa = "060e6df82da728d72ff5d75c4a39de6d3627a7dcf61d846efba8ca03042763b1"
    hvis hash != forventa {
        skriv("[FAIL] Linux v146-kandidathash avvik: " + hash + "\n")
        returner 1
    }
    la manifest = builtin.fil_les(manifest_sti)
    hvis ikkje tekstverk.inneholder(manifest, "candidate_sha256=" + forventa) eller
       ikkje tekstverk.inneholder(manifest, "github_run=30874650093") eller
       ikkje tekstverk.inneholder(manifest, "strict_gate=pending") eller
       ikkje tekstverk.inneholder(manifest, "promoted=false") {
        skriv("[FAIL] Linux v146-manifesten er ikkje fail-closed før strict\n")
        returner 1
    }
    skriv("[OK] Linux v146-kandidat og kjeldebunde manifest er verifiserte\n")
    skriv("candidate_sha256=" + hash + "\n")
    returner 0
}
