// Prosessfritt SHA-256-manifest for committed stage0-artefaktar.

bruk std.liste som liste
bruk std.filops som filops
bruk std.sha256 som sha256

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon stage0_seed_files(root: tekst) -> liste_tekst {
    la dir = root + "/bootstrap/stage0"
    la namn = filops.lista_katalog(dir)
    liste.sorter_tekst(namn)
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(namn) {
        la fil = dir + "/" + namn[i]
        hvis builtin.starts_with(namn[i], "norscode-") og filops.fil_finnes(fil) {
            legg_til(ut, fil)
        }
        i = i + 1
    }
    returner ut
}

funksjon manifest_innhald(root: tekst) -> tekst {
    la filer = stage0_seed_files(root)
    la body = ""
    la i = 0
    mens i < lengde(filer) {
        la relativ = filops.relativ_sti(root, filer[i])
        la hash = sha256.hash_bytes(builtin.fil_les_binær(filer[i]))
        body = body + hash + "  " + relativ + "\n"
        i = i + 1
    }
    returner body
}

funksjon skriv_manifest(root: tekst) -> bool {
    la innhald = manifest_innhald(root)
    hvis innhald == "" { returner usann }
    builtin.fil_skriv(root + "/bootstrap/stage0/SHA256SUMS", innhald)
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    hvis ikkje skriv_manifest(root) {
        skriv("Feil: ingen stage0-artefaktar funne\n")
        returner 1
    }
    skriv("✓ Manifest oppdatert: bootstrap/stage0/SHA256SUMS\n")
    returner 0
}
