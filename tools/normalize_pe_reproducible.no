// Kanoniser ikkje-funksjonelle PE/CodeView-identitetsfelt etter LLD-link.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon u16(bytes, p: heiltall) -> heiltall {
    returner bytes[p] | (bytes[p + 1] << 8)
}

funksjon u32(bytes, p: heiltall) -> heiltall {
    returner bytes[p] | (bytes[p + 1] << 8) | (bytes[p + 2] << 16) | (bytes[p + 3] << 24)
}

funksjon sett_u32(bytes, p: heiltall, verdi: heiltall) -> heiltall {
    bytes[p] = verdi & 255
    bytes[p + 1] = (verdi >> 8) & 255
    bytes[p + 2] = (verdi >> 16) & 255
    bytes[p + 3] = (verdi >> 24) & 255
    returner 0
}

funksjon rva_til_fil(bytes, seksjonar: heiltall, tal: heiltall, rva: heiltall) -> heiltall {
    la i = 0
    mens i < tal {
        la s = seksjonar + i * 40
        la virt_storleik = u32(bytes, s + 8)
        la virt_adresse = u32(bytes, s + 12)
        la rå_storleik = u32(bytes, s + 16)
        la rå_peikar = u32(bytes, s + 20)
        la spenn = virt_storleik
        hvis rå_storleik > spenn { spenn = rå_storleik }
        hvis rva >= virt_adresse og rva < virt_adresse + spenn {
            returner rå_peikar + (rva - virt_adresse)
        }
        i = i + 1
    }
    returner -1
}

funksjon start() -> heiltall {
    la input = env("NORSCODE_PE_INPUT")
    la output = env("NORSCODE_PE_OUTPUT")
    hvis input == "" eller output == "" eller input == output {
        skriv("Feil: krev ulike NORSCODE_PE_INPUT og NORSCODE_PE_OUTPUT\n")
        returner 2
    }
    la bytes = builtin.fil_les_binær(input)
    hvis lengde(bytes) < 256 eller bytes[0] != 0x4D eller bytes[1] != 0x5A {
        skriv("Feil: input er ikkje PE\n")
        returner 1
    }
    la pe = u32(bytes, 60)
    hvis pe < 0 eller pe + 256 > lengde(bytes) eller
       bytes[pe] != 0x50 eller bytes[pe + 1] != 0x45 {
        skriv("Feil: ugyldig PE-header\n")
        returner 1
    }
    la tal_seksjonar = u16(bytes, pe + 6)
    la optional_storleik = u16(bytes, pe + 20)
    la optional = pe + 24
    hvis u16(bytes, optional) != 0x20B { skriv("Feil: krev PE32+\n") returner 1 }
    la data_dir = optional + 112
    la debug_rva = u32(bytes, data_dir + 6 * 8)
    la debug_storleik = u32(bytes, data_dir + 6 * 8 + 4)
    la seksjonar = optional + optional_storleik
    la debug_fil = rva_til_fil(bytes, seksjonar, tal_seksjonar, debug_rva)
    hvis debug_fil < 0 eller debug_storleik < 28 eller
       debug_fil + debug_storleik > lengde(bytes) {
        skriv("Feil: manglar gyldig PE debug-directory\n")
        returner 1
    }

    // COFF-tidsstempel er ikkje funksjonelt og skal ikkje avhenge av linkaren.
    sett_u32(bytes, pe + 8, 0)
    la postar = debug_storleik / 28
    la fann_codeview = usann
    la i = 0
    mens i < postar {
        la entry = debug_fil + i * 28
        sett_u32(bytes, entry + 4, 0)
        la type = u32(bytes, entry + 12)
        la storleik = u32(bytes, entry + 16)
        la rå = u32(bytes, entry + 24)
        hvis type == 2 og storleik >= 24 og rå >= 0 og rå + storleik <= lengde(bytes) og
           bytes[rå] == 0x52 og bytes[rå + 1] == 0x53 og bytes[rå + 2] == 0x44 og bytes[rå + 3] == 0x53 {
            la identitet = "NORSCODE-PE-V1!!"
            la j = 0
            mens j < 16 { bytes[rå + 4 + j] = builtin.char_code(identitet[j]) & 255 j = j + 1 }
            sett_u32(bytes, rå + 20, 1)
            j = 24
            mens j < storleik { bytes[rå + j] = 0 j = j + 1 }
            la pdb = "norscode.pdb"
            j = 0
            mens j < lengde(pdb) og 24 + j < storleik - 1 {
                bytes[rå + 24 + j] = builtin.char_code(pdb[j]) & 255
                j = j + 1
            }
            fann_codeview = sann
        }
        i = i + 1
    }
    hvis ikkje fann_codeview { skriv("Feil: manglar CodeView-post\n") returner 1 }
    builtin.fil_skriv_binær(output, bytes)
    skriv("[OK] PE-identitetsfelt er kanoniserte\n")
    returner 0
}
