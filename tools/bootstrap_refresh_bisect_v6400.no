// tools/bootstrap_refresh_bisect_v6400.no — bisect bundle-steg for bootstrap refresh

bruk std.filops som filops
bruk tools.process_runner som runner

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon bundle(root: tekst, namn: tekst, args: liste_tekst, outdir: tekst) -> heiltall {
    la out = outdir + "/" + namn + ".ncb.json"
    la logg = outdir + "/" + namn + ".log"
    linje("[bundle] " + namn)
    la argv: liste_tekst = ["bundle"]
    la i = 0
    mens i < lengde(args) {
        legg_til(argv, args[i])
        i = i + 1
    }
    legg_til(argv, "--output")
    legg_til(argv, out)
    la res = runner.køyr(root + "/bin/nc", argv, root, {}, 300000)
    builtin.fil_skriv(logg, tekst(res["stdout"]) + tekst(res["stderr"]))
    hvis runner.ok(res) {
        linje("  STATUS=green out=" + out)
    } ellers {
        linje("  STATUS=red log=" + logg)
    }
    returner 0
}

funksjon start() -> heiltall {
    la root = tekst(builtin.system_info()["cwd"])
    la outdir = root + "/build/v6400/bisect"
    hvis ikkje filops.lag_katalogar(outdir) { returner 1 }

    la step1 = ["selfhost.lexer.lexer_m1=selfhost/lexer/lexer_m1.no"]
    bundle(root, "step1_lexer", step1, outdir)

    la step2 = builtin.slice(step1, 0, lengde(step1))
    legg_til(step2, "selfhost.parser=selfhost/parser.no")
    bundle(root, "step2_parser", step2, outdir)

    la step3 = builtin.slice(step2, 0, lengde(step2))
    legg_til(step3, "selfhost.compiler.semantic=selfhost/compiler/semantic.no")
    bundle(root, "step3_semantic", step3, outdir)

    la step4 = builtin.slice(step3, 0, lengde(step3))
    legg_til(step4, "selfhost.compiler.ir_to_bytecode=selfhost/compiler/ir_to_bytecode.no")
    bundle(root, "step4_ir", step4, outdir)

    la step5 = builtin.slice(step4, 0, lengde(step4))
    legg_til(step5, "selfhost.kompiler=selfhost/kompiler.no")
    bundle(root, "step5_kompiler", step5, outdir)

    la step6 = builtin.slice(step5, 0, lengde(step5))
    legg_til(step6, "selfhost.json=selfhost/json.no")
    bundle(root, "step6_json", step6, outdir)

    la step7 = builtin.slice(step6, 0, lengde(step6))
    legg_til(step7, "selfhost.vm=selfhost/vm.no")
    bundle(root, "step7_vm", step7, outdir)

    la step8 = builtin.slice(step7, 0, lengde(step7))
    legg_til(step8, "selfhost.bundler=selfhost/bundler.no")
    bundle(root, "step8_bundler", step8, outdir)

    la step9 = builtin.slice(step8, 0, lengde(step8))
    legg_til(step9, "selfhost.nc_main=selfhost/nc_main.no")
    bundle(root, "step9_nc_main", step9, outdir)
    returner 0
}
