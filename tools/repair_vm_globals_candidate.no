// Reparer modulglobale VM-opkodar i ein allereie typebevarande NCB-kandidat.
//
// Verktøyet arbeider på rå JSON-tekst. Dermed blir null, heiltalet 0 og
// tekstverdiane "null"/"0" urørte. Det promoterer aldri runtime eller stage0.

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon tel_tekst(src: tekst, needle: tekst) -> heiltall {
    hvis needle == "" { returner 0 }
    returner lengde(builtin.split(src, needle)) - 1
}

funksjon global_json(namn: tekst) -> tekst {
    returner "\"" + namn + "\""
}

funksjon start() -> heiltall {
    la inn = env("NC_VM_GLOBALS_IN")
    la ut = env("NC_VM_GLOBALS_OUT")
    la vm_kjelde = env("NC_VM_GLOBALS_SOURCE")
    hvis vm_kjelde == "" { vm_kjelde = "selfhost/vm.no" }
    hvis inn == "" eller ut == "" eller inn == ut {
        linje("bruk: NC_VM_GLOBALS_IN=<inn.ncb.json> NC_VM_GLOBALS_OUT=<ut.ncb.json> ./bin/nc run tools/repair_vm_globals_candidate.no")
        returner 2
    }

    la data = ""
    la kjelde = ""
    prøv {
        data = builtin.fil_les(inn)
        kjelde = builtin.fil_les(vm_kjelde)
    } fang (e) {
        linje("[FAIL] kandidat eller VM-kjelde kan ikkje lesast")
        returner 1
    }

    la globale: liste_tekst = [
        "vm_active_functions", "vm_active_ncb", "vm_request_counter",
        "vm_db_store", "vm_pool_store", "vm_db_counter", "vm_pool_counter",
        "vm_norsdb_active_handle", "vm_norsdb_indexes", "vm_random_counter"
    ]

    la metadata_fra = "\"selfhost.vm\":[]"
    hvis tel_tekst(data, metadata_fra) != 1 {
        linje("[FAIL] venta nøyaktig eitt tomt selfhost.vm-globalfelt")
        returner 1
    }

    la metadata_til = "\"selfhost.vm\":["
    la i: heiltall = 0
    mens i < lengde(globale) {
        la namn = globale[i]
        // Lista er versjonert mot levande kjelde, ikkje ein laus gammal NCB.
        hvis ikkje builtin.contains(kjelde, "la " + namn + ":") {
            linje("[FAIL] VM-global manglar i levande kjelde: " + namn)
            returner 1
        }
        hvis i > 0 { metadata_til = metadata_til + "," }
        metadata_til = metadata_til + global_json(namn)
        i = i + 1
    }
    metadata_til = metadata_til + "]"

    la reparert: heiltall = 0
    i = 0
    mens i < lengde(globale) {
        la namn = globale[i]
        la load_fra = "[\"LOAD_NAME\",\"" + namn + "\"]"
        la load_til = "[\"LOAD_GLOBAL\",\"" + namn + "\"]"
        la store_fra = "[\"STORE_NAME\",\"" + namn + "\"]"
        la store_til = "[\"STORE_GLOBAL\",\"" + namn + "\"]"
        la loads = tel_tekst(data, load_fra)
        la stores = tel_tekst(data, store_fra)
        reparert = reparert + loads + stores
        data = tekst_erstatt(data, load_fra, load_til)
        data = tekst_erstatt(data, store_fra, store_til)
        i = i + 1
    }

    // Denne kjende kjeldekandidaten skal ha nøyaktig 14 feilklassifiserte
    // referansar. Eit anna tal betyr at input eller kjelde har drifta.
    hvis reparert != 14 {
        linje("[FAIL] venta 14 VM-globalreferansar, fann " + tekst_fra_heiltall(reparert))
        returner 1
    }
    data = tekst_erstatt(data, metadata_fra, metadata_til)

    i = 0
    mens i < lengde(globale) {
        la namn = globale[i]
        hvis tel_tekst(data, "[\"LOAD_NAME\",\"" + namn + "\"]") != 0 eller
           tel_tekst(data, "[\"STORE_NAME\",\"" + namn + "\"]") != 0 {
            linje("[FAIL] ureparert VM-globalreferanse: " + namn)
            returner 1
        }
        i = i + 1
    }
    hvis tel_tekst(data, metadata_til) != 1 {
        linje("[FAIL] VM-globalmetadata vart ikkje skrive nøyaktig ein gong")
        returner 1
    }

    builtin.fil_skriv(ut, data)
    linje("[OK] reparerte 14 VM-globalreferansar frå levande kjeldeliste")
    linje("[OK] skreiv typebevarande kandidat utan promotering: " + ut)
    returner 0
}
