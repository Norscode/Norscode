// Fail-closed byteidentitet for CI utan cmp eller eksternt hashverktøy.

bruk std.sha256 som sha256

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la a = env("NORSCODE_COMPARE_FILE_A")
    la b = env("NORSCODE_COMPARE_FILE_B")
    hvis a == "" eller b == "" {
        skriv("FEIL: begge samanlikningsfiler må vere sette\n")
        returner 2
    }
    la bytes_a
    la bytes_b
    prøv {
        bytes_a = builtin.fil_les_binær(a)
        bytes_b = builtin.fil_les_binær(b)
    } fang (e) {
        skriv("FEIL: kunne ikkje lese samanlikningsfilene\n")
        returner 1
    }
    hvis lengde(bytes_a) != lengde(bytes_b) eller bytes_a != bytes_b {
        skriv("FEIL: filene er ikkje byte-identiske\n")
        skriv("A=" + sha256.hash_bytes(bytes_a) + "\n")
        skriv("B=" + sha256.hash_bytes(bytes_b) + "\n")
        returner 1
    }
    skriv("OK: filene er byte-identiske sha256=" + sha256.hash_bytes(bytes_a) + "\n")
    returner 0
}

