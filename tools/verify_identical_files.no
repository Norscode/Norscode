// Fail-closed byteidentitet for CI utan cmp eller eksternt hashverktøy.

bruk std.sha256 som sha256

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hash_bytes(bytes) -> tekst {
    prøv { returner builtin.sha256_bytes(bytes) } fang (e) { returner sha256.hash_bytes(bytes) }
    returner ""
}

funksjon start() -> heiltall {
    la a = env("NORSCODE_COMPARE_FILE_A")
    la b = env("NORSCODE_COMPARE_FILE_B")
    hvis a == "" eller b == "" {
        skriv("FEIL: begge samanlikningsfiler må vere sette\n")
        returner 2
    }
    la storleik_a: heiltall = 0
    la storleik_b: heiltall = 0
    la hash_a: tekst = ""
    la hash_b: tekst = ""
    prøv {
        // Den committa bootstrapen kan ikkje halde to store bytebufferar
        // levande gjennom den andre innlesinga. Fullfør kvar filhash før
        // neste buffer blir allokert; berre lengd og digest skal overleve.
        la bytes_a = builtin.fil_les_binær(a)
        storleik_a = lengde(bytes_a)
        hash_a = hash_bytes(bytes_a)
        la bytes_b = builtin.fil_les_binær(b)
        storleik_b = lengde(bytes_b)
        hash_b = hash_bytes(bytes_b)
    } fang (e) {
        skriv("FEIL: kunne ikkje lese samanlikningsfilene\n")
        returner 1
    }
    hvis storleik_a != storleik_b eller hash_a == "" eller hash_a != hash_b {
        skriv("FEIL: filene er ikkje byte-identiske\n")
        skriv("A=" + hash_a + "\n")
        skriv("B=" + hash_b + "\n")
        returner 1
    }
    skriv("OK: filene er byte-identiske sha256=" + hash_a + "\n")
    returner 0
}
