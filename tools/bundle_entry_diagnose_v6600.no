// tools/bundle_entry_diagnose_v6600.no — diagnose for bundle entry

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon run(executable: tekst, argv: liste_tekst, cwd: tekst, miljø: ordbok_tekst) -> bool {
    la res = prosess.køyr(executable, argv, cwd, miljø, 600000)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon vis_fil(sti: tekst) -> heiltall {
    prøv {
        la data = builtin.fil_les(sti)
        hvis data != "" { skriv(data) }
    } fang (e) {}
    returner 0
}

funksjon append_fil(sti: tekst, tekstlinje: tekst) -> bool {
    prøv {
        builtin.fil_append(sti, tekstlinje + "\n")
        returner sann
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon skriv_log(sti: tekst, res: ordbok_tekst) -> bool {
    prøv {
        fil_skriv(sti, tekst(res["stdout"]) + tekst(res["stderr"]))
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    root = builtin.trim(root)
    hvis root == "" {
        linje("Feil: manglar NORSCODE_ROOT for v6600-diagnose")
        returner 1
    }
    la nc = root + "/dist/norscode_native"
    hvis ikkje fil_finst(nc) {
        linje("Feil: manglar dist/norscode_native for v6600-diagnose")
        linje("Køyr: ./bin/nc fetch-stage0-seed")
        returner 1
    }
    la outdir = root + "/build/v6600"
    hvis ikkje filops.lag_katalogar(outdir) { returner 1 }

    linje("[1/3] plain compile of lexer")
    la disk_roots = root + ",.,/tmp,/private/tmp"
    la capabilities = "env.read,process.exec,disk.read,disk.write"
    la compile_env = {"NORSCODE_CMD": "compile", "NORSCODE_FILE": "selfhost/lexer/lexer_m1.no", "NORSCODE_OUTPUT": outdir + "/lexer_compile_v6600.ncb.json", "NORSCODE_VM_CAPABILITIES": capabilities, "NORSCODE_VM_DISK_ROOT": disk_roots}
    hvis ikkje run(nc, [], root, compile_env) { returner 1 }

    linje("")
    linje("[2/3] run bundler without args (expect normal error)")
    la log1 = outdir + "/bundler_no_args_v6600.log"
    la no_args_env = {"NORSCODE_CMD": "run", "NORSCODE_FILE": "selfhost/bundler.no", "NORSCODE_VM_CAPABILITIES": capabilities, "NORSCODE_VM_DISK_ROOT": disk_roots}
    la no_args = prosess.køyr(nc, [], root, no_args_env, 600000)
    skriv_log(log1, no_args)
    hvis prosess.ok(no_args) {
        append_fil(log1, "unexpected-success")
    } ellers {
        vis_fil(log1)
    }

    linje("")
    linje("[3/3] run bundler with single module arg")
    la log2 = outdir + "/bundler_one_arg_v6600.log"
    la one_env = {"NORSCODE_CMD": "run", "NORSCODE_FILE": "selfhost/bundler.no", "NORSCODE_BUNDLE_ARGS": "selfhost.lexer.lexer_m1=selfhost/lexer/lexer_m1.no", "NORSCODE_BUNDLE_OUTPUT": outdir + "/bundle_one_v6600.ncb.json", "NORSCODE_VM_CAPABILITIES": capabilities, "NORSCODE_VM_DISK_ROOT": disk_roots}
    la one_arg = prosess.køyr(nc, [], root, one_env, 600000)
    skriv_log(log2, one_arg)
    hvis prosess.ok(one_arg) {
        linje("[OK] single-module bundle succeeded")
    } ellers {
        vis_fil(log2)
    }
    returner 0
}
