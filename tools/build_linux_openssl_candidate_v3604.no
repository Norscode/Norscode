// Bygg eksplisitt fase-5 Linux x86_64-kandidat med OpenSSL utan shelltekst.
// Kandidaten blir ikkje promotert til stage0 eller dist.

bruk std.filops som filops
bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon er_linux_x86_64_elf(sti: tekst) -> boolsk {
    prøv {
        la b = builtin.fil_les_binær(sti)
        returner lengde(b) >= 20 og b[0] == 127 og b[1] == 69 og b[2] == 76 og b[3] == 70 og
            b[4] == 2 og b[5] == 1 og b[18] == 62 og b[19] == 0
    } fang (e) { returner usann }
    returner usann
}

funksjon er_direkte_linux_x86_64() -> boolsk {
    la os = env("RUNNER_OS")
    la arch = builtin.lower(env("RUNNER_ARCH"))
    hvis os != "" { returner os == "Linux" og (arch == "x64" eller arch == "x86_64" eller arch == "amd64") }
    prøv {
        la info = builtin.system_info()
        la machine = builtin.lower(tekst(info["machine"]))
        returner tekst(info["system"]) == "Linux" og
            (machine == "x86_64" eller machine == "amd64")
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la image = env("NORSCODE_DOCKER_IMAGE")
    hvis image == "" { image = "ubuntu:24.04" }
    la out_dir = root + "/build/v3600/linux"
    la out_rel = "build/v3600/linux/norscode_native_linux_x86_64_v3603_openssl"
    la out = root + "/" + out_rel
    hvis ikkje filops.lag_katalogar(out_dir) { returner 1 }

    hvis er_direkte_linux_x86_64() {
        la argv: liste_tekst = [
            "-O2", "-DNC_ENABLE_OPENSSL", "-DNC_DYNAMIC_SQLITE",
            "-Iarchive/legacy_c_backend", "build/v3009/native_candidate_gc.c",
            "-lpthread", "-ldl", "-lm", "-lssl", "-lcrypto", "-o", out
        ]
        la bygg = prosess.køyr("/usr/bin/gcc", argv, root, {}, 1200000)
        prosess.skriv_resultat(bygg)
        hvis ikkje prosess.ok(bygg) eller ikkje er_linux_x86_64_elf(out) {
            skriv("[FAIL] direkte Linux OpenSSL-kandidat kunne ikkje byggjast eller validerast\n")
            returner 1
        }
        la data = builtin.fil_les_binær(out)
        skriv("[OK] Linux OpenSSL-kandidat bygd direkte på ekte x86_64-host; ikkje promotert\n")
        skriv("[OK] bytes=" + tekst_fra_heiltall(lengde(data)) + " sha256=" + builtin.sha256_bytes(data) + "\n")
        returner 0
    }

    la docker = docker_runner.finn()
    hvis ikkje docker_runner.tilgjengeleg(docker, root) {
        skriv("[FAIL] Docker er ikkje tilgjengeleg for fase-5-overgangen\n")
        returner 1
    }
    la container = docker_runner.opprett(docker, root, root, "linux/amd64", image, "openssl-candidate-v3604")
    hvis container == "" { returner 1 }
    hvis ikkje docker_runner.start(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    hvis ikkje docker_runner.installer_pakkar(docker, root, container,
        ["build-essential", "libsqlite3-dev", "libssl-dev"]) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    la argv: liste_tekst = [
        "gcc", "-O2", "-DNC_ENABLE_OPENSSL", "-Iarchive/legacy_c_backend",
        "build/v3009/native_candidate_gc.c", "third_party/sqlite/sqlite3.c",
        "-lpthread", "-ldl", "-lm", "-lssl", "-lcrypto", "-o", "/work/" + out_rel
    ]
    la bygg = docker_runner.køyr_i(docker, root, container, argv, 1200000)
    prosess.skriv_resultat(bygg)
    docker_runner.fjern(docker, root, container)
    hvis ikkje prosess.ok(bygg) eller ikkje er_linux_x86_64_elf(out) {
        skriv("[FAIL] Linux OpenSSL-kandidat kunne ikkje byggjast eller validerast\n")
        returner 1
    }
    la data = builtin.fil_les_binær(out)
    skriv("[OK] Linux OpenSSL-kandidat bygd; ikkje promotert\n")
    skriv("[OK] bytes=" + tekst_fra_heiltall(lengde(data)) + " sha256=" + builtin.sha256_bytes(data) + "\n")
    returner 0
}
