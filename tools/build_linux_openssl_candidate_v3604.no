// Bygg ein fersk Linux x86-64 full-host direkte frå levande Norscode-kjelder.
// Filnamnet er halde stabilt for workflow-kompatibilitet; normalbana brukar
// ikkje lenger Docker, GCC, Zig eller legacy C-backend.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon er_linux_x86_64_elf(sti: tekst) -> boolsk {
    prøv {
        la b = builtin.fil_les_binær(sti)
        returner lengde(b) >= 20 og b[0] == 127 og b[1] == 69 og b[2] == 76 og b[3] == 70 og
            b[4] == 2 og b[5] == 1 og b[18] == 62 og b[19] == 0
    } fang (e) { returner usann }
    returner usann
}

funksjon er_linux_host() -> boolsk {
    hvis env("RUNNER_OS") == "Linux" { returner sann }
    prøv { returner builtin.contains(builtin.lower(tekst(builtin.system_info()["system"])), "linux") }
    fang (e) { returner usann }
    returner usann
}

funksjon køyr_norscode_verktøy(root: tekst, runtime: tekst, fil: tekst,
                               miljø: ordbok_tekst, timeout_ms: heiltall) -> boolsk {
    miljø["NORSCODE_ROOT"] = root
    miljø["NORSCODE_ENABLE_EXEC_PROSESS"] = "1"
    miljø["NORSCODE_VM_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
    miljø["NORSCODE_VM_DISK_ROOT"] = root + ",.,/tmp,/private/tmp"
    miljø["NORSCODE_CMD"] = "run"
    miljø["NORSCODE_FILE"] = root + "/" + fil
    la resultat = prosess.køyr(runtime, [], root, miljø, timeout_ms)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon køyr_fersk_codegen_ncb(root: tekst, runtime: tekst, codegen_ncb: tekst,
                                input_ncb: tekst, out: tekst) -> boolsk {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/selfhost/vm_executor.no",
        "NORSCODE_NCB_FILE": codegen_ncb,
        "NC_INPUT": input_ncb,
        "NC_OUTPUT": out,
        "NC_NATIVE_SYMBOL_MAP": out + ".symbols",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp"
    }
    // Bind også i forelderen for committed stage0-backendar som ikkje les den
    // strukturerte environment-blokka ved nøsta spawn.
    la namn = nøkler(miljø)
    la i: heiltall = 0
    mens i < lengde(namn) {
        miljo_sett(tekst(namn[i]), tekst(miljø[namn[i]]))
        i = i + 1
    }
    la resultat = prosess.køyr(runtime, [], root, miljø, 1800000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) { returner usann }
    hvis ikkje builtin.fil_sett_kjorbar(out) {
        skriv("[FAIL] klarte ikkje setje full-host-kandidaten køyrbar via filmodus-ABI\n")
        returner usann
    }
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    // Committed Linux-stage0 kan ignorere environment-feltet i ein nøsta
    // spawn-request. Bind source-only-kontrakten i forelderen slik at execve-
    // barnet arvar han også gjennom den eldre prosessbackenden.
    miljo_sett("NORSCODE_NATIVE_TOOL_CACHE", "0")
    miljo_sett("NORSCODE_USE_PRECOMPILED_SELFHOST", "0")
    miljo_sett("NORSCODE_USE_PRECOMPILED_STDLIB", "0")
    la out_dir = root + "/build/v3600/linux"
    la ncb = out_dir + "/nc_main_current.ncb.json"
    la codegen_ncb = out_dir + "/native_codegen_v2_current.ncb.json"
    la out = out_dir + "/norscode_native_linux_x86_64_v3603_openssl"
    hvis ikkje filops.lag_katalogar(out_dir) { returner 1 }

    la runtime = env("NC_NATIVE")
    hvis runtime == "" { runtime = root + "/dist/norscode_native" }
    la compile_env: ordbok_tekst = {
        "NORSCODE_HYBRID_ROOT": root,
        "NORSCODE_HYBRID_SRC": root + "/selfhost/nc_main.no",
        "NORSCODE_HYBRID_OUT": ncb,
        "NORSCODE_HYBRID_MODULE": "selfhost.nc_main",
        "NORSCODE_HYBRID_PROJECT_ROOT": root,
        "NORSCODE_NATIVE_BIN": runtime,
        // Kandidaten skal alltid kome frå levande kjelde. Eldre committed
        // stage0-ar kan elles gjenbruke ein verktøycache utan ny fingerprint.
        "NORSCODE_NATIVE_TOOL_CACHE": "0",
        "NORSCODE_USE_PRECOMPILED_SELFHOST": "0",
        "NORSCODE_USE_PRECOMPILED_STDLIB": "0"
    }
    hvis ikkje køyr_norscode_verktøy(root, runtime,
        "tools/compile_with_hybrid_bundle_v9400.no", compile_env, 900000) {
        skriv("[FAIL] Norscode kunne ikkje kompilere levande nc_main/importgraf\n")
        returner 1
    }

    la codegen_compile_env: ordbok_tekst = {
        "NORSCODE_HYBRID_ROOT": root,
        "NORSCODE_HYBRID_SRC": root + "/selfhost/native_execution/native_codegen_v2.no",
        "NORSCODE_HYBRID_OUT": codegen_ncb,
        "NORSCODE_HYBRID_MODULE": "__main__",
        "NORSCODE_HYBRID_PROJECT_ROOT": root,
        "NORSCODE_NATIVE_BIN": runtime,
        "NORSCODE_NATIVE_TOOL_CACHE": "0",
        "NORSCODE_USE_PRECOMPILED_SELFHOST": "0",
        "NORSCODE_USE_PRECOMPILED_STDLIB": "0"
    }
    hvis ikkje køyr_norscode_verktøy(root, runtime,
        "tools/compile_with_hybrid_bundle_v9400.no", codegen_compile_env, 900000) {
        skriv("[FAIL] Norscode kunne ikkje kompilere levande native_codegen_v2\n")
        returner 1
    }
    hvis ikkje køyr_fersk_codegen_ncb(root, runtime, codegen_ncb, ncb, out) {
        skriv("[FAIL] Norscode native codegen kunne ikkje byggje Linux full-host\n")
        returner 1
    }
    hvis ikkje er_linux_x86_64_elf(out) {
        skriv("[FAIL] native codegen-resultatet er ikkje Linux x86-64 ELF\n")
        returner 1
    }
    hvis er_linux_host() {
        la smoke = prosess.køyr(out, ["selftest"], root, {}, 120000)
        // Den committed Linux-stage0-en sender i nøsta spawn args-lista som
        // komplett OS-argv. Prøv berre den eksplisitte argv[0]-forma når den
        // vanlege v1-forma gav den byteeksakte tom-kommando-feilen. Dette held
        // kompatibiliteten smal og let kandidaten attestere argv[1]=selftest.
        hvis ikkje prosess.ok(smoke) og
           builtin.trim(tekst(smoke["stdout"])) == "Ukjend NORSCODE_CMD:" {
            skriv("[PROBE] committed stage0 krev eksplisitt argv[0]; prøver kandidat-ABI\n")
            smoke = prosess.køyr(out, [out, "selftest"], root, {}, 120000)
        }
        skriv("[PROBE] native full-host status=" + tekst(smoke["status"]) +
              " exit=" + tekst(smoke["exit_code"]) + " error=" + tekst(smoke["error"]) + "\n")
        prosess.skriv_resultat(smoke)
        hvis ikkje prosess.ok(smoke) {
            skriv("[FAIL] native full-host er ELF, men runtime-selftest feila\n")
            returner 1
        }
    }
    la data = builtin.fil_les_binær(out)
    skriv("[OK] Linux full-host bygd direkte av Norscode native codegen; ikkje promotert\n")
    skriv("[OK] bytes=" + tekst_fra_heiltall(lengde(data)) + " sha256=" + builtin.sha256_bytes(data) + "\n")
    returner 0
}
