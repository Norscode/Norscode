// Eksplisitt fase-5 Linux x86_64-kandidat med portable Zig Argon2id.
// Kandidaten blir ikkje promotert til stage0 eller dist.

bruk std.filops som filops
bruk std.prosess som system_prosess
bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon er_linux_x86_64_elf(sti: tekst) -> boolsk {
    prøv {
        la b = builtin.fil_les_binær(sti)
        returner lengde(b) >= 20 og b[0] == 127 og b[1] == 69 og b[2] == 76 og b[3] == 70 og
            b[4] == 2 og b[5] == 1 og b[18] == 62 og b[19] == 0
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la out_dir = root + "/build/v3600/linux"
    hvis ikkje filops.lag_katalogar(out_dir) { returner 1 }
    la zig = env("NORSCODE_ZIG")
    hvis zig == "" { zig = system_prosess.finn_kjorbar("zig") }
    hvis zig == "" { skriv("[FAIL] Zig manglar for eksplisitt fase-5-overgang\n") returner 1 }
    la object_rel = "build/v3600/linux/nc_argon2_zig_v3606.o"
    la object = root + "/" + object_rel
    la out_rel = "build/v3600/linux/norscode_native_linux_x86_64_v3605_zigargon"
    la out = root + "/" + out_rel
    la zig_result = prosess.køyr(zig,
        ["build-obj", root + "/archive/legacy_c_backend/nc_argon2_zig.zig",
         "-target", "x86_64-linux-gnu", "-O", "ReleaseFast", "-fsingle-threaded",
         "-fPIC", "-femit-bin=" + object], root, {}, 600000)
    prosess.skriv_resultat(zig_result)
    hvis ikkje prosess.ok(zig_result) { skriv("[FAIL] Zig Argon2id-objekt kunne ikkje byggjast\n") returner 1 }

    la image = env("NORSCODE_DOCKER_IMAGE")
    hvis image == "" { image = "ubuntu:24.04" }
    la docker = docker_runner.finn()
    hvis ikkje docker_runner.tilgjengeleg(docker, root) { skriv("[FAIL] Docker er ikkje tilgjengeleg\n") returner 1 }
    la container = docker_runner.opprett(docker, root, root, "linux/amd64", image, "zig-argon-v3606")
    hvis container == "" { returner 1 }
    hvis ikkje docker_runner.start(docker, root, container) eller
       ikkje docker_runner.installer_pakkar(docker, root, container,
           ["build-essential", "libsqlite3-dev", "libssl-dev"]) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    la argv: liste_tekst = [
        "gcc", "-O2", "-DNC_ENABLE_OPENSSL", "-DNC_ENABLE_ZIG_ARGON2",
        "-Iarchive/legacy_c_backend", "build/v3009/native_candidate_gc.c",
        "third_party/sqlite/sqlite3.c", object_rel, "-lpthread", "-ldl", "-lm",
        "-lssl", "-lcrypto", "-o", "/work/" + out_rel
    ]
    la bygg = docker_runner.køyr_i(docker, root, container, argv, 1200000)
    prosess.skriv_resultat(bygg)
    docker_runner.fjern(docker, root, container)
    hvis ikkje prosess.ok(bygg) eller ikkje er_linux_x86_64_elf(out) {
        skriv("[FAIL] Linux Zig Argon2id-kandidat kunne ikkje byggjast eller validerast\n")
        returner 1
    }
    la data = builtin.fil_les_binær(out)
    skriv("[OK] Linux Zig Argon2id-kandidat bygd; ikkje promotert\n")
    skriv("[OK] bytes=" + tekst_fra_heiltall(lengde(data)) + " sha256=" + builtin.sha256_bytes(data) + "\n")
    returner 0
}
