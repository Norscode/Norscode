// tools/no_c_python_active_surface.no — aktiv repository-flate utan C/Python

bruk std.liste som liste
bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim_tekst(t: tekst) -> tekst {
    returner trim(t)
}

funksjon basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    returner delar[lengde(delar) - 1]
}

funksjon list_dir(sti: tekst) -> liste_tekst {
    la out: liste_tekst = []
    prøv {
        la listing = native_fs.native_list(sti, "")
        hvis listing["status"] != "ok" { returner out }
        la lines = builtin.split(listing["data"], "\n")
        la i = 0
        mens i < lengde(lines) {
            la namn = trim_tekst(lines[i])
            hvis namn != "" { legg_til(out, namn) }
            i = i + 1
        }
    } fang (e) {}
    returner out
}

funksjon is_dir(sti: tekst) -> bool {
    prøv { returner native_fs.native_list(sti, "")["status"] == "ok" }
    fang (e) { returner usann }
    returner usann
}

funksjon walk_files_filtrert(startar: liste_tekst, skip_build: bool,
                             suffiksar: tekst) -> liste_tekst {
    la files: liste_tekst = []
    la queue: liste_tekst = []
    la si = 0
    mens si < lengde(startar) {
        hvis is_dir(startar[si]) {
            la ekskluder = ".git,.norscode"
            hvis skip_build { ekskluder = ekskluder + ",build" }
            la walk = native_fs.native_walk_files_filtrert(
                startar[si], "", suffiksar, ekskluder)
            hvis walk["status"] == "ok" {
                la native_filer = builtin.split(walk["data"], "\n")
                la wi = 0
                mens wi < lengde(native_filer) {
                    la rel = trim_tekst(native_filer[wi])
                    hvis rel != "" { legg_til(files, startar[si] + "/" + rel) }
                    wi = wi + 1
                }
            } ellers {
                legg_til(queue, startar[si])
            }
        } ellers hvis builtin.fil_finnes(startar[si]) {
            // Eksplisitt oppgjevne enkeltfiler høyrer alltid til flata; den
            // kallande porten avgjer om innhaldet er relevant.
            legg_til(files, startar[si])
        }
        si = si + 1
    }
    la qi = 0
    mens qi < lengde(queue) {
        la children = list_dir(queue[qi])
        la i = 0
        mens i < lengde(children) {
            la path = queue[qi] + "/" + children[i]
            hvis is_dir(path) {
                hvis children[i] != ".git" og children[i] != ".norscode" og
                   (ikkje skip_build eller children[i] != "build") {
                    legg_til(queue, path)
                }
            } ellers {
                legg_til(files, path)
            }
            i = i + 1
        }
        qi = qi + 1
    }
    returner files
}

funksjon walk_files(startar: liste_tekst, skip_build: bool) -> liste_tekst {
    returner walk_files_filtrert(startar, skip_build, "")
}

funksjon print_policy() -> heiltall {
    linje("")
    linje("Policy (no-c/python active surface):")
    linje("  - Aktiv flyt: sjølvstendig .no/NCB/Native-ELF, utan Python/C i kjede.")
    linje("  - C/Python er ikkje del av aktiv kompilering; berre archive/ og smalt deklarerte test-/vendorartefaktar er tillatne.")
    linje("  - Nye funksjonar skal byggjast som .no og verifiserast med ./bin/nc feature-check.")
    linje("")
    returner 0
}

funksjon allowlisted_path(root: tekst, path: tekst) -> bool {
    hvis builtin.starts_with(path, root + "/archive/") { returner sann }
    hvis path == root + "/tests/fixtures/windows_process_fixture.c" { returner sann }
    hvis path == root + "/tests/fixtures/windows_utf8_file_fixture.c" { returner sann }
    hvis path == root + "/tests/native_gc_blocked_thread.c" { returner sann }
    hvis path == root + "/tests/native_gc_exception_unwind.c" { returner sann }
    hvis path == root + "/tests/native_gc_generational.c" { returner sann }
    hvis path == root + "/tests/native_gc_lifecycle.c" { returner sann }
    hvis path == root + "/tests/native_gc_relocation.c" { returner sann }
    hvis path == root + "/tests/native_gc_threads.c" { returner sann }
    hvis path == root + "/third_party/sqlite/sqlite3.c" { returner sann }
    hvis path == root + "/third_party/sqlite/sqlite3.h" { returner sann }
    returner usann
}

funksjon ncb_to_c_allowlisted_path(root: tekst, path: tekst) -> bool {
    hvis builtin.starts_with(path, root + "/docs/") { returner sann }
    hvis builtin.starts_with(path, root + "/tools/maint/") { returner sann }
    hvis path == root + "/tools/no_c_python_active_surface." + "s" + "h" { returner sann }
    hvis path == root + "/tools/no_c_python_active_surface.no" { returner sann }
    hvis path == root + "/docs/05-development/NATIVE_CODEGEN_V2_ABI.md" { returner sann }
    hvis path == root + "/docs/SELFHOST_HANDLINGSPLAN.md" { returner sann }
    hvis path == root + "/docs/STATUS.md" { returner sann }
    returner usann
}

funksjon linjer(t: tekst) -> liste_tekst {
    la rå = builtin.split(t, "\n")
    la ut: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(rå) {
        la l = trim_tekst(rå[i])
        hvis l != "" { legg_til(ut, l) }
        i = i + 1
    }
    returner ut
}

funksjon sortert_unik(verdiar: liste_tekst) -> liste_tekst {
    // Same kontrakt som liste.sorter_tekst(verdiar), men gatefila må også
    // kunne køyrast med committed stage-0 før den nyaste std.liste er bundla.
    la pass: heiltall = 0
    mens pass < lengde(verdiar) {
        la j: heiltall = 0
        mens j + 1 < lengde(verdiar) - pass {
            hvis verdiar[j] > verdiar[j + 1] {
                la tmp = verdiar[j]
                verdiar[j] = verdiar[j + 1]
                verdiar[j + 1] = tmp
            }
            j = j + 1
        }
        pass = pass + 1
    }
    la ut: liste_tekst = []
    la sist = ""
    la har_sist = usann
    la i: heiltall = 0
    mens i < lengde(verdiar) {
        la v = verdiar[i]
        hvis ikkje har_sist eller v != sist {
            legg_til(ut, v)
            sist = v
            har_sist = sann
        }
        i = i + 1
    }
    returner ut
}

funksjon collect_py_hits(root: tekst) -> liste_tekst {
    la alle = walk_files_filtrert([root], usann, ".py")
    la out: liste_tekst = []
    la i = 0
    mens i < lengde(alle) {
        hvis builtin.ends_with(alle[i], ".py") { legg_til(out, alle[i]) }
        i = i + 1
    }
    returner sortert_unik(out)
}

funksjon collect_c_hits(root: tekst) -> liste_tekst {
    la alle = walk_files_filtrert([root], sann, ".c,.h")
    la out: liste_tekst = []
    la i = 0
    mens i < lengde(alle) {
        hvis builtin.ends_with(alle[i], ".c") eller builtin.ends_with(alle[i], ".h") {
            legg_til(out, alle[i])
        }
        i = i + 1
    }
    returner sortert_unik(out)
}

funksjon ref_file_allowed(root: tekst, fil: tekst) -> bool {
    hvis builtin.index_of(fil, "/reports/") >= 0 { returner usann }
    hvis builtin.index_of(fil, "/archive/") >= 0 { returner usann }
    hvis builtin.starts_with(fil, root + "/docs/") { returner usann }
    hvis fil == root + "/bin/nc" { returner usann }
    hvis builtin.ends_with(fil, "/norscode_feature_gate.sh") { returner usann }
    hvis builtin.ends_with(fil, "/python_dependency_audit.sh") { returner usann }
    hvis builtin.ends_with(fil, "/python_free_ci.sh") { returner usann }
    hvis builtin.ends_with(fil, "/build_norscode_native.sh") { returner usann }
    hvis builtin.ends_with(fil, "/verify_seed_only.sh") { returner usann }
    hvis builtin.ends_with(fil, "/verify_selvstendighet.sh") { returner usann }
    hvis builtin.ends_with(fil, "/verify_omgang6.sh") { returner usann }
    hvis builtin.ends_with(fil, "/selfhost_phase0_verify.sh") { returner usann }
    hvis builtin.ends_with(fil, "/selfhost_drift_guard.sh") { returner usann }
    hvis builtin.ends_with(fil, "/unified_bootstrap_verifier.sh") { returner usann }
    hvis builtin.ends_with(fil, "/no_legacy_cvm.sh") { returner usann }
    hvis builtin.ends_with(fil, "/ci.yml") { returner usann }
    hvis builtin.ends_with(fil, "/publish.yml") { returner usann }
    hvis builtin.ends_with(fil, "/selfhost-lexer-token-smoke.yml") { returner usann }
    hvis builtin.ends_with(fil, "/selvstendighet.yml") { returner usann }
    hvis builtin.ends_with(fil, "/stage0-binary.yml") { returner usann }
    hvis builtin.ends_with(fil, "/windows-app-release.yml") { returner usann }
    hvis builtin.ends_with(fil, "/linux-app-release.yml") { returner usann }
    hvis builtin.ends_with(fil, "/macos-app-release.yml") { returner usann }
    returner sann
}

funksjon collect_ref_files(root: tekst) -> liste_tekst {
    la alle = walk_files_filtrert(
        [root + "/bin/nc", root + "/.github/workflows", root + "/tools"],
        usann, ".yml,.yaml,.sh")
    la rå: liste_tekst = []
    la ai = 0
    mens ai < lengde(alle) {
        hvis alle[ai] == root + "/bin/nc" eller builtin.ends_with(alle[ai], ".yml") eller
           builtin.ends_with(alle[ai], ".yaml") eller builtin.ends_with(alle[ai], ".sh") {
            legg_til(rå, alle[ai])
        }
        ai = ai + 1
    }
    rå = sortert_unik(rå)
    la ut: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(rå) {
        hvis ref_file_allowed(root, rå[i]) { legg_til(ut, rå[i]) }
        i = i + 1
    }
    returner ut
}

funksjon linje_har_ref(line: tekst) -> bool {
    hvis builtin.index_of(line, "python3") >= 0 { returner sann }
    hvis builtin.index_of(line, "python") >= 0 { returner sann }
    hvis builtin.index_of(line, "pytest") >= 0 { returner sann }
    hvis builtin.index_of(line, "clang") >= 0 { returner sann }
    hvis builtin.index_of(line, "gcc") >= 0 { returner sann }
    hvis builtin.index_of(line, " cc ") >= 0 { returner sann }
    hvis builtin.index_of(line, "ncb_to_c") >= 0 { returner sann }
    hvis builtin.index_of(line, "c_minimal_vm") >= 0 { returner sann }
    hvis builtin.index_of(line, "nc_runtime") >= 0 { returner sann }
    hvis builtin.index_of(line, "nc_native_main") >= 0 { returner sann }
    returner usann
}

funksjon fil_ref_hits(fil: tekst) -> tekst {
    la data = ""
    prøv { data = builtin.fil_les(fil) } fang (e) { returner "" }
    la lines = builtin.split(data, "\n")
    la out = ""
    la i: heiltall = 0
    mens i < lengde(lines) {
        hvis linje_har_ref(lines[i]) {
            out = out + fil + ":" + tekst_fra_heltall(i + 1) + ":" + lines[i] + "\n"
        }
        i = i + 1
    }
    returner trim_tekst(out)
}

funksjon collect_ref_hits(root: tekst) -> tekst {
    la filer = collect_ref_files(root)
    la out = ""
    la i: heiltall = 0
    mens i < lengde(filer) {
        la hit = fil_ref_hits(filer[i])
        hvis hit != "" { out = out + hit + "\n" }
        i = i + 1
    }
    returner trim_tekst(out)
}

funksjon collect_ncb_to_c_hits(root: tekst) -> liste_tekst {
    // Røtene er disjunkte; sortering av tusenvis av filer før lineær skann
    // gav kvadratisk porttid utan å fjerne duplikat.
    la filer = walk_files_filtrert([
        root + "/.github", root + "/tools", root + "/selfhost",
        root + "/docs", root + "/bootstrap", root + "/bin"
    ], usann, ".no,.yml,.yaml,.md,.sh")
    la hits: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(filer) {
        la data = ""
        prøv { data = builtin.fil_les(filer[i]) } fang (e) { data = "" }
        hvis data != "" og builtin.contains(data, "ncb_to_c") {
            la lines = builtin.split(data, "\n")
            la j: heiltall = 0
            mens j < lengde(lines) {
                hvis builtin.index_of(lines[j], "ncb_to_c") >= 0 {
                    legg_til(hits, filer[i] + ":" + tekst_fra_heltall(j + 1) + ":" + lines[j])
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    returner hits
}

funksjon collect_scaffold_shell_entry_hits(root: tekst) -> liste_tekst {
    la filer = walk_files_filtrert(
        [root + "/README.md", root + "/docs", root + "/bin/nc"],
        usann, ".md,.sh")
    la hits: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(filer) {
        la data = ""
        prøv { data = builtin.fil_les(filer[i]) } fang (e) { data = "" }
        hvis data != "" og (builtin.contains(data, "tools/startproject.sh") eller
                            builtin.contains(data, "tools/startapp.sh")) {
            la lines = builtin.split(data, "\n")
            la j: heiltall = 0
            mens j < lengde(lines) {
                la line = lines[j]
                la er_cli = filer[i] == root + "/bin/nc"
                la er_doc_shell_ref = (builtin.index_of(line, "tools/startproject.sh") >= 0 eller builtin.index_of(line, "tools/startapp.sh") >= 0) og ikkje er_cli
                la er_gammal_cli_passthrough = er_cli og (builtin.index_of(line, "exec sh \"$ROOT_DIR/tools/startproject.sh\" \"$@\"") >= 0 eller builtin.index_of(line, "exec sh \"$ROOT_DIR/tools/startapp.sh\" \"$@\"") >= 0)
                hvis er_doc_shell_ref eller er_gammal_cli_passthrough {
                    legg_til(hits, filer[i] + ":" + tekst_fra_heltall(j + 1) + ":" + line)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    returner hits
}

funksjon collect_active_shell(root: tekst) -> liste_tekst {
    la alle = walk_files_filtrert([
        root + "/package-release.sh", root + "/scripts", root + "/tests", root + "/tools"
    ], usann, ".sh")
    la out: liste_tekst = []
    la i = 0
    mens i < lengde(alle) {
        hvis builtin.ends_with(alle[i], ".sh") { legg_til(out, alle[i]) }
        i = i + 1
    }
    returner sortert_unik(out)
}

funksjon shell_baseline_bad(root: tekst) -> liste_tekst {
    la baseline = ""
    prøv {
        baseline = builtin.fil_les(root + "/reports/shell-surface-inventory.json")
    } fang (e) {
        returner ["manglar gyldig reports/shell-surface-inventory.json"]
    }
    la aktive = collect_active_shell(root)
    la bad: liste_tekst = []
    la i = 0
    mens i < lengde(aktive) {
        la relativ = aktive[i]
        hvis builtin.starts_with(relativ, root + "/") {
            relativ = builtin.slice(relativ, lengde(root) + 1, lengde(relativ))
        }
        la kjent = builtin.index_of(baseline, "\"sti\":\"" + relativ + "\"") >= 0
        hvis ikkje kjent { legg_til(bad, aktive[i]) }
        i = i + 1
    }
    returner bad
}

funksjon shelltekst_unntak(root: tekst, fil: tekst) -> boolsk {
    // Porten sjølv og release-kontraktane må kunne nemne dei forbodne
    // tekstane. Linux Docker-stage0 er ein eksplisitt fase-5 overgangslane,
    // ikkje del av den aktive kjerneflata.
    hvis fil == root + "/tools/no_c_python_active_surface.no" { returner sann }
    hvis fil == root + "/tools/release_preflight.no" { returner sann }
    hvis fil == root + "/tools/build_linux_x86_64_stage0_docker_v3601.no" { returner sann }
    returner usann
}

funksjon forboden_shelltekst(line: tekst) -> boolsk {
    la rein = trim_tekst(line)
    hvis builtin.starts_with(rein, "#") eller builtin.starts_with(rein, "//") { returner usann }
    hvis builtin.contains(line, "sh" + " -c") { returner sann }
    hvis builtin.contains(line, "rm" + " -rf") { returner sann }
    hvis builtin.contains(line, "kommando(\"find ") eller builtin.contains(line, "exec_" + "prosess(\"find ") eller builtin.contains(line, "run(\"find ") { returner sann }
    hvis builtin.contains(line, "kommando(\"gzip ") eller builtin.contains(line, "exec_" + "prosess(\"gzip ") eller builtin.contains(line, "run(\"gzip ") { returner sann }
    hvis builtin.contains(line, "kommando(\"tar ") eller builtin.contains(line, "exec_" + "prosess(\"tar ") eller builtin.contains(line, "run(\"tar ") { returner sann }
    returner usann
}

funksjon collect_forbidden_shelltext(root: tekst) -> liste_tekst {
    la filer = walk_files_filtrert([
        root + "/std", root + "/selfhost", root + "/compiler",
        root + "/tools"
    ], sann, ".no")
    la hits: liste_tekst = []
    la i = 0
    mens i < lengde(filer) {
        hvis ikkje shelltekst_unntak(root, filer[i]) {
            la data = ""
            prøv { data = builtin.fil_les(filer[i]) } fang (e) { data = "" }
            la kan_ha = data != "" og (
                builtin.contains(data, "sh" + " -c") eller builtin.contains(data, "rm" + " -rf") eller
                builtin.contains(data, "kommando(\"find ") eller builtin.contains(data, "exec_" + "prosess(\"find ") eller builtin.contains(data, "run(\"find ") eller
                builtin.contains(data, "kommando(\"gzip ") eller builtin.contains(data, "exec_" + "prosess(\"gzip ") eller builtin.contains(data, "run(\"gzip ") eller
                builtin.contains(data, "kommando(\"tar ") eller builtin.contains(data, "exec_" + "prosess(\"tar ") eller builtin.contains(data, "run(\"tar ")
            )
            hvis kan_ha {
                la lines = builtin.split(data, "\n")
                la j = 0
                mens j < lengde(lines) {
                    hvis forboden_shelltekst(lines[j]) {
                        legg_til(hits, filer[i] + ":" + tekst_fra_heiltall(j + 1) + ":" + lines[j])
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    returner sortert_unik(hits)
}

funksjon hit_path(root: tekst, hit: tekst) -> tekst {
    la deler = builtin.split(hit, ":")
    hvis lengde(deler) < 1 { returner "" }
    la p = deler[0]
    hvis builtin.starts_with(p, "/") { returner p }
    returner root + "/" + p
}

funksjon skriv_liste(tittel: tekst, verdiar: liste_tekst) -> heiltall {
    linje(tittel)
    la i: heiltall = 0
    mens i < lengde(verdiar) {
        linje(verdiar[i])
        i = i + 1
    }
    linje("")
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }

    la fail: heiltall = 0
    linje("=== Active surface C/Python gate ===")
    linje("")
    print_policy()

    la py_hits = collect_py_hits(root)
    la py_bad: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(py_hits) {
        hvis ikkje allowlisted_path(root, py_hits[i]) { legg_til(py_bad, py_hits[i]) }
        i = i + 1
    }
    hvis lengde(py_bad) > 0 {
        skriv_liste("Feil: .py-filer funne utanfor archive/:", py_bad)
        fail = 1
    } ellers {
        linje("OK: ingen .py-filer utanfor archive/")
    }

    la c_hits = collect_c_hits(root)
    la c_bad: liste_tekst = []
    i = 0
    mens i < lengde(c_hits) {
        hvis ikkje allowlisted_path(root, c_hits[i]) { legg_til(c_bad, c_hits[i]) }
        i = i + 1
    }
    hvis lengde(c_bad) > 0 {
        skriv_liste("Feil: nye .c/.h-filer utanfor allowlist:", c_bad)
        fail = 1
    } ellers {
        linje("OK: ingen nye .c/.h-filer utanfor allowlist")
    }

    la ncb_hits = collect_ncb_to_c_hits(root)
    la ncb_bad: liste_tekst = []
    i = 0
    mens i < lengde(ncb_hits) {
        la p = hit_path(root, ncb_hits[i])
        hvis ikkje ncb_to_c_allowlisted_path(root, p) { legg_til(ncb_bad, ncb_hits[i]) }
        i = i + 1
    }
    hvis lengde(ncb_bad) > 0 {
        skriv_liste("Feil: ncb_to_c funne i normal kontekst:", ncb_bad)
        fail = 1
    } ellers hvis lengde(ncb_hits) > 0 {
        linje("OK: ncb_to_c er avgrensa til vedlikehald/docs-lane")
    } ellers {
        linje("OK: ncb_to_c-referansar er ikkje funne")
    }

    la ref_hits = collect_ref_hits(root)
    hvis ref_hits != "" {
        linje("Feil: aktive referansar til C/Python-overgangsflater utanfor allowlist:")
        linje(ref_hits)
        fail = 1
    } ellers {
        linje("OK: ingen uventa overgangsreferansar utanfor allowlist")
    }

    la scaffold_hits = collect_scaffold_shell_entry_hits(root)
    hvis lengde(scaffold_hits) > 0 {
        skriv_liste("Feil: aktiv scaffold-flate peker direkte til .sh i staden for Norscode-inngangen:", scaffold_hits)
        fail = 1
    } ellers {
        linje("OK: scaffold-kommandoflate går via Norscode-inngang")
    }

    la nye_shell = shell_baseline_bad(root)
    hvis lengde(nye_shell) > 0 {
        skriv_liste("Feil: nye aktive .sh-filer er ikkje tillatne:", nye_shell)
        fail = 1
    } ellers {
        linje("OK: ingen nye aktive .sh-filer utanfor den låste migreringsbaselinen")
    }

    la shelltekst = collect_forbidden_shelltext(root)
    hvis lengde(shelltekst) > 0 {
        skriv_liste("Feil: forboden shelltekst i aktiv kjerneflate:", shelltekst)
        fail = 1
    } ellers {
        linje("OK: ingen sh -c, rm -rf, find, gzip eller tar som kommando i aktiv kjerneflate")
    }

    hvis fail != 0 { returner 1 }
    linje("")
    linje("=== Gate passerte ===")
    returner 0
}
