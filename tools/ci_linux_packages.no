// Smal plattformgrense for den attverande SQLite-utviklingspakken.

bruk tools.process_runner som prosess

funksjon start() -> heiltall {
    la root = "."
    prøv { root = builtin.miljo_hent("NORSCODE_ROOT") } fang (e) {}
    la resultat = prosess.køyr("/usr/bin/sudo",
        ["/usr/bin/apt-get", "install", "-y", "libsqlite3-dev"], root, {}, 600000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) { returner 1 }
    skriv("Linux-plattformpakke klar\n")
    returner 0
}

