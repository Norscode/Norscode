// tools/run_selfhost_compile_phase_v4400.no — shellfri selfhost compile-fase

bruk std.filops som filops
bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon has(sti: tekst, needle: tekst) -> bool {
    prøv { returner builtin.index_of(builtin.fil_les(sti), needle) >= 0 }
    fang (e) { returner usann }
    returner usann
}

funksjon skriv_logg(sti: tekst, resultat: ordbok_tekst) -> tekst {
    la body = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    builtin.fil_skriv(sti, body)
    hvis body != "" { skriv(body) }
    returner body
}

funksjon assert_ncb(sti: tekst) -> bool {
    returner has(sti, "\"entry\"") og has(sti, "\"functions\"")
}

funksjon base_no(src: tekst) -> tekst {
    la delar = builtin.split(src, "/")
    la base = delar[lengde(delar) - 1]
    hvis builtin.ends_with(base, ".no") { returner builtin.slice(base, 0, lengde(base) - 3) }
    returner base
}

funksjon files() -> liste_tekst {
    returner ["selfhost/lexer/lexer_m1.no", "selfhost/parser.no",
              "selfhost/compiler/semantic.no", "selfhost/compiler/ir_to_bytecode.no",
              "selfhost/kompiler.no"]
}

funksjon compile_one_host(root: tekst, bin_path: tekst, src: tekst, tag: tekst) -> bool {
    la out_dir = root + "/build/v4400"
    la base = base_no(src)
    la out = out_dir + "/" + tag + "_" + base + ".ncb.json"
    la log = out_dir + "/" + tag + "_" + base + ".compile.log"
    la miljø = {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": root + "/" + src, "NORSCODE_OUTPUT": out
    }
    la resultat = prosess.køyr(bin_path, [], root, miljø, 180000)
    skriv_logg(log, resultat)
    hvis ikkje prosess.ok(resultat) eller ikkje builtin.fil_finnes(out) eller ikkje assert_ncb(out) { returner usann }
    linje("[OK] " + tag + " compile: " + src + " -> " + out)
    returner sann
}

funksjon parserfeil_ok(logg: tekst) -> boolsk {
    returner builtin.index_of(logg, "Parserfeil ") >= 0 og builtin.index_of(logg, ":") >= 0
}

funksjon check_error_host(root: tekst, bin_path: tekst, tag: tekst) -> bool {
    la out_dir = root + "/build/v4400"
    la log = out_dir + "/" + tag + "_parser_error.log"
    la miljø = {
        "NORSCODE_ROOT": root, "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": root + "/tests/fixtures/compiler_error_v4400.no",
        "NORSCODE_OUTPUT": out_dir + "/" + tag + "_should_not_exist.json"
    }
    la resultat = prosess.køyr(bin_path, [], root, miljø, 120000)
    la logg = skriv_logg(log, resultat)
    hvis prosess.ok(resultat) {
        linje("[FAIL] " + tag + " parser-smoke skulle feile, men kompilerte")
        returner usann
    }
    hvis ikkje parserfeil_ok(logg) { returner usann }
    linje("[OK] " + tag + " parser error smoke har linje/kolonne")
    returner sann
}

funksjon run_linux_docker(root: tekst, docker: tekst) -> bool {
    la container = docker_runner.opprett_ubuntu(docker, root, root, "linux/amd64", "selfhost-compile-v4400")
    hvis container == "" { returner usann }
    hvis ikkje docker_runner.start(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner usann
    }
    hvis ikkje docker_runner.installer_sqlite_runtime(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner usann
    }
    for src i files() {
        la base = base_no(src)
        la out = root + "/build/v4400/linux_stage0_" + base + ".ncb.json"
        la log = root + "/build/v4400/linux_stage0_" + base + ".compile.log"
        la argv: liste_tekst = [
            "env", "NORSCODE_ROOT=/work", "NORSCODE_CMD=compile",
            "NORSCODE_FILE=/work/" + src,
            "NORSCODE_OUTPUT=/work/build/v4400/linux_stage0_" + base + ".ncb.json",
            "/work/bootstrap/stage0/norscode-linux-x86_64"
        ]
        la resultat = docker_runner.køyr_i(docker, root, container, argv, 180000)
        skriv_logg(log, resultat)
        hvis ikkje prosess.ok(resultat) eller ikkje builtin.fil_finnes(out) eller ikkje assert_ncb(out) {
            docker_runner.fjern(docker, root, container)
            returner usann
        }
        linje("[OK] linux_stage0 compile: " + src + " -> " + out)
    }

    la error_log = root + "/build/v4400/linux_stage0_parser_error.log"
    la error_argv: liste_tekst = [
        "env", "NORSCODE_ROOT=/work", "NORSCODE_CMD=compile",
        "NORSCODE_FILE=/work/tests/fixtures/compiler_error_v4400.no",
        "NORSCODE_OUTPUT=/work/build/v4400/linux_should_not_exist.json",
        "/work/bootstrap/stage0/norscode-linux-x86_64"
    ]
    la error_result = docker_runner.køyr_i(docker, root, container, error_argv, 120000)
    la error_body = skriv_logg(error_log, error_result)
    docker_runner.fjern(docker, root, container)
    hvis prosess.ok(error_result) eller ikkje parserfeil_ok(error_body) { returner usann }
    linje("[OK] linux_stage0 parser error smoke har linje/kolonne")
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    hvis ikkje filops.lag_katalogar(root + "/build/v4400") { returner 1 }

    linje("== v4400 selfhost compile phase ==")
    linje("")
    linje("[1/3] macOS active dist compile gate")
    for src i files() {
        hvis ikkje compile_one_host(root, root + "/dist/norscode_native", src, "macos_dist") { returner 1 }
    }
    linje("")
    linje("[2/3] macOS active dist parser error smoke")
    hvis ikkje check_error_host(root, root + "/dist/norscode_native", "macos_dist") { returner 1 }

    la docker = docker_runner.finn()
    hvis docker_runner.tilgjengeleg(docker, root) {
        linje("")
        linje("[3/3] Linux x86_64 stage0 compile gate (Docker)")
        hvis ikkje run_linux_docker(root, docker) { returner 1 }
    } ellers {
        linje("")
        linje("[SKIP] Docker er ikkje tilgjengeleg.")
    }
    linje("")
    linje("[OK] v4400 selfhost compile phase ferdig.")
    returner 0
}
