// Bygg macOS single-binary-kandidat gjennom strukturert Norscode-prosess-ABI.

bruk tools.process_runner som prosess
bruk tools.materialize_runtime_payloads som payloads

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/dist/norscode_native" }
    la vm_ncb = env("NORSCODE_MACOS_VM_NCB")
    // J1c/F1.2: payloadane er genererte frå kjelde (CI: artefakt), og «compiler»-
    // payloaden (795 B mini-bunt som ingen runtime les) er pensjonert.
    hvis ikkje payloads.sikre_alle(root, native) {
        skriv("[FAIL] runtime-payloadane kunne ikkje genererast frå kjelde\n")
        returner 1
    }
    hvis vm_ncb == "" { vm_ncb = payloads.ut_sti(root, "vm") }
    la output = root + "/build/norscode_native_macos_attested"
    la miljø: ordbok_tekst = {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/tools/embed_release_ncb.no",
        "NORSCODE_ROOT": root,
        "NORSCODE_EMBED_BASE": native,
        "NORSCODE_EMBED_OUT": output,
        "NORSCODE_EMBED_STREAM": "1",
        "NORSCODE_EMBED_SPECS": "vm=" + vm_ncb + ";vm-executor=" + payloads.ut_sti(root, "vm-executor")
    }
    la resultat = prosess.køyr(native, [], root, miljø, 300000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) { returner 1 }
    prøv {
        la bytes = builtin.fil_les_binær(output)
        hvis lengde(bytes) < 32 { returner 1 }
    } fang (e) { returner 1 }
    skriv("[OK] macOS single-binary attestasjonskandidat er bygd\n")
    returner 0
}
