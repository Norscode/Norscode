// tools/enforce_native_first.no — verifiser native-first-regel i Norscode

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon fil_inneheld(sti: tekst, needle: tekst) -> bool {
    prøv {
        returner builtin.index_of(builtin.fil_les(sti), needle) >= 0
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon har_legacy_test_fallback(sti: tekst) -> bool {
    returner fil_inneheld(sti, "python") eller fil_inneheld(sti, "minimal_vm")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }

    linje("=== Norscode Native-First Enforcement ===")
    linje("")

    skriv("1. Checking dist/norscode_native...")
    hvis ikkje fil_finst(root + "/dist/norscode_native") {
        linje(" FAIL")
        linje("   ERROR: dist/norscode_native not found")
        returner 1
    }
    linje(" OK")

    skriv("2. Checking no Python in normal workflow...")
    hvis fil_finst(root + "/tools/main.py") eller fil_finst(root + "/tools/compile.py") {
        linje(" FAIL")
        linje("   ERROR: Legacy Python tools found")
        returner 1
    }
    linje(" OK")

    skriv("3. Checking Norscode test owner and no active shell wrapper...")
    hvis ikkje fil_finst(root + "/tools/nc_test.no") {
        linje(" FAIL")
        linje("   ERROR: tools/nc_test.no not found")
        returner 1
    }
    hvis fil_finst(root + "/tools/nc_test.sh") {
        linje(" FAIL")
        linje("   ERROR: active tools/nc_test.sh still exists")
        returner 1
    }
    hvis har_legacy_test_fallback(root + "/archive/legacy_shell/tools/nc_test.sh") {
        linje(" FAIL")
        linje("   ERROR: archived nc_test.sh has undocumented legacy fallback")
        returner 1
    }
    linje(" OK")

    linje("")
    linje("=== Native-First Enforcement: PASSED ===")
    returner 0
}
