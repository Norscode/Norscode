// tools/run_runtime_basics_phase_v4200.no — shellfrie runtime-basics-prober

bruk std.filops som filops
bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon has(log: tekst, needle: tekst) -> bool {
    prøv { returner builtin.index_of(builtin.fil_les(log), needle) >= 0 }
    fang (e) { returner usann }
    returner usann
}

funksjon krev(log: tekst, needle: tekst) -> bool {
    hvis has(log, needle) { returner sann }
    linje("[FAIL] manglar " + needle)
    returner usann
}

funksjon skriv_logg(sti: tekst, resultat: ordbok_tekst) -> heiltall {
    la body = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    builtin.fil_skriv(sti, body)
    hvis body != "" { skriv(body) }
    returner 0
}

funksjon valider_logg(log: tekst, label: tekst) -> boolsk {
    hvis ikkje krev(log, "trim OK:") { returner usann }
    hvis ikkje krev(log, "split OK len=2") { returner usann }
    hvis ikkje krev(log, "starts_with OK: sann") { returner usann }
    hvis ikkje krev(log, "ends_with OK: sann") { returner usann }
    hvis ikkje krev(log, "tekst_fra_heltall OK: 42") { returner usann }
    hvis ikkje krev(log, "json_parse_raw OK") { returner usann }
    hvis ikkje krev(log, "nøkler OK len=2") { returner usann }
    hvis ikkje krev(log, "verdier OK len=2") { returner usann }
    hvis ikkje krev(log, "json_stringify OK len=") { returner usann }
    hvis ikkje krev(log, "fil_skriv OK") { returner usann }
    hvis ikkje krev(log, "fil_les OK: linje-42") { returner usann }
    linje("[OK] " + label + " runtime basics grøn")
    returner sann
}

funksjon run_host_probe(root: tekst, bin_path: tekst, label: tekst) -> bool {
    la probe = root + "/tests/runtime_basics_probe_v4200.no"
    la log = root + "/build/v4200/" + label + "_runtime_basics.log"
    la miljø = {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": probe,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    la resultat = prosess.køyr(bin_path, [], root, miljø, 120000)
    skriv_logg(log, resultat)
    hvis ikkje prosess.ok(resultat) { returner usann }
    returner valider_logg(log, label)
}

funksjon run_linux_docker(root: tekst, docker: tekst) -> bool {
    la log = root + "/build/v4200/linux_stage0_runtime_basics.log"
    la container = docker_runner.opprett_ubuntu(docker, root, root, "linux/amd64", "runtime-basics-v4200")
    hvis container == "" { returner usann }
    hvis ikkje docker_runner.start(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner usann
    }
    hvis ikkje docker_runner.installer_sqlite_runtime(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner usann
    }
    la argv: liste_tekst = [
        "env", "NORSCODE_CMD=run",
        "NORSCODE_FILE=/work/tests/runtime_basics_probe_v4200.no",
        "NORSCODE_ENABLE_EXEC_PROSESS=1",
        "NORSCODE_VM_CAPABILITIES=env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT=/work,.,/tmp",
        "/work/bootstrap/stage0/norscode-linux-x86_64"
    ]
    la resultat = docker_runner.køyr_i(docker, root, container, argv, 120000)
    skriv_logg(log, resultat)
    docker_runner.fjern(docker, root, container)
    hvis ikkje prosess.ok(resultat) { returner usann }
    returner valider_logg(log, "linux_stage0")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    hvis ikkje filops.lag_katalogar(root + "/build/v4200") { returner 1 }

    linje("== v4200 runtime basics phase ==")
    linje("")
    linje("[1/2] macOS active dist runtime basics")
    hvis ikkje run_host_probe(root, root + "/dist/norscode_native", "macos_dist") { returner 1 }

    la docker = docker_runner.finn()
    hvis docker_runner.tilgjengeleg(docker, root) {
        linje("")
        linje("[2/2] Linux x86_64 stage0 runtime basics (Docker)")
        hvis ikkje run_linux_docker(root, docker) { returner 1 }
    } ellers {
        linje("")
        linje("[SKIP] Docker er ikkje tilgjengeleg.")
    }

    linje("")
    linje("[OK] v4200 runtime basics probes ferdige.")
    returner 0
}
