// Norscode-eigd, deterministisk ZIP-kjerne for macOS app-bundlar.

bruk std.filops som filops
bruk std.liste som lister
bruk tools.zip_stored_writer som zip

funksjon sha256_skriv(sti: tekst) -> boolsk {
    prøv {
        la sha = builtin.sha256_bytes(builtin.fil_les_binær(sti))
        hvis sha == "" { returner usann }
        builtin.fil_skriv(sti + ".sha256", sha + "\n")
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon package_zip(app_path: tekst, zip_path: tekst) -> boolsk {
    la parent = filops.katalog(app_path)
    la filer_abs = filops.walk(app_path)
    la filer: liste_tekst = []
    la i = 0
    mens i < lengde(filer_abs) {
        la relativ = filops.relativ_sti(parent, filer_abs[i])
        hvis relativ == "" eller builtin.starts_with(relativ, "../") { returner usann }
        legg_til(filer, relativ)
        i = i + 1
    }
    lister.sorter_tekst(filer)
    hvis lengde(filer) == 0 eller ikkje zip.zip_skriv_stream(zip_path, parent, filer) {
        returner usann
    }
    returner sha256_skriv(zip_path)
}
