// tools/notarize-macos-app.no — strukturert, shellfri macOS-notarisering

bruk std.filops som filops
bruk std.liste som liste
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}
funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon krev_env(namn: tekst) -> boolsk {
    hvis env(namn) != "" { returner sann }
    linje("Feil: manglar miljøvariabel " + namn)
    returner usann
}

funksjon køyr(executable: tekst, argv: liste_tekst, root: tekst) -> boolsk {
    la resultat = prosess.køyr(executable, argv, root, {}, 1800000)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon artefaktar(root: tekst) -> liste_tekst {
    la eksplisitt = env("NORSCODE_MACOS_NOTARIZE_ARTIFACT")
    hvis eksplisitt != "" { returner [eksplisitt] }
    la ut: liste_tekst = []
    la namn = filops.lista_katalog(root + "/release-artifacts")
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis builtin.starts_with(namn[i], "Norscode-macos-") og builtin.ends_with(namn[i], ".pkg") {
            legg_til(ut, root + "/release-artifacts/" + namn[i])
        }
        i = i + 1
    }
    returner liste.sorter_tekst(ut)
}

funksjon notariser(root: tekst, artifact: tekst) -> boolsk {
    hvis ikkje filops.fil_finnes(artifact) {
        linje("Feil: manglar artefakt: " + artifact)
        returner usann
    }
    linje("Notariserer artefakt: " + artifact)
    hvis ikkje køyr("/usr/bin/xcrun", [
        "notarytool", "submit", artifact,
        "--apple-id", env("APPLE_ID"),
        "--team-id", env("APPLE_TEAM_ID"),
        "--password", env("APPLE_APP_PASSWORD"), "--wait"
    ], root) { returner usann }

    hvis builtin.ends_with(artifact, ".dmg") eller builtin.ends_with(artifact, ".app") {
        linje("Staplar notarization-resultat for " + artifact)
        hvis ikkje køyr("/usr/bin/xcrun", ["stapler", "staple", artifact], root) { returner usann }
    } ellers {
        linje("Merk: stapling blir ikkje køyrd for denne artefakttypen.")
    }
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    hvis ikkje krev_env("APPLE_ID") eller ikkje krev_env("APPLE_TEAM_ID") eller
       ikkje krev_env("APPLE_APP_PASSWORD") { returner 1 }

    la host_os = env("RUNNER_OS")
    hvis host_os == "" {
        prøv { host_os = tekst(builtin.system_info()["system"]) } fang (e) { host_os = "" }
    }
    hvis builtin.lower(host_os) != "darwin" og builtin.lower(host_os) != "macos" {
        linje("Feil: notarize-macos-app krev macOS.")
        returner 1
    }
    la filer = artefaktar(root)
    hvis lengde(filer) == 0 {
        linje("Feil: manglar artefakt")
        returner 1
    }
    la i: heiltall = 0
    mens i < lengde(filer) {
        hvis ikkje notariser(root, filer[i]) { returner 1 }
        i = i + 1
    }
    linje("Notarization ferdig.")
    returner 0
}
