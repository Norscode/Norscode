// tools/source_compile_gen1_fragment.no — isolert Gen1-kjeldekompilering

bruk selfhost.vm som vm

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la gen1_sti = env("NORSCODE_GEN1_NCB")
    la kjelde_sti = env("NORSCODE_GEN1_SOURCE")
    la ut_sti = env("NORSCODE_GEN1_OUTPUT")
    la modul_namn = env("NORSCODE_GEN1_MODULE")
    hvis gen1_sti == "" eller kjelde_sti == "" eller ut_sti == "" eller modul_namn == "" {
        linje("[FEIL] Manglar Gen1-fragmentmiljø")
        returner 1
    }

    prøv {
        la gen1 = builtin.json_parse_raw(builtin.fil_les(gen1_sti))
        la gen1_fns = gen1["functions"]
        hvis gen1_fns == null {
            linje("[FEIL] Gen1 manglar functions")
            returner 1
        }
        gen1_fns["__vm_inherit_env__"] = "sann"
        vm.vm_runtime_init(gen1_fns, sann)
        la compiler_fn = vm.finn_funksjon(
            "selfhost.kompiler.kompiler_fil_til_disk", gen1_fns)
        hvis compiler_fn == "" {
            linje("[FEIL] Gen1 manglar kompiler_fil_til_disk")
            returner 1
        }
        la args: liste = []
        legg_til(args, kjelde_sti)
        legg_til(args, ut_sti)
        legg_til(args, modul_namn)
        la skreve = vm.køyr_funksjon(compiler_fn, args, gen1_fns, 0)
        hvis ikkje fil_finst(ut_sti) {
            linje("[FEIL] Gen1 skreiv ikkje fragmentet (retur=" + tekst(skreve) + ")")
            returner 1
        }
        hvis lengde(builtin.fil_les_binær(ut_sti)) == 0 {
            linje("[FEIL] Gen1 skreiv eit tomt fragment")
            returner 1
        }
        linje("[OK] Gen1 source-compile " + kjelde_sti + " -> " + ut_sti)
        returner 0
    } fang (e) {
        linje("[FEIL] Gen1 source-compile: " + tekst(e))
        returner 1
    }
    returner 1
}
