// Prosessfri samla bootstrap-verifisering.

bruk std.filops som filops
bruk tools.python_dependency_audit som python_audit
bruk tools.compare_compilers som compare
bruk tools.bootstrap_diff_analyzer som bootstrap_diff
bruk tools.backend_ordering_validator som backend
bruk tools.semantic_diff_analyzer som semantic
bruk tools.bootstrap_artifact_pipeline som artifacts

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon statuslinje(namn: tekst, ok: bool) -> tekst {
    hvis ok { returner namn + ": OK\n" }
    returner namn + ": MANGLAR/FEIL\n"
}

funksjon verifiser(root: tekst, report: tekst) -> bool {
    hvis ikkje filops.lag_katalogar(filops.katalog(report)) { returner usann }
    la body = "=== Unified Bootstrap Verification ===\n\n"

    body = body + statuslinje("Python dependency audit", python_audit.start() == 0)

    la stage1 = root + "/build/compiler_stage1"
    la stage2 = root + "/build/compiler_stage2"
    la har_stages = filops.fil_finnes(stage1) og filops.fil_finnes(stage2)
    body = body + statuslinje("Compiler equivalence", har_stages og compare.samanlikn(stage1, stage2))
    hvis har_stages {
        body = body + statuslinje(
            "Bootstrap diff report",
            bootstrap_diff.analyser(stage1, stage2, root + "/reports/bootstrap_diff_report.txt")
        )
    } ellers {
        body = body + "Bootstrap diff report: MANGLAR COMPILER-STAGES\n"
    }

    la backend_a = root + "/reports/backend_a.txt"
    la backend_b = root + "/reports/backend_b.txt"
    hvis filops.fil_finnes(backend_a) og filops.fil_finnes(backend_b) {
        body = body + statuslinje(
            "Backend ordering",
            backend.valider(backend_a, backend_b, root + "/reports/backend_ordering_report.txt")
        )
    } ellers {
        body = body + "Backend ordering: TRACE-ARTEFAKTAR MANGLAR\n"
    }

    la semantic_a = root + "/reports/symbols_a.txt"
    la semantic_b = root + "/reports/symbols_b.txt"
    hvis filops.fil_finnes(semantic_a) og filops.fil_finnes(semantic_b) {
        body = body + statuslinje(
            "Semantic diff",
            semantic.valider(semantic_a, semantic_b, root + "/reports/semantic_diff_report.txt")
        )
    } ellers {
        body = body + "Semantic diff: TRACE-ARTEFAKTAR MANGLAR\n"
    }

    la artifact_dir = artifacts.samle(root, root + "/reports/bootstrap_artifacts")
    body = body + statuslinje("Bootstrap artifact collection", artifact_dir != "")
    body = body + "\nUnified bootstrap verification completed\n"
    builtin.fil_skriv(report, body)
    returner sann
}

funksjon start() -> heiltall {
    la root = "."
    prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) {}
    la report = root + "/reports/unified_bootstrap_verification.txt"
    hvis ikkje verifiser(root, report) { returner 1 }
    linje("Unified bootstrap verification report written to: " + report)
    returner 0
}
