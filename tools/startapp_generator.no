// Native Norscode-malmotor for `nc startapp`.

bruk std.filops som filops

funksjon _sti(rot: tekst, rel: tekst) -> tekst {
    hvis builtin.ends_with(rot, "/") { returner rot + rel }
    returner rot + "/" + rel
}

funksjon _gyldig_namn(namn: tekst) -> bool {
    returner namn != "" og builtin.index_of(namn, "/") < 0 og
        builtin.index_of(namn, "\\") < 0 og builtin.index_of(namn, "..") < 0 og
        builtin.index_of(namn, "\n") < 0 og builtin.index_of(namn, "\r") < 0
}

funksjon generer(root: tekst, project_root: tekst, app: tekst) -> bool {
    hvis ikkje _gyldig_namn(app) eller root == "" eller project_root == "" { returner usann }
    la template_root = _sti(root, "apps/users")
    la app_root = _sti(project_root, "apps/" + app)
    hvis ikkje filops.katalog_finnes(template_root) { returner usann }
    hvis filops.katalog_finnes(app_root) og lengde(filops.lista_katalog(app_root)) > 0 { returner usann }
    hvis ikkje filops.lag_katalogar(app_root) { returner usann }

    la filer = filops.walk(template_root)
    la i = 0
    mens i < lengde(filer) {
        la source = filer[i]
        la relative = builtin.slice(source, lengde(template_root) + 1, lengde(source))
        relative = builtin.replace(relative, "users", app)
        la target = _sti(app_root, relative)
        hvis ikkje filops.lag_katalogar(filops.katalog(target)) { returner usann }
        prøv {
            la body = builtin.fil_les(source)
            builtin.fil_skriv(target, builtin.replace(body, "users", app))
        } fang (e) {
            returner usann
        }
        i = i + 1
    }
    returner sann
}

funksjon start() -> heiltall {
    skriv("startapp_generator: bruk tools/startapp.no\n")
    returner 2
}
