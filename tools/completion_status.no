// Godkjend omfang for sluttporten. Nye/fjerna modular krev ei eksplisitt
// kontraktendring her; tal frå registeret åleine kan ikkje bevise dekning.
funksjon runtime_omfang() -> liste_tekst {
    returner ["bytecode_vm", "memory_manager", "garbage_collector", "call_stack",
        "heap", "type_runtime", "exception_runtime", "scheduler", "thread_system",
        "runtime_library", "filesystem_api", "network_runtime", "process_api",
        "dynamic_loader", "reflection", "runtime_security", "debug_runtime",
        "profiler", "ai_runtime", "media_runtime", "gui_runtime", "jit"]
}

funksjon stdlib_omfang() -> liste_tekst {
    returner ["tekst", "fil", "json", "http", "web", "tid", "logg", "test", "db",
        "transactional_storage", "sikkerheit", "deployment_config", "mock_http",
        "observability", "job_queue", "quick3", "inbound_email", "vedlegg", "dns",
        "tls_acme", "brannmur", "mail_server", "domenehost", "runtime_status",
        "runtime_library", "runtime_allocator", "runtime_loader", "runtime_jit",
        "runtime_stack", "runtime_type", "runtime_exception", "ai", "http_binary",
        "media_job", "media_model", "media_local", "tensor", "model_runtime",
        "qmodel_binary", "model_registry", "model_server", "model_trust",
        "model_release", "sampling", "media_neural", "media_diffusion", "neural_ops",
        "transformer", "text_generation", "tokenizer", "tokenizer_bpe",
        "text_model_bundle", "text_model_registry", "ai_bilde", "ai_lyd",
        "ai_musikk", "ai_video", "asynk", "multiprocessing", "socketserver",
        "wsgiref", "js_liste", "js_streng", "js_tal", "js_objekt", "wasm_binary"]
}

funksjon vurder(rader, omfang: liste_tekst) -> ordbok_tekst {
    la krav: ordbok_tekst = {}
    la sett: ordbok_tekst = {}
    la manglar: liste_tekst = []
    la duplikat: liste_tekst = []
    la ukjent: liste_tekst = []
    la ustabil: liste_tekst = []
    la ugyldig = 0
    la stabil = 0
    for namn i omfang {
        hvis namn == "" eller finnes_nøkkel(krav, namn) { ugyldig = ugyldig + 1 }
        krav[namn] = "1"
    }
    for rad i rader {
        hvis builtin.type(rad) != "ordbok" {
            ugyldig = ugyldig + 1
        } ellers hvis ikkje finnes_nøkkel(rad, "namn") eller ikkje finnes_nøkkel(rad, "status") {
            ugyldig = ugyldig + 1
        } ellers {
            la namn = tekst(rad["namn"])
            hvis finnes_nøkkel(sett, namn) { legg_til(duplikat, namn) }
            sett[namn] = "1"
            hvis ikkje finnes_nøkkel(krav, namn) { legg_til(ukjent, namn) }
            hvis tekst(rad["status"]) == "stabil" { stabil = stabil + 1 }
            ellers { legg_til(ustabil, namn) }
        }
    }
    for namn i omfang {
        hvis ikkje finnes_nøkkel(sett, namn) { legg_til(manglar, namn) }
    }
    la status = "red"
    hvis lengde(omfang) > 0 og lengde(rader) == lengde(omfang) og
       ugyldig == 0 og lengde(manglar) == 0 og lengde(duplikat) == 0 og
       lengde(ukjent) == 0 og lengde(ustabil) == 0 { status = "green" }
    returner {"status": status, "total": tekst(lengde(rader)), "stabil": tekst(stabil),
        "forventa": tekst(lengde(omfang)), "manglar": builtin.join(manglar, ","),
        "duplikat": builtin.join(duplikat, ","), "ukjent": builtin.join(ukjent, ","),
        "ikkje_stabil": builtin.join(ustabil, ","), "ugyldig": tekst(ugyldig)}
}
