# Bygg Linux x86_64 native-kandidat frå macOS/Linux med strukturert Zig-argv.
# Zig/C-backenden er ein eksplisitt fase-5-overgang og kandidaten blir aldri promotert her.

bruk std.filops som filops
bruk std.prosess som system_prosess
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon er_linux_x86_64_elf(sti: tekst) -> boolsk {
    prøv {
        la b = builtin.fil_les_binær(sti)
        hvis lengde(b) < 20 { returner usann }
        # ELF magic, ELFCLASS64, little-endian og e_machine=EM_X86_64 (62).
        returner b[0] == 127 og b[1] == 69 og b[2] == 76 og b[3] == 70 og
            b[4] == 2 og b[5] == 1 og b[18] == 62 og b[19] == 0
    } fang (e) { returner usann }
    returner usann
}

funksjon start() -> heiltall {
    la project_root = env("NORSCODE_ROOT")
    hvis project_root == "" { project_root = tekst(builtin.system_info()["cwd"]) }
    la zig = env("NORSCODE_ZIG")
    hvis zig == "" { zig = system_prosess.finn_kjorbar("zig") }
    hvis zig == "" { skriv("[FAIL] manglar Zig for eksplisitt fase-5-overgang\n") returner 1 }

    la out_dir = project_root + "/build/v3600/linux"
    la out = out_dir + "/norscode_native_linux_x86_64_v3602"
    la source = project_root + "/build/v3009/native_candidate_gc.c"
    la sqlite = project_root + "/third_party/sqlite/sqlite3.c"
    hvis ikkje filops.fil_finnes(source) { skriv("[FAIL] manglar native-kjelde\n") returner 1 }
    hvis ikkje filops.fil_finnes(sqlite) { skriv("[FAIL] manglar SQLite-kjelde\n") returner 1 }
    hvis ikkje filops.lag_katalogar(out_dir) { returner 1 }

    la argv: liste_tekst = ["cc", "-target", "x86_64-linux-gnu", "-O2", "-Wno-everything",
        "-I" + project_root + "/archive/legacy_c_backend", source, sqlite,
        "-lpthread", "-ldl", "-lm", "-o", out]
    la build = prosess.køyr(zig, argv, project_root, {}, 1200000)
    hvis ikkje prosess.ok(build) {
        prosess.skriv_resultat(build)
        skriv("[FAIL] Linux x86_64 cross-build\n")
        returner 1
    }
    hvis ikkje er_linux_x86_64_elf(out) {
        skriv("[FAIL] artefakt er ikkje Linux x86_64 ELF\n")
        returner 1
    }
    la data = builtin.fil_les_binær(out)
    skriv("[OK] Linux x86_64 ELF-kandidat: " + out + "\n")
    skriv("[OK] bytes=" + tekst_fra_heltall(lengde(data)) + " sha256=" + builtin.sha256_bytes(data) + "\n")
    skriv("[INFO] Kandidaten er ikkje promotert; runtime execution krev faktisk Linux-host.\n")
    returner 0
}
