bruk selfhost.ncb_serde som serde
// Lag ein separat compilerkandidat frå ei nyare NCB-bundle utan å endre
// committed stage0/precompiled. Kandidaten rettar berre den kjende,
// sjølvrefererande vm_map_har_nokkel-instruksjonen og verifiserer resultatet.

funksjon tom() -> tekst { returner builtin.slice("x", 0, 0) }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner tom() }
    returner tom()
}

funksjon start() -> heiltall {
    la inn = env("NORSCODE_COMPILER_CANDIDATE_INPUT")
    la ut = env("NORSCODE_COMPILER_CANDIDATE_OUTPUT")
    hvis inn == tom() eller ut == tom() { kast "compilerkandidat krev input og output" }
    la ncb = serde.les_fil(inn)
    la fns = ncb["functions"]
    la namn = "selfhost.vm.vm_map_har_nokkel"
    hvis ikkje finnes_nøkkel(fns, namn) { kast "compilerkandidat manglar vm-map-hjelpar" }
    la fn = fns[namn]
    la kode = fn["code"]
    la retta = 0
    la i: heiltall = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        hvis lengde(instr) >= 2 og instr[0] == "CALL" og instr[1] == namn {
            instr[1] = "builtin.har_nokkel"
            retta = retta + 1
        }
        i = i + 1
    }
    hvis retta != 1 { kast "compilerkandidat venta eksakt éin sjølvreferanse" }
    fil_skriv(ut, builtin.json_stringify(ncb))
    la kontroll = serde.les_fil(ut)
    hvis kontroll["functions"][namn]["code"][2][1] != "builtin.har_nokkel" {
        kast "compilerkandidat vart ikkje verifisert etter skriving"
    }
    skriv("compilerkandidat OK: " + ut + "\n")
    returner 0
}
