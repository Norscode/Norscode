// tools/build_linux_native_candidate_v3005.no — bygg Linux-kandidat utan promotering

bruk std.tid som tid
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon run(executable: tekst, argv: liste_tekst, cwd: tekst, miljø: ordbok_tekst) -> bool {
    la res = prosess.køyr(executable, argv, cwd, miljø, 1200000)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la os = tekst(info["system"])
    la arch = tekst(info["machine"])
    hvis os != "Linux" {
        linje("[STOP] v3005 Linux-kandidat må byggjast på Linux, ikkje " + os + ".")
        linje("[STOP] Ingen filer i dist/ eller bootstrap/stage0 vart endra.")
        returner 2
    }
    hvis ikkje (arch == "x86_64" eller arch == "amd64" eller arch == "aarch64" eller arch == "arm64") {
        linje("[STOP] Ustøtta Linux-arkitektur: " + arch)
        returner 2
    }

    linje("== v3005 Linux native candidate build ==")
    linje("root: " + root)
    linje("platform: " + os + " " + arch)
    linje("regel: ikkje skriv til dist/norscode_native")
    linje("regel: ikkje skriv til bootstrap/stage0")
    la nc = root + "/bin/nc"
    la base_env = {"NORSCODE_ROOT": root, "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write", "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp"}
    la build_env = base_env
    build_env["NC_SKIP_BUNDLE"] = "1"
    build_env["NC_SKIP_CGEN"] = "1"
    hvis ikkje run(nc, ["run", root + "/tools/build_native_candidate_v3002.no"], root, build_env) { returner 1 }

    la candidate = root + "/build/v3002/norscode_native_v3002"
    hvis ikkje builtin.fil_finnes(candidate) { linje("[FAIL] kandidat manglar etter bygg: " + candidate) returner 1 }
    la gate_env = base_env
    gate_env["NORSCODE_NATIVE_GAP_BIN"] = candidate
    hvis ikkje run(nc, ["run", root + "/tools/native_runtime_gap_gate_v3001.no"], root, gate_env) { returner 1 }

    la data = builtin.fil_les_binær(candidate)
    la stamp = tid.unix_til_iso(tid.no()) + "Z"
    la manifest = root + "/build/v3002/native_linux_candidate_v3005.manifest"
    la platform = os + "-" + arch
    la body = "version=v3005\nstatus=linux_candidate_ready_not_promoted\ncreated_utc=" + stamp + "\ncandidate=build/v3002/norscode_native_v3002\nsize_bytes=" + tekst_fra_heltall(lengde(data)) + "\nsha256=" + builtin.sha256_bytes(data) + "\nplatform=" + platform + "\ngate=NORSCODE_NATIVE_GAP_BIN=build/v3002/norscode_native_v3002 bin/nc run tools/native_runtime_gap_gate_v3001.no\ngate_status=green\ndist_norscode_native=unchanged\nbootstrap_stage0=unchanged\nproduction_promoted=false\n"
    builtin.fil_skriv(manifest, body)
    linje("[OK] Linux-kandidat klar: " + candidate)
    linje("[OK] Manifest: " + manifest)
    linje("[OK] Ingen promotering utført.")
    returner 0
}
