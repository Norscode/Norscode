// Ein kortliva Norscode-prosess eig heile bytebufferen for éin fullfil-hash.
// Inventarløparen tek berre imot digesten; ingen byte-lister lever vidare der.

funksjon start() -> heiltall {
    la sti = miljo_hent("NORSCODE_SURFACE_SHA256_FILE")
    hvis sti == "" {
        skriv("F0_FILE_SHA256_ERROR\n")
        returner 2
    }
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        la digest = tekst(builtin.sha256_bytes(bytes))
        skriv("F0_FILE_SHA256 " + digest + "\n")
        returner 0
    } fang (e) {
        skriv("F0_FILE_SHA256_ERROR\n")
        returner 1
    }
}
