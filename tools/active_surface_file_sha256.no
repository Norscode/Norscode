// Ein kortliva Norscode-prosess eig heile bytebufferen for éin fullfil-hash.
// Inventarløparen tek berre imot digesten; ingen byte-lister lever vidare der.

bruk std.runtime_filesystem som fs

funksjon filstorleik(sti: tekst) -> heiltall {
    la stat = fs.native_stat_sti(sti)
    hvis stat["status"] != "ok" eller stat["kind"] != "file" {
        kast "hash krev ei vanleg fil"
    }
    la storleik = heiltall_fra_tekst(tekst(stat["value"]))
    hvis storleik < 0 { kast "ugyldig filstorleik" }
    returner storleik
}

funksjon kontroller_lesbar(sti: tekst, storleik: heiltall) {
    la delar = fs.native_sti_rot_relativ(sti)
    la h = fs.opne_native(tekst(delar["root"]), tekst(delar["relative"]), "read")
    hvis h["status"] != "open" { kast "fila kunne ikkje opnast for lesing" }
    // Behald stien ved handtakskall: VM-policyen må kontrollere same fil ved
    // stat/close òg når disk.read er avgrensa til ei absolutt repository-rot.
    la req = {"abi": fs.native_versjon(), "operation": "stat", "handle": h["handle"],
        "root": delar["root"], "relative": delar["relative"]}
    la stat = builtin.filesystem_read_operation(req)
    req["operation"] = "close"
    la lukka = builtin.filesystem_read_operation(req)
    hvis stat["status"] != "ok" eller lukka["status"] != "closed" eller
       heiltall_fra_tekst(tekst(stat["value"])) != storleik {
        kast "fila kunne ikkje lesast fullstendig"
    }
}

funksjon start() -> heiltall {
    la sti = miljo_hent("NORSCODE_SURFACE_SHA256_FILE")
    hvis sti == "" {
        skriv("F0_FILE_SHA256_ERROR\n")
        returner 2
    }
    prøv {
        // ARM-binary-read kan returnere ei tom/kort liste ved open/read-feil.
        // Ein slik feil må aldri godkjennast som SHA-256 av ei ekte tom fil.
        la storleik = filstorleik(sti)
        kontroller_lesbar(sti, storleik)
        la bytes = builtin.fil_les_binær(sti)
        hvis lengde(bytes) != storleik eller filstorleik(sti) != storleik {
            kast "fila endra seg eller binærlesinga vart avkorta"
        }
        la digest = tekst(builtin.sha256_bytes(bytes))
        skriv("F0_FILE_SHA256 " + digest + "\n")
        returner 0
    } fang (e) {
        skriv("F0_FILE_SHA256_ERROR\n")
        returner 1
    }
}
