// Kandidatpatch for Linux x86-64 RT_JOIN. Skriv alltid separat output og
// krev kjende, nullfylte grenser før ein byte blir endra.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon copy(dst, src) {
    la i = 0
    mens i < lengde(src) { legg_til(dst, src[i])  i = i + 1 }
}

funksjon u32(buf, v: heiltall) {
    legg_til(buf, v & 255)
    legg_til(buf, (v >> 8) & 255)
    legg_til(buf, (v >> 16) & 255)
    legg_til(buf, (v >> 24) & 255)
}

funksjon u64(buf, v: heiltall) {
    la i = 0
    mens i < 8 { legg_til(buf, (v >> (i * 8)) & 255)  i = i + 1 }
}

funksjon les_u64(buf, pos: heiltall) -> heiltall {
    la v: heiltall = 0
    la i: heiltall = 0
    mens i < 8 { v = v | (buf[pos + i] << (i * 8))  i = i + 1 }
    returner v
}

funksjon skriv_u64_at(buf, pos: heiltall, v: heiltall) {
    la i: heiltall = 0
    mens i < 8 { buf[pos + i] = (v >> (i * 8)) & 255  i = i + 1 }
}

funksjon hopp_plass(buf, opcode: heltall) -> heiltall {
    hvis opcode >= 0 { copy(buf, [0x0F, opcode]) }
    ellers { legg_til(buf, 0xE9) }
    la pos = lengde(buf)
    u32(buf, 0)
    returner pos
}

funksjon patch_hopp(buf, pos: heiltall, mål: heiltall) {
    la rel = (mål - (pos + 4)) & 4294967295
    buf[pos] = rel & 255
    buf[pos + 1] = (rel >> 8) & 255
    buf[pos + 2] = (rel >> 16) & 255
    buf[pos + 3] = (rel >> 24) & 255
}

funksjon linear_join_bytes() {
    la b = []
    copy(b, [0x55, 0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57])
    copy(b, [0x48, 0x8B, 0x47, 0x08, 0x4C, 0x8B, 0x20, 0x4C, 0x8B, 0x68, 0x10])
    copy(b, [0x48, 0x8B, 0x46, 0x08, 0x49, 0x89, 0xC6, 0x4C, 0x8B, 0x38])
    copy(b, [0x31, 0xDB, 0x31, 0xED])
    la sum_loop = lengde(b)
    copy(b, [0x4C, 0x39, 0xE5])
    la je_sum_done = hopp_plass(b, 0x84)
    copy(b, [0x49, 0x8B, 0x44, 0xED, 0x00, 0x48, 0x8B, 0x40, 0x08, 0x48, 0x03, 0x18])
    copy(b, [0x48, 0xFF, 0xC5])
    la jmp_sum = hopp_plass(b, -1)
    patch_hopp(b, jmp_sum, sum_loop)
    patch_hopp(b, je_sum_done, lengde(b))
    copy(b, [0x49, 0x83, 0xFC, 0x01])
    la jbe_no_sep = hopp_plass(b, 0x86)
    copy(b, [0x4C, 0x89, 0xE0, 0x48, 0xFF, 0xC8, 0x49, 0x0F, 0xAF, 0xC7, 0x48, 0x01, 0xC3])
    patch_hopp(b, jbe_no_sep, lengde(b))
    copy(b, [0x4C, 0x8B, 0x1C, 0x25])
    u32(b, 6291456)
    copy(b, [0x49, 0x89, 0x1B, 0x4D, 0x8D, 0x53, 0x08, 0x31, 0xED])
    la copy_loop = lengde(b)
    copy(b, [0x4C, 0x39, 0xE5])
    la je_copy_done = hopp_plass(b, 0x84)
    copy(b, [0x48, 0x85, 0xED])
    la je_skip_sep = hopp_plass(b, 0x84)
    copy(b, [0x4C, 0x89, 0xD7, 0x49, 0x8D, 0x76, 0x08, 0x4C, 0x89, 0xF9])
    copy(b, [0xF3, 0xA4, 0x49, 0x89, 0xFA])
    patch_hopp(b, je_skip_sep, lengde(b))
    copy(b, [0x49, 0x8B, 0x44, 0xED, 0x00, 0x48, 0x8B, 0x40, 0x08])
    copy(b, [0x48, 0x8B, 0x08, 0x48, 0x8D, 0x70, 0x08, 0x4C, 0x89, 0xD7, 0xF3, 0xA4])
    copy(b, [0x49, 0x89, 0xFA, 0x48, 0xFF, 0xC5])
    la jmp_copy = hopp_plass(b, -1)
    patch_hopp(b, jmp_copy, copy_loop)
    patch_hopp(b, je_copy_done, lengde(b))
    copy(b, [0x41, 0xC6, 0x02, 0x00, 0x49, 0x8D, 0x42, 0x01])
    copy(b, [0x48, 0x89, 0x04, 0x25])
    u32(b, 6291456)
    copy(b, [0x48, 0x8B, 0x04, 0x25])
    u32(b, 6291456)
    copy(b, [0x48, 0x8D, 0x48, 0x10, 0x48, 0x89, 0x0C, 0x25])
    u32(b, 6291456)
    copy(b, [0x48, 0xC7, 0x00])
    u32(b, 2)
    copy(b, [0x4C, 0x89, 0x58, 0x08])
    copy(b, [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B, 0x5D, 0xC3])
    returner b
}

funksjon start() -> heiltall {
    la inn = env("NC_PATCH_INPUT")
    la ut = env("NC_PATCH_OUTPUT")
    hvis inn == "" eller ut == "" eller inn == ut {
        skriv("[FAIL] krev separate NC_PATCH_INPUT/NC_PATCH_OUTPUT\n")
        returner 2
    }
    la image = builtin.bytes_to_list(builtin.fil_les_binær(inn))
    hvis lengde(image) < 1069056 eller image[0] != 127 eller image[1] != 69 eller image[2] != 76 eller image[3] != 70 {
        skriv("[FAIL] input er ikkje venta Linux-ELF\n")
        returner 1
    }
    la join_off = 4201424 - 4194304
    la map_off = 4201568 - 4194304
    // Målområdet er layout-versjonert og må veljast eksplisitt når tekstflata
    // flyttar seg. v11-v13 brukar 0x501f00, v14 brukar 0x502800, og v15 brukar
    // 0x502e10 etter den oppdaterte VM-dispatchen. v16 brukar 0x502e70 etter
    // append-only bundle-diagnostikk. v20 brukar 0x502eb0 etter den minimale
    // køsporinga. v27 brukar 0x528900 i verifisert filpadding; den grenen
    // utvidar første RX-LOAD fram til 0x129000, framleis under neste virtuelle
    // segment på 0x540000. Nullbyteporten under avviser automatisk kandidatar
    // der området ikkje lenger er rein padding.
    la mål_va = 5250816
    la mål_raw = env("NC_PATCH_TARGET_VA")
    hvis mål_raw != "" { mål_va = heltall_fra_tekst(mål_raw) }
    hvis mål_va != 5250816 og mål_va != 5253120 og mål_va != 5254672 og
       mål_va != 5254768 og mål_va != 5254832 og mål_va != 5409024 og
       mål_va != 5413120 og mål_va != 5417216 {
        skriv("[FAIL] ukjent layout-versjon for RT_JOIN-mål\n")
        returner 1
    }
    la mål_off = mål_va - 4194304
    hvis mål_va == 5409024 eller mål_va == 5413120 eller mål_va == 5417216 {
        la ph = 64
        la rx_filesz = les_u64(image, ph + 32)
        hvis image[ph] != 1 eller image[ph + 4] != 5 eller
           les_u64(image, ph + 8) != 0 eller
           les_u64(image, ph + 16) != 4194304 eller
           (rx_filesz != 1060740 og rx_filesz != 1060683 og
            rx_filesz != 1060667 og rx_filesz != 1060719 og
            rx_filesz != 1061597 og rx_filesz != 1064050 og
            rx_filesz != 1064624 og rx_filesz != 1065140 og
            rx_filesz != 1065153 og rx_filesz != 1065118 og
            rx_filesz != 1065336 og rx_filesz != 1065442 og
            rx_filesz != 1065795 og rx_filesz != 1066754) eller
           les_u64(image, ph + 40) != rx_filesz {
            skriv("[FAIL] v27 RX-programheader avvik frå verifisert layout\n")
            returner 1
        }
        // Neste LOAD har filoffset 0x103000/0x104000 og virtuell adresse
        // 0x540000; begge er observerte, eksakte kodegen-layoutar.
        // utvidinga endar på virtuell 0x529000 og kan ikkje overlappe han.
        hvis image[120] != 1 eller image[124] != 4 eller
           (les_u64(image, 128) != 1060864 og
            les_u64(image, 128) != 1064960 og
            les_u64(image, 128) != 1069056) eller
           les_u64(image, 136) != 5505024 {
            skriv("[FAIL] v27 neste LOAD avvik frå verifisert layout\n")
            returner 1
        }
        la ny_rx_grense = 1216512
        hvis mål_va == 5413120 {
            // v32: read-only-segmentet sluttar eksakt på 0x129818 og
            // 0x129900..0x1299ff er kontrollert nullpadding før 0x12a000.
            hvis (les_u64(image, 152) != 153624 og
                  les_u64(image, 152) != 153656) eller
               (les_u64(image, 160) != 153624 og
                  les_u64(image, 160) != 153656) {
                skriv("[FAIL] v32 read-only-segment avvik frå verifisert layout\n")
                returner 1
            }
            ny_rx_grense = 1220608
        }
        hvis mål_va == 5417216 {
            // v43: read-only-segmentet sluttar på 0x12a888, og den neste
            // 256-byteøya 0x12a900..0x12a9ff er kontrollert nullpadding.
            hvis (les_u64(image, 152) != 153736 og
                  les_u64(image, 152) != 153704 og
                  les_u64(image, 152) != 153768) eller
               (les_u64(image, 160) != 153736 og
                  les_u64(image, 160) != 153704 og
                  les_u64(image, 160) != 153768) {
                skriv("[FAIL] v43 read-only-segment avvik frå verifisert layout\n")
                returner 1
            }
            ny_rx_grense = 1223168
        }
        skriv_u64_at(image, ph + 32, ny_rx_grense)
        skriv_u64_at(image, ph + 40, ny_rx_grense)
    }
    hvis image[join_off] != 0x41 eller image[join_off + 1] != 0x57 eller
       image[join_off + 2] != 0x41 eller image[join_off + 3] != 0x56 {
        skriv("[FAIL] RT_JOIN-prolog avvik frå verifisert base\n")
        returner 1
    }
    la kode = linear_join_bytes()
    hvis mål_off + lengde(kode) >= (mål_va + 256) - 4194304 {
        skriv("[FAIL] lineær join passar ikkje i verifisert tekstpadding\n")
        returner 1
    }
    la i = 0
    mens i < lengde(kode) {
        hvis image[mål_off + i] != 0 {
            skriv("[FAIL] målpadding er ikkje tom\n")
            returner 1
        }
        i = i + 1
    }
    i = 0
    mens i < lengde(kode) { image[mål_off + i] = kode[i]  i = i + 1 }
    image[join_off] = 0x48
    image[join_off + 1] = 0xB8
    la mål_bytes = []
    u64(mål_bytes, mål_va)
    i = 0
    mens i < 8 { image[join_off + 2 + i] = mål_bytes[i]  i = i + 1 }
    image[join_off + 10] = 0xFF
    image[join_off + 11] = 0xE0
    i = join_off + 12
    mens i < map_off { image[i] = 0x90  i = i + 1 }
    builtin.fil_skriv_binær(ut, builtin.bytes_from_list(image))
    hvis ikkje builtin.fil_sett_kjorbar(ut) {
        skriv("[FAIL] kunne ikkje setje kandidat kjørbar\n")
        returner 1
    }
    skriv("[OK] lineær RT_JOIN patcha i separat Linux-kandidat, bytes=" + tekst_fra_heiltall(lengde(kode)) + "\n")
    returner 0
}
