# tools/repository_cleanup_core.no — shell-fri og avgrensa repo-opprydding

bruk std.filops som filops

funksjon _sti(rot: tekst, namn: tekst) -> tekst {
    hvis builtin.ends_with(rot, "/") { returner rot + namn }
    returner rot + "/" + namn
}

funksjon _trygg_rot(rot: tekst) -> tekst {
    la normal = filops.absolutt_sti(builtin.trim(rot))
    hvis rot == "" eller normal == "" eller normal == "/" eller normal == "." {
        returner ""
    }
    la heim = ""
    prøv { heim = filops.absolutt_sti(miljo_hent("HOME")) } fang (e) {}
    hvis heim != "" og normal == heim { returner "" }
    hvis ikkje filops.katalog_finnes(normal) { returner "" }
    hvis ikkje filops.fil_finnes(_sti(normal, "norcode.toml")) { returner "" }
    returner normal
}

funksjon _er_artefaktfil(namn: tekst, full: bool) -> bool {
    hvis namn == ".DS_Store" { returner sann }
    hvis builtin.starts_with(namn, "tmp_") eller builtin.starts_with(namn, "debug_") {
        returner sann
    }
    hvis builtin.ends_with(namn, ".pyc") eller builtin.ends_with(namn, ".tmp") {
        returner sann
    }
    hvis full og (builtin.ends_with(namn, ".pyo") eller
                  builtin.ends_with(namn, ".bak") eller
                  builtin.ends_with(namn, ".old") eller
                  builtin.ends_with(namn, ".log")) {
        returner sann
    }
    returner usann
}

funksjon _er_artefaktkatalog(namn: tekst, full: bool) -> bool {
    hvis namn == "__pycache__" { returner sann }
    returner full og namn == "__MACOSX"
}

funksjon _slett_filer_og_merkte_katalogar(rot: tekst, full: bool) -> heiltall {
    la kø: liste_tekst = [rot]
    la qi = 0
    la sletta = 0
    mens qi < lengde(kø) {
        la katalog = kø[qi]
        la barn = filops.lista_katalog(katalog)
        la i = 0
        mens i < lengde(barn) {
            la namn = barn[i]
            la sti = _sti(katalog, namn)
            hvis filops.katalog_finnes(sti) {
                hvis namn == ".git" {
                } ellers hvis _er_artefaktkatalog(namn, full) {
                    hvis ikkje filops.slett_tre(sti) {
                        skriv("Cleanup failed to remove directory: " + sti + "\n")
                        returner -1
                    }
                    sletta = sletta + 1
                } ellers {
                    legg_til(kø, sti)
                }
            } ellers hvis _er_artefaktfil(namn, full) {
                hvis ikkje filops.slett_fil(sti) {
                    skriv("Cleanup failed to remove file: " + sti + "\n")
                    returner -1
                }
                sletta = sletta + 1
            }
            i = i + 1
        }
        qi = qi + 1
    }
    returner sletta
}

funksjon _slett_tomme_katalogar(rot: tekst) -> heiltall {
    la katalogar = filops.list_katalogar_rekursivt(rot)
    la i = lengde(katalogar) - 1
    la sletta = 0
    mens i > 0 {
        la sti = katalogar[i]
        hvis filops.filnamn(sti) != ".git" og
           filops.katalog_finnes(sti) og lengde(filops.lista_katalog(sti)) == 0 {
            hvis ikkje filops.slett_tre(sti) {
                skriv("Cleanup failed to remove empty directory: " + sti + "\n")
                returner -1
            }
            sletta = sletta + 1
        }
        i = i - 1
    }
    returner sletta
}

funksjon rydd(rot: tekst, full: bool) -> heiltall {
    la trygg = _trygg_rot(rot)
    hvis trygg == "" { returner -1 }

    la sletta = _slett_filer_og_merkte_katalogar(trygg, full)
    hvis sletta < 0 { returner -1 }

    hvis full {
        la toppnivå: liste_tekst = ["build", "dist", "release", "artifacts"]
        la i = 0
        mens i < lengde(toppnivå) {
            la sti = _sti(trygg, toppnivå[i])
            hvis filops.katalog_finnes(sti) {
                hvis ikkje filops.slett_tre(sti) {
                    skriv("Cleanup failed to remove top-level directory: " + sti + "\n")
                    returner -1
                }
                sletta = sletta + 1
            }
            i = i + 1
        }
        la tomme = _slett_tomme_katalogar(trygg)
        hvis tomme < 0 { returner -1 }
        sletta = sletta + tomme
    }
    returner sletta
}
