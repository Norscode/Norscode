// Avslutt ein allereie generert Linux-ELF med eksakt NCB-trailer og filmodus.
// Brukast av diagnostisk/kontrollert kandidatflyt; promoterer aldri dist/stage0.
// Verktøyet er med vilje importfritt: ferdigstilling av ein allereie lukka
// ELF skal ikkje materialisere heile release-bygggrafen i kandidatheapen.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon u64_le(verdi: heiltall) -> liste_heiltall {
    la bytes: liste_heiltall = []
    la i: heiltall = 0
    mens i < 8 {
        legg_til(bytes, (verdi >> (i * 8)) & 255)
        i = i + 1
    }
    returner bytes
}

funksjon fullfør_innebygd_ncb(elf: tekst, ncb: tekst) -> boolsk {
    prøv {
        la payload = builtin.fil_les_binær(ncb)
        builtin.fil_append_binary(elf, payload)
        builtin.fil_append(elf, "NORSCODE_NCB_V1")
        builtin.fil_append_binary(elf,
            builtin.bytes_from_list(u64_le(lengde(payload))))
        returner sann
    } fang (e) {
        skriv("[FAIL] klarte ikkje strøyme NCB-trailer: " + tekst(e) + "\n")
        returner usann
    }
    returner usann
}

funksjon start() -> heiltall {
    la elf = env("NC_FINALIZE_ELF")
    la ncb = env("NC_FINALIZE_NCB")
    hvis elf == "" eller ncb == "" {
        skriv("[FAIL] NC_FINALIZE_ELF/NC_FINALIZE_NCB manglar\n")
        returner 2
    }
    hvis ikkje builtin.fil_finnes(elf) eller ikkje builtin.fil_finnes(ncb) {
        skriv("[FAIL] kandidat-ELF eller NCB manglar\n")
        returner 1
    }
    hvis ikkje fullfør_innebygd_ncb(elf, ncb) {
        returner 1
    }
    hvis ikkje builtin.fil_sett_kjorbar(elf) {
        skriv("[FAIL] kandidatmodus kunne ikkje setjast\n")
        returner 1
    }
    skriv("[OK] Linux full-host-kandidat ferdigstilt utan promotering\n")
    returner 0
}
