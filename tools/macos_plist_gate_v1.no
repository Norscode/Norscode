// Norscode-eigd Info.plist-validering for bygg, signering og pakking.

bruk std.plistlib som plist

funksjon valider_info(sti: tekst) -> boolsk {
    prøv {
        la data = plist.les_fil(sti)
        returner plist.get(data, "CFBundleIdentifier") != "" og
            plist.get(data, "CFBundleExecutable") != "" og
            plist.get(data, "CFBundlePackageType") == "APPL" og
            plist.get(data, "CFBundleVersion") != ""
    } fang (e) { returner usann }
    returner usann
}
