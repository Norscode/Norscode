// Prosessfri Windows ZIP-pakking.

bruk tools.build_windows_app_layout_core som layout
bruk std.filops som filops
bruk std.runtime_filesystem som runtime_fs
bruk std.sha256 som sha256_bytes
bruk std.zip som zip

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    // index_of finst òg i den committed Windows-stage0-en, medan den gamle
    // VM-en ikkje deler tekst til teikn stabilt med split(sti, "").
    hvis builtin.index_of(sti, ":") >= 0 { returner sti }
    hvis builtin.starts_with(sti, builtin.chr(92) + builtin.chr(92)) { returner sti }
    returner root + "/" + sti
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon toml_version_fra_innhald(innhald: tekst) -> tekst {
    la linjer = builtin.split(innhald, "\n")
    la i = 0
    mens i < lengde(linjer) {
        la line = builtin.trim(linjer[i])
        hvis builtin.starts_with(line, "version") {
            la delar = builtin.split(line, "\"")
            hvis lengde(delar) >= 3 { returner builtin.trim(delar[1]) }
        }
        i = i + 1
    }
    returner ""
}

funksjon repo_version(root: tekst) -> tekst {
    la toml = root + "/norcode.toml"
    hvis fil_finst(toml) {
        la v = toml_version_fra_innhald(builtin.fil_les(toml))
        hvis v != "" { returner v }
    }
    returner "1.0"
}

funksjon sorter_tekst(verdiar: liste_tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(verdiar) {
        la pos = lengde(ut)
        la j = 0
        mens j < lengde(ut) {
            hvis verdiar[i] < ut[j] { pos = j j = lengde(ut) }
            ellers { j = j + 1 }
        }
        legg_til(ut, "")
        j = lengde(ut) - 1
        mens j > pos { ut[j] = ut[j - 1] j = j - 1 }
        ut[pos] = verdiar[i]
        i = i + 1
    }
    returner ut
}

funksjon pakk(exe_path_inn: tekst, version_inn: tekst, root: tekst) -> heiltall {
    la exe_path = exe_path_inn
    hvis exe_path == "" {
        linje("Feil: manglar path til Windows-native .exe")
        linje("Døme: ./bin/nc package-windows-app build/windows/norscode.exe")
        returner 1
    }
    // CLI-dispatchen kan allereie ha normalisert Windows-stien. Bruk ei
    // eksisterande fil direkte og legg berre på root når relativoppslaget
    // faktisk ikkje finst; dette er stabilt på tvers av stage0-streng-ABI-ar.
    hvis ikkje fil_finst(exe_path) { exe_path = abs_sti(root, exe_path) }
    hvis ikkje fil_finst(exe_path) {
        linje("Feil: fann ikkje .exe-artefakt: " + exe_path)
        returner 1
    }
    la version = version_inn
    hvis version == "" { version = repo_version(root) }
    hvis builtin.index_of(version, "/") >= 0 eller builtin.index_of(version, "\\") >= 0 eller
       builtin.index_of(version, "..") >= 0 {
        linje("Feil: ugyldig pakkeversjon")
        returner 1
    }

    la release_dir = root + "/release-artifacts"
    la build_dir = root + "/build"
    hvis ikkje filops.lag_katalogar(release_dir) eller ikkje filops.lag_katalogar(build_dir) { returner 1 }
    la stage = runtime_fs.native_tempområde(build_dir, "windows-package-")
    hvis stage["status"] != "created" { returner 1 }
    la stage_dir = build_dir + "/" + stage["relative"]
    la layout_root = stage_dir + "/layout"
    la pkg_name = "norscode-windows-" + version
    la zip_path = release_dir + "/" + pkg_name + ".zip"

    hvis layout.bygg(layout_root, "Norscode", exe_path, root) != 0 {
        filops.slett_tre(stage_dir)
        returner 1
    }
    filops.slett_fil(zip_path)
    filops.slett_fil(zip_path + ".sha256")
    la filer_full = filops.walk(layout_root + "/Norscode")
    la filer: liste_tekst = []
    la i = 0
    mens i < lengde(filer_full) {
        legg_til(filer, filops.relativ_sti(layout_root, filer_full[i]))
        i = i + 1
    }
    filer = sorter_tekst(filer)
    hvis ikkje zip.zip_skriv_lagra_filer(zip_path, layout_root, filer) {
        filops.slett_tre(stage_dir)
        returner 1
    }
    la hash = sha256_bytes.hash_bytes(builtin.fil_les_binær(zip_path))
    builtin.fil_skriv(zip_path + ".sha256", hash + "\n")
    hvis ikkje filops.slett_tre(stage_dir) { returner 1 }

    linje("Bygde Windows ZIP-artefakt: " + zip_path)
    linje("SHA256: " + zip_path + ".sha256")
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    returner pakk(env("NORSCODE_WINDOWS_PACKAGE_EXE"),
                  env("NORSCODE_WINDOWS_PACKAGE_VERSION"), root)
}
