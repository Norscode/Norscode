// Same-length, fail-closed candidatepatch for legacy JSON empty-list ABI.
// Patcher berre den NCB-en som er trekt ut av levande kodegenerator; aktiv
// runtime, stage0 og kjeldeartefaktar blir aldri overskrivne.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon tel(raw: tekst, nål: tekst) -> heiltall {
    la rest = raw
    la n: heiltall = 0
    mens builtin.index_of(rest, nål) >= 0 {
        la p = builtin.index_of(rest, nål)
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
    }
    returner n
}

funksjon start() -> heiltall {
    la inn = env("NC_CODEGEN_PATCH_INPUT")
    la ut = env("NC_CODEGEN_PATCH_OUTPUT")
    hvis inn == "" eller ut == "" eller inn == ut { returner 2 }
    la raw = builtin.fil_les(inn)
    // Generator-NCB-en held pre-patch-adressa 0x4010e0; bygg_runtime_v2
    // normaliserer henne seinare til aktive RT_STR_RAW på 0x401090.
    la gammel = "48bf331040000000000048b8e010400000000000ffd0"
    la ny = "31ff31f690909090909048b8e010400000000000ffd0"
    hvis lengde(gammel) != lengde(ny) eller tel(raw, gammel) != 1 eller
       tel(raw, ny) != 0 {
        skriv("[FAIL] JSON empty-list-signatur avvik frå verifisert kodegen-NCB\n")
        returner 1
    }
    la resultat = builtin.replace(raw, gammel, ny)
    hvis lengde(resultat) != lengde(raw) eller tel(resultat, gammel) != 0 eller
       tel(resultat, ny) != 1 {
        skriv("[FAIL] JSON empty-list-patch gav ikkje eksakt resultat\n")
        returner 1
    }
    builtin.fil_skriv(ut, resultat)
    skriv("[OK] JSON empty-list ABI patcha i separat kodegen-NCB\n")
    returner 0
}
