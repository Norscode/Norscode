// Norscode-eigd syntakskontroll for CI-barn starta gjennom committed stage0.
// Eldre stage0 kjenner ikkje den nye `check`-kommandoen; custom-shell-
// adapteren ruter derfor hit og bevarer original executable/argv bytepresist.

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon argv() -> liste_tekst {
    prøv {
        la svar = builtin.argv_operation({"abi": "norscode-argv-v1", "operation": "get"})
        hvis svar["status"] == "ok" { returner svar["argv"] }
    } fang (e) {}
    returner []
}

funksjon kjeldefil() -> tekst {
    la eksplisitt = env("NORSCODE_CI_CHECK_FILE")
    hvis eksplisitt != "" { returner eksplisitt }
    la args = argv()
    la i: heiltall = 0
    mens i + 1 < lengde(args) {
        hvis tekst(args[i]) == "check" { returner tekst(args[i + 1]) }
        i = i + 1
    }
    returner ""
}

funksjon start() -> heiltall {
    la src = kjeldefil()
    hvis src == "" eller ikkje builtin.fil_finnes(src) {
        skriv("CI check: finn ikkje kjeldefil " + src + "\n")
        returner 2
    }
    prøv {
        // Bruk kandidaten sin innebygde kompilator-ABI direkte. Å importere
        // heile selfhost-kompilatorgrafen berre for denne tidlege CI-smoken
        // brukte fleire GiB før fase-0 i det heile starta.
        builtin.kompiler_fil(builtin.fil_les(src), "__main__")
        skriv(src + ": OK\n")
        returner 0
    } fang (e) {
        skriv("CI check: " + tekst(e) + "\n")
        returner 1
    }
    returner 1
}
