// tools/build_native_from_ncb.no — in-process AOT: NCB → native Linux ARM64 ELF i
// ÉIN codegen-load (plan → compile-alle → flat-link → elf.bygg_program). Brukt for
// å byggje codegen_native.elf (AOT-codegen) frå codegen.ncb.json, så den native
// binæren kan lenke store bundle (nc_main) i LÅGT minne — utan den tolka ~11 GB-
// codegen-lasten som spränger 16 GB-verten. IN_NCB → OUT_ELF.
bruk selfhost.native_execution.macho_arm64_codegen som arm64
bruk selfhost.native_execution.elf_arm64_emitter som elf

funksjon start() -> heiltall {
    la inn = miljo_hent("IN_NCB")
    la ut = miljo_hent("OUT_ELF")
    hvis inn == "" eller ut == "" { skriv("IN_NCB og OUT_ELF påkravde\n") returner 2 }
    la ncb = arm64.les_ncb_fil(inn)   // dual-format: binær (magic) eller JSON
    skriv("[native-build] plan...\n")
    la plan = arm64.ncval_plan(ncb)
    hvis tekst(plan["ok"]) != "sann" { skriv("PLAN-FEIL " + tekst(plan["error"]) + "\n") returner 1 }
    la order = plan["order"]
    skriv("[native-build] " + tekst(lengde(order)) + " funksjonar → compile...\n")
    la res = arm64.ncval_compile_range(ncb, "linux", order, plan["globals"], 0, lengde(order))
    hvis tekst(res["ok"]) != "sann" { skriv("COMPILE-FEIL " + tekst(res["error"]) + "\n") returner 1 }
    skriv("[native-build] byggjer flatt image...\n")
    la image = []
    la fn_meta = []
    la cf = 0
    mens cf < lengde(res["frags"]) {
        la fr = res["frags"][cf]
        legg_til(fn_meta, {"name": fr["name"], "base": lengde(image), "patches": fr["patches"]})
        la w = fr["words"]
        la wi = 0
        mens wi < lengde(w) { legg_til(image, w[wi])  wi = wi + 1 }
        cf = cf + 1
    }
    skriv("[native-build] link (flat, O(n))...\n")
    la lr = arm64.ncval_link_flat("linux", image, fn_meta, plan["globals"])
    hvis tekst(lr["ok"]) != "sann" { skriv("LINK-FEIL " + tekst(lr["error"]) + "\n") returner 1 }
    skriv("[native-build] ELF-emit...\n")
    la elfbytes = elf.bygg_program(lr["image"])
    builtin.fil_skriv_binær(ut, elfbytes)
    prøv { builtin.fil_sett_kjorbar(ut) } fang (e) {}
    skriv("[native-build] ELF OK: " + ut + " (" + tekst(lengde(elfbytes)) + " bytes)\n")
    returner 0
}
