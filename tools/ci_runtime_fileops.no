// CI-bootstrap for kopiering og filmodus utan mkdir/cp/chmod-shell.

bruk std.filops som filops
bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon forelder(sti: tekst) -> tekst {
    la teikn = builtin.split(sti, "")
    la sist: heiltall = -1
    la i: heiltall = 0
    mens i < lengde(teikn) {
        hvis teikn[i] == "/" { sist = i }
        i = i + 1
    }
    hvis sist <= 0 { returner "." }
    returner builtin.join(builtin.slice(teikn, 0, sist), "")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la kjelde = env("NORSCODE_CI_FILE_SOURCE")
    la mål = env("NORSCODE_CI_FILE_TARGET")
    hvis mål == "" {
        skriv("FEIL: NORSCODE_CI_FILE_TARGET manglar\n")
        returner 2
    }
    hvis ikkje builtin.starts_with(mål, "/") { mål = root + "/" + mål }
    hvis kjelde != "" og ikkje builtin.starts_with(kjelde, "/") { kjelde = root + "/" + kjelde }

    hvis ikkje filops.lag_katalogar(forelder(mål)) {
        skriv("FEIL: kunne ikkje opprette målkatalog\n")
        returner 1
    }
    hvis kjelde != "" og ikkje filops.kopier2(kjelde, mål) {
        skriv("FEIL: kunne ikkje kopiere runtime\n")
        returner 1
    }
    la modus = native_fs.native_sett_modus_sti(mål, 493)
    hvis modus["status"] != "ok" {
        // Eldre committed stage0 manglar chmod-operasjonen. Overskriving av
        // den tracked 0755-runtimefila bevarer inode-modusen. Eit strukturert
        // selftest-kall er den fail-closed kontrollen av at målfilen verkeleg
        // kan køyrast.
        la smoke = prosess.køyr(mål, ["selftest"], root, {}, 120000)
        hvis ikkje prosess.ok(smoke) {
            prosess.skriv_resultat(smoke)
            skriv("FEIL: kunne ikkje stadfeste køyrbar filmodus\n")
            returner 1
        }
    }
    skriv("CI-runtime klar: " + mål + "\n")
    returner 0
}
