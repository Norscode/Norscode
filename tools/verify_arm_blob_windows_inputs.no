// Verify the two fixed 19ee050 hosts before either downloaded binary executes.
// This gate runs on the committed Linux stage0. The Windows host is then
// transferred only in the same-run prepared artifact used by the Windows job.
bruk tools.verify_arm_blob_uploader som linux
bruk std.sha256 som sha256

funksjon windows_bytes_ok(data) -> boolsk {
    hvis lengde(data) != 8984410 { returner usann }
    la hash = ""
    prøv { hash = builtin.sha256_bytes(data) }
    fang (e) { hash = sha256.hash_bytes(data) }
    returner hash == "60b0f4d7bcfc7d9515aaba3b01afaeaf889a455b345abd5d2f489244d7d0fc35"
}

funksjon start() -> heiltall {
    hvis linux.start() != 0 { returner 1 }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { returner 2 }
    la base = root + "/build/arm-blob-stage/windows/"
    la data = builtin.fil_les_binær(base + "nc_main_freestanding_win.exe")
    hvis ikkje windows_bytes_ok(data) {
        skriv("FEIL: Windows-adapteren har feil storleik eller SHA-256\n")
        returner 1
    }
    builtin.mkdir_p(root + "/build/windows")
    la target = root + "/build/windows/nc_main_freestanding_win.exe"
    builtin.fil_skriv_binær(target, data)
    hvis ikkje windows_bytes_ok(builtin.fil_les_binær(target)) {
        skriv("FEIL: Windows-adapteren vart ikkje kopiert byte-eksakt\n")
        returner 1
    }
    skriv("OK: kjeldebunden CRT-fri Windows-adapter, 8984410 byte, SHA-256 " +
        "60b0f4d7bcfc7d9515aaba3b01afaeaf889a455b345abd5d2f489244d7d0fc35\n")
    returner 0
}
