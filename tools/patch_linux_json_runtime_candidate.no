// Fail-closed Linux-kandidatpatch for dei fire rekursive JSON-dispatchane og
// tre gamle concat-registervariantane i den versjonerte runtimebloba.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon tel_tekst(raw: tekst, nål: tekst) -> heiltall {
    la rest = raw
    la n: heiltall = 0
    mens builtin.index_of(rest, nål) >= 0 {
        la p = builtin.index_of(rest, nål)
        n = n + 1
        rest = builtin.slice(rest, p + lengde(nål), lengde(rest))
    }
    returner n
}

funksjon patch_eksakt(bytes, gammel, ny, venta: heiltall) -> heiltall {
    hvis lengde(gammel) != lengde(ny) { returner -1 }
    la treff: heiltall = 0
    la i: heiltall = 0
    mens i + lengde(gammel) <= lengde(bytes) {
        la lik = sann
        la j: heiltall = 0
        mens j < lengde(gammel) {
            hvis bytes[i + j] != gammel[j] { lik = usann; bryt }
            j = j + 1
        }
        hvis lik {
            j = 0
            mens j < lengde(ny) { bytes[i + j] = ny[j]; j = j + 1 }
            treff = treff + 1
            i = i + lengde(gammel)
        } ellers { i = i + 1 }
    }
    hvis treff != venta { returner -1 }
    returner treff
}

funksjon skriv_i32(bytes, pos: heiltall, verdi: heiltall) {
    bytes[pos] = verdi & 255
    bytes[pos + 1] = (verdi >> 8) & 255
    bytes[pos + 2] = (verdi >> 16) & 255
    bytes[pos + 3] = (verdi >> 24) & 255
}

funksjon les_u64(bytes, pos: heiltall) -> heiltall {
    la verdi: heiltall = 0
    la i: heiltall = 7
    mens i >= 0 {
        verdi = (verdi << 8) | bytes[pos + i]
        i = i - 1
    }
    returner verdi
}

funksjon start() -> heiltall {
    la inn = env("NC_JSON_PATCH_INPUT")
    la ut = env("NC_JSON_PATCH_OUTPUT")
    hvis inn == "" eller ut == "" eller inn == ut { returner 2 }
    la bytes = builtin.bytes_to_list(builtin.fil_les_binær(inn))
    la nbytes = lengde(bytes)
    hvis nbytes < 1000000 { returner 1 }
    // Layouten er bunden til kandidatgenerasjonen. Eksakte offsetar gjer
    // patchen O(1) etter innlesing, og kvar byte blir kontrollert før endring.
    la dispatch_offsets = [10129, 10383, 10736, 12779]
    la di: heiltall = 0
    mens di < lengde(dispatch_offsets) {
        la p = dispatch_offsets[di]
        hvis bytes[p] == 0x1e og bytes[p + 1] == 0x47 og bytes[p + 2] == 0x40 og
           bytes[p + 3] == 0 og bytes[p + 4] == 0 og bytes[p + 5] == 0 og
           bytes[p + 6] == 0 og bytes[p + 7] == 0 {
            di = di + 1
            fortsett
        }
        hvis bytes[p] != 0x60 eller bytes[p + 1] != 0x26 eller bytes[p + 2] != 0x40 eller
           bytes[p + 3] != 0 eller bytes[p + 4] != 0 eller bytes[p + 5] != 0 eller
           bytes[p + 6] != 0 eller bytes[p + 7] != 0 { returner 1 }
        bytes[p] = 0x1e; bytes[p + 1] = 0x47
        di = di + 1
    }
    la concat_offsets = [10859, 10018, 10744]
    la concat_rex = [0x48, 0x49, 0x49]
    la concat_reg = [0xb9, 0xbc, 0xbe]
    la ci: heiltall = 0
    mens ci < 3 {
        la p = concat_offsets[ci]
        hvis bytes[p] == concat_rex[ci] og bytes[p + 1] == concat_reg[ci] og
           bytes[p + 2] == 0x47 og bytes[p + 3] == 0x39 og
           bytes[p + 4] == 0x40 og bytes[p + 5] == 0 og bytes[p + 6] == 0 og
           bytes[p + 7] == 0 og bytes[p + 8] == 0 og bytes[p + 9] == 0 {
            ci = ci + 1
            fortsett
        }
        hvis bytes[p] != concat_rex[ci] eller bytes[p + 1] != concat_reg[ci] eller
           bytes[p + 2] != 0x10 eller bytes[p + 3] != 0x11 eller bytes[p + 4] != 0x40 eller
           bytes[p + 5] != 0 eller bytes[p + 6] != 0 eller bytes[p + 7] != 0 eller
           bytes[p + 8] != 0 eller bytes[p + 9] != 0 {
            returner 1
        }
        bytes[p + 2] = 0x47; bytes[p + 3] = 0x39
        ci = ci + 1
    }
    // Tre direkte legacy-kall brukte 0x401430 (replace med tre argument) som
    // om det var concat. Bind dei til den aktive to-arguments concat-rutinen.
    la direkte_concat_offsets = [9801, 10114, 10426]
    la dci: heiltall = 0
    mens dci < 3 {
        la p = direkte_concat_offsets[dci]
        hvis bytes[p] != 0x30 eller bytes[p + 1] != 0x14 eller bytes[p + 2] != 0x40 eller
           bytes[p + 3] != 0 eller bytes[p + 4] != 0 eller bytes[p + 5] != 0 eller
           bytes[p + 6] != 0 eller bytes[p + 7] != 0 { returner 1 }
        bytes[p] = 0x47; bytes[p + 1] = 0x39
        dci = dci + 1
    }
    // Alle JSON-teikna blir materialiserte frå ein stackbyte med lengd 1.
    // Dette erstattar dei sju legacy-peikarane i nøyaktig same 22-bytebudsjett.
    la literal_offsets = [9926, 9990, 10084, 10396, 10702, 10801, 10837]
    la literal_lågbyte = [0x37, 0x66, 0x64, 0x39, 0x33, 0x64, 0x35]
    la literal_byte = [0x7b, 0x3a, 0x2c, 0x7d, 0x5b, 0x2c, 0x5d]
    la li: heiltall = 0
    mens li < 7 {
        la p = literal_offsets[li]
        hvis bytes[p] == 0x6a og bytes[p + 1] == literal_byte[li] og
           bytes[p + 2] == 0x48 og bytes[p + 3] == 0x89 og bytes[p + 4] == 0xe7 og
           bytes[p + 5] == 0xbe og bytes[p + 6] == 1 og bytes[p + 7] == 0 og
           bytes[p + 8] == 0 og bytes[p + 9] == 0 og bytes[p + 10] == 0xe8 og
           bytes[p + 15] == 0x59 {
            li = li + 1
            fortsett
        }
        hvis bytes[p] != 0x48 eller bytes[p + 1] != 0xbf eller
           bytes[p + 2] != literal_lågbyte[li] eller bytes[p + 3] != 0x10 eller
           bytes[p + 4] != 0x40 eller bytes[p + 5] != 0 eller bytes[p + 6] != 0 eller
           bytes[p + 7] != 0 eller bytes[p + 8] != 0 eller bytes[p + 9] != 0 eller
           bytes[p + 10] != 0x48 eller bytes[p + 11] != 0xb8 eller
           bytes[p + 12] != 0x90 eller bytes[p + 13] != 0x10 eller
           bytes[p + 14] != 0x40 eller bytes[p + 15] != 0 eller
           bytes[p + 16] != 0 eller bytes[p + 17] != 0 eller bytes[p + 18] != 0 eller
           bytes[p + 19] != 0 eller bytes[p + 20] != 0xff eller bytes[p + 21] != 0xd0 {
            returner 1
        }
        bytes[p] = 0x6a; bytes[p + 1] = literal_byte[li]
        bytes[p + 2] = 0x48; bytes[p + 3] = 0x89; bytes[p + 4] = 0xe7
        bytes[p + 5] = 0xbe; bytes[p + 6] = 1
        bytes[p + 7] = 0; bytes[p + 8] = 0; bytes[p + 9] = 0
        bytes[p + 10] = 0xe8
        la rel = 4198544 - (4194304 + p + 15)
        bytes[p + 11] = rel & 255
        bytes[p + 12] = (rel >> 8) & 255
        bytes[p + 13] = (rel >> 16) & 255
        bytes[p + 14] = (rel >> 24) & 255
        bytes[p + 15] = 0x59
        la ni = 16
        mens ni < 22 { bytes[p + ni] = 0x90; ni = ni + 1 }
        li = li + 1
    }
    // json_stringify må handtere null før første NcVal-dereferering. Den
    // eksisterande wrapperen har ikkje fem ledige byte, så bruk den siste
    // verifiserte RX-paddinga etter lineær-join-området som ein 24-byte
    // trampoline og hopp tilbake etter den opphavlege type-1-greina.
    la wrapper = 18206
    hvis bytes[wrapper] != 0x48 eller bytes[wrapper + 1] != 0x83 eller
       bytes[wrapper + 2] != 0x3f eller bytes[wrapper + 3] != 1 eller
       bytes[wrapper + 4] != 0x74 eller bytes[wrapper + 5] != 0x35 { returner 1 }
    la tramp = 1219048
    hvis ((les_u64(bytes, 96) == 1065140 og les_u64(bytes, 104) == 1065140 og
           les_u64(bytes, 152) == 153736 og les_u64(bytes, 160) == 153736) eller
          (les_u64(bytes, 96) == 1065153 og les_u64(bytes, 104) == 1065153 og
           les_u64(bytes, 152) == 153704 og les_u64(bytes, 160) == 153704) eller
          (les_u64(bytes, 96) == 1065118 og les_u64(bytes, 104) == 1065118 og
           les_u64(bytes, 152) == 153704 og les_u64(bytes, 160) == 153704) eller
          (les_u64(bytes, 96) == 1065336 og les_u64(bytes, 104) == 1065336 og
           les_u64(bytes, 152) == 153768 og les_u64(bytes, 160) == 153768) eller
          (les_u64(bytes, 96) == 1065442 og les_u64(bytes, 104) == 1065442 og
           les_u64(bytes, 152) == 153704 og les_u64(bytes, 160) == 153704) eller
          (les_u64(bytes, 96) == 1065795 og les_u64(bytes, 104) == 1065795 og
           les_u64(bytes, 152) == 153704 og les_u64(bytes, 160) == 153704) eller
          (les_u64(bytes, 96) == 1066754 og les_u64(bytes, 104) == 1066754 og
           les_u64(bytes, 152) == 153704 og les_u64(bytes, 160) == 153704)) {
        // v43/v44: read-only-data flytta inn i den gamle øya. Bruk dei siste
        // 24 byta i den verifiserte 0x12a900..0x12a9ff-paddinga i staden.
        tramp = 1223144
    }
    la ti: heiltall = 0
    mens ti < 24 {
        hvis bytes[tramp + ti] != 0 { returner 1 }
        ti = ti + 1
    }
    bytes[wrapper] = 0xe9
    skriv_i32(bytes, wrapper + 1, tramp - (wrapper + 5))
    bytes[wrapper + 5] = 0x90
    bytes[tramp] = 0x48; bytes[tramp + 1] = 0x85; bytes[tramp + 2] = 0xff
    bytes[tramp + 3] = 0x0f; bytes[tramp + 4] = 0x84
    skriv_i32(bytes, tramp + 5, (wrapper + 30) - (tramp + 9))
    bytes[tramp + 9] = 0x48; bytes[tramp + 10] = 0x83
    bytes[tramp + 11] = 0x3f; bytes[tramp + 12] = 1
    bytes[tramp + 13] = 0x0f; bytes[tramp + 14] = 0x84
    skriv_i32(bytes, tramp + 15, (wrapper + 59) - (tramp + 19))
    bytes[tramp + 19] = 0xe9
    skriv_i32(bytes, tramp + 20, (wrapper + 6) - (tramp + 24))
    hvis di != 4 eller ci != 3 eller dci != 3 eller li != 7 {
        skriv("[FAIL] JSON runtime-layout samsvarer ikkje med 4/1/1/1-porten\n")
        returner 1
    }
    builtin.fil_skriv_binær(ut, builtin.bytes_from_list(bytes))
    skriv("[OK] rekursiv JSON/concat patcha i separat Linux-kandidat\n")
    returner 0
}
