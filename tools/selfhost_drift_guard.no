// tools/selfhost_drift_guard.no — samlet driftsvakt i Norscode

bruk tools.process_runner som process_runner

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim(t: tekst) -> tekst {
    returner builtin.trim(t)
}

funksjon native_executable(root: tekst) -> tekst {
    la eksplisitt = env("NC_NATIVE")
    hvis eksplisitt != "" { returner eksplisitt }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon run_step(root: tekst, label: tekst, argv: liste_tekst) -> bool {
    returner run_step_env(root, label, argv, {"NORSCODE_ROOT": root})
}

funksjon run_step_env(root: tekst, label: tekst, argv: liste_tekst, miljø: ordbok_tekst) -> bool {
    la res = process_runner.køyr(native_executable(root), argv, root, miljø, 3600000)
    process_runner.skriv_resultat(res)
    hvis process_runner.ok(res) {
        returner sann
    }
    linje("Driftsvakt feila i " + label)
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    hvis ikkje run_step(root, "fase0", ["phase0-verify"]) { returner 1 }
    // F0.1-kategoriane (framandspråk, binær, hex, bytekode, json …) er ein PORT her, ikkje
    // rapport: ratchet = talet per kategori kan berre gå ned, og nye treff utanfor
    // tools/active_surface_allowlist.txt feilar.
    hvis ikkje run_step_env(root, "aktiv flate", ["active-surface"],
                            {"NORSCODE_ROOT": root, "NORSCODE_SURFACE_GATE": "ratchet"}) { returner 1 }
    hvis ikkje run_step(root, "vedlikehald", ["selfhost-maintenance-verify"]) { returner 1 }
    linje("Driftsvakt: OK")
    returner 0
}
