// Kopier, verifiser og hash release-runtime utan cp/chmod/hash-shell.

bruk std.filops som filops
bruk std.sha256 som sha256
bruk std.runtime_filesystem som native_fs
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    returner delar[lengde(delar) - 1]
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la kjelde = env("NORSCODE_PUBLISH_RUNTIME_SOURCE")
    la mål = env("NORSCODE_PUBLISH_RUNTIME_OUTPUT")
    hvis kjelde == "" eller mål == "" { returner 2 }
    hvis ikkje builtin.starts_with(kjelde, "/") { kjelde = root + "/" + kjelde }
    hvis ikkje builtin.starts_with(mål, "/") { mål = root + "/" + mål }

    hvis env("NORSCODE_PUBLISH_SELFCHECK") == "1" {
        la selfcheck = prosess.køyr(kjelde, ["selfcheck"], root, {}, 120000)
        prosess.skriv_resultat(selfcheck)
        hvis ikkje prosess.ok(selfcheck) { returner 1 }
    }
    hvis ikkje filops.kopier2(kjelde, mål) { returner 1 }
    hvis native_fs.native_sett_modus_sti(mål, 493)["status"] != "ok" {
        la chmod = prosess.køyr("/bin/chmod", ["755", mål], root, {}, 30000)
        hvis ikkje prosess.ok(chmod) { returner 1 }
    }
    la hash = sha256.hash_bytes(builtin.fil_les_binær(mål))
    builtin.fil_skriv(mål + ".sha256", hash + "  " + basename(mål) + "\n")
    skriv("Publisert runtime: " + mål + " sha256=" + hash + "\n")
    returner 0
}

