// Prosessfri binærsamanlikning av kompilatorartefaktar.

bruk std.filops som filops
bruk std.sha256 som sha256

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hash_fil(sti: tekst) -> tekst {
    prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon samanlikn(comp_a: tekst, comp_b: tekst) -> bool {
    hvis ikkje filops.fil_finnes(comp_a) eller ikkje filops.fil_finnes(comp_b) { returner usann }
    returner hash_fil(comp_a) == hash_fil(comp_b)
}

funksjon start() -> heiltall {
    la comp_a = env("NORSCODE_COMPILER_A")
    la comp_b = env("NORSCODE_COMPILER_B")
    hvis comp_a == "" eller comp_b == "" {
        linje("Usage: NORSCODE_COMPILER_A=<compiler_a> NORSCODE_COMPILER_B=<compiler_b> ./bin/nc run tools/compare_compilers.no")
        returner 1
    }
    hvis ikkje filops.fil_finnes(comp_a) {
        linje("Missing compiler: " + comp_a)
        returner 1
    }
    hvis ikkje filops.fil_finnes(comp_b) {
        linje("Missing compiler: " + comp_b)
        returner 1
    }

    la hash_a = hash_fil(comp_a)
    la hash_b = hash_fil(comp_b)
    linje("Compiler A: " + comp_a)
    linje("Compiler B: " + comp_b)
    linje("")
    linje("Hash A: " + hash_a)
    linje("Hash B: " + hash_b)
    linje("")
    hvis hash_a == hash_b {
        linje("Compiler equivalence PASSED")
        returner 0
    }
    linje("Compiler equivalence FAILED")
    linje("Differences detected between compiler outputs")
    returner 1
}
