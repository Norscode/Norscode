// tools/python_free_ci.no — Python- og C-fri CI-gate for normal flyt

bruk tools.process_runner som process_runner

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim_tekst(t: tekst) -> tekst {
    returner trim(t)
}

funksjon native_executable(root: tekst) -> tekst {
    la eksplisitt = env("NC_NATIVE")
    hvis eksplisitt != "" { returner eksplisitt }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) {}
    returner root + "/dist/norscode_native"
}

funksjon run(root: tekst, argv: liste_tekst) -> bool {
    la res = process_runner.køyr(native_executable(root), argv, root, {"NORSCODE_ROOT": root}, 14400000)
    process_runner.skriv_resultat(res)
    returner process_runner.ok(res)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }

    linje("=== Norscode Python-fri CI ===")
    linje("")

    hvis ikkje run(root, ["active-surface"]) { returner 1 }

    linje("1. dist/norscode_native...")
    hvis ikkje run(root, ["fetch-stage0-seed"]) { returner 1 }
    linje("")

    linje("2. Køyrer testar...")
    hvis ikkje run(root, ["test"]) { returner 1 }

    linje("")
    linje("=== Python-fri CI: BESTÅTT ===")
    returner 0
}
