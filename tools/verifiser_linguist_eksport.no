// Kontrollerer berre generert Linguist-eksport etter eksplisitt eksportsteg.
// Ligg under tools/ så vanlege test-shards ikkje krev genererte build/-filer.
// Køyres etter tools/eksporter_linguist_grammatikk.no i Format og Lint.
bruk std.regex som re
bruk std.tekst som t

funksjon oppdag(kjelde: tekst, f: tekst, r: tekst, s: tekst, kompakt: tekst, gjerde: tekst) -> bool {
    // GitHub Linguist Heuristics.call les berre dei første 50 KiB.
    // Bruk ASCII i grense-testane for å halde bytegrensa eintydig.
    la utdrag = kjelde
    hvis lengde(kjelde) > 51200 { utdrag = t.del_av(kjelde, 0, 51200) }
    // Ingen dokumentasjon med inngjerda kodeblokker skal bli Norscode.
    hvis re.samsvar(utdrag, "(?m)" + gjerde) { returner usann }
    la fleirlinje = re.samsvar(utdrag, "(?m)" + f) og re.samsvar(utdrag, "(?m)" + r) og re.samsvar(utdrag, "(?m)" + s)
    returner fleirlinje eller re.samsvar(utdrag, "(?m)" + kompakt)
}

funksjon sjekk(ok: bool, namn: tekst) -> heiltall {
    hvis ikkje ok {
        skriv("FEIL " + namn + "\n")
        returner 1
    }
    returner 0
}

funksjon start() -> heiltall {
    la funksjon_mønster = "^[ \\t]*funksjon[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\([^\\r\\n)]*\\)(?:[ \\t]*->[ \\t]*[^\\r\\n{}]+)?[ \\t]*(?:\\{|:)?[ \\t]*$"
    la retur_mønster = "^[ \\t]+returner[ \\t]+[^\\s\\r\\n]"
    la slutt_mønster = "^[ \\t]*(?:\\}|slutt)[ \\t]*$"
    la kompakt_mønster = "^[ \\t]*funksjon[ \\t]+[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\([^\\r\\n)]*\\)(?:[ \\t]*->[ \\t]*[^\\r\\n{}]+)?[ \\t]*\\{[ \\t]*returner[ \\t]+[^\\r\\n{}]+[ \\t]*\\}[ \\t]*$"
    la gjerde_mønster = "^[ \\t]*```"
    la utkast = fil_les("docs/04-how-to-guides/linguist-proposal/norscode-heuristics.yml")
    la feil = 0

    // Valider det som faktisk vert levert i GitHub Actions-artefaktet,
    // ikkje berre teststrengane eller originalkjeldene. Eksportøren må køyrast først.
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/samples/Norscode/compiler_runtime.no"), "eksportert Norscode compiler_runtime.no finst")
    feil = feil + sjekk(fil_les("build/norscode-linguist-upstream/samples/Norscode/compiler_runtime.no") == fil_les("compiler/compiler.no"), "eksportert Norscode compiler_runtime.no er uendra")
    feil = feil + sjekk(oppdag(fil_les("build/norscode-linguist-upstream/samples/Norscode/compiler_runtime.no"), funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "eksportert Norscode compiler_runtime.no")
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/samples/Norscode/toml_parser.no"), "eksportert Norscode toml_parser.no finst")
    feil = feil + sjekk(fil_les("build/norscode-linguist-upstream/samples/Norscode/toml_parser.no") == fil_les("std/tomllib.no"), "eksportert Norscode toml_parser.no er uendra")
    feil = feil + sjekk(oppdag(fil_les("build/norscode-linguist-upstream/samples/Norscode/toml_parser.no"), funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "eksportert Norscode toml_parser.no")
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/samples/Norscode/ghash.no"), "eksportert Norscode ghash.no finst")
    feil = feil + sjekk(fil_les("build/norscode-linguist-upstream/samples/Norscode/ghash.no") == fil_les("std/ghash.no"), "eksportert Norscode ghash.no er uendra")
    feil = feil + sjekk(oppdag(fil_les("build/norscode-linguist-upstream/samples/Norscode/ghash.no"), funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "eksportert Norscode ghash.no")
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/samples/Norscode/package_cache.no"), "eksportert Norscode package_cache.no finst")
    feil = feil + sjekk(fil_les("build/norscode-linguist-upstream/samples/Norscode/package_cache.no") == fil_les("toolchain/norspkg/cache.no"), "eksportert Norscode package_cache.no er uendra")
    feil = feil + sjekk(oppdag(fil_les("build/norscode-linguist-upstream/samples/Norscode/package_cache.no"), funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "eksportert Norscode package_cache.no")
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/test/fixtures/Generic/no/Text/plain_text.no"), "eksportert Text plain_text.no finst")
    feil = feil + sjekk(ikkje oppdag(fil_les("build/norscode-linguist-upstream/test/fixtures/Generic/no/Text/plain_text.no"), funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "eksportert Text plain_text.no")
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/test/fixtures/Generic/no/Text/fenced_example.no"), "eksportert Text fenced_example.no finst")
    feil = feil + sjekk(ikkje oppdag(fil_les("build/norscode-linguist-upstream/test/fixtures/Generic/no/Text/fenced_example.no"), funksjon_mønster, retur_mønster, slutt_mønster, kompakt_mønster, gjerde_mønster), "eksportert Text fenced_example.no")
    la upstream_snutt = "build/norscode-linguist-upstream/TEST_HEURISTICS_SNIPPET.txt"
    feil = feil + sjekk(fil_finnes(upstream_snutt), "upstream testutdrag finst")
    la testinnhald = fil_les(upstream_snutt)
    feil = feil + sjekk(t.inneholder(testinnhald, "def test_no_by_heuristics"), "upstream testfunksjon")
    feil = feil + sjekk(t.inneholder(testinnhald, "assert_heuristics"), "upstream assert_heuristics")
    feil = feil + sjekk(t.inneholder(testinnhald, "Generic/no/Text"), "upstream negative .no-fixtures")
    feil = feil + sjekk(fil_finnes("build/norscode-linguist-upstream/SAMPLE_ORIGINS.md"), "sample-opphav finst")

    hvis feil != 0 {
        skriv("verifiser_linguist_eksport FEIL " + tekst(feil) + "\n")
        returner 1
    }
    skriv("verifiser_linguist_eksport OK\n")
    returner 0
}
