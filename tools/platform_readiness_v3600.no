// tools/platform_readiness_v3600.no — shellfri, bevisbunden plattformstatus.
// Linux-kandidaten kan materialiserast med: ./bin/nc build-linux-stage0-docker

bruk std.runtime_filesystem som native_fs
bruk std.sha256 som sha256
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon systemfelt(namn: tekst) -> tekst {
    prøv { returner builtin.lower(tekst(builtin.system_info()[namn])) } fang (e) { returner "" }
    returner ""
}

funksjon executable(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon native_executable(root: tekst) -> tekst {
    la eksplisitt = env("NC_NATIVE")
    hvis eksplisitt == "" { eksplisitt = env("NORSCODE_NATIVE_BIN") }
    hvis eksplisitt != "" { returner eksplisitt }
    prøv { returner tekst(builtin.system_info()["executable"]) } fang (e) { }
    returner root + "/dist/norscode_native"
}

funksjon fil_sha256(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) } fang (e) {
        prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) } fang (e2) { returner "" }
    }
    returner ""
}

funksjon sluttmarkør(bytes, markør: tekst) -> boolsk {
    hvis lengde(bytes) < lengde(markør) { returner usann }
    la start = lengde(bytes) - lengde(markør)
    la i: heiltall = 0
    mens i < lengde(markør) {
        hvis bytes[start + i] != (builtin.char_code(markør[i]) & 255) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon har_embedded_ncb(sti: tekst) -> boolsk {
    hvis ikkje executable(sti) { returner usann }
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        returner sluttmarkør(bytes, "NORSCODE_NCB_IMAGE_V1") eller
            sluttmarkør(bytes, "NORSCODE_NCB_TEXT_V1")
    } fang (e) { returner usann }
    returner usann
}

funksjon runtime_smoke(root: tekst, sti: tekst) -> boolsk {
    hvis ikkje executable(sti) { returner usann }
    // Hald smoken innanfor repoets eksplisitte disk-scope. Ein vilkårleg
    // verts-TMPDIR kan liggje utanfor capability-rota.
    la tmp_rot = env("NORSCODE_PLATFORM_TMP_ROOT")
    hvis tmp_rot == "" { tmp_rot = root + "/build" }
    la tmp = native_fs.native_tempområde(tmp_rot, "nc_platform_smoke.")
    hvis tmp["status"] != "created" { returner usann }
    la rel = tekst(tmp["relative"])
    la dir = tmp_rot + "/" + rel
    la smoke = dir + "/smoke.no"
    prøv { builtin.fil_skriv(smoke, "funksjon start() { returner 0 }\n") }
    fang (e) { returner usann }
    la resultat = prosess.køyr(sti, ["run", smoke], dir, {
        "NORSCODE_ROOT": dir,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read",
        "NORSCODE_VM_DISK_ROOT": dir,
        "PATH": "/nonexistent"
    }, 30000)
    prøv { native_fs.native_slett(tmp_rot, rel + "/smoke.no") } fang (e) { }
    prøv { native_fs.native_slett_mappe(tmp_rot, rel) } fang (e) { }
    returner prosess.ok(resultat)
}

funksjon gyldig_commit(verdi: tekst) -> boolsk {
    hvis lengde(verdi) != 40 og lengde(verdi) != 64 { returner usann }
    la heks = "0123456789abcdefABCDEF"
    la i: heiltall = 0
    mens i < lengde(verdi) {
        hvis builtin.index_of(heks, verdi[i]) < 0 { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon forventa_commit() -> tekst {
    la commit = env("NORSCODE_SOURCE_COMMIT")
    hvis commit == "" { commit = env("GITHUB_SHA") }
    returner commit
}

funksjon prøv_gh(root: tekst, attestasjon: tekst, gh: tekst) -> boolsk {
    la verify = prosess.køyr(gh,
        ["attestation", "verify", attestasjon, "--repo", "Norscode/Norscode"],
        root, {}, 120000)
    returner prosess.ok(verify)
}

funksjon verifiser_github_attestasjon(root: tekst, attestasjon: tekst) -> boolsk {
    la eksplisitt = env("NORSCODE_GH")
    hvis eksplisitt != "" og prøv_gh(root, attestasjon, eksplisitt) { returner sann }
    la sti = env("PATH")
    hvis sti != "" {
        la skilje = ":"
        hvis builtin.index_of(sti, ";") >= 0 { skilje = ";" }
        for mappe i builtin.split(sti, skilje) {
            hvis mappe != "" {
                la namn = "gh"
                hvis skilje == ";" { namn = "gh.exe" }
                la kandidat = mappe + "/" + namn
                prøv {
                    hvis prøv_gh(root, attestasjon, kandidat) { returner sann }
                } fang (e) { }
            }
        }
    }
    // Dokumenterte runner-plasseringar er reserve når PATH ikkje blir arva
    // av ein eldre committed stage0.
    for gh i ["/opt/homebrew/bin/gh", "/usr/local/bin/gh", "/usr/bin/gh",
                 "C:/Program Files/GitHub CLI/gh.exe"] {
        hvis prøv_gh(root, attestasjon, gh) { returner sann }
    }
    returner usann
}

funksjon windows_attestasjon_ok(root: tekst, kandidat: tekst, attestasjon: tekst) -> boolsk {
    hvis attestasjon == "" eller ikkje executable(attestasjon) eller ikkje executable(kandidat) {
        returner usann
    }
    hvis ikkje verifiser_github_attestasjon(root, attestasjon) { returner usann }
    prøv {
        la data = builtin.json_parse_raw(builtin.fil_les(attestasjon))
        hvis tekst(data["schema"]) != "norscode-windows-runtime-attestation-v1" eller
           tekst(data["status"]) != "verified" eller tekst(data["platform"]) != "windows" eller
           tekst(data["repository"]) != "Norscode/Norscode" eller tekst(data["run_id"]) == "" {
            returner usann
        }
        hvis tekst(data["tests"]) != "backend,appcontainer,network,schannel_tls13,iocp,filesystem,argon2id,acme_sign,acme_verify" {
            returner usann
        }
        la commit = forventa_commit()
        hvis ikkje gyldig_commit(commit) eller tekst(data["source_commit"]) != commit { returner usann }
        returner tekst(data["runtime_sha256"]) == fil_sha256(kandidat)
    } fang (e) { returner usann }
    returner usann
}

funksjon macos_attestasjon_ok(root: tekst, kandidat: tekst, attestasjon: tekst) -> boolsk {
    hvis attestasjon == "" eller ikkje executable(attestasjon) eller ikkje executable(kandidat) {
        returner usann
    }
    hvis ikkje verifiser_github_attestasjon(root, attestasjon) { returner usann }
    prøv {
        la data = builtin.json_parse_raw(builtin.fil_les(attestasjon))
        hvis tekst(data["schema"]) != "norscode-macos-runtime-attestation-v1" eller
           tekst(data["status"]) != "verified" eller tekst(data["platform"]) != "macos" eller
           tekst(data["architecture"]) != "arm64" eller
           tekst(data["repository"]) != "Norscode/Norscode" eller tekst(data["run_id"]) == "" {
            returner usann
        }
        hvis tekst(data["tests"]) != "native_selftest,macho_codesign,native_aot,seatbelt_sandbox,tls13" {
            returner usann
        }
        la commit = forventa_commit()
        hvis ikkje gyldig_commit(commit) eller tekst(data["source_commit"]) != commit { returner usann }
        returner tekst(data["runtime_sha256"]) == fil_sha256(kandidat)
    } fang (e) { returner usann }
    returner usann
}

funksjon linux_attestasjon_ok(root: tekst, kandidat: tekst, attestasjon: tekst,
                              arkitektur: tekst) -> boolsk {
    hvis attestasjon == "" eller ikkje executable(attestasjon) eller ikkje executable(kandidat) {
        returner usann
    }
    hvis ikkje verifiser_github_attestasjon(root, attestasjon) { returner usann }
    prøv {
        la data = builtin.json_parse_raw(builtin.fil_les(attestasjon))
        hvis tekst(data["schema"]) != "norscode-linux-runtime-attestation-v1" eller
           tekst(data["status"]) != "verified" eller tekst(data["platform"]) != "linux" eller
           tekst(data["architecture"]) != arkitektur eller
           tekst(data["repository"]) != "Norscode/Norscode" eller tekst(data["run_id"]) == "" {
            returner usann
        }
        hvis tekst(data["tests"]) != "filesystem,process_seccomp,network_epoll,threads,argon2id,tls13" {
            returner usann
        }
        hvis ikkje gyldig_commit(tekst(data["probe_ncb_sha256"])) { returner usann }
        la commit = forventa_commit()
        hvis ikkje gyldig_commit(commit) eller tekst(data["source_commit"]) != commit { returner usann }
        returner tekst(data["runtime_sha256"]) == fil_sha256(kandidat) og har_embedded_ncb(kandidat)
    } fang (e) { returner usann }
    returner usann
}

funksjon rapporter(sti: tekst, ok_melding: tekst, warn_melding: tekst, sha_label: tekst) -> heiltall {
    hvis executable(sti) {
        linje(ok_melding)
        la hash = fil_sha256(sti)
        hvis hash != "" { linje("[INFO] " + sha_label + "=" + hash) }
    } ellers { linje(warn_melding) }
    returner 0
}

funksjon docker_gate(root: tekst, kandidat: tekst, platform: tekst) -> boolsk {
    hvis env("NORSCODE_VERIFY_LINUX_DOCKER") != "1" eller ikkje executable(kandidat) { returner usann }
    la native = native_executable(root)
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_LINUX_CANDIDATE": kandidat,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
    hvis platform != "" { miljø["NORSCODE_DOCKER_PLATFORM"] = platform }
    returner prosess.ok(prosess.køyr(native,
        ["run", "tools/linux_runtime_gap_docker_gate_v3603.no"], root, miljø, 1800000))
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la macos_dist = root + "/dist/norscode_native"
    la macos_stage0 = root + "/bootstrap/stage0/norscode-macos-arm64"
    la linux_candidate = env("NORSCODE_LINUX_CANDIDATE")
    hvis linux_candidate == "" {
        la v9646 = root + "/build/v9646/norscode_native_linux_x86_64_embedded_payload"
        la v9630 = root + "/build/v9630/norscode_native_linux_x86_64_embedded"
        la portable = root + "/build/v3600/linux/norscode_native_linux_x86_64_v3605_zigargon"
        hvis executable(v9646) { linux_candidate = v9646 }
        ellers hvis executable(v9630) { linux_candidate = v9630 }
        ellers hvis executable(portable) { linux_candidate = portable }
        ellers { linux_candidate = root + "/build/v3600/linux/norscode_native_linux_x86_64_v3602" }
    }
    la linux_arm64_candidate = env("NORSCODE_LINUX_ARM64_CANDIDATE")
    hvis linux_arm64_candidate == "" { linux_arm64_candidate = root + "/build/v9646/norscode_native_linux_aarch64_embedded_payload" }
    hvis ikkje executable(linux_arm64_candidate) {
        linux_arm64_candidate = root + "/build/v9630/norscode_native_linux_aarch64_embedded"
        hvis ikkje executable(linux_arm64_candidate) {
            linux_arm64_candidate = root + "/build/v3600/linux/norscode_native_linux_aarch64_v3608_zigargon"
        }
    }
    la linux_stage0 = root + "/bootstrap/stage0/norscode-linux-x86_64"
    la linux_arm64_stage0 = root + "/bootstrap/stage0/norscode-linux-arm64"
    la windows_stage0 = root + "/bootstrap/stage0/norscode-windows-x86_64.exe"
    la windows_candidate = root + "/build/v9646/norscode_native_windows_x86_64_embedded_payload.exe"
    hvis ikkje executable(windows_candidate) {
        windows_candidate = root + "/build/v9630/norscode_native_windows_x86_64_embedded.exe"
        hvis ikkje executable(windows_candidate) {
            windows_candidate = root + "/build/windows/norscode_native_windows_x86_64.exe"
        }
    }
    la macos_candidate = env("NORSCODE_MACOS_CANDIDATE")
    hvis macos_candidate == "" { macos_candidate = macos_dist }
    la macos_attestasjon = env("NORSCODE_MACOS_ATTESTATION")
    la krev_macos_attestasjon = env("NORSCODE_REQUIRE_MACOS_ATTESTATION") == "1"
    la linux_x86_attestasjon = env("NORSCODE_LINUX_X86_64_ATTESTATION")
    la linux_arm64_attestasjon = env("NORSCODE_LINUX_ARM64_ATTESTATION")
    la krev_linux_attestasjon = env("NORSCODE_REQUIRE_LINUX_ATTESTATION") == "1"
    la windows_attestasjon = env("NORSCODE_WINDOWS_ATTESTATION")
    la krev_windows_attestasjon = env("NORSCODE_REQUIRE_WINDOWS_ATTESTATION") == "1"
    la host_os = systemfelt("system")
    hvis host_os == "" { host_os = systemfelt("os") }
    la macos_ready = "false"
    hvis har_embedded_ncb(macos_candidate) og
       macos_attestasjon_ok(root, macos_candidate, macos_attestasjon) { macos_ready = "true" }
    la linux_x86_attestert = "false"
    hvis linux_attestasjon_ok(root, linux_candidate, linux_x86_attestasjon, "x86_64") {
        linux_x86_attestert = "true"
    }
    la linux_arm64_attestert = "false"
    hvis linux_attestasjon_ok(root, linux_arm64_candidate, linux_arm64_attestasjon, "arm64") {
        linux_arm64_attestert = "true"
    }
    la linux_docker_ready = "false"
    hvis docker_gate(root, linux_candidate, "linux/amd64") { linux_docker_ready = "true" }
    la linux_arm64_docker_ready = "false"
    hvis docker_gate(root, linux_arm64_candidate, "linux/arm64") { linux_arm64_docker_ready = "true" }
    la windows_ready = "false"
    hvis windows_attestasjon_ok(root, windows_candidate, windows_attestasjon) { windows_ready = "true" }

    linje("== v3600 platform readiness ==")
    rapporter(macos_dist, "[OK] macOS dist finst: dist/norscode_native", "[WARN] macOS dist manglar eller er ikkje køyrbar", "macOS dist sha256")
    hvis har_embedded_ncb(macos_dist) { linje("[OK] macOS dist har innebygd NCB-image") }
    ellers { linje("[PENDING] macOS dist manglar innebygd NCB-image") }
    rapporter(macos_stage0, "[OK] macOS stage0 finst: bootstrap/stage0/norscode-macos-arm64", "[WARN] macOS stage0 manglar eller er ikkje køyrbar", "macOS stage0 sha256")
    hvis har_embedded_ncb(macos_stage0) { linje("[OK] macOS stage0 har innebygd NCB-image") }
    ellers { linje("[PENDING] macOS stage0 manglar innebygd NCB-image") }

    hvis executable(linux_candidate) {
        linje("[OK] Linux x86_64-kandidat finst: " + linux_candidate)
        hvis har_embedded_ncb(linux_candidate) { linje("[OK] Linux x86_64-kandidat har innebygd NCB-image") }
        ellers { linje("[PENDING] Linux x86_64-kandidat manglar innebygd NCB-image") }
        la hash = fil_sha256(linux_candidate)
        hvis hash != "" { linje("[INFO] Linux candidate sha256=" + hash) }
    } ellers {
        linje("[PENDING] Linux x86_64-kandidat manglar.")
        linje("[INFO] Køyr: ./bin/nc run tools/build_linux_cross_candidate_v3602.no eller tools/build_linux_zig_argon_candidate_v3606.no")
    }
    hvis executable(linux_arm64_candidate) {
        linje("[OK] Linux ARM64-kandidat finst: " + linux_arm64_candidate)
        hvis har_embedded_ncb(linux_arm64_candidate) { linje("[OK] Linux ARM64-kandidat har innebygd NCB-image") }
        ellers { linje("[PENDING] Linux ARM64-kandidat manglar innebygd NCB-image") }
        la hash = fil_sha256(linux_arm64_candidate)
        hvis hash != "" { linje("[INFO] Linux ARM64 candidate sha256=" + hash) }
        hvis linux_arm64_docker_ready == "true" { linje("[OK] Linux ARM64 runtime-gap køyrd i Docker") }
    } ellers { linje("[PENDING] Linux ARM64-kandidat manglar.") }

    rapporter(linux_stage0, "[OK] Linux x86_64 stage0 finst: bootstrap/stage0/norscode-linux-x86_64", "[PENDING] Linux x86_64 stage0 manglar.", "Linux stage0 sha256")
    hvis har_embedded_ncb(linux_stage0) { linje("[OK] Linux x86_64 stage0 har innebygd NCB-image") }
    ellers { linje("[PENDING] Linux x86_64 stage0 manglar innebygd NCB-image") }
    rapporter(linux_arm64_stage0, "[OK] Linux ARM64 stage0 finst: bootstrap/stage0/norscode-linux-arm64", "[PENDING] Linux ARM64 stage0 manglar.", "Linux ARM64 stage0 sha256")
    hvis har_embedded_ncb(linux_arm64_stage0) { linje("[OK] Linux ARM64 stage0 har innebygd NCB-image") }
    ellers { linje("[PENDING] Linux ARM64 stage0 manglar innebygd NCB-image") }
    rapporter(windows_stage0, "[OK] Windows x86_64 stage0 finst: bootstrap/stage0/norscode-windows-x86_64.exe", "[PENDING] Windows x86_64 stage0 manglar.", "Windows stage0 sha256")
    hvis har_embedded_ncb(windows_stage0) { linje("[OK] Windows stage0 har innebygd NCB-image") }
    ellers { linje("[PENDING] Windows stage0 manglar innebygd NCB-image") }
    rapporter(windows_candidate, "[OK] Windows x86_64 cross-linka kandidat finst", "[PENDING] Windows x86_64-kandidat manglar.", "Windows candidate sha256")
    hvis har_embedded_ncb(windows_candidate) { linje("[OK] Windows-kandidat har innebygd NCB-image") }
    ellers { linje("[PENDING] Windows-kandidat manglar innebygd NCB-image") }

    linje("")
    linje("production_ready_macos=" + macos_ready)
    hvis macos_ready == "true" { linje("macos_reason=github_signed_real_macos_execution_attestation") }
    ellers { linje("macos_reason=requires_real_macos_execution_attestation") }
    hvis linux_x86_attestert == "true" {
        linje("production_ready_linux_x86_64=true")
        linje("reason=github_signed_real_linux_x86_64_execution_attestation")
    } ellers hvis linux_docker_ready == "true" {
        linje("production_ready_linux_x86_64=true")
        linje("reason=linux_docker_runtime_gap_verified")
    } ellers hvis builtin.contains(host_os, "linux") og runtime_smoke(root, linux_candidate) {
        linje("production_ready_linux_x86_64=true")
        linje("reason=linux_host_execution_verified")
    } ellers {
        linje("production_ready_linux_x86_64=false")
        hvis builtin.contains(host_os, "linux") { linje("reason=linux_candidate_selftest_failed") }
        ellers { linje("reason=linux_candidate_cross_compiled_but_execution_requires_linux_host") }
    }
    linje("production_ready_linux_arm64=" + linux_arm64_attestert)
    hvis linux_arm64_attestert == "true" { linje("linux_arm64_reason=github_signed_real_linux_arm64_execution_attestation") }
    ellers { linje("linux_arm64_reason=requires_real_linux_arm64_execution_attestation") }
    hvis macos_ready == "true" og linux_x86_attestert == "true" og linux_arm64_attestert == "true" {
        linje("production_ready_unix=true")
    } ellers { linje("production_ready_unix=false") }
    linje("production_ready_windows=" + windows_ready)
    hvis windows_ready == "true" { linje("windows_reason=github_signed_real_windows_execution_attestation") }
    ellers { linje("windows_reason=requires_real_windows_execution_attestation") }
    hvis macos_ready == "true" og linux_x86_attestert == "true" og
       linux_arm64_attestert == "true" og windows_ready == "true" {
        linje("production_ready_all_platforms=true")
    } ellers { linje("production_ready_all_platforms=false") }
    linje("[SAFE] Ingen filer vart endra.")
    hvis krev_windows_attestasjon og windows_ready != "true" {
        linje("[FAIL] Windows-attestasjon er påkravd, men ikkje verifisert.")
        returner 2
    }
    hvis krev_macos_attestasjon og macos_ready != "true" {
        linje("[FAIL] macOS-attestasjon er påkravd, men ikkje verifisert.")
        returner 2
    }
    hvis krev_linux_attestasjon og (linux_x86_attestert != "true" eller linux_arm64_attestert != "true") {
        linje("[FAIL] Linux x86_64/ARM64-attestasjon er påkravd, men ikkje verifisert.")
        returner 2
    }
    returner 0
}
