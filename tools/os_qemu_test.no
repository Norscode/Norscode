// tools/os_qemu_test.no — bootar eit Norscode OS-bilete i QEMU og kontrollerer resultatet.
//
//   ./bin/nc run tools/os_qemu_test.no
//
// Miljø (alle valfrie):
//   OS_BILETE          bilete (standard build/os/norscode_os.img)
//   OS_MINNE           QEMU -m (standard 256M)
//   OS_VENTA           tekst som må finnast i seriell-utdata (standard «Hei frå Norscode OS»)
//   OS_VENTA_KODE      kjerne-exitkode (standard 0 → QEMU-status 1)
//   OS_TIDSGRENSE_MS   hard tidsgrense (standard 300000); QEMU blir drepen ved overskriding
//   OS_QEMU            sti til qemu-system-x86_64 (elles PATH)
//   OS_SERIE_INN       tekst til gjesten sin COM1 («\n» = linjeskift); slår på -serial mon:stdio
//   OS_TASTAR          mellomromsdelte QEMU-tastenamn for monitoren sin sendkey (t.d.
//                      «shift-h e i ret»); blir sende etter at seriell-teksten er motteken
// Returnerer 0 ved bestått, 1 ved feil, 2 når QEMU manglar.

bruk os.boot.byggjar som byggjar
bruk os.boot.qemu som qemu

funksjon standard(namn: tekst, verdi: tekst) -> tekst {
    la v = byggjar.miljø(namn)
    hvis v == "" { returner verdi }
    returner v
}

funksjon start() -> heiltall {
    la root = byggjar.rot()
    la q = qemu.finn_qemu()
    hvis q == "" {
        skriv("[os_qemu_test] qemu-system-x86_64 manglar (set OS_QEMU eller installer QEMU)\n")
        returner 2
    }
    la bilete = byggjar.abs_sti(root, standard("OS_BILETE", "build/os/norscode_os.img"))
    la minne = standard("OS_MINNE", "256M")
    la venta = standard("OS_VENTA", "Hei frå Norscode OS")
    la venta_kode = heltall_fra_tekst(standard("OS_VENTA_KODE", "0"))
    la grense = heltall_fra_tekst(standard("OS_TIDSGRENSE_MS", "300000"))
    la stamme = bilete
    hvis builtin.ends_with(stamme, ".img") { stamme = builtin.slice(stamme, 0, lengde(stamme) - 4) }
    skriv("[os_qemu_test] " + q + " -kernel " + bilete + " -m " + minne + "\n")
    la serie_inn = builtin.replace(byggjar.miljø("OS_SERIE_INN"), "\\n", builtin.chr(10))
    la tastar: liste_tekst = []
    for t i builtin.split(byggjar.miljø("OS_TASTAR"), " ") {
        hvis builtin.trim(t) != "" { legg_til(tastar, builtin.trim(t)) }
    }
    la r = {}
    hvis serie_inn != "" eller lengde(tastar) > 0 {
        skriv("[os_qemu_test] inndata: " + tekst(lengde(serie_inn)) + " seriell-byte, " + tekst(lengde(tastar)) + " tastar (-serial mon:stdio)\n")
        r = qemu.køyr_med_inndata(q, bilete, minne, grense, serie_inn, tastar, stamme + ".debugcon.txt")
        fil_skriv(stamme + ".serie.txt", r["serie"])
        fil_skriv(stamme + ".stdout.txt", r["stdout"])
    } ellers {
        r = qemu.køyr(q, bilete, minne, grense, stamme + ".serie.txt", stamme + ".debugcon.txt")
    }
    skriv("[os_qemu_test] status=" + r["status"] + " qemu=" + r["qemu_kode"] + " kjerne=" + r["kjerne_kode"] + " (" + r["ms"] + " ms)\n")
    skriv("----- seriell (COM1) -----\n" + r["serie"])
    hvis ikkje builtin.ends_with(r["serie"], "\n") { skriv("\n") }
    skriv("----- debugcon (0xE9) -----\n" + r["debugcon"])
    hvis ikkje builtin.ends_with(r["debugcon"], "\n") { skriv("\n") }
    la ok = sann
    hvis r["status"] != "ferdig" {
        skriv("[os_qemu_test] FEIL: QEMU vart ikkje ferdig (" + r["status"] + ")\n")
        ok = usann
    }
    hvis heltall_fra_tekst(r["kjerne_kode"]) != venta_kode {
        skriv("[os_qemu_test] FEIL: kjerne-exitkode " + r["kjerne_kode"] + ", venta " + tekst(venta_kode) + "\n")
        ok = usann
    }
    hvis builtin.index_of(r["serie"], venta) < 0 {
        skriv("[os_qemu_test] FEIL: fann ikkje «" + venta + "» i seriell-utdata\n")
        ok = usann
    }
    hvis ok {
        skriv("[os_qemu_test] OK\n")
        returner 0
    }
    returner 1
}
