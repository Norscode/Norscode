// Prosessfri binærdiff og SHA-256-rapport for bootstrap.

bruk std.filops som filops
bruk std.sha256 som sha256

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon hash_fil(sti: tekst) -> tekst {
    prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon første_forskjellar(sti_a: tekst, sti_b: tekst, maks: heiltall) -> tekst {
    la a = builtin.fil_les_binær(sti_a)
    la b = builtin.fil_les_binær(sti_b)
    la min_lengd = lengde(a)
    hvis lengde(b) < min_lengd { min_lengd = lengde(b) }
    la out = ""
    la funne = 0
    la i = 0
    mens i < min_lengd og funne < maks {
        hvis a[i] != b[i] {
            out = out + tekst_fra_heltall(i) + " " + tekst_fra_heltall(a[i]) + " " + tekst_fra_heltall(b[i]) + "\n"
            funne = funne + 1
        }
        i = i + 1
    }
    hvis funne < maks og lengde(a) != lengde(b) {
        out = out + "length " + tekst_fra_heltall(lengde(a)) + " " + tekst_fra_heltall(lengde(b)) + "\n"
    }
    hvis out == "" { returner "No byte differences found\n" }
    returner out
}

funksjon analyser(build_a: tekst, build_b: tekst, report: tekst) -> bool {
    hvis ikkje filops.fil_finnes(build_a) eller ikkje filops.fil_finnes(build_b) { returner usann }
    hvis ikkje filops.lag_katalogar(filops.katalog(report)) { returner usann }
    la hash_a = hash_fil(build_a)
    la hash_b = hash_fil(build_b)
    la body = "=== Norscode Bootstrap Diff Analyzer ===\n\nBuild A: " + build_a + "\nBuild B: " + build_b + "\n\nHash A: " + hash_a + "\nHash B: " + hash_b + "\n\n"
    hvis hash_a == hash_b {
        body = body + "Bootstrap outputs are deterministic\n"
    } ellers {
        body = body + "Bootstrap mismatch detected\n\nFirst binary differences:\n" +
            første_forskjellar(build_a, build_b, 50)
    }
    builtin.fil_skriv(report, body)
    returner sann
}

funksjon start() -> heiltall {
    la build_a = env("NORSCODE_BUILD_A")
    la build_b = env("NORSCODE_BUILD_B")
    hvis build_a == "" eller build_b == "" {
        linje("Usage: NORSCODE_BUILD_A=<build_a> NORSCODE_BUILD_B=<build_b> ./bin/nc run tools/bootstrap_diff_analyzer.no")
        returner 1
    }
    hvis ikkje filops.fil_finnes(build_a) {
        linje("Missing build artifact: " + build_a)
        returner 1
    }
    hvis ikkje filops.fil_finnes(build_b) {
        linje("Missing build artifact: " + build_b)
        returner 1
    }

    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la report = root + "/reports/bootstrap_diff_report.txt"
    hvis ikkje analyser(build_a, build_b, report) { returner 1 }
    linje("Bootstrap diff report written to: " + report)
    returner 0
}
