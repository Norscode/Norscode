// tools/differensial_sele.no — Omgang 2 (AOT-masterplan): differensial-sele.
//
// Køyrer eit program BÅDE via VM-tolk (`vm.køyr_ncb`) og AOT-native
// (`bygg-native` + køyr binæren), og samanliknar returverdien. For AOT er
// returverdien exit-koden (0–255). Skil dei seg → codegen har eit avvik frå
// tolk-orakelet, og selen feilar. Dette er verifiseringsverktøyet som gjer
// codegen-fiksar (t.d. Omgang 1 null-tryggleik) etterprøvbare.
//
// Bruk:
//   NORSCODE_ENABLE_EXEC_PROSESS=1 \
//   NORSCODE_VM_CAPABILITIES=env.read,process.exec,disk.read,disk.write \
//   NORSCODE_VM_DISK_ROOT="$PWD,.,/tmp,/private/tmp" \
//   NORSCODE_DIFF_FILE=<fil.no> ./bin/nc run tools/differensial_sele.no
//
// MERK: testar codegen i den KØYRANDE seeden. For å teste kjelde-codegen må
// seeden vere rebygd frå kjelde (fixpunkt/CI). Exit-kode-samanlikninga dekker
// heiltal 0–255; utvid til stdout-samanlikning ved behov.

bruk selfhost.vm som vm
bruk tools.process_runner som prosess
bruk std.filops som filops

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon aot_target() -> tekst {
    // Overstyr via NORSCODE_DIFF_TARGET; standard linux-x86_64 (CI-verten).
    // Unngår builtin.system_info som ikkje finst i committa stage0-seed.
    la t = env("NORSCODE_DIFF_TARGET")
    hvis t != "" { returner t }
    returner "linux-x86_64"
}

funksjon vel_native(root: tekst) -> tekst {
    // Vel éin gong for begge sider. Eit eksplisitt val skal feile om binæren
    // manglar, ikkje stille falle tilbake til ein annan runtime i dist.
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" {
        prøv { native = tekst(builtin.system_info()["executable"]) } fang (e) {}
    }
    // Eldre stage0 manglar system_info; behald CLI-fallback berre der.
    hvis native == "" { native = root + "/bin/nc" }
    ellers hvis ikkje builtin.starts_with(native, "/") {
        hvis builtin.starts_with(native, "./") { native = builtin.slice(native, 2, lengde(native)) }
        native = root + "/" + native
    }
    returner native
}

funksjon native_miljø(root: tekst, native: tekst) -> ordbok {
    returner {
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_ROOT": root,
        "NORSCODE_NATIVE_BIN": native,
        "NC_NATIVE": native,
        // Kandidaten kan ha eit anna filnamn enn norscode_native. Masker
        // orkestratorens kommando òg når process_runner ikkje kjenner namnet.
        "NORSCODE_CMD": "", "NORSCODE_FILE": "", "NORSCODE_OUTPUT": "",
        "NORSCODE_RUN_CMD": "", "NORSCODE_RUN_FILE": "",
        // CLI compile skal alltid levere JSON med same entry som tolkeorakelet,
        // uavhengig av format-/modulval i foreldreprosessen.
        "NORSCODE_NCB_BINARY": "0", "NORSCODE_MODULE": "__main__",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
}

// ARM-codegen har ikkje builtin.kompiler_fil. Kandidaten sin native CLI har
// kompilatoren, og compile bind òg importane før vm.køyr_ncb. Dette unngår å
// importere og tolke heile selfhost.kompiler inne i differensialverktøyet.
funksjon køyr_tolk(root: tekst, native: tekst, src_sti: tekst, dir: tekst) -> ordbok {
    la ut = dir + "/tolk.ncb.json"
    la bygg = {}
    prøv {
        bygg = prosess.køyr(native, ["compile", src_sti, ut], root,
            native_miljø(root, native), 600000)
    } fang (e) {
        returner { "ok": "usann", "steg": "compile", "feil": tekst(e) }
    }
    hvis ikkje prosess.ok(bygg) {
        returner { "ok": "usann", "steg": "compile", "res": bygg }
    }
    hvis ikkje builtin.fil_finnes(ut) {
        returner { "ok": "usann", "steg": "compile-output", "res": bygg,
            "feil": "Kandidaten skreiv ikkje NCB-fila " + ut }
    }
    prøv {
        la ncb = builtin.json_parse_raw(builtin.fil_les(ut))
        returner { "ok": "sann", "exit": vm.køyr_ncb(ncb) }
    } fang (e) {
        returner { "ok": "usann", "steg": "vm.køyr_ncb", "feil": tekst(e) }
    }
}

funksjon køyr_aot(root: tekst, native: tekst, src_sti: tekst,
                  target: tekst, dir: tekst) -> ordbok {
    la ut = dir + "/aot_bin"
    la bygg = prosess.køyr(native,
        ["bygg-native", "--target", target, src_sti, ut], root,
        native_miljø(root, native), 600000)
    hvis ikkje prosess.ok(bygg) {
        returner { "ok": "usann", "steg": "bygg-native", "res": bygg }
    }
    la kjor = prosess.køyr(ut, [], root, {}, 120000)
    hvis tekst(kjor["status"]) != "ferdig" {
        returner { "ok": "usann", "steg": "køyr", "res": kjor }
    }
    returner { "ok": "sann", "exit": kjor["exit_code"], "res": kjor }
}

funksjon samanlikn(root: tekst, native: tekst, fil: tekst,
                   target: tekst, dir: tekst) -> heiltall {
    skriv("[differensial] " + fil + " (target " + target + ")\n")
    skriv("  kandidat = " + native + "\n")

    la tolkesvar = køyr_tolk(root, native, fil, dir)
    hvis tekst(tolkesvar["ok"]) != "sann" {
        skriv("  [FEIL] NCB-steget feila ved " + tekst(tolkesvar["steg"]) + "\n")
        hvis finnes_nøkkel(tolkesvar, "res") {
            la res = tolkesvar["res"]
            skriv("  status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) + "\n")
            prosess.skriv_resultat(res)
            hvis finnes_nøkkel(res, "error") { skriv(tekst(res["error"]) + "\n") }
        }
        hvis finnes_nøkkel(tolkesvar, "feil") { skriv(tekst(tolkesvar["feil"]) + "\n") }
        // Utan eit tolkeorakel kan heller ikkje diagnostikk-modus samanlikne.
        returner 1
    }
    la tolk = heltall_fra_tekst(tekst(tolkesvar["exit"]))
    skriv("  tolk (vm.køyr_ncb) = " + tekst(tolk) + "\n")

    // Diagnostikk-modus (standard): rapporter avvik men blokker ikkje CI, fordi
    // AOT enno ikkje er ved paritet (det er heile poenget med omgangane). Sett
    // NORSCODE_DIFF_STRICT=1 for å feile ved avvik (målretta verifisering).
    la strikt = env("NORSCODE_DIFF_STRICT") == "1"

    // NORSCODE_DIFF_EXPECT=<n>: tolken må òg gje n (mod 256). VM-en i seeden er sjølv
    // AOT-kompilert, so ein codegen-feil kan slå likt ut på begge sider (common mode):
    // på seeden før aotfloat gav diff_desimal_tekst 108 i tolken — «tolk == AOT» åleine hadde
    // sleppt gjennom om AOT òg gav 108. Fiksturar med fasit (exit 42) set denne.
    // AOT-sida køyrer likevel, so loggen viser begge.
    la fasit_brot = usann
    la venta_tekst = env("NORSCODE_DIFF_EXPECT")
    hvis venta_tekst != "" {
        hvis (tolk % 256) != heltall_fra_tekst(venta_tekst) {
            skriv("  [FEIL] tolken gav " + tekst(tolk) + ", fasit er " + venta_tekst + "\n")
            fasit_brot = sann
        }
    }

    la aot = køyr_aot(root, native, fil, target, dir)
    hvis tekst(aot["ok"]) != "sann" {
        skriv("  [FEIL] AOT-steget feila ved " + tekst(aot["steg"]) + "\n")
        prosess.skriv_resultat(aot["res"])
        hvis strikt { returner 1 }
        returner 0
    }
    la aot_exit = heltall_fra_tekst(tekst(aot["exit"]))
    skriv("  AOT (bygg-native + køyr) = " + tekst(aot_exit) + "\n")

    hvis (tolk % 256) == aot_exit {
        hvis fasit_brot {
            skriv("  [FEIL] tolk == AOT, men begge avvik frå fasiten " + venta_tekst + "\n")
            hvis strikt { returner 1 }
            returner 0
        }
        skriv("  [OK] tolk == AOT\n")
        returner 0
    }
    skriv("  [AVVIK] tolk=" + tekst(tolk) + " (mod256=" + tekst(tolk % 256) +
          ") != AOT=" + tekst(aot_exit) + "\n")
    // Fiksturar rapporterer den konkrete sjekken på stdout. Ta med denne
    // diagnosen ved avvik, ikkje berre den pakka exit-koden.
    prosess.skriv_resultat(aot["res"])
    hvis strikt { returner 1 }
    skriv("  (diagnostikk-modus: avvik rapportert, blokkerer ikkje CI. " +
          "Sett NORSCODE_DIFF_STRICT=1 for streng.)\n")
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la fil = env("NORSCODE_DIFF_FILE")
    hvis fil == "" { skriv("Feil: sett NORSCODE_DIFF_FILE=<fil.no>\n") returner 2 }
    la target = aot_target()
    hvis target == "" { skriv("Feil: ingen AOT-target for denne verten\n") returner 2 }
    la native = vel_native(root)
    // Parallelle testbarn må aldri lese eller overskrive kvarandre sitt NCB/AOT.
    la dir = root + "/build/diff/run-" + builtin.random_hex(12)
    la kode = 1
    prøv {
        hvis ikkje filops.lag_katalogar(dir) { kast "klarte ikkje lage " + dir }
        kode = samanlikn(root, native, fil, target, dir)
    } fang (e) {
        skriv("  [FEIL] differensial: " + tekst(e) + "\n")
    }
    hvis ikkje filops.slett_tre(dir) {
        skriv("  [FEIL] klarte ikkje rydde " + dir + "\n")
        returner 1
    }
    returner kode
}
