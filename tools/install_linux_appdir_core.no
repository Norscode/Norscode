// tools/install-linux-appdir.no — prosessfri installasjon av Linux AppDir

bruk std.path som path
bruk std.sha256 som sha256_bytes
bruk std.tarfile som tarfile
bruk std.filops som filops
bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon abs_sti(root: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner root + "/" + sti
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon sha256_for(sti: tekst) -> tekst {
    prøv { returner sha256_bytes.hash_bytes(builtin.fil_les_binær(sti)) }
    fang (e) { returner "" }
    returner ""
}

funksjon rydd(sti: tekst) -> bool {
    hvis sti == "" eller sti == "/" eller sti == "." { returner usann }
    hvis ikkje fil_finst(sti) { returner sann }
    returner filops.slett_tre(sti)
}

funksjon sorter_tekst(verdiar: liste_tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(verdiar) {
        la pos = lengde(ut)
        la j = 0
        mens j < lengde(ut) {
            hvis verdiar[i] < ut[j] { pos = j j = lengde(ut) }
            ellers { j = j + 1 }
        }
        legg_til(ut, "")
        j = lengde(ut) - 1
        mens j > pos {
            ut[j] = ut[j - 1]
            j = j - 1
        }
        ut[pos] = verdiar[i]
        i = i + 1
    }
    returner ut
}

funksjon finn_appdir(stage_dir: tekst, venta_namn: tekst) -> tekst {
    la venta = stage_dir + "/" + venta_namn + ".AppDir"
    hvis filops.katalog_finnes(venta) { returner venta }
    la barn = sorter_tekst(filops.lista_katalog(stage_dir))
    la i = 0
    mens i < lengde(barn) {
        la kandidat = stage_dir + "/" + barn[i]
        hvis builtin.ends_with(barn[i], ".AppDir") og filops.katalog_finnes(kandidat) {
            returner kandidat
        }
        i = i + 1
    }
    returner ""
}

funksjon prefix_relativ(prefix: tekst) -> tekst {
    hvis ikkje builtin.starts_with(prefix, "/") eller lengde(prefix) <= 1 { returner "" }
    returner builtin.slice(prefix, 1, lengde(prefix))
}

funksjon installer(archive_path_inn: tekst, prefix_inn: tekst, root_inn: tekst) -> heiltall {
    la root = root_inn
    hvis root == "" { root = "." }
    la archive_path = archive_path_inn
    la prefix = prefix_inn
    hvis prefix == "" { prefix = env("HOME") + "/.local/opt/norscode-app" }

    hvis archive_path == "" {
        linje("Feil: manglar Linux AppDir-tarball")
        returner 1
    }
    archive_path = abs_sti(root, archive_path)
    prefix = abs_sti(root, prefix)
    la prefix_rel = prefix_relativ(prefix)
    hvis prefix_rel == "" {
        linje("Feil: installasjonsprefix må vere ei absolutt mappe under /")
        returner 1
    }
    hvis ikkje fil_finst(archive_path) {
        linje("Feil: manglar Linux AppDir-tarball: " + archive_path)
        returner 1
    }

    hvis fil_finst(archive_path + ".sha256") {
        la expected = builtin.trim(builtin.fil_les(archive_path + ".sha256"))
        la actual = sha256_for(archive_path)
        hvis actual == "" eller expected != actual {
            linje("Feil: SHA256-avvik for " + archive_path)
            returner 1
        }
    }

    la version_name = path.basename(archive_path)
    hvis builtin.ends_with(version_name, ".tar.gz") {
        version_name = builtin.slice(version_name, 0, lengde(version_name) - 7)
    }
    la install_root = prefix + "/versions"
    la target_dir = install_root + "/" + version_name
    la bin_dir = prefix + "/bin"
    la staging_root = prefix + "/.staging"

    hvis ikkje filops.lag_katalogar(install_root) eller
       ikkje filops.lag_katalogar(bin_dir) eller
       ikkje filops.lag_katalogar(staging_root) {
        linje("Feil: klarte ikkje lage installasjonsmapper")
        returner 1
    }
    la stage = native_fs.native_tempområde(staging_root, "appdir-")
    hvis stage["status"] != "created" {
        linje("Feil: klarte ikkje lage Norscode-eigd stagingområde")
        returner 1
    }
    la stage_dir = staging_root + "/" + stage["relative"]

    hvis ikkje tarfile.extractall_enkel(archive_path, stage_dir) {
        rydd(stage_dir)
        linje("Feil: klarte ikkje pakke ut AppDir i Norscode")
        returner 1
    }
    la appdir = finn_appdir(stage_dir, version_name)
    hvis appdir == "" {
        rydd(stage_dir)
        linje("Feil: fann ikkje AppDir i tarballen")
        returner 1
    }

    hvis fil_finst(target_dir) og ikkje rydd(target_dir) {
        rydd(stage_dir)
        linje("Feil: klarte ikkje rydde eksisterande versjonsmappe")
        returner 1
    }
    hvis ikkje filops.kopier_tre(appdir, target_dir) {
        rydd(target_dir)
        rydd(stage_dir)
        linje("Feil: klarte ikkje materialisere AppDir")
        returner 1
    }
    hvis ikkje fil_finst(target_dir + "/AppRun") {
        rydd(target_dir)
        rydd(stage_dir)
        linje("Feil: AppDir manglar AppRun")
        returner 1
    }

    la current = native_fs.native_erstatt_symbolsk_lenke(
        "/", prefix_rel + "/current", "versions/" + version_name)
    hvis current["status"] != "ok" {
        rydd(stage_dir)
        linje("Feil: klarte ikkje publisere aktiv versjonslenke: " + tekst(current["error"]))
        returner 1
    }
    la launcher = native_fs.native_erstatt_symbolsk_lenke(
        "/", prefix_rel + "/bin/norscode-app", "../current/AppRun")
    hvis launcher["status"] != "ok" {
        rydd(stage_dir)
        linje("Feil: klarte ikkje publisere launcherlenke: " + tekst(launcher["error"]))
        returner 1
    }
    rydd(stage_dir)

    linje("Installert Linux AppDir: " + target_dir)
    linje("Aktiv lenke: " + prefix + "/current")
    linje("Launcher: " + bin_dir + "/norscode-app")
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    returner installer(env("NORSCODE_LINUX_APPDIR_ARCHIVE"),
                       env("NORSCODE_LINUX_APPDIR_PREFIX"), root)
}
