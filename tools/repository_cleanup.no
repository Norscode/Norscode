// tools/repository_cleanup.no — shell-fri opprydding av vanlege artefaktar

bruk std.filops som filops
bruk tools.repository_cleanup_core som cleanup

funksjon start() -> heiltall {
    la root = ""
    prøv { root = miljo_hent("NORSCODE_ROOT") } fang (e) {}
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    skriv("Cleaning repository artifacts...\n")
    la sletta = cleanup.rydd(filops.absolutt_sti(root), usann)
    hvis sletta < 0 {
        skriv("Cleanup refused or failed: root must be a repository with norcode.toml.\n")
        returner 1
    }
    skriv("Cleanup complete. Removed " + tekst(sletta) + " artifact entries.\n")
    returner 0
}
