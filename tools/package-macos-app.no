// tools/package-macos-app.no — pakk lokal macOS app-bundle

bruk std.filops som filops
bruk std.tempfile som tempfile
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim(t: tekst) -> tekst {
    returner builtin.trim(t)
}

funksjon run(executable: tekst, argv: liste_tekst, cwd: tekst) -> bool {
    la res = prosess.køyr(executable, argv, cwd, {}, 600000)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon mappe_finst(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon toml_version_fra_innhald(innhald: tekst) -> tekst {
    la linjer = builtin.split(innhald, "\n")
    la i = 0
    mens i < lengde(linjer) {
        la line = trim(linjer[i])
        hvis builtin.starts_with(line, "version") {
            la delar = builtin.split(line, "\"")
            hvis lengde(delar) >= 3 { returner trim(delar[1]) }
        }
        i = i + 1
    }
    returner ""
}

funksjon repo_version(root: tekst) -> tekst {
    la toml = root + "/norcode.toml"
    hvis fil_finst(toml) {
        la v = toml_version_fra_innhald(builtin.fil_les(toml))
        hvis v != "" { returner v }
    }
    returner "1.0"
}

funksjon basename_app(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    la namn = ""
    la i = lengde(delar) - 1
    mens i >= 0 og namn == "" {
        hvis delar[i] != "" { namn = delar[i] }
        i = i - 1
    }
    hvis builtin.ends_with(namn, ".app") {
        returner builtin.slice(namn, 0, lengde(namn) - 4)
    }
    returner namn
}

funksjon sha256_skriv(sti: tekst) -> bool {
    prøv {
        la sha = builtin.sha256_bytes(builtin.fil_les_binær(sti))
        hvis sha == "" { returner usann }
        builtin.fil_skriv(sti + ".sha256", sha + "\n")
        returner sann
    } fang (e) {
        returner usann
    }
}

funksjon package_zip(root: tekst, app_path: tekst, zip_path: tekst) -> bool {
    hvis ikkje run("/usr/bin/ditto", ["-c", "-k", "--sequesterRsrc", "--keepParent", app_path, zip_path], root) { returner usann }
    hvis ikkje sha256_skriv(zip_path) { returner usann }
    linje("Bygde ZIP-artefakt: " + zip_path)
    returner sann
}

funksjon package_dmg(root: tekst, app_path: tekst, dmg_path: tekst, stage_dir: tekst, app_basename: tekst, vol_name: tekst) -> bool {
    la dmg_src_dir = stage_dir + "/dmg-root"
    la tmp_dmg = stage_dir + "/" + app_basename + ".dmg"
    hvis ikkje filops.lag_katalogar(dmg_src_dir) { returner usann }
    hvis ikkje filops.kopier_tre(app_path, dmg_src_dir + "/" + app_basename + ".app") { returner usann }
    hvis ikkje run("/bin/ln", ["-s", "/Applications", dmg_src_dir + "/Applications"], root) { returner usann }
    hvis ikkje run("/usr/bin/hdiutil", ["create", "-volname", vol_name, "-srcfolder", dmg_src_dir, "-ov", "-format", "UDZO", tmp_dmg], root) {
        linje("Merk: DMG-bygging feila via hdiutil, ZIP-artefakt kan framleis brukast.")
        returner usann
    }
    hvis ikkje filops.flytt(tmp_dmg, dmg_path) { returner usann }
    hvis ikkje sha256_skriv(dmg_path) { returner usann }
    linje("Bygde DMG-artefakt: " + dmg_path)
    returner sann
}

funksjon package_pkg(root: tekst, app_path: tekst, pkg_path: tekst, stage_dir: tekst, version: tekst) -> bool {
    la pkg_root_dir = stage_dir + "/pkg-root"
    la install_root = pkg_root_dir + "/Applications"
    hvis ikkje filops.lag_katalogar(install_root) { returner usann }
    hvis ikkje filops.kopier_tre(app_path, install_root + "/" + basename_app(app_path) + ".app") { returner usann }
    hvis ikkje run("/usr/bin/pkgbuild", ["--root", pkg_root_dir, "--identifier", "dev.norscode.app.pkg", "--version", version, "--install-location", "/", pkg_path], root) { returner usann }
    hvis ikkje sha256_skriv(pkg_path) { returner usann }
    linje("Bygde PKG-artefakt: " + pkg_path)
    returner sann
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la app_path = env("NORSCODE_MACOS_PACKAGE_APP")
    hvis app_path == "" { app_path = root + "/build/macos-app/Norscode.app" }
    la format = env("NORSCODE_MACOS_PACKAGE_FORMAT")
    hvis format == "" { format = "all" }
    la version = env("NORSCODE_MACOS_PACKAGE_VERSION")
    hvis version == "" { version = repo_version(root) }
    la release_dir = env("NORSCODE_MACOS_PACKAGE_RELEASE_DIR")
    hvis release_dir == "" { release_dir = root + "/release-artifacts" }
    la host_os = env("NORSCODE_HOST_OS")
    hvis host_os == "" { host_os = tekst(info["system"]) }

    hvis builtin.lower(host_os) != "darwin" {
        linje("Feil: package-macos-app krev macOS.")
        returner 1
    }
    hvis ikkje mappe_finst(app_path) {
        hvis ikkje run(root + "/bin/nc", ["build-macos-app", "--mode", "gui", "--version", version], root) { returner 1 }
    }
    hvis ikkje mappe_finst(app_path) {
        linje("Feil: manglar app-bundle: " + app_path)
        returner 1
    }
    hvis ikkje run("/usr/bin/plutil", ["-lint", app_path + "/Contents/Info.plist"], root) { returner 1 }

    hvis ikkje filops.lag_katalogar(release_dir) { returner 1 }
    la app_basename = basename_app(app_path)
    la zip_path = release_dir + "/" + app_basename + "-macos-" + version + ".zip"
    la dmg_path = release_dir + "/" + app_basename + "-macos-" + version + ".dmg"
    la pkg_path = release_dir + "/" + app_basename + "-macos-" + version + ".pkg"
    la temp_obj = tempfile.ny_tempkatalog("norscode_macos_package_")
    la stage_dir = tempfile.sti(temp_obj)
    la vol_name = app_basename + " " + version

    filops.slett_fil(zip_path)
    filops.slett_fil(zip_path + ".sha256")
    filops.slett_fil(dmg_path)
    filops.slett_fil(dmg_path + ".sha256")
    filops.slett_fil(pkg_path)
    filops.slett_fil(pkg_path + ".sha256")

    hvis format == "zip" {
        hvis package_zip(root, app_path, zip_path) {
            tempfile.lukk(temp_obj)
            returner 0
        }
        tempfile.lukk(temp_obj)
        returner 1
    }
    hvis format == "dmg" {
        hvis package_dmg(root, app_path, dmg_path, stage_dir, app_basename, vol_name) {
            tempfile.lukk(temp_obj)
            returner 0
        }
        tempfile.lukk(temp_obj)
        returner 1
    }
    hvis format == "pkg" {
        hvis package_pkg(root, app_path, pkg_path, stage_dir, version) {
            tempfile.lukk(temp_obj)
            returner 0
        }
        tempfile.lukk(temp_obj)
        returner 1
    }
    hvis format == "both" eller format == "all" {
        hvis ikkje package_zip(root, app_path, zip_path) {
            tempfile.lukk(temp_obj)
            returner 1
        }
        package_dmg(root, app_path, dmg_path, stage_dir, app_basename, vol_name)
        hvis ikkje package_pkg(root, app_path, pkg_path, stage_dir, version) {
            tempfile.lukk(temp_obj)
            returner 1
        }
        tempfile.lukk(temp_obj)
        returner 0
    }

    tempfile.lukk(temp_obj)
    linje("Feil: ugyldig format " + format + " (bruk zip, dmg, pkg eller all)")
    returner 1
}
