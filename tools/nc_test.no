// tools/nc_test.no — Norscode-native testløpar
//
// Denne fila eig testval, skip-reglar, køyring og rapportering. Wrapperen gir
// berre miljøverdiane NORSCODE_ROOT, NC_NATIVE, TESTS_DIR og eventuell
// NC_TEST_FILE.

bruk std.liste som liste
bruk std.filops som filops
bruk std.runtime.process_abi som process_abi
bruk std.runtime_filesystem som native_fs
bruk std.sha256 som sha256

// Cachetilstanden blir oppretta i start_konfigurert og sendt eksplisitt.
// Dermed er testløparen uavhengig av modulglobal initialisering også på eldre
// committed stage0-ar, utan å miste innhaldscachen i kvar shardprosess.

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon native_argv() -> liste_tekst {
    // Eldre kandidat-VM-ar kan mangle argv_operation sjølv om alle
    // testparametrar er eksplisitt bundne i miljøet. Denne fail-closed modusen
    // gjer ingen argv-sondering; normal CLI-prioritet er uendra utan flagget.
    hvis env("NORSCODE_NO_ARGV") == "1" { returner [] }
    prøv {
        la svar = builtin.argv_operation({"abi": "norscode-argv-v1", "operation": "get"})
        hvis svar["status"] == "ok" { returner svar["argv"] }
    } fang (e) {}
    returner []
}

funksjon argv_verdi(namn: tekst) -> tekst {
    la args = native_argv()
    la i: heiltall = 0
    mens i + 1 < lengde(args) {
        hvis args[i] == namn { returner tekst(args[i + 1]) }
        i = i + 1
    }
    returner ""
}

funksjon konfig(namn: tekst, argv_namn: tekst) -> tekst {
    la frå_argv = argv_verdi(argv_namn)
    hvis frå_argv != "" { returner frå_argv }
    returner env(namn)
}

funksjon tekst_ein() -> tekst {
    returner builtin.slice("x1", 1, 2)
}

funksjon tekst_null() -> tekst {
    returner builtin.slice("x0", 1, 2)
}

funksjon tekst_tretti() -> tekst {
    returner builtin.slice("x30", 1, 3)
}

funksjon tekst_sakte_timeout() -> tekst {
    returner builtin.slice("x600", 1, 4)
}

funksjon tekst_normal_timeout() -> tekst {
    returner builtin.slice("x180", 1, 4)
}

funksjon tekst_pure_timeout() -> tekst {
    la konfigurert = env("PURE_TEST_TIMEOUT")
    hvis konfigurert != "" { returner konfigurert }
    returner builtin.slice("x600", 1, 4)
}

funksjon ok(res: liste_tekst) -> bool {
    returner tekst(res[0]) == tekst_null()
}

funksjon rydd_runtime() -> heiltall {
    prøv { builtin.gc_collect() } fang (e) { }
    returner 0
}

funksjon trim_tekst(t: tekst) -> tekst {
    returner trim(t)
}

funksjon finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon fil_hash(sti: tekst) -> tekst {
    hvis ikkje finst(sti) { returner "missing" }
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) }
    fang (e) {
        prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) }
        fang (e2) { returner "unreadable" }
    }
    returner "unreadable"
}

funksjon hash_tekst(data: tekst) -> tekst {
    prøv { returner builtin.sha256(data) }
    fang (e) { returner sha256.hash(data) }
    returner sha256.hash(data)
}

funksjon legg_kjelde_filer(root: tekst, relativ: tekst, ut: liste_tekst) -> heiltall {
    la listing = native_fs.native_list(root, relativ)
    hvis listing["status"] != "ok" {
        // Testorkestratorane påverkar ikkje generert NCB. Dei skal ikkje
        // ugyldiggjere heile innhaldscachen når berre shard-/lane-policy blir
        // endra.
        hvis relativ != "tools/nc_test.no" og relativ != "tools/nc_test_parallel.no" og
           finst(root + "/" + relativ) {
            legg_til(ut, relativ)
        }
        returner 0
    }
    la barn = builtin.split(listing["data"], "\n")
    la i: heiltall = 0
    mens i < lengde(barn) {
        la namn = builtin.trim(barn[i])
        hvis namn != "" {
            la sti = namn
            hvis relativ != "" { sti = relativ + "/" + namn }
            legg_kjelde_filer(root, sti, ut)
        }
        i = i + 1
    }
    returner 0
}

funksjon compiler_cache_abi() -> tekst {
    returner "norscode-test-cache-v4|norscode-bytecode-v1|selfhost-compiler-0.31|runtime-library-abi-v1"
}

funksjon cached_fil_hash(cache, sti: tekst) -> tekst {
    hvis finnes_nøkkel(cache, "fil:" + sti) {
        returner cache["fil:" + sti]
    }
    la verdi = fil_hash(sti)
    cache["fil:" + sti] = verdi
    returner verdi
}

funksjon import_filstiar(cache, root: tekst, sti: tekst, kjelde: tekst) -> liste_tekst {
    hvis finnes_nøkkel(cache, "import:" + sti) {
        returner cache["import:" + sti]
    }
    la resultat: liste_tekst = []
    la linjer = builtin.split(kjelde, "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la linje = builtin.trim(linjer[i])
        la rest = ""
        hvis builtin.starts_with(linje, "bruk ") {
            rest = builtin.trim(builtin.slice(linje, 5, lengde(linje)))
        } ellers hvis builtin.starts_with(linje, "importer ") {
            rest = builtin.trim(builtin.slice(linje, 9, lengde(linje)))
        }
        hvis rest != "" {
            hvis builtin.ends_with(rest, ";") { rest = builtin.slice(rest, 0, lengde(rest) - 1) }
            la som_idx = builtin.index_of(rest, " som ")
            hvis som_idx >= 0 { rest = builtin.trim(builtin.slice(rest, 0, som_idx)) }
            la basis = root + "/" + builtin.replace(rest, ".", "/")
            la kandidat = basis + ".nors"
            hvis ikkje finst(kandidat) { kandidat = basis + ".no" }
            hvis finst(kandidat) { legg_til(resultat, kandidat) }
        }
        i = i + 1
    }
    cache["import:" + sti] = resultat
    returner resultat
}

funksjon compiler_implementation_key(cache, root: tekst, hybrid: tekst) -> tekst {
    la cache_nøkkel = root + "|" + hybrid
    hvis finnes_nøkkel(cache, "compiler:" + cache_nøkkel) {
        returner cache["compiler:" + cache_nøkkel]
    }
    // Bytekodeprodusenten blir bunden til dei konkrete compiler-eigarane,
    // utan å dra heile runtime-/verktøygrafen inn i kvar test-shard.
    la filer = builtin.split(
        absolutt_fil(root, hybrid) + "\n" +
        root + "/selfhost/lexer/lexer_m1.no\n" +
        root + "/selfhost/parser.no\n" +
        root + "/selfhost/compiler/semantic.no\n" +
        root + "/selfhost/compiler/ir_to_bytecode.no\n" +
        root + "/selfhost/kompiler.no\n" +
        root + "/selfhost/json.no\n" +
        root + "/selfhost/bundler.no\n" +
        root + "/selfhost/vm.no",
        "\n"
    )
    la manifest = compiler_cache_abi() + "\n"
    la i: heiltall = 0
    mens i < lengde(filer) {
        hvis finst(filer[i]) { manifest = manifest + filer[i] + ":" + cached_fil_hash(cache, filer[i]) + "\n" }
        i = i + 1
    }
    la nøkkel = hash_tekst(manifest)
    cache["compiler:" + cache_nøkkel] = nøkkel
    returner nøkkel
}

funksjon dependency_key(cache, root: tekst, fil: tekst) -> tekst {
    la startfil = absolutt_fil(root, fil)
    hvis finnes_nøkkel(cache, "dependency:" + startfil) {
        returner cache["dependency:" + startfil]
    }
    la kø: liste_tekst = []
    legg_til(kø, startfil)
    la besøkt = {}
    la manifest = compiler_cache_abi() + "\n"
    la indeks: heiltall = 0
    mens indeks < lengde(kø) {
        la sti = kø[indeks]
        indeks = indeks + 1
        hvis finnes_nøkkel(besøkt, sti) { fortsett }
        besøkt[sti] = sann
        hvis ikkje finst(sti) { fortsett }
        manifest = manifest + sti + ":" + cached_fil_hash(cache, sti) + "\n"
        la imports = import_filstiar(cache, root, sti, fil_les(sti))
        la i: heiltall = 0
        mens i < lengde(imports) {
            hvis ikkje finnes_nøkkel(besøkt, imports[i]) { legg_til(kø, imports[i]) }
            i = i + 1
        }
    }
    la nøkkel = hash_tekst(manifest)
    cache["dependency:" + startfil] = nøkkel
    returner nøkkel
}

funksjon test_cache_key(cache, root: tekst, fil: tekst, hybrid: tekst, native: tekst) -> tekst {
    // Runtime-kandidaten køyrer alltid den cachelagra NCB-en på nytt. Bytecode
    // skal derfor ugyldiggjerast av innhald og compiler-ABI, ikkje av mtime
    // eller storleiken til runtime-binæren.
    returner hash_tekst(
        compiler_cache_abi() + "|" + fil_hash(fil) + "|" +
        compiler_implementation_key(cache, root, hybrid) + "|" + dependency_key(cache, root, fil)
    )
}

funksjon executable(sti: tekst) -> bool {
    returner finst(sti)
}

funksjon basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) == 0 { returner sti }
    returner delar[lengde(delar) - 1]
}

funksjon absolutt_fil(root: tekst, fil: tekst) -> tekst {
    hvis builtin.starts_with(fil, "/") { returner fil }
    returner root + "/" + fil
}

funksjon fjern_suffiks(verdi: tekst, suffiks: tekst) -> tekst {
    hvis suffiks != "" og builtin.ends_with(verdi, suffiks) {
        returner builtin.slice(verdi, 0, lengde(verdi) - lengde(suffiks))
    }
    returner verdi
}

funksjon dirname(sti: tekst) -> tekst {
    la slutt = lengde(sti) - 1
    mens slutt > 0 og builtin.slice(sti, slutt, slutt + 1) == "/" { slutt = slutt - 1 }
    mens slutt >= 0 {
        hvis builtin.slice(sti, slutt, slutt + 1) == "/" {
            hvis slutt == 0 { returner "/" }
            returner builtin.slice(sti, 0, slutt)
        }
        slutt = slutt - 1
    }
    returner "."
}

funksjon absolutt_native(root: tekst, native: tekst) -> tekst {
    hvis builtin.starts_with(native, "/") { returner native }
    hvis builtin.starts_with(native, "./") {
        returner root + "/" + builtin.slice(native, 2, lengde(native))
    }
    returner root + "/" + native
}

funksjon køyr_native(root: tekst, native: tekst, miljø: ordbok_tekst,
                      timeout: tekst) -> liste_tekst {
    la sekund = til_tal_eller(timeout, 180)
    hvis sekund <= 0 { sekund = 180 }
    la executable = absolutt_native(root, native)
    la req = process_abi.request(executable, [], root, "", sekund * 1000, 8388608)
    // Store selfhost-importtestar kan passere 2 GiB i kald kompilering. Dette
    // er ei hard øvre tryggleiksgrense, ikkje eit ytingsmål; minneporten må
    // framleis drive talet ned i fase 6. Hybrid-bundle-compile av testar som
    // importerer selfhost.native_execution.* toppar ~8.8 GB på committed seed →
    // NC_TEST_MEMORY_BYTES let 16 GB-Linux-slow-lanen heve taket (macOS-verten har
    // 7 GB og held 8 GiB — der er det ærleg «compile-steg: memory limit»).
    la minne: heiltall = 8589934592
    la minne_env = env("NC_TEST_MEMORY_BYTES")
    hvis minne_env != "" {
        la m = til_tal_eller(minne_env, 0)
        hvis m >= 1073741824 { minne = m }
    }
    process_abi.sett_sandbox(req, "none", minne, 128, sann)
    process_abi.sett_environment(req, miljø)
    prøv {
        la svar = builtin.process_spawn_argv(req)
        la status = tekst(svar["status"])
        la kode = til_tal_eller(tekst(svar["exit_code"]), -1)
        hvis status == "timeout" { kode = 124 }
        la feil = tekst(svar["stderr"])
        hvis feil == "" og finnes_nøkkel(svar, "error") { feil = tekst(svar["error"]) }
        hvis feil == "" og status != "ferdig" { feil = "prosessstatus: " + status }
        returner [tekst_fra_heiltall(kode), tekst(svar["stdout"]), feil]
    } fang (e) {
        returner ["-1", "", "native spawn_argv feila: " + tekst(e)]
    }
    returner ["-1", "", "native spawn_argv manglar"]
}

// kompilator_fast_modus: compile-steget (compile_with_hybrid_bundle_v9400) køyrer med
// NORSCODE_VM_FAST=1. VM_FAST=0 (full skyggeheap/bokhald) er meint for TESTPROGRAMMET
// som blir køyrt etterpå — kompilatoren er verktøy. Stage-0-drivaren gjer det same
// for Gen1-kjeldekompileringane (kjeldefragment_miljø). På fersk GC-seed var bokhaldet
// (100k+ nøklar per map, per-byte-allokering) det som gjorde compile-steget kvadratisk
// og GC-tungt; NCB-utdata er identisk i begge modus.
funksjon runtime_miljø(root: tekst) -> ordbok_tekst {
    // Den native rekursjonsvakta har ei låg default (256). Legitime djupe
    // e2e-kjeder (test → orm → db → norsdb → sql → motor → btre) treff ~257
    // og feilar (jf. test_admin_relations/auth/domenehost/helpdesk/storage_restore
    // + norsdb-motoren si B-tre-rekursjon). Barn arvar ikkje foreldre-env her,
    // så vi må binde grensa eksplisitt. Foreldre-env kan overstyre.
    // Seed-runtimen (nc_exec_call i legacy C-main) godtek BERRE 32..16384; alt utanfor
    // fell STILLE tilbake til 256 (1000000 var difor = 256 → «For djup rekursjon …
    // grense=256» i norsdb-testane). Teljar-unntaket er FANGBART; det som er ufangbart
    // er den ekte stakk-veggen: seed-VM-rammene er tunge — test_security (uendeleg
    // rekursjon) gjev SIGSEGV ved 1536 på Linux-seed (2048 OK på macOS-seed), 1024 er
    // OK på begge. 1024 er difor det portable taket. Foreldre-env kan overstyre.
    // (norsdb-motoren sin B-tre-rekursjon går >2048 djupt på seed-VM-en → dei e2e-
    // testane krev betre seed, ikkje høgare tal.)
    la maxdjupn = env("NORSCODE_NATIVE_MAX_DEPTH")
    hvis maxdjupn == "" { maxdjupn = "1024" }
    returner {
        "TMPDIR": "/tmp",
        "NORSCODE_VM_FAST": "0",
        "NORSCODE_RUN_DIRECT_HOST": "0",
        "NORSCODE_HOST_NCB_FILE": "",
        "NORSCODE_NCB_FILE": "",
        "NORSCODE_VM_SOURCE": "0",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_NATIVE_MAX_DEPTH": maxdjupn,
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    }
}

funksjon sett_target_policy(miljø: ordbok_tekst, capabilities: tekst,
                            disk_root: tekst) -> ordbok_tekst {
    miljø["NORSCODE_VM_CAPABILITIES"] = capabilities
    miljø["NORSCODE_VM_REQUESTED_POLICY"] = "1"
    miljø["NORSCODE_VM_REQUESTED_CAPABILITIES"] = capabilities
    miljø["NORSCODE_VM_REQUESTED_DISK_ROOT"] = disk_root
    returner miljø
}

funksjon test_namn(sti: tekst) -> tekst {
    returner fjern_suffiks(basename(sti), ".no")
}

funksjon lik(namn: tekst, verdiar: liste_tekst) -> bool {
    la i: heiltall = 0
    mens i < lengde(verdiar) {
        hvis namn == verdiar[i] { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon ny_state() -> ordbok_tekst {
    la s: ordbok_tekst = {}
    s["pass"] = "0"
    s["fail"] = "0"
    s["skip"] = "0"
    s["total"] = "0"
    returner s
}

funksjon hent_tal(s: ordbok_tekst, nøkkel: tekst) -> heiltall {
    returner builtin.heltall_fra_tekst(s[nøkkel])
}

funksjon auk(s: ordbok_tekst, nøkkel: tekst) -> heiltall {
    la verdi = hent_tal(s, nøkkel) + 1
    s[nøkkel] = tekst_fra_heltall(verdi)
    returner verdi
}

funksjon startar_med_ein(namn: tekst, verdiar: liste_tekst) -> bool {
    la i: heiltall = 0
    mens i < lengde(verdiar) {
        hvis builtin.starts_with(namn, verdiar[i]) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon er_tung_sjølvhost(namn: tekst) -> bool {
    hvis namn == "test_chunk_2000.no" { returner sann }
    hvis namn == "test_chunk_end.no" { returner sann }
    hvis namn == "test_chunk_full.no" { returner sann }
    hvis namn == "test_chunk_tail.no" { returner sann }
    hvis namn == "test_selfhost.no" { returner sann }
    // Codegen/chunk/native-build-familiar (>90s kvar, målt) høyrer heime i slow-
    // lanen ("Slow tests chunk/selfhost"), ikkje i fast-lane-shardane der dei
    // brenn 60s-per-test-timeouten og får shardane til å timeoute på 1t. Berre
    // BEKREFTA-trege familiar — test_compiler_*/bundle_*/embed_* er blanda (mange
    // 2s), difor ikkje prefiks-klassifiserte; native-build-variantane deira
    // fangast av _native_live-suffikset.
    hvis builtin.starts_with(namn, "test_chunk_") { returner sann }
    hvis builtin.starts_with(namn, "test_arm64_") { returner sann }
    hvis builtin.starts_with(namn, "test_elf_arm64_") { returner sann }
    hvis builtin.starts_with(namn, "test_macho_arm64_") { returner sann }
    hvis builtin.starts_with(namn, "test_linux_arm64_") { returner sann }
    hvis builtin.contains(namn, "_native_live") { returner sann }
    // Codegen/compiler/bundle/bootstrap-familiar: dei fleste kompilerer store
    // bundlar / køyr codegen og tek titals sekund. Nokre få (t.d. test_compiler_
    // builtin_alias_normalization=2s) er raske og blir over-klassifisert hit, men
    // slow-lanen er parallellisert (4 shards) og absorberer dei billeg — medan
    // uklassifiserte trege codegen-testar brenn 60s-timeouten i fast-lanen.
    hvis builtin.starts_with(namn, "test_compiler_") { returner sann }
    hvis builtin.starts_with(namn, "test_kodegen_") { returner sann }
    hvis builtin.starts_with(namn, "test_l5b_") { returner sann }
    hvis builtin.starts_with(namn, "test_bundle_") { returner sann }
    hvis builtin.starts_with(namn, "test_bundler_") { returner sann }
    hvis builtin.starts_with(namn, "test_embed_") { returner sann }
    hvis builtin.starts_with(namn, "test_embedded_") { returner sann }
    hvis builtin.starts_with(namn, "test_generate_") { returner sann }
    hvis builtin.starts_with(namn, "test_bootstrap_") { returner sann }
    hvis builtin.starts_with(namn, "test_ir_") { returner sann }
    hvis builtin.starts_with(namn, "test_inject_") { returner sann }
    hvis builtin.starts_with(namn, "test_bytecode_") { returner sann }
    hvis builtin.starts_with(namn, "test_ncval_") { returner sann }
    hvis builtin.starts_with(namn, "test_ncb_") { returner sann }
    hvis builtin.starts_with(namn, "test_hybrid_") { returner sann }
    hvis builtin.starts_with(namn, "test_selfhost_") { returner sann }
    returner usann
}

funksjon er_slow(namn: tekst) -> bool {
    hvis er_tung_sjølvhost(namn) { returner sann }
    // returner er_tung_sjølvhost(namn)
    hvis namn == "test_chunk_2114.no" { returner sann }
    hvis namn == "test_api_advanced.no" { returner sann }
    hvis namn == "test_file_io_large.no" { returner sann }
    hvis namn == "test_thread_native_backend_lifecycle.no" { returner sann }
    hvis namn == "test_macho_arm64_aot_stdlib_cli.no" { returner sann }
    hvis namn == "test_runtime_memory_parallel_gc.no" { returner sann }
    hvis namn == "test_linux_arm64_aot_cli.no" { returner sann }
    hvis namn == "test_macho_arm64_aot_common_runtime.no" { returner sann }
    hvis namn == "test_native_module_globals_codegen.no" { returner sann }
    returner usann
}

// Testar som importerer den tunge vm-kjeda (std.db/admin/norsdb/orm → bruk
// selfhost.vm) tek >2min på module-load (selfhost.vm er ikkje i stdlib-cachen)
// og heng dermed fast test-parallel sin 60s per-test-timeout. Klassifiser dei
// som slow slik at dei køyrer i slow-suiten (med romsleg timeout) i staden for
// å blokkere fast-lane-shardane. Les fila; feil-fritt fallback til usann.
funksjon _tung_modulnamn(modul: tekst) -> bool {
    // db/admin/norsdb/orm → bruk selfhost.vm (>2min module-load, uncachbar).
    // media/ai/neural → tung ML-compute. selfhost.vm sjølv = kjelda til hengen.
    returner builtin.starts_with(modul, "std.db") eller
             builtin.starts_with(modul, "std.admin") eller
             builtin.starts_with(modul, "std.norsdb") eller
             builtin.starts_with(modul, "std.orm") eller
             builtin.starts_with(modul, "std.media_") eller
             builtin.starts_with(modul, "std.ai_") eller
             // Store nettverks-/web-modular (~5-13s compile kvar) — testar som
             // når dei brenn fast-lane-timeouten. Slow-lanen (parallellisert)
             // absorberer dei; fast-lanen held berre trivielle unit-testar.
             builtin.starts_with(modul, "std.web") eller
             builtin.starts_with(modul, "std.http") eller
             builtin.starts_with(modul, "std.socket") eller
             builtin.starts_with(modul, "std.tls") eller
             builtin.starts_with(modul, "std.dns") eller
             builtin.starts_with(modul, "std.frontend") eller
             builtin.starts_with(modul, "std.deploy") eller
             builtin.starts_with(modul, "std.domenehost") eller
             builtin.starts_with(modul, "std.acme") eller
             modul == "selfhost.vm"
}

funksjon _bruk_modular(innhald: tekst) -> liste {
    la ut = []
    la linjer = builtin.split(innhald, "\n")
    la i = 0
    mens i < lengde(linjer) {
        la l = builtin.trim(linjer[i])
        hvis builtin.starts_with(l, "bruk ") {
            la rest = builtin.trim(builtin.slice(l, 5, lengde(l)))
            la sp = builtin.index_of(rest, " ")
            la modul = rest
            hvis sp >= 0 { modul = builtin.slice(rest, 0, sp) }
            legg_til(ut, modul)
        }
        i = i + 1
    }
    returner ut
}

funksjon _naar_tung(root: tekst, fil: tekst, visited: ordbok_tekst, depth: heiltall) -> bool {
    hvis depth > 8 { returner usann }
    hvis finnes_nøkkel(visited, fil) { returner usann }
    visited[fil] = "1"
    la innhald = ""
    prøv { innhald = builtin.fil_les(fil) } fang (e) { returner usann }
    la modular = _bruk_modular(innhald)
    la i = 0
    mens i < lengde(modular) {
        la m = modular[i]
        hvis _tung_modulnamn(m) { returner sann }
        la sti = root + "/" + builtin.replace(m, ".", "/") + ".no"
        hvis builtin.fil_finnes(sti) {
            hvis _naar_tung(root, sti, visited, depth + 1) { returner sann }
        }
        i = i + 1
    }
    returner usann
}

// Testar som TRANSITIVT når den tunge vm-kjeda (std.db/admin/norsdb/orm →
// bruk selfhost.vm) tek >2min på module-load (selfhost.vm er ikkje i stdlib-
// cachen) og heng fast test-parallel sin 60s per-test-timeout. Mange testar
// når kjeda via wrappers (bruk examples.db/examples.helpdesk), ikkje direkte —
// difor følgjer vi import-grafen. Klassifiser som slow. Feil-fritt → usann.
funksjon importerer_tung_db(fil: tekst, root: tekst) -> bool {
    prøv {
        hvis root == "" { root = env("NORSCODE_ROOT") }
        hvis root == "" { root = "." }
        // fil kan vere relativ til root i shard-konteksten; gjer absolutt.
        la mål = fil
        hvis ikkje builtin.starts_with(mål, "/") { mål = root + "/" + fil }
        la visited: ordbok_tekst = {}
        returner _naar_tung(root, mål, visited, 0)
    } fang (e) { returner usann }
    returner usann
}

funksjon er_native_unsupported(namn: tekst) -> bool {
    hvis env("NC_TEST_SKIP_OPTIONAL_NATIVE_CRYPTO") == "1" {
        hvis namn == "test_argon2_native.no" eller
           namn == "test_acme_sign_native.no" eller
           namn == "test_acme_verify_native.no" eller
           namn == "test_argon2id_differential_optional.no" { returner sann }
    }
    la system = ""
    prøv { system = tekst(builtin.system_info()["system"]) } fang (e) { }
    hvis builtin.starts_with(namn, "test_windows_") {
        returner ikkje builtin.starts_with(system, "Windows")
    }
    hvis namn == "test_linux_runtime_attestation_probe.no" eller
       namn == "test_linux_arm64_runtime_attestation_probe.no" {
        returner ikkje builtin.starts_with(system, "Linux")
    }
    hvis namn == "test_contains_any_runtime.no" {
        // Nyare kandidatar skal køyre den levande builtin-kontrakten. Eldre
        // committed stage0-ar manglar builtinen og får eit eksplisitt,
        // klassifisert kompatibilitetshopp i staden for tilfeldig VM-feil.
        prøv {
            returner lengde(builtin.contains_any("norscode", ["code"])) != 1
        } fang (e) { returner sann }
    }
    hvis namn == "test_vm_vent_sleep.no" {
        // Levande tidsport: seed-runtimen (stage0) hadde no-op vent.sov (x86-64-
        // codegen mangla nanosleep; macOS-ARM64 var eksplisitt no-op). Codegen er
        // fiksa (nanosleep #35 / poll #230), men committed seed søv ikkje før han
        // er regenerert → klassifisert hopp i staden for raud assert. Nyare
        // kandidatar som faktisk søv køyrer testen.
        prøv {
            la t0 = builtin.tid_ms()
            builtin.vent.sov(15)
            returner builtin.tid_ms() - t0 < 5
        } fang (e) { returner sann }
    }
    hvis namn == "test_unntakstypar.no" eller krev_ny_seed(namn) {
        // Kjende hol i dei COMMITTED stage0-seedane (VM/runtime eldre enn kjelda):
        // typa fang (unntakstypar «AXCD != ABCD»), filops/native_filesystem-ABI
        // (slett_tre, symlink, walk krev disk.write-scope), prosess-spawn/async,
        // json-flyttal («12.3»), språkparitet (grensesnitt/modul-globalar),
        // builtin.system_operation, bygg-artefakt-probar. Raude på main sidan #181;
        // fast-lanen hoppa dei berre på timeout til test-compile-cachen gjorde lanen
        // rask nok. Ein probe INNE i harnessen ser ikkje hola (harnessen er kompilert
        // av seeden sin eigen kompilator, testane av kjeldekompilatoren) → same
        // levande seed-diskriminator som vent_sleep: committed seedar søv ikkje,
        // kjeldebygde (regenererte) seedar gjer det → testane kjem automatisk att.
        prøv {
            la t0 = builtin.tid_ms()
            builtin.vent.sov(15)
            returner builtin.tid_ms() - t0 < 5
        } fang (e) { returner sann }
    }
    hvis krev_system_info(namn) {
        // Committed Linux-stage0 manglar builtin.system_info («Ukjent funksjon») —
        // 17 slow-lane-testar (native_live/arm64/auth-mfa/ci_shell_runner) kallar han
        // uguarda. Klassifisert hopp på runtimes utan builtinen (levande probe);
        // nyare kandidatar/regenerert seed køyrer testane som før.
        prøv {
            la info = builtin.system_info()
            returner info == null
        } fang (e) { returner sann }
    }
    hvis namn == "test_incremental_module_cache_live.no" {
        // Den levande cachetesten krev den atomiske file_replace-ABI-en som
        // kom saman med systeminfo-ABI-en. Committed stage0 manglar begge;
        // nyare kandidatar køyrer framleis testen og må bevise cachetreff.
        prøv {
            la info = builtin.system_info()
            returner info == null
        } fang (e) { returner sann }
    }
    returner usann
}

funksjon krev_ny_seed(namn: tekst) -> bool {
    la liste = "|test_filops_absolute_tmp_directory.no|test_filops_broken_symlink_cleanup.no|" +
        "test_filops_native.no|test_grensesnitt.no|test_json_invalid.no|" +
        "test_json_parse_raw_ncb_bool.no|test_linux_drift_contract.no|test_multiprocessing_native.no|" +
        "test_native_filesystem_mode_absolute_tmp.no|test_native_filesystem_symlink_live.no|" +
        "test_native_filesystem_walk_live.no|test_native_import_direct_module_contract.no|" +
        "test_native_module_globals_gate_contract.no|test_native_process_async.no|" +
        "test_native_process_spawn_argv.no|" +
        // bygg-native er argv-berre i nc_main; committed Linux-seed har ingen argv-
        // builtins (køyrer selftest → exit 0 utan binær). Krev regenerert seed.
        "test_linux_x86_64_aot_cli.no|" +
        // norsdb-motoren sin B-tre-rekursjon (_btre_i_orden) går djupare enn seed-VM-en
        // toler (1024/1536 → «For djup rekursjon»); fersk seed har native stakkvakt.
        "test_helpdesk_deployment_contract.no|"
    returner builtin.index_of(liste, "|" + namn + "|") >= 0
}

funksjon krev_system_info(namn: tekst) -> bool {
    la liste = "|test_arm64_ncval_heap.no|test_arm64_ncval_machine.no|test_arm64_skriv_int_aot.no|" +
        "test_native_cli_argument_environment.no|" +
        "test_auth_full_mfa_norsdb.no|test_auth_mfa_enrollment_recovery.no|" +
        "test_auth_persistent_guard_reauth.no|test_build_windows_app_layout_native_live.no|" +
        "test_ci_shell_runner.no|test_embed_release_ncb_idempotent.no|" +
        "test_install_linux_appdir_native_live.no|test_install_linux_desktop_entry_native_live.no|" +
        "test_install_macos_app_native_live.no|test_macho_arm64_aot_cli.no|" +
        "test_macho_arm64_aot_function_cli.no|test_macho_arm64_codegen.no|" +
        "test_macho_arm64_emitter.no|test_native_compile_cache_live.no|"
    returner builtin.index_of(liste, "|" + namn + "|") >= 0
}

funksjon er_native_direkte(namn: tekst) -> bool {
    returner namn == "test_security.no" eller namn == "test_stil.no" eller
        namn == "test_cli_maturity.no" eller
        namn == "test_macho_arm64_aot_common_runtime.no" eller
        namn == "test_incremental_module_cache_live.no"
}

funksjon er_pure_vm_test(fil: tekst, namn: tekst) -> bool {
    // Køyrelane må ikkje avgjerast av teksttreff i kommentarar eller
    // strengliteralar. Lista er den eksplisitte pure-VM-kontrakten og blir
    // kontrollert av testpolicyporten.
    la pure = "|test_runtime_profiler_api.no|test_runtime_stack_type_exception.no|" +
        "test_vm_callstack_exception_integration.no|test_vm_continuation_frames.no|" +
        "test_vm_continuation_host_error.no|test_vm_continuation_unwind.no|" +
        "test_vm_debugger_integration.no|test_vm_dynamic_continuation.no|" +
        "test_vm_dynamic_loader.no|test_vm_dynamic_loader_trust.no|" +
        "test_vm_dynamic_loader_unsigned.no|test_vm_gc_integration.no|test_vm_gc_root_dedup.no|" +
        "test_vm_host_object_isolation.no|test_vm_jit_denied.no|" +
        "test_vm_jit_float_integration.no|test_vm_jit_integration.no|" +
        "test_vm_jit_text_integration.no|test_vm_network_scope.no|" +
        "test_vm_plugin_capability_isolation.no|test_vm_process_scope.no|" +
        "test_vm_profiler_functions.no|test_vm_profiler_integration.no|" +
        "test_vm_reflection_symbol_table.no|test_vm_security_disk_absolute_scope.no|" +
        "test_vm_security_disk_scope.no|test_vm_security_enforcement.no|" +
        "test_vm_tailcall_trampoline.no|test_vm_type_registry.no|" +
        "test_ws_transport_loopback.no|test_https_front_live_multisite.no|" +
        "test_fjern_agent_signer.no|"
    returner builtin.index_of(pure, "|" + namn + "|") >= 0
}

funksjon pure_vm_policy(namn: tekst, root: tekst) -> ordbok_tekst {
    la p: ordbok_tekst = {
        "capabilities": "",
        "disk_root": ".",
        "net_scope": "",
        "process_scope": "",
        "trust_store": ""
    }
    hvis namn == "test_vm_profiler_integration.no" { p["capabilities"] = "disk.read" }
    hvis namn == "test_vm_host_object_isolation.no" { p["capabilities"] = "env.read,disk.read" }
    hvis namn == "test_vm_dynamic_loader.no" {
        p["capabilities"] = "disk.read"
        p["disk_root"] = "build"
        p["trust_store"] = "build/vm_trust.json"
    }
    hvis namn == "test_vm_plugin_capability_isolation.no" {
        p["capabilities"] = "disk.read"
        p["disk_root"] = "."
        p["trust_store"] = "build/vm_trust.json"
    }
    hvis namn == "test_vm_process_scope.no" {
        p["capabilities"] = "process.exec"
        p["process_scope"] = "/usr/bin/printf"
    }
    hvis namn == "test_vm_network_scope.no" {
        p["capabilities"] = "net.tcp"
        p["net_scope"] = "127.0.0.1"
    }
    hvis namn == "test_ws_transport_loopback.no" {
        p["capabilities"] = "net.tcp"
        p["net_scope"] = "127.0.0.1"
    }
    hvis namn == "test_https_front_live_multisite.no" {
        p["capabilities"] = "net.tcp,thread.spawn"
        p["net_scope"] = "127.0.0.1"
    }
    // test_fjern_agent_loopback.no er blokkert av runtime-socket-åtferd (sjå
    // docs/PRODUKSJON_HULL_PLAN.md M6) og er difor ikkje i pure-lista enno.
    // test_fjern_agent_signer.no dekker protokoll-logikken og treng ingen caps.
    hvis namn == "test_vm_jit_integration.no" eller namn == "test_vm_jit_float_integration.no" eller namn == "test_vm_jit_text_integration.no" {
        p["capabilities"] = "jit.execute"
    }
    hvis namn == "test_vm_security_disk_scope.no" {
        p["capabilities"] = "disk.read"
        p["disk_root"] = "docs"
    }
    hvis namn == "test_vm_security_disk_absolute_scope.no" {
        p["capabilities"] = "env.read,disk.read"
        p["disk_root"] = root + "/docs"
    }
    returner p
}

funksjon runtime_capabilities(namn: tekst) -> tekst {
    // CLI-argumentkontrakten verifiserer eksplisitt argv -> miljø-adapteren i
    // selfhost.nc_main. Berre denne testen skal få skrive miljøvariablar;
    // standardpolicyen for resten av testflata held fram utan env.write.
    hvis namn == "test_native_cli_argument_environment.no" eller
       namn == "test_incremental_module_cache_live.no" eller
       namn == "test_auth_full_mfa_norsdb.no" eller
       namn == "test_l5b_raw_bundler_metadata_filter.no" eller
       namn == "test_vm_fast_env_contract.no" eller
       namn == "test_typesjekk.no" {
        returner "env.read,env.write,process.exec,thread.spawn,net.tcp,net.dns,disk.read,disk.write,jit.execute"
    }
    returner "env.read,process.exec,thread.spawn,net.tcp,net.dns,disk.read,disk.write,jit.execute"
}

funksjon første_linje(t: tekst) -> tekst {
    la linjer = builtin.split(t, "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la l: tekst = trim_tekst(linjer[i])
        hvis l != "" og ikkje builtin.starts_with(l, "[nc-vm]") og ikkje builtin.starts_with(l, "[norscode]") {
            returner l
        }
        i = i + 1
    }
    returner ""
}

// Stille feil: ikkje-null exit (ikkje timeout 124) UTAN ei einaste byte på stdout/
// stderr. Ein ekte Norscode-feil skriv alltid «norscode: …»; stille exit er
// signaturen til ein barneprosess som døydde før runtime kom i gang (minne-/
// ressurspress på delte CI-vertar). Éin retry + logg skil transient frå ekte.
// Vent (ms) utan å stole på vent.sov (no-op på committed seedar): sov fyrst, og
// spinn på tid_ms for resten. Brukt berre for retry-pause etter stille exit.
funksjon vent_ms(ms: heiltall) -> heiltall {
    la t0 = builtin.tid_ms()
    prøv { builtin.vent.sov(ms) } fang (e) { }
    mens builtin.tid_ms() - t0 < ms { }
    returner 0
}

funksjon er_stille_feil(res: liste_tekst) -> bool {
    hvis lengde(res) < 3 { returner usann }
    hvis tekst(res[0]) == "0" eller tekst(res[0]) == "124" { returner usann }
    returner trim_tekst(tekst(res[1])) == "" og trim_tekst(tekst(res[2])) == ""
}

funksjon første_ikkje_tomme_linje(t: tekst) -> tekst {
    la linjer = builtin.split(t, "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la l: tekst = trim_tekst(linjer[i])
        hvis l != "" { returner l }
        i = i + 1
    }
    returner ""
}

funksjon res_tekst(res: liste_tekst) -> tekst {
    la out: tekst = ""
    hvis lengde(res) > 1 { out = out + res[1] }
    hvis lengde(res) > 2 { out = out + "\n" + res[2] }
    hvis out == "" og lengde(res) > 0 { out = "exit " + tekst(res[0]) }
    returner out
}

funksjon klargjer_vm_loader_fixture(root: tekst) -> heiltall {
    la namn = builtin.split("vm_plugin_v1.ncb.json\nvm_plugin_v2.ncb.json\nvm_plugin_disk.ncb.json\nvm_plugin_tampered.ncb.json\nvm_trust.json", "\n")
    la i: heiltall = 0
    mens i < lengde(namn) {
        la kjelde = root + "/tests/fixtures/vm_loader/" + namn[i]
        la mål = root + "/build/" + namn[i]
        fil_skriv(mål, fil_les(kjelde))
        i = i + 1
    }
    returner 0
}

funksjon køyr_test(state: ordbok_tekst, cache, fil: tekst, root: tekst, native: tekst, hybrid: tekst, timeout: tekst, tmpdir: tekst, cache_dir: tekst, slow_mode: bool) -> heiltall {
    la namn = basename(fil)
    hvis env("NC_TRACE_TESTS") == "1" { linje("[RUN] " + test_namn(fil)) }
    auk(state, "total")
    // NC_TEST_ALL=1 køyrer HEILE suiten (komplett dekning i den parallelliserte
    // slow-lanen) — ingen lane-filter-skip.
    hvis env("NC_TEST_FILE") == "" og env("NC_TEST_ALL") != tekst_ein() {
        la er_treg = er_slow(namn) eller importerer_tung_db(fil, root)
        hvis slow_mode og ikkje er_treg {
            auk(state, "skip")
            returner 0
        }
        hvis ikkje slow_mode og er_treg {
            auk(state, "skip")
            returner 0
        }
    }
    hvis er_native_unsupported(namn) {
        auk(state, "skip")
        hvis env("NC_VERBOSE") == "1" {
            la grunn = "native-unsupported"
            hvis env("NC_TEST_SKIP_OPTIONAL_NATIVE_CRYPTO") == "1" og
               (namn == "test_argon2_native.no" eller namn == "test_acme_sign_native.no" eller
                namn == "test_acme_verify_native.no" eller namn == "test_argon2id_differential_optional.no") {
                grunn = "optional-native-crypto-adapter"
            }
            linje("  SKIP " + test_namn(fil) + " (" + grunn + ")")
        }
        returner 0
    }
    hvis builtin.starts_with(namn, "test_vm_dynamic_loader") eller namn == "test_vm_plugin_capability_isolation.no" {
        klargjer_vm_loader_fixture(root)
    }

    la res: liste_tekst = []
    hvis er_native_direkte(namn) {
        la direkte_miljø = runtime_miljø(root)
        sett_target_policy(direkte_miljø, runtime_capabilities(namn), root + ",.,/tmp,/private/tmp")
        direkte_miljø["NORSCODE_CMD"] = "run"
        direkte_miljø["NORSCODE_FILE"] = absolutt_fil(root, fil)
        res = køyr_native(root, native, direkte_miljø, timeout)
    } ellers hvis er_pure_vm_test(fil, namn) {
        filops.lag_katalogar(tmpdir)
        la pure_ncb = tmpdir + "/pure-" + test_namn(fil) + ".ncb.json"
        la pure_compile = runtime_miljø(root)
        pure_compile["NORSCODE_VM_FAST"] = "1"   // kompilatoren er verktøy, ikkje testobjektet (sjå kompilator_fast_modus)
        pure_compile["NORSCODE_VM_CAPABILITIES"] = "env.read,process.exec,disk.read,disk.write"
        pure_compile["NORSCODE_NATIVE_BIN"] = absolutt_native(root, native)
        pure_compile["NORSCODE_HYBRID_ROOT"] = root
        pure_compile["NORSCODE_HYBRID_SRC"] = absolutt_fil(root, fil)
        pure_compile["NORSCODE_HYBRID_OUT"] = pure_ncb
        pure_compile["NORSCODE_HYBRID_MODULE"] = "__main__"
        pure_compile["NORSCODE_HYBRID_PROJECT_ROOT"] = root
        pure_compile["NORSCODE_CMD"] = "run"
        pure_compile["NORSCODE_FILE"] = hybrid
        la pure_comp = køyr_native(root, native, pure_compile, tekst_pure_timeout())
        hvis ikkje ok(pure_comp) {
            res = pure_comp
        } ellers {
            la policy = pure_vm_policy(namn, root)
            la pure_run = runtime_miljø(root)
            pure_run["NORSCODE_VM_REQUESTED_POLICY"] = "1"
            pure_run["NORSCODE_VM_REQUESTED_CAPABILITIES"] = policy["capabilities"]
            pure_run["NORSCODE_VM_REQUESTED_DISK_ROOT"] = policy["disk_root"]
            pure_run["NORSCODE_VM_REQUESTED_NET_SCOPE"] = policy["net_scope"]
            pure_run["NORSCODE_VM_REQUESTED_PROCESS_SCOPE"] = policy["process_scope"]
            pure_run["NORSCODE_VM_CAPABILITIES"] = "env.read,env.write,process.exec,thread.spawn,net.tcp,net.http,net.dns,disk.read,disk.write,jit.execute"
            pure_run["NORSCODE_VM_DISK_ROOT"] = root + ",.,/tmp,/private/tmp," + policy["disk_root"]
            pure_run["NORSCODE_VM_GC_THRESHOLD"] = env("NORSCODE_VM_GC_THRESHOLD")
            hvis pure_run["NORSCODE_VM_GC_THRESHOLD"] == "" { pure_run["NORSCODE_VM_GC_THRESHOLD"] = "16" }
            hvis policy["trust_store"] != "" { pure_run["NORSCODE_VM_TRUST_STORE"] = policy["trust_store"] }
            hvis namn == "test_vm_jit_integration.no" eller namn == "test_vm_jit_float_integration.no" eller namn == "test_vm_jit_text_integration.no" {
                pure_run["NORSCODE_VM_JIT_THRESHOLD"] = "2"
            }
            pure_run["NORSCODE_VM_NCB"] = root + "/bootstrap/precompiled/vm.ncb.json"
            pure_run["NORSCODE_CMD"] = "run"
            pure_run["NORSCODE_FILE"] = root + "/selfhost/tooling/ncb_host_run_entry.no"
            pure_run["NORSCODE_HOST_NCB_FILE"] = root + "/selfhost/vm_executor.ncb.json"
            pure_run["NORSCODE_NCB_FILE"] = pure_ncb
            pure_run["NORSCODE_VM_SOURCE"] = "1"
            pure_run["NORSCODE_VM_QUIET"] = "1"
            res = køyr_native(root, native, pure_run, tekst_pure_timeout())
        }
        filops.slett_fil(pure_ncb)
    } ellers hvis builtin.ends_with(hybrid, ".no") {
        // Ei eksplisitt enkeltfilkøyring skal ikkje bruke fleire minutt på å
        // hashe heile kjeldetreet før testen startar. Fullflata brukar cache
        // som før; enkeltfilcache er opt-in med NC_TEST_CACHE=1.
        la cache_val = env("NC_TEST_CACHE")
        la use_cache = cache_val != "0" og (env("NC_TEST_FILE") == "" eller cache_val == "1")
        la ncb = tmpdir + "/" + test_namn(fil) + ".ncb.json"
        la cache_ncb = cache_dir + "/" + test_namn(fil) + ".ncb.json"
        la cache_meta = cache_dir + "/" + test_namn(fil) + ".key"
        la key = test_cache_key(cache, root, fil, hybrid, native)
        la kompilert: bool = usann
        hvis use_cache og finst(cache_ncb) og finst(cache_meta) og trim(fil_les(cache_meta)) == key {
            ncb = cache_ncb
            kompilert = sann
        } ellers {
            hvis ikkje filops.lag_katalogar(tmpdir) {
                res = ["1", "", "klarte ikkje lage test-tempområde"]
            }
            hvis use_cache {
                hvis ikkje filops.lag_katalogar(cache_dir) {
                    res = ["1", "", "klarte ikkje lage testcache"]
                }
                // Bygg kandidaten i det prosess-/shard-eigde arbeidsområdet.
                // Eit felles `cache_ncb + ".tmp"` kolliderte når fleire
                // deterministiske shards kompilerte samstundes.
                ncb = tmpdir + "/cache-" + test_namn(fil) + ".ncb.json"
            }
            la absolutt_test = absolutt_fil(root, fil)
            la compile_miljø = runtime_miljø(root)
            compile_miljø["NORSCODE_VM_FAST"] = "1"   // kompilatoren er verktøy, ikkje testobjektet (sjå kompilator_fast_modus)
            compile_miljø["NORSCODE_VM_CAPABILITIES"] = runtime_capabilities(namn)
            compile_miljø["NORSCODE_NATIVE_BIN"] = absolutt_native(root, native)
            compile_miljø["NORSCODE_HYBRID_ROOT"] = root
            compile_miljø["NORSCODE_HYBRID_SRC"] = absolutt_test
            compile_miljø["NORSCODE_HYBRID_OUT"] = ncb
            compile_miljø["NORSCODE_HYBRID_MODULE"] = "__main__"
            compile_miljø["NORSCODE_HYBRID_PROJECT_ROOT"] = dirname(absolutt_test)
            compile_miljø["NORSCODE_CMD"] = "run"
            compile_miljø["NORSCODE_FILE"] = hybrid
            la comp = køyr_native(root, native, compile_miljø, timeout)
            la comp_retry: heiltall = 0
            mens ikkje ok(comp) og er_stille_feil(comp) og comp_retry < 2 {
                // Stille exit utan output frå compile-steget: vent litt (ressurs-
                // press ved shard-start) og prøv att, maks 2 gonger, alltid logga.
                comp_retry = comp_retry + 1
                linje("  [RETRY " + tekst(comp_retry) + "] " + test_namn(fil) + " compile-steg stille exit " + tekst(comp[0]))
                vent_ms(3000 * comp_retry)
                comp = køyr_native(root, native, compile_miljø, timeout)
            }
            hvis ikkje ok(comp) og er_stille_feil(comp) { comp[2] = "stille exit frå compile-steg (hybrid-bundle)" }
            hvis ikkje ok(comp) {
                // Compile-steget feila (t.d. status=feil/exit 126 = drepen på minne-
                // grensa 8 GiB — hybrid-bundle-compile av tunge codegen-importar toppar
                // 8.8 GB på seed). Barnet kan ha late etter seg ein AVKUTTA NCB; køyr
                // ALDRI vidare på han (gav «stille exit frå køyre-steg»).
                hvis lengde(comp) > 2 og trim_tekst(tekst(comp[2])) == "" { comp[2] = "compile-steg feila utan output" }
                comp[2] = "compile-steg: " + tekst(comp[2])
                res = comp
                filops.slett_fil(ncb)
            }
            kompilert = ok(comp)
            hvis ok(comp) og use_cache {
                filops.flytt(ncb, cache_ncb)
                la meta_kandidat = tmpdir + "/cache-" + test_namn(fil) + ".key"
                fil_skriv(meta_kandidat, key)
                filops.flytt(meta_kandidat, cache_meta)
                ncb = cache_ncb
            }
        }
        hvis kompilert og finst(ncb) {
            la run_miljø = runtime_miljø(root)
            sett_target_policy(run_miljø, runtime_capabilities(namn), root + ",.,/tmp,/private/tmp")
            run_miljø["NORSCODE_CMD"] = "run"
            run_miljø["NORSCODE_FILE"] = root + "/selfhost/tooling/ncb_host_run_entry.no"
            run_miljø["NORSCODE_NCB_FILE"] = ncb
            run_miljø["NORSCODE_ROOT"] = root
            res = køyr_native(root, native, run_miljø, timeout)
            la run_retry: heiltall = 0
            mens ikkje ok(res) og er_stille_feil(res) og run_retry < 2 {
                run_retry = run_retry + 1
                linje("  [RETRY " + tekst(run_retry) + "] " + test_namn(fil) + " køyre-steg stille exit " + tekst(res[0]))
                vent_ms(3000 * run_retry)
                res = køyr_native(root, native, run_miljø, timeout)
            }
            hvis ikkje ok(res) og er_stille_feil(res) { res[2] = "stille exit frå køyre-steg (ingen stdout/stderr)" }
            hvis ikkje use_cache { filops.slett_fil(ncb) }
        } ellers hvis lengde(res) == 0 {
            res = ["1", "", "test compile failed"]
            filops.slett_fil(ncb)
        }
    } ellers hvis executable(hybrid) {
        filops.lag_katalogar(tmpdir)
        la ncb = tmpdir + "/" + test_namn(fil) + ".ncb.json"
        la vm_ncb = tmpdir + "/vm_executor_" + test_namn(fil) + ".ncb.json"
        la ekstern_compile = runtime_miljø(root)
        ekstern_compile["NORSCODE_VM_FAST"] = "1"   // kompilatoren er verktøy, ikkje testobjektet (sjå kompilator_fast_modus)
        ekstern_compile["NORSCODE_HYBRID_ROOT"] = root
        ekstern_compile["NORSCODE_HYBRID_SRC"] = absolutt_fil(root, fil)
        ekstern_compile["NORSCODE_HYBRID_OUT"] = ncb
        ekstern_compile["NORSCODE_HYBRID_MODULE"] = "__main__"
        ekstern_compile["NORSCODE_HYBRID_PROJECT_ROOT"] = dirname(absolutt_fil(root, fil))
        la comp = køyr_native(root, hybrid, ekstern_compile, timeout)
        hvis ok(comp) {
            la ekstern_run = runtime_miljø(root)
            sett_target_policy(ekstern_run, runtime_capabilities(namn), root + ",.,/tmp,/private/tmp")
            ekstern_run["NORSCODE_CMD"] = "run"
            ekstern_run["NORSCODE_FILE"] = root + "/selfhost/tooling/ncb_host_run_entry.no"
            ekstern_run["NORSCODE_NCB_FILE"] = ncb
            res = køyr_native(root, native, ekstern_run, timeout)
            filops.slett_fil(ncb)
            filops.slett_fil(vm_ncb)
        } ellers {
            res = comp
            filops.slett_fil(ncb)
            filops.slett_fil(vm_ncb)
        }
    } ellers {
        la kjelde_miljø = runtime_miljø(root)
        sett_target_policy(kjelde_miljø, runtime_capabilities(namn), root + ",.,/tmp,/private/tmp")
        kjelde_miljø["NORSCODE_CMD"] = "run"
        kjelde_miljø["NORSCODE_FILE"] = absolutt_fil(root, fil)
        res = køyr_native(root, native, kjelde_miljø, timeout)
    }

    hvis ok(res) {
        auk(state, "pass")
        hvis env("NC_VERBOSE") == tekst_ein() {
            linje("  OK " + test_namn(fil))
        } ellers {
            skriv(".")
        }
    } ellers hvis ikkje slow_mode og tekst(res[0]) == "124" {
        // Fast-lane: ein test som overskrid per-test-timeouten er TREG, ikkje
        // broten. Marker SKIP (ikkje FEIL) så fast-lanen aldri blir raud på treg-
        // heit. Den komplette, parallelliserte slow-lanen (NC_TEST_ALL=1) køyrer
        // testen med romsleg timeout og fangar ekte hengingar/feil.
        auk(state, "skip")
        hvis env("NC_TRACE_TESTS") == tekst_ein() {
            linje("  SKIP " + test_namn(fil) + " (fast-lane-timeout-utsett til slow-lane)")
        }
    } ellers {
        auk(state, "fail")
        linje("")
        linje("  FEIL " + test_namn(fil))
        hvis env("NC_VERBOSE") == tekst_ein() {
            linje(res_tekst(res))
        } ellers {
            // Aldri tom detaljlinje: fall tilbake til fyrste ikkje-tomme linje
            // (òg [nc-vm]/[norscode]-prefiksa) + exit-kode, så CI-loggen alltid
            // seier KVA som feila (macOS-shardane gav "  FEIL x" + blank).
            la detalj = første_linje(res_tekst(res))
            hvis detalj == "" { detalj = første_ikkje_tomme_linje(res_tekst(res)) }
            linje("    " + detalj + " [exit " + tekst(res[0]) + "]")
        }
    }
    returner 0
}

funksjon testfiler(test_dir: tekst) -> liste_tekst {
    la frå_json = argv_verdi("--test-files-json")
    hvis frå_json != "" {
        prøv { returner builtin.json_parse(frå_json) } fang (e) { returner [] }
    }
    la frå_env = env("NC_TEST_FILES")
    hvis frå_env != "" {
        la rå_env = builtin.split(frå_env, "\n")
        la ut_env: liste_tekst = []
        la e: heiltall = 0
        mens e < lengde(rå_env) {
            la f_env = trim_tekst(rå_env[e])
            hvis f_env != "" { legg_til(ut_env, f_env) }
            e = e + 1
        }
        returner ut_env
    }
    la ut: liste_tekst = []
    la listing = native_fs.native_list(test_dir, "")
    hvis listing["status"] != "ok" { returner ut }
    la rå = builtin.split(listing["data"], "\n")
    la i: heiltall = 0
    mens i < lengde(rå) {
        la namn = trim_tekst(rå[i])
        hvis builtin.starts_with(namn, "test_") og builtin.ends_with(namn, ".no") {
            legg_til(ut, test_dir + "/" + namn)
        }
        i = i + 1
    }
    liste.sorter_tekst(ut)
    returner ut
}

funksjon til_tal_eller(t: tekst, fallback: heiltall) -> heiltall {
    hvis t == "" { returner fallback }
    prøv { returner builtin.heltall_fra_tekst(t) } fang (e) { returner fallback }
    returner fallback
}

funksjon bruk_shard(shard: heiltall, shards: heiltall) -> bool {
    returner shard >= 0 og shards > 1
}

funksjon start_konfigurert(shard_override: heiltall, shards_override: heiltall) -> heiltall {
    la root = konfig("NORSCODE_ROOT", "--root")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la native = konfig("NC_NATIVE", "--native")
    hvis native == "" { native = root + "/dist/norscode_native" }
    hvis ikkje executable(native) {
        linje("FEIL: Trenger dist/norscode_native. Køyr: ./bin/nc fetch-stage0-seed")
        returner 1
    }

    la hybrid = env("HYBRID_COMPILE")
    hvis hybrid == "" { hybrid = root + "/tools/compile_with_hybrid_bundle_v9400.no" }
    la tests_dir = env("TESTS_DIR")
    hvis tests_dir == "" { tests_dir = root + "/tests" }
    la slow_mode = env("NC_SLOW_TESTS") == tekst_ein() eller argv_verdi("--slow") == tekst_ein()
    la timeout = ""
    // Ei eksplisitt langsamgrense må vinne over den generelle grensa. Utan
    // dette blir tunge selfhost-testar feilaktig SIGALRM-avbrotne når begge
    // variablane er sette av den overordna sjølvstendighetsporten.
    hvis slow_mode { timeout = env("SLOW_TEST_TIMEOUT") }
    hvis timeout == "" { timeout = env("TEST_TIMEOUT") }
    hvis timeout == "" {
        hvis slow_mode { timeout = tekst_sakte_timeout() }
        ellers { timeout = tekst_normal_timeout() }
    }
    la shard = shard_override
    la shards = shards_override
    hvis shard < 0 { shard = til_tal_eller(konfig("NC_TEST_SHARD", "--shard"), -1) }
    hvis shards <= 0 { shards = til_tal_eller(konfig("NC_TEST_SHARDS", "--shards"), 0) }
    la tmpdir = env("NC_TEST_TMPDIR")
    hvis tmpdir == "" {
        la run_id = konfig("NC_TEST_RUN_ID", "--run-id")
        hvis run_id == "" { run_id = tekst_fra_heltall(builtin.tid_ms()) }
        hvis bruk_shard(shard, shards) {
            run_id = run_id + "-shard-" + tekst_fra_heltall(shard)
        }
        tmpdir = root + "/build/nc-test-tmp-" + run_id
    }
    la cache_dir = env("NC_TEST_CACHE_DIR")
    hvis cache_dir == "" { cache_dir = root + "/build/nc-test-cache" }
    la enkelt = env("NC_TEST_FILE")
    la state = ny_state()
    la cache = {}

    hvis enkelt != "" {
        linje("Testing: " + enkelt)
            køyr_test(state, cache, enkelt, root, native, hybrid, timeout, tmpdir, cache_dir, slow_mode)
    } ellers {
        linje("Norscode Python-fri testløpar")
        hvis bruk_shard(shard, shards) {
            linje("Shard: " + tekst_fra_heltall(shard) + "/" + tekst_fra_heltall(shards))
        }
        linje("Kompilerer og køyrer tests/test_*.no via norscode_native...")
        linje("")
        la filer = testfiler(tests_dir)
        hvis lengde(filer) == 0 {
            linje("FEIL: Ingen testfiler funne i " + tests_dir)
            returner 1
        }
        hvis env("NC_TRACE_TESTS") == tekst_ein() {
            la tung_tal: heiltall = 0
            la td: heiltall = 0
            mens td < lengde(filer) {
                hvis er_slow(basename(filer[td])) eller importerer_tung_db(filer[td], root) {
                    tung_tal = tung_tal + 1
                }
                td = td + 1
            }
            linje("[DIAG] tunge testar klassifisert: " + tekst_fra_heltall(tung_tal) +
                  " av " + tekst_fra_heltall(lengde(filer)) + " (root=" + root + ")")
        }
        la i: heiltall = 0
        la idx: heiltall = 0
        la pure_idx: heiltall = 0
        mens i < lengde(filer) {
            hvis bruk_shard(shard, shards) {
                la pure = er_pure_vm_test(filer[i], basename(filer[i]))
                hvis pure og (pure_idx % shards) == shard {
                    køyr_test(state, cache, filer[i], root, native, hybrid, timeout, tmpdir, cache_dir, slow_mode)
                }
                hvis pure {
                    pure_idx = pure_idx + 1
                } ellers hvis (idx % shards) == shard {
                    køyr_test(state, cache, filer[i], root, native, hybrid, timeout, tmpdir, cache_dir, slow_mode)
                }
                idx = idx + 1
            } ellers {
                køyr_test(state, cache, filer[i], root, native, hybrid, timeout, tmpdir, cache_dir, slow_mode)
            }
            i = i + 1
        }
        linje("")
    }

    linje("")
    linje("--- Resultat ------------------------------")
    la pass_tal = hent_tal(state, "pass")
    la fail_tal = hent_tal(state, "fail")
    la skip_tal = hent_tal(state, "skip")
    la total_tal = hent_tal(state, "total")
    linje("  Bestått:  " + tekst_fra_heltall(pass_tal))
    linje("  Feilet:   " + tekst_fra_heltall(fail_tal))
    hvis skip_tal > 0 {
        linje("  Hoppa:    " + tekst_fra_heltall(skip_tal) + "  (lane-filter/native-unsupported)")
    } ellers {
        linje("  Hoppa:    " + tekst_fra_heltall(skip_tal))
    }
    linje("  Totalt:   " + tekst_fra_heltall(total_tal))
    linje("")

    hvis fail_tal > 0 {
        linje("FEIL: Testane feilet (" + tekst_fra_heltall(fail_tal) + " av " + tekst_fra_heltall(pass_tal + fail_tal) + ")")
        returner 1
    }
    linje("OK: Alle testar bestått (" + tekst_fra_heltall(pass_tal) + "/" + tekst_fra_heltall(pass_tal + fail_tal) + ")")
    returner 0
}

funksjon start() -> heiltall {
    // Normalflata er Norscode-eigd og skal ikkje krevje valfrie OpenSSL- eller
    // eksterne Argon2-adapterar. Set verdien til 0 eksplisitt i adapter-lana.
    hvis env("NC_TEST_SKIP_OPTIONAL_NATIVE_CRYPTO") == "" {
        miljo_sett("NC_TEST_SKIP_OPTIONAL_NATIVE_CRYPTO", "1")
    }
    returner start_konfigurert(-1, 0)
}
