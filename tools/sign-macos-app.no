// tools/sign-macos-app.no — signer lokal macOS app-bundle

bruk tools.process_runner som prosess
bruk tools.macos_plist_gate_v1 som plist_gate
bruk tools.platform_context_v1 som kontekst

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon mappe_finst(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon køyr(sti: tekst, argv: liste_tekst, cwd: tekst) -> bool {
    la res = prosess.køyr(sti, argv, cwd, {}, 120000)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon start() -> heiltall {
    la root = kontekst.root()
    la app_path = env("NORSCODE_MACOS_SIGN_APP")
    hvis app_path == "" { app_path = root + "/build/macos-app/Norscode.app" }
    la identity = env("NORSCODE_MACOS_SIGN_IDENTITY")
    hvis identity == "" { identity = "-" }
    la entitlements = env("NORSCODE_MACOS_SIGN_ENTITLEMENTS")
    hvis entitlements == "" { entitlements = root + "/tools/macos-app.entitlements" }
    la verify = env("NORSCODE_MACOS_SIGN_VERIFY")

    hvis ikkje kontekst.er_macos() {
        linje("Feil: sign-macos-app krev macOS.")
        returner 1
    }
    hvis ikkje mappe_finst(app_path) {
        linje("Feil: manglar app-bundle: " + app_path)
        returner 1
    }
    la info_plist = app_path + "/Contents/Info.plist"
    hvis ikkje fil_finst(info_plist) {
        linje("Feil: ugyldig app-bundle, manglar Info.plist: " + app_path)
        returner 1
    }
    hvis ikkje plist_gate.valider_info(info_plist) {
        linje("Feil: Info.plist validerte ikkje gjennom Norscode")
        returner 1
    }
    hvis ikkje fil_finst(entitlements) {
        linje("Feil: manglar entitlements-fil: " + entitlements)
        returner 1
    }

    linje("Signerer macOS-app: " + app_path)
    linje("Identity: " + identity)
    hvis ikkje køyr("/usr/bin/codesign", ["--force", "--deep", "--sign", identity, "--timestamp=none", "--entitlements", entitlements, app_path], root) {
        returner 1
    }
    linje("Signering ferdig.")

    hvis verify != "" og verify != "0" {
        hvis ikkje køyr(root + "/bin/nc", ["verify-macos-app", app_path], root) { returner 1 }
    }
    returner 0
}
