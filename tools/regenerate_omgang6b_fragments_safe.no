// tools/regenerate_omgang6b_fragments_safe.no — regenerer Omgang 6b-fragment (standard: build/6b/fragments_gen0)

bruk std.filops som filops

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fragment_namn(src_file: tekst) -> tekst {
    hvis builtin.ends_with(src_file, ".ncb.json") {
        returner builtin.slice(src_file, 0, lengde(src_file) - lengde(".ncb.json")) + ".functions.json"
    }
    returner src_file + ".functions.json"
}

funksjon omdøyp_kall_i_kode(fn, modul_namn: tekst) {
    la kode = fn["code"]
    la i: heiltall = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        hvis builtin.type(instr) == "liste" og lengde(instr) >= 2 {
            hvis instr[0] == "CALL" og builtin.type(instr[1]) == "tekst" og builtin.starts_with(instr[1], "__main__.") {
                instr[1] = modul_namn + builtin.slice(instr[1], 8, lengde(instr[1]))
            }
        }
        i = i + 1
    }
}

funksjon omskriv_funksjonar(precompiled_sti: tekst, modul_namn: tekst) -> tekst {
    la ncb_json = fil_les(precompiled_sti)
    la ncb = json_parse_raw(ncb_json)
    la fns = ncb["functions"]
    la nk = nøkler(fns)
    la ny_fns: ordbok<tekst, tekst> = {}
    la i: heiltall = 0
    mens i < lengde(nk) {
        la gammal_nøkkel = nk[i]
        la fn = fns[gammal_nøkkel]
        la suffix = gammal_nøkkel
        hvis builtin.starts_with(gammal_nøkkel, "__main__.") {
            suffix = builtin.slice(gammal_nøkkel, 9, lengde(gammal_nøkkel))
        }
        fn["module"] = modul_namn
        omdøyp_kall_i_kode(fn, modul_namn)
        ny_fns[modul_namn + "." + suffix] = fn
        i = i + 1
    }
    returner json_skriv(ny_fns)
}

funksjon trekk_ut_native_funksjonar(precompiled_sti: tekst) -> tekst {
    // NCB-en er kompilert direkte med endeleg modulnamn av Gen1. Dermed skal
    // funksjonsnøklar og CALL-mål ikkje skrivast om eller parseast til ein
    // stor VM-objektgraf. Eit stabilt tekstsnitt held minnet proporsjonalt med
    // éin modul og bevarer bytekoden nøyaktig slik Gen1 skreiv han.
    la ncb_json = fil_les(precompiled_sti)
    la start_markør = "\"functions\":{"
    la slutt_markør = "},\"module_initializers\":"
    la start_pos = builtin.index_of(ncb_json, start_markør)
    hvis start_pos < 0 { kast "NCB manglar functions: " + precompiled_sti }
    start_pos = start_pos + lengde(start_markør)
    la rest = builtin.slice(ncb_json, start_pos, lengde(ncb_json))
    la slutt_rel = builtin.index_of(rest, slutt_markør)
    // Eldre committed NCB-format sluttar direkte etter functions-objektet.
    hvis slutt_rel < 0 og builtin.ends_with(rest, "}}") {
        returner builtin.slice(rest, 0, lengde(rest) - 2)
    }
    hvis slutt_rel < 0 { kast "NCB manglar gyldig slutt etter functions: " + precompiled_sti }
    returner builtin.slice(rest, 0, slutt_rel)
}

funksjon del_ut_modul(fns, modul_namn: tekst) -> tekst {
    // Seed-bunt (J2 Gen0, NORSCODE_FRAGMENT_BUNDLE): éin NCB med alle kompilator-
    // modulane under endelege namn. Behald berre funksjonane til denne modulen.
    // Prefikset sluttar på «.», så selfhost.json tek ikkje med selfhost.json_x.
    la prefiks = modul_namn + "."
    la nk = nøkler(fns)
    la ny_fns: ordbok<tekst, tekst> = {}
    la tal: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(nk) {
        hvis builtin.starts_with(nk[i], prefiks) {
            ny_fns[nk[i]] = fns[nk[i]]
            tal = tal + 1
        }
        i = i + 1
    }
    hvis tal == 0 { kast "seed-bunten manglar funksjonar for " + modul_namn }
    returner json_skriv(ny_fns)
}

funksjon rewrite_one_frå_bunt(bunt_fns, outer_dir: tekst, inner_dir: tekst,
                              src_file: tekst, module_name: tekst) -> bool {
    la out_name = fragment_namn(src_file)
    la outer = del_ut_modul(bunt_fns, module_name)
    la inner = builtin.slice(outer, 1, lengde(outer) - 1)
    fil_skriv(outer_dir + "/" + out_name, outer)
    fil_skriv(inner_dir + "/" + out_name, inner)
    linje(out_name + ": outer=" + tekst_fra_heltall(lengde(outer)) + " inner=" +
          tekst_fra_heltall(lengde(inner)) + " (seed-bunt)")
    returner sann
}

funksjon rewrite_one(input_dir: tekst, outer_dir: tekst, inner_dir: tekst,
                     src_file: tekst, module_name: tekst) -> bool {
    la src_path = input_dir + "/" + src_file
    la out_name = fragment_namn(src_file)
    la outer_path = outer_dir + "/" + out_name
    la inner_path = inner_dir + "/" + out_name
    la inner = ""
    la outer = ""
    hvis env("NORSCODE_FRAGMENT_SOURCE_NATIVE") == "1" {
        inner = trekk_ut_native_funksjonar(src_path)
        outer = "{" + inner + "}"
    } ellers {
        outer = omskriv_funksjonar(src_path, module_name)
        inner = builtin.slice(outer, 1, lengde(outer) - 1)
    }
    fil_skriv(outer_path, outer)
    fil_skriv(inner_path, inner)
    la outer_size = tekst_fra_heltall(lengde(outer))
    la inner_size = tekst_fra_heltall(lengde(inner))
    linje(out_name + ": outer=" + outer_size + " inner=" + inner_size)
    returner sann
}

funksjon regenerer(input_dir: tekst, outer_dir: tekst, inner_dir: tekst) -> heiltall {
    hvis ikkje filops.lag_katalogar(outer_dir) eller ikkje filops.lag_katalogar(inner_dir) { returner 1 }
    la bunt_sti = env("NORSCODE_FRAGMENT_BUNDLE")
    hvis bunt_sti != "" {
        la bunt = json_parse_raw(fil_les(bunt_sti))
        la fns = bunt["functions"]
        hvis fns == null { kast "seed-bunten manglar functions: " + bunt_sti }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "lexer_m1.ncb.json", "selfhost.lexer.lexer_m1") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "parser.ncb.json", "selfhost.parser") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "semantic.ncb.json", "selfhost.compiler.semantic") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "ir_to_bytecode.ncb.json", "selfhost.compiler.ir_to_bytecode") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "json.ncb.json", "selfhost.json") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "kompiler.ncb.json", "selfhost.kompiler") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "bundler.ncb.json", "selfhost.bundler") { returner 1 }
        hvis ikkje rewrite_one_frå_bunt(fns, outer_dir, inner_dir, "elf_compile_driver.ncb.json", "selfhost.elf_compile_driver") { returner 1 }
        returner 0
    }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "lexer_m1.ncb.json", "selfhost.lexer.lexer_m1") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "parser.ncb.json", "selfhost.parser") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "semantic.ncb.json", "selfhost.compiler.semantic") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "ir_to_bytecode.ncb.json", "selfhost.compiler.ir_to_bytecode") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "json.ncb.json", "selfhost.json") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "kompiler.ncb.json", "selfhost.kompiler") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "bundler.ncb.json", "selfhost.bundler") { returner 1 }
    hvis ikkje rewrite_one(input_dir, outer_dir, inner_dir, "elf_compile_driver.ncb.json", "selfhost.elf_compile_driver") { returner 1 }
    returner 0
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    // Inga standard-inndata: den committa bootstrap/precompiled-cachen er fjerna
    // (J1b), og fragment-NCB-ane blir genererte frå kjelde av
    // tools/selfcompile_stage0_elf.no, som set denne variabelen.
    la input_dir = env("NORSCODE_FRAGMENT_NCB_DIR")
    // BUNDLE vinn over NCB_DIR i regenerer(). Er begge sette (t.d. ein BUNDLE arva frå
    // forelderen), ville fragmenta stille kome frå bunten og ikkje frå dei kompilerte
    // per-modul-NCB-ane, og ein fikspunktport ville samanlikne bunten med seg sjølv.
    la bundle_env = env("NORSCODE_FRAGMENT_BUNDLE")
    hvis input_dir != "" og bundle_env != "" {
        linje("[FEIL] både NORSCODE_FRAGMENT_NCB_DIR og NORSCODE_FRAGMENT_BUNDLE er sette; set berre éin")
        returner 2
    }
    hvis input_dir == "" og bundle_env == "" {
        linje("Feil: NORSCODE_FRAGMENT_NCB_DIR (katalog med genererte fragment-NCB-ar: lexer_m1/parser/semantic/ir_to_bytecode/json/kompiler/bundler/elf_compile_driver.ncb.json) eller NORSCODE_FRAGMENT_BUNDLE må setjast, t.d. av tools/selfcompile_stage0_elf.no / tools/gen0_omgang6b_fragments.no")
        returner 2
    }
    la outer_dir = env("NORSCODE_FRAGMENT_OUTER_DIR")
    hvis outer_dir == "" { outer_dir = root + "/build/6b/gen0/fragments" }
    la inner_dir = env("NORSCODE_FRAGMENT_INNER_DIR")
    hvis inner_dir == "" { inner_dir = root + "/build/6b/fragments_gen0" }
    returner regenerer(input_dir, outer_dir, inner_dir)
}
