bruk tools.process_runner som prosess

funksjon env(namn: tekst, standard: tekst) -> tekst {
    la verdi = miljo_hent(namn)
    hvis verdi == "" { returner standard }
    returner verdi
}

funksjon måling(root: tekst, runtime: tekst, host: tekst, target: tekst) -> ordbok_tekst {
    la miljø = {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/selfhost/tooling/ncb_host_run_entry.no",
        "NORSCODE_HOST_NCB_FILE": host,
        "NORSCODE_NCB_FILE": target,
        "NORSCODE_NCB_STREAM_CHUNK_BYTES": "65536",
        "NORSCODE_VM_SOURCE": "1",
        "NORSCODE_VM_QUIET": "1",
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,disk.read",
        "NORSCODE_VM_DISK_ROOT": root + ",."
    }
    returner prosess.køyr(runtime, [], root, miljø, 120000)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT", ".")
    la runtime = env("NORSCODE_NCB_STREAM_RUNTIME", root + "/dist/norscode_native")
    la host = env("NORSCODE_NCB_STREAM_HOST", root + "/build/vm-executor-ncb-lazy-stream.ncb.json")
    la json_fil = env("NORSCODE_NCB_STREAM_JSON", root + "/build/l5/compiler_v1.ncb.json")
    la stream_fil = env("NORSCODE_NCB_STREAM_FILE", root + "/build/l5/compiler_v1.ncbs")
    la output = env("NORSCODE_NCB_STREAM_REPORT", root + "/build/benchmarks/ncb-stream-v1.json")

    la full = måling(root, runtime, host, json_fil)
    la stream = måling(root, runtime, host, stream_fil)
    la full_rss = heltall_fra_tekst(tekst(full["peak_rss_bytes"]))
    la stream_rss = heltall_fra_tekst(tekst(stream["peak_rss_bytes"]))
    la reduksjon_bp: heiltall = 0
    hvis full_rss > 0 og stream_rss < full_rss {
        reduksjon_bp = (full_rss - stream_rss) * 10000 / full_rss
    }
    la rapport = {
        "abi": "norscode-ncb-stream-benchmark-v1",
        "json": {"wall_ms": full["wall_ms"], "peak_rss_bytes": full["peak_rss_bytes"], "exit_code": full["exit_code"]},
        "lazy_stream": {"wall_ms": stream["wall_ms"], "peak_rss_bytes": stream["peak_rss_bytes"], "exit_code": stream["exit_code"]},
        "rss_reduction_basis_points": tekst_fra_heltall(reduksjon_bp),
        "status": hvis full_rss > 0 og stream_rss > 0 og stream_rss < full_rss og full["exit_code"] == stream["exit_code"] da "passed" ellers "failed"
    }
    fil_skriv(output, builtin.json_skriv(rapport) + "\n")
    skriv("ncb_stream_benchmark: json=" + tekst_fra_heltall(full_rss) + " stream=" + tekst_fra_heltall(stream_rss) + " reduction_bp=" + tekst_fra_heltall(reduksjon_bp) + "\n")
    hvis rapport["status"] != "passed" { returner 1 }
    returner 0
}
