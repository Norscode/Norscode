// Éin stor spesialiseringsgraf per kortliva Norscode-prosess.
bruk tools.selfcompile_stage0_elf som bygg

funksjon start() -> heiltall {
    la root = bygg.env("NORSCODE_ROOT")
    la base = bygg.env("NORSCODE_SPECIALIZE_BASE")
    la dir = bygg.env("NORSCODE_SPECIALIZE_DIR")
    la source = bygg.env("NORSCODE_SPECIALIZE_SOURCE")
    la modul = bygg.env("NORSCODE_SPECIALIZE_MODULE")
    la namn = bygg.env("NORSCODE_SPECIALIZE_NAME")
    hvis root == "" eller base == "" eller dir == "" eller source == "" eller modul == "" eller namn == "" {
        skriv("[FEIL] Ufullstendig selfhost-spesialisering\n")
        returner 2
    }
    hvis bygg.spesialiser_gen1_source_executor_lokalt(root, base, dir, source, modul, namn) == "" {
        returner 1
    }
    returner 0
}
