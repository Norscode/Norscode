// tools/omgang6b_compiler_bundle_args.inc.no — Norscode-kopi av Omgang 6b-modullista
bruk tools.omgang6b_modules som modular

funksjon omgang6b_bundle_args() -> liste_tekst {
    la args: liste_tekst = []
    for spec i modular.spesifikasjonar() {
        la felt = builtin.split(spec, "|")
        legg_til(args, felt[1] + "=" + felt[0])
    }
    returner args
}

funksjon start() -> heiltall {
    la args = omgang6b_bundle_args()
    la i = 0
    mens i < lengde(args) {
        skriv(args[i] + "\n")
        i = i + 1
    }
    returner 0
}
