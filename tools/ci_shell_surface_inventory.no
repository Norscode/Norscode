// Maskinlesbart inventar over shellorkestrering i aktive CI-workflowar.
// Direkte oppstart av ./bin/nc er bootstrapgrensa; all annan run:-tekst er
// migreringsgjeld til ein Norscode-eigd .no-jobb.

bruk std.runtime_filesystem som native_fs

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon legg_workflowfiler(root: tekst, relativ: tekst, ut) -> heiltall {
    la listing = native_fs.native_list(root, relativ)
    hvis listing["status"] != "ok" {
        hvis builtin.ends_with(relativ, ".yml") eller builtin.ends_with(relativ, ".yaml") {
            legg_til(ut, relativ)
        }
        returner 0
    }
    la barn = builtin.split(listing["data"], "\n")
    la i: heiltall = 0
    mens i < lengde(barn) {
        la namn = builtin.trim(barn[i])
        hvis namn != "" {
            la sti = namn
            hvis relativ != "" { sti = relativ + "/" + namn }
            legg_workflowfiler(root, sti, ut)
        }
        i = i + 1
    }
    returner 0
}

funksjon sortert(verdiar) {
    la pass: heiltall = 0
    mens pass < lengde(verdiar) {
        la i: heiltall = 0
        mens i + 1 < lengde(verdiar) - pass {
            hvis verdiar[i] > verdiar[i + 1] {
                la tmp = verdiar[i]
                verdiar[i] = verdiar[i + 1]
                verdiar[i + 1] = tmp
            }
            i = i + 1
        }
        pass = pass + 1
    }
    returner verdiar
}

funksjon run_verdi(line: tekst) -> tekst {
    la rein = builtin.trim(line)
    hvis builtin.starts_with(rein, "- run:") {
        returner builtin.trim(builtin.slice(rein, 6, lengde(rein)))
    }
    hvis builtin.starts_with(rein, "run:") {
        returner builtin.trim(builtin.slice(rein, 4, lengde(rein)))
    }
    returner ""
}

funksjon er_run_line(line: tekst) -> bool {
    la rein = builtin.trim(line)
    returner builtin.starts_with(rein, "run:") eller builtin.starts_with(rein, "- run:")
}

funksjon direkte_norscode(verdi: tekst) -> bool {
    hvis verdi == "" eller verdi == "|" eller verdi == ">" { returner usann }
    hvis builtin.starts_with(verdi, "./bin/nc ") eller verdi == "./bin/nc" { returner sann }
    hvis builtin.starts_with(verdi, "bin/nc ") eller verdi == "bin/nc" { returner sann }
    hvis builtin.starts_with(verdi, "./dist/norscode_native ") eller verdi == "./dist/norscode_native" { returner sann }
    hvis builtin.starts_with(verdi, "./bootstrap/stage0/norscode-") { returner sann }
    hvis builtin.starts_with(verdi, "./build/norscode_native") { returner sann }
    hvis builtin.starts_with(verdi, "./build/windows/norscode_native_") { returner sann }
    returner usann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }

    la filer = []
    legg_workflowfiler(root, ".github/workflows", filer)
    filer = sortert(filer)

    la totalt: heiltall = 0
    la direkte: heiltall = 0
    la shell: heiltall = 0
    la postar = []
    la funn = []
    la i: heiltall = 0
    mens i < lengde(filer) {
        la data = ""
        prøv { data = builtin.fil_les(root + "/" + filer[i]) } fang (e) { data = "" }
        la lines = builtin.split(data, "\n")
        la fil_total: heiltall = 0
        la fil_direkte: heiltall = 0
        la fil_shell: heiltall = 0
        la j: heiltall = 0
        mens j < lengde(lines) {
            la rein = builtin.trim(lines[j])
            hvis er_run_line(lines[j]) {
                la verdi = run_verdi(lines[j])
                totalt = totalt + 1
                fil_total = fil_total + 1
                hvis direkte_norscode(verdi) {
                    direkte = direkte + 1
                    fil_direkte = fil_direkte + 1
                } ellers {
                    shell = shell + 1
                    fil_shell = fil_shell + 1
                    legg_til(funn, {
                        "sti": filer[i],
                        "linje": j + 1,
                        "run": verdi
                    })
                }
            }
            j = j + 1
        }
        legg_til(postar, {
            "sti": filer[i],
            "run_total": fil_total,
            "direkte_norscode": fil_direkte,
            "shellorkestrering": fil_shell
        })
        i = i + 1
    }

    la rapport = {
        "schema": "norscode-ci-shell-surface-v1",
        "workflowfiler": lengde(filer),
        "run_total": totalt,
        "direkte_norscode": direkte,
        "shellorkestrering": shell,
        "filer": postar,
        "funn": funn
    }
    prøv { builtin.mkdir_p(root + "/reports") } fang (e) {
        skriv("FEIL: kan ikkje opprette reports/: " + tekst(e) + "\n")
        returner 1
    }
    la utfil = root + "/reports/ci-shell-surface-inventory.json"
    builtin.fil_skriv(utfil, builtin.json_stringify(rapport))
    skriv("CI-shellflate: " + tekst_fra_heiltall(shell) + " av " +
          tekst_fra_heiltall(totalt) + " run-blokker krev migrering\n")
    skriv("Direkte Norscode-bootstrap: " + tekst_fra_heiltall(direkte) + "\n")
    skriv("Rapport: " + utfil + "\n")

    hvis env("NORSCODE_CI_SHELL_STRICT") == "1" og shell > 0 {
        skriv("FEIL: aktiv CI inneheld shellorkestrering\n")
        returner 1
    }
    returner 0
}
