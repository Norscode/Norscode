// Maskinlesbart inventar over shell-eksekvering i aktive CI-workflowar.
// GitHub Actions køyrer også direkte Norscode-tekst i `run:` gjennom runnerens
// shell. Direkte Norscode blir rapportert separat, men er framleis fase-3-gjeld.

bruk std.runtime_filesystem som native_fs
bruk tools.no_c_python_active_surface som flate

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon legg_workflowfiler(root: tekst, relativ: tekst, ut) -> heiltall {
    la listing = native_fs.native_list(root, relativ)
    hvis listing["status"] != "ok" {
        hvis builtin.ends_with(relativ, ".yml") eller builtin.ends_with(relativ, ".yaml") {
            legg_til(ut, relativ)
        }
        returner 0
    }
    la barn = builtin.split(listing["data"], "\n")
    la i: heiltall = 0
    mens i < lengde(barn) {
        la namn = builtin.trim(barn[i])
        hvis namn != "" {
            la sti = namn
            hvis relativ != "" { sti = relativ + "/" + namn }
            legg_workflowfiler(root, sti, ut)
        }
        i = i + 1
    }
    returner 0
}

funksjon sortert(verdiar) {
    la pass: heiltall = 0
    mens pass < lengde(verdiar) {
        la i: heiltall = 0
        mens i + 1 < lengde(verdiar) - pass {
            hvis verdiar[i] > verdiar[i + 1] {
                la tmp = verdiar[i]
                verdiar[i] = verdiar[i + 1]
                verdiar[i + 1] = tmp
            }
            i = i + 1
        }
        pass = pass + 1
    }
    returner verdiar
}

funksjon run_verdi(line: tekst) -> tekst {
    la rein = builtin.trim(line)
    hvis builtin.starts_with(rein, "- run:") {
        returner builtin.trim(builtin.slice(rein, 6, lengde(rein)))
    }
    hvis builtin.starts_with(rein, "run:") {
        returner builtin.trim(builtin.slice(rein, 4, lengde(rein)))
    }
    returner ""
}

funksjon er_run_line(line: tekst) -> bool {
    la rein = builtin.trim(line)
    returner builtin.starts_with(rein, "run:") eller builtin.starts_with(rein, "- run:")
}

funksjon innrykk(line: tekst) -> heiltall {
    la i = 0
    mens i < lengde(line) og builtin.slice(line, i, i + 1) == " " { i = i + 1 }
    returner i
}

funksjon er_norscode_custom_shell(line: tekst) -> boolsk {
    returner flate.er_norscode_shell_linje(builtin.trim(line))
}

funksjon direkte_norscode(verdi: tekst) -> bool {
    hvis verdi == "" eller verdi == "|" eller verdi == ">" { returner usann }
    hvis builtin.starts_with(verdi, "./bin/nc ") eller verdi == "./bin/nc" { returner sann }
    hvis builtin.starts_with(verdi, "bin/nc ") eller verdi == "bin/nc" { returner sann }
    hvis builtin.starts_with(verdi, "./dist/norscode_native ") eller verdi == "./dist/norscode_native" { returner sann }
    hvis builtin.starts_with(verdi, "./bootstrap/stage0/norscode-") { returner sann }
    hvis builtin.starts_with(verdi, "./build/norscode_native") { returner sann }
    hvis builtin.starts_with(verdi, "./build/windows/norscode_native_") { returner sann }
    hvis builtin.starts_with(verdi, "./build/linux-arm64-attested/norscode-") { returner sann }
    returner usann
}

funksjon samle(root: tekst) -> ordbok {
    la filer = []
    legg_workflowfiler(root, ".github/workflows", filer)
    filer = sortert(filer)

    la totalt: heiltall = 0
    la direkte: heiltall = 0
    la shell: heiltall = 0
    la shell_execution: heiltall = 0
    la norscode_shell: heiltall = 0
    la postar = []
    la funn = []
    la i: heiltall = 0
    mens i < lengde(filer) {
        la data = ""
        prøv { data = builtin.fil_les(root + "/" + filer[i]) } fang (e) { data = "" }
        la runs = flate.ci_workflow_runs(data)
        la fil_total: heiltall = 0
        la fil_direkte: heiltall = 0
        la fil_shell: heiltall = 0
        la j: heiltall = 0
        mens j < lengde(runs) {
                la verdi = runs[j]["run"]
                totalt = totalt + 1
                fil_total = fil_total + 1
                hvis runs[j]["norscode"] { norscode_shell = norscode_shell + 1 }
                ellers { shell_execution = shell_execution + 1 }
                hvis direkte_norscode(verdi) {
                    direkte = direkte + 1
                    fil_direkte = fil_direkte + 1
                } ellers {
                    shell = shell + 1
                    fil_shell = fil_shell + 1
                    legg_til(funn, {
                        "sti": filer[i],
                        "linje": runs[j]["linje"],
                        "run": verdi
                    })
                }
            j = j + 1
        }
        legg_til(postar, {
            "sti": filer[i],
            "run_total": fil_total,
            "direkte_norscode": fil_direkte,
            "shellorkestrering": fil_shell
        })
        i = i + 1
    }

    // Porten og inventaret les dei same scope-verifiserte run-postane.
    // Heredoc-tekst og env.run skal heller ikkje auke totalteljinga.
    returner {
        "schema": "norscode-ci-shell-surface-v2",
        "workflowfiler": lengde(filer),
        "run_total": totalt,
        "direkte_norscode": direkte,
        "shellorkestrering": shell,
        "shell_execution": shell_execution,
        "norscode_custom_shell": norscode_shell,
        "filer": postar,
        "funn": funn
    }
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la rapport = samle(root)
    prøv { builtin.mkdir_p(root + "/reports") } fang (e) {
        skriv("FEIL: kan ikkje opprette reports/: " + tekst(e) + "\n")
        returner 1
    }
    la utfil = root + "/reports/ci-shell-surface-inventory.json"
    builtin.fil_skriv(utfil, builtin.json_stringify(rapport))
    skriv("CI-shellflate: " + tekst_fra_heiltall(rapport["shell_execution"]) + " av " +
          tekst_fra_heiltall(rapport["run_total"]) + " run-blokker bruker runner-shell\n")
    skriv("Shellorkestrering i blokkene: " + tekst_fra_heiltall(rapport["shellorkestrering"]) + "\n")
    skriv("Norscode custom-shell: " + tekst_fra_heiltall(rapport["norscode_custom_shell"]) + "\n")
    skriv("Direkte Norscode-bootstrap: " + tekst_fra_heiltall(rapport["direkte_norscode"]) + "\n")
    skriv("Rapport: " + utfil + "\n")

    hvis env("NORSCODE_CI_SHELL_STRICT") == "1" og rapport["shell_execution"] > 0 {
        skriv("FEIL: aktiv CI inneheld shell-eksekverte run-blokker\n")
        returner 1
    }
    returner 0
}
