// tools/no_legacy_cvm.no — legacy C-VM-sjekk i Norscode

bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}
funksjon env(namn: tekst) -> tekst {
    prøv {
        returner miljo_hent(namn)
    } fang (e) {
        returner ""
    }
    returner ""
}
funksjon trim_tekst(t: tekst) -> tekst {
    returner trim(t)
}

funksjon finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon er_utelaten(fil: tekst) -> bool {
    hvis builtin.ends_with(fil, "/no_legacy_cvm.sh") { returner sann }
    hvis builtin.ends_with(fil, "/no_legacy_cvm.no") { returner sann }
    hvis builtin.ends_with(fil, "/no_c_python_active_surface.no") { returner sann }
    returner usann
}

funksjon fil_inneheld(fil: tekst, pattern: tekst) -> bool {
    prøv {
        la data = builtin.fil_les(fil)
        returner builtin.index_of(data, pattern) >= 0
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon søk(root: tekst, pattern: tekst) -> tekst {
    la filer: liste_tekst = []
    la kø: liste_tekst = ["tools"]
    la qi = 0
    mens qi < lengde(kø) {
        la katalog = kø[qi]
        la listing = native_fs.native_list(root, katalog)
        hvis listing["status"] == "ok" {
            la barn = builtin.split(listing["data"], "\n")
            la bi = 0
            mens bi < lengde(barn) {
                la namn = trim_tekst(barn[bi])
                hvis namn != "" {
                    la relativ = katalog + "/" + namn
                    hvis native_fs.native_list(root, relativ)["status"] == "ok" {
                        legg_til(kø, relativ)
                    } ellers {
                        legg_til(filer, relativ)
                    }
                }
                bi = bi + 1
            }
        }
        qi = qi + 1
    }
    la hits = ""
    la i = 0
    mens i < lengde(filer) {
        la fil = filer[i]
        hvis ikkje er_utelaten(fil) {
            hvis fil_inneheld(root + "/" + fil, pattern) {
                hits = hits + fil + "\n"
            }
        }
        i = i + 1
    }
    returner trim_tekst(hits)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    hvis finst(root + "/tools/c_minimal_vm") {
        linje("Feil: tools/c_minimal_vm/ finst (legacy C-VM er fjerna og skal ikkje kome attende).")
        returner 1
    }
    hvis finst(root + "/tools/build_norscode_native_from_source.sh") {
        linje("Feil: tools/build_norscode_native_from_source.sh finst (legacy). Bruk ./bin/nc fetch-stage0-seed")
        returner 1
    }
    la hits = søk(root, "c_minimal_vm")
    hvis hits != "" {
        linje("Feil: referanse til c_minimal_vm i tools/:")
        linje(hits)
        returner 1
    }
    hits = søk(root, "ncbb")
    hvis hits != "" {
        linje("Feil: referanse til ncbb (legacy binærformat) i tools/:")
        linje(hits)
        returner 1
    }
    linje("OK: ingen historisk C-VM/NCBB under tools/")
    returner 0
}
