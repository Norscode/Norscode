// Materialiser VM-loader-fixtures med Norscode-eigd binær filflyt.

bruk std.filops som filops

funksjon start() -> heiltall {
    hvis ikkje filops.lag_katalogar("build") { returner 1 }
    la namn = [
        "vm_plugin_v1.ncb.json",
        "vm_plugin_v2.ncb.json",
        "vm_plugin_disk.ncb.json",
        "vm_plugin_tampered.ncb.json",
        "vm_trust.json"
    ]
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis ikkje filops.kopier2("tests/fixtures/vm_loader/" + namn[i], "build/" + namn[i]) {
            skriv("FEIL: kunne ikkje materialisere " + namn[i] + "\n")
            returner 1
        }
        i = i + 1
    }
    skriv("VM-loader-fixtures materialiserte\n")
    returner 0
}

