// tools/build_fullhost_x86.no — orkestrator for batch-x86_64-ELF-codegen.
//
// Byggjer ein full Linux x86_64 ELF frå ein NCB-bundle ved å køyre den
// precompilerte codegen-driveren (tools/x86_batch_host via run-ncb-pure) i fem
// fasar: prep → plan(implisitt i prep) → N målebatchar (barriere) → N emit-batchar
// → link. Kvar batch er sin eigen prosess (run-ncb-pure gjev vm.no sin GC +
// prosess-isolasjon frigjer minnet), så toppminnet held seg på ~éin batch.
//
// SETUP-CACHE: prep byggjer det tunge deterministiske oppsettet (samle_strenger
// + bygg_data + bygg_runtime, ~10 min interpretert) ÉIN gong og serialiserer det;
// batchane lastar cachen i staden for å byggje på nytt, så per-batch-kostnaden
// fell til NCB-parse + kompilering av utsnittet.
//
// Miljø:
//   NC_ELF_NCB       — inn-bundle (påkravd)
//   NC_ELF_BIN       — ut-ELF (påkravd)
//   NC_X86_CODEGEN   — driver-NCB (standard build/fullhost/x86_batch_host.ncb.json)
//   NC_BATCH_SIZE    — funksjonar per batch (standard 20)
//   NC_BATCH_WORKDIR — mellomlager (standard build/fullhost/x86batch)

bruk tools.process_runner som prosess
bruk selfhost.ncb_serde som serde

funksjon linje(m: tekst) -> heiltall { skriv(m + "\n") returner 0 }
funksjon env(n: tekst) -> tekst { prøv { returner miljo_hent(n) } fang (e) { returner "" } }
funksjon fil_finst(s: tekst) -> bool { prøv { returner builtin.fil_finnes(s) } fang (e) { returner usann } }
funksjon mb(b: heiltall) -> tekst { returner tekst_fra_heltall(b / 1048576) + " MB" }

funksjon grunnmiljø(root: tekst, ncb: tekst, cache: tekst, rt: tekst, data: tekst) -> ordbok_tekst {
    returner {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NC_X86_NCB": ncb,
        "NC_X86_CACHE": cache,
        "NC_X86_RT": rt,
        "NC_X86_DATA": data,
        "NC_NATIVE_EXTERNAL_EMBED_NCB": "0"
    }
}

funksjon køyr_steg(native: tekst, codegen: tekst, root: tekst, grunn: ordbok_tekst, ekstra: ordbok_tekst, merkelapp: tekst) -> heiltall {
    la miljø: ordbok_tekst = {}
    la gk = nøkler(grunn)
    la gi: heiltall = 0
    mens gi < lengde(gk) { miljø[gk[gi]] = grunn[gk[gi]] gi = gi + 1 }
    la nøkl = nøkler(ekstra)
    la i: heiltall = 0
    mens i < lengde(nøkl) { miljø[nøkl[i]] = ekstra[nøkl[i]] i = i + 1 }
    la res = prosess.køyr_med_grenser(native, ["run-ncb-pure", codegen], root, miljø, 2700000, 7516192768, 1024)
    hvis ikkje prosess.ok(res) {
        linje("  [FEIL] " + merkelapp + " (exit=" + tekst(res["exit_code"]) + ")")
        prosess.skriv_resultat(res)
        returner 0 - 1
    }
    returner prosess.minnetopp_bytes(res)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la native = root + "/dist/norscode_native"
    la konfig = env("NORSCODE_NATIVE_BIN")
    hvis konfig != "" { native = konfig }
    la inn = env("NC_ELF_NCB")
    la ut = env("NC_ELF_BIN")
    la codegen = env("NC_X86_CODEGEN")
    hvis codegen == "" { codegen = root + "/build/fullhost/x86_batch_host.ncb.json" }
    la batch_size = heltall_fra_tekst(env("NC_BATCH_SIZE"))
    hvis batch_size <= 0 { batch_size = 20 }
    la workdir = env("NC_BATCH_WORKDIR")
    hvis workdir == "" { workdir = root + "/build/fullhost/x86batch" }

    hvis inn == "" eller ut == "" { linje("✗ NC_ELF_NCB og NC_ELF_BIN er påkravde") returner 1 }
    hvis ikkje fil_finst(native) { linje("✗ manglar " + native) returner 1 }
    hvis ikkje fil_finst(codegen) { linje("✗ manglar driver-NCB " + codegen) returner 1 }
    hvis ikkje fil_finst(inn) { linje("✗ manglar inn-bundle " + inn) returner 1 }
    prøv { builtin.mkdir_p(workdir) } fang (e) { linje("✗ kan ikkje opprette " + workdir) returner 1 }

    la cache_sti = workdir + "/cache.json"
    la rt_sti = workdir + "/rt.bin"
    la data_sti = workdir + "/data.bin"
    la grunn = grunnmiljø(root, inn, cache_sti, rt_sti, data_sti)

    linje("=== Batch-x86_64-ELF-codegen: " + inn + " → " + ut + " ===")
    la maks_rss = 0

    // 1) prep → cache + total
    la total_sti = workdir + "/total.txt"
    la rss = køyr_steg(native, codegen, root, grunn, {"NC_X86_MODE": "prep", "NC_X86_OUT": total_sti}, "prep")
    hvis rss < 0 { returner 1 }
    hvis rss > maks_rss { maks_rss = rss }
    hvis ikkje fil_finst(cache_sti) { linje("✗ prep skreiv ikkje cache") returner 1 }
    la total = heltall_fra_tekst(builtin.fil_les(total_sti))
    linje("  [prep] " + tekst_fra_heltall(total) + " funksjonar, batch=" + tekst_fra_heltall(batch_size) + " (topp-RSS " + mb(rss) + ")")

    // 2) målebatchar → slå saman sizes (barriere)
    la merged: ordbok_tekst = {}
    la start_idx = 0
    la batchnr = 0
    mens start_idx < total {
        la sz_ut = workdir + "/sizes-" + tekst_fra_heltall(batchnr) + ".json"
        la mrss = køyr_steg(native, codegen, root, grunn, {
            "NC_X86_MODE": "measure", "NC_X86_START": tekst_fra_heltall(start_idx),
            "NC_X86_COUNT": tekst_fra_heltall(batch_size), "NC_X86_OUT": sz_ut
        }, "measure " + tekst_fra_heltall(batchnr))
        hvis mrss < 0 { returner 1 }
        hvis mrss > maks_rss { maks_rss = mrss }
        hvis ikkje fil_finst(sz_ut) { linje("✗ measure " + tekst_fra_heltall(batchnr) + " skreiv ikkje sizes") returner 1 }
        la part = serde.les_fil(sz_ut)
        la ks = nøkler(part)
        la ki: heiltall = 0
        mens ki < lengde(ks) { merged[ks[ki]] = part[ks[ki]] ki = ki + 1 }
        start_idx = start_idx + batch_size
        batchnr = batchnr + 1
    }
    la sizes_sti = workdir + "/sizes.json"
    builtin.fil_skriv(sizes_sti, builtin.json_skriv(merged))
    linje("  [measure] " + tekst_fra_heltall(lengde(nøkler(merged))) + " storleikar samla i " + tekst_fra_heltall(batchnr) + " batchar")

    // 3) emit-batchar → frag-filer
    la frag_paths: liste_tekst = []
    start_idx = 0
    batchnr = 0
    mens start_idx < total {
        la frag_ut = workdir + "/frag-" + tekst_fra_heltall(batchnr) + ".bin"
        la erss = køyr_steg(native, codegen, root, grunn, {
            "NC_X86_MODE": "emit", "NC_X86_START": tekst_fra_heltall(start_idx),
            "NC_X86_COUNT": tekst_fra_heltall(batch_size),
            "NC_X86_SIZES": sizes_sti, "NC_X86_OUT": frag_ut
        }, "emit " + tekst_fra_heltall(batchnr))
        hvis erss < 0 { returner 1 }
        hvis erss > maks_rss { maks_rss = erss }
        hvis ikkje fil_finst(frag_ut) { linje("✗ emit " + tekst_fra_heltall(batchnr) + " skreiv ikkje frag") returner 1 }
        legg_til(frag_paths, frag_ut)
        start_idx = start_idx + batch_size
        batchnr = batchnr + 1
    }
    linje("  [emit] " + tekst_fra_heltall(lengde(frag_paths)) + " fragment")

    // 4) link → full ELF
    la lrss = køyr_steg(native, codegen, root, grunn, {
        "NC_X86_MODE": "link", "NC_X86_SIZES": sizes_sti,
        "NC_X86_FRAGS": builtin.join(frag_paths, ","), "NC_X86_BIN": ut
    }, "link")
    hvis lrss < 0 { returner 1 }
    hvis lrss > maks_rss { maks_rss = lrss }
    hvis ikkje fil_finst(ut) { linje("✗ link skreiv ikkje ELF " + ut) returner 1 }
    linje("  [link] ELF skriven (topp-RSS " + mb(lrss) + ")")
    linje("")
    linje("Ferdig. Full ELF: " + ut + " — høgaste steg-RSS " + mb(maks_rss) + ".")
    returner 0
}
