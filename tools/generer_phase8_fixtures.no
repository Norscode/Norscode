# tools/generer_phase8_fixtures.no
#
# Genererer dei to «phase8»-testfiksturane som krev_ny_seed-testane les frå
# build/. build/ er git-ignorert (byggartefakt), så fiksturane kan ikkje
# commitast — dei blir laga ved køyretid frå dei committa precompiled-NCB-ane.
#
# Kjelda (bootstrap/precompiled/{vm,lexer_m1}.ncb.json) er kompilert som
# «__main__». Testane ventar den MODUL-kvalifiserte forma (selfhost.vm.* /
# selfhost.lexer.lexer_m1.*) slik ein `bruk`-lasting gjev. Vi omdøyper difor
# «__main__»-prefikset på tekstnivå (rein streng-erstatting bevarer JSON-
# boolean-literala som test_json_parse_raw_ncb_bool sjekkar).
#
#  · build/vm_phase8_fixed6_direct.ncb.json   → test_bundle_metadata_merge,
#                                                test_nc_main_metadata_recovery
#  · build/lexer_phase8_json_probe.ncb.json   → test_json_parse_raw_ncb_bool

funksjon omdøyp_modul(kjelde: tekst, modul: tekst) -> tekst {
    # Kvalifiserte namn: "__main__.foo" → "<modul>.foo" (funksjonsnøklar,
    # module_initializers, entry, CALL-referansar).
    la ut = builtin.replace(kjelde, "\"__main__.", "\"" + modul + ".")
    # Berre modul-nøkkelen i global_names: "__main__" → "<modul>".
    ut = builtin.replace(ut, "\"__main__\"", "\"" + modul + "\"")
    returner ut
}

funksjon generer_ein(kjelde_sti: tekst, mål_sti: tekst, modul: tekst) -> heiltall {
    hvis ikkje builtin.fil_finnes(kjelde_sti) {
        skriv("HOPP: manglar kjelde " + kjelde_sti + "\n")
        returner 1
    }
    la raw = builtin.fil_les(kjelde_sti)
    la ut = omdøyp_modul(raw, modul)
    builtin.fil_skriv(mål_sti, ut)
    skriv("skreiv " + mål_sti + " (modul=" + modul + ")\n")
    returner 0
}

funksjon start() -> heiltall {
    prøv { builtin.mkdir("build") } fang (e) { }
    la feil = 0
    feil = feil + generer_ein("bootstrap/precompiled/vm.ncb.json",
        "build/vm_phase8_fixed6_direct.ncb.json", "selfhost.vm")
    feil = feil + generer_ein("bootstrap/precompiled/lexer_m1.ncb.json",
        "build/lexer_phase8_json_probe.ncb.json", "selfhost.lexer.lexer_m1")
    hvis feil > 0 { returner 1 }
    skriv("phase8-fixturar OK\n")
    returner 0
}
