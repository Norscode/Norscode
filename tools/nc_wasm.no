# tools/nc_wasm.no — NCB → WebAssembly-klientmodul + generert lastar (W0–W3).
#
# Bruk:
#   ./bin/nc compile klient.no -o build/wasm/app/klient.ncb.json
#   NC_WASM_NCB=build/wasm/app/klient.ncb.json NC_WASM_UT=build/wasm/app ./bin/nc run tools/nc_wasm.no
#
# Miljø:
#   NC_WASM_NCB       NCB-JSON frå `nc compile` (påkravd)
#   NC_WASM_UT        utmappe, må liggje under build/wasm/ (påkravd, blir laga ved behov)
#   NC_WASM_TESTBYGG  «1» tillèt testvertsfunksjonar (test_klikk); aldri i produksjon
#   NC_WASM_PREFIKS   URL-prefiks for ressursane (standard «/_nc/»)
#
# Utdata i NC_WASM_UT (alt generert, aldri committa — build/ er git-ignorert):
#   app.wasm        modulen
#   nc.js           lastaren, emittert av std/wasm_js.no frå Norscode-data (for innsyn)
#   klient_data.no  Norscode-modul med bytane (hex), lastaren og versjonane, som ein
#                   serve-app kan `bruk`-e (nc serve har ingen disk-kapabilitet)
# Versjonen v er dei 12 første hex-teikna av sha256 over bytane (sha256_bytes).
# Utdatalinja: `WASM: app.wasm <n> byte, lastar <m> byte, v=<12 hex> importar=<a,b> eksportar=<m,i>
# atom=<…>` — importane og eksportane er dei validatoren (std/wasm_les.no) las ut av modulen.
# Ukjende opkodar og builtins gjev exit 1 med ei liste over alle feil (ingen fallback).
#
# W3: runtime-biblioteket std/wasm_rt.no (vanleg Norscode) blir kompilert med `nc compile`
# i ein barneprosess (via ein generert drivar i NC_WASM_UT/rt/) og lenka inn i NCB-en
# (lowring.lenk_rt). Lowringa tek berre med rt-funksjonane programmet når; utdatalinja
# listar dei som `rt=<a,b>`.

bruk std.wasm_lowring som lowring
bruk std.wasm_js som js
bruk std.wasm_les som les
bruk std.runtime.process_abi som process_abi

funksjon _hex(bytar: liste) -> tekst {
    returner les.til_hex(bytar)
}

# Norscode-strengliteral: escape \ og ".
funksjon _no_streng(s: tekst) -> tekst {
    la bs = "\\"
    la q = "\""
    returner q + builtin.replace(builtin.replace(s, bs, bs + bs), q, bs + q) + q
}

funksjon klient_data_modul(hex: tekst, v: tekst, lastar: tekst, lastar_v: tekst, n: heltall) -> tekst {
    la ut = "# GENERERT av tools/nc_wasm.no. Ikkje rediger og ikkje commit (ligg under build/).\n"
    ut = ut + "# WASM-modulen som hex, lastaren emittert frå Norscode-data, og versjonane.\n\n"
    ut = ut + "funksjon wasm_hex() -> tekst { returner " + _no_streng(hex) + " }\n\n"
    ut = ut + "funksjon wasm_versjon() -> tekst { returner " + _no_streng(v) + " }\n\n"
    ut = ut + "funksjon wasm_storleik() -> heltall { returner " + tekst(n) + " }\n\n"
    ut = ut + "funksjon lastar() -> tekst { returner " + _no_streng(lastar) + " }\n\n"
    ut = ut + "funksjon lastar_versjon() -> tekst { returner " + _no_streng(lastar_v) + " }\n"
    returner ut
}

funksjon _rot() -> tekst {
    la r = miljo_hent("NORSCODE_ROOT")
    hvis r == "" { r = tekst(builtin.system_info()["cwd"]) }
    returner r
}

funksjon _abs(rot: tekst, sti: tekst) -> tekst {
    hvis builtin.starts_with(sti, "/") { returner sti }
    returner rot + "/" + sti
}

# `nc compile` av ein drivar som importerer std.wasm_rt, i ein barneprosess med eksplisitt
# miljø (ikkje arva CMD/FILE frå ein CI-adapter). Gjev rt-NCB-en, eller {} ved feil.
funksjon kompiler_rt(rot: tekst, ut: tekst) -> ordbok {
    la mappe = _abs(rot, ut) + "/rt"
    builtin.mkdir_p(mappe)
    fil_skriv(mappe + "/rt_drivar.no", "# GENERERT av tools/nc_wasm.no\nbruk std.wasm_rt som rt\n\nfunksjon start() -> heltall {\n    returner 0\n}\n")
    la miljø = {
        "PATH": "/usr/bin:/bin", "HOME": miljo_hent("HOME"), "TMPDIR": "/tmp", "NORSCODE_ROOT": rot,
        "NORSCODE_CMD": "compile", "NORSCODE_FILE": mappe + "/rt_drivar.no", "NORSCODE_OUTPUT": mappe + "/rt.ncb.json",
        "NORSCODE_VM_FAST": "1", "NORSCODE_MODULE": "", "NORSCODE_VM_CI_COMMAND": "", "NORSCODE_VM_CI_CHILD_CMD": "",
        "NORSCODE_VM_CI_CHILD_FILE": "", "NORSCODE_RUN_DIRECT_HOST": "0", "NORSCODE_HOST_NCB_FILE": "", "NORSCODE_NCB_FILE": ""
    }
    la req = process_abi.request(tekst(builtin.system_info()["executable"]), [], rot, "", 300000, 33554432)
    process_abi.sett_sandbox(req, "none", 4294967296, 1024, usann)
    process_abi.sett_environment(req, miljø)
    la res = builtin.process_spawn_argv(req)
    la ec = -1
    hvis finnes_nøkkel(res, "exit_code") { ec = heltall_fra_tekst(tekst(res["exit_code"])) }
    hvis ec != 0 eller ikkje builtin.fil_finnes(mappe + "/rt.ncb.json") {
        skriv("nc_wasm: kompilering av std/wasm_rt.no feila (exit " + tekst(ec) + "):\n" + tekst(res["stdout"]) + tekst(res["stderr"]) + "\n")
        returner {}
    }
    returner builtin.json_parse_raw(fil_les(mappe + "/rt.ncb.json"))
}

funksjon start() -> heltall {
    la ncb_sti = miljo_hent("NC_WASM_NCB")
    la ut = miljo_hent("NC_WASM_UT")
    hvis ncb_sti == "" eller ut == "" {
        skriv("nc_wasm: set NC_WASM_NCB og NC_WASM_UT\n")
        returner 2
    }
    hvis ikkje builtin.starts_with(ut, "build/wasm/") og ikkje builtin.contains(ut, "/build/wasm/") {
        skriv("nc_wasm: NC_WASM_UT må liggje under build/wasm/ (generert, aldri committa): " + ut + "\n")
        returner 2
    }
    la prefiks = miljo_hent("NC_WASM_PREFIKS")
    hvis prefiks == "" { prefiks = "/_nc/" }
    la testbygg = miljo_hent("NC_WASM_TESTBYGG") == "1"

    la ncb = builtin.json_parse_raw(fil_les(ncb_sti))
    la rt_ncb = kompiler_rt(_rot(), ut)
    hvis lengde(rt_ncb) == 0 { returner 1 }
    la res = lowring.kompiler(lowring.lenk_rt(ncb, rt_ncb), {"testbygg": testbygg})
    hvis ikkje res["ok"] {
        skriv(lowring.feilrapport(res))
        returner 1
    }
    la bytar = res["bytar"]
    la sjekk = les.valider(bytar)
    hvis ikkje sjekk["ok"] {
        skriv("nc_wasm: intern feil, validatoren avviste modulen: " + sjekk["feil"] + "\n")
        returner 1
    }
    la v = lowring.versjon(bytar)
    la l = js.bygg_lastar(res["importar"], prefiks + "app.wasm?v=" + v, res["har_init"])
    la lastar = l["js"]
    la lastar_v = builtin.slice(builtin.sha256(lastar), 0, 12)

    builtin.mkdir_p(ut)
    builtin.fil_skriv_binær(ut + "/app.wasm", bytar)
    fil_skriv(ut + "/nc.js", lastar)
    fil_skriv(ut + "/klient_data.no", klient_data_modul(_hex(bytar), v, lastar, lastar_v, lengde(bytar)))
    la vi = sjekk["info"]
    skriv("WASM: app.wasm " + tekst(lengde(bytar)) + " byte, lastar " + tekst(lengde(lastar)) + " byte, v=" + v +
          " importar=" + builtin.join(vi["importar"], ",") + " eksportar=" + builtin.join(vi["eksportar"], ",") +
          " atom=" + builtin.join(res["atom"], ",") + " rt=" + builtin.join(res["rt"], ",") + "\n")
    returner 0
}
