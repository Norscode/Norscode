// Strukturert stage0-smoke utan shellbasert tekstskriving eller substitusjon.

bruk std.filops som filops
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner builtin.miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la runtime = root + "/dist/norscode_native"
    la kjelde = "/tmp/_nc_smoke.no"
    builtin.fil_skriv(kjelde, "funksjon start() { returner 7 }\n")
    la miljø: ordbok_tekst = {
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": kjelde,
        "NORSCODE_VM_CAPABILITIES": "disk.read",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp"
    }
    la resultat = prosess.køyr(runtime, [], root, miljø, 120000)
    filops.slett_fil(kjelde)
    hvis tekst(resultat["status"]) != "ferdig" eller
       heltall_fra_tekst(tekst(resultat["exit_code"])) != 7 {
        prosess.skriv_resultat(resultat)
        skriv("FEIL: stage0-smoke returnerte ikkje 7\n")
        returner 1
    }
    skriv("Stage0 smoke OK\n")
    returner 0
}
