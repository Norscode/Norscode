// tools/verify-macos-app.no — verifiser macOS app-bundle

bruk std.path som path
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon mappe_finst(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon executable(sti: tekst) -> bool {
    returner fil_finst(sti)
}

funksjon krev_verktøy(sti: tekst, namn: tekst) -> bool {
    hvis fil_finst(sti) { returner sann }
    linje("Feil: manglar macOS-verktøyet " + namn + ": " + sti)
    returner usann
}

funksjon køyr(sti: tekst, argv: liste_tekst, cwd: tekst) -> bool {
    la res = prosess.køyr(sti, argv, cwd, {}, 120000)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon basename(sti: tekst) -> tekst {
    returner path.basename(sti)
}

funksjon fjern_suffiks(verdi: tekst, suffiks: tekst) -> tekst {
    hvis suffiks != "" og builtin.ends_with(verdi, suffiks) {
        returner builtin.slice(verdi, 0, lengde(verdi) - lengde(suffiks))
    }
    returner verdi
}

funksjon basename_app(sti: tekst) -> tekst {
    returner fjern_suffiks(basename(sti), ".app")
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(info["cwd"]) }
    la app_path = env("NORSCODE_MACOS_VERIFY_APP")
    hvis app_path == "" { app_path = root + "/build/macos-app/Norscode.app" }

    hvis builtin.lower(tekst(info["system"])) != "darwin" {
        linje("Feil: verify-macos-app krev macOS.")
        returner 1
    }
    hvis ikkje krev_verktøy("/usr/bin/plutil", "plutil") { returner 1 }
    hvis ikkje krev_verktøy("/usr/bin/codesign", "codesign") { returner 1 }
    hvis ikkje krev_verktøy("/usr/sbin/spctl", "spctl") { returner 1 }

    hvis ikkje mappe_finst(app_path) {
        linje("Feil: manglar app-bundle: " + app_path)
        returner 1
    }

    la info_plist = app_path + "/Contents/Info.plist"
    la launcher = app_path + "/Contents/MacOS/" + basename_app(app_path)
    hvis ikkje fil_finst(info_plist) {
        linje("Feil: manglar Info.plist")
        returner 1
    }
    hvis ikkje executable(launcher) {
        linje("Feil: manglar launcher: " + launcher)
        returner 1
    }

    hvis ikkje køyr("/usr/bin/plutil", ["-lint", info_plist], root) { returner 1 }
    linje("Info.plist: OK")
    linje("Launcher: OK")

    linje("")
    linje("Codesign verify:")
    hvis ikkje køyr("/usr/bin/codesign", ["--verify", "--deep", "--strict", app_path], root) { returner 1 }

    linje("")
    linje("Codesign details:")
    hvis ikkje køyr("/usr/bin/codesign", ["-dvv", app_path], root) { returner 1 }

    linje("")
    linje("Gatekeeper assess:")
    hvis ikkje køyr("/usr/sbin/spctl", ["--assess", "--type", "execute", "--verbose=4", app_path], root) {
        linje("Merk: Gatekeeper-avvik er forventa for ad-hoc-signert eller ikkje-notarisert app.")
    }

    linje("")
    linje("macOS app-verifikasjon: OK")
    returner 0
}
