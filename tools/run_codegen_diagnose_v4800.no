// tools/run_codegen_diagnose_v4800.no — shellfri literal/index compile-diagnose

bruk std.filops som filops
bruk std.prosess som system_prosess
bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon trim(t: tekst) -> tekst { returner builtin.trim(t) }

funksjon has(path: tekst, needle: tekst) -> bool {
    prøv { returner builtin.index_of(builtin.fil_les(path), needle) >= 0 }
    fang (e) { returner usann }
    returner usann
}

funksjon skriv_logg(sti: tekst, resultat: ordbok_tekst) -> heiltall {
    la body = tekst(resultat["stdout"]) + tekst(resultat["stderr"])
    builtin.fil_skriv(sti, body)
    hvis body != "" { skriv(body) }
    returner 0
}

funksjon valider_fixture(out: tekst, tag: tekst) -> boolsk {
    prøv {
        la out_body = builtin.fil_les(out)
        hvis out_body != "" { skriv(out_body) }
    } fang (e) { returner usann }
    hvis ikkje has(out, "\"PUSH_CONST\",1") { returner usann }
    hvis ikkje has(out, "\"BUILD_LIST\"") {
        linje("[FAIL] " + tag + " manglar BUILD_LIST i literal/index-probe")
        returner usann
    }
    hvis ikkje has(out, "\"BUILD_MAP\"") {
        linje("[FAIL] " + tag + " manglar BUILD_MAP i literal/index-probe")
        returner usann
    }
    hvis ikkje has(out, "\"INDEX_GET\"") {
        linje("[FAIL] " + tag + " manglar INDEX_GET i literal/index-probe")
        returner usann
    }
    linje("[OK] " + tag + " literal/index compile-probe grøn")
    returner sann
}

funksjon compile_fixture(root: tekst, bin_path: tekst, tag: tekst) -> bool {
    la out_dir = root + "/build/v4800"
    la fixture = root + "/tests/fixtures/literal_index_probe_v4800.no"
    la out = out_dir + "/" + tag + "_literal_index_probe.json"
    la log = out_dir + "/" + tag + "_literal_index_probe_compile.log"
    la miljø = {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": fixture,
        "NORSCODE_OUTPUT": out
    }
    la resultat = prosess.køyr(bin_path, [], root, miljø, 120000)
    skriv_logg(log, resultat)
    hvis ikkje prosess.ok(resultat) { returner usann }
    returner valider_fixture(out, tag)
}

funksjon docker_finst(docker: tekst, root: tekst) -> bool {
    hvis docker == "" { returner usann }
    returner prosess.ok(prosess.køyr(docker, ["info"], root, {}, 30000))
}

funksjon docker_exec(docker: tekst, root: tekst, container: tekst,
                      argv: liste_tekst, timeout_ms: heiltall) -> ordbok_tekst {
    la args: liste_tekst = ["exec", container]
    la i = 0
    mens i < lengde(argv) { legg_til(args, argv[i]) i = i + 1 }
    returner prosess.køyr(docker, args, root, {}, timeout_ms)
}

funksjon rydd_container(docker: tekst, root: tekst, container: tekst) -> heiltall {
    hvis container != "" { prosess.køyr(docker, ["rm", "-f", container], root, {}, 30000) }
    returner 0
}

funksjon run_linux_docker(root: tekst, docker: tekst) -> bool {
    la out = root + "/build/v4800/linux_stage0_literal_index_probe.json"
    la log = root + "/build/v4800/linux_stage0_literal_index_probe.log"
    la create = prosess.køyr(docker,
        ["create", "--platform", "linux/amd64", "-v", root + ":/work", "-w", "/work",
         "ubuntu:24.04", "/bin/sleep", "infinity"], root, {}, 120000)
    hvis ikkje prosess.ok(create) { prosess.skriv_resultat(create) returner usann }
    la container = trim(tekst(create["stdout"]))
    hvis container == "" { returner usann }

    la start_result = prosess.køyr(docker, ["start", container], root, {}, 30000)
    hvis ikkje prosess.ok(start_result) {
        prosess.skriv_resultat(start_result)
        rydd_container(docker, root, container)
        returner usann
    }
    la update = docker_exec(docker, root, container, ["apt-get", "update"], 600000)
    hvis ikkje prosess.ok(update) {
        prosess.skriv_resultat(update)
        rydd_container(docker, root, container)
        returner usann
    }
    la install = docker_exec(docker, root, container,
        ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", "libsqlite3-0"], 600000)
    hvis ikkje prosess.ok(install) {
        prosess.skriv_resultat(install)
        rydd_container(docker, root, container)
        returner usann
    }
    la compile_argv: liste_tekst = [
        "env", "NORSCODE_ROOT=/work", "NORSCODE_CMD=compile",
        "NORSCODE_FILE=/work/tests/fixtures/literal_index_probe_v4800.no",
        "NORSCODE_OUTPUT=/work/build/v4800/linux_stage0_literal_index_probe.json",
        "/work/bootstrap/stage0/norscode-linux-x86_64"
    ]
    la compile = docker_exec(docker, root, container, compile_argv, 120000)
    skriv_logg(log, compile)
    rydd_container(docker, root, container)
    hvis ikkje prosess.ok(compile) { returner usann }
    returner valider_fixture(out, "linux_stage0")
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    hvis ikkje filops.lag_katalogar(root + "/build/v4800") { returner 1 }

    linje("== v4800 codegen diagnose ==")
    linje("")
    linje("[1/2] macOS active dist literal/index compile-probe")
    hvis ikkje compile_fixture(root, root + "/dist/norscode_native", "macos_dist") { returner 1 }

    la docker = system_prosess.finn_kjorbar("docker")
    hvis docker_finst(docker, root) {
        linje("")
        linje("[2/2] Linux x86_64 stage0 literal/index compile-probe (Docker)")
        hvis ikkje run_linux_docker(root, docker) { returner 1 }
    } ellers {
        linje("")
        linje("[SKIP] Docker er ikkje tilgjengeleg.")
    }

    linje("")
    linje("[OK] v4800 codegen diagnose ferdig.")
    returner 0
}
