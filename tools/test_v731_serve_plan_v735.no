// tools/test_v731_serve_plan_v735.no — v731 route-smoke med DEV-flyt

bruk std.http som http

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon køyr(url: tekst, cookie: tekst) -> tekst {
    la headers: ordbok_tekst = {}
    hvis cookie != "" { headers["Cookie"] = cookie }
    la res = http.get(url, headers, {}, 10000)
    skriv(res + "\n")
    hvis http.response_status(res) < 200 eller http.response_status(res) >= 400 { returner "" }
    returner res
}

funksjon start() -> heiltall {
    la port = env("NORSCODE_V731_PORT")
    hvis port == "" { port = "8126" }
    la base = "http://127.0.0.1:" + port

    linje("Tester " + base)
    hvis køyr(base + "/", "") == "" { returner 1 }
    linje("")
    hvis køyr(base + "/admin", "") == "" { returner 1 }
    linje("")
    hvis køyr(base + "/status.json", "") == "" { returner 1 }
    linje("")
    hvis køyr(base + "/logout", "") == "" { returner 1 }
    linje("")

    linje("DEV-flyt:")
    la login = køyr(base + "/dev-login", "")
    hvis login == "" { returner 1 }
    la cookie = http.response_header(login, "set-cookie")
    hvis builtin.index_of(cookie, ";") >= 0 { cookie = builtin.slice(cookie, 0, builtin.index_of(cookie, ";")) }
    hvis cookie == "" { returner 1 }
    linje("")
    hvis køyr(base + "/admin", cookie) == "" { returner 1 }
    linje("")
    hvis køyr(base + "/logout", cookie) == "" { returner 1 }
    linje("")

    linje("OK v800")
    returner 0
}
