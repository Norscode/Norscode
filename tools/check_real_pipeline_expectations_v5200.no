// Strukturerte real-compiler expectation-prober utan shell.

bruk std.filops som filops
bruk std.runtime.process_abi som process_abi

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon run_probe(root: tekst, native: tekst, file: tekst) -> tekst {
    la req = process_abi.request(native, [], root, "", 120000, 1048576)
    process_abi.sett_sandbox(req, "none", 536870912, 32, usann)
    process_abi.sett_environment(req, {
        "NORSCODE_ROOT": root,
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/" + file,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"
    })
    la res = builtin.process_spawn_argv(req)
    hvis res["stderr"] != "" { skriv(res["stderr"]) }
    hvis res["status"] != "ferdig" eller heltall_fra_tekst(res["exit_code"]) != 0 { returner "" }
    returner res["stdout"]
}

funksjon assert_contains(haystack: tekst, needle: tekst, label: tekst) -> bool {
    hvis tekst_inneholder(haystack, needle) { returner sann }
    linje("[FAIL] " + label + " manglar " + needle)
    returner usann
}

funksjon sjekk(root: tekst, native: tekst) -> bool {
    hvis ikkje assert_contains(run_probe(root, native, "selfhost/probes_real/list_probe_real.no"), "BUILD_LIST", "list_probe_real") { returner usann }
    hvis ikkje assert_contains(run_probe(root, native, "selfhost/probes_real/empty_list_probe_real.no"), "BUILD_LIST", "empty_list_probe_real") { returner usann }
    hvis ikkje assert_contains(run_probe(root, native, "selfhost/probes_real/map_probe_real.no"), "BUILD_MAP", "map_probe_real") { returner usann }
    hvis ikkje assert_contains(run_probe(root, native, "selfhost/probes_real/index_probe_real.no"), "INDEX_GET", "index_probe_real") { returner usann }
    la assignment_list_out = run_probe(root, native, "selfhost/probes_real/assignment_list_probe_real.no")
    hvis ikkje assert_contains(assignment_list_out, "BUILD_LIST", "assignment_list_probe_real") eller ikkje assert_contains(assignment_list_out, "STORE_VAR", "assignment_list_probe_real") { returner usann }
    la assignment_map_out = run_probe(root, native, "selfhost/probes_real/assignment_map_probe_real.no")
    hvis ikkje assert_contains(assignment_map_out, "BUILD_MAP", "assignment_map_probe_real") eller ikkje assert_contains(assignment_map_out, "STORE_VAR", "assignment_map_probe_real") { returner usann }
    la assignment_index_out = run_probe(root, native, "selfhost/probes_real/assignment_index_probe_real.no")
    hvis ikkje assert_contains(assignment_index_out, "INDEX_GET", "assignment_index_probe_real") eller ikkje assert_contains(assignment_index_out, "STORE_VAR", "assignment_index_probe_real") { returner usann }
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" {
        prøv { root = tekst(builtin.system_info()["cwd"]) } fang (e) { root = "." }
    }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/dist/norscode_native" }
    hvis ikkje filops.fil_finnes(native) {
        linje("[FAIL] manglar native runtime: " + native)
        returner 1
    }
    linje("== v5200 real compiler expectations ==")
    hvis ikkje sjekk(root, native) { returner 1 }
    linje("[OK] real pipeline expectation checks passerte")
    returner 0
}
