// Build a source-bound CI runtime entirely through Norscode. The committed
// bootstrap is only the first compiler, never the resulting runtime under test.
// No stage0/dist promotion: output stays under build/ci-runtime.
bruk tools.process_runner som prosess
bruk std.filops som filops
bruk selfhost.native_execution.codegen_prebuilt som cgp

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon pin(allow: tekst, rel: tekst) -> tekst {
    la prefix: tekst = "godkjend binær " + rel + " sha256="
    for line i builtin.split(allow, "\n") {
        hvis builtin.starts_with(line, prefix) { returner builtin.trim(builtin.slice(line, lengde(prefix), lengde(line))) }
    }
    kast "ci-runtime: manglar godkjend pin for " + rel
    returner ""
}

funksjon hash(sti: tekst) -> tekst {
    la h: tekst = cgp.sha256_fil(sti)
    hvis lengde(h) != 64 { kast "ci-runtime: ugyldig SHA-256 for " + sti }
    returner h
}

funksjon grunnmiljø(root: tekst) -> ordbok_tekst {
    returner {"NORSCODE_ROOT": root, "NORSCODE_CMD": "", "NORSCODE_FILE": "", "NORSCODE_OUTPUT": "",
        "NORSCODE_HOST_NCB_FILE": "", "NORSCODE_NCB_FILE": "", "NORSCODE_VM_SOURCE": "",
        "NORSCODE_ENABLE_EXEC_PROSESS": "1", "NORSCODE_GC_ALLOC": "1",
        "NC_INPUT": "", "NC_OUTPUT": "", "NC_TARGET": "", "NC_NATIVE_EXTERNAL_EMBED_NCB": "",
        "NC_BUILTIN_REPORT": "1", "NC_BUILTIN_KVITLISTE": "",
        "NORSCODE_VM_CAPABILITIES": "env.read,env.write,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp"}
}

funksjon køyr(root: tekst, ut: tekst, namn: tekst, exe: tekst, args: liste_tekst, miljø: ordbok_tekst, timeout: heiltall) -> tekst {
    skriv("[ci-runtime] " + namn + "\n")
    la r = prosess.køyr(exe, args, root, miljø, timeout)
    la logg: tekst = tekst(r["stdout"]) + tekst(r["stderr"])
    fil_skriv(ut + "/" + namn + ".log", logg)
    hvis ikkje prosess.ok(r) {
        prosess.skriv_resultat(r)
        kast "ci-runtime: " + namn + " feila: " + tekst(r["status"]) + "/" + tekst(r["exit_code"])
    }
    returner logg
}

funksjon materialiser_driver(root: tekst, ut: tekst) -> heiltall {
    la driver = builtin.json_parse_raw(fil_les(root + "/build/l5/compiler_driver.ncb.json"))
    la fns = driver["functions"]
    la namn = nøkler(fns)
    for fn i namn {
        la f = fns[fn]
        hvis har_nokkel(f, "__ncb_lazy_json__") { fns[fn] = builtin.json_parse_raw(f["__ncb_lazy_json__"]) }
    }
    hvis ikkje har_nokkel(fns, tekst(driver["entry"])) { kast "ci-runtime: compiler-driver manglar entry" }
    fil_skriv(ut, builtin.json_skriv(driver))
    returner lengde(namn)
}

funksjon bygg_native(root: tekst, ut: tekst, cg: tekst, ncb: tekst, exe: tekst, namn: tekst) {
    la miljø = grunnmiljø(root)
    miljø["NC_INPUT"] = ncb
    miljø["NC_OUTPUT"] = exe
    miljø["NC_TARGET"] = "linux-x86_64"
    la logg = køyr(root, ut, namn, cg, [], miljø, 600000)
    hvis ikkje builtin.contains(logg, "BUILTIN-RAPPORT uløyste=0 uventa=0") {
        kast "ci-runtime: " + namn + " manglar rein builtin-rapport"
    }
    hvis ikkje builtin.fil_finnes(exe) eller ikkje builtin.fil_sett_kjorbar(exe) {
        kast "ci-runtime: " + namn + " skreiv ingen køyrbar kandidat"
    }
}

funksjon bygg(root: tekst, ut: tekst) {
    hvis cgp.vert_plattform() != "linux-x86_64" { kast "ci-runtime: source-builder krev Linux x86-64" }
    la allow = fil_les(root + "/tools/active_surface_allowlist.txt")
    la bootstrap: tekst = env("NORSCODE_CI_RUNTIME_BOOTSTRAP")
    la bootstrap_pin: tekst = env("NORSCODE_CI_RUNTIME_BOOTSTRAP_SHA256")
    hvis bootstrap == "" {
        bootstrap = root + "/bootstrap/stage0/norscode-linux-x86_64"
        bootstrap_pin = pin(allow, "bootstrap/stage0/norscode-linux-x86_64")
    }
    hvis lengde(bootstrap_pin) != 64 eller hash(bootstrap) != bootstrap_pin {
        kast "ci-runtime: bootstrap samsvarar ikkje med eksplisitt/godkjend SHA-256"
    }
    la val = cgp.vel(root, "linux-x86_64", "linux-x86_64")
    hvis tekst(val["status"]) != "ok" { kast "ci-runtime: " + tekst(val["melding"]) }
    la cg_rel: tekst = tekst(val["rel"])
    la cg: tekst = root + "/" + cg_rel
    la cg_sha = hash(cg)
    hvis cg_sha != pin(allow, cg_rel) { kast "ci-runtime: codegen samsvarar ikkje med godkjend pin" }
    la src: tekst = cgp.srchash(root, "linux-x86_64")
    la deps: tekst = cgp.depshash(root, "linux-x86_64")
    la runtime_sources = cgp.lukking(root, "selfhost/nc_main.no")
    la runtime_sha: tekst = cgp.hash_filer(root, runtime_sources)
    hvis lengde(runtime_sha) != 64 { kast "ci-runtime: kan ikkje hashe fullhost-kjeldene" }
    la miljø = grunnmiljø(root)
    miljø["NORSCODE_NATIVE_BIN"] = bootstrap
    // Always regenerate both L5 generations; a warm fragment cache is not proof.
    la l5 = køyr(root, ut, "l5", bootstrap, ["selfcompile-l5"], miljø, 1800000)
    hvis ikkje builtin.contains(l5, "=== L5: BESTÅTT ===") { kast "ci-runtime: L5 manglar byte-paritet" }
    la driver_ncb: tekst = ut + "/compiler_driver.ncb.json"
    la driver_exe: tekst = ut + "/compiler_driver"
    la driver_functions = materialiser_driver(root, driver_ncb)
    bygg_native(root, ut, cg, driver_ncb, driver_exe, "compiler-driver")
    la ncb: tekst = ut + "/nc_main_fullhost.ncb.json"
    miljø["NC_FULLHOST_COMPILER"] = driver_exe
    miljø["NC_FULLHOST_REUSE"] = "0"
    miljø["NC_FULLHOST_DIR"] = ut + "/fragments"
    miljø["NC_FULLHOST_OUT"] = ncb
    miljø["NC_MAT_ROT"] = "selfhost.nc_main"
    miljø["NC_MAT_ENTRY"] = "selfhost.nc_main.start"
    miljø["NC_MAT_SPECS"] = ""
    miljø["NC_MAT_LIST"] = ""
    køyr(root, ut, "fullhost", bootstrap, ["run", root + "/tools/materialize_nc_main_fullhost_candidate.no"], miljø, 1800000)
    la kandidat: tekst = ut + "/norscode_native"
    bygg_native(root, ut, cg, ncb, kandidat, "runtime")
    // Check the FINAL path and its executable mode. A copy/rename can lose mode.
    la smoke = køyr(root, ut, "selftest", kandidat, ["selftest"], grunnmiljø(root), 120000)
    hvis ikkje builtin.contains(smoke, "=== nc_main.no selftest ===") eller ikkje builtin.contains(smoke, "test OK") {
        kast "ci-runtime: kandidaten manglar levande selftest-markørar"
    }
    hvis cgp.srchash(root, "linux-x86_64") != src eller cgp.depshash(root, "linux-x86_64") != deps eller hash(cg) != cg_sha eller
       cgp.hash_filer(root, cgp.lukking(root, "selfhost/nc_main.no")) != runtime_sha {
        kast "ci-runtime: codegen/kjelder endra seg under bygget"
    }
    la report = {"schema": "norscode-ci-runtime-v1", "status": "ok", "source_commit": env("GITHUB_SHA"),
        "bootstrap_sha256": bootstrap_pin, "codegen_sha256": cg_sha,
        "codegen_source_sha256": src, "codegen_dependencies_sha256": deps,
        "runtime_sources_sha256": runtime_sha, "runtime_source_files": lengde(runtime_sources),
        "compiler_driver_functions": driver_functions, "l5_byte_parity": sann,
        "ncb_sha256": hash(ncb), "candidate_path": kandidat, "candidate_sha256": hash(kandidat),
        "unresolved_builtins": 0, "unexpected_builtins": 0, "selftest": "passed", "promoted": usann}
    fil_skriv(ut + "/build.json", builtin.json_skriv(report) + "\n")
    skriv("[ci-runtime] OK: " + kandidat + " sha256=" + tekst(report["candidate_sha256"]) + "\n")
}

funksjon start() -> heiltall {
    la root: tekst = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la ut: tekst = root + "/build/ci-runtime"
    prøv {
        hvis ikkje filops.lag_katalogar(ut) { kast "ci-runtime: kan ikkje opprette " + ut }
        hvis builtin.fil_finnes(ut + "/build.json") { filops.slett_fil(ut + "/build.json") }
        hvis builtin.fil_finnes(ut + "/failure.log") { filops.slett_fil(ut + "/failure.log") }
        bygg(root, ut)
    } fang (e) {
        prøv { fil_skriv(ut + "/failure.log", tekst(e) + "\n") } fang (e2) {}
        skriv("[ci-runtime] FEIL: " + tekst(e) + "\n")
        returner 1
    }
    returner 0
}
