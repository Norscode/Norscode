bruk selfhost.ncb_serde som serde
// Bygg komplett native host-bundle frå verifisert L5-kompilator og nc_main.
// Ingen precompiled kjeldeartefaktar blir lesne her; inngangane er eksplisitte.

funksjon env(namn: tekst, standard: tekst) -> tekst {
    prøv {
        la verdi = miljo_hent(namn)
        hvis verdi != "" { returner verdi }
    } fang (e) { }
    returner standard
}

funksjon slå_saman(dest, src) -> heiltall {
    la nøklar = builtin.nøkler(src)
    la i: heiltall = 0
    mens i < lengde(nøklar) {
        dest[nøklar[i]] = src[nøklar[i]]
        i = i + 1
    }
    returner lengde(nøklar)
}

funksjon slå_saman_prefiks(dest, src, prefiks: tekst) -> heiltall {
    hvis prefiks == "" { returner slå_saman(dest, src) }
    la nøklar = builtin.nøkler(src)
    la lagt_til: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(nøklar) {
        la namn = nøklar[i]
        hvis builtin.starts_with(namn, prefiks) {
            dest[namn] = src[namn]
            lagt_til = lagt_til + 1
        }
        i = i + 1
    }
    returner lagt_til
}

funksjon slå_saman_metadata(dest, src) -> heiltall {
    hvis ikkje finnes_nøkkel(dest, "module_initializers") { dest["module_initializers"] = [] }
    hvis ikkje finnes_nøkkel(dest, "global_names") { dest["global_names"] = {} }
    hvis finnes_nøkkel(src, "module_initializers") {
        la initializers = src["module_initializers"]
        la i: heiltall = 0
        mens i < lengde(initializers) {
            la dest_initializers = dest["module_initializers"]
            la finst = usann
            la j: heiltall = 0
            mens j < lengde(dest_initializers) {
                hvis dest_initializers[j] == initializers[i] { finst = sann }
                j = j + 1
            }
            hvis ikkje finst { legg_til(dest_initializers, initializers[i]) }
            i = i + 1
        }
    }
    hvis finnes_nøkkel(src, "global_names") {
        la modular = nøkler(src["global_names"])
        la dest_globalar = dest["global_names"]
        la src_globalar = src["global_names"]
        la i: heiltall = 0
        mens i < lengde(modular) {
            dest_globalar[modular[i]] = src_globalar[modular[i]]
            i = i + 1
        }
    }
    returner 0
}

funksjon slå_saman_hovud_utan_compiler_overstyring(dest, src) -> heiltall {
    la nøklar = builtin.nøkler(src)
    la lagt_til: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(nøklar) {
        la namn = nøklar[i]
        hvis builtin.starts_with(namn, "selfhost.nc_main.") eller ikkje finnes_nøkkel(dest, namn) {
            dest[namn] = src[namn]
            lagt_til = lagt_til + 1
        }
        i = i + 1
    }
    returner lagt_til
}

funksjon start() -> heiltall {
    la compiler_sti = env("NORSCODE_HOST_COMPILER_NCB", "build/l5/compiler_v1.ncb.json")
    la main_sti = env("NORSCODE_HOST_MAIN_NCB", "build/nc_main_argv_module.ncb.json")
    la semantic_sti = env("NORSCODE_HOST_SEMANTIC_NCB", "build/semantic_validation_real_module.ncb.json")
    la ast_sti = env("NORSCODE_HOST_AST_NCB", "build/ast_module.ncb.json")
    la overlay_stiar = env("NORSCODE_HOST_OVERLAY_NCBS", "")
    la overlay_prefiks = env("NORSCODE_HOST_OVERLAY_PREFIX", "")
    la ut_sti = env("NORSCODE_HOST_BUNDLE_OUTPUT", "build/native_host_candidate.ncb.json")

    hvis ikkje fil_finnes(compiler_sti) { kast "manglar L5-kompilator: " + compiler_sti }
    hvis ikkje fil_finnes(main_sti) { kast "manglar nc_main-kandidat: " + main_sti }

    la compiler = serde.les_fil(compiler_sti)
    la main = serde.les_fil(main_sti)
    hvis tekst(main["entry"]) != "selfhost.nc_main.start" {
        kast "nc_main-modulen har feil entry: " + tekst(main["entry"]) +
             " (venta selfhost.nc_main.start)"
    }
    la functions = compiler["functions"]
    hvis ikkje finnes_nøkkel(compiler, "module_initializers") { compiler["module_initializers"] = [] }
    hvis ikkje finnes_nøkkel(compiler, "global_names") { compiler["global_names"] = {} }
    la compiler_tal = lengde(builtin.nøkler(functions))
    la main_tal = slå_saman_hovud_utan_compiler_overstyring(functions, main["functions"])
    slå_saman_metadata(compiler, main)
    la semantic_tal = 0
    hvis fil_finnes(semantic_sti) {
        la semantic = serde.les_fil(semantic_sti)
        semantic_tal = slå_saman(functions, semantic["functions"])
        slå_saman_metadata(compiler, semantic)
        functions["selfhost.semantic_validation_real.real_semantic_analyser"] =
            functions["selfhost.semantic_validation_real.semantic_analyser"]
        functions["selfhost.semantic_validation_real.real_semantic_has_errors"] =
            functions["selfhost.semantic_validation_real.semantic_has_errors"]
        functions["selfhost.semantic_validation_real.real_semantic_validate_program"] =
            functions["selfhost.semantic_validation_real.semantic_validate_program"]
    }
    hvis fil_finnes(ast_sti) {
        la ast = serde.les_fil(ast_sti)
        slå_saman(functions, ast["functions"])
        slå_saman_metadata(compiler, ast)
    }
    la overlay_tal: heiltall = 0
    hvis overlay_stiar != "" {
        la stiar = builtin.split(overlay_stiar, "\n")
        la oi: heiltall = 0
        mens oi < lengde(stiar) {
            la overlay_sti = builtin.trim(stiar[oi])
            hvis overlay_sti != "" {
                hvis ikkje fil_finnes(overlay_sti) { kast "manglar host-overlay: " + overlay_sti }
                la overlay = serde.les_fil(overlay_sti)
                overlay_tal = overlay_tal + slå_saman_prefiks(functions, overlay["functions"], overlay_prefiks)
                slå_saman_metadata(compiler, overlay)
            }
            oi = oi + 1
        }
    }

    compiler["entry"] = env("NORSCODE_HOST_ENTRY", "selfhost.nc_main.start")
    compiler["imports"] = []
    compiler["route_handlers"] = []
    compiler["dependency_providers"] = {}
    compiler["guard_providers"] = {}
    compiler["request_middlewares"] = []
    compiler["response_middlewares"] = []
    compiler["error_middlewares"] = []
    compiler["startup_hooks"] = []
    compiler["shutdown_hooks"] = []
    compiler["tests"] = {}

    la ut = builtin.json_stringify(compiler)
    fil_skriv(ut_sti, ut)
    skriv("native-host-bundle: " + tekst_fra_heltall(compiler_tal) +
          " compiler + " + tekst_fra_heltall(main_tal) +
          " main/import-funksjonar + " + tekst_fra_heltall(overlay_tal) +
          " overlay-funksjonar, " + tekst_fra_heltall(lengde(ut)) + " byte\n")
    returner 0
}
