// tools/backup_native_stage0_v723.no — shellfri backup av dist og macOS stage0

bruk std.filops som filops

funksjon linje(melding: tekst) -> heiltall { skriv(melding + "\n") returner 0 }

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon backup(root: tekst, src_rel: tekst, out_name: tekst, stamp: tekst) -> bool {
    la src = root + "/" + src_rel
    hvis ikkje fil_finst(src) { returner sann }
    la rel = "build/backups/native_v721/" + out_name + "." + stamp + ".bak"
    hvis ikkje filops.kopier2(src, root + "/" + rel) { returner usann }
    linje("Backup: " + rel)
    returner sann
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la stamp = tekst_fra_heltall(builtin.tid_ms())
    hvis ikkje filops.lag_katalogar(root + "/build/backups/native_v721") { returner 1 }
    hvis ikkje backup(root, "dist/norscode_native", "norscode_native", stamp) { returner 1 }
    hvis ikkje backup(root, "bootstrap/stage0/norscode-macos-arm64", "norscode-macos-arm64", stamp) { returner 1 }
    linje("OK: backup ferdig.")
    returner 0
}
