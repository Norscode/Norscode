// Miljøbasert plattformkontekst for committed stage0-ar utan system_info.

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon root() -> tekst {
    la verdi = env("NORSCODE_ROOT")
    hvis verdi == "" { verdi = env("GITHUB_WORKSPACE") }
    hvis verdi == "" { verdi = env("PWD") }
    hvis verdi == "" { verdi = "." }
    returner verdi
}

funksjon system() -> tekst {
    la verdi = env("NORSCODE_HOST_OS")
    hvis verdi == "" { verdi = env("RUNNER_OS") }
    hvis verdi == "" { verdi = env("OSTYPE") }
    la låg = builtin.lower(verdi)
    hvis builtin.starts_with(låg, "darwin") eller låg == "macos" { returner "Darwin" }
    hvis builtin.starts_with(låg, "linux") { returner "Linux" }
    hvis builtin.starts_with(låg, "win") { returner "Windows" }
    returner verdi
}

funksjon er_macos() -> boolsk { returner builtin.lower(system()) == "darwin" }
