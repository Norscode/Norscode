// tools/linux_random_hex_rebuild_check_v733.no — trygg Linux-sjekk utan stage0-skriving

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon køyr(root: tekst, argv: liste_tekst) -> bool {
    la res = prosess.køyr(root + "/bin/nc", argv, root, {}, 600000)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon vis_binærtreff(sti: tekst, needle: tekst, label: tekst) -> bool {
    prøv {
        la data = builtin.bytes_to_text(builtin.fil_les_binær(sti))
        hvis builtin.index_of(data, needle) >= 0 {
            linje(needle + " funne i " + label)
        } ellers {
            linje(needle + " ikkje funne i " + label)
        }
        returner sann
    } fang (e) {
        linje("Klarte ikkje lese " + label + ": " + tekst(e))
        returner usann
    }
    returner usann
}

funksjon start() -> heiltall {
    la info = builtin.system_info()
    la os = builtin.lower(tekst(info["system"]))
    la arch = builtin.lower(tekst(info["machine"]))
    la root = tekst(info["cwd"])

    hvis os != "linux" {
        linje("FEIL: Dette scriptet skal køyrast på Linux, ikkje " + os + ".")
        returner 1
    }

    hvis arch == "x86_64" eller arch == "amd64" {
        linje("OK: Linux x86_64/amd64")
    } ellers {
        linje("FEIL: Krever Linux x86_64/amd64 for denne løypen. Fant " + arch)
        returner 1
    }

    linje("")
    linje("1. Check VM og serve_runner")
    hvis ikkje køyr(root, ["check", "selfhost/vm.no"]) { returner 1 }
    hvis ikkje køyr(root, ["check", "selfhost/serve_runner.no"]) { returner 1 }

    linje("")
    linje("2. Check v701 og v731 app")
    køyr(root, ["check", "prosjekter/NorscodeWeb/app_random_session_module_demo_v701.no"])
    hvis ikkje køyr(root, ["check", "prosjekter/NorscodeWeb/app_linux_stage0_random_hex_plan_v731.no"]) { returner 1 }

    linje("")
    linje("3. Verifiser eksisterende native")
    hvis ikkje køyr(root, ["run", "prosjekter/NorscodeWeb/app_linux_stage0_random_hex_plan_v731.no"]) { returner 1 }

    linje("")
    linje("4. Sjekk om random_hex finnes i dist/stage0")
    vis_binærtreff(root + "/dist/norscode_native", "random_hex", "dist")
    vis_binærtreff(root + "/bootstrap/stage0/norscode-linux-x86_64", "random_hex", "linux stage0")

    linje("")
    linje("Neste: bare rebuild hvis du har egen Linux stage0-løype klar. Ikke overskriv stage0 automatisk.")
    returner 0
}
