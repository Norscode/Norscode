// tools/omg_batch_verify.no — verifiser BATCH/flat-link-vegen (ncval_plan +
// ncval_compile_range + ncval_link_flat med M3-lamaddr/M6-throw_dispatch) ende-til-
// ende på Linux ARM64 ELF, i ÉIN codegen-load. Speglar elf_batch_host plan→compile→
// link, men in-process (ingen run-ncb-pure-subprosess). Ut: build/diff/elf_<navn>
// (statisk aarch64-ELF) — køyr i Docker linux/arm64, samanlikn exit mot forventa.
bruk selfhost.native_execution.macho_arm64_codegen som arm64
bruk selfhost.native_execution.elf_arm64_emitter som elf

funksjon bygg_ein(root: tekst, navn: tekst) -> tekst {
    la ncb = builtin.json_parse_raw(builtin.fil_les(root + "/tools/fixtures/ncb_arm64/" + navn + ".ncb.json"))
    la plan = arm64.ncval_plan(ncb)
    hvis tekst(plan["ok"]) != "sann" { returner navn + ": PLAN-FEIL " + tekst(plan["error"]) }
    la order = plan["order"]
    la res = arm64.ncval_compile_range(ncb, "linux", order, plan["globals"], 0, lengde(order))
    hvis tekst(res["ok"]) != "sann" { returner navn + ": COMPILE-FEIL " + tekst(res["error"]) }
    la image = []
    la fn_meta = []
    la cf = 0
    mens cf < lengde(res["frags"]) {
        la fr = res["frags"][cf]
        legg_til(fn_meta, {"name": fr["name"], "base": lengde(image), "patches": fr["patches"]})
        la w = fr["words"]
        la wi = 0
        mens wi < lengde(w) { legg_til(image, w[wi])  wi = wi + 1 }
        cf = cf + 1
    }
    la lr = arm64.ncval_link_flat("linux", image, fn_meta, plan["globals"])
    hvis tekst(lr["ok"]) != "sann" { returner navn + ": LINK-FEIL " + tekst(lr["error"]) }
    la elfbytes = elf.bygg_program(lr["image"])
    la ut = root + "/build/diff/elf_" + navn
    builtin.fil_skriv_binær(ut, elfbytes)
    prøv { builtin.fil_sett_kjorbar(ut) } fang (e) {}
    returner navn + ": ELF ok (" + tekst(lengde(elfbytes)) + " bytes)"
}

funksjon start() -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")  hvis root == "" { root = "." }
    la fix = ["nc_closure", "nc_nested", "nc_carg", "nc_method", "nc_marg", "nc_mdisp",
              "nc_m10", "nc_destr", "nc_optional", "nc_spread",
              "diff_unntakstype", "diff_finally", "integ1", "t_prop2"]
    la feil = 0
    for n i fix {
        prøv {
            la linje = bygg_ein(root, n)
            skriv(linje + "\n")
            hvis builtin.contains(linje, "FEIL") { feil = feil + 1 }
        } fang (e) { skriv(n + ": UNNTAK " + tekst(e) + "\n")  feil = feil + 1 }
    }
    skriv("=== batch-ELF: " + tekst(lengde(fix)) + " program, " + tekst(feil) + " feil ===\n")
    returner feil
}
