// Ekte Windows-køyring og kjeldebunden attestasjon.
//
// Porten køyrer berre på ein faktisk Windows x86_64-host. All orkestrering
// skjer gjennom versjonerte Norscode-ABI-ar: systeminfo, filesystem, SHA-256
// og strukturert executable/argv. Krysskompilering og Wine er ikkje nok.

bruk std.runtime_filesystem som native_fs
bruk std.sha256 som sha256
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon systemfelt(namn: tekst) -> tekst {
    prøv { returner builtin.lower(tekst(builtin.system_info()[namn])) } fang (e) { returner "" }
    returner ""
}

funksjon er_windows() -> boolsk {
    la system = systemfelt("system")
    la os = systemfelt("os")
    returner builtin.contains(system, "windows") eller builtin.contains(os, "windows")
}

funksjon er_windows_x64() -> boolsk {
    la maskin = systemfelt("machine")
    hvis maskin == "" { maskin = systemfelt("arch") }
    returner maskin == "amd64" eller maskin == "x86_64"
}

funksjon fil_finst(sti: tekst) -> boolsk {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon fil_sha256(sti: tekst) -> tekst {
    prøv { returner builtin.sha256_bytes(builtin.fil_les_binær(sti)) } fang (e) {
        prøv { returner sha256.hash_bytes(builtin.fil_les_binær(sti)) } fang (e2) { returner "" }
    }
    returner ""
}

funksjon sluttmarkør(bytes, markør: tekst) -> boolsk {
    hvis lengde(bytes) < lengde(markør) { returner usann }
    la start = lengde(bytes) - lengde(markør)
    la i: heiltall = 0
    mens i < lengde(markør) {
        hvis bytes[start + i] != (builtin.char_code(markør[i]) & 255) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon har_embedded_ncb(sti: tekst) -> boolsk {
    prøv {
        la bytes = builtin.fil_les_binær(sti)
        returner sluttmarkør(bytes, "NORSCODE_NCB_IMAGE_V1") eller
            sluttmarkør(bytes, "NORSCODE_NCB_TEXT_V1")
    } fang (e) { returner usann }
    returner usann
}

funksjon køyr(root: tekst, native: tekst, argv: liste_tekst,
              ekstra_miljø: ordbok_tekst, namn: tekst) -> boolsk {
    la miljø: ordbok_tekst = {
        "NORSCODE_ROOT": root,
        "NORSCODE_NATIVE_BIN": native,
        "NC_NATIVE": native,
        "NORSCODE_ENABLE_EXEC_PROSESS": "1",
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root
    }
    la nøklar = builtin.nøkler(ekstra_miljø)
    la i: heiltall = 0
    mens i < lengde(nøklar) {
        miljø[nøklar[i]] = tekst(ekstra_miljø[nøklar[i]])
        i = i + 1
    }
    la resultat = prosess.køyr(native, argv, root, miljø, 600000)
    prosess.skriv_resultat(resultat)
    hvis ikkje prosess.ok(resultat) {
        skriv("[FAIL] Windows-attestasjon " + namn + "\n")
        returner usann
    }
    skriv("[OK] Windows-attestasjon " + namn + "\n")
    returner sann
}

funksjon gyldig_commit(verdi: tekst) -> boolsk {
    hvis lengde(verdi) != 40 og lengde(verdi) != 64 { returner usann }
    la heks = "0123456789abcdefABCDEF"
    la i: heiltall = 0
    mens i < lengde(verdi) {
        hvis builtin.index_of(heks, verdi[i]) < 0 { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon kjelde_commit() -> tekst {
    la commit = env("NORSCODE_SOURCE_COMMIT")
    hvis commit == "" { commit = env("GITHUB_SHA") }
    returner commit
}

funksjon start() -> heiltall {
    hvis ikkje er_windows() {
        skriv("[FAIL] Windows-attestasjon krev faktisk Windows-host\n")
        returner 2
    }
    hvis ikkje er_windows_x64() {
        skriv("[FAIL] Windows-attestasjon krev Windows x86_64/AMD64-host\n")
        returner 2
    }

    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/build/windows/norscode_native_windows_x86_64.exe" }
    la backend = env("NORSCODE_WINDOWS_BACKEND_SMOKE")
    hvis backend == "" { backend = root + "/build/windows/nc_windows_backend_smoke_x86_64.exe" }
    la app = env("NORSCODE_WINDOWS_APPCONTAINER_SMOKE")
    hvis app == "" { app = root + "/build/windows/nc_windows_appcontainer_smoke_x86_64.exe" }

    hvis ikkje fil_finst(native) eller ikkje fil_finst(backend) eller ikkje fil_finst(app) {
        skriv("[FAIL] Windows-attestasjon manglar runtime eller smoke-binær\n")
        returner 1
    }
    la native_hash = fil_sha256(native)
    la backend_hash = fil_sha256(backend)
    la app_hash = fil_sha256(app)
    hvis native_hash == "" eller backend_hash == "" eller app_hash == "" {
        skriv("[FAIL] Windows-attestasjon kunne ikkje hashe runtime/smoke i Norscode\n")
        returner 1
    }
    hvis ikkje har_embedded_ncb(native) {
        skriv("[FAIL] Windows-attestasjon nektar runtime utan innebygd NCB-image\n")
        returner 1
    }

    hvis ikkje køyr(root, native, ["run", "tools/windows_runtime_execution_gate.no"], {
        "NORSCODE_WINDOWS_BACKEND_SMOKE": backend,
        "NORSCODE_WINDOWS_APPCONTAINER_SMOKE": app
    }, "backend og AppContainer") { returner 1 }

    la testar: liste_tekst = [
        "tests/test_windows_native_network.no",
        "tests/test_windows_schannel_client.no",
        "tests/test_windows_iocp_scheduler.no",
        "tests/test_windows_filesystem_iocp.no",
        "tests/test_argon2_native.no",
        "tests/test_acme_sign_native.no",
        "tests/test_acme_verify_native.no"
    ]
    la i: heiltall = 0
    mens i < lengde(testar) {
        hvis ikkje køyr(root, native, ["test"], {
            "NC_TEST_FILE": testar[i],
            "NC_VERBOSE": "1"
        }, testar[i]) { returner 1 }
        i = i + 1
    }

    la commit = kjelde_commit()
    hvis ikkje gyldig_commit(commit) {
        skriv("[FAIL] Windows-attestasjon krev NORSCODE_SOURCE_COMMIT eller GITHUB_SHA\n")
        returner 1
    }
    la workflow_sha = env("GITHUB_SHA")
    hvis workflow_sha != "" og workflow_sha != commit {
        skriv("[FAIL] Windows-attestasjon GITHUB_SHA samsvarer ikkje med kjeldecommit\n")
        returner 1
    }

    la rapport: ordbok_tekst = {}
    rapport["schema"] = "norscode-windows-runtime-attestation-v1"
    rapport["status"] = "verified"
    rapport["platform"] = "windows"
    rapport["architecture"] = systemfelt("machine")
    rapport["source_commit"] = commit
    rapport["runtime_sha256"] = native_hash
    rapport["backend_smoke_sha256"] = backend_hash
    rapport["appcontainer_smoke_sha256"] = app_hash
    rapport["tests"] = "backend,appcontainer,network,schannel_tls13,iocp,filesystem,argon2id,acme_sign,acme_verify"
    rapport["repository"] = env("GITHUB_REPOSITORY")
    rapport["workflow"] = env("GITHUB_WORKFLOW")
    rapport["run_id"] = env("GITHUB_RUN_ID")
    rapport["run_attempt"] = env("GITHUB_RUN_ATTEMPT")
    rapport["runner_name"] = env("RUNNER_NAME")

    la output = env("NORSCODE_WINDOWS_ATTESTATION_OUTPUT")
    hvis output == "" { output = root + "/reports/windows-runtime-attestation.json" }
    la laga = native_fs.native_lag_mappe(root, "reports")
    hvis laga["status"] != "created" og laga["status"] != "ok" og laga["status"] != "exists" {
        skriv("[FAIL] Windows-attestasjon kunne ikkje lage rapportmappe\n")
        returner 1
    }
    prøv { builtin.fil_skriv(output, builtin.json_skriv(rapport) + "\n") } fang (e) {
        skriv("[FAIL] Windows-attestasjon kunne ikkje skrive rapport: " + tekst(e) + "\n")
        returner 1
    }
    skriv("[OK] Ekte Windows runtime-attestasjon: " + output + "\n")
    returner 0
}
