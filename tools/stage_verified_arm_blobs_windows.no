// Explicit AOT closure: the Windows CLI does not add the Linux-only implicit
// native_gap imports. The module dispatches to the existing SChannel backend.
bruk std.native_gap som native_gap
bruk std.desimaltall_tekst som desimaltall_tekst
bruk tools.stage_verified_arm_blobs som staging

funksjon start() -> heiltall { returner staging.start() }
