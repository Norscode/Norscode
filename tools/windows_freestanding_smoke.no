// tools/windows_freestanding_smoke.no — køyrd AV den frittståande windows-kandidaten
// (via ci_shell_runner-adapteren på windows-latest). Øver process.exec på EKTE Windows:
// process_spawn_argv spawnar `cmd /c echo WIN-SPAWN-OK` og fangar stdout. Exit 0 =
// status ferdig OG «WIN-SPAWN-OK» i fanga stdout (dvs. CreateProcessW + pipe-fang verkar).
bruk std.runtime.process_abi som abi
funksjon start() -> heiltall {
    // Positiv kontroll utan isolasjon. Dei avviste sandboxprofilane blir testa
    // separat i test_windows_appcontainer_failclosed.no paa same kandidat.
    la req = abi.request("cmd", ["/c", "echo", "WIN-SPAWN-OK"], "", "", 10000, 65536)
    la svar = builtin.process_spawn_argv(req)
    skriv("WINSPAWN status=" + tekst(svar["status"]) + " exit=" + tekst(svar["exit_code"]) +
          " out=[" + tekst(svar["stdout"]) + "]\n")
    hvis tekst(svar["status"]) == "ferdig" og heltall_fra_tekst(tekst(svar["exit_code"])) == 0 og builtin.contains(tekst(svar["stdout"]), "WIN-SPAWN-OK") {
        skriv("WINSPAWN OK\n")
        returner 0
    }
    skriv("WINSPAWN FEIL\n")
    returner 1
}
