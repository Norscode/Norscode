// tools/windows_freestanding_smoke.no — køyrd AV den frittståande windows-kandidaten
// (via ci_shell_runner-adapteren på windows-latest) for å prove at han faktisk kompilerer,
// køyrer og gjer stdout + fil-I/O på ekte Windows. Exit 0 = alt grønt.
funksjon start() -> heiltall {
    skriv("WINSMOKE-OK\n")
    la p = "winfio_smoke.txt"
    prøv { fil_skriv(p, "FIO-123") } fang (e) { skriv("FIO-SKRIV-FEIL: " + tekst(e) + "\n") returner 1 }
    la s = ""
    prøv { s = fil_les(p) } fang (e2) { skriv("FIO-LES-FEIL: " + tekst(e2) + "\n") returner 1 }
    hvis s == "FIO-123" { skriv("FIO-OK\n") returner 0 }
    skriv("FIO-FEIL: fekk '" + s + "'\n")
    returner 1
}
