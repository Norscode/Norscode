// Release-gate for eksplisitt fase-5 Linux x86_64 Zig Argon2id-kandidat.
// Alle vert- og containerkall brukar strukturert executable/argv.

bruk tools.docker_runner som docker_runner
bruk tools.process_runner som prosess

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon køyr_container(docker: tekst, root: tekst, container: tekst,
                         argv: liste_tekst, timeout_ms: heiltall) -> boolsk {
    la resultat = docker_runner.køyr_i(docker, root, container, argv, timeout_ms)
    prosess.skriv_resultat(resultat)
    returner prosess.ok(resultat)
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = tekst(builtin.system_info()["cwd"]) }
    la bygg = root + "/tools/build_linux_zig_argon_candidate_v3606.no"
    la bygg_miljø = {"NORSCODE_ROOT": root, "NORSCODE_ZIG": env("NORSCODE_ZIG")}
    skriv("== Linux portable Argon2id release-gate v3607 ==\n")
    la bygg_resultat = prosess.køyr(root + "/bin/nc", ["run", bygg], root, bygg_miljø, 1800000)
    prosess.skriv_resultat(bygg_resultat)
    hvis ikkje prosess.ok(bygg_resultat) { skriv("[FAIL] Kandidat kunne ikkje byggjast\n") returner 1 }

    la kandidat_rel = "build/v3600/linux/norscode_native_linux_x86_64_v3605_zigargon"
    la image = env("NORSCODE_DOCKER_IMAGE")
    hvis image == "" { image = "ubuntu:24.04" }
    la docker = docker_runner.finn()
    hvis ikkje docker_runner.tilgjengeleg(docker, root) { skriv("[FAIL] Docker er ikkje tilgjengeleg\n") returner 1 }
    la container = docker_runner.opprett(docker, root, root, "linux/amd64", image, "zig-argon-release-v3607")
    hvis container == "" { returner 1 }
    hvis ikkje docker_runner.start(docker, root, container) eller
       ikkje docker_runner.installer_sqlite_runtime(docker, root, container) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    la grunn: liste_tekst = [
        "env", "NODE_BIN=/nonexistent", "NORSCODE_ROOT=/work",
        "NORSCODE_ENABLE_EXEC_PROSESS=1",
        "NORSCODE_VM_CAPABILITIES=env.read,process.exec,disk.read,disk.write,net.listen,net.connect,net.tcp,net.udp,net.dns",
        "NORSCODE_VM_DISK_ROOT=/work,.,/tmp,/private/tmp"
    ]
    la argon = grunn + ["NORSCODE_CMD=run", "NORSCODE_FILE=/work/tests/test_argon2_native.no", "/work/" + kandidat_rel]
    hvis ikkje køyr_container(docker, root, container, argon, 300000) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    la gap = grunn + ["NORSCODE_CMD=run", "NORSCODE_FILE=/work/tools/native_runtime_gap_gate_v3001.no",
        "NORSCODE_NATIVE_GAP_BIN=/work/" + kandidat_rel, "/work/" + kandidat_rel]
    hvis ikkje køyr_container(docker, root, container, gap, 600000) {
        docker_runner.fjern(docker, root, container)
        returner 1
    }
    la full = grunn + ["NORSCODE_CMD=run", "NORSCODE_FILE=/work/tools/nc_test.no",
        "NORSCODE_NATIVE_BIN=/work/" + kandidat_rel, "NC_TEST_SHARDS=8", "TEST_TIMEOUT=20",
        "/work/bootstrap/stage0/norscode-linux-x86_64"]
    la full_ok = køyr_container(docker, root, container, full, 3600000)
    docker_runner.fjern(docker, root, container)
    hvis ikkje full_ok { skriv("[FAIL] Linux portable Argon2id release-gate feila\n") returner 1 }
    skriv("[OK] Linux portable Argon2id release-gate er grøn\n")
    returner 0
}
