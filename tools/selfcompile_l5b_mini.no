// tools/selfcompile_l5b_mini.no — L5b smoke: liten bundle, VM Gen2

bruk tools.process_runner som prosess

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon les_fil_trygt(sti: tekst) -> tekst {
    prøv { returner fil_les(sti) } fang (e) { returner "" }
    returner ""
}

funksjon filer_identiske(a: tekst, b: tekst) -> bool {
    hvis ikkje fil_finst(a) eller ikkje fil_finst(b) { returner usann }
    returner les_fil_trygt(a) == les_fil_trygt(b)
}

funksjon køyr_native(native: tekst, root: tekst, miljø: ordbok_tekst, timeout_ms: heiltall) -> boolsk {
    la res = prosess.køyr(native, [], root, miljø, timeout_ms)
    prosess.skriv_resultat(res)
    returner prosess.ok(res)
}

funksjon materialiser_fixture(root: tekst, native: tekst, driver: tekst, rel_sti: tekst, modul: tekst, utfil: tekst) -> bool {
    prøv {
        hvis fil_finst(utfil) { builtin.fil_slett(utfil) }
    } fang (e) {
        linje("FEIL: kan ikkje nullstille fixture-kandidat " + utfil)
        returner usann
    }
    la miljø = {
        "NORSCODE_ROOT": root,
        "NORSCODE_L5B_COMPILE_SOURCE": root + "/" + rel_sti,
        "NORSCODE_L5B_COMPILE_OUTPUT": utfil,
        "NORSCODE_L5B_COMPILE_MODULE": modul,
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/selfhost/tooling/ncb_host_run_entry.no",
        "NORSCODE_HOST_NCB_FILE": driver,
        "NORSCODE_NCB_FILE": driver,
        "NORSCODE_VM_SOURCE": "1"
    }
    hvis ikkje køyr_native(native, root, miljø, 120000) eller ikkje fil_finst(utfil) {
        linje("FEIL: kunne ikkje materialisere " + rel_sti)
        returner usann
    }
    returner sann
}

funksjon bundle_fixture(root: tekst, native: tekst, driver: tekst, utfil: tekst, kandidat_dir: tekst, cache_raw: tekst) -> bool {
    la cache = cache_raw
    hvis cache == "" { cache = "1" }
    la miljø = {
        "NORSCODE_ROOT": root,
        "NORSCODE_VM_FAST": "1",
        "NORSCODE_USE_PRECOMPILED_SELFHOST": cache,
        "NORSCODE_L5B_SOURCE_CANDIDATE_DIR": kandidat_dir,
        "NORSCODE_BUNDLE_ENTRY": "selfhost.l5b_host.start",
        "NORSCODE_L5B_V1": driver,
        "NORSCODE_L5B_V2": utfil,
        "NORSCODE_BUNDLE_ARGS": bundle_args(),
        "NORSCODE_VM_CAPABILITIES": "env.read,process.exec,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": root + ",.,/tmp,/private/tmp",
        "NORSCODE_CMD": "run",
        "NORSCODE_FILE": root + "/selfhost/tooling/ncb_host_run_entry.no",
        "NORSCODE_HOST_NCB_FILE": driver,
        "NORSCODE_NCB_FILE": driver,
        "NORSCODE_VM_SOURCE": "1"
    }
    returner køyr_native(native, root, miljø, 180000)
}

funksjon bundle_args() -> tekst {
    // To små modular gjer mini-porten rask, men går framleis gjennom både
    // kjeldekompilering, funksjonsomdøyping, bundlebygging og serialisering.
    returner "l5b.mini_a=tests/fixtures/l5b_mini_a.no " +
        "l5b.mini_b=tests/fixtures/l5b_mini_b.no"
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la native = env("NORSCODE_NATIVE_BIN")
    hvis native == "" { native = root + "/dist/norscode_native" }
    la driver = root + "/build/l5/compiler_v1.ncb.json"
    la v1 = root + "/build/l5b/mini_v1.ncb.json"
    la v2 = root + "/build/l5b/mini_v2.ncb.json"
    la kandidat_dir = root + "/build/l5b/mini-source"
    la cache_raw = env("NORSCODE_USE_PRECOMPILED_SELFHOST")

    linje("=== L5b-mini (VM byte-paritet, liten bundle) ===")
    linje("")
    prøv {
        builtin.mkdir_p(root + "/build/l5b")
        builtin.mkdir_p(kandidat_dir)
    } fang (e) {
        linje("FEIL: kan ikkje opprette build/l5b: " + tekst(e))
        returner 1
    }
    // L5-kandidaten er kjeldebygd og inneheld den ferske kompilatoren.
    // Bruk han som tillitsgrunnlag i staden for stage0 sin statiske
    // kompiler_fil-dispatch.
    hvis ikkje fil_finst(driver) {
        hvis ikkje køyr_native(native, root, {
            "NORSCODE_ROOT": root,
            "NORSCODE_NATIVE_BIN": native,
            "NORSCODE_CMD": "selfcompile-l5"
        }, 300000) { returner 1 }
    }
    hvis ikkje materialiser_fixture(root, native, driver, "tests/fixtures/l5b_mini_a.no", "l5b.mini_a", kandidat_dir + "/l5b_mini_a.ncb.json") { returner 1 }
    hvis ikkje materialiser_fixture(root, native, driver, "tests/fixtures/l5b_mini_b.no", "l5b.mini_b", kandidat_dir + "/l5b_mini_b.ncb.json") { returner 1 }
    hvis ikkje bundle_fixture(root, native, driver, v1, kandidat_dir, cache_raw) { returner 1 }
    hvis ikkje bundle_fixture(root, native, driver, v2, kandidat_dir, cache_raw) { returner 1 }

    hvis ikkje fil_finst(v1) eller ikkje fil_finst(v2) {
        linje("FEIL: manglar v1/v2 bundle")
        returner 1
    }
    hvis ikkje filer_identiske(v1, v2) {
        linje("FEIL: v1 og v2 differ")
        returner 1
    }
    linje("")
    linje("=== L5b-mini: BESTÅTT ===")
    returner 0
}
