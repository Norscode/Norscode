// tools/nc_doc.no — `nc doc <modul|fil.no|mappe> [--ut <fil.md|mappe>]` (F44).
//
// Genererer markdown-dokumentasjon frå dokumentasjonskommentarar: `///`-linjer (eller
// ein samanhengande `//`/`#`-kommentarblokk) rett over ein deklarasjon, saman med
// signaturen slik han står i kjelda (parametertypar og returtype frå R3). Dekker
// funksjonar (inkl. metodar `Type.metode`), strukturar (felt + trailing-kommentar),
// grensesnitt og enum. Kommentarblokka øvst i fila (skild frå første deklarasjon med
// blank linje) blir modulomtalen. Rein kjeldeskanning — ingen VM- eller seed-endring.
//
// Argument kjem frå NC_VERKTOY_ARGV (linjeskild). Modulnamn («std.dataclasses»)
// blir løyste til sti. Utan --ut går markdown til stdout.

bruk std.runtime_filesystem som native_fs

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon args() -> liste_tekst {
    la rå = env("NC_VERKTOY_ARGV")
    la ut: liste_tekst = []
    hvis rå == "" { returner ut }
    la delar = builtin.split(rå, "\n")
    la i = 0
    mens i < lengde(delar) {
        hvis delar[i] != "" { legg_til(ut, delar[i]) }
        i = i + 1
    }
    returner ut
}

// ── Linjeklassifisering ─────────────────────────────────────────────────────────

// Innhaldet i ein kommentarlinje, eller null viss linja ikkje er kommentar.
funksjon kommentar_innhald(linje: tekst) {
    la t = builtin.trim(linje)
    hvis builtin.starts_with(t, "///") {
        returner builtin.trim(builtin.slice(t, 3, lengde(t)))
    }
    hvis builtin.starts_with(t, "//") {
        returner builtin.trim(builtin.slice(t, 2, lengde(t)))
    }
    hvis builtin.starts_with(t, "#") {
        returner builtin.trim(builtin.slice(t, 1, lengde(t)))
    }
    returner null
}

funksjon fjern_prefiks(t: tekst, prefiks: tekst) -> tekst {
    hvis builtin.starts_with(t, prefiks) { returner builtin.slice(t, lengde(prefiks), lengde(t)) }
    returner t
}

// Fjern modifikatorar slik at me ser nøkkelordet: «privat async funksjon …».
funksjon utan_modifikator(t: tekst) -> tekst {
    la r = builtin.trim(t)
    la forrige = ""
    mens forrige != r {
        forrige = r
        r = fjern_prefiks(r, "privat ")
        r = fjern_prefiks(r, "asynk ")
        r = fjern_prefiks(r, "async ")
        r = builtin.trim(r)
    }
    returner r
}

funksjon deklarasjonstype(linje: tekst) -> tekst {
    // Berre toppnivå (ingen innrykk).
    hvis lengde(linje) == 0 eller builtin.starts_with(linje, " ") eller builtin.starts_with(linje, "\t") { returner "" }
    la t = utan_modifikator(linje)
    hvis builtin.starts_with(t, "funksjon ") { returner "funksjon" }
    hvis builtin.starts_with(t, "struktur ") { returner "struktur" }
    hvis builtin.starts_with(t, "grensesnitt ") { returner "grensesnitt" }
    hvis builtin.starts_with(t, "enum ") { returner "enum" }
    returner ""
}

funksjon tell(t: tekst, tegn: tekst) -> heiltall {
    la n = 0
    la i = 0
    mens i < lengde(t) {
        hvis builtin.slice(t, i, i + 1) == tegn { n = n + 1 }
        i = i + 1
    }
    returner n
}

// Signaturen utan kroppen: alt til (men utan) første `{`; fleirlinjers parameterlister
// blir slegne saman.
funksjon signatur_av(linjer: liste_tekst, start: heiltall) -> tekst {
    la sig = ""
    la i = start
    mens i < lengde(linjer) {
        la l = builtin.trim(linjer[i])
        la ix = builtin.index_of(l, "{")
        hvis ix >= 0 {
            sig = sig + builtin.trim(builtin.slice(l, 0, ix))
            returner builtin.trim(sig)
        }
        sig = sig + l
        hvis tell(sig, "(") <= tell(sig, ")") og (i + 1 >= lengde(linjer) eller ikkje builtin.starts_with(builtin.trim(linjer[i + 1]), "->")) {
            hvis i > start eller tell(sig, "(") > 0 eller deklarasjonstype(linjer[start]) != "funksjon" {
                returner builtin.trim(sig)
            }
        }
        sig = sig + " "
        i = i + 1
    }
    returner builtin.trim(sig)
}

// ── Utval av dokumentasjon over linje `idx` ─────────────────────────────────────

funksjon doku_over(linjer: liste_tekst, idx: heiltall) -> tekst {
    la start = idx
    mens start > 0 og kommentar_innhald(linjer[start - 1]) != null {
        start = start - 1
    }
    la ut = ""
    la i = start
    mens i < idx {
        hvis ut != "" { ut = ut + "\n" }
        ut = ut + tekst(kommentar_innhald(linjer[i]))
        i = i + 1
    }
    returner ut
}

// Modulomtale: kommentarblokka øvst i fila viss ho er skild frå første kode med blank linje.
funksjon modul_doku(linjer: liste_tekst) -> tekst {
    la i = 0
    mens i < lengde(linjer) og builtin.trim(linjer[i]) == "" { i = i + 1 }
    la ut = ""
    mens i < lengde(linjer) og kommentar_innhald(linjer[i]) != null {
        hvis ut != "" { ut = ut + "\n" }
        ut = ut + tekst(kommentar_innhald(linjer[i]))
        i = i + 1
    }
    // Ei blokk som heng rett i ein deklarasjon høyrer til denne, ikkje til modulen.
    hvis i < lengde(linjer) og builtin.trim(linjer[i]) != "" og deklarasjonstype(linjer[i]) != "" { returner "" }
    returner ut
}

// Kroppslinjer (felt/variantar) til matchande `}` på nivå 0, med trailing-kommentar.
funksjon kropp_punkt(linjer: liste_tekst, start: heiltall) -> liste_tekst {
    la ut: liste_tekst = []
    la i = start + 1
    mens i < lengde(linjer) og builtin.trim(linjer[i]) != "}" og builtin.trim(linjer[i]) != "slutt" {
        la t = builtin.trim(linjer[i])
        hvis t != "" og kommentar_innhald(linjer[i]) == null {
            la ix = builtin.index_of(t, "//")
            la namn = t
            la omtale = ""
            hvis ix >= 0 {
                namn = builtin.trim(builtin.slice(t, 0, ix))
                omtale = builtin.trim(builtin.slice(t, ix + 2, lengde(t)))
            }
            hvis builtin.starts_with(namn, "funksjon ") {
                namn = namn
            }
            hvis omtale != "" { legg_til(ut, "`" + namn + "` — " + omtale) }
            ellers { legg_til(ut, "`" + namn + "`") }
        }
        i = i + 1
    }
    returner ut
}

funksjon namn_av(sig: tekst, type: tekst) -> tekst {
    la t = utan_modifikator(sig)
    t = builtin.trim(fjern_prefiks(t, type + " "))
    la ix = builtin.index_of(t, "(")
    hvis ix >= 0 { t = builtin.slice(t, 0, ix) }
    la sp = builtin.index_of(t, " ")
    hvis sp >= 0 { t = builtin.slice(t, 0, sp) }
    returner builtin.trim(t)
}

// ── Markdown for éi fil ────────────────────────────────────────────────────────

funksjon dokumenter_tekst(modulnamn: tekst, kjelde: tekst) -> tekst {
    la linjer = builtin.split(kjelde, "\n")
    la ut = "# " + modulnamn + "\n\n"
    la omtale = modul_doku(linjer)
    hvis omtale != "" { ut = ut + omtale + "\n\n" }
    la funk = ""
    la strukt = ""
    la gren = ""
    la enm = ""
    la i = 0
    mens i < lengde(linjer) {
        la type = deklarasjonstype(linjer[i])
        hvis type != "" {
            la sig = signatur_av(linjer, i)
            la doku = doku_over(linjer, i)
            la namn = namn_av(sig, type)
            hvis builtin.starts_with(namn, "_") { i = i + 1  fortsett }
            // Privat er ikkje del av flata.
            hvis builtin.starts_with(builtin.trim(linjer[i]), "privat ") { i = i + 1  fortsett }
            la blokk = "### `" + sig + "`\n\n"
            hvis doku != "" { blokk = blokk + doku + "\n\n" }
            hvis type == "struktur" eller type == "enum" eller type == "grensesnitt" {
                la punkt = kropp_punkt(linjer, i)
                la pi = 0
                mens pi < lengde(punkt) {
                    blokk = blokk + "- " + punkt[pi] + "\n"
                    pi = pi + 1
                }
                hvis lengde(punkt) > 0 { blokk = blokk + "\n" }
            }
            hvis type == "funksjon" { funk = funk + blokk }
            hvis type == "struktur" { strukt = strukt + blokk }
            hvis type == "grensesnitt" { gren = gren + blokk }
            hvis type == "enum" { enm = enm + blokk }
        }
        i = i + 1
    }
    hvis strukt != "" { ut = ut + "## Strukturar\n\n" + strukt }
    hvis gren != "" { ut = ut + "## Grensesnitt\n\n" + gren }
    hvis enm != "" { ut = ut + "## Enum\n\n" + enm }
    hvis funk != "" { ut = ut + "## Funksjonar\n\n" + funk }
    returner ut
}

// ── Sti-oppslag ────────────────────────────────────────────────────────────────

funksjon modul_til_sti(mål: tekst, root: tekst) -> tekst {
    hvis builtin.ends_with(mål, ".no") { returner mål }
    la rel = builtin.replace(mål, ".", "/")
    hvis builtin.fil_finnes(root + "/" + rel + ".no") { returner rel + ".no" }
    returner mål
}

funksjon modulnamn_av_sti(sti: tekst) -> tekst {
    la t = sti
    hvis builtin.ends_with(t, ".no") { t = builtin.slice(t, 0, lengde(t) - 3) }
    returner builtin.replace(t, "/", ".")
}

funksjon fil_liste(mål: tekst, root: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    hvis builtin.ends_with(mål, ".no") {
        legg_til(ut, mål)
        returner ut
    }
    // Modulnamn eller mappe: prøv fil først, så mappe.
    la som_fil = modul_til_sti(mål, root)
    hvis builtin.ends_with(som_fil, ".no") {
        legg_til(ut, som_fil)
        returner ut
    }
    la walk = native_fs.native_walk_files_med_suffiks(root, mål, ".no")
    hvis walk["status"] != "ok" { returner ut }
    la filer = builtin.split(walk["data"], "\n")
    la i = 0
    mens i < lengde(filer) {
        la f = builtin.trim(filer[i])
        hvis f != "" { legg_til(ut, f) }
        i = i + 1
    }
    returner ut
}

funksjon start() -> heiltall {
    la root = env("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la a = args()
    la mål = ""
    la ut_sti = ""
    la i = 0
    mens i < lengde(a) {
        hvis a[i] == "--ut" og i + 1 < lengde(a) { ut_sti = a[i + 1]  i = i + 1 }
        ellers { mål = a[i] }
        i = i + 1
    }
    hvis mål == "" {
        skriv("bruk: nc doc <modul|fil.no|mappe> [--ut <fil.md|mappe>]\n")
        returner 2
    }
    la filer = fil_liste(mål, root)
    hvis lengde(filer) == 0 {
        skriv("nc doc: fann ingen .no-filer for " + mål + "\n")
        returner 2
    }
    la samla = ""
    la fi = 0
    mens fi < lengde(filer) {
        la sti = filer[fi]
        la full = sti
        hvis ikkje builtin.starts_with(sti, "/") { full = root + "/" + sti }
        hvis ikkje builtin.fil_finnes(full) {
            skriv("nc doc: finn ikkje " + sti + "\n")
            returner 2
        }
        la md = dokumenter_tekst(modulnamn_av_sti(sti), builtin.fil_les(full))
        hvis ut_sti != "" og lengde(filer) > 1 og ikkje builtin.ends_with(ut_sti, ".md") {
            builtin.fil_skriv(ut_sti + "/" + builtin.replace(modulnamn_av_sti(sti), ".", "_") + ".md", md)
        } ellers {
            samla = samla + md + "\n"
        }
        fi = fi + 1
    }
    hvis samla != "" {
        hvis ut_sti != "" og builtin.ends_with(ut_sti, ".md") { builtin.fil_skriv(ut_sti, samla) }
        ellers { skriv(samla) }
    }
    returner 0
}
