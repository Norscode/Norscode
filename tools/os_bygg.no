// tools/os_bygg.no — byggjer eit Norscode OS-kjernebilete (K0/K1).
//
//   ./bin/nc run tools/os_bygg.no
//
// Miljø (alle valfrie):
//   OS_KJERNE   kjerne-kjelde           (standard os/kjerne/hei.no)
//   OS_BILETE   utbilete                (standard build/os/norscode_os.img)
//   OS_MODUS    demand | ivrig          (standard demand: demand-zero-heap, held med -m 256M;
//                                        ivrig = K0-identitetskart, krev ~2 GiB RAM)
//   OS_BYGG_LOKAL=1  hopp over Docker og køyr codegen lokalt (tolka på macOS)
//   OS_DOCKER_IMAGE  Docker-bilete for Linux-codegen (standard nc-x86tools:latest)
// Sjå os/boot/byggjar.no og docs/NORSCODE_OS_PLAN.md.

bruk os.boot.byggjar som byggjar

funksjon standard(namn: tekst, verdi: tekst) -> tekst {
    la v = byggjar.miljø(namn)
    hvis v == "" { returner verdi }
    returner v
}

funksjon start() -> heiltall {
    la kjelde = standard("OS_KJERNE", "os/kjerne/hei.no")
    la bilete = standard("OS_BILETE", "build/os/norscode_os.img")
    la modus = standard("OS_MODUS", "demand")
    skriv("[os_bygg] kjerne=" + kjelde + " modus=" + modus + "\n")
    la r = byggjar.bygg_kjerne(kjelde, bilete, modus)
    hvis r["feil"] != "" {
        skriv("[os_bygg] FEIL: " + r["feil"] + "\n")
        returner 1
    }
    skriv("[os_bygg] elf=" + r["elf"] + " (" + r["elf_bytes"] + " B, inngang " + r["inngang"] + ")\n")
    skriv("[os_bygg] bilete=" + r["bilete"] + " (" + r["bilete_bytes"] + " B: trampoline " + r["boot_bytes"] +
        " B, kopisider " + r["kopisider"] + ", pool frå " + r["pool_start"] + ")\n")
    skriv("[os_bygg] tid: compile " + r["ms_compile"] + " ms, codegen " + r["ms_codegen"] + " ms, pakk " + r["ms_pakk"] + " ms\n")
    returner 0
}
