// Prosessfri macOS app-installasjon med atomisk versjonslenke.

bruk std.platform som platform
bruk std.plistlib som plist
bruk std.filops som filops
bruk std.runtime_filesystem som native_fs

funksjon linje(melding: tekst) -> heiltall {
    skriv(melding + "\n")
    returner 0
}

funksjon env(namn: tekst) -> tekst {
    prøv { returner miljo_hent(namn) } fang (e) { returner "" }
    returner ""
}

funksjon fil_finst(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) } fang (e) { returner usann }
    returner usann
}

funksjon absolutt_relativ(sti: tekst) -> tekst {
    hvis ikkje builtin.starts_with(sti, "/") eller lengde(sti) <= 1 { returner "" }
    returner builtin.slice(sti, 1, lengde(sti))
}

funksjon app_metadata(app_path: tekst) -> ordbok_tekst {
    returner plist.les_fil(app_path + "/Contents/Info.plist")
}

funksjon gyldig_app_metadata(data: ordbok_tekst) -> bool {
    returner plist.get(data, "CFBundleIdentifier") != "" og
        plist.get(data, "CFBundleExecutable") != ""
}

funksjon installer(app_path: tekst, dest_dir: tekst, app_name_inn: tekst) -> heiltall {
    hvis ikkje platform.er_macos() {
        linje("Feil: install-macos-app krev macOS.")
        returner 1
    }
    la app_name = app_name_inn
    hvis app_name == "" { app_name = "Norscode.app" }
    hvis ikkje builtin.ends_with(app_name, ".app") eller
       builtin.index_of(app_name, "/") >= 0 eller builtin.index_of(app_name, "\\") >= 0 {
        linje("Feil: ugyldig appnamn")
        returner 1
    }
    hvis ikkje filops.katalog_finnes(app_path) {
        linje("Feil: manglar app-bundle: " + app_path)
        linje("Bygg først med: ./bin/nc build-macos-app")
        returner 1
    }
    la metadata = app_metadata(app_path)
    hvis ikkje gyldig_app_metadata(metadata) {
        linje("Feil: ugyldig app-bundle eller Info.plist: " + app_path)
        returner 1
    }
    la executable = plist.get(metadata, "CFBundleExecutable")
    hvis ikkje fil_finst(app_path + "/Contents/MacOS/" + executable) {
        linje("Feil: app-bundle manglar deklarert executable")
        returner 1
    }
    la version = plist.get_h(metadata, "CFBundleShortVersionString", "1.0")
    hvis version == "" { version = "1.0" }
    hvis builtin.index_of(version, "/") >= 0 eller builtin.index_of(version, "\\") >= 0 eller
       builtin.index_of(version, "..") >= 0 {
        linje("Feil: ugyldig appversjon")
        returner 1
    }

    la dest_rel = absolutt_relativ(dest_dir)
    hvis dest_rel == "" {
        linje("Feil: installasjonsmål må vere ei absolutt mappe under /")
        returner 1
    }
    la target_app = dest_dir + "/" + app_name
    la versioned_root = dest_dir + "/.Norscode"
    la versions_dir = versioned_root + "/versions"
    la versioned_app = versions_dir + "/" + version + "/" + app_name

    hvis ikkje filops.lag_katalogar(versions_dir + "/" + version) { returner 1 }
    hvis fil_finst(versioned_app) og ikkje filops.slett_tre(versioned_app) { returner 1 }
    hvis ikkje filops.kopier_tre(app_path, versioned_app) { returner 1 }

    la current = native_fs.native_erstatt_symbolsk_lenke(
        "/", dest_rel + "/.Norscode/current", "versions/" + version + "/" + app_name)
    hvis current["status"] != "ok" {
        linje("Feil: klarte ikkje publisere aktiv appversjon: " + tekst(current["error"]))
        returner 1
    }
    hvis fil_finst(target_app) og ikkje filops.slett_tre(target_app) { returner 1 }
    la app_link = native_fs.native_erstatt_symbolsk_lenke(
        "/", dest_rel + "/" + app_name, ".Norscode/current")
    hvis app_link["status"] != "ok" {
        linje("Feil: klarte ikkje publisere app-lenke: " + tekst(app_link["error"]))
        returner 1
    }

    linje("Installert macOS-app: " + versioned_app)
    linje("Aktiv app-lenke: " + target_app)
    linje("Filikon kan registrerast eksplisitt med: ./bin/nc install-macos-file-icons")
    returner 0
}

funksjon start() -> heiltall {
    returner installer(env("NORSCODE_MACOS_INSTALL_APP"),
                       env("NORSCODE_MACOS_INSTALL_DEST"),
                       env("NORSCODE_MACOS_INSTALL_NAME"))
}
