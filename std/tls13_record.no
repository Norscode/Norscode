# tls13_record.no - TLS 1.3 record-lag (RFC 8446 §5) i rein Norscode.
# AEAD: ChaCha20-Poly1305 (RFC 8439) via std.chacha20_poly1305.
# Trafikk-nøklar via HKDF-Expand-Label (std.tls13_keyschedule).
bruk std.chacha20_poly1305 som chacha
bruk std.tls13_keyschedule som ks
bruk std.bytes som bytes

funksjon _liste(v) -> liste_heiltall {
    hvis bytes.er_bytes(v) { returner bytes.til_liste(v) }
    returner v
}

# Trafikk-nøkkel og IV frå ein trafikk-løyndom (RFC 8446 §7.3).
# ChaCha20-Poly1305 (TLS_CHACHA20_POLY1305_SHA256): 32-byte nøkkel, 12-byte IV.
# IV-utleiinga er suite-uavhengig; nøkkellengda følgjer suiten.
funksjon traffic_keys(secret: liste_heiltall) -> ordbok {
    la key = ks.expand_label(secret, "key", [], 32)
    la iv = ks.expand_label(secret, "iv", [], 12)
    returner { "key": key, "iv": iv }
}

# Per-post nonce: seq big-endian i dei 8 høgre bytane, venstre-padda til 12,
# XOR-a med den statiske IV-en (RFC 8446 §5.3).
funksjon _nonce(iv: liste_heiltall, seq: heiltall) -> liste_heiltall {
    la padded: liste_heiltall = []
    la i = 0
    mens i < 4 { legg_til(padded, 0) i = i + 1 }
    la s = seq
    la be: liste_heiltall = [0, 0, 0, 0, 0, 0, 0, 0]
    la j = 7
    mens j >= 0 { be[j] = s & 255 s = s >> 8 j = j - 1 }
    i = 0
    mens i < 8 { legg_til(padded, be[i]) i = i + 1 }
    la ut: liste_heiltall = []
    i = 0
    mens i < 12 { legg_til(ut, iv[i] ^ padded[i]) i = i + 1 }
    returner ut
}

# TLSInnerPlaintext = content || content_type || 0*  (RFC 8446 §5.2). Utan padding her.
# Krypter til ein komplett post: header(5) || ciphertext || tag(16).
funksjon krypter_post(key: liste_heiltall, iv: liste_heiltall, seq: heiltall, content_type: heiltall, plaintext: liste_heiltall) -> liste_heiltall {
    la inner = _liste(plaintext)
    la inner2: liste_heiltall = []
    la i = 0
    mens i < lengde(inner) { legg_til(inner2, inner[i]) i = i + 1 }
    legg_til(inner2, content_type & 255)
    la total = lengde(inner2) + 16
    la header: liste_heiltall = [23, 3, 3, (total >> 8) & 255, total & 255]
    la nonce = _nonce(iv, seq)
    la res = chacha.krypter(key, nonce, inner2, header)
    la ct = _liste(res["ciphertext"])
    la tag = _liste(res["tag"])
    la ut: liste_heiltall = []
    i = 0
    mens i < lengde(header) { legg_til(ut, header[i]) i = i + 1 }
    i = 0
    mens i < lengde(ct) { legg_til(ut, ct[i]) i = i + 1 }
    i = 0
    mens i < lengde(tag) { legg_til(ut, tag[i]) i = i + 1 }
    returner ut
}

# Dekrypter ein komplett post. Returnerer {status, type, plaintext, error}.
funksjon dekrypter_post(key: liste_heiltall, iv: liste_heiltall, seq: heiltall, post: liste_heiltall) -> ordbok {
    la r = _liste(post)
    hvis lengde(r) < 5 { returner {"status": "feil", "error": "for kort post", "type": 0, "plaintext": []} }
    la len = (r[3] << 8) | r[4]
    hvis lengde(r) != 5 + len eller len < 16 { returner {"status": "feil", "error": "ugyldig postlengde", "type": 0, "plaintext": []} }
    la header: liste_heiltall = [r[0], r[1], r[2], r[3], r[4]]
    la ct: liste_heiltall = []
    la i = 5
    mens i < 5 + len - 16 { legg_til(ct, r[i]) i = i + 1 }
    la tag: liste_heiltall = []
    i = 5 + len - 16
    mens i < 5 + len { legg_til(tag, r[i]) i = i + 1 }
    la nonce = _nonce(iv, seq)
    la res = chacha.dekrypter(key, nonce, ct, header, tag)
    hvis res["status"] != "ok" { returner {"status": "feil", "error": res["error"], "type": 0, "plaintext": []} }
    la inner = _liste(res["plaintext"])
    # Fjern trailing null-padding, siste ikkje-null byte er content_type.
    la p = lengde(inner) - 1
    mens p >= 0 og inner[p] == 0 { p = p - 1 }
    hvis p < 0 { returner {"status": "feil", "error": "tom inner plaintext", "type": 0, "plaintext": []} }
    la ct_type = inner[p]
    la data: liste_heiltall = []
    i = 0
    mens i < p { legg_til(data, inner[i]) i = i + 1 }
    returner {"status": "ok", "error": "", "type": ct_type, "plaintext": data}
}

funksjon status() { returner { "abi": "norscode-tls13-record-v1", "aead": "chacha20-poly1305" } }
