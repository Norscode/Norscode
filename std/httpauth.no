# httpauth.no — HTTPBasic- og API-nøkkel-hjelparar for Norscode (Fase 0.11)
#
# Alle hemmeleg-samanlikningar er konstant-tid (krypto.konstant_tid_lik) for å
# unngå tidslekkasje. API-nøkkel-sjekken går gjennom HEILE nøkkelsettet utan
# tidleg exit, so talet på treff ikkje kan utleiast via tid.
#
# Bruk:
#   hvis ikkje httpauth.verify_basic(ctx, "ada", "l0sen") {
#       returner httpauth.basic_utfordring("Mitt API")
#   }
#   hvis ikkje httpauth.verify_api_key(ctx, ["k1","k2"], "x-api-key") {
#       returner web.response_error(401, "ugyldig api-nøkkel")
#   }

bruk std.web som web
bruk std.krypto som krypto
bruk std.base64 som base64

# ─── HTTP Basic ──────────────────────────────────────────────────────────────

funksjon basic_credentials(ctx: ordbok_tekst) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    r["ok"] = "usann"
    r["bruker"] = ""
    r["passord"] = ""
    la h = web.request_header(ctx, "authorization")
    hvis ikkje builtin.starts_with(h, "Basic ") { returner r }
    la koda = builtin.slice(h, 6, lengde(h))
    la dekoda = ""
    prøv { dekoda = base64.dekod(koda) } fang (e) { returner r }
    la sep = builtin.index_of(dekoda, ":")
    hvis sep < 0 { returner r }
    r["bruker"] = builtin.slice(dekoda, 0, sep)
    r["passord"] = builtin.slice(dekoda, sep + 1, lengde(dekoda))
    r["ok"] = "sann"
    returner r
}

funksjon verify_basic(ctx: ordbok_tekst, forventa_bruker: tekst, forventa_passord: tekst) -> boolsk {
    la c = basic_credentials(ctx)
    hvis tekst(c["ok"]) != "sann" { returner usann }
    // Samanlikn BEGGE felta konstant-tid og AND-a resultata (ingen tidleg exit).
    la bruker_lik = krypto.konstant_tid_lik(tekst(c["bruker"]), forventa_bruker)
    la passord_lik = krypto.konstant_tid_lik(tekst(c["passord"]), forventa_passord)
    returner bruker_lik og passord_lik
}

funksjon basic_utfordring(realm: tekst) -> ordbok_tekst {
    la h: ordbok_tekst = {}
    h["www-authenticate"] = "Basic realm=\"" + realm + "\", charset=\"UTF-8\""
    h["content-type"] = "application/json; charset=utf-8"
    returner web.response_builder(401, h, "{\"detail\":\"Not authenticated\"}")
}

# ─── API-nøkkel ──────────────────────────────────────────────────────────────

funksjon api_key(ctx: ordbok_tekst, header_namn: tekst) -> tekst {
    la hn = header_namn
    hvis hn == "" { hn = "x-api-key" }
    la v = web.request_header(ctx, hn)
    hvis v != "" { returner v }
    returner web.request_query_param(ctx, "api_key")
}

# Konstant-tid over heile settet: ingen tidleg exit, so talet på/plasseringa av
# treff ikkje kan utleiast. Returnerer sann dersom nøkkelen matchar éin gyldig.
funksjon verify_api_key(ctx: ordbok_tekst, gyldige: liste<tekst>, header_namn: tekst) -> boolsk {
    la gitt = api_key(ctx, header_namn)
    la treff: boolsk = usann
    la i: heiltall = 0
    mens i < lengde(gyldige) {
        hvis krypto.konstant_tid_lik(gitt, tekst(gyldige[i])) { treff = sann }
        i = i + 1
    }
    hvis gitt == "" { returner usann }
    returner treff
}

funksjon status() -> ordbok_tekst {
    returner {
        "modul": "std.httpauth",
        "ordningar": "HTTPBasic,APIKey",
        "samanlikning": "constant_time"
    }
}
