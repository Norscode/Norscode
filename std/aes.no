# aes.no — AES-128 blokkchiffer (kryptering), ren Norscode.
# FIPS-197. Kun kryptering (AES-CTR/GCM treng aldri dekryptering).
# Byggekloss for AES-128-GCM AEAD i TLS 1.3 (RFC 8446) og ACME/HTTPS.
# Verifisert mot FIPS-197 kjent-svar i tests/test_aes128_fips197.no.

funksjon _sbox() -> liste_heiltall {
    la hex = "637c777bf26b6fc53001672bfed7ab76"
        + "ca82c97dfa5947f0add4a2af9ca472c0"
        + "b7fd9326363ff7cc34a5e5f171d83115"
        + "04c723c31896059a071280e2eb27b275"
        + "09832c1a1b6e5aa0523bd6b329e32f84"
        + "53d100ed20fcb15b6acbbe394a4c58cf"
        + "d0efaafb434d338545f9027f503c9fa8"
        + "51a3408f929d38f5bcb6da2110fff3d2"
        + "cd0c13ec5f974417c4a77e3d645d1973"
        + "60814fdc222a908846eeb814de5e0bdb"
        + "e0323a0a4906245cc2d3ac629195e479"
        + "e7c8376d8dd54ea96c56f4ea657aae08"
        + "ba78252e1ca6b4c6e8dd741f4bbd8b8a"
        + "703eb5664803f60e613557b986c11d9e"
        + "e1f8981169d98e949b1e87e9ce5528df"
        + "8ca1890dbfe6426841992d0fb054bb16"
    la sifre = "0123456789abcdef"
    la ut: liste_heiltall = []
    la i = 0
    mens i < 256 {
        la hi = builtin.index_of(sifre, builtin.slice(hex, i * 2, i * 2 + 1))
        la lo = builtin.index_of(sifre, builtin.slice(hex, i * 2 + 1, i * 2 + 2))
        legg_til(ut, hi * 16 + lo)
        i = i + 1
    }
    returner ut
}

funksjon _xtime(b: heiltall) -> heiltall {
    la r = (b << 1) & 255
    hvis (b & 128) != 0 { r = r ^ 27 }
    returner r
}

# Nøkkelutvidelse: 16-byte nøkkel -> 176 byte (11 rundenøklar).
funksjon _key_expansion(key: liste_heiltall, sbox: liste_heiltall) -> liste_heiltall {
    la rcon = [1, 2, 4, 8, 16, 32, 64, 128, 27, 54]
    la w: liste_heiltall = []
    la i = 0
    mens i < 16 { legg_til(w, key[i]) i = i + 1 }
    la ord = 4
    mens ord < 44 {
        la a0 = w[(ord - 1) * 4]
        la a1 = w[(ord - 1) * 4 + 1]
        la a2 = w[(ord - 1) * 4 + 2]
        la a3 = w[(ord - 1) * 4 + 3]
        hvis ord % 4 == 0 {
            # RotWord + SubWord + Rcon
            la t0 = a0
            a0 = sbox[a1] ^ rcon[ord / 4 - 1]
            a1 = sbox[a2]
            a2 = sbox[a3]
            a3 = sbox[t0]
        }
        legg_til(w, w[(ord - 4) * 4] ^ a0)
        legg_til(w, w[(ord - 4) * 4 + 1] ^ a1)
        legg_til(w, w[(ord - 4) * 4 + 2] ^ a2)
        legg_til(w, w[(ord - 4) * 4 + 3] ^ a3)
        ord = ord + 1
    }
    returner w
}

# Krypterer én 16-byte blokk. key og block er liste_heiltall (0-255).
funksjon aes128_encrypt_block(key: liste_heiltall, block: liste_heiltall) -> liste_heiltall {
    la sbox = _sbox()
    la rk = _key_expansion(key, sbox)
    la s: liste_heiltall = []
    la i = 0
    mens i < 16 { legg_til(s, block[i] ^ rk[i]) i = i + 1 }

    la runde = 1
    mens runde <= 10 {
        # SubBytes
        i = 0
        mens i < 16 { s[i] = sbox[s[i]] i = i + 1 }

        # ShiftRows (kolonne-major: indeks = rad + 4*kol)
        la n: liste_heiltall = []
        i = 0
        mens i < 16 { legg_til(n, 0) i = i + 1 }
        la r = 0
        mens r < 4 {
            la c = 0
            mens c < 4 {
                n[r + 4 * c] = s[r + 4 * ((c + r) % 4)]
                c = c + 1
            }
            r = r + 1
        }
        s = n

        # MixColumns (ikke i siste runde)
        hvis runde < 10 {
            la c = 0
            mens c < 4 {
                la s0 = s[4 * c]
                la s1 = s[4 * c + 1]
                la s2 = s[4 * c + 2]
                la s3 = s[4 * c + 3]
                s[4 * c] = _xtime(s0) ^ (_xtime(s1) ^ s1) ^ s2 ^ s3
                s[4 * c + 1] = s0 ^ _xtime(s1) ^ (_xtime(s2) ^ s2) ^ s3
                s[4 * c + 2] = s0 ^ s1 ^ _xtime(s2) ^ (_xtime(s3) ^ s3)
                s[4 * c + 3] = (_xtime(s0) ^ s0) ^ s1 ^ s2 ^ _xtime(s3)
                c = c + 1
            }
        }

        # AddRoundKey
        i = 0
        mens i < 16 { s[i] = s[i] ^ rk[16 * runde + i] i = i + 1 }
        runde = runde + 1
    }
    returner s
}
