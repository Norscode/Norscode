# md5.no - rein Norscode MD5 (RFC 1321), berre for kompatibilitet/sjekksum.
# MD5 skal ikkje brukast til passord eller sikkerheitsavgjerder.

funksjon _u32(x: heiltall) -> heiltall { returner x & 4294967295 }
funksjon _rotl(x: heiltall, n: heiltall) -> heiltall {
    returner _u32((x << n) | (x >> (32 - n)))
}

funksjon _k() -> liste_heiltall {
    returner [
        3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955, 4249261313,
        1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329,
        4129170786, 3225465664, 643717713, 3921069994, 3593408605, 38016083, 3634488961, 3889429448,
        568446438, 3275163606, 4107603335, 1163531501, 2850285829, 4243563512, 1735328473, 2368359562,
        4294588738, 2272392833, 1839030562, 4259657740, 2763975236, 1272893353, 4139469664, 3200236656,
        681279174, 3936430074, 3572445317, 76029189, 3654602809, 3873151461, 530742520, 3299628645,
        4096336452, 1126891415, 2878612391, 4237533241, 1700485571, 2399980690, 4293915773, 2240044497,
        1873313359, 4264355552, 2734768916, 1309151649, 4149444226, 3174756917, 718787259, 3951481745
    ]
}

funksjon _s() -> liste_heiltall {
    returner [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
    ]
}

funksjon _hex_byte(verdi: heiltall) -> tekst {
    la chars = "0123456789abcdef"
    returner builtin.slice(chars, (verdi >> 4) & 15, ((verdi >> 4) & 15) + 1) +
             builtin.slice(chars, verdi & 15, (verdi & 15) + 1)
}

funksjon _hex_le(verdi: heiltall) -> tekst {
    returner _hex_byte(verdi & 255) +
             _hex_byte((verdi >> 8) & 255) +
             _hex_byte((verdi >> 16) & 255) +
             _hex_byte((verdi >> 24) & 255)
}

funksjon hash_bytes(data) -> tekst {
    la bytes: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(data) {
        legg_til(bytes, data[i] & 255)
        i = i + 1
    }
    la bit_len = lengde(bytes) * 8
    legg_til(bytes, 128)
    mens (lengde(bytes) % 64) != 56 { legg_til(bytes, 0) }
    la shift: heiltall = 0
    mens shift < 64 {
        legg_til(bytes, (bit_len >> shift) & 255)
        shift = shift + 8
    }

    la a0: heiltall = 1732584193
    la b0: heiltall = 4023233417
    la c0: heiltall = 2562383102
    la d0: heiltall = 271733878
    la constants = _k()
    la rotations = _s()
    la offset: heiltall = 0
    mens offset < lengde(bytes) {
        la words: liste_heiltall = []
        i = 0
        mens i < 16 {
            la p = offset + i * 4
            legg_til(words, _u32(bytes[p] | (bytes[p + 1] << 8) |
                                  (bytes[p + 2] << 16) | (bytes[p + 3] << 24)))
            i = i + 1
        }
        la a = a0
        la b = b0
        la c = c0
        la d = d0
        i = 0
        mens i < 64 {
            la f: heiltall = 0
            la g: heiltall = 0
            hvis i < 16 {
                f = (b & c) | ((_u32(b ^ 4294967295)) & d)
                g = i
            } ellers hvis i < 32 {
                f = (d & b) | ((_u32(d ^ 4294967295)) & c)
                g = (5 * i + 1) % 16
            } ellers hvis i < 48 {
                f = b ^ c ^ d
                g = (3 * i + 5) % 16
            } ellers {
                f = c ^ (b | _u32(d ^ 4294967295))
                g = (7 * i) % 16
            }
            la neste_d = d
            d = c
            c = b
            b = _u32(b + _rotl(_u32(a + f + constants[i] + words[g]), rotations[i]))
            a = neste_d
            i = i + 1
        }
        a0 = _u32(a0 + a)
        b0 = _u32(b0 + b)
        c0 = _u32(c0 + c)
        d0 = _u32(d0 + d)
        offset = offset + 64
    }
    returner _hex_le(a0) + _hex_le(b0) + _hex_le(c0) + _hex_le(d0)
}

funksjon hash(data: tekst) -> tekst {
    la bytes: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(data) {
        legg_til(bytes, builtin.char_code(builtin.slice(data, i, i + 1)) & 255)
        i = i + 1
    }
    returner hash_bytes(bytes)
}
