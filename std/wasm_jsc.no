# std/wasm_jsc.no — vertsshim for JavaScriptCore-skalet (`jsc -e`), som JS-tre (W5).
#
# jsc-skalet har verken DOM, TextDecoder/TextEncoder eller fetch. For å køyre den genererte
# lastaren og ein korpusmodul i JavaScriptCore (Safari-motoren) utan ei JS-fil, byggjer
# nettlesar-benken (std/wasm_nettlesar.no) eit skript av
#   1. shimen her: console.log og document.getElementById(…).append skriv kvar loggbit som
#      éi JSON-strenglinje med print (så teksten kjem eksakt attende), TextDecoder og
#      TextEncoder for UTF-8, fetch som gjev URL-en attende, og instantiateStreaming som
#      les modulfila med readFile;
#   2. lastaren som tools/nc_wasm.no emitterte, med .catch som skriv «Uncaught <feil>».
# Alt er JS-tre emittert token for token av std/wasm_js.no, som lastaren. Literalane i
# denne fila er enkelttoken; tests/test_wasm_lastar.no skannar ho etter JS-fragment.
bruk std.wasm_js som js

# new (Object.bind(null, o))() gjev o: ein konstruerbar «klasse» utan class-syntaks.
funksjon _klasse(o: liste) -> liste {
    returner ["kall", ["felt", ["global", "Object"], "bind"], [["global", "null"], o]]
}

# Vertsshimen for `jsc -e` som JS-tre (emittert med std/wasm_js.no). jsc-skalet har verken
# DOM, TextDecoder/TextEncoder eller fetch; shimen gjev lastaren det han treng for
# korpusprogram (logg_test og logg), og kvar loggbit blir skriven som éi JSON-strenglinje
# (print) så teksten kjem eksakt attende. Modulen blir lesen frå `wasm_sti` med readFile.
funksjon jsc_shim(wasm_sti: tekst) -> liste {
    la skriv_json = ["pil", ["a"], ["kall", ["global", "print"], [["kall", ["felt", ["global", "JSON"], "stringify"], [["namn", "a"]]]]]]
    la dekod = ["pil", ["a"], ["kall", ["global", "decodeURIComponent"], [["kall", ["global", "escape"],
        [["kall", ["felt", ["kall", ["felt", ["global", "Array"], "from"], [["namn", "a"],
            ["pil", ["b"], ["kall", ["felt", ["global", "String"], "fromCharCode"], [["namn", "b"]]]]]], "join"], [["streng", ""]]]]]]]]
    la kod = ["pil", ["a"], ["kall", ["felt", ["global", "Uint8Array"], "from"],
        [["kall", ["global", "unescape"], [["kall", ["global", "encodeURIComponent"], [["namn", "a"]]]]],
         ["pil", ["b"], ["kall", ["felt", ["namn", "b"], "charCodeAt"], [["tal", 0]]]]]]]
    returner [
        ["uttrykk", ["tildel", ["global", "console"], ["objekt", [["log", skriv_json]]]]],
        ["uttrykk", ["tildel", ["global", "document"], ["objekt", [["getElementById",
            ["pil", ["a"], ["objekt", [["append", skriv_json]]]]]]]]],
        ["uttrykk", ["tildel", ["global", "TextDecoder"], _klasse(["objekt", [["decode", dekod]]])]],
        ["uttrykk", ["tildel", ["global", "TextEncoder"], _klasse(["objekt", [["encode", kod]]])]],
        ["uttrykk", ["tildel", ["global", "fetch"], ["pil", ["a"], ["namn", "a"]]]],
        ["uttrykk", ["tildel", ["felt", ["global", "WebAssembly"], "instantiateStreaming"],
            ["pil", ["a", "b"], ["kall", ["felt", ["global", "WebAssembly"], "instantiate"],
                [["kall", ["global", "readFile"], [["streng", wasm_sti], ["streng", "binary"]]], ["namn", "b"]]]]]]
    ]
}

# Heile skriptet for `jsc -e`: shimen, så lastarprogrammet (JS-treet frå js.bygg_lastar) med
# .catch som skriv «Uncaught <feil>» (som Chrome-konsollen) når noko når JavaScript.
funksjon jsc_skript(wasm_sti: tekst, lastar_program: liste) -> tekst {
    la setningar = jsc_shim(wasm_sti)
    legg_til(setningar, ["uttrykk", ["kall", ["felt", lastar_program, "catch"],
        [["pil", ["a"], ["kall", ["global", "print"], [["kall", ["felt", ["global", "JSON"], "stringify"],
            [["binær", "+", ["streng", "Uncaught "], ["namn", "a"]]]]]]]]]])
    returner js.token_til_tekst(js.emit_skript(setningar))
}
