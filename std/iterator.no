# std/iterator.no — M11: iterator- og generatorprotokoll (data-driven)
#
# Ein iterator er ei ordbok { "kind": <tekst>, "state": <ordbok> }.
# `neste(it)` returnerer { "ferdig": bool, "verdi": <verdi> } og muterer
# state (ordbøker er referansetypar, så mutasjonen varer mellom kall).
#
# Denne varianten er DATA-DRIVEN og køyrer på seed-runtimen i dag: han bruker
# ikkje førsteklasses funksjonar. Late kjeder med vilkårlege transformasjonar
# (kart/filter over ein iterator med brukar-lambda) og `gi`-nøkkelord-
# generatorar krev M3-aktivering / VM suspend-resume — sjå plan-dokumentet.

# ── Konstruktørar ────────────────────────────────────────────────────────

# Uendeleg teljar: start, start+hopp, start+2*hopp, ...
funksjon teljar(start: heiltall, hopp: heiltall) -> ordbok {
    returner { "kind": "teljar", "state": { "n": start, "hopp": hopp } }
}

# Endeleg område [start, ende) med gitt steglengd hopp (hopp > 0).
funksjon område(start: heiltall, ende: heiltall, hopp: heiltall) -> ordbok {
    returner { "kind": "område", "state": { "n": start, "ende": ende, "hopp": hopp } }
}

# Iterator over ei liste.
funksjon frå_liste(xs: liste) -> ordbok {
    returner { "kind": "liste", "state": { "xs": xs, "i": 0 } }
}

# Iterator over teikna i ein tekst.
funksjon frå_tekst(s: tekst) -> ordbok {
    returner { "kind": "tekst", "state": { "s": s, "i": 0 } }
}

# Iterator over nøklane i ei ordbok (som `for k in dict`). Erstattar den
# codegen-baserte for-løkka over ordbok som braut sjølvhostings-fixpunktet.
funksjon frå_ordbok(m: ordbok) -> ordbok {
    returner { "kind": "liste", "state": { "xs": builtin.nøkler(m), "i": 0 } }
}

# ── Protokoll ────────────────────────────────────────────────────────────

funksjon neste(it: ordbok) -> ordbok {
    la k = it["kind"]
    la st = it["state"]

    hvis k == "teljar" {
        la v = st["n"]
        st["n"] = v + st["hopp"]
        returner { "ferdig": usann, "verdi": v }
    }

    hvis k == "område" {
        la v = st["n"]
        hvis v >= st["ende"] {
            returner { "ferdig": sann, "verdi": ingenting }
        }
        st["n"] = v + st["hopp"]
        returner { "ferdig": usann, "verdi": v }
    }

    hvis k == "liste" {
        la i = st["i"]
        hvis i >= lengde(st["xs"]) {
            returner { "ferdig": sann, "verdi": ingenting }
        }
        st["i"] = i + 1
        returner { "ferdig": usann, "verdi": st["xs"][i] }
    }

    hvis k == "tekst" {
        la i = st["i"]
        hvis i >= lengde(st["s"]) {
            returner { "ferdig": sann, "verdi": ingenting }
        }
        st["i"] = i + 1
        returner { "ferdig": usann, "verdi": st["s"][i] }
    }

    kast "IteratorFeil: ukjend iterator-kind: " + tekst(k)
}

# ── Konsumentar ──────────────────────────────────────────────────────────

# Dei n første verdiane som ei liste (trygg mot uendelege iteratorar).
funksjon ta(it: ordbok, n: heiltall) -> liste {
    la ut = []
    la i = 0
    mens i < n {
        la r = neste(it)
        hvis r["ferdig"] {
            bryt
        }
        legg_til(ut, r["verdi"])
        i = i + 1
    }
    returner ut
}

# Heile den (endelege) iteratoren som ei liste.
funksjon saml(it: ordbok) -> liste {
    la ut = []
    la går = sann
    mens går {
        la r = neste(it)
        hvis r["ferdig"] {
            går = usann
        } ellers {
            legg_til(ut, r["verdi"])
        }
    }
    returner ut
}

# Tel talet på element (endeleg iterator).
funksjon tel(it: ordbok) -> heiltall {
    la c = 0
    la går = sann
    mens går {
        la r = neste(it)
        hvis r["ferdig"] {
            går = usann
        } ellers {
            c = c + 1
        }
    }
    returner c
}
