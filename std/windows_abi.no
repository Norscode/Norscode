// Avgrensa Win64-ABI for dei kjeldebygde, CRT-frie Windows-runtimane.
// OSTAB 502 er ei statisk allowliste, ikkje ein vilkaarleg funksjonspeikar.
// ID 0..63: prosess/core. ID 64..159: nettverk, SChannel og IOCP.
// sys6(502, id, args, 0, 0, 0, 0): 12 u64-argument @0..88;
// GetLastError fangast straks etter API-kallet og skrivast til args+96.
// Retur er API-et sin uendra 64-bit RAX. DWORD/HRESULT maskerer kallaren.
// Traadkontrakt: call/last_error og argumentbufferet tilhoyrer den eine
// Norscode-traaden. Windows clone/thread-spawn er framleis fail-closed;
// sched/IOCP blir pumpa paa same traad. Native Windows-traadar maa faa
// thread-local argument/feiltilstand foer dei kan aktiverast.

funksjon api_entries() -> liste {
    returner [
        [0, "KERNEL32.dll", "GetLastError"],
        [1, "KERNEL32.dll", "VirtualAlloc"],
        [2, "KERNEL32.dll", "VirtualFree"],
        [3, "KERNEL32.dll", "MultiByteToWideChar"],
        [4, "KERNEL32.dll", "WideCharToMultiByte"],
        [5, "KERNEL32.dll", "GetTickCount64"],
        [6, "KERNEL32.dll", "CreateJobObjectW"],
        [7, "KERNEL32.dll", "SetInformationJobObject"],
        [8, "KERNEL32.dll", "AssignProcessToJobObject"],
        [9, "KERNEL32.dll", "TerminateJobObject"],
        [10, "KERNEL32.dll", "QueryInformationJobObject"],
        [11, "KERNEL32.dll", "CreateProcessW"],
        [12, "KERNEL32.dll", "ResumeThread"],
        [13, "KERNEL32.dll", "WaitForSingleObject"],
        [14, "KERNEL32.dll", "GetExitCodeProcess"],
        [15, "KERNEL32.dll", "CloseHandle"],
        [16, "KERNEL32.dll", "CreatePipe"],
        [17, "KERNEL32.dll", "SetHandleInformation"],
        [18, "KERNEL32.dll", "PeekNamedPipe"],
        [19, "KERNEL32.dll", "ReadFile"],
        [20, "KERNEL32.dll", "WriteFile"],
        [21, "KERNEL32.dll", "CreateFileW"],
        [22, "KERNEL32.dll", "GetCurrentProcess"],
        [23, "ADVAPI32.dll", "OpenProcessToken"],
        [24, "ADVAPI32.dll", "GetTokenInformation"],
        [25, "KERNEL32.dll", "InitializeProcThreadAttributeList"],
        [26, "KERNEL32.dll", "UpdateProcThreadAttribute"],
        [27, "KERNEL32.dll", "DeleteProcThreadAttributeList"],
        [28, "KERNEL32.dll", "GetCurrentProcessId"],
        [29, "KERNEL32.dll", "LocalFree"],
        [30, "ADVAPI32.dll", "GetNamedSecurityInfoW"],
        [31, "ADVAPI32.dll", "SetNamedSecurityInfoW"],
        [32, "ADVAPI32.dll", "SetEntriesInAclW"],
        [33, "ADVAPI32.dll", "FreeSid"],
        [34, "USERENV.dll", "CreateAppContainerProfile"],
        [35, "USERENV.dll", "DeleteAppContainerProfile"],
        [36, "USERENV.dll", "DeriveAppContainerSidFromAppContainerName"],
        [37, "KERNEL32.dll", "TerminateProcess"],
        [38, "KERNEL32.dll", "GetFileAttributesW"],
        [39, "KERNEL32.dll", "GetFullPathNameW"],
        [40, "ADVAPI32.dll", "GetSecurityDescriptorControl"],
        [41, "KERNEL32.dll", "DuplicateHandle"],
        [42, "KERNEL32.dll", "Sleep"],
        [43, "ADVAPI32.dll", "SystemFunction036"],
        [44, "KERNEL32.dll", "IsProcessInJob"],
        [45, "KERNEL32.dll", "GetProcessHandleCount"],
        [46, "KERNEL32.dll", "CreateNamedPipeW"],
        [47, "KERNEL32.dll", "ConnectNamedPipe"],
        [48, "KERNEL32.dll", "GetOverlappedResult"],
        [49, "KERNEL32.dll", "CreateEventW"],
        [50, "KERNEL32.dll", "ResetEvent"],
        [51, "KERNEL32.dll", "GetNamedPipeClientProcessId"],
        [52, "KERNEL32.dll", "GetStdHandle"],
        [64, "WS2_32.dll", "WSAStartup"],
        [65, "WS2_32.dll", "WSASocketW"],
        [66, "WS2_32.dll", "closesocket"],
        [67, "WS2_32.dll", "ioctlsocket"],
        [68, "WS2_32.dll", "bind"],
        [69, "WS2_32.dll", "listen"],
        [70, "WS2_32.dll", "accept"],
        [71, "WS2_32.dll", "connect"],
        [72, "WS2_32.dll", "recv"],
        [73, "WS2_32.dll", "send"],
        [74, "WS2_32.dll", "WSAPoll"],
        [75, "WS2_32.dll", "getsockname"],
        [76, "WS2_32.dll", "setsockopt"],
        [77, "WS2_32.dll", "getsockopt"],
        [78, "WS2_32.dll", "shutdown"],
        [79, "WS2_32.dll", "WSAGetLastError"],
        [80, "WS2_32.dll", "getaddrinfo"],
        [81, "WS2_32.dll", "freeaddrinfo"],
        [82, "WS2_32.dll", "WSARecv"],
        [83, "WS2_32.dll", "WSASend"],
        [84, "WS2_32.dll", "recvfrom"],
        [85, "WS2_32.dll", "sendto"],
        [86, "KERNEL32.dll", "CreateIoCompletionPort"],
        [87, "KERNEL32.dll", "GetQueuedCompletionStatus"],
        [88, "KERNEL32.dll", "CancelIoEx"],
        // Berre desse to faste extension-GUIDane blir løyste av porten.
        [89, "", "AcceptEx"],
        [90, "", "ConnectEx"],
        [91, "WS2_32.dll", "WSAIoctl"],
        [96, "SECUR32.dll", "AcquireCredentialsHandleW"],
        [97, "SECUR32.dll", "InitializeSecurityContextW"],
        [98, "SECUR32.dll", "EncryptMessage"],
        [99, "SECUR32.dll", "DecryptMessage"],
        [100, "SECUR32.dll", "QueryContextAttributesW"],
        [101, "SECUR32.dll", "DeleteSecurityContext"],
        [102, "SECUR32.dll", "FreeCredentialsHandle"],
        [103, "SECUR32.dll", "FreeContextBuffer"],
        [104, "CRYPT32.dll", "CertFreeCertificateContext"],
        [105, "SECUR32.dll", "ApplyControlToken"],
        [106, "SECUR32.dll", "CompleteAuthToken"],
        [160, "KERNEL32.dll", "SetFilePointerEx"],
        [161, "KERNEL32.dll", "SetEndOfFile"],
        [162, "KERNEL32.dll", "GetFileSizeEx"],
        [163, "KERNEL32.dll", "FindFirstFileW"],
        [164, "KERNEL32.dll", "FindNextFileW"],
        [165, "KERNEL32.dll", "FindClose"],
        [166, "KERNEL32.dll", "DeleteFileW"],
        [167, "KERNEL32.dll", "MoveFileExW"],
        [168, "KERNEL32.dll", "CreateDirectoryW"],
        [169, "KERNEL32.dll", "RemoveDirectoryW"],
        [170, "KERNEL32.dll", "FlushFileBuffers"],
        [171, "KERNEL32.dll", "GetFinalPathNameByHandleW"],
        [172, "KERNEL32.dll", "SetFileAttributesW"],
        [173, "KERNEL32.dll", "GetFileInformationByHandle"],
        [174, "KERNEL32.dll", "GetFileType"]
    ]
}

funksjon port() -> heiltall { returner 502 }
funksjon argument_bytes() -> heiltall { returner 104 }
funksjon er_windows() -> boolsk {
    returner tekst(builtin.native_target()) == "windows-x86_64"
}

la _ids = {}
la _args: heiltall = 0
la _last_error: heiltall = 0

funksjon api_id(namn: tekst) -> heiltall {
    hvis lengde(nøkler(_ids)) == 0 {
        la entries = api_entries()
        for e i entries { _ids[tekst(e[2])] = e[0] }
    }
    hvis ikkje finnes_nøkkel(_ids, namn) { kast "windows_abi: ukjent API " + namn }
    returner _ids[namn]
}

funksjon alloc(n: heiltall) -> heiltall {
    hvis n <= 0 eller n > 67108864 { returner 0 }
    hvis ikkje er_windows() { kast "windows_abi krev Windows" }
    la p = builtin.sys6(9, 0, n, 0, 0, 0 - 1, 0)
    hvis p <= 0 { returner 0 }
    returner p
}

funksjon call(namn: tekst, args: liste) -> heiltall {
    hvis lengde(args) > 12 { kast "windows_abi: meir enn 12 argument" }
    hvis _args == 0 { _args = alloc(4096) }
    hvis _args == 0 { kast "windows_abi: argumentbuffer kunne ikkje allokerast" }
    la i: heiltall = 0
    mens i < 13 { builtin.raw_store64(_args + i * 8, 0) i = i + 1 }
    i = 0
    mens i < lengde(args) { builtin.raw_store64(_args + i * 8, args[i]) i = i + 1 }
    la r = builtin.sys6(port(), api_id(namn), _args, 0, 0, 0, 0)
    _last_error = builtin.raw_load64(_args + 96) & 4294967295
    returner r
}

funksjon last_error() -> heiltall { returner _last_error }
funksjon free(p: heiltall) -> boolsk {
    hvis p == 0 { returner sann }
    returner call("VirtualFree", [p, 0, 32768]) != 0
}
funksjon close(h: heiltall) -> boolsk {
    hvis h == 0 eller h == 0 - 1 { returner sann }
    returner call("CloseHandle", [h]) != 0
}
funksjon u32(p: heiltall, v: heiltall) -> heiltall {
    la i: heiltall = 0
    mens i < 4 { builtin.raw_store8(p + i, (v >> (i * 8)) & 255) i = i + 1 }
    returner 0
}
funksjon read32(p: heiltall) -> heiltall {
    returner builtin.raw_load8(p) | (builtin.raw_load8(p + 1) << 8) |
        (builtin.raw_load8(p + 2) << 16) | (builtin.raw_load8(p + 3) << 24)
}
funksjon bytes_to_text(p: heiltall, n: heiltall) -> tekst {
    la parts: liste_tekst = []
    la i: heiltall = 0
    mens i < n { legg_til(parts, builtin.chr(builtin.raw_load8(p + i))) i = i + 1 }
    returner builtin.join(parts, "")
}
funksjon put_text(p: heiltall, t: tekst) -> heiltall {
    la i: heiltall = 0
    mens i < lengde(t) { builtin.raw_store8(p + i, builtin.char_code(t[i]) & 255) i = i + 1 }
    builtin.raw_store8(p + i, 0)
    returner i
}

// Resultatet er ein eigen VirtualAlloc-buffer og skal frigjerast med free().
// MB_ERR_INVALID_CHARS og eksplisitte kapasitetsgrenser avviser ugyldig UTF-8.
funksjon wide(t: tekst) -> heiltall {
    hvis lengde(t) > 32767 eller builtin.index_of(t, "\u0000") >= 0 { returner 0 }
    la n = lengde(t) + 1
    la p = alloc(n * 3 + 16)
    hvis p == 0 { returner 0 }
    la src = p + n * 2
    put_text(src, t)
    hvis call("MultiByteToWideChar", [65001, 8, src, 0 - 1, p, n]) == 0 {
        free(p)
        returner 0
    }
    returner p
}

funksjon utf8(p: heiltall) -> tekst {
    hvis p == 0 { returner "" }
    la n = call("WideCharToMultiByte", [65001, 0, p, 0 - 1, 0, 0, 0, 0])
    hvis n <= 0 eller n > 1048576 { returner "" }
    la out = alloc(n)
    hvis out == 0 { returner "" }
    la result = ""
    hvis call("WideCharToMultiByte", [65001, 0, p, 0 - 1, out, n, 0, 0]) == n {
        result = bytes_to_text(out, n - 1)
    }
    free(out)
    returner result
}
