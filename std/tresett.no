# std/tresett.no — sortert sett (Java TreeSet / NavigableSet) oppå std.tremap.
#
# Elementa blir haldne sorterte og unike etter ein komparator (to element er
# like når komparatoren gjev 0). Alle operasjonar er O(log n) bortsett frå
# listeuttrekk og mengdeoperasjonar.
#
# Bruk:
#   bruk std.tresett som ts
#   la s = ts.frå_liste([5, 1, 3, 1])
#   ts.legg_til(s, 4)             # sann (nytt element)
#   ts.til_liste(s)               # [1, 3, 4, 5]
#   ts.tak(s, 2)                  # 3
#   la etter_lengd = ts.ny_med(fun(a, b) -> lengde(a) - lengde(b))
#
# API (Java-motstykke i parentes):
#   ny() / ny_synkande() / ny_med(komparator)
#   frå_liste(xs) / frå_liste_med(xs, komparator)
#   legg_til(s, x) -> bool   sann viss nytt   (add)
#   fjern(s, x) -> bool      sann viss fanst  (remove)
#   inneheld(s, x) -> bool                    (contains)
#   storleik / er_tom / tøm
#   første / siste / ta_første / ta_siste     (first/last/pollFirst/pollLast; ingenting når tomt)
#   golv / tak / lågare / høgare              (floor/ceiling/lower/higher; ingenting når ingen)
#   område(s, nedre, øvre) [nedre, øvre)  område_inkl  hovud(s, øvre)  hale(s, nedre)  (subSet/headSet/tailSet)
#   til_liste / til_liste_synkande / til_tekst "[1, 2]"  (element via std.verdiform.vis)
#   union / snitt / differanse (nye sett, same komparator som a) / er_delmengd(a, b)
#
# NB: modulen definerer `legg_til` og `fjern`, som skuggar builtin-funksjonane med
# same namn INNE i denne fila. Difor gjer modulen all listebygging via std.tremap
# og kallar aldri builtin legg_til/fjern sjølv.
bruk std.tremap som tm
bruk std.verdiform som vfm

funksjon ny() -> ordbok {
    returner tm.ny()
}

funksjon ny_synkande() -> ordbok {
    returner tm.ny_synkande()
}

funksjon ny_med(komparator) -> ordbok {
    returner tm.ny_med(komparator)
}

funksjon _fyll(s: ordbok, xs) -> ordbok {
    for x i xs {
        tm.set(s, x, sann)
    }
    returner s
}

funksjon frå_liste(xs) -> ordbok {
    returner _fyll(tm.ny(), xs)
}

funksjon frå_liste_med(xs, komparator) -> ordbok {
    returner _fyll(tm.ny_med(komparator), xs)
}

funksjon legg_til(s: ordbok, x) -> bool {
    returner tm.set(s, x, sann)
}

funksjon fjern(s: ordbok, x) -> bool {
    returner tm.fjern(s, x)
}

funksjon inneheld(s: ordbok, x) -> bool {
    returner tm.finnes(s, x)
}

funksjon storleik(s: ordbok) -> heiltall {
    returner tm.storleik(s)
}

funksjon er_tom(s: ordbok) -> bool {
    returner tm.er_tom(s)
}

funksjon tøm(s: ordbok) {
    tm.tøm(s)
}

funksjon første(s: ordbok) {
    returner tm.første(s)
}

funksjon siste(s: ordbok) {
    returner tm.siste(s)
}

funksjon ta_første(s: ordbok) {
    returner tm.ta_første(s)
}

funksjon ta_siste(s: ordbok) {
    returner tm.ta_siste(s)
}

funksjon golv(s: ordbok, x) {
    returner tm.golv(s, x)
}

funksjon tak(s: ordbok, x) {
    returner tm.tak(s, x)
}

funksjon lågare(s: ordbok, x) {
    returner tm.lågare(s, x)
}

funksjon høgare(s: ordbok, x) {
    returner tm.høgare(s, x)
}

funksjon område(s: ordbok, nedre, øvre) -> liste {
    returner tm.område(s, nedre, øvre)
}

funksjon område_inkl(s: ordbok, nedre, øvre) -> liste {
    returner tm.område_inkl(s, nedre, øvre)
}

funksjon hovud(s: ordbok, øvre) -> liste {
    returner tm.hovud(s, øvre)
}

funksjon hale(s: ordbok, nedre) -> liste {
    returner tm.hale(s, nedre)
}

funksjon til_liste(s: ordbok) -> liste {
    returner tm.nøklar(s)
}

funksjon til_liste_synkande(s: ordbok) -> liste {
    returner tm.nøklar_synkande(s)
}

funksjon til_tekst(s: ordbok) -> tekst {
    returner vfm.vis(tm.nøklar(s))
}

# Nytt tomt sett med same ordning som s.
funksjon _tom_som(s: ordbok) -> ordbok {
    returner tm.ny_som(s)
}

funksjon union(a: ordbok, b: ordbok) -> ordbok {
    la r = _tom_som(a)
    _fyll(r, tm.nøklar(a))
    _fyll(r, tm.nøklar(b))
    returner r
}

funksjon snitt(a: ordbok, b: ordbok) -> ordbok {
    la r = _tom_som(a)
    for x i tm.nøklar(a) {
        hvis tm.finnes(b, x) { tm.set(r, x, sann) }
    }
    returner r
}

funksjon differanse(a: ordbok, b: ordbok) -> ordbok {
    la r = _tom_som(a)
    for x i tm.nøklar(a) {
        hvis ikkje tm.finnes(b, x) { tm.set(r, x, sann) }
    }
    returner r
}

# sann viss alle element i a finst i b.
funksjon er_delmengd(a: ordbok, b: ordbok) -> bool {
    for x i tm.nøklar(a) {
        hvis ikkje tm.finnes(b, x) { returner usann }
    }
    returner sann
}
