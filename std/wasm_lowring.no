# std/wasm_lowring.no — NCB → WebAssembly med WasmGC-verdimodell (W0, W1, W2).
#
# Inndata er NCB-JSON frå `nc compile` (parsa med json_parse_raw). Utdata er ein
# WASM-modul (byteliste) som nettlesaren kan instansiere med lastaren frå std/wasm_js.no.
#
# Verdimodell (WasmGC, sjå std/wasm_atom.no): alle Norscode-verdiar er `eqref`.
#   heltall      i31ref i −2^30 … 2^30−1, elles struct $boks {i64} (kanonisk)
#   bool         to singleton-structar $bool {i32} i globalane 0 (usann) og 1 (sann)
#   null         ref.null eq
#   desimaltall  struct $flyt {f64}
#   tekst        array $tekst (mut i8): UTF-8-bytar som i VM-en (`lengde` tel bytar)
#   liste        struct $liste {n, $arr} med amortisert vekst
#   ordbok       struct $ordbok {n, nøklar, verdiar}, innsetjingsordna
#   closure      struct $lambda {funcref, ref $arr fangar} (W2; berre når modulen har closures)
# Semantikken (polymorf +, blanda samanlikningar, sanning, tekst(x), feilmeldingar) ligg i
# atoma i std/wasm_atom.no, som berre blir tekne med når modulen brukar dei.
#
# Subset: PUSH_CONST (heltall, desimaltall, tekst, bool, null), LOAD/STORE_NAME,
# LOAD/STORE_GLOBAL (R2/F14: med valfri tredje operand = modulen), POP, DUP,
# BINARY_{ADD,SUB,MUL,DIV,MOD,AND,OR,XOR,LSHIFT,RSHIFT}, COMPARE_{EQ,NE,LT,LE,GT,GE},
# UNARY_{NEG,NOT}, JUMP, JUMP_IF_FALSE, LABEL, BUILD_LIST, BUILD_MAP, INDEX_GET, INDEX_SET,
# CALL (brukarfunksjonar inkl. dei kompilerte struktur-konstruktørane «modul.Namn»,
# vertsfunksjonar i std.wasm_vert, builtins i `builtin_tabell`, builtin.kall_metode,
# builtin.er_instans og builtin.ncb_call_fn), RETURN, og i W2: TRY_BEGIN, TRY_END, THROW,
# LOAD_EXCEPTION, FINALLY_PUSH, FINALLY_RUN, FINALLY_END, LOAD_PENDING, CLEAR_PENDING
# (prøv/fang/endeleg og utsett), BUILD_LAMBDA og CALL_VALUE.
# Alt anna — ukjende opkodar og builtins — gjev KOMPILERINGSFEIL med ei liste over alle
# funna. Det finst ingen stille fallback.
#
# R2-objektmodellen (selfhost/vm.no, vm_metode_løys/vm_er_instans/vm_struktur_nøkler):
#   - Ein struktur-instans er ei ordbok frå konstruktøren «modul.Namn» (ein vanleg funksjon i
#     NCB-en, "struct": true) med dei skjulte merka «__struktur__» (modulkvalifisert) og
#     «__type__». nøkler/lengde (og dermed verdier, for og json_stringify i std.wasm_rt)
#     gøymer merka på ordbøker med «__struktur__»; indeksering (p["__type__"]) og har_nokkel
#     ser dei, som i VM-en. Atoma får gøymeløypa berre når modulen kan ha strukturar (flagget
#     «struktur»: ein «__struktur__»-konstant i koden, eller json_parse_raw).
#   - mott.m(args) = CALL builtin.kall_metode [mott, "m", args…]. Metodenamnet er ein
#     tekstkonstant (sporet over blokkgrenser av analysen); kallet går til ein generert
#     dispatcher per (m, aritet) som samanliknar __struktur__ med konstruktørane S som har ein
#     funksjon «S.m» (eksakt oppslag), så closure-felt (berre når modulen har closures), så
#     fangbar MetodeFeil (òg for ingenting) og ArgumentFeil ved feil aritet med VM-tekstane.
#   - builtin.typenamn er eit atom; builtin.er_instans(v, "modul.T") ein generert test mot T
#     og strukturane som implementerer T ("interfaces"), og __type__ for eit ukvalifisert namn.
#   - Eit metode-/typenamn som ikkje er ein konstant, gjev kompileringsfeil.
#   - R2/F08: + med tekst på éi side gjev tekst(a) + tekst(b); andre ikkje-tal til + - * / %
#     og unær minus kastar TypeFeil med VM-teksten når modulen har unnatak (elles trap).
#   - R2/F14: globalar i andre modular (alias.NAMN) og modulinitialiseringa deira kjem med;
#     ei initialisering med kall eller kast (toppnivå-setningar) køyrer sjølv om modulen
#     elles ikkje er nådd, som i VM-en.
#
# Kontrollflyt: basisblokker med stakkslot-lokale og ei dispatch-lykkje
# (loop + br_table). Verdiar som flyt over etikettar (`og`/`eller`) blir lagra i slotane.
#
# Unnatak (W2), same maskin som VM-en (selfhost/vm.no: TRY_*, FINALLY_*, THROW):
#   - Analysen fører ein ABSTRAKT tilstand per blokk: try-stakken T (TRY_BEGIN-ar med
#     fangetikett, type og stakkhøgd), opprydjingsstakken C (FINALLY_PUSH med etikett og
#     try-djupn) og mengda av moglege «pending»-verdiar P (normal/return/throw). Tilstands-
#     endrande opkodar avsluttar blokka, så T og C er konstante i kvar blokk. Ulik tilstand
#     der to vegar møtest (bryt/fortsett ut av ei prøv-blokk, utsett i ei lykkje) gjev
#     kompileringsfeil i staden for feil oppførsel.
#   - Ein funksjon med prøv/endeleg/utsett får dispatch-lykkja pakka i `try_table (catch
#     $nc_unntak)`. Eit unnatak (THROW, eit atom som kastar, eller ein kallar lenger inne)
#     hamnar i ein handterar som vel mål etter tilstanden i blokka det skjedde i, akkurat som
#     VM-en: øvste passande handterar over opprydjingsgrensa → fang-blokka; elles endeleg-
#     blokka med pending=throw; elles vidare kast til kallaren.
#   - RETURN inne i endeleg/utsett går til endeleg-blokka med pending=return; FINALLY_END
#     vel etter pending (lokal i32), LOAD_PENDING/CLEAR_PENDING les/nullstiller han.
#   - Uhandterte unnatak i init og tilbakekall blir skrivne som «ERROR: <tekst(v)>».
# Closures (W2): BUILD_LAMBDA fangar by-value (som VM-en) i ein $lambda med funksjons-
# referanse og fangar-array; lambda-hjelpefunksjonen får fangarane som ekstra parameter og
# kopierer dei til lokale. CALL_VALUE kastar funksjonsreferansen til $fnN (éin type per
# aritet) og brukar call_ref. builtin.ncb_call_fn(x, args…) blir ein generert dispatcher per
# aritet: closure → call_ref; tekst → samanlikning mot funksjonsnamna `modul.Type.metode` i
# NCB-en (før R2 lowra kompilatoren p.metode(args) slik); ukjent → unnatak
# «Ukjent selfhost-funksjon: <namn>» som i VM-en. R2: builtin.<Stor forbokstav>() er ikkje
# lenger ein konstruktør (VM-en har fjerna heuristikken) og gjev «ustøtta builtin».
#
# Modulen: typar (dei sju GC-typane, [$lambda], så funksjonstypar), importar «nc».<vertsfunksjon>,
# funksjonar (atom, innpakkarar, brukarfunksjonar, dispatcharar, innpakka tilbakekall, init),
# minne «m», tag $nc_unntak (når modulen kan kaste), globalar, eksportar («m», «i» = init,
# «k0», «k1», … = funksjonar som lytt_klikk peikar på), deklarativt elementsegment (lambda-
# hjelparane, for ref.func), datacount, kode og data (passivt segment 0 med tekstliteralar
# for array.new_data, aktivt segment med vertskonstantane). Init («i») køyrer
# modulinitialiseringane og så `start()`.

bruk std.wasm_binary som w
bruk std.wasm_vert som vert
bruk std.wasm_atom som a

funksjon EQREF() -> heltall { returner 109 }
funksjon I32() -> heltall { returner 127 }
funksjon I64() -> heltall { returner 126 }

funksjon _la_til(mål: liste, kjelde: liste) -> heltall {
    la i = 0
    mens i < lengde(kjelde) {
        legg_til(mål, kjelde[i])
        i = i + 1
    }
    returner 0
}

# Usignert LEB128 (utan ekstra kall for små tal: kall er dyre i VM-en).
funksjon _leb(verdi: heltall) -> liste {
    hvis verdi >= 0 og verdi < 128 { returner [verdi] }
    returner a.leb_u(verdi)
}

funksjon _type_namn(v) -> tekst {
    la t = builtin.type(v)
    hvis t == "boolsk" eller t == "bool" { returner "bool" }
    hvis t == "ingenting" eller t == "null" { returner "null" }
    returner t
}

# ─── Tabellar ────────────────────────────────────────────────────────────────

# builtin.<namn> → [aritet, atom]. Alle andre builtins gjev «ustøtta builtin».
funksjon builtin_tabell() -> ordbok {
    returner {"skriv": [1, "skriv"], "lengde": [1, "lengde"], "tekst": [1, "tekst_av"],
              "tekst_fra_heltall": [1, "tekst_av"], "heltall": [1, "heltall_av"],
              "heltall_fra_tekst": [1, "heltall_av"], "legg_til": [2, "legg_til"],
              "har_nokkel": [2, "har_nokkel"], "nøkler": [1, "nøkler"], "slice": [3, "slice"],
              "char_code": [1, "char_code"], "chr": [1, "chr"], "type": [1, "type_namn"],
              "for_iterabel": [1, "for_iterabel"], "desimaltall": [1, "desimal_av"], "typenamn": [1, "typenamn"],
              "fjern_nokkel": [2, "fjern_nokkel"], "fjern_nøkkel": [2, "fjern_nokkel"], "tid_ms": [0, "tid_ms"]}
}

# W3: builtin.<namn> → funksjon i runtime-biblioteket std/wasm_rt.no (vanleg Norscode, kompilert
# av same lowring). Aritet og semantikk er VM-builtinen sin. Modulen må vere lenka inn med
# `lenk_rt` (tools/nc_wasm.no gjer det); berre funksjonane programmet når, kjem med.
funksjon rt_modul() -> tekst {
    returner "std.wasm_rt"
}

funksjon rt_tabell() -> ordbok {
    returner {"split": "splitt", "tekst_splitt": "splitt", "join": "saman", "tekst_join": "saman",
              "trim": "trim_tekst", "tekst_trim": "trim_tekst", "replace": "erstatt", "tekst_erstatt": "erstatt",
              "starts_with": "starter_med", "tekst_starter_med": "starter_med",
              "ends_with": "slutter_med", "tekst_slutter_med": "slutter_med",
              "contains": "inneheld", "tekst_inneholder": "inneheld", "index_of": "finn_indeks", "tekst_indeks": "finn_indeks",
              "lower": "til_små", "tekst_sma": "til_små", "upper": "til_store", "tekst_store": "til_store",
              "json_parse_raw": "json_parse", "json_stringify": "json_skriv", "sha256": "sha256_hex",
              "verdier": "verdiar"}
}

# Tilleggstekst til «ustøtta builtin» der det finst ein støtta veg.
funksjon _builtin_hint(namn: tekst) -> tekst {
    hvis namn == "json_parse" { returner " (VM-en sin json_parse gjev tekstverdiar; bruk json_parse_raw for typa verdiar)" }
    hvis namn == "tekst_til_liste" eller namn == "sorter" eller namn == "sortert" {
        returner " (finst som std.wasm_rt." + namn + ": bruk std.wasm_rt som rt)"
    }
    returner ""
}

# Lenk runtime-biblioteket inn i klient-NCB-en: funksjonane, globalnamna og modul-
# initialiseringane til alle modulane i rt_ncb utanom __main__ (std.wasm_rt og det han
# importerer, t.d. std.sha256), når klienten ikkje alt har dei. Gjev ein ny NCB; ncb er urørt.
funksjon lenk_rt(ncb: ordbok, rt_ncb: ordbok) -> ordbok {
    la ut = {}
    la nk = nøkler(ncb)
    la i = 0
    mens i < lengde(nk) {
        ut[nk[i]] = ncb[nk[i]]
        i = i + 1
    }
    la fns = {}
    la fk = nøkler(ncb["functions"])
    i = 0
    mens i < lengde(fk) {
        fns[fk[i]] = ncb["functions"][fk[i]]
        i = i + 1
    }
    la globale = {}
    hvis finnes_nøkkel(ncb, "global_names") {
        la gk = nøkler(ncb["global_names"])
        i = 0
        mens i < lengde(gk) {
            globale[gk[i]] = ncb["global_names"][gk[i]]
            i = i + 1
        }
    }
    la inits = []
    hvis finnes_nøkkel(ncb, "module_initializers") { _la_til(inits, ncb["module_initializers"]) }
    la init_sett = {}
    i = 0
    mens i < lengde(inits) {
        init_sett[tekst(inits[i])] = sann
        i = i + 1
    }
    la rfns = rt_ncb["functions"]
    la rk = nøkler(rfns)
    i = 0
    mens i < lengde(rk) {
        la q = tekst(rk[i])
        la m = tekst(rfns[q]["module"])
        hvis m != "__main__" og ikkje finnes_nøkkel(fns, q) {
            fns[q] = rfns[q]
            hvis finnes_nøkkel(rt_ncb, "global_names") og finnes_nøkkel(rt_ncb["global_names"], m) og ikkje finnes_nøkkel(globale, m) {
                globale[m] = rt_ncb["global_names"][m]
            }
        }
        i = i + 1
    }
    hvis finnes_nøkkel(rt_ncb, "module_initializers") {
        la ri = rt_ncb["module_initializers"]
        i = 0
        mens i < lengde(ri) {
            la iq = tekst(ri[i])
            hvis finnes_nøkkel(rfns, iq) og tekst(rfns[iq]["module"]) != "__main__" og ikkje finnes_nøkkel(init_sett, iq) {
                init_sett[iq] = sann
                legg_til(inits, iq)
            }
            i = i + 1
        }
    }
    ut["functions"] = fns
    ut["global_names"] = globale
    ut["module_initializers"] = inits
    returner ut
}

# NCB-opkode → atom.
funksjon binær_atom_kart() -> ordbok {
    returner {"BINARY_ADD": "add", "BINARY_SUB": "sub", "BINARY_MUL": "mul",
              "BINARY_AND": "and", "BINARY_OR": "or", "BINARY_XOR": "xor",
              "BINARY_LSHIFT": "shl", "BINARY_RSHIFT": "shr"}
}

# Ordna samanlikningar: cmp gjev −1/0/1/2; tabellen er instruksjonane som gjer det om til
# i32 (0/1) før bool-atomet.
funksjon samanlikn_kart() -> ordbok {
    returner {"COMPARE_LT": [65, 127, 70], "COMPARE_GT": [65, 1, 70],
              "COMPARE_GE": [65, 2, 73], "COMPARE_LE": [65, 1, 106, 65, 2, 73]}
}

# Fangtypar som fangar alt (vm_handler_match).
funksjon _jokertype(t: tekst) -> bool {
    returner t == "" eller t == "*" eller t == "alle"
}

# R2/F14: modulen til LOAD_GLOBAL/STORE_GLOBAL — den valfrie tredje operanden, elles
# modulen til funksjonen.
funksjon _global_modul(ins: liste, modul: tekst) -> tekst {
    hvis lengde(ins) > 2 og ins[2] != null og builtin.type(ins[2]) == "tekst" og tekst(ins[2]) != "" { returner tekst(ins[2]) }
    returner modul
}

# R2/F20: er q ein kompilert struktur-konstruktør («modul.Namn» med "struct": true)?
funksjon _er_struktur_fn(k: ordbok, q: tekst) -> bool {
    hvis ikkje finnes_nøkkel(k["fns"], q) { returner usann }
    la fd = k["fns"][q]
    returner finnes_nøkkel(fd, "struct") og fd["struct"] == sann
}

# Konstruktørane i NCB-en (kvalifiserte namn), i NCB-rekkjefølgje.
funksjon _strukturar(k: ordbok) -> liste {
    hvis finnes_nøkkel(k, "strukturar_c") { returner k["strukturar_c"] }
    la ut = []
    la namn = nøkler(k["fns"])
    la i = 0
    mens i < lengde(namn) {
        hvis _er_struktur_fn(k, tekst(namn[i])) { legg_til(ut, tekst(namn[i])) }
        i = i + 1
    }
    k["strukturar_c"] = ut
    returner ut
}

# ─── Kontekst ────────────────────────────────────────────────────────────────

funksjon _ny_kontekst(ncb: ordbok, testbygg: bool) -> ordbok {
    la globale = {}
    hvis finnes_nøkkel(ncb, "global_names") { globale = ncb["global_names"] }
    la tabell = vert.vertsfunksjonar()
    la vert_idx = {}
    la i = 0
    mens i < lengde(tabell) {
        vert_idx[tekst(tabell[i]["namn"])] = tabell[i]
        i = i + 1
    }
    returner {
        "ncb": ncb, "fns": ncb["functions"], "globale": globale, "testbygg": testbygg,
        "vert_modul": "std.wasm_vert", "feil": [], "feil_sett": {}, "tabell": tabell, "vert_idx": vert_idx,
        "binop": binær_atom_kart(), "cmpop": samanlikn_kart(), "builtins": builtin_tabell(), "rt": rt_tabell(),
        "nåbare": [], "nåbar_sett": {}, "analyse": {}, "flyt": usann,
        "vert_brukt": {}, "atom_direkte": {}, "tilbakekall": {}, "tilbakekall_liste": [], "tilbakekall_namn": {},
        "lit": [], "lit_idx": {}, "data": [], "strengar": {},
        "lambda": {}, "bruker_lambda": usann, "dyn": {}, "dyn_liste": [], "dyn_kand": {},
        "har_throw": usann, "har_eh": usann, "struktur": usann, "kast_ok": usann,
        "gen": {}, "gen_liste": [], "glob_mod": {}, "glob_mod_liste": [],
        "reloc": usann, "reloc_ok": sann, "rt_cache": {}, "rt_cache_på": usann, "rt_cache_fil": "", "rt_cache_mappe": "", "rt_cache_rot": "", "rt_ny": {}, "rt_treff": 0, "rt_bomm": 0,
        "rt_analyse_treff": 0, "rt_effekt": {}, "opptak": null, "kode_s": {}
    }
}

funksjon _feil(k: ordbok, q: tekst, melding: tekst) -> heltall {
    la m = "funksjon " + q + ": " + melding
    hvis ikkje finnes_nøkkel(k["feil_sett"], m) {
        k["feil_sett"][m] = sann
        legg_til(k["feil"], m)
    }
    returner 0
}

funksjon _legg_nåbar(k: ordbok, q: tekst) -> heltall {
    hvis k["opptak"] != null { legg_til(k["opptak"]["nåbare"], q) }
    hvis ikkje finnes_nøkkel(k["nåbar_sett"], q) {
        k["nåbar_sett"][q] = sann
        legg_til(k["nåbare"], q)
    }
    returner 0
}

funksjon _bruk_atom(k: ordbok, namn: tekst) -> heltall {
    hvis k["opptak"] != null { legg_til(k["opptak"]["atom"], namn) }
    k["atom_direkte"][namn] = sann
    returner 0
}

# W7: analysen rører noko som ikkje kan spelast av frå analysecachen (closures, CALL_VALUE,
# ncb_call_fn og vertsfunksjonar). Før vart det avgjort ved å samanlikne storleiken på
# settet før og etter, men då vart verknadene tekne opp når settet ALT hadde oppføringa frå
# ein annan funksjon (t.d. ein dispatcher for ncb_call_fn med same aritet), og eit anna
# program som brukte oppføringa, fekk ein kropp som kalla ein dispatcher som ikkje fanst.
funksjon _opptak_urein(k: ordbok) -> heltall {
    hvis k["opptak"] != null { k["opptak"]["urein"] = sann }
    returner 0
}

# Transitiv lukking over atom_avheng (etter analysen, når k["flyt"] er kjend).
funksjon _atom_lukking(k: ordbok) -> ordbok {
    la sett = {}
    la arbeid = []
    la r = a.atom_rekkje()
    la i = 0
    mens i < lengde(r) {
        hvis finnes_nøkkel(k["atom_direkte"], r[i]) { legg_til(arbeid, r[i]) }
        i = i + 1
    }
    la j = 0
    mens j < lengde(arbeid) {
        la n = tekst(arbeid[j])
        hvis ikkje finnes_nøkkel(sett, n) {
            sett[n] = sann
            la dep = a.atom_avheng(n, k)
            la d = 0
            mens d < lengde(dep) {
                legg_til(arbeid, dep[d])
                d = d + 1
            }
        }
        j = j + 1
    }
    returner sett
}

# Metodekandidatar for ncb_call_fn med n argument: funksjonar `modul.Type.metode` (namnet
# etter modulprefikset inneheld eit punktum) med n parametrar, i NCB-rekkjefølgje.
funksjon _metodekandidatar(k: ordbok, n: heltall) -> liste {
    la ut = []
    la fns = k["fns"]
    la namn = nøkler(fns)
    la i = 0
    mens i < lengde(namn) {
        la q = tekst(namn[i])
        la fd = fns[q]
        la m = tekst(fd["module"])
        hvis builtin.starts_with(q, m + ".") og lengde(fd["params"]) == n {
            la rest = builtin.slice(q, lengde(m) + 1, lengde(q))
            hvis builtin.index_of(rest, ".") > 0 { legg_til(ut, q) }
        }
        i = i + 1
    }
    returner ut
}

# ─── Små listehjelparar for den abstrakte unnatakstilstanden ─────────────────

funksjon _med(l: liste, x) -> liste {
    la ut = []
    _la_til(ut, l)
    legg_til(ut, x)
    returner ut
}

funksjon _første(l: liste, n: heltall) -> liste {
    la ut = []
    la i = 0
    mens i < n og i < lengde(l) {
        legg_til(ut, l[i])
        i = i + 1
    }
    returner ut
}

funksjon _utan_siste(l: liste) -> liste {
    returner _første(l, lengde(l) - 1)
}

funksjon _tc_nøkkel(T: liste, C: liste) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(T) { ut = ut + tekst(T[i]) + ","  i = i + 1 }
    ut = ut + "|"
    i = 0
    mens i < lengde(C) { ut = ut + tekst(C[i]) + ","  i = i + 1 }
    returner ut
}

# ─── Analyse (pass 1): blokker, stakkhøgder, unnatakstilstand, roller ─────────

funksjon _push(st: ordbok, kind: tekst) -> heltall {
    la h = st["h"]
    hvis h < lengde(st["k"]) { st["k"][h] = kind } ellers { legg_til(st["k"], kind) }
    st["h"] = h + 1
    hvis st["h"] > st["maks"] { st["maks"] = st["h"] }
    returner 0
}

# Pop éin verdi. Gjev kinden («v» eller «t:<instruksjonsindeks>» for ein tekstkonstant),
# eller "" ved underflyt.
funksjon _pop(st: ordbok) -> tekst {
    hvis st["h"] <= 0 { returner "" }
    st["h"] = st["h"] - 1
    returner tekst(st["k"][st["h"]])
}

funksjon _pop_verdi(k: ordbok, q: tekst, st: ordbok, kva: tekst) -> heltall {
    hvis _pop(st) == "" { _feil(k, q, "stakkunderflyt ved " + kva) }
    returner 0
}

funksjon _pop_n(k: ordbok, q: tekst, st: ordbok, n: heltall, kva: tekst) -> heltall {
    la i = 0
    mens i < n {
        _pop_verdi(k, q, st, kva)
        i = i + 1
    }
    returner 0
}

# Opkodar som avsluttar ei basisblokk. TRY_BEGIN, TRY_END og FINALLY_PUSH endrar berre
# unnatakstilstanden og fell gjennom; dei avsluttar blokka så tilstanden er konstant i kvar.
funksjon _er_terminator(op: tekst) -> bool {
    returner op == "JUMP" eller op == "JUMP_IF_FALSE" eller op == "RETURN" eller op == "THROW" eller
             op == "FINALLY_RUN" eller op == "FINALLY_END" eller op == "TRY_BEGIN" eller op == "TRY_END" eller
             op == "FINALLY_PUSH"
}

# Ny inngang til blokka b2 med stakkhøgd h og unnatakstilstand (T, C, P). Unnataks- og
# endeleg-kantar: alle stakkverdiane er «v» (ukjende).
funksjon _flett(k: ordbok, q: tekst, an: ordbok, b2: heltall, h: heltall, T: liste, C: liste, P: heltall, arbeid: liste) -> heltall {
    returner _flett_st(k, q, an, b2, h, T, C, P, arbeid, null)
}

# Som _flett, men med kindane på stakken frå st (vanlege kantar: hopp og gjennomfall). R2:
# ein tekstkonstant («t:<i>») held seg over blokkgrenser når alle vegar inn har same
# konstant, så metodenamnet i `p.m(a og b)` (der argumentet lagar blokker) er kjent.
funksjon _flett_st(k: ordbok, q: tekst, an: ordbok, b2: heltall, h: heltall, T: liste, C: liste, P: heltall, arbeid: liste, st) -> heltall {
    la hoyde = an["hoyde"]
    la nk = _tc_nøkkel(T, C)
    la kinds = []
    la ki = 0
    mens ki < h {
        hvis st != null og ki < st["h"] { legg_til(kinds, tekst(st["k"][ki])) } ellers { legg_til(kinds, "v") }
        ki = ki + 1
    }
    hvis hoyde[b2] < 0 {
        hoyde[b2] = h
        an["tT"][b2] = T
        an["tC"][b2] = C
        an["tP"][b2] = P
        an["tkey"][b2] = nk
        an["tK"][b2] = kinds
        legg_til(arbeid, b2)
    } ellers hvis hoyde[b2] != h {
        _feil(k, q, "ulik stakkhøgd ved blokk " + tekst(b2) + " (" + tekst(hoyde[b2]) + " mot " + tekst(h) + ")")
    } ellers hvis an["tkey"][b2] != nk {
        _feil(k, q, "ulik unntakstilstand ved blokk " + tekst(b2) + " (" + an["tkey"][b2] + " mot " + nk +
              "): hopp ut av ei prøv-blokk (bryt/fortsett) og utsett i ei lykkje er ikkje støtta")
    } ellers {
        la igjen = usann
        hvis (an["tP"][b2] | P) != an["tP"][b2] {
            an["tP"][b2] = an["tP"][b2] | P
            igjen = sann
        }
        # Ulike kindar på same plass blir «v» (monotont, så arbeidslista endar)
        la gk = an["tK"][b2]
        ki = 0
        mens ki < h {
            hvis gk[ki] != "v" og gk[ki] != kinds[ki] {
                gk[ki] = "v"
                igjen = sann
            }
            ki = ki + 1
        }
        hvis igjen { legg_til(arbeid, b2) }
    }
    returner 0
}

# Kantane eit unnatak i blokka (tilstand T, C) kan ta: øvste handterarar over opprydjings-
# grensa (til og med første jokertype), så endeleg-blokka med pending=throw.
funksjon _unnatak_kantar(k: ordbok, q: tekst, an: ordbok, T: liste, C: liste, P: heltall, arbeid: liste) -> heltall {
    la td = 0
    hvis lengde(C) > 0 { td = an["cln"][tekst(C[lengde(C) - 1])]["td"] }
    la i = lengde(T) - 1
    mens i >= td {
        la h = an["try"][tekst(T[i])]
        hvis finnes_nøkkel(an["labels"], h["lbl"]) {
            _flett(k, q, an, an["labels"][h["lbl"]], h["h"], _første(T, i + 1), C, P, arbeid)
        }
        hvis _jokertype(h["type"]) { returner 0 }
        i = i - 1
    }
    hvis lengde(C) > 0 {
        la c = an["cln"][tekst(C[lengde(C) - 1])]
        hvis finnes_nøkkel(an["labels"], c["lbl"]) {
            _flett(k, q, an, an["labels"][c["lbl"]], c["h"], _første(T, c["td"]), _utan_siste(C), 4, arbeid)
        }
    }
    returner 0
}

funksjon _etikett(k: ordbok, q: tekst, an: ordbok, lbl: tekst) -> heltall {
    hvis ikkje finnes_nøkkel(an["labels"], lbl) {
        _feil(k, q, "ukjend etikett " + lbl)
        returner -1
    }
    returner an["labels"][lbl]
}

funksjon _analyser(k: ordbok, q: tekst) -> heltall {
    la fd = k["fns"][q]
    la modul = tekst(fd["module"])
    la params = fd["params"]
    la kode = fd["code"]
    la n = lengde(kode)
    la er_lambda = finnes_nøkkel(k["lambda"], q)
    la np_w = lengde(params)
    hvis er_lambda { np_w = np_w + 1 }
    la an = {"q": q, "modul": modul, "np": lengde(params), "np_w": np_w, "lambda": er_lambda, "lok": {}, "n_lok": 0,
             "fangar": [], "blokker": [], "labels": {}, "hoyde": [], "tT": [], "tC": [], "tP": [], "tkey": [], "tK": [], "gen_kall": {},
             "rolle": {}, "maks_slot": 0, "dup": usann, "konst_div": {}, "eh": usann,
             "try": {}, "cln": {}, "fr_mål": {}, "ret_mål": {}, "ret_drop": {}, "fe_p": {}}
    k["analyse"][q] = an
    hvis finnes_nøkkel(fd, "is_async") og fd["is_async"] == sann {
        _feil(k, q, "asynkrone funksjonar er ikkje støtta enno")
    }
    la i = 0
    mens i < lengde(params) {
        an["lok"][tekst(params[i])] = i
        i = i + 1
    }
    # Lambda-hjelpar: fangarane kjem som ein $arr i parameteren etter dei vanlege og blir
    # kopierte til lokale først i kroppen.
    hvis er_lambda {
        la caps = k["lambda"][q]
        i = 0
        mens i < lengde(caps) {
            la cn = tekst(caps[i])
            hvis ikkje finnes_nøkkel(an["lok"], cn) {
                an["lok"][cn] = np_w + an["n_lok"]
                an["n_lok"] = an["n_lok"] + 1
                legg_til(an["fangar"], cn)
            }
            i = i + 1
        }
    }
    # Lokale: alle STORE_NAME-mål som ikkje er parametrar eller fangarar
    i = 0
    mens i < n {
        la ins = kode[i]
        la op0 = tekst(ins[0])
        hvis op0 == "STORE_NAME" og ikkje finnes_nøkkel(an["lok"], tekst(ins[1])) {
            an["lok"][tekst(ins[1])] = np_w + an["n_lok"]
            an["n_lok"] = an["n_lok"] + 1
        }
        hvis op0 == "DUP" eller op0 == "CALL_VALUE" { an["dup"] = sann }
        hvis op0 == "TRY_BEGIN" eller op0 == "FINALLY_PUSH" { an["eh"] = sann }
        i = i + 1
    }
    hvis an["eh"] { _flagg(k, "har_eh") }
    # Basisblokker: leiarar ved 0, ved kvar LABEL og etter kvar terminator
    la leiar = []
    i = 0
    mens i < n { legg_til(leiar, usann)  i = i + 1 }
    hvis n > 0 { leiar[0] = sann }
    i = 0
    mens i < n {
        la op = tekst(kode[i][0])
        hvis op == "LABEL" { leiar[i] = sann }
        hvis _er_terminator(op) og i + 1 < n { leiar[i + 1] = sann }
        i = i + 1
    }
    i = 0
    mens i < n {
        hvis leiar[i] {
            la j = i + 1
            mens j < n og ikkje leiar[j] { j = j + 1 }
            legg_til(an["blokker"], {"start": i, "slutt": j})
            legg_til(an["hoyde"], -1)
            legg_til(an["tT"], [])
            legg_til(an["tC"], [])
            legg_til(an["tP"], 0)
            legg_til(an["tkey"], "")
            legg_til(an["tK"], [])
            hvis tekst(kode[i][0]) == "LABEL" { an["labels"][tekst(kode[i][1])] = lengde(an["blokker"]) - 1 }
        }
        i = i + 1
    }
    hvis n == 0 {
        _feil(k, q, "tom funksjonskropp")
        returner 0
    }
    # Stakkhøgder og unnatakstilstand (arbeidsliste frå blokk 0; ei blokk blir teken opp att
    # når P-mengda hennar veks)
    an["hoyde"][0] = 0
    an["tT"][0] = []
    an["tC"][0] = []
    an["tP"][0] = 1
    an["tkey"][0] = "|"
    an["tK"][0] = []
    la arbeid = [0]
    la ai = 0
    mens ai < lengde(arbeid) {
        la bi = arbeid[ai]
        ai = ai + 1
        la blk = an["blokker"][bi]
        la st = {"k": [], "h": 0, "maks": 0}
        la hi = 0
        mens hi < an["hoyde"][bi] { _push(st, tekst(an["tK"][bi][hi]))  hi = hi + 1 }
        la T0 = an["tT"][bi]
        la C0 = an["tC"][bi]
        la T = T0
        la C = C0
        la P = an["tP"][bi]
        la P_alle = P
        la avslutta = usann
        la ii = blk["start"]
        mens ii < blk["slutt"] {
            la ins = kode[ii]
            la op = tekst(ins[0])
            hvis op == "LABEL" {
            } ellers hvis op == "PUSH_CONST" {
                la tn = _type_namn(ins[1])
                hvis tn == "heltall" eller tn == "bool" eller tn == "null" { _push(st, "v") }
                ellers hvis tn == "tekst" {
                    # R2: «__struktur__» i koden (konstruktørane) → modulen kan ha strukturar,
                    # så nøkler/lengde må gøyme merka
                    hvis ins[1] == "__struktur__" { _flagg(k, "struktur") }
                    _push(st, "t:" + tekst(ii))
                }
                ellers hvis tn == "desimaltall" {
                    _flagg(k, "flyt")
                    _push(st, "v")
                } ellers {
                    _feil(k, q, "konstant av typen " + tn + " er ikkje støtta")
                    _push(st, "v")
                }
            } ellers hvis op == "LOAD_NAME" {
                hvis ikkje finnes_nøkkel(an["lok"], tekst(ins[1])) { _feil(k, q, "ukjend namn " + tekst(ins[1])) }
                _push(st, "v")
            } ellers hvis op == "STORE_NAME" {
                _pop_verdi(k, q, st, "STORE_NAME " + tekst(ins[1]))
            } ellers hvis op == "LOAD_GLOBAL" eller op == "STORE_GLOBAL" {
                la gn = tekst(ins[1])
                # R2/F14: valfri tredje operand = modulen globalen ligg i (alias.NAMN)
                la gmod = _global_modul(ins, modul)
                la finst = usann
                hvis finnes_nøkkel(k["globale"], gmod) {
                    la gl = k["globale"][gmod]
                    la gi = 0
                    mens gi < lengde(gl) {
                        hvis tekst(gl[gi]) == gn { finst = sann }
                        gi = gi + 1
                    }
                }
                hvis ikkje finst { _feil(k, q, "ukjend global " + gmod + "." + gn) }
                hvis gmod != modul {
                    # Globalen og modulinitialiseringa til den andre modulen må med, sjølv om
                    # ingen funksjon i han er nåbar
                    _opptak_urein(k)
                    hvis ikkje finnes_nøkkel(k["glob_mod"], gmod) {
                        k["glob_mod"][gmod] = sann
                        legg_til(k["glob_mod_liste"], gmod)
                    }
                }
                hvis op == "LOAD_GLOBAL" { _push(st, "v") } ellers { _pop_verdi(k, q, st, "STORE_GLOBAL " + gn) }
            } ellers hvis finnes_nøkkel(k["binop"], op) {
                _pop_n(k, q, st, 2, op)
                _push(st, "v")
                _bruk_atom(k, k["binop"][op])
            } ellers hvis op == "BINARY_DIV" eller op == "BINARY_MOD" {
                # Konstant divisor ≠ 0 rett før: ingen nullsjekk (og ingen feilveg i modulen)
                la atom = "div"
                hvis op == "BINARY_MOD" { atom = "mod" }
                hvis ii > blk["start"] {
                    la førre = kode[ii - 1]
                    hvis tekst(førre[0]) == "PUSH_CONST" og builtin.type(førre[1]) == "heltall" {
                        hvis førre[1] != 0 {
                            atom = atom + "_k"
                            an["konst_div"][tekst(ii)] = sann
                        }
                    }
                }
                _pop_n(k, q, st, 2, op)
                _push(st, "v")
                _bruk_atom(k, atom)
            } ellers hvis op == "COMPARE_EQ" eller op == "COMPARE_NE" {
                _pop_n(k, q, st, 2, op)
                _push(st, "v")
                _bruk_atom(k, "lik")
                _bruk_atom(k, "bool")
            } ellers hvis finnes_nøkkel(k["cmpop"], op) {
                _pop_n(k, q, st, 2, op)
                _push(st, "v")
                _bruk_atom(k, "cmp")
                _bruk_atom(k, "bool")
            } ellers hvis op == "UNARY_NEG" {
                _pop_verdi(k, q, st, op)
                _push(st, "v")
                _bruk_atom(k, "neg")
            } ellers hvis op == "UNARY_NOT" {
                _pop_verdi(k, q, st, op)
                _push(st, "v")
                _bruk_atom(k, "sannhet")
                _bruk_atom(k, "bool")
            } ellers hvis op == "BUILD_LIST" {
                _pop_n(k, q, st, ins[1], op)
                _push(st, "v")
                _bruk_atom(k, "liste_frå_arr")
            } ellers hvis op == "BUILD_MAP" {
                _pop_n(k, q, st, 2 * ins[1], op)
                _push(st, "v")
                _bruk_atom(k, "ordbok_frå_par")
            } ellers hvis op == "INDEX_GET" {
                _pop_n(k, q, st, 2, op)
                _push(st, "v")
                _bruk_atom(k, "indeks_hent")
            } ellers hvis op == "INDEX_SET" {
                _pop_n(k, q, st, 3, op)
                _push(st, "v")
                _bruk_atom(k, "indeks_set")
            } ellers hvis op == "POP" {
                _pop_verdi(k, q, st, op)
            } ellers hvis op == "DUP" {
                _pop_verdi(k, q, st, op)
                _push(st, "v")
                _push(st, "v")
            } ellers hvis op == "CALL" {
                _analyser_kall(k, an, q, modul, ins, st, ii)
            } ellers hvis op == "BUILD_LAMBDA" {
                _analyser_lambda(k, an, q, ins)
                _push(st, "v")
            } ellers hvis op == "CALL_VALUE" {
                _pop_n(k, q, st, ins[1] + 1, op)
                _push(st, "v")
                _opptak_urein(k)
                k["bruker_lambda"] = sann
            } ellers hvis op == "RETURN" {
                _pop_verdi(k, q, st, op)
                hvis lengde(C) > 0 {
                    # returner inne i endeleg/utsett: endeleg-blokka først, pending=return
                    la c = an["cln"][tekst(C[lengde(C) - 1])]
                    la mb = _etikett(k, q, an, c["lbl"])
                    hvis st["h"] < c["h"] { _feil(k, q, "RETURN under stakkhøgda til endeleg-blokka") }
                    hvis mb >= 0 {
                        an["ret_mål"][tekst(ii)] = mb
                        an["ret_drop"][tekst(ii)] = st["h"] - c["h"]
                        _flett(k, q, an, mb, c["h"], _første(T, c["td"]), _utan_siste(C), 2, arbeid)
                    }
                }
                avslutta = sann
            } ellers hvis op == "THROW" {
                _pop_verdi(k, q, st, op)
                _flagg(k, "har_throw")
                avslutta = sann
            } ellers hvis op == "TRY_BEGIN" {
                la typ = "*"
                hvis lengde(ins) > 2 { typ = tekst(ins[2]) }
                an["try"][tekst(ii)] = {"lbl": tekst(ins[1]), "type": typ, "h": st["h"]}
                _etikett(k, q, an, tekst(ins[1]))
                hvis ikkje _jokertype(typ) { _bruk_atom(k, "unntak_passar") }
                T = _med(T, ii)
            } ellers hvis op == "TRY_END" {
                hvis lengde(T) > 0 { T = _utan_siste(T) }
            } ellers hvis op == "FINALLY_PUSH" {
                an["cln"][tekst(ii)] = {"lbl": tekst(ins[1]), "td": lengde(T), "h": st["h"]}
                _etikett(k, q, an, tekst(ins[1]))
                C = _med(C, ii)
            } ellers hvis op == "FINALLY_RUN" {
                hvis lengde(C) == 0 {
                    _feil(k, q, "FINALLY_RUN utan aktiv endeleg-blokk")
                } ellers {
                    la c = an["cln"][tekst(C[lengde(C) - 1])]
                    la mb = _etikett(k, q, an, c["lbl"])
                    hvis mb >= 0 {
                        an["fr_mål"][tekst(ii)] = mb
                        _flett(k, q, an, mb, st["h"], T, _utan_siste(C), 1, arbeid)
                    }
                }
                avslutta = sann
            } ellers hvis op == "FINALLY_END" {
                an["fe_p"][tekst(ii)] = P
                hvis (P & 1) != 0 {
                    la m1 = _etikett(k, q, an, tekst(ins[1]))
                    hvis m1 >= 0 { _flett(k, q, an, m1, st["h"], T, C, P, arbeid) }
                }
                hvis (P & 2) != 0 {
                    la m2 = _etikett(k, q, an, tekst(ins[2]))
                    hvis m2 >= 0 { _flett(k, q, an, m2, st["h"], T, C, P, arbeid) }
                }
                hvis (P & 4) != 0 {
                    la m3 = _etikett(k, q, an, tekst(ins[3]))
                    hvis m3 >= 0 { _flett(k, q, an, m3, st["h"], T, C, P, arbeid) }
                }
                avslutta = sann
            } ellers hvis op == "LOAD_PENDING" eller op == "LOAD_EXCEPTION" {
                _push(st, "v")
            } ellers hvis op == "CLEAR_PENDING" {
                P = 1
            } ellers hvis op == "JUMP" {
                la mj = _etikett(k, q, an, tekst(ins[1]))
                hvis mj >= 0 { _flett_st(k, q, an, mj, st["h"], T, C, P, arbeid, st) }
                avslutta = sann
            } ellers hvis op == "JUMP_IF_FALSE" {
                _pop_verdi(k, q, st, op)
                _bruk_atom(k, "sannhet")
                la mf = _etikett(k, q, an, tekst(ins[1]))
                hvis mf >= 0 { _flett_st(k, q, an, mf, st["h"], T, C, P, arbeid, st) }
                hvis bi + 1 < lengde(an["blokker"]) { _flett_st(k, q, an, bi + 1, st["h"], T, C, P, arbeid, st) }
                avslutta = sann
            } ellers {
                _feil(k, q, "ustøtta opcode " + op)
            }
            P_alle = P_alle | P
            ii = ii + 1
        }
        # Unnatak i blokka (tilstanden ved inngangen gjeld heile blokka)
        hvis lengde(T0) > 0 eller lengde(C0) > 0 {
            _unnatak_kantar(k, q, an, T0, C0, P_alle, arbeid)
        }
        hvis ikkje avslutta {
            hvis bi + 1 < lengde(an["blokker"]) {
                _flett_st(k, q, an, bi + 1, st["h"], T, C, P, arbeid, st)
            } ellers {
                _feil(k, q, "funksjonen endar utan RETURN")
            }
        }
        hvis st["maks"] > an["maks_slot"] { an["maks_slot"] = st["maks"] }
    }
    returner 0
}

funksjon _analyser_lambda(k: ordbok, an: ordbok, q: tekst, ins: liste) -> heltall {
    _opptak_urein(k)
    la mål = tekst(ins[1])
    la caps = ins[2]
    hvis ikkje finnes_nøkkel(k["fns"], mål) {
        _feil(k, q, "BUILD_LAMBDA: finn ikkje funksjonen " + mål)
        returner 0
    }
    la cn = []
    la i = 0
    mens i < lengde(caps) {
        la c = tekst(caps[i])
        hvis ikkje finnes_nøkkel(an["lok"], c) { _feil(k, q, "closuren " + mål + " fangar " + c + ", som ikkje er ein lokal variabel her") }
        legg_til(cn, c)
        i = i + 1
    }
    hvis finnes_nøkkel(k["lambda"], mål) {
        hvis builtin.join(k["lambda"][mål], ",") != builtin.join(cn, ",") {
            _feil(k, q, "closuren " + mål + " blir bygd med ulike fangarar")
        }
    } ellers {
        hvis finnes_nøkkel(k["analyse"], mål) { _feil(k, q, mål + " blir både kalla direkte og brukt som closure") }
        k["lambda"][mål] = cn
    }
    k["bruker_lambda"] = sann
    _legg_nåbar(k, mål)
    returner 0
}

# R2/F20 + F21: builtin.kall_metode(mott, "metode", args…) og builtin.er_instans(v, "modul.Type").
# Kompilatoren pushar metode-/typenamnet som ein tekstkonstant (PUSH_CONST) rett før dei andre
# argumenta; han blir løyst her (òg over blokkgrenser, sjå _flett_st) og kallet går til ein
# generert funksjon per (metode, aritet) eller per type (_gen_kropp). Konstanten blir ikkje
# laga i modulen (rolla «null»: ref.null i staden for ein $tekst). Eit namn som ikkje er ein
# konstant, er ein kompileringsfeil.
funksjon _analyser_r2_kall(k: ordbok, an: ordbok, q: tekst, kort: tekst, n: heltall, st: ordbok, ii: heltall) -> heltall {
    _opptak_urein(k)
    hvis (kort == "kall_metode" og n < 2) eller (kort == "er_instans" og n != 2) {
        _feil(k, q, "builtin." + kort + " med " + tekst(n) + " argument er ikkje støtta")
        returner 0
    }
    la base = st["h"] - n
    hvis base < 0 {
        _feil(k, q, "stakkunderflyt ved builtin." + kort)
        returner 0
    }
    la kind = tekst(st["k"][base + 1])
    hvis ikkje builtin.starts_with(kind, "t:") {
        _feil(k, q, "builtin." + kort + ": metode- eller typenamnet må vere ein tekstkonstant (dynamisk namn er ikkje støtta)")
        returner 0
    }
    la ci = builtin.heltall_fra_tekst(builtin.slice(kind, 2, lengde(kind)))
    la namn = tekst(k["fns"][q]["code"][ci][1])
    an["rolle"][tekst(ci)] = {"art": "null"}
    la nøkkel = ""
    hvis kort == "kall_metode" { nøkkel = _gen_metode(k, q, namn, n - 2) } ellers { nøkkel = _gen_instans(k, namn) }
    an["gen_kall"][tekst(ii)] = nøkkel
    returner 0
}

# Dispatcher for mott.m(a1..an): kandidatane er konstruktørane S med ein funksjon «S.m»
# (eksakt oppslag på __struktur__, som vm_metode_løys). Metodar med rett aritet blir nåbare;
# feil aritet gjev ArgumentFeil ved køyring, som VM-en.
funksjon _gen_metode(k: ordbok, q: tekst, m: tekst, na: heltall) -> tekst {
    la nøkkel = "m:" + m + "/" + tekst(na)
    hvis ikkje finnes_nøkkel(k["gen"], nøkkel) {
        la kand = []
        la ss = _strukturar(k)
        la i = 0
        mens i < lengde(ss) {
            la mq = ss[i] + "." + m
            hvis finnes_nøkkel(k["fns"], mq) {
                la np = lengde(k["fns"][mq]["params"])
                legg_til(kand, [ss[i], mq, np])
                hvis np == na + 1 {
                    hvis finnes_nøkkel(k["lambda"], mq) { _feil(k, q, mq + " er ein closure-hjelpar og kan ikkje vere ein metode") }
                    _legg_nåbar(k, mq)
                }
            }
            i = i + 1
        }
        k["gen"][nøkkel] = {"art": "metode", "m": m, "n": na, "kand": kand}
        legg_til(k["gen_liste"], nøkkel)
    }
    la at = ["tekst_av", "tekst_lik", "merke_finn", "konkat", "kast", "verdi_typenamn", "ordbok_hent"]
    la ai = 0
    mens ai < lengde(at) {
        _bruk_atom(k, at[ai])
        ai = ai + 1
    }
    returner nøkkel
}

# er_instans(v, mål): sann når v er ein struktur og __struktur__ er mål eller ein struktur som
# implementerer mål ("interfaces" i konstruktør-defen), eller (mål utan punktum) __type__ er
# mål — vm_er_instans.
funksjon _gen_instans(k: ordbok, mål: tekst) -> tekst {
    la nøkkel = "i:" + mål
    hvis ikkje finnes_nøkkel(k["gen"], nøkkel) {
        la tagg = [mål]
        la ss = _strukturar(k)
        la i = 0
        mens i < lengde(ss) {
            la fd = k["fns"][ss[i]]
            hvis ss[i] != mål og finnes_nøkkel(fd, "interfaces") {
                la gl = fd["interfaces"]
                la j = 0
                mens j < lengde(gl) {
                    hvis tekst(gl[j]) == mål {
                        legg_til(tagg, ss[i])
                        j = lengde(gl)
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        k["gen"][nøkkel] = {"art": "instans", "mål": mål, "tagg": tagg, "kort": builtin.index_of(mål, ".") < 0}
        legg_til(k["gen_liste"], nøkkel)
    }
    _bruk_atom(k, "merke_finn")
    _bruk_atom(k, "tekst_av")
    _bruk_atom(k, "tekst_lik")
    returner nøkkel
}

funksjon _analyser_kall(k: ordbok, an: ordbok, q: tekst, modul: tekst, ins: liste, st: ordbok, ii: heltall) -> heltall {
    la namn = tekst(ins[1])
    la n = ins[2]
    la vm = k["vert_modul"] + "."
    hvis builtin.starts_with(namn, "builtin.") {
        la kort_b = builtin.slice(namn, 8, lengde(namn))
        hvis kort_b == "kall_metode" eller kort_b == "er_instans" {
            _analyser_r2_kall(k, an, q, kort_b, n, st, ii)
            _pop_n(k, q, st, n, namn)
            _push(st, "v")
            returner 0
        }
        hvis kort_b == "ncb_call_fn" {
            _opptak_urein(k)
            hvis n < 1 {
                _feil(k, q, "builtin.ncb_call_fn treng minst eitt argument")
            } ellers {
                la na = n - 1
                hvis ikkje finnes_nøkkel(k["dyn"], tekst(na)) {
                    k["dyn"][tekst(na)] = sann
                    legg_til(k["dyn_liste"], na)
                    la kand = _metodekandidatar(k, na)
                    k["dyn_kand"][tekst(na)] = kand
                    la ci = 0
                    mens ci < lengde(kand) {
                        hvis finnes_nøkkel(k["lambda"], kand[ci]) { _feil(k, q, kand[ci] + " er ein closure-hjelpar og kan ikkje vere ein metode") }
                        _legg_nåbar(k, kand[ci])
                        ci = ci + 1
                    }
                }
                k["bruker_lambda"] = sann
                _bruk_atom(k, "tekst_lik")
                _bruk_atom(k, "tekst_av")
                _bruk_atom(k, "konkat")
                _bruk_atom(k, "kast")
            }
            _pop_n(k, q, st, n, namn)
            _push(st, "v")
            returner 0
        }
        hvis finnes_nøkkel(k["rt"], kort_b) {
            # R2: json_parse kan lage ordbøker med «__struktur__» (VM-en gøymer merka då òg)
            hvis kort_b == "json_parse_raw" { _flagg(k, "struktur") }
            la mål_rt = rt_modul() + "." + tekst(k["rt"][kort_b])
            hvis ikkje finnes_nøkkel(k["fns"], mål_rt) {
                _feil(k, q, "builtin." + kort_b + " krev runtime-biblioteket " + rt_modul() +
                      " (" + mål_rt + " manglar; bygg med tools/nc_wasm.no, som lenkar det inn)")
            } ellers {
                la np_rt = lengde(k["fns"][mål_rt]["params"])
                hvis n != np_rt {
                    _feil(k, q, "builtin." + kort_b + " tek " + tekst(np_rt) + " argument, fekk " + tekst(n))
                }
                _legg_nåbar(k, mål_rt)
            }
            _pop_n(k, q, st, n, namn)
            _push(st, "v")
            returner 0
        }
        hvis finnes_nøkkel(k["builtins"], kort_b) {
            la bt = k["builtins"][kort_b]
            hvis bt[1] == "desimal_av" { _flagg(k, "flyt") }
            hvis n != bt[0] {
                _feil(k, q, "builtin." + kort_b + " tek " + tekst(bt[0]) + " argument, fekk " + tekst(n))
            }
            _bruk_atom(k, bt[1])
        } ellers {
            _feil(k, q, "ustøtta builtin: " + kort_b + _builtin_hint(kort_b))
        }
        _pop_n(k, q, st, n, namn)
        _push(st, "v")
        returner 0
    }
    hvis builtin.starts_with(namn, vm) og finnes_nøkkel(k["vert_idx"], builtin.slice(namn, lengde(vm), lengde(namn))) og
         ikkje k["vert_idx"][builtin.slice(namn, lengde(vm), lengde(namn))]["intern"] {
        la kort = builtin.slice(namn, lengde(vm), lengde(namn))
        la vf = k["vert_idx"][kort]
        _opptak_urein(k)
        hvis vf["berre_test"] og ikkje k["testbygg"] {
            _feil(k, q, "vertsfunksjonen " + kort + " finst berre i testbygg (NC_WASM_TESTBYGG=1)")
        }
        la pt = vf["param"]
        hvis n != lengde(pt) {
            _feil(k, q, "vertsfunksjonen " + kort + " tek " + tekst(lengde(pt)) + " argument, fekk " + tekst(n))
            la i = 0
            mens i < n { _pop(st)  i = i + 1 }
            _push(st, "v")
            returner 0
        }
        # Argumenta ligg på st["k"][h-n .. h-1]
        la base = st["h"] - n
        hvis base < 0 {
            _feil(k, q, "stakkunderflyt ved kall til " + kort)
            returner 0
        }
        la j = 0
        mens j < n {
            la t = tekst(pt[j])
            la kind = tekst(st["k"][base + j])
            hvis vert.konstant_parameter(t) {
                hvis ikkje builtin.starts_with(kind, "t:") {
                    _feil(k, q, "argument " + tekst(j + 1) + " til " + kort + " må vere ein tekstkonstant i kjelda")
                } ellers {
                    la ci = builtin.heltall_fra_tekst(builtin.slice(kind, 2, lengde(kind)))
                    la kv = tekst(k["fns"][q]["code"][ci][1])
                    hvis t == "hending" og ikkje vert.er_hending(kv) {
                        _feil(k, q, kort + ": ukjend hending «" + kv + "» (støtta: " + _hending_namn() + ")")
                    }
                    hvis t == "attributt" og ikkje vert.trygt_attributt(kv) {
                        _feil(k, q, kort + ": attributtet «" + kv + "» er ikkje på lista over trygge attributt (ingen on…, href, src, style eller data-nc-…)")
                    }
                    hvis t == "tag" og ikkje vert.trygg_tag(kv) {
                        _feil(k, q, kort + ": taggen «" + kv + "» er ikkje på lista over trygge taggar")
                    }
                    hvis t != "funksjon" {
                        an["rolle"][tekst(ci)] = {"art": "tekst"}
                    } ellers {
                        la fnamn = tekst(k["fns"][q]["code"][ci][1])
                        la mål = modul + "." + fnamn
                        hvis ikkje finnes_nøkkel(k["fns"], mål) {
                            _feil(k, q, kort + ": finn ikkje funksjonen " + fnamn + " i modulen " + modul)
                        } ellers hvis lengde(k["fns"][mål]["params"]) != 0 {
                            _feil(k, q, kort + ": funksjonen " + fnamn + " kan ikkje ha parametrar")
                        } ellers {
                            hvis ikkje finnes_nøkkel(k["tilbakekall"], mål) {
                                # Eksportnamnet er «_<funksjonsnamn>» (W4): deleger() kallar
                                # eksporten som data-nc-attributtet namngjev.
                                la en = "_" + fnamn
                                hvis finnes_nøkkel(k["tilbakekall_namn"], en) {
                                    _feil(k, q, kort + ": to tilbakekall har kortnamnet " + fnamn + " (" + k["tilbakekall_namn"][en] + " og " + mål + ")")
                                }
                                k["tilbakekall_namn"][en] = mål
                                k["tilbakekall"][mål] = en
                                legg_til(k["tilbakekall_liste"], mål)
                            }
                            _legg_nåbar(k, mål)
                            an["rolle"][tekst(ci)] = {"art": "funksjon", "mål": mål}
                        }
                    }
                }
            } ellers hvis (t == "heltall" eller t == "handtak" eller t == "tal") og builtin.starts_with(kind, "t:") {
                _feil(k, q, "argument " + tekst(j + 1) + " til " + kort + " må vere eit heltal, ikkje tekst")
            }
            j = j + 1
        }
        st["h"] = base
        _push(st, "v")
        k["vert_brukt"][kort] = sann
        la pi = 0
        la n_verdi = 0
        mens pi < lengde(pt) {
            hvis pt[pi] == "handtak" eller pt[pi] == "heltall" eller pt[pi] == "tal" { _bruk_atom(k, "til_i64") }
            hvis pt[pi] == "bool" { _bruk_atom(k, "sannhet") }
            hvis pt[pi] == "verdi" {
                _bruk_atom(k, "tekst_av")
                _bruk_atom(k, "til_minne")
                n_verdi = n_verdi + 1
            }
            pi = pi + 1
        }
        # W4: fleire tekstverdiar ligg etter kvarandre i postkassa; tekst tilbake frå verten
        # blir bygd av bytane i postkassa
        hvis n_verdi > 1 { _bruk_atom(k, "til_minne_ved") }
        hvis vf["resultat"] == "tekst" { _bruk_atom(k, "frå_minne") }
        returner 0
    }
    hvis finnes_nøkkel(k["fns"], namn) {
        la np = lengde(k["fns"][namn]["params"])
        hvis n != np { _feil(k, q, namn + " tek " + tekst(np) + " argument, fekk " + tekst(n)) }
        hvis finnes_nøkkel(k["lambda"], namn) { _feil(k, q, namn + " er ein closure-hjelpar og kan ikkje kallast direkte") }
        _pop_n(k, q, st, n, "kall til " + namn)
        _push(st, "v")
        _legg_nåbar(k, namn)
        returner 0
    }
    _feil(k, q, "ukjend funksjon " + namn)
    la i = 0
    mens i < n { _pop(st)  i = i + 1 }
    _push(st, "v")
    returner 0
}

# ─── Typeregister ────────────────────────────────────────────────────────────

# param/res: lister av verdityper (heiltal eller bytelister som [99, 3]).
funksjon _type_idx(k: ordbok, param: liste, res: liste) -> heltall {
    la pf = a.flat(param)
    la rf = a.flat(res)
    la nøkkel = "p"
    la i = 0
    mens i < lengde(pf) { nøkkel = nøkkel + "," + tekst(pf[i])  i = i + 1 }
    nøkkel = nøkkel + "r"
    i = 0
    mens i < lengde(rf) { nøkkel = nøkkel + "," + tekst(rf[i])  i = i + 1 }
    hvis finnes_nøkkel(k["type_nøkkel"], nøkkel) { returner k["type_nøkkel"][nøkkel] }
    la enc = [96]
    _la_til(enc, _leb(lengde(param)))
    _la_til(enc, pf)
    _la_til(enc, _leb(lengde(res)))
    _la_til(enc, rf)
    legg_til(k["typar"], enc)
    la idx = lengde(k["typar"]) - 1
    k["type_nøkkel"][nøkkel] = idx
    returner idx
}

funksjon _eqref_liste(n: heltall) -> liste {
    la ut = []
    la i = 0
    mens i < n { legg_til(ut, EQREF())  i = i + 1 }
    returner ut
}

# $fnN: (eqref × n, (ref null $arr) fangar) → eqref — lambda-hjelparar og call_ref.
funksjon _fn_type(k: ordbok, n: heltall) -> heltall {
    la p = _eqref_liste(n)
    legg_til(p, [99, a.T_ARR()])
    returner _type_idx(k, p, [EQREF()])
}

# WASM-signaturen til importen (JS-sida).
funksjon _import_sig(vf: ordbok) -> liste {
    la p = []
    la i = 0
    mens i < lengde(vf["param"]) {
        la t = tekst(vf["param"][i])
        hvis vert.tekst_parameter(t) { legg_til(p, I32())  legg_til(p, I32()) }
        ellers hvis vert.i32_parameter(t) { legg_til(p, I32()) }
        ellers hvis t == "desimal" { legg_til(p, 124) }
        ellers { legg_til(p, I64()) }
        i = i + 1
    }
    la r = []
    # W4: tekst tilbake — siste parameter er postkassa, resultatet er talet på bytar
    hvis vf["resultat"] == "tekst" {
        legg_til(p, I32())
        legg_til(r, I32())
    }
    hvis vf["resultat"] == "handtak" eller vf["resultat"] == "lengd" { legg_til(r, I32()) }
    hvis vf["resultat"] == "desimal" { legg_til(r, 124) }
    returner [p, r]
}

# Signaturen til innpakkaren som klientkoden kallar (eqref-verdiar).
funksjon _innpakkar_sig(vf: ordbok) -> liste {
    la p = []
    la i = 0
    mens i < lengde(vf["param"]) {
        la t = tekst(vf["param"][i])
        hvis vert.konstant_parameter(t) { legg_til(p, I32())  legg_til(p, I32()) }
        ellers { legg_til(p, EQREF()) }
        i = i + 1
    }
    returner [p, [EQREF()]]
}

# ─── Emittering (pass 2) ─────────────────────────────────────────────────────

# Tekstkonstant til ein vertsfunksjon: (i32 peikar, i32 lengd) i det aktive segmentet.
funksjon _streng_ref(k: ordbok, s: tekst) -> liste {
    hvis ikkje finnes_nøkkel(k["strengar"], s) {
        k["strengar"][s] = lengde(k["data"])
        la i = 0
        mens i < lengde(s) {
            legg_til(k["data"], builtin.char_code(builtin.slice(s, i, i + 1)))
            i = i + 1
        }
    }
    la ut = [65]
    _la_til(ut, w.leb_s(k["strengar"][s]))
    legg_til(ut, 65)
    _la_til(ut, w.leb_s(lengde(s)))
    returner ut
}

funksjon _heiltal(n: heltall) -> liste {
    la ut = []
    hvis n >= a.I31_MIN() og n <= a.I31_MAX() {
        legg_til(ut, 65)
        _la_til(ut, w.leb_s(n))
        _la_til(ut, [251, 28])
    } ellers {
        legg_til(ut, 66)
        _la_til(ut, w.leb_s(n))
        _la_til(ut, [251, 0, a.T_BOKS()])
    }
    returner ut
}

# ─── Flyttbare kroppar (W4: cache av lowra runtime-funksjonar) ────────────────
#
# Når k["reloc"] er sann, emitterer hjelparane under ein *merkelapp* (ei ordbok) i staden
# for bytar som avheng av modulen (funksjons-, atom-, global- og typeindeksar, og
# literaloffset). `_lenk_kropp` byter merkelappane ut med bytane. Ein flyttbar kropp kan
# difor lagrast (build/wasm/rt_cache/) og lenkast inn i ein annan modul. Lenkinga skjer på
# same stad i rekkjefølgja som emitteringa, så literalar og typar blir registrerte i same
# rekkjefølgje: modulen blir byte-identisk med og utan cache.

funksjon _merk(k: ordbok, r: tekst, n) -> liste {
    returner [{"r": r, "n": n}]
}

funksjon _lenk_merke(k: ordbok, m: ordbok) -> liste {
    la r = tekst(m["r"])
    hvis r == "A" { returner _leb(k["atom_idx"][tekst(m["n"])]) }
    hvis r == "F" { returner _leb(k["funk_idx"][tekst(m["n"])]) }
    hvis r == "G" { returner _leb(k["glob_idx"][tekst(m["n"])]) }
    hvis r == "D" { returner _leb(k["dyn_idx"][tekst(m["n"])]) }
    hvis r == "M" { returner _leb(k["gen_idx"][tekst(m["n"])]) }
    hvis r == "L" { returner a.flat(a.LIT(k, tekst(m["n"]))) }
    hvis r == "N" { returner _fnamn_bytar(k, tekst(m["n"])) }
    hvis r == "TL" { returner _leb(k["t_lambda"]) }
    hvis r == "TLs" { returner w.leb_s(k["t_lambda"]) }
    hvis r == "FT" { returner _leb(_fn_type(k, m["n"])) }
    hvis r == "FTs" { returner w.leb_s(_fn_type(k, m["n"])) }
    kast "wasm_lowring: ukjend merkelapp " + r
}

# Ein flyttbar kropp (flat liste med bytar og merkelappar) som bitar: bytelister og
# merkelappar om kvarandre. Cachen lagrar bitane, så lenkinga går per bit, ikkje per byte.
funksjon _til_bitar(kropp: liste) -> liste {
    la ut = []
    la bit = []
    la i = 0
    mens i < lengde(kropp) {
        la x = kropp[i]
        hvis builtin.type(x) == "ordbok" {
            hvis lengde(bit) > 0 { legg_til(ut, bit) }
            legg_til(ut, x)
            bit = []
        } ellers {
            legg_til(bit, x)
        }
        i = i + 1
    }
    hvis lengde(bit) > 0 { legg_til(ut, bit) }
    returner ut
}

# Lenk bitane: {"bitar": [bytelister], "n": talet på bytar}. Kodeseksjonen skriv bitane
# rett inn i modulen.
funksjon _lenk_bitar(k: ordbok, bitar: liste) -> ordbok {
    la ut = []
    la n = 0
    la i = 0
    mens i < lengde(bitar) {
        la x = bitar[i]
        hvis builtin.type(x) == "ordbok" { x = _lenk_merke(k, x) }
        legg_til(ut, x)
        n = n + lengde(x)
        i = i + 1
    }
    returner {"bitar": ut, "n": n}
}

funksjon _kropp_lengd(b) -> heltall {
    hvis builtin.type(b) == "ordbok" { returner b["n"] }
    returner lengde(b)
}

funksjon _kropp_inn(m: liste, b) -> heltall {
    hvis builtin.type(b) == "ordbok" {
        la bitar = b["bitar"]
        la i = 0
        mens i < lengde(bitar) {
            _la_til(m, bitar[i])
            i = i + 1
        }
    } ellers {
        _la_til(m, b)
    }
    returner 0
}

funksjon _kall(k: ordbok, atom: tekst) -> liste {
    hvis k["reloc"] { returner [16, {"r": "A", "n": atom}] }
    la ut = [16]
    _la_til(ut, _leb(k["atom_idx"][atom]))
    returner ut
}

# Tekstliteral som $tekst (array.new_data), flyttbar.
funksjon _LIT(k: ordbok, s: tekst) -> liste {
    hvis k["reloc"] { returner _merk(k, "L", s) }
    returner a.flat(a.LIT(k, s))
}

# Funksjonsindeks for call/ref.func, flyttbar.
funksjon _fidx(k: ordbok, q: tekst) -> liste {
    hvis k["reloc"] { returner _merk(k, "F", q) }
    returner _leb(k["funk_idx"][q])
}

# (i32.const off, i32.const len) for namnet på funksjonen (feilmeldingar som i VM-en).
funksjon _fnamn(k: ordbok, q: tekst) -> liste {
    hvis k["reloc"] { returner _merk(k, "N", q) }
    returner _fnamn_bytar(k, q)
}

funksjon _fnamn_bytar(k: ordbok, q: tekst) -> liste {
    la r = a.lit_ref(k, q)
    la ut = [65]
    _la_til(ut, w.leb_s(r[0]))
    legg_til(ut, 65)
    _la_til(ut, w.leb_s(r[1]))
    returner ut
}

funksjon _lg(i: heltall) -> liste {
    la ut = [32]
    _la_til(ut, _leb(i))
    returner ut
}

funksjon _ls(i: heltall) -> liste {
    la ut = [33]
    _la_til(ut, _leb(i))
    returner ut
}

funksjon _i32(n: heltall) -> liste {
    la ut = [65]
    _la_til(ut, w.leb_s(n))
    returner ut
}

# ref.cast (ref $t) — heaptypen er s33 (signert LEB128).
funksjon _rcast(t: heltall) -> liste {
    la ut = [251, 22]
    _la_til(ut, w.leb_s(t))
    returner ut
}

# Kall closuren i lokalen `tmp` med n argument som alt ligg på stakken.
funksjon _kall_closure(k: ordbok, tmp: heltall, n: heltall) -> liste {
    hvis k["reloc"] {
        la tls = {"r": "TLs", "n": 0}
        la tlu = {"r": "TL", "n": 0}
        la ut_r = []
        _la_til(ut_r, _lg(tmp))
        _la_til(ut_r, [251, 22, tls, 251, 2, tlu, 1])
        _la_til(ut_r, _lg(tmp))
        _la_til(ut_r, [251, 22, tls, 251, 2, tlu, 0, 251, 22, {"r": "FTs", "n": n}, 20, {"r": "FT", "n": n}])
        returner ut_r
    }
    la tl = k["t_lambda"]
    la ft = _fn_type(k, n)
    la ut = []
    _la_til(ut, _lg(tmp))
    _la_til(ut, _rcast(tl))
    _la_til(ut, [251, 2])
    _la_til(ut, _leb(tl))
    legg_til(ut, 1)
    _la_til(ut, _lg(tmp))
    _la_til(ut, _rcast(tl))
    _la_til(ut, [251, 2])
    _la_til(ut, _leb(tl))
    legg_til(ut, 0)
    _la_til(ut, _rcast(ft))
    legg_til(ut, 20)
    _la_til(ut, _leb(ft))
    returner ut
}

funksjon _instruksjon(k: ordbok, an: ordbok, ii: heltall, ins: liste, lok_tmp: heltall) -> liste {
    la op = tekst(ins[0])
    la b = []
    hvis op == "LABEL" eller op == "TRY_BEGIN" eller op == "TRY_END" eller op == "FINALLY_PUSH" {
    } ellers hvis op == "PUSH_CONST" {
        la v = ins[1]
        la tn = _type_namn(v)
        hvis tn == "heltall" { _la_til(b, _heiltal(v)) }
        ellers hvis tn == "bool" {
            hvis v { _la_til(b, [35, 1]) } ellers { _la_til(b, [35, 0]) }
        }
        ellers hvis tn == "null" { _la_til(b, [208, EQREF()]) }
        ellers hvis tn == "desimaltall" {
            _la_til(b, a.flat([a.f64c(builtin.desimal_til_bits(v)), a.sny(a.T_FLYT())]))
        }
        ellers hvis tn == "tekst" {
            la nøkkel = tekst(ii)
            hvis finnes_nøkkel(an["rolle"], nøkkel) {
                la r = an["rolle"][nøkkel]
                hvis r["art"] != "null" { k["reloc_ok"] = usann }
                # R2: metode-/typenamnet til kall_metode/er_instans er løyst i analysen
                hvis r["art"] == "null" { _la_til(b, [208, EQREF()]) }
                ellers hvis r["art"] == "funksjon" { _la_til(b, _streng_ref(k, k["tilbakekall"][r["mål"]])) }
                ellers { _la_til(b, _streng_ref(k, tekst(v))) }
            } ellers {
                _la_til(b, _LIT(k, tekst(v)))
            }
        }
    } ellers hvis op == "LOAD_NAME" {
        _la_til(b, _lg(an["lok"][tekst(ins[1])]))
    } ellers hvis op == "STORE_NAME" {
        _la_til(b, _ls(an["lok"][tekst(ins[1])]))
    } ellers hvis op == "LOAD_GLOBAL" eller op == "STORE_GLOBAL" {
        hvis op == "LOAD_GLOBAL" { legg_til(b, 35) } ellers { legg_til(b, 36) }
        la gn = _global_modul(ins, an["modul"]) + "." + tekst(ins[1])
        hvis k["reloc"] { legg_til(b, {"r": "G", "n": gn}) } ellers { _la_til(b, _leb(k["glob_idx"][gn])) }
    } ellers hvis finnes_nøkkel(k["binop"], op) {
        _la_til(b, _kall(k, k["binop"][op]))
    } ellers hvis op == "BINARY_DIV" eller op == "BINARY_MOD" {
        la atom = "div"
        hvis op == "BINARY_MOD" { atom = "mod" }
        hvis finnes_nøkkel(an["konst_div"], tekst(ii)) {
            _la_til(b, _kall(k, atom + "_k"))
        } ellers {
            _la_til(b, _fnamn(k, an["q"]))
            _la_til(b, _kall(k, atom))
        }
    } ellers hvis op == "COMPARE_EQ" {
        _la_til(b, _kall(k, "lik"))
        _la_til(b, _kall(k, "bool"))
    } ellers hvis op == "COMPARE_NE" {
        _la_til(b, _kall(k, "lik"))
        legg_til(b, 69)
        _la_til(b, _kall(k, "bool"))
    } ellers hvis finnes_nøkkel(k["cmpop"], op) {
        _la_til(b, _kall(k, "cmp"))
        _la_til(b, k["cmpop"][op])
        _la_til(b, _kall(k, "bool"))
    } ellers hvis op == "UNARY_NEG" {
        _la_til(b, _kall(k, "neg"))
    } ellers hvis op == "UNARY_NOT" {
        _la_til(b, _kall(k, "sannhet"))
        legg_til(b, 69)
        _la_til(b, _kall(k, "bool"))
    } ellers hvis op == "BUILD_LIST" {
        _la_til(b, [251, 8, a.T_ARR()])
        _la_til(b, _leb(ins[1]))
        _la_til(b, _kall(k, "liste_frå_arr"))
    } ellers hvis op == "BUILD_MAP" {
        _la_til(b, [251, 8, a.T_ARR()])
        _la_til(b, _leb(2 * ins[1]))
        _la_til(b, _kall(k, "ordbok_frå_par"))
    } ellers hvis op == "INDEX_GET" {
        _la_til(b, _fnamn(k, an["q"]))
        _la_til(b, _kall(k, "indeks_hent"))
    } ellers hvis op == "INDEX_SET" {
        _la_til(b, _fnamn(k, an["q"]))
        _la_til(b, _kall(k, "indeks_set"))
    } ellers hvis op == "POP" {
        legg_til(b, 26)
    } ellers hvis op == "DUP" {
        legg_til(b, 34)
        _la_til(b, _leb(lok_tmp))
        _la_til(b, _lg(lok_tmp))
    } ellers hvis op == "RETURN" {
        # berre i den direkte vegen (éi blokk, ingen endeleg); elles er RETURN ein terminator
        legg_til(b, 15)
    } ellers hvis op == "LOAD_EXCEPTION" {
        _la_til(b, _lg(an["l_exc"]))
    } ellers hvis op == "LOAD_PENDING" {
        _la_til(b, _lg(an["l_pval"]))
    } ellers hvis op == "CLEAR_PENDING" {
        # pending = normal, pending_value = 0 (som VM-en)
        _la_til(b, [65, 0])
        _la_til(b, _ls(an["l_pend"]))
        _la_til(b, [65, 0, 251, 28])
        _la_til(b, _ls(an["l_pval"]))
    } ellers hvis op == "BUILD_LAMBDA" {
        # struct.new $lambda (ref.func hjelpar, array.new_fixed $arr fangarane)
        la mål = tekst(ins[1])
        legg_til(b, 210)
        _la_til(b, _fidx(k, mål))
        la caps = ins[2]
        la ci = 0
        mens ci < lengde(caps) {
            _la_til(b, _lg(an["lok"][tekst(caps[ci])]))
            ci = ci + 1
        }
        _la_til(b, [251, 8, a.T_ARR()])
        _la_til(b, _leb(lengde(caps)))
        _la_til(b, [251, 0])
        hvis k["reloc"] { legg_til(b, {"r": "TL", "n": 0}) } ellers { _la_til(b, _leb(k["t_lambda"])) }
    } ellers hvis op == "CALL_VALUE" {
        _la_til(b, _ls(lok_tmp))
        _la_til(b, _kall_closure(k, lok_tmp, ins[1]))
    } ellers hvis op == "CALL" {
        la namn = tekst(ins[1])
        hvis builtin.starts_with(namn, "builtin.") {
            la kort = builtin.slice(namn, 8, lengde(namn))
            hvis kort == "kall_metode" eller kort == "er_instans" {
                la gk = an["gen_kall"][tekst(ii)]
                legg_til(b, 16)
                hvis k["reloc"] { legg_til(b, {"r": "M", "n": gk}) } ellers { _la_til(b, _leb(k["gen_idx"][gk])) }
            } ellers hvis kort == "ncb_call_fn" {
                legg_til(b, 16)
                hvis k["reloc"] { legg_til(b, {"r": "D", "n": tekst(ins[2] - 1)}) }
                ellers { _la_til(b, _leb(k["dyn_idx"][tekst(ins[2] - 1)])) }
            } ellers hvis finnes_nøkkel(k["rt"], kort) {
                legg_til(b, 16)
                _la_til(b, _fidx(k, rt_modul() + "." + tekst(k["rt"][kort])))
            } ellers {
                _la_til(b, _kall(k, k["builtins"][kort][1]))
            }
        } ellers {
            legg_til(b, 16)
            hvis finnes_nøkkel(k["innpakkar_idx"], namn) {
                k["reloc_ok"] = usann
                _la_til(b, _leb(k["innpakkar_idx"][namn]))
            } ellers { _la_til(b, _fidx(k, namn)) }
        }
    } ellers {
        kast "wasm_lowring: intern feil, uanalysert opcode " + op
    }
    returner b
}

funksjon _lokal_grupper(n_eq: heltall, n_i32: heltall) -> liste {
    la g = []
    la ng = 0
    hvis n_eq > 0 { ng = ng + 1 }
    hvis n_i32 > 0 { ng = ng + 1 }
    _la_til(g, _leb(ng))
    hvis n_eq > 0 { _la_til(g, _leb(n_eq))  legg_til(g, EQREF()) }
    hvis n_i32 > 0 { _la_til(g, _leb(n_i32))  legg_til(g, I32()) }
    returner g
}

# Lagre `he` stakkverdiar i slotane, set pc = mål-id og grein til lykkja.
funksjon _til_blokk(kropp: liste, slot0: heltall, he: heltall, id: heltall, pc: heltall, djup: heltall) -> heltall {
    la s2 = he - 1
    mens s2 >= 0 {
        _la_til(kropp, _ls(slot0 + s2))
        s2 = s2 - 1
    }
    _la_til(kropp, _i32(id))
    _la_til(kropp, _ls(pc))
    legg_til(kropp, 12)
    _la_til(kropp, _leb(djup))
    returner 0
}

# Handteraren etter try_table: exc-lokalen har unnataket. Vel mål etter tilstanden i blokka
# som køyrde (pc), som VM-en sin THROW: øvste passande handterar over opprydjingsgrensa,
# elles endeleg-blokka (pending=throw), elles kast vidare.
funksjon _fang_handterar(k: ordbok, an: ordbok, nåbare: liste, id: ordbok, pc: heltall) -> liste {
    la kropp = []
    la grupper = []
    la gruppe_av = {}
    la g_for = []
    la d = 0
    mens d < lengde(nåbare) {
        la bix = nåbare[d]
        hvis lengde(an["tT"][bix]) == 0 og lengde(an["tC"][bix]) == 0 {
            legg_til(g_for, -1)
        } ellers {
            la nk = an["tkey"][bix]
            hvis ikkje finnes_nøkkel(gruppe_av, nk) {
                gruppe_av[nk] = lengde(grupper)
                legg_til(grupper, bix)
            }
            legg_til(g_for, gruppe_av[nk])
        }
        d = d + 1
    }
    la ng = lengde(grupper)
    la G = ng + 1
    la i = 0
    mens i < G { _la_til(kropp, [2, 64])  i = i + 1 }
    _la_til(kropp, _lg(pc))
    legg_til(kropp, 14)
    _la_til(kropp, _leb(lengde(g_for)))
    i = 0
    mens i < lengde(g_for) {
        la g = g_for[i]
        hvis g < 0 { g = ng }
        _la_til(kropp, _leb(g))
        i = i + 1
    }
    _la_til(kropp, _leb(ng))
    legg_til(kropp, 11)
    la exc = an["l_exc"]
    la g2 = 0
    mens g2 < ng {
        la bix = grupper[g2]
        la T = an["tT"][bix]
        la C = an["tC"][bix]
        la D = G - 1 - g2
        la td = 0
        hvis lengde(C) > 0 { td = an["cln"][tekst(C[lengde(C) - 1])]["td"] }
        la stoppa = usann
        la ti = lengde(T) - 1
        mens ti >= td og ikkje stoppa {
            la h = an["try"][tekst(T[ti])]
            la mål = id[tekst(an["labels"][h["lbl"]])]
            hvis _jokertype(h["type"]) {
                _la_til(kropp, _i32(mål))
                _la_til(kropp, _ls(pc))
                legg_til(kropp, 12)
                _la_til(kropp, _leb(D))
                stoppa = sann
            } ellers {
                _la_til(kropp, _lg(exc))
                _la_til(kropp, _LIT(k, h["type"]))
                _la_til(kropp, _kall(k, "unntak_passar"))
                _la_til(kropp, [4, 64])
                _la_til(kropp, _i32(mål))
                _la_til(kropp, _ls(pc))
                legg_til(kropp, 12)
                _la_til(kropp, _leb(D + 1))
                legg_til(kropp, 11)
            }
            ti = ti - 1
        }
        hvis ikkje stoppa {
            hvis lengde(C) > 0 {
                la c = an["cln"][tekst(C[lengde(C) - 1])]
                _la_til(kropp, _lg(exc))
                _la_til(kropp, _ls(an["l_pval"]))
                _la_til(kropp, [65, 2])
                _la_til(kropp, _ls(an["l_pend"]))
                _la_til(kropp, _i32(id[tekst(an["labels"][c["lbl"]])]))
                _la_til(kropp, _ls(pc))
                legg_til(kropp, 12)
                _la_til(kropp, _leb(D))
            } ellers {
                _la_til(kropp, _lg(exc))
                _la_til(kropp, [8, 0])
            }
        }
        legg_til(kropp, 11)
        g2 = g2 + 1
    }
    # Blokker utan handterar: kast vidare
    _la_til(kropp, _lg(exc))
    _la_til(kropp, [8, 0])
    returner kropp
}

funksjon _brukarfunksjon(k: ordbok, q: tekst) -> liste {
    la an = k["analyse"][q]
    la kode = k["fns"][q]["code"]
    la np_w = an["np_w"]
    la slot0 = np_w + an["n_lok"]
    la n_slot = an["maks_slot"]
    la lok_tmp = slot0 + n_slot
    la n_eq = an["n_lok"] + n_slot
    hvis an["dup"] { n_eq = n_eq + 1 }
    la eh = an["eh"]
    hvis eh {
        an["l_exc"] = np_w + n_eq
        an["l_pval"] = np_w + n_eq + 1
        n_eq = n_eq + 2
    }
    la pc = np_w + n_eq
    la c = pc + 1
    la n_i32 = 2
    hvis eh {
        an["l_pend"] = pc + 2
        n_i32 = 3
    }
    la ekstra = 0
    hvis eh { ekstra = 2 }
    # Prolog for closure-hjelparar: fangarane frå $arr-parameteren til lokalane
    la prolog = []
    la fi = 0
    mens fi < lengde(an["fangar"]) {
        _la_til(prolog, _lg(an["np"]))
        _la_til(prolog, _i32(fi))
        _la_til(prolog, [251, 11, a.T_ARR()])
        _la_til(prolog, _ls(an["lok"][an["fangar"][fi]]))
        fi = fi + 1
    }
    # Nåbare blokker i kjelderekkjefølgje → dispatch-id
    la nåbare = []
    la id = {}
    la bi = 0
    mens bi < lengde(an["blokker"]) {
        hvis an["hoyde"][bi] >= 0 {
            id[tekst(bi)] = lengde(nåbare)
            legg_til(nåbare, bi)
        }
        bi = bi + 1
    }
    la nb = lengde(nåbare)
    la b0 = an["blokker"][nåbare[0]]
    la siste = tekst(kode[b0["slutt"] - 1][0])
    la direkte = nb == 1 og siste == "RETURN" og ikkje eh
    la kropp = []
    hvis direkte {
        _la_til(kropp, _lokal_grupper(n_eq, 0))
        _la_til(kropp, prolog)
        la ii = b0["start"]
        mens ii < b0["slutt"] {
            _la_til(kropp, _instruksjon(k, an, ii, kode[ii], lok_tmp))
            ii = ii + 1
        }
        _la_til(kropp, [0, 11])
        returner kropp
    }
    _la_til(kropp, _lokal_grupper(n_eq, n_i32))
    _la_til(kropp, prolog)
    # loop { [block (eqref) { try_table (catch 0 → 0) {] block×nb { local.get pc; br_table } kode_0 … }
    _la_til(kropp, [3, 64])
    hvis eh { _la_til(kropp, [2, EQREF(), 31, 64, 1, 0, 0, 0]) }
    la i = 0
    mens i < nb { _la_til(kropp, [2, 64])  i = i + 1 }
    _la_til(kropp, _lg(pc))
    legg_til(kropp, 14)
    _la_til(kropp, _leb(nb))
    i = 0
    mens i < nb { _la_til(kropp, _leb(i))  i = i + 1 }
    _la_til(kropp, _leb(nb - 1))
    legg_til(kropp, 11)
    la d = 0
    mens d < nb {
        la bix = nåbare[d]
        la blk = an["blokker"][bix]
        la djup = nb - 1 - d + ekstra
        la h = an["hoyde"][bix]
        # Last stakkslotane inn på WASM-stakken
        la s = 0
        mens s < h {
            _la_til(kropp, _lg(slot0 + s))
            s = s + 1
        }
        la termin = ""
        la termin_ii = -1
        la ii = blk["start"]
        mens ii < blk["slutt"] {
            la ins = kode[ii]
            la op = tekst(ins[0])
            hvis op == "JUMP" eller op == "JUMP_IF_FALSE" eller op == "RETURN" eller op == "THROW" eller
                 op == "FINALLY_RUN" eller op == "FINALLY_END" {
                termin = op
                termin_ii = ii
            } ellers {
                _la_til(kropp, _instruksjon(k, an, ii, ins, lok_tmp))
            }
            ii = ii + 1
        }
        la tk = tekst(termin_ii)
        hvis termin == "THROW" {
            _la_til(kropp, [8, 0])
        } ellers hvis termin == "RETURN" og ikkje finnes_nøkkel(an["ret_mål"], tk) {
            legg_til(kropp, 15)
        } ellers hvis termin == "RETURN" {
            # returner inne i endeleg/utsett: pending = return, så endeleg-blokka
            la mb = an["ret_mål"][tk]
            _la_til(kropp, _ls(an["l_pval"]))
            _la_til(kropp, [65, 1])
            _la_til(kropp, _ls(an["l_pend"]))
            la dr = 0
            mens dr < an["ret_drop"][tk] { legg_til(kropp, 26)  dr = dr + 1 }
            _til_blokk(kropp, slot0, an["hoyde"][mb], id[tekst(mb)], pc, djup)
        } ellers hvis termin == "FINALLY_RUN" {
            la mb = an["fr_mål"][tk]
            _la_til(kropp, [65, 0])
            _la_til(kropp, _ls(an["l_pend"]))
            _til_blokk(kropp, slot0, an["hoyde"][mb], id[tekst(mb)], pc, djup)
        } ellers hvis termin == "FINALLY_END" {
            # Etter pending: 0 normal → etter, 1 return → return-etikett, 2 throw → throw-etikett.
            # Berre moglege mål (P frå analysen) har blokker; umoglege får det første moglege.
            la ins = kode[termin_ii]
            la P = an["fe_p"][tk]
            la mål = [-1, -1, -1]
            hvis (P & 1) != 0 { mål[0] = an["labels"][tekst(ins[1])] }
            hvis (P & 2) != 0 { mål[1] = an["labels"][tekst(ins[2])] }
            hvis (P & 4) != 0 { mål[2] = an["labels"][tekst(ins[3])] }
            la første = -1
            la mi = 0
            mens mi < 3 {
                hvis første < 0 og mål[mi] >= 0 { første = mål[mi] }
                mi = mi + 1
            }
            mi = 0
            mens mi < 3 {
                hvis mål[mi] < 0 { mål[mi] = første }
                mi = mi + 1
            }
            la he = an["hoyde"][første]
            la s2 = he - 1
            mens s2 >= 0 {
                _la_til(kropp, _ls(slot0 + s2))
                s2 = s2 - 1
            }
            hvis mål[0] == mål[1] og mål[1] == mål[2] {
                _la_til(kropp, _i32(id[tekst(første)]))
            } ellers {
                _la_til(kropp, _i32(id[tekst(mål[2])]))
                _la_til(kropp, _i32(id[tekst(mål[1])]))
                _la_til(kropp, _i32(id[tekst(mål[0])]))
                _la_til(kropp, _lg(an["l_pend"]))
                _la_til(kropp, [65, 1, 70, 27])
                _la_til(kropp, _lg(an["l_pend"]))
                _la_til(kropp, [65, 2, 70, 27])
            }
            _la_til(kropp, _ls(pc))
            legg_til(kropp, 12)
            _la_til(kropp, _leb(djup))
        } ellers {
            la mål = -1
            hvis termin == "JUMP" eller termin == "JUMP_IF_FALSE" { mål = an["labels"][tekst(kode[termin_ii][1])] }
            hvis termin == "JUMP_IF_FALSE" {
                _la_til(kropp, _kall(k, "sannhet"))
                _la_til(kropp, _ls(c))
            }
            # Høgda ved utgangen = høgda til etterfølgjaren
            la etter = bix + 1
            hvis termin == "JUMP" { etter = mål }
            la he = an["hoyde"][etter]
            la s2 = he - 1
            mens s2 >= 0 {
                _la_til(kropp, _ls(slot0 + s2))
                s2 = s2 - 1
            }
            hvis termin == "JUMP_IF_FALSE" {
                # sann → fall gjennom (bix+1), usann → mål
                _la_til(kropp, _i32(id[tekst(bix + 1)]))
                _la_til(kropp, _i32(id[tekst(mål)]))
                _la_til(kropp, _lg(c))
                legg_til(kropp, 27)
            } ellers {
                _la_til(kropp, _i32(id[tekst(etter)]))
            }
            _la_til(kropp, _ls(pc))
            legg_til(kropp, 12)
            _la_til(kropp, _leb(djup))
        }
        hvis d < nb - 1 { legg_til(kropp, 11) }
        d = d + 1
    }
    hvis eh {
        # slutt på try_table, unreachable, slutt på fangblokka (eqref på stakken), handterar
        _la_til(kropp, [11, 0, 11])
        _la_til(kropp, _ls(an["l_exc"]))
        _la_til(kropp, _fang_handterar(k, an, nåbare, id, pc))
    }
    # slutt på loop, unreachable, slutt på funksjonen
    _la_til(kropp, [11, 0, 11])
    returner kropp
}

# Innpakkaren klientkoden kallar: gjer Norscode-verdiane om til importtypane, kallar
# importen og gjer resultatet om til ein Norscode-verdi.
#   - Éin tekstverdi: tekst(x) blir skriven i postkassa (som i W3).
#   - W4: fleire tekstverdiar: alle tekst(x) blir rekna ut først (tekst(desimaltal) brukar
#     postkassa sjølv), så skrivne etter kvarandre frå postkassa (til_minne_ved).
#   - W4: resultatet «tekst»: importen får adressa til postkassa som siste argument og gjev
#     talet på bytar; frå_minne byggjer teksten.
# Kjeldene som bestemmer korleis ein funksjon blir lowra. Endrar ei av dei seg, får
# cachen ein ny nøkkel (og den gamle fila blir ikkje lesen).
funksjon backend_kjelder() -> liste {
    returner ["std/wasm_lowring.no", "std/wasm_atom.no", "std/wasm_binary.no", "std/wasm_vert.no"]
}

# Cachefila: <mappe>/<16 hex av sha256 over backend-kjeldene>.json (mappe relativ til rot
# eller absolutt).
funksjon rt_cache_sti(rot: tekst, mappe: tekst) -> tekst {
    la kjelder = backend_kjelder()
    la alt = ""
    la i = 0
    mens i < lengde(kjelder) {
        alt = alt + kjelder[i] + "\n" + fil_les(rot + "/" + kjelder[i]) + "\n"
        i = i + 1
    }
    la m = mappe
    hvis ikkje builtin.starts_with(m, "/") { m = rot + "/" + m }
    returner m + "/" + builtin.slice(builtin.sha256(alt), 0, 16) + ".json"
}

# Kroppar som kan lagrast i rt-cachen: funksjonar i std.*-modular (runtime-biblioteket og
# det det importerer), ikkje closure-hjelparar (fangarane kjem frå kallstaden).
funksjon _kan_cachast(k: ordbok, q: tekst) -> bool {
    hvis ikkje builtin.starts_with(q, "std.") { returner usann }
    hvis builtin.starts_with(q, k["vert_modul"] + ".") { returner usann }
    returner ikkje finnes_nøkkel(k["lambda"], q)
}

# Cachefila blir funnen og lesen første gongen ein funksjon kan cachast: program utan
# rt-funksjonar slepp å rekne nøkkelen (sha256 over ~175 KB kjelde, om lag 110 ms).
funksjon _last_rt_cache(k: ordbok) -> heltall {
    hvis k["rt_cache_fil"] == "" og k["rt_cache_mappe"] != "" {
        k["rt_cache_fil"] = rt_cache_sti(k["rt_cache_rot"], k["rt_cache_mappe"])
        hvis builtin.fil_finnes(k["rt_cache_fil"]) { k["rt_cache"] = builtin.json_parse_raw(fil_les(k["rt_cache_fil"])) }
    }
    returner 0
}

# NCB-koden til q som tekst (identiteten til ei cacheoppføring), rekna éin gong.
funksjon _kode_s(k: ordbok, q: tekst) -> tekst {
    hvis ikkje finnes_nøkkel(k["kode_s"], q) { k["kode_s"][q] = builtin.json_stringify(k["fns"][q]) }
    returner k["kode_s"][q]
}

# Analysen av q, frå cachen når oppføringa har verknadene til analysen («effekt»): kalla
# funksjonar (i rekkjefølgja analysen la dei til), atom og flagg. Då blir dei spela av i
# same rekkjefølgje, så funksjonsindeksane blir dei same. Elles blir q analysert, og for
# funksjonar som kan cachast blir verknadene tekne opp (ikkje når analysen rørte closures,
# ncb_call_fn, vertsfunksjonar eller gav feil).
funksjon _analyser_cache(k: ordbok, q: tekst) -> heltall {
    hvis ikkje k["rt_cache_på"] eller ikkje _kan_cachast(k, q) { returner _analyser(k, q) }
    _last_rt_cache(k)
    la kode_s = _kode_s(k, q)
    hvis finnes_nøkkel(k["rt_cache"], q) og tekst(k["rt_cache"][q]["kode"]) == kode_s og finnes_nøkkel(k["rt_cache"][q], "effekt") {
        la e = k["rt_cache"][q]["effekt"]
        k["analyse"][q] = {"q": q, "np": e["np"], "lambda": usann, "frå_cache": sann}
        la i = 0
        mens i < lengde(e["nåbare"]) { _legg_nåbar(k, tekst(e["nåbare"][i]))  i = i + 1 }
        i = 0
        mens i < lengde(e["atom"]) { _bruk_atom(k, tekst(e["atom"][i]))  i = i + 1 }
        i = 0
        mens i < lengde(e["flagg"]) { k[tekst(e["flagg"][i])] = sann  i = i + 1 }
        k["rt_analyse_treff"] = k["rt_analyse_treff"] + 1
        returner 0
    }
    la opptak = {"nåbare": [], "atom": [], "flagg": []}
    la n_dyn = lengde(k["dyn_liste"])
    la n_lambda = lengde(nøkler(k["lambda"]))
    la n_feil = lengde(k["feil"])
    la n_vert = lengde(nøkler(k["vert_brukt"]))
    la bl = k["bruker_lambda"]
    k["opptak"] = opptak
    _analyser(k, q)
    k["opptak"] = null
    hvis ikkje finnes_nøkkel(opptak, "urein") og lengde(k["dyn_liste"]) == n_dyn og lengde(nøkler(k["lambda"])) == n_lambda og
         lengde(k["feil"]) == n_feil og lengde(nøkler(k["vert_brukt"])) == n_vert og k["bruker_lambda"] == bl {
        opptak["np"] = k["analyse"][q]["np"]
        k["rt_effekt"][q] = opptak
    }
    returner 0
}

# Set eit flagg i konteksten (flyt, har_throw, har_eh) og ta det opp for analysecachen.
funksjon _flagg(k: ordbok, namn: tekst) -> heltall {
    k[namn] = sann
    hvis k["opptak"] != null { legg_til(k["opptak"]["flagg"], namn) }
    returner 0
}

# Kroppen til q: frå cachen når NCB-koden er den same, elles emittert (flyttbart for
# funksjonar som kan cachast, og lagt i k["rt_ny"]) og lenka.
funksjon _brukarfunksjon_cache(k: ordbok, q: tekst) -> liste {
    hvis ikkje k["rt_cache_på"] eller ikkje _kan_cachast(k, q) { returner _brukarfunksjon(k, q) }
    la kode_s = _kode_s(k, q)
    hvis finnes_nøkkel(k["rt_cache"], q) og tekst(k["rt_cache"][q]["kode"]) == kode_s {
        k["rt_treff"] = k["rt_treff"] + 1
        returner _lenk_bitar(k, k["rt_cache"][q]["kropp"])
    }
    k["rt_bomm"] = k["rt_bomm"] + 1
    k["reloc"] = sann
    k["reloc_ok"] = sann
    la r = _til_bitar(_brukarfunksjon(k, q))
    k["reloc"] = usann
    hvis k["reloc_ok"] {
        la oppf = {"kode": kode_s, "kropp": r}
        hvis finnes_nøkkel(k["rt_effekt"], q) { oppf["effekt"] = k["rt_effekt"][q] }
        k["rt_ny"][q] = oppf
    }
    returner _lenk_bitar(k, r)
}

funksjon _innpakkar(k: ordbok, vf: ordbok, import_idx: heltall) -> liste {
    la pt = vf["param"]
    la n_verdi = 0
    la np_w = 0
    la i = 0
    mens i < lengde(pt) {
        hvis pt[i] == "verdi" { n_verdi = n_verdi + 1 }
        hvis vert.konstant_parameter(tekst(pt[i])) { np_w = np_w + 2 } ellers { np_w = np_w + 1 }
        i = i + 1
    }
    la fleire = n_verdi > 1
    # lokale ved fleire tekstverdiar: n_verdi × (ref null $tekst), så o og n (i32)
    la tl0 = np_w
    la lo = np_w + n_verdi
    la ln = lo + 1
    la b = [0]
    hvis fleire {
        b = [2]
        _la_til(b, _leb(n_verdi))
        _la_til(b, [99, a.T_TEKST()])
        _la_til(b, [2, I32()])
        # pass 1: tekst(x) for kvar tekstverdi
        la ai0 = 0
        la vj = 0
        i = 0
        mens i < lengde(pt) {
            hvis pt[i] == "verdi" {
                _la_til(b, _lg(ai0))
                _la_til(b, _kall(k, "tekst_av"))
                _la_til(b, _ls(tl0 + vj))
                vj = vj + 1
            }
            hvis vert.konstant_parameter(tekst(pt[i])) { ai0 = ai0 + 2 } ellers { ai0 = ai0 + 1 }
            i = i + 1
        }
        _la_til(b, _i32(k["postkasse"]))
        _la_til(b, _ls(lo))
    }
    hvis vf["resultat"] == "tekst" { _la_til(b, _i32(k["postkasse"])) }
    la ai = 0
    la vi = 0
    i = 0
    mens i < lengde(pt) {
        la t = tekst(pt[i])
        hvis vert.konstant_parameter(t) {
            _la_til(b, [32])
            _la_til(b, _leb(ai))
            _la_til(b, [32])
            _la_til(b, _leb(ai + 1))
            ai = ai + 2
        } ellers hvis t == "handtak" eller t == "tal" {
            legg_til(b, 32)
            _la_til(b, _leb(ai))
            _la_til(b, _kall(k, "til_i64"))
            legg_til(b, 167)
            ai = ai + 1
        } ellers hvis t == "bool" {
            _la_til(b, _lg(ai))
            _la_til(b, _kall(k, "sannhet"))
            ai = ai + 1
        } ellers hvis t == "verdi" og fleire {
            # peikar o; lengd = til_minne_ved(t_j, o); o += lengd
            _la_til(b, _lg(lo))
            _la_til(b, _lg(tl0 + vi))
            _la_til(b, _lg(lo))
            _la_til(b, _kall(k, "til_minne_ved"))
            _la_til(b, [34])
            _la_til(b, _leb(ln))
            _la_til(b, _lg(lo))
            _la_til(b, _lg(ln))
            _la_til(b, [106])
            _la_til(b, _ls(lo))
            vi = vi + 1
            ai = ai + 1
        } ellers hvis t == "verdi" {
            _la_til(b, a.flat([a.i32c(k["postkasse"]), a.lg(ai), a.K(k, "tekst_av"), a.K(k, "til_minne")]))
            ai = ai + 1
        } ellers {
            legg_til(b, 32)
            _la_til(b, _leb(ai))
            _la_til(b, _kall(k, "til_i64"))
            ai = ai + 1
        }
        i = i + 1
    }
    hvis vf["resultat"] == "tekst" { _la_til(b, _i32(k["postkasse"])) }
    legg_til(b, 16)
    _la_til(b, _leb(import_idx))
    hvis vf["resultat"] == "handtak" { _la_til(b, [251, 28]) }
    ellers hvis vf["resultat"] == "tekst" { _la_til(b, _kall(k, "frå_minne")) }
    ellers { _la_til(b, [208, EQREF()]) }
    legg_til(b, 11)
    returner b
}

# Namna på hendingane (til feilmeldingar).
funksjon _hending_namn() -> tekst {
    la h = vert.hendingar()
    la ut = []
    la i = 0
    mens i < lengde(h) {
        legg_til(ut, h[i][0])
        i = i + 1
    }
    returner builtin.join(ut, ", ")
}

# R2: kroppen til ein generert funksjon (kall_metode-dispatcher eller er_instans-test).
funksjon _gen_kropp(k: ordbok, nøkkel: tekst) -> liste {
    la g = k["gen"][nøkkel]
    hvis g["art"] == "instans" { returner _instans_kropp(k, g) }
    returner _metode_kropp(k, g)
}

# (v, _) → bool: vm_er_instans for mål (sjå _gen_instans). Parameter 1 er plassen til
# typenamnet (ref.null; namnet er løyst i analysen). lokale: 2 d (ordbok), 3 i (i32), 4 t (tekst).
funksjon _instans_kropp(k: ordbok, g: ordbok) -> liste {
    la td = a.T_ORDBOK()
    la tt = a.T_TEKST()
    la ta = a.T_ARR()
    la b = [3, 1, 99, td, 1, I32(), 1, 99, tt]
    _la_til(b, a.flat([a.lg(0), a.rtest(td), 69, a.iff([]), 35, 0, 15, a.END(),
                       a.lg(0), a.rcast(td), a.ls(2),
                       a.lg(2), a.LIT(k, "__struktur__"), a.K(k, "merke_finn"), 34, 3, a.i32c(0), 72, a.iff([]), 35, 0, 15, a.END(),
                       a.lg(2), a.sget(td, 2), a.lg(3), a.aget(ta), a.K(k, "tekst_av"), a.ls(4)]))
    la tagg = g["tagg"]
    la i = 0
    mens i < lengde(tagg) {
        _la_til(b, a.flat([a.lg(4), a.LIT(k, tekst(tagg[i])), a.K(k, "tekst_lik"), a.iff([]), 35, 1, 15, a.END()]))
        i = i + 1
    }
    hvis g["kort"] {
        # Ukvalifisert namn: samanlikna med det korte typenamnet (__type__)
        _la_til(b, a.flat([a.lg(2), a.LIT(k, "__type__"), a.K(k, "merke_finn"), 34, 3, a.i32c(0), 78, a.iff([]),
                             a.lg(2), a.sget(td, 2), a.lg(3), a.aget(ta), a.K(k, "tekst_av"), a.LIT(k, tekst(g["mål"])),
                             a.K(k, "tekst_lik"), a.iff([]), 35, 1, 15, a.END(),
                           a.END()]))
    }
    _la_til(b, [35, 0, 11])
    returner b
}

# (mott, _, a1..an) → eqref: mott.m(a1..an) som vm_metode_løys + CALL-armen i VM-en:
#   1. struktur: tekst(mott.__struktur__) samanlikna med kvar kandidat S → S.m(mott, a1..an)
#      (feil aritet → ArgumentFeil som VM-en);
#   2. ordbok med feltet m som held ein closure → closuren(a1..an) (berre når modulen har
#      closures; utan $lambda kan ingen verdi vere ein closure);
#   3. elles MetodeFeil (òg for ingenting).
# lokale: n+2 d (ordbok), n+3 t (tekst), n+4 v (eqref), n+5 i (i32).
funksjon _metode_kropp(k: ordbok, g: ordbok) -> liste {
    la td = a.T_ORDBOK()
    la tt = a.T_TEKST()
    la ta = a.T_ARR()
    la na = g["n"]
    la m = tekst(g["m"])
    la ld = na + 2
    la lt = na + 3
    la lv = na + 4
    la li = na + 5
    la b = [4, 1, 99, td, 1, 99, tt, 1, EQREF(), 1, I32()]
    _la_til(b, a.flat([a.lg(0), a.rtest(td), a.iff([]), a.lg(0), a.rcast(td), a.ls(ld)]))
    la kand = g["kand"]
    hvis lengde(kand) > 0 {
        _la_til(b, a.flat([a.lg(ld), a.LIT(k, "__struktur__"), a.K(k, "merke_finn"), 34, li, a.i32c(0), 78, a.iff([]),
                           a.lg(ld), a.sget(td, 2), a.lg(li), a.aget(ta), a.K(k, "tekst_av"), a.ls(lt)]))
        la ci = 0
        mens ci < lengde(kand) {
            la c = kand[ci]
            _la_til(b, a.flat([a.lg(lt), a.LIT(k, tekst(c[0])), a.K(k, "tekst_lik"), a.iff([])]))
            hvis c[2] == na + 1 {
                _la_til(b, _lg(0))
                la ai = 0
                mens ai < na {
                    _la_til(b, _lg(ai + 2))
                    ai = ai + 1
                }
                legg_til(b, 16)
                _la_til(b, _leb(k["funk_idx"][tekst(c[1])]))
                legg_til(b, 15)
            } ellers {
                la meld = "ArgumentFeil: Aritetsfeil ved dynamisk kall til " + tekst(c[1]) + ": forventa " + tekst(c[2]) +
                          " argument, fekk " + tekst(na + 1)
                _la_til(b, a.flat([a.LIT(k, meld), a.K(k, "kast")]))
            }
            legg_til(b, 11)
            ci = ci + 1
        }
        legg_til(b, 11)
    }
    hvis k["bruker_lambda"] {
        _la_til(b, a.flat([a.lg(ld), a.LIT(k, m), a.K(k, "ordbok_hent"), a.ls(lv)]))
        _la_til(b, _lg(lv))
        _la_til(b, [251, 20])
        _la_til(b, w.leb_s(k["t_lambda"]))
        _la_til(b, [4, 64])
        la ai2 = 0
        mens ai2 < na {
            _la_til(b, _lg(ai2 + 2))
            ai2 = ai2 + 1
        }
        _la_til(b, _kall_closure(k, lv, na))
        _la_til(b, [15, 11])
    }
    legg_til(b, 11)
    _la_til(b, a.flat([a.lg(0), 209, a.iff([]), a.LIT(k, "MetodeFeil: kan ikkje kalle metoden " + m + "() på ingenting"), a.K(k, "kast"), a.END(),
                       a.LIT(k, "MetodeFeil: "), a.lg(0), a.K(k, "verdi_typenamn"), a.K(k, "konkat"),
                       a.LIT(k, " har ingen metode " + m + "()"), a.K(k, "konkat"), a.K(k, "kast"), 0, 11]))
    returner b
}

# Dispatcher for builtin.ncb_call_fn med n argument: (x, a1..an) → eqref.
funksjon _dyn_kropp(k: ordbok, n: heltall) -> liste {
    la tl = k["t_lambda"]
    la namn_lok = n + 1
    la b = [1, 1, 99, a.T_TEKST()]
    # closure → call_ref
    _la_til(b, _lg(0))
    _la_til(b, [251, 20])
    _la_til(b, w.leb_s(tl))
    _la_til(b, [4, 64])
    la i = 1
    mens i <= n { _la_til(b, _lg(i))  i = i + 1 }
    _la_til(b, _kall_closure(k, 0, n))
    _la_til(b, [15, 11])
    # tekst → metodenamn
    _la_til(b, _lg(0))
    _la_til(b, _kall(k, "tekst_av"))
    _la_til(b, _ls(namn_lok))
    la kand = k["dyn_kand"][tekst(n)]
    la ci = 0
    mens ci < lengde(kand) {
        _la_til(b, _lg(namn_lok))
        _la_til(b, a.flat(a.LIT(k, kand[ci])))
        _la_til(b, _kall(k, "tekst_lik"))
        _la_til(b, [4, 64])
        i = 1
        mens i <= n { _la_til(b, _lg(i))  i = i + 1 }
        legg_til(b, 16)
        _la_til(b, _leb(k["funk_idx"][kand[ci]]))
        _la_til(b, [15, 11])
        ci = ci + 1
    }
    _la_til(b, a.flat(a.LIT(k, "Ukjent selfhost-funksjon: ")))
    _la_til(b, _lg(namn_lok))
    _la_til(b, _kall(k, "konkat"))
    _la_til(b, _kall(k, "kast"))
    _la_til(b, [0, 11])
    returner b
}

# Kall `mål` (() → eqref) inne i try_table; eit uhandtert unnatak blir skrive som ERROR.
funksjon _verna_kall(k: ordbok, mål: liste) -> liste {
    la b = [2, 64, 2, EQREF(), 31, 64, 1, 0, 0, 0]
    _la_til(b, mål)
    _la_til(b, [11, 12, 1, 11])
    _la_til(b, _kall(k, "uhandtert"))
    legg_til(b, 11)
    returner b
}

# R2/F14: har modulinitialiseringa ein verknad utover å setje globalane (kall eller kast, t.d.
# ei toppnivå-setning som skriv)? VM-en køyrer alle initialiseringane; ei init med verknad
# kjem difor med sjølv når ingenting i modulen elles er nådd. Ei rein init (konstantar og
# literalar inn i globalar) kan ingen sjå når globalane ikkje blir brukte.
funksjon _init_har_verknad(fd: ordbok) -> bool {
    la kode = fd["code"]
    la i = 0
    mens i < lengde(kode) {
        la op = tekst(kode[i][0])
        hvis op == "CALL" eller op == "CALL_VALUE" eller op == "THROW" { returner sann }
        i = i + 1
    }
    returner usann
}

# ─── Hovudinngang ────────────────────────────────────────────────────────────

# opsjonar: {"testbygg": bool}
# Gjev {"ok": bool, "feil": [tekst], "bytar": liste, "importar": [namn], "eksportar": [namn],
#       "tilbakekall": {kvalifisert namn: eksportnamn}, "funksjonar": [kvalifiserte namn],
#       "har_init": bool, "atom": [namn], "kan_kaste": bool, "closures": [namn]}
funksjon kompiler(ncb: ordbok, opsjonar: ordbok) -> ordbok {
    la testbygg = usann
    hvis finnes_nøkkel(opsjonar, "testbygg") { testbygg = opsjonar["testbygg"] == sann }
    la k = _ny_kontekst(ncb, testbygg)
    # W4: rt-cache {q: {"kode", "kropp"}} (flyttbare kroppar frå eit tidlegare bygg)
    # Utan rt_cache i opsjonane blir alle kroppar emitterte direkte (ingen flyttbare kroppar)
    hvis finnes_nøkkel(opsjonar, "rt_cache") {
        k["rt_cache"] = opsjonar["rt_cache"]
        k["rt_cache_på"] = sann
    }
    # ... eller ei mappe (og rota) der cachefila blir lesen først når ho trengst
    hvis finnes_nøkkel(opsjonar, "rt_cache_mappe") {
        k["rt_cache_mappe"] = tekst(opsjonar["rt_cache_mappe"])
        k["rt_cache_rot"] = tekst(opsjonar["rt_cache_rot"])
        k["rt_cache_på"] = sann
    }
    la fns = k["fns"]
    la entry = ""
    hvis finnes_nøkkel(ncb, "entry") { entry = tekst(ncb["entry"]) }
    hvis entry == "" eller ikkje finnes_nøkkel(fns, entry) {
        returner {"ok": usann, "feil": ["klientmodulen manglar funksjonen start()"]}
    }
    hvis lengde(fns[entry]["params"]) != 0 {
        returner {"ok": usann, "feil": ["start() kan ikkje ha parametrar i ein klientmodul"]}
    }
    _legg_nåbar(k, entry)
    la inits = []
    hvis finnes_nøkkel(ncb, "module_initializers") { inits = ncb["module_initializers"] }
    la inits_med = {}
    la init_liste = []
    la ai = 0
    mens sann {
        mens ai < lengde(k["nåbare"]) {
            _analyser_cache(k, k["nåbare"][ai])
            ai = ai + 1
        }
        # Modulinit for kvar modul som har ein nåbar funksjon
        la modular = {}
        la mi = 0
        mens mi < lengde(k["nåbare"]) {
            modular[tekst(fns[k["nåbare"][mi]]["module"])] = sann
            mi = mi + 1
        }
        # R2/F14: modular med globalar som andre modular les eller skriv (alias.NAMN)
        la gmi0 = 0
        mens gmi0 < lengde(k["glob_mod_liste"]) {
            modular[tekst(k["glob_mod_liste"][gmi0])] = sann
            gmi0 = gmi0 + 1
        }
        la endra = usann
        la ii = 0
        mens ii < lengde(inits) {
            la iq = tekst(inits[ii])
            hvis finnes_nøkkel(fns, iq) og ikkje finnes_nøkkel(inits_med, iq) og
                 (finnes_nøkkel(modular, tekst(fns[iq]["module"])) eller _init_har_verknad(fns[iq])) {
                inits_med[iq] = sann
                _legg_nåbar(k, iq)
                endra = sann
            }
            ii = ii + 1
        }
        hvis ikkje endra og ai >= lengde(k["nåbare"]) { bryt }
    }
    # Init-rekkjefølgja er rekkjefølgja i module_initializers
    la ii2 = 0
    mens ii2 < lengde(inits) {
        hvis finnes_nøkkel(inits_med, tekst(inits[ii2])) { legg_til(init_liste, tekst(inits[ii2])) }
        ii2 = ii2 + 1
    }
    hvis lengde(k["feil"]) > 0 {
        returner {"ok": usann, "feil": k["feil"]}
    }

    # ── Atom og importar ──
    la atom_sett = _atom_lukking(k)
    la kan_kaste = k["har_throw"] eller k["har_eh"] eller lengde(k["dyn_liste"]) > 0 eller finnes_nøkkel(atom_sett, "kast")
    hvis kan_kaste {
        # R2/F08: modulen har unnatak (tag og uhandtert) alt, så aritmetikk på ikkje-tal
        # kastar ein fangbar TypeFeil som i VM-en (atom_avheng tek med «typefeil»)
        k["kast_ok"] = sann
        _bruk_atom(k, "uhandtert")
        atom_sett = _atom_lukking(k)
    }
    la atomar = []
    la ar = a.atom_rekkje()
    la ati = 0
    mens ati < lengde(ar) {
        hvis finnes_nøkkel(atom_sett, ar[ati]) {
            legg_til(atomar, ar[ati])
            la imp = a.atom_importar(ar[ati], testbygg)
            la ip0 = 0
            mens ip0 < lengde(imp) {
                k["vert_brukt"][imp[ip0]] = sann
                ip0 = ip0 + 1
            }
        }
        ati = ati + 1
    }

    # ── Indeksar ──
    k["typar"] = []
    k["type_nøkkel"] = {}
    la gct = a.gc_typar()
    la gi = 0
    mens gi < lengde(gct) {
        legg_til(k["typar"], gct[gi])
        gi = gi + 1
    }
    k["t_lambda"] = -1
    hvis k["bruker_lambda"] {
        # $lambda = struct {funcref, (ref null $arr)}
        k["t_lambda"] = lengde(k["typar"])
        legg_til(k["typar"], [95, 2, 112, 0, 99, a.T_ARR(), 0])
    }

    la tabell = k["tabell"]
    la vert_liste = []
    la ti = 0
    mens ti < lengde(tabell) {
        hvis finnes_nøkkel(k["vert_brukt"], tekst(tabell[ti]["namn"])) { legg_til(vert_liste, tabell[ti]) }
        ti = ti + 1
    }
    la n_imp = lengde(vert_liste)
    k["import_idx"] = {}
    la neste = 0
    la vi = 0
    mens vi < n_imp {
        k["import_idx"][tekst(vert_liste[vi]["namn"])] = vi
        vi = vi + 1
    }
    neste = n_imp
    # Atoma rett etter importane: indeksane er små (éin LEB-byte i kvart kall)
    k["atom_idx"] = {}
    ati = 0
    mens ati < lengde(atomar) {
        k["atom_idx"][atomar[ati]] = neste
        neste = neste + 1
        ati = ati + 1
    }
    # Innpakkarar berre for vertsfunksjonane klientkoden kallar (ikkje dei interne)
    k["innpakkar_idx"] = {}
    la innpakka = []
    vi = 0
    mens vi < n_imp {
        hvis ikkje vert_liste[vi]["intern"] {
            k["innpakkar_idx"][k["vert_modul"] + "." + tekst(vert_liste[vi]["namn"])] = neste
            legg_til(innpakka, vi)
            neste = neste + 1
        }
        vi = vi + 1
    }
    k["funk_idx"] = {}
    la fi = 0
    mens fi < lengde(k["nåbare"]) {
        k["funk_idx"][k["nåbare"][fi]] = neste
        neste = neste + 1
        fi = fi + 1
    }
    k["dyn_idx"] = {}
    la dli = 0
    mens dli < lengde(k["dyn_liste"]) {
        k["dyn_idx"][tekst(k["dyn_liste"][dli])] = neste
        neste = neste + 1
        dli = dli + 1
    }
    # R2: genererte funksjonar (kall_metode-dispatcharar og er_instans-testar)
    k["gen_idx"] = {}
    la gli = 0
    mens gli < lengde(k["gen_liste"]) {
        k["gen_idx"][tekst(k["gen_liste"][gli])] = neste
        neste = neste + 1
        gli = gli + 1
    }
    # Tilbakekall blir pakka inn (uhandterte unnatak → ERROR) når modulen kan kaste
    la tk_idx = {}
    hvis kan_kaste {
        la tki0 = 0
        mens tki0 < lengde(k["tilbakekall_liste"]) {
            tk_idx[k["tilbakekall_liste"][tki0]] = neste
            neste = neste + 1
            tki0 = tki0 + 1
        }
    }
    la init_idx = neste
    # Globalar: 0 usann, 1 sann, så modulglobalane til modular med nåbare funksjonar
    k["glob_idx"] = {}
    la glob_modular = []
    la gm_sett = {}
    fi = 0
    mens fi < lengde(k["nåbare"]) {
        la mm = tekst(fns[k["nåbare"][fi]]["module"])
        hvis ikkje finnes_nøkkel(gm_sett, mm) {
            gm_sett[mm] = sann
            legg_til(glob_modular, mm)
        }
        fi = fi + 1
    }
    # R2/F14: modular som berre blir nådde gjennom globalane sine (alias.NAMN)
    fi = 0
    mens fi < lengde(k["glob_mod_liste"]) {
        la mm3 = tekst(k["glob_mod_liste"][fi])
        hvis ikkje finnes_nøkkel(gm_sett, mm3) {
            gm_sett[mm3] = sann
            legg_til(glob_modular, mm3)
        }
        fi = fi + 1
    }
    la n_glob = 2
    la gmi = 0
    mens gmi < lengde(glob_modular) {
        la mm2 = glob_modular[gmi]
        hvis finnes_nøkkel(k["globale"], mm2) {
            la gl = k["globale"][mm2]
            la gj = 0
            mens gj < lengde(gl) {
                k["glob_idx"][mm2 + "." + tekst(gl[gj])] = n_glob
                n_glob = n_glob + 1
                gj = gj + 1
            }
        }
        gmi = gmi + 1
    }

    # ── Kroppar: brukarfunksjonane først (dei samlar data), så atom og innpakkarar ──
    la brukar_kroppar = []
    fi = 0
    mens fi < lengde(k["nåbare"]) {
        legg_til(brukar_kroppar, _brukarfunksjon_cache(k, k["nåbare"][fi]))
        fi = fi + 1
    }
    la dyn_kroppar = []
    dli = 0
    mens dli < lengde(k["dyn_liste"]) {
        legg_til(dyn_kroppar, _dyn_kropp(k, k["dyn_liste"][dli]))
        dli = dli + 1
    }
    la gen_kroppar = []
    la gli2 = 0
    mens gli2 < lengde(k["gen_liste"]) {
        legg_til(gen_kroppar, _gen_kropp(k, tekst(k["gen_liste"][gli2])))
        gli2 = gli2 + 1
    }
    # Postkassa ligg etter vertskonstantane (8-justert)
    k["postkasse"] = ((lengde(k["data"]) + 7) / 8) * 8
    la har_minne = lengde(k["data"]) > 0 eller finnes_nøkkel(atom_sett, "til_minne") eller finnes_nøkkel(atom_sett, "fmt_f64") eller
                   finnes_nøkkel(atom_sett, "frå_minne") eller finnes_nøkkel(atom_sett, "til_minne_ved")

    la import_typar = []
    vi = 0
    mens vi < n_imp {
        la sig = _import_sig(vert_liste[vi])
        legg_til(import_typar, _type_idx(k, sig[0], sig[1]))
        vi = vi + 1
    }
    la funk_typar = []
    la kroppar = []
    ati = 0
    mens ati < lengde(atomar) {
        la sig3 = a.atom_sig(atomar[ati])
        legg_til(funk_typar, _type_idx(k, sig3[0], sig3[1]))
        la ak = a.flat(a.atom_kropp(k, atomar[ati]))
        legg_til(ak, 11)
        legg_til(kroppar, ak)
        ati = ati + 1
    }
    la ii3 = 0
    mens ii3 < lengde(innpakka) {
        la vf = vert_liste[innpakka[ii3]]
        la sig2 = _innpakkar_sig(vf)
        legg_til(funk_typar, _type_idx(k, sig2[0], sig2[1]))
        legg_til(kroppar, _innpakkar(k, vf, innpakka[ii3]))
        ii3 = ii3 + 1
    }
    la closures = []
    fi = 0
    mens fi < lengde(k["nåbare"]) {
        la q = k["nåbare"][fi]
        la qa = k["analyse"][q]
        hvis qa["lambda"] {
            legg_til(funk_typar, _fn_type(k, qa["np"]))
            legg_til(closures, q)
        } ellers {
            legg_til(funk_typar, _type_idx(k, _eqref_liste(qa["np"]), [EQREF()]))
        }
        legg_til(kroppar, brukar_kroppar[fi])
        fi = fi + 1
    }
    dli = 0
    mens dli < lengde(k["dyn_liste"]) {
        legg_til(funk_typar, _type_idx(k, _eqref_liste(k["dyn_liste"][dli] + 1), [EQREF()]))
        legg_til(kroppar, dyn_kroppar[dli])
        dli = dli + 1
    }
    gli = 0
    mens gli < lengde(k["gen_liste"]) {
        la gs = k["gen"][tekst(k["gen_liste"][gli])]
        la gn_p = 2
        hvis gs["art"] == "metode" { gn_p = gs["n"] + 2 }
        legg_til(funk_typar, _type_idx(k, _eqref_liste(gn_p), [EQREF()]))
        legg_til(kroppar, gen_kroppar[gli])
        gli = gli + 1
    }
    hvis kan_kaste {
        la tki1 = 0
        mens tki1 < lengde(k["tilbakekall_liste"]) {
            la tq0 = k["tilbakekall_liste"][tki1]
            legg_til(funk_typar, _type_idx(k, [], []))
            la kall_tq = [16]
            _la_til(kall_tq, _leb(k["funk_idx"][tq0]))
            legg_til(kall_tq, 26)
            la tb = [0]
            _la_til(tb, _verna_kall(k, kall_tq))
            legg_til(tb, 11)
            legg_til(kroppar, tb)
            tki1 = tki1 + 1
        }
    }
    # Init: modulinitialiseringar, så start() (inne i try_table når modulen kan kaste)
    legg_til(funk_typar, _type_idx(k, [], []))
    la kall = []
    la ij = 0
    mens ij < lengde(init_liste) {
        legg_til(kall, 16)
        _la_til(kall, _leb(k["funk_idx"][init_liste[ij]]))
        legg_til(kall, 26)
        ij = ij + 1
    }
    legg_til(kall, 16)
    _la_til(kall, _leb(k["funk_idx"][entry]))
    legg_til(kall, 26)
    la ik = [0]
    hvis kan_kaste { _la_til(ik, _verna_kall(k, kall)) } ellers { _la_til(ik, kall) }
    legg_til(ik, 11)
    legg_til(kroppar, ik)
    la tag_type = -1
    hvis kan_kaste { tag_type = _type_idx(k, [EQREF()], []) }

    # ── Seksjonar ──
    la m = [0, 97, 115, 109, 1, 0, 0, 0]
    la tp = _leb(lengde(k["typar"]))
    la tyi = 0
    mens tyi < lengde(k["typar"]) { _la_til(tp, k["typar"][tyi])  tyi = tyi + 1 }
    _la_til(m, w.seksjon(1, tp))

    hvis n_imp > 0 {
        la ip = _leb(n_imp)
        vi = 0
        mens vi < n_imp {
            _la_til(ip, w.namn_bytar("nc"))
            _la_til(ip, w.namn_bytar(tekst(vert_liste[vi]["namn"])))
            legg_til(ip, 0)
            _la_til(ip, _leb(import_typar[vi]))
            vi = vi + 1
        }
        _la_til(m, w.seksjon(2, ip))
    }

    la fp = _leb(lengde(funk_typar))
    la fti = 0
    mens fti < lengde(funk_typar) { _la_til(fp, _leb(funk_typar[fti]))  fti = fti + 1 }
    _la_til(m, w.seksjon(3, fp))

    hvis har_minne {
        # Minst éi side; nok til vertskonstantane og ei lita postkasse
        la sider = (k["postkasse"] + 64 + 65535) / 65536
        la mp = [1, 0]
        _la_til(mp, _leb(sider))
        _la_til(m, w.seksjon(5, mp))
    }

    hvis kan_kaste {
        # Tag $nc_unntak (eqref) → ()
        la tgp = [1, 0]
        _la_til(tgp, _leb(tag_type))
        _la_til(m, w.seksjon(13, tgp))
    }

    la gp = _leb(n_glob)
    # usann / sann: (ref $bool) immutable = struct.new $bool (i32.const 0/1)
    la tbo = a.T_BOOL()
    _la_til(gp, [100, tbo, 0, 65, 0, 251, 0, tbo, 11])
    _la_til(gp, [100, tbo, 0, 65, 1, 251, 0, tbo, 11])
    la gk = 2
    mens gk < n_glob {
        _la_til(gp, [EQREF(), 1, 208, EQREF(), 11])
        gk = gk + 1
    }
    _la_til(m, w.seksjon(6, gp))

    la eksportar = []
    la ep = []
    la n_eksp = 1 + lengde(k["tilbakekall_liste"])
    hvis har_minne { n_eksp = n_eksp + 1 }
    _la_til(ep, _leb(n_eksp))
    hvis har_minne {
        _la_til(ep, w.namn_bytar("m"))
        _la_til(ep, [2, 0])
        legg_til(eksportar, "m")
    }
    _la_til(ep, w.namn_bytar("i"))
    legg_til(ep, 0)
    _la_til(ep, _leb(init_idx))
    legg_til(eksportar, "i")
    la tki = 0
    mens tki < lengde(k["tilbakekall_liste"]) {
        la tq = k["tilbakekall_liste"][tki]
        la en = k["tilbakekall"][tq]
        _la_til(ep, w.namn_bytar(en))
        legg_til(ep, 0)
        hvis kan_kaste { _la_til(ep, _leb(tk_idx[tq])) } ellers { _la_til(ep, _leb(k["funk_idx"][tq])) }
        legg_til(eksportar, en)
        tki = tki + 1
    }
    _la_til(m, w.seksjon(7, ep))

    hvis lengde(closures) > 0 {
        # Deklarativt elementsegment: lambda-hjelparane kan brukast i ref.func
        la el = [1, 3, 0]
        _la_til(el, _leb(lengde(closures)))
        la cli = 0
        mens cli < lengde(closures) {
            _la_til(el, _leb(k["funk_idx"][closures[cli]]))
            cli = cli + 1
        }
        _la_til(m, w.seksjon(9, el))
    }

    # Datasegment: 0 = passivt (tekstliteralar for array.new_data), så det aktive med
    # vertskonstantane i minnet.
    la n_seg = 0
    hvis lengde(k["lit"]) > 0 { n_seg = n_seg + 1 }
    hvis lengde(k["data"]) > 0 { n_seg = n_seg + 1 }
    hvis lengde(k["lit"]) > 0 {
        _la_til(m, w.seksjon(12, _leb(n_seg)))
    }

    # Kodeseksjonen blir skriven rett inn i modulen (W4: éin kopi av kvar byte, ikkje tre)
    la kl = []
    la c_n = lengde(_leb(lengde(kroppar)))
    la ki = 0
    mens ki < lengde(kroppar) {
        la bl = _kropp_lengd(kroppar[ki])
        legg_til(kl, bl)
        c_n = c_n + lengde(_leb(bl)) + bl
        ki = ki + 1
    }
    legg_til(m, 10)
    _la_til(m, _leb(c_n))
    _la_til(m, _leb(lengde(kroppar)))
    ki = 0
    mens ki < lengde(kroppar) {
        _la_til(m, _leb(kl[ki]))
        _kropp_inn(m, kroppar[ki])
        ki = ki + 1
    }

    hvis n_seg > 0 {
        la dp = _leb(n_seg)
        hvis lengde(k["lit"]) > 0 {
            legg_til(dp, 1)
            _la_til(dp, _leb(lengde(k["lit"])))
            _la_til(dp, k["lit"])
        }
        hvis lengde(k["data"]) > 0 {
            _la_til(dp, [0, 65, 0, 11])
            _la_til(dp, _leb(lengde(k["data"])))
            _la_til(dp, k["data"])
        }
        _la_til(m, w.seksjon(11, dp))
    }

    la imp_namn = []
    vi = 0
    mens vi < n_imp { legg_til(imp_namn, tekst(vert_liste[vi]["namn"]))  vi = vi + 1 }
    # Runtime-funksjonane (std.wasm_rt) som kom med, utan modulprefikset
    la rt_med = []
    la rp = rt_modul() + "."
    fi = 0
    mens fi < lengde(k["nåbare"]) {
        la rq = tekst(k["nåbare"][fi])
        hvis builtin.starts_with(rq, rp) { legg_til(rt_med, builtin.slice(rq, lengde(rp), lengde(rq))) }
        fi = fi + 1
    }
    returner {"ok": sann, "feil": [], "bytar": m, "importar": imp_namn, "eksportar": eksportar,
              "tilbakekall": k["tilbakekall"], "funksjonar": k["nåbare"], "har_init": sann,
              "atom": atomar, "kan_kaste": kan_kaste, "closures": closures, "rt": rt_med,
              "rt_ny": k["rt_ny"], "rt_cache": k["rt_cache"], "rt_cache_fil": k["rt_cache_fil"],
              "rt_treff": k["rt_treff"], "rt_bomm": k["rt_bomm"], "rt_analyse_treff": k["rt_analyse_treff"]}
}

# Versjon over sjølve bytane (sha256_bytes, 12 hex). sha256(tekst(liste)) er IKKJE
# innhaldet og gav same versjon for ulike modular (funn i W0-proben).
funksjon versjon(bytar: liste) -> tekst {
    returner builtin.slice(builtin.sha256_bytes(bytar), 0, 12)
}

funksjon feilrapport(res: ordbok) -> tekst {
    la ut = "WASM-kompilering feila (" + tekst(lengde(res["feil"])) + " feil):\n"
    la i = 0
    mens i < lengde(res["feil"]) {
        ut = ut + "  - " + tekst(res["feil"][i]) + "\n"
        i = i + 1
    }
    returner ut
}
