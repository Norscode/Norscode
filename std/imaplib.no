# imaplib.no — persistent, shell-fri IMAP/IMAPS-klient

bruk std.protocol_stream som stream

funksjon _inneheld(s: tekst, del: tekst) -> boolsk { returner builtin.index_of(s, del) >= 0 }
funksjon _startar(s: tekst, prefiks: tekst) -> boolsk { returner builtin.starts_with(s, prefiks) }
funksjon _trim(s: tekst) -> tekst { returner builtin.trim(s) }

funksjon _trygt_felt(s: tekst) -> boolsk {
    returner s != "" og builtin.index_of(s, "\r") < 0 og builtin.index_of(s, "\n") < 0 og builtin.index_of(s, "\u0000") < 0
}

funksjon _quote(s: tekst) -> tekst {
    hvis ikkje _trygt_felt(s) { kast "IMAPValidation: ugyldig felt" }
    returner "\"" + builtin.replace(builtin.replace(s, "\\", "\\\\"), "\"", "\\\"") + "\""
}

funksjon _ny_klient(vert: tekst, port: heiltall, ssl: boolsk, starttls: boolsk,
                    ca_file: tekst) -> ordbok {
    returner {
        "vert": vert, "port": port, "ssl": ssl, "starttls": starttls,
        "ca_file": ca_file, "brukar": "", "passord": "", "postboks": "",
        "tilkopla": usann, "autentisert": usann, "session": {}, "buffer": "",
        "tag_counter": 0, "timeout_ms": 30000, "max_response": 4194304,
        "seen_uids": "|", "reconnect_count": 0, "last_error": "",
        "last_status": "", "last_raw": ""
    }
}

funksjon sett_ca_fil(c: ordbok, ca_file: tekst) { c["ca_file"] = ca_file }
funksjon sett_grenser(c: ordbok, timeout_ms: heiltall, max_response: heiltall) -> boolsk {
    hvis timeout_ms < 100 eller timeout_ms > 300000 eller max_response < 1024 eller max_response > 16777216 { returner usann }
    c["timeout_ms"] = timeout_ms
    c["max_response"] = max_response
    returner sann
}

funksjon _tag(c: ordbok) -> tekst {
    c["tag_counter"] = c["tag_counter"] + 1
    returner "N" + tekst_fra_heltall(c["tag_counter"])
}

funksjon _literal_lengde(linje: tekst) -> heiltall {
    hvis ikkje builtin.ends_with(linje, "}") { returner -1 }
    la p = lengde(linje) - 2
    mens p >= 0 og builtin.slice(linje, p, p + 1) >= "0" og builtin.slice(linje, p, p + 1) <= "9" { p = p - 1 }
    hvis p < 0 eller builtin.slice(linje, p, p + 1) != "{" { returner -1 }
    la rå = builtin.slice(linje, p + 1, lengde(linje) - 1)
    hvis rå == "" { returner -1 }
    prøv { returner heltall_fra_tekst(rå) } fang (e) { returner -1 }
    returner -1
}

# Finn berre terminaltaggar på protokolllinjer; bytes i IMAP-literals blir hoppa over.
funksjon _tag_status(svar: tekst, tag: tekst) -> tekst {
    la p = 0
    mens p < lengde(svar) {
        la rest = builtin.slice(svar, p, lengde(svar))
        la rel = builtin.index_of(rest, "\r\n")
        hvis rel < 0 { returner "" }
        la linje = builtin.slice(rest, 0, rel)
        la literal = _literal_lengde(linje)
        hvis literal >= 0 {
            la neste = p + rel + 2 + literal
            hvis neste > lengde(svar) { returner "" }
            p = neste
        } ellers {
            hvis _startar(linje, tag + " ") {
                la delar = builtin.split(linje, " ")
                hvis lengde(delar) >= 2 { returner builtin.upper(delar[1]) }
                returner "BAD"
            }
            p = p + rel + 2
        }
    }
    returner ""
}

funksjon _les_til_tag(c: ordbok, tag: tekst) -> ordbok_tekst {
    la out = c["buffer"]
    c["buffer"] = ""
    la status = _tag_status(out, tag)
    la rundar = 0
    mens status == "" og lengde(out) < c["max_response"] og rundar < 1024 {
        la chunk_maks = c["max_response"] - lengde(out)
        hvis chunk_maks > 1048576 { chunk_maks = 1048576 }
        la r = stream.les_chunk(c["session"], chunk_maks)
        hvis r["status"] != "ok" { returner {"status": "network", "raw": out, "error": r["error"]} }
        out = out + r["data"]
        status = _tag_status(out, tag)
        rundar = rundar + 1
    }
    hvis status == "" { returner {"status": "protocol", "raw": out, "error": "ufullstendig eller for stort IMAP-svar"} }
    returner {"status": status, "raw": out, "error": ""}
}

funksjon _les_helsing(c: ordbok) -> boolsk {
    la r = stream.les_chunk(c["session"], 65536)
    hvis r["status"] != "ok" { c["last_error"] = r["error"] returner usann }
    hvis ikkje _startar(r["data"], "* OK") og ikkje _startar(r["data"], "* PREAUTH") {
        c["last_error"] = "server gav ikkje gyldig IMAP-helsing"
        returner usann
    }
    returner sann
}

funksjon _opne(c: ordbok) -> boolsk {
    hvis ikkje _trygt_felt(c["vert"]) eller c["port"] <= 0 { c["last_error"] = "ugyldig endepunkt" returner usann }
    c["session"] = stream.opne_session_ca(c["vert"], c["port"], c["ssl"], c["timeout_ms"], c["ca_file"])
    hvis c["session"]["status"] != "open" { c["last_error"] = c["session"]["error"] returner usann }
    hvis ikkje _les_helsing(c) { stream.lukk_session(c["session"]) returner usann }
    hvis c["starttls"] {
        la tag = _tag(c)
        hvis ikkje stream.skriv_alt(c["session"], tag + " STARTTLS\r\n") { stream.lukk_session(c["session"]) returner usann }
        la tls_svar = _les_til_tag(c, tag)
        hvis tls_svar["status"] != "OK" eller ikkje stream.oppgrader_tls(c["session"], c["vert"], c["ca_file"]) {
            c["last_error"] = "STARTTLS feila"
            stream.lukk_session(c["session"])
            returner usann
        }
    }
    c["tilkopla"] = sann
    returner sann
}

funksjon connect_ca(vert: tekst, port: heiltall, ssl: boolsk, ca_file: tekst) -> ordbok {
    la c = _ny_klient(vert, port, ssl, usann, ca_file)
    _opne(c)
    returner c
}

funksjon connect(vert: tekst, port: heiltall, ssl: boolsk) -> ordbok { returner connect_ca(vert, port, ssl, "") }
funksjon connect_starttls(vert: tekst, port: heiltall, ca_file: tekst) -> ordbok {
    la c = _ny_klient(vert, port, usann, sann, ca_file)
    _opne(c)
    returner c
}
funksjon connect_standard(vert: tekst) -> ordbok { returner connect(vert, 993, sann) }

funksjon _send_ein(c: ordbok, kommando: tekst) -> ordbok_tekst {
    la tag = _tag(c)
    hvis ikkje stream.skriv_alt(c["session"], tag + " " + kommando + "\r\n") {
        returner {"status": "network", "raw": "", "error": "skriving feila"}
    }
    returner _les_til_tag(c, tag)
}

funksjon _gjenopprett(c: ordbok) -> boolsk {
    prøv { stream.lukk_session(c["session"]) } fang (e) {}
    c["tilkopla"] = usann
    c["autentisert"] = usann
    hvis ikkje _opne(c) { returner usann }
    hvis c["brukar"] != "" {
        la auth = _send_ein(c, "LOGIN " + _quote(c["brukar"]) + " " + _quote(c["passord"]))
        hvis auth["status"] != "OK" { returner usann }
        c["autentisert"] = sann
    }
    hvis c["postboks"] != "" {
        la valgt = _send_ein(c, "SELECT " + _quote(c["postboks"]))
        hvis valgt["status"] != "OK" { returner usann }
    }
    c["reconnect_count"] = c["reconnect_count"] + 1
    returner sann
}

funksjon _kommando(c: ordbok, kommando: tekst, kan_replay: boolsk) -> ordbok_tekst {
    hvis ikkje _trygt_felt(kommando) { returner {"status": "validation", "raw": "", "error": "ugyldig kommando"} }
    hvis ikkje c["tilkopla"] og ikkje _gjenopprett(c) { returner {"status": "network", "raw": "", "error": c["last_error"]} }
    la result = _send_ein(c, kommando)
    hvis result["status"] == "network" og kan_replay og _gjenopprett(c) { result = _send_ein(c, kommando) }
    c["last_status"] = result["status"]
    c["last_raw"] = result["raw"]
    c["last_error"] = result["error"]
    returner result
}

funksjon login(c: ordbok, brukar: tekst, passord: tekst) -> boolsk {
    hvis ikkje _trygt_felt(brukar) eller ikkje _trygt_felt(passord) { returner usann }
    c["brukar"] = brukar
    c["passord"] = passord
    la result = _kommando(c, "LOGIN " + _quote(brukar) + " " + _quote(passord), usann)
    c["autentisert"] = result["status"] == "OK"
    returner c["autentisert"]
}

funksjon logout(c: ordbok) {
    hvis c["tilkopla"] { _kommando(c, "LOGOUT", usann) }
    prøv { stream.lukk_session(c["session"]) } fang (e) {}
    c["tilkopla"] = usann
    c["autentisert"] = usann
    c["passord"] = ""
}

funksjon list(c: ordbok) -> liste_tekst {
    la result = _kommando(c, "LIST \"\" \"*\"", sann)
    la out: liste_tekst = []
    hvis result["status"] != "OK" { returner out }
    la linjer = builtin.split(result["raw"], "\r\n")
    la i = 0
    mens i < lengde(linjer) { hvis _startar(linjer[i], "* LIST ") { legg_til(out, linjer[i]) } i = i + 1 }
    returner out
}

funksjon select(c: ordbok, postboks: tekst) -> boolsk {
    hvis ikkje _trygt_felt(postboks) { returner usann }
    la result = _kommando(c, "SELECT " + _quote(postboks), sann)
    hvis result["status"] == "OK" { c["postboks"] = postboks returner sann }
    returner usann
}

funksjon search(c: ordbok, kriterie: tekst) -> liste_tekst {
    la out: liste_tekst = []
    hvis ikkje _trygt_felt(kriterie) { returner out }
    la result = _kommando(c, "UID SEARCH " + kriterie, sann)
    hvis result["status"] != "OK" { returner out }
    la linjer = builtin.split(result["raw"], "\r\n")
    la i = 0
    mens i < lengde(linjer) {
        hvis _startar(linjer[i], "* SEARCH") {
            la delar = builtin.split(linjer[i], " ")
            la j = 2
            mens j < lengde(delar) { hvis delar[j] != "" { legg_til(out, delar[j]) } j = j + 1 }
        }
        i = i + 1
    }
    returner out
}

funksjon _felt(rå: tekst, namn: tekst) -> tekst {
    la linjer = builtin.split(rå, "\r\n")
    la prefiks = builtin.lower(namn) + ":"
    la i = 0
    mens i < lengde(linjer) {
        hvis _startar(builtin.lower(linjer[i]), prefiks) { returner _trim(builtin.slice(linjer[i], lengde(prefiks), lengde(linjer[i]))) }
        i = i + 1
    }
    returner ""
}

funksjon _flags(rå: tekst) -> liste_tekst {
    la out: liste_tekst = []
    la marker = builtin.index_of(rå, "FLAGS (")
    hvis marker < 0 { returner out }
    la rest = builtin.slice(rå, marker + 7, lengde(rå))
    la slutt = builtin.index_of(rest, ")")
    hvis slutt < 0 { returner out }
    la delar = builtin.split(builtin.slice(rest, 0, slutt), " ")
    la i = 0
    mens i < lengde(delar) { hvis delar[i] != "" { legg_til(out, delar[i]) } i = i + 1 }
    returner out
}

funksjon fetch(c: ordbok, uid: tekst) -> ordbok {
    la msg: ordbok = {"_type": "imap_melding", "uid": uid, "id": uid, "raw": "", "flags": [], "duplicate": usann, "error": ""}
    hvis ikkje _trygt_felt(uid) { msg["error"] = "ugyldig UID" returner msg }
    la result = _kommando(c, "UID FETCH " + uid + " (UID FLAGS BODY.PEEK[])", sann)
    hvis result["status"] != "OK" { msg["error"] = result["error"] returner msg }
    msg["raw"] = result["raw"]
    msg["flags"] = _flags(result["raw"])
    msg["from"] = _felt(result["raw"], "From")
    msg["to"] = _felt(result["raw"], "To")
    msg["subject"] = _felt(result["raw"], "Subject")
    msg["date"] = _felt(result["raw"], "Date")
    hvis _inneheld(c["seen_uids"], "|" + uid + "|") { msg["duplicate"] = sann }
    ellers { c["seen_uids"] = c["seen_uids"] + uid + "|" }
    returner msg
}

funksjon store_flags(c: ordbok, uid: tekst, handling: tekst, flags: liste_tekst) -> boolsk {
    hvis handling != "+FLAGS.SILENT" og handling != "-FLAGS.SILENT" og handling != "FLAGS.SILENT" { returner usann }
    hvis ikkje _trygt_felt(uid) eller lengde(flags) == 0 { returner usann }
    la i = 0
    mens i < lengde(flags) { hvis ikkje _trygt_felt(flags[i]) eller _inneheld(flags[i], " ") { returner usann } i = i + 1 }
    returner _kommando(c, "UID STORE " + uid + " " + handling + " (" + builtin.join(flags, " ") + ")", usann)["status"] == "OK"
}

funksjon store_seen(c: ordbok, uid: tekst) -> boolsk { returner store_flags(c, uid, "+FLAGS.SILENT", ["\\Seen"]) }
funksjon store_deleted(c: ordbok, uid: tekst) -> boolsk { returner store_flags(c, uid, "+FLAGS.SILENT", ["\\Deleted"]) }

funksjon reconnect_count(c: ordbok) -> heiltall { returner c["reconnect_count"] }
funksjon produksjonsstatus() -> ordbok_tekst {
    returner {"status": "klar", "transport": "persistent native IMAPS/STARTTLS", "parser": "tagged untagged literal-aware", "identity": "UID with in-session deduplication", "reconnect": "single safe replay for read-only commands"}
}
