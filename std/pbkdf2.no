# pbkdf2.no — PBKDF2-HMAC-SHA256 (RFC 8018) i REIN Norscode.
#
# Demonstrerer den "brutale" sjølvstende-vegen: i staden for handskriven native
# maskinkode per krypto-builtin, uttrykk krypto i Norscode og la den sjølv-hostande
# codegen-en kompilere det nativt. Byggjer på std.sha256.hmac_sha256_bytes (som
# berre brukar char_code/index_of/slice — primitiv codegen alt har).

bruk std.sha256 som sha

funksjon _hex_nibble(n: heiltall) -> tekst {
    hvis n < 10 { returner tekst_fra_heltall(n) }
    hvis n == 10 { returner "a" }
    hvis n == 11 { returner "b" }
    hvis n == 12 { returner "c" }
    hvis n == 13 { returner "d" }
    hvis n == 14 { returner "e" }
    returner "f"
}

funksjon _hex_byte(b: heiltall) -> tekst {
    returner _hex_nibble((b >> 4) & 15) + _hex_nibble(b & 15)
}

# PBKDF2-HMAC-SHA256(passord, salt, iterasjonar, dklen) → dklen-byte avleidd nøkkel
# som hex-streng. passord/salt = byte-lister (liste_heiltall).
funksjon pbkdf2_sha256(passord: liste_heiltall, salt: liste_heiltall, iterasjonar: heiltall, dklen: heiltall) -> tekst {
    la nblokk = (dklen + 31) / 32
    la dk: liste_heiltall = []
    la bi = 1
    mens bi <= nblokk {
        # msg = salt || INT32BE(bi)
        la msg: liste_heiltall = []
        for b i salt { legg_til(msg, b) }
        legg_til(msg, (bi >> 24) & 255)
        legg_til(msg, (bi >> 16) & 255)
        legg_til(msg, (bi >> 8) & 255)
        legg_til(msg, bi & 255)
        # U1 = HMAC(pw, msg); T = U1
        la u = sha.hmac_sha256_bytes(passord, msg)
        la t: liste_heiltall = []
        for b i u { legg_til(t, b) }
        # Uc = HMAC(pw, U(c-1)); T ^= Uc
        la c = 2
        mens c <= iterasjonar {
            u = sha.hmac_sha256_bytes(passord, u)
            la j = 0
            mens j < 32 {
                t[j] = t[j] ^ u[j]
                j = j + 1
            }
            c = c + 1
        }
        for b i t { legg_til(dk, b) }
        bi = bi + 1
    }
    # trunker til dklen byte, hex-kod
    la hex = ""
    la i = 0
    mens i < dklen {
        hex = hex + _hex_byte(dk[i])
        i = i + 1
    }
    returner hex
}
