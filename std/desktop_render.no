# Desktop render v1: deterministisk tegneliste i Norscode.
# Backend-uavhengig kontrakt. Ingen native skjermoppteikning.
funksjon ny_scene(breidde: heiltall, hogde: heiltall) -> ordbok_tekst {
    la s: ordbok_tekst = {}
    s["width"] = tekst_fra_heltall(breidde)
    s["height"] = tekst_fra_heltall(hogde)
    s["count"] = "0"
    s["valid"] = "usann"
    hvis breidde > 0 og hogde > 0 og breidde <= 16384 og hogde <= 16384 { s["valid"] = "sann" }
    returner s
}

funksjon _tal(x: heiltall) -> tekst { returner tekst_fra_heltall(x) }

funksjon _farge_ok(farge: tekst) -> bool {
    hvis lengde(farge) != 7 { returner usann }
    hvis builtin.slice(farge, 0, 1) != "#" { returner usann }
    la lovleg = "0123456789abcdefABCDEF"
    la i: heiltall = 1
    mens i < 7 {
        hvis builtin.index_of(lovleg, builtin.slice(farge, i, i + 1)) < 0 { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon _rekt_ok(s: ordbok_tekst, x: heiltall, y: heiltall, w: heiltall, h: heiltall) -> bool {
    hvis s["valid"] != "sann" eller w <= 0 eller h <= 0 eller x < 0 eller y < 0 { returner usann }
    hvis x > heltall_fra_tekst(s["width"]) eller y > heltall_fra_tekst(s["height"]) { returner usann }
    hvis w > heltall_fra_tekst(s["width"]) - x eller h > heltall_fra_tekst(s["height"]) - y { returner usann }
    returner sann
}

funksjon _legg(s: ordbok_tekst, type_namn: tekst, x: heiltall, y: heiltall, w: heiltall, h: heiltall, farge: tekst, verdi: tekst) -> bool {
    la n = heltall_fra_tekst(s["count"])
    hvis n >= 4096 { returner usann }
    la key = "command." + _tal(n) + "."
    s[key + "type"] = type_namn
    s[key + "x"] = _tal(x)
    s[key + "y"] = _tal(y)
    s[key + "width"] = _tal(w)
    s[key + "height"] = _tal(h)
    s[key + "color"] = farge
    s[key + "text"] = verdi
    s["count"] = _tal(n + 1)
    returner sann
}

funksjon rektangel(s: ordbok_tekst, x: heiltall, y: heiltall, w: heiltall, h: heiltall, farge: tekst) -> bool {
    hvis ikkje _rekt_ok(s, x, y, w, h) eller ikkje _farge_ok(farge) { returner usann }
    returner _legg(s, "rect", x, y, w, h, farge, "")
}

funksjon tekstlinje(s: ordbok_tekst, x: heiltall, y: heiltall, w: heiltall, h: heiltall, farge: tekst, verdi: tekst) -> bool {
    hvis ikkje _rekt_ok(s, x, y, w, h) eller ikkje _farge_ok(farge) { returner usann }
    hvis lengde(verdi) > 16384 { returner usann }
    returner _legg(s, "text", x, y, w, h, farge, verdi)
}

funksjon kommando(s: ordbok_tekst, indeks: heiltall) -> ordbok_tekst {
    hvis indeks < 0 eller indeks >= heltall_fra_tekst(s["count"]) { returner {"ok": "usann"} }
    la key = "command." + _tal(indeks) + "."
    returner {"ok":"sann", "type":s[key + "type"], "x":s[key + "x"], "y":s[key + "y"], "width":s[key + "width"], "height":s[key + "height"], "color":s[key + "color"], "text":s[key + "text"]}
}

funksjon status() -> ordbok_tekst {
    returner {"api":"norscode-desktop-render-v1", "status":"headless-command-list", "native_backend":"mangler", "max_commands":"4096"}
}
