# tarfile.no — prosessfri TAR/TAR.GZ i Norscode
#
# Brukar den delte std.zip-kjernen for USTAR-header, checksum, blokkgrenser,
# gzip CRC32/ISIZE og traversal-sikker utpakking. Bzip2 og xz feilar lukka.

bruk std.zip som tar
bruk std.runtime_filesystem som native_fs

funksjon _katalog_finnes(sti: tekst) -> bool {
    prøv { returner native_fs.native_list(sti, "")["status"] == "ok" }
    fang (e) { returner usann }
    returner usann
}

funksjon _fil_finnes(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) og ikkje _katalog_finnes(sti) }
    fang (e) { returner usann }
    returner usann
}

funksjon _filnamn(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    returner delar[lengde(delar) - 1]
}

funksjon _katalog(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) <= 1 { returner "." }
    la ut = builtin.join(builtin.slice(delar, 0, lengde(delar) - 1), "/")
    hvis ut == "" { returner "/" }
    returner ut
}

funksjon _lag_katalog(sti: tekst) -> bool {
    prøv {
        builtin.mkdir_p(sti)
        returner _katalog_finnes(sti)
    } fang (e) { returner usann }
    returner usann
}

funksjon _lista(sti: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    prøv {
        la listing = native_fs.native_list(sti, "")
        hvis listing["status"] != "ok" { returner ut }
        la linjer = builtin.split(listing["data"], "\n")
        la i = 0
        mens i < lengde(linjer) {
            la namn = builtin.trim(linjer[i])
            hvis namn != "" { legg_til(ut, namn) }
            i = i + 1
        }
    } fang (e) {}
    returner ut
}

funksjon _walk(sti: tekst) -> liste_tekst {
    la filer: liste_tekst = []
    la kø: liste_tekst = [sti]
    la qi = 0
    mens qi < lengde(kø) {
        la barn = _lista(kø[qi])
        la i = 0
        mens i < lengde(barn) {
            la kandidat = kø[qi] + "/" + barn[i]
            hvis _katalog_finnes(kandidat) { legg_til(kø, kandidat) }
            ellers { legg_til(filer, kandidat) }
            i = i + 1
        }
        qi = qi + 1
    }
    returner filer
}

funksjon _detect_format(sti: tekst) -> tekst {
    hvis builtin.ends_with(sti, ".tar.gz") eller builtin.ends_with(sti, ".tgz") { returner "gz" }
    hvis builtin.ends_with(sti, ".tar.bz2") eller builtin.ends_with(sti, ".tbz") { returner "bz2" }
    hvis builtin.ends_with(sti, ".tar.xz") eller builtin.ends_with(sti, ".txz") { returner "xz" }
    returner "tar"
}

funksjon _trygt_namn(namn: tekst) -> bool {
    hvis namn == "" eller lengde(namn) > 100 eller builtin.starts_with(namn, "/") eller
       builtin.index_of(namn, "\\") >= 0 { returner usann }
    la delar = builtin.split(namn, "/")
    la i = 0
    mens i < lengde(delar) {
        hvis delar[i] == "" eller delar[i] == ".." { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon _skriv(ark: ordbok_tekst) -> bool {
    hvis ark["format"] == "gz" { returner tar.tar_skriv_gzip(ark["data"], ark["sti"]) }
    hvis ark["format"] == "tar" { returner tar.tar_skriv(ark["data"], ark["sti"]) }
    returner usann
}

funksjon open(sti: tekst, modus: tekst) -> ordbok_tekst {
    la ark: ordbok_tekst = {}
    ark["sti"] = sti
    ark["modus"] = modus
    ark["format"] = _detect_format(sti)
    ark["open"] = "sann"
    ark["feil"] = ""
    hvis builtin.starts_with(modus, "r") {
        ark["data"] = tar.tar_les_pure(sti)
    } ellers {
        ark["data"] = tar.ny_tar()
    }
    returner ark
}

funksjon close(ark: ordbok_tekst) {
    hvis ark["open"] != "sann" { returner }
    hvis builtin.starts_with(ark["modus"], "w") eller builtin.starts_with(ark["modus"], "a") {
        hvis ikkje _skriv(ark) { ark["feil"] = "format eller skriving er ikkje støtta" }
    }
    ark["open"] = "usann"
}

funksjon _relativ_under(rot: tekst, sti: tekst) -> tekst {
    hvis sti == rot { returner "" }
    hvis builtin.starts_with(sti, rot + "/") {
        returner builtin.slice(sti, lengde(rot) + 1, lengde(sti))
    }
    returner _filnamn(sti)
}

funksjon add(ark: ordbok_tekst, sti: tekst, arcname: tekst) -> bool {
    hvis ark["open"] != "sann" eller builtin.starts_with(ark["modus"], "r") { returner usann }
    hvis ark["format"] != "tar" og ark["format"] != "gz" { returner usann }
    hvis _katalog_finnes(sti) {
        la base = arcname
        hvis base == "" { base = _filnamn(sti) }
        hvis ikkje _trygt_namn(base) { returner usann }
        la filer = _walk(sti)
        la i = 0
        mens i < lengde(filer) {
            la namn = base + "/" + _relativ_under(sti, filer[i])
            hvis ikkje _trygt_namn(namn) { returner usann }
            hvis tar.tar_legg_til_bytes(ark["data"], namn, builtin.fil_les_binær(filer[i])) != 0 {
                returner usann
            }
            la stat = native_fs.native_stat_sti(filer[i])
            hvis stat["status"] == "ok" {
                tar.tar_sett_modus(ark["data"], namn, heltall_fra_tekst(stat["mode"]) & 511)
            }
            i = i + 1
        }
    } ellers {
        hvis ikkje _fil_finnes(sti) { returner usann }
        la namn = arcname
        hvis namn == "" { namn = _filnamn(sti) }
        hvis ikkje _trygt_namn(namn) { returner usann }
        hvis tar.tar_legg_til_bytes(ark["data"], namn, builtin.fil_les_binær(sti)) != 0 {
            returner usann
        }
        la stat = native_fs.native_stat_sti(sti)
        hvis stat["status"] == "ok" {
            tar.tar_sett_modus(ark["data"], namn, heltall_fra_tekst(stat["mode"]) & 511)
        }
    }
    // Samle metadata og byteinnhald i arkivet. close() skriv nøyaktig éin
    // gong; tidlegare vart heile det veksande TAR.GZ-arkivet skrive på nytt
    // for kvar fil, som gjorde releasepakking kvadratisk.
    returner sann
}

funksjon set_mode(ark: ordbok_tekst, arcname: tekst, mode: heiltall) -> bool {
    hvis ark["open"] != "sann" eller builtin.starts_with(ark["modus"], "r") { returner usann }
    returner tar.tar_sett_modus(ark["data"], arcname, mode) == 0
}

funksjon lag_arkiv(ark_sti: tekst, filer: liste_tekst) -> bool {
    la ark = open(ark_sti, "w")
    la i = 0
    mens i < lengde(filer) {
        hvis ikkje add(ark, filer[i], "") {
            close(ark)
            returner usann
        }
        i = i + 1
    }
    close(ark)
    returner ark["feil"] == ""
}

funksjon getnames(ark: ordbok_tekst) -> liste_tekst {
    returner tar.tar_lista(ark["data"])
}

funksjon getmembers(ark: ordbok_tekst) -> liste_tekst {
    la namn = getnames(ark)
    la resultat: liste_tekst = []
    la i = 0
    mens i < lengde(namn) {
        legg_til(resultat, builtin.json_stringify({"namn": namn[i], "type": _gjer_type(namn[i])}))
        i = i + 1
    }
    returner resultat
}

funksjon _gjer_type(namn: tekst) -> tekst {
    hvis builtin.ends_with(namn, "/") { returner "katalog" }
    returner "fil"
}

funksjon extractall(ark: ordbok_tekst, mål_mappe: tekst) -> bool {
    hvis mål_mappe == "" { mål_mappe = "." }
    hvis ark["format"] != "tar" og ark["format"] != "gz" { returner usann }
    hvis ikkje _lag_katalog(mål_mappe) { returner usann }
    returner tar.tar_pakk_ut(ark["sti"], mål_mappe)
}

funksjon extract(ark: ordbok_tekst, membre_namn: tekst, mål_mappe: tekst) -> bool {
    hvis ikkje _trygt_namn(membre_namn) eller ikkje har_nokkel(ark["data"], membre_namn) { returner usann }
    hvis mål_mappe == "" { mål_mappe = "." }
    la mål = mål_mappe + "/" + membre_namn
    hvis ikkje _lag_katalog(_katalog(mål)) { returner usann }
    prøv {
        builtin.fil_skriv_binær(mål, ark["data"][membre_namn])
        returner sann
    } fang (e) { returner usann }
    returner usann
}

funksjon is_tarfile(sti: tekst) -> bool {
    hvis ikkje _fil_finnes(sti) { returner usann }
    hvis _detect_format(sti) == "bz2" eller _detect_format(sti) == "xz" { returner usann }
    prøv { returner lengde(tar.tar_lista(tar.tar_les_pure(sti))) > 0 }
    fang (e) { returner usann }
    returner usann
}

funksjon er_open(ark: ordbok_tekst) -> bool { returner ark["open"] == "sann" }

funksjon kopier_fra(mål_ark: ordbok_tekst, kjelde_ark: ordbok_tekst, membre_namn: tekst) -> bool {
    hvis ikkje _trygt_namn(membre_namn) eller ikkje har_nokkel(kjelde_ark["data"], membre_namn) {
        returner usann
    }
    hvis tar.tar_legg_til_bytes(mål_ark["data"], membre_namn, kjelde_ark["data"][membre_namn]) != 0 {
        returner usann
    }
    returner _skriv(mål_ark)
}

funksjon extractall_enkel(ark_sti: tekst, mål_mappe: tekst) -> bool {
    la ark = open(ark_sti, "r")
    la ok = extractall(ark, mål_mappe)
    close(ark)
    returner ok
}

funksjon create_from_files(ark_sti: tekst, filer: liste_tekst) -> bool {
    returner lag_arkiv(ark_sti, filer)
}

funksjon format_frå_sti(sti: tekst) -> tekst { returner _detect_format(sti) }
