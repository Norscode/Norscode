# Desktop native bridge v1: versjonert, avgrenset adapterkontrakt.
# Ingen påstand om OS-vindauge. Adapteren må implementerast i runtime før bruk.
bruk std.desktop_render som rendering

funksjon ny_bru(plattform: tekst) -> ordbok_tekst {
    la b: ordbok_tekst = {}
    b["protocol"] = "norscode-desktop-native-v1"
    b["platform"] = plattform
    b["connected"] = "usann"
    b["native_verified"] = "usann"
    b["last_sequence"] = "0"
    b["max_batch"] = "256"
    hvis plattform != "macos-arm64" og plattform != "linux-x86_64" og plattform != "windows-x86_64" {
        b["platform"] = "unsupported"
    }
    returner b
}

funksjon klar(b: ordbok_tekst) -> bool {
    returner b["platform"] != "unsupported" og b["connected"] == "sann" og b["native_verified"] == "sann"
}

funksjon planlegg_batch(b: ordbok_tekst, scene: ordbok_tekst, start: heiltall, antall: heiltall) -> ordbok_tekst {
    hvis b["platform"] == "unsupported" { returner {"ok":"usann","error":"unsupported platform"} }
    hvis scene["valid"] != "sann" { returner {"ok":"usann","error":"invalid scene"} }
    la total = heltall_fra_tekst(scene["count"])
    hvis start < 0 eller antall <= 0 eller antall > 256 eller start > total eller antall > total - start {
        returner {"ok":"usann","error":"invalid batch"}
    }
    la p: ordbok_tekst = {}
    p["ok"] = "sann"
    p["protocol"] = b["protocol"]
    p["platform"] = b["platform"]
    p["start"] = tekst_fra_heltall(start)
    p["count"] = tekst_fra_heltall(antall)
    p["width"] = scene["width"]
    p["height"] = scene["height"]
    p["native_executed"] = "usann"
    la i: heiltall = 0
    mens i < antall {
        la c = rendering.kommando(scene, start + i)
        hvis c["ok"] != "sann" { returner {"ok":"usann","error":"invalid command"} }
        la prefix = "command." + tekst_fra_heltall(i) + "."
        p[prefix + "type"] = c["type"]
        p[prefix + "x"] = c["x"]
        p[prefix + "y"] = c["y"]
        p[prefix + "width"] = c["width"]
        p[prefix + "height"] = c["height"]
        p[prefix + "color"] = c["color"]
        p[prefix + "text"] = c["text"]
        i = i + 1
    }
    returner p
}

funksjon status(b: ordbok_tekst) -> ordbok_tekst {
    returner {"protocol":b["protocol"],"platform":b["platform"],"connected":b["connected"],"native_verified":b["native_verified"],"status":"adapter-required"}
}
