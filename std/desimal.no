# desimal.no — Fast-komma desimaltal med vilkårleg stor mantisse
# Python: decimal   Java: java.math.BigDecimal
#
# Verdi = mantisse × 10^(−skala). Representasjonen er ein liste_heltall:
#   liten:  [mantisse, skala]                      når |mantisse| < 2^62
#   stor:   [forteikn, skala, l0, l1, ..., lk]     elles; forteikn er 1/-1 og
#           l0.. er |mantisse| som std.bigint-limbar (base 2^16, little-endian)
# Operasjonane vel den raske 64-bit-vegen når resultatet beviseleg får plass,
# og går elles via std.bigint, så ingenting flyt over (Java BigDecimal-
# semantikk: 12345678901.5 × 98765432101.5 = 1219326311248285321124.25).
# Resultat som får plass igjen, blir normaliserte tilbake til liten form.
#
# Eksempel:
#   3.14  → [314, 2]
#   -0.5  → [-5, 1]
#   1000  → [1000, 0]
#
# Divisjon trunkerer mot null til ønskt presisjon; avrund/til_tekst_n rundar
# halvt opp (bort frå null, RoundingMode.HALF_UP). sqrt/ln/exp/log reknar med
# 6 desimalar og føreset at heiltalsdelen får plass i 64 bit.
# mantisse(d) kastar når mantissen ikkje får plass i heltall; bruk til_tekst.
#
# Bruk:
#   bruk std.desimal som des
#   la a = des.frå_tekst("3.14")
#   la b = des.frå_tekst("1.5")
#   skriv(des.til_tekst(des.pluss(a, b)))   # => "4.64"

bruk std.bigint som bi

# ─── Hjelpefunksjonar ─────────────────────────────────────────────────────────

# 2^62 − 1: største |mantisse| i liten form.
funksjon _maks() -> heltall {
    returner 4611686018427387903
}

funksjon _abs(n: heltall) -> heltall {
    hvis (n < 0) { returner 0 - n }
    returner n
}

funksjon _potens10(n: heltall) -> heltall {
    la r: heltall = 1
    la i: heltall = 0
    mens (i < n) {
        r = r * 10
        i = i + 1
    }
    returner r
}

# |m| < 2^62 (trygg for vidare 64-bit-rekning med kontroll).
funksjon _liten(m: heltall) -> bool {
    returner m < _maks() og m > 0 - _maks()
}

# m × 10^k får plass i liten form.
funksjon _kan_skalere(m: heltall, k: heltall) -> bool {
    hvis (k > 18 eller ikkje _liten(m)) { returner usann }
    la grense: heltall = _maks() / _potens10(k)
    returner m <= grense og m >= 0 - grense
}

# |m| som bigint-limbar (fungerer òg for negative m utan overflyt).
funksjon _limbar_abs(m: heltall) -> liste_heltall {
    la ut: liste_heltall = []
    hvis (m == 0) {
        legg_til(ut, 0)
        returner ut
    }
    la x: heltall = m
    mens (x != 0) {
        la r: heltall = x % 65536
        hvis (r < 0) { r = 0 - r }
        legg_til(ut, r)
        x = x / 65536
    }
    returner ut
}

# 10^k som bigint-limbar.
funksjon _pot10_limbar(k: heltall) -> liste_heltall {
    la r: liste_heltall = [1]
    la i: heltall = k
    mens (i >= 4) {
        r = bi.mul(r, [10000])
        i = i - 4
    }
    hvis (i > 0) { r = bi.mul(r, [_potens10(i)]) }
    returner r
}

funksjon _er_stor(d: liste_heltall) -> bool {
    returner lengde(d) > 2
}

# Forteikn: -1, 0 eller 1.
funksjon _fort(d: liste_heltall) -> heltall {
    hvis (lengde(d) > 2) { returner d[0] }
    hvis (d[0] > 0) { returner 1 }
    hvis (d[0] < 0) { returner -1 }
    returner 0
}

# |mantisse| som bigint-limbar.
funksjon _mag(d: liste_heltall) -> liste_heltall {
    hvis (lengde(d) > 2) { returner builtin.slice(d, 2, lengde(d)) }
    returner _limbar_abs(d[0])
}

# |mantisse| × 10^k som bigint-limbar.
funksjon _mag_skalert(d: liste_heltall, k: heltall) -> liste_heltall {
    la m = _mag(d)
    hvis (k > 0) { m = bi.mul(m, _pot10_limbar(k)) }
    returner m
}

# Bygg desimaltal frå forteikn, limbar og skala; normaliserer til liten form
# når mantissen får plass.
funksjon _lag(fort: heltall, mag: liste_heltall, skala: heltall) -> liste_heltall {
    la m = bi.norm(mag)
    la n: heltall = lengde(m)
    hvis (n == 1 og m[0] == 0) { returner ny(0, skala) }
    hvis (n < 4 eller (n == 4 og m[3] < 16384)) {
        la v: heltall = 0
        la i: heltall = n - 1
        mens (i >= 0) {
            v = v * 65536 + m[i]
            i = i - 1
        }
        hvis (fort < 0) { v = 0 - v }
        returner ny(v, skala)
    }
    la d: liste_heltall = []
    hvis (fort < 0) { legg_til(d, -1) } ellers { legg_til(d, 1) }
    legg_til(d, skala)
    la j: heltall = 0
    mens (j < n) {
        legg_til(d, m[j])
        j = j + 1
    }
    returner d
}

# Forteikn og storleik av a + b der begge storleikane har same skala.
funksjon _signert_sum(fa: heltall, ma: liste_heltall, fb: heltall, mb: liste_heltall) -> liste {
    la ut: liste = []
    hvis (fa == 0) {
        legg_til(ut, fb)
        legg_til(ut, mb)
        returner ut
    }
    hvis (fb == 0 eller fa == fb) {
        legg_til(ut, fa)
        hvis (fb == 0) { legg_til(ut, ma) } ellers { legg_til(ut, bi.add(ma, mb)) }
        returner ut
    }
    la c: heltall = bi.cmp(ma, mb)
    hvis (c == 0) {
        legg_til(ut, 0)
        legg_til(ut, [0])
    } ellers hvis (c > 0) {
        legg_til(ut, fa)
        legg_til(ut, bi.sub(ma, mb))
    } ellers {
        legg_til(ut, fb)
        legg_til(ut, bi.sub(mb, ma))
    }
    returner ut
}

# Storleik (limbar) → desimaltekst.
funksjon _mag_tekst(mag: liste_heltall) -> tekst {
    la x = bi.norm(mag)
    hvis (lengde(x) == 1 og x[0] == 0) { returner "0" }
    la delar: liste_heltall = []
    mens (ikkje (lengde(x) == 1 og x[0] == 0)) {
        la r = bi.divmod(x, [10000])
        la rest = r["r"]
        legg_til(delar, rest[0])
        x = bi.norm(r["q"])
    }
    la ut: tekst = tekst_fra_heltall(delar[lengde(delar) - 1])
    la i: heltall = lengde(delar) - 2
    mens (i >= 0) {
        la del_t: tekst = tekst_fra_heltall(delar[i])
        la lengd: heltall = lengde(builtin.split(del_t, ""))
        mens (lengd < 4) {
            del_t = "0" + del_t
            lengd = lengd + 1
        }
        ut = ut + del_t
        i = i - 1
    }
    returner ut
}

# Desimalsiffer (ASCII) → storleik som limbar, fire siffer om gongen.
funksjon _siffer_til_mag(siffer: liste_tekst) -> liste_heltall {
    la mag: liste_heltall = [0]
    la n: heltall = lengde(siffer)
    la i: heltall = 0
    mens (i < n) {
        la bit: heltall = n - i
        hvis (bit > 4) { bit = 4 }
        la v: heltall = 0
        la k: heltall = 0
        mens (k < bit) {
            v = v * 10 + (builtin.char_code(siffer[i + k]) - 48)
            k = k + 1
        }
        mag = bi.add(bi.mul(mag, [_potens10(bit)]), [v])
        i = i + bit
    }
    returner mag
}

# ─── Konstruksjon ─────────────────────────────────────────────────────────────

# Lag desimaltal frå mantisse og skala
funksjon ny(mantisse: heltall, skala: heltall) -> liste_heltall {
    la d: liste_heltall = []
    legg_til(d, mantisse)
    legg_til(d, skala)
    returner d
}

# Lag frå heltall (skala = 0)
funksjon frå_heltall(n: heltall) -> liste_heltall {
    returner ny(n, 0)
}

# Lag frå tekst, t.d. "3.14", "-0.5", "1000", "123456789012345678901234.5"
funksjon frå_tekst(s: tekst) -> liste_heltall {
    la negativ: bool = tekst_starter_med(s, "-")
    hvis (negativ eller tekst_starter_med(s, "+")) { s = builtin.slice(s, 1, lengde(builtin.split(s, ""))) }

    la delar = builtin.split(s, ".")
    la heiltall_del: tekst = delar[0]
    la desimal_del: tekst = ""
    hvis (lengde(delar) > 1) { desimal_del = delar[1] }

    la heil_siffer = builtin.split(heiltall_del, "")
    la des_siffer = builtin.split(desimal_del, "")
    la skala: heltall = lengde(des_siffer)

    hvis (lengde(heil_siffer) + skala <= 18) {
        la mantisse: heltall = 0
        hvis (lengde(heil_siffer) > 0) { mantisse = builtin.heltall_fra_tekst(heiltall_del) * _potens10(skala) }
        hvis (skala > 0) { mantisse = mantisse + builtin.heltall_fra_tekst(desimal_del) }
        hvis (negativ) { mantisse = 0 - mantisse }
        returner ny(mantisse, skala)
    }

    la alle: liste_tekst = []
    la i: heltall = 0
    mens (i < lengde(heil_siffer)) {
        legg_til(alle, heil_siffer[i])
        i = i + 1
    }
    i = 0
    mens (i < skala) {
        legg_til(alle, des_siffer[i])
        i = i + 1
    }
    la fort: heltall = 1
    hvis (negativ) { fort = -1 }
    returner _lag(fort, _siffer_til_mag(alle), skala)
}

# ─── Henting ──────────────────────────────────────────────────────────────────

# Mantissen som heltall. Kastar når han ikkje får plass (bruk til_tekst).
funksjon mantisse(d: liste_heltall) -> heltall  {
    hvis (_er_stor(d)) { kast "desimal: mantissen er for stor for heltall" }
    returner d[0]
}
funksjon skala(d: liste_heltall) -> heltall  {
    returner d[1]
}

# ─── Aritmetikk ───────────────────────────────────────────────────────────────

funksjon pluss(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    la sa: heltall = a[1]
    la sb: heltall = b[1]
    la s: heltall = sa
    hvis (sb > s) { s = sb }
    hvis (ikkje _er_stor(a) og ikkje _er_stor(b)) {
        la ma: heltall = a[0]
        la mb: heltall = b[0]
        la ok: bool = sann
        hvis (sa < s) {
            ok = _kan_skalere(ma, s - sa)
            hvis (ok) { ma = ma * _potens10(s - sa) }
        }
        hvis (ok og sb < s) {
            ok = _kan_skalere(mb, s - sb)
            hvis (ok) { mb = mb * _potens10(s - sb) }
        }
        # Begge under 2^61 i absoluttverdi: summen får plass.
        la halv: heltall = 2305843009213693952
        hvis (ok og ma < halv og ma > 0 - halv og mb < halv og mb > 0 - halv) {
            returner ny(ma + mb, s)
        }
    }
    la r = _signert_sum(_fort(a), _mag_skalert(a, s - sa), _fort(b), _mag_skalert(b, s - sb))
    returner _lag(r[0], r[1], s)
}

funksjon minus(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    returner pluss(a, neg(b))
}

# Multiplikasjon: mantA × mantB, skala = sA + sB
funksjon gonger(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    la ny_skala: heltall = a[1] + b[1]
    hvis (ikkje _er_stor(a) og ikkje _er_stor(b) og _liten(a[0]) og _liten(b[0])) {
        la x: heltall = a[0]
        la y: heltall = b[0]
        hvis (x == 0 eller y == 0) { returner ny(0, ny_skala) }
        hvis (_abs(x) <= _maks() / _abs(y)) { returner ny(x * y, ny_skala) }
    }
    returner _lag(_fort(a) * _fort(b), bi.mul(_mag(a), _mag(b)), ny_skala)
}

# Divisjon: skaler teljar til mål-presisjon, del på nemnar (trunkerer mot null)
# => (a[0] × 10^(presisjon + b[1] − a[1])) / b[0]
funksjon dele(a: liste_heltall, b: liste_heltall, presisjon: heltall) -> liste_heltall {
    hvis (_fort(b) == 0) { kast "desimal: divisjon med null" }
    la skale_diff: heltall = presisjon + b[1] - a[1]
    la ny_skala: heltall = presisjon
    hvis (skale_diff < 0) { ny_skala = ny_skala + (0 - skale_diff) }
    hvis (ikkje _er_stor(a) og ikkje _er_stor(b) og _liten(b[0])) {
        la teller: heltall = a[0]
        la ok: bool = _liten(teller)
        hvis (ok og skale_diff > 0) {
            ok = _kan_skalere(teller, skale_diff)
            hvis (ok) { teller = teller * _potens10(skale_diff) }
        }
        hvis (ok) { returner ny(teller / b[0], ny_skala) }
    }
    la k: heltall = skale_diff
    hvis (k < 0) { k = 0 }
    la q = bi.divmod(_mag_skalert(a, k), _mag(b))["q"]
    returner _lag(_fort(a) * _fort(b), q, ny_skala)
}

# Dele med standard presisjon 6
funksjon del(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    returner dele(a, b, 6)
}

# ─── Samanlikning ─────────────────────────────────────────────────────────────

# -1, 0 eller 1 (Java compareTo).
funksjon samanlikn(a: liste_heltall, b: liste_heltall) -> heltall {
    la sa: heltall = a[1]
    la sb: heltall = b[1]
    la s: heltall = sa
    hvis (sb > s) { s = sb }
    hvis (ikkje _er_stor(a) og ikkje _er_stor(b) og _kan_skalere(a[0], s - sa) og _kan_skalere(b[0], s - sb)) {
        la x: heltall = a[0] * _potens10(s - sa)
        la y: heltall = b[0] * _potens10(s - sb)
        hvis (x < y) { returner -1 }
        hvis (x > y) { returner 1 }
        returner 0
    }
    la fa: heltall = _fort(a)
    la fb: heltall = _fort(b)
    hvis (fa != fb) {
        hvis (fa < fb) { returner -1 }
        returner 1
    }
    hvis (fa == 0) { returner 0 }
    returner bi.cmp(_mag_skalert(a, s - sa), _mag_skalert(b, s - sb)) * fa
}

funksjon er_lik(a: liste_heltall, b: liste_heltall) -> bool {
    returner samanlikn(a, b) == 0
}

funksjon er_mindre(a: liste_heltall, b: liste_heltall) -> bool {
    returner samanlikn(a, b) < 0
}

funksjon er_større(a: liste_heltall, b: liste_heltall) -> bool {
    returner samanlikn(a, b) > 0
}

funksjon er_negativ(d: liste_heltall) -> bool  {
    returner _fort(d) < 0
}
funksjon er_null(d: liste_heltall) -> bool  {
    returner _fort(d) == 0
}

# ─── Matematiske hjelpefunksjonar ─────────────────────────────────────────────

funksjon abs_des(d: liste_heltall) -> liste_heltall {
    hvis (_er_stor(d)) { returner _lag(1, _mag(d), d[1]) }
    returner ny(_abs(d[0]), d[1])
}

funksjon neg(d: liste_heltall) -> liste_heltall {
    hvis (_er_stor(d)) { returner _lag(0 - d[0], _mag(d), d[1]) }
    returner ny(0 - d[0], d[1])
}

funksjon maks(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    hvis (er_større(a, b)) { returner a }
    returner b
}

funksjon min(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    hvis (er_mindre(a, b)) { returner a }
    returner b
}

# ─── Avrunding ────────────────────────────────────────────────────────────────

# Kvotient og rest av |mantisse| / 10^k: [q-limbar, r-limbar].
funksjon _del_pot10(d: liste_heltall, k: heltall) -> liste {
    la r = bi.divmod(_mag(d), _pot10_limbar(k))
    la ut: liste = []
    legg_til(ut, r["q"])
    legg_til(ut, r["r"])
    returner ut
}

funksjon _er_null_mag(m: liste_heltall) -> bool {
    la x = bi.norm(m)
    returner lengde(x) == 1 og x[0] == 0
}

# Avrund til n desimalplassar (halvt opp, bort frå null)
funksjon avrund(d: liste_heltall, n: heltall) -> liste_heltall {
    la s: heltall = d[1]
    hvis (s <= n) { returner d }
    la diff: heltall = s - n
    hvis (ikkje _er_stor(d) og diff <= 18 og _liten(d[0])) {
        la divisor: heltall = _potens10(diff)
        la runda: heltall = d[0] / divisor
        # Halvt-opp-avrunding: viss rest >= divisor/2, rund opp
        la rest: heltall = _abs(d[0] % divisor)
        la halvt: heltall = divisor / 2
        hvis (rest >= halvt) {
            hvis (d[0] >= 0) { runda = runda + 1 }
            ellers { runda = runda - 1 }
        }
        returner ny(runda, n)
    }
    la qr = _del_pot10(d, diff)
    la q = qr[0]
    la rest2 = qr[1]
    hvis (bi.cmp(bi.add(rest2, rest2), _pot10_limbar(diff)) >= 0) { q = bi.add(q, [1]) }
    returner _lag(_fort(d), q, n)
}

# Trunkér (kast desimalar utover n plassar utan avrunding)
funksjon trunkér(d: liste_heltall, n: heltall) -> liste_heltall {
    la s: heltall = d[1]
    hvis (s <= n) { returner d }
    la diff: heltall = s - n
    hvis (ikkje _er_stor(d) og diff <= 18 og _liten(d[0])) {
        returner ny(d[0] / _potens10(diff), n)
    }
    returner _lag(_fort(d), _del_pot10(d, diff)[0], n)
}

# Golv (avrund ned mot negativ uendeleg)
funksjon golv(d: liste_heltall) -> liste_heltall {
    la s: heltall = d[1]
    hvis (s <= 0) { returner d }
    hvis (ikkje _er_stor(d) og s <= 18 og _liten(d[0])) {
        la divisor: heltall = _potens10(s)
        la heilt: heltall = d[0] / divisor
        la rest: heltall = d[0] % divisor
        # Viss negativ og det er ein rest, trekk frå 1
        hvis (d[0] < 0 og rest != 0) { heilt = heilt - 1 }
        returner ny(heilt, 0)
    }
    la qr = _del_pot10(d, s)
    la q = qr[0]
    hvis (_fort(d) < 0 og ikkje _er_null_mag(qr[1])) { q = bi.add(q, [1]) }
    returner _lag(_fort(d), q, 0)
}

# Tak (avrund opp mot positiv uendeleg)
funksjon tak(d: liste_heltall) -> liste_heltall {
    la s: heltall = d[1]
    hvis (s <= 0) { returner d }
    hvis (ikkje _er_stor(d) og s <= 18 og _liten(d[0])) {
        la divisor: heltall = _potens10(s)
        la heilt: heltall = d[0] / divisor
        la rest: heltall = d[0] % divisor
        hvis (d[0] > 0 og rest != 0) { heilt = heilt + 1 }
        returner ny(heilt, 0)
    }
    la qr = _del_pot10(d, s)
    la q = qr[0]
    hvis (_fort(d) > 0 og ikkje _er_null_mag(qr[1])) { q = bi.add(q, [1]) }
    returner _lag(_fort(d), q, 0)
}

# ─── Konvertering ─────────────────────────────────────────────────────────────

# Til heltall (golv). Kastar når verdien ikkje får plass i heltall.
funksjon til_heltall(d: liste_heltall) -> heltall {
    la h = golv(d)
    hvis (_er_stor(h)) { kast "desimal: verdien er for stor for heltall" }
    returner h[0]
}

# Til tekst med eksakt skala, t.d. [314, 2] → "3.14"
funksjon til_tekst(d: liste_heltall) -> tekst {
    la s: heltall = d[1]
    la negativ: bool = _fort(d) < 0
    la m_tekst: tekst = ""
    hvis (ikkje _er_stor(d) og _liten(d[0])) {
        m_tekst = tekst_fra_heltall(_abs(d[0]))
    } ellers {
        m_tekst = _mag_tekst(_mag(d))
    }
    la t: tekst = ""

    hvis (s <= 0) {
        t = m_tekst
    } ellers {
        la m_len: heltall = lengde(builtin.split(m_tekst, ""))
        hvis (m_len <= s) {
            # Treng leiande nullar etter komma: 0.0314 → skala=4, m=314
            la nullar: tekst = ""
            la mangl: heltall = s - m_len
            la i: heltall = 0
            mens (i < mangl) {
                nullar = nullar + "0"
                i = i + 1
            }
            t = "0." + nullar + m_tekst
        } ellers {
            # Del opp: sett inn punktum
            la heil_del: tekst = builtin.slice(m_tekst, 0, m_len - s)
            la des_del: tekst = builtin.slice(m_tekst, m_len - s, m_len)
            t = heil_del + "." + des_del
        }
    }

    hvis (negativ) { t = "-" + t }
    returner t
}

# Til tekst med fast antal desimalplassar
funksjon til_tekst_n(d: liste_heltall, n: heltall) -> tekst {
    la justert = avrund(d, n)
    la s: heltall = justert[1]
    la grunn: tekst = til_tekst(justert)

    # Legg til nullar viss skala er mindre enn n
    la mangl: heltall = n - s
    hvis (mangl > 0) {
        # (split i staden for tekst_inneholder, som ARM64-AOT ikkje har)
        hvis (lengde(builtin.split(grunn, ".")) < 2) { grunn = grunn + "." }
        la i: heltall = 0
        mens (i < mangl) {
            grunn = grunn + "0"
            i = i + 1
        }
    }
    returner grunn
}

# ─── Modulo ───────────────────────────────────────────────────────────────────

funksjon modulo(a: liste_heltall, b: liste_heltall) -> liste_heltall {
    # a mod b = a - b * golv(a/b)
    la q = golv(dele(a, b, 0))
    returner minus(a, gonger(b, q))
}

# ─── Potens (berre ikkje-negativ heiltalseksponent) ──────────────────────────

funksjon potens(base: liste_heltall, exp: heltall) -> liste_heltall {
    la r = frå_heltall(1)
    la b = base
    la e: heltall = exp
    mens (e > 0) {
        hvis (e % 2 == 1) { r = gonger(r, b) }
        e = e / 2
        hvis (e > 0) { b = gonger(b, b) }
    }
    returner r
}

# ─── Konstante verdiar ────────────────────────────────────────────────────────

funksjon null_des() -> liste_heltall  {
    returner ny(0, 0)
}
funksjon ein() -> liste_heltall  {
    returner ny(1, 0)
}
funksjon ti() -> liste_heltall  {
    returner ny(10, 0)
}
funksjon hundre() -> liste_heltall  {
    returner ny(100, 0)
}

# Pi × 10^6 (god nok presisjon for dei fleste brukstilfelle)
funksjon pi() -> liste_heltall  {
    returner ny(3141593, 6)
}
funksjon e_des() -> liste_heltall  {
    returner ny(2718282, 6)
}

# ─── Samanlikning med null ─────────────────────────────────────────────────────

funksjon forteikn(d: liste_heltall) -> heltall {
    returner _fort(d)
}

# ─── Kvadratrot (Newton-Raphson) ──────────────────────────────────────────────
# Presisjon: 6 desimalplassar
# Algoritme: x_{n+1} = (x_n + S/x_n) / 2

funksjon sqrt(d: liste_heltall) -> liste_heltall {
    hvis (er_negativ(d)) { kast "desimal.sqrt: negativ inndata" }
    hvis (er_null(d)) { returner null_des() }
    la presisjon: heltall = 6

    # Startgjett: bruk heltallsdelen som x_0 × 10^3
    la heil: heltall = til_heltall(d)
    la gjett_mant: heltall = 1000  # start med 1.0
    hvis (heil > 0) {
        # Betre startgjett: isqrt(heil) × 10^3
        la sq: heltall = heil
        la r: heltall = sq
        mens (r * r > sq) { r = (r + sq / r) / 2 }
        gjett_mant = r * 1000
    }
    la x = ny(gjett_mant, 3)

    # Newton-iterasjonar (8 er meir enn nok for presisjon 6)
    la iter: heltall = 0
    mens (iter < 12) {
        # x_ny = (x + d/x) / 2
        la d_over_x = dele(d, x, presisjon + 2)
        la sum_des = pluss(x, d_over_x)
        la to = ny(2, 0)
        x = dele(sum_des, to, presisjon)
        iter = iter + 1
    }
    returner avrund(x, presisjon)
}

# ─── Naturleg logaritme (ln) via Taylor-rekke ────────────────────────────────
# ln(x) ≈ 2 * artanh((x-1)/(x+1)) der artanh(y) = y + y^3/3 + y^5/5 + ...
# Konvergerer raskt for x nær 1. For andre x: ln(x) = n*ln(2) + ln(x/2^n)

funksjon _ln2() -> liste_heltall { returner ny(693147, 6) }  # ln(2) × 10^6

funksjon ln(d: liste_heltall) -> liste_heltall {
    hvis (er_negativ(d) eller er_null(d)) { kast "desimal.ln: argument <= 0" }
    la presisjon: heltall = 6
    la ein_des = ein()
    la to_des = ny(2, 0)

    # Normaliser: finn n slik at d / 2^n er nær 1
    la n: heltall = 0
    la x = d
    mens (er_større(x, ny(2, 0))) {
        x = dele(x, to_des, presisjon)
        n = n + 1
    }
    mens (er_mindre(x, ny(5, 1))) {  # 0.5
        x = gonger(x, to_des)
        n = n - 1
    }

    # artanh-rekke: y = (x-1)/(x+1)
    la teller_des = minus(x, ein_des)
    la nemnar_des = pluss(x, ein_des)
    la y = dele(teller_des, nemnar_des, presisjon + 2)
    la y2 = gonger(y, y)
    la sum_des = y
    la ledd = y
    la k: heltall = 1
    mens (k < 20) {
        ledd = gonger(ledd, y2)
        la k_des = ny(2 * k + 1, 0)
        la bidrag = dele(ledd, k_des, presisjon + 2)
        la ny_sum = pluss(sum_des, bidrag)
        # Sjekk konvergens
        la diff = minus(ny_sum, sum_des)
        la diff_abs = abs_des(diff)
        sum_des = ny_sum
        hvis (er_mindre(diff_abs, ny(1, presisjon + 1))) { k = 20 }
        k = k + 1
    }
    la artanh_2 = gonger(sum_des, to_des)

    # Legg til n * ln(2)
    la n_ln2 = gonger(_ln2(), ny(n, 0))
    returner avrund(pluss(artanh_2, n_ln2), presisjon)
}

# log10 via ln(x) / ln(10)
funksjon log10(d: liste_heltall) -> liste_heltall {
    la ln10 = ny(2302585, 6)  # ln(10) × 10^6
    returner avrund(dele(ln(d), ln10, 6), 6)
}

# log med vilkårleg base
funksjon log(d: liste_heltall, base: liste_heltall) -> liste_heltall {
    returner avrund(dele(ln(d), ln(base), 6), 6)
}

# ─── Eksponentialfunksjon (e^x) via Taylor-rekke ─────────────────────────────
# e^x = 1 + x + x^2/2! + x^3/3! + ...

funksjon exp(d: liste_heltall) -> liste_heltall {
    la presisjon: heltall = 6
    la sum_des = ein()
    la ledd = ein()
    la k: heltall = 1
    mens (k <= 25) {
        la k_des = ny(k, 0)
        ledd = dele(gonger(ledd, d), k_des, presisjon + 2)
        la ny_sum = pluss(sum_des, ledd)
        la diff = abs_des(minus(ny_sum, sum_des))
        sum_des = ny_sum
        hvis (er_mindre(diff, ny(1, presisjon + 1))) { k = 26 }
        k = k + 1
    }
    returner avrund(sum_des, presisjon)
}
