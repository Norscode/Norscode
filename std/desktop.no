# Norscode Desktop v0.1: backend-uavhengig, trygg tilstandsmodell for native IDE.
# Dette opnar ikkje OS-vindauge. Native macOS/Linux/Windows-adapter manglar.
bruk std.runtime_gui som gui

funksjon ny_skrivebordsapp(namn: tekst) -> ordbok_tekst {
    la app = gui.ny_app(namn)
    app["desktop.protocol"] = "norscode-desktop-v1"
    app["desktop.backend"] = "headless"
    app["desktop.native_ready"] = "usann"
    app["desktop.next_event"] = "0"
    app["desktop.clipboard"] = ""
    returner app
}

funksjon opprett_vindu(app: ordbok_tekst, id: tekst, tittel: tekst, breidde: heiltall, hogde: heiltall) -> bool {
    hvis id == "" eller builtin.index_of(id, "|") >= 0 { returner usann }
    hvis har_nokkel(app, "gui." + id + ".type") { returner usann }
    hvis breidde < 320 eller hogde < 200 eller breidde > 16384 eller hogde > 16384 { returner usann }
    returner gui.legg_vindu(app, id, tittel, breidde, hogde)
}

funksjon ny_komponent(app: ordbok_tekst, vindu: tekst, id: tekst, type_namn: tekst, innhald: tekst) -> bool {
    hvis id == "" eller builtin.index_of(id, "|") >= 0 { returner usann }
    hvis har_nokkel(app, "gui." + id + ".type") { returner usann }
    returner gui.legg_komponent(app, vindu, id, type_namn, innhald)
}

funksjon aktiver(app: ordbok_tekst, id: tekst) -> bool {
    returner gui.fokus(app, id)
}

funksjon tastatur_event(app: ordbok_tekst, id: tekst, tast: tekst, modifikatorar: tekst) -> bool {
    hvis tast == "" eller lengde(tast) > 64 eller lengde(modifikatorar) > 64 { returner usann }
    hvis builtin.index_of(tast, "\n") >= 0 { returner usann }
    returner gui.send_event(app, id, "keyboard", tast + "|" + modifikatorar)
}

funksjon mus_event(app: ordbok_tekst, id: tekst, handling: tekst, x: heiltall, y: heiltall) -> bool {
    hvis handling != "down" og handling != "up" og handling != "move" { returner usann }
    hvis x < 0 eller y < 0 eller x > 16384 eller y > 16384 { returner usann }
    returner gui.send_event(app, id, "pointer", handling + "|" + tekst_fra_heltall(x) + "|" + tekst_fra_heltall(y))
}

funksjon tilgjengelegheit(app: ordbok_tekst, vindu: tekst) -> liste<ordbok_tekst> {
    returner gui.accessibility_tree(app, vindu)
}

funksjon render_headless(app: ordbok_tekst, vindu: tekst) -> tekst {
    returner gui.render_html(app, vindu)
}

funksjon plattform_status() -> ordbok_tekst {
    returner {
        "api": "norscode-desktop-v1",
        "tilstand": "headless-kontrakt",
        "native_window": "mangler",
        "native_text": "mangler",
        "native_events": "mangler",
        "native_pty": "mangler",
        "klar_for_swift_fri_studio": "usann"
    }
}
