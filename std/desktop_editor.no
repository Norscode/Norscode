# Desktop editor: avgrenset dokumentmodell med undo/redo, skrevet i Norscode.
bruk std.desktop_text som tekstbuffer

funksjon nytt_dokument(id: tekst, innhald: tekst) -> ordbok_tekst {
    la d = tekstbuffer.ny_buffer(id, innhald)
    d["undo_count"] = "0"
    d["redo_count"] = "0"
    d["history_limit"] = "32"
    returner d
}

funksjon _rydd_redo(d: ordbok_tekst) {
    la n = heltall_fra_tekst(d["redo_count"])
    la i: heiltall = 0
    mens i < n {
        fjern_nokkel(d, "redo." + tekst_fra_heltall(i))
        i = i + 1
    }
    d["redo_count"] = "0"
}

funksjon _dytt(d: ordbok_tekst, prefix: tekst, counter: tekst, verdi: tekst) {
    la n = heltall_fra_tekst(d[counter])
    hvis n >= 32 {
        la i: heiltall = 1
        mens i < 32 {
            d[prefix + tekst_fra_heltall(i - 1)] = d[prefix + tekst_fra_heltall(i)]
            i = i + 1
        }
        n = 31
    }
    d[prefix + tekst_fra_heltall(n)] = verdi
    d[counter] = tekst_fra_heltall(n + 1)
}

funksjon _hent(d: ordbok_tekst, prefix: tekst, counter: tekst) -> tekst {
    la n = heltall_fra_tekst(d[counter]) - 1
    la key = prefix + tekst_fra_heltall(n)
    la verdi = d[key]
    fjern_nokkel(d, key)
    d[counter] = tekst_fra_heltall(n)
    returner verdi
}

funksjon rediger(d: ordbok_tekst, start: heiltall, slutt: heiltall, verdi: tekst) -> bool {
    la gammel = d["text"]
    hvis ikkje tekstbuffer.erstatt_område(d, start, slutt, verdi) { returner usann }
    hvis gammel != d["text"] {
        _dytt(d, "undo.", "undo_count", gammel)
        _rydd_redo(d)
    }
    returner sann
}

funksjon angre(d: ordbok_tekst) -> bool {
    hvis heltall_fra_tekst(d["undo_count"]) <= 0 { returner usann }
    la gammel = d["text"]
    la forrige = _hent(d, "undo.", "undo_count")
    _dytt(d, "redo.", "redo_count", gammel)
    tekstbuffer._ny_revisjon(d, forrige)
    returner sann
}

funksjon gjor_om(d: ordbok_tekst) -> bool {
    hvis heltall_fra_tekst(d["redo_count"]) <= 0 { returner usann }
    la gammel = d["text"]
    la neste = _hent(d, "redo.", "redo_count")
    _dytt(d, "undo.", "undo_count", gammel)
    tekstbuffer._ny_revisjon(d, neste)
    returner sann
}
