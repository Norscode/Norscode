// pwa.no — Progressive Web App frå Norscode: manifest, service worker og
// <head>-taggar, slik at ein Norscode-app kan installerast frå nettlesaren
// («Legg til på Heim-skjerm») med eige ikon, fullskjerm og hurtigbufra skal.
//
// Alt er tekst (JSON og JS), så det fungerer med nc serve utan binærstøtte.
// Ikonet bør vere SVG inntil binære svar er tilgjengelege (PNG krev bytes).
//
// Bruk:
//   GET /manifest.webmanifest -> pwa.manifest_response(...)
//   GET /sw.js                -> pwa.service_worker_response(...)
//   <head>: pwa.head_tags("/manifest.webmanifest", "#04060a", "/assets/ikon.svg")
//   før </body>: pwa.register_inline("/sw.js")   (eller register_script_tag)
//
// Service workeren:
//   - precachar lista ved install og tek over straks (skipWaiting/clients.claim)
//   - GET under cache_prefiks (t.d. /assets/): cache først, nett ved bom
//   - navigasjonar (HTML): nett først, offline_url frå cache ved nettverksfeil
//   - alt anna går rett til nettet (POST, API, webhooks er aldri cacha)
//
// JS-en nyttar berre einskild-hermeteikn ' og ingen omvend skråstrek.

bruk std.web som web

funksjon _json_tekst(s: tekst) -> tekst {
    // Enkel JSON-streng: hermeteikn og linjeskift blir erstatta, ikkje escapa,
    // sidan manifestfelta er korte namn og stiar utan desse teikna.
    la t = builtin.replace(s, "\"", "'")
    t = builtin.replace(t, "\n", " ")
    returner "\"" + t + "\""
}

// Web App Manifest (https://www.w3.org/TR/appmanifest/). display=standalone
// gjev app-kjensle utan adresselinje; ikon_type t.d. "image/svg+xml".
funksjon manifest_json(namn: tekst, kort_namn: tekst, start_url: tekst, scope: tekst, theme_color: tekst, background_color: tekst, ikon_url: tekst, ikon_type: tekst) -> tekst {
    returner "{"
        + "\"name\":" + _json_tekst(namn) + ","
        + "\"short_name\":" + _json_tekst(kort_namn) + ","
        + "\"start_url\":" + _json_tekst(start_url) + ","
        + "\"scope\":" + _json_tekst(scope) + ","
        + "\"display\":\"standalone\","
        + "\"orientation\":\"any\","
        + "\"lang\":\"no\","
        + "\"theme_color\":" + _json_tekst(theme_color) + ","
        + "\"background_color\":" + _json_tekst(background_color) + ","
        + "\"icons\":[{\"src\":" + _json_tekst(ikon_url) + ",\"sizes\":\"any\",\"type\":" + _json_tekst(ikon_type) + ",\"purpose\":\"any\"},"
        + "{\"src\":" + _json_tekst(ikon_url) + ",\"sizes\":\"any\",\"type\":" + _json_tekst(ikon_type) + ",\"purpose\":\"maskable\"}]"
        + "}"
}

funksjon manifest_response(namn: tekst, kort_namn: tekst, start_url: tekst, scope: tekst, theme_color: tekst, background_color: tekst, ikon_url: tekst, ikon_type: tekst) -> ordbok_tekst {
    returner web.response_builder(200, {"content-type": "application/manifest+json; charset=utf-8", "cache-control": "public, max-age=3600"}, manifest_json(namn, kort_namn, start_url, scope, theme_color, background_color, ikon_url, ikon_type))
}

funksjon _js_liste(stiar: liste_tekst) -> tekst {
    la ut = "["
    la i = 0
    mens i < lengde(stiar) {
        hvis i > 0 { ut = ut + "," }
        ut = ut + "'" + builtin.replace(stiar[i], "'", "") + "'"
        i = i + 1
    }
    returner ut + "]"
}

// Service worker. cache_namn bør innehalde ein versjon (t.d. "helpdesk-v12"):
// ny versjon => gamle cachar blir sletta ved activate.
funksjon service_worker_js(cache_namn: tekst, precache: liste_tekst, cache_prefiks: tekst, offline_url: tekst) -> tekst {
    la namn = builtin.replace(cache_namn, "'", "")
    la prefiks = builtin.replace(cache_prefiks, "'", "")
    la offline = builtin.replace(offline_url, "'", "")
    returner "(function(){"
        + "'use strict';"
        + "var CACHE='" + namn + "';"
        + "var PRECACHE=" + _js_liste(precache) + ";"
        + "var PREFIX='" + prefiks + "';"
        + "var OFFLINE='" + offline + "';"
        + "self.addEventListener('install',function(e){"
        + "e.waitUntil(caches.open(CACHE).then(function(c){return c.addAll(PRECACHE);}).then(function(){return self.skipWaiting();}));"
        + "});"
        + "self.addEventListener('activate',function(e){"
        + "e.waitUntil(caches.keys().then(function(keys){return Promise.all(keys.filter(function(k){return k!==CACHE;}).map(function(k){return caches.delete(k);}));}).then(function(){return self.clients.claim();}));"
        + "});"
        + "self.addEventListener('fetch',function(e){"
        + "var req=e.request;"
        + "if(req.method!=='GET')return;"
        + "var url=new URL(req.url);"
        + "if(url.origin!==self.location.origin)return;"
        + "if(PREFIX&&url.pathname.indexOf(PREFIX)===0){"
        + "e.respondWith(caches.match(req).then(function(hit){return hit||fetch(req).then(function(r){if(r&&r.ok){var kopi=r.clone();caches.open(CACHE).then(function(c){c.put(req,kopi);});}return r;});}));"
        + "return;}"
        + "if(req.mode==='navigate'){"
        + "e.respondWith(fetch(req).catch(function(){return OFFLINE?caches.match(OFFLINE):Response.error();}));"
        + "}"
        + "});"
        + "})();"
}

funksjon service_worker_response(cache_namn: tekst, precache: liste_tekst, cache_prefiks: tekst, offline_url: tekst) -> ordbok_tekst {
    returner web.response_builder(200, {"content-type": "application/javascript; charset=utf-8", "cache-control": "no-cache"}, service_worker_js(cache_namn, precache, cache_prefiks, offline_url))
}

// <head>-taggar: manifest, temafarge, iOS-ikon og standalone-modus.
funksjon head_tags(manifest_url: tekst, theme_color: tekst, ikon_url: tekst) -> tekst {
    returner "<link rel=\"manifest\" href=\"" + manifest_url + "\">"
        + "<meta name=\"theme-color\" content=\"" + theme_color + "\">"
        + "<meta name=\"mobile-web-app-capable\" content=\"yes\">"
        + "<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">"
        + "<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">"
        + "<link rel=\"apple-touch-icon\" href=\"" + ikon_url + "\">"
}

// Registrering av service worker (berre over https eller localhost).
funksjon register_js(sw_url: tekst) -> tekst {
    la sti = builtin.replace(sw_url, "'", "")
    returner "if('serviceWorker' in navigator){window.addEventListener('load',function(){navigator.serviceWorker.register('" + sti + "').catch(function(){});});}"
}

funksjon register_inline(sw_url: tekst) -> tekst {
    returner "<script>" + register_js(sw_url) + "</script>"
}

// Respons for ei rute som leverer registreringa som ekstern fil (CSP script-src 'self').
funksjon register_response(sw_url: tekst) -> ordbok_tekst {
    returner web.response_builder(200, {"content-type": "application/javascript; charset=utf-8", "cache-control": "public, max-age=86400"}, register_js(sw_url))
}

funksjon register_script_tag(src: tekst) -> tekst {
    returner "<script src=\"" + src + "\" defer></script>"
}
