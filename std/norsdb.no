// Rein Norscode-standarddatabase.
// SQL- og lagringsmotoren er den same .no-implementasjonen som pure-VM brukar.

bruk selfhost.vm som vm

funksjon _state() { returner vm.norsdb_standard_state() }

// ─── FROM-subquery-støtte (std-lag) ──────────────────────────────────────────
// Detekterer SELECT ... FROM ( <subquery> ) [alias] ..., køyrer den indre
// spørjinga, materialiserer resultatet som ein midlertidig tabell i db-objektet
// og skriv om den ytre spørjinga. Nøsta og fleire subqueries blir handterte
// rekursivt. Dette ligg heilt i std-laget og rører IKKJE self-host-VM-kjernen
// (selfhost/vm.no) — det brukar berre dei eksisterande vm-hjelparane.

funksjon _subq_er_ws(c: tekst) -> boolsk {
    returner c == " " eller c == "\t" eller c == "\n" eller c == "\r"
}

funksjon _subq_er_ord(c: tekst) -> boolsk {
    la l = tekst_til_liten(c)
    returner (l >= "a" og l <= "z") eller (c >= "0" og c <= "9") eller c == "_"
}

funksjon _subq_er_nøkkelord(ord: tekst) -> boolsk {
    la o = tekst_til_liten(ord)
    returner o == "where" eller o == "order" eller o == "group" eller o == "limit" eller
             o == "offset" eller o == "having" eller o == "union" eller o == "join" eller o == "on"
}

// Finn matchande ) for ( på posisjon `start`, respekterer enkle sitat.
funksjon _subq_match_paren(sql: tekst, start: heltall) -> heltall {
    la n = lengde(sql)
    la depth: heltall = 0
    la i: heltall = start
    mens i < n {
        la c = builtin.slice(sql, i, i + 1)
        hvis c == "'" {
            i = i + 1
            mens i < n og builtin.slice(sql, i, i + 1) != "'" { i = i + 1 }
        } ellers hvis c == "(" {
            depth = depth + 1
        } ellers hvis c == ")" {
            depth = depth - 1
            hvis depth == 0 { returner i }
        }
        i = i + 1
    }
    returner -1
}

// Finn første FROM ( ... ) [alias]. Returnerer {"finst","for","inner","etter"}.
funksjon _subq_finn(sql: tekst) -> ordbok_tekst {
    la n = lengde(sql)
    la lav = tekst_til_liten(sql)
    la i: heltall = 0
    mens i < n {
        la c = builtin.slice(sql, i, i + 1)
        hvis c == "'" {
            i = i + 1
            mens i < n og builtin.slice(sql, i, i + 1) != "'" { i = i + 1 }
            i = i + 1
            fortsett
        }
        hvis i + 4 <= n og builtin.slice(lav, i, i + 4) == "from" {
            la før_ok = i == 0 eller ikkje _subq_er_ord(builtin.slice(sql, i - 1, i))
            la etter_ord = i + 4 >= n eller ikkje _subq_er_ord(builtin.slice(sql, i + 4, i + 5))
            hvis før_ok og etter_ord {
                la k = i + 4
                mens k < n og _subq_er_ws(builtin.slice(sql, k, k + 1)) { k = k + 1 }
                hvis k < n og builtin.slice(sql, k, k + 1) == "(" {
                    la close = _subq_match_paren(sql, k)
                    hvis close < 0 { returner {"finst": "usann"} }
                    la inner = builtin.slice(sql, k + 1, close)
                    la e = close + 1
                    mens e < n og _subq_er_ws(builtin.slice(sql, e, e + 1)) { e = e + 1 }
                    // valfri AS
                    hvis e + 2 <= n og tekst_til_liten(builtin.slice(sql, e, e + 2)) == "as"
                         og (e + 2 >= n eller ikkje _subq_er_ord(builtin.slice(sql, e + 2, e + 3))) {
                        e = e + 2
                        mens e < n og _subq_er_ws(builtin.slice(sql, e, e + 1)) { e = e + 1 }
                    }
                    // valfritt alias-ord (ikkje eit klausul-nøkkelord)
                    la ord_start = e
                    mens e < n og _subq_er_ord(builtin.slice(sql, e, e + 1)) { e = e + 1 }
                    hvis e > ord_start {
                        hvis _subq_er_nøkkelord(builtin.slice(sql, ord_start, e)) { e = ord_start }
                    }
                    la res: ordbok_tekst = {}
                    res["finst"] = "sann"
                    res["for"] = builtin.slice(sql, 0, k)
                    res["inner"] = inner
                    res["etter"] = builtin.slice(sql, e, n)
                    returner res
                }
            }
        }
        i = i + 1
    }
    returner {"finst": "usann"}
}

// Projiser inner-rader til inner-select sine kolonnar (SELECT * → tabellschema).
funksjon _subq_projiser(db: ordbok_tekst, inner_parsed: ordbok_tekst, rows) -> ordbok_tekst {
    la sel = inner_parsed["select"]
    la cols: liste<tekst> = []
    hvis lengde(sel) == 1 og vm._vm_db_col_from_token(sel[0]) == "*" {
        la sch = db["_tables"][inner_parsed["table"]]["schema"]
        la s: heltall = 0
        mens s < lengde(sch) { legg_til(cols, sch[s]["namn"]) s = s + 1 }
    } ellers {
        la s: heltall = 0
        mens s < lengde(sel) { legg_til(cols, vm._vm_db_col_from_token(sel[s])) s = s + 1 }
    }
    la schema: liste<ordbok_tekst> = []
    la c: heltall = 0
    mens c < lengde(cols) {
        la co: ordbok_tekst = {}
        co["namn"] = cols[c]
        co["type"] = "TEXT"
        legg_til(schema, co)
        c = c + 1
    }
    la prows: liste<ordbok_tekst> = []
    la r: heltall = 0
    mens r < lengde(rows) {
        la pr: ordbok_tekst = {}
        la cc: heltall = 0
        mens cc < lengde(cols) { pr[cols[cc]] = vm._vm_db_row_val(rows[r], cols[cc]) cc = cc + 1 }
        legg_til(prows, pr)
        r = r + 1
    }
    la ut: ordbok_tekst = {}
    ut["schema"] = schema
    ut["rows"] = prows
    returner ut
}

// Skriv om alle FROM-subqueries til midlertidige tabellar (rekursivt). Nye
// tabellnamn blir lagt til i `temp_navn` for opprydding etterpå.
funksjon _subq_rewrite(db: ordbok_tekst, sql: tekst, temp_navn: liste<tekst>) -> tekst {
    la sq = _subq_finn(sql)
    mens sq["finst"] == "sann" {
        la inner_flat = _subq_rewrite(db, sq["inner"], temp_navn)
        la inner_parsed = vm._vm_db_parse_select(inner_flat)
        hvis lengde(nøkler(inner_parsed)) == 0 eller ikkje har_nokkel(inner_parsed, "table") {
            returner sql
        }
        la rows = vm._vm_db_select_rows_with_meta(db, inner_parsed)
        la proj = _subq_projiser(db, inner_parsed, rows)
        la navn = "__subq_" + tekst_fra_heltall(lengde(temp_navn) + 1) + "__"
        la tbl: ordbok_tekst = {}
        tbl["schema"] = proj["schema"]
        tbl["rows"] = proj["rows"]
        tbl["next_id"] = lengde(proj["rows"]) + 1
        db["_tables"][navn] = tbl
        legg_til(temp_navn, navn)
        sql = sq["for"] + navn + " " + sq["etter"]
        sq = _subq_finn(sql)
    }
    returner sql
}

funksjon _subq_rydd(db: ordbok_tekst, temp_navn: liste<tekst>) -> heltall {
    la t: heltall = 0
    mens t < lengde(temp_navn) {
        hvis har_nokkel(db["_tables"], temp_navn[t]) { fjern_nokkel(db["_tables"], temp_navn[t]) }
        t = t + 1
    }
    returner 0
}

funksjon backend() -> tekst { returner "norsdb-pure-v1" }

funksjon status() -> ordbok_tekst {
    returner {"backend": backend(), "external_runtime": "false", "sqlite": "optional-adapter"}
}

funksjon open(sti: tekst) -> tekst {
    la database = vm._vm_db_load(sti)
    la handle = vm._vm_ny_id("db", _state())
    database["_path"] = sti
    database["_pool"] = ""
    vm._vm_db_set(_state(), handle, database)
    returner handle
}

funksjon close(handle: tekst) -> bool {
    la database = vm._vm_db_get(_state(), handle)
    vm._vm_db_save(database)
    la pool_handle = database["_pool"]
    hvis pool_handle != "" og vm._rt_har_nøkkel(_state()["__vm_pool_store__"], pool_handle) {
        // Nullstill transaksjonstilstand før tilkoblinga går tilbake i poolen, slik
        // at neste pool_acquire får ei rein tilkobling (ikkje hengande _in_tx/_snapshot).
        database["_in_tx"] = usann
        database["_snapshot"] = {}
        la p = _state()["__vm_pool_store__"][pool_handle]
        // Håndhev maks: cache berre opp til maks ledige; elles forkast tilkoblinga.
        hvis lengde(p["idle"]) < p["max"] {
            legg_til(p["idle"], handle)
        } ellers {
            fjern_nokkel(_state()["__vm_db_store__"], handle)
        }
    } ellers {
        fjern_nokkel(_state()["__vm_db_store__"], handle)
    }
    returner sann
}

funksjon execute(handle: tekst, sql: tekst) -> heltall {
    returner vm._vm_db_exec(vm._vm_db_get(_state(), handle), sql)
}

funksjon query_text(handle: tekst, sql: tekst) -> tekst {
    la db = vm._vm_db_get(_state(), handle)
    hvis _subq_finn(sql)["finst"] != "sann" {
        returner vm._vm_db_select_text(db, sql)
    }
    la temp_navn: liste<tekst> = []
    la flat = _subq_rewrite(db, sql, temp_navn)
    la res = vm._vm_db_select_text(db, flat)
    _subq_rydd(db, temp_navn)
    returner res
}

funksjon query_int(handle: tekst, sql: tekst) -> heltall {
    la db = vm._vm_db_get(_state(), handle)
    hvis _subq_finn(sql)["finst"] != "sann" {
        returner vm._vm_db_select_count(db, sql)
    }
    la temp_navn: liste<tekst> = []
    la flat = _subq_rewrite(db, sql, temp_navn)
    la res = vm._vm_db_select_count(db, flat)
    _subq_rydd(db, temp_navn)
    returner res
}

// Siste feilmelding frå execute på denne tilkoblinga ("" om siste setning var gyldig).
// execute() returnerer -1 ved ugyldig SQL; bruk denne for å hente meldinga.
funksjon siste_feil(handle: tekst) -> tekst {
    la database = vm._vm_db_get(_state(), handle)
    hvis vm._rt_har_nøkkel(database, "_siste_feil") {
        returner database["_siste_feil"]
    }
    returner ""
}

// Parameterbundne varianter: ?-plassholdarar bindast trygt til params (escaping),
// som vern mot SQL-injeksjon. Verdiar sendast som tekstliste.
funksjon execute_bundet(handle: tekst, sql: tekst, params: liste<tekst>) -> heltall {
    returner vm._vm_db_exec(vm._vm_db_get(_state(), handle), vm._vm_db_bind_params(sql, params))
}

funksjon query_text_bundet(handle: tekst, sql: tekst, params: liste<tekst>) -> tekst {
    returner vm._vm_db_select_text(vm._vm_db_get(_state(), handle), vm._vm_db_bind_params(sql, params))
}

funksjon query_int_bundet(handle: tekst, sql: tekst, params: liste<tekst>) -> heltall {
    returner vm._vm_db_select_count(vm._vm_db_get(_state(), handle), vm._vm_db_bind_params(sql, params))
}

funksjon migrate(handle: tekst, skript: tekst) -> heltall {
    returner vm._vm_db_migrate(vm._vm_db_get(_state(), handle), skript)
}

funksjon transaction(handle: tekst, skript: tekst) -> heltall {
    la database = vm._vm_db_get(_state(), handle)
    la snapshot = vm._vm_db_clone(database)
    la resultat = vm._vm_db_migrate(database, skript)
    // resultat >= 0 => alle setningar var gyldige (også reine UPDATE/DDL som
    // set inn 0 rader). Berre reelt ugyldige setningar gjev -1 => rull tilbake.
    hvis resultat >= 0 {
        vm._vm_db_save(database)
        returner 1
    }
    _state()["__vm_db_store__"][handle] = snapshot
    returner 0
}

funksjon begin(handle: tekst) -> bool {
    la database = vm._vm_db_get(_state(), handle)
    hvis database["_in_tx"] { returner usann }
    database["_snapshot"] = vm._vm_db_clone(database)
    database["_in_tx"] = sann
    returner sann
}

funksjon commit(handle: tekst) -> bool {
    la database = vm._vm_db_get(_state(), handle)
    hvis ikkje database["_in_tx"] { returner usann }
    database["_snapshot"] = {}
    database["_in_tx"] = usann
    vm._vm_db_save(database)
    returner sann
}

funksjon rollback(handle: tekst) -> bool {
    la database = vm._vm_db_get(_state(), handle)
    hvis ikkje database["_in_tx"] { returner usann }
    la snapshot = database["_snapshot"]
    snapshot["_path"] = database["_path"]
    snapshot["_in_tx"] = usann
    _state()["__vm_db_store__"][handle] = snapshot
    returner sann
}

funksjon ping(handle: tekst) -> bool {
    vm._vm_db_state(_state())
    returner vm._rt_har_nøkkel(_state()["__vm_db_store__"], handle)
}

funksjon backup(handle: tekst, sti: tekst) -> bool {
    hvis sti == "" { returner usann }
    prøv {
        la kopi = vm._vm_db_clone(vm._vm_db_get(_state(), handle))
        kopi["_path"] = sti
        kopi["_in_tx"] = usann
        kopi["_snapshot"] = {}
        kopi["_pool"] = ""
        vm._vm_db_save(kopi)
        returner sann
    } fang (e) {
        returner usann
    }
}

funksjon pool(sti: tekst, maks: heltall) -> tekst {
    vm._vm_db_state(_state())
    la p = {"path": sti, "max": maks, "idle": []}
    la pool_handle = vm._vm_ny_id("pool", _state())
    la conn = vm._vm_ny_id("db", _state())
    la database = vm._vm_db_load(sti)
    database["_path"] = sti
    database["_pool"] = pool_handle
    vm._vm_db_set(_state(), conn, database)
    legg_til(p["idle"], conn)
    _state()["__vm_pool_store__"][pool_handle] = p
    returner pool_handle
}

funksjon pool_acquire(pool_handle: tekst) -> tekst {
    la p = vm._vm_pool_get(_state(), pool_handle)
    hvis lengde(p["idle"]) > 0 {
        la siste = p["idle"][lengde(p["idle"]) - 1]
        fjern_siste(p["idle"])
        returner siste
    }
    la conn = vm._vm_ny_id("db", _state())
    la database = vm._vm_db_load(p["path"])
    database["_path"] = p["path"]
    database["_pool"] = pool_handle
    vm._vm_db_set(_state(), conn, database)
    returner conn
}

funksjon pool_size(pool_handle: tekst) -> heltall {
    returner lengde(vm._vm_pool_get(_state(), pool_handle)["idle"])
}

funksjon pool_close(pool_handle: tekst) -> bool {
    la p = vm._vm_pool_get(_state(), pool_handle)
    la i = 0
    mens i < lengde(p["idle"]) {
        la conn = p["idle"][i]
        hvis vm._rt_har_nøkkel(_state()["__vm_db_store__"], conn) {
            vm._vm_db_save(_state()["__vm_db_store__"][conn])
            fjern_nokkel(_state()["__vm_db_store__"], conn)
        }
        i = i + 1
    }
    fjern_nokkel(_state()["__vm_pool_store__"], pool_handle)
    returner sann
}
