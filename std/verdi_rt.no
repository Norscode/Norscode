// std/verdi_rt.no — R4/F22: automatisk til_tekst og strukturell likskap for strukturar i
// ARM64-AOT (linux-arm64 og macos-arm64). Same semantikk som vm.no (vm_tekst_av, vm_lik) og
// x86-AOT (atoma to_text_struct/struct_eq i native_codegen_v2):
//   * tekst(s) på ein struktur gjev «Namn(felt=verdi, …)»; ein metode «til_tekst» vinn;
//     lister med minst eitt struktur-element blir viste som «[a, b]»; ein syklus gjev
//     «Namn(...)» (kortvarig «__vis__»-merke på ordboka);
//   * == / != mellom to strukturar: same type og felt for felt (djupt); ein metode
//     «er_lik» vinn.
// bygg-native legg modulen til implisitt for ARM64-måla når programmet har strukturar
// (NCB-en har «__struktur__»). Kodegeneratoren kallar struktur_tekst/struktur_lik_ok/
// verdi_lik frå tekst()-/==-stadene når modulen er i bunten. Utan modulen er åtferda den
// gamle («[verdi]» og identitet).

funksjon er_struktur(v) -> boolsk {
    hvis builtin.type(v) != "ordbok" { returner usann }
    returner finnes_nøkkel(v, "__struktur__")
}

// Tekstform for ein struktur eller ei liste med strukturar, elles null (kallaren held
// fram med den vanlege tekstforma).
funksjon struktur_tekst(v) {
    la t = builtin.type(v)
    hvis t == "ordbok" {
        hvis er_struktur(v) { returner vis_struktur(v) }
        returner null
    }
    hvis t == "liste" {
        la har = usann
        la i = 0
        mens i < lengde(v) {
            hvis er_struktur(v[i]) {
                har = sann
                bryt
            }
            i = i + 1
        }
        hvis ikkje har { returner null }
        la delar = []
        i = 0
        mens i < lengde(v) {
            legg_til(delar, vis_verdi(v[i]))
            i = i + 1
        }
        returner "[" + builtin.join(delar, ", ") + "]"
    }
    returner null
}

funksjon vis_verdi(v) -> tekst {
    hvis er_struktur(v) { returner vis_struktur(v) }
    returner tekst(v)
}

funksjon vis_struktur(v) -> tekst {
    la namn = tekst(v["__type__"])
    la hook = tekst(v["__struktur__"]) + ".til_tekst"
    hvis builtin.host_finst(hook) { returner tekst(builtin.host_kall(hook, [v])) }
    hvis finnes_nøkkel(v, "__vis__") { returner namn + "(...)" }
    la nk = nøkler(v)
    la delar = []
    v["__vis__"] = 1
    la i = 0
    mens i < lengde(nk) {
        legg_til(delar, tekst(nk[i]) + "=" + vis_verdi(v[nk[i]]))
        i = i + 1
    }
    fjern_nokkel(v, "__vis__")
    returner namn + "(" + builtin.join(delar, ", ") + ")"
}

// 0 = ikkje to strukturar (kallaren samanliknar på identitet som før), 1 = ulike, 2 = like.
funksjon struktur_lik_ok(a, b) -> heiltall {
    hvis ikkje (er_struktur(a) og er_struktur(b)) { returner 0 }
    hvis tekst(a["__struktur__"]) != tekst(b["__struktur__"]) { returner 1 }
    la hook = tekst(a["__struktur__"]) + ".er_lik"
    hvis builtin.host_finst(hook) {
        hvis builtin.host_kall(hook, [a, b]) == sann { returner 2 }
        returner 1
    }
    la nk = nøkler(a)
    hvis lengde(nk) != lengde(nøkler(b)) { returner 1 }
    la i = 0
    mens i < lengde(nk) {
        hvis ikkje finnes_nøkkel(b, nk[i]) { returner 1 }
        hvis ikkje verdi_lik(a[nk[i]], b[nk[i]]) { returner 1 }
        i = i + 1
    }
    returner 2
}

// Djup likskap for liste == liste (element for element) og strukturar; elles ==.
funksjon verdi_lik(a, b) -> boolsk {
    la ta = builtin.type(a)
    la tb = builtin.type(b)
    hvis ta == "liste" og tb == "liste" {
        hvis lengde(a) != lengde(b) { returner usann }
        la i = 0
        mens i < lengde(a) {
            hvis ikkje verdi_lik(a[i], b[i]) { returner usann }
            i = i + 1
        }
        returner sann
    }
    hvis er_struktur(a) og er_struktur(b) { returner struktur_lik_ok(a, b) == 2 }
    returner a == b
}
