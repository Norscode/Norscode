# Webhjelpere — pure Norscode implementasjon
# Brukar NCB route_handlers metadata frå builtin.ncb_route_handlers()

# ─── Request context ────────────────────────────────────────────────────────

funksjon _ascii_upper(verdi: tekst) -> tekst {
    la ut: tekst = ""
    la i: heiltall = 0
    mens i < lengde(verdi) {
        la c: tekst = builtin.slice(verdi, i, i + 1)
        la code = builtin.char_code(c)
        hvis code >= 97 og code <= 122 {
            ut = ut + builtin.chr(code - 32)
        } ellers {
            ut = ut + c
        }
        i = i + 1
    }
    returner ut
}

funksjon request_context(metode: tekst, sti: tekst, query: ordbok_tekst, headers: ordbok_tekst, body: tekst) -> ordbok_tekst {
    la ctx: ordbok_tekst = {}
    // Bevar kallaren sin metode-kasus (test_web_request_response ventar "get" som
    // gjeve inn). Ruting er kasus-uavhengig: handle_request _ascii_upper-ar
    // ctx["__method__"] internt før samanlikning, so store/små spelar inga rolle der.
    ctx["__method__"] = metode
    ctx["__path__"]   = sti
    ctx["__query__"]  = query
    ctx["__headers__"] = headers
    ctx["__body__"]   = body
    ctx["__params__"] = {}
    returner ctx
}

funksjon request_method(ctx: ordbok_tekst) -> tekst {
    returner ctx["__method__"]
}

funksjon request_path(ctx: ordbok_tekst) -> tekst {
    returner ctx["__path__"]
}

funksjon request_query(ctx: ordbok_tekst) -> ordbok_tekst {
    returner ctx["__query__"]
}

funksjon request_headers(ctx: ordbok_tekst) -> ordbok_tekst {
    returner ctx["__headers__"]
}

funksjon request_body(ctx: ordbok_tekst) -> tekst {
    returner ctx["__body__"]
}

funksjon request_params(ctx: ordbok_tekst) -> ordbok_tekst {
    returner ctx["__params__"]
}

funksjon request_param(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    la p = ctx["__params__"]
    prøv {
        returner "" + tekst(p[nøkkel])
    } fang (e) {
        returner ""
    }
    returner ""
}

funksjon request_param_int(ctx: ordbok_tekst, nøkkel: tekst) -> heltall {
    returner heltall_fra_tekst(request_param(ctx, nøkkel))
}

funksjon request_query_param(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    la q = ctx["__query__"]
    hvis (finnes_nøkkel(q, nøkkel)) { returner tekst(q[nøkkel]) }
    returner ""
}

funksjon request_query_required(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    la v = request_query_param(ctx, nøkkel)
    hvis (v == "") { kast "ValideringsFeil: manglande påkrevd query-felt '" + nøkkel + "'" }
    returner v
}

funksjon request_query_int(ctx: ordbok_tekst, nøkkel: tekst) -> heltall {
    returner heltall_fra_tekst(request_query_param(ctx, nøkkel))
}

// ─── Fase 0.6: tolerant parameter-tolking (utan reseed) ──────────────────────
// FastAPI/Starlette tolkar query-parametrar mildt. VM-speilet
// builtin.web.request_query_bool kjende berre true/sann; desse std-funksjonane
// skuggar det for web.-kall og dekkjer heile settet (FA-016/017/018/051).

// Kasus-uavhengig boolsk tolking. sanne: 1/true/sann/yes/ja/on.
// usanne: 0/false/usann/no/nei/off. Alt anna → fallback.
funksjon _tolk_bool(verdi: tekst, fallback: boolsk) -> boolsk {
    la v = _ascii_lower(builtin.trim(verdi))
    hvis v == "1" eller v == "true" eller v == "sann" eller v == "yes" eller v == "ja" eller v == "on" { returner sann }
    hvis v == "0" eller v == "false" eller v == "usann" eller v == "no" eller v == "nei" eller v == "off" { returner usann }
    returner fallback
}

// Sjekk om teksten er eit gyldig desimaltal (valfritt forteikn, siffer, éin
// desimalpunkt). builtin.desimaltall gjev stilt 0 på ugyldig inndata, so vi må
// validere sjølve for å kunne skilje "0" frå feil.
funksjon _er_desimal(verdi: tekst) -> boolsk {
    la s = builtin.trim(verdi)
    la n = lengde(s)
    hvis n == 0 { returner usann }
    la i: heiltall = 0
    la c0 = builtin.slice(s, 0, 1)
    hvis c0 == "-" eller c0 == "+" { i = 1 }
    la siffer: heiltall = 0
    la punkt: heiltall = 0
    mens i < n {
        la c = builtin.slice(s, i, i + 1)
        la code = builtin.char_code(c)
        hvis code >= 48 og code <= 57 { siffer = siffer + 1 }
        ellers hvis c == "." { punkt = punkt + 1 }
        ellers { returner usann }
        i = i + 1
    }
    returner siffer > 0 og punkt <= 1
}

// Tolerant boolsk query-parameter. Manglande/ukjend verdi → usann.
funksjon request_query_bool(ctx: ordbok_tekst, nøkkel: tekst) -> boolsk {
    returner _tolk_bool(request_query_param(ctx, nøkkel), usann)
}

// Boolsk query-parameter med eksplisitt standardverdi.
funksjon request_query_bool_or(ctx: ordbok_tekst, nøkkel: tekst, fallback: boolsk) -> boolsk {
    la v = request_query_param(ctx, nøkkel)
    hvis v == "" { returner fallback }
    returner _tolk_bool(v, fallback)
}

// Desimaltal-query. Kastar ValideringsFeil på ugyldig (som request_query_int).
funksjon request_query_float(ctx: ordbok_tekst, nøkkel: tekst) -> desimaltall {
    la v = request_query_param(ctx, nøkkel)
    hvis ikkje _er_desimal(v) {
        kast "ValideringsFeil: ugyldig desimaltal for query-felt '" + nøkkel + "': " + v
    }
    returner builtin.desimaltall(builtin.trim(v))
}

// Desimaltal-query med standardverdi. Manglande/ugyldig → fallback.
funksjon request_query_float_or(ctx: ordbok_tekst, nøkkel: tekst, fallback: desimaltall) -> desimaltall {
    la v = request_query_param(ctx, nøkkel)
    hvis ikkje _er_desimal(v) { returner fallback }
    returner builtin.desimaltall(builtin.trim(v))
}

// Heiltals-query med standardverdi. Manglande/ugyldig → fallback (ingen 500).
funksjon request_query_int_or(ctx: ordbok_tekst, nøkkel: tekst, fallback: heltall) -> heltall {
    la v = request_query_param(ctx, nøkkel)
    hvis v == "" { returner fallback }
    prøv {
        returner heltall_fra_tekst(builtin.trim(v))
    } fang (e) {
        returner fallback
    }
    returner fallback
}

// Rå query-verdi som kommadelt liste (FA-018). Under nc serve kollapsar
// parse_query gjentekne nøklar til siste verdi, so ekte repeterte nøklar
// (?x=1&x=2) krev at rå query-streng blir teke vare på i ctx — det er ei
// reseed-endring i selfhost/nc_main.no. Inntil då støttar denne hjelparen
// kommalister (?x=1,2,3), som er den vanlege no-reseed-konvensjonen.
funksjon request_query_list(ctx: ordbok_tekst, nøkkel: tekst) -> liste<tekst> {
    la v = request_query_param(ctx, nøkkel)
    hvis v == "" { returner [] }
    la deler = builtin.split(v, ",")
    la ut: liste<tekst> = []
    la i: heiltall = 0
    mens i < lengde(deler) {
        la d = builtin.trim(deler[i])
        hvis d != "" { legg_til(ut, d) }
        i = i + 1
    }
    returner ut
}

// ─── Fase 0.6: application/x-www-form-urlencoded ─────────────────────────────

// Dekod éin form-/URL-komponent: %XX → byte, + → mellomrom.
funksjon _url_decode_komponent(verdi: tekst) -> tekst {
    la n = lengde(verdi)
    la ut: tekst = ""
    la i: heiltall = 0
    mens i < n {
        la c = builtin.slice(verdi, i, i + 1)
        hvis c == "%" og i + 2 < n {
            la h1 = builtin.slice(verdi, i + 1, i + 2)
            la h2 = builtin.slice(verdi, i + 2, i + 3)
            la k1 = _hex_siffer_verdi(h1)
            la k2 = _hex_siffer_verdi(h2)
            hvis k1 >= 0 og k2 >= 0 {
                ut = ut + builtin.chr(k1 * 16 + k2)
                i = i + 3
            } ellers {
                ut = ut + c
                i = i + 1
            }
        } ellers hvis c == "+" {
            ut = ut + " "
            i = i + 1
        } ellers {
            ut = ut + c
            i = i + 1
        }
    }
    returner ut
}

// Verdien til eitt hex-siffer, eller -1 om det ikkje er hex.
funksjon _hex_siffer_verdi(c: tekst) -> heiltall {
    la code = builtin.char_code(c)
    hvis code >= 48 og code <= 57 { returner code - 48 }
    hvis code >= 97 og code <= 102 { returner code - 87 }
    hvis code >= 65 og code <= 70 { returner code - 55 }
    returner -1
}

funksjon _content_type_er_form(ctx: ordbok_tekst) -> boolsk {
    la ct = request_header(ctx, "content-type")
    hvis ct == "" { returner usann }
    la base = ct
    la semi = builtin.index_of(ct, ";")
    hvis semi >= 0 { base = builtin.slice(ct, 0, semi) }
    base = _ascii_lower(builtin.trim(base))
    returner base == "application/x-www-form-urlencoded"
}

// Parse urlencoded-kropp til felt. Content-Type må vere
// application/x-www-form-urlencoded, elles tom ordbok. Siste verdi vinn per
// felt (FastAPI Form()-semantikk for enkeltfelt); bruk request_form_list for
// alle verdiane.
funksjon request_form(ctx: ordbok_tekst) -> ordbok_tekst {
    la felt: ordbok_tekst = {}
    hvis ikkje _content_type_er_form(ctx) { returner felt }
    la body = request_body(ctx)
    hvis body == "" { returner felt }
    la par = builtin.split(body, "&")
    la i: heiltall = 0
    mens i < lengde(par) {
        la p = par[i]
        hvis p != "" {
            la eq = builtin.index_of(p, "=")
            hvis eq >= 0 {
                la k = _url_decode_komponent(builtin.slice(p, 0, eq))
                la v = _url_decode_komponent(builtin.slice(p, eq + 1, lengde(p)))
                felt[k] = v
            } ellers {
                felt[_url_decode_komponent(p)] = ""
            }
        }
        i = i + 1
    }
    returner felt
}

funksjon request_form_field(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    la f = request_form(ctx)
    hvis finnes_nøkkel(f, nøkkel) { returner tekst(f[nøkkel]) }
    returner ""
}

funksjon request_form_field_or(ctx: ordbok_tekst, nøkkel: tekst, fallback: tekst) -> tekst {
    la v = request_form_field(ctx, nøkkel)
    hvis v == "" { returner fallback }
    returner v
}

// Alle verdiane til eit felt (fleirverdifelt a=1&a=2 → ["1","2"]).
funksjon request_form_list(ctx: ordbok_tekst, nøkkel: tekst) -> liste<tekst> {
    la ut: liste<tekst> = []
    hvis ikkje _content_type_er_form(ctx) { returner ut }
    la body = request_body(ctx)
    hvis body == "" { returner ut }
    la par = builtin.split(body, "&")
    la i: heiltall = 0
    mens i < lengde(par) {
        la p = par[i]
        hvis p != "" {
            la eq = builtin.index_of(p, "=")
            la k = ""
            la v = ""
            hvis eq >= 0 {
                k = _url_decode_komponent(builtin.slice(p, 0, eq))
                v = _url_decode_komponent(builtin.slice(p, eq + 1, lengde(p)))
            } ellers {
                k = _url_decode_komponent(p)
            }
            hvis k == nøkkel { legg_til(ut, v) }
        }
        i = i + 1
    }
    returner ut
}

// HTTP-headernamn skil ikkje mellom store og små bokstavar (RFC 9110 §5.1).
// nc serve legg headerane i ctx slik klienten sende dei («Cookie», «If-None-Match»),
// web.request_context og HTTP/2-proxyar gjev små bokstavar: slå opp direkte først,
// og skann nøklane kasus-uavhengig berre når det ikkje treffer.
funksjon request_header(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    hvis ctx == null eller ikkje finnes_nøkkel(ctx, "__headers__") { returner "" }
    la h = ctx["__headers__"]
    hvis h == null { returner "" }
    la low = tekst_til_liten(nøkkel)
    hvis (finnes_nøkkel(h, low)) { returner h[low] }
    hvis (finnes_nøkkel(h, nøkkel)) { returner h[nøkkel] }
    la ks = nøkler(h)
    la i: heiltall = 0
    mens i < lengde(ks) {
        la k = tekst(ks[i])
        // Berre nøklar med rett lengd blir lowercasa: namnet er klientstyrt, og
        // tekst_til_liten heng på tekstar over 256 byte på Linux-x86-stage0.
        hvis lengde(k) == lengde(low) og tekst_til_liten(k) == low { returner h[k] }
        i = i + 1
    }
    returner ""
}

funksjon request_id(ctx: ordbok_tekst) -> tekst {
    la h = request_header(ctx, "x-request-id")
    hvis (h != "") { returner h }
    returner ncb_next_request_id()
}

funksjon request_cookie(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    la cookie_hdr = request_header(ctx, "cookie")
    la deler = builtin.split(cookie_hdr, ";")
    la i: heltall = 0
    mens i < lengde(deler) {
        la del = builtin.trim(deler[i])
        la eq = builtin.index_of(del, "=")
        hvis eq > 0 {
            la k = builtin.trim(builtin.slice(del, 0, eq))
            la v = builtin.trim(builtin.slice(del, eq + 1, lengde(del)))
            hvis k == nøkkel { returner v }
        }
        i = i + 1
    }
    returner ""
}

funksjon request_cookie_or(ctx: ordbok_tekst, nøkkel: tekst, fallback: tekst) -> tekst {
    la v = request_cookie(ctx, nøkkel)
    hvis v == "" { returner fallback }
    returner v
}

funksjon auth_header(ctx: ordbok_tekst) -> tekst {
    returner request_header(ctx, "authorization")
}

funksjon bearer_token(ctx: ordbok_tekst) -> tekst {
    la h = auth_header(ctx)
    hvis (tekst_starter_med(h, "Bearer ")) { returner builtin.slice(h, 7, lengde(h)) }
    returner ""
}

// TRYGGLEIK (Fase 0.5b): konstant-tid-samanlikning for token/hemmeleg. Eit vanleg
// `==` på tekst kan avslutte ved første ulike byte og lekke lengd/innhald via tid.
// Her går vi alltid gjennom heile lengda og akkumulerer skilnaden.
funksjon _konstant_tid_lik(a: tekst, b: tekst) -> boolsk {
    prøv { returner builtin.constant_time_compare(a, b) } fang (e) { }
    la la_lengd = lengde(a)
    la lb_lengd = lengde(b)
    // Bland inn lengde-skilnad utan å returnere tidleg.
    la skilnad: heltall = la_lengd - lb_lengd
    hvis skilnad < 0 { skilnad = 0 - skilnad }
    la n = la_lengd
    hvis lb_lengd > n { n = lb_lengd }
    la i: heltall = 0
    mens i < n {
        la ca: heltall = 0
        hvis i < la_lengd { ca = builtin.char_code(a[i]) }
        la cb: heltall = 0
        hvis i < lb_lengd { cb = builtin.char_code(b[i]) }
        la d = ca - cb
        skilnad = skilnad + (d * d)
        i = i + 1
    }
    returner skilnad == 0
}

funksjon konstant_tid_lik(a: tekst, b: tekst) -> boolsk {
    returner _konstant_tid_lik(a, b)
}

funksjon require_bearer(ctx: ordbok_tekst, expected: tekst) -> boolsk {
    returner _konstant_tid_lik(bearer_token(ctx), expected)
}

funksjon _csv_til_liste(csv: tekst) -> liste<tekst> {
    la deler = builtin.split(csv, ",")
    la r: liste<tekst> = []
    la i: heltall = 0
    mens i < lengde(deler) {
        la v = builtin.trim(deler[i])
        hvis v != "" { legg_til(r, v) }
        i = i + 1
    }
    returner r
}

// TRYGGLEIK (Fase 0.5a): roller og rettar kjem BERRE frå klarerte, server-sette
// felt i ctx — aldri frå klient-sende headerar som X-Roles/X-Permissions. Ein
// klient kan setje kva header som helst, so å stole på dei gav rolle-forfalsking
// (send «X-Roles: admin» → full tilgang). Autentiseringslaget (sesjon/JWT/api-nøkkel)
// må kalle sett_roller/sett_rettar etter at identiteten er verifisert. Standard er
// «ingen roller» = nekt, som er trygt.
funksjon _roles_fra_ctx(ctx: ordbok_tekst) -> liste<tekst> {
    la roller_str: tekst = ""
    hvis finnes_nøkkel(ctx, "__roller__") { roller_str = tekst(ctx["__roller__"]) }
    returner _csv_til_liste(roller_str)
}

funksjon _perms_fra_ctx(ctx: ordbok_tekst) -> liste<tekst> {
    la perms_str: tekst = ""
    hvis finnes_nøkkel(ctx, "__rettar__") { perms_str = tekst(ctx["__rettar__"]) }
    returner _csv_til_liste(perms_str)
}

// Server-side oppsett av verifiserte roller/rettar. Kall desse frå autentiserings-
// eller dependency-laget ETTER at identiteten er stadfesta. roller/rettar er ein
// komma-separert streng (t.d. "admin,editor").
funksjon sett_roller(ctx: ordbok_tekst, roller: tekst) -> ordbok_tekst {
    ctx["__roller__"] = roller
    returner ctx
}

funksjon sett_rettar(ctx: ordbok_tekst, rettar: tekst) -> ordbok_tekst {
    ctx["__rettar__"] = rettar
    returner ctx
}

funksjon gje_rolle(ctx: ordbok_tekst, rolle: tekst) -> ordbok_tekst {
    la noverande: tekst = ""
    hvis finnes_nøkkel(ctx, "__roller__") { noverande = tekst(ctx["__roller__"]) }
    hvis noverande == "" { ctx["__roller__"] = rolle }
    ellers { ctx["__roller__"] = noverande + "," + rolle }
    returner ctx
}

// EKSPLISITT opt-in: promoter X-Role(s)/X-Permissions-headerane til klarerte felt.
// Kall denne BERRE når requesten kjem gjennom ein klarert proxy som set desse
// headerane etter autentisering (og strippar klient-sende variantar), eller i
// demo/testkontekst. Dette er ikkje trygt mot direkte klientar på `nc serve`.
funksjon stol_på_rolle_headerar(ctx: ordbok_tekst) -> ordbok_tekst {
    la h = ctx["__headers__"]
    la roller_str: tekst = ""
    hvis finnes_nøkkel(h, "x-roles") { roller_str = h["x-roles"] }
    ellers hvis finnes_nøkkel(h, "x-role") { roller_str = h["x-role"] }
    hvis roller_str != "" { ctx["__roller__"] = roller_str }
    hvis finnes_nøkkel(h, "x-permissions") { ctx["__rettar__"] = h["x-permissions"] }
    returner ctx
}

funksjon role(ctx: ordbok_tekst) -> tekst {
    la roles = _roles_fra_ctx(ctx)
    hvis lengde(roles) > 0 { returner roles[0] }
    returner ""
}

funksjon has_role(ctx: ordbok_tekst, rolle: tekst) -> boolsk {
    la roles = _roles_fra_ctx(ctx)
    la i: heltall = 0
    mens i < lengde(roles) {
        hvis tekst(roles[i]) == rolle { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon require_role(ctx: ordbok_tekst, rolle: tekst) -> boolsk {
    returner has_role(ctx, rolle)
}

funksjon has_permission(ctx: ordbok_tekst, rettighet: tekst) -> boolsk {
    la perms = _perms_fra_ctx(ctx)
    la i: heltall = 0
    mens i < lengde(perms) {
        hvis tekst(perms[i]) == rettighet { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon require_permission(ctx: ordbok_tekst, rettighet: tekst) -> boolsk {
    returner has_permission(ctx, rettighet)
}

# ─── Fase 0.3: streng JSON-validator i rein Norscode ─────────────────────────────
# Den native builtin.json_parse_raw kan krasje (SIGSEGV) på feilforma JSON, so ein
# enkelt POST med «{…» eller «{"a":1,}» kunne ta ned `nc serve` (DoS). Vi validerer
# difor velforma JSON i rein Norscode FØR vi sender kroppen til den native parseren.
# Validatoren sjekkar balanserte {}/[], gyldige strengar/escapes, gyldige tal,
# ingen hengande komma og ingen søppel etter verdien. Djupnevakt hindrar at djupt
# nøsta input kan stakk-overflø validatoren sjølv.
#
# (Den VARIGE fiksen er native parser + aritetskontroll i vm.no — det er reseed,
# Fase 2. Her er berre std-vakta.)

funksjon _json_kode(s: tekst, i: heiltall) -> heiltall {
    hvis i < 0 { returner -1 }
    hvis i >= lengde(s) { returner -1 }
    returner builtin.char_code(builtin.slice(s, i, i + 1))
}

funksjon _json_er_siffer(c: heiltall) -> boolsk {
    returner c >= 48 og c <= 57
}

funksjon _json_er_hex(c: heiltall) -> boolsk {
    hvis c >= 48 og c <= 57 { returner sann }
    hvis c >= 97 og c <= 102 { returner sann }
    hvis c >= 65 og c <= 70 { returner sann }
    returner usann
}

funksjon _json_hopp_ws(s: tekst, i: heiltall) -> heiltall {
    la j = i
    mens sann {
        la c = _json_kode(s, j)
        hvis c == 32 eller c == 9 eller c == 10 eller c == 13 { j = j + 1 }
        ellers { returner j }
    }
    returner j
}

funksjon _json_streng(s: tekst, i: heiltall) -> heiltall {
    // i peikar på opningssitat
    la j = i + 1
    mens sann {
        la c = _json_kode(s, j)
        hvis c == -1 { returner -1 }        // uavslutta
        hvis c == 34 { returner j + 1 }     // avsluttande "
        hvis c == 92 {                      // backslash
            j = j + 1
            la e = _json_kode(s, j)
            hvis e == 34 eller e == 92 eller e == 47 eller e == 98 eller e == 102 eller e == 110 eller e == 114 eller e == 116 {
                j = j + 1
            } ellers hvis e == 117 {        // \uXXXX
                j = j + 1
                la h = 0
                mens h < 4 {
                    hvis ikkje _json_er_hex(_json_kode(s, j)) { returner -1 }
                    j = j + 1
                    h = h + 1
                }
            } ellers {
                returner -1
            }
        } ellers hvis c < 32 {              // rå kontrollteikn er ulovleg i JSON-streng
            returner -1
        } ellers {
            j = j + 1
        }
    }
    returner -1
}

funksjon _json_tal(s: tekst, i: heiltall) -> heiltall {
    la j = i
    hvis _json_kode(s, j) == 45 { j = j + 1 }   // valfri minus
    la c = _json_kode(s, j)
    hvis c == 48 {
        j = j + 1
    } ellers hvis c >= 49 og c <= 57 {
        j = j + 1
        mens _json_er_siffer(_json_kode(s, j)) { j = j + 1 }
    } ellers {
        returner -1
    }
    // brøk
    hvis _json_kode(s, j) == 46 {
        j = j + 1
        hvis ikkje _json_er_siffer(_json_kode(s, j)) { returner -1 }
        mens _json_er_siffer(_json_kode(s, j)) { j = j + 1 }
    }
    // eksponent
    la e = _json_kode(s, j)
    hvis e == 101 eller e == 69 {
        j = j + 1
        la sgn = _json_kode(s, j)
        hvis sgn == 43 eller sgn == 45 { j = j + 1 }
        hvis ikkje _json_er_siffer(_json_kode(s, j)) { returner -1 }
        mens _json_er_siffer(_json_kode(s, j)) { j = j + 1 }
    }
    returner j
}

funksjon _json_literal(s: tekst, i: heiltall, lit: tekst) -> heiltall {
    la n = lengde(lit)
    hvis i + n > lengde(s) { returner -1 }
    hvis builtin.slice(s, i, i + n) == lit { returner i + n }
    returner -1
}

funksjon _json_objekt(s: tekst, i: heiltall, dybde: heiltall) -> heiltall {
    la j = _json_hopp_ws(s, i + 1)
    hvis _json_kode(s, j) == 125 { returner j + 1 }   // tom {}
    mens sann {
        j = _json_hopp_ws(s, j)
        hvis _json_kode(s, j) != 34 { returner -1 }   // nøkkel må vere streng
        j = _json_streng(s, j)
        hvis j < 0 { returner -1 }
        j = _json_hopp_ws(s, j)
        hvis _json_kode(s, j) != 58 { returner -1 }   // :
        j = j + 1
        j = _json_verdi(s, j, dybde + 1)
        hvis j < 0 { returner -1 }
        j = _json_hopp_ws(s, j)
        la c = _json_kode(s, j)
        hvis c == 44 {
            j = _json_hopp_ws(s, j + 1)
            hvis _json_kode(s, j) == 125 { returner -1 }   // hengande komma
        } ellers hvis c == 125 {
            returner j + 1
        } ellers {
            returner -1
        }
    }
    returner -1
}

funksjon _json_liste(s: tekst, i: heiltall, dybde: heiltall) -> heiltall {
    la j = _json_hopp_ws(s, i + 1)
    hvis _json_kode(s, j) == 93 { returner j + 1 }    // tom []
    mens sann {
        j = _json_verdi(s, j, dybde + 1)
        hvis j < 0 { returner -1 }
        j = _json_hopp_ws(s, j)
        la c = _json_kode(s, j)
        hvis c == 44 {
            j = _json_hopp_ws(s, j + 1)
            hvis _json_kode(s, j) == 93 { returner -1 }    // hengande komma
        } ellers hvis c == 93 {
            returner j + 1
        } ellers {
            returner -1
        }
    }
    returner -1
}

funksjon _json_verdi(s: tekst, i: heiltall, dybde: heiltall) -> heiltall {
    hvis dybde > 256 { returner -1 }   // djupnevakt mot stakk-overflow-DoS
    la j = _json_hopp_ws(s, i)
    la c = _json_kode(s, j)
    hvis c == 34 { returner _json_streng(s, j) }
    hvis c == 123 { returner _json_objekt(s, j, dybde) }
    hvis c == 91 { returner _json_liste(s, j, dybde) }
    hvis c == 116 { returner _json_literal(s, j, "true") }
    hvis c == 102 { returner _json_literal(s, j, "false") }
    hvis c == 110 { returner _json_literal(s, j, "null") }
    hvis c == 45 eller _json_er_siffer(c) { returner _json_tal(s, j) }
    returner -1
}

// Returnerer sann berre for ein komplett, velforma JSON-tekst (eitt toppnivå-verdi,
// ingen søppel etter).
funksjon json_er_gyldig(s: tekst) -> boolsk {
    la slutt: heiltall = _json_verdi(s, 0, 0)
    hvis slutt < 0 { returner usann }
    la etter: heiltall = _json_hopp_ws(s, slutt)
    hvis etter == lengde(s) { returner sann }
    returner usann
}

funksjon request_json(ctx: ordbok_tekst) -> ordbok_tekst {
    la body = ctx["__body__"]
    // Fase 0.3: hindre at feilforma JSON når den native parseren (SIGSEGV/DoS).
    hvis body != "" og ikkje json_er_gyldig(body) {
        kast "json_invalid: ugyldig JSON-kropp"
    }
    prøv {
        la r = builtin.json_parse_raw(body)
        la rt = builtin.type(r)
        hvis rt == "ordbok" { returner r }
        kast "ValideringsFeil: body forventet JSON-objekt, fikk " + rt
    } fang (e) {
        kast e
    }
    returner {}
}

funksjon _ascii_lower(verdi: tekst) -> tekst {
    la ut: tekst = ""
    la i: heiltall = 0
    mens i < lengde(verdi) {
        la c: tekst = builtin.slice(verdi, i, i + 1)
        la code = builtin.char_code(c)
        hvis code >= 65 og code <= 90 { ut = ut + builtin.chr(code + 32) }
        ellers { ut = ut + c }
        i = i + 1
    }
    returner ut
}

funksjon _content_type_er_json(ctx: ordbok_tekst) -> boolsk {
    la ct = request_header(ctx, "content-type")
    hvis ct == "" { returner usann }
    la base = ct
    la semi = builtin.index_of(ct, ";")
    hvis semi >= 0 { base = builtin.slice(ct, 0, semi) }
    base = _ascii_lower(builtin.trim(base))
    returner base == "application/json"
}

// 422-respons for ugyldig JSON, i det samla 0.7-formatet.
funksjon json_feil_respons(melding: tekst) -> ordbok_tekst {
    la loc: liste<tekst> = ["body"]
    la post = valideringsfeil_post("json_invalid", loc, melding, "")
    la poster: liste<tekst> = [post]
    returner valideringsfeil_respons(poster, 422)
}

// Serve-trygg JSON-innlesing: sjekkar Content-Type = application/json, validerer
// strengt, og returnerer {ok, data} eller {ok:"usann", respons} (422 json_invalid).
// Handlar-mønster:
//   la r = web.request_json_resultat(ctx)
//   hvis r["ok"] == "usann" { returner r["respons"] }
//   la data = r["data"]
funksjon request_json_resultat(ctx: ordbok_tekst) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    hvis ikkje _content_type_er_json(ctx) {
        r["ok"] = "usann"
        r["respons"] = json_feil_respons("Content-Type må vere application/json")
        returner r
    }
    la body = ctx["__body__"]
    hvis ikkje json_er_gyldig(body) {
        r["ok"] = "usann"
        r["respons"] = json_feil_respons("ugyldig JSON-kropp")
        returner r
    }
    la parsed = builtin.json_parse_raw(body)
    hvis builtin.type(parsed) != "ordbok" {
        r["ok"] = "usann"
        r["respons"] = json_feil_respons("body forventa JSON-objekt")
        returner r
    }
    r["ok"] = "sann"
    r["data"] = parsed
    returner r
}

funksjon request_json_field(ctx: ordbok_tekst, nøkkel: tekst) -> tekst {
    la d = request_json(ctx)
    hvis (finnes_nøkkel(d, nøkkel)) { returner tekst(d[nøkkel]) }
    returner ""
}

funksjon request_json_field_or(ctx: ordbok_tekst, nøkkel: tekst, fallback: tekst) -> tekst {
    la v = request_json_field(ctx, nøkkel)
    hvis v == "" { returner fallback }
    returner v
}

funksjon request_json_field_int(ctx: ordbok_tekst, nøkkel: tekst) -> heltall {
    returner heltall_fra_tekst(request_json_field(ctx, nøkkel))
}

funksjon request_json_field_bool(ctx: ordbok_tekst, nøkkel: tekst) -> boolsk {
    returner request_json_field(ctx, nøkkel) == "sann" eller request_json_field(ctx, nøkkel) == "true"
}

# ─── Response ──────────────────────────────────────────────────────────────────

funksjon response_builder(status: heltall, headers: ordbok_tekst, body: tekst) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    r["status"] = status
    r["headers"] = headers
    r["body"] = body
    r["__status__"] = status
    r["__headers__"] = headers
    r["__body__"] = body
    returner r
}

// Som response_builder, men for binær body (bytes frå builtin.fil_les_binær):
// fontar, bilete, PDF. nc serve sender headerane som tekst og bytane uendra
// (selfhost/http_response.no: response_to_http + response_body_bytes).
funksjon response_bytes(status: heltall, headers: ordbok_tekst, body) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    r["status"] = status
    r["headers"] = headers
    r["body"] = body
    r["__status__"] = status
    r["__headers__"] = headers
    r["__body__"] = body
    returner r
}

// Les ei fil binært og lever henne med gitt content-type (404 om fila manglar).
funksjon response_file_bytes(sti: tekst, content_type: tekst) -> ordbok_tekst {
    prøv {
        la innhald = builtin.fil_les_binær(sti)
        returner response_bytes(200, {"content-type": content_type}, innhald)
    } fang (e) {
        returner response_error(404, "Fil ikkje funne: " + sti)
    }
    returner response_error(500, "")
}

funksjon response_status(response: ordbok_tekst) -> heltall {
    hvis finnes_nøkkel(response, "status") {
        returner response["status"]
    }
    hvis finnes_nøkkel(response, "__status__") {
        returner response["__status__"]
    }
    la ks = nøkler(response)
    la i: heltall = 0
    mens i < lengde(ks) {
        la k: tekst = tekst(ks[i])
        hvis k == "status" {
            returner response[ks[i]]
        }
        i = i + 1
    }
    i = 0
    mens i < lengde(ks) {
        la k2: tekst = tekst(ks[i])
        hvis k2 == "__status__" {
            returner response[ks[i]]
        }
        i = i + 1
    }
    returner 200
}

// Kompatibilitet for eldre kode som bruker response_code
funksjon response_code(response: ordbok_tekst) -> heltall {
    returner response_status(response)
}

funksjon response_headers(response: ordbok_tekst) -> ordbok_tekst {
    hvis finnes_nøkkel(response, "headers") {
        returner response["headers"]
    }
    hvis finnes_nøkkel(response, "__headers__") {
        returner response["__headers__"]
    }
    la ks = nøkler(response)
    la i: heltall = 0
    mens i < lengde(ks) {
        la k: tekst = tekst(ks[i])
        hvis k == "headers" {
            returner response[ks[i]]
        }
        i = i + 1
    }
    i = 0
    mens i < lengde(ks) {
        la k2: tekst = tekst(ks[i])
        hvis k2 == "__headers__" {
            returner response[ks[i]]
        }
        i = i + 1
    }
    returner {}
}

funksjon response_body(response: ordbok_tekst) -> tekst {
    hvis finnes_nøkkel(response, "body") {
        returner response["body"]
    }
    hvis finnes_nøkkel(response, "__body__") {
        returner response["__body__"]
    }
    la ks = nøkler(response)
    la i: heltall = 0
    mens i < lengde(ks) {
        la k: tekst = tekst(ks[i])
        hvis k == "body" {
            returner response[ks[i]]
        }
        i = i + 1
    }
    i = 0
    mens i < lengde(ks) {
        la k2: tekst = tekst(ks[i])
        hvis k2 == "__body__" {
            returner response[ks[i]]
        }
        i = i + 1
    }
    returner ""
}

funksjon response_text(response: ordbok_tekst) -> tekst {
    returner response_body(response)
}

funksjon response_with_header(response: ordbok_tekst, nøkkel: tekst, verdi: tekst) -> ordbok_tekst {
    la h = response["__headers__"]
    hvis h == null { h = {} }
    h[nøkkel] = verdi
    response["__headers__"] = h
    returner response
}

funksjon response_html(status: heltall, body: tekst) -> ordbok_tekst {
    returner response_builder(status, {"content-type": "text/html; charset=utf-8"}, body)
}

funksjon response_text_plain(status: heltall, body: tekst) -> ordbok_tekst {
    returner response_builder(status, {"content-type": "text/plain; charset=utf-8"}, body)
}

funksjon response_redirect(location: tekst, status: heltall) -> ordbok_tekst {
    returner response_builder(status, {"location": location, "content-type": "text/plain; charset=utf-8"}, "")
}

funksjon response_redirect_found(location: tekst) -> ordbok_tekst {
    returner response_redirect(location, 302)
}

funksjon response_redirect_see_other(location: tekst) -> ordbok_tekst {
    returner response_redirect(location, 303)
}

funksjon response_no_content() -> ordbok_tekst {
    returner response_builder(204, {}, "")
}

funksjon _header_finnes(headers: ordbok_tekst, nøkkel: tekst) -> boolsk {
    la low = tekst_til_liten(nøkkel)
    hvis finnes_nøkkel(headers, low) { returner sann }
    hvis finnes_nøkkel(headers, nøkkel) { returner sann }
    la ks = nøkler(headers)
    la i: heiltall = 0
    mens i < lengde(ks) {
        hvis tekst_til_liten(tekst(ks[i])) == low { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon _header_sett_mangler(headers: ordbok_tekst, nøkkel: tekst, verdi: tekst) -> ordbok_tekst {
    hvis ikkje _header_finnes(headers, nøkkel) {
        headers[nøkkel] = verdi
    }
    returner headers
}

funksjon _body_ser_json_ut(body: tekst) -> boolsk {
    la trimmed = builtin.trim(body)
    returner tekst_starter_med(trimmed, "{") eller tekst_starter_med(trimmed, "[")
}

funksjon response_finalize(ctx: ordbok_tekst, response: ordbok_tekst) -> ordbok_tekst {
    la headers = response_headers(response)
    hvis headers == null { headers = {} }
    la status = response_status(response)
    la body = response_text(response)
    // Toppnøkkelen content_type (responskontrakten i std/http_cache) vinn i
    // serialiseringa; ein gissa content-type i headers ville motseie han.
    la topp_ct = ""
    hvis finnes_nøkkel(response, "content_type") og response["content_type"] != null {
        topp_ct = tekst(response["content_type"])
    }
    hvis topp_ct == "" og _body_ser_json_ut(body) {
        headers = _header_sett_mangler(headers, "content-type", "application/json; charset=utf-8")
    } ellers hvis topp_ct == "" og body != "" {
        headers = _header_sett_mangler(headers, "content-type", "text/plain; charset=utf-8")
    }
    headers = _header_sett_mangler(headers, "x-content-type-options", "nosniff")
    headers = _header_sett_mangler(headers, "referrer-policy", "no-referrer")
    headers = _header_sett_mangler(headers, "x-frame-options", "DENY")
    headers = _header_sett_mangler(headers, "cache-control", "no-store")
    headers = _header_sett_mangler(headers, "permissions-policy", "geolocation=(), microphone=(), camera=(), payment=()")
    headers = _header_sett_mangler(headers, "cross-origin-opener-policy", "same-origin")
    headers = _header_sett_mangler(headers, "content-security-policy", "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' https: data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:")
    hvis status >= 400 {
        headers = _header_sett_mangler(headers, "x-robots-tag", "noindex,nofollow")
    }
    headers = _header_sett_mangler(headers, "server", "Norscode")
    headers = _header_sett_mangler(headers, "x-request-id", request_id(ctx))
    // Ingen CORS her. Før vart kvar Origin spegla med credentials, so ein framand
    // side med brukaren sin cookie kunne lese svaret. Cross-origin går berre via
    // response_finalize_strict_cors med eksplisitt allowlist (docs/APP_KJENSLE.md).
    response["__status__"] = status
    response["__body__"] = body
    response["__headers__"] = headers
    response["status"] = status
    response["body"] = body
    response["headers"] = headers
    returner response
}

funksjon response_finalize_strict(ctx: ordbok_tekst, response: ordbok_tekst) -> ordbok_tekst {
    la ferdig = response_finalize(ctx, response)
    la headers = ferdig["__headers__"]
    headers = _header_sett_mangler(headers, "strict-transport-security", "max-age=31536000; includeSubDomains")
    headers = _header_sett_mangler(headers, "content-security-policy", "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'")
    headers = _header_sett_mangler(headers, "permissions-policy", "geolocation=(), microphone=(), camera=()")
    headers = _header_sett_mangler(headers, "cross-origin-opener-policy", "same-origin")
    headers = _header_sett_mangler(headers, "cross-origin-embedder-policy", "require-corp")
    headers = _header_sett_mangler(headers, "cross-origin-resource-policy", "same-origin")
    headers = _header_sett_mangler(headers, "x-permitted-cross-domain-policies", "none")
    ferdig["__headers__"] = headers
    returner ferdig
}

funksjon _origin_er_tillaten(origin: tekst, tillatne: tekst) -> boolsk {
    hvis origin == "" { returner usann }
    la origins = builtin.split(tillatne, ",")
    la i: heltall = 0
    mens i < lengde(origins) {
        hvis builtin.trim(origins[i]) == origin { returner sann }
        i = i + 1
    }
    returner usann
}

// Legg `verdi` til Vary utan å skrive over det som alt står der (t.d.
// «x-norscode-fragment»): ein cache som mistar Vary-leddet kan gje fragment
// til ei full navigasjon. Nøkkelen blir funnen kasus-uavhengig.
funksjon _vary_legg_til(headers: ordbok_tekst, verdi: tekst) -> ordbok_tekst {
    la nøkkel = "vary"
    la ks = nøkler(headers)
    la i: heiltall = 0
    mens i < lengde(ks) {
        hvis tekst_til_liten(tekst(ks[i])) == "vary" { nøkkel = tekst(ks[i]) }
        i = i + 1
    }
    la eksisterande = ""
    hvis finnes_nøkkel(headers, nøkkel) { eksisterande = builtin.trim(tekst(headers[nøkkel])) }
    hvis eksisterande == "" {
        headers[nøkkel] = verdi
        returner headers
    }
    la ledd = builtin.split(eksisterande, ",")
    la j: heiltall = 0
    mens j < lengde(ledd) {
        la l = tekst_til_liten(builtin.trim(ledd[j]))
        hvis l == tekst_til_liten(verdi) eller l == "*" { returner headers }
        j = j + 1
    }
    headers[nøkkel] = eksisterande + ", " + verdi
    returner headers
}

funksjon response_finalize_strict_cors(ctx: ordbok_tekst, response: ordbok_tekst, tillatne_origins: tekst) -> ordbok_tekst {
    la ferdig = response_finalize_strict(ctx, response)
    la origin = request_header(ctx, "origin")
    la headers = ferdig["__headers__"]
    // Svaret er avhengig av Origin same om origin er tillaten eller ikkje.
    headers = _vary_legg_til(headers, "Origin")
    hvis _origin_er_tillaten(origin, tillatne_origins) {
        headers["access-control-allow-origin"] = origin
        headers["access-control-allow-credentials"] = "true"
    } ellers {
        hvis har_nokkel(headers, "access-control-allow-origin") { headers["access-control-allow-origin"] = "" }
        hvis har_nokkel(headers, "access-control-allow-credentials") { headers["access-control-allow-credentials"] = "" }
    }
    ferdig["__headers__"] = headers
    returner ferdig
}

funksjon _json_stringify_vals(d: ordbok_tekst) -> ordbok_tekst {
    // Konverter boolske verdiar til "true"/"false" for konsistens med JSON-forventningar
    la r: ordbok_tekst = {}
    la nk = nøkler(d)
    la i: heltall = 0
    mens i < lengde(nk) {
        la k: tekst = nk[i]
        la v = d[k]
        la vt = builtin.type(v)
        hvis vt == "boolsk" {
            hvis v { r[k] = "true" } ellers { r[k] = "false" }
        } ellers {
            r[k] = tekst(v)
        }
        i = i + 1
    }
    returner r
}

funksjon response_json(response: ordbok_tekst) -> ordbok_tekst {
    prøv {
        la raw = builtin.json_parse_raw(response["__body__"])
        returner _json_stringify_vals(raw)
    } fang (e) {
        returner {}
    }
    returner {}
}

funksjon response_header(response: ordbok_tekst, nøkkel: tekst) -> tekst {
    la h = response_headers(response)
    la low = tekst_til_liten(nøkkel)
    hvis (finnes_nøkkel(h, low)) { returner h[low] }
    hvis (finnes_nøkkel(h, nøkkel)) { returner h[nøkkel] }
    returner ""
}

funksjon cookie_header(nøkkel: tekst, verdi: tekst) -> tekst {
    returner nøkkel + "=" + verdi + "; HttpOnly; Secure; SameSite=Lax"
}

funksjon response_set_cookie(response: ordbok_tekst, cookie: tekst) -> ordbok_tekst {
    la h = response["__headers__"]
    h["set-cookie"] = cookie
    response["__headers__"] = h
    returner response
}

funksjon validation_error_body(errors: liste<tekst>) -> tekst {
    la body = "{\"ok\":\"usann\",\"error\":\"ValidationError\",\"details\":["
    la i: heiltall = 0
    mens i < lengde(errors) {
        la e = errors[i]
        la e_f = tekst_erstatt(e, "\"", "\\\\\"")
        hvis i == 0 {
            body = body + "\"" + e_f + "\""
        } ellers {
            body = body + ",\"" + e_f + "\""
        }
        i = i + 1
    }
    body = body + "]}"
    returner body
}

funksjon validation_error_response(errors: liste<tekst>, status: heiltall) -> ordbok_tekst {
    la body = validation_error_body(errors)
    returner response_builder(status, {"content-type": "application/json; charset=utf-8"}, body)
}

funksjon validation_bad_request(errors: liste<tekst>) -> ordbok_tekst {
    returner validation_error_response(errors, 422)
}

// ─── Fase 0.7: samla 422-format {detail:[{type,loc,msg,input}]} ──────────────────
// FastAPI-kompatibelt valideringsfeil-format, delt mellom web, skjema og rest.
// All brukarinput blir JSON-escapa (FA-030) so anførselsteikn ikkje bryt JSON-en.

funksjon _json_escape(s: tekst) -> tekst {
    la r = tekst_erstatt(s, "\\", "\\\\")
    r = tekst_erstatt(r, "\"", "\\\"")
    r = tekst_erstatt(r, "\n", "\\n")
    r = tekst_erstatt(r, "\r", "\\r")
    r = tekst_erstatt(r, "\t", "\\t")
    returner r
}

// Byggjer éin detalj-post som ferdig-serialisert JSON-objekt-streng.
// loc er ei liste av stegnamn (t.d. ["body", "namn"]).
funksjon valideringsfeil_post(type_kode: tekst, loc: liste<tekst>, msg: tekst, input_verdi: tekst) -> tekst {
    la loc_json: liste<tekst> = []
    la j: heltall = 0
    mens j < lengde(loc) {
        legg_til(loc_json, "\"" + _json_escape(tekst(loc[j])) + "\"")
        j = j + 1
    }
    returner "{\"type\":\"" + _json_escape(type_kode) + "\",\"loc\":[" + builtin.join(loc_json, ",") +
             "],\"msg\":\"" + _json_escape(msg) + "\",\"input\":\"" + _json_escape(input_verdi) + "\"}"
}

// Samlar ferdig-serialiserte poster (frå valideringsfeil_post) til {detail:[...]}.
funksjon valideringsfeil_json(poster: liste<tekst>) -> tekst {
    returner "{\"detail\":[" + builtin.join(poster, ",") + "]}"
}

funksjon valideringsfeil_respons(poster: liste<tekst>, status: heiltall) -> ordbok_tekst {
    la body = valideringsfeil_json(poster)
    returner response_builder(status, {"content-type": "application/json; charset=utf-8"}, body)
}

// Enkel bru frå felt→melding-ordbok til 422-respons med loc ["body", felt].
funksjon valideringsfeil_frå_felt(feil: ordbok_tekst, status: heiltall) -> ordbok_tekst {
    la nk = nøkler(feil)
    la poster: liste<tekst> = []
    la i: heltall = 0
    mens i < lengde(nk) {
        la k: tekst = tekst(nk[i])
        la loc: liste<tekst> = ["body", k]
        legg_til(poster, valideringsfeil_post("value_error", loc, tekst(feil[k]), ""))
        i = i + 1
    }
    returner valideringsfeil_respons(poster, status)
}

funksjon request_query_required_or_error(ctx: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> tekst {
    la v = request_query_param(ctx, nøkkel)
    hvis v == "" {
        legg_til(errors, nøkkel + " er påkravd")
    }
    returner v
}

funksjon request_header_or_error(ctx: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> tekst {
    la v = request_header(ctx, nøkkel)
    hvis v == "" {
        legg_til(errors, nøkkel + " er påkravd")
    }
    returner v
}

funksjon request_header_int_or_error(ctx: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> heiltall {
    la verdi = request_header_or_error(ctx, nøkkel, errors)
    hvis verdi == "" { returner 0 }
    prøv {
        returner builtin.heltall_fra_tekst(verdi)
    } fang (e) {
        legg_til(errors, nøkkel + " må vere heiltal")
        returner 0
    }
    returner 0
}

funksjon request_header_bool_or_error(ctx: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> boolsk {
    la verdi = request_header_or_error(ctx, nøkkel, errors)
    hvis verdi == "" { returner usann }
    hvis verdi == "sann" eller verdi == "true" { returner sann }
    hvis verdi == "usann" eller verdi == "false" { returner usann }
    legg_til(errors, nøkkel + " må vere boolsk")
    returner usann
}

funksjon request_json_int_or_error(payload: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> heiltall {
    la verdi = ""
    hvis (finnes_nøkkel(payload, nøkkel)) { verdi = tekst(payload[nøkkel]) }
    hvis verdi == "" {
        legg_til(errors, nøkkel + " er påkravd")
        returner 0
    }
    prøv {
        returner builtin.heltall_fra_tekst(verdi)
    } fang (e) {
        legg_til(errors, nøkkel + " må vere heiltal")
        returner 0
    }
    returner 0
}

funksjon request_json_text_or_error(payload: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> tekst {
    hvis ikkje finnes_nøkkel(payload, nøkkel) {
        legg_til(errors, nøkkel + " er påkravd")
        returner ""
    }
    la verdi = payload[nøkkel]
    la vt = builtin.type(verdi)
    hvis vt != "tekst" {
        legg_til(errors, nøkkel + " må vere tekst")
        returner ""
    }
    la tekst_verdi = tekst(verdi)
    hvis tekst_verdi == "" {
        legg_til(errors, nøkkel + " er påkravd")
        returner ""
    }
    returner tekst_verdi
}

funksjon request_json_bool_or_error(payload: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> boolsk {
    hvis ikkje finnes_nøkkel(payload, nøkkel) {
        legg_til(errors, nøkkel + " er påkravd")
        returner usann
    }
    la verdi = payload[nøkkel]
    la vt = builtin.type(verdi)
    hvis vt == "boolsk" {
        returner verdi
    }
    hvis vt == "tekst" {
        la booltekst = tekst(verdi)
        hvis booltekst == "sann" eller booltekst == "true" {
            returner sann
        }
        hvis booltekst == "usann" eller booltekst == "false" {
            returner usann
        }
        legg_til(errors, nøkkel + " må vere boolsk")
        returner usann
    }
    legg_til(errors, nøkkel + " må vere boolsk")
    returner usann
}

funksjon request_json_list_or_error(payload: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> liste<tekst> {
    hvis ikkje finnes_nøkkel(payload, nøkkel) {
        legg_til(errors, nøkkel + " er påkravd")
        la tom: liste<tekst> = []
        returner tom
    }
    la verdi = payload[nøkkel]
    hvis builtin.type(verdi) != "liste" {
        legg_til(errors, nøkkel + " må vere liste")
        la tom: liste<tekst> = []
        returner tom
    }
    returner verdi
}

funksjon request_json_object_or_error(payload: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> ordbok_tekst {
    hvis ikkje finnes_nøkkel(payload, nøkkel) {
        legg_til(errors, nøkkel + " er påkravd")
        returner {}
    }
    la verdi = payload[nøkkel]
    hvis builtin.type(verdi) != "ordbok" {
        legg_til(errors, nøkkel + " må vere objekt")
        returner {}
    }
    returner verdi
}

funksjon response_shape_validate_or_error(payload: ordbok_tekst, schema: ordbok_tekst, errors: liste<tekst>) {
    la krav_nøklar = nøkler(schema)
    la i: heiltall = 0
    mens i < lengde(krav_nøklar) {
        la nøkkel = krav_nøklar[i]
        la forventet = schema[nøkkel]
        hvis ikkje finnes_nøkkel(payload, nøkkel) {
            legg_til(errors, nøkkel + " manglar")
        } ellers {
            la faktisk = builtin.type(payload[nøkkel])
            hvis faktisk != forventet {
                legg_til(errors, nøkkel + " må vere " + forventet)
            }
        }
        i = i + 1
    }
}

funksjon request_param_int_or_error(params: ordbok_tekst, nøkkel: tekst, errors: liste<tekst>) -> heiltall {
    la verdi = ""
    hvis finnes_nøkkel(params, nøkkel) { verdi = tekst(params[nøkkel]) }
    hvis verdi == "" {
        legg_til(errors, nøkkel + " er påkravd")
        returner 0
    }
    prøv {
        returner builtin.heltall_fra_tekst(verdi)
    } fang (e) {
        legg_til(errors, nøkkel + " må vere heiltal")
        returner 0
    }
    returner 0
}

funksjon response_error(status: heltall, melding: tekst) -> ordbok_tekst {
    returner response_builder(status, {"content-type": "application/json"}, "{\"ok\":false,\"error\":\"" + melding + "\"}")
}

funksjon response_file(sti: tekst, content_type: tekst) -> ordbok_tekst {
    prøv {
        la innhald = fil_les(sti)
        returner response_builder(200, {"content-type": content_type}, innhald)
    } fang (e) {
        returner response_error(404, "Fil ikkje funne: " + sti)
    }
    returner response_error(500, "")
}

funksjon safe_relative_path(rel_sti: tekst) -> boolsk {
    hvis rel_sti == null { returner usann }
    hvis rel_sti == "" { returner usann }
    hvis tekst_starter_med(rel_sti, "/") { returner usann }
    hvis tekst_starter_med(rel_sti, "\\") { returner usann }
    hvis tekst_starter_med(rel_sti, "~") { returner usann }
    hvis tekst_inneholder(rel_sti, "\\") { returner usann }
    hvis tekst_inneholder(rel_sti, "%") { returner usann }
    hvis tekst_inneholder(rel_sti, ":") { returner usann }

    la deler = builtin.split(rel_sti, "/")
    la i: heltall = 0
    mens i < lengde(deler) {
        la del: tekst = deler[i]
        hvis del == "" { returner usann }
        hvis del == "." { returner usann }
        hvis del == ".." { returner usann }
        la j: heltall = 0
        mens j < lengde(del) {
            la c: tekst = builtin.slice(del, j, j + 1)
            la code = builtin.char_code(c)
            hvis code < 32 eller code == 127 { returner usann }
            hvis c == "<" eller c == ">" eller c == "|" eller c == "\"" eller c == "?" eller c == "*" {
                returner usann
            }
            j = j + 1
        }
        i = i + 1
    }
    returner sann
}

funksjon safe_join_path(root: tekst, rel_sti: tekst) -> tekst {
    hvis root == null eller root == "" { returner "" }
    hvis ikkje safe_relative_path(rel_sti) { returner "" }
    hvis tekst_slutter_med(root, "/") {
        returner root + rel_sti
    }
    returner root + "/" + rel_sti
}

funksjon response_static_file(root: tekst, rel_sti: tekst, content_type: tekst) -> ordbok_tekst {
    la trygg_sti = safe_join_path(root, rel_sti)
    hvis trygg_sti == "" {
        returner response_error(403, "Forbudt")
    }
    returner response_file(trygg_sti, content_type)
}

# ─── Routing ────────────────────────────────────────────────────────────────────

# route(spec) er kun ein markør; faktisk routing skjer via NCB-metadata i handle_request
funksjon route(spec: tekst) -> tekst {
    returner spec
}

funksjon router(prefiks: tekst) -> tekst {
    returner prefiks
}

funksjon subrouter(prefiks: tekst) -> tekst {
    returner prefiks
}

funksjon guard() -> tekst  {
    returner ""
}
funksjon dependency(navn: tekst) -> tekst  {
    returner navn
}
funksjon use_dependency(navn: tekst) -> tekst  {
    returner navn
}
funksjon use_guard(navn: tekst) -> tekst  {
    returner navn
}
funksjon request_middleware() -> tekst  {
    returner ""
}
funksjon response_middleware() -> tekst  {
    returner ""
}
funksjon error_middleware() -> tekst  {
    returner ""
}
funksjon startup_hook() -> tekst  {
    returner ""
}
funksjon shutdown_hook() -> tekst  {
    returner ""
}
// ─── OpenAPI-markørar (Fase 2 / 2.10) ────────────────────────────────────────
// Kompilatoren (ir_to_bytecode sin prolog-skann, 2.10) les desse frå dei
// leiande setningane i ein handlar og skriv metadata inn i route-oppføringa.
// MERK: sjølve kallet VERT emittert til bytekode og køyrer kvar gong
// handlaren køyrer, og aritetsvakta i VM-en (R1/F07) krev nøyaktig
// lengde(params) argument. Kryssmodul-kall får verken standardargument eller
// vararg-pakking, så signaturen her MÅ samsvare med bruken. Tidlegare var
// tags() parameterlaus, og web.tags("a") gav 500 ArgumentFeil i handlaren
// (FA-097). Éin tag per kall: fleire tags skriv ein som fleire linjer,
// web.tags("a") + web.tags("b") — prolog-skannen samlar dei i éi liste.
// web.tags("a", "b") i eitt kall krev at kompilatoren slepper markørkallet
// (eller pakkar varargs på tvers av modular) — det er ei seed-endring.
funksjon tags(tag: tekst) -> tekst  {
    returner tag
}
funksjon beskriving(tekst_verdi: tekst) -> tekst  {
    returner tekst_verdi
}
funksjon respons(status: tekst, beskrivelse: tekst) -> tekst  {
    returner status
}
funksjon forelda() -> tekst  {
    returner ""
}
funksjon skjul() -> tekst  {
    returner ""
}

# Kall fn utan argument når han ikkje tek parametrar, elles med arg. Aritetsvakta i
# VM-en (Fase 2.1) kastar ved feil tal argument, so testfunksjonar og krokar utan
# parameter kan ikkje lenger kallast med ein tom ctx.
funksjon _kall_valfritt_arg(fn: tekst, arg) {
    la pc = "-1"
    prøv {
        la info = builtin.vm_function_info(fn)
        hvis tekst(info["finnes"]) == "sann" { pc = tekst(info["param_count"]) }
    } fang (e) { }
    hvis pc == "0" { returner builtin.ncb_call_fn(fn) }
    returner builtin.ncb_call_fn(fn, arg)
}

funksjon startup() -> heltall {
    la hooks = ncb_metadata("startup_hooks")
    la i: heltall = 0
    la siste: heltall = 0
    mens i < lengde(hooks) {
        la r = _kall_valfritt_arg(hooks[i], {})
        prøv { siste = heltall(r) } fang (e) { siste = 1 }
        i = i + 1
    }
    returner siste
}

funksjon shutdown() -> heltall {
    la hooks = ncb_metadata("shutdown_hooks")
    la i: heltall = 0
    la siste: heltall = 0
    mens i < lengde(hooks) {
        la r = _kall_valfritt_arg(hooks[i], {})
        prøv { siste = heltall(r) } fang (e) { siste = 1 }
        i = i + 1
    }
    returner siste
}

funksjon request_dependency(ctx: ordbok_tekst, nøkkel: tekst) -> ordbok_tekst {
    la dep_key: tekst = "__dep_" + nøkkel + "__"
    hvis finnes_nøkkel(ctx, dep_key) { returner ctx[dep_key] }
    returner {}
}

# ─── Path matching ──────────────────────────────────────────────────────────────

funksjon _normaliser_sti(sti: tekst) -> tekst {
    hvis lengde(sti) > 1 og tekst_slutter_med(sti, "/") {
        returner builtin.slice(sti, 0, lengde(sti) - 1)
    }
    returner sti
}

funksjon path_match(mønster: tekst, sti: tekst) -> boolsk {
    mønster = _normaliser_sti(mønster)
    sti = _normaliser_sti(sti)
    la m_segs = builtin.split(mønster, "/")
    la s_segs = builtin.split(sti, "/")
    hvis lengde(m_segs) != lengde(s_segs) { returner usann }
    la i: heltall = 0
    mens i < lengde(m_segs) {
        la ms: tekst = m_segs[i]
        la ss: tekst = s_segs[i]
        la er_wildcard: boolsk = tekst_starter_med(ms, "{") og tekst_slutter_med(ms, "}")
        la segment_ok: boolsk = sann
        hvis er_wildcard {
            // Sjekk type-constraint
            la inner = builtin.slice(ms, 1, lengde(ms) - 1)
            la colon = builtin.index_of(inner, ":")
            hvis colon > 0 {
                la type_hint: tekst = builtin.slice(inner, colon + 1, lengde(inner))
                hvis type_hint == "int" {
                    la j: heltall = 0
                    la all_digits: boolsk = lengde(ss) > 0
                    mens j < lengde(ss) {
                        la ch: tekst = ss[j]
                        la code = builtin.char_code(ch)
                        hvis code < 48 eller code > 57 { all_digits = usann }
                        j = j + 1
                    }
                    hvis ikkje all_digits { segment_ok = usann }
                }
            }
        } ellers {
            segment_ok = (ms == ss)
        }
        hvis ikkje segment_ok { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon path_params(mønster: tekst, sti: tekst) -> ordbok_tekst {
    mønster = _normaliser_sti(mønster)
    sti = _normaliser_sti(sti)
    la params: ordbok_tekst = {}
    la m_segs = builtin.split(mønster, "/")
    la s_segs = builtin.split(sti, "/")
    la i: heltall = 0
    mens i < lengde(m_segs) og i < lengde(s_segs) {
        la ms: tekst = m_segs[i]
        la ss: tekst = s_segs[i]
        hvis tekst_starter_med(ms, "{") og tekst_slutter_med(ms, "}") {
            // Hent param-namn, strip { }
            la inner = builtin.slice(ms, 1, lengde(ms) - 1)
            la colon = builtin.index_of(inner, ":")
            la param_namn: tekst = ""
            hvis colon > 0 {
                param_namn = builtin.slice(inner, 0, colon)
            } ellers {
                param_namn = inner
            }
            params[param_namn] = ss
        }
        i = i + 1
    }
    returner params
}

funksjon route_match(spec: tekst, metode: tekst, sti: tekst) -> boolsk {
    la deler = builtin.split(spec, " ")
    hvis lengde(deler) < 2 { returner usann }
    la spec_metode: tekst = deler[0]
    la spec_sti: tekst = deler[1]
    la m_upper = _ascii_upper(metode)
    la spec_upper = _ascii_upper(spec_metode)
    hvis spec_upper != m_upper { returner usann }
    returner path_match(spec_sti, sti)
}

funksjon path_param(params: ordbok_tekst, nøkkel: tekst) -> tekst {
    hvis (finnes_nøkkel(params, nøkkel)) { returner params[nøkkel] }
    returner ""
}

funksjon path_param_or(params: ordbok_tekst, nøkkel: tekst, fallback: tekst) -> tekst {
    la v = path_param(params, nøkkel)
    hvis v == "" { returner fallback }
    returner v
}

funksjon dispatch(routes: ordbok_tekst, metode: tekst, sti: tekst) -> tekst {
    la nk = nøkler(routes)
    la i: heltall = 0
    mens i < lengde(nk) {
        la key: tekst = nk[i]
        la spec: tekst = routes[key]
        hvis route_match(spec, metode, sti) { returner key }
        i = i + 1
    }
    returner ""
}

funksjon dispatch_params(routes: ordbok_tekst, metode: tekst, sti: tekst) -> ordbok_tekst {
    la nk = nøkler(routes)
    la i: heltall = 0
    mens i < lengde(nk) {
        la key: tekst = nk[i]
        la spec: tekst = routes[key]
        la deler = builtin.split(spec, " ")
        hvis lengde(deler) >= 2 og route_match(spec, metode, sti) {
            returner path_params(deler[1], sti)
        }
        i = i + 1
    }
    returner {}
}

funksjon _web_debug(melding: tekst) -> heiltall {
    prøv {
        hvis builtin.miljo_hent("NORSCODE_WEB_DEBUG") == "1" {
            skriv("[web-debug] " + melding + "\n")
        }
    } fang (e) {
    }
    returner 0
}

# ─── handle_request ────────────────────────────────────────────────────────────
# Brukar NCB route_handlers-metadata (builtin.ncb_route_handlers) for dispatch.

funksjon _apply_request_middlewares(ctx: ordbok_tekst) -> ordbok_tekst {
    la mws = ncb_metadata("request_middlewares")
    la i: heltall = 0
    la current = ctx
    mens i < lengde(mws) {
        prøv {
            la r = builtin.ncb_call_fn(mws[i], current)
            hvis r != null { current = r }
        } fang (e) { }
        i = i + 1
    }
    returner current
}

funksjon _apply_response_middlewares(response: ordbok_tekst) -> ordbok_tekst {
    la mws = ncb_metadata("response_middlewares")
    la i: heltall = 0
    la current = response
    mens i < lengde(mws) {
        prøv {
            la r = builtin.ncb_call_fn(mws[i], current)
            hvis r != null { current = r }
        } fang (e) { }
        i = i + 1
    }
    returner current
}

funksjon _apply_error_middlewares(response: ordbok_tekst) -> ordbok_tekst {
    la mws = ncb_metadata("error_middlewares")
    la i: heltall = 0
    la current = response
    mens i < lengde(mws) {
        prøv {
            la r = builtin.ncb_call_fn(mws[i], current)
            hvis r != null { current = r }
        } fang (e) { }
        i = i + 1
    }
    returner current
}

funksjon handle_request(ctx: ordbok_tekst) -> ordbok_tekst {
    la metode: tekst = _ascii_upper(ctx["__method__"])
    la sti: tekst    = ctx["__path__"]
    la rh = ncb_route_handlers()
    // Apply request middleware
    ctx = _apply_request_middlewares(ctx)

    // HEAD → prøv GET, returner utan body
    la er_head: boolsk = metode == "HEAD"
    la søk_metode: tekst = metode
    hvis er_head { søk_metode = "GET" }

    // OPTIONS → finn alle metodar for sti, returner 204 med Allow-header
    hvis metode == "OPTIONS" {
        la found_methods: tekst = ""
        la i: heltall = 0
        mens i < lengde(rh) {
            la deler = builtin.split(rh[i]["spec"], " ")
            hvis lengde(deler) >= 2 og path_match(deler[1], sti) {
                la m: tekst = _ascii_upper(deler[0])
                hvis found_methods == "" { found_methods = m }
                ellers { found_methods = found_methods + ", " + m }
            }
            i = i + 1
        }
        la allowed: tekst = found_methods
        hvis tekst_inneholder(found_methods, "GET") {
            allowed = allowed + ", HEAD"
        }
        allowed = allowed + ", OPTIONS"
        la preflight = response_builder(204, {
            "allow": allowed,
            "access-control-allow-methods": allowed,
            "access-control-allow-headers": "authorization, content-type, x-api-key, x-request-id"
        }, "")
        // Preflight speglar ikkje Origin. Ein app som vil tillate cross-origin, set
        // ctx["__cors_origins__"] (kommaseparert allowlist) i ein request-middleware;
        // då går preflight gjennom response_finalize_strict_cors som andre CORS-svar.
        la tillatne_origins: tekst = ""
        hvis finnes_nøkkel(ctx, "__cors_origins__") og ctx["__cors_origins__"] != null {
            tillatne_origins = tekst(ctx["__cors_origins__"])
        }
        hvis tillatne_origins != "" {
            returner response_finalize_strict_cors(ctx, preflight, tillatne_origins)
        }
        returner response_finalize(ctx, preflight)
    }

    la sti_match: boolsk = usann
    la i: heltall = 0
    mens i < lengde(rh) {
        la handler = rh[i]
        la spec: tekst = handler["spec"]
        la fn_namn: tekst = handler["function"]
        la deler = builtin.split(spec, " ")
        hvis lengde(deler) >= 2 {
            la spec_metode: tekst = _ascii_upper(deler[0])
            la spec_sti: tekst    = deler[1]
            _web_debug("check spec=" + spec + " sti=" + sti + " match=" + tekst(path_match(spec_sti, sti)))
            hvis path_match(spec_sti, sti) {
                sti_match = sann
                hvis spec_metode == søk_metode {
                    _web_debug("call fn=" + fn_namn)
                    la p = path_params(spec_sti, sti)
                    _web_debug("params=" + tekst(p))
                    ctx["__params__"] = p
                    // Sjekk guards
                    la guards = handler["guards"]
                    la gi: heltall = 0
                    la guard_ok: boolsk = sann
                    mens gi < lengde(guards) og guard_ok {
                        la g_fn: tekst = guards[gi]
                        la g_result = builtin.ncb_call_fn("__main__." + g_fn, ctx)
                        hvis ikkje g_result { guard_ok = usann }
                        gi = gi + 1
                    }
                    hvis ikkje guard_ok { returner response_finalize(ctx, response_error(403, "Forbudt")) }
                    // Dependency injection
                    la deps = handler["deps"]
                    la dep_providers = ncb_metadata("dependency_providers")
                    la dep_args: liste = [ctx]
                    la di: heltall = 0
                    mens di < lengde(deps) {
                        la dep_namn: tekst = deps[di]
                        la dep_fn: tekst = dep_namn
                        hvis finnes_nøkkel(dep_providers, dep_namn) { dep_fn = dep_providers[dep_namn] }
                        ellers { dep_fn = "__main__." + dep_namn }
                        la dep_ctx: ordbok_tekst = {}
                        la nk2 = nøkler(ctx)
                        la ck: heltall = 0
                        mens ck < lengde(nk2) {
                            dep_ctx[nk2[ck]] = ctx[nk2[ck]]
                            ck = ck + 1
                        }
                        dep_ctx["__dep_name__"] = dep_namn
                        la dep_r = null
                        hvis lengde(dep_args) == 1 {
                            dep_r = builtin.ncb_call_fn(dep_fn, dep_ctx)
                        } ellers hvis lengde(dep_args) == 2 {
                            dep_r = builtin.ncb_call_fn(dep_fn, dep_ctx, dep_args[1])
                        } ellers hvis lengde(dep_args) == 3 {
                            dep_r = builtin.ncb_call_fn(dep_fn, dep_ctx, dep_args[1], dep_args[2])
                        } ellers {
                            dep_r = builtin.ncb_call_fn(dep_fn, dep_ctx)
                        }
                        legg_til(dep_args, dep_r)
                        // Lagre dep-resultatet i ctx for bruk av seinare deps
                        ctx["__dep_" + dep_namn + "__"] = dep_r
                        di = di + 1
                    }
                    la resp: ordbok_tekst = {}
                    prøv {
                        // Kall handler med ctx + dep-args. Fase 2 / 2.1: dynamiske
                        // bytekode-kall (builtin.ncb_call_fn) har no ein aritetsvakt i
                        // VM-en — for mange argument vert IKKJE lenger stilt ignorert, men
                        // kasta som fangbart unntak. Ein handlar kan markere use_dependency
                        // men ta imot avhengnadene manuelt (berre ein ctx-parameter); då
                        // skal han kallast med nøyaktig dei parametrane han deklarerer, ikkje
                        // med heile dep_args. Klamp talet på argument til handlaren sin aritet.
                        la kall_n: heltall = lengde(dep_args)
                        la h_info = builtin.vm_function_info(fn_namn)
                        hvis tekst(h_info["finnes"]) == "sann" {
                            la h_pc: heltall = heltall_fra_tekst(tekst(h_info["param_count"]))
                            hvis h_pc >= 1 og h_pc < kall_n { kall_n = h_pc }
                        }
                        hvis kall_n == 1 {
                            resp = builtin.ncb_call_fn(fn_namn, dep_args[0])
                        } ellers hvis kall_n == 2 {
                            resp = builtin.ncb_call_fn(fn_namn, dep_args[0], dep_args[1])
                        } ellers hvis kall_n == 3 {
                            resp = builtin.ncb_call_fn(fn_namn, dep_args[0], dep_args[1], dep_args[2])
                        } ellers {
                            resp = builtin.ncb_call_fn(fn_namn, ctx)
                        }
                        hvis er_head { resp["__body__"] = "" }
                        returner response_finalize(ctx, _apply_response_middlewares(resp))
                    } fang (err) {
                        hvis builtin.type(err) == "tekst" {
                            hvis tekst_starter_med(err, "ValideringsFeil:") {
                                la deler = builtin.split(err, ":")
                                la detalj = err
                                hvis lengde(deler) > 1 {
                                    detalj = builtin.trim(deler[1])
                                    la i: heltall = 2
                                    mens i < lengde(deler) {
                                        detalj = detalj + ":" + deler[i]
                                        i = i + 1
                                    }
                                }
                                la val_err = validation_error_response([detalj], 422)
                                returner response_finalize(ctx, _apply_error_middlewares(val_err))
                            }
                        }
                        la err_resp = response_error(500, "Intern feil: " + err)
                        returner response_finalize(ctx, _apply_error_middlewares(err_resp))
                    }
                    returner response_finalize(ctx, _apply_response_middlewares(resp))
                }
            }
        }
        i = i + 1
    }
    hvis sti_match {
        // Bygg allow-header for 405
        la allowed_405: tekst = ""
        la j405: heltall = 0
        mens j405 < lengde(rh) {
            la deler405 = builtin.split(rh[j405]["spec"], " ")
            hvis lengde(deler405) >= 2 og path_match(deler405[1], sti) {
                la m405: tekst = _ascii_upper(deler405[0])
                hvis allowed_405 == "" { allowed_405 = m405 }
                ellers { allowed_405 = allowed_405 + ", " + m405 }
            }
            j405 = j405 + 1
        }
        la r405 = response_error(404, "Metode ikkje funne: " + metode)
        r405["__headers__"]["allow"] = allowed_405
        returner response_finalize(ctx, _apply_error_middlewares(r405))
    }
    returner response_finalize(ctx, _apply_error_middlewares(response_error(404, "Ikkje funne: " + metode + " " + sti)))
}

# ─── Sanitering ────────────────────────────────────────────────────────────────

funksjon escape_html(tekst_verdi: tekst) -> tekst {
    la r = tekst_verdi
    r = tekst_erstatt(r, "&", "&amp;")
    r = tekst_erstatt(r, "<", "&lt;")
    r = tekst_erstatt(r, ">", "&gt;")
    r = tekst_erstatt(r, "\"", "&quot;")
    r = tekst_erstatt(r, "'", "&#x27;")
    returner r
}

funksjon safe_filename(tekst_verdi: tekst) -> tekst {
    la tegn = builtin.split(tekst_verdi, "")
    la r: tekst = ""
    la i: heltall = 0
    mens i < lengde(tegn) {
        la c: tekst = tegn[i]
        la code = builtin.char_code(c)
        // Tillat a-z A-Z 0-9 . - _; alt anna vert _
        la ok: boolsk = (code >= 97 og code <= 122) eller (code >= 65 og code <= 90) eller
                        (code >= 48 og code <= 57) eller c == "." eller c == "-" eller c == "_"
        hvis ok { r = r + c }
        ellers { r = r + "_" }
        i = i + 1
    }
    returner r
}

funksjon safe_path_segment(tekst_verdi: tekst) -> tekst {
    la tegn = builtin.split(tekst_verdi, "")
    la r: tekst = ""
    la i: heltall = 0
    mens i < lengde(tegn) {
        la c: tekst = tegn[i]
        la code = builtin.char_code(c)
        la ok: boolsk = (code >= 97 og code <= 122) eller (code >= 65 og code <= 90) eller
                        (code >= 48 og code <= 57) eller c == "-" eller c == "_"
        hvis ok { r = r + c }
        ellers { r = r + "-" }
        i = i + 1
    }
    returner r
}

funksjon safe_slug(tekst_verdi: tekst) -> tekst {
    la lower = tekst_til_liten(tekst_verdi)
    la tegn = builtin.split(lower, "")
    la r: tekst = ""
    la i: heltall = 0
    mens i < lengde(tegn) {
        la c: tekst = tegn[i]
        la code = builtin.char_code(c)
        la ok: boolsk = (code >= 97 og code <= 122) eller (code >= 48 og code <= 57) eller c == "-"
        hvis ok { r = r + c }
        ellers hvis c == " " eller c == "_" { r = r + "-" }
        i = i + 1
    }
    returner r
}

# ─── OpenAPI ───────────────────────────────────────────────────────────────────

// Fase 0.9: JSON-escape ein strengverdi for trygg innbaking i generert skjema.
// Utan dette gav t.d. ein tittel med " ugyldig JSON (FA-094).
funksjon _json_escape(verdi: tekst) -> tekst {
    la ut: tekst = ""
    la i: heiltall = 0
    la n = lengde(verdi)
    mens i < n {
        la c = builtin.slice(verdi, i, i + 1)
        la code = builtin.char_code(c)
        hvis c == "\"" { ut = ut + "\\\"" }
        ellers hvis c == "\\" { ut = ut + "\\\\" }
        ellers hvis code == 10 { ut = ut + "\\n" }
        ellers hvis code == 13 { ut = ut + "\\r" }
        ellers hvis code == 9 { ut = ut + "\\t" }
        ellers hvis code < 32 {
            la hexd = "0123456789abcdef"
            la hi = code / 16
            la lo = code - hi * 16
            ut = ut + "\\u00" + builtin.slice(hexd, hi, hi + 1) + builtin.slice(hexd, lo, lo + 1)
        }
        ellers { ut = ut + c }
        i = i + 1
    }
    returner ut
}

// JSON-skjema for ein skalar path-param-type.
funksjon _openapi_type_schema(type_namn: tekst) -> tekst {
    hvis type_namn == "int" eller type_namn == "heltall" { returner "{\"type\":\"integer\"}" }
    hvis type_namn == "float" eller type_namn == "desimaltall" { returner "{\"type\":\"number\"}" }
    hvis type_namn == "bool" eller type_namn == "boolsk" { returner "{\"type\":\"boolean\"}" }
    returner "{\"type\":\"string\"}"
}

// Normaliser sti: {id:int} → {id} (OpenAPI path-mal utan type-annotasjon).
funksjon _openapi_norm_path(raw_path: tekst) -> tekst {
    la segs = builtin.split(raw_path, "/")
    la ut: tekst = ""
    la i: heiltall = 0
    mens i < lengde(segs) {
        la seg = segs[i]
        la norm = seg
        hvis tekst_starter_med(seg, "{") og tekst_slutter_med(seg, "}") {
            la inner = builtin.slice(seg, 1, lengde(seg) - 1)
            la c = builtin.index_of(inner, ":")
            hvis c > 0 { norm = "{" + builtin.slice(inner, 0, c) + "}" }
        }
        hvis i == 0 { ut = norm }
        ellers { ut = ut + "/" + norm }
        i = i + 1
    }
    returner ut
}

// Bygg in:path-parameterfragment frå rute-mønsteret {namn} / {namn:type}.
funksjon _openapi_path_params(raw_path: tekst) -> tekst {
    la segs = builtin.split(raw_path, "/")
    la frag: tekst = ""
    la i: heiltall = 0
    mens i < lengde(segs) {
        la seg = segs[i]
        hvis tekst_starter_med(seg, "{") og tekst_slutter_med(seg, "}") {
            la inner = builtin.slice(seg, 1, lengde(seg) - 1)
            la navn = inner
            la typ = "tekst"
            la c = builtin.index_of(inner, ":")
            hvis c > 0 {
                navn = builtin.slice(inner, 0, c)
                typ = builtin.slice(inner, c + 1, lengde(inner))
            }
            la p = "{\"name\":\"" + _json_escape(navn) + "\",\"in\":\"path\",\"required\":true,\"schema\":" + _openapi_type_schema(typ) + "}"
            hvis frag == "" { frag = p } ellers { frag = frag + "," + p }
        }
        i = i + 1
    }
    returner frag
}

// Unik operationId frå modul-kvalifisert funksjonsnamn: __main__.x → x,
// std.rest.index → std_rest_index. Kallaren sikrar unikskap på tvers.
funksjon _openapi_operation_id(funksjonsnamn: tekst) -> tekst {
    la f = funksjonsnamn
    hvis tekst_starter_med(f, "__main__.") { f = builtin.slice(f, 9, lengde(f)) }
    returner builtin.replace(f, ".", "_")
}

// Tag = siste modul-ledd i funksjonsnamnet (gruppering per modul). __main__ → "standard".
funksjon _openapi_tag(funksjonsnamn: tekst) -> tekst {
    la deler = builtin.split(funksjonsnamn, ".")
    hvis lengde(deler) < 2 { returner "standard" }
    la modul_sist = deler[lengde(deler) - 2]
    hvis modul_sist == "__main__" { returner "standard" }
    returner modul_sist
}

// True for dokumentasjonsrutene som skal skjulast frå skjemaet.
funksjon _openapi_er_docs_rute(norm_path: tekst) -> boolsk {
    returner norm_path == "/openapi.json" eller norm_path == "/docs" eller norm_path == "/redoc"
}

// Robuste oppslag i rute-metadata (eitt element frå ncb_route_handlers()):
// eldre NCB-ar (før 2.10) manglar nøklane, og verdiane kan kome som bool/tekst
// avhengig av JSON-lesaren. Offentlege fordi std.docs_side brukar dei òg.
funksjon rute_meta_sann(handler, nøkkel: tekst) -> boolsk {
    hvis ikkje finnes_nøkkel(handler, nøkkel) { returner usann }
    la v = tekst(handler[nøkkel])
    returner v == "sann" eller v == "true" eller v == "1"
}

funksjon rute_meta_tekst(handler, nøkkel: tekst) -> tekst {
    hvis ikkje finnes_nøkkel(handler, nøkkel) { returner "" }
    la v = handler[nøkkel]
    hvis v == null { returner "" }
    returner tekst(v)
}

funksjon rute_meta_liste(handler, nøkkel: tekst) {
    la ut = []
    hvis ikkje finnes_nøkkel(handler, nøkkel) { returner ut }
    la v = handler[nøkkel]
    hvis builtin.type(v) != "liste" { returner ut }
    la i: heltall = 0
    mens i < lengde(v) {
        legg_til(ut, v[i])
        i = i + 1
    }
    returner ut
}

// Standard skildring for ein statuskode når web.respons(...) ikkje gav nokon
// (OpenAPI krev «description» på kvar respons).
funksjon _openapi_status_tekst(status: tekst) -> tekst {
    hvis status == "400" { returner "Bad Request" }
    hvis status == "401" { returner "Unauthorized" }
    hvis status == "403" { returner "Forbidden" }
    hvis status == "404" { returner "Not Found" }
    hvis status == "409" { returner "Conflict" }
    hvis status == "422" { returner "Validation Error" }
    hvis status == "500" { returner "Internal Server Error" }
    returner "Respons " + status
}

funksjon _openapi_resp_json(parsed_verdi, fallback: tekst) -> tekst {
    prøv { returner builtin.json_skriv(parsed_verdi) } fang (e) { }
    returner fallback
}

// FA-094/096/098/099/102/103: metadata-drive OpenAPI 3.1-generator.
// oppsett: ordbok med valfrie nøklar «tittel», «versjon», «beskriving»,
// «tags» (ordbok tag→beskriving) og «eksempel» (ordbok operationId→rå JSON
// for requestBody-eksempel).
funksjon openapi_json_med(oppsett: ordbok) -> tekst {
    la tittel: tekst = "Norscode API"
    hvis finnes_nøkkel(oppsett, "tittel") { tittel = tekst(oppsett["tittel"]) }
    la versjon: tekst = "0.1.0"
    hvis finnes_nøkkel(oppsett, "versjon") { versjon = tekst(oppsett["versjon"]) }

    la rh = ncb_route_handlers()
    // Grupper operasjonar per normalisert sti (GET+POST på same sti i eitt path-item).
    la path_ops: ordbok_tekst = {}
    la path_order: liste<tekst> = []
    la id_seen: ordbok_tekst = {}
    la tag_order: liste<tekst> = []
    la tag_seen: ordbok_tekst = {}
    la har_security: boolsk = usann

    la i: heltall = 0
    mens i < lengde(rh) {
        la handler = rh[i]
        la spec: tekst = tekst(handler["spec"])
        la deler = builtin.split(spec, " ")
        hvis lengde(deler) >= 2 {
            la raw_path: tekst = deler[1]
            la norm_path: tekst = _openapi_norm_path(raw_path)
            hvis _openapi_er_docs_rute(norm_path) eller rute_meta_sann(handler, "hidden") {
                // web.skjul() → include_in_schema=False (FA-097).
                i = i + 1
                fortsett
            }
            la method: tekst = tekst_til_liten(deler[0])
            la funksjonsnamn: tekst = tekst(handler["function"])

            // Unik operationId frå modul+funksjon.
            la base_id = _openapi_operation_id(funksjonsnamn)
            la op_id = base_id
            la dupctr = 2
            mens finnes_nøkkel(id_seen, op_id) {
                op_id = base_id + "_" + tekst(dupctr)
                dupctr = dupctr + 1
            }
            id_seen[op_id] = "1"

            // Modell-wiring (additivt): rute knytt til modell via oppsett["rute_modell"].
            // oppsett["rute_modell"][op_id] = {"request": skjemanamn, "respons": skjemanamn}.
            la rm_req: tekst = ""
            la rm_resp: tekst = ""
            hvis finnes_nøkkel(oppsett, "rute_modell") {
                la rmap = oppsett["rute_modell"]
                hvis finnes_nøkkel(rmap, op_id) {
                    la rr = rmap[op_id]
                    hvis finnes_nøkkel(rr, "request") { rm_req = tekst(rr["request"]) }
                    hvis finnes_nøkkel(rr, "respons") { rm_resp = tekst(rr["respons"]) }
                }
            }

            // Tags: web.tags("x")-markørane i metadata vinn; elles tag per modul.
            la rute_tags: liste<tekst> = rute_meta_liste(handler, "tags")
            hvis lengde(rute_tags) == 0 { legg_til(rute_tags, _openapi_tag(funksjonsnamn)) }
            la tags_op: tekst = ""
            la tgi: heltall = 0
            mens tgi < lengde(rute_tags) {
                la tag = tekst(rute_tags[tgi])
                hvis ikkje finnes_nøkkel(tag_seen, tag) {
                    tag_seen[tag] = "1"
                    legg_til(tag_order, tag)
                }
                hvis tags_op != "" { tags_op = tags_op + "," }
                tags_op = tags_op + "\"" + _json_escape(tag) + "\""
                tgi = tgi + 1
            }

            // Parametrar: path (frå mønster) + query (frå metadata).
            la params_json: tekst = _openapi_path_params(raw_path)
            la qp = handler["query_params"]
            la pi: heltall = 0
            mens pi < lengde(qp) {
                la p: tekst = "{\"name\":\"" + _json_escape(tekst(qp[pi])) + "\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}}"
                hvis params_json == "" { params_json = p } ellers { params_json = params_json + "," + p }
                pi = pi + 1
            }

            // requestBody (body-felt).
            la bf = handler["body_fields"]
            la body_schema: tekst = ""
            la bi: heltall = 0
            mens bi < lengde(bf) {
                la f: tekst = "\"" + _json_escape(tekst(bf[bi])) + "\":{\"type\":\"string\"}"
                hvis body_schema == "" { body_schema = f } ellers { body_schema = body_schema + "," + f }
                bi = bi + 1
            }

            la op: tekst = "{\"operationId\":\"" + _json_escape(op_id) + "\",\"tags\":[" + tags_op + "]"
            // web.beskriving("...") → description; web.forelda() → deprecated (FA-097).
            la beskr: tekst = rute_meta_tekst(handler, "description")
            hvis beskr != "" { op = op + ",\"description\":\"" + _json_escape(beskr) + "\"" }
            hvis rute_meta_sann(handler, "deprecated") { op = op + ",\"deprecated\":true" }
            hvis params_json != "" { op = op + ",\"parameters\":[" + params_json + "]" }
            // Eksempel på requestBody frå oppsett["eksempel"][op_id] dersom gjeve.
            la body_example: tekst = ""
            hvis finnes_nøkkel(oppsett, "eksempel") {
                la eks = oppsett["eksempel"]
                hvis finnes_nøkkel(eks, op_id) { body_example = ",\"example\":" + tekst(eks[op_id]) }
            }
            hvis rm_req != "" {
                // Modell-referert requestBody ($ref til components/schemas).
                la ref_req = "{\"$ref\":\"#/components/schemas/" + _json_escape(rm_req) + "\"}"
                op = op + ",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":" + ref_req + body_example + "}}}"
            } ellers hvis body_schema != "" {
                op = op + ",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{" + body_schema + "}}" + body_example + "}}}"
            }

            // Respons: bruk response_schema/response_example frå NCB-metadata (FA-050).
            la resp_schema: tekst = _openapi_resp_json(handler["response_schema"], "{\"type\":\"string\"}")
            // Modell-referert respons overstyrer skjemaet med $ref (additivt).
            hvis rm_resp != "" { resp_schema = "{\"$ref\":\"#/components/schemas/" + _json_escape(rm_resp) + "\"}" }
            la resp_example: tekst = _openapi_resp_json(handler["response_example"], "\"eksempel\"")
            la responses_json: tekst = "\"200\":{\"description\":\"OK\",\"content\":{\"application/json\":{\"schema\":" + resp_schema + ",\"example\":" + resp_example + "}}}"
            // Statuskodar som alt er med: ein JSON-nøkkel kan berre finnast éin gong.
            la status_sett: ordbok_tekst = {}
            status_sett["200"] = "1"

            la errs = handler["error_responses"]
            la eri: heltall = 0
            mens eri < lengde(errs) {
                la er = errs[eri]
                la sc: tekst = tekst(er["status"])
                hvis ikkje finnes_nøkkel(status_sett, sc) {
                    status_sett[sc] = "1"
                    la sm: tekst = _json_escape(tekst(er["message"]))
                    responses_json = responses_json + ",\"" + _json_escape(sc) + "\":{\"description\":\"" + sm + "\",\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"type\":\"string\"}}}}}}"
                }
                eri = eri + 1
            }

            // web.respons("404", "Ikkje funne") → extra_responses (FA-059/100).
            la extras = rute_meta_liste(handler, "extra_responses")
            la xri: heltall = 0
            mens xri < lengde(extras) {
                la xr = extras[xri]
                la xs: tekst = ""
                la xd: tekst = ""
                prøv { xs = tekst(xr["status"]) } fang (e) { xs = "" }
                prøv { xd = tekst(xr["description"]) } fang (e) { xd = "" }
                hvis xs != "" og ikkje finnes_nøkkel(status_sett, xs) {
                    status_sett[xs] = "1"
                    hvis xd == "" { xd = _openapi_status_tekst(xs) }
                    responses_json = responses_json + ",\"" + _json_escape(xs) + "\":{\"description\":\"" + _json_escape(xd) + "\"}"
                }
                xri = xri + 1
            }

            la guards2 = handler["guards"]
            hvis lengde(guards2) > 0 {
                op = op + ",\"security\":[{\"bearerAuth\":[]}]"
                hvis ikkje finnes_nøkkel(status_sett, "401") {
                    status_sett["401"] = "1"
                    responses_json = responses_json + ",\"401\":{\"description\":\"Ikkje autentisert\"}"
                }
                hvis ikkje finnes_nøkkel(status_sett, "403") {
                    status_sett["403"] = "1"
                    responses_json = responses_json + ",\"403\":{\"description\":\"Forbudt\"}"
                }
                har_security = sann
            }
            op = op + ",\"responses\":{" + responses_json + "}}"

            // Slå saman i path-item for denne stien.
            la method_entry = "\"" + method + "\":" + op
            hvis finnes_nøkkel(path_ops, norm_path) {
                path_ops[norm_path] = path_ops[norm_path] + "," + method_entry
            } ellers {
                path_ops[norm_path] = method_entry
                legg_til(path_order, norm_path)
            }
        }
        i = i + 1
    }

    // Bygg paths-objektet i rekkefølgje.
    la paths: tekst = ""
    la poi: heltall = 0
    mens poi < lengde(path_order) {
        la pth = path_order[poi]
        la entry = "\"" + _json_escape(pth) + "\":{" + path_ops[pth] + "}"
        hvis paths == "" { paths = entry } ellers { paths = paths + "," + entry }
        poi = poi + 1
    }

    // info-objekt med valfri beskriving.
    la info: tekst = "\"title\":\"" + _json_escape(tittel) + "\",\"version\":\"" + _json_escape(versjon) + "\""
    hvis finnes_nøkkel(oppsett, "beskriving") {
        info = info + ",\"description\":\"" + _json_escape(tekst(oppsett["beskriving"])) + "\""
    }

    // Topp-nivå tags med valfri beskriving frå oppsett["tags"].
    la tags_json: tekst = ""
    la ti: heltall = 0
    mens ti < lengde(tag_order) {
        la tg = tag_order[ti]
        la te = "{\"name\":\"" + _json_escape(tg) + "\""
        hvis finnes_nøkkel(oppsett, "tags") {
            la tmap = oppsett["tags"]
            hvis finnes_nøkkel(tmap, tg) { te = te + ",\"description\":\"" + _json_escape(tekst(tmap[tg])) + "\"" }
        }
        te = te + "}"
        hvis tags_json == "" { tags_json = te } ellers { tags_json = tags_json + "," + te }
        ti = ti + 1
    }

    // components/schemas frå oppsett["modellar"] (modell.json_schema(m) per namn).
    la schemas_json: tekst = ""
    hvis finnes_nøkkel(oppsett, "modellar") {
        la mm = oppsett["modellar"]
        la mk = nøkler(mm)
        la mi: heltall = 0
        mens mi < lengde(mk) {
            la nm = mk[mi]
            la sj = _openapi_resp_json(mm[nm], "{\"type\":\"object\"}")
            la entry = "\"" + _json_escape(tekst(nm)) + "\":" + sj
            hvis schemas_json == "" { schemas_json = entry } ellers { schemas_json = schemas_json + "," + entry }
            mi = mi + 1
        }
    }

    la components_inner: tekst = ""
    hvis schemas_json != "" { components_inner = "\"schemas\":{" + schemas_json + "}" }
    hvis har_security {
        la sec = "\"securitySchemes\":{\"bearerAuth\":{\"type\":\"http\",\"scheme\":\"bearer\",\"bearerFormat\":\"JWT\"}}"
        hvis components_inner == "" { components_inner = sec } ellers { components_inner = components_inner + "," + sec }
    }
    la components: tekst = ""
    hvis components_inner != "" { components = ",\"components\":{" + components_inner + "}" }

    la ut: tekst = "{\"openapi\":\"3.1.0\",\"info\":{" + info + "},\"paths\":{" + paths + "}"
    hvis tags_json != "" { ut = ut + ",\"tags\":[" + tags_json + "]" }
    ut = ut + components + "}"
    returner ut
}

funksjon openapi_json(tittel: tekst, versjon: tekst) -> tekst {
    la oppsett: ordbok = {}
    oppsett["tittel"] = tittel
    oppsett["versjon"] = versjon
    returner openapi_json_med(oppsett)
}

// JS-fri dokumentasjonsside: ingen CDN-/ekstern JS (i tråd med sjølvstende).
// Ei rikare, interaktiv men framleis JS-fri docs-side kjem i Fase 1 (punkt 1.10).
funksjon docs_html(tittel: tekst, versjon: tekst) -> tekst {
    la spec = openapi_json(tittel, versjon)
    returner "<!doctype html><html><head><title>" + tittel + "</title></head><body><h1>" + tittel + "</h1><pre>" + spec + "</pre></body></html>"
}

# ─── Serverstart ───────────────────────────────────────────────────────────────

funksjon web_server_start(ruter: liste<tekst>, vert: tekst, port: heltall) -> heltall {
    skriv("═══════════════════════════════════════════════════════════════")
    skriv("Norscode HTTP-server")
    skriv("═══════════════════════════════════════════════════════════════")
    skriv("")
    skriv("Server: http://" + vert + ":" + tekst(port))
    skriv("Ruter:  " + tekst_fra_heltall(lengde(ruter)))
    skriv("")

    la fake_request = miljo_hent("NORSCODE_FAKE_HTTP_REQUEST")
    hvis fake_request != "" {
        la ctx = request_context("GET", "/", {}, {}, "")
        la resp = handle_request(ctx)
        skriv(response_text(resp))
        returner response_status(resp)
    }

    returner 0
}
