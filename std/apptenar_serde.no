# apptenar_serde.no — automatisk JSON-serialisering for apptenar-handlarar (Fase 1, 1.1)
#
# Gjer ein verdi frå ein handlar (ordbok, liste, struktur, primitiv) om til JSON:
#   - struktur/ordbok: interne nøklar som byrjar på "__" (t.d. __type__) blir fjerna;
#   - dato/datotid/tidspunkt (ordbøker med nøkkelen "type"): ISO-8601;
#   - desimal (fast-punkt): rett desimaltal, via den eksplisitte innpakkinga json_desimal();
#   - bytes: base64;
#   - tekst/heltall/desimaltall/boolsk/null: som i builtin.json_stringify.
#
# Rå desimal er i dag berre ei liste [mantisse, skala] på VM-nivå og kan ikkje skiljast
# frå ei vanleg liste. Pakk difor ein desimal inn med json_desimal(d) (eller legg rå JSON
# inn med json_rå(tekst)) når han ligg i ei svarordbok. Dato, datotid, tidspunkt og bytes
# blir attkjende automatisk.

bruk std.base64 som _b64
bruk std.desimal som _des
bruk std.tidspunkt som _tp

# ─── Eksplisitte innpakkingar (for verdiar serialisatoren ikkje kan kjenne att) ──

# Rå, ferdig JSON som blir lagt inn uendra.
funksjon json_rå(ferdig_json: tekst) -> ordbok {
    returner {"__rå_json__": ferdig_json}
}

# Ein desimal ([mantisse, skala]) som skal serialiserast som eit rett desimaltal.
funksjon json_desimal(d) -> ordbok {
    returner {"__desimal__": d}
}

# ─── Serialisering ───────────────────────────────────────────────────────────
#
# Heit veg for apptenar-svar i tolka Norscode: kvart funksjons- og builtin-kall kostar,
# så primitive verdiar i lister og ordbøker blir serialiserte direkte (utan rekursivt
# kall), og ferdige JSON-nøklar ("\"namn\":", eller "" for interne "__"-nøklar) blir
# cacha. Ordbøker med spesialnøklar ("__rå_json__", "__desimal__", "type") går den
# generelle vegen i _ser_spesial.

la _nk: ordbok = {}
la _nk_tal: ordbok = {"n": 0}

funksjon til_json(verdi) -> tekst {
    returner _ser(verdi, 0)
}

# Som til_json for ei ordbok på toppnivå når nøklane alt er henta (apptenar sin
# normaliser har dei). Same resultat som til_json(v); sparer type- og nøkler-kalla.
# Løkka er ein kopi av ordbok-greina i _ser (eit ekstra kall per nøsta ordbok ville
# kosta meir enn kopien).
funksjon ordbok_json(v, ks: liste) -> tekst {
    la n = lengde(ks)
    la nk = _nk
    la ut = "{"
    la først = sann
    la i = 0
    mens i < n {
        la k = ks[i]
        hvis k == "__rå_json__" eller k == "__desimal__" eller k == "type" { returner _ser_spesial(v, 0) }
        la kj = ""
        hvis har_nokkel(nk, k) { kj = nk[k] } ellers { kj = _nøkkel(k) }
        hvis kj != "" {
            la x = v[k]
            la xs = "null"
            hvis x != null {
                la xt = builtin.type(x)
                hvis xt != "ordbok" og xt != "liste" og xt != "bytes" {
                    xs = builtin.json_stringify(x)
                } ellers {
                    xs = _ser(x, 1)
                }
            }
            hvis først {
                ut = ut + kj + xs
                først = usann
            } ellers {
                ut = ut + "," + kj + xs
            }
        }
        i = i + 1
    }
    returner ut + "}"
}

funksjon _str(s: tekst) -> tekst {
    returner builtin.json_stringify(s)
}

# JSON-nøkkel med kolon, eller "" for interne nøklar som skal hoppast over.
funksjon _nøkkel(k: tekst) -> tekst {
    la kj = ""
    hvis ikkje builtin.starts_with(k, "__") { kj = builtin.json_stringify(k) + ":" }
    hvis _nk_tal["n"] < 1024 og lengde(k) <= 128 {
        _nk[k] = kj
        _nk_tal["n"] = _nk_tal["n"] + 1
    }
    returner kj
}

funksjon _ser(v, djup: heltall) -> tekst {
    hvis djup > 64 { kast "apptenar_serde: for djup nøsting" }
    hvis v == null { returner "null" }
    la t = builtin.type(v)
    hvis t == "bytes" { returner "\"" + _b64.kod_bytes(v) + "\"" }
    # Djupt nede går alt via _ser, så djupnegrensa slår til på same stad som før.
    la rask = djup < 64
    hvis t == "liste" {
        la ut = "["
        la n = lengde(v)
        la i = 0
        mens i < n {
            hvis i > 0 { ut = ut + "," }
            la x = v[i]
            hvis rask og x == null {
                ut = ut + "null"
            } ellers {
                la xt = "ordbok"
                hvis rask { xt = builtin.type(x) }
                hvis xt != "ordbok" og xt != "liste" og xt != "bytes" {
                    ut = ut + builtin.json_stringify(x)
                } ellers {
                    ut = ut + _ser(x, djup + 1)
                }
            }
            i = i + 1
        }
        returner ut + "]"
    }
    hvis t == "ordbok" {
        la ks = nøkler(v)
        la n = lengde(ks)
        la nk = _nk
        la ut = "{"
        la først = sann
        la i = 0
        mens i < n {
            la k = ks[i]
            hvis k == "__rå_json__" eller k == "__desimal__" eller k == "type" { returner _ser_spesial(v, djup) }
            la kj = ""
            hvis har_nokkel(nk, k) { kj = nk[k] } ellers { kj = _nøkkel(k) }
            hvis kj != "" {
                la x = v[k]
                la xs = "null"
                hvis rask og x == null {
                    xs = "null"
                } ellers {
                    la xt = "ordbok"
                    hvis rask { xt = builtin.type(x) }
                    hvis xt != "ordbok" og xt != "liste" og xt != "bytes" {
                        xs = builtin.json_stringify(x)
                    } ellers {
                        xs = _ser(x, djup + 1)
                    }
                }
                hvis først {
                    ut = ut + kj + xs
                    først = usann
                } ellers {
                    ut = ut + "," + kj + xs
                }
            }
            i = i + 1
        }
        returner ut + "}"
    }
    # Primitivar (tekst, heltall, desimaltall, boolsk) — builtin.json_stringify er rett
    returner builtin.json_stringify(v)
}

# Ordbøker med spesialnøklar: eksplisitte innpakkingar og dato/tid, elles generisk objekt.
funksjon _ser_spesial(v, djup: heltall) -> tekst {
    # Eksplisitte innpakkingar
    hvis har_nokkel(v, "__rå_json__") { returner tekst(v["__rå_json__"]) }
    hvis har_nokkel(v, "__desimal__") {
        prøv { returner _des.til_tekst(v["__desimal__"]) } fang (e) { returner "null" }
    }
    # Dato/datotid/tidspunkt (ordbøker med "type")
    hvis har_nokkel(v, "type") {
        la ty = tekst(v["type"])
        hvis ty == "Dato" { prøv { returner _str(_tp.dato_til_tekst(v)) } fang (e) { } }
        hvis ty == "Datotid" { prøv { returner _str(_tp.datotid_til_tekst(v)) } fang (e) { } }
        hvis ty == "Tidspunkt" { prøv { returner _str(_tp.tidspunkt_til_tekst(v)) } fang (e) { } }
    }
    # Generisk objekt: hopp over interne nøklar ("__…")
    la ut = "{"
    la ks = nøkler(v)
    la i = 0
    la først = sann
    mens i < lengde(ks) {
        la k = tekst(ks[i])
        hvis ikkje builtin.starts_with(k, "__") {
            hvis ikkje først { ut = ut + "," }
            ut = ut + _str(k) + ":" + _ser(v[ks[i]], djup + 1)
            først = usann
        }
        i = i + 1
    }
    returner ut + "}"
}
