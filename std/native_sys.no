// std/native_sys.no — plattformtabellar for dei native OS-vegane (F3.1 / X0.3, 2026-09-25).
//
// Alt OS-arbeid i std/native_gap.no går over éitt OS-atom per plattform (builtin.sys6 på
// Linux) og tek systemkallnummer, flagg, errno og struct-layout BERRE herifrå:
//   _nr("read")  _flagg("O_CLOEXEC")  _errno("EAGAIN")  _layout("rusage", "maxrss")
// Tabellen blir vald ved KØYRING via builtin.native_target() (konstant-atom i kvar codegen;
// VM-en svarar frå system_info), slik at nc_main-NCB-en blir byte-identisk på alle mål og
// NCB-fikspunktporten mellom seedane held (seeds-plan §3). Tabellar finst for
// "linux-x86_64" og "linux-arm64" (A2) og "macos-arm64" (M1); andre mål (windows-x86_64 = W3)
// kastar (fail-closed) i staden for å gje gjetta tal.
//
// Ukjende namn kastar òg: eit manglande oppslag skal aldri bli null → systemkall 0 (read).
// _har_nr() let kallaren hoppe over kall som ikkje finst på eit mål (t.d. open/creat/fork
// finst ikkje på linux-arm64) — brukt i seccomp-avslagslista. _nr_kompat() gjev ein
// erstatning med same argumentvektor for dei få kalla native_gap treng på alle mål
// (fork/dup2/epoll_wait; sjå _kompat_linux_arm64).
//
// Tabellane blir fylte lat ved første oppslag (modulglobalar; std.native_gap køyrer i AOT).

la _ns_mal = ""
la _ns_nr = {}
la _ns_flagg = {}
la _ns_errno = {}
la _ns_layout = {}
la _ns_kompat = {}

funksjon _ns_init() -> heiltall {
    hvis _ns_mal != "" { returner 0 }
    la m = tekst(builtin.native_target())
    hvis m == "linux-x86_64" {
        _ns_nr = _linux_x86_64_nr()
        _ns_flagg = _linux_x86_64_flagg()
        _ns_errno = _linux_errno()
        _ns_layout = _linux_x86_64_layout()
        _ns_kompat = {}
    } ellers hvis m == "linux-arm64" {
        _ns_nr = _linux_arm64_nr()
        _ns_flagg = _linux_arm64_flagg()
        _ns_errno = _linux_errno()
        _ns_layout = _linux_arm64_layout()
        _ns_kompat = _kompat_linux_arm64()
    } ellers hvis m == "macos-arm64" {
        _ns_nr = _macos_arm64_nr()
        _ns_flagg = _macos_arm64_flagg()
        _ns_errno = _macos_errno()
        _ns_layout = _macos_arm64_layout()
        _ns_kompat = _kompat_macos_arm64()
    } ellers {
        kast "native_sys: ingen systemtabell for mål «" + m + "»"
    }
    _ns_mal = m
    returner 0
}

// Plattformmålet tabellane er valde for ("linux-x86_64" | "linux-arm64" | "macos-arm64" | …).
funksjon mål() -> tekst {
    _ns_init()
    returner _ns_mal
}

funksjon _nr(namn: tekst) -> heiltall {
    _ns_init()
    hvis ikkje finnes_nøkkel(_ns_nr, namn) { kast "native_sys: ukjent systemkall «" + namn + "» for " + _ns_mal }
    returner _ns_nr[namn]
}

funksjon _har_nr(namn: tekst) -> boolsk {
    _ns_init()
    returner finnes_nøkkel(_ns_nr, namn)
}

// Systemkall som finst på målet, eller den dokumenterte erstatninga som tek SAME
// argumentvektor (kallaren sender alle seks argumenta; dei ekstra er 0 eller eit
// _flagg). Brukt der native_gap treng eit kall som ikkje finst på alle mål:
//   fork()              → linux-arm64: clone(SIGCHLD, 0, 0, 0, 0)   (a1 = _flagg("FORK_A1"))
//   dup2(a, b)          → linux-arm64: dup3(a, b, 0)                (a3 = 0)
//   epoll_wait(e,v,n,t) → linux-arm64: epoll_pwait(e,v,n,t,NULL,0)  (a5 = a6 = 0)
// Finst namnet sjølv (linux-x86_64), er svaret det vanlege nummeret; ukjent → kast.
funksjon _nr_kompat(namn: tekst) -> heiltall {
    _ns_init()
    hvis finnes_nøkkel(_ns_nr, namn) { returner _ns_nr[namn] }
    hvis finnes_nøkkel(_ns_kompat, namn) { returner _nr(_ns_kompat[namn]) }
    kast "native_sys: ukjent systemkall «" + namn + "» for " + _ns_mal + " (inga kompatibel erstatning)"
}

// Finst flagget på målet? (t.d. SO_NOSIGPIPE / F_SETNOSIGPIPE berre på Darwin)
funksjon _har_flagg(namn: tekst) -> boolsk {
    _ns_init()
    returner finnes_nøkkel(_ns_flagg, namn)
}

funksjon _flagg(namn: tekst) -> heiltall {
    _ns_init()
    hvis ikkje finnes_nøkkel(_ns_flagg, namn) { kast "native_sys: ukjent flagg «" + namn + "» for " + _ns_mal }
    returner _ns_flagg[namn]
}

// Positivt errno-tal. Rå systemkall gjev −errno (Linux; macOS-sys6 normaliserer til same form).
funksjon _errno(namn: tekst) -> heiltall {
    _ns_init()
    hvis ikkje finnes_nøkkel(_ns_errno, namn) { kast "native_sys: ukjent errno «" + namn + "» for " + _ns_mal }
    returner _ns_errno[namn]
}

// Struct-layout: offset (eller «storleik») for felt i ein kjerne-struct.
funksjon _layout(struktur: tekst, felt: tekst) -> heiltall {
    _ns_init()
    la k = struktur + "." + felt
    hvis ikkje finnes_nøkkel(_ns_layout, k) { kast "native_sys: ukjent layout «" + k + "» for " + _ns_mal }
    returner _ns_layout[k]
}

// ── linux-x86_64 ────────────────────────────────────────────────────────────────
// Kjelde: arch/x86/entry/syscalls/syscall_64.tbl (kjernen), asm-generic/errno*.h,
// uapi-headers for flagg og struct-ar. Berre det native_gap faktisk brukar.
funksjon _linux_x86_64_nr() -> ordbok {
    returner {
        "read": 0, "write": 1, "open": 2, "close": 3, "poll": 7, "mmap": 9, "mprotect": 10,
        "munmap": 11, "rt_sigprocmask": 14, "dup2": 33, "nanosleep": 35, "getpid": 39, "socket": 41,
        "connect": 42, "accept": 43, "sendto": 44, "recvfrom": 45, "shutdown": 48, "bind": 49,
        "listen": 50, "getsockname": 51, "setsockopt": 54, "fork": 57, "execve": 59,
        "exit": 60, "wait4": 61, "kill": 62, "fcntl": 72, "truncate": 76, "chdir": 80,
        "rename": 82, "mkdir": 83, "rmdir": 84, "creat": 85, "link": 86, "unlink": 87,
        "symlink": 88, "chmod": 90, "mknod": 133, "rt_sigtimedwait": 128,
        "prctl": 157, "gettid": 186, "futex": 202,
        "epoll_wait": 232, "epoll_ctl": 233, "openat": 257, "mkdirat": 258, "mknodat": 259,
        "unlinkat": 263, "renameat": 264, "linkat": 265, "symlinkat": 266, "fchmodat": 268,
        "ppoll": 271, "utimensat": 280, "epoll_create1": 291, "pipe2": 293, "renameat2": 316,
        "seccomp": 317, "getrandom": 318, "openat2": 437,
        // A5: fs_gap_* (native_fs-kontrakten over sys6, same namn som arm64-tabellen)
        "getdents64": 217, "newfstatat": 262
    }
}

funksjon _linux_x86_64_flagg() -> ordbok {
    returner {
        // open/fcntl (asm-generic/fcntl.h; x86-64 har ingen eigne avvik)
        "O_WRONLY": 1, "O_RDWR": 2, "O_CREAT": 64, "O_TRUNC": 512, "O_NONBLOCK": 2048,
        "O_CLOEXEC": 524288, "F_GETFL": 3, "F_SETFL": 4,
        // Desse fire skil seg på arm64 (arch/arm64/include/uapi/asm/fcntl.h), sjå
        // _linux_arm64_flagg; tests/test_native_sys_tabellar.no pinnar begge.
        "O_DIRECT": 16384, "O_LARGEFILE": 32768, "O_DIRECTORY": 65536, "O_NOFOLLOW": 131072,
        "AT_FDCWD": 0 - 100,
        // A5: *at-flagg og d_type for fs_gap_* (asm-generic/fcntl.h, linux/fcntl.h, dirent.h;
        // like på x86-64 og arm64)
        "AT_REMOVEDIR": 512, "AT_SYMLINK_NOFOLLOW": 256, "DT_DIR": 4, "DT_REG": 8, "DT_LNK": 10,
        // mmap/mprotect
        "PROT_READ": 1, "PROT_WRITE": 2, "PROT_EXEC": 4, "MAP_PRIVATE": 2, "MAP_ANONYMOUS": 32,
        // prosess/signal
        "WNOHANG": 1, "SIGKILL": 9, "SIGUSR1": 10, "SIGPIPE": 13, "SIGTERM": 15, "SIGCHLD": 17,
        "SIG_BLOCK": 0, "SIG_UNBLOCK": 1, "SIG_SETMASK": 2,
        // clone(2) for native trådar: CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD
        "CLONE_TRAAD": 69376,
        // a1 til _nr_kompat("fork"): fork(2) les ingen argument, so 0 (registeridentisk med før)
        "FORK_A1": 0,
        // sokkel
        "AF_UNIX": 1, "AF_INET": 2, "SOCK_STREAM": 1, "SOCK_DGRAM": 2, "SOL_SOCKET": 1,
        "SO_REUSEADDR": 2, "SO_RCVTIMEO": 20, "SO_SNDTIMEO": 21, "MSG_NOSIGNAL": 16384,
        "SHUT_RDWR": 2,
        // epoll/poll
        "EPOLL_CLOEXEC": 524288, "EPOLL_CTL_ADD": 1, "EPOLL_CTL_DEL": 2, "EPOLL_CTL_MOD": 3,
        "EPOLLIN": 1, "EPOLLOUT": 4, "EPOLLERR": 8, "EPOLLHUP": 16,
        "POLLIN": 1, "POLLOUT": 4, "POLLERR": 8, "POLLHUP": 16, "POLLNVAL": 32,
        // futex
        "FUTEX_WAIT": 0, "FUTEX_WAKE": 1,
        // seccomp-BPF (sandkasse)
        "PR_SET_NO_NEW_PRIVS": 38, "SECCOMP_SET_MODE_FILTER": 1, "AUDIT_ARCH": 3221225534,
        "SECCOMP_RET_KILL_PROCESS": 2147483648, "SECCOMP_RET_ERRNO": 327680,
        "SECCOMP_RET_ALLOW": 2147418112, "BPF_LD_W_ABS": 32, "BPF_JEQ_K": 21,
        "BPF_JSET_K": 69, "BPF_RET_K": 6
    }
}

funksjon _linux_errno() -> ordbok {
    returner {"EPERM": 1, "EINTR": 4, "EAGAIN": 11, "EEXIST": 17, "EINVAL": 22, "EPIPE": 32, "ETIMEDOUT": 110}
}

funksjon _linux_x86_64_layout() -> ordbok {
    returner {
        // struct sockaddr_in: family u16 (LE) @0, port u16 (BE) @2, addr @4; «len» -1 = finst ikkje
        "sockaddr_in.storleik": 16, "sockaddr_in.len": -1, "sockaddr_in.family": 0,
        "sockaddr_in.port": 2, "sockaddr_in.addr": 4,
        // struct epoll_event er PAKKA på x86-64: u32 events @0, u64 data @4 (12 byte)
        "epoll_event.storleik": 12, "epoll_event.events": 0, "epoll_event.data": 4,
        // struct pollfd: i32 fd @0, i16 events @4, i16 revents @6
        "pollfd.storleik": 8, "pollfd.fd": 0, "pollfd.events": 4, "pollfd.revents": 6,
        "timespec.storleik": 16, "timespec.sec": 0, "timespec.nsec": 8,
        "timeval.storleik": 16, "timeval.sec": 0, "timeval.usec": 8,
        // struct rusage: ru_maxrss @32 i KiB (skala 1024 → byte)
        "rusage.storleik": 144, "rusage.maxrss": 32, "rusage.maxrss_skala": 1024,
        // struct seccomp_data: nr @0, arch @4, args[6] @16 (8 byte kvar)
        "seccomp_data.nr": 0, "seccomp_data.arch": 4, "seccomp_data.args": 16,
        // struct sock_fprog: u16 len @0, filter-peikar @8
        "sock_fprog.storleik": 16, "sock_fprog.len": 0, "sock_fprog.filter": 8,
        "sigset.storleik": 8, "wstatus.storleik": 8,
        // A5: struct stat (arch/x86/include/uapi/asm/stat.h): nlink er u64 @16, mode u32 @24
        "stat.storleik": 144, "stat.dev": 0, "stat.dev_breidd": 8, "stat.ino": 8, "stat.nlink": 16,
        "stat.nlink_breidd": 8, "stat.mode": 24, "stat.mode_breidd": 4, "stat.uid": 28, "stat.gid": 32, "stat.size": 48, "stat.atime": 72,
        "stat.mtime": 88, "stat.ctime": 104,
        // struct linux_dirent64: d_ino @0, d_off @8, d_reclen u16 @16, d_type u8 @18, d_name @19
        "dirent64.reclen": 16, "dirent64.type": 18, "dirent64.name": 19
    }
}

// ── linux-arm64 (A2) ────────────────────────────────────────────────────────────
// Kjelde: include/uapi/asm-generic/unistd.h (den generiske syscall-ABI-en arm64 brukar;
// 64-bit, so __NR_ppoll = 73 og ikkje _time64-variantane), asm-generic/errno*.h,
// asm-generic/fcntl.h, asm-generic/socket.h, uapi/linux/audit.h. Syscall-ABI: x8 = nr,
// x0..x5 = argument, `svc #0`, x0 = resultat eller −errno (same form som x86-64).
// Finst IKKJE på arm64 (berre __ARCH_WANT_*-gamle kall): open, poll, dup2, fork,
// epoll_wait, creat, link, unlink, symlink, chmod, mkdir, rmdir, rename, mknod, pipe —
// native_gap brukar openat/ppoll/pipe2/…at-variantane, _har_nr() for seccomp-lista og
// _nr_kompat() for fork/dup2/epoll_wait.
funksjon _linux_arm64_nr() -> ordbok {
    returner {
        "read": 63, "write": 64, "close": 57, "ppoll": 73, "pselect6": 72, "mmap": 222,
        "mprotect": 226, "munmap": 215, "rt_sigprocmask": 135, "dup3": 24, "nanosleep": 101,
        "getpid": 172, "socket": 198, "connect": 203, "accept": 202, "accept4": 242,
        "sendto": 206, "recvfrom": 207, "shutdown": 210, "bind": 200, "listen": 201,
        "getsockname": 204, "setsockopt": 208, "clone": 220, "execve": 221, "exit": 93,
        "exit_group": 94, "wait4": 260, "kill": 129, "fcntl": 25, "truncate": 45, "chdir": 49,
        "rt_sigtimedwait": 137, "prctl": 167, "gettid": 178, "futex": 98,
        "epoll_pwait": 22, "epoll_ctl": 21, "epoll_create1": 20, "openat": 56, "mkdirat": 34,
        "mknodat": 33, "unlinkat": 35, "renameat": 38, "linkat": 37, "symlinkat": 36,
        "fchmodat": 53, "utimensat": 88, "pipe2": 59, "renameat2": 276, "seccomp": 277,
        "openat2": 437, "getrandom": 278, "uname": 160, "getcwd": 17, "readlinkat": 78,
        "getdents64": 61, "newfstatat": 79, "clock_gettime": 113, "sched_yield": 124
    }
}

// Namn → erstatning med same argumentvektor (sjå _nr_kompat).
funksjon _kompat_linux_arm64() -> ordbok {
    returner {"fork": "clone", "dup2": "dup3", "epoll_wait": "epoll_pwait"}
}

funksjon _linux_arm64_flagg() -> ordbok {
    // Eigen, fullt utskriven tabell (ikkje arva frå x86-64): ein ny nøkkel i x86-tabellen
    // skal ALDRI lekke hit med x86-verdien. Manglar ein nøkkel her, kastar _flagg()
    // (fail-closed), og tests/test_native_sys_tabellar.no krev at nøkkelsetta er like og
    // pinnar kvar verdi literalt. Kjelder: asm-generic/fcntl.h + arch/arm64/include/uapi/
    // asm/fcntl.h, asm-generic/mman-common.h, signal.h, socket.h, eventpoll.h, poll.h,
    // uapi/linux/futex.h, seccomp.h, filter.h, audit.h.
    returner {
        // open/fcntl: dei generiske verdiane
        "O_WRONLY": 1, "O_RDWR": 2, "O_CREAT": 64, "O_TRUNC": 512, "O_NONBLOCK": 2048,
        "O_CLOEXEC": 524288, "F_GETFL": 3, "F_SETFL": 4,
        // arm64 sine EIGNE fcntl-verdiar (arch/arm64/include/uapi/asm/fcntl.h), ulike x86-64:
        // O_DIRECTORY 040000, O_NOFOLLOW 0100000, O_DIRECT 0200000, O_LARGEFILE 0400000.
        "O_DIRECTORY": 16384, "O_NOFOLLOW": 32768, "O_DIRECT": 65536, "O_LARGEFILE": 131072,
        "AT_FDCWD": 0 - 100,
        // A5: *at-flagg og d_type for fs_gap_* (asm-generic/fcntl.h, linux/fcntl.h, dirent.h;
        // like på x86-64 og arm64)
        "AT_REMOVEDIR": 512, "AT_SYMLINK_NOFOLLOW": 256, "DT_DIR": 4, "DT_REG": 8, "DT_LNK": 10,
        // mmap/mprotect
        "PROT_READ": 1, "PROT_WRITE": 2, "PROT_EXEC": 4, "MAP_PRIVATE": 2, "MAP_ANONYMOUS": 32,
        // prosess/signal
        "WNOHANG": 1, "SIGKILL": 9, "SIGUSR1": 10, "SIGPIPE": 13, "SIGTERM": 15, "SIGCHLD": 17,
        "SIG_BLOCK": 0, "SIG_UNBLOCK": 1, "SIG_SETMASK": 2,
        // clone(2) for native trådar: CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD
        "CLONE_TRAAD": 69376,
        // clone(flags=SIGCHLD, stack=0, ptid=0, tls=0, ctid=0) = fork(2) (sjå _nr_kompat)
        "FORK_A1": 17,
        // sokkel
        "AF_UNIX": 1, "AF_INET": 2, "SOCK_STREAM": 1, "SOCK_DGRAM": 2, "SOL_SOCKET": 1,
        "SO_REUSEADDR": 2, "SO_RCVTIMEO": 20, "SO_SNDTIMEO": 21, "MSG_NOSIGNAL": 16384,
        "SHUT_RDWR": 2,
        // epoll/poll
        "EPOLL_CLOEXEC": 524288, "EPOLL_CTL_ADD": 1, "EPOLL_CTL_DEL": 2, "EPOLL_CTL_MOD": 3,
        "EPOLLIN": 1, "EPOLLOUT": 4, "EPOLLERR": 8, "EPOLLHUP": 16,
        "POLLIN": 1, "POLLOUT": 4, "POLLERR": 8, "POLLHUP": 16, "POLLNVAL": 32,
        // futex
        "FUTEX_WAIT": 0, "FUTEX_WAKE": 1,
        // seccomp-BPF (sandkasse). AUDIT_ARCH_AARCH64 = EM_AARCH64 (183 = 0xB7) |
        // __AUDIT_ARCH_64BIT | __AUDIT_ARCH_LE = 0xC00000B7.
        "PR_SET_NO_NEW_PRIVS": 38, "SECCOMP_SET_MODE_FILTER": 1, "AUDIT_ARCH": 3221225655,
        "SECCOMP_RET_KILL_PROCESS": 2147483648, "SECCOMP_RET_ERRNO": 327680,
        "SECCOMP_RET_ALLOW": 2147418112, "BPF_LD_W_ABS": 32, "BPF_JEQ_K": 21,
        "BPF_JSET_K": 69, "BPF_RET_K": 6
    }
}

funksjon _linux_arm64_layout() -> ordbok {
    // Eigen, fullt utskriven tabell (ikkje arva frå x86-64; sjå _linux_arm64_flagg).
    returner {
        // struct sockaddr_in: family u16 (LE) @0, port u16 (BE) @2, addr @4; «len» -1 = finst ikkje
        "sockaddr_in.storleik": 16, "sockaddr_in.len": -1, "sockaddr_in.family": 0,
        "sockaddr_in.port": 2, "sockaddr_in.addr": 4,
        // struct epoll_event er IKKJE pakka på arm64 (EPOLL_PACKED berre på x86-64):
        // u32 events @0, 4 byte fyll, u64 data @8 (16 byte).
        "epoll_event.storleik": 16, "epoll_event.events": 0, "epoll_event.data": 8,
        // struct pollfd: i32 fd @0, i16 events @4, i16 revents @6
        "pollfd.storleik": 8, "pollfd.fd": 0, "pollfd.events": 4, "pollfd.revents": 6,
        "timespec.storleik": 16, "timespec.sec": 0, "timespec.nsec": 8,
        "timeval.storleik": 16, "timeval.sec": 0, "timeval.usec": 8,
        // struct rusage: ru_maxrss @32 i KiB (skala 1024 → byte)
        "rusage.storleik": 144, "rusage.maxrss": 32, "rusage.maxrss_skala": 1024,
        // struct seccomp_data: nr @0, arch @4, args[6] @16 (8 byte kvar)
        "seccomp_data.nr": 0, "seccomp_data.arch": 4, "seccomp_data.args": 16,
        // struct sock_fprog: u16 len @0, filter-peikar @8
        "sock_fprog.storleik": 16, "sock_fprog.len": 0, "sock_fprog.filter": 8,
        "sigset.storleik": 8, "wstatus.storleik": 8,
        // A5: struct stat (asm-generic/stat.h): mode u32 @16, nlink u32 @20, uid @24, gid @28
        "stat.storleik": 128, "stat.dev": 0, "stat.dev_breidd": 8, "stat.ino": 8, "stat.nlink": 20,
        "stat.nlink_breidd": 4, "stat.mode": 16, "stat.mode_breidd": 4, "stat.uid": 24, "stat.gid": 28, "stat.size": 48, "stat.atime": 72,
        "stat.mtime": 88, "stat.ctime": 104,
        // struct linux_dirent64: d_ino @0, d_off @8, d_reclen u16 @16, d_type u8 @18, d_name @19
        "dirent64.reclen": 16, "dirent64.type": 18, "dirent64.name": 19
    }
}


// ── macos-arm64 (M1) ────────────────────────────────────────────────────────────
// Kjelde: xnu bsd/kern/syscalls.master (BSD-kall; svc #0x80 med x16 = nr, carry = feil,
// og codegen-sys6 normaliserer til −errno som på Linux), bsd/sys/{fcntl,mman,signal,
// socket,poll,errno,wait,stat,dirent,ulock}.h, bsd/netinet/in.h. Darwin-ABI-en skil seg frå
// Linux på fleire punkt native_gap tek omsyn til:
//   * pipe (#42) og fork (#2) svarar i x0/x1 — codegen-sys6 gjer pipe om til int[2] i [a1]
//     (som pipe2) og fork til 0 i barnet; det finst ingen pipe2, so O_CLOEXEC blir sett med
//     fcntl(F_SETFD, FD_CLOEXEC), og F_SETNOSIGPIPE erstattar SIGPIPE-maskinga;
//   * ingen ppoll/epoll/futex/seccomp/prctl/rt_sig*: poll(2) med ms-tidsgrense, poll i
//     staden for epoll, __ulock_wait/__ulock_wake for futex; sandkasseprofilar (seccomp)
//     finst ikkje (Seatbelt krev libsandbox) og blir avviste (fail-closed);
//   * ingen MSG_NOSIGNAL (= 0 her): sokkelen får SO_NOSIGPIPE i staden;
//   * sockaddr_in har ein lengd-byte (@0) og family er u8 (@1); struct stat (64-bit-inodar,
//     fstatat64) har dev u32, mode u16, nlink u16; rusage.maxrss er i byte.
// _kompat_macos_arm64 gjev kall med SAME argumentvektor under Linux-namna native_gap brukar
// (getdents64 → getdirentries64 med basep som 4. argument, newfstatat → fstatat64,
// gettid → thread_selfid; pipe2 → pipe, der codegenen sin sys6 skriv fd-paret til adressa i
// a1 og flagg-argumentet blir ignorert — native_gap set FD_CLOEXEC sjølv; rt_sigprocmask →
// sigprocmask(how, set, oset), der sigset-storleiken (4. argument) blir ignorert).
funksjon _macos_arm64_nr() -> ordbok {
    returner {
        "exit": 1, "fork": 2, "read": 3, "write": 4, "open": 5, "close": 6, "wait4": 7,
        "unlink": 10, "chdir": 12, "chmod": 15, "getpid": 20, "recvfrom": 29, "accept": 30,
        "getsockname": 32, "kill": 37, "pipe": 42, "sigaction": 46, "sigprocmask": 48,
        "symlink": 57, "readlink": 58, "execve": 59, "munmap": 73, "mprotect": 74, "dup2": 90,
        "fcntl": 92, "socket": 97, "connect": 98, "bind": 104, "setsockopt": 105, "listen": 106,
        "gettimeofday": 116, "getsockopt": 118, "rename": 128, "sendto": 133, "shutdown": 134,
        "socketpair": 135, "mkdir": 136, "rmdir": 137, "mmap": 197, "lseek": 199, "sysctl": 202,
        "poll": 230, "proc_info": 336, "stat64": 338, "fstat64": 339, "lstat64": 340,
        "getdirentries64": 344, "kqueue": 362, "kevent": 363, "thread_selfid": 372,
        "openat": 463, "renameat": 465, "fchmodat": 467, "fstatat64": 470, "unlinkat": 472,
        "readlinkat": 473, "symlinkat": 474, "mkdirat": 475, "getentropy": 500,
        "ulock_wait": 515, "ulock_wake": 516
    }
}

funksjon _kompat_macos_arm64() -> ordbok {
    returner {"getdents64": "getdirentries64", "newfstatat": "fstatat64", "gettid": "thread_selfid",
              "pipe2": "pipe", "rt_sigprocmask": "sigprocmask"}
}

funksjon _macos_arm64_flagg() -> ordbok {
    returner {
        // open/fcntl (bsd/sys/fcntl.h)
        "O_WRONLY": 1, "O_RDWR": 2, "O_NONBLOCK": 4, "O_APPEND": 8, "O_CREAT": 512,
        "O_TRUNC": 1024, "O_EXCL": 2048, "O_NOFOLLOW": 256, "O_DIRECTORY": 1048576,
        "O_CLOEXEC": 16777216, "F_GETFD": 1, "F_SETFD": 2, "F_GETFL": 3, "F_SETFL": 4,
        "FD_CLOEXEC": 1, "F_GETPATH": 50, "F_SETNOSIGPIPE": 73,
        "AT_FDCWD": 0 - 2, "AT_SYMLINK_NOFOLLOW": 32, "AT_REMOVEDIR": 128,
        "DT_DIR": 4, "DT_REG": 8, "DT_LNK": 10,
        // mmap/mprotect (bsd/sys/mman.h): MAP_ANON = 0x1000, MAP_JIT = 0x800
        "PROT_READ": 1, "PROT_WRITE": 2, "PROT_EXEC": 4, "MAP_PRIVATE": 2, "MAP_ANONYMOUS": 4096,
        "MAP_JIT": 2048,
        // prosess/signal (bsd/sys/signal.h, wait.h): SIGUSR1 = 30, SIGCHLD = 20, SIG_BLOCK = 1
        "WNOHANG": 1, "SIGKILL": 9, "SIGUSR1": 30, "SIGPIPE": 13, "SIGTERM": 15, "SIGCHLD": 20,
        "SIG_BLOCK": 1, "SIG_UNBLOCK": 2, "SIG_SETMASK": 3,
        // fork(2) les ingen argument (a1 til _nr_kompat("fork"))
        "FORK_A1": 0,
        // sokkel (bsd/sys/socket.h): SOL_SOCKET = 0xFFFF, SO_* 0x10xx, ingen MSG_NOSIGNAL
        "AF_UNIX": 1, "AF_INET": 2, "SOCK_STREAM": 1, "SOCK_DGRAM": 2, "SOL_SOCKET": 65535,
        "SO_REUSEADDR": 4, "SO_SNDTIMEO": 4101, "SO_RCVTIMEO": 4102, "SO_ERROR": 4103,
        "SO_NOSIGPIPE": 4130, "MSG_NOSIGNAL": 0, "SHUT_RDWR": 2,
        // poll (bsd/sys/poll.h)
        "POLLIN": 1, "POLLOUT": 4, "POLLERR": 8, "POLLHUP": 16, "POLLNVAL": 32,
        // __ulock_wait/__ulock_wake (bsd/sys/ulock.h)
        "UL_COMPARE_AND_WAIT": 1, "ULF_WAKE_ALL": 256
    }
}

funksjon _macos_errno() -> ordbok {
    returner {"EPERM": 1, "EINTR": 4, "EAGAIN": 35, "EEXIST": 17, "EINVAL": 22, "EPIPE": 32, "ETIMEDOUT": 60}
}

funksjon _macos_arm64_layout() -> ordbok {
    returner {
        // struct sockaddr_in: sin_len u8 @0, sin_family u8 @1, port u16 (BE) @2, addr @4
        "sockaddr_in.storleik": 16, "sockaddr_in.len": 0, "sockaddr_in.family": 1,
        "sockaddr_in.port": 2, "sockaddr_in.addr": 4,
        // struct pollfd: i32 fd @0, i16 events @4, i16 revents @6
        "pollfd.storleik": 8, "pollfd.fd": 0, "pollfd.events": 4, "pollfd.revents": 6,
        "timespec.storleik": 16, "timespec.sec": 0, "timespec.nsec": 8,
        // struct timeval: tv_sec i64 @0, tv_usec i32 @8 (+ 4 byte fyll)
        "timeval.storleik": 16, "timeval.sec": 0, "timeval.usec": 8,
        // struct rusage: ru_maxrss @32 er i BYTE på Darwin (skala 1)
        "rusage.storleik": 144, "rusage.maxrss": 32, "rusage.maxrss_skala": 1,
        // sigset_t er u32
        "sigset.storleik": 4, "wstatus.storleik": 8,
        // struct stat (64-bit inodar, fstatat64): dev u32 @0, mode u16 @4, nlink u16 @6,
        // ino u64 @8, uid @16, gid @20, atime @32, mtime @48, ctime @64, size @96
        "stat.storleik": 144, "stat.dev": 0, "stat.dev_breidd": 4, "stat.mode": 4,
        "stat.mode_breidd": 2, "stat.nlink": 6, "stat.nlink_breidd": 2, "stat.ino": 8,
        "stat.uid": 16, "stat.gid": 20, "stat.size": 96, "stat.atime": 32, "stat.mtime": 48,
        "stat.ctime": 64,
        // struct direntry (getdirentries64): d_ino u64 @0, d_seekoff u64 @8, d_reclen u16 @16,
        // d_namlen u16 @18, d_type u8 @20, d_name @21
        "dirent64.reclen": 16, "dirent64.type": 20, "dirent64.name": 21
    }
}
