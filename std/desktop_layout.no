# Desktop layout v1: pure Norscode layout validation and deterministic geometry.
# Headless; actual native rendering remains a separate OS backend.
funksjon nytt_panel(id: tekst, x: heiltall, y: heiltall, breidde: heiltall, hogde: heiltall) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["id"] = id
    p["x"] = tekst_fra_heltall(x)
    p["y"] = tekst_fra_heltall(y)
    p["width"] = tekst_fra_heltall(breidde)
    p["height"] = tekst_fra_heltall(hogde)
    p["valid"] = "usann"
    hvis id != "" og x >= 0 og y >= 0 og breidde > 0 og hogde > 0 og breidde <= 16384 og hogde <= 16384 {
        hvis x + breidde <= 16384 og y + hogde <= 16384 { p["valid"] = "sann" }
    }
    returner p
}

funksjon innanfor(ytre: ordbok_tekst, indre: ordbok_tekst) -> bool {
    hvis ytre["valid"] != "sann" eller indre["valid"] != "sann" { returner usann }
    la x1 = heltall_fra_tekst(ytre["x"])
    la y1 = heltall_fra_tekst(ytre["y"])
    la x2 = heltall_fra_tekst(indre["x"])
    la y2 = heltall_fra_tekst(indre["y"])
    returner x2 >= x1 og y2 >= y1 og x2 + heltall_fra_tekst(indre["width"]) <= x1 + heltall_fra_tekst(ytre["width"]) og y2 + heltall_fra_tekst(indre["height"]) <= y1 + heltall_fra_tekst(ytre["height"])
}

funksjon del_vassrett(panel: ordbok_tekst, venstre_breidde: heiltall) -> liste<ordbok_tekst> {
    la ut: liste<ordbok_tekst> = []
    hvis panel["valid"] != "sann" { returner ut }
    la w = heltall_fra_tekst(panel["width"])
    hvis venstre_breidde <= 0 eller venstre_breidde >= w { returner ut }
    la x = heltall_fra_tekst(panel["x"])
    la y = heltall_fra_tekst(panel["y"])
    la h = heltall_fra_tekst(panel["height"])
    legg_til(ut, nytt_panel(panel["id"] + ".left", x, y, venstre_breidde, h))
    legg_til(ut, nytt_panel(panel["id"] + ".right", x + venstre_breidde, y, w - venstre_breidde, h))
    returner ut
}

funksjon del_loddrett(panel: ordbok_tekst, topp_hogde: heiltall) -> liste<ordbok_tekst> {
    la ut: liste<ordbok_tekst> = []
    hvis panel["valid"] != "sann" { returner ut }
    la h = heltall_fra_tekst(panel["height"])
    hvis topp_hogde <= 0 eller topp_hogde >= h { returner ut }
    la x = heltall_fra_tekst(panel["x"])
    la y = heltall_fra_tekst(panel["y"])
    la w = heltall_fra_tekst(panel["width"])
    legg_til(ut, nytt_panel(panel["id"] + ".top", x, y, w, topp_hogde))
    legg_til(ut, nytt_panel(panel["id"] + ".bottom", x, y + topp_hogde, w, h - topp_hogde))
    returner ut
}
