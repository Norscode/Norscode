# argon2id.no - RFC 9106 Argon2id eigd av Norscode.
# Native implementasjon er ein eksplisitt, valfri adapter og aldri skjult standard.

bruk std.argon2id_pure som pure

funksjon hash(passord: tekst, salt: tekst, minne_kib: heiltall,
             iterasjonar: heiltall, parallellisme: heiltall,
             lengde_bytes: heiltall) -> tekst {
    returner pure.hash_pure(passord, salt, minne_kib, iterasjonar, parallellisme, lengde_bytes)
}

funksjon hash_native_adapter(passord: tekst, salt: tekst, minne_kib: heiltall,
                             iterasjonar: heiltall, parallellisme: heiltall,
                             lengde_bytes: heiltall) -> tekst {
    hvis lengde(salt) < 8 { kast "Argon2idFeil: salt må vere minst 8 byte" }
    returner builtin.argon2id(passord, salt, minne_kib, iterasjonar, parallellisme, lengde_bytes)
}

funksjon verifiser(passord: tekst, salt: tekst, minne_kib: heiltall,
                  iterasjonar: heiltall, parallellisme: heiltall,
                  forventa: tekst) -> boolsk {
    prøv {
        la faktisk = hash(passord, salt, minne_kib, iterasjonar, parallellisme,
                          lengde(forventa) / 2)
        returner pure.konstanttid_lik(faktisk, builtin.lower(forventa))
    } fang (e) { returner usann }
    returner usann
}

funksjon status() -> ordbok_tekst {
    returner {"abi": "norscode-argon2id-v2", "status": "pure-standard", "standard": "RFC 9106", "native": "explicit-optional-adapter"}
}
