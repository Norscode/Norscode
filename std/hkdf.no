# hkdf.no - rein Norscode HKDF (RFC 5869) over HMAC-SHA256.
bruk std.sha256 som sha

funksjon _hash_len() -> heiltall { returner 32 }

funksjon _kopier(a: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(a) { legg_til(ut, a[i]) i = i + 1 }
    returner ut
}

funksjon _saman(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut = _kopier(a)
    la i: heiltall = 0
    mens i < lengde(b) { legg_til(ut, b[i]) i = i + 1 }
    returner ut
}

funksjon _nullbytes(n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < n { legg_til(ut, 0) i = i + 1 }
    returner ut
}

funksjon extract(salt: liste_heiltall, ikm: liste_heiltall) -> liste_heiltall {
    la s = salt
    hvis lengde(s) == 0 { s = _nullbytes(_hash_len()) }
    returner sha.hmac_sha256_bytes(s, ikm)
}

funksjon expand(prk: liste_heiltall, info: liste_heiltall, lengde_ut: heiltall) -> liste_heiltall {
    hvis lengde_ut < 0 { kast "HKDFFeil: negativ lengde" }
    hvis lengde_ut > 255 * _hash_len() { kast "HKDFFeil: L for stor" }
    la ut: liste_heiltall = []
    la forrige: liste_heiltall = []
    la teljar: heiltall = 1
    mens lengde(ut) < lengde_ut {
        la melding = _kopier(forrige)
        melding = _saman(melding, info)
        legg_til(melding, teljar & 255)
        forrige = sha.hmac_sha256_bytes(prk, melding)
        la j: heiltall = 0
        mens j < lengde(forrige) og lengde(ut) < lengde_ut {
            legg_til(ut, forrige[j])
            j = j + 1
        }
        teljar = teljar + 1
    }
    returner ut
}

funksjon hkdf(salt: liste_heiltall, ikm: liste_heiltall, info: liste_heiltall, lengde_ut: heiltall) -> liste_heiltall {
    returner expand(extract(salt, ikm), info, lengde_ut)
}

funksjon status() {
    returner { "abi": "norscode-hkdf-v1", "hash": "sha256", "hash_len": _hash_len() }
}
