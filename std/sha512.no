# sha512.no - rein Norscode SHA-512 (FIPS 180-4).
# 64-bit ord er representert som [hi32, lo32] for usignert semantikk i VM.

funksjon _K() -> liste_heiltall { returner [
        1116352408, 3609767458, 1899447441, 602891725, 3049323471, 3964484399, 3921009573, 2173295548,
        961987163, 4081628472, 1508970993, 3053834265, 2453635748, 2937671579, 2870763221, 3664609560,
        3624381080, 2734883394, 310598401, 1164996542, 607225278, 1323610764, 1426881987, 3590304994,
        1925078388, 4068182383, 2162078206, 991336113, 2614888103, 633803317, 3248222580, 3479774868,
        3835390401, 2666613458, 4022224774, 944711139, 264347078, 2341262773, 604807628, 2007800933,
        770255983, 1495990901, 1249150122, 1856431235, 1555081692, 3175218132, 1996064986, 2198950837,
        2554220882, 3999719339, 2821834349, 766784016, 2952996808, 2566594879, 3210313671, 3203337956,
        3336571891, 1034457026, 3584528711, 2466948901, 113926993, 3758326383, 338241895, 168717936,
        666307205, 1188179964, 773529912, 1546045734, 1294757372, 1522805485, 1396182291, 2643833823,
        1695183700, 2343527390, 1986661051, 1014477480, 2177026350, 1206759142, 2456956037, 344077627,
        2730485921, 1290863460, 2820302411, 3158454273, 3259730800, 3505952657, 3345764771, 106217008,
        3516065817, 3606008344, 3600352804, 1432725776, 4094571909, 1467031594, 275423344, 851169720,
        430227734, 3100823752, 506948616, 1363258195, 659060556, 3750685593, 883997877, 3785050280,
        958139571, 3318307427, 1322822218, 3812723403, 1537002063, 2003034995, 1747873779, 3602036899,
        1955562222, 1575990012, 2024104815, 1125592928, 2227730452, 2716904306, 2361852424, 442776044,
        2428436474, 593698344, 2756734187, 3733110249, 3204031479, 2999351573, 3329325298, 3815920427,
        3391569614, 3928383900, 3515267271, 566280711, 3940187606, 3454069534, 4118630271, 4000239992,
        116418474, 1914138554, 174292421, 2731055270, 289380356, 3203993006, 460393269, 320620315,
        685471733, 587496836, 852142971, 1086792851, 1017036298, 365543100, 1126000580, 2618297676,
        1288033470, 3409855158, 1501505948, 4234509866, 1607167915, 987167468, 1816402316, 1246189591
    ] }
funksjon _H() -> liste_heiltall { returner [
        1779033703, 4089235720, 3144134277, 2227873595, 1013904242, 4271175723, 2773480762, 1595750129,
        1359893119, 2917565137, 2600822924, 725511199, 528734635, 4215389547, 1541459225, 327033209
    ] }

funksjon _add2(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la lo = a[1] + b[1]
    la carry = lo >> 32
    la hi = (a[0] + b[0] + carry) & 4294967295
    returner [hi, lo & 4294967295]
}
funksjon _xor2(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall { returner [a[0] ^ b[0], a[1] ^ b[1]] }
funksjon _and2(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall { returner [a[0] & b[0], a[1] & b[1]] }
funksjon _not2(a: liste_heiltall) -> liste_heiltall { returner [a[0] ^ 4294967295, a[1] ^ 4294967295] }

funksjon _rotr2(a: liste_heiltall, n: heiltall) -> liste_heiltall {
    la hi = a[0]
    la lo = a[1]
    hvis n == 32 { returner [lo, hi] }
    hvis n < 32 {
        returner [((hi >> n) | (lo << (32 - n))) & 4294967295, ((lo >> n) | (hi << (32 - n))) & 4294967295]
    }
    la k = n - 32
    returner [((lo >> k) | (hi << (32 - k))) & 4294967295, ((hi >> k) | (lo << (32 - k))) & 4294967295]
}
funksjon _shr2(a: liste_heiltall, n: heiltall) -> liste_heiltall {
    la hi = a[0]
    la lo = a[1]
    hvis n < 32 {
        returner [(hi >> n) & 4294967295, ((lo >> n) | (hi << (32 - n))) & 4294967295]
    }
    returner [0, (hi >> (n - 32)) & 4294967295]
}
funksjon _ch(e: liste_heiltall, f: liste_heiltall, g: liste_heiltall) -> liste_heiltall {
    returner _xor2(_and2(e, f), _and2(_not2(e), g))
}
funksjon _maj(a: liste_heiltall, b: liste_heiltall, c: liste_heiltall) -> liste_heiltall {
    returner [(a[0]&b[0])^(a[0]&c[0])^(b[0]&c[0]), (a[1]&b[1])^(a[1]&c[1])^(b[1]&c[1])]
}
funksjon _bsig0(x: liste_heiltall) -> liste_heiltall { returner _xor2(_xor2(_rotr2(x,28), _rotr2(x,34)), _rotr2(x,39)) }
funksjon _bsig1(x: liste_heiltall) -> liste_heiltall { returner _xor2(_xor2(_rotr2(x,14), _rotr2(x,18)), _rotr2(x,41)) }
funksjon _ssig0(x: liste_heiltall) -> liste_heiltall { returner _xor2(_xor2(_rotr2(x,1), _rotr2(x,8)), _shr2(x,7)) }
funksjon _ssig1(x: liste_heiltall) -> liste_heiltall { returner _xor2(_xor2(_rotr2(x,19), _rotr2(x,61)), _shr2(x,6)) }

funksjon _hex8(x: liste_heiltall) -> tekst {
    la chars = "0123456789abcdef"
    la ut = ""
    la ord = 0
    mens ord < 2 {
        la v = x[ord]
        la shift = 28
        mens shift >= 0 {
            la nib = (v >> shift) & 15
            ut = ut + builtin.slice(chars, nib, nib + 1)
            shift = shift - 4
        }
        ord = ord + 1
    }
    returner ut
}
funksjon _pad(data: liste_heiltall) -> liste_heiltall {
    la out: liste_heiltall = []
    la i = 0
    mens i < lengde(data) { legg_til(out, data[i] & 255) i = i + 1 }
    la bit_len = lengde(data) * 8
    legg_til(out, 128)
    mens (lengde(out) % 128) != 112 { legg_til(out, 0) }
    la j = 0
    mens j < 8 { legg_til(out, 0) j = j + 1 }
    la shift = 56
    mens shift >= 0 { legg_til(out, (bit_len >> shift) & 255) shift = shift - 8 }
    returner out
}
funksjon hash_bytes(data: liste_heiltall) -> tekst {
    la bytes = _pad(data)
    la K = _K()
    la Hf = _H()
    la H: liste_heiltall = []
    la hi = 0
    mens hi < 8 { legg_til(H, [Hf[hi*2], Hf[hi*2+1]]) hi = hi + 1 }
    la Kw: liste_heiltall = []
    la ki = 0
    mens ki < 80 { legg_til(Kw, [K[ki*2], K[ki*2+1]]) ki = ki + 1 }
    la offset = 0
    mens offset < lengde(bytes) {
        la W: liste_heiltall = []
        la t = 0
        mens t < 16 {
            la p = offset + t * 8
            la wh = ((bytes[p] << 24) | (bytes[p+1] << 16) | (bytes[p+2] << 8) | bytes[p+3]) & 4294967295
            la wl = ((bytes[p+4] << 24) | (bytes[p+5] << 16) | (bytes[p+6] << 8) | bytes[p+7]) & 4294967295
            legg_til(W, [wh, wl])
            t = t + 1
        }
        mens t < 80 {
            la s = _add2(_add2(_ssig1(W[t-2]), W[t-7]), _add2(_ssig0(W[t-15]), W[t-16]))
            legg_til(W, s)
            t = t + 1
        }
        la a = H[0]
        la b = H[1]
        la c = H[2]
        la d = H[3]
        la e = H[4]
        la f = H[5]
        la g = H[6]
        la h = H[7]
        t = 0
        mens t < 80 {
            la t1 = _add2(_add2(_add2(h, _bsig1(e)), _add2(_ch(e,f,g), Kw[t])), W[t])
            la t2 = _add2(_bsig0(a), _maj(a,b,c))
            h = g
            g = f
            f = e
            e = _add2(d, t1)
            d = c
            c = b
            b = a
            a = _add2(t1, t2)
            t = t + 1
        }
        H[0] = _add2(H[0], a)
        H[1] = _add2(H[1], b)
        H[2] = _add2(H[2], c)
        H[3] = _add2(H[3], d)
        H[4] = _add2(H[4], e)
        H[5] = _add2(H[5], f)
        H[6] = _add2(H[6], g)
        H[7] = _add2(H[7], h)
        offset = offset + 128
    }
    returner _hex8(H[0])+_hex8(H[1])+_hex8(H[2])+_hex8(H[3])+_hex8(H[4])+_hex8(H[5])+_hex8(H[6])+_hex8(H[7])
}
funksjon _tekst_bytes(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(s) { legg_til(ut, builtin.char_code(builtin.slice(s, i, i + 1)) & 255) i = i + 1 }
    returner ut
}
funksjon hash(data: tekst) -> tekst { returner hash_bytes(_tekst_bytes(data)) }
funksjon _hexval(c: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", c) }
funksjon digest_bytes(data: liste_heiltall) -> liste_heiltall {
    la h = hash_bytes(data)
    la ut: liste_heiltall = []
    la i = 0
    mens i < 64 {
        legg_til(ut, _hexval(builtin.slice(h, i*2, i*2+1)) * 16 + _hexval(builtin.slice(h, i*2+1, i*2+2)))
        i = i + 1
    }
    returner ut
}
funksjon status() { returner { "abi": "norscode-sha512-v1", "bits": 512 } }
