# std/prioritetsko.no — prioritetskø med komparator (Java PriorityQueue<E>(Comparator)).
#
# Binær heap over vilkårlege verdiar. dytt/pop er O(log n), topp er O(1).
# Til skilnad frå std.prioritet (berre heiltall, min-heap) og std.heapq
# (Python-heapq over heiltall/tekst) tek denne modulen ein komparator-lambda,
# så han handterer postar, tekst, tupel-liknande lister og omvendt orden.
#
# Bruk:
#   bruk std.prioritetsko som pk
#   la q = pk.ny()                                  # min-heap, naturleg orden
#   pk.dytt(q, 5)
#   pk.dytt(q, 2)
#   pk.topp(q)                                      # 2 (utan å fjerne)
#   pk.pop(q)                                       # 2
#   la oppg = pk.ny_med(fun(a, b) -> a["pri"] - b["pri"])
#   pk.dytt(oppg, {"namn": "rydd", "pri": 3})
#
# Komparator: (a, b) -> heiltall, < 0 når a skal ut før b. Naturleg orden brukar
# `<`/`>` (tal etter verdi, tekst etter kodepunkt). ny_maks() gjev største først.
# Ved lik prioritet (komparatoren gjev 0) kjem elementa ut i innsetjingsrekkje-
# følgje (FIFO). Det er sterkare enn Java, som ikkje lovar noko her, og gjer
# resultatet likt på alle køyrevegar.
#
# API (Java-motstykke i parentes):
#   ny() / ny_maks() / ny_med(komparator)
#   frå_liste(xs) / frå_liste_med(xs, komparator)   heapify, O(n)
#   dytt(q, x) -> heiltall   ny storleik              (offer / add)
#   topp(q)                  minste eller ingenting   (peek)
#   pop(q)                   fjernar minste, eller ingenting når tom (poll)
#   pop_eller_kast(q)        som pop, men kastar "TomtFeil: ..." når tom (remove())
#   storleik / er_tom / tøm                           (size / isEmpty / clear)
#   inneheld(q, x) -> bool   lineært søk med ==       (contains)
#   fjern(q, x) -> bool      fjernar første like (==) element, O(n) (remove(Object))
#   til_liste(q)             kopi i heap-rekkjefølgje (iterator(); ikkje sortert)
#   til_sortert_liste(q)     kopi i prioritetsrekkjefølgje, q er urørt
#   tøm_til_liste(q)         poppar alt i prioritetsrekkjefølgje (q blir tom)
#
# Komparatoren blir kalla direkte (komp(a, b)) frå ein namngjeven funksjon, ikkje
# via builtin.ncb_call_fn, så modulen verkar på VM og i native AOT. Fjerning skjer
# med fjern_siste (den einaste list-krympinga som verkar likt på alle vegar).
#
# NB: modulen definerer `fjern`, som skuggar builtin fjern INNE i denne fila.

funksjon _ny_tom(modus: heiltall, komp) -> ordbok {
    returner {
        "__prioritetsko__": sann,
        "modus": modus,
        "cmp": komp,
        "h": [],
        "s": [],
        "seq": 0
    }
}

# Naturleg orden: minste først.
funksjon ny() -> ordbok {
    returner _ny_tom(0, ingenting)
}

# Omvendt naturleg orden: største først.
funksjon ny_maks() -> ordbok {
    returner _ny_tom(1, ingenting)
}

funksjon ny_med(komparator) -> ordbok {
    returner _ny_tom(2, komparator)
}

funksjon _nat(a, b) -> heiltall {
    hvis a < b { returner -1 }
    hvis a > b { returner 1 }
    returner 0
}

funksjon _cmp(q: ordbok, a, b) -> heiltall {
    la modus = q["modus"]
    hvis modus == 0 { returner _nat(a, b) }
    hvis modus == 1 { returner _nat(b, a) }
    la komp = q["cmp"]
    la r = komp(a, b)
    hvis r < 0 { returner -1 }
    hvis r > 0 { returner 1 }
    returner 0
}

# sann viss element i skal ut før element j.
funksjon _før(q: ordbok, i: heiltall, j: heiltall) -> bool {
    la h = q["h"]
    la s = q["s"]
    la c = _cmp(q, h[i], h[j])
    hvis c != 0 { returner c < 0 }
    returner s[i] < s[j]
}

funksjon _byt(q: ordbok, i: heiltall, j: heiltall) {
    la h = q["h"]
    la s = q["s"]
    la tv = h[i]
    h[i] = h[j]
    h[j] = tv
    la ts = s[i]
    s[i] = s[j]
    s[j] = ts
}

funksjon _opp(q: ordbok, start: heiltall) {
    la i = start
    mens i > 0 {
        la p = (i - 1) / 2
        hvis _før(q, i, p) {
            _byt(q, i, p)
            i = p
        } ellers {
            returner
        }
    }
}

funksjon _ned(q: ordbok, start: heiltall) {
    la h = q["h"]
    la n = lengde(h)
    la i = start
    mens sann {
        la best = i
        la v = 2 * i + 1
        la r = v + 1
        hvis v < n og _før(q, v, best) { best = v }
        hvis r < n og _før(q, r, best) { best = r }
        hvis best == i { returner }
        _byt(q, i, best)
        i = best
    }
}

funksjon _heapify(q: ordbok) -> ordbok {
    la n = lengde(q["h"])
    la i = n / 2 - 1
    mens i >= 0 {
        _ned(q, i)
        i = i - 1
    }
    returner q
}

funksjon _fyll(q: ordbok, xs) -> ordbok {
    la h = q["h"]
    la s = q["s"]
    for x i xs {
        legg_til(h, x)
        legg_til(s, q["seq"])
        q["seq"] = q["seq"] + 1
    }
    returner _heapify(q)
}

funksjon frå_liste(xs) -> ordbok {
    returner _fyll(ny(), xs)
}

funksjon frå_liste_med(xs, komparator) -> ordbok {
    returner _fyll(ny_med(komparator), xs)
}

funksjon dytt(q: ordbok, x) -> heiltall {
    la h = q["h"]
    la s = q["s"]
    legg_til(h, x)
    legg_til(s, q["seq"])
    q["seq"] = q["seq"] + 1
    _opp(q, lengde(h) - 1)
    returner lengde(h)
}

funksjon topp(q: ordbok) {
    la h = q["h"]
    hvis lengde(h) == 0 { returner ingenting }
    returner h[0]
}

# Fjernar elementet på indeks i og held heap-eigenskapen.
funksjon _fjern_ved(q: ordbok, i: heiltall) {
    la h = q["h"]
    la s = q["s"]
    la sist = lengde(h) - 1
    hvis i != sist {
        h[i] = h[sist]
        s[i] = s[sist]
    }
    fjern_siste(h)
    fjern_siste(s)
    hvis i < lengde(h) {
        _ned(q, i)
        _opp(q, i)
    }
}

funksjon pop(q: ordbok) {
    la h = q["h"]
    hvis lengde(h) == 0 { returner ingenting }
    la v = h[0]
    _fjern_ved(q, 0)
    returner v
}

funksjon pop_eller_kast(q: ordbok) {
    hvis lengde(q["h"]) == 0 { kast "TomtFeil: prioritetskøa er tom" }
    returner pop(q)
}

funksjon storleik(q: ordbok) -> heiltall {
    returner lengde(q["h"])
}

funksjon er_tom(q: ordbok) -> bool {
    returner lengde(q["h"]) == 0
}

funksjon tøm(q: ordbok) {
    q["h"] = []
    q["s"] = []
}

funksjon _indeks_av(q: ordbok, x) -> heiltall {
    la h = q["h"]
    la i = 0
    mens i < lengde(h) {
        hvis h[i] == x { returner i }
        i = i + 1
    }
    returner -1
}

funksjon inneheld(q: ordbok, x) -> bool {
    returner _indeks_av(q, x) >= 0
}

funksjon fjern(q: ordbok, x) -> bool {
    la i = _indeks_av(q, x)
    hvis i < 0 { returner usann }
    _fjern_ved(q, i)
    returner sann
}

funksjon til_liste(q: ordbok) -> liste {
    la ut = []
    for x i q["h"] {
        legg_til(ut, x)
    }
    returner ut
}

funksjon _kopi(q: ordbok) -> ordbok {
    la k = _ny_tom(q["modus"], q["cmp"])
    la h = k["h"]
    la s = k["s"]
    for x i q["h"] {
        legg_til(h, x)
    }
    for x i q["s"] {
        legg_til(s, x)
    }
    k["seq"] = q["seq"]
    returner k
}

funksjon tøm_til_liste(q: ordbok) -> liste {
    la ut = []
    mens lengde(q["h"]) > 0 {
        legg_til(ut, pop(q))
    }
    returner ut
}

funksjon til_sortert_liste(q: ordbok) -> liste {
    returner tøm_til_liste(_kopi(q))
}
