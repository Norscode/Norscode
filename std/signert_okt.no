# signert_okt.no — Signert cookie-økt for Norscode (Fase 0.11)
#
# Lagrar øktdata i ein signert, base64url-koda cookie-verdi (klient-side økt, som
# Flask/itsdangerous «secure cookie session»). Integriteten er sikra med EKTE
# HMAC-SHA256 (full 32-byte/64-hex, ikkje avkorta) over den koda nyttelasta.
# Signaturen blir verifisert i konstant tid. Valfri utløpstid (__exp__).
#
# Merk: innhaldet er lesbart for klienten (berre base64url, ikkje kryptert) — legg
# ikkje hemmelegheiter her, berre signert, ikkje-sensitiv øktstatus.
#
# Bruk:
#   la data: ordbok_tekst = {}
#   data["bruker"] = "ada"
#   la c = signert_okt.signer_okt(data, HEMMELEG, 3600)
#   // send som cookie: signert_okt.cookie("okt", c)
#   la lest = signert_okt.les_okt(c, HEMMELEG)   // kastar OktFeil ved tukling/utløp
#   la bruker = signert_okt.hent(lest, "bruker")

bruk std.krypto som krypto
bruk std.base64 som base64
bruk std.json som json

funksjon _no_sek() -> heiltall {
    prøv { returner builtin.now_ms() / 1000 } fang (e) { }
    returner 0
}

funksjon _esc(s: tekst) -> tekst {
    la r = tekst_erstatt(s, "\\", "\\\\")
    r = tekst_erstatt(r, "\"", "\\\"")
    r = tekst_erstatt(r, "\n", "\\n")
    r = tekst_erstatt(r, "\r", "\\r")
    r = tekst_erstatt(r, "\t", "\\t")
    returner r
}

funksjon _serialiser(data: ordbok_tekst, ttl_sek: heiltall) -> tekst {
    la exp: heiltall = 0
    hvis ttl_sek > 0 { exp = _no_sek() + ttl_sek }
    la delar: liste<tekst> = []
    legg_til(delar, "\"__exp__\":" + tekst_fra_heltall(exp))
    la nk = nøkler(data)
    la i: heiltall = 0
    mens i < lengde(nk) {
        la k: tekst = tekst(nk[i])
        hvis ikkje builtin.starts_with(k, "__") {
            legg_til(delar, "\"" + _esc(k) + "\":\"" + _esc(tekst(data[k])) + "\"")
        }
        i = i + 1
    }
    returner "{" + builtin.join(delar, ",") + "}"
}

funksjon signer_okt(data: ordbok_tekst, hemmeleg: tekst, ttl_sek: heiltall) -> tekst {
    la payload = _serialiser(data, ttl_sek)
    la b = base64.kod_url(payload)
    la sig = krypto.hmac_sha256(hemmeleg, b)   // full HMAC-SHA256 (64 hex)
    returner b + "." + sig
}

funksjon les_okt(verdi: tekst, hemmeleg: tekst) -> ordbok_tekst {
    la dot = builtin.index_of(verdi, ".")
    hvis dot <= 0 { kast "OktFeil: ugyldig øktformat" }
    la b = builtin.slice(verdi, 0, dot)
    la sig = builtin.slice(verdi, dot + 1, lengde(verdi))
    la forventa = krypto.hmac_sha256(hemmeleg, b)
    hvis ikkje krypto.konstant_tid_lik(forventa, sig) { kast "OktFeil: ugyldig signatur" }
    la payload = ""
    prøv { payload = base64.dekod_url(b) } fang (e) { kast "OktFeil: ugyldig nyttelast" }
    la o = json.parse(payload)
    la exp = json.hent_tall(o, "__exp__")
    hvis exp > 0 og _no_sek() >= exp { kast "OktFeil: økta er utløpt" }
    returner o
}

funksjon hent(okt: ordbok_tekst, nøkkel: tekst) -> tekst {
    returner json.hent_tekst(okt, nøkkel)
}

funksjon gyldig(verdi: tekst, hemmeleg: tekst) -> boolsk {
    prøv { les_okt(verdi, hemmeleg) returner sann } fang (e) { returner usann }
    returner usann
}

funksjon cookie(namn: tekst, verdi: tekst) -> tekst {
    returner namn + "=" + verdi + "; HttpOnly; Secure; SameSite=Lax; Path=/"
}

funksjon status() -> ordbok_tekst {
    returner {
        "modul": "std.signert_okt",
        "signatur": "HMAC-SHA256 (full)",
        "samanlikning": "constant_time"
    }
}
