# httpfeil.no — HTTPFeil-hierarki for handlarar (4.1): `kast HTTPFeil(404, "Fann ikkje")`.
#
# Bygd på R4-unntakshierarkiet (docs/UNNTAK.md): ingen arv. Rota er grensesnittet
# `HTTPFeil`; det generelle unntaket og undertypane er eigne strukturar som implementerer
# det. `fang (e: HTTPFeil)` fangar difor alle, `fang (e: IkkjeFunnet)` berre éin type.
# Funksjonen `HTTPFeil(kode, detalj)` lagar det generelle unntaket (HTTPFeilGenerell).
#
#   undertype        status
#   UgyldigInput     400
#   IkkjeAutorisert  401
#   Forbode          403
#   IkkjeFunnet      404
#   Konflikt         409
#   ServerFeil       500
#
# Alle har felta `detalj` (tekst eller struktur) og `headers` (ordbok eller ingenting):
#   kast IkkjeFunnet("vare manglar")
#   kast IkkjeAutorisert("logg inn", {"www-authenticate": "Bearer"})
#
# nc serve og std/apptenar svarar med statuskoden og JSON-kroppen {"detail": detalj}
# (FastAPI-format). Eigne feilhandterarar per type: std/httpfeil_handterar.no.
# Bruk: `bruk std.httpfeil` (utan alias, så namna er synlege i fang).

grensesnitt HTTPFeil {
    funksjon status(self) -> heiltall
}

struktur HTTPFeilGenerell implementerer HTTPFeil {
    kode
    detalj
    headers
}
funksjon HTTPFeilGenerell.status(self) -> heiltall { returner self.kode }

funksjon HTTPFeil(kode: heiltall, detalj: tekst) -> HTTPFeilGenerell {
    returner HTTPFeilGenerell(kode, detalj, null)
}

funksjon HTTPFeil_med_headers(kode: heiltall, detalj: tekst, headers: ordbok) -> HTTPFeilGenerell {
    returner HTTPFeilGenerell(kode, detalj, headers)
}

struktur UgyldigInput implementerer HTTPFeil {
    detalj
    headers
}
funksjon UgyldigInput.status(self) -> heiltall { returner 400 }

struktur IkkjeAutorisert implementerer HTTPFeil {
    detalj
    headers
}
funksjon IkkjeAutorisert.status(self) -> heiltall { returner 401 }

struktur Forbode implementerer HTTPFeil {
    detalj
    headers
}
funksjon Forbode.status(self) -> heiltall { returner 403 }

struktur IkkjeFunnet implementerer HTTPFeil {
    detalj
    headers
}
funksjon IkkjeFunnet.status(self) -> heiltall { returner 404 }

struktur Konflikt implementerer HTTPFeil {
    detalj
    headers
}
funksjon Konflikt.status(self) -> heiltall { returner 409 }

struktur ServerFeil implementerer HTTPFeil {
    detalj
    headers
}
funksjon ServerFeil.status(self) -> heiltall { returner 500 }

# Standardsvaret for eit HTTPFeil-unntak: {"status", "content_type", "body", "headers"}.
# Kroppen er {"detail": detalj} (tekst, eller JSON for liste/ordbok).
funksjon feil_respons(e) -> ordbok {
    la st = e.status()
    la hd = e.headers
    la d = {"status": st, "content_type": "application/json; charset=utf-8",
            "body": "{\"detail\":" + detalj_json(e.detalj) + "}"}
    hvis hd != null og builtin.type(hd) == "ordbok" og lengde(nøkler(hd)) > 0 {
        d["headers"] = hd
    }
    returner d
}

funksjon detalj_json(v) -> tekst {
    hvis v == null { returner "null" }
    la t = builtin.type(v)
    hvis t == "tekst" { returner builtin.json_stringify(v) }
    hvis t == "heltall" { returner tekst(v) }
    hvis t == "boolsk" eller t == "bool" {
        hvis v { returner "true" }
        returner "false"
    }
    hvis t == "liste" {
        la ut = "["
        la i = 0
        mens i < lengde(v) {
            hvis i > 0 { ut = ut + "," }
            ut = ut + detalj_json(v[i])
            i = i + 1
        }
        returner ut + "]"
    }
    hvis t == "ordbok" {
        la ks = nøkler(v)
        la ut = "{"
        la i = 0
        mens i < lengde(ks) {
            hvis i > 0 { ut = ut + "," }
            ut = ut + builtin.json_stringify(tekst(ks[i])) + ":" + detalj_json(v[ks[i]])
            i = i + 1
        }
        returner ut + "}"
    }
    returner builtin.json_stringify(tekst(v))
}
