# rsa.no - RSA PKCS#1 v1.5 signaturverifikasjon (RFC 8017 §8.2.2) i rein Norscode.
# Berre verifikasjon (offentleg eksponent). Byggjer på std.bigint og std.sha256.
bruk std.bigint som bn
bruk std.sha256 som sha

# DER-prefiks for DigestInfo med SHA-256 (RFC 8017 §9.2, notat 1).
funksjon _sha256_digestinfo_prefiks() -> liste_heiltall {
    returner [48, 49, 48, 13, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 1, 5, 0, 4, 32]
}

funksjon _lik(a: liste_heiltall, b: liste_heiltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) { hvis a[i] != b[i] { returner usann } i = i + 1 }
    returner sann
}
funksjon _sha256_bytes(melding: liste_heiltall) -> liste_heiltall {
    la hexs = sha.hash_bytes(melding)
    la ut: liste_heiltall = []
    la i = 0
    mens i < 32 {
        legg_til(ut, builtin.index_of("0123456789abcdef", builtin.slice(hexs, i*2, i*2+1))*16 + builtin.index_of("0123456789abcdef", builtin.slice(hexs, i*2+1, i*2+2)))
        i = i + 1
    }
    returner ut
}

# Bygg forventa EMSA-PKCS1-v1_5-koding (RFC 8017 §9.2) for eit SHA-256-hash, lengde k byte.
funksjon _emsa_pkcs1_v15(hash: liste_heiltall, k: heiltall) -> liste_heiltall {
    la prefiks = _sha256_digestinfo_prefiks()
    la t_len = lengde(prefiks) + lengde(hash)          # DigestInfo-lengde
    # EM = 0x00 || 0x01 || PS(0xFF..) || 0x00 || T
    la ps_len = k - t_len - 3
    la em: liste_heiltall = [0, 1]
    la i = 0
    mens i < ps_len { legg_til(em, 255) i = i + 1 }
    legg_til(em, 0)
    i = 0
    mens i < lengde(prefiks) { legg_til(em, prefiks[i]) i = i + 1 }
    i = 0
    mens i < lengde(hash) { legg_til(em, hash[i]) i = i + 1 }
    returner em
}

# rsa_verify: n_bytes/e_bytes = offentleg nøkkel (big-endian), melding + signatur (bytes).
# Returnerer sann berre om signaturen er gyldig (fail-closed).
funksjon rsa_verify(n_bytes: liste_heiltall, e_bytes: liste_heiltall, melding: liste_heiltall, signatur: liste_heiltall) -> boolsk {
    la k = lengde(n_bytes)
    hvis lengde(signatur) != k { returner usann }
    # RSAVP1: m = s^e mod n
    la n = bn.fra_bytes(n_bytes)
    la e = bn.fra_bytes(e_bytes)
    la s = bn.fra_bytes(signatur)
    hvis bn.cmp(s, n) >= 0 { returner usann }              # signatur ute av rekkevidde
    la m = bn.modexp(s, e, n)
    la em = bn.til_bytes(m, k)
    # Krav: minst 8 padding-byte (0xFF) og gyldig struktur.
    hvis k < lengde(_sha256_digestinfo_prefiks()) + 32 + 11 { returner usann }
    la hash = _sha256_bytes(melding)
    la forventa = _emsa_pkcs1_v15(hash, k)
    returner _lik(em, forventa)
}

funksjon status() { returner { "abi": "norscode-rsa-v1", "scheme": "pkcs1-v1_5", "hash": "sha256" } }
