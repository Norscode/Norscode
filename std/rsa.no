# rsa.no - RSA PKCS#1 v1.5 signaturverifikasjon (RFC 8017 §8.2.2) i rein Norscode.
# Berre verifikasjon (offentleg eksponent). Byggjer på std.bigint og std.sha256.
bruk std.bigint som bn
bruk std.sha256 som sha

# DER-prefiks for DigestInfo med SHA-256 (RFC 8017 §9.2, notat 1).
funksjon _sha256_digestinfo_prefiks() -> liste_heiltall {
    returner [48, 49, 48, 13, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 1, 5, 0, 4, 32]
}

funksjon _lik(a: liste_heiltall, b: liste_heiltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la i = 0
    mens i < lengde(a) { hvis a[i] != b[i] { returner usann } i = i + 1 }
    returner sann
}
funksjon _sha256_bytes(melding: liste_heiltall) -> liste_heiltall {
    la hexs = sha.hash_bytes(melding)
    la ut: liste_heiltall = []
    la i = 0
    mens i < 32 {
        legg_til(ut, builtin.index_of("0123456789abcdef", builtin.slice(hexs, i*2, i*2+1))*16 + builtin.index_of("0123456789abcdef", builtin.slice(hexs, i*2+1, i*2+2)))
        i = i + 1
    }
    returner ut
}

# Bygg forventa EMSA-PKCS1-v1_5-koding (RFC 8017 §9.2) for eit SHA-256-hash, lengde k byte.
funksjon _emsa_pkcs1_v15(hash: liste_heiltall, k: heiltall) -> liste_heiltall {
    la prefiks = _sha256_digestinfo_prefiks()
    la t_len = lengde(prefiks) + lengde(hash)          # DigestInfo-lengde
    # EM = 0x00 || 0x01 || PS(0xFF..) || 0x00 || T
    la ps_len = k - t_len - 3
    la em: liste_heiltall = [0, 1]
    la i = 0
    mens i < ps_len { legg_til(em, 255) i = i + 1 }
    legg_til(em, 0)
    i = 0
    mens i < lengde(prefiks) { legg_til(em, prefiks[i]) i = i + 1 }
    i = 0
    mens i < lengde(hash) { legg_til(em, hash[i]) i = i + 1 }
    returner em
}

# rsa_verify: n_bytes/e_bytes = offentleg nøkkel (big-endian), melding + signatur (bytes).
# Returnerer sann berre om signaturen er gyldig (fail-closed).
funksjon rsa_verify(n_bytes: liste_heiltall, e_bytes: liste_heiltall, melding: liste_heiltall, signatur: liste_heiltall) -> boolsk {
    la k = lengde(n_bytes)
    hvis lengde(signatur) != k { returner usann }
    # RSAVP1: m = s^e mod n
    la n = bn.fra_bytes(n_bytes)
    la e = bn.fra_bytes(e_bytes)
    la s = bn.fra_bytes(signatur)
    hvis bn.cmp(s, n) >= 0 { returner usann }              # signatur ute av rekkevidde
    la m = bn.modexp(s, e, n)
    la em = bn.til_bytes(m, k)
    # Krav: minst 8 padding-byte (0xFF) og gyldig struktur.
    hvis k < lengde(_sha256_digestinfo_prefiks()) + 32 + 11 { returner usann }
    la hash = _sha256_bytes(melding)
    la forventa = _emsa_pkcs1_v15(hash, k)
    returner _lik(em, forventa)
}

# ── RSASSA-PSS-verifikasjon (RFC 8017 §8.1.2 + §9.1.2), SHA-256, MGF1-SHA256,
# saltlengd = hashlengd (32). Brukt av TLS 1.3 CertificateVerify med
# rsa_pss_rsae_sha256 (0x0804) — t.d. Go/Pebble sin ACME-tenar.

funksjon _saman_liste(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(a) { legg_til(ut, a[i]) i = i + 1 }
    i = 0
    mens i < lengde(b) { legg_til(ut, b[i]) i = i + 1 }
    returner ut
}

funksjon _slice_liste(a: liste_heiltall, start: heiltall, slutt: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = start
    mens i < slutt { legg_til(ut, a[i]) i = i + 1 }
    returner ut
}

funksjon _xor_liste(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(a) { legg_til(ut, (a[i] & 255) ^ (b[i] & 255)) i = i + 1 }
    returner ut
}

# Bit-lengd av eit big-endian byte-tal (talet på signifikante bit).
funksjon _bit_lengd(n_bytes: liste_heiltall) -> heiltall {
    la i = 0
    mens i < lengde(n_bytes) og n_bytes[i] == 0 { i = i + 1 }
    hvis i >= lengde(n_bytes) { returner 0 }
    la bits = (lengde(n_bytes) - i - 1) * 8
    la topp = n_bytes[i]
    mens topp > 0 { bits = bits + 1 topp = topp >> 1 }
    returner bits
}

# MGF1 med SHA-256 (RFC 8017 §B.2.1).
funksjon _mgf1(seed: liste_heiltall, mask_len: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la counter = 0
    mens lengde(ut) < mask_len {
        la c = [(counter >> 24) & 255, (counter >> 16) & 255, (counter >> 8) & 255, counter & 255]
        la blk = _sha256_bytes(_saman_liste(seed, c))
        la j = 0
        mens j < lengde(blk) { legg_til(ut, blk[j]) j = j + 1 }
        counter = counter + 1
    }
    returner _slice_liste(ut, 0, mask_len)
}

# rsa_pss_verify: n_bytes/e_bytes = offentleg nøkkel (big-endian), melding + signatur (bytes).
# Fail-closed. saltlengd = 32 (rsa_pss_rsae_sha256).
funksjon rsa_pss_verify(n_bytes: liste_heiltall, e_bytes: liste_heiltall, melding: liste_heiltall, signatur: liste_heiltall) -> boolsk {
    la k = lengde(n_bytes)
    hvis lengde(signatur) != k { returner usann }
    la n = bn.fra_bytes(n_bytes)
    la e = bn.fra_bytes(e_bytes)
    la s = bn.fra_bytes(signatur)
    hvis bn.cmp(s, n) >= 0 { returner usann }
    la m = bn.modexp(s, e, n)
    la mod_bits = _bit_lengd(n_bytes)
    la em_bits = mod_bits - 1
    la em_len = 0
    mens em_len * 8 < em_bits { em_len = em_len + 1 }        # ceil(em_bits/8)
    hvis em_len < 1 { returner usann }
    la EM = bn.til_bytes(m, em_len)
    la h_len = 32
    la s_len = 32
    hvis em_len < h_len + s_len + 2 { returner usann }
    hvis EM[em_len - 1] != 188 { returner usann }            # 0xbc
    la db_len = em_len - h_len - 1
    la maskedDB = _slice_liste(EM, 0, db_len)
    la H = _slice_liste(EM, db_len, db_len + h_len)
    la zerobits = 8 * em_len - em_bits
    hvis zerobits > 0 {
        la maske = 255 - (255 >> zerobits)                   # dei øvste zerobits-bita
        hvis (maskedDB[0] & maske) != 0 { returner usann }
    }
    la dbMask = _mgf1(H, db_len)
    la DB = _xor_liste(maskedDB, dbMask)
    hvis zerobits > 0 { DB[0] = DB[0] & (255 >> zerobits) }
    la ps_len = em_len - h_len - s_len - 2
    la i = 0
    mens i < ps_len { hvis DB[i] != 0 { returner usann } i = i + 1 }
    hvis DB[ps_len] != 1 { returner usann }                  # 0x01-separator
    la salt = _slice_liste(DB, db_len - s_len, db_len)
    la mHash = _sha256_bytes(melding)
    la mprime = _saman_liste(_saman_liste([0, 0, 0, 0, 0, 0, 0, 0], mHash), salt)
    la Hprime = _sha256_bytes(mprime)
    returner _lik(Hprime, H)
}

# RSASSA-PKCS1-v1_5-SIGNERING (RFC 8017 §8.2.1), SHA-256. Privat eksponent d.
# Brukt av JWS RS256 (ACME-konto-signering mot Pebble). melding = rå signing-input.
funksjon rsa_sign(n_bytes: liste_heiltall, d_bytes: liste_heiltall, melding: liste_heiltall) -> liste_heiltall {
    la k = lengde(n_bytes)
    la hash = _sha256_bytes(melding)
    la em = _emsa_pkcs1_v15(hash, k)          # EM = 0x00 0x01 PS 0x00 T
    la m = bn.fra_bytes(em)
    la d = bn.fra_bytes(d_bytes)
    la n = bn.fra_bytes(n_bytes)
    la s = bn.modexp(m, d, n)                  # RSASP1: s = m^d mod n
    returner bn.til_bytes(s, k)
}

funksjon status() { returner { "abi": "norscode-rsa-v1", "scheme": "pkcs1-v1_5", "hash": "sha256" } }
