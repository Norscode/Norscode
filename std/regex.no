# regex.no — Regulære uttrykk (java.util.regex / Python re)
#
# Mønsteret blir tolka til eit syntakstre og kompilert til eit lite
# instruksjonsprogram (Thompson/Pike-stil: CHAR, CLASS, SPLIT, JMP, SAVE, ...).
# Matchinga er backtracking med eksplisitt stakk og memo på (SPLIT, posisjon)
# ("bit-state", som RE2): kvart par blir prøvd høgst éin gong per søk, så
# køyretida er O(tekstlengd × mønsterlengd) — ingen eksponentiell backtracking
# — medan resultatet er det same som Java/Perl sin prioritet (venstre-først,
# grådig/lat). Tomme løkker (t.d. (a*)*) terminerer.
#
# Teksten blir dekoda frå UTF-8 til kodepunkt, så «.» og [æøå] tek heile
# teikn, og start/slutt-posisjonar er kodepunkt-indeksar.
#
# Støttar:
#   .              kva som helst teikn unntatt \n ((?s): òg \n)
#   * + ? {m} {m,} {m,n} {,n}   grådige kvantorar; late med etterhengt ?
#                  (possessive *+ ++ ?+ {..}+ blir handsama som grådige)
#   ^ $            start/slutt ((?m): linjestart/-slutt); $ matchar òg før
#                  ein avsluttande \n; \A \z \Z; \b \B
#   [abc] [^a] [a-z] [\d\s_.-]    teiknklassar (med escapar inni)
#   |              alternering (på alle nivå)
#   \d \w \s  \D \W \S            (ASCII, som Java: \w = [a-zA-Z0-9_])
#   \. \* \\ \/ ...               escapa literal; \n \t \r \f \v \e \a \0
#   \xhh \x{h..} \uhhhh           kodepunkt
#   (...)          fangande gruppe
#   (?:...)        ikkje-fangande gruppe
#   (?P<namn>...) (?<namn>...)    namngjeven gruppe
#   (?=...) (?!...)               lookahead (positiv/negativ)
#   (?i) (?m) (?s) (?x) (?-i) (?i:...)   flagg (gjeld ut gruppa, som Java;
#                  (?i) fold ASCII og Latin-1, inkl. ÆØÅ/æøå)
#   (?#...)        kommentar
# Ikkje støtta (kompiler kastar "regex: ..."): tilbakereferansar \1 og \k,
# lookbehind (?<=..), atomiske grupper (?>..), \p{..}- og POSIX-klassar.
#
# Bruk:
#   bruk std.regex som re
#   la tok = re.kompiler("(\\d+)-(\\w+)")
#   la m = re.finn_samsvar(tok, "abc 42-hei xyz")
#   skriv(re.gruppe(m, 0))   # => "42-hei"
#   skriv(re.gruppe(m, 1))   # => "42"
#   skriv(re.gruppe(m, 2))   # => "hei"
#   skriv(re.finn("år 2026", "\\d{4}"))   # => "2026"
#
# Det kompilerte programmet er ein ugjennomsiktig verdi (liste). Match-objektet
# er ei ordbok_tekst: "ok" ("1"/"0"), "start", "slutt", "g0" (heile treffet),
# "g<n>" / "g<n>_s" / "g<n>_e" for deltakande grupper og "n<namn>" /
# "n<namn>_s" / "n<namn>_e" for namngjevne.
#
# Instruksjonar (op, a, b):
#   0 MATCH   1 CHAR a   2 ANY   3 ANYNL   4 CLASS a   5 SPLIT a,b   6 JMP a
#   7 SAVE a  8 DIGIT a=neg   9 WORD a=neg   10 SPACE a=neg   11 BOT
#   12 BOL    13 EOT   14 EOT_NL   15 EOL   16 WORDB   17 NWORDB
#   18 LOOK a=start b=neg   19 CHAR_I a   20 CLASS_I a   21 LMATCH

# ─── UTF-8 → kodepunkt ────────────────────────────────────────────────────────
# builtin.split(t, "") gir éin tekst per byte; char_code gir byteverdien.
# Returnerer [koder, bytepos, teikn]: koder[i] er kodepunkt nr. i, bytepos[i]
# er indeksen i teikn der kodepunktet startar (bytepos[n] = lengde(teikn)).
# Ugyldige/einskilde byte blir tekne som eigne kodepunkt (robust dersom split
# ein gong gir heile teikn i staden for byte).

funksjon _dekod(t: tekst) -> liste {
    la teikn = builtin.split(t, "")
    la nb: heltall = lengde(teikn)
    la bytar: liste_heltall = []
    la i: heltall = 0
    mens (i < nb) {
        legg_til(bytar, builtin.char_code(teikn[i]))
        i = i + 1
    }
    la koder: liste_heltall = []
    la bp: liste_heltall = []
    i = 0
    mens (i < nb) {
        la c: heltall = bytar[i]
        la tal: heltall = 0
        hvis (c >= 192 og c < 224) { tal = 1 }
        ellers hvis (c >= 224 og c < 240) { tal = 2 }
        ellers hvis (c >= 240 og c < 248) { tal = 3 }
        la ok: bool = tal > 0 og i + tal < nb
        la k: heltall = 1
        mens (ok og k <= tal) {
            la cc: heltall = bytar[i + k]
            hvis (cc < 128 eller cc >= 192) { ok = usann }
            k = k + 1
        }
        legg_til(bp, i)
        hvis (ok) {
            la cp: heltall = c - 192
            hvis (tal == 2) { cp = c - 224 }
            hvis (tal == 3) { cp = c - 240 }
            la k2: heltall = 1
            mens (k2 <= tal) {
                cp = cp * 64 + (bytar[i + k2] - 128)
                k2 = k2 + 1
            }
            legg_til(koder, cp)
            i = i + tal + 1
        } ellers {
            legg_til(koder, c)
            i = i + 1
        }
    }
    legg_til(bp, nb)
    la ut: liste = []
    legg_til(ut, koder)
    legg_til(ut, bp)
    legg_til(ut, teikn)
    returner ut
}

# Kodepunkt → tekst for feilmeldingar.
funksjon _cp_tekst(cp: heltall) -> tekst {
    hvis (cp >= 32 og cp < 127) { returner builtin.chr(cp) }
    returner "U+" + tekst_fra_heltall(cp)
}

# Små bokstavar: ASCII A-Z og Latin-1 À-Þ (unntatt ×), inkl. ÆØÅ.
funksjon _fold(c: heltall) -> heltall {
    hvis (c >= 65 og c <= 90) { returner c + 32 }
    hvis (c >= 192 og c <= 222 og c != 215) { returner c + 32 }
    returner c
}

funksjon _stor(c: heltall) -> heltall {
    hvis (c >= 97 og c <= 122) { returner c - 32 }
    hvis (c >= 224 og c <= 254 og c != 247) { returner c - 32 }
    returner c
}

funksjon _er_ord(c: heltall) -> bool {
    returner (c >= 97 og c <= 122) eller (c >= 65 og c <= 90) eller
             (c >= 48 og c <= 57) eller c == 95
}

# ─── Syntakstre ───────────────────────────────────────────────────────────────
# Datastrukturane er flate heiltalslister i behaldarar med høgst fire element:
# VM-en i standardmodus (NORSCODE_VM_FAST=0) held skyggeheap-bokhald for kvar
# liste/ordbok som blir henta ut av ei liste med meir enn fire element, og det
# gjer djupe/breie strukturar i indre løkker svært trege.
#
# Kompileringstilstand cs = [mk, st, tre, rest]:
#   mk   mønsterkoder
#   st   [pos, ngrupper, fi, fm, fs, fx]
#   tre  [nt, na, nb, nc]           nodetype og tre argument per node
#   rest [lenke, kl, namn]          lenke = [første_barn, neste_søsken, siste_barn]
#                                   kl = flate teiknklassar, namn = [namn, nr]
# Nodetypar: 1 OP (na=op, nb=arg: atom/påstand), 4 KJEDE, 5 ALT,
#            6 GRUPPE (na=nr), 7 GJENTAK (na=min, nb=maks|-1, nc=grådig),
#            8 LOOK (nb=neg)
# Teiknklasse ved forskyving o i kl: [neg, r, lo1, hi1, ..., lo_r, hi_r].

funksjon _node(cs, t: heltall, a: heltall, b: heltall, c: heltall) -> heltall {
    la tre = cs[2]
    legg_til(tre[0], t)
    legg_til(tre[1], a)
    legg_til(tre[2], b)
    legg_til(tre[3], c)
    la lenke = cs[3][0]
    legg_til(lenke[0], -1)
    legg_til(lenke[1], -1)
    legg_til(lenke[2], -1)
    returner lengde(tre[0]) - 1
}

funksjon _legg_barn(cs, n: heltall, barn: heltall) {
    hvis (barn < 0) { returner }
    la lenke = cs[3][0]
    la første: liste_heltall = lenke[0]
    la neste: liste_heltall = lenke[1]
    la siste: liste_heltall = lenke[2]
    hvis (første[n] < 0) { første[n] = barn } ellers { neste[siste[n]] = barn }
    siste[n] = barn
}

funksjon _første_barn(cs, n: heltall) -> heltall {
    returner cs[3][0][0][n]
}

funksjon _neste_søsken(cs, n: heltall) -> heltall {
    returner cs[3][0][1][n]
}

funksjon _feil(cs, melding: tekst) {
    kast "regex: " + melding + " (posisjon " + tekst_fra_heltall(cs[1][0]) + ")"
}

funksjon _kikk(cs) -> heltall {
    la p: heltall = cs[1][0]
    la mk: liste_heltall = cs[0]
    hvis (p < lengde(mk)) { returner mk[p] }
    returner -1
}

funksjon _kikk_ved(cs, forskyv: heltall) -> heltall {
    la p: heltall = cs[1][0] + forskyv
    la mk: liste_heltall = cs[0]
    hvis (p >= 0 og p < lengde(mk)) { returner mk[p] }
    returner -1
}

funksjon _hopp(cs, antal: heltall) {
    la st: liste_heltall = cs[1]
    st[0] = st[0] + antal
}

# Hopp over mellomrom og #-kommentarar i (?x)-modus.
funksjon _hopp_x(cs) {
    la st: liste_heltall = cs[1]
    hvis (st[5] == 0) { returner }
    la mk: liste_heltall = cs[0]
    la vidare: bool = sann
    mens (vidare og st[0] < lengde(mk)) {
        la c: heltall = mk[st[0]]
        hvis (c == 32 eller (c >= 9 og c <= 13)) {
            st[0] = st[0] + 1
        } ellers hvis (c == 35) {
            mens (st[0] < lengde(mk) og mk[st[0]] != 10) { st[0] = st[0] + 1 }
        } ellers {
            vidare = usann
        }
    }
}

funksjon _p_alt(cs) -> heltall {
    la første: heltall = _p_kjede(cs)
    hvis (_kikk(cs) != 124) { returner første }
    la n: heltall = _node(cs, 5, 0, 0, 0)
    _legg_barn(cs, n, første)
    mens (_kikk(cs) == 124) {
        _hopp(cs, 1)
        _legg_barn(cs, n, _p_kjede(cs))
    }
    returner n
}

funksjon _p_kjede(cs) -> heltall {
    la n: heltall = _node(cs, 4, 0, 0, 0)
    la vidare: bool = sann
    mens (vidare) {
        _hopp_x(cs)
        la c: heltall = _kikk(cs)
        hvis (c == -1 eller c == 124 eller c == 41) {
            vidare = usann
        } ellers {
            la a: heltall = _p_atom(cs)
            hvis (a >= 0) { _legg_barn(cs, n, _p_kvantor(cs, a)) }
        }
    }
    returner n
}

# Les eit desimaltal frå mønsteret; -1 om det ikkje står siffer der.
funksjon _les_tal(cs) -> heltall {
    la c: heltall = _kikk(cs)
    hvis (c < 48 eller c > 57) { returner -1 }
    la v: heltall = 0
    mens (c >= 48 og c <= 57) {
        v = v * 10 + (c - 48)
        hvis (v > 100000) { _feil(cs, "for stor kvantor") }
        _hopp(cs, 1)
        c = _kikk(cs)
    }
    returner v
}

funksjon _p_kvantor(cs, atom: heltall) -> heltall {
    la resultat: heltall = atom
    la vidare: bool = sann
    mens (vidare) {
        _hopp_x(cs)
        la c: heltall = _kikk(cs)
        la mn: heltall = -2
        la mx: heltall = -1
        hvis (c == 42) {
            mn = 0
            _hopp(cs, 1)
        } ellers hvis (c == 43) {
            mn = 1
            _hopp(cs, 1)
        } ellers hvis (c == 63) {
            mn = 0
            mx = 1
            _hopp(cs, 1)
        } ellers hvis (c == 123) {
            # {m} {m,} {m,n} {,n}; elles er { eit literal teikn
            la lagra: heltall = cs[1][0]
            _hopp(cs, 1)
            la a: heltall = _les_tal(cs)
            la b: heltall = a
            la gyldig: bool = sann
            hvis (_kikk(cs) == 44) {
                _hopp(cs, 1)
                b = _les_tal(cs)
                hvis (a == -1 og b == -1) { gyldig = usann }
                hvis (a == -1) { a = 0 }
            } ellers hvis (a == -1) {
                gyldig = usann
            }
            hvis (gyldig og _kikk(cs) == 125) {
                _hopp(cs, 1)
                mn = a
                mx = b
                hvis (mx != -1 og mx < mn) { _feil(cs, "ugyldig kvantor {" + tekst_fra_heltall(mn) + "," + tekst_fra_heltall(mx) + "}") }
                hvis (mn > 1000 eller mx > 1000) { _feil(cs, "kvantor over 1000") }
            } ellers {
                la st: liste_heltall = cs[1]
                st[0] = lagra
            }
        }
        hvis (mn == -2) {
            vidare = usann
        } ellers {
            la grådig: heltall = 1
            hvis (_kikk(cs) == 63) {
                grådig = 0
                _hopp(cs, 1)
            } ellers hvis (_kikk(cs) == 43) {
                _hopp(cs, 1)
            }
            la r: heltall = _node(cs, 7, mn, mx, grådig)
            _legg_barn(cs, r, resultat)
            resultat = r
        }
    }
    returner resultat
}

funksjon _op_node(cs, op: heltall, arg: heltall) -> heltall {
    returner _node(cs, 1, op, arg, 0)
}

# Heksadesimalt siffer → verdi, -1 om ugyldig.
funksjon _hex(c: heltall) -> heltall {
    hvis (c >= 48 og c <= 57) { returner c - 48 }
    hvis (c >= 97 og c <= 102) { returner c - 87 }
    hvis (c >= 65 og c <= 70) { returner c - 55 }
    returner -1
}

funksjon _les_hex(cs, antal: heltall) -> heltall {
    la v: heltall = 0
    la i: heltall = 0
    mens (i < antal) {
        la h: heltall = _hex(_kikk(cs))
        hvis (h < 0) { _feil(cs, "ugyldig heksadesimal escape") }
        v = v * 16 + h
        _hopp(cs, 1)
        i = i + 1
    }
    returner v
}

# Kodepunktet for ein literal escape etter backslash (\n, \x41, \. ...).
funksjon _escape_kode(cs, c: heltall) -> heltall {
    hvis (c == 110) { returner 10 }   # \n
    hvis (c == 116) { returner 9 }    # \t
    hvis (c == 114) { returner 13 }   # \r
    hvis (c == 102) { returner 12 }   # \f
    hvis (c == 118) { returner 11 }   # \v
    hvis (c == 101) { returner 27 }   # \e
    hvis (c == 97) { returner 7 }     # \a
    hvis (c == 48) { returner 0 }     # \0
    hvis (c == 120) {                 # \xhh eller \x{h...}
        hvis (_kikk(cs) == 123) {
            _hopp(cs, 1)
            la v: heltall = 0
            la tal: heltall = 0
            mens (_kikk(cs) != 125) {
                la h: heltall = _hex(_kikk(cs))
                hvis (h < 0) { _feil(cs, "ugyldig \\x{...}") }
                v = v * 16 + h
                tal = tal + 1
                _hopp(cs, 1)
            }
            _hopp(cs, 1)
            hvis (tal == 0) { _feil(cs, "tom \\x{}") }
            returner v
        }
        returner _les_hex(cs, 2)
    }
    hvis (c == 117) { returner _les_hex(cs, 4) }   # \uhhhh
    hvis (c >= 49 og c <= 57) { _feil(cs, "tilbakereferansar (\\" + builtin.chr(c) + ") er ikkje støtta") }
    hvis (c == 112 eller c == 80) { _feil(cs, "\\p{...}-klassar er ikkje støtta") }
    hvis (c == 107) { _feil(cs, "namngjevne tilbakereferansar (\\k) er ikkje støtta") }
    # Alle andre teikn (\. \* \\ \/ \- \[ \$ ...) er literal.
    returner c
}

funksjon _p_atom(cs) -> heltall {
    la st: liste_heltall = cs[1]
    la c: heltall = _kikk(cs)
    hvis (c == 40) { returner _p_gruppe(cs) }
    hvis (c == 91) {
        _hopp(cs, 1)
        returner _p_klasse(cs)
    }
    hvis (c == 46) {
        _hopp(cs, 1)
        hvis (st[4] == 1) { returner _op_node(cs, 3, 0) }
        returner _op_node(cs, 2, 0)
    }
    hvis (c == 94) {
        _hopp(cs, 1)
        hvis (st[3] == 1) { returner _op_node(cs, 12, 0) }
        returner _op_node(cs, 11, 0)
    }
    hvis (c == 36) {
        _hopp(cs, 1)
        hvis (st[3] == 1) { returner _op_node(cs, 15, 0) }
        returner _op_node(cs, 14, 0)
    }
    hvis (c == 42 eller c == 43 eller c == 63) { _feil(cs, "kvantor utan noko å gjenta") }
    hvis (c == 92) {
        _hopp(cs, 1)
        la e: heltall = _kikk(cs)
        hvis (e == -1) { _feil(cs, "mønsteret sluttar med \\") }
        _hopp(cs, 1)
        hvis (e == 100) { returner _op_node(cs, 8, 0) }
        hvis (e == 68) { returner _op_node(cs, 8, 1) }
        hvis (e == 119) { returner _op_node(cs, 9, 0) }
        hvis (e == 87) { returner _op_node(cs, 9, 1) }
        hvis (e == 115) { returner _op_node(cs, 10, 0) }
        hvis (e == 83) { returner _op_node(cs, 10, 1) }
        hvis (e == 98) { returner _op_node(cs, 16, 0) }
        hvis (e == 66) { returner _op_node(cs, 17, 0) }
        hvis (e == 65) { returner _op_node(cs, 11, 0) }
        hvis (e == 122) { returner _op_node(cs, 13, 0) }
        hvis (e == 90) { returner _op_node(cs, 14, 0) }
        returner _teikn_node(cs, _escape_kode(cs, e))
    }
    _hopp(cs, 1)
    returner _teikn_node(cs, c)
}

funksjon _teikn_node(cs, cp: heltall) -> heltall {
    hvis (cs[1][2] == 1 og _fold(cp) != _stor(_fold(cp))) {
        returner _op_node(cs, 19, _fold(cp))
    }
    returner _op_node(cs, 1, cp)
}

funksjon _les_namn(cs, slutt: heltall) -> tekst {
    la namn: tekst = ""
    mens (_kikk(cs) != slutt) {
        la c: heltall = _kikk(cs)
        hvis (c == -1) { _feil(cs, "uavslutta gruppenamn") }
        hvis (ikkje _er_ord(c)) { _feil(cs, "ugyldig teikn i gruppenamn") }
        namn = namn + builtin.chr(c)
        _hopp(cs, 1)
    }
    _hopp(cs, 1)
    hvis (namn == "") { _feil(cs, "tomt gruppenamn") }
    returner namn
}

funksjon _ny_gruppe(cs) -> heltall {
    la st: liste_heltall = cs[1]
    st[1] = st[1] + 1
    returner st[1]
}

# Les innhaldet i ei gruppe og ")". Flagga blir sette tilbake når gruppa
# sluttar (Java-semantikk).
funksjon _gruppe_kropp(cs) -> heltall {
    la st: liste_heltall = cs[1]
    la fi: heltall = st[2]
    la fm: heltall = st[3]
    la fs: heltall = st[4]
    la fx: heltall = st[5]
    la inni: heltall = _p_alt(cs)
    hvis (_kikk(cs) != 41) { _feil(cs, "manglar )") }
    _hopp(cs, 1)
    st[2] = fi
    st[3] = fm
    st[4] = fs
    st[5] = fx
    returner inni
}

funksjon _p_gruppe(cs) -> heltall {
    la st: liste_heltall = cs[1]
    _hopp(cs, 1)
    hvis (_kikk(cs) != 63) {
        la nr: heltall = _ny_gruppe(cs)
        la g: heltall = _node(cs, 6, nr, 0, 0)
        _legg_barn(cs, g, _gruppe_kropp(cs))
        returner g
    }
    _hopp(cs, 1)
    la c: heltall = _kikk(cs)
    hvis (c == 58) {
        _hopp(cs, 1)
        returner _gruppe_kropp(cs)
    }
    hvis (c == 80 og _kikk_ved(cs, 1) == 60) {
        _hopp(cs, 2)
        returner _namngjeven(cs)
    }
    hvis (c == 60 og _kikk_ved(cs, 1) != 61 og _kikk_ved(cs, 1) != 33) {
        _hopp(cs, 1)
        returner _namngjeven(cs)
    }
    hvis (c == 61 eller c == 33) {
        _hopp(cs, 1)
        la neg: heltall = 0
        hvis (c == 33) { neg = 1 }
        la l: heltall = _node(cs, 8, 0, neg, 0)
        _legg_barn(cs, l, _gruppe_kropp(cs))
        returner l
    }
    hvis (c == 60) { _feil(cs, "lookbehind (?<=...) / (?<!...) er ikkje støtta") }
    hvis (c == 62) { _feil(cs, "atomiske grupper (?>...) er ikkje støtta") }
    hvis (c == 35) {
        mens (_kikk(cs) != 41) {
            hvis (_kikk(cs) == -1) { _feil(cs, "uavslutta (?#") }
            _hopp(cs, 1)
        }
        _hopp(cs, 1)
        returner -1
    }
    # Flagg: (?imsx-imsx) gjeld resten av gruppa rundt; (?imsx-imsx:...) berre
    # innhaldet. u/U/d blir godtekne og ignorerte.
    la fi: heltall = st[2]
    la fm: heltall = st[3]
    la fs: heltall = st[4]
    la fx: heltall = st[5]
    la på: heltall = 1
    la vidare: bool = sann
    mens (vidare) {
        la f: heltall = _kikk(cs)
        hvis (f == 105) { st[2] = på }
        ellers hvis (f == 109) { st[3] = på }
        ellers hvis (f == 115) { st[4] = på }
        ellers hvis (f == 120) { st[5] = på }
        ellers hvis (f == 45) { på = 0 }
        ellers hvis (f != 117 og f != 85 og f != 100) { vidare = usann }
        hvis (vidare) { _hopp(cs, 1) }
    }
    la slutt: heltall = _kikk(cs)
    hvis (slutt == 41) {
        _hopp(cs, 1)
        returner -1
    }
    hvis (slutt == 58) {
        _hopp(cs, 1)
        la inni: heltall = _gruppe_kropp(cs)
        st[2] = fi
        st[3] = fm
        st[4] = fs
        st[5] = fx
        returner inni
    }
    _feil(cs, "ukjend gruppe (?" + _cp_tekst(slutt))
    returner -1
}

funksjon _namngjeven(cs) -> heltall {
    la namn: tekst = _les_namn(cs, 62)
    la nl = cs[3][2]
    la namneliste: liste_tekst = nl[0]
    la i: heltall = 0
    mens (i < lengde(namneliste)) {
        hvis (namneliste[i] == namn) { _feil(cs, "gruppenamnet «" + namn + "» er brukt før") }
        i = i + 1
    }
    la nr: heltall = _ny_gruppe(cs)
    legg_til(namneliste, namn)
    legg_til(nl[1], nr)
    la g: heltall = _node(cs, 6, nr, 0, 0)
    _legg_barn(cs, g, _gruppe_kropp(cs))
    returner g
}

# Teiknklasse etter "[". Legg klassen flatt i kl og returnerer ein CLASS-node.
funksjon _p_klasse(cs) -> heltall {
    la neg: heltall = 0
    hvis (_kikk(cs) == 94) {
        neg = 1
        _hopp(cs, 1)
    }
    la område: liste_heltall = []
    la første: bool = sann
    la vidare: bool = sann
    mens (vidare) {
        la c: heltall = _kikk(cs)
        hvis (c == -1) { _feil(cs, "manglar ]") }
        hvis (c == 93 og ikkje første) {
            _hopp(cs, 1)
            vidare = usann
        } ellers {
            første = usann
            la lo: heltall = _klasse_teikn(cs, område)
            hvis (lo >= 0) {
                # Område a-b (men "-" rett før "]" er literal)
                hvis (_kikk(cs) == 45 og _kikk_ved(cs, 1) != 93 og _kikk_ved(cs, 1) != -1) {
                    _hopp(cs, 1)
                    la hi: heltall = _klasse_teikn(cs, område)
                    hvis (hi < 0) { _feil(cs, "ugyldig område i teiknklasse") }
                    hvis (hi < lo) { _feil(cs, "område ute av rekkjefølgje i teiknklasse") }
                    _legg_område(område, lo, hi)
                } ellers {
                    _legg_område(område, lo, lo)
                }
            }
        }
    }
    la kl: liste_heltall = cs[3][1]
    la o: heltall = lengde(kl)
    legg_til(kl, neg)
    legg_til(kl, lengde(område) / 2)
    la i: heltall = 0
    mens (i < lengde(område)) {
        legg_til(kl, område[i])
        i = i + 1
    }
    hvis (cs[1][2] == 1) { returner _op_node(cs, 20, o) }
    returner _op_node(cs, 4, o)
}

funksjon _legg_område(område: liste_heltall, lo: heltall, hi: heltall) {
    legg_til(område, lo)
    legg_til(område, hi)
}

# Legg komplementet av (sorterte, ikkje-overlappande) område til.
funksjon _legg_komplement(område: liste_heltall, ut_av: liste_heltall) {
    la forrige: heltall = 0
    la i: heltall = 0
    mens (i < lengde(ut_av)) {
        hvis (ut_av[i] > forrige) { _legg_område(område, forrige, ut_av[i] - 1) }
        forrige = ut_av[i + 1] + 1
        i = i + 2
    }
    _legg_område(område, forrige, 1114111)
}

# Eitt element i ein teiknklasse: returnerer kodepunktet, eller -1 når
# elementet var ein klasse-escape (\d \w \s ...) som alt er lagd til.
funksjon _klasse_teikn(cs, område: liste_heltall) -> heltall {
    la c: heltall = _kikk(cs)
    _hopp(cs, 1)
    hvis (c == 91 og _kikk(cs) == 58) { _feil(cs, "POSIX-klassar [:...:] er ikkje støtta") }
    hvis (c != 92) { returner c }
    la e: heltall = _kikk(cs)
    hvis (e == -1) { _feil(cs, "mønsteret sluttar med \\") }
    _hopp(cs, 1)
    hvis (e == 100) {
        _legg_område(område, 48, 57)
        returner -1
    }
    hvis (e == 68) {
        _legg_komplement(område, [48, 57])
        returner -1
    }
    hvis (e == 119) {
        _legg_område(område, 48, 57)
        _legg_område(område, 65, 90)
        _legg_område(område, 95, 95)
        _legg_område(område, 97, 122)
        returner -1
    }
    hvis (e == 87) {
        _legg_komplement(område, [48, 57, 65, 90, 95, 95, 97, 122])
        returner -1
    }
    hvis (e == 115) {
        _legg_område(område, 9, 13)
        _legg_område(område, 32, 32)
        returner -1
    }
    hvis (e == 83) {
        _legg_komplement(område, [9, 13, 32, 32])
        returner -1
    }
    hvis (e == 98) { returner 8 }   # \b i klasse = backspace
    returner _escape_kode(cs, e)
}

# ─── Kodegenerering ───────────────────────────────────────────────────────────
# Program pg = [kode, kl, meta, namn]
#   kode = [ops, pa, pb, memo]    memo[pc] = SPLIT-nummer (elles -1)
#   meta = [ngrupper, nsplit, forankra, filter_op, filter_arg]
#   namn = [gruppenamn, gruppenr]

funksjon _emit(pg, op: heltall, a: heltall, b: heltall) -> heltall {
    la kode = pg[0]
    legg_til(kode[0], op)
    legg_til(kode[1], a)
    legg_til(kode[2], b)
    legg_til(kode[3], -1)
    returner lengde(kode[0]) - 1
}

funksjon _lengd(pg) -> heltall {
    returner lengde(pg[0][0])
}

funksjon _gen(cs, pg, n: heltall) {
    la tre = cs[2]
    la t: heltall = tre[0][n]
    la pa: liste_heltall = pg[0][1]
    la pb: liste_heltall = pg[0][2]
    hvis (t == 1) {
        _emit(pg, tre[1][n], tre[2][n], 0)
    } ellers hvis (t == 4) {
        la b: heltall = _første_barn(cs, n)
        mens (b >= 0) {
            _gen(cs, pg, b)
            b = _neste_søsken(cs, b)
        }
    } ellers hvis (t == 5) {
        la hopp: liste_heltall = []
        la b: heltall = _første_barn(cs, n)
        mens (b >= 0) {
            la neste: heltall = _neste_søsken(cs, b)
            hvis (neste >= 0) {
                la s: heltall = _emit(pg, 5, 0, 0)
                pa[s] = s + 1
                _gen(cs, pg, b)
                legg_til(hopp, _emit(pg, 6, 0, 0))
                pb[s] = _lengd(pg)
            } ellers {
                _gen(cs, pg, b)
            }
            b = neste
        }
        la slutt: heltall = _lengd(pg)
        la j: heltall = 0
        mens (j < lengde(hopp)) {
            pa[hopp[j]] = slutt
            j = j + 1
        }
    } ellers hvis (t == 6) {
        la nr: heltall = tre[1][n]
        _emit(pg, 7, 2 * nr, 0)
        _gen(cs, pg, _første_barn(cs, n))
        _emit(pg, 7, 2 * nr + 1, 0)
    } ellers hvis (t == 7) {
        la mn: heltall = tre[1][n]
        la mx: heltall = tre[2][n]
        la grådig: bool = tre[3][n] == 1
        la kropp: heltall = _første_barn(cs, n)
        la i: heltall = 0
        mens (i < mn) {
            _gen(cs, pg, kropp)
            i = i + 1
        }
        hvis (mx == -1) {
            la l: heltall = _emit(pg, 5, 0, 0)
            _gen(cs, pg, kropp)
            _emit(pg, 6, l, 0)
            la slutt: heltall = _lengd(pg)
            hvis (grådig) {
                pa[l] = l + 1
                pb[l] = slutt
            } ellers {
                pa[l] = slutt
                pb[l] = l + 1
            }
        } ellers {
            la splittar: liste_heltall = []
            la k: heltall = mn
            mens (k < mx) {
                legg_til(splittar, _emit(pg, 5, 0, 0))
                _gen(cs, pg, kropp)
                k = k + 1
            }
            la slutt: heltall = _lengd(pg)
            la j: heltall = 0
            mens (j < lengde(splittar)) {
                la s2: heltall = splittar[j]
                hvis (grådig) {
                    pa[s2] = s2 + 1
                    pb[s2] = slutt
                } ellers {
                    pa[s2] = slutt
                    pb[s2] = s2 + 1
                }
                j = j + 1
            }
        }
    } ellers hvis (t == 8) {
        # LOOK a=start på delprogrammet, b=neg; delprogrammet sluttar med LMATCH.
        la l: heltall = _emit(pg, 18, 0, tre[2][n])
        la forbi: heltall = _emit(pg, 6, 0, 0)
        pa[l] = _lengd(pg)
        _gen(cs, pg, _første_barn(cs, n))
        _emit(pg, 21, 0, 0)
        pa[forbi] = _lengd(pg)
    }
}

# Første obligatoriske teikn-test (for å hoppe raskt over startposisjonar):
# [op, arg] for CHAR/CHAR_I/CLASS/CLASS_I/DIGIT/WORD/SPACE, elles [-1, 0].
funksjon _første(cs, n: heltall) -> liste_heltall {
    la tre = cs[2]
    la t: heltall = tre[0][n]
    hvis (t == 1) {
        la op: heltall = tre[1][n]
        hvis (op == 1 eller op == 4 eller op == 8 eller op == 9 eller op == 10 eller op == 19 eller op == 20) {
            returner [op, tre[2][n]]
        }
        returner [-1, 0]
    }
    hvis (t == 4) {
        la b: heltall = _første_barn(cs, n)
        mens (b >= 0) {
            # Hopp over \b og \B (null breidd); andre påstandar stoppar.
            hvis (tre[0][b] == 1 og (tre[1][b] == 16 eller tre[1][b] == 17)) {
                b = _neste_søsken(cs, b)
            } ellers {
                returner _første(cs, b)
            }
        }
        returner [-1, 0]
    }
    hvis (t == 6) { returner _første(cs, _første_barn(cs, n)) }
    hvis (t == 7 og tre[1][n] >= 1) { returner _første(cs, _første_barn(cs, n)) }
    returner [-1, 0]
}

# Er mønsteret forankra til tekststart (\A, eller ^ utan (?m))?
funksjon _forankra(cs, n: heltall) -> bool {
    la tre = cs[2]
    la t: heltall = tre[0][n]
    hvis (t == 1) { returner tre[1][n] == 11 }
    hvis (t == 4 og _første_barn(cs, n) >= 0) { returner _forankra(cs, _første_barn(cs, n)) }
    hvis (t == 6) { returner _forankra(cs, _første_barn(cs, n)) }
    returner usann
}

# Kompiler mønster til program. Kastar "regex: ..." ved ugyldig mønster.
funksjon kompiler(mønster: tekst) -> liste {
    la dek = _dekod(mønster)
    la tre: liste = []
    legg_til(tre, [])
    legg_til(tre, [])
    legg_til(tre, [])
    legg_til(tre, [])
    la lenke: liste = []
    legg_til(lenke, [])
    legg_til(lenke, [])
    legg_til(lenke, [])
    la kl: liste_heltall = []
    la namn: liste = []
    legg_til(namn, [])
    legg_til(namn, [])
    la rest: liste = []
    legg_til(rest, lenke)
    legg_til(rest, kl)
    legg_til(rest, namn)
    la cs: liste = []
    legg_til(cs, dek[0])
    legg_til(cs, [0, 0, 0, 0, 0, 0])
    legg_til(cs, tre)
    legg_til(cs, rest)
    la rot: heltall = _p_alt(cs)
    hvis (_kikk(cs) == 41) { _feil(cs, "ubalansert )") }
    hvis (_kikk(cs) != -1) { _feil(cs, "uventa teikn") }

    la kode: liste = []
    legg_til(kode, [])
    legg_til(kode, [])
    legg_til(kode, [])
    legg_til(kode, [])
    la meta: liste_heltall = []
    la pg: liste = []
    legg_til(pg, kode)
    legg_til(pg, kl)
    legg_til(pg, meta)
    legg_til(pg, namn)
    _emit(pg, 7, 0, 0)
    _gen(cs, pg, rot)
    _emit(pg, 7, 1, 0)
    _emit(pg, 0, 0, 0)

    # Memo-nummer for kvar SPLIT.
    la ops: liste_heltall = kode[0]
    la memo: liste_heltall = kode[3]
    la ns: heltall = 0
    la i: heltall = 0
    mens (i < lengde(ops)) {
        hvis (ops[i] == 5) {
            memo[i] = ns
            ns = ns + 1
        }
        i = i + 1
    }
    la forankra: heltall = 0
    hvis (_forankra(cs, rot)) { forankra = 1 }
    la f = _første(cs, rot)
    legg_til(meta, cs[1][1])
    legg_til(meta, ns)
    legg_til(meta, forankra)
    legg_til(meta, f[0])
    legg_til(meta, f[1])
    returner pg
}

# ─── Matching ─────────────────────────────────────────────────────────────────

funksjon _i_klasse(kl: liste_heltall, o: heltall, c: heltall) -> bool {
    la i: heltall = o + 2
    la slutt: heltall = i + 2 * kl[o + 1]
    mens (i < slutt) {
        hvis (c >= kl[i] og c <= kl[i + 1]) { returner kl[o] == 0 }
        i = i + 2
    }
    returner kl[o] == 1
}

funksjon _atom_ok(kl: liste_heltall, op: heltall, arg: heltall, c: heltall) -> bool {
    hvis (op == 1) { returner c == arg }
    hvis (op == 19) { returner _fold(c) == arg }
    hvis (op == 9) { returner _er_ord(c) != (arg == 1) }
    hvis (op == 8) { returner (c >= 48 og c <= 57) != (arg == 1) }
    hvis (op == 10) { returner (c == 32 eller (c >= 9 og c <= 13)) != (arg == 1) }
    hvis (op == 4) { returner _i_klasse(kl, arg, c) }
    hvis (op == 20) {
        la f: heltall = _fold(c)
        hvis (_i_klasse(kl, arg, f)) { returner sann }
        la s: heltall = _stor(f)
        hvis (s != f) { returner _i_klasse(kl, arg, s) }
        returner usann
    }
    returner sann
}

# Køyr programmet frå instruksjon pc0 ved posisjon start.
# caps: fangstposisjonar (skrivne ved treff; attende til utgangsverdiane når
# det ikkje blir treff). tilstand = [vis, [gen], [sp, sv], _]: memo for
# (SPLIT, pos) og gjenbrukt stakk. krev_slutt: MATCH godtek berre pos == n
# (fullsamsvar). Returnerer sluttposisjon eller -1.
# (Maks åtte parametrar: x86-64-AOT sender 13+ argument feil i dag.)
funksjon _kjør(pg, koder: liste_heltall, n: heltall, pc0: heltall, start: heltall,
               caps: liste_heltall, tilstand, krev_slutt: bool) -> heltall {
    la kode = pg[0]
    la kl: liste_heltall = pg[1]
    la ns: heltall = pg[2][1]
    la ops: liste_heltall = kode[0]
    la pa: liste_heltall = kode[1]
    la pb: liste_heltall = kode[2]
    la memo: liste_heltall = kode[3]
    la vis: liste_heltall = tilstand[0]
    la gen: heltall = tilstand[1][0]
    la stakk = tilstand[2]
    la sp: liste_heltall = stakk[0]
    la sv: liste_heltall = stakk[1]
    sp[0] = pc0
    sv[0] = start
    la topp: heltall = 1
    mens (topp > 0) {
        topp = topp - 1
        la pc: heltall = sp[topp]
        la pos: heltall = sv[topp]
        hvis (pc < 0) {
            caps[0 - pc - 1] = pos
        } ellers {
            la går: bool = sann
            mens (går) {
                la op: heltall = ops[pc]
                hvis (op == 1) {
                    hvis (pos < n og koder[pos] == pa[pc]) {
                        pc = pc + 1
                        pos = pos + 1
                    } ellers { går = usann }
                } ellers hvis (op == 9) {
                    hvis (pos < n og _er_ord(koder[pos]) != (pa[pc] == 1)) {
                        pc = pc + 1
                        pos = pos + 1
                    } ellers { går = usann }
                } ellers hvis (op == 5) {
                    la idx: heltall = pos * ns + memo[pc]
                    mens (idx >= lengde(vis)) { legg_til(vis, 0) }
                    hvis (vis[idx] == gen) {
                        går = usann
                    } ellers {
                        vis[idx] = gen
                        hvis (topp < lengde(sp)) {
                            sp[topp] = pb[pc]
                            sv[topp] = pos
                        } ellers {
                            legg_til(sp, pb[pc])
                            legg_til(sv, pos)
                        }
                        topp = topp + 1
                        pc = pa[pc]
                    }
                } ellers hvis (op == 6) {
                    pc = pa[pc]
                } ellers hvis (op == 7) {
                    la slot: heltall = pa[pc]
                    hvis (topp < lengde(sp)) {
                        sp[topp] = 0 - slot - 1
                        sv[topp] = caps[slot]
                    } ellers {
                        legg_til(sp, 0 - slot - 1)
                        legg_til(sv, caps[slot])
                    }
                    topp = topp + 1
                    caps[slot] = pos
                    pc = pc + 1
                } ellers hvis (op == 4 eller op == 8 eller op == 10 eller op == 19 eller op == 20) {
                    hvis (pos < n og _atom_ok(kl, op, pa[pc], koder[pos])) {
                        pc = pc + 1
                        pos = pos + 1
                    } ellers { går = usann }
                } ellers hvis (op == 2) {
                    hvis (pos < n og koder[pos] != 10) {
                        pc = pc + 1
                        pos = pos + 1
                    } ellers { går = usann }
                } ellers hvis (op == 3) {
                    hvis (pos < n) {
                        pc = pc + 1
                        pos = pos + 1
                    } ellers { går = usann }
                } ellers hvis (op == 0) {
                    hvis (krev_slutt og pos != n) { går = usann } ellers { returner pos }
                } ellers hvis (op == 21) {
                    returner pos
                } ellers hvis (op == 11) {
                    hvis (pos == 0) { pc = pc + 1 } ellers { går = usann }
                } ellers hvis (op == 12) {
                    hvis (pos == 0) { pc = pc + 1 }
                    ellers hvis (koder[pos - 1] == 10) { pc = pc + 1 }
                    ellers { går = usann }
                } ellers hvis (op == 13) {
                    hvis (pos == n) { pc = pc + 1 } ellers { går = usann }
                } ellers hvis (op == 14) {
                    hvis (pos == n) { pc = pc + 1 }
                    ellers hvis (pos == n - 1 og koder[pos] == 10) { pc = pc + 1 }
                    ellers { går = usann }
                } ellers hvis (op == 15) {
                    hvis (pos == n) { pc = pc + 1 }
                    ellers hvis (koder[pos] == 10) { pc = pc + 1 }
                    ellers { går = usann }
                } ellers hvis (op == 16 eller op == 17) {
                    la før: bool = usann
                    hvis (pos > 0) { før = _er_ord(koder[pos - 1]) }
                    la etter: bool = usann
                    hvis (pos < n) { etter = _er_ord(koder[pos]) }
                    la grense: bool = før != etter
                    hvis (grense == (op == 16)) { pc = pc + 1 } ellers { går = usann }
                } ellers hvis (op == 18) {
                    # Lookahead: eige søk med eiga memo og stakk; fangstar inni
                    # blir ikkje behaldne.
                    la kopi: liste_heltall = []
                    la ci: heltall = 0
                    mens (ci < lengde(caps)) {
                        legg_til(kopi, caps[ci])
                        ci = ci + 1
                    }
                    la r: heltall = _kjør(pg, koder, n, pa[pc], pos, kopi, _ny_tilstand(pg), usann)
                    la treff: bool = r >= 0
                    hvis (treff != (pb[pc] == 1)) { pc = pc + 1 } ellers { går = usann }
                } ellers {
                    går = usann
                }
            }
        }
    }
    returner -1
}

# Første startposisjon >= frå der det første obligatoriske teiknet kan stå.
funksjon _neste_kandidat(kl: liste_heltall, fop: heltall, farg: heltall,
                         koder: liste_heltall, n: heltall, frå: heltall) -> heltall {
    hvis (fop < 0) { returner frå }
    la p: heltall = frå
    hvis (fop == 1) {
        mens (p < n) {
            hvis (koder[p] == farg) { returner p }
            p = p + 1
        }
        returner -1
    }
    mens (p < n) {
        hvis (_atom_ok(kl, fop, farg, koder[p])) { returner p }
        p = p + 1
    }
    returner -1
}

# Søketilstand for éin tekst: [vis, [gen], [sp, sv], caps]. Blir delt mellom
# påfølgjande søk (finn_alle, erstatt_alle, del_på) så ingenting blir allokert
# per startposisjon.
funksjon _ny_tilstand(pg) -> liste {
    la ng: heltall = pg[2][0]
    la caps: liste_heltall = []
    la i: heltall = 0
    mens (i < 2 * ng + 2) {
        legg_til(caps, -1)
        i = i + 1
    }
    la stakk: liste = []
    legg_til(stakk, [0])
    legg_til(stakk, [0])
    la t: liste = []
    legg_til(t, [])
    legg_til(t, [1])
    legg_til(t, stakk)
    legg_til(t, caps)
    returner t
}

# Søk frå posisjon frå. Ved treff: sann, og tilstand[3] (caps) har
# caps[0]/caps[1] = start/slutt og gruppeposisjonane.
funksjon _søk(pg, koder: liste_heltall, frå: heltall, tilstand) -> bool {
    la n: heltall = lengde(koder)
    la kl: liste_heltall = pg[1]
    la meta: liste_heltall = pg[2]
    la forankra: bool = meta[2] == 1
    la fop: heltall = meta[3]
    la farg: heltall = meta[4]
    la genliste: liste_heltall = tilstand[1]
    la gen: heltall = genliste[0]
    la caps: liste_heltall = tilstand[3]
    la i: heltall = 0
    mens (i < lengde(caps)) {
        caps[i] = -1
        i = i + 1
    }
    la p: heltall = frå
    mens (p <= n) {
        hvis (forankra og p > 0) { returner usann }
        la kand: heltall = p
        hvis (ikkje forankra) {
            kand = _neste_kandidat(kl, fop, farg, koder, n, p)
            # Eit obligatorisk første teikn finst ikkje lenger ut i teksten.
            hvis (kand < 0) { returner usann }
        }
        la slutt: heltall = _kjør(pg, koder, n, 0, kand, caps, tilstand, usann)
        hvis (slutt >= 0) {
            # Ny memo-generasjon: tilstandane på treffstien er ikkje feil.
            genliste[0] = gen + 1
            returner sann
        }
        p = kand + 1
    }
    returner usann
}

funksjon _del_tekst(dek, s: heltall, e: heltall) -> tekst {
    la bp: liste_heltall = dek[1]
    returner builtin.join(builtin.slice(dek[2], bp[s], bp[e]), "")
}

funksjon _nytt_samsvar(pg, dek, caps: liste_heltall) -> ordbok_tekst {
    la m: ordbok_tekst = {}
    m["ok"] = "1"
    m["start"] = tekst_fra_heltall(caps[0])
    m["slutt"] = tekst_fra_heltall(caps[1])
    m["g0"] = _del_tekst(dek, caps[0], caps[1])
    la ng: heltall = pg[2][0]
    m["_ngrupper"] = tekst_fra_heltall(ng)
    la g: heltall = 1
    mens (g <= ng) {
        la s: heltall = caps[2 * g]
        la e: heltall = caps[2 * g + 1]
        hvis (s >= 0 og e >= s) {
            la gn: tekst = "g" + tekst_fra_heltall(g)
            m[gn + "_s"] = tekst_fra_heltall(s)
            m[gn + "_e"] = tekst_fra_heltall(e)
            m[gn] = _del_tekst(dek, s, e)
        }
        g = g + 1
    }
    la nl = pg[3]
    la namneliste: liste_tekst = nl[0]
    la nrliste: liste_heltall = nl[1]
    la i: heltall = 0
    mens (i < lengde(namneliste)) {
        la nm: tekst = namneliste[i]
        la gn2: tekst = "g" + tekst_fra_heltall(nrliste[i])
        hvis (har_nokkel(m, gn2)) {
            m["n" + nm + "_s"] = m[gn2 + "_s"]
            m["n" + nm + "_e"] = m[gn2 + "_e"]
            m["n" + nm] = m[gn2]
        }
        i = i + 1
    }
    returner m
}

funksjon _tomt_samsvar() -> ordbok_tekst {
    la m: ordbok_tekst = {}
    m["ok"] = "0"
    m["start"] = "-1"
    m["slutt"] = "-1"
    m["g0"] = ""
    returner m
}

# ─── Offentleg API ────────────────────────────────────────────────────────────

# Første treff (Java Matcher.find / Python re.search).
funksjon finn_samsvar(tok, inndata: tekst) -> ordbok_tekst {
    la dek = _dekod(inndata)
    la tilstand = _ny_tilstand(tok)
    hvis (ikkje _søk(tok, dek[0], 0, tilstand)) { returner _tomt_samsvar() }
    returner _nytt_samsvar(tok, dek, tilstand[3])
}

# Heile teksten må matche (Java Matcher.matches / Python re.fullmatch).
funksjon fullsamsvar(tok, inndata: tekst) -> ordbok_tekst {
    la dek = _dekod(inndata)
    la koder: liste_heltall = dek[0]
    la tilstand = _ny_tilstand(tok)
    la caps: liste_heltall = tilstand[3]
    la slutt: heltall = _kjør(tok, koder, lengde(koder), 0, 0, caps, tilstand, sann)
    hvis (slutt < 0) { returner _tomt_samsvar() }
    returner _nytt_samsvar(tok, dek, caps)
}

# Alle ikkje-overlappande treff (heile treffet), frå venstre.
funksjon finn_alle_samsvar(tok, inndata: tekst) -> liste_tekst {
    la dek = _dekod(inndata)
    la koder: liste_heltall = dek[0]
    la n: heltall = lengde(koder)
    la tilstand = _ny_tilstand(tok)
    la caps: liste_heltall = tilstand[3]
    la resultat: liste_tekst = []
    la p: heltall = 0
    mens (p <= n) {
        hvis (ikkje _søk(tok, koder, p, tilstand)) { returner resultat }
        legg_til(resultat, _del_tekst(dek, caps[0], caps[1]))
        hvis (caps[1] > caps[0]) { p = caps[1] } ellers { p = caps[1] + 1 }
    }
    returner resultat
}

# Alle treff som match-objekt (Java: while (m.find()) ...).
funksjon finn_alle_objekt(tok, inndata: tekst) -> liste {
    la dek = _dekod(inndata)
    la koder: liste_heltall = dek[0]
    la n: heltall = lengde(koder)
    la tilstand = _ny_tilstand(tok)
    la caps: liste_heltall = tilstand[3]
    la resultat: liste = []
    la p: heltall = 0
    mens (p <= n) {
        hvis (ikkje _søk(tok, koder, p, tilstand)) { returner resultat }
        legg_til(resultat, _nytt_samsvar(tok, dek, caps))
        hvis (caps[1] > caps[0]) { p = caps[1] } ellers { p = caps[1] + 1 }
    }
    returner resultat
}

# ─── Match-objekt-tilgang ─────────────────────────────────────────────────────

funksjon er_samsvar(m: ordbok_tekst) -> bool  {
    returner m["ok"] == "1"
}
funksjon samsvar_start(m: ordbok_tekst) -> heltall  {
    returner builtin.heltall_fra_tekst(m["start"])
}
funksjon samsvar_slutt(m: ordbok_tekst) -> heltall  {
    returner builtin.heltall_fra_tekst(m["slutt"])
}

# Gruppe n (0 = heile treffet); "" når gruppa ikkje var med i treffet.
funksjon gruppe(m: ordbok_tekst, n: heltall) -> tekst {
    hvis (n == 0) { returner m["g0"] }
    la k: tekst = "g" + tekst_fra_heltall(n)
    hvis (har_nokkel(m, k)) { returner m[k] }
    returner ""
}

# Start/slutt (kodepunkt) for gruppe n; -1 når gruppa ikkje var med.
funksjon gruppe_start(m: ordbok_tekst, n: heltall) -> heltall {
    hvis (n == 0) { returner samsvar_start(m) }
    la k: tekst = "g" + tekst_fra_heltall(n) + "_s"
    hvis (har_nokkel(m, k)) { returner builtin.heltall_fra_tekst(m[k]) }
    returner -1
}

funksjon gruppe_slutt(m: ordbok_tekst, n: heltall) -> heltall {
    hvis (n == 0) { returner samsvar_slutt(m) }
    la k: tekst = "g" + tekst_fra_heltall(n) + "_e"
    hvis (har_nokkel(m, k)) { returner builtin.heltall_fra_tekst(m[k]) }
    returner -1
}

funksjon gruppe_tal(m: ordbok_tekst) -> heltall {
    hvis (har_nokkel(m, "_ngrupper")) { returner builtin.heltall_fra_tekst(m["_ngrupper"]) }
    returner 0
}

# Namngjeven gruppe ((?P<namn>...) / (?<namn>...)); "" når ho ikkje var med.
funksjon named_gruppe(m: ordbok_tekst, namn: tekst) -> tekst {
    la k: tekst = "n" + namn
    hvis (har_nokkel(m, k)) { returner m[k] }
    returner ""
}

funksjon namngjeven_gruppe(m: ordbok_tekst, namn: tekst) -> tekst {
    returner named_gruppe(m, namn)
}

# ─── Erstatting og deling ─────────────────────────────────────────────────────

# Erstatt første treff med ny_val (literal tekst).
funksjon erstatt(tok, inndata: tekst, ny_val: tekst) -> tekst {
    la dek = _dekod(inndata)
    la tilstand = _ny_tilstand(tok)
    hvis (ikkje _søk(tok, dek[0], 0, tilstand)) { returner inndata }
    la caps: liste_heltall = tilstand[3]
    la n: heltall = lengde(dek[0])
    returner _del_tekst(dek, 0, caps[0]) + ny_val + _del_tekst(dek, caps[1], n)
}

# Erstatt alle treff med ny_val (literal tekst). Eit tomt treff blir erstatta
# og teiknet etter kopiert (som Python re.sub / Java replaceAll).
funksjon erstatt_alle(tok, inndata: tekst, ny_val: tekst) -> tekst {
    la dek = _dekod(inndata)
    la koder: liste_heltall = dek[0]
    la n: heltall = lengde(koder)
    la tilstand = _ny_tilstand(tok)
    la caps: liste_heltall = tilstand[3]
    la delar: liste_tekst = []
    la p: heltall = 0
    la kopiert: heltall = 0
    mens (p <= n) {
        hvis (ikkje _søk(tok, koder, p, tilstand)) {
            p = n + 1
        } ellers {
            la s: heltall = caps[0]
            la e: heltall = caps[1]
            legg_til(delar, _del_tekst(dek, kopiert, s))
            legg_til(delar, ny_val)
            kopiert = e
            hvis (e > s) {
                p = e
            } ellers {
                hvis (e < n) { legg_til(delar, _del_tekst(dek, e, e + 1)) }
                kopiert = e + 1
                p = e + 1
            }
        }
    }
    hvis (kopiert < n) { legg_til(delar, _del_tekst(dek, kopiert, n)) }
    returner builtin.join(delar, "")
}

# Del teksten på (ikkje-tomme) treff.
funksjon del_på(tok, inndata: tekst) -> liste_tekst {
    la dek = _dekod(inndata)
    la koder: liste_heltall = dek[0]
    la n: heltall = lengde(koder)
    la tilstand = _ny_tilstand(tok)
    la caps: liste_heltall = tilstand[3]
    la delar: liste_tekst = []
    la siste: heltall = 0
    la p: heltall = 0
    mens (p <= n) {
        hvis (ikkje _søk(tok, koder, p, tilstand)) {
            p = n + 1
        } ellers hvis (caps[1] > caps[0]) {
            legg_til(delar, _del_tekst(dek, siste, caps[0]))
            siste = caps[1]
            p = caps[1]
        } ellers {
            p = caps[0] + 1
        }
    }
    legg_til(delar, _del_tekst(dek, siste, n))
    returner delar
}

# ─── Direktebruk (einlinjes-API) ──────────────────────────────────────────────

funksjon samsvar(inndata: tekst, mønster: tekst) -> bool {
    la m = finn_samsvar(kompiler(mønster), inndata)
    returner er_samsvar(m)
}

funksjon finn(inndata: tekst, mønster: tekst) -> tekst {
    la m = finn_samsvar(kompiler(mønster), inndata)
    hvis (er_samsvar(m)) { returner m["g0"] }
    returner ""
}

funksjon finn_alle(inndata: tekst, mønster: tekst) -> liste_tekst {
    returner finn_alle_samsvar(kompiler(mønster), inndata)
}

funksjon erstatt_tekst(inndata: tekst, mønster: tekst, ny_val: tekst) -> tekst {
    returner erstatt(kompiler(mønster), inndata, ny_val)
}

funksjon erstatt_alle_tekst(inndata: tekst, mønster: tekst, ny_val: tekst) -> tekst {
    returner erstatt_alle(kompiler(mønster), inndata, ny_val)
}

# Java String.matches / Pattern.matches: heile teksten må matche.
funksjon passar_heilt(inndata: tekst, mønster: tekst) -> bool {
    returner er_samsvar(fullsamsvar(kompiler(mønster), inndata))
}
