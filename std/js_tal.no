# js_tal.no — Number- og Math-funksjonar med JavaScript-semantikk, i Norscode
#
# JS: Number.*, Math.*, parseInt, parseFloat
#
# std/math.no reknar berre med heiltal. Denne modulen arbeider med desimaltal
# slik JavaScript gjer: `del(7, 2)` gir 3.5, ikkje 3.
#
# Bruk:
#   bruk std.js_tal som jst
#
#   jst.del(7, 2)              # 3.5
#   jst.til_fast(3.14159, 2)   # "3.14"
#   jst.golv(0 - 2.5)          # -3
#
# Grenser: det finst ingen NaN eller Infinity i Norscode. Funksjonar som ikkje
# kan gi eit tal kastar unntak (deling på null) eller returnerer 0 saman med
# ein eigen sjekkfunksjon (`er_talstreng`).

bruk std.js_streng som jss

# ─── Grunnrekning ─────────────────────────────────────────────────────────────

# JS: a / b — ekte divisjon, ikkje heiltalsdivisjon.
funksjon del(a, b) {
    hvis builtin.desimaltall(b) == 0.0 {
        kast "js_tal.del: deling på null"
    }
    returner builtin.desimaltall(a) / builtin.desimaltall(b)
}

# JS: Number(x) — som desimaltal.
funksjon som_tal(x) {
    returner builtin.desimaltall(x)
}

# ─── Avrunding ────────────────────────────────────────────────────────────────

# Heiltalsdelen av tekstforma til eit tal ("-3.9" -> -3).
funksjon _trunker_tekst(t: tekst) -> heltall {
    la punkt: heltall = builtin.index_of(t, ".")
    hvis punkt < 0 {
        returner builtin.heltall_fra_tekst(t)
    }
    la heil_del: tekst = builtin.slice(t, 0, punkt)
    hvis heil_del == "" eller heil_del == "-" {
        returner 0
    }
    returner builtin.heltall_fra_tekst(heil_del)
}

funksjon _har_brøkdel(t: tekst) -> bool {
    la punkt: heltall = builtin.index_of(t, ".")
    hvis punkt < 0 {
        returner usann
    }
    returner builtin.slice(t, punkt + 1, lengde(t)) != ""
}

# JS: Math.trunc(x) — kutt mot null.
funksjon trunker(x) -> heltall {
    returner _trunker_tekst(tekst(builtin.desimaltall(x)))
}

# JS: Math.floor(x)
funksjon golv(x) -> heltall {
    la t: tekst = tekst(builtin.desimaltall(x))
    la heil: heltall = _trunker_tekst(t)
    hvis builtin.starts_with(t, "-") og _har_brøkdel(t) {
        returner heil - 1
    }
    returner heil
}

# JS: Math.ceil(x)
funksjon tak(x) -> heltall {
    la t: tekst = tekst(builtin.desimaltall(x))
    la heil: heltall = _trunker_tekst(t)
    hvis ikkje builtin.starts_with(t, "-") og _har_brøkdel(t) {
        returner heil + 1
    }
    returner heil
}

# JS: Math.round(x) — halve verdiar rundar oppover (Math.round(-2.5) er -2).
funksjon rund(x) -> heltall {
    returner golv(builtin.desimaltall(x) + 0.5)
}

# JS: Math.abs(x)
funksjon absolutt(x) {
    la d = builtin.desimaltall(x)
    hvis d < 0.0 {
        returner 0.0 - d
    }
    returner d
}

# JS: Math.sign(x)
funksjon signum(x) -> heltall {
    la d = builtin.desimaltall(x)
    hvis d > 0.0 {
        returner 1
    }
    hvis d < 0.0 {
        returner 0 - 1
    }
    returner 0
}

# ─── Min/maks/potens/rot ─────────────────────────────────────────────────────

# JS: Math.min(a, b)
funksjon min(a, b) {
    la x = builtin.desimaltall(a)
    la y = builtin.desimaltall(b)
    hvis x < y {
        returner x
    }
    returner y
}

# JS: Math.max(a, b)
funksjon maks(a, b) {
    la x = builtin.desimaltall(a)
    la y = builtin.desimaltall(b)
    hvis x > y {
        returner x
    }
    returner y
}

# JS: Math.min(...liste)
funksjon min_av(l) {
    hvis lengde(l) == 0 {
        kast "js_tal.min_av: tom liste"
    }
    la m = builtin.desimaltall(l[0])
    la i: heltall = 1
    mens (i < lengde(l)) {
        m = min(m, l[i])
        i = i + 1
    }
    returner m
}

# JS: Math.max(...liste)
funksjon maks_av(l) {
    hvis lengde(l) == 0 {
        kast "js_tal.maks_av: tom liste"
    }
    la m = builtin.desimaltall(l[0])
    la i: heltall = 1
    mens (i < lengde(l)) {
        m = maks(m, l[i])
        i = i + 1
    }
    returner m
}

# JS: Math.pow(grunntal, eksponent) — heiltalseksponent, òg negativ.
funksjon potens(grunntal, eksponent: heltall) {
    hvis eksponent < 0 {
        returner del(1, potens(grunntal, 0 - eksponent))
    }
    la ut = builtin.desimaltall(1)
    la g = builtin.desimaltall(grunntal)
    la i: heltall = 0
    mens (i < eksponent) {
        ut = ut * g
        i = i + 1
    }
    returner ut
}

# JS: Math.sqrt(x) — Newton-iterasjon på desimaltal.
funksjon kvadratrot(x) {
    la d = builtin.desimaltall(x)
    hvis d < 0.0 {
        kast "js_tal.kvadratrot: negativt tal"
    }
    hvis d == 0.0 {
        returner builtin.desimaltall(0)
    }
    la gjett = d
    hvis gjett < 1.0 {
        gjett = builtin.desimaltall(1)
    }
    la i: heltall = 0
    mens (i < 40) {
        gjett = (gjett + d / gjett) / 2.0
        i = i + 1
    }
    returner gjett
}

# ─── Formatering ──────────────────────────────────────────────────────────────

# JS: x.toFixed(desimalar)
funksjon til_fast(x, desimalar: heltall) -> tekst {
    la d = builtin.desimaltall(x)
    la negativ: bool = d < 0.0
    hvis negativ {
        d = 0.0 - d
    }
    la skala = potens(10, desimalar)
    la heil: heltall = golv(d * skala + 0.5)
    la faktor: heltall = golv(skala)
    la heil_del: heltall = heil / faktor
    la rest: heltall = heil - heil_del * faktor
    la ut: tekst = tekst_fra_heltall(heil_del)
    hvis desimalar > 0 {
        ut = ut + "." + jss.fyll_start(tekst_fra_heltall(rest), desimalar, "0")
    }
    hvis negativ og (heil > 0) {
        ut = "-" + ut
    }
    returner ut
}

# JS: String(x)
funksjon til_tekst(x) -> tekst {
    returner tekst(x)
}

# ─── Parsing og sjekkar ───────────────────────────────────────────────────────

funksjon _er_siffer(c: tekst) -> bool {
    la k: heltall = builtin.char_code(c)
    returner k >= 48 og k <= 57
}

# Les det leiande talet i teksten. Returnerer "" når det ikkje finst noko tal.
funksjon _leiande_tal(s: tekst, tillat_punkt: bool) -> tekst {
    la t: tekst = builtin.trim(s)
    la ut: tekst = ""
    la i: heltall = 0
    hvis builtin.starts_with(t, "-") eller builtin.starts_with(t, "+") {
        hvis builtin.starts_with(t, "-") {
            ut = "-"
        }
        i = 1
    }
    la siffer: heltall = 0
    la sett_punkt: bool = usann
    mens (i < lengde(t)) {
        la c: tekst = builtin.slice(t, i, i + 1)
        hvis _er_siffer(c) {
            ut = ut + c
            siffer = siffer + 1
        } ellers {
            hvis c == "." og tillat_punkt og ikkje sett_punkt og siffer > 0 {
                ut = ut + c
                sett_punkt = sann
            } ellers {
                i = lengde(t)
            }
        }
        i = i + 1
    }
    hvis siffer == 0 {
        returner ""
    }
    hvis builtin.ends_with(ut, ".") {
        returner builtin.slice(ut, 0, lengde(ut) - 1)
    }
    returner ut
}

# JS: parseInt(s) — les leiande heiltal. Gir 0 når ingenting kan lesast;
# bruk `er_talstreng` eller `parse_heltall_eller` når du må skilje.
funksjon parse_heltall(s: tekst) -> heltall {
    returner parse_heltall_eller(s, 0)
}

# parseInt med eigen standardverdi når teksten ikkje startar med eit tal.
funksjon parse_heltall_eller(s: tekst, standard: heltall) -> heltall {
    la rå: tekst = _leiande_tal(s, usann)
    hvis rå == "" {
        returner standard
    }
    returner builtin.heltall_fra_tekst(rå)
}

# JS: parseFloat(s)
funksjon parse_desimal(s: tekst) {
    returner parse_desimal_eller(s, builtin.desimaltall(0))
}

funksjon parse_desimal_eller(s: tekst, standard) {
    la rå: tekst = _leiande_tal(s, sann)
    hvis rå == "" {
        returner standard
    }
    returner builtin.desimaltall(rå)
}

# JS: !isNaN(Number(s)) — heile teksten må vere eit tal.
funksjon er_talstreng(s: tekst) -> bool {
    la t: tekst = builtin.trim(s)
    hvis t == "" {
        returner usann
    }
    # "+3" er eit gyldig tal i JS, men pluss-teiknet blir ikkje med i den
    # normaliserte forma — samanlikn difor mot teksten utan leiande pluss.
    hvis builtin.starts_with(t, "+") {
        t = builtin.slice(t, 1, lengde(t))
    }
    hvis t == "" {
        returner usann
    }
    returner _leiande_tal(t, sann) == t
}

# JS: Number.isInteger(x)
funksjon er_heiltal(x) -> bool {
    returner ikkje _har_brøkdel(tekst(builtin.desimaltall(x)))
}
