# js_streng.no — String-funksjonar med JavaScript-semantikk, skrivne i Norscode
#
# JS: String.prototype.*  (slice, padStart, replaceAll, split, ...)
#
# Alle posisjonar er teiknposisjonar, ikkje bytar. Norscode-tekst er UTF-8, og
# builtin.slice/lengde arbeider på bytar — desse funksjonane dekoder difor
# UTF-8 sjølve, slik at "æ" tel som eitt teikn slik det gjer i JavaScript.
#
# Bruk:
#   bruk std.js_streng som jss
#
#   jss.skiv("kjæra", -2, 5)          # "ra"
#   jss.fyll_start("7", 3, "0")       # "007"
#   jss.erstatt_alle("a-b-c", "-", "+")  # "a+b+c"

bruk std.unicode som uc

# ─── UTF-8-grunnlag ───────────────────────────────────────────────────────────

# Talet på bytar i teiknet som startar med denne leiande byten.
funksjon _teikn_byte_lengde(b: heltall) -> heltall {
    hvis b < 128 {
        returner 1
    }
    hvis b >= 240 {
        returner 4
    }
    hvis b >= 224 {
        returner 3
    }
    hvis b >= 192 {
        returner 2
    }
    # Frittståande fortsetjingsbyte: ta han som eitt teikn i staden for å stoppe.
    returner 1
}

# Del teksten i teikn (ikkje bytar). JS: [...s]
funksjon teikn(s: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    la i: heltall = 0
    la n: heltall = lengde(s)
    mens (i < n) {
        la b: heltall = builtin.char_code(builtin.slice(s, i, i + 1))
        la breidd: heltall = _teikn_byte_lengde(b)
        hvis i + breidd > n {
            breidd = n - i
        }
        legg_til(ut, builtin.slice(s, i, i + breidd))
        i = i + breidd
    }
    returner ut
}

# JS: s.length (talet på teikn)
funksjon lengde_teikn(s: tekst) -> heltall {
    returner lengde(teikn(s))
}

# Talet på bytar i UTF-8-representasjonen.
funksjon lengde_bytes(s: tekst) -> heltall {
    returner lengde(s)
}

funksjon _normaliser_indeks(n: heltall, lengde_s: heltall) -> heltall {
    la i: heltall = n
    hvis i < 0 {
        i = lengde_s + i
    }
    hvis i < 0 {
        returner 0
    }
    hvis i > lengde_s {
        returner lengde_s
    }
    returner i
}

funksjon _sett_saman(deler: liste_tekst, start_i: heltall, slutt_i: heltall) -> tekst {
    la ut: tekst = ""
    la i: heltall = start_i
    mens (i < slutt_i) {
        ut = ut + deler[i]
        i = i + 1
    }
    returner ut
}

# Gjer om ein byteposisjon til teiknposisjon.
funksjon _byte_til_teikn(s: tekst, byte_pos: heltall) -> heltall {
    hvis byte_pos <= 0 {
        returner byte_pos
    }
    returner lengde_teikn(builtin.slice(s, 0, byte_pos))
}

# ─── Lesing ───────────────────────────────────────────────────────────────────

# JS: s.at(i) — negativ indeks tel frå slutten, "" utanfor rekkevidde.
funksjon ved(s: tekst, i: heltall) -> tekst {
    la t: liste_tekst = teikn(s)
    la idx: heltall = i
    hvis idx < 0 {
        idx = lengde(t) + idx
    }
    hvis idx < 0 eller idx >= lengde(t) {
        returner ""
    }
    returner t[idx]
}

# JS: s.charAt(i) — "" utanfor rekkevidde, ingen negative indeksar.
funksjon teikn_ved(s: tekst, i: heltall) -> tekst {
    hvis i < 0 {
        returner ""
    }
    returner ved(s, i)
}

# JS: s.codePointAt(i) — heilt kodepunkt, ikkje berre fyrste byte.
funksjon kodepunkt_ved(s: tekst, i: heltall) -> heltall {
    la c: tekst = ved(s, i)
    hvis c == "" {
        returner 0 - 1
    }
    la b0: heltall = builtin.char_code(builtin.slice(c, 0, 1))
    la breidd: heltall = lengde(c)
    hvis breidd == 1 {
        returner b0
    }
    la kode: heltall = 0
    hvis breidd == 2 {
        kode = b0 - 192
    }
    hvis breidd == 3 {
        kode = b0 - 224
    }
    hvis breidd == 4 {
        kode = b0 - 240
    }
    la j: heltall = 1
    mens (j < breidd) {
        la b: heltall = builtin.char_code(builtin.slice(c, j, j + 1))
        kode = kode * 64 + (b - 128)
        j = j + 1
    }
    returner kode
}

# JS: String.fromCodePoint(k) — kodar kodepunktet som UTF-8.
funksjon frå_kodepunkt(k: heltall) -> tekst {
    hvis k < 128 {
        returner builtin.chr(k)
    }
    hvis k < 2048 {
        returner builtin.chr(192 + (k / 64)) + builtin.chr(128 + (k % 64))
    }
    hvis k < 65536 {
        returner builtin.chr(224 + (k / 4096)) + builtin.chr(128 + ((k / 64) % 64)) + builtin.chr(128 + (k % 64))
    }
    returner builtin.chr(240 + (k / 262144)) + builtin.chr(128 + ((k / 4096) % 64)) + builtin.chr(128 + ((k / 64) % 64)) + builtin.chr(128 + (k % 64))
}

# ─── Utsnitt ──────────────────────────────────────────────────────────────────

# JS: s.slice(start, slutt) — negative posisjonar tel frå slutten.
funksjon skiv(s: tekst, start: heltall, slutt: heltall) -> tekst {
    la t: liste_tekst = teikn(s)
    la n: heltall = lengde(t)
    la a: heltall = _normaliser_indeks(start, n)
    la b: heltall = _normaliser_indeks(slutt, n)
    hvis a >= b {
        returner ""
    }
    returner _sett_saman(t, a, b)
}

# JS: s.slice(start)
funksjon skiv_frå(s: tekst, start: heltall) -> tekst {
    returner skiv(s, start, lengde_teikn(s))
}

# JS: s.substring(start, slutt) — byter om når start > slutt, ingen negative.
funksjon del_streng(s: tekst, start: heltall, slutt: heltall) -> tekst {
    la n: heltall = lengde_teikn(s)
    la a: heltall = start
    la b: heltall = slutt
    hvis a < 0 {
        a = 0
    }
    hvis b < 0 {
        b = 0
    }
    hvis a > n {
        a = n
    }
    hvis b > n {
        b = n
    }
    hvis a > b {
        la bytt: heltall = a
        a = b
        b = bytt
    }
    returner skiv(s, a, b)
}

# ─── Søk ──────────────────────────────────────────────────────────────────────

# JS: s.includes(deltekst)
funksjon inkluderer(s: tekst, deltekst: tekst) -> bool {
    hvis deltekst == "" {
        returner sann
    }
    returner builtin.contains(s, deltekst)
}

# JS: s.startsWith(prefiks)
funksjon startar_med(s: tekst, prefiks: tekst) -> bool {
    returner builtin.starts_with(s, prefiks)
}

# JS: s.endsWith(suffiks)
funksjon sluttar_med(s: tekst, suffiks: tekst) -> bool {
    returner builtin.ends_with(s, suffiks)
}

# JS: s.indexOf(deltekst) — teiknposisjon, -1 når ikkje funne.
funksjon indeks_av(s: tekst, deltekst: tekst) -> heltall {
    hvis deltekst == "" {
        returner 0
    }
    la byte_pos: heltall = builtin.index_of(s, deltekst)
    hvis byte_pos < 0 {
        returner 0 - 1
    }
    returner _byte_til_teikn(s, byte_pos)
}

# JS: s.lastIndexOf(deltekst)
funksjon siste_indeks_av(s: tekst, deltekst: tekst) -> heltall {
    hvis deltekst == "" {
        returner lengde_teikn(s)
    }
    la treff: heltall = 0 - 1
    la byte_pos: heltall = 0
    la n: heltall = lengde(s)
    mens (byte_pos <= n - lengde(deltekst)) {
        hvis builtin.slice(s, byte_pos, byte_pos + lengde(deltekst)) == deltekst {
            treff = byte_pos
        }
        byte_pos = byte_pos + 1
    }
    hvis treff < 0 {
        returner 0 - 1
    }
    returner _byte_til_teikn(s, treff)
}

# ─── Endring ──────────────────────────────────────────────────────────────────

# JS: s.replace(gammel, ny) — berre fyrste førekomst.
funksjon erstatt(s: tekst, gammel: tekst, ny: tekst) -> tekst {
    hvis gammel == "" {
        returner ny + s
    }
    la byte_pos: heltall = builtin.index_of(s, gammel)
    hvis byte_pos < 0 {
        returner s
    }
    returner builtin.slice(s, 0, byte_pos) + ny + builtin.slice(s, byte_pos + lengde(gammel), lengde(s))
}

# JS: s.replaceAll(gammel, ny)
funksjon erstatt_alle(s: tekst, gammel: tekst, ny: tekst) -> tekst {
    hvis gammel == "" {
        returner s
    }
    returner builtin.replace(s, gammel, ny)
}

# JS: s.split(skiljeteikn) — tom skiljetekst gir teiknliste.
funksjon del(s: tekst, skiljeteikn: tekst) -> liste_tekst {
    hvis skiljeteikn == "" {
        returner teikn(s)
    }
    returner builtin.split(s, skiljeteikn)
}

# JS: s.split(skiljeteikn, grense)
funksjon del_grense(s: tekst, skiljeteikn: tekst, grense: heltall) -> liste_tekst {
    la alle: liste_tekst = del(s, skiljeteikn)
    la ut: liste_tekst = []
    la i: heltall = 0
    mens (i < lengde(alle) og i < grense) {
        legg_til(ut, alle[i])
        i = i + 1
    }
    returner ut
}

# JS: s.trim()
funksjon trim(s: tekst) -> tekst {
    returner builtin.trim(s)
}

funksjon _er_kvitrom(c: tekst) -> bool {
    returner c == " " eller c == "\t" eller c == "\n" eller c == "\r"
}

# JS: s.trimStart()
funksjon trim_start(s: tekst) -> tekst {
    la i: heltall = 0
    la n: heltall = lengde(s)
    mens (i < n og _er_kvitrom(builtin.slice(s, i, i + 1))) {
        i = i + 1
    }
    returner builtin.slice(s, i, n)
}

# JS: s.trimEnd()
funksjon trim_slutt(s: tekst) -> tekst {
    la n: heltall = lengde(s)
    mens (n > 0 og _er_kvitrom(builtin.slice(s, n - 1, n))) {
        n = n - 1
    }
    returner builtin.slice(s, 0, n)
}

# JS: s.padStart(mål_lengde, fyll)
funksjon fyll_start(s: tekst, mål_lengde: heltall, fyll: tekst) -> tekst {
    hvis fyll == "" {
        returner s
    }
    la ut: tekst = s
    mens (lengde_teikn(ut) < mål_lengde) {
        ut = fyll + ut
    }
    hvis lengde_teikn(ut) > mål_lengde {
        returner skiv(ut, lengde_teikn(ut) - mål_lengde, lengde_teikn(ut))
    }
    returner ut
}

# JS: s.padEnd(mål_lengde, fyll)
funksjon fyll_slutt(s: tekst, mål_lengde: heltall, fyll: tekst) -> tekst {
    hvis fyll == "" {
        returner s
    }
    la ut: tekst = s
    mens (lengde_teikn(ut) < mål_lengde) {
        ut = ut + fyll
    }
    hvis lengde_teikn(ut) > mål_lengde {
        returner skiv(ut, 0, mål_lengde)
    }
    returner ut
}

# JS: s.repeat(n)
funksjon gjenta(s: tekst, n: heltall) -> tekst {
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < n) {
        ut = ut + s
        i = i + 1
    }
    returner ut
}

# JS: s.toUpperCase() — teikn for teikn, så æøå blir handterte.
funksjon til_store(s: tekst) -> tekst {
    la t: liste_tekst = teikn(s)
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < lengde(t)) {
        ut = ut + uc.til_stor(t[i])
        i = i + 1
    }
    returner ut
}

# JS: s.toLowerCase()
funksjon til_små(s: tekst) -> tekst {
    la t: liste_tekst = teikn(s)
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < lengde(t)) {
        ut = ut + uc.til_liten(t[i])
        i = i + 1
    }
    returner ut
}

# JS: a.concat(b)
funksjon konkat(a: tekst, b: tekst) -> tekst {
    returner a + b
}

# JS: a.localeCompare(b) — -1, 0 eller 1 (byte-orden).
funksjon samanlikn(a: tekst, b: tekst) -> heltall {
    hvis a == b {
        returner 0
    }
    la na: heltall = lengde(a)
    la nb: heltall = lengde(b)
    la i: heltall = 0
    mens (i < na og i < nb) {
        la ka: heltall = builtin.char_code(builtin.slice(a, i, i + 1))
        la kb: heltall = builtin.char_code(builtin.slice(b, i, i + 1))
        hvis ka < kb {
            returner 0 - 1
        }
        hvis ka > kb {
            returner 1
        }
        i = i + 1
    }
    hvis na < nb {
        returner 0 - 1
    }
    returner 1
}
