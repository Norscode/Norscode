# Standard databaseflate: rein NorsDB.
# SQLite er berre tilgjengeleg gjennom eksplisitt `std.sqlite_adapter`.

bruk std.norsdb som norsdb

funksjon backend() -> tekst { returner norsdb.backend() }
funksjon status() -> ordbok_tekst { returner norsdb.status() }

funksjon open(sti: tekst) -> tekst {
    returner norsdb.open(sti)
}

funksjon close(handle: tekst) -> bool {
    returner norsdb.close(handle)
}

funksjon execute(handle: tekst, sql: tekst) -> heltall {
    returner norsdb.execute(handle, sql)
}

funksjon query_text(handle: tekst, sql: tekst) -> tekst {
    returner norsdb.query_text(handle, sql)
}

funksjon query_int(handle: tekst, sql: tekst) -> heltall {
    returner norsdb.query_int(handle, sql)
}

funksjon siste_feil(handle: tekst) -> tekst {
    returner norsdb.siste_feil(handle)
}

funksjon execute_bundet(handle: tekst, sql: tekst, params: liste<tekst>) -> heltall {
    returner norsdb.execute_bundet(handle, sql, params)
}

funksjon query_text_bundet(handle: tekst, sql: tekst, params: liste<tekst>) -> tekst {
    returner norsdb.query_text_bundet(handle, sql, params)
}

funksjon query_int_bundet(handle: tekst, sql: tekst, params: liste<tekst>) -> heltall {
    returner norsdb.query_int_bundet(handle, sql, params)
}

funksjon migrate(handle: tekst, skript: tekst) -> heltall {
    returner norsdb.migrate(handle, skript)
}

funksjon transaction(handle: tekst, skript: tekst) -> heltall {
    returner norsdb.transaction(handle, skript)
}

funksjon pool(sti: tekst, maks: heltall) -> tekst {
    returner norsdb.pool(sti, maks)
}

funksjon pool_acquire(pool: tekst) -> tekst {
    returner norsdb.pool_acquire(pool)
}

funksjon pool_size(pool: tekst) -> heltall {
    returner norsdb.pool_size(pool)
}

funksjon pool_close(pool: tekst) -> bool {
    returner norsdb.pool_close(pool)
}

funksjon begin(handle: tekst) -> bool {
    returner norsdb.begin(handle)
}

funksjon commit(handle: tekst) -> bool {
    returner norsdb.commit(handle)
}

funksjon rollback(handle: tekst) -> bool {
    returner norsdb.rollback(handle)
}

funksjon ping(handle: tekst) -> bool {
    returner norsdb.ping(handle)
}

funksjon backup(handle: tekst, sti: tekst) -> bool {
    returner norsdb.backup(handle, sti)
}
