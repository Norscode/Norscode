# Standard databaseflate: rein NorsDB (binær B-tre/WAL-motor).
# SQLite er berre tilgjengeleg gjennom eksplisitt `std.sqlite_adapter`.
#
# Rutar til std.norsdb_db (binær motor: norsdb_sql + norsdb_motor), ikkje den
# gamle JSON-blob-motoren. Handle-en er eit ugjennomsiktig objekt (ordbok), ikkje
# ein streng — difor utypa `handle`-parametrar (speglar adapteren).

bruk std.norsdb_db som norsdb

funksjon backend() -> tekst { returner norsdb.backend() }
funksjon status() -> ordbok_tekst { returner norsdb.status() }

funksjon open(sti: tekst) -> ordbok_tekst {
    returner norsdb.open(sti)
}

funksjon close(handle) -> bool {
    returner norsdb.close(handle)
}

funksjon execute(handle, sql: tekst) -> heltall {
    returner norsdb.execute(handle, sql)
}

funksjon query_text(handle, sql: tekst) -> tekst {
    returner norsdb.query_text(handle, sql)
}

funksjon query_int(handle, sql: tekst) -> heltall {
    returner norsdb.query_int(handle, sql)
}

funksjon query_rader(handle, sql: tekst) -> tekst {
    returner norsdb.query_rader(handle, sql)
}

funksjon siste_feil(handle) -> tekst {
    returner norsdb.siste_feil(handle)
}

funksjon execute_bundet(handle, sql: tekst, params: liste<tekst>) -> heltall {
    returner norsdb.execute_bundet(handle, sql, params)
}

funksjon query_text_bundet(handle, sql: tekst, params: liste<tekst>) -> tekst {
    returner norsdb.query_text_bundet(handle, sql, params)
}

funksjon query_int_bundet(handle, sql: tekst, params: liste<tekst>) -> heltall {
    returner norsdb.query_int_bundet(handle, sql, params)
}

funksjon migrate(handle, skript: tekst) -> heltall {
    returner norsdb.migrate(handle, skript)
}

funksjon transaction(handle, skript: tekst) -> heltall {
    returner norsdb.transaction(handle, skript)
}

funksjon pool(sti: tekst, maks: heltall) -> ordbok_tekst {
    returner norsdb.pool(sti, maks)
}

funksjon pool_acquire(pool) -> ordbok_tekst {
    returner norsdb.pool_acquire(pool)
}

funksjon pool_size(pool) -> heltall {
    returner norsdb.pool_size(pool)
}

funksjon pool_close(pool) -> bool {
    returner norsdb.pool_close(pool)
}

funksjon begin(handle) -> bool {
    returner norsdb.begin(handle)
}

funksjon commit(handle) -> bool {
    returner norsdb.commit(handle)
}

funksjon rollback(handle) -> bool {
    returner norsdb.rollback(handle)
}

funksjon ping(handle) -> bool {
    returner norsdb.ping(handle)
}

funksjon backup(handle, sti: tekst) -> bool {
    returner norsdb.backup(handle, sti)
}
