# httpfeil_handterar.no — feilhandterarar per unntakstype for HTTPFeil (4.1).
#
#   bruk std.httpfeil
#   bruk std.httpfeil_handterar som hf
#   hf.feilhandterar("IkkjeFunnet", fun(req, feil) {
#       returner {"status": 404, "body": "Finst ikkje: " + tekst(feil.detalj)}
#   })
#   hf.feilhandterar("HTTPFeil", fun(req, feil) { ... })   # rota: alle andre HTTPFeil
#
# Registrer handlarane éin gong ved oppstart: i start() før app.lytt (std/apptenar, sjå
# app.feilhandterar) eller i ein web.startup_hook()-funksjon under nc serve. Oppslag:
# eksakt typenamn (typenamn(feil)) vinn, deretter rota «HTTPFeil», elles standardsvaret
# {"detail": ...} med riktig statuskode (std/httpfeil.feil_respons). Handlaren får
# (req, feil) og returnerer ei respons-ordbok ({"status", "body", ...}); ei ordbok utan
# respons-nøklar blir JSON-kropp med statuskoden til feilen. Kastar handlaren sjølv,
# gjev det 500 (i nc serve/apptenar). Ingen arv: «IkkjeFunnet» fangar ikkje Forbode.
#
# Merk: eiga modul utan strukturar, fordi ein toppnivå-`la` saman med `struktur` i same
# modul gjev «Stack underflow i __module_init__» i stage0-kompilatoren.
bruk std.httpfeil som _hfeil

la _hh: ordbok = {"liste": []}

funksjon feilhandterar(typenamn_tekst: tekst, fn) -> heiltall {
    la l = _hh["liste"]
    la ny = []
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]["type"]) != typenamn_tekst { legg_til(ny, l[i]) }
        i = i + 1
    }
    legg_til(ny, {"type": typenamn_tekst, "fn": fn})
    _hh["liste"] = ny
    returner 0
}

funksjon feilhandterarar_nullstill() -> heiltall {
    _hh["liste"] = []
    returner 0
}

funksjon antal_handterarar() -> heiltall {
    returner lengde(_hh["liste"])
}

funksjon er_http_feil(e) -> boolsk {
    hvis e == null { returner usann }
    prøv {
        returner builtin.er_instans(e, "std.httpfeil.HTTPFeil")
    } fang (x) {
        returner usann
    }
    returner usann
}

funksjon _finn(namn: tekst) {
    la l = _hh["liste"]
    la i = 0
    mens i < lengde(l) {
        hvis tekst(l[i]["type"]) == namn { returner l[i]["fn"] }
        i = i + 1
    }
    returner null
}

# Svaret for eit unntak, eller ingenting når det ikkje er eit HTTPFeil.
# Respons-nøklar: «status», «body», «headers», «content_type».
funksjon til_respons(req, e) {
    hvis ikkje er_http_feil(e) { returner null }
    la fn = _finn(typenamn(e))
    hvis fn == null { fn = _finn("HTTPFeil") }
    hvis fn == null { returner _hfeil.feil_respons(e) }
    la r = fn(req, e)
    hvis r != null og builtin.type(r) == "ordbok" {
        hvis har_nokkel(r, "status") eller har_nokkel(r, "body") eller har_nokkel(r, "headers") eller har_nokkel(r, "content_type") {
            hvis ikkje har_nokkel(r, "status") { r["status"] = e.status() }
            returner r
        }
    }
    la d = {"status": e.status(), "content_type": "application/json; charset=utf-8", "body": _hfeil.detalj_json(r)}
    hvis r != null og builtin.type(r) == "tekst" { d["content_type"] = "text/plain; charset=utf-8" d["body"] = r }
    returner d
}
