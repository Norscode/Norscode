# linux_drift.no — smal, versjonert Linux driftsgrense

funksjon abi() -> tekst { returner "norscode-linux-ops-v1" }

funksjon _call(operation: tekst, fields: ordbok) -> ordbok {
    fields["abi"] = abi()
    fields["operation"] = operation
    returner builtin.system_operation(fields)
}

funksjon status() -> ordbok { returner _call("procfs_metrics", {}) }
funksjon procfs_metrics() -> ordbok { returner _call("procfs_metrics", {}) }
funksjon brukar(namn: tekst) -> ordbok { returner _call("user_lookup", {"name": namn}) }
funksjon gruppe(namn: tekst) -> ordbok { returner _call("group_lookup", {"name": namn}) }

funksjon chmod(sti: tekst, mode: heiltall) -> ordbok {
    returner _call("chmod", {"path": sti, "mode": mode})
}

funksjon chown(sti: tekst, uid: heiltall, gid: heiltall) -> ordbok {
    returner _call("chown", {"path": sti, "uid": uid, "gid": gid})
}

funksjon dropp_privilegium(brukar_namn: tekst, gruppe_namn: tekst) -> ordbok {
    returner _call("privilege_drop", {"user": brukar_namn, "group": gruppe_namn})
}

funksjon journal_skriv(identifier: tekst, message: tekst, priority: heiltall) -> ordbok {
    returner _call("journald_write", {"identifier": identifier, "message": message, "priority": priority})
}

funksjon systemd_status(unit: tekst) -> ordbok { returner _call("systemd_status", {"unit": unit}) }
funksjon systemd_start(unit: tekst) -> ordbok { returner _call("systemd_start", {"unit": unit}) }
funksjon systemd_stop(unit: tekst) -> ordbok { returner _call("systemd_stop", {"unit": unit}) }
funksjon systemd_restart(unit: tekst) -> ordbok { returner _call("systemd_restart", {"unit": unit}) }

funksjon produksjonsstatus() -> ordbok_tekst {
    la live = status()
    returner {
        "abi": abi(), "status": live["status"],
        "dekning": "systemd system-bus, journald socket, procfs/rusage, user/group lookup, fd-bound chmod/chown and irreversible uid/gid drop",
        "error": live["error"]
    }
}
