# multiprocessing.no — multiprosessering
# Python: multiprocessing
#
# Simulerer multiprocessing-kontrakten utan Python/C.
# Prosessobjekt køyrer deterministisk i denne runtime-flata og kan bytast til
# ekte Norscode-prosessar når native prosess-spawning er tilgjengeleg.
#
# Mønster:
#   Prosess: ordbok_tekst med PID, inn/ut-filer, tilstand
#   Pool:    liste av prosessar
#   Queue:   fil-basert FIFO
#   Pipe:    par av fil-baserte kanalar
#   Event:   fil-basert semafor
#   Lock:    fil-basert låsing
#   prosess_map: EKTE parallell map over barneprosessar (fleire kjerner), sjå
#            «Prosesspool» nedanfor
#
# Bruk:
#   bruk std.multiprocessing som mp
#   la p = mp.ny_prosess("std.worker.arbeid", {"input": "data"})
#   mp.start(p)
#   mp.join(p)
#   la res = mp.resultat(p)

bruk std.prosess som prosess

# ─── Prosess ──────────────────────────────────────────────────────────────────

funksjon ny_prosess(fn_namn: tekst, args: ordbok_tekst) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["_type"]      = "prosess"
    p["fn_namn"]    = fn_namn
    p["args"]       = builtin.json_stringify(args)
    p["pid"]        = ""
    p["tilstand"]   = "ny"
    p["inn_fil"]    = "/tmp/mp_inn_" + _tidstempel() + ".json"
    p["ut_fil"]     = "/tmp/mp_ut_" + _tidstempel() + ".json"
    p["pid_fil"]    = "/tmp/mp_pid_" + _tidstempel() + ".txt"
    p["feil_fil"]   = "/tmp/mp_feil_" + _tidstempel() + ".txt"
    p["exit_kode"]  = "-1"
    p["backend"]    = "deterministisk"
    returner p
}

# Ekte native argv-prosess for arbeid som allereie er eit OS-program.
funksjon ny_native_prosess(program: tekst, argv: liste_tekst) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["_type"] = "native_prosess"
    p["program"] = program
    p["argv"] = argv
    p["tilstand"] = "ny"
    p["pid"] = "-1"
    p["exit_kode"] = "-1"
    p["backend"] = "native-argv"
    p["handle"] = {}
    returner p
}

funksjon start_native(p: ordbok_tekst, spool_rot: tekst) -> bool {
    prøv {
        la policy = prosess.ny_policy("multiprocessing-native")
        prosess.tillat(policy, prosess._kommando_namn(p["program"]))
        prosess.aktiver_køyring(policy)
        la plan = prosess.start_argv_plan(p["program"], p["argv"])
        prosess.med_sandbox(plan, "no-network", 268435456, 64, usann)
        la sync = prosess.start_argv_trygt(policy, plan)
        la result: ordbok_tekst = {}
        result["status"] = "ferdig"
        result["pid"] = "-1"
        result["exit_code"] = sync[0]
        result["stdout"] = sync[1]
        result["stderr"] = sync[2]
        hvis sync[0] != "0" {
            p["tilstand"] = "feil"
            p["feil"] = sync[2]
            returner usann
        }
        p["handle"] = {}
        p["_last"] = result
        p["pid"] = "-1"
        p["tilstand"] = "ferdig"
        returner sann
    } fang (e) {
        p["tilstand"] = "feil"
        p["feil"] = tekst(e)
        returner usann
    }
    returner usann
}

funksjon native_status(p: ordbok_tekst) -> tekst {
    prøv {
        la last = p["_last"]
        returner tekst(last["status"])
    } fang (e) { returner "feil" }
    returner "feil"
}

funksjon native_wait(p: ordbok_tekst, timeout_ms: heiltall) -> tekst {
    prøv {
        returner native_status(p)
    } fang (e) { returner "feil" }
    returner "feil"
}

funksjon native_resultat(p: ordbok_tekst) -> ordbok_tekst {
    la h = p["handle"]
    la last = p["_last"]
    hvis last == null { last = {} p["_last"] = last }
    la r: ordbok_tekst = {}
    r["status"] = tekst(last["status"])
    r["pid"] = tekst(last["pid"])
    r["exit_code"] = tekst(last["exit_code"])
    r["stdout"] = tekst(last["stdout"])
    r["stderr"] = tekst(last["stderr"])
    returner r
}

funksjon start(p: ordbok_tekst) -> bool {
    prøv {
        builtin.fil_skriv(p["inn_fil"], p["args"])
        la res: ordbok_tekst = {}
        res["ok"] = "true"
        res["fn_namn"] = p["fn_namn"]
        res["args"] = p["args"]
        builtin.fil_skriv(p["ut_fil"], builtin.json_stringify(res))
        builtin.fil_skriv(p["pid_fil"], "norscode-deterministic")
        p["pid"] = "norscode-deterministic"
        p["tilstand"] = "ferdig"
        p["exit_kode"] = "0"
        returner sann
    } fang (e) {
        p["tilstand"] = "feil"
        returner usann
    }
    returner usann
}

funksjon join(p: ordbok_tekst, timeout_s: heltall) {
    la pid: tekst = p["pid"]
    hvis (pid == "") { returner }
    p["exit_kode"] = "0"
    p["tilstand"] = "ferdig"
}

funksjon is_alive(p: ordbok_tekst) -> bool {
    returner usann
}

funksjon terminate(p: ordbok_tekst) {
    p["tilstand"] = "avslutta"
}

funksjon kill(p: ordbok_tekst) {
    p["tilstand"] = "drepen"
}

funksjon resultat(p: ordbok_tekst) -> ordbok_tekst {
    prøv {
        la json_str = builtin.fil_les(p["ut_fil"])
        la data = builtin.json_parse(_trim(json_str))
        returner data
    } fang (e) {
        la res: ordbok_tekst = {}
        res["ok"]   = "false"
        res["feil"] = "Ingen resultat"
        returner res
    }
    returner {}
}

funksjon exit_kode(p: ordbok_tekst) -> heltall {
    prøv { returner builtin.heltall_fra_tekst(p["exit_kode"]) } fang (e) { returner -1 }
    returner -1
}

# Rydd opp kortlevde prosessartefaktar
funksjon rydd(p: ordbok_tekst) {
    _slett_fil_trygt(p["inn_fil"])
    _slett_fil_trygt(p["ut_fil"])
    _slett_fil_trygt(p["pid_fil"])
    _slett_fil_trygt(p["feil_fil"])
}

# ─── Pool ─────────────────────────────────────────────────────────────────────

funksjon ny_pool(antal_arbeidarar: heltall) -> ordbok_tekst {
    la pool: ordbok_tekst = {}
    pool["_type"]     = "pool"
    pool["storleik"]  = tekst_fra_heltall(antal_arbeidarar)
    pool["prosessar"] = "[]"
    pool["aktiv"]     = "sann"
    returner pool
}

funksjon pool_map(pool: ordbok_tekst, fn_namn: tekst, args_liste: liste_tekst) -> liste_tekst {
    la prosessar: liste_tekst = []
    la p_objekt: liste_tekst = []
    # Start prosessar
    la i: heltall = 0
    mens (i < lengde(args_liste)) {
        la args: ordbok_tekst = {}
        args["input"] = args_liste[i]
        la p = ny_prosess(fn_namn, args)
        start(p)
        legg_til(p_objekt, builtin.json_stringify(p))
        i = i + 1
    }
    # Vent på alle og samle resultat
    la resultat_liste: liste_tekst = []
    la j: heltall = 0
    mens (j < lengde(p_objekt)) {
        la p = builtin.json_parse(p_objekt[j])
        join(p, 30)
        la res = resultat(p)
        legg_til(resultat_liste, builtin.json_stringify(res))
        rydd(p)
        j = j + 1
    }
    returner resultat_liste
}

funksjon pool_close(pool: ordbok_tekst) {
    pool["aktiv"] = "usann"
}

funksjon pool_terminate(pool: ordbok_tekst) {
    pool["aktiv"] = "usann"
}

# ─── Queue (fil-basert FIFO) ─────────────────────────────────────────────────

funksjon ny_queue() -> ordbok_tekst {
    la q: ordbok_tekst = {}
    q["_type"]     = "queue"
    q["fil"]       = "/tmp/mp_queue_" + _tidstempel() + ".jsonl"
    q["les_pos"]   = "0"
    q["lås"]       = "/tmp/mp_queue_" + _tidstempel() + ".lock"
    # Opprett tom fil
    prøv { builtin.fil_skriv(q["fil"], "") } fang (e) {}
    returner q
}

funksjon queue_put(q: ordbok_tekst, verdi: tekst) {
    la json_linje: tekst = builtin.json_stringify({"v": verdi}) + "\n"
    prøv {
        la eksisterande = ""
        prøv { eksisterande = builtin.fil_les(q["fil"]) } fang (e2) { eksisterande = "" }
        builtin.fil_skriv(q["fil"], eksisterande + json_linje)
    } fang (e) {}
}

funksjon queue_get(q: ordbok_tekst) -> tekst {
    prøv {
        la pos: heltall = builtin.heltall_fra_tekst(q["les_pos"])
        la innhald = builtin.fil_les(q["fil"])
        la linjer = builtin.split(innhald, "\n")
        la i: heltall = 0
        la gyldig: heltall = 0
        mens (i < lengde(linjer)) {
            la linje: tekst = _trim(linjer[i])
            hvis (linje != "") {
                hvis (gyldig == pos) {
                    q["les_pos"] = tekst_fra_heltall(pos + 1)
                    la data = builtin.json_parse(linje)
                    returner data["v"]
                }
                gyldig = gyldig + 1
            }
            i = i + 1
        }
        kast "queue.Empty: Køen er tom"
    } fang (e) { kast "queue.Empty" }
    returner ""
}

funksjon queue_empty(q: ordbok_tekst) -> bool {
    prøv {
        la pos: heltall = builtin.heltall_fra_tekst(q["les_pos"])
        la innhald = builtin.fil_les(q["fil"])
        la linjer = builtin.split(innhald, "\n")
        la gyldig: heltall = 0
        la i: heltall = 0
        mens (i < lengde(linjer)) {
            la linje: tekst = _trim(linjer[i])
            hvis (linje != "") { gyldig = gyldig + 1 }
            i = i + 1
        }
        returner gyldig <= pos
    } fang (e) { returner sann }
    returner sann
}

funksjon queue_size(q: ordbok_tekst) -> heltall {
    prøv {
        la pos: heltall = builtin.heltall_fra_tekst(q["les_pos"])
        la innhald = builtin.fil_les(q["fil"])
        la linjer = builtin.split(innhald, "\n")
        la gyldig: heltall = 0
        la i: heltall = 0
        mens (i < lengde(linjer)) {
            la linje: tekst = _trim(linjer[i])
            hvis (linje != "") { gyldig = gyldig + 1 }
            i = i + 1
        }
        la rest: heltall = gyldig - pos
        hvis (rest < 0) { returner 0 }
        returner rest
    } fang (e) { returner 0 }
    returner 0
}

# ─── Pipe ─────────────────────────────────────────────────────────────────────

# Returner eit par [lese-ende, skrive-ende] (begge som queue-objekt)
funksjon ny_pipe() -> liste_tekst {
    la ts: tekst = _tidstempel()
    la q: ordbok_tekst = {}
    q["_type"]   = "queue"
    q["fil"]     = "/tmp/mp_pipe_" + ts + ".jsonl"
    q["les_pos"] = "0"
    q["lås"]     = "/tmp/mp_pipe_" + ts + ".lock"
    prøv { builtin.fil_skriv(q["fil"], "") } fang (e) {}
    la q_json: tekst = builtin.json_stringify(q)
    returner [q_json, q_json]  # Begge endar peikar til same fil
}

# ─── Event (fil-basert) ───────────────────────────────────────────────────────

funksjon ny_event() -> ordbok_tekst {
    la e: ordbok_tekst = {}
    e["_type"] = "event"
    e["fil"]   = "/tmp/mp_event_" + _tidstempel() + ".flag"
    returner e
}

funksjon event_set(e: ordbok_tekst) {
    prøv { builtin.fil_skriv(e["fil"], "1") } fang (err) {}
}

funksjon event_clear(e: ordbok_tekst) {
    _slett_fil_trygt(e["fil"])
}

funksjon event_is_set(e: ordbok_tekst) -> bool {
    prøv {
        builtin.fil_les(e["fil"])
        returner sann
    } fang (err) { returner usann }
    returner usann
}

funksjon event_wait(e: ordbok_tekst, timeout_s: heltall) -> bool {
    la elapsed: heltall = 0
    mens (elapsed < timeout_s) {
        hvis (event_is_set(e)) { returner sann }
        elapsed = elapsed + 1
    }
    returner event_is_set(e)
}

# ─── Lock (fil-basert) ────────────────────────────────────────────────────────

funksjon ny_lock() -> ordbok_tekst {
    la l: ordbok_tekst = {}
    l["_type"] = "lock"
    l["fil"]   = "/tmp/mp_lock_" + _tidstempel() + ".lock"
    returner l
}

funksjon lock_acquire(l: ordbok_tekst, timeout_s: heltall) -> bool {
    la elapsed: heltall = 0
    mens (elapsed < timeout_s) {
        hvis ikkje lock_locked(l) {
            prøv {
                builtin.fil_skriv(l["fil"], "locked")
                hvis lock_locked(l) { returner sann }
            } fang (e) {}
        }
        elapsed = elapsed + 1
    }
    returner usann
}

funksjon lock_release(l: ordbok_tekst) {
    _slett_fil_trygt(l["fil"])
}

funksjon lock_locked(l: ordbok_tekst) -> bool {
    prøv {
        builtin.fil_les(l["fil"])
        returner sann
    } fang (e) { returner usann }
    returner usann
}

# ─── Prosesspool: parallell map over ekte barneprosessar ──────────────────────
#
# Den einaste vegen til fleire kjerner i dag (VM-trådane er M:1, AOT har ingen
# brukartrådar, sjå std/samtid.no). Java: parallelStream()/invokeAll over ein
# ForkJoinPool; Python: multiprocessing.Pool.map med «spawn».
#
#   bruk std.multiprocessing som mp
#   funksjon arbeid(x: tekst) -> tekst { ... }
#   funksjon start() -> heiltall {
#       hvis mp.er_prosessarbeidar() { returner mp.prosessarbeidar(fun(x) -> arbeid(x)) }
#       la ut = mp.prosess_map(fun(x) -> arbeid(x), verdiar, 4, mp.arbeidar_kommando("app.no"))
#       ...
#   }
#
# * Verdiane blir delte i bolkar (om lag like mange som arbeidarar, fleire når ein bolk
#   ville bli over 64 KiB), og kvar bolk køyrer i ein eigen barneprosess, høgst
#   `arbeidarar` samstundes. Resultata kjem i same rekkjefølgje som verdiane.
# * Barnet er same program (arbeidar_kommando): under VM-en `nc run <skript>`, i AOT
#   den same binæren. Barnet ser NORSCODE_PROSESSPOOL_ARBEIDAR=1 og skal då berre kalle
#   prosessarbeidar(f) — som `if __name__ == "__main__"` i Python. Eit eige
#   arbeidarprogram går òg (kommando = [program, argv...]), når det kallar prosessarbeidar.
# * Verdiar og resultat er tekst (andre verdiar blir gjorde om med tekst()). Overføringa
#   er ASCII-trygg (teikn utanfor ASCII og %, @, ", \ blir koda som %<kode>;) inn via
#   miljøvariabelen NORSCODE_PROSESSPOOL_INN og ut via stdout (@PPR<i>:…@E), so
#   linjeskift, sitatteikn og æøå kjem fram uendra. Forelder og barn skal vere same
#   runtime (VM↔VM eller same AOT-binær).
# * Kastar f eit unntak i barnet, kastar prosess_map «ProsessPoolFeil: element <i>: …».
#   Eit barn som døyr, ikkje svarar innan fristen eller manglar resultat gjev òg
#   ProsessPoolFeil (med stderr).
# * Utan prosess-ABI (macOS AOT: NATIV-GAP:process_operation; x86 AOT bygd frå --ncb
#   utan `bruk std.native_gap`: builtin.process_operation er null) køyrer map-en
#   sekvensielt i denne prosessen med same f; prosess_map_rapport seier då
#   backend "lokal" og grunnen. x86 AOT: `nc bygg-native` frå kjelde legg std.native_gap
#   til sjølv; frå --ncb må programmet ha `bruk std.native_gap`.

funksjon _pp_maks_inn() -> heiltall { returner 65536 }

funksjon er_prosessarbeidar() -> boolsk {
    prøv {
        returner builtin.miljo_hent("NORSCODE_PROSESSPOOL_ARBEIDAR") == "1"
    } fang (e) { returner usann }
    returner usann
}

# Kommandoen som startar ein arbeidar av dette programmet: [nc, "run", skript] under
# VM-en (køyrbar fil heiter nc/norscode…), elles [denne binæren] (AOT, sjølv-spawn).
funksjon arbeidar_kommando(skript: tekst) -> liste_tekst {
    la exe = ""
    prøv { exe = tekst(builtin.system_info()["executable"]) } fang (e) { exe = "" }
    hvis exe == "" { kast "ProsessPoolFeil: finn ikkje den køyrbare fila (system_info.executable)" }
    la delar = builtin.split(exe, "/")
    la namn = delar[lengde(delar) - 1]
    hvis namn == "nc" eller builtin.starts_with(namn, "norscode") {
        returner [exe, "run", skript]
    }
    returner [exe]
}

funksjon _pp_trygt(c: heiltall) -> boolsk {
    returner c >= 32 og c <= 126 og c != 34 og c != 37 og c != 64 og c != 92
}

# Kod teikn for teikn (strengane er byte-baserte i VM-en og AOT: æ blir %195;%166;).
# Trygge løp blir kopierte med slice, so rein ASCII-tekst kostar éin skanning.
funksjon _pp_koda(s: tekst) -> tekst {
    la delar: liste_tekst = []
    la n: heiltall = lengde(s)
    la løp: heiltall = 0
    la i: heiltall = 0
    mens i < n {
        la c = builtin.char_code(s[i])
        hvis ikkje _pp_trygt(c) {
            hvis i > løp { legg_til(delar, builtin.slice(s, løp, i)) }
            legg_til(delar, "%" + tekst(c) + ";")
            løp = i + 1
        }
        i = i + 1
    }
    hvis løp == 0 { returner s }
    hvis n > løp { legg_til(delar, builtin.slice(s, løp, n)) }
    returner builtin.join(delar, "")
}

funksjon _pp_dekoda(s: tekst) -> tekst {
    hvis builtin.index_of(s, "%") < 0 { returner s }
    la biter = builtin.split(s, "%")
    la delar: liste_tekst = [biter[0]]
    la k: heiltall = 1
    mens k < lengde(biter) {
        la b = biter[k]
        la semi = builtin.index_of(b, ";")
        hvis semi < 1 { kast "ProsessPoolFeil: ugyldig koding: %" + b }
        legg_til(delar, builtin.chr(heltall_fra_tekst(builtin.slice(b, 0, semi))))
        hvis semi + 1 < lengde(b) { legg_til(delar, builtin.slice(b, semi + 1, lengde(b))) }
        k = k + 1
    }
    returner builtin.join(delar, "")
}

# Barnesida: les bolken frå miljøet, køyr f på kvar verdi, skriv resultata på stdout.
# Returner verdien frå start() (0 = ok).
funksjon prosessarbeidar(f) -> heiltall {
    la inn = ""
    prøv { inn = tekst(builtin.miljo_hent("NORSCODE_PROSESSPOOL_INN")) } fang (e) { inn = "" }
    la delar = builtin.split(inn, "@")
    la n: heiltall = -1
    prøv { n = heltall_fra_tekst(delar[0]) } fang (e) { n = -1 }
    hvis n < 0 eller lengde(delar) != n + 1 {
        skriv("@PPX:" + _pp_koda("ugyldig bolk i NORSCODE_PROSESSPOOL_INN") + "@E")
        returner 2
    }
    la ut: liste_tekst = []
    la i: heiltall = 0
    mens i < n {
        la v = _pp_dekoda(delar[i + 1])
        prøv {
            la r = f(v)
            legg_til(ut, "@PPR" + tekst(i) + ":" + _pp_koda(tekst(r)) + "@E")
        } fang (e) {
            legg_til(ut, "@PPF" + tekst(i) + ":" + _pp_koda(tekst(e)) + "@E")
        }
        i = i + 1
    }
    legg_til(ut, "@PPSLUTT" + tekst(n) + "@E")
    skriv(builtin.join(ut, ""))
    returner 0
}

# Del verdiane i bolkar på høgst bolk_storleik verdiar (0 = om lag lengde/arbeidarar,
# éin bolk per arbeidar) og aldri over _pp_maks_inn() koda teikn.
funksjon _pp_bolkar(koda: liste_tekst, arbeidarar: heiltall, bolk_storleik: heiltall) -> liste {
    la n: heiltall = lengde(koda)
    la mål: heiltall = (n + arbeidarar - 1) / arbeidarar
    hvis bolk_storleik > 0 { mål = bolk_storleik }
    hvis mål < 1 { mål = 1 }
    la bolkar = []
    la fra: heiltall = 0
    la delar: liste_tekst = []
    la storleik: heiltall = 0
    la i: heiltall = 0
    mens i < n {
        la e = koda[i]
        hvis lengde(delar) > 0 og (lengde(delar) >= mål eller storleik + lengde(e) + 12 > _pp_maks_inn()) {
            legg_til(bolkar, {"fra": fra, "tal": lengde(delar), "inn": tekst(lengde(delar)) + "@" + builtin.join(delar, "@")})
            fra = i
            delar = []
            storleik = 0
        }
        legg_til(delar, e)
        storleik = storleik + lengde(e) + 1
        i = i + 1
    }
    hvis lengde(delar) > 0 {
        legg_til(bolkar, {"fra": fra, "tal": lengde(delar), "inn": tekst(lengde(delar)) + "@" + builtin.join(delar, "@")})
    }
    returner bolkar
}

funksjon _pp_start(policy: ordbok_tekst, kommando: liste_tekst, bolk: ordbok, frist_ms: heiltall) {
    la argv: liste_tekst = []
    la i: heiltall = 1
    mens i < lengde(kommando) {
        legg_til(argv, kommando[i])
        i = i + 1
    }
    la plan = prosess.start_argv_plan(kommando[0], argv)
    prosess.med_miljø(plan, {"NORSCODE_PROSESSPOOL_ARBEIDAR": "1", "NORSCODE_PROSESSPOOL_INN": bolk["inn"]})
    prosess.med_timeout(plan, (frist_ms + 999) / 1000)
    prosess.med_maks_output(plan, 67108864)
    returner prosess.start_argv_async_trygt(policy, plan)
}

funksjon _pp_utdrag(t: tekst) -> tekst {
    hvis lengde(t) > 400 { returner builtin.slice(t, 0, 400) + "…" }
    returner t
}

# Tolk stdout frå éin bolk inn i resultat/feil. Kastar ProsessPoolFeil når noko manglar.
funksjon _pp_tolk(ut: tekst, feil_ut: tekst, bolk: ordbok, resultat, har) -> heiltall {
    la fra: heiltall = bolk["fra"]
    la tal: heiltall = bolk["tal"]
    la fann: heiltall = 0
    la slutt_sett = usann
    la delar = builtin.split(ut, "@PP")
    la k: heiltall = 1
    mens k < lengde(delar) {
        la d = delar[k]
        la slutt = builtin.index_of(d, "@E")
        la kolon = builtin.index_of(d, ":")
        hvis slutt >= 0 {
            hvis builtin.starts_with(d, "SLUTT") {
                slutt_sett = sann
            } ellers hvis builtin.starts_with(d, "X:") {
                kast "ProsessPoolFeil: arbeidaren avviste bolken: " + _pp_dekoda(builtin.slice(d, 2, slutt))
            } ellers hvis kolon > 1 og kolon < slutt og (builtin.starts_with(d, "R") eller builtin.starts_with(d, "F")) {
                la idx: heiltall = -1
                prøv { idx = heltall_fra_tekst(builtin.slice(d, 1, kolon)) } fang (e) { idx = -1 }
                hvis idx >= 0 og idx < tal {
                    la verdi = _pp_dekoda(builtin.slice(d, kolon + 1, slutt))
                    hvis builtin.starts_with(d, "F") {
                        kast "ProsessPoolFeil: element " + tekst(fra + idx) + ": " + verdi
                    }
                    hvis har[fra + idx] == 0 { fann = fann + 1 }
                    resultat[fra + idx] = verdi
                    har[fra + idx] = 1
                }
            }
        }
        k = k + 1
    }
    hvis fann != tal eller ikkje slutt_sett {
        kast "ProsessPoolFeil: arbeidaren gav " + tekst(fann) + " av " + tekst(tal) + " resultat (element " +
            tekst(fra) + "–" + tekst(fra + tal - 1) + "); stderr: " + _pp_utdrag(feil_ut) + " stdout: " + _pp_utdrag(ut)
    }
    returner fann
}

funksjon _pp_lokal(f, verdiar, rapport: ordbok, grunn: tekst) -> ordbok {
    la ut: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(verdiar) {
        prøv {
            legg_til(ut, tekst(f(tekst(verdiar[i]))))
        } fang (e) {
            kast "ProsessPoolFeil: element " + tekst(i) + ": " + tekst(e)
        }
        i = i + 1
    }
    rapport["resultat"] = ut
    rapport["backend"] = "lokal"
    rapport["grunn"] = grunn
    returner rapport
}

funksjon _pp_stopp_alle(køyrande) -> heiltall {
    la i: heiltall = 0
    mens i < lengde(køyrande) {
        prøv { prosess.native_async_lukk(køyrande[i]["h"]) } fang (e) { }
        i = i + 1
    }
    returner 0
}

# Som prosess_map, men returnerer { "resultat": liste_tekst, "backend": "prosessar" |
# "lokal", "prosessar": tal barn starta, "bolkar": tal bolkar, "grunn": tekst }.
# frist_ms gjeld kvar barneprosess (runda opp til heile sekund; < 1 = 120 s).
# bolk_storleik = høgst so mange verdiar per barneprosess (chunksize); 0 = automatisk.
funksjon prosess_map_rapport(f, verdiar, arbeidarar: heiltall, kommando: liste_tekst,
                             frist_ms: heiltall, bolk_storleik: heiltall) -> ordbok {
    hvis arbeidarar < 1 { kast "ProsessPoolFeil: arbeidarar må vere minst 1" }
    hvis lengde(kommando) < 1 { kast "ProsessPoolFeil: tom arbeidarkommando" }
    hvis frist_ms < 1 { frist_ms = 120000 }
    la rapport = {"resultat": [], "backend": "prosessar", "prosessar": 0, "bolkar": 0, "grunn": ""}
    la n: heiltall = lengde(verdiar)
    hvis n == 0 { returner rapport }
    la koda: liste_tekst = []
    la resultat: liste_tekst = []
    la har = []
    la i: heiltall = 0
    mens i < n {
        la e = _pp_koda(tekst(verdiar[i]))
        hvis lengde(e) + 12 > _pp_maks_inn() {
            kast "ProsessPoolFeil: element " + tekst(i) + " er for stort (" + tekst(lengde(e)) + " koda teikn, grense " + tekst(_pp_maks_inn()) + ")"
        }
        legg_til(koda, e)
        legg_til(resultat, "")
        legg_til(har, 0)
        i = i + 1
    }
    la bolkar = _pp_bolkar(koda, arbeidarar, bolk_storleik)
    rapport["bolkar"] = lengde(bolkar)
    la policy = prosess.ny_policy("prosesspool")
    prosess.tillat(policy, prosess._kommando_namn(kommando[0]))
    prosess.aktiver_køyring(policy)
    la køyrande = []
    la neste: heiltall = 0
    mens neste < lengde(bolkar) eller lengde(køyrande) > 0 {
        mens lengde(køyrande) < arbeidarar og neste < lengde(bolkar) {
            la h = null
            la startfeil = ""
            prøv {
                h = _pp_start(policy, kommando, bolkar[neste], frist_ms)
            } fang (e) {
                startfeil = tekst(e)
            }
            hvis rapport["prosessar"] == 0 og lengde(køyrande) == 0 {
                hvis startfeil != "" og builtin.index_of(startfeil, "NATIV-GAP") >= 0 {
                    returner _pp_lokal(f, verdiar, rapport, startfeil)
                }
                hvis startfeil == "" og builtin.type(h) != "ordbok" {
                    returner _pp_lokal(f, verdiar, rapport, "builtin.process_operation svarte " + builtin.type(h) + " (x86 AOT utan std.native_gap i bunten?)")
                }
            }
            hvis startfeil != "" eller builtin.type(h) != "ordbok" {
                _pp_stopp_alle(køyrande)
                kast "ProsessPoolFeil: kunne ikkje starte arbeidar: " + startfeil
            }
            hvis tekst(h["status"]) != "kjorer" {
                _pp_stopp_alle(køyrande)
                la detalj = ""
                hvis har_nokkel(h, "error_detail") { detalj = tekst(h["error_detail"]) }
                hvis detalj == "" og har_nokkel(h, "error") { detalj = tekst(h["error"]) }
                kast "ProsessPoolFeil: kunne ikkje starte " + kommando[0] + ": status " + tekst(h["status"]) + " " + detalj
            }
            rapport["prosessar"] = rapport["prosessar"] + 1
            legg_til(køyrande, {"h": h, "bolk": bolkar[neste], "ut": [], "feil": []})
            neste = neste + 1
        }
        la vidare = []
        la ferdige: heiltall = 0
        la k: heiltall = 0
        mens k < lengde(køyrande) {
            la barn = køyrande[k]
            la st = tekst(prosess.native_async_poll(barn["h"])["status"])
            la les = prosess.native_async_les(barn["h"])
            legg_til(barn["ut"], tekst(les["stdout"]))
            legg_til(barn["feil"], tekst(les["stderr"]))
            hvis st == "kjorer" {
                legg_til(vidare, barn)
            } ellers {
                ferdige = ferdige + 1
                la slutt = prosess.native_async_lukk(barn["h"])
                legg_til(barn["ut"], tekst(slutt["stdout"]))
                legg_til(barn["feil"], tekst(slutt["stderr"]))
                la ut = builtin.join(barn["ut"], "")
                la feil_ut = builtin.join(barn["feil"], "")
                prøv {
                    hvis st != "ferdig" {
                        kast "ProsessPoolFeil: arbeidaren enda med status " + st + " (exit " + tekst(slutt["exit_code"]) +
                            "); stderr: " + _pp_utdrag(feil_ut)
                    }
                    _pp_tolk(ut, feil_ut, barn["bolk"], resultat, har)
                } fang (e) {
                    _pp_stopp_alle(vidare)
                    k = k + 1
                    mens k < lengde(køyrande) {
                        prøv { prosess.native_async_lukk(køyrande[k]["h"]) } fang (e2) { }
                        k = k + 1
                    }
                    kast e
                }
            }
            k = k + 1
        }
        køyrande = vidare
        hvis ferdige == 0 og lengde(køyrande) > 0 { builtin.vent.sov(5) }
    }
    rapport["resultat"] = resultat
    returner rapport
}

# parallelStream().map(f).collect(): resultata i same rekkjefølgje som verdiane.
funksjon prosess_map(f, verdiar, arbeidarar: heiltall, kommando: liste_tekst) -> liste_tekst {
    returner prosess_map_rapport(f, verdiar, arbeidarar, kommando, 120000, 0)["resultat"]
}

# ─── Verktøy ──────────────────────────────────────────────────────────────────

funksjon cpu_count() -> heltall {
    returner 1
}

funksjon current_process() -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["_type"] = "prosess"
    p["tilstand"] = "køyrer"
    p["pid"] = "norscode-current"
    p["fn_namn"] = "__main__"
    returner p
}

funksjon active_children() -> liste_tekst {
    returner []
}

# ─── Value (delt minne via fil) ───────────────────────────────────────────────

funksjon ny_value(initiell_verdi: heltall) -> ordbok_tekst {
    la v: ordbok_tekst = {}
    v["_type"] = "mp_value"
    v["fil"]   = "/tmp/mp_val_" + _tidstempel() + ".txt"
    prøv { builtin.fil_skriv(v["fil"], tekst_fra_heltall(initiell_verdi)) } fang (e) {}
    returner v
}

funksjon value_get(v: ordbok_tekst) -> heltall {
    prøv {
        la innhald = builtin.fil_les(v["fil"])
        returner builtin.heltall_fra_tekst(_trim(innhald))
    } fang (e) { returner 0 }
    returner 0
}

funksjon value_set(v: ordbok_tekst, verdi: heltall) {
    prøv { builtin.fil_skriv(v["fil"], tekst_fra_heltall(verdi)) } fang (e) {}
}

funksjon produksjonsstatus() -> ordbok_tekst {
    returner {
        process_contract: "stabil",
        pool_contract: "stabil",
        queue_contract: "stabil",
        pipe_contract: "stabil",
        event_contract: "stabil",
        lock_contract: "stabil",
        value_contract: "stabil",
        native_runtime: "deterministisk Norscode-kontrakt og native argv-backend",
        prosesspool: "prosess_map over ekte barneprosessar (async prosess-ABI), lokal reserve utan prosess-ABI",
        shell_free_core: "stabil",
        summary: "process,pool,queue,pipe,event,lock,value"
    }
}

# ─── Internhjelpar ─────────────────────────────────────────────────────────────

funksjon _slett_fil_trygt(sti: tekst) {
    prøv { builtin.fil_slett(sti) } fang (e) {}
}

funksjon _tidstempel() -> tekst {
    la ms: heltall = builtin.tid_ms()
    returner tekst_fra_heltall(ms)
}

funksjon _escape_single(s: tekst) -> tekst {
    la t = builtin.split(s, "")
    la r: liste_tekst = []
    la i: heltall = 0
    mens (i < lengde(t)) {
        la c: tekst = t[i]
        hvis (c == "'") { legg_til(r, "'\"'\"'") }
        ellers { legg_til(r, c) }
        i = i + 1
    }
    returner builtin.join(r, "")
}

funksjon tekst_fra_heltall(n: heltall) -> tekst {
    prøv { returner builtin.join([n], "") } fang (e) { returner "0" }
    returner "0"
}

funksjon _trim(s: tekst) -> tekst {
    la t = builtin.split(s, "")
    la n: heltall = lengde(t)
    la a: heltall = 0  la b: heltall = n
    mens (a < b og (t[a]==" " eller t[a]=="\t" eller t[a]=="\n" eller t[a]=="\r")) { a=a+1 }
    mens (b > a og (t[b-1]==" " eller t[b-1]=="\t" eller t[b-1]=="\n" eller t[b-1]=="\r")) { b=b-1 }
    returner builtin.join(builtin.slice(t, a, b), "")
}
