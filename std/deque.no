# deque.no — Dobbeltenda kø (deque) som ringbuffer
# Python: collections.deque   Java: java.util.ArrayDeque
#
# Representasjon: éi liste der dei to første plassane er hovud (fysisk indeks
# til fremste element i bufferen) og storleik, og resten er ringbufferen:
#   d = [hovud, storleik, b0, b1, ..., b(kap-1)]
# Element nr. i (0 = fremst) ligg på d[2 + (hovud + i) % kap]. Lista er same
# objekt heile levetida (endringar er synlege gjennom alle referansar); når
# bufferen er full, blir kapasiteten dobla med legg_til og den ombrotne delen
# flytta, så legg_framme/legg_bak/pop_framme/pop_bak er O(1) amortisert i
# begge endar. Ingen fjern_indeks (som er stille no-op på x86-64-AOT i dag).
#
# Deque-en er ein ugjennomsiktig verdi: bruk funksjonane her (storleik,
# hent, til_liste, ...) i staden for lengde(d)/d[i]/for-løkker direkte.
#
# Generisk API (vilkårlege verdiar):
#   bruk std.deque som dq
#   la d = dq.ny()
#   dq.legg_bak(d, "b")
#   dq.legg_framme(d, "a")
#   skriv(dq.pop_framme(d))   # => a
#   skriv(dq.pop_bak(d))      # => b
#
# Dei typa variantane (_tall/_tekst) er tynne omslag over det same og gir
# 0 / "" frå ein tom deque; den generiske pop_* gir `ingenting`.

funksjon _kap_start() -> heltall { returner 8 }

funksjon _ny_med(fyll) -> liste {
    la d: liste = [0, 0]
    la i: heltall = 0
    mens (i < _kap_start()) { legg_til(d, fyll)  i = i + 1 }
    returner d
}

funksjon _fys(d, i: heltall) -> heltall {
    returner 2 + (d[0] + i) % (lengde(d) - 2)
}

# Doble kapasiteten (kallast når bufferen er full). Den ombrotne delen (fysisk før
# hovud) blir flytta rett etter den gamle enden, så elementa ligg samanhengande.
funksjon _voks(d) {
    la kap: heltall = lengde(d) - 2
    hvis (d[1] < kap) { returner }
    la i: heltall = 0
    mens (i < kap) { legg_til(d, ingenting)  i = i + 1 }
    la hovud: heltall = d[0]
    la k: heltall = 0
    mens (k < hovud) {
        d[2 + kap + k] = d[2 + k]
        d[2 + k] = ingenting
        k = k + 1
    }
}

# ─── Generisk deque ───────────────────────────────────────────────────────────

funksjon ny() -> liste {
    returner _ny_med(ingenting)
}

# Lag deque frå liste (fremst = l[0]).
funksjon frå_liste(l) -> liste {
    la d = ny()
    la i: heltall = 0
    mens (i < lengde(l)) { legg_bak(d, l[i])  i = i + 1 }
    returner d
}

funksjon storleik(d) -> heltall {
    returner d[1]
}

funksjon er_tom(d) -> bool {
    returner d[1] == 0
}

funksjon legg_bak(d, verdi) -> heltall {
    la kap: heltall = lengde(d) - 2
    la n: heltall = d[1]
    hvis (n >= kap) {
        _voks(d)
        kap = lengde(d) - 2
    }
    la p: heltall = d[0] + n
    hvis (p >= kap) { p = p - kap }
    d[2 + p] = verdi
    d[1] = n + 1
    returner n + 1
}

funksjon legg_framme(d, verdi) -> heltall {
    la kap: heltall = lengde(d) - 2
    la n: heltall = d[1]
    hvis (n >= kap) {
        _voks(d)
        kap = lengde(d) - 2
    }
    la hovud: heltall = d[0] - 1
    hvis (hovud < 0) { hovud = hovud + kap }
    d[0] = hovud
    d[2 + hovud] = verdi
    d[1] = n + 1
    returner n + 1
}

# Fjern og returner fremste element (`ingenting` når tom).
funksjon pop_framme(d) {
    la n: heltall = d[1]
    hvis (n == 0) { returner ingenting }
    la hovud: heltall = d[0]
    la v = d[2 + hovud]
    d[2 + hovud] = ingenting
    hovud = hovud + 1
    hvis (hovud >= lengde(d) - 2) { hovud = 0 }
    d[0] = hovud
    d[1] = n - 1
    returner v
}

# Fjern og returner bakerste element (`ingenting` når tom).
funksjon pop_bak(d) {
    la n: heltall = d[1]
    hvis (n == 0) { returner ingenting }
    la kap: heltall = lengde(d) - 2
    la p: heltall = d[0] + n - 1
    hvis (p >= kap) { p = p - kap }
    la v = d[2 + p]
    d[2 + p] = ingenting
    d[1] = n - 1
    returner v
}

funksjon framme(d) {
    hvis (d[1] == 0) { returner ingenting }
    returner d[2 + d[0]]
}

funksjon bak(d) {
    hvis (d[1] == 0) { returner ingenting }
    returner d[_fys(d, d[1] - 1)]
}

# Element nr. i frå fremst (negativ i tel frå bak, som Python). Kastar utanfor.
funksjon hent(d, i: heltall) {
    la idx: heltall = i
    hvis (idx < 0) { idx = idx + d[1] }
    hvis (idx < 0 eller idx >= d[1]) { kast "deque: indeks utanfor: " + tekst(i) }
    returner d[_fys(d, idx)]
}

funksjon sett(d, i: heltall, verdi) {
    la idx: heltall = i
    hvis (idx < 0) { idx = idx + d[1] }
    hvis (idx < 0 eller idx >= d[1]) { kast "deque: indeks utanfor: " + tekst(i) }
    d[_fys(d, idx)] = verdi
}

# Kopi av innhaldet som vanleg liste, fremst først.
funksjon til_liste(d) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < d[1]) { legg_til(ut, d[_fys(d, i)])  i = i + 1 }
    returner ut
}

funksjon tøm(d) -> heltall {
    la i: heltall = 2
    mens (i < lengde(d)) { d[i] = ingenting  i = i + 1 }
    d[0] = 0
    d[1] = 0
    returner 0
}

# Roter n steg til høgre (positiv n: bakerste blir fremst), venstre for negativ n.
funksjon roter(d, n: heltall) -> heltall {
    la len: heltall = d[1]
    hvis (len == 0) { returner 0 }
    la antal: heltall = n % len
    hvis (antal < 0) { antal = antal + len }
    la i: heltall = 0
    mens (i < antal) {
        legg_framme(d, pop_bak(d))
        i = i + 1
    }
    returner 0
}

# Avgrensa deque (Python deque(maxlen=maks)): kastar eldst i motsett ende.
funksjon legg_bak_avgrensa(d, verdi, maks: heltall) -> heltall {
    mens (d[1] >= maks og d[1] > 0) { pop_framme(d) }
    hvis (maks <= 0) { returner d[1] }
    returner legg_bak(d, verdi)
}

funksjon legg_framme_avgrensa(d, verdi, maks: heltall) -> heltall {
    mens (d[1] >= maks og d[1] > 0) { pop_bak(d) }
    hvis (maks <= 0) { returner d[1] }
    returner legg_framme(d, verdi)
}

# ─── Heltall-deque ────────────────────────────────────────────────────────────

funksjon ny_tall() -> liste {
    returner _ny_med(0)
}

funksjon legg_framme_tall(d, verdi: heltall) -> heltall {
    returner legg_framme(d, verdi)
}

funksjon legg_bak_tall(d, verdi: heltall) -> heltall {
    returner legg_bak(d, verdi)
}

funksjon pop_framme_tall(d) -> heltall {
    hvis (d[1] == 0) { returner 0 }
    returner pop_framme(d)
}

funksjon pop_bak_tall(d) -> heltall {
    hvis (d[1] == 0) { returner 0 }
    returner pop_bak(d)
}

funksjon framme_tall(d) -> heltall {
    hvis (d[1] == 0) { returner 0 }
    returner framme(d)
}

funksjon bak_tall(d) -> heltall {
    hvis (d[1] == 0) { returner 0 }
    returner bak(d)
}

funksjon er_tom_tall(d) -> bool {
    returner d[1] == 0
}

funksjon storleik_tall(d) -> heltall {
    returner d[1]
}

funksjon tøm_tall(d) -> heltall {
    returner tøm(d)
}

# ─── Tekst-deque ──────────────────────────────────────────────────────────────

funksjon ny_tekst() -> liste {
    returner _ny_med("")
}

funksjon legg_framme_tekst(d, verdi: tekst) -> heltall {
    returner legg_framme(d, verdi)
}

funksjon legg_bak_tekst(d, verdi: tekst) -> heltall {
    returner legg_bak(d, verdi)
}

funksjon pop_framme_tekst(d) -> tekst {
    hvis (d[1] == 0) { returner "" }
    returner pop_framme(d)
}

funksjon pop_bak_tekst(d) -> tekst {
    hvis (d[1] == 0) { returner "" }
    returner pop_bak(d)
}

funksjon framme_tekst(d) -> tekst {
    hvis (d[1] == 0) { returner "" }
    returner framme(d)
}

funksjon bak_tekst(d) -> tekst {
    hvis (d[1] == 0) { returner "" }
    returner bak(d)
}

funksjon er_tom_tekst(d) -> bool {
    returner d[1] == 0
}

funksjon storleik_tekst(d) -> heltall {
    returner d[1]
}

funksjon tøm_tekst(d) -> heltall {
    returner tøm(d)
}

# ─── Rotering ─────────────────────────────────────────────────────────────────

funksjon roter_høgre_tall(d, n: heltall) -> heltall {
    returner roter(d, n)
}

funksjon roter_venstre_tall(d, n: heltall) -> heltall {
    returner roter(d, 0 - n)
}

funksjon roter_høgre_tekst(d, n: heltall) -> heltall {
    returner roter(d, n)
}

funksjon roter_venstre_tekst(d, n: heltall) -> heltall {
    returner roter(d, 0 - n)
}

# ─── Avgrensa deque (maks kapasitet, kastar eldst viss full) ─────────────────

funksjon legg_bak_avgrensa_tall(d, verdi: heltall, maks: heltall) -> heltall {
    returner legg_bak_avgrensa(d, verdi, maks)
}

funksjon legg_framme_avgrensa_tall(d, verdi: heltall, maks: heltall) -> heltall {
    returner legg_framme_avgrensa(d, verdi, maks)
}

funksjon legg_bak_avgrensa_tekst(d, verdi: tekst, maks: heltall) -> heltall {
    returner legg_bak_avgrensa(d, verdi, maks)
}
