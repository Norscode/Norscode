# shutil.no — Norscode-eigde høgnivå fil- og katalogoperasjonar
#
# Ingen funksjon startar shell eller eksterne filverktøy. Vanlege operasjonar
# delegerer til std.filops. Arkivformat som ikkje enno har ein Norscode-backend
# feilar lukka i staden for å starte zip, tar, gzip, bzip2 eller xz.

bruk std.filops som filops
bruk std.prosess som prosess
bruk std.runtime_filesystem som native_fs
bruk std.tarfile som tarfile
bruk std.gzip som gzip

funksjon copyfile(kjelde: tekst, mål: tekst) -> bool {
    returner filops.kopier(kjelde, mål)
}

funksjon copy(kjelde: tekst, mål: tekst) -> bool {
    returner filops.kopier2(kjelde, mål)
}

funksjon copy2(kjelde: tekst, mål: tekst) -> bool {
    returner filops.kopier2(kjelde, mål)
}

funksjon copymode(kjelde: tekst, mål: tekst) -> bool {
    prøv {
        la stat = native_fs.native_stat_sti(kjelde)
        hvis stat["status"] != "ok" { returner usann }
        la resultat = native_fs.native_sett_modus_sti(mål, heltall_fra_tekst(stat["mode"]) & 511)
        returner resultat["status"] == "ok"
    } fang (e) { returner usann }
    returner usann
}

# Tidsstempelkopiering krev ein versjonert utimens/FileTime-ABI.
funksjon copystat(kjelde: tekst, mål: tekst) -> bool { returner usann }

funksjon copy_til_katalog(kjelde: tekst, katalog: tekst) -> tekst {
    hvis ikkje filops.katalog_finnes(katalog) { returner "" }
    la mål = katalog
    hvis ikkje builtin.ends_with(mål, "/") { mål = mål + "/" }
    mål = mål + filops.filnamn(kjelde)
    hvis copy(kjelde, mål) { returner mål }
    returner ""
}

funksjon copytree(kjelde: tekst, mål: tekst) -> bool {
    returner filops.kopier_tre(kjelde, mål)
}

# Symlink-følgjing er fail-closed fram til lstat/reparse-point er attestert.
funksjon copytree_lenker(kjelde: tekst, mål: tekst) -> bool { returner usann }

funksjon rmtree(sti: tekst) -> bool { returner filops.slett_tre(sti) }
funksjon remove(sti: tekst) -> bool { returner filops.slett_fil(sti) }

funksjon tøm_katalog(sti: tekst) -> bool {
    hvis ikkje filops.katalog_finnes(sti) { returner usann }
    la barn = filops.lista_katalog(sti)
    la i = 0
    mens i < lengde(barn) {
        hvis ikkje filops.slett_tre(sti + "/" + barn[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon move(kjelde: tekst, mål: tekst) -> bool { returner filops.flytt(kjelde, mål) }

# Returnerer -1-felt til statvfs/GetDiskFreeSpaceEx-ABI-en er attestert.
funksjon disk_usage(sti: tekst) -> ordbok_tekst {
    returner {"total": "-1", "brukt": "-1", "ledig": "-1"}
}

funksjon storleik(sti: tekst) -> heltall { returner filops.fil_storleik(sti) }

funksjon which(namn: tekst) -> tekst { returner prosess.finn_kjorbar(namn) }
funksjon er_tilgjengeleg(program: tekst) -> bool { returner which(program) != "" }

funksjon _make_archive(base_namn: tekst, format: tekst, rot_katalog: tekst, modusar: ordbok_tekst) -> tekst {
    hvis format != "tar" og format != "gztar" { returner "" }
    hvis ikkje filops.katalog_finnes(rot_katalog) { returner "" }
    la ark_sti = base_namn + ".tar"
    hvis format == "gztar" { ark_sti = ark_sti + ".gz" }
    la ark = tarfile.open(ark_sti, "w")
    la filer = filops.walk(rot_katalog)
    la i = 0
    mens i < lengde(filer) {
        la namn = filops.relativ_sti(rot_katalog, filer[i])
        hvis ikkje tarfile.add(ark, filer[i], namn) {
            tarfile.close(ark)
            returner ""
        }
        hvis har_nokkel(modusar, namn) og
           ikkje tarfile.set_mode(ark, namn, heltall_fra_tekst(modusar[namn])) {
            tarfile.close(ark)
            returner ""
        }
        i = i + 1
    }
    tarfile.close(ark)
    hvis ark["feil"] == "" { returner ark_sti }
    returner ""
}

funksjon make_archive(base_namn: tekst, format: tekst, rot_katalog: tekst) -> tekst {
    la modusar: ordbok_tekst = {}
    returner _make_archive(base_namn, format, rot_katalog, modusar)
}

funksjon make_archive_med_modus(base_namn: tekst, format: tekst, rot_katalog: tekst,
                                modusar: ordbok_tekst) -> tekst {
    returner _make_archive(base_namn, format, rot_katalog, modusar)
}

funksjon unpack_archive(filnamn: tekst, mål_katalog: tekst) -> bool {
    hvis builtin.ends_with(filnamn, ".tar") eller builtin.ends_with(filnamn, ".tar.gz") eller
       builtin.ends_with(filnamn, ".tgz") {
        returner tarfile.extractall_enkel(filnamn, mål_katalog)
    }
    hvis builtin.ends_with(filnamn, ".gz") {
        hvis ikkje filops.lag_katalogar(mål_katalog) { returner usann }
        la namn = filops.filnamn(filnamn)
        namn = builtin.slice(namn, 0, lengde(namn) - 3)
        returner gzip.dekomprimer_fil(filnamn, mål_katalog + "/" + namn)
    }
    returner usann
}

funksjon get_archive_formats() -> liste_tekst {
    returner ["tar", "gztar"]
}

funksjon get_terminal_size() -> ordbok_tekst {
    returner {"kolonnar": "80", "rader": "24"}
}

funksjon makedirs(sti: tekst) -> bool { returner filops.lag_katalogar(sti) }
funksjon listdir(sti: tekst) -> liste_tekst { returner filops.lista_katalog(sti) }

funksjon _trim(s: tekst) -> tekst { returner builtin.trim(s) }

funksjon _siste_ikkje_tom_linje(s: tekst) -> tekst {
    la linjer = builtin.split(s, "\n")
    la i = lengde(linjer) - 1
    mens i >= 0 {
        la linje = builtin.trim(linjer[i])
        hvis linje != "" { returner linje }
        i = i - 1
    }
    returner ""
}

funksjon _basename(sti: tekst, fjern_suffiks: tekst) -> tekst {
    la namn = filops.filnamn(sti)
    hvis fjern_suffiks != "" og builtin.ends_with(namn, fjern_suffiks) {
        returner builtin.slice(namn, 0, lengde(namn) - lengde(fjern_suffiks))
    }
    returner namn
}
