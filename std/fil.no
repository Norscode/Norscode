# fil.no — kompatibilitetslag for eldre `std.fil`-importar
#
# Repoet har i praksis filhjelparar fordelt på `std.filops` og `std.lagring`.
# Denne modulen gir ei liten fasade for testane som framleis bruker
# `bruk std.fil som fil`.

bruk std.filops som filops

# Finst det noko på stien? builtin.fil_finnes svarar utan å lese fila.
# Tidlegare las finnes heile fila, som kosta tid og minne på store filer
# (på Linux-seeden flyttar kvar heil-fil-lesing heapen eit 64 MiB-steg).
# Same svar som før: sann for fil og mappe, usann for manglande og tom sti.
funksjon finnes(sti: tekst) -> bool {
    prøv {
        returner builtin.fil_finnes(sti)
    } fang (e) { }
    prøv {
        builtin.fil_les(sti)
        returner sann
    } fang (e) {
        returner usann
    }
}

# Skriv heile fila. Returnerer talet på byte, eller 0 når skrivinga feilar
# (t.d. manglande mappe) — sjekk returverdien, eller bruk
# skriv_fil_kontrollert om ei tapt skriving ikkje må gå upåakta.
funksjon skriv_fil(sti: tekst, innhald: tekst) -> heltall {
    prøv {
        builtin.fil_skriv(sti, innhald)
        returner lengde(innhald)
    } fang (e) {
        returner 0
    }
}

# Som skriv_fil, men kastar IOFeil når skrivinga feilar i staden for å
# returnere 0.
funksjon skriv_fil_kontrollert(sti: tekst, innhald: tekst) -> heltall {
    prøv {
        builtin.fil_skriv(sti, innhald)
    } fang (e) {
        kast "IOFeil: kunne ikkje skrive fil " + sti
    }
    returner lengde(innhald)
}

funksjon les_fil(sti: tekst) -> tekst {
    prøv {
        returner builtin.fil_les(sti)
    } fang (e) {
        returner ""
    }
}

funksjon les(sti: tekst) -> tekst {
    prøv {
        returner builtin.fil_les(sti)
    } fang (e) {
        kast "IOFeil: kunne ikkje lese fil " + sti
    }
    returner ""
}


# Legg til på slutten av fila, og lag fila om ho manglar. Returnerer talet på
# byte som vart lagt til, eller 0 når skrivinga feilar.
# Brukar builtin.fil_append, som ikkje les fila. Tidlegare las append heile
# fila og skreiv ho på nytt for kvart kall, så mange små tillegg vart
# kvadratiske i tid og minne. builtin.fil_append melder ikkje feil for ei
# mappe som manglar, så vi kontrollerer at fila finst etterpå.
funksjon append(sti: tekst, innhald: tekst) -> heltall {
    prøv {
        builtin.fil_append(sti, innhald)
        hvis builtin.fil_finnes(sti) { returner lengde(innhald) }
        returner 0
    } fang (e) { }
    # Reserve for runtimar utan fil_append: den gamle vegen.
    la eksisterande = les_fil(sti)
    la alt = eksisterande + innhald
    hvis skriv_fil(sti, alt) != lengde(alt) { returner 0 }
    returner lengde(innhald)
}

funksjon skriv_bytes(sti: tekst, data) -> heltall {
    prøv {
        fil_skriv_binær(sti, data)
        returner lengde(data)
    } fang (e) {
        returner 0
    }
}

funksjon les_bytes(sti: tekst) {
    returner builtin.fil_les_binær(sti)
}

funksjon les_byte_liste(sti: tekst) -> liste_heltall {
    returner builtin.bytes_to_list(les_bytes(sti))
}

funksjon slett_fil(sti: tekst) -> bool {
    returner filops.slett_fil(sti)
}

funksjon status(sti: tekst) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    hvis (sti != null og sti != "") {
        r["gyldig"] = "sann"
    } ellers {
        r["gyldig"] = "usann"
    }
    prøv {
        builtin.fil_les(sti)
        r["finnes"] = "sann"
    } fang (e) {
        r["finnes"] = "usann"
    }
    r["sti"] = sti
    returner r
}
