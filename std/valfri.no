# std/valfri.no — valfri verdi (Java Optional<T>) og hjelparar for ingenting.
#
# Ein valfri er ei ordbok {"__valfri__": sann, "har": bool, "v": verdi}. Han
# gjer «kanskje ein verdi» eksplisitt i staden for å returnere rå ingenting.
#
# Bruk:
#   bruk std.valfri som vf
#   la o = vf.av_nullbar(kart["namn"])
#   la stor = vf.map(o, fun(s) -> tekst_til_store(s))
#   skriv(vf.eller_standard(stor, "ukjend"))
#
# API (Java-motstykke i parentes):
#   tom()                    tom valfri                     (Optional.empty)
#   av(v)                    kastar VerdiFeil viss v er ingenting (Optional.of)
#   av_nullbar(v)            tom viss v er ingenting        (Optional.ofNullable)
#   er_til_stades(o) / er_tom(o)                            (isPresent / isEmpty)
#   hent(o)                  verdien, kastar TomtFeil når tom (get / orElseThrow())
#   eller_standard(o, s)     verdien eller s                (orElse)
#   eller_hent(o, f)         verdien eller f()              (orElseGet)
#   eller_kast(o, melding)   verdien, elles kast "TomtFeil: <melding>" (orElseThrow(supplier))
#   eller_valfri(o, f)       o viss til stades, elles f() (ein valfri)  (or)
#   map(o, f)                av_nullbar(f(v)) eller tom     (map)
#   flat_map(o, f)           f(v) (må gje ein valfri) eller tom (flatMap)
#   filter(o, p)             o viss p(v), elles tom         (filter)
#   om_til_stades(o, f)      kallar f(v) viss til stades    (ifPresent)
#   om_til_stades_ellers(o, f, g)  f(v) eller g()          (ifPresentOrElse)
#   til_liste(o)             [] eller [v]                   (stream().toList())
#   lik(a, b) / til_tekst(o) "Valfri[v]" / "Valfri.tom"     (equals / toString)
#                            til_tekst viser v via std.verdiform.vis: Valfri[[1, 2]]
#   er_valfri(x)             sann viss x er ein valfri
#
# Hjelparar for rå verdiar som kan vere ingenting:
#   er_ingenting(x)          sann viss x er ingenting (typesjekk, ikkje ==)
#   verdi_eller(x, s)        x, eller s viss x er ingenting (x ?? s; Objects.requireNonNullElse)
#   krev(x, melding)         x, elles kast "VerdiFeil: <melding>" (Objects.requireNonNull)
#
# NB: `eller` er eit reservert nøkkelord i Norscode, difor heiter Java orElse
# her eller_standard. Lambdaene blir kalla direkte (f(v)) frå namngjevne
# funksjonar, ikkje via builtin.ncb_call_fn, så modulen verkar i native AOT.
# ingenting blir testa med builtin.type(x) == "ingenting" (ikkje x == ingenting),
# som er einsarta på alle køyrevegar.

bruk std.verdiform som vfm

funksjon er_ingenting(x) -> bool {
    returner builtin.type(x) == "ingenting"
}

funksjon verdi_eller(x, standard) {
    hvis er_ingenting(x) { returner standard }
    returner x
}

funksjon krev(x, melding: tekst) {
    hvis er_ingenting(x) { kast "VerdiFeil: " + melding }
    returner x
}

funksjon er_valfri(x) -> bool {
    hvis builtin.type(x) != "ordbok" { returner usann }
    returner har_nokkel(x, "__valfri__")
}

funksjon tom() -> ordbok {
    returner {"__valfri__": sann, "har": usann, "v": ingenting}
}

funksjon av(v) -> ordbok {
    hvis er_ingenting(v) { kast "VerdiFeil: valfri.av fekk ingenting (bruk av_nullbar)" }
    returner {"__valfri__": sann, "har": sann, "v": v}
}

funksjon av_nullbar(v) -> ordbok {
    hvis er_ingenting(v) { returner tom() }
    returner {"__valfri__": sann, "har": sann, "v": v}
}

funksjon er_til_stades(o: ordbok) -> bool {
    returner o["har"]
}

funksjon er_tom(o: ordbok) -> bool {
    returner ikkje o["har"]
}

funksjon hent(o: ordbok) {
    hvis ikkje o["har"] { kast "TomtFeil: valfri utan verdi" }
    returner o["v"]
}

funksjon eller_standard(o: ordbok, standard) {
    hvis o["har"] { returner o["v"] }
    returner standard
}

funksjon eller_hent(o: ordbok, f) {
    hvis o["har"] { returner o["v"] }
    returner f()
}

funksjon eller_kast(o: ordbok, melding: tekst) {
    hvis o["har"] { returner o["v"] }
    kast "TomtFeil: " + melding
}

funksjon eller_valfri(o: ordbok, f) -> ordbok {
    hvis o["har"] { returner o }
    returner f()
}

funksjon map(o: ordbok, f) -> ordbok {
    hvis ikkje o["har"] { returner o }
    returner av_nullbar(f(o["v"]))
}

funksjon flat_map(o: ordbok, f) -> ordbok {
    hvis ikkje o["har"] { returner o }
    la r = f(o["v"])
    hvis ikkje er_valfri(r) { kast "TypeFeil: flat_map-funksjonen må returnere ein valfri" }
    returner r
}

funksjon filter(o: ordbok, p) -> ordbok {
    hvis ikkje o["har"] { returner o }
    hvis p(o["v"]) { returner o }
    returner tom()
}

funksjon om_til_stades(o: ordbok, f) -> bool {
    hvis o["har"] {
        f(o["v"])
        returner sann
    }
    returner usann
}

funksjon om_til_stades_ellers(o: ordbok, f, g) -> bool {
    hvis o["har"] {
        f(o["v"])
        returner sann
    }
    g()
    returner usann
}

funksjon til_liste(o: ordbok) -> liste {
    hvis o["har"] { returner [o["v"]] }
    returner []
}

funksjon lik(a: ordbok, b: ordbok) -> bool {
    hvis a["har"] != b["har"] { returner usann }
    hvis ikkje a["har"] { returner sann }
    returner a["v"] == b["v"]
}

funksjon til_tekst(o: ordbok) -> tekst {
    hvis o["har"] { returner "Valfri[" + vfm.vis(o["v"]) + "]" }
    returner "Valfri.tom"
}
