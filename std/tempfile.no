# tempfile.no — Mellombels filer og katalogar
# Python: tempfile
#
# Byggjer og registrerer mellombels ressursar i Norscode gjennom den
# versjonerte filesystem-ABI-en. Ingen ekstern prosess eller shelltekst.
# Alle mellombels ressursar vert registrert i eit globalt register
# slik at dei kan ryddast opp (via rydd_opp()).
#
# Bruk:
#   bruk std.tempfile som tf
#
#   la fil = tf.ny_tempfil("prefiks_", ".txt")
#   tf.skriv_tempfil(fil, "innhald")
#   skriv tf.sti(fil)
#   tf.slett(fil)
#
#   la kataog = tf.ny_tempkatalog("mitt_")
#   skriv tf.sti(katalog)
#   tf.slett_katalog(katalog)

# ─── Oppslagsregister ─────────────────────────────────────────────────────────
# Vi held styr på aktive tempobjekt i ei global liste

bruk std.runtime_filesystem som native_fs

funksjon _ny_id() -> tekst {
    returner "tmp_" + builtin.random_hex(12)
}

funksjon _trygg_namnedel(verdi: tekst) -> tekst {
    hvis builtin.index_of(verdi, "/") >= 0 eller builtin.index_of(verdi, "\\") >= 0 eller
       builtin.index_of(verdi, "\u0000") >= 0 eller builtin.index_of(verdi, "\n") >= 0 eller
       builtin.index_of(verdi, "\r") >= 0 { kast "tempfile: ugyldig namn" }
    returner verdi
}

funksjon _unik_del() -> tekst {
    returner builtin.random_hex(12)
}

funksjon _forelder(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) <= 1 { returner "." }
    la siste = lengde(delar) - 1
    la ut = ""
    la i = 0
    mens i < siste {
        hvis i == 0 og delar[i] == "" { ut = "/" }
        ellers hvis delar[i] != "" {
            hvis ut != "" og ut != "/" { ut = ut + "/" }
            ut = ut + delar[i]
        }
        i = i + 1
    }
    hvis ut == "" { returner "." }
    returner ut
}

funksjon _namn(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) == 0 { returner sti }
    returner delar[lengde(delar) - 1]
}

funksjon _slett_tre(sti: tekst) -> bool {
    hvis sti == "" eller sti == "/" { returner usann }
    hvis ikkje builtin.fil_finnes(sti) { returner sann }
    la rot = _forelder(sti)
    la relativ = _namn(sti)
    la listing = native_fs.native_list(rot, relativ)
    hvis listing["status"] == "ok" {
        la barn = builtin.split(listing["data"], "\n")
        la i = 0
        mens i < lengde(barn) {
            la namn = builtin.trim(barn[i])
            hvis namn != "" og ikkje _slett_tre(sti + "/" + namn) { returner usann }
            i = i + 1
        }
    }
    la sletta = native_fs.native_slett(rot, relativ)
    returner sletta["status"] == "deleted" eller ikkje builtin.fil_finnes(sti)
}

# ─── Temp-katalog ─────────────────────────────────────────────────────────────

funksjon _temp_dir() -> tekst {
    prøv {
        la res = builtin.miljo_hent("NORSCODE_TEMP_ROOT")
        hvis res != "" og ikkje builtin.starts_with(res, "/") og
           builtin.index_of(res, "\\") < 0 og builtin.index_of(res, "..") < 0 {
            builtin.mkdir_p(res)
            returner res
        }
    } fang (e) {}
    builtin.mkdir_p(".norscode/tmp")
    returner ".norscode/tmp"
}

# ─── Tempfil ──────────────────────────────────────────────────────────────────

# Returner eit tempfil-objekt: ordbok_tekst med metadata
funksjon ny_tempfil(prefiks: tekst, suffiks: tekst) -> ordbok_tekst {
    la tmpdir: tekst = _temp_dir()
    prefiks = _trygg_namnedel(prefiks)
    suffiks = _trygg_namnedel(suffiks)
    la sti: tekst = ""
    la forsøk = 0
    mens sti == "" og forsøk < 32 {
        la kandidat = tmpdir + "/" + prefiks + _unik_del() + suffiks
        hvis ikkje builtin.fil_finnes(kandidat) {
            builtin.fil_skriv(kandidat, "")
            sti = kandidat
        }
        forsøk = forsøk + 1
    }
    hvis sti == "" { kast "tempfile: klarte ikkje lage unik tempfil" }

    la obj: ordbok_tekst = {}
    la id: tekst = _ny_id()
    obj["id"] = id
    obj["sti"] = sti
    obj["type"] = "fil"
    obj["open"] = "sann"
    obj["prefiks"] = prefiks
    obj["suffiks"] = suffiks
    returner obj
}

# Tempfil med standard innstillingar
funksjon ny_tempfil_enkel() -> ordbok_tekst {
    returner ny_tempfil("tmp_", "")
}

# Les innhald frå tempfil
funksjon les_tempfil(obj: ordbok_tekst) -> tekst {
    prøv {
        returner builtin.fil_les(obj["sti"])
    } fang (e) {
        returner ""
    }
    returner ""
}

# Skriv innhald til tempfil
funksjon skriv_tempfil(obj: ordbok_tekst, innhald: tekst) {
    builtin.fil_skriv(obj["sti"], innhald)
}

# Legg til på slutten
funksjon append_tempfil(obj: ordbok_tekst, innhald: tekst) {
    la eksisterande: tekst = les_tempfil(obj)
    builtin.fil_skriv(obj["sti"], eksisterande + innhald)
}

# ─── Tempkatalog ──────────────────────────────────────────────────────────────

funksjon ny_tempkatalog(prefiks: tekst) -> ordbok_tekst {
    la tmpdir: tekst = _temp_dir()
    prefiks = _trygg_namnedel(prefiks)
    la sti: tekst = ""
    la forsøk = 0
    mens sti == "" og forsøk < 32 {
        la kandidat = tmpdir + "/" + prefiks + _unik_del()
        hvis ikkje builtin.fil_finnes(kandidat) {
            builtin.mkdir_p(kandidat)
            sti = kandidat
        }
        forsøk = forsøk + 1
    }
    hvis sti == "" { kast "tempfile: klarte ikkje lage unik tempkatalog" }

    la obj: ordbok_tekst = {}
    la id: tekst = _ny_id()
    obj["id"] = id
    obj["sti"] = sti
    obj["type"] = "katalog"
    obj["prefiks"] = prefiks
    returner obj
}

funksjon ny_tempkatalog_enkel() -> ordbok_tekst {
    returner ny_tempkatalog("tmp_")
}

# ─── Slett ────────────────────────────────────────────────────────────────────

funksjon slett(obj: ordbok_tekst) -> bool {
    returner _slett_tre(obj["sti"])
}

funksjon slett_katalog(obj: ordbok_tekst) -> bool {
    returner _slett_tre(obj["sti"])
}

# Slett basert på sti-type
funksjon lukk(obj: ordbok_tekst) {
    hvis (obj["type"] == "katalog") {
        returner slett_katalog(obj)
    } ellers {
        returner slett(obj)
    }
}

# Rydd opp alle registrerte tempobjekt
funksjon rydd_opp() {
    # Ressursane er objekt-eigde. Bruk lukk/slett på kvart returnert objekt.
    returner 0
}

# ─── Hent-funksjonar ─────────────────────────────────────────────────────────

funksjon sti(obj: ordbok_tekst) -> tekst {
    returner obj["sti"]
}

funksjon er_fil(obj: ordbok_tekst) -> bool {
    returner obj["type"] == "fil"
}

funksjon er_katalog(obj: ordbok_tekst) -> bool {
    returner obj["type"] == "katalog"
}

funksjon eksisterer(obj: ordbok_tekst) -> bool {
    prøv {
        returner builtin.fil_finnes(obj["sti"])
    } fang (e) {
        returner usann
    }
    returner usann
}

# ─── NamedTemporaryFile-mønster ──────────────────────────────────────────────
# Slik Python sitt NamedTemporaryFile fungerer: fila finst på disk,
# og vert sletta anten ved eksplisitt kall til lukk() eller rydd_opp()

funksjon named_tempfil(prefiks: tekst, suffiks: tekst, slett_ved_lukk: bool) -> ordbok_tekst {
    la obj = ny_tempfil(prefiks, suffiks)
    obj["slett_ved_lukk"] = "usann"
    hvis slett_ved_lukk {
        obj["slett_ved_lukk"] = "sann"
    }
    returner obj
}

funksjon named_lukk(obj: ordbok_tekst) {
    hvis (obj["slett_ved_lukk"] == "sann") {
        slett(obj)
    } ellers {
        obj["open"] = "usann"
    }
}

# ─── SpooledTemporaryFile (in-memory → disk) ──────────────────────────────────
# Held data i minne til ein terskel, deretter skriv til disk

funksjon ny_spooled(maks_minne: heltall, prefiks: tekst, suffiks: tekst) -> ordbok_tekst {
    la obj: ordbok_tekst = {}
    obj["maks"] = tekst_fra_heltall(maks_minne)
    obj["minne"] = ""
    obj["spilt"] = "usann"
    obj["prefiks"] = prefiks
    obj["suffiks"] = suffiks
    obj["sti"] = ""
    returner obj
}

funksjon spooled_skriv(obj: ordbok_tekst, data: tekst) {
    hvis (obj["spilt"] == "sann") {
        la eksisterande: tekst = builtin.fil_les(obj["sti"])
        builtin.fil_skriv(obj["sti"], eksisterande + data)
        returner
    }
    obj["minne"] = obj["minne"] + data
    la maks: heltall = builtin.heltall_fra_tekst(obj["maks"])
    la storleik: heltall = lengde(builtin.split(obj["minne"], ""))
    hvis (storleik > maks) {
        # Spill til disk
        la tempfil = ny_tempfil(obj["prefiks"], obj["suffiks"])
        builtin.fil_skriv(tempfil["sti"], obj["minne"])
        obj["sti"] = tempfil["sti"]
        obj["spilt"] = "sann"
        obj["minne"] = ""
    }
}

funksjon spooled_les(obj: ordbok_tekst) -> tekst {
    hvis (obj["spilt"] == "sann") {
        prøv { returner builtin.fil_les(obj["sti"]) } fang (e) { returner "" }
    }
    returner obj["minne"]
}

funksjon spooled_er_spilt(obj: ordbok_tekst) -> bool {
    returner obj["spilt"] == "sann"
}

# ─── gettempdir ───────────────────────────────────────────────────────────────

funksjon gettempdir() -> tekst {
    returner _temp_dir()
}

funksjon gettempprefix() -> tekst {
    returner "tmp_"
}

# Lag ein unik mellombels filsti (utan å opprette fila)
funksjon mktempnamn(prefiks: tekst, suffiks: tekst) -> tekst {
    la tmpdir: tekst = _temp_dir()
    la tid_str: tekst = tekst_fra_heltall(builtin.tid_ms())
    returner tmpdir + "/" + prefiks + tid_str + suffiks
}

funksjon registrert_tal() -> heltall {
    returner 0
}
