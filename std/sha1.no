# sha1.no - rein Norscode SHA-1 (FIPS 180-4 / RFC 3174)
#
# ADVARSEL: SHA-1 er kryptografisk broten for kollisjonsmotstand og skal IKKJE
# brukast til nye signaturar, sertifikat eller passordhashing. Bruk std.sha256,
# std.scrypt eller std.argon2id til det. SHA-1 er teken med her berre fordi
# enkelte eldre wire-protokollar krev han — særleg WebSocket-handshaket
# (RFC 6455), der Sec-WebSocket-Accept = base64(SHA1(nøkkel + magic)).
#
# Rein pure-VM-implementasjon utan native avhengnad. Køyrer der SHA-256 køyrer.

funksjon _u32(x: heiltall) -> heiltall { returner x & 4294967295 }
funksjon _rotl(x: heiltall, n: heiltall) -> heiltall {
    returner _u32((x << n) | ((x & 4294967295) >> (32 - n)))
}

funksjon _bytes_frå_tekst(data: tekst) -> liste_heiltall {
    la out: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(data) {
        legg_til(out, builtin.char_code(builtin.slice(data, i, i + 1)) & 255)
        i = i + 1
    }
    returner out
}

# Big-endian padding: 0x80, nullar til 56 mod 64, deretter 64-bit bitlengd.
funksjon _pad(bytes: liste_heiltall) -> liste_heiltall {
    la out: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(bytes) {
        la v = bytes[i]
        hvis v < 0 eller v > 255 { kast "SHA1Feil: byte utanfor område" }
        legg_til(out, v)
        i = i + 1
    }
    la bit_len = lengde(bytes) * 8
    legg_til(out, 128)
    mens (lengde(out) % 64) != 56 { legg_til(out, 0) }
    legg_til(out, (bit_len >> 56) & 255)
    legg_til(out, (bit_len >> 48) & 255)
    legg_til(out, (bit_len >> 40) & 255)
    legg_til(out, (bit_len >> 32) & 255)
    legg_til(out, (bit_len >> 24) & 255)
    legg_til(out, (bit_len >> 16) & 255)
    legg_til(out, (bit_len >> 8) & 255)
    legg_til(out, bit_len & 255)
    returner out
}

funksjon _komprimer(hs: liste_heiltall, blokk: liste_heiltall) -> heiltall {
    la w: liste_heiltall = []
    la i: heiltall = 0
    mens i < 16 {
        la p = i * 4
        legg_til(w, _u32((blokk[p] << 24) | (blokk[p + 1] << 16) |
                         (blokk[p + 2] << 8) | blokk[p + 3]))
        i = i + 1
    }
    mens i < 80 {
        legg_til(w, _rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1))
        i = i + 1
    }
    la a = hs[0]
    la b = hs[1]
    la c = hs[2]
    la d = hs[3]
    la e = hs[4]
    i = 0
    mens i < 80 {
        la f: heiltall = 0
        la k: heiltall = 0
        hvis i < 20 {
            f = (b & c) | ((b ^ 4294967295) & d)
            k = 1518500249
        } ellers hvis i < 40 {
            f = b ^ c ^ d
            k = 1859775393
        } ellers hvis i < 60 {
            f = (b & c) | (b & d) | (c & d)
            k = 2400959708
        } ellers {
            f = b ^ c ^ d
            k = 3395469782
        }
        la temp = _u32(_rotl(a, 5) + (f & 4294967295) + e + k + w[i])
        e = d
        d = c
        c = _rotl(b, 30)
        b = a
        a = temp
        i = i + 1
    }
    hs[0] = _u32(hs[0] + a)
    hs[1] = _u32(hs[1] + b)
    hs[2] = _u32(hs[2] + c)
    hs[3] = _u32(hs[3] + d)
    hs[4] = _u32(hs[4] + e)
    returner 0
}

# Returnerer dei rå 20 bytane (0-255). Nyttig for WS-handshake:
# base64(sha1.hash_raw(...)).
funksjon hash_raw(bytes: liste_heiltall) -> liste_heiltall {
    la data = _pad(bytes)
    la hs: liste_heiltall = [1732584193, 4023233417, 2562383102, 271733878, 3285377520]
    la i: heiltall = 0
    mens i < lengde(data) {
        la blokk: liste_heiltall = []
        la j: heiltall = 0
        mens j < 64 {
            legg_til(blokk, data[i + j])
            j = j + 1
        }
        _komprimer(hs, blokk)
        i = i + 64
    }
    la ut: liste_heiltall = []
    la n: heiltall = 0
    mens n < 5 {
        la x = hs[n]
        legg_til(ut, (x >> 24) & 255)
        legg_til(ut, (x >> 16) & 255)
        legg_til(ut, (x >> 8) & 255)
        legg_til(ut, x & 255)
        n = n + 1
    }
    returner ut
}

funksjon _hex(bytes: liste_heiltall) -> tekst {
    la chars = "0123456789abcdef"
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(bytes) {
        la hi = (bytes[i] >> 4) & 15
        la lo = bytes[i] & 15
        ut = ut + builtin.slice(chars, hi, hi + 1) + builtin.slice(chars, lo, lo + 1)
        i = i + 1
    }
    returner ut
}

# 40-teikns heksadesimal digest av ei byte-liste.
funksjon hash_bytes(data: liste_heiltall) -> tekst {
    returner _hex(hash_raw(data))
}

# 40-teikns heksadesimal digest av ein tekst (latin-1/byte-tolka).
funksjon hash(data: tekst) -> tekst {
    returner _hex(hash_raw(_bytes_frå_tekst(data)))
}

# Rå 20-byte digest av ein tekst. Snarveg for WS-handshake:
# base64.kod_bytes(sha1.hash_raw_tekst(nøkkel + magic)).
funksjon hash_raw_tekst(data: tekst) -> liste_heiltall {
    returner hash_raw(_bytes_frå_tekst(data))
}
