# bigint.no - avgrensa unsigned bigint i rein Norscode (base 2^16, little-endian limbar).
# Nok for RSA-verifikasjon (modexp med offentleg eksponent). Ikkje konstanttid.
# Limb-basen 2^16 held delprodukt (< 2^32) og akkumulering godt innanfor 63-bit heiltall.

funksjon _B() -> heiltall { returner 65536 }

funksjon _kopi(a: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(a) { legg_til(ut, a[i]) i = i + 1 }
    returner ut
}
# Fjern leiande null-limbar (behald minst éin).
funksjon norm(a: liste_heiltall) -> liste_heiltall {
    la r = _kopi(a)
    mens lengde(r) > 1 og r[lengde(r) - 1] == 0 { fjern(r, lengde(r) - 1) }
    returner r
}
funksjon _nuller(n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < n { legg_til(ut, 0) i = i + 1 }
    returner ut
}

# Big-endian bytes -> bigint (little-endian limbar base 2^16).
funksjon fra_bytes(bytes: liste_heiltall) -> liste_heiltall {
    # Gjer om til little-endian byteorden, pakk to og to.
    la n = lengde(bytes)
    la le: liste_heiltall = []
    la i = n - 1
    mens i >= 0 { legg_til(le, bytes[i] & 255) i = i - 1 }
    la limbar: liste_heiltall = []
    i = 0
    mens i < lengde(le) {
        la lo = le[i]
        la hi = 0
        hvis i + 1 < lengde(le) { hi = le[i + 1] }
        legg_til(limbar, lo | (hi << 8))
        i = i + 2
    }
    returner norm(limbar)
}
# bigint -> big-endian bytes med gitt lengde (venstre-padda med null).
funksjon til_bytes(a: liste_heiltall, lengde_ut: heiltall) -> liste_heiltall {
    la le: liste_heiltall = []
    la i = 0
    mens i < lengde(a) { legg_til(le, a[i] & 255) legg_til(le, (a[i] >> 8) & 255) i = i + 1 }
    # le er no little-endian bytes; kutt/utvid til lengde_ut og snu.
    mens lengde(le) < lengde_ut { legg_til(le, 0) }
    la ut: liste_heiltall = []
    i = lengde_ut - 1
    mens i >= 0 { legg_til(ut, le[i]) i = i - 1 }
    returner ut
}

# Samanlikn: -1 hvis a<b, 0 hvis a==b, 1 hvis a>b.
funksjon cmp(a_in: liste_heiltall, b_in: liste_heiltall) -> heiltall {
    la a = norm(a_in) la b = norm(b_in)
    hvis lengde(a) != lengde(b) { hvis lengde(a) < lengde(b) { returner -1 } returner 1 }
    la i = lengde(a) - 1
    mens i >= 0 { hvis a[i] != b[i] { hvis a[i] < b[i] { returner -1 } returner 1 } i = i - 1 }
    returner 0
}

funksjon add(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la n = lengde(a) hvis lengde(b) > n { n = lengde(b) }
    la carry = 0 la i = 0
    mens i < n {
        la av = 0 hvis i < lengde(a) { av = a[i] }
        la bv = 0 hvis i < lengde(b) { bv = b[i] }
        la s = av + bv + carry
        legg_til(ut, s & 65535)
        carry = s >> 16
        i = i + 1
    }
    hvis carry > 0 { legg_til(ut, carry) }
    returner norm(ut)
}
# a - b, føreset a >= b.
funksjon sub(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la borrow = 0 la i = 0
    mens i < lengde(a) {
        la bv = 0 hvis i < lengde(b) { bv = b[i] }
        la d = a[i] - bv - borrow
        hvis d < 0 { d = d + 65536 borrow = 1 } ellers { borrow = 0 }
        legg_til(ut, d)
        i = i + 1
    }
    returner norm(ut)
}
funksjon mul(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut = _nuller(lengde(a) + lengde(b))
    la i = 0
    mens i < lengde(a) {
        la carry = 0
        la j = 0
        mens j < lengde(b) {
            la p = ut[i + j] + a[i] * b[j] + carry
            ut[i + j] = p & 65535
            carry = p >> 16
            j = j + 1
        }
        ut[i + lengde(b)] = ut[i + lengde(b)] + carry
        i = i + 1
    }
    returner norm(ut)
}
# Divider bigint med ein enkel limb (0<d<2^16). Returnerer {q, r}.
funksjon _divmod_small(a: liste_heiltall, d: heiltall) -> ordbok {
    la q = _nuller(lengde(a))
    la rem = 0
    la i = lengde(a) - 1
    mens i >= 0 {
        la cur = rem * 65536 + a[i]
        q[i] = cur / d
        rem = cur % d
        i = i - 1
    }
    returner {"q": norm(q), "r": rem}
}

# Knuth Algorithm D: u / v -> {q, r} (bigint-rest).
funksjon divmod(u_in: liste_heiltall, v_in: liste_heiltall) -> ordbok {
    la u = norm(u_in) la v = norm(v_in)
    hvis cmp(u, v) < 0 { returner {"q": [0], "r": u} }
    la n = lengde(v)
    hvis n == 1 {
        la res = _divmod_small(u, v[0])
        returner {"q": res["q"], "r": [res["r"]]}
    }
    la m = lengde(u) - n
    # Normalisering slik at v[n-1] >= base/2.
    la d = 65536 / (v[n - 1] + 1)
    la un = mul(u, [d])
    la vn = norm(mul(v, [d]))
    # un skal ha m+n+1 limbar.
    mens lengde(un) < m + n + 1 { legg_til(un, 0) }
    la q = _nuller(m + 1)
    la j = m
    mens j >= 0 {
        la num = un[j + n] * 65536 + un[j + n - 1]
        la qhat = num / vn[n - 1]
        la rhat = num - qhat * vn[n - 1]
        mens qhat >= 65536 eller (qhat * vn[n - 2] > rhat * 65536 + un[j + n - 2]) {
            qhat = qhat - 1
            rhat = rhat + vn[n - 1]
            hvis rhat >= 65536 { bryt }
        }
        # multipliser og trekk frå: un[j..j+n] -= qhat * vn
        la carry = 0
        la borrow = 0
        la i = 0
        mens i < n {
            la p = qhat * vn[i] + carry
            carry = p >> 16
            la lav = p & 65535
            la s = un[j + i] - lav - borrow
            hvis s < 0 { s = s + 65536 borrow = 1 } ellers { borrow = 0 }
            un[j + i] = s
            i = i + 1
        }
        la s2 = un[j + n] - carry - borrow
        hvis s2 < 0 { s2 = s2 + 65536 borrow = 1 } ellers { borrow = 0 }
        un[j + n] = s2
        hvis borrow != 0 {
            # qhat var éin for stor: legg vn tilbake.
            qhat = qhat - 1
            la c2 = 0
            i = 0
            mens i < n {
                la t = un[j + i] + vn[i] + c2
                un[j + i] = t & 65535
                c2 = t >> 16
                i = i + 1
            }
            un[j + n] = (un[j + n] + c2) & 65535
        }
        q[j] = qhat
        j = j - 1
    }
    # Rest = un[0..n-1] / d (eksakt).
    la rem_limbar: liste_heiltall = []
    la k = 0
    mens k < n { legg_til(rem_limbar, un[k]) k = k + 1 }
    la r_scaled = norm(rem_limbar)
    la r = _divmod_small(r_scaled, d)["q"]
    returner {"q": norm(q), "r": norm(r)}
}
funksjon modulo(a: liste_heiltall, n: liste_heiltall) -> liste_heiltall {
    returner divmod(a, n)["r"]
}

# modexp(base, exp, mod) via square-and-multiply over exp-bitane (MSB->LSB).
funksjon modexp(base_in: liste_heiltall, exp: liste_heiltall, n: liste_heiltall) -> liste_heiltall {
    la resultat: liste_heiltall = [1]
    la b = modulo(base_in, n)
    la e = norm(exp)
    # Finn høgste bit.
    la top = lengde(e) - 1
    mens top > 0 og e[top] == 0 { top = top - 1 }
    la hb = 15
    mens hb > 0 og ((e[top] >> hb) & 1) == 0 { hb = hb - 1 }
    la limb = top
    mens limb >= 0 {
        la start = 15
        hvis limb == top { start = hb }
        la bit = start
        mens bit >= 0 {
            resultat = modulo(mul(resultat, resultat), n)
            hvis ((e[limb] >> bit) & 1) == 1 {
                resultat = modulo(mul(resultat, b), n)
            }
            bit = bit - 1
        }
        limb = limb - 1
    }
    returner norm(resultat)
}

funksjon status() { returner { "abi": "norscode-bigint-v1", "base": 65536 } }
