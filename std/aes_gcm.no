# aes_gcm.no — AES-128-GCM AEAD (RFC 5116 / NIST SP 800-38D), ren Norscode.
# Byggjer på std.aes (FIPS-197) + std.ghash. 96-bit IV (som TLS 1.3 og NIST GCM
# Test Cases). Verifisert i tests/test_aes_gcm_nist.no mot NIST GCM TC2/TC3.
# Byte er liste_heiltall (0-255). Teller-inkrement er byte-vis (unngår 31-bit).

bruk std.aes som aes
bruk std.ghash som gh

funksjon _kopi(v: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(v) { legg_til(ut, v[i]) i = i + 1 }
    returner ut
}

funksjon _zeros(n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < n { legg_til(ut, 0) i = i + 1 }
    returner ut
}

funksjon _append(dst: liste_heiltall, src: liste_heiltall) -> liste_heiltall {
    la i = 0
    mens i < lengde(src) { legg_til(dst, src[i]) i = i + 1 }
    returner dst
}

funksjon _xor(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la u: liste_heiltall = []
    la i = 0
    mens i < lengde(a) { legg_til(u, a[i] ^ b[i]) i = i + 1 }
    returner u
}

# Padder til eit heiltal av 16 byte med nullar.
funksjon _pad16(data: liste_heiltall) -> liste_heiltall {
    la ut = _kopi(data)
    mens lengde(ut) % 16 != 0 { legg_til(ut, 0) }
    returner ut
}

# 64-bit big-endian av n.
funksjon _u64be(n: heiltall) -> liste_heiltall {
    la le: liste_heiltall = []
    la tmp = n
    la k = 0
    mens k < 8 { legg_til(le, tmp % 256) tmp = tmp / 256 k = k + 1 }
    la ut: liste_heiltall = []
    la j = 7
    mens j >= 0 { legg_til(ut, le[j]) j = j - 1 }
    returner ut
}

# Inkrementer dei høgre 32 bitane (byte 12-15) mod 2^32.
funksjon _inc32(ctr: liste_heiltall) -> liste_heiltall {
    la out = _kopi(ctr)
    la i = 15
    la carry = 1
    mens i >= 12 {
        la v = out[i] + carry
        out[i] = v & 255
        carry = v >> 8
        i = i - 1
    }
    returner out
}

# GCTR: CTR-modus frå startteller icb.
funksjon _gctr(key: liste_heiltall, icb: liste_heiltall, data: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la ctr = _kopi(icb)
    la n = lengde(data)
    la off = 0
    mens off < n {
        la ks = aes.aes128_encrypt_block(key, ctr)
        la j = 0
        mens j < 16 og off + j < n {
            legg_til(ut, data[off + j] ^ ks[j])
            j = j + 1
        }
        ctr = _inc32(ctr)
        off = off + 16
    }
    returner ut
}

# Intern: GHASH over pad(aad) || pad(ct) || lenblock, deretter tag = S XOR E(J0).
funksjon _tag(key: liste_heiltall, h: liste_heiltall, j0: liste_heiltall,
              aad: liste_heiltall, ct: liste_heiltall) -> liste_heiltall {
    la gin: liste_heiltall = []
    gin = _append(gin, _pad16(aad))
    gin = _append(gin, _pad16(ct))
    gin = _append(gin, _u64be(lengde(aad) * 8))
    gin = _append(gin, _u64be(lengde(ct) * 8))
    la s = gh.ghash(h, gin)
    returner _xor(s, aes.aes128_encrypt_block(key, j0))
}

# seal: krypter + autentiser. Returnerer {ciphertext, tag} (begge liste_heiltall).
funksjon aes128_gcm_seal(key: liste_heiltall, iv: liste_heiltall,
                         aad: liste_heiltall, plaintext: liste_heiltall) -> ordbok {
    la h = aes.aes128_encrypt_block(key, _zeros(16))
    la j0 = _kopi(iv)
    j0 = _append(j0, [0, 0, 0, 1])
    la ct = _gctr(key, _inc32(j0), plaintext)
    la tag = _tag(key, h, j0, aad, ct)
    returner {"ciphertext": ct, "tag": tag}
}

# _lik: konstant-tid-lik samanlikning av to byte-lister.
funksjon _lik(a: liste_heiltall, b: liste_heiltall) -> boolsk {
    hvis lengde(a) != lengde(b) { returner usann }
    la diff = 0
    la i = 0
    mens i < lengde(a) { diff = diff | (a[i] ^ b[i]) i = i + 1 }
    returner diff == 0
}

# open: verifiser tag, deretter dekrypter. Returnerer {ok, plaintext}.
funksjon aes128_gcm_open(key: liste_heiltall, iv: liste_heiltall, aad: liste_heiltall,
                         ct: liste_heiltall, tag: liste_heiltall) -> ordbok {
    la h = aes.aes128_encrypt_block(key, _zeros(16))
    la j0 = _kopi(iv)
    j0 = _append(j0, [0, 0, 0, 1])
    la forventa = _tag(key, h, j0, aad, ct)
    hvis ikkje _lik(forventa, tag) { returner {"ok": usann, "plaintext": []} }
    returner {"ok": sann, "plaintext": _gctr(key, _inc32(j0), ct)}
}
