# Feilstandardbibliotek
#
# Feil er anten tekst på forma "Type: melding" (det `kast "IOFeil: ..."` og dei
# innebygde feila gjev) eller ordbøker med "type"- og "melding"-felt. Nedst i fila
# ligg årsakskjede-hjelparar (Throwable.getCause-stil): ny_feil, årsak, rotårsak,
# årsakskjede og kjede_til_tekst. ny_feil lagar tekst med "Forårsaka av:"-linjer,
# fordi ein ufanga ordbok-feil blir skriven ut som "[verdi]" (sjå der).

funksjon ny(type_navn: tekst, melding: tekst) -> tekst {
    returner type_navn + ": " + melding
}

funksjon io(melding: tekst) -> tekst {
    returner ny("IOFeil", melding)
}

funksjon verdi(melding: tekst) -> tekst {
    returner ny("VerdiFeil", melding)
}

funksjon typefeil(melding: tekst) -> tekst {
    returner ny("TypeFeil", melding)
}

funksjon indeks(melding: tekst) -> tekst {
    returner ny("IndeksFeil", melding)
}

funksjon nøkkel(melding: tekst) -> tekst {
    returner ny("NøkkelFeil", melding)
}

funksjon overflyt(melding: tekst) -> tekst {
    returner ny("OverflytFeil", melding)
}

funksjon tomt(melding: tekst) -> tekst {
    returner ny("TomtFeil", melding)
}

funksjon ikkje_implementert(melding: tekst) -> tekst {
    returner ny("IkkjeImplementertFeil", melding)
}

funksjon argument(melding: tekst) -> tekst {
    returner ny("ArgumentFeil", melding)
}

funksjon tilstand(melding: tekst) -> tekst {
    returner ny("TilstandsFeil", melding)
}

# Kast viss vilkår ikkje er oppfylt (assert-stil)
funksjon kast_viss_usann(vilkår: bool, melding: tekst) -> bool {
    hvis (ikke vilkår) {
        kast "AssertFeil: " + melding
    }
    returner sann
}

# Kast viss tekst er tom
funksjon kast_viss_tom(tekstverdi: tekst, namn: tekst) -> tekst {
    hvis (tekst_inneholder(tekstverdi, "") og lengde(tekstverdi) == 0) {
        kast ny("ArgumentFeil", namn + " kan ikkje vere tom")
    }
    returner tekstverdi
}

# Kast viss heltall er utanfor område
funksjon kast_viss_utanfor(verdi: heltall, min_v: heltall, maks_v: heltall, namn: tekst) -> heltall {
    hvis (verdi < min_v eller verdi > maks_v) {
        kast ny("ArgumentFeil", namn + " må vere mellom " + tekst_fra_heltall(min_v) + " og " + tekst_fra_heltall(maks_v) + ", fekk " + tekst_fra_heltall(verdi))
    }
    returner verdi
}

# Pakk ut feiltekst frå "Type: melding"-format
funksjon feil_type(feiltekst: tekst) -> tekst {
    la kolon: heltall = builtin.index_of(feiltekst, ":")
    hvis (kolon < 0) { returner feiltekst }
    returner builtin.slice(feiltekst, 0, kolon)
}

funksjon feil_melding(feiltekst: tekst) -> tekst {
    la kolon: heltall = builtin.index_of(feiltekst, ":")
    hvis (kolon < 0) { returner feiltekst }
    returner tekst_trim(builtin.slice(feiltekst, kolon + 1, lengde(feiltekst)))
}

# ─── Årsakskjede (Java: new X(melding, cause), getCause, printStackTrace) ──────
#
# ny_feil og ny_feil_typa gjev TEKST: hovudlinja "Type: melding" og éi
# "Forårsaka av: "-linje per ledd i årsakskjeda, som Java sine "Caused by:"-linjer:
#
#   TenestFeil: kunne ikkje lagre
#   Forårsaka av: IOFeil: disk full
#
#   prøv { lagre() } fang (e) {
#       kast feil.ny_feil("TenestFeil: kunne ikkje lagre", e)
#   }
#   ...
#   fang (e: TenestFeil) {
#       skriv(feil.kjede_til_tekst(e))   # dei to linjene over
#       feil.årsak(e)                    # "IOFeil: disk full"
#   }
#
# Kvifor tekst og ikkje ordbok: utskrifta av UFANGA feil ligg i nc_main-lukkinga
# (selfhost/nc_main.no, "ERROR: " + verdi) og i codegen ("norscode: Norscode
# unntak: ..."), og ho skriv ei ordbok som "[verdi]" (VM og x86-64-AOT) eller som
# tom melding (macOS-AOT) — type, melding og årsak forsvinn. Ein tekst blir skriven
# ut heil, med alle "Forårsaka av:"-linjene, på alle tre. Typa fang ser på teksten
# før første kolon, så `fang (e: TenestFeil)` fangar ny_feil("TenestFeil: ...", e)
# på same måte som `kast "TenestFeil: ..."`.
#
# Lesarane (årsak, årsakskjede, rotårsak, type_av, melding_av, feil_til_tekst,
# kjede_til_tekst, finn_årsak) følgjer både slike tekstkjeder og ordbøker med
# "årsak"-felt. Treng du å ta vare på sjølve årsaksobjektet (identitet eller eigne
# felt, som Java getCause), lag ordboka sjølv:
#
#   kast {"type": "TenestFeil", "melding": "kunne ikkje lagre", "årsak": e}
#
# (skriv nøkkelen "årsak" i hermeteikn: ein bar ikkje-ASCII-nøkkel som `årsak: e`
# blir lesen som variabelen årsak når fila blir kompilert via `nc test`), men då
# skriv ein ufanga feil berre "[verdi]" (sjå over). ny_feil gjer ei årsak som
# ikkje er tekst om til tekst med kjede_til_tekst, så eigne felt i ho går tapt.
#
# Avgrensingar: ei melding som sjølv inneheld "\nForårsaka av: " blir lesen som ei
# kjede; ei årsak som ikkje er ein feil (tal, boolsk) blir tekst ("heltall: 0").
# Ordbokkjeder blir følgde i høgst 100 ordbok-ledd, så ei sirkulær kjede hengjer
# ikkje; rotårsak er då siste ledd før avkortinga. Tekstkjeder kan ikkje vere
# sirkulære og blir følgde heilt ut.

funksjon _kjede_maks() -> heltall {
    returner 100
}

funksjon _markør() -> tekst {
    returner "\nForårsaka av: "
}

# Indeksen til kolonet etter eit gyldig typenamn (bokstavar, siffer, _ og .,
# ikkje siffer først, ingen mellomrom), eller -1.
funksjon _type_kolon(s: tekst) -> heltall {
    la kolon: heltall = builtin.index_of(s, ":")
    hvis kolon <= 0 {
        returner -1
    }
    la i: heltall = 0
    mens i < kolon {
        la b: heltall = builtin.char_code(s[i])
        la bokstav: bool = (b >= 65 og b <= 90) eller (b >= 97 og b <= 122) eller b == 95 eller b >= 128
        la siffer: bool = b >= 48 og b <= 57
        hvis ikkje (bokstav eller b == 46 eller (siffer og i > 0)) {
            returner -1
        }
        i = i + 1
    }
    returner kolon
}

funksjon _etter_kolon(s: tekst, kolon: heltall) -> tekst {
    la n: heltall = lengde(s)
    la i: heltall = kolon + 1
    mens i < n og builtin.char_code(s[i]) == 32 {
        i = i + 1
    }
    returner builtin.slice(s, i, n)
}

# Hovudlinja i ei tekstkjede: alt før første "\nForårsaka av: ".
funksjon _hovud(s: tekst) -> tekst {
    la i: heltall = builtin.index_of(s, _markør())
    hvis i < 0 {
        returner s
    }
    returner builtin.slice(s, 0, i)
}

funksjon _er_ordbok(e) -> bool {
    returner builtin.type(e) == "ordbok"
}

funksjon _med_årsak(hovud: tekst, årsak_verdi) -> tekst {
    hvis årsak_verdi == null {
        returner hovud
    }
    hvis builtin.type(årsak_verdi) == "tekst" {
        returner hovud + _markør() + årsak_verdi
    }
    returner hovud + _markør() + kjede_til_tekst(årsak_verdi)
}

# Ny feil "type_namn: melding" med årsak (årsak kan vere null). Tom type blir "Feil".
funksjon ny_feil_typa(type_namn: tekst, melding: tekst, årsak_verdi) -> tekst {
    la t: tekst = type_namn
    hvis t == "" {
        t = "Feil"
    }
    returner _med_årsak(t + ": " + melding, årsak_verdi)
}

# Ny feil frå "Type: melding" med årsak (throw new X(melding, cause)). Utan gyldig
# typeprefiks blir teksten "Feil: <melding>", så typa fang og type_av ser "Feil".
funksjon ny_feil(melding: tekst, årsak_verdi) -> tekst {
    hvis _type_kolon(melding) < 0 {
        returner _med_årsak("Feil: " + melding, årsak_verdi)
    }
    returner _med_årsak(melding, årsak_verdi)
}

# Kast ein ny feil med årsak.
funksjon kast_med_årsak(melding: tekst, årsak_verdi) {
    kast ny_feil(melding, årsak_verdi)
}

# Årsaka til ein feil (getCause), eller null: resten av ei tekstkjede etter første
# "Forårsaka av:", eller "årsak"-feltet i ei ordbok.
funksjon årsak(e) {
    la t: tekst = builtin.type(e)
    hvis t == "tekst" {
        la i: heltall = builtin.index_of(e, _markør())
        hvis i < 0 {
            returner null
        }
        returner builtin.slice(e, i + lengde(_markør()), lengde(e))
    }
    hvis t == "ordbok" {
        hvis builtin.har_nokkel(e, "årsak") {
            returner e["årsak"]
        }
    }
    returner null
}

# Alle ledd i kjeda, frå feilen sjølv til rotårsaka (Guava getCausalChain).
funksjon årsakskjede(e) {
    la kjede = []
    la gjeldande = e
    la ordbok_ledd: heltall = 0
    mens gjeldande != null og ordbok_ledd < _kjede_maks() {
        legg_til(kjede, gjeldande)
        hvis _er_ordbok(gjeldande) {
            ordbok_ledd = ordbok_ledd + 1
        }
        gjeldande = årsak(gjeldande)
    }
    returner kjede
}

# Den inste årsaka (Guava getRootCause): feilen sjølv om han ikkje har årsak.
funksjon rotårsak(e) {
    la kjede = årsakskjede(e)
    hvis lengde(kjede) == 0 {
        returner e
    }
    returner kjede[lengde(kjede) - 1]
}

# Typenamnet: "IOFeil" for "IOFeil: ...", "type"-feltet for ordbøker (òg
# struktur-taggane __type__/__struct_type__), "" for tekst utan typeprefiks,
# og builtin.type for andre verdiar.
funksjon type_av(e) -> tekst {
    la t: tekst = builtin.type(e)
    hvis t == "tekst" {
        la h: tekst = _hovud(e)
        la kolon: heltall = _type_kolon(h)
        hvis kolon < 0 {
            returner ""
        }
        returner builtin.slice(h, 0, kolon)
    }
    hvis t == "ordbok" {
        hvis builtin.har_nokkel(e, "type") og e["type"] != null {
            returner tekst(e["type"])
        }
        hvis builtin.har_nokkel(e, "__type__") og e["__type__"] != null {
            returner tekst(e["__type__"])
        }
        hvis builtin.har_nokkel(e, "__struct_type__") og e["__struct_type__"] != null {
            returner tekst(e["__struct_type__"])
        }
        returner ""
    }
    returner t
}

# Meldinga utan typeprefiks og utan årsakslinjer ("melding"-feltet for ordbøker).
funksjon melding_av(e) -> tekst {
    la t: tekst = builtin.type(e)
    hvis t == "tekst" {
        la h: tekst = _hovud(e)
        la kolon: heltall = _type_kolon(h)
        hvis kolon < 0 {
            returner h
        }
        returner _etter_kolon(h, kolon)
    }
    hvis t == "ordbok" {
        hvis builtin.har_nokkel(e, "melding") og e["melding"] != null {
            returner tekst(e["melding"])
        }
        returner ""
    }
    hvis t == "ingenting" {
        returner "null"
    }
    returner tekst(e)
}

# Éi linje for eitt ledd: "Type: melding" (berre meldinga når typen manglar).
# For tekst er det hovudlinja slik ho står, utan årsakslinjene.
funksjon feil_til_tekst(e) -> tekst {
    hvis builtin.type(e) == "tekst" {
        returner _hovud(e)
    }
    la type_namn: tekst = type_av(e)
    la melding: tekst = melding_av(e)
    hvis type_namn == "" {
        returner melding
    }
    hvis melding == "" {
        returner type_namn
    }
    returner type_namn + ": " + melding
}

# Heile kjeda, éi linje per ledd, som Java sine "Caused by:"-linjer:
#   TenestFeil: kunne ikkje lagre
#   Forårsaka av: IOFeil: disk full
# For ei tekstkjede frå ny_feil er dette teksten sjølv.
funksjon kjede_til_tekst(e) -> tekst {
    la kjede = årsakskjede(e)
    la linjer: liste_tekst = []
    la i: heltall = 0
    mens i < lengde(kjede) {
        hvis i == 0 {
            legg_til(linjer, feil_til_tekst(kjede[i]))
        } ellers {
            legg_til(linjer, "Forårsaka av: " + feil_til_tekst(kjede[i]))
        }
        i = i + 1
    }
    hvis lengde(kjede) > 0 og årsak(kjede[lengde(kjede) - 1]) != null {
        legg_til(linjer, "Forårsaka av: ... (kjeda er avkorta etter " + tekst(_kjede_maks()) + " ordbok-ledd)")
    }
    returner builtin.join(linjer, "\n")
}

# Første ledd i kjeda (inkludert feilen sjølv) med typen, eller null.
funksjon finn_årsak(e, type_namn: tekst) {
    la kjede = årsakskjede(e)
    la i: heltall = 0
    mens i < lengde(kjede) {
        hvis type_av(kjede[i]) == type_namn {
            returner kjede[i]
        }
        i = i + 1
    }
    returner null
}

funksjon har_årsak_av_type(e, type_namn: tekst) -> bool {
    returner finn_årsak(e, type_namn) != null
}
