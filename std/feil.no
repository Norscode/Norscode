# Feilstandardbibliotek
#
# Feil er anten tekst på forma "Type: melding" (det `kast "IOFeil: ..."` og dei
# innebygde feila gjev) eller ordbøker med "type"- og "melding"-felt. Nedst i fila
# ligg årsakskjede-hjelparar (Throwable.getCause-stil): ny_feil, årsak, rotårsak,
# årsakskjede og kjede_til_tekst.

funksjon ny(type_navn: tekst, melding: tekst) -> tekst {
    returner type_navn + ": " + melding
}

funksjon io(melding: tekst) -> tekst {
    returner ny("IOFeil", melding)
}

funksjon verdi(melding: tekst) -> tekst {
    returner ny("VerdiFeil", melding)
}

funksjon typefeil(melding: tekst) -> tekst {
    returner ny("TypeFeil", melding)
}

funksjon indeks(melding: tekst) -> tekst {
    returner ny("IndeksFeil", melding)
}

funksjon nøkkel(melding: tekst) -> tekst {
    returner ny("NøkkelFeil", melding)
}

funksjon overflyt(melding: tekst) -> tekst {
    returner ny("OverflytFeil", melding)
}

funksjon tomt(melding: tekst) -> tekst {
    returner ny("TomtFeil", melding)
}

funksjon ikkje_implementert(melding: tekst) -> tekst {
    returner ny("IkkjeImplementertFeil", melding)
}

funksjon argument(melding: tekst) -> tekst {
    returner ny("ArgumentFeil", melding)
}

funksjon tilstand(melding: tekst) -> tekst {
    returner ny("TilstandsFeil", melding)
}

# Kast viss vilkår ikkje er oppfylt (assert-stil)
funksjon kast_viss_usann(vilkår: bool, melding: tekst) -> bool {
    hvis (ikke vilkår) {
        kast "AssertFeil: " + melding
    }
    returner sann
}

# Kast viss tekst er tom
funksjon kast_viss_tom(tekstverdi: tekst, namn: tekst) -> tekst {
    hvis (tekst_inneholder(tekstverdi, "") og lengde(tekstverdi) == 0) {
        kast ny("ArgumentFeil", namn + " kan ikkje vere tom")
    }
    returner tekstverdi
}

# Kast viss heltall er utanfor område
funksjon kast_viss_utanfor(verdi: heltall, min_v: heltall, maks_v: heltall, namn: tekst) -> heltall {
    hvis (verdi < min_v eller verdi > maks_v) {
        kast ny("ArgumentFeil", namn + " må vere mellom " + tekst_fra_heltall(min_v) + " og " + tekst_fra_heltall(maks_v) + ", fekk " + tekst_fra_heltall(verdi))
    }
    returner verdi
}

# Pakk ut feiltekst frå "Type: melding"-format
funksjon feil_type(feiltekst: tekst) -> tekst {
    la kolon: heltall = builtin.index_of(feiltekst, ":")
    hvis (kolon < 0) { returner feiltekst }
    returner builtin.slice(feiltekst, 0, kolon)
}

funksjon feil_melding(feiltekst: tekst) -> tekst {
    la kolon: heltall = builtin.index_of(feiltekst, ":")
    hvis (kolon < 0) { returner feiltekst }
    returner tekst_trim(builtin.slice(feiltekst, kolon + 1, lengde(feiltekst)))
}

# ─── Årsakskjede (Java: new X(melding, cause), getCause, printStackTrace) ──────
#
# Ein feil med årsak er ei ordbok {type, melding, årsak}, der årsaka er den
# fanga verdien slik prøv/fang gav han: tekst ("IOFeil: disk full", òg innebygde
# feil som "IndeksFeil: ..." på VM) eller ei ny ordbok. Typa fang matchar på
# "type"-feltet, så `fang (e: TenestFeil)` fangar ny_feil("TenestFeil: ...", e).
#
#   prøv { lagre() } fang (e) {
#       kast feil.ny_feil("TenestFeil: kunne ikkje lagre", e)
#   }
#   ...
#   fang (e: TenestFeil) {
#       skriv(feil.kjede_til_tekst(e))
#       # TenestFeil: kunne ikkje lagre
#       # Forårsaka av: IOFeil: disk full
#   }
#
# Kjeda blir følgd gjennom "årsak"-feltet på ordbøker; tekst og andre verdiar har
# inga årsak. Traverseringa stoppar etter 100 ledd, så ei sirkulær kjede hengjer ikkje.

funksjon _kjede_maks() -> heltall {
    returner 100
}

# Indeksen til kolonet etter eit gyldig typenamn (bokstavar, siffer, _ og .,
# ikkje siffer først, ingen mellomrom), eller -1.
funksjon _type_kolon(s: tekst) -> heltall {
    la kolon: heltall = builtin.index_of(s, ":")
    hvis kolon <= 0 {
        returner -1
    }
    la i: heltall = 0
    mens i < kolon {
        la b: heltall = builtin.char_code(s[i])
        la bokstav: bool = (b >= 65 og b <= 90) eller (b >= 97 og b <= 122) eller b == 95 eller b >= 128
        la siffer: bool = b >= 48 og b <= 57
        hvis ikkje (bokstav eller b == 46 eller (siffer og i > 0)) {
            returner -1
        }
        i = i + 1
    }
    returner kolon
}

funksjon _etter_kolon(s: tekst, kolon: heltall) -> tekst {
    la n: heltall = lengde(s)
    la i: heltall = kolon + 1
    mens i < n og builtin.char_code(s[i]) == 32 {
        i = i + 1
    }
    returner builtin.slice(s, i, n)
}

# Ny feil med type, melding og årsak (årsak kan vere null).
funksjon ny_feil_typa(type_namn: tekst, melding: tekst, årsak_verdi) {
    la e = {type: type_namn, melding: melding}
    hvis årsak_verdi != null {
        e["årsak"] = årsak_verdi
    }
    returner e
}

# Ny feil frå "Type: melding" (utan gyldig typeprefiks blir typen "Feil") med årsak.
funksjon ny_feil(melding: tekst, årsak_verdi) {
    la kolon: heltall = _type_kolon(melding)
    hvis kolon < 0 {
        returner ny_feil_typa("Feil", melding, årsak_verdi)
    }
    returner ny_feil_typa(builtin.slice(melding, 0, kolon), _etter_kolon(melding, kolon), årsak_verdi)
}

# Kast ein ny feil med årsak (throw new X(melding, cause)).
funksjon kast_med_årsak(melding: tekst, årsak_verdi) {
    kast ny_feil(melding, årsak_verdi)
}

funksjon _er_ordbok(e) -> bool {
    returner builtin.type(e) == "ordbok"
}

# Årsaka til ein feil (getCause), eller null.
funksjon årsak(e) {
    hvis _er_ordbok(e) og builtin.har_nokkel(e, "årsak") {
        returner e["årsak"]
    }
    returner null
}

# Alle ledd i kjeda, frå feilen sjølv til rotårsaka (Guava getCausalChain).
funksjon årsakskjede(e) {
    la kjede = []
    la gjeldande = e
    la n: heltall = 0
    mens gjeldande != null og n < _kjede_maks() {
        legg_til(kjede, gjeldande)
        gjeldande = årsak(gjeldande)
        n = n + 1
    }
    returner kjede
}

# Den inste årsaka (Guava getRootCause): feilen sjølv om han ikkje har årsak.
funksjon rotårsak(e) {
    la kjede = årsakskjede(e)
    hvis lengde(kjede) == 0 {
        returner e
    }
    returner kjede[lengde(kjede) - 1]
}

# Typenamnet: "IOFeil" for "IOFeil: ...", "type"-feltet for ordbøker (òg
# struktur-taggane __type__/__struct_type__), "" for tekst utan typeprefiks,
# og builtin.type for andre verdiar.
funksjon type_av(e) -> tekst {
    la t: tekst = builtin.type(e)
    hvis t == "tekst" {
        la kolon: heltall = _type_kolon(e)
        hvis kolon < 0 {
            returner ""
        }
        returner builtin.slice(e, 0, kolon)
    }
    hvis t == "ordbok" {
        hvis builtin.har_nokkel(e, "type") og e["type"] != null {
            returner tekst(e["type"])
        }
        hvis builtin.har_nokkel(e, "__type__") og e["__type__"] != null {
            returner tekst(e["__type__"])
        }
        hvis builtin.har_nokkel(e, "__struct_type__") og e["__struct_type__"] != null {
            returner tekst(e["__struct_type__"])
        }
        returner ""
    }
    returner t
}

# Meldinga utan typeprefiks ("melding"-feltet for ordbøker).
funksjon melding_av(e) -> tekst {
    la t: tekst = builtin.type(e)
    hvis t == "tekst" {
        la kolon: heltall = _type_kolon(e)
        hvis kolon < 0 {
            returner e
        }
        returner _etter_kolon(e, kolon)
    }
    hvis t == "ordbok" {
        hvis builtin.har_nokkel(e, "melding") og e["melding"] != null {
            returner tekst(e["melding"])
        }
        returner ""
    }
    hvis t == "ingenting" {
        returner "null"
    }
    returner tekst(e)
}

# Éi linje: "Type: melding" (berre meldinga når typen manglar).
funksjon feil_til_tekst(e) -> tekst {
    la type_namn: tekst = type_av(e)
    la melding: tekst = melding_av(e)
    hvis builtin.type(e) == "tekst" {
        returner e
    }
    hvis type_namn == "" {
        returner melding
    }
    hvis melding == "" {
        returner type_namn
    }
    returner type_namn + ": " + melding
}

# Heile kjeda, éi linje per ledd, som Java sine "Caused by:"-linjer:
#   TenestFeil: kunne ikkje lagre
#   Forårsaka av: IOFeil: disk full
funksjon kjede_til_tekst(e) -> tekst {
    la kjede = årsakskjede(e)
    la linjer: liste_tekst = []
    la i: heltall = 0
    mens i < lengde(kjede) {
        hvis i == 0 {
            legg_til(linjer, feil_til_tekst(kjede[i]))
        } ellers {
            legg_til(linjer, "Forårsaka av: " + feil_til_tekst(kjede[i]))
        }
        i = i + 1
    }
    hvis lengde(kjede) >= _kjede_maks() og årsak(kjede[lengde(kjede) - 1]) != null {
        legg_til(linjer, "Forårsaka av: ... (kjeda er avkorta etter " + tekst(_kjede_maks()) + " ledd)")
    }
    returner builtin.join(linjer, "\n")
}

# Første ledd i kjeda (inkludert feilen sjølv) med typen, eller null.
funksjon finn_årsak(e, type_namn: tekst) {
    la kjede = årsakskjede(e)
    la i: heltall = 0
    mens i < lengde(kjede) {
        hvis type_av(kjede[i]) == type_namn {
            returner kjede[i]
        }
        i = i + 1
    }
    returner null
}

funksjon har_årsak_av_type(e, type_namn: tekst) -> bool {
    returner finn_årsak(e, type_namn) != null
}
