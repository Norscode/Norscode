// RFC 6238 TOTP med RFC 4648 Base32 og HMAC-SHA256.

bruk std.base32 som base32
bruk std.sha256 som sha256

funksjon potens10(n: heiltall) -> heiltall {
    la verdi: heiltall = 1
    la i: heiltall = 0
    mens i < n { verdi = verdi * 10 i = i + 1 }
    returner verdi
}

funksjon teljar_bytes(teljar: heiltall) -> liste_heiltall {
    hvis teljar < 0 { kast "TOTPFeil: negativ teljar" }
    la ut: liste_heiltall = [0,0,0,0,0,0,0,0]
    la i: heiltall = 7
    mens i >= 0 {
        ut[i] = teljar % 256
        teljar = teljar / 256
        i = i - 1
    }
    returner ut
}

funksjon venstre_pad(verdi: heiltall, siffer: heiltall) -> tekst {
    la ut = tekst_fra_heltall(verdi)
    mens lengde(ut) < siffer { ut = "0" + ut }
    returner ut
}

funksjon hotp_sha256_bytes(nøkkel: liste_heiltall, teljar: heiltall, siffer: heiltall) -> tekst {
    hvis siffer < 6 eller siffer > 8 { kast "TOTPFeil: siffer må vere 6..8" }
    la tag = sha256.hmac_sha256_bytes(nøkkel, teljar_bytes(teljar))
    la offset = tag[lengde(tag) - 1] & 15
    hvis offset + 3 >= lengde(tag) { kast "TOTPFeil: ugyldig trunkering" }
    la binær = ((tag[offset] & 127) << 24) |
                 ((tag[offset + 1] & 255) << 16) |
                 ((tag[offset + 2] & 255) << 8) |
                 (tag[offset + 3] & 255)
    returner venstre_pad(binær % potens10(siffer), siffer)
}

funksjon hotp_sha256(hemmeleg_base32: tekst, teljar: heiltall, siffer: heiltall) -> tekst {
    returner hotp_sha256_bytes(base32.dekod_bytes(hemmeleg_base32), teljar, siffer)
}

funksjon kode(hemmeleg_base32: tekst, unix_tid_sekund: heiltall, steg_sekund: heiltall, siffer: heiltall) -> tekst {
    hvis steg_sekund <= 0 { kast "TOTPFeil: steg må vere positivt" }
    hvis unix_tid_sekund < 0 { kast "TOTPFeil: negativ tid" }
    returner hotp_sha256(hemmeleg_base32, unix_tid_sekund / steg_sekund, siffer)
}

funksjon konstant_tid_lik(a: tekst, b: tekst) -> boolsk {
    la diff: heiltall = lengde(a) ^ lengde(b)
    la maks = lengde(a)
    hvis lengde(b) > maks { maks = lengde(b) }
    la i: heiltall = 0
    mens i < maks {
        la av: heiltall = 0
        la bv: heiltall = 0
        hvis i < lengde(a) { av = builtin.char_code(a[i]) }
        hvis i < lengde(b) { bv = builtin.char_code(b[i]) }
        diff = diff | (av ^ bv)
        i = i + 1
    }
    returner diff == 0
}

funksjon verifiser(hemmeleg_base32: tekst, oppgitt: tekst, unix_tid_sekund: heiltall,
                  steg_sekund: heiltall, siffer: heiltall, vindauge: heiltall) -> boolsk {
    hvis vindauge < 0 eller vindauge > 10 { kast "TOTPFeil: ugyldig vindauge" }
    la grunn = unix_tid_sekund / steg_sekund
    la i = 0 - vindauge
    la treff = usann
    mens i <= vindauge {
        la teljar = grunn + i
        hvis teljar >= 0 {
            la kandidat = hotp_sha256(hemmeleg_base32, teljar, siffer)
            // Ikkje returner tidleg; alle vindaugsposisjonar blir kontrollerte.
            hvis konstant_tid_lik(kandidat, oppgitt) { treff = sann }
        }
        i = i + 1
    }
    returner treff
}

funksjon otpauth_uri(utstedar: tekst, konto: tekst, hemmeleg_base32: tekst,
                    steg_sekund: heiltall, siffer: heiltall) -> tekst {
    // Kallaren må gi URL-koda utstedar/konto; hemmelegheita blir normalisert.
    returner "otpauth://totp/" + utstedar + ":" + konto +
        "?secret=" + base32.normaliser(hemmeleg_base32) +
        "&issuer=" + utstedar + "&algorithm=SHA256&digits=" +
        tekst_fra_heltall(siffer) + "&period=" + tekst_fra_heltall(steg_sekund)
}
