# js_objekt.no — Object-funksjonar med JavaScript-semantikk, skrivne i Norscode
#
# JS: Object.keys/values/entries/assign/fromEntries, spread, in, delete
#
# Ordbøker i Norscode svarar til vanlege JS-objekt. Funksjonane her gir same
# oppførsel som Object-metodane, med Norscode-namn.
#
# Om rekkjefølgje: JavaScript garanterer innsetjingsrekkjefølgje for
# strengnøklar. Norscode-køyrarane gjer ikkje det — `nøklar` kan gi ei anna
# rekkjefølgje i tolk og NCB-køyrar. Bruk `nøklar_sortert` (og
# `oppføringar_sorterte`) når resultatet må vere deterministisk.
#
# Bruk:
#   bruk std.js_objekt som jso
#
#   jso.nøklar({"a": 1, "b": 2})             # ["a", "b"]
#   jso.slå_saman({"a": 1}, {"b": 2})        # {"a": 1, "b": 2}   (som {...a, ...b})
#   jso.hent({"a": 1}, "z", 0)               # 0                  (som a.z ?? 0)

# ─── Lesing ───────────────────────────────────────────────────────────────────

# JS: Object.keys(o)
funksjon nøklar(o) -> liste_tekst {
    returner builtin.nøkler(o)
}

# Nøklar i stigande alfabetisk rekkjefølgje — deterministisk uansett køyrar.
funksjon nøklar_sortert(o) -> liste_tekst {
    la k: liste_tekst = builtin.nøkler(o)
    la ut: liste_tekst = []
    la i: heltall = 0
    mens (i < lengde(k)) {
        legg_til(ut, k[i])
        i = i + 1
    }
    la j: heltall = 1
    mens (j < lengde(ut)) {
        la gjeldande: tekst = ut[j]
        la m: heltall = j - 1
        la plassert: bool = usann
        mens (m >= 0 og ikkje plassert) {
            hvis ut[m] <= gjeldande {
                plassert = sann
            } ellers {
                ut[m + 1] = ut[m]
                m = m - 1
            }
        }
        ut[m + 1] = gjeldande
        j = j + 1
    }
    returner ut
}

# JS: Object.entries(o) med deterministisk rekkjefølgje.
funksjon oppføringar_sorterte(o) -> liste {
    la ut: liste = []
    la k: liste_tekst = nøklar_sortert(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        legg_til(ut, [k[i], o[k[i]]])
        i = i + 1
    }
    returner ut
}

# JS: Object.values(o)
funksjon verdiar(o) -> liste {
    la ut: liste = []
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        legg_til(ut, o[k[i]])
        i = i + 1
    }
    returner ut
}

# JS: Object.entries(o) — liste av [nøkkel, verdi]
funksjon oppføringar(o) -> liste {
    la ut: liste = []
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        legg_til(ut, [k[i], o[k[i]]])
        i = i + 1
    }
    returner ut
}

# JS: Object.fromEntries(par)
funksjon frå_oppføringar(par) -> ordbok {
    la ut: ordbok = {}
    la i: heltall = 0
    mens (i < lengde(par)) {
        la rad = par[i]
        hvis lengde(rad) >= 2 {
            ut[tekst(rad[0])] = rad[1]
        }
        i = i + 1
    }
    returner ut
}

# JS: "nøkkel" in o / o.hasOwnProperty(nøkkel)
funksjon har(o, nøkkel: tekst) -> bool {
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        hvis k[i] == nøkkel {
            returner sann
        }
        i = i + 1
    }
    returner usann
}

# JS: o[nøkkel] ?? standard — standardverdi når nøkkelen manglar.
funksjon hent(o, nøkkel: tekst, standard) {
    hvis har(o, nøkkel) {
        returner o[nøkkel]
    }
    returner standard
}

# JS: Object.keys(o).length === 0
funksjon er_tom(o) -> bool {
    returner lengde(builtin.nøkler(o)) == 0
}

# JS: Object.keys(o).length
funksjon antal(o) -> heltall {
    returner lengde(builtin.nøkler(o))
}

# ─── Endring ──────────────────────────────────────────────────────────────────

# JS: {...o} — grunn kopi.
funksjon kopi(o) -> ordbok {
    la ut: ordbok = {}
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        ut[k[i]] = o[k[i]]
        i = i + 1
    }
    returner ut
}

# JS: Object.assign(mål, kjelde) — endrar `mål` og returnerer det.
funksjon tildel(mål, kjelde) {
    la k: liste_tekst = builtin.nøkler(kjelde)
    la i: heltall = 0
    mens (i < lengde(k)) {
        mål[k[i]] = kjelde[k[i]]
        i = i + 1
    }
    returner mål
}

# JS: {...a, ...b} — ny ordbok, b vinn ved like nøklar.
funksjon slå_saman(a, b) -> ordbok {
    la ut: ordbok = kopi(a)
    returner tildel(ut, b)
}

# JS: delete o[nøkkel] — ny ordbok utan nøkkelen.
funksjon utan(o, nøkkel: tekst) -> ordbok {
    la ut: ordbok = {}
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        hvis k[i] != nøkkel {
            ut[k[i]] = o[k[i]]
        }
        i = i + 1
    }
    returner ut
}

# JS: Object.entries(o).map(...) — nye verdiar, same nøklar.
# fn_namn blir kalla som fn(verdi).
funksjon kart_verdiar(o, fn_namn: tekst) -> ordbok {
    la ut: ordbok = {}
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        ut[k[i]] = builtin.ncb_call_fn(fn_namn, o[k[i]])
        i = i + 1
    }
    returner ut
}

# JS: Object.fromEntries(Object.entries(o).filter(...))
# fn_namn blir kalla som fn(nøkkel, verdi) og skal returnere bool.
funksjon filtrer(o, fn_namn: tekst) -> ordbok {
    la ut: ordbok = {}
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        hvis builtin.ncb_call_fn(fn_namn, k[i], o[k[i]]) == sann {
            ut[k[i]] = o[k[i]]
        }
        i = i + 1
    }
    returner ut
}

# JS: Object.entries(o).map(([k, v]) => [v, k]) — snu nøkkel og verdi.
funksjon snu(o) -> ordbok {
    la ut: ordbok = {}
    la k: liste_tekst = builtin.nøkler(o)
    la i: heltall = 0
    mens (i < lengde(k)) {
        ut[tekst(o[k[i]])] = k[i]
        i = i + 1
    }
    returner ut
}
