# prosess.no — Subprosess og OS-kommandoar
# Python: subprocess, os.system, shlex
#
# Prosesskøyring går gjennom `norscode-process-spawn-v1` med eksplisitt
# executable/argv. Shellmetateikn blir avviste, og katalog/miljø/PID brukar
# direkte, versjonerte runtime-bindingar.
#
# Prosess-resultat: liste representert som liste_tekst
#   [returkode_tekst, stdout, stderr]
#   Bruk: res[0]=returkode, res[1]=stdout, res[2]=stderr
#
# Bruk:
#   bruk std.prosess som pros
#   la res = pros.køyr("ls -la")
#   skriv(pros.stdout(res))
#   skriv(pros.returkode(res))

bruk std.sched som sched
bruk std.runtime.process_abi som process_abi

# ─── Prosess-resultat-hjelparar ───────────────────────────────────────────────

funksjon _nytt_resultat(kode: heltall, ut: tekst, feil: tekst) -> liste_tekst {
    la r: liste_tekst = []
    legg_til(r, tekst_fra_heltall(kode))
    legg_til(r, ut)
    legg_til(r, feil)
    returner r
}

funksjon _tekst_inneheld(s: tekst, del: tekst) -> bool {
    returner builtin.index_of(s, del) >= 0
}

funksjon _trim(s: tekst) -> tekst {
    returner builtin.trim(s)
}

funksjon _første_ord(kommando: tekst) -> tekst {
    la rein = _trim(kommando)
    hvis rein == "" { returner "" }
    la deler = builtin.split(rein, " ")
    hvis lengde(deler) == 0 { returner "" }
    returner deler[0]
}

funksjon _har_shell_metategn(kommando: tekst) -> bool {
    hvis _tekst_inneheld(kommando, ";") { returner sann }
    hvis _tekst_inneheld(kommando, "&") { returner sann }
    hvis _tekst_inneheld(kommando, "|") { returner sann }
    hvis _tekst_inneheld(kommando, "`") { returner sann }
    hvis _tekst_inneheld(kommando, "$") { returner sann }
    hvis _tekst_inneheld(kommando, ">") { returner sann }
    hvis _tekst_inneheld(kommando, "<") { returner sann }
    hvis _tekst_inneheld(kommando, "\n") { returner sann }
    hvis _tekst_inneheld(kommando, "\r") { returner sann }
    returner usann
}

funksjon policy_av() -> ordbok_tekst {
    returner {"aktiv": "usann", "tillatne": "", "shell": "av"}
}

funksjon policy_tillat(tillatne: liste_tekst) -> ordbok_tekst {
    la p = policy_av()
    p["aktiv"] = "sann"
    p["tillatne"] = builtin.join(tillatne, ",")
    returner p
}

funksjon policy_status(policy: ordbok_tekst) -> ordbok_tekst {
    la s: ordbok_tekst = {}
    s["aktiv"] = "usann"
    s["shell"] = "av"
    s["tillatne"] = ""
    hvis har_nokkel(policy, "aktiv") { s["aktiv"] = tekst(policy["aktiv"]) }
    hvis har_nokkel(policy, "shell") { s["shell"] = tekst(policy["shell"]) }
    hvis har_nokkel(policy, "tillatne") { s["tillatne"] = tekst(policy["tillatne"]) }
    returner s
}

funksjon policy_tillater(policy: ordbok_tekst, kommando: tekst) -> bool {
    hvis policy_status(policy)["aktiv"] != "sann" { returner usann }
    hvis _har_shell_metategn(kommando) { returner usann }
    la navn = _første_ord(kommando)
    hvis navn == "" { returner usann }
    la tillatne = builtin.split(policy_status(policy)["tillatne"], ",")
    la i: heltall = 0
    mens i < lengde(tillatne) {
        hvis _trim(tillatne[i]) == navn { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon returkode(res: liste_tekst) -> heltall {
    returner builtin.heltall_fra_tekst(res[0])
}
funksjon stdout(res: liste_tekst) -> tekst  {
    returner res[1]
}
funksjon stderr(res: liste_tekst) -> tekst  {
    returner res[2]
}
funksjon er_ok(res: liste_tekst) -> bool  {
    prøv {
        la kode = builtin.heltall_fra_tekst(builtin.trim(tekst(res[0])))
        returner kode >= 0 og kode <= 0
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon _trim(t: tekst) -> tekst {
    returner builtin.trim(t)
}

funksjon _inneheld(t: tekst, del: tekst) -> bool {
    returner builtin.index_of(t, del) >= 0
}

funksjon _kommando_namn(kommando: tekst) -> tekst {
    la delar = split_args(kommando)
    hvis lengde(delar) == 0 { returner "" }
    la sti = delar[0]
    la bitar = builtin.split(sti, "/")
    hvis lengde(bitar) == 0 { returner sti }
    returner bitar[lengde(bitar) - 1]
}

funksjon _trygg_kommando_tekst(kommando: tekst) -> bool {
    hvis _trim(kommando) == "" { returner usann }
    hvis _inneheld(kommando, "\n") eller _inneheld(kommando, "\r") { returner usann }
    hvis _inneheld(kommando, "\u0000") { returner usann }
    returner sann
}

funksjon ny_policy(namn: tekst) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["namn"] = namn
    p["allow_all"] = "usann"
    p["allow_shell"] = "usann"
    p["allowlist"] = "|"
    p["strict_executables"] = "usann"
    p["executable_allowlist"] = "|"
    p["timeout_seconds"] = "30"
    p["max_output_bytes"] = "1048576"
    p["dry_run_default"] = "sann"
    p["audit"] = "sann"
    returner p
}

funksjon tillat(policy: ordbok_tekst, kommando_namn: tekst) -> bool {
    la namn = _trim(kommando_namn)
    hvis namn == "" { returner usann }
    hvis _inneheld(namn, "|") eller _inneheld(namn, "/") { returner usann }
    hvis ikkje _inneheld(policy["allowlist"], "|" + namn + "|") {
        policy["allowlist"] = policy["allowlist"] + namn + "|"
    }
    returner sann
}

# Opt-in for deployment med fullstendige executable-stiar. Ein basename-
# allowlist (t.d. "printf") godkjenner elles også ein ukjend /tmp/printf.
# Streng modus krev eksplisitt allowlist av nøyaktig executable-sti.
funksjon krev_eksakte_programstiar(policy: ordbok_tekst) -> bool {
    policy["strict_executables"] = "sann"
    hvis ikkje finnes_nøkkel(policy, "executable_allowlist") { policy["executable_allowlist"] = "|" }
    returner sann
}

# Same kanoniske, absolutte sti-kontrakt ved registrering og køyring.
# Tomme, relative eller ikkje-normaliserte stiar skal ikkje gi policytreff.
funksjon _gyldig_programsti(sti: tekst) -> bool {
    hvis sti == "" eller ikkje builtin.starts_with(sti, "/") { returner usann }
    hvis _inneheld(sti, "|") eller _inneheld(sti, "\u0000") eller
       _inneheld(sti, "\n") eller _inneheld(sti, "\r") { returner usann }
    hvis lengde(sti) <= 1 eller builtin.ends_with(sti, "/") eller _inneheld(sti, "//") { returner usann }
    la delar = builtin.split(sti, "/")
    la i: heiltall = 0
    mens i < lengde(delar) {
        hvis delar[i] == "." eller delar[i] == ".." { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon tillat_programsti(policy: ordbok_tekst, sti: tekst) -> bool {
    hvis ikkje _gyldig_programsti(sti) { returner usann }
    hvis ikkje finnes_nøkkel(policy, "executable_allowlist") { policy["executable_allowlist"] = "|" }
    hvis ikkje _inneheld(policy["executable_allowlist"], "|" + sti + "|") {
        policy["executable_allowlist"] = policy["executable_allowlist"] + sti + "|"
    }
    returner sann
}

# Policyformatet må ikkje kunne falle tilbake til ein svakare modus
# ved feilskriving eller tap av strict_executables-feltet.
funksjon _gyldig_programsti_policy(policy: ordbok_tekst) -> bool {
    hvis ikkje finnes_nøkkel(policy, "strict_executables") { returner usann }
    returner policy["strict_executables"] == "sann" eller
        policy["strict_executables"] == "usann"
}

funksjon _tillater_programsti(policy: ordbok_tekst, executable: tekst) -> bool {
    hvis ikkje _gyldig_programsti_policy(policy) { returner usann }
    hvis policy["strict_executables"] == "usann" { returner sann }
    hvis ikkje _gyldig_programsti(executable) { returner usann }
    hvis ikkje finnes_nøkkel(policy, "executable_allowlist") { returner usann }
    returner _inneheld(policy["executable_allowlist"], "|" + executable + "|")
}

funksjon tillat_alle(policy: ordbok_tekst) -> bool {
    policy["allow_all"] = "sann"
    returner sann
}

funksjon tillat_shell(policy: ordbok_tekst) -> bool {
    policy["allow_shell"] = "av"
    returner usann
}

funksjon aktiver_køyring(policy: ordbok_tekst) -> bool {
    policy["dry_run_default"] = "usann"
    returner sann
}

funksjon set_timeout(policy: ordbok_tekst, sekund: heltall) -> bool {
    hvis sekund <= 0 { returner usann }
    policy["timeout_seconds"] = tekst_fra_heltall(sekund)
    returner sann
}

funksjon set_maks_output(policy: ordbok_tekst, bytes: heltall) -> bool {
    hvis bytes <= 0 { returner usann }
    policy["max_output_bytes"] = tekst_fra_heltall(bytes)
    returner sann
}

funksjon policy_tillater(policy: ordbok_tekst, kommando: tekst) -> bool {
    # Ein tekstkommando blir slått opp via PATH seinare. I eksakt
    # executable-modus må han ikkje kunne omgå sti-allowlista.
    # Bruk eksplisitt argv-plan som bind absolutt programsti.
    hvis ikkje _gyldig_programsti_policy(policy) { returner usann }
    hvis policy["strict_executables"] == "sann" { returner usann }
    hvis ikkje _trygg_kommando_tekst(kommando) { returner usann }
    la shell = _inneheld(kommando, ";") eller _inneheld(kommando, "|") eller _inneheld(kommando, "&") eller _inneheld(kommando, ">") eller _inneheld(kommando, "<") eller _inneheld(kommando, "$") eller _inneheld(kommando, "`")
    hvis shell { returner usann }
    hvis policy["allow_all"] == "sann" { returner sann }
    la namn = _kommando_namn(kommando)
    hvis namn == "" { returner usann }
    returner _inneheld(policy["allowlist"], "|" + namn + "|")
}

funksjon start_plan(kommando: tekst) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["kommando"] = kommando
    p["kommando_namn"] = _kommando_namn(kommando)
    p["stdin"] = ""
    p["cwd"] = ""
    p["timeout_seconds"] = "30"
    p["max_output_bytes"] = "1048576"
    p["capture_stdout"] = "sann"
    p["capture_stderr"] = "sann"
    p["status"] = "planlagt"
    p["execution_mode"] = "argv_text"
    returner p
}

funksjon start_argv_plan(executable: tekst, args: liste_tekst) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["executable"] = executable
    p["kommando_namn"] = _kommando_namn(executable)
    p["args"] = args
    p["stdin"] = ""
    p["cwd"] = ""
    p["timeout_seconds"] = "30"
    p["max_output_bytes"] = "1048576"
    p["capture_stdout"] = "sann"
    p["capture_stderr"] = "sann"
    p["status"] = "planlagt"
    p["execution_mode"] = "argv"
    p["sandbox"] = "none"
    p["max_memory_bytes"] = "536870912"
    p["max_open_files"] = "64"
    p["inherit_env"] = "1"
    p["environment"] = {}
    returner p
}

funksjon med_sandbox(plan: ordbok_tekst, profile: tekst,
                     max_memory_bytes: heiltall, max_open_files: heiltall,
                     inherit_env: boolsk) -> ordbok_tekst {
    # Ugyldig sandkasse skal aldri degraderast stille til "none".
    # Behald den ugyldige verdien, slik at planvalideringa avviser spawn.
    hvis profile != "none" og profile != "restricted" og profile != "no-network" og profile != "no-write" og profile != "pure" {
        plan["sandbox"] = profile
        returner plan
    }
    hvis max_memory_bytes > 0 { plan["max_memory_bytes"] = tekst_fra_heltall(max_memory_bytes) }
    hvis max_open_files > 2 { plan["max_open_files"] = tekst_fra_heltall(max_open_files) }
    plan["sandbox"] = profile
    hvis inherit_env { plan["inherit_env"] = "1" } ellers { plan["inherit_env"] = "0" }
    returner plan
}

funksjon _trygt_argv_felt(verdi: tekst) -> boolsk {
    returner builtin.index_of(verdi, "\u0000") < 0 og builtin.index_of(verdi, "\n") < 0 og builtin.index_of(verdi, "\r") < 0
}

# Valider ressurstal og sikkerheitsprofil foer heiltallkonvertering.
# Timeout i sekund blir multiplisert med 1000 ved native dispatch;
# maks 2 147 483 sekund held resultatet innanfor signed 32-bit millisekund.
funksjon _gyldige_argv_grenser(plan: ordbok_tekst) -> boolsk {
    hvis ikkje finnes_nøkkel(plan, "timeout_seconds") eller
       ikkje finnes_nøkkel(plan, "max_output_bytes") eller
       ikkje finnes_nøkkel(plan, "max_memory_bytes") eller
       ikkje finnes_nøkkel(plan, "max_open_files") eller
       ikkje finnes_nøkkel(plan, "inherit_env") eller
       ikkje finnes_nøkkel(plan, "sandbox") eller
       ikkje finnes_nøkkel(plan, "cwd") eller
       ikkje finnes_nøkkel(plan, "stdin") eller
       ikkje finnes_nøkkel(plan, "environment") { returner usann }

    hvis ikkje process_abi._kanonisk_heiltal(plan["timeout_seconds"]) eller
       ikkje process_abi._kanonisk_heiltal(plan["max_output_bytes"]) eller
       ikkje process_abi._kanonisk_heiltal(plan["max_memory_bytes"]) eller
       ikkje process_abi._kanonisk_heiltal(plan["max_open_files"]) { returner usann }

    la sekund = heltall_fra_tekst(plan["timeout_seconds"])
    la ut_bytes = heltall_fra_tekst(plan["max_output_bytes"])
    la minne = heltall_fra_tekst(plan["max_memory_bytes"])
    la filer = heltall_fra_tekst(plan["max_open_files"])
    hvis sekund <= 0 eller sekund > 2147483 { returner usann }
    hvis ut_bytes <= 0 eller ut_bytes > 2147483647 { returner usann }
    hvis minne < 0 eller minne > 8589934592 { returner usann }
    hvis filer < 0 eller filer > 4096 { returner usann }
    hvis plan["inherit_env"] != "0" og plan["inherit_env"] != "1" { returner usann }
    hvis ikkje process_abi._gyldig_sandbox(plan["sandbox"]) { returner usann }
    hvis ikkje _trygt_argv_felt(plan["cwd"]) eller ikkje _trygt_argv_felt(plan["stdin"]) { returner usann }
    hvis ikkje process_abi.gyldig_environment(plan["environment"]) { returner usann }
    hvis ikkje finnes_nøkkel(plan, "capture_stdout") eller ikkje finnes_nøkkel(plan, "capture_stderr") { returner usann }
    hvis (plan["capture_stdout"] != "sann" og plan["capture_stdout"] != "usann") eller
       (plan["capture_stderr"] != "sann" og plan["capture_stderr"] != "usann") { returner usann }
    returner sann
}

funksjon valider_argv_plan(policy: ordbok_tekst, plan: ordbok_tekst) -> boolsk {
    hvis ikkje finnes_nøkkel(plan, "execution_mode") eller
       ikkje finnes_nøkkel(plan, "executable") eller
       ikkje finnes_nøkkel(plan, "args") { returner usann }
    hvis plan["execution_mode"] != "argv" eller plan["executable"] == "" { returner usann }
    hvis ikkje _trygt_argv_felt(plan["executable"]) eller ikkje _gyldige_argv_grenser(plan) { returner usann }
    la namn = _kommando_namn(plan["executable"])
    hvis namn == "" { returner usann }
    hvis policy["allow_all"] != "sann" og ikkje _inneheld(policy["allowlist"], "|" + namn + "|") { returner usann }
    hvis ikkje _tillater_programsti(policy, plan["executable"]) { returner usann }
    hvis builtin.type(plan["args"]) != "liste" { returner usann }
    la args = plan["args"]
    la i: heiltall = 0
    mens i < lengde(args) {
        hvis builtin.type(args[i]) != "tekst" eller ikkje _trygt_argv_felt(args[i]) { returner usann }
        i = i + 1
    }
    returner sann
}

funksjon med_cwd(plan: ordbok_tekst, sti: tekst) -> ordbok_tekst {
    plan["cwd"] = sti
    returner plan
}

funksjon med_stdin(plan: ordbok_tekst, stdin: tekst) -> ordbok_tekst {
    plan["stdin"] = stdin
    returner plan
}

funksjon med_miljø(plan: ordbok_tekst, miljø: ordbok_tekst) -> ordbok_tekst {
    plan["environment"] = miljø
    returner plan
}

funksjon med_timeout(plan: ordbok_tekst, sekund: heltall) -> ordbok_tekst {
    hvis sekund > 0 { plan["timeout_seconds"] = tekst_fra_heltall(sekund) }
    returner plan
}

funksjon med_maks_output(plan: ordbok_tekst, bytes: heltall) -> ordbok_tekst {
    hvis bytes > 0 { plan["max_output_bytes"] = tekst_fra_heltall(bytes) }
    returner plan
}

funksjon valider_plan(policy: ordbok_tekst, plan: ordbok_tekst) -> bool {
    # Tekstplanar blir også nytta av dry-run og async-prosessar.
    # Avvis manglande eller ugyldige ressursfelt foer tal-konvertering,
    # slik at dry-run ikkje godkjenner noko native-løypa må avvise.
    hvis ikkje finnes_nøkkel(plan, "kommando") eller
       ikkje finnes_nøkkel(plan, "timeout_seconds") eller
       ikkje finnes_nøkkel(plan, "max_output_bytes") eller
       ikkje finnes_nøkkel(plan, "cwd") eller
       ikkje finnes_nøkkel(plan, "stdin") eller
       ikkje finnes_nøkkel(plan, "capture_stdout") eller
       ikkje finnes_nøkkel(plan, "capture_stderr") { returner usann }
    hvis ikkje _trygt_argv_felt(plan["cwd"]) eller ikkje _trygt_argv_felt(plan["stdin"]) { returner usann }
    hvis (plan["capture_stdout"] != "sann" og plan["capture_stdout"] != "usann") eller
       (plan["capture_stderr"] != "sann" og plan["capture_stderr"] != "usann") { returner usann }
    hvis ikkje policy_tillater(policy, plan["kommando"]) { returner usann }
    hvis ikkje process_abi._kanonisk_heiltal(plan["timeout_seconds"]) eller
       ikkje process_abi._kanonisk_heiltal(plan["max_output_bytes"]) { returner usann }
    la sekund = heltall_fra_tekst(plan["timeout_seconds"])
    la ut_bytes = heltall_fra_tekst(plan["max_output_bytes"])
    hvis sekund <= 0 eller sekund > 2147483 { returner usann }
    hvis ut_bytes <= 0 eller ut_bytes > 2147483647 { returner usann }
    returner sann
}

funksjon tørrkøyr(policy: ordbok_tekst, plan: ordbok_tekst) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    r["kommando"] = plan["kommando"]
    r["kommando_namn"] = plan["kommando_namn"]
    r["allowed"] = "usann"
    hvis policy_tillater(policy, plan["kommando"]) { r["allowed"] = "sann" }
    r["valid"] = "usann"
    hvis valider_plan(policy, plan) { r["valid"] = "sann" }
    r["action"] = "reject"
    hvis r["valid"] == "sann" { r["action"] = "would_start" }
    r["timeout_seconds"] = plan["timeout_seconds"]
    r["max_output_bytes"] = plan["max_output_bytes"]
    r["audit"] = policy["audit"]
    returner r
}

funksjon start_trygt(policy: ordbok_tekst, plan: ordbok_tekst) -> liste_tekst {
    hvis ikkje valider_plan(policy, plan) {
        returner _nytt_resultat(-1, "", "prosess avvist av policy")
    }
    hvis tekst(policy["dry_run_default"]) == "sann" {
        returner _nytt_resultat(0, "dry-run: " + plan["kommando"], "")
    }
    returner køyr(plan["kommando"])
}

funksjon start_argv_trygt(policy: ordbok_tekst, plan: ordbok_tekst) -> liste_tekst {
    hvis ikkje valider_argv_plan(policy, plan) { returner _nytt_resultat(-1, "", "argv-prosess avvist av policy") }
    hvis policy["dry_run_default"] == "sann" {
        returner _nytt_resultat(0, "dry-run argv: " + plan["executable"], "")
    }
    la req = process_abi.request(
        plan["executable"], plan["args"], plan["cwd"], plan["stdin"],
        heltall_fra_tekst(plan["timeout_seconds"]) * 1000,
        heltall_fra_tekst(plan["max_output_bytes"])
    )
    process_abi.sett_sandbox(req, plan["sandbox"], heltall_fra_tekst(plan["max_memory_bytes"]), heltall_fra_tekst(plan["max_open_files"]), plan["inherit_env"] == "1")
    process_abi.sett_environment(req, plan["environment"])
    process_abi.sett_capture(req, plan["capture_stdout"], plan["capture_stderr"])
    hvis ikkje process_abi.gyldig_request(req) { returner _nytt_resultat(-1, "", "ugyldig spawn_argv request") }
    prøv {
        la svar = builtin.process_spawn_argv(req)
        hvis ikkje process_abi.gyldig_resultat(svar) { returner _nytt_resultat(-1, "", "ugyldig spawn_argv resultat") }
        la feil_ut = svar["stderr"]
        // Backend-avslag (t.d. sandkasseprofil utan seccomp) har grunnen i «error»,
        // ikkje i stderr; utan dette fekk kallaren ein stum -1.
        hvis svar["status"] == "feil" og feil_ut == "" {
            hvis finnes_nøkkel(svar, "error_detail") {
                feil_ut = tekst(svar["error_detail"])
            } ellers hvis finnes_nøkkel(svar, "error") {
                feil_ut = tekst(svar["error"])
            }
        }
        returner _nytt_resultat(heltall_fra_tekst(svar["exit_code"]), svar["stdout"], feil_ut)
    } fang (e) {
        returner _nytt_resultat(-1, "", "native spawn_argv-backend manglar: " + tekst(e))
    }
    returner _nytt_resultat(-1, "", "native spawn_argv-backend manglar")
}

funksjon start_argv_async_trygt(policy: ordbok_tekst, plan: ordbok_tekst) -> ordbok_tekst {
    hvis ikkje valider_argv_plan(policy, plan) { returner {"status": "feil", "error": "argv-prosess avvist av policy"} }
    hvis policy["dry_run_default"] == "sann" { returner {"status": "dry-run", "error": "dry-run er aktiv"} }
    la req = process_abi.async_spawn_request(
        plan["executable"], plan["args"], plan["cwd"], plan["stdin"],
        heltall_fra_tekst(plan["timeout_seconds"]) * 1000,
        heltall_fra_tekst(plan["max_output_bytes"])
    )
    process_abi.sett_sandbox(req, plan["sandbox"], heltall_fra_tekst(plan["max_memory_bytes"]), heltall_fra_tekst(plan["max_open_files"]), plan["inherit_env"] == "1")
    process_abi.sett_environment(req, plan["environment"])
    process_abi.sett_capture(req, plan["capture_stdout"], plan["capture_stderr"])
    # Det asynkrone løpet må validere same native request som sync.
    # Avvis lokalt, før sandbox/process-dispatch, dersom ABI eller miljø
    # er ugyldig.
    hvis ikkje process_abi.gyldig_request(req) {
        returner {"status": "feil", "error": "ugyldig async spawn_argv request"}
    }
    prøv {
        la svar = builtin.process_operation(req)
        hvis ikkje process_abi.gyldig_async_resultat(svar) {
            returner {"status": "feil", "error": "ugyldig native async spawn-resultat"}
        }
        returner svar
    } fang (e) {
        returner {"status": "feil", "error": "native async spawn-backend manglar: " + tekst(e)}
    }
    returner {"status": "feil", "error": "native async spawn-backend manglar"}
}

funksjon native_async_poll(handle: ordbok_tekst) -> ordbok_tekst {
    hvis ikkje finnes_nøkkel(handle, "handle") {
        returner {"status": "feil", "error": "ugyldig async poll request"}
    }
    la req = process_abi.async_operation("poll", handle["handle"])
    hvis ikkje process_abi.gyldig_async_operasjon(req) {
        returner {"status": "feil", "error": "ugyldig async poll request"}
    }
    returner builtin.process_operation(req)
}

funksjon native_async_les(handle: ordbok_tekst) -> ordbok_tekst {
    hvis ikkje finnes_nøkkel(handle, "handle") {
        returner {"status": "feil", "error": "ugyldig async read request"}
    }
    la req = process_abi.async_operation("read", handle["handle"])
    hvis ikkje process_abi.gyldig_async_operasjon(req) {
        returner {"status": "feil", "error": "ugyldig async read request"}
    }
    returner builtin.process_operation(req)
}

funksjon native_async_vent(handle: ordbok_tekst, wait_ms: heiltall) -> ordbok_tekst {
    hvis ikkje finnes_nøkkel(handle, "handle") {
        returner {"status": "feil", "error": "ugyldig async wait request"}
    }
    la req = process_abi.async_wait_request(handle["handle"], wait_ms)
    hvis ikkje process_abi.gyldig_async_operasjon(req) {
        returner {"status": "feil", "error": "ugyldig async wait request"}
    }
    returner builtin.process_operation(req)
}

funksjon native_async_signal(handle: ordbok_tekst, signal: heiltall) -> ordbok_tekst {
    hvis ikkje finnes_nøkkel(handle, "handle") {
        returner {"status": "feil", "error": "ugyldig async signal request"}
    }
    la req = process_abi.async_signal_request(handle["handle"], signal)
    hvis ikkje process_abi.gyldig_async_operasjon(req) {
        returner {"status": "feil", "error": "ugyldig async signal request"}
    }
    returner builtin.process_operation(req)
}

funksjon native_async_lukk(handle: ordbok_tekst) -> ordbok_tekst {
    hvis ikkje finnes_nøkkel(handle, "handle") {
        returner {"status": "feil", "error": "ugyldig async close request"}
    }
    la req = process_abi.async_operation("close", handle["handle"])
    hvis ikkje process_abi.gyldig_async_operasjon(req) {
        returner {"status": "feil", "error": "ugyldig async close request"}
    }
    returner builtin.process_operation(req)
}

funksjon vent(res: liste_tekst) -> heltall {
    returner returkode(res)
}

funksjon drep_plan(pid: heltall) -> ordbok_tekst {
    la p: ordbok_tekst = {}
    p["pid"] = tekst_fra_heltall(pid)
    p["action"] = "kill"
    p["requires_policy"] = "sann"
    p["status"] = "planlagt"
    returner p
}

# ─── Levande prosesshandtak gjennom native ABI ───────────────────────────────

funksjon _prosess_oppdater(handle: ordbok_tekst) -> tekst {
    hvis handle["status"] == "ferdig" eller handle["status"] == "signal" eller
       handle["status"] == "timeout" eller handle["status"] == "feil" eller
       handle["status"] == "kansellert" {
        returner handle["status"]
    }
    la svar = native_async_poll(handle)
    hvis finnes_nøkkel(svar, "status") { handle["status"] = tekst(svar["status"]) }
    hvis finnes_nøkkel(svar, "exit_code") { handle["exit_code"] = tekst(svar["exit_code"]) }
    hvis finnes_nøkkel(svar, "pid") { handle["pid"] = tekst(svar["pid"]) }
    hvis finnes_nøkkel(svar, "error") { handle["feil"] = tekst(svar["error"]) }
    hvis handle["status"] == "ventende" {
        handle["status"] = "kjorer"
    }
    returner handle["status"]
}

funksjon start_async_trygt(policy: ordbok_tekst, plan: ordbok_tekst,
                           spool_rot: tekst) -> ordbok_tekst {
    la h: ordbok_tekst = {"status": "feil", "pid": "-1", "exit_code": "-1", "feil": ""}
    hvis ikkje valider_plan(policy, plan) {
        h["feil"] = "prosess avvist av policy"
        returner h
    }
    hvis policy["dry_run_default"] == "sann" {
        h["status"] = "dry-run"
        h["feil"] = "dry-run er aktiv"
        returner h
    }
    hvis _har_shell_metategn(plan["kommando"]) {
        h["feil"] = "async argv-tekst avviser shellmetateikn"
        returner h
    }
    la delar = split_args(plan["kommando"])
    hvis lengde(delar) == 0 {
        h["feil"] = "tom async-kommando"
        returner h
    }
    la executable = _finn_kjorbar(delar[0])
    hvis executable == "" {
        h["feil"] = "kommando ikkje funnen: " + delar[0]
        returner h
    }
    la args: liste_tekst = []
    la i: heiltall = 1
    mens i < lengde(delar) {
        legg_til(args, delar[i])
        i = i + 1
    }
    la argv_plan = start_argv_plan(executable, args)
    argv_plan["cwd"] = plan["cwd"]
    argv_plan["stdin"] = plan["stdin"]
    argv_plan["timeout_seconds"] = plan["timeout_seconds"]
    argv_plan["max_output_bytes"] = plan["max_output_bytes"]
    argv_plan["capture_stdout"] = plan["capture_stdout"]
    argv_plan["capture_stderr"] = plan["capture_stderr"]
    la native = start_argv_async_trygt(policy, argv_plan)
    hvis finnes_nøkkel(native, "error") { native["feil"] = tekst(native["error"]) }
    ellers { native["feil"] = "" }
    hvis ikkje finnes_nøkkel(native, "exit_code") { native["exit_code"] = "-1" }
    hvis ikkje finnes_nøkkel(native, "pid") { native["pid"] = "-1" }
    hvis ikkje finnes_nøkkel(native, "status") {
        native["status"] = "feil"
        native["feil"] = "ugyldig native async-resultat"
    }
    native["timeout_ms"] = tekst_fra_heltall(heltall_fra_tekst(plan["timeout_seconds"]) * 1000)
    native["stdout_buffer"] = ""
    native["stderr_buffer"] = ""
    returner native
}

funksjon async_status(handle: ordbok_tekst) -> tekst { returner _prosess_oppdater(handle) }
funksjon async_pid(handle: ordbok_tekst) -> heltall { returner heltall_fra_tekst(handle["pid"]) }
funksjon async_exit_code(handle: ordbok_tekst) -> heltall {
    _prosess_oppdater(handle)
    hvis handle["exit_code"] == "" eller handle["exit_code"] == "-1" { returner -1 }
    returner heltall_fra_tekst(handle["exit_code"])
}

funksjon _async_les_stream(handle: ordbok_tekst, stream: tekst) -> tekst {
    la nøkkel = stream + "_buffer"
    hvis ikkje finnes_nøkkel(handle, nøkkel) { handle[nøkkel] = "" }
    hvis handle[nøkkel] != "" {
        la bufret = handle[nøkkel]
        handle[nøkkel] = ""
        returner bufret
    }
    la svar = native_async_les(handle)
    hvis finnes_nøkkel(svar, "stdout") og stream != "stdout" {
        handle["stdout_buffer"] = tekst(svar["stdout"])
    }
    hvis finnes_nøkkel(svar, "stderr") og stream != "stderr" {
        handle["stderr_buffer"] = tekst(svar["stderr"])
    }
    hvis finnes_nøkkel(svar, stream) { returner tekst(svar[stream]) }
    returner ""
}

funksjon async_les_stdout(handle: ordbok_tekst) -> tekst { returner _async_les_stream(handle, "stdout") }
funksjon async_les_stderr(handle: ordbok_tekst) -> tekst { returner _async_les_stream(handle, "stderr") }

funksjon async_signal(handle: ordbok_tekst, signal: heltall) -> bool {
    hvis signal != 1 og signal != 2 og signal != 9 og signal != 15 { returner usann }
    hvis _prosess_oppdater(handle) != "kjorer" { returner usann }
    la svar = native_async_signal(handle, signal)
    hvis finnes_nøkkel(svar, "status") { handle["status"] = tekst(svar["status"]) }
    hvis finnes_nøkkel(svar, "exit_code") { handle["exit_code"] = tekst(svar["exit_code"]) }
    hvis handle["status"] == "feil" { returner usann }
    la ferdig = native_async_vent(handle, 5000)
    hvis finnes_nøkkel(ferdig, "status") { handle["status"] = tekst(ferdig["status"]) }
    hvis finnes_nøkkel(ferdig, "exit_code") { handle["exit_code"] = tekst(ferdig["exit_code"]) }
    returner handle["status"] == "signal"
}

funksjon async_timeout_sjekk(handle: ordbok_tekst) -> bool {
    returner _prosess_oppdater(handle) == "timeout"
}

funksjon start_async_med_future(scheduler: ordbok_tekst, policy: ordbok_tekst,
                                plan: ordbok_tekst, spool_rot: tekst) -> ordbok_tekst {
    la handle = start_async_trygt(policy, plan, spool_rot)
    hvis handle["status"] == "feil" eller handle["status"] == "dry-run" {
        la future_id = sched.future_ny(scheduler)
        handle["future_id"] = future_id
        sched.future_avvis(scheduler, future_id, handle["feil"])
        returner handle
    }
    la poll_args: ordbok_tekst = {}
    poll_args["handle"] = handle
    la cleanup_args: ordbok_tekst = {}
    cleanup_args["handle"] = handle
    la timeout_ms = heltall_fra_tekst(handle["timeout_ms"])
    handle["future_id"] = sched.io_registrer_med_cleanup(scheduler, "process", "std.prosess._async_poll_svar", poll_args, timeout_ms, "std.prosess._async_cleanup", cleanup_args)
    returner handle
}

funksjon _async_cleanup(args: ordbok_tekst) -> boolsk {
    la handle = args["handle"]
    la reason = args["cleanup_reason"]
    hvis _prosess_oppdater(handle) != "kjorer" { returner sann }
    hvis ikkje async_signal(handle, 15) { returner usann }
    hvis reason == "timeout" { handle["status"] = "timeout" }
    ellers { handle["status"] = "kansellert" }
    returner sann
}

funksjon async_kanseller_future(scheduler: ordbok_tekst, handle: ordbok_tekst) -> boolsk {
    hvis handle["future_id"] == "" { returner usann }
    returner sched.future_kanseller(scheduler, handle["future_id"])
}

funksjon _async_poll_svar(args: ordbok_tekst) -> ordbok_tekst {
    la handle = args["handle"]
    la svar: ordbok_tekst = {"status": "ventende", "resultat": "", "feil": ""}
    la st = _prosess_oppdater(handle)
    hvis st == "kjorer" { returner svar }
    hvis st == "ferdig" {
        la kode = async_exit_code(handle)
        la output = native_async_les(handle)
        la resultat: ordbok_tekst = {}
        resultat["pid"] = handle["pid"]
        resultat["exit_code"] = tekst_fra_heltall(kode)
        resultat["stdout"] = tekst(output["stdout"])
        resultat["stderr"] = tekst(output["stderr"])
        hvis kode == 0 {
            svar["status"] = "ferdig"
            svar["resultat"] = builtin.json_stringify(resultat)
            returner svar
        }
        svar["status"] = "feil"
        svar["feil"] = "prosess exit " + tekst_fra_heltall(kode) + ": " + resultat["stderr"]
        returner svar
    }
    svar["status"] = "feil"
    svar["feil"] = "prosess avslutta med status " + st
    returner svar
}

funksjon async_poll_future(scheduler: ordbok_tekst, handle: ordbok_tekst) -> tekst {
    la future_id = handle["future_id"]
    hvis future_id == "" { returner "ukjent" }
    hvis ikkje sched.future_er_ferdig(scheduler, future_id) { sched.io_poll(scheduler) }
    returner sched.future_status(scheduler, future_id)
}

funksjon produksjonsstatus() -> ordbok_tekst {
    la s: ordbok_tekst = {}
    s["modul"] = "std.prosess"
    s["status"] = "delvis"
    s["dekning"] = "separate shell/argv-planar, policy, allowlist, dry-run, shell-fri native sync/async, generasjonsbunde PID-handle, scheduler-poll, signal, streaming og eksplisitt sandboxprofil med lukka miljo, rlimits, Linux no_new_privs/seccomp, macOS Seatbelt og forelderhandheva RSS-grense"
    s["mangler"] = "Windows: AppContainer+Job Object startar og køyrer barn på ekte Windows (test_windows_process_appcontainer); manglar test av at AppContainer faktisk nektar nettverk"
    s["sikkerheit"] = "deny-by-default med allowlist, process scope, separat shell-tillatelse, dry-run og attestert sandboxprofil"
    returner s
}

# ─── Køyr kommando ────────────────────────────────────────────────────────────

# Køyr ei enkel kommandolinje som strukturert executable/argv.
funksjon køyr(kommando: tekst) -> liste_tekst {
    hvis _har_shell_metategn(kommando) {
        returner _nytt_resultat(126, "", "shellmetateikn er ikkje tillatne")
    }
    la delar = split_args(kommando)
    hvis lengde(delar) == 0 { returner _nytt_resultat(126, "", "tom kommando") }
    la executable = _finn_kjorbar(delar[0])
    hvis executable == "" { returner _nytt_resultat(127, "", "kommando ikkje funnen: " + delar[0]) }
    la args: liste_tekst = []
    la i: heltall = 1
    mens i < lengde(delar) {
        legg_til(args, delar[i])
        i = i + 1
    }
    la req = process_abi.request(executable, args, "", "", 30000, 1048576)
    prøv {
        la svar = builtin.process_spawn_argv(req)
        returner _nytt_resultat(
            heltall_fra_tekst(tekst(svar["exit_code"])),
            tekst(svar["stdout"]),
            tekst(svar["stderr"]) + tekst(svar["error"])
        )
    } fang (e) {
        returner _nytt_resultat(-1, "", "native spawn_argv-backend manglar: " + tekst(e))
    }
    returner _nytt_resultat(-1, "", "ukjent feil")
}

funksjon køyr_med_policy(kommando: tekst, policy: ordbok_tekst) -> liste_tekst {
    hvis ikkje policy_tillater(policy, kommando) {
        returner _nytt_resultat(126, "", "strukturert prosess blokkert av policy")
    }
    returner køyr(kommando)
}

# Køyr og returner berre stdout som tekst
funksjon køyr_og_hent(kommando: tekst) -> tekst {
    la res = køyr(kommando)
    returner res[1]
}

# Sjekk om ein kommando eksisterer i PATH
funksjon kommando_finnes(namn: tekst) -> bool {
    returner _finn_kjorbar(namn) != ""
}

funksjon finn_kjorbar(namn: tekst) -> tekst {
    returner _finn_kjorbar(namn)
}

# ─── Miljøvariablar ───────────────────────────────────────────────────────────

funksjon miljø_hent(namn: tekst) -> tekst {
    prøv {
        la val: tekst = builtin.miljo_hent(namn)
        returner val
    } fang (e) {
        returner ""
    }
    returner ""
}

funksjon miljø_set(namn: tekst, verdi: tekst) -> bool {
    prøv {
        la res: heltall = builtin.miljo_set(namn, verdi)
        returner res == 0
    } fang (e) {
        returner usann
    }
    returner usann
}

funksjon miljø_slett(namn: tekst) -> bool {
    prøv {
        la res: heltall = builtin.miljo_slett(namn)
        returner res == 0
    } fang (e) {
        returner usann
    }
    returner usann
}

# ─── Prosessinformasjon ───────────────────────────────────────────────────────

funksjon pid() -> heltall {
    prøv { returner builtin.prosess_pid() } fang (e) { returner -1 }
    returner -1
}

funksjon ppid() -> heltall {
    prøv { returner builtin.prosess_ppid() } fang (e) { returner -1 }
    returner -1
}

funksjon arbeids_katalog() -> tekst {
    prøv { returner tekst(builtin.system_info()["cwd"]) } fang (e) { returner "." }
    returner "."
}

funksjon byt_katalog(sti: tekst) -> bool {
    prøv {
        la res: heltall = builtin.chdir(sti)
        returner res == 0
    } fang (e) {
        returner usann
    }
    returner usann
}

# ─── OS-informasjon ───────────────────────────────────────────────────────────

funksjon os_namn() -> tekst {
    prøv { returner tekst(builtin.system_info()["system"]) } fang (e) { returner "ukjent" }
    returner "ukjent"
}

funksjon er_linux() -> bool  {
    returner os_namn() == "Linux"
}
funksjon er_macos() -> bool  {
    returner os_namn() == "Darwin"
}
funksjon er_windows() -> bool {
    returner os_namn() == "Windows"
}

# ─── Argument-splitting (shlex-liknande) ──────────────────────────────────────
# Del ein kommandolinje på mellomrom, respekter enkle anførsels-teikn

funksjon split_args(linje: tekst) -> liste_tekst {
    la teikn = builtin.split(linje, "")
    la n: heltall = lengde(teikn)
    la delar: liste_tekst = []
    la gjeldande: tekst = ""
    la i_sitat: bool = usann
    la i: heltall = 0

    mens (i < n) {
        la c: tekst = teikn[i]
        la k: heltall = builtin.char_code(c)

        hvis (c == "\"" eller c == "'") {
            i_sitat = ikkje i_sitat
        } ellers hvis (k == 32 og ikkje i_sitat) {
            hvis (lengde(builtin.split(gjeldande, "")) > 0) {
                legg_til(delar, gjeldande)
                gjeldande = ""
            }
        } ellers {
            gjeldande = gjeldande + c
        }
        i = i + 1
    }
    hvis (lengde(builtin.split(gjeldande, "")) > 0) {
        legg_til(delar, gjeldande)
    }
    returner delar
}

funksjon _finn_kjorbar(namn: tekst) -> tekst {
    hvis namn == "" eller _har_shell_metategn(namn) { returner "" }
    prøv {
        la svar = builtin.system_operation({
            "abi": "norscode-system-v1",
            "operation": "resolve_executable",
            "name": namn
        })
        hvis svar["status"] == "ok" { returner tekst(svar["path"]) }
    } fang (e) {
        # Eldre stage0: eksplisitte stiar kan framleis sendast fail-closed til execv.
        hvis _inneheld(namn, "/") eller _inneheld(namn, "\\") { returner namn }
    }
    returner ""
}

# ─── Støttesjekk ──────────────────────────────────────────────────────────────

funksjon er_støtta() -> bool {
    prøv { returner builtin.system_info()["status"] == "ok" } fang (e) { returner usann }
    returner usann
}
