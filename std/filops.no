# filops.no — Norscode-eigde høgnivå filoperasjonar
#
# Alle operasjonar går gjennom Norscode-filsystemet og den versjonerte
# filesystem-ABI-en. Modulen startar aldri shell eller eksterne verktøy.

bruk std.runtime_filesystem som native_fs

funksjon _basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    la i = lengde(delar) - 1
    mens i >= 0 {
        hvis delar[i] != "" { returner delar[i] }
        i = i - 1
    }
    returner ""
}

funksjon _dirname(sti: tekst) -> tekst {
    la teikn = builtin.split(sti, "")
    la sist = -1
    la i = 0
    mens i < lengde(teikn) {
        hvis teikn[i] == "/" { sist = i }
        i = i + 1
    }
    hvis sist < 0 { returner "." }
    hvis sist == 0 { returner "/" }
    returner builtin.join(builtin.slice(teikn, 0, sist), "")
}

funksjon _sti(rot: tekst, namn: tekst) -> tekst {
    hvis rot == "/" { returner "/" + namn }
    hvis rot == "." { returner namn }
    hvis builtin.ends_with(rot, "/") { returner rot + namn }
    returner rot + "/" + namn
}

funksjon fil_finnes(sti: tekst) -> bool {
    prøv { returner builtin.fil_finnes(sti) og ikkje katalog_finnes(sti) }
    fang (e) { returner usann }
    returner usann
}

funksjon katalog_finnes(sti: tekst) -> bool {
    hvis sti == "" { returner usann }
    prøv {
        la delar = native_fs.native_sti_rot_relativ(sti)
        returner native_fs.native_list(tekst(delar["root"]), tekst(delar["relative"]))["status"] == "ok"
    }
    fang (e) { returner usann }
    returner usann
}

funksjon fil_storleik(sti: tekst) -> heltall {
    prøv {
        la stat = native_fs.native_stat_sti(sti)
        hvis stat["status"] == "ok" { returner heltall_fra_tekst(stat["value"]) }
        returner lengde(builtin.fil_les_binær(sti))
    } fang (e) { returner -1 }
    returner -1
}

funksjon kopier(kjelde: tekst, mål: tekst) -> bool {
    hvis ikkje fil_finnes(kjelde) eller kjelde == mål { returner usann }
    prøv {
        builtin.fil_skriv_binær(mål, builtin.fil_les_binær(kjelde))
        returner sann
    } fang (e) {
        prøv { builtin.fil_slett(mål) } fang (e2) {}
        returner usann
    }
    returner usann
}

funksjon kopier2(kjelde: tekst, mål: tekst) -> bool {
    hvis ikkje kopier(kjelde, mål) { returner usann }
    prøv {
        la stat = native_fs.native_stat_sti(kjelde)
        hvis stat["status"] == "ok" {
            native_fs.native_sett_modus_sti(mål, heltall_fra_tekst(stat["mode"]) & 511)
        }
    } fang (e) {}
    returner sann
}

funksjon kopier_tre(kjelde: tekst, mål: tekst) -> bool {
    hvis ikkje katalog_finnes(kjelde) eller kjelde == mål { returner usann }
    hvis ikkje lag_katalogar(mål) { returner usann }
    la barn = lista_katalog(kjelde)
    la i = 0
    mens i < lengde(barn) {
        la kjelde_sti = _sti(kjelde, barn[i])
        la mål_sti = _sti(mål, barn[i])
        hvis katalog_finnes(kjelde_sti) {
            la tre_ok = kopier_tre(kjelde_sti, mål_sti)
            hvis ikkje tre_ok { returner usann }
        } ellers {
            hvis ikkje kopier2(kjelde_sti, mål_sti) { returner usann }
        }
        i = i + 1
    }
    returner sann
}

funksjon flytt(kjelde: tekst, mål: tekst) -> bool {
    hvis katalog_finnes(kjelde) {
        hvis ikkje kopier_tre(kjelde, mål) { returner usann }
        hvis ikkje slett_tre(kjelde) {
            slett_tre(mål)
            returner usann
        }
        returner sann
    }
    hvis ikkje kopier(kjelde, mål) { returner usann }
    hvis ikkje slett_fil(kjelde) {
        slett_fil(mål)
        returner usann
    }
    returner sann
}

funksjon omdøyp(gammal: tekst, ny: tekst) -> bool { returner flytt(gammal, ny) }

funksjon slett_fil(sti: tekst) -> bool {
    hvis katalog_finnes(sti) { returner usann }
    la delar = native_fs.native_sti_rot_relativ(sti)
    la rot = tekst(delar["root"])
    la relativ = tekst(delar["relative"])
    la sletta = native_fs.native_slett(rot, relativ)
    // native_slett (unlink via native-FS-ABI) feilar i tolkaren til enkelte stage0-
    // seedar når rota er "." (relativ cwd) — committed Linux-seed → status=feil — medan
    // builtin.fil_slett fjernar fila uansett. Fall tilbake på builtin når native ikkje sletta.
    hvis sletta["status"] != "deleted" og builtin.fil_finnes(sti) {
        prøv { builtin.fil_slett(sti) } fang (e) { }
    }
    returner ikkje builtin.fil_finnes(sti)
}

funksjon slett_tre(sti: tekst) -> bool {
    hvis sti == "" eller sti == "/" eller sti == "." { returner usann }
    hvis ikkje builtin.fil_finnes(sti) { returner slett_fil(sti) }
    hvis ikkje katalog_finnes(sti) { returner slett_fil(sti) }
    la barn = lista_katalog(sti)
    la i = 0
    mens i < lengde(barn) {
        hvis ikkje slett_tre(_sti(sti, barn[i])) { returner usann }
        i = i + 1
    }
    la delar = native_fs.native_sti_rot_relativ(sti)
    la rot = tekst(delar["root"])
    la relativ = tekst(delar["relative"])
    la sletta = native_fs.native_slett_mappe(rot, relativ)
    // native_slett_mappe (rmdir via native-FS-ABI) manglar i tolkaren til enkelte
    // stage0-seedar (committed Linux-seed → status=feil), medan builtin.fil_slett
    // fjernar ein no TOM katalog. Fall tilbake på builtin når native rmdir ikkje sletta.
    hvis sletta["status"] != "deleted" og builtin.fil_finnes(sti) {
        prøv { builtin.fil_slett(sti) } fang (e) { }
    }
    returner ikkje builtin.fil_finnes(sti)
}

funksjon lag_katalog(sti: tekst) -> bool { returner lag_katalogar(sti) }

funksjon lag_katalogar(sti: tekst) -> bool {
    hvis sti == "" { returner usann }
    prøv {
        builtin.mkdir_p(sti)
        returner katalog_finnes(sti)
    } fang (e) { returner usann }
    returner usann
}

funksjon lista_katalog(sti: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    prøv {
        la listing = native_fs.native_list(sti, "")
        hvis listing["status"] != "ok" { returner ut }
        la linjer = builtin.split(listing["data"], builtin.chr(10))
        la i = 0
        mens i < lengde(linjer) {
            la namn = builtin.trim(linjer[i])
            hvis namn != "" { legg_til(ut, namn) }
            i = i + 1
        }
    } fang (e) {}
    returner ut
}

# Diskkapasitet krev ein eigen statvfs/GetDiskFreeSpaceEx ABI. Returner ein
# tydeleg utilgjengeleg nulltrippel fram til den ABI-en er attestert.
funksjon disk_bruk(sti: tekst) -> liste_heltall { returner [0, 0, 0] }

funksjon filnamn(sti: tekst) -> tekst { returner _basename(sti) }
funksjon katalog(sti: tekst) -> tekst { returner _dirname(sti) }

funksjon ending(namn: tekst) -> tekst {
    la delar = builtin.split(_basename(namn), ".")
    hvis lengde(delar) <= 1 { returner "" }
    returner delar[lengde(delar) - 1]
}

funksjon join_sti(delar: liste_tekst) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(delar) {
        hvis delar[i] != "" {
            hvis ut != "" og ikkje builtin.ends_with(ut, "/") { ut = ut + "/" }
            ut = ut + delar[i]
        }
        i = i + 1
    }
    returner ut
}

funksjon midlertidig_fil(prefiks: tekst) -> tekst {
    hvis prefiks == "" eller builtin.index_of(prefiks, "/") >= 0 eller
       builtin.index_of(prefiks, builtin.chr(92)) >= 0 eller builtin.index_of(prefiks, "..") >= 0 {
        returner ""
    }
    la rot = ".norscode/tmp"
    hvis ikkje lag_katalogar(rot) { returner "" }
    la i = 0
    mens i < 32 {
        la sti = rot + "/" + prefiks + builtin.random_hex(12)
        hvis ikkje builtin.fil_finnes(sti) {
            prøv {
                builtin.fil_skriv(sti, "")
                returner sti
            } fang (e) {}
        }
        i = i + 1
    }
    returner ""
}

funksjon er_støtta() -> bool { returner katalog_finnes(".") }

funksjon _glob_samsvar_segment(mønster: tekst, namn: tekst) -> bool {
    hvis mønster == "*" { returner sann }
    hvis builtin.starts_with(mønster, "*") og
       builtin.index_of(builtin.slice(mønster, 1, lengde(mønster)), "*") < 0 og
       builtin.index_of(mønster, "?") < 0 {
        returner builtin.ends_with(namn, builtin.slice(mønster, 1, lengde(mønster)))
    }
    la mp = builtin.split(mønster, "")
    la np = builtin.split(namn, "")
    la prev: liste_heltall = []
    la k = 0
    mens k <= lengde(np) { legg_til(prev, 0) k = k + 1 }
    prev[0] = 1
    la mi = 1
    mens mi <= lengde(mp) {
        la gjeld: liste_heltall = []
        k = 0
        mens k <= lengde(np) { legg_til(gjeld, 0) k = k + 1 }
        hvis mp[mi - 1] == "*" {
            gjeld[0] = prev[0]
            la ni = 1
            mens ni <= lengde(np) {
                gjeld[ni] = gjeld[ni - 1] eller prev[ni]
                ni = ni + 1
            }
        } ellers hvis mp[mi - 1] == "?" {
            la ni = 1
            mens ni <= lengde(np) {
                gjeld[ni] = prev[ni - 1]
                ni = ni + 1
            }
        } ellers {
            la ni = 1
            mens ni <= lengde(np) {
                gjeld[ni] = prev[ni - 1] og mp[mi - 1] == np[ni - 1]
                ni = ni + 1
            }
        }
        prev = gjeld
        mi = mi + 1
    }
    returner prev[lengde(np)] == 1
}

funksjon _glob_del_sti(mønster: tekst) -> liste_tekst { returner builtin.split(mønster, "/") }

funksjon glob(mønster: tekst) -> liste_tekst {
    la rot = _dirname(mønster)
    la namn_mønster = _basename(mønster)
    la namn = lista_katalog(rot)
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(namn) {
        hvis _glob_samsvar_segment(namn_mønster, namn[i]) { legg_til(ut, _sti(rot, namn[i])) }
        i = i + 1
    }
    returner ut
}

funksjon _walk_fyll(rot: tekst, mønster: tekst, berre_katalog: bool, resultat) -> heltall {
    la barn = lista_katalog(rot)
    la i = 0
    mens i < lengde(barn) {
        la sti = _sti(rot, barn[i])
        hvis katalog_finnes(sti) {
            hvis berre_katalog og _glob_samsvar_segment(mønster, barn[i]) { legg_til(resultat, sti) }
            _walk_fyll(sti, mønster, berre_katalog, resultat)
        } ellers hvis ikkje berre_katalog og _glob_samsvar_segment(mønster, barn[i]) {
            legg_til(resultat, sti)
        }
        i = i + 1
    }
    returner 0
}

funksjon glob_rekursiv(rotkatalog: tekst, mønster: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    hvis ikkje katalog_finnes(rotkatalog) { returner ut }
    la kø: liste_tekst = [rotkatalog]
    la qi = 0
    mens qi < lengde(kø) {
        la rot = kø[qi]
        la barn = lista_katalog(rot)
        la i = 0
        mens i < lengde(barn) {
            la sti = _sti(rot, barn[i])
            hvis katalog_finnes(sti) {
                legg_til(kø, sti)
            } ellers hvis _glob_samsvar_segment(mønster, barn[i]) {
                legg_til(ut, sti)
            }
            i = i + 1
        }
        qi = qi + 1
    }
    returner ut
}

funksjon walk(rotkatalog: tekst) -> liste_tekst { returner glob_rekursiv(rotkatalog, "*") }

funksjon walk_med_ignore(rotkatalog: tekst, ignorar: liste_tekst) -> liste_tekst {
    la alle = walk(rotkatalog)
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(alle) {
        la ignorert = usann
        la j = 0
        mens j < lengde(ignorar) {
            hvis builtin.index_of(alle[i], ignorar[j]) >= 0 { ignorert = sann }
            j = j + 1
        }
        hvis ikkje ignorert { legg_til(ut, alle[i]) }
        i = i + 1
    }
    returner ut
}

funksjon list_katalogar_rekursivt(rotkatalog: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    hvis ikkje katalog_finnes(rotkatalog) { returner ut }
    legg_til(ut, rotkatalog)
    la qi = 0
    mens qi < lengde(ut) {
        la barn = lista_katalog(ut[qi])
        la i = 0
        mens i < lengde(barn) {
            la sti = _sti(ut[qi], barn[i])
            hvis katalog_finnes(sti) { legg_til(ut, sti) }
            i = i + 1
        }
        qi = qi + 1
    }
    returner ut
}

funksjon normaliser_sti(sti: tekst) -> tekst {
    la absolutt = builtin.starts_with(sti, "/")
    la rå = builtin.split(builtin.replace(sti, builtin.chr(92), "/"), "/")
    la delar: liste_tekst = []
    la i = 0
    mens i < lengde(rå) {
        hvis rå[i] == "" eller rå[i] == "." {
        } ellers hvis rå[i] == ".." {
            hvis lengde(delar) > 0 og delar[lengde(delar) - 1] != ".." {
                delar = builtin.slice(delar, 0, lengde(delar) - 1)
            } ellers hvis ikkje absolutt { legg_til(delar, "..") }
        } ellers { legg_til(delar, rå[i]) }
        i = i + 1
    }
    la ut = builtin.join(delar, "/")
    hvis absolutt { returner "/" + ut }
    hvis ut == "" { returner "." }
    returner ut
}

funksjon absolutt_sti(relativ: tekst) -> tekst {
    hvis ikkje er_relativ_sti(relativ) { returner normaliser_sti(relativ) }
    la cwd = "."
    prøv {
        la verdi = builtin.miljo_hent("PWD")
        hvis verdi != "" { cwd = verdi }
    } fang (e) {}
    returner normaliser_sti(cwd + "/" + relativ)
}

funksjon relativ_sti(base: tekst, mål: tekst) -> tekst {
    la bd = builtin.split(absolutt_sti(base), "/")
    la md = builtin.split(absolutt_sti(mål), "/")
    la felles = 0
    mens felles < lengde(bd) og felles < lengde(md) og bd[felles] == md[felles] {
        felles = felles + 1
    }
    la ut: liste_tekst = []
    la i = felles
    mens i < lengde(bd) {
        hvis bd[i] != "" { legg_til(ut, "..") }
        i = i + 1
    }
    i = felles
    mens i < lengde(md) {
        hvis md[i] != "" { legg_til(ut, md[i]) }
        i = i + 1
    }
    hvis lengde(ut) == 0 { returner "." }
    returner builtin.join(ut, "/")
}

funksjon er_relativ_sti(sti: tekst) -> bool {
    returner sti == "" eller (ikkje builtin.starts_with(sti, "/") og
        ikkje (lengde(sti) >= 2 og builtin.slice(sti, 1, 2) == ":"))
}

funksjon heimekatalog() -> tekst {
    prøv {
        la heim = builtin.miljo_hent("HOME")
        hvis heim != "" { returner heim }
        heim = builtin.miljo_hent("USERPROFILE")
        hvis heim != "" { returner heim }
    } fang (e) {}
    returner ""
}

funksjon utvid_brukar(sti: tekst) -> tekst {
    hvis sti == "~" { returner heimekatalog() }
    hvis builtin.starts_with(sti, "~/") { returner heimekatalog() + builtin.slice(sti, 1, lengde(sti)) }
    returner sti
}

funksjon _trim(s: tekst) -> tekst { returner builtin.trim(s) }

funksjon tekst_inneholder(høy: tekst, nål: tekst) -> bool {
    returner builtin.index_of(høy, nål) >= 0
}
