# ftplib.no — prosessfri FTP-klient over Norscode native socket-ABI
#
# Kontrollkanalen er persistent. Listing, nedlasting og opplasting brukar EPSV
# eller PASV og ei separat native datakanal. Ingen curl- eller shellreserveveg.

bruk std.socket som sok
bruk std.bytes som bytes
bruk std.struct som bin

funksjon _inneheld(s: tekst, nål: tekst) -> bool { returner builtin.index_of(s, nål) >= 0 }
funksjon _starter_med(s: tekst, prefiks: tekst) -> bool { returner builtin.starts_with(s, prefiks) }
funksjon _trim(s: tekst) -> tekst { returner builtin.trim(s) }

funksjon _har_kontrollteikn(verdi: tekst) -> bool {
    returner _inneheld(verdi, "\n") eller _inneheld(verdi, "\r") eller _inneheld(verdi, "\t")
}

funksjon _trygg_felt(verdi: tekst) -> bool {
    returner verdi != "" og ikkje _har_kontrollteikn(verdi) og ikkje _inneheld(verdi, "`")
}

funksjon _trygg_sti(sti: tekst) -> bool {
    returner _trygg_felt(sti) og ikkje _inneheld(sti, "..")
}

funksjon _trygg_lokal_sti(sti: tekst) -> bool {
    returner _trygg_felt(sti) og sti != "/" og sti != "."
}

funksjon _vent(h: ordbok_tekst, events: heiltall) -> bool {
    returner sok.native_poll_vent(h, events, 5000)["status"] == "klar"
}

funksjon _skriv(h: ordbok_tekst, data: tekst) -> bool {
    la offset = 0
    mens offset < lengde(data) {
        la r = sok.native_skriv(h, builtin.slice(data, offset, lengde(data)))
        hvis r["status"] == "ventende" {
            hvis ikkje _vent(h, 2) { returner usann }
        } ellers hvis r["status"] != "ok" {
            returner usann
        } ellers {
            la n = heltall_fra_tekst(tekst(r["value"]))
            hvis n <= 0 { returner usann }
            offset = offset + n
        }
    }
    returner sann
}

funksjon _svar_ferdig(data: tekst) -> bool {
    la linjer = builtin.split(data, "\n")
    hvis lengde(linjer) == 0 { returner usann }
    la første = _trim(linjer[0])
    hvis lengde(første) < 3 { returner usann }
    la kode = builtin.slice(første, 0, 3)
    hvis lengde(første) >= 4 og builtin.slice(første, 3, 4) == "-" {
        la i = 1
        mens i < lengde(linjer) {
            la linje = _trim(linjer[i])
            hvis builtin.starts_with(linje, kode + " ") { returner sann }
            i = i + 1
        }
        returner usann
    }
    returner lengde(første) >= 4
}

funksjon _les_svar(h: ordbok_tekst) -> tekst {
    la ut = ""
    la rundar = 0
    mens rundar < 64 og lengde(ut) < 65536 {
        la r = sok.native_les(h, 4096)
        hvis r["status"] == "ventende" {
            hvis ikkje _vent(h, 1) { returner "" }
        } ellers hvis r["status"] != "ok" {
            returner ""
        } ellers {
            la del = tekst(r["data"])
            hvis del == "" { returner ut }
            ut = ut + del
            hvis _svar_ferdig(ut) { returner ut }
            rundar = rundar + 1
        }
    }
    returner ut
}

funksjon _kode(svar: tekst) -> heltall {
    la s = _trim(svar)
    hvis lengde(s) < 3 { returner -1 }
    prøv { returner heltall_fra_tekst(builtin.slice(s, 0, 3)) }
    fang (e) { returner -1 }
    returner -1
}

funksjon _kommando(f: ordbok_tekst, kommando: tekst) -> tekst {
    hvis f["tilkopla"] != "sann" eller _har_kontrollteikn(kommando) { returner "" }
    hvis ikkje _skriv(f["kontroll"], kommando + "\r\n") { returner "" }
    returner _les_svar(f["kontroll"])
}

funksjon connect(vert: tekst, port: heltall) -> ordbok_tekst {
    la f: ordbok_tekst = {
        "vert": vert, "port": tekst_fra_heltall(port), "brukar": "anonymous",
        "passord": "anonymous@", "passiv": "sann", "tilkopla": "usann",
        "gjeldande_katalog": "/", "feil": ""
    }
    hvis ikkje _trygg_felt(vert) eller port <= 0 eller port > 65535 { returner f }
    la h = sok.native_tilkoble(vert, port)
    hvis h["status"] == "ventende" eller h["status"] == "connecting" {
        hvis ikkje _vent(h, 2) { sok.native_lukk(h) returner f }
    } ellers hvis h["status"] == "feil" { returner f }
    la helsing = _les_svar(h)
    hvis _kode(helsing) != 220 {
        sok.native_lukk(h)
        f["feil"] = "FTP-helsing manglar"
        returner f
    }
    f["kontroll"] = h
    f["tilkopla"] = "sann"
    returner f
}

funksjon connect_standard(vert: tekst) -> ordbok_tekst { returner connect(vert, 21) }

funksjon login(f: ordbok_tekst, brukar: tekst, passord: tekst) -> bool {
    hvis ikkje _trygg_felt(brukar) eller ikkje _trygg_felt(passord) eller f["tilkopla"] != "sann" {
        returner usann
    }
    la svar = _kommando(f, "USER " + brukar)
    la kode = _kode(svar)
    hvis kode == 331 { svar = _kommando(f, "PASS " + passord) kode = _kode(svar) }
    hvis kode != 230 { returner usann }
    f["brukar"] = brukar
    f["passord"] = passord
    returner sann
}

funksjon quit(f: ordbok_tekst) {
    hvis f["tilkopla"] == "sann" {
        _kommando(f, "QUIT")
        sok.native_lukk(f["kontroll"])
    }
    f["tilkopla"] = "usann"
}

funksjon _epsv_port(svar: tekst) -> heltall {
    la start = builtin.index_of(svar, "(|||")
    hvis start < 0 { returner -1 }
    la rest = builtin.slice(svar, start + 4, lengde(svar))
    la slutt = builtin.index_of(rest, "|)")
    hvis slutt < 0 { returner -1 }
    prøv { returner heltall_fra_tekst(builtin.slice(rest, 0, slutt)) }
    fang (e) { returner -1 }
    returner -1
}

funksjon _pasv_endpoint(svar: tekst, standard_vert: tekst) -> ordbok_tekst {
    la port = _epsv_port(svar)
    hvis port > 0 { returner {"vert": standard_vert, "port": tekst_fra_heltall(port)} }
    la a = builtin.index_of(svar, "(")
    la b = builtin.index_of(svar, ")")
    hvis a < 0 eller b <= a { returner {"vert": "", "port": "-1"} }
    la delar = builtin.split(builtin.slice(svar, a + 1, b), ",")
    hvis lengde(delar) != 6 { returner {"vert": "", "port": "-1"} }
    prøv {
        la p1 = heltall_fra_tekst(_trim(delar[4]))
        la p2 = heltall_fra_tekst(_trim(delar[5]))
        returner {
            "vert": _trim(delar[0]) + "." + _trim(delar[1]) + "." + _trim(delar[2]) + "." + _trim(delar[3]),
            "port": tekst_fra_heltall(p1 * 256 + p2)
        }
    } fang (e) { returner {"vert": "", "port": "-1"} }
    returner {"vert": "", "port": "-1"}
}

funksjon _data_tilkoble(f: ordbok_tekst) -> ordbok_tekst {
    hvis f["passiv"] != "sann" { returner {"status": "feil", "error": "aktiv FTP er ikkje støtta"} }
    la svar = _kommando(f, "EPSV")
    la ep = _pasv_endpoint(svar, f["vert"])
    hvis heltall_fra_tekst(ep["port"]) <= 0 {
        svar = _kommando(f, "PASV")
        ep = _pasv_endpoint(svar, f["vert"])
    }
    la port = heltall_fra_tekst(ep["port"])
    hvis ep["vert"] == "" eller port <= 0 { returner {"status": "feil", "error": "passiv endpoint manglar"} }
    la h = sok.native_tilkoble(ep["vert"], port)
    hvis h["status"] == "ventende" eller h["status"] == "connecting" {
        hvis ikkje _vent(h, 2) { sok.native_lukk(h) returner {"status": "feil", "error": "data-timeout"} }
    }
    returner h
}

funksjon _les_data_tekst(h: ordbok_tekst) -> tekst {
    la ut = ""
    la rundar = 0
    mens rundar < 1024 og lengde(ut) < 16777216 {
        la r = sok.native_les(h, 16384)
        hvis r["status"] == "ventende" {
            hvis ikkje _vent(h, 1) { rundar = 1024 }
        } ellers hvis r["status"] != "ok" eller tekst(r["data"]) == "" {
            rundar = 1024
        } ellers {
            ut = ut + tekst(r["data"])
            rundar = rundar + 1
        }
    }
    returner ut
}

funksjon _data_kommando(f: ordbok_tekst, kommando: tekst) -> ordbok_tekst {
    la data = _data_tilkoble(f)
    hvis data["status"] == "feil" { returner data }
    la svar = _kommando(f, kommando)
    la kode = _kode(svar)
    hvis kode != 125 og kode != 150 {
        sok.native_lukk(data)
        returner {"status": "feil", "error": "FTP avviste dataoverføring"}
    }
    data["status"] = "ok"
    returner data
}

funksjon nlst(f: ordbok_tekst, katalog: tekst) -> liste_tekst {
    hvis ikkje _trygg_sti(katalog) { returner [] }
    la h = _data_kommando(f, "NLST " + katalog)
    hvis h["status"] != "ok" { returner [] }
    la data = _les_data_tekst(h)
    sok.native_lukk(h)
    la slutt = _les_svar(f["kontroll"])
    hvis _kode(slutt) != 226 og _kode(slutt) != 250 { returner [] }
    la linjer = builtin.split(data, "\n")
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(linjer) {
        la linje = _trim(linjer[i])
        hvis linje != "" { legg_til(ut, linje) }
        i = i + 1
    }
    returner ut
}

funksjon dir(f: ordbok_tekst, katalog: tekst) -> liste_tekst {
    hvis ikkje _trygg_sti(katalog) { returner [] }
    la h = _data_kommando(f, "LIST " + katalog)
    hvis h["status"] != "ok" { returner [] }
    la data = _les_data_tekst(h)
    sok.native_lukk(h)
    la slutt = _les_svar(f["kontroll"])
    hvis _kode(slutt) != 226 og _kode(slutt) != 250 { returner [] }
    la linjer = builtin.split(data, "\n")
    la ut: liste_tekst = []
    la i = 0
    mens i < lengde(linjer) {
        la linje = _trim(linjer[i])
        hvis linje != "" { legg_til(ut, linje) }
        i = i + 1
    }
    returner ut
}

funksjon retrbinary(f: ordbok_tekst, fjern_fil: tekst, lokal_sti: tekst) -> bool {
    hvis ikkje _trygg_sti(fjern_fil) eller ikkje _trygg_lokal_sti(lokal_sti) { returner usann }
    hvis _kode(_kommando(f, "TYPE I")) != 200 { returner usann }
    la h = _data_kommando(f, "RETR " + fjern_fil)
    hvis h["status"] != "ok" { returner usann }
    builtin.fil_skriv_binær(lokal_sti, bytes.tom())
    la ok = sann
    la ferdig = usann
    mens ikkje ferdig {
        la r = sok.native_les_hex(h, 65536)
        hvis r["status"] == "ventende" {
            hvis ikkje _vent(h, 1) { ok = usann ferdig = sann }
        } ellers hvis r["status"] != "ok" {
            ferdig = sann
        } ellers hvis r["data_hex"] == "" {
            ferdig = sann
        } ellers {
            builtin.fil_append_binary(lokal_sti, bytes.fra_liste(bin.hex_til_bytes(r["data_hex"])))
        }
    }
    sok.native_lukk(h)
    la slutt = _kode(_les_svar(f["kontroll"]))
    returner ok og (slutt == 226 eller slutt == 250)
}

funksjon retrlines(f: ordbok_tekst, fjern_fil: tekst) -> tekst {
    hvis ikkje _trygg_sti(fjern_fil) { returner "" }
    la h = _data_kommando(f, "RETR " + fjern_fil)
    hvis h["status"] != "ok" { returner "" }
    la data = _les_data_tekst(h)
    sok.native_lukk(h)
    la slutt = _kode(_les_svar(f["kontroll"]))
    hvis slutt != 226 og slutt != 250 { returner "" }
    returner data
}

funksjon storbinary(f: ordbok_tekst, lokal_sti: tekst, fjern_fil: tekst) -> bool {
    hvis ikkje _trygg_lokal_sti(lokal_sti) eller ikkje _trygg_sti(fjern_fil) eller
       ikkje builtin.fil_finnes(lokal_sti) { returner usann }
    hvis _kode(_kommando(f, "TYPE I")) != 200 { returner usann }
    la h = _data_kommando(f, "STOR " + fjern_fil)
    hvis h["status"] != "ok" { returner usann }
    la data = bytes.til_liste(builtin.fil_les_binær(lokal_sti))
    la pos = 0
    la ok = sann
    mens pos < lengde(data) og ok {
        la slutt = pos + 32768
        hvis slutt > lengde(data) { slutt = lengde(data) }
        la r = sok.native_skriv_hex(h, bin.bytes_til_hex(builtin.slice(data, pos, slutt)))
        hvis r["status"] == "ventende" {
            hvis ikkje _vent(h, 2) { ok = usann }
        } ellers hvis r["status"] != "ok" { ok = usann }
        ellers { pos = slutt }
    }
    sok.native_lukk(h)
    la kode = _kode(_les_svar(f["kontroll"]))
    returner ok og (kode == 226 eller kode == 250)
}

funksjon cwd(f: ordbok_tekst, katalog: tekst) -> bool {
    hvis ikkje _trygg_sti(katalog) { returner usann }
    hvis _kode(_kommando(f, "CWD " + katalog)) != 250 { returner usann }
    f["gjeldande_katalog"] = katalog
    returner sann
}

funksjon _sitert_257(svar: tekst) -> tekst {
    la a = builtin.index_of(svar, "\"")
    hvis a < 0 { returner "" }
    la rest = builtin.slice(svar, a + 1, lengde(svar))
    la b = builtin.index_of(rest, "\"")
    hvis b < 0 { returner "" }
    returner builtin.slice(rest, 0, b)
}

funksjon pwd(f: ordbok_tekst) -> tekst {
    la svar = _kommando(f, "PWD")
    hvis _kode(svar) == 257 {
        la sti = _sitert_257(svar)
        hvis sti != "" { f["gjeldande_katalog"] = sti returner sti }
    }
    returner ""
}

funksjon mkd(f: ordbok_tekst, katalog: tekst) -> bool {
    returner _trygg_sti(katalog) og _kode(_kommando(f, "MKD " + katalog)) == 257
}

funksjon delete(f: ordbok_tekst, fjern_fil: tekst) -> bool {
    returner _trygg_sti(fjern_fil) og _kode(_kommando(f, "DELE " + fjern_fil)) == 250
}

funksjon size(f: ordbok_tekst, fjern_fil: tekst) -> heltall {
    hvis ikkje _trygg_sti(fjern_fil) { returner -1 }
    la svar = _kommando(f, "SIZE " + fjern_fil)
    hvis _kode(svar) != 213 { returner -1 }
    la linje = _trim(svar)
    prøv { returner heltall_fra_tekst(_trim(builtin.slice(linje, 3, lengde(linje)))) }
    fang (e) { returner -1 }
    returner -1
}

funksjon set_pasv(f: ordbok_tekst, aktiv: bool) {
    hvis aktiv { f["passiv"] = "sann" } ellers { f["passiv"] = "usann" }
}
