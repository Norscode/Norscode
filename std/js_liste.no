# js_liste.no — Array-funksjonar med JavaScript-semantikk, skrivne i Norscode
#
# JS: Array.prototype.*  (map, filter, reduce, slice, splice, ...)
#
# Skilnad frå JS: Norscode har ikkje metodesyntaks (arr.map(...)), så
# funksjonane tek lista som fyrste argument. Callback-funksjonar blir sende
# som "modul.funksjon"-namn og kalla med builtin.ncb_call_fn, same konvensjon
# som std/funktools.no.
#
# Bruk:
#   bruk std.js_liste som jsl
#
#   funksjon dobbel(x: heltall) -> heltall { returner x * 2 }
#
#   la ut = jsl.kart([1, 2, 3], "dobbel")        # [2, 4, 6]
#   la nokre_få = jsl.skiv([1, 2, 3, 4], -2, 4)  # [3, 4]
#
# Merk om null: Norscode har ikkje ein eigen null-verdi slik JS har undefined.
# Funksjonar som ikkje finn noko returnerer `ingenting` (som er 0 i praksis).
# Bruk `har_indeks`, `finn_indeks` eller `indeks_av` når du må skilje mellom
# "fann ingenting" og "fann verdien 0".

# ─── Interne hjelparar ────────────────────────────────────────────────────────

# Streng likskap på same måte som JS ===: ulik type gir ulikskap.
funksjon lik(a, b) -> bool {
    hvis builtin.type(a) != builtin.type(b) {
        returner usann
    }
    returner a == b
}

# Normaliser ein indeks slik JS gjer det: negativ indeks tel frå slutten,
# og resultatet blir klemt inn i [0, lengde].
funksjon normaliser_indeks(n: heltall, lengde_l: heltall) -> heltall {
    la i: heltall = n
    hvis i < 0 {
        i = lengde_l + i
    }
    hvis i < 0 {
        returner 0
    }
    hvis i > lengde_l {
        returner lengde_l
    }
    returner i
}

# ─── Lesing ───────────────────────────────────────────────────────────────────

# JS: arr.at(i) — negativ indeks tel frå slutten. Utanfor rekkevidde gir
# `ingenting`; sjekk med `har_indeks` fyrst når 0 er ein gyldig verdi.
funksjon ved(l, i: heltall) {
    la n: heltall = lengde(l)
    la idx: heltall = i
    hvis idx < 0 {
        idx = n + idx
    }
    hvis idx < 0 eller idx >= n {
        returner ingenting
    }
    returner l[idx]
}

# Sjekk om ein (eventuelt negativ) indeks finst i lista. Bruk denne saman med
# `ved` når lista kan innehalde 0, sidan `ingenting` ikkje kan skiljast frå 0.
funksjon har_indeks(l, i: heltall) -> bool {
    la n: heltall = lengde(l)
    la idx: heltall = i
    hvis idx < 0 {
        idx = n + idx
    }
    returner idx >= 0 og idx < n
}

# JS: arr.slice(start, slutt) — negative indeksar tel frå slutten.
funksjon skiv(l, start: heltall, slutt: heltall) -> liste {
    la n: heltall = lengde(l)
    la a: heltall = normaliser_indeks(start, n)
    la b: heltall = normaliser_indeks(slutt, n)
    la ut: liste = []
    la i: heltall = a
    mens (i < b) {
        legg_til(ut, l[i])
        i = i + 1
    }
    returner ut
}

# JS: arr.slice(start) — resten av lista frå start.
funksjon skiv_frå(l, start: heltall) -> liste {
    returner skiv(l, start, lengde(l))
}

# JS: arr.indexOf(verdi) — -1 når verdien ikkje finst.
funksjon indeks_av(l, verdi) -> heltall {
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis lik(l[i], verdi) {
            returner i
        }
        i = i + 1
    }
    returner 0 - 1
}

# JS: arr.lastIndexOf(verdi)
funksjon siste_indeks_av(l, verdi) -> heltall {
    la i: heltall = lengde(l) - 1
    mens (i >= 0) {
        hvis lik(l[i], verdi) {
            returner i
        }
        i = i - 1
    }
    returner 0 - 1
}

# JS: arr.includes(verdi)
funksjon inkluderer(l, verdi) -> bool {
    returner indeks_av(l, verdi) >= 0
}

# JS: arr.join(skiljeteikn) — element blir konverterte til tekst.
funksjon sett_saman(l, skiljeteikn: tekst) -> tekst {
    la ut: tekst = ""
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis i > 0 {
            ut = ut + skiljeteikn
        }
        ut = ut + tekst(l[i])
        i = i + 1
    }
    returner ut
}

# ─── Nye lister (ikkje-muterande, som JS toReversed/toSorted/concat) ──────────

# JS: arr.toReversed() — snur utan å endre originalen.
funksjon snu(l) -> liste {
    la ut: liste = []
    la i: heltall = lengde(l) - 1
    mens (i >= 0) {
        legg_til(ut, l[i])
        i = i - 1
    }
    returner ut
}

# JS: a.concat(b)
funksjon konkat(a, b) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(a)) {
        legg_til(ut, a[i])
        i = i + 1
    }
    la j: heltall = 0
    mens (j < lengde(b)) {
        legg_til(ut, b[j])
        j = j + 1
    }
    returner ut
}

# JS: arr.flat() — flatar ut eitt nivå.
funksjon flat(l) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(l)) {
        la element = l[i]
        hvis builtin.type(element) == "liste" {
            la j: heltall = 0
            mens (j < lengde(element)) {
                legg_til(ut, element[j])
                j = j + 1
            }
        } ellers {
            legg_til(ut, element)
        }
        i = i + 1
    }
    returner ut
}

# JS: arr.flat(djupne)
funksjon flat_djup(l, djupne: heltall) -> liste {
    hvis djupne <= 0 {
        returner konkat(l, [])
    }
    returner flat_djup(flat(l), djupne - 1)
}

# JS: arr.splice(start, slett_antal, ...innsett) — returnerer den nye lista.
# Originalen blir ikkje endra; bruk resultatet.
funksjon spleis(l, start: heltall, slett_antal: heltall, innsett) -> liste {
    la n: heltall = lengde(l)
    la a: heltall = normaliser_indeks(start, n)
    la slutt: heltall = a + slett_antal
    hvis slett_antal < 0 {
        slutt = a
    }
    hvis slutt > n {
        slutt = n
    }
    la ut: liste = skiv(l, 0, a)
    la i: heltall = 0
    mens (i < lengde(innsett)) {
        legg_til(ut, innsett[i])
        i = i + 1
    }
    la j: heltall = slutt
    mens (j < n) {
        legg_til(ut, l[j])
        j = j + 1
    }
    returner ut
}

# JS: arr.fill(verdi) — ny liste med same lengde.
funksjon fyll(l, verdi) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(l)) {
        legg_til(ut, verdi)
        i = i + 1
    }
    returner ut
}

# JS: Array.from({length: n}, (_, i) => i) — [0, 1, ... n-1]
funksjon indeksar(n: heltall) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < n) {
        legg_til(ut, i)
        i = i + 1
    }
    returner ut
}

# JS: arr.keys() som liste
funksjon nøklar(l) -> liste {
    returner indeksar(lengde(l))
}

# JS: arr.entries() — liste av [indeks, verdi]
funksjon oppføringar(l) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(l)) {
        legg_til(ut, [i, l[i]])
        i = i + 1
    }
    returner ut
}

# ─── Muterande operasjonar (som JS push/pop/shift/unshift) ────────────────────

# JS: arr.push(verdi) — returnerer ny lengde.
funksjon legg_bak(l, verdi) -> heltall {
    legg_til(l, verdi)
    returner lengde(l)
}

# JS: arr.pop() — fjernar og returnerer siste element, `ingenting` når tom.
funksjon pop(l) {
    hvis lengde(l) == 0 {
        returner ingenting
    }
    la siste = l[lengde(l) - 1]
    fjern_siste(l)
    returner siste
}

# JS: arr.unshift(verdi) — ny liste med verdien fremst.
funksjon legg_framfor(l, verdi) -> liste {
    la ut: liste = [verdi]
    la i: heltall = 0
    mens (i < lengde(l)) {
        legg_til(ut, l[i])
        i = i + 1
    }
    returner ut
}

# JS: arr.shift() — lista utan fyrste element.
funksjon utan_første(l) -> liste {
    returner skiv(l, 1, lengde(l))
}

# ─── Høgare ordens funksjonar (callback som "modul.funksjon"-namn) ────────────

# JS: arr.forEach(fn) — fn(element)
funksjon for_kvar(l, fn_namn: tekst) -> heltall {
    la i: heltall = 0
    mens (i < lengde(l)) {
        builtin.ncb_call_fn(fn_namn, l[i])
        i = i + 1
    }
    returner lengde(l)
}

# JS: arr.map(fn) — fn(element)
funksjon kart(l, fn_namn: tekst) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(l)) {
        legg_til(ut, builtin.ncb_call_fn(fn_namn, l[i]))
        i = i + 1
    }
    returner ut
}

# JS: arr.map((element, indeks) => ...) — fn(element, indeks)
funksjon kart_indeks(l, fn_namn: tekst) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(l)) {
        legg_til(ut, builtin.ncb_call_fn(fn_namn, l[i], i))
        i = i + 1
    }
    returner ut
}

# JS: arr.filter(fn) — fn(element) -> bool
funksjon filtrer(l, fn_namn: tekst) -> liste {
    la ut: liste = []
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis builtin.ncb_call_fn(fn_namn, l[i]) == sann {
            legg_til(ut, l[i])
        }
        i = i + 1
    }
    returner ut
}

# JS: arr.reduce(fn, start) — fn(akkumulator, element)
funksjon reduser(l, fn_namn: tekst, start) {
    la akk = start
    la i: heltall = 0
    mens (i < lengde(l)) {
        akk = builtin.ncb_call_fn(fn_namn, akk, l[i])
        i = i + 1
    }
    returner akk
}

# JS: arr.reduceRight(fn, start)
funksjon reduser_høgre(l, fn_namn: tekst, start) {
    la akk = start
    la i: heltall = lengde(l) - 1
    mens (i >= 0) {
        akk = builtin.ncb_call_fn(fn_namn, akk, l[i])
        i = i - 1
    }
    returner akk
}

# JS: arr.find(fn) — fyrste element som gir sann, elles `ingenting`.
# Bruk `finn_indeks` når du treng å vite om noko faktisk vart funne.
funksjon finn(l, fn_namn: tekst) {
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis builtin.ncb_call_fn(fn_namn, l[i]) == sann {
            returner l[i]
        }
        i = i + 1
    }
    returner ingenting
}

# JS: arr.findIndex(fn) — -1 når ingen treff.
funksjon finn_indeks(l, fn_namn: tekst) -> heltall {
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis builtin.ncb_call_fn(fn_namn, l[i]) == sann {
            returner i
        }
        i = i + 1
    }
    returner 0 - 1
}

# JS: arr.findLast(fn)
funksjon finn_siste(l, fn_namn: tekst) {
    la i: heltall = lengde(l) - 1
    mens (i >= 0) {
        hvis builtin.ncb_call_fn(fn_namn, l[i]) == sann {
            returner l[i]
        }
        i = i - 1
    }
    returner ingenting
}

# JS: arr.some(fn)
funksjon nokre(l, fn_namn: tekst) -> bool {
    returner finn_indeks(l, fn_namn) >= 0
}

# JS: arr.every(fn)
funksjon alle(l, fn_namn: tekst) -> bool {
    la i: heltall = 0
    mens (i < lengde(l)) {
        hvis builtin.ncb_call_fn(fn_namn, l[i]) != sann {
            returner usann
        }
        i = i + 1
    }
    returner sann
}

# JS: arr.flatMap(fn)
funksjon flat_kart(l, fn_namn: tekst) -> liste {
    returner flat(kart(l, fn_namn))
}

# JS: arr.toSorted(cmp) — cmp(a, b) returnerer negativt, 0 eller positivt.
# Stabil innsetjingssortering, som JS krev.
funksjon sorter_med(l, cmp_namn: tekst) -> liste {
    la ut: liste = konkat(l, [])
    la i: heltall = 1
    mens (i < lengde(ut)) {
        la gjeldande = ut[i]
        la j: heltall = i - 1
        la plassert: bool = usann
        mens (j >= 0 og ikkje plassert) {
            la orden = builtin.ncb_call_fn(cmp_namn, ut[j], gjeldande)
            hvis orden <= 0 {
                plassert = sann
            } ellers {
                ut[j + 1] = ut[j]
                j = j - 1
            }
        }
        ut[j + 1] = gjeldande
        i = i + 1
    }
    returner ut
}
