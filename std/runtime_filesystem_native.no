// std/runtime_filesystem_native.no — rein-Norscode-implementasjon av den native
// filsystem-ABI-en (norscode-native-filesystem-v1) for self-hosta AOT-runtimes.
//
// Native x86-64-codegen (native_codegen_v2) rutar builtin.filesystem_read_operation
// og builtin.filesystem_write_operation hit (gap_ruter.gap_rute) og emitterer dei små
// primitiva builtin.native_fs_dirents / native_fs_stat / native_fs_unlink /
// native_fs_rmdir / native_fs_chmod / native_fs_rename / native_fs_symlink som
// rå syscall-innpakkingar. På VM-/C-runtimes med eigen ABI blir denne modulen
// aldri kalla (berre bundla). Svar-forma speglar nc_filesystem_result i den gamle
// C-runtimen: {abi, status, handle, data, value, error, event_backend}.

funksjon abi_versjon() -> tekst { returner "norscode-native-filesystem-v1" }

// Filhandtak (open/read/write/flush/close) for opne_native, native_les, native_skriv,
// native_lukk og dermed native_kopier_fil/native_flytt_fil. Var «unsupported in native
// seed». Handtaka lever i ein modulglobal tabell; skriving går rett til fila med
// fil_append (flush er difor ein no-op), lesing hentar fila éin gong og deler ut bitar.
la _fh_tabell = {}
la _fh_neste: heiltall = 1

// Confinement mot symlenke-flukt: filesystem-ABI-en bind stien til rota og skal
// avvise både traversal (trygg_relativ over) OG symlenker som kan peike ut av rota.
// Seed-primitiva har ikkje readlink/realpath, så vi lstat-ar kvar sti-komponent
// (native_fs_stat med follow=usann) og avviser stiar som går gjennom ei symlenke.
// Konservativt: ei symlenke vi ikkje kan verifisere blir nekta. (Legitim lesing
// gjennom in-rot-symlenker går via builtin.fil_les, ikkje dette handtaket.)
funksjon sti_gjennom_symlenke(root: tekst, rel: tekst) -> boolsk {
    hvis rel == "" { returner usann }
    la basis = root
    hvis basis == "" { basis = "." }
    la delar = builtin.split(rel, "/")
    la sti = basis
    la i: heiltall = 0
    mens i < lengde(delar) {
        la d = delar[i]
        hvis d != "" og d != "." {
            sti = sett_saman(sti, d)
            prøv {
                la st = stat_svar(sti, usann)
                hvis st["status"] == "ok" og st["kind"] == "symlink" { returner sann }
            } fang (e) {}
        }
        i = i + 1
    }
    returner usann
}

funksjon fh_opne(req, skriv: bool) -> ordbok_tekst {
    la sti = full_sti(req)
    hvis sti == "" eller felt(req, "relative") == "" { returner feilsvar("invalid path") }
    hvis sti_gjennom_symlenke(felt(req, "root"), felt(req, "relative")) {
        returner feilsvar("sti går gjennom symlenke (confinement)")
    }
    la mode = felt(req, "mode")
    // Handhev at operasjonsklassen matchar modusen: read_operation (skriv=usann) kan
    // ikkje opne i skrive-/append-modus, og write_operation (skriv=sann) kan ikkje opne
    // i lesemodus. Utan dette gav filesystem_read_operation(open, mode=write) "open" i
    // staden for "feil" (test_native_filesystem_handles).
    hvis ikkje skriv og (mode == "write" eller mode == "append") {
        returner feilsvar("read_operation kan ikkje opne i modus " + mode)
    }
    hvis skriv og mode == "read" {
        returner feilsvar("write_operation kan ikkje opne i modus read")
    }
    la innhald = ""
    la startpos: heiltall = 0
    hvis ikkje skriv {
        hvis ikkje builtin.fil_finnes(sti) { returner feilsvar("open feila: " + sti) }
        // Katalogar blir avviste eksplisitt der stat-primitivet finst (native); elles er
        // fil_les sjølv barrieren (fil_les_safe har S_IFDIR-sjekk).
        la er_katalog = usann
        prøv {
            la st = stat_svar(sti, sann)
            hvis st["status"] == "ok" og st["kind"] == "directory" { er_katalog = sann }
        } fang (e) {}
        hvis er_katalog { returner feilsvar("ikkje ei vanleg fil: " + sti) }
        // Les innhaldet ved open, so handtaket berre kan opnast for ei lesbar fil.
        prøv { innhald = builtin.fil_les(sti) } fang (e) { returner feilsvar("ikkje ei lesbar fil: " + sti) }
    } ellers hvis mode == "append" {
        // Append: last eksisterande innhald i bufferen og sett posisjonen til slutten
        // slik at seek/skriv arbeider mot heile fila (positioned write).
        prøv { hvis builtin.fil_finnes(sti) { innhald = builtin.fil_les(sti) } } fang (e) { innhald = "" }
        startpos = lengde(innhald)
    } ellers {
        // Trunkér: skrivebufferen er autoritativ og blir persistert ved kvar skriv.
        prøv { builtin.fil_skriv(sti, "") } fang (e) { returner feilsvar("open feila: " + sti) }
        innhald = ""
    }
    la id = "fh-" + tekst_fra_heltall(_fh_neste)
    _fh_neste = _fh_neste + 1
    // lasta=sann: innhald er den autoritative bufferen (lese-handtak lasta ved open,
    // skrive-handtak held bufferen som blir skriven til fila ved kvar skriv).
    _fh_tabell[id] = {"sti": sti, "skriv": skriv, "pos": startpos, "lasta": sann, "innhald": innhald}
    la r = svar("open", "", 0, "")
    r["handle"] = id
    returner r
}

funksjon fh_hent(req) {
    la id = felt(req, "handle")
    hvis id == "" eller ikkje finnes_nøkkel(_fh_tabell, id) { returner null }
    la h = _fh_tabell[id]
    hvis h == null { returner null }
    returner h
}

funksjon fh_les(req) -> ordbok_tekst {
    la h = fh_hent(req)
    hvis h == null { returner feilsvar("ukjent filhandtak") }
    hvis h["skriv"] { returner feilsvar("handtaket er ope for skriving") }
    hvis ikkje h["lasta"] {
        prøv { h["innhald"] = builtin.fil_les(h["sti"]) } fang (e) { returner feilsvar("read feila: " + h["sti"]) }
        h["lasta"] = sann
    }
    la maks = heiltall_felt(req, "max", 65536)
    hvis maks < 1 { maks = 65536 }
    la innhald: tekst = h["innhald"]
    la pos: heiltall = h["pos"]
    la slutt: heiltall = pos + maks
    hvis slutt > lengde(innhald) { slutt = lengde(innhald) }
    la data = ""
    hvis slutt > pos { data = builtin.slice(innhald, pos, slutt) }
    h["pos"] = slutt
    la r = svar("ok", data, slutt - pos, "")
    r["handle"] = felt(req, "handle")
    returner r
}

funksjon fh_skriv(req) -> ordbok_tekst {
    la h = fh_hent(req)
    hvis h == null { returner feilsvar("ukjent filhandtak") }
    hvis ikkje h["skriv"] { returner feilsvar("handtaket er ope for lesing") }
    la data = felt(req, "data")
    // Posisjonert skriving: skriv `data` inn i bufferen ved pos (overskriv/utvid) i
    // staden for rein append, so seek + skriv gjev same semantikk som lseek+write.
    la buf: tekst = h["innhald"]
    la pos: heiltall = h["pos"]
    la buflen: heiltall = lengde(buf)
    la prefiks = ""
    hvis pos < buflen { prefiks = builtin.slice(buf, 0, pos) }
    ellers { prefiks = buf pos = buflen }
    la etter_start: heiltall = pos + lengde(data)
    la suffiks = ""
    hvis etter_start < buflen { suffiks = builtin.slice(buf, etter_start, buflen) }
    la nybuf = prefiks + data + suffiks
    prøv { builtin.fil_skriv(h["sti"], nybuf) } fang (e) { returner feilsvar("write feila: " + h["sti"]) }
    h["innhald"] = nybuf
    h["pos"] = pos + lengde(data)
    la r = svar("ok", "", lengde(data), "")
    r["handle"] = felt(req, "handle")
    returner r
}

// Felles seek/ready/handtak-stat for både lese- og skrive-operasjonar. Native seed
// har ikkje eit eige seek-primitiv; posisjonen lever i handtaket sin buffer.
funksjon fh_seek(req) -> ordbok_tekst {
    la h = fh_hent(req)
    hvis h == null { returner feilsvar("ukjent filhandtak") }
    la posisjon = heiltall_felt(req, "position", 0 - 1)
    hvis posisjon < 0 { returner feilsvar("ugyldig seek-posisjon") }
    h["pos"] = posisjon
    la r = svar("ok", "", posisjon, "")
    r["handle"] = felt(req, "handle")
    returner r
}

// Readiness for kooperativ I/O: eit ope buffer-handtak er alltid klart (value=1);
// eit ukjent/lukka handtak gjev "feil" so future-en feilar deterministisk.
funksjon fh_ready(req) -> ordbok_tekst {
    la h = fh_hent(req)
    hvis h == null { returner feilsvar("ukjent filhandtak") }
    la r = svar("ok", "", 1, "")
    r["handle"] = felt(req, "handle")
    returner r
}

funksjon fh_stat(req) -> ordbok_tekst {
    la h = fh_hent(req)
    hvis h == null { returner feilsvar("ukjent filhandtak") }
    la r = svar("ok", "", lengde(tekst(h["innhald"])), "")
    r["handle"] = felt(req, "handle")
    returner r
}

funksjon fh_lukk(req) -> ordbok_tekst {
    la id = felt(req, "handle")
    hvis fh_hent(req) == null { returner feilsvar("ukjent filhandtak") }
    // Nullstill i staden for å fjerne nøkkelen: «fjern» er liste-indeks-fjerning i
    // native codegen og skal ikkje brukast på ordbøker.
    _fh_tabell[id] = null
    la r = svar("closed", "", 0, "")
    r["handle"] = id
    returner r
}

// Plattforma sin readiness-backend, slik nc_filesystem_result i C-runtimen rapporterte
// han (kqueue på macOS, epoll på Linux, elles poll) — same kontrakt som native_gap sin
// nettverksveg (event_backend "epoll"). Var plasshaldaren "native", som
// test_native_filesystem_handles (kqueue/epoll/poll) avviste på fersk Linux-seed.
la _fs_event_backend = ""

funksjon fs_event_backend() -> tekst {
    hvis _fs_event_backend != "" { returner _fs_event_backend }
    la sys = ""
    prøv { sys = tekst(builtin.system_info()["system"]) } fang (e) { sys = "" }
    la b = "poll"
    hvis builtin.starts_with(sys, "Linux") { b = "epoll" }
    hvis builtin.starts_with(sys, "Darwin") { b = "kqueue" }
    _fs_event_backend = b
    returner b
}

funksjon svar(status: tekst, data: tekst, verdi: heiltall, feil: tekst) -> ordbok_tekst {
    la r: ordbok_tekst = {}
    r["abi"] = abi_versjon()
    r["status"] = status
    r["handle"] = ""
    r["data"] = data
    r["value"] = verdi
    r["error"] = feil
    r["event_backend"] = fs_event_backend()
    returner r
}

funksjon feilsvar(melding: tekst) -> ordbok_tekst { returner svar("feil", "", 0 - 1, melding) }

funksjon felt(req, namn: tekst) -> tekst {
    hvis req == null { returner "" }
    hvis ikkje finnes_nøkkel(req, namn) { returner "" }
    la v = req[namn]
    hvis v == null { returner "" }
    returner tekst(v)
}

funksjon heiltall_felt(req, namn: tekst, standard: heiltall) -> heiltall {
    la t = felt(req, namn)
    hvis t == "" { returner standard }
    prøv { returner heltall_fra_tekst(t) } fang (e) { returner standard }
    returner standard
}

funksjon trygg_relativ(rel: tekst) -> bool {
    hvis builtin.starts_with(rel, "/") { returner usann }
    hvis builtin.index_of(rel, "..") >= 0 { returner usann }
    hvis builtin.index_of(rel, "\n") >= 0 eller builtin.index_of(rel, "\r") >= 0 { returner usann }
    returner sann
}

// Lenkjemål er relativt til lenkja si foreldremappe. Normaliser mappa + målet
// segment for segment og avvis mål som er absolutte eller går over rota.
funksjon lenkjemål_innanfor_rot(rel: tekst, mål: tekst) -> bool {
    hvis builtin.starts_with(mål, "/") { returner usann }
    hvis builtin.index_of(mål, "\n") >= 0 eller builtin.index_of(mål, "\r") >= 0 { returner usann }
    la djupn: heiltall = 0
    la delar = builtin.split(rel, "/")
    la i: heiltall = 0
    mens i < lengde(delar) - 1 {
        la d = tekst(delar[i])
        hvis d != "" og d != "." { djupn = djupn + 1 }
        i = i + 1
    }
    la mdelar = builtin.split(mål, "/")
    la j: heiltall = 0
    mens j < lengde(mdelar) {
        la d = tekst(mdelar[j])
        hvis d == ".." {
            djupn = djupn - 1
            hvis djupn < 0 { returner usann }
        } ellers hvis d != "" og d != "." {
            djupn = djupn + 1
        }
        j = j + 1
    }
    returner sann
}

funksjon sett_saman(root: tekst, rel: tekst) -> tekst {
    hvis rel == "" { returner root }
    hvis root == "" eller root == "." { returner rel }
    hvis builtin.ends_with(root, "/") { returner root + rel }
    returner root + "/" + rel
}

funksjon full_sti(req) -> tekst {
    la root = felt(req, "root")
    la rel = felt(req, "relative")
    hvis ikkje trygg_relativ(rel) { returner "" }
    hvis root == "" { root = "." }
    returner sett_saman(root, rel)
}

funksjon kind_frå_mode(mode: heiltall) -> tekst {
    la fmt = mode & 61440
    hvis fmt == 16384 { returner "directory" }
    hvis fmt == 32768 { returner "file" }
    hvis fmt == 40960 { returner "symlink" }
    returner "other"
}

funksjon stat_svar(sti: tekst, følg: bool) -> ordbok_tekst {
    la f: heiltall = 0
    hvis følg { f = 1 }
    la st = builtin.native_fs_stat(sti, f)
    // Primitivet gjev [-1] ved feil (aldri null: typa null-samanlikning på liste-var
    // derefererer payload i native codegen).
    hvis lengde(st) < 10 { returner feilsvar("stat feila: " + sti) }
    la mode: heiltall = st[0]
    la r = svar("ok", "", st[1], "")
    r["kind"] = kind_frå_mode(mode)
    r["mode"] = mode
    r["inode"] = st[2]
    r["device"] = st[3]
    r["nlink"] = st[4]
    r["uid"] = st[5]
    r["gid"] = st[6]
    r["atime"] = st[7]
    r["mtime"] = st[8]
    r["ctime"] = st[9]
    returner r
}

funksjon del_linjer(data: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    hvis data == "" { returner ut }
    la linjer = builtin.split(data, "\n")
    la i: heiltall = 0
    mens i < lengde(linjer) {
        hvis linjer[i] != "" { legg_til(ut, linjer[i]) }
        i = i + 1
    }
    returner ut
}

funksjon list_svar(sti: tekst, typa: bool) -> ordbok_tekst {
    la rå = builtin.native_fs_dirents(sti)
    hvis rå == "!" { returner feilsvar("katalog kan ikkje opnast: " + sti) }
    la linjer = del_linjer(tekst(rå))
    // Samla i liste og slå saman éin gong: «data = data + …» per linje var kvadratisk.
    la delar: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la l = linjer[i]
        hvis typa { legg_til(delar, l) }
        ellers { legg_til(delar, builtin.slice(l, 2, lengde(l))) }
        i = i + 1
    }
    la data = ""
    hvis lengde(delar) > 0 { data = builtin.join(delar, "\n") + "\n" }
    returner svar("ok", data, lengde(linjer), "")
}

funksjon har_suffiks(namn: tekst, suffiksar: liste_tekst) -> bool {
    hvis lengde(suffiksar) == 0 { returner sann }
    la i: heiltall = 0
    mens i < lengde(suffiksar) {
        hvis suffiksar[i] != "" og builtin.ends_with(namn, suffiksar[i]) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon har_prefiks(rel: tekst, prefiksar: liste_tekst) -> bool {
    la i: heiltall = 0
    mens i < lengde(prefiksar) {
        hvis prefiksar[i] != "" og builtin.starts_with(rel, prefiksar[i]) { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon gå(base: tekst, rel: tekst, suffiksar: liste_tekst, ekskluder: liste_tekst, ut: liste_tekst, djup: heiltall) -> heiltall {
    hvis djup > 64 { returner 0 }
    la rå = builtin.native_fs_dirents(sett_saman(base, rel))
    hvis rå == "!" { returner 0 }
    la linjer = del_linjer(tekst(rå))
    la i: heiltall = 0
    mens i < lengde(linjer) {
        la l = linjer[i]
        la k = builtin.slice(l, 0, 1)
        la namn = builtin.slice(l, 2, lengde(l))
        la barn = namn
        hvis rel != "" { barn = rel + "/" + namn }
        hvis ikkje har_prefiks(barn, ekskluder) {
            hvis k == "d" { gå(base, barn, suffiksar, ekskluder, ut, djup + 1) }
            ellers hvis k == "f" og har_suffiks(namn, suffiksar) { legg_til(ut, barn) }
        }
        i = i + 1
    }
    returner 0
}

funksjon walk_svar(req) -> ordbok_tekst {
    la root = felt(req, "root")
    la rel = felt(req, "relative")
    hvis ikkje trygg_relativ(rel) { returner feilsvar("invalid directory path") }
    hvis root == "" { root = "." }
    la suffiksar = del_kommalist(felt(req, "suffixes"))
    la ekskluder = del_kommalist(felt(req, "exclude_prefixes"))
    la ut: liste_tekst = []
    gå(root, rel, suffiksar, ekskluder, ut, 0)
    // Éin join i staden for «data = data + sti + "\n"» per fil: over heile repoet
    // (tusenvis av stiar, fleire gonger i 0b-porten) var det kvadratisk kopiering.
    la data = ""
    hvis lengde(ut) > 0 { data = builtin.join(ut, "\n") + "\n" }
    returner svar("ok", data, lengde(ut), "")
}

funksjon del_kommalist(t: tekst) -> liste_tekst {
    la ut: liste_tekst = []
    hvis t == "" { returner ut }
    la delar = builtin.split(t, ",")
    la i: heiltall = 0
    mens i < lengde(delar) {
        la d = builtin.trim(delar[i])
        hvis d != "" { legg_til(ut, d) }
        i = i + 1
    }
    returner ut
}

funksjon read_operation(req) -> ordbok_tekst {
    la op = felt(req, "operation")
    hvis op == "list" eller op == "list_typed" {
        la sti = full_sti(req)
        hvis sti == "" { returner feilsvar("invalid directory path") }
        returner list_svar(sti, op == "list_typed")
    }
    hvis op == "walk_files" { returner walk_svar(req) }
    hvis op == "open" { returner fh_opne(req, usann) }
    hvis op == "read" { returner fh_les(req) }
    hvis op == "close" { returner fh_lukk(req) }
    hvis op == "seek" { returner fh_seek(req) }
    hvis op == "ready" { returner fh_ready(req) }
    // Handtak-basert stat (native_stat på eit ope handtak): returner buffer-lengda.
    hvis op == "stat" og felt(req, "handle") != "" { returner fh_stat(req) }
    hvis op == "stat" eller op == "path_stat" {
        la sti = full_sti(req)
        hvis sti == "" { returner feilsvar("invalid path") }
        returner stat_svar(sti, op == "stat")
    }
    hvis op == "read_binary" eller op == "read_async" eller op == "wait_async" eller op == "cancel_async" {
        returner feilsvar("operation " + op + " unsupported in native seed")
    }
    returner feilsvar("operation requires disk.write")
}

funksjon write_operation(req) -> ordbok_tekst {
    la op = felt(req, "operation")
    la root = felt(req, "root")
    hvis root == "" { root = "." }
    hvis op == "open" { returner fh_opne(req, sann) }
    hvis op == "write" { returner fh_skriv(req) }
    hvis op == "seek" { returner fh_seek(req) }
    hvis op == "ready" { returner fh_ready(req) }
    hvis op == "flush" {
        hvis fh_hent(req) == null { returner feilsvar("ukjent filhandtak") }
        returner svar("ok", "", 0, "")
    }
    hvis op == "close" { returner fh_lukk(req) }
    hvis op == "mkdir_p" {
        la sti = full_sti(req)
        hvis sti == "" eller felt(req, "relative") == "" { returner feilsvar("invalid directory path") }
        prøv { builtin.mkdir_p(sti) } fang (e) { returner feilsvar("mkdir feila: " + sti) }
        returner svar("ok", "", 1, "")
    }
    hvis op == "delete" {
        la sti = full_sti(req)
        hvis sti == "" { returner feilsvar("invalid path") }
        la rc: heiltall = builtin.native_fs_unlink(sti)
        hvis rc != 0 { returner feilsvar("unlink feila (" + tekst(rc) + "): " + sti) }
        returner svar("deleted", "", 0, "")
    }
    hvis op == "rmdir" {
        la sti = full_sti(req)
        hvis sti == "" { returner feilsvar("invalid path") }
        la rc: heiltall = builtin.native_fs_rmdir(sti)
        hvis rc != 0 { returner feilsvar("rmdir feila (" + tekst(rc) + "): " + sti) }
        returner svar("deleted", "", 0, "")
    }
    hvis op == "chmod" {
        la sti = full_sti(req)
        la mode = heiltall_felt(req, "mode", 0 - 1)
        hvis sti == "" { returner feilsvar("invalid path") }
        hvis mode < 0 eller mode > 511 { returner feilsvar("invalid mode") }
        la rc: heiltall = builtin.native_fs_chmod(sti, mode)
        hvis rc != 0 { returner feilsvar("chmod feila (" + tekst(rc) + "): " + sti) }
        returner svar("ok", "", mode, "")
    }
    hvis op == "file_replace" {
        la kjelde = felt(req, "source")
        la mål = felt(req, "target")
        hvis ikkje trygg_relativ(kjelde) eller ikkje trygg_relativ(mål) eller kjelde == "" eller mål == "" { returner feilsvar("invalid path") }
        la rc: heiltall = builtin.native_fs_rename(sett_saman(root, kjelde), sett_saman(root, mål))
        hvis rc != 0 { returner feilsvar("rename feila (" + tekst(rc) + ")") }
        returner svar("replaced", "", 1, "")
    }
    hvis op == "symlink_replace" {
        la rel = felt(req, "relative")
        la mål = felt(req, "target")
        hvis ikkje trygg_relativ(rel) eller rel == "" eller mål == "" { returner feilsvar("invalid path") }
        hvis ikkje lenkjemål_innanfor_rot(rel, mål) { returner feilsvar("symlink target escapes root") }
        la lenkje = sett_saman(root, rel)
        builtin.native_fs_unlink(lenkje)
        la rc: heiltall = builtin.native_fs_symlink(mål, lenkje)
        hvis rc != 0 { returner feilsvar("symlink feila (" + tekst(rc) + ")") }
        returner svar("ok", "", 1, "")
    }
    hvis op == "write_async" eller op == "wait_async" eller op == "cancel_async" {
        returner feilsvar("operation " + op + " unsupported in native seed")
    }
    returner feilsvar("operation requires disk.read")
}
