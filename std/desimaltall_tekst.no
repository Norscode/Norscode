// std/desimaltall_tekst.no — desimaltall ↔ tekst for den native x86-64-backenden.
//
// Flytta ut av std/native_gap.no 2026-09-10. Grunnen er AOT: eit brukarprogram
// kompilert med `nc bygg-native` får berre dei modulane det importerer, og
// native_gap er 1489 linjer med nettverk, filsystem, pbkdf2 m.m. Å dra alt det
// inn for å kunne skrive ut eit flyttal gjorde binæren ~10× større (målt:
// 39 696 B → 389 909 B for same program). Denne modulen er sjølvstendig — han
// kallar berre builtins og seg sjølv — og blir bunta implisitt av bygg-native.
//
// ─── desimaltall: tekst ↔ double (Fase C, 2026-09-10) ────────────────────────
//
// Den native x86-64-backenden fekk typen og xmm-aritmetikken i maskinkode. Dei
// TO VANSKELEGE delane ligg her, i Norscode, med vilje: double → desimalstreng
// og desimalstreng → double er algoritmar, ikkje instruksjonar, og dei ville
// vore mange hundre linjer handemittert maskinkode med tilsvarande feilrisiko.
// Maskinkoden gjev oss det vi treng: aritmetikk, cvttsd2si og bit-brua.
//
// Formateringa brukar RUNDTUR-SØK: prøv 1, 2, 3 … signifikante siffer og ta det
// fyrste som parsar tilbake til nøyaktig same bitmønster. Det gjev den kortaste
// representasjonen som er tapsfri, som er det committed seed gjer (0.1 → «0.1»,
// ikkje «0.1000000000000000055511151231257827»).

funksjon _d_null() { returner builtin.desimal_frå_bits(0) }

// heiltal → double. Blanda aritmetikk utvidar heiltalet med cvtsi2sd.
funksjon _d_frå_heiltal(n: heiltall) { returner _d_null() + n }

funksjon _d_ti() { returner _d_frå_heiltal(10) }

funksjon _d_er_negativ(x) -> boolsk { returner builtin.desimal_til_bits(x) < 0 }

funksjon _d_abs(x) {
    hvis _d_er_negativ(x) { returner _d_null() - x }
    returner x
}

// 10^n som double, n >= 0. Gjentatt multiplikasjon; n er lite i praksis.
funksjon _d_pow10(n: heiltall) {
    la r = _d_frå_heiltal(1)
    la i: heiltall = 0
    mens i < n { r = r * _d_ti() i = i + 1 }
    returner r
}

// Desimalstreng → double. M × 10^E, der M er sifra som heiltal.
// Skalering skjer i flyttal, so 35/10 blir nøyaktig 3.5 og 1/10 blir den
// korrekt avrunda 0.1.
funksjon desimal_frå_tekst(t: tekst) {
    la s = builtin.trim(t)
    la n = lengde(s)
    hvis n == 0 { returner _d_null() }
    la i: heiltall = 0
    la neg = usann
    la c0 = builtin.slice(s, 0, 1)
    hvis c0 == "-" { neg = sann i = 1 }
    ellers hvis c0 == "+" { i = 1 }

    la mant: heiltall = 0
    la eksp: heiltall = 0
    la siffer: heiltall = 0
    la sett_punktum = usann
    mens i < n {
        la c = builtin.slice(s, i, i + 1)
        hvis c == "." {
            hvis sett_punktum { bryt }
            sett_punktum = sann
            i = i + 1
            fortsett
        }
        hvis c == "e" eller c == "E" { bryt }
        la d = builtin.char_code(c) - 48
        hvis d < 0 eller d > 9 { bryt }
        // Maks 18 siffer i mantissa; resten justerer berre eksponenten.
        hvis siffer < 18 {
            mant = mant * 10 + d
            siffer = siffer + 1
            hvis sett_punktum { eksp = eksp - 1 }
        } ellers {
            hvis ikkje sett_punktum { eksp = eksp + 1 }
        }
        i = i + 1
    }
    // Eksplisitt eksponent (1e3, 2.5E-4)
    hvis i < n {
        la ec = builtin.slice(s, i, i + 1)
        hvis ec == "e" eller ec == "E" {
            i = i + 1
            la eneg = usann
            hvis i < n {
                la sc = builtin.slice(s, i, i + 1)
                hvis sc == "-" { eneg = sann i = i + 1 }
                ellers hvis sc == "+" { i = i + 1 }
            }
            la ev: heiltall = 0
            mens i < n {
                la d2 = builtin.char_code(builtin.slice(s, i, i + 1)) - 48
                hvis d2 < 0 eller d2 > 9 { bryt }
                ev = ev * 10 + d2
                i = i + 1
            }
            hvis eneg { eksp = eksp - ev } ellers { eksp = eksp + ev }
        }
    }

    la v = _d_frå_heiltal(mant)
    hvis eksp > 0 { v = v * _d_pow10(eksp) }
    hvis eksp < 0 { v = v / _d_pow10(0 - eksp) }
    hvis neg { v = _d_null() - v }
    returner v
}

// Formater med nøyaktig `sig` signifikante siffer. Returnerer utan eksponent
// for moderate storleikar, elles på e-form.
funksjon _d_format_sig(x, sig: heiltall) -> tekst {
    la bits = builtin.desimal_til_bits(x)
    hvis bits == 0 { returner "0" }
    la neg = _d_er_negativ(x)
    la a = _d_abs(x)

    // Normaliser til [1,10) og tel titalseksponenten.
    la e10: heiltall = 0
    la ti = _d_ti()
    la ein = _d_frå_heiltal(1)
    mens (a / ti) >= ein { a = a / ti e10 = e10 + 1 }
    mens a < ein { a = a * ti e10 = e10 - 1 }

    // Hent ut `sig` siffer med avrunding på det siste.
    la sifre: liste_heltall = []
    la j: heiltall = 0
    mens j < sig {
        la d = builtin.desimal_til_heiltal(a)
        hvis d > 9 { d = 9 }
        hvis d < 0 { d = 0 }
        legg_til(sifre, d)
        a = (a - _d_frå_heiltal(d)) * ti
        j = j + 1
    }
    // Avrund på neste siffer.
    hvis builtin.desimal_til_heiltal(a) >= 5 {
        la k: heiltall = lengde(sifre) - 1
        la bær = sann
        mens k >= 0 og bær {
            sifre[k] = sifre[k] + 1
            hvis sifre[k] == 10 { sifre[k] = 0 k = k - 1 }
            ellers { bær = usann }
        }
        hvis bær {
            la ny: liste_heltall = [1]
            la m: heiltall = 0
            mens m < lengde(sifre) { legg_til(ny, sifre[m]) m = m + 1 }
            sifre = ny
            e10 = e10 + 1
            fjern_siste(sifre)
        }
    }

    // Bygg sifferstrengen og fjern etterfølgjande nullar.
    la ds = ""
    la q: heiltall = 0
    mens q < lengde(sifre) { ds = ds + tekst_fra_heltall(sifre[q]) q = q + 1 }
    mens lengde(ds) > 1 og builtin.slice(ds, lengde(ds) - 1, lengde(ds)) == "0" {
        ds = builtin.slice(ds, 0, lengde(ds) - 1)
    }

    la ut = ""
    hvis e10 >= 0 og e10 < 17 {
        hvis lengde(ds) <= e10 + 1 {
            ut = ds
            la pad: heiltall = e10 + 1 - lengde(ds)
            la pi: heiltall = 0
            mens pi < pad { ut = ut + "0" pi = pi + 1 }
        } ellers {
            ut = builtin.slice(ds, 0, e10 + 1) + "." + builtin.slice(ds, e10 + 1, lengde(ds))
        }
    } ellers hvis e10 < 0 og e10 > 0 - 5 {
        la nullar = ""
        la z: heiltall = 0
        mens z < (0 - e10) - 1 { nullar = nullar + "0" z = z + 1 }
        ut = "0." + nullar + ds
    } ellers {
        // e-form
        la mantstr = builtin.slice(ds, 0, 1)
        hvis lengde(ds) > 1 { mantstr = mantstr + "." + builtin.slice(ds, 1, lengde(ds)) }
        ut = mantstr + "e" + tekst_fra_heltall(e10)
    }
    hvis neg { ut = "-" + ut }
    returner ut
}

// double → kortaste tapsfrie desimalstreng (rundtur-søk).
funksjon desimal_til_tekst(x) -> tekst {
    la bits = builtin.desimal_til_bits(x)
    hvis bits == 0 { returner "0" }
    // -0.0 skal skrivast som 0, slik committed seed gjer. MERK: skriv IKKJE
    // dette som `bits == 0 - 9223372036854775808` — 2^63 får ikkje plass i eit
    // fortegnsbestemt 64-bits heiltal, og den literalen krasja kompilert kode.
    // Mønsteret for -0.0 er «fortegnsbit sett, resten null», som ein kan teste
    // utan å skrive 2^63 i det heile.
    hvis bits < 0 og (bits + 1) == 0 - 9223372036854775807 { returner "0" }
    la sig: heiltall = 1
    mens sig <= 17 {
        la kandidat = _d_format_sig(x, sig)
        hvis builtin.desimal_til_bits(desimal_frå_tekst(kandidat)) == bits { returner kandidat }
        sig = sig + 1
    }
    returner _d_format_sig(x, 17)
}

// tekst(x) må kunne formatere desimaltall. Kodegeneratoren rutar `tekst`/`til_tekst`
// hit; her sjekkar vi typen billeg med er_desimaltall-atomet og fell tilbake til
// den native rutina (til_tekst_native = same atom som før) for alt anna.
// MERK: fallbacken MÅ vere til_tekst_native og ikkje `tekst`, elles kallar
// wrapperen seg sjølv i det uendelege.
funksjon til_tekst_gap(x) -> tekst {
    hvis builtin.er_desimaltall(x) { returner desimal_til_tekst(x) }
    returner builtin.til_tekst_native(x)
}
