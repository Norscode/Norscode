# metrikk_eksport.no — OTLP/HTTP-eksport (JSON) av std.metrikk-register og spans
#
# Byggjer førespurnaden med std.metrikk (otlp_metrikk_json / otlp_spor_json /
# otlp_førespurnad, reine og testbare utan nettverk) og sender han med POST via
# std.http. Endepunkt, headerar og tenestenamn følgjer OTEL_*-variablane; sjå
# toppkommentaren i std/metrikk.no.
#
# Bruk:
#   bruk std.metrikk som m
#   bruk std.metrikk_eksport som eksport
#   la r = eksport.eksporter_metrikk(m.standard(), {})      # OTEL_EXPORTER_OTLP_ENDPOINT
#   hvis ikkje r["ok"] { skriv("OTLP feila: " + tekst(r["status"]) + " " + r["feil"]) }
#   eksport.eksporter_spor({"endepunkt": "http://samlar:4318"})
#
# Kallet blokkerer til mottakaren svarar eller tidsavbrotet (opp["tidsavbrot_ms"],
# standard 10 s) går ut. I apptenaren kan det køyrast periodisk med konfig-nøkkelen
# "periodisk": {"intervall_ms": 15000, "fn": "mi_eksport"}.

bruk std.http som _http
bruk std.metrikk som _m

funksjon _tidsavbrot(opp: ordbok) -> heltall {
    hvis opp != null og har_nokkel(opp, "tidsavbrot_ms") og builtin.type(opp["tidsavbrot_ms"]) == "heltall" {
        returner opp["tidsavbrot_ms"]
    }
    returner 10000
}

funksjon _send(f: ordbok, opp: ordbok) -> ordbok {
    la svar = ""
    prøv {
        # request_full gjev svarkontrakten ({"status", "headers", "body"}) eller "" ved
        # nettverksfeil; http.post gjev berre kroppen (og tolkar "" som JSON).
        svar = _http.request_full("POST", f["url"], f["headers"], {}, f["body"], _tidsavbrot(opp))
    } fang (e) {
        returner {"ok": usann, "status": 0, "feil": tekst(e), "url": f["url"]}
    }
    hvis svar == null eller svar == "" { returner {"ok": usann, "status": 0, "feil": "ingen svar", "url": f["url"]} }
    la st = 0
    prøv { st = _http.response_status(svar) } fang (e) { st = 0 }
    returner {"ok": st >= 200 og st < 300, "status": st, "feil": "", "url": f["url"]}
}

# POST registeret til OTLP-mottakaren. Gjev {"ok", "status", "feil", "url"}.
funksjon eksporter_metrikk(reg: ordbok, opp: ordbok) -> ordbok {
    returner _send(_m.otlp_førespurnad("metrics", _m.otlp_metrikk_json(reg, opp), opp), opp)
}

# POST bufra spans til OTLP-mottakaren; bufferen blir tømd når mottakaren svarar 2xx.
funksjon eksporter_spor(opp: ordbok) -> ordbok {
    la l = _m.spans()
    hvis lengde(l) == 0 { returner {"ok": sann, "status": 0, "feil": "", "url": _m.otlp_url("traces", opp)} }
    la r = _send(_m.otlp_førespurnad("traces", _m.otlp_spor_json(l, opp), opp), opp)
    hvis r["ok"] { _m.tøm_spans() }
    returner r
}
