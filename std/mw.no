# mw.no — Mellomvare-pakke for Norscode
# Ferdigbygde request/response middlewares
#
# Bruk:
#   bruk std.mw som mw
#   bruk std.web som web
#
#   # I app-fila — registrer som web-middlewares:
#   funksjon req_mw(ctx)  -> ordbok_tekst { returner mw.køyr_request(ctx, cors_cfg, rl_cfg) }
#   funksjon resp_mw(r)   -> ordbok_tekst { returner mw.køyr_response(r, sikkerhets_cfg) }
#   web.request_middleware()
#   web.response_middleware()

bruk std.web som web
bruk std.zip som zip
bruk std.bytes som bytes

# ─── CORS ────────────────────────────────────────────────────────────────────

funksjon cors_cfg(origins: tekst, metodar: tekst, headers: tekst, maks_alder: heltall) -> ordbok_tekst {
    la c: ordbok_tekst = {}
    c["type"]        = "cors"
    c["origins"]     = origins     // "*" eller "https://a.com,https://b.com"
    c["metodar"]     = metodar     // "GET,POST,PUT,DELETE,OPTIONS"
    c["headers"]     = headers     // "Content-Type,Authorization"
    c["maks_alder"]  = tekst_fra_heltall(maks_alder)
    c["credentials"] = "usann"
    returner c
}

funksjon cors_open() -> ordbok_tekst {
    returner cors_cfg("*", "GET,POST,PUT,PATCH,DELETE,OPTIONS", "Content-Type,Authorization", 86400)
}

funksjon cors_strict(origin: tekst) -> ordbok_tekst {
    la c = cors_cfg(origin, "GET,POST,PUT,DELETE,OPTIONS", "Content-Type,Authorization,X-Request-ID", 3600)
    c["credentials"] = "sann"
    returner c
}

funksjon bruk_cors(ctx: ordbok_tekst, cfg: ordbok_tekst) -> ordbok_tekst {
    // Preflight OPTIONS → returner tidleg med CORS-headerar
    la metode = web.request_method(ctx)
    la origin = web.request_header(ctx, "origin")
    ctx["__cors_origin__"] = origin
    ctx["__cors_cfg__"]    = cfg
    returner ctx
}

funksjon cors_headers(cfg: ordbok_tekst, request_origin: tekst) -> ordbok_tekst {
    la h: ordbok_tekst = {}
    la allowed = cfg["origins"]
    la faktisk_origin = request_origin
    hvis allowed == "*" {
        h["access-control-allow-origin"] = "*"
    } ellers {
        la origins = builtin.split(allowed, ",")
        la i: heltall = 0
        la funne: boolsk = usann
        mens i < lengde(origins) {
            la o: tekst = builtin.trim(origins[i])
            hvis o == request_origin { funne = sann }
            i = i + 1
        }
        h["access-control-allow-origin"] = ""
        hvis funne {
            h["access-control-allow-origin"] = request_origin
        }
        h["vary"] = "Origin"
    }
    h["access-control-allow-methods"] = cfg["metodar"]
    h["access-control-allow-headers"] = cfg["headers"]
    h["access-control-max-age"]       = cfg["maks_alder"]
    hvis cfg["credentials"] == "sann" {
        h["access-control-allow-credentials"] = "true"
    }
    returner h
}

funksjon cors_response(cfg: ordbok_tekst, resp: ordbok_tekst, request_origin: tekst) -> ordbok_tekst {
    la cors_h = cors_headers(cfg, request_origin)
    la existing_h = resp["__headers__"]
    la nk = nøkler(cors_h)
    la i: heltall = 0
    mens i < lengde(nk) {
        la k: tekst = nk[i]
        la v: tekst = cors_h[k]
        hvis v != "" { existing_h[k] = v }
        i = i + 1
    }
    resp["__headers__"] = existing_h
    returner resp
}

# ─── Rate Limiting ────────────────────────────────────────────────────────────

funksjon rate_cfg(maks_per_minutt: heltall, nøkkel_type: tekst) -> ordbok_tekst {
    la c: ordbok_tekst = {}
    c["type"]          = "rate_limit"
    c["maks"]          = tekst_fra_heltall(maks_per_minutt)
    c["vindauge_sek"]  = "60"
    c["nøkkel_type"]   = nøkkel_type  // "ip", "brukar", "global"
    c["strategi"]      = "glidande"   // "fast" eller "glidande"
    c["strict"]        = "usann"
    returner c
}

funksjon rate_cfg_strict(maks_per_minutt: heltall, nøkkel_type: tekst) -> ordbok_tekst {
    la c = rate_cfg(maks_per_minutt, nøkkel_type)
    c["strict"] = "sann"
    returner c
}

// Sjekk rate limit — returnerer sann viss OK, usann viss over grensa
// Brukar in-memory teller (per prosess)
funksjon sjekk_rate(cfg: ordbok_tekst, nøkkel: tekst) -> boolsk {
    la maks = heltall_fra_tekst(cfg["maks"])
    // Prøv native rate-limit-builtin
    prøv {
        la vindauge = heltall_fra_tekst(cfg["vindauge_sek"])
        returner builtin.rate_check(nøkkel, maks, vindauge)
    } fang (e) { }
    hvis har_nokkel(cfg, "strict") og cfg["strict"] == "sann" {
        returner usann
    }
    // Kompatibilitetsmodus utan native rate-limit-støtte.
    returner sann
}

funksjon rate_nøkkel(ctx: ordbok_tekst, nøkkel_type: tekst) -> tekst {
    hvis nøkkel_type == "ip" {
        la ip = web.request_header(ctx, "x-forwarded-for")
        hvis ip == "" { ip = web.request_header(ctx, "x-real-ip") }
        hvis ip == "" { ip = "ukjend" }
        returner "ip:" + ip
    }
    hvis nøkkel_type == "brukar" {
        hvis har_nokkel(ctx, "__auth_id__") { returner "brukar:" + ctx["__auth_id__"] }
        returner "anonym:ip"
    }
    returner "global"
}

funksjon rate_limit_middleware(ctx: ordbok_tekst, cfg: ordbok_tekst) -> ordbok_tekst {
    la nøkkel = rate_nøkkel(ctx, cfg["nøkkel_type"])
    hvis ikkje sjekk_rate(cfg, nøkkel) {
        ctx["__rate_limited__"] = "sann"
        ctx["__rate_nøkkel__"]  = nøkkel
    }
    returner ctx
}

funksjon er_rate_limited(ctx: ordbok_tekst) -> boolsk {
    returner har_nokkel(ctx, "__rate_limited__") og ctx["__rate_limited__"] == "sann"
}

funksjon rate_limit_response() -> ordbok_tekst {
    la h: ordbok_tekst = {"content-type": "application/json", "retry-after": "60"}
    returner web.response_builder(429, h, "{\"feil\":\"For mange forespørslar. Prøv igjen seinare.\"}")
}

# ─── Tryggleiksheaderar ───────────────────────────────────────────────────────

funksjon sikkerhets_cfg(hsts: boolsk, xframe: tekst, csp: tekst) -> ordbok_tekst {
    la c: ordbok_tekst = {}
    c["type"] = "sikkerheit"
    c["hsts"] = "usann"
    hvis hsts {
        c["hsts"] = "sann"
    }
    c["xframe"] = xframe  // "DENY", "SAMEORIGIN", ""
    c["csp"]    = csp     // Content-Security-Policy-verdi
    returner c
}

funksjon sikkerhets_standard() -> ordbok_tekst {
    returner sikkerhets_cfg(
        sann,
        "SAMEORIGIN",
        "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
    )
}

funksjon legg_til_sikkerhets_headers(resp: ordbok_tekst, cfg: ordbok_tekst) -> ordbok_tekst {
    la h = resp["__headers__"]
    h["x-content-type-options"] = "nosniff"
    h["x-xss-protection"]       = "1; mode=block"
    h["referrer-policy"]         = "strict-origin-when-cross-origin"
    h["permissions-policy"]      = "geolocation=(), microphone=(), camera=()"
    hvis cfg["hsts"] == "sann" {
        h["strict-transport-security"] = "max-age=31536000; includeSubDomains"
    }
    hvis cfg["xframe"] != "" {
        h["x-frame-options"] = cfg["xframe"]
    }
    hvis cfg["csp"] != "" {
        h["content-security-policy"] = cfg["csp"]
    }
    resp["__headers__"] = h
    returner resp
}

# ─── Request-logging ──────────────────────────────────────────────────────────

funksjon logging_cfg(nivå: tekst, inkluder_body: boolsk) -> ordbok_tekst {
    la c: ordbok_tekst = {}
    c["type"]          = "logging"
    c["nivå"]          = nivå   // "DEBUG", "INFO", "WARN"
    c["inkluder_body"] = "usann"
    hvis inkluder_body {
        c["inkluder_body"] = "sann"
    }
    returner c
}

funksjon logg_request(ctx: ordbok_tekst, cfg: ordbok_tekst) -> ordbok_tekst {
    la metode = web.request_method(ctx)
    la sti    = web.request_path(ctx)
    la req_id = web.request_id(ctx)
    ctx["__req_id__"] = req_id
    ctx["__req_start_ms__"] = tekst_fra_heltall(_no_ms())
    skriv("[" + cfg["nivå"] + "] → " + metode + " " + sti + " req_id=" + req_id)
    returner ctx
}

funksjon logg_response(resp: ordbok_tekst, ctx: ordbok_tekst, cfg: ordbok_tekst) -> ordbok_tekst {
    la status = tekst(resp["__status__"])
    la sti = ""
    hvis har_nokkel(ctx, "__path__") {
        sti = ctx["__path__"]
    }
    la req_id = ""
    hvis har_nokkel(ctx, "__req_id__") {
        req_id = ctx["__req_id__"]
    }
    la start_tekst = "0"
    hvis har_nokkel(ctx, "__req_start_ms__") {
        start_tekst = ctx["__req_start_ms__"]
    }
    la start  = heltall_fra_tekst(start_tekst)
    la no     = _no_ms()
    la ms     = tekst_fra_heltall(no - start)
    la h = resp["__headers__"]
    h["x-request-id"]     = req_id
    h["x-response-time"]  = ms + "ms"
    resp["__headers__"]   = h
    skriv("[" + cfg["nivå"] + "] ← " + status + " " + sti + " " + ms + "ms req_id=" + req_id)
    returner resp
}

# ─── Komprimering ─────────────────────────────────────────────────────────────

// GZipMiddleware-ekvivalent (FA-113). Tidlegare kalla denne builtin.gzip, som
// ikkje finst, og feilen vart svelgd → svaret gjekk alltid ukomprimert ut.
// No brukar ho den reine Norscode-DEFLATE-en frå Fase 1 (std.zip,
// gzip_komprimer_bytes, RFC 1951/1952). Kroppen blir ein byte-tekst (kvar
// byte som eitt teikn), som både nc serve og apptenar sender byte-eksakt.
//
// MERK ytelse: DEFLATE køyrer i VM-en (~0,5 s for 9 KB med VM_FAST). Difor
// er det ei øvre grense (standard 65536 byte); større svar går ukomprimerte.

// Sann når Accept-Encoding godtek gzip (ikkje «gzip;q=0»). «*» tel òg.
funksjon godtek_gzip(accept: tekst) -> boolsk {
    la delar = builtin.split(_liten_mw(accept), ",")
    la i: heltall = 0
    mens i < lengde(delar) {
        la d = builtin.trim(delar[i])
        la namn = d
        la q = ""
        la semi = builtin.index_of(d, ";")
        hvis semi >= 0 {
            namn = builtin.trim(builtin.slice(d, 0, semi))
            q = builtin.replace(builtin.trim(builtin.slice(d, semi + 1, lengde(d))), " ", "")
        }
        hvis namn == "gzip" eller namn == "*" {
            hvis q == "q=0" eller q == "q=0.0" eller q == "q=0.00" eller q == "q=0.000" { returner usann }
            returner sann
        }
        i = i + 1
    }
    returner usann
}

funksjon _liten_mw(t: tekst) -> tekst {
    la ut = ""
    la i: heltall = 0
    mens i < lengde(t) {
        la c = builtin.slice(t, i, i + 1)
        la k = builtin.char_code(c)
        hvis k >= 65 og k <= 90 { ut = ut + builtin.chr(k + 32) } ellers { ut = ut + c }
        i = i + 1
    }
    returner ut
}

// gzip av ein tekst (byte for byte) → byte-tekst med gzip-straumen.
funksjon gzip_tekst(body: tekst) -> tekst {
    la inn: liste_heltall = []
    la i: heltall = 0
    la n = lengde(body)
    mens i < n {
        legg_til(inn, builtin.char_code(builtin.slice(body, i, i + 1)))
        i = i + 1
    }
    la ut = bytes.til_liste(zip.gzip_komprimer_bytes(bytes.fra_liste(inn)))
    la delar: liste<tekst> = []
    la j: heltall = 0
    mens j < lengde(ut) {
        legg_til(delar, builtin.chr(ut[j]))
        j = j + 1
    }
    returner builtin.join(delar, "")
}

// Content-Type som alt er komprimert (bilete, video, arkiv) → ikkje komprimer.
funksjon _ct_komprimert(ct: tekst) -> boolsk {
    la c = _liten_mw(ct)
    hvis tekst_starter_med(c, "image/") og ikkje tekst_starter_med(c, "image/svg") { returner sann }
    hvis tekst_starter_med(c, "video/") eller tekst_starter_med(c, "audio/") { returner sann }
    hvis tekst_inneholder(c, "zip") eller tekst_inneholder(c, "gzip") eller tekst_inneholder(c, "compress") { returner sann }
    hvis tekst_starter_med(c, "text/event-stream") { returner sann }
    returner usann
}

// Header-oppslag (kasus-uavhengig) i ei headers-ordbok; "" om han manglar.
funksjon _h_mw(h, namn: tekst) -> tekst {
    hvis h == null eller builtin.type(h) != "ordbok" { returner "" }
    la ks = nøkler(h)
    la i: heltall = 0
    mens i < lengde(ks) {
        hvis _liten_mw(tekst(ks[i])) == namn { returner tekst(h[ks[i]]) }
        i = i + 1
    }
    returner ""
}

// Komprimer eit svar når klienten godtek gzip og kroppen er mellom min og
// maks byte. Svaret kan ha nøklane body/__body__, headers/__headers__ og
// content_type (begge responskontraktane). Set Content-Encoding: gzip og
// Vary: Accept-Encoding. Gjer ingenting for 204/304/206, bytes-kropp, svar som
// alt har Content-Encoding, delsvar (206/Content-Range) eller allereie komprimerte typar.
funksjon komprimer_svar(resp, accept_encoding: tekst, min: heltall, maks: heltall) {
    hvis resp == null eller builtin.type(resp) != "ordbok" { returner resp }
    hvis ikkje godtek_gzip(accept_encoding) { returner resp }
    la bk = "body"
    hvis ikkje finnes_nøkkel(resp, "body") { bk = "__body__" }
    hvis ikkje finnes_nøkkel(resp, bk) { returner resp }
    la b = resp[bk]
    hvis b == null eller builtin.type(b) != "tekst" { returner resp }
    la n = lengde(b)
    hvis n < min eller n > maks { returner resp }
    la st = web.response_status(resp)
    hvis tekst(st) == "204" eller tekst(st) == "304" eller tekst(st) == "206" { returner resp }
    la hk = "headers"
    hvis ikkje finnes_nøkkel(resp, "headers") og finnes_nøkkel(resp, "__headers__") { hk = "__headers__" }
    la h = null
    hvis finnes_nøkkel(resp, hk) { h = resp[hk] }
    hvis h == null eller builtin.type(h) != "ordbok" { h = {} }
    hvis _h_mw(h, "content-encoding") != "" eller _h_mw(h, "content-range") != "" { returner resp }
    la ct = _h_mw(h, "content-type")
    hvis finnes_nøkkel(resp, "content_type") og resp["content_type"] != null { ct = tekst(resp["content_type"]) }
    hvis _ct_komprimert(ct) { returner resp }
    la komp = gzip_tekst(b)
    // Lønner det seg ikkje (allereie komprimert innhald), send originalen.
    hvis lengde(komp) >= n { returner resp }
    resp[bk] = komp
    hvis bk == "body" og finnes_nøkkel(resp, "__body__") { resp["__body__"] = komp }
    hvis bk == "__body__" og finnes_nøkkel(resp, "body") { resp["body"] = komp }
    h["content-encoding"] = "gzip"
    la vary = _h_mw(h, "vary")
    hvis vary == "" { h["vary"] = "Accept-Encoding" }
    ellers hvis ikkje tekst_inneholder(_liten_mw(vary), "accept-encoding") { h["vary"] = vary + ", Accept-Encoding" }
    resp[hk] = h
    hvis hk == "headers" og finnes_nøkkel(resp, "__headers__") { resp["__headers__"] = h }
    hvis hk == "__headers__" og finnes_nøkkel(resp, "headers") { resp["headers"] = h }
    returner resp
}

// Handlar-hjelpar (nc serve og apptenar): returner mw.komprimer_response(svar, ctx).
// Komprimerer svar på 500–65536 byte når klienten sender Accept-Encoding: gzip.
funksjon komprimer_response(resp: ordbok_tekst, ctx: ordbok_tekst) -> ordbok_tekst {
    returner komprimer_svar(resp, web.request_header(ctx, "accept-encoding"), 500, 65536)
}

# ─── CSRF-vern ────────────────────────────────────────────────────────────────

funksjon csrf_cfg(hemmelig: tekst) -> ordbok_tekst {
    la c: ordbok_tekst = {}
    c["type"]     = "csrf"
    c["hemmelig"] = hemmelig
    returner c
}

funksjon generer_csrf_token(cfg: ordbok_tekst) -> tekst {
    prøv {
        returner builtin.hmac_sha256(cfg["hemmelig"], tekst_fra_heltall(builtin.now_ms()))
    } fang (e) {
        returner builtin.random_hex(32)
    }
    returner ""
}

funksjon _konstant_lik_mw(a: tekst, b: tekst) -> boolsk {
    prøv { returner builtin.constant_time_compare(a, b) } fang (e) { }
    hvis lengde(a) != lengde(b) { returner usann }
    la resultat: heltall = 0
    la i: heltall = 0
    mens i < lengde(a) {
        la diff = builtin.char_code(a[i]) - builtin.char_code(b[i])
        resultat = resultat + (diff * diff)
        i = i + 1
    }
    returner resultat == 0
}

funksjon _stor_metode(m: tekst) -> tekst {
    la ut: tekst = ""
    la i: heltall = 0
    mens i < lengde(m) {
        la c: tekst = builtin.slice(m, i, i + 1)
        la code = builtin.char_code(c)
        hvis code >= 97 og code <= 122 { ut = ut + builtin.chr(code - 32) }
        ellers { ut = ut + c }
        i = i + 1
    }
    returner ut
}

# TRYGGLEIK (Fase 0.5e):
#  - metode-kasus: normaliser til store bokstavar før safe-method-sjekken, elles
#    vart CSRF handheva på «get»/«Get» (brot) eller logikken var kasus-skjør.
#  - cookie-namn-konsistens: csrf.no set cookien «csrf_token», men her vart det lese
#    «csrftoken» → dobbel-innsending matcha aldri. Les same namn som vert sett.
#  - header-fallback flukta ikkje med csrf.no sin «x-xsrf-token».
funksjon verifiser_csrf(ctx: ordbok_tekst, cfg: ordbok_tekst) -> boolsk {
    la metode = _stor_metode(web.request_method(ctx))
    // Berre sjekk skriv-metodar (trygge metodar treng ikkje CSRF)
    hvis metode == "GET" eller metode == "HEAD" eller metode == "OPTIONS" eller metode == "TRACE" { returner sann }
    la token_header = web.request_header(ctx, "x-csrf-token")
    hvis token_header == "" { token_header = web.request_header(ctx, "x-xsrf-token") }
    la token_cookie = web.request_cookie(ctx, "csrf_token")
    hvis token_header == "" { returner usann }
    hvis token_cookie == "" { returner usann }
    returner _konstant_lik_mw(token_header, token_cookie)
}

# ─── Cache-kontroll ───────────────────────────────────────────────────────────

funksjon ingen_cache(resp: ordbok_tekst) -> ordbok_tekst {
    la h = resp["__headers__"]
    h["cache-control"] = "no-store, no-cache, must-revalidate, max-age=0"
    h["pragma"]        = "no-cache"
    resp["__headers__"] = h
    returner resp
}

funksjon cache_offentleg(resp: ordbok_tekst, sekunder: heltall) -> ordbok_tekst {
    la h = resp["__headers__"]
    h["cache-control"] = "public, max-age=" + tekst_fra_heltall(sekunder)
    resp["__headers__"] = h
    returner resp
}

funksjon cache_privat(resp: ordbok_tekst, sekunder: heltall) -> ordbok_tekst {
    la h = resp["__headers__"]
    h["cache-control"] = "private, max-age=" + tekst_fra_heltall(sekunder)
    resp["__headers__"] = h
    returner resp
}

# ─── Kombinert pipeline ───────────────────────────────────────────────────────

# Køyr alle aktiverte request-middlewares i rekkefølge
funksjon pipeline_request(ctx: ordbok_tekst, middlewares: liste<ordbok_tekst>) -> ordbok_tekst {
    la current = ctx
    la i: heltall = 0
    mens i < lengde(middlewares) {
        la mw = middlewares[i]
        la type: tekst = mw["type"]
        hvis type == "cors"       { current = bruk_cors(current, mw) }
        ellers hvis type == "rate_limit" { current = rate_limit_middleware(current, mw) }
        ellers hvis type == "logging"    { current = logg_request(current, mw) }
        i = i + 1
    }
    returner current
}

funksjon pipeline_response(resp: ordbok_tekst, ctx: ordbok_tekst, middlewares: liste<ordbok_tekst>) -> ordbok_tekst {
    la current = resp
    la origin = ""
    hvis har_nokkel(ctx, "__cors_origin__") {
        origin = ctx["__cors_origin__"]
    }
    la i: heltall = 0
    mens i < lengde(middlewares) {
        la mw = middlewares[i]
        la type: tekst = mw["type"]
        hvis type == "cors"      {
            la cors_c = mw
            hvis har_nokkel(ctx, "__cors_cfg__") {
                cors_c = ctx["__cors_cfg__"]
            }
            current = cors_response(cors_c, current, origin)
        }
        ellers hvis type == "sikkerheit" { current = legg_til_sikkerhets_headers(current, mw) }
        ellers hvis type == "logging"    { current = logg_response(current, ctx, mw) }
        i = i + 1
    }
    returner current
}

# ─── Internals ────────────────────────────────────────────────────────────────

funksjon _no_ms() -> heltall {
    prøv { returner builtin.now_ms() } fang (e) { }
    returner 0
}
