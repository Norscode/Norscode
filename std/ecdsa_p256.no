# ecdsa_p256.no - ECDSA på NIST P-256 (secp256r1) i rein Norscode.
# Verifikasjon og signering (deterministisk k etter RFC 6979, SHA-256).
# Jacobian-projektive koordinatar (éin inversjon til slutt). Byggjer på
# std.bigint. Ikkje konstanttid: signering lekk tidsinformasjon om den
# private nøkkelen, så bruk han berre der det er akseptabelt.
bruk std.bigint som bn
bruk std.sha256 som sha

funksjon _nib(ch: tekst) -> heiltall { returner builtin.index_of("0123456789abcdef", ch) }
funksjon _hexbn(h: tekst) -> liste_heiltall {
    la bytes: liste_heiltall = [] la i = 0
    mens i < lengde(h) { legg_til(bytes, _nib(builtin.slice(h,i,i+1))*16 + _nib(builtin.slice(h,i+1,i+2))) i = i + 2 }
    returner bn.fra_bytes(bytes)
}
funksjon P() -> liste_heiltall { returner _hexbn("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff") }
funksjon N() -> liste_heiltall { returner _hexbn("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551") }
funksjon _Gx() -> liste_heiltall { returner _hexbn("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296") }
funksjon _Gy() -> liste_heiltall { returner _hexbn("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5") }

# ---- feltaritmetikk mod p ----
funksjon _fadd(a: liste_heiltall, b: liste_heiltall, p: liste_heiltall) -> liste_heiltall { returner bn.modulo(bn.add(a, b), p) }
funksjon _fsub(a: liste_heiltall, b: liste_heiltall, p: liste_heiltall) -> liste_heiltall {
    hvis bn.cmp(a, b) >= 0 { returner bn.sub(a, b) }
    returner bn.sub(bn.add(a, p), b)
}
funksjon _fmul(a: liste_heiltall, b: liste_heiltall, p: liste_heiltall) -> liste_heiltall { returner bn.modulo(bn.mul(a, b), p) }
funksjon _finv(a: liste_heiltall, p: liste_heiltall) -> liste_heiltall { returner bn.modexp(a, bn.sub(p, [2]), p) }

funksjon _er_uendeleg(pt: ordbok) -> boolsk { returner bn.cmp(pt["z"], [0]) == 0 }
funksjon _uendeleg() -> ordbok { returner {"x": [1], "y": [1], "z": [0]} }

# Jacobian dobling (a = -3).
funksjon _dobling(pt: ordbok, p: liste_heiltall) -> ordbok {
    hvis _er_uendeleg(pt) { returner pt }
    la X = pt["x"] la Y = pt["y"] la Z = pt["z"]
    la ZZ = _fmul(Z, Z, p)
    la A = _fmul(Y, Y, p)                                  # Y^2
    la B = _fmul(_fmul([4], X, p), A, p)                    # 4*X*Y^2
    la C = _fmul(_fmul([8], A, p), A, p)                    # 8*Y^4
    la D = _fmul([3], _fmul(_fsub(X, ZZ, p), _fadd(X, ZZ, p), p), p)   # 3*(X-Z^2)*(X+Z^2)
    la X3 = _fsub(_fmul(D, D, p), _fmul([2], B, p), p)
    la Y3 = _fsub(_fmul(D, _fsub(B, X3, p), p), C, p)
    la Z3 = _fmul(_fmul([2], Y, p), Z, p)
    returner {"x": X3, "y": Y3, "z": Z3}
}

# Jacobian addisjon (generell).
funksjon _addisjon(p1: ordbok, p2: ordbok, p: liste_heiltall) -> ordbok {
    hvis _er_uendeleg(p1) { returner p2 }
    hvis _er_uendeleg(p2) { returner p1 }
    la X1 = p1["x"] la Y1 = p1["y"] la Z1 = p1["z"]
    la X2 = p2["x"] la Y2 = p2["y"] la Z2 = p2["z"]
    la Z1Z1 = _fmul(Z1, Z1, p)
    la Z2Z2 = _fmul(Z2, Z2, p)
    la U1 = _fmul(X1, Z2Z2, p)
    la U2 = _fmul(X2, Z1Z1, p)
    la S1 = _fmul(_fmul(Y1, Z2, p), Z2Z2, p)
    la S2 = _fmul(_fmul(Y2, Z1, p), Z1Z1, p)
    hvis bn.cmp(U1, U2) == 0 {
        hvis bn.cmp(S1, S2) != 0 { returner _uendeleg() }
        returner _dobling(p1, p)
    }
    la H = _fsub(U2, U1, p)
    la I = _fmul(_fmul([2], H, p), _fmul([2], H, p), p)      # (2H)^2
    la J = _fmul(H, I, p)
    la r = _fmul([2], _fsub(S2, S1, p), p)
    la U1I = _fmul(U1, I, p)
    la X3 = _fsub(_fsub(_fmul(r, r, p), J, p), _fmul([2], U1I, p), p)
    la Y3 = _fsub(_fmul(r, _fsub(U1I, X3, p), p), _fmul([2], _fmul(S1, J, p), p), p)
    la Z3 = _fmul(_fsub(_fsub(_fmul(_fadd(Z1, Z2, p), _fadd(Z1, Z2, p), p), Z1Z1, p), Z2Z2, p), H, p)
    returner {"x": X3, "y": Y3, "z": Z3}
}

# Skalarmultiplikasjon k*Punkt (double-and-add over 256 bit).
funksjon _skalar(k: liste_heiltall, pt: ordbok, p: liste_heiltall) -> ordbok {
    la R = _uendeleg()
    la e = bn.norm(k)
    la top = lengde(e) - 1
    mens top > 0 og e[top] == 0 { top = top - 1 }
    la limb = top
    la først = sann
    mens limb >= 0 {
        la hb = 15
        mens hb >= 0 {
            hvis først {
                # hopp over leiande null-bit til første 1
                hvis ((e[limb] >> hb) & 1) == 1 { først = usann R = pt }
            } ellers {
                R = _dobling(R, p)
                hvis ((e[limb] >> hb) & 1) == 1 { R = _addisjon(R, pt, p) }
            }
            hb = hb - 1
        }
        limb = limb - 1
    }
    returner R
}

funksjon _til_affin_x(pt: ordbok, p: liste_heiltall) -> liste_heiltall {
    la zinv = _finv(pt["z"], p)
    la zinv2 = _fmul(zinv, zinv, p)
    returner _fmul(pt["x"], zinv2, p)
}

# ECDSA-verifikasjon. qx,qy = offentleg nøkkel (bigint), hash = 32-byte melding-digest (bigint),
# r,s = signatur (bigint). Returnerer sann berre om gyldig.
funksjon ecdsa_verify(qx: liste_heiltall, qy: liste_heiltall, hash_bn: liste_heiltall, r: liste_heiltall, s: liste_heiltall) -> boolsk {
    la p = P() la n = N()
    # 1: r, s i [1, n-1]
    hvis bn.cmp(r, [1]) < 0 eller bn.cmp(r, n) >= 0 { returner usann }
    hvis bn.cmp(s, [1]) < 0 eller bn.cmp(s, n) >= 0 { returner usann }
    # 3: w = s^-1 mod n
    la w = bn.modexp(s, bn.sub(n, [2]), n)
    la u1 = bn.modulo(bn.mul(hash_bn, w), n)
    la u2 = bn.modulo(bn.mul(r, w), n)
    la G = {"x": _Gx(), "y": _Gy(), "z": [1]}
    la Q = {"x": qx, "y": qy, "z": [1]}
    la P1 = _skalar(u1, G, p)
    la P2 = _skalar(u2, Q, p)
    la R = _addisjon(P1, P2, p)
    hvis _er_uendeleg(R) { returner usann }
    la x1 = bn.modulo(_til_affin_x(R, p), n)
    returner bn.cmp(x1, r) == 0
}

# ---- signering ----

funksjon _saman(a: liste_heiltall, b: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < lengde(a) { legg_til(ut, a[i]) i = i + 1 }
    i = 0
    mens i < lengde(b) { legg_til(ut, b[i]) i = i + 1 }
    returner ut
}
funksjon _fyll(n: heiltall, v: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = [] la i = 0
    mens i < n { legg_til(ut, v) i = i + 1 }
    returner ut
}
funksjon _G() -> ordbok { returner {"x": _Gx(), "y": _Gy(), "z": [1]} }

funksjon _til_affin(pt: ordbok, p: liste_heiltall) -> ordbok {
    la zinv = _finv(pt["z"], p)
    la zinv2 = _fmul(zinv, zinv, p)
    la zinv3 = _fmul(zinv2, zinv, p)
    returner {"x": _fmul(pt["x"], zinv2, p), "y": _fmul(pt["y"], zinv3, p)}
}

# RFC 6979 §3.2 for P-256 med SHA-256. Sidan qlen = hlen = 256 er T éi V-blokk
# og bits2int(T) = int(T). d_oct: 32-byte privat skalar (big-endian),
# h1: 32-byte hash av meldinga. Returnerer k som bigint.
funksjon rfc6979_k(d_oct: liste_heiltall, h1: liste_heiltall) -> liste_heiltall {
    la n = N()
    la h_oct = bn.til_bytes(bn.modulo(bn.fra_bytes(h1), n), 32)
    la V = _fyll(32, 1)
    la K = _fyll(32, 0)
    K = sha.hmac_sha256_bytes(K, _saman(_saman(_saman(V, [0]), d_oct), h_oct))
    V = sha.hmac_sha256_bytes(K, V)
    K = sha.hmac_sha256_bytes(K, _saman(_saman(_saman(V, [1]), d_oct), h_oct))
    V = sha.hmac_sha256_bytes(K, V)
    la forsøk = 0
    mens forsøk < 64 {
        V = sha.hmac_sha256_bytes(K, V)
        la k = bn.fra_bytes(V)
        hvis bn.cmp(k, [1]) >= 0 og bn.cmp(k, n) < 0 { returner k }
        K = sha.hmac_sha256_bytes(K, _saman(V, [0]))
        V = sha.hmac_sha256_bytes(K, V)
        forsøk = forsøk + 1
    }
    kast "ecdsa_p256: fann ingen gyldig k"
    returner [0]
}

# Offentleg nøkkel Q = d·G i affine koordinatar {"x", "y"} (bigint).
funksjon offentleg_nokkel(d_bytes: liste_heiltall) -> ordbok {
    la p = P()
    returner _til_affin(_skalar(bn.fra_bytes(d_bytes), _G(), p), p)
}

# ECDSA-signering (FIPS 186-4 §6.4) med deterministisk k (RFC 6979).
# d_bytes: privat nøkkel (32 byte), hash: 32-byte SHA-256-digest.
# Returnerer {"r": bigint, "s": bigint}.
funksjon ecdsa_sign(d_bytes: liste_heiltall, hash: liste_heiltall) -> ordbok {
    la p = P() la n = N()
    la d_oct = bn.til_bytes(bn.fra_bytes(d_bytes), 32)
    la d = bn.fra_bytes(d_oct)
    la e = bn.modulo(bn.fra_bytes(hash), n)
    la k = rfc6979_k(d_oct, hash)
    la r = bn.modulo(_til_affin_x(_skalar(k, _G(), p), p), n)
    la kinv = bn.modexp(k, bn.sub(n, [2]), n)
    la s = bn.modulo(bn.mul(kinv, bn.modulo(bn.add(e, bn.mul(r, d)), n)), n)
    returner {"r": r, "s": s}
}

# DER-koding av ECDSA-Sig-Value: SEQUENCE { INTEGER r, INTEGER s }.
# Dette er formatet TLS 1.3 (ecdsa_secp256r1_sha256) og X.509 brukar.
funksjon _der_heiltal(v: liste_heiltall) -> liste_heiltall {
    la b = bn.til_bytes(v, 32)
    la start = 0
    mens start < 31 og b[start] == 0 { start = start + 1 }
    la kropp: liste_heiltall = []
    hvis b[start] >= 128 { legg_til(kropp, 0) }
    la i = start
    mens i < 32 { legg_til(kropp, b[i]) i = i + 1 }
    returner _saman([2, lengde(kropp)], kropp)
}
funksjon signatur_der(r: liste_heiltall, s: liste_heiltall) -> liste_heiltall {
    la kropp = _saman(_der_heiltal(r), _der_heiltal(s))
    returner _saman([48, lengde(kropp)], kropp)
}

funksjon status() { returner { "abi": "norscode-ecdsa-p256-v1", "kurve": "secp256r1", "hash": "sha256", "signering": "rfc6979" } }
