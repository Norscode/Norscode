# pixel_diff.no — ressursavgrensa visuell samanlikning utan ekstern prosess

funksjon _resultat(status: tekst, error: tekst, endra: heiltall,
                   total: heiltall, maks_delta: heiltall,
                   sum_delta: heiltall) -> ordbok_tekst {
    la ratio_bp: heiltall = 0
    hvis total > 0 { ratio_bp = (endra * 10000) / total }
    returner {
        "format": "norscode-pixel-diff-v1",
        "status": status,
        "error": error,
        "changed_pixels": tekst_fra_heltall(endra),
        "total_pixels": tekst_fra_heltall(total),
        "changed_basis_points": tekst_fra_heltall(ratio_bp),
        "max_channel_delta": tekst_fra_heltall(maks_delta),
        "sum_channel_delta": tekst_fra_heltall(sum_delta)
    }
}

funksjon samanlikn(expected: liste_heiltall, actual: liste_heiltall,
                   width: heiltall, height: heiltall, channels: heiltall,
                   channel_tolerance: heiltall,
                   max_changed_pixels: heiltall) -> ordbok_tekst {
    hvis width < 1 eller height < 1 eller width > 8192 eller height > 8192 {
        returner _resultat("feil", "ugyldige dimensjonar", 0, 0, 0, 0)
    }
    hvis channels != 3 og channels != 4 {
        returner _resultat("feil", "kanalar må vere RGB eller RGBA", 0, 0, 0, 0)
    }
    hvis channel_tolerance < 0 eller channel_tolerance > 255 eller max_changed_pixels < 0 {
        returner _resultat("feil", "ugyldige toleransegrenser", 0, 0, 0, 0)
    }
    la pixels = width * height
    la bytes = pixels * channels
    hvis bytes > 268435456 {
        returner _resultat("feil", "biletet overskrid ressursgrensa", 0, pixels, 0, 0)
    }
    hvis lengde(expected) != bytes eller lengde(actual) != bytes {
        returner _resultat("feil", "byte- og dimensjonsavvik", 0, pixels, 0, 0)
    }
    la changed: heiltall = 0
    la max_delta: heiltall = 0
    la sum_delta: heiltall = 0
    la p: heiltall = 0
    mens p < pixels {
        la pixel_changed = usann
        la c: heiltall = 0
        mens c < channels {
            la index = p * channels + c
            la a = expected[index]
            la b = actual[index]
            hvis a < 0 eller a > 255 eller b < 0 eller b > 255 {
                returner _resultat("feil", "kanalverdi utanfor byteområdet", changed, pixels, max_delta, sum_delta)
            }
            la delta = a - b
            hvis delta < 0 { delta = 0 - delta }
            sum_delta = sum_delta + delta
            hvis delta > max_delta { max_delta = delta }
            hvis delta > channel_tolerance { pixel_changed = sann }
            c = c + 1
        }
        hvis pixel_changed { changed = changed + 1 }
        p = p + 1
    }
    hvis changed > max_changed_pixels {
        returner _resultat("ulik", "for mange endra pikslar", changed, pixels, max_delta, sum_delta)
    }
    returner _resultat("lik", "", changed, pixels, max_delta, sum_delta)
}

funksjon samanlikn_rgba(expected: liste_heiltall, actual: liste_heiltall,
                        width: heiltall, height: heiltall,
                        channel_tolerance: heiltall,
                        max_changed_pixels: heiltall) -> ordbok_tekst {
    returner samanlikn(expected, actual, width, height, 4,
                      channel_tolerance, max_changed_pixels)
}

funksjon samanlikn_rgb(expected: liste_heiltall, actual: liste_heiltall,
                       width: heiltall, height: heiltall,
                       channel_tolerance: heiltall,
                       max_changed_pixels: heiltall) -> ordbok_tekst {
    returner samanlikn(expected, actual, width, height, 3,
                      channel_tolerance, max_changed_pixels)
}
