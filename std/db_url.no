# db_url.no — same flate som std.db, men motoren blir vald av adressa (H5/H6).
#
#   bruk std.db_url som db
#
#   la a = db.open("")                                  # NorsDB i minnet
#   la b = db.open("/data/app.ndb")                     # NorsDB på fil
#   la c = db.open("postgresql://app:pw@localhost:5432/appdb")   # Postgres
#
# Postgres-handtaket følgjer NorsDB-konvensjonen: execute() gir -1 og
# siste_feil() forklarer, i staden for å kaste. Tekst-/heiltals-spørringar gir
# "" / 0 ved feil. Koden din er den same for begge motorane.
#
# Tilkoplingspool (pool/pool_acquire/pool_release) fungerer for begge. Ei
# Postgres-tilkopling som har gått i stykke blir erstatta ved neste uttak, og
# SELECT/WITH/SHOW blir prøvd éin gong til på ei fersk tilkopling utanfor
# transaksjon. Skrivande setningar blir ALDRI prøvd på nytt av seg sjølv, for
# vi veit ikkje om tenaren rakk å utføre dei.
#
# Eigen modul (ikkje std.db) slik at appar som berre brukar NorsDB ikkje får
# socket-/krypto-modulane med i kompileringa.

bruk std.norsdb_db som norsdb
bruk std.pg som pg

funksjon backend() -> tekst { returner norsdb.backend() }
funksjon status() -> ordbok_tekst { returner norsdb.status() }

funksjon er_postgres_adresse(adresse: tekst) -> boolsk {
    returner builtin.starts_with(adresse, "postgresql://") eller builtin.starts_with(adresse, "postgres://")
}

funksjon _pg(handle) -> boolsk {
    returner finnes_nøkkel(handle, "_motor") og handle["_motor"] == "postgres"
}

funksjon _pg_opne(adresse: tekst) -> ordbok_tekst {
    la h = {"_motor": "postgres", "_adresse": adresse, "_feil": "", "_i_tx": usann, "_lukka": usann, "_conn": ""}
    prøv {
        h["_conn"] = pg.open_url(adresse)
    } fang (e) {
        h["_feil"] = tekst(e)
        h["_lukka"] = sann
    }
    returner h
}

funksjon open(adresse: tekst) -> ordbok_tekst {
    hvis er_postgres_adresse(adresse) { returner _pg_opne(adresse) }
    returner norsdb.open(adresse)
}

funksjon close(handle) -> bool {
    hvis _pg(handle) {
        pg.close(handle["_conn"])
        handle["_lukka"] = sann
        returner sann
    }
    returner norsdb.close(handle)
}

funksjon ping(handle) -> bool {
    hvis _pg(handle) {
        hvis handle["_lukka"] eller ikkje pg.er_tilkopla(handle["_conn"]) { returner usann }
        returner sann
    }
    returner norsdb.ping(handle)
}

# Opprett Postgres-tilkoplinga på nytt (ikkje midt i ein transaksjon).
funksjon _pg_gjenopprett(handle) -> bool {
    hvis handle["_i_tx"] { returner usann }
    pg.close(handle["_conn"])
    la ny = _pg_opne(handle["_adresse"])
    handle["_conn"] = ny["_conn"]
    handle["_lukka"] = ny["_lukka"]
    handle["_feil"] = ny["_feil"]
    returner ikkje handle["_lukka"]
}

funksjon _er_lesing(sql: tekst) -> boolsk {
    la s = builtin.lower(builtin.trim(sql))
    returner builtin.starts_with(s, "select") eller builtin.starts_with(s, "with") eller builtin.starts_with(s, "show")
}

# Køyr éi Postgres-spørring. Gir {"ok": boolsk, "r": resultat}. Set _feil ved feil.
# `modus`: "exec" | "tekst" | "rader" | "verdi"
funksjon _pg_kjor(handle, sql: tekst, params: liste<tekst>, modus: tekst) -> ordbok_tekst {
    hvis handle["_lukka"] eller ikkje pg.er_tilkopla(handle["_conn"]) {
        hvis ikkje _pg_gjenopprett(handle) {
            hvis handle["_feil"] == "" { handle["_feil"] = "PG-feil: tilkoplinga er lukka" }
            returner {"ok": usann, "r": ""}
        }
    }
    la forsøk: heltall = 0
    mens forsøk < 2 {
        prøv {
            la r = ""
            hvis modus == "exec" { r = pg.execute(handle["_conn"], sql, params) }
            hvis modus == "verdi" { r = pg.query_verdi(handle["_conn"], sql, params) }
            hvis modus == "rader" { r = pg.rader_tekst(handle["_conn"], sql, params) }
            handle["_feil"] = ""
            returner {"ok": sann, "r": r}
        } fang (e) {
            handle["_feil"] = tekst(e)
            la teknisk = builtin.index_of(tekst(e), "SQLSTATE") < 0
            hvis teknisk og forsøk == 0 og _er_lesing(sql) og _pg_gjenopprett(handle) {
                forsøk = forsøk + 1
            } ellers {
                forsøk = 2
            }
        }
    }
    returner {"ok": usann, "r": ""}
}

funksjon siste_feil(handle) -> tekst {
    hvis _pg(handle) { returner handle["_feil"] }
    returner norsdb.siste_feil(handle)
}

funksjon execute(handle, sql: tekst) -> heltall {
    hvis _pg(handle) {
        la r = _pg_kjor(handle, sql, [], "exec")
        hvis r["ok"] { returner r["r"] }
        returner -1
    }
    returner norsdb.execute(handle, sql)
}

funksjon query_text(handle, sql: tekst) -> tekst {
    hvis _pg(handle) { returner tekst(_pg_kjor(handle, sql, [], "verdi")["r"]) }
    returner norsdb.query_text(handle, sql)
}

funksjon query_int(handle, sql: tekst) -> heltall {
    hvis _pg(handle) {
        la v = tekst(_pg_kjor(handle, sql, [], "verdi")["r"])
        hvis v == "" { returner 0 }
        prøv { returner heltall_fra_tekst(v) } fang (e) { returner 0 }
        returner 0
    }
    returner norsdb.query_int(handle, sql)
}

funksjon query_rader(handle, sql: tekst) -> tekst {
    hvis _pg(handle) { returner tekst(_pg_kjor(handle, sql, [], "rader")["r"]) }
    returner norsdb.query_rader(handle, sql)
}

# NorsDB bruker ?-teikn; Postgres $1, $2. Byt ut ? (utanfor strengar) med $n så same SQL fungerer på begge.
funksjon _til_dollar(sql: tekst) -> tekst {
    hvis builtin.index_of(sql, "?") < 0 { returner sql }
    la ut: liste_tekst = []
    la n: heltall = 0
    la i_streng = usann
    la i: heltall = 0
    mens i < lengde(sql) {
        la ch = builtin.slice(sql, i, i + 1)
        hvis ch == "'" { i_streng = ikkje i_streng }
        hvis ch == "?" og ikkje i_streng {
            n = n + 1
            legg_til(ut, "$" + tekst_fra_heltall(n))
        } ellers {
            legg_til(ut, ch)
        }
        i = i + 1
    }
    returner builtin.join(ut, "")
}

# Bundne parametrar: på Postgres går dei som ekte parametrar ($1, $2, …), på
# NorsDB blir ?-teikn bytt ut slik std.db alltid har gjort.
funksjon execute_bundet(handle, sql: tekst, params: liste<tekst>) -> heltall {
    hvis _pg(handle) {
        la r = _pg_kjor(handle, _til_dollar(sql), params, "exec")
        hvis r["ok"] { returner r["r"] }
        returner -1
    }
    returner norsdb.execute_bundet(handle, sql, params)
}

funksjon query_text_bundet(handle, sql: tekst, params: liste<tekst>) -> tekst {
    hvis _pg(handle) { returner tekst(_pg_kjor(handle, _til_dollar(sql), params, "verdi")["r"]) }
    returner norsdb.query_text_bundet(handle, sql, params)
}

funksjon query_int_bundet(handle, sql: tekst, params: liste<tekst>) -> heltall {
    hvis _pg(handle) {
        la v = tekst(_pg_kjor(handle, _til_dollar(sql), params, "verdi")["r"])
        hvis v == "" { returner 0 }
        prøv { returner heltall_fra_tekst(v) } fang (e) { returner 0 }
        returner 0
    }
    returner norsdb.query_int_bundet(handle, sql, params)
}

# ─── Transaksjonar ────────────────────────────────────────────────────────────

funksjon begin(handle) -> bool {
    hvis _pg(handle) {
        la r = _pg_kjor(handle, "BEGIN", [], "exec")
        hvis r["ok"] { handle["_i_tx"] = sann }
        returner r["ok"]
    }
    returner norsdb.begin(handle)
}

funksjon commit(handle) -> bool {
    hvis _pg(handle) {
        la r = _pg_kjor(handle, "COMMIT", [], "exec")
        handle["_i_tx"] = usann
        returner r["ok"]
    }
    returner norsdb.commit(handle)
}

funksjon rollback(handle) -> bool {
    hvis _pg(handle) {
        hvis ikkje handle["_i_tx"] { returner usann }
        la r = _pg_kjor(handle, "ROLLBACK", [], "exec")
        handle["_i_tx"] = usann
        returner r["ok"]
    }
    returner norsdb.rollback(handle)
}

# Køyr fleire ;-separerte setningar. Gir tal på setningar som råka rader, eller -1 ved feil.
funksjon migrate(handle, skript: tekst) -> heltall {
    hvis _pg(handle) {
        la delar = builtin.split(skript, ";")
        la tal: heltall = 0
        la i: heltall = 0
        mens i < lengde(delar) {
            la s = builtin.trim(delar[i])
            hvis s != "" {
                la n = execute(handle, s)
                hvis n < 0 { returner -1 }
                hvis n > 0 { tal = tal + 1 }
            }
            i = i + 1
        }
        returner tal
    }
    returner norsdb.migrate(handle, skript)
}

# Køyr skript atomisk: 1 ved commit, 0 ved rollback.
funksjon transaction(handle, skript: tekst) -> heltall {
    hvis _pg(handle) {
        hvis ikkje begin(handle) { returner 0 }
        hvis migrate(handle, skript) >= 0 {
            hvis commit(handle) { returner 1 }
            returner 0
        }
        rollback(handle)
        returner 0
    }
    returner norsdb.transaction(handle, skript)
}

funksjon backup(handle, sti: tekst) -> bool {
    hvis _pg(handle) { returner usann }
    returner norsdb.backup(handle, sti)
}

# ─── Tilkoplingspool ──────────────────────────────────────────────────────────
# pool(adresse, maks) → pool_acquire → … → pool_release. Handtak ut over `maks`
# blir avvist (handtak med siste_feil() = "pool full").

funksjon pool(adresse: tekst, maks: heltall) -> ordbok_tekst {
    returner {"_pool_sti": adresse, "_pool_maks": maks, "_pool_idle": [], "_pool_ute": 0}
}

funksjon pool_acquire(p) -> ordbok_tekst {
    hvis p["_pool_ute"] >= p["_pool_maks"] {
        returner {"_motor": "postgres", "_feil": "pool full", "_lukka": sann, "_i_tx": usann, "_conn": "", "_adresse": ""}
    }
    la c = {}
    hvis lengde(p["_pool_idle"]) > 0 {
        c = p["_pool_idle"][lengde(p["_pool_idle"]) - 1]
        fjern_siste(p["_pool_idle"])
        hvis ikkje ping(c) {
            c = open(p["_pool_sti"])
        }
    } ellers {
        c = open(p["_pool_sti"])
    }
    c["_pool"] = p
    p["_pool_ute"] = p["_pool_ute"] + 1
    returner c
}

# Gi tilbake eit handtak. Open transaksjon blir rulla tilbake først.
funksjon pool_release(p, handle) -> bool {
    hvis finnes_nøkkel(handle, "_i_tx") og handle["_i_tx"] { rollback(handle) }
    hvis p["_pool_ute"] > 0 { p["_pool_ute"] = p["_pool_ute"] - 1 }
    hvis ping(handle) { legg_til(p["_pool_idle"], handle) }
    returner sann
}

funksjon pool_size(p) -> heltall {
    returner lengde(p["_pool_idle"])
}

funksjon pool_close(p) -> bool {
    la i: heltall = 0
    mens i < lengde(p["_pool_idle"]) {
        close(p["_pool_idle"][i])
        i = i + 1
    }
    p["_pool_idle"] = []
    returner sann
}
