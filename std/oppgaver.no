# std/oppgaver.no — hjelparar for asynk-oppgåver (R5 / F36), sjå docs/ASYNK.md.
#
# I programkøyring (VM) startar eit kall til ein `asynk funksjon` ei OPPGÅVE som køyrer
# samtidig med kallaren og gjev ei future. `vent f` parkerer den kallande oppgåva
# til resultatet er klart; andre oppgåver køyrer imens. Her ligg samlingane:
#
#   bruk std.oppgaver som oppg
#   la a = hent(1)                      # future, kroppen er ikkje starta enno
#   la b = hent(2)
#   la begge = oppg.vent_alle([a, b])   # liste med resultata, i same rekkjefølgje
#   la raskast = oppg.vent_første([a, b])
#   la verdi = oppg.vent_innan(a, 500)  # TimeoutFeil (og avbrot av oppgåva) etter 500 ms
#   oppg.sov_asynk(10)                  # søv utan å blokkere andre oppgåver
#
# Utan planleggar (AOT i dag, og innbyggings-API-et) er `asynk funksjon` ein vanleg
# synkron funksjon og kallet gjev verdien direkte: ein verdi som ikkje er ei future er
# alltid «ferdig», so alle funksjonane under verkar (sekvensielt) og gjev same resultat.
#
# Feil: ei oppgåve som kastar gjev same unntak ved vent (med stakkspor frå oppgåva);
# ei avbroten oppgåve gjev AvbruttFeil, tidsavbrot gjev TimeoutFeil (begge FutureFeil).

funksjon er_future(v) -> boolsk {
    hvis builtin.type(v) != "ordbok" { returner usann }
    returner har_nokkel(v, "__future__")
}

# Er oppgåva avgjord (ferdig, feila, avbroten eller tidsavbrott)? Ein verdi som ikkje er
# ei future er alltid ferdig. Ei future som returnerte ei anna ventande future er ikkje ferdig.
funksjon er_ferdig(f) -> boolsk {
    hvis ikkje er_future(f) { returner sann }
    la st = tekst(f["status"])
    hvis st == "ventende" eller st == "kjorer" eller st == "kjører" { returner usann }
    hvis st == "ferdig" og har_nokkel(f, "__task__") og er_future(f["verdi"]) {
        returner er_ferdig(f["verdi"])
    }
    returner sann
}

funksjon er_kansellert(f) -> boolsk {
    hvis ikkje er_future(f) { returner usann }
    returner tekst(f["status"]) == "kansellert"
}

# Søv ms millisekund utan å blokkere andre oppgåver (og trådar). I ei oppgåve gjev
# oppgåva frå seg kontrollen; i hovudtråden køyrer planleggaren oppgåvene medan han søv.
funksjon sov_asynk(ms: heiltall) -> heiltall {
    hvis ms > 0 { builtin.vent.sov(ms) }
    returner 0
}

# Be om at oppgåva bak f blir avbroten: er ho ikkje starta, startar ho aldri; elles får ho
# AvbruttFeil ved neste ventepunkt (sov_asynk, vent, kanal-/lås-venting). Ein oppgåve som
# aldri ventar blir ferdig som vanleg. Returnerer sann når f var ei levande oppgåve.
funksjon avbryt(f) -> boolsk {
    hvis ikkje er_future(f) eller er_ferdig(f) { returner usann }
    hvis har_nokkel(f, "__task__") {
        builtin.vent.kanseller(f)
    } ellers {
        # Future utan oppgåve bak seg (handlaga, t.d. frå ein ekstern vert): berre statusen.
        f["status"] = "kansellert"
    }
    returner sann
}

# Vent på alle: liste med resultata i same rekkjefølgje som oppgåvene. Feila ei av dei,
# blir det første unntaket (i listerekkjefølgje) kasta; dei andre oppgåvene held fram.
funksjon vent_alle(oppgaver) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(oppgaver) {
        la f = oppgaver[i]
        la v = await f
        legg_til(ut, v)
        i = i + 1
    }
    returner ut
}

# Indeksen til den fyrste ferdige oppgåva (lågast indeks ved likt), ventar til ei er ferdig.
funksjon vent_første_indeks(oppgaver) -> heiltall {
    hvis lengde(oppgaver) == 0 { kast "ArgumentFeil: vent_første krev minst éi oppgåve" }
    mens sann {
        la i = 0
        mens i < lengde(oppgaver) {
            hvis er_ferdig(oppgaver[i]) { returner i }
            i = i + 1
        }
        sov_asynk(1)
    }
    returner -1
}

# Resultatet til den fyrste oppgåva som blir ferdig (feila ho, blir feilen kasta).
# Dei andre held fram; avbryt dei med avbryt() om dei ikkje trengst.
funksjon vent_første(oppgaver) {
    la i = vent_første_indeks(oppgaver)
    la f = oppgaver[i]
    la v = await f
    returner v
}

# Vent på f i høgst ms millisekund. Går fristen ut, blir oppgåva avbroten og
# TimeoutFeil kasta.
funksjon vent_innan(f, ms: heiltall) {
    la frist = builtin.tid_ms() + ms
    mens ikkje er_ferdig(f) {
        hvis builtin.tid_ms() >= frist {
            avbryt(f)
            kast "TimeoutFeil: oppgåva vart ikkje ferdig innan " + tekst(ms) + " ms"
        }
        sov_asynk(1)
    }
    la v = await f
    returner v
}
