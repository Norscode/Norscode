# ghash.no — GHASH (GF(2^128)) for AES-GCM, ren Norscode.
# NIST SP 800-38D. 128-bit blokker er 16-byte lister, big-endian (byte 0 mest
# signifikant). Reduksjonspolynom R = 0xe1 || 0^120 (byte 0 = 0xe1).
# Byggekloss for AES-128-GCM AEAD. Verifisert i tests/test_ghash_gcm.no mot
# NIST GCM Test Case 2 (via den FIPS-verifiserte std.aes).

funksjon _kopi(v: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(v) { legg_til(ut, v[i]) i = i + 1 }
    returner ut
}

# 128-bit høgreskift med 1 (over 16-byte big-endian array).
funksjon _rshift1(v: liste_heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la carry = 0
    la i = 0
    mens i < 16 {
        la b = v[i]
        legg_til(ut, (b >> 1) + (carry << 7))
        carry = b & 1
        i = i + 1
    }
    returner ut
}

# GF(2^128)-multiplikasjon x·y (NIST SP 800-38D, Algoritme 1).
funksjon gf_mul(x: liste_heiltall, y: liste_heiltall) -> liste_heiltall {
    la z: liste_heiltall = []
    la i = 0
    mens i < 16 { legg_til(z, 0) i = i + 1 }
    la v = _kopi(y)
    la bit = 0
    mens bit < 128 {
        # x_bit: bit `bit` av x, der bit 0 = MSB av byte 0.
        la xb = (x[bit / 8] >> (7 - (bit % 8))) & 1
        hvis xb == 1 {
            la j = 0
            mens j < 16 { z[j] = z[j] ^ v[j] j = j + 1 }
        }
        la lsb = v[15] & 1
        v = _rshift1(v)
        hvis lsb == 1 { v[0] = v[0] ^ 225 }   # 0xe1
        bit = bit + 1
    }
    returner z
}

# GHASH_H(data): data må vere eit heiltal av 16-byte blokker. Y_0 = 0,
# Y_i = (Y_{i-1} XOR blokk_i) · H.
funksjon ghash(h: liste_heiltall, data: liste_heiltall) -> liste_heiltall {
    la y: liste_heiltall = []
    la i = 0
    mens i < 16 { legg_til(y, 0) i = i + 1 }
    la nblokk = lengde(data) / 16
    la b = 0
    mens b < nblokk {
        la j = 0
        mens j < 16 { y[j] = y[j] ^ data[b * 16 + j] j = j + 1 }
        y = gf_mul(y, h)
        b = b + 1
    }
    returner y
}
