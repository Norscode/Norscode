# gzip.no — prosessfri gzip i Norscode
#
# Skrivaren produserer RFC 1952 gzip med DEFLATE stored-blokker. Lesaren
# kontrollerer header, blokkgrenser, CRC32 og ISIZE og feilar lukka for
# komprimerte blokktypekodar som ikkje enno er implementerte.

bruk std.zip som arkiv
bruk std.bytes som bytes
bruk std.base64 som base64
bruk std.filops som filops

funksjon komprimer_fil(src_fil: tekst, dst_fil: tekst) -> bool {
    prøv { returner arkiv.gzip_skriv_bytes(dst_fil, builtin.fil_les_binær(src_fil)) }
    fang (e) { returner usann }
    returner usann
}

funksjon dekomprimer_fil(src_fil: tekst, dst_fil: tekst) -> bool {
    prøv {
        hvis ikkje er_gzip(src_fil) { returner usann }
        builtin.fil_skriv_binær(dst_fil, arkiv.gzip_les_bytes(src_fil))
        returner sann
    } fang (e) {
        prøv { builtin.fil_slett(dst_fil) } fang (e2) {}
        returner usann
    }
    returner usann
}

funksjon komprimer_plass(filsti: tekst) -> bool {
    la mål = filsti + ".gz"
    hvis ikkje komprimer_fil(filsti, mål) { returner usann }
    hvis ikkje filops.slett_fil(filsti) {
        filops.slett_fil(mål)
        returner usann
    }
    returner sann
}

funksjon _utan_gz(sti: tekst) -> tekst {
    hvis builtin.ends_with(sti, ".gz") { returner builtin.slice(sti, 0, lengde(sti) - 3) }
    returner sti + ".out"
}

funksjon dekomprimer_plass(gz_sti: tekst) -> bool {
    la mål = _utan_gz(gz_sti)
    hvis ikkje dekomprimer_fil(gz_sti, mål) { returner usann }
    hvis ikkje filops.slett_fil(gz_sti) {
        filops.slett_fil(mål)
        returner usann
    }
    returner sann
}

funksjon komprimer_tekst(innhald: tekst) -> tekst {
    prøv {
        la rå = bytes.fra_liste(_tekst_bytes(innhald))
        returner base64.kod_bytes(arkiv.gzip_komprimer_bytes(rå))
    } fang (e) { returner "" }
    returner ""
}

funksjon dekomprimer_tekst(b64_data: tekst) -> tekst {
    prøv {
        la gzip_bytes = bytes.fra_liste(base64.dekod_bytes(b64_data))
        returner bytes.til_tekst(arkiv.gzip_dekomprimer_bytes(gzip_bytes))
    } fang (e) { returner "" }
    returner ""
}

funksjon open(sti: tekst, modus: tekst) -> ordbok_tekst {
    la f: ordbok_tekst = {
        "sti": sti,
        "modus": modus,
        "buffer": "",
        "pos": "0",
        "lukka": "usann",
        "feil": ""
    }
    hvis modus == "r" eller modus == "rb" {
        hvis er_gzip(sti) {
            f["buffer"] = bytes.til_tekst(arkiv.gzip_les_bytes(sti))
        } ellers {
            f["feil"] = "Kan ikkje lese gzip: " + sti
        }
    } ellers hvis modus == "a" {
        hvis builtin.fil_finnes(sti) og er_gzip(sti) {
            f["buffer"] = bytes.til_tekst(arkiv.gzip_les_bytes(sti))
        }
    }
    returner f
}

funksjon les(f: ordbok_tekst) -> tekst {
    hvis f["lukka"] == "sann" { returner "" }
    la pos = heltall_fra_tekst(f["pos"])
    la buffer = f["buffer"]
    hvis pos >= lengde(buffer) { returner "" }
    f["pos"] = tekst_fra_heltall(lengde(buffer))
    returner builtin.slice(buffer, pos, lengde(buffer))
}

funksjon readline(f: ordbok_tekst) -> tekst {
    hvis f["lukka"] == "sann" { returner "" }
    la pos = heltall_fra_tekst(f["pos"])
    la buffer = f["buffer"]
    hvis pos >= lengde(buffer) { returner "" }
    la slutt = pos
    mens slutt < lengde(buffer) og builtin.slice(buffer, slutt, slutt + 1) != "\n" {
        slutt = slutt + 1
    }
    hvis slutt < lengde(buffer) { slutt = slutt + 1 }
    f["pos"] = tekst_fra_heltall(slutt)
    returner builtin.slice(buffer, pos, slutt)
}

funksjon readlines(f: ordbok_tekst) -> liste_tekst {
    returner builtin.split(les(f), "\n")
}

funksjon write(f: ordbok_tekst, innhald: tekst) {
    hvis f["lukka"] == "usann" { f["buffer"] = f["buffer"] + innhald }
}

funksjon flush(f: ordbok_tekst) -> bool {
    hvis f["modus"] == "r" eller f["modus"] == "rb" { returner sann }
    prøv {
        returner arkiv.gzip_skriv_bytes(f["sti"], bytes.fra_liste(_tekst_bytes(f["buffer"])))
    } fang (e) { returner usann }
    returner usann
}

funksjon close(f: ordbok_tekst) -> bool {
    hvis f["lukka"] == "sann" { returner sann }
    la ok = sann
    hvis f["modus"] != "r" og f["modus"] != "rb" { ok = flush(f) }
    f["lukka"] = "sann"
    returner ok
}

funksjon er_lukka(f: ordbok_tekst) -> bool { returner f["lukka"] == "sann" }

funksjon komprimert_storleik(gz_sti: tekst) -> heltall {
    returner filops.fil_storleik(gz_sti)
}

funksjon ukomprimert_storleik(gz_sti: tekst) -> heltall {
    hvis ikkje er_gzip(gz_sti) { returner -1 }
    prøv {
        la rå = bytes.til_liste(builtin.fil_les_binær(gz_sti))
        la n = lengde(rå)
        returner rå[n - 4] + (rå[n - 3] << 8) + (rå[n - 2] << 16) + (rå[n - 1] << 24)
    } fang (e) { returner -1 }
    returner -1
}

funksjon kompresjonsforhold(gz_sti: tekst) -> heltall {
    la komp = komprimert_storleik(gz_sti)
    la ukomp = ukomprimert_storleik(gz_sti)
    hvis ukomp <= 0 eller komp <= 0 { returner 0 }
    returner (komp * 10000) / ukomp
}

funksjon er_gzip(sti: tekst) -> bool {
    prøv {
        la rå = bytes.til_liste(builtin.fil_les_binær(sti))
        hvis lengde(rå) < 18 eller rå[0] != 31 eller rå[1] != 139 eller rå[2] != 8 eller rå[3] != 0 {
            returner usann
        }
        la n = lengde(rå)
        la storleik = rå[n - 4] + (rå[n - 3] << 8) + (rå[n - 2] << 16) + (rå[n - 1] << 24)
        la ut = arkiv.gzip_dekomprimer_bytes(bytes.fra_liste(rå))
        returner lengde(ut) == storleik
    } fang (e) { returner usann }
    returner usann
}

funksjon komprimer_mange(filer: liste_tekst) -> liste_tekst {
    la feil: liste_tekst = []
    la i = 0
    mens i < lengde(filer) {
        hvis ikkje komprimer_plass(filer[i]) { legg_til(feil, filer[i]) }
        i = i + 1
    }
    returner feil
}

funksjon dekomprimer_mange(gz_filer: liste_tekst) -> liste_tekst {
    la feil: liste_tekst = []
    la i = 0
    mens i < lengde(gz_filer) {
        hvis ikkje dekomprimer_plass(gz_filer[i]) { legg_til(feil, gz_filer[i]) }
        i = i + 1
    }
    returner feil
}

funksjon _tekst_bytes(s: tekst) -> liste_heltall {
    la ut: liste_heltall = []
    la i = 0
    mens i < lengde(s) {
        legg_til(ut, builtin.char_code(builtin.slice(s, i, i + 1)))
        i = i + 1
    }
    returner ut
}

funksjon _trim_tekst(s: tekst) -> tekst { returner builtin.trim(s) }
funksjon les_fil(gz_sti: tekst) -> tekst {
    la f = open(gz_sti, "r")
    la innhald = les(f)
    close(f)
    returner innhald
}

funksjon skriv_fil(gz_sti: tekst, innhald: tekst) -> bool {
    la f = open(gz_sti, "w")
    write(f, innhald)
    returner close(f)
}
