// NorsDB SQL-lag — frittståande, oppå std.norsdb_motor (binær B-tre/WAL-motor).
// Ingen vom vm.no; dette er ein eigen Norscode-databasemotor: storage + SQL.
// Fase 4b (start): CREATE TABLE / INSERT / SELECT (m/ enkel WHERE) / COUNT.

bruk std.norsdb_motor som motor

// ── Tokenisering (sitat-bevisst) ─────────────────────────────────────
funksjon _er_ws(c: tekst) -> boolsk {
    returner c == " " eller c == "\t" eller c == "\n" eller c == "\r"
}

funksjon _er_siffer(c: tekst) -> boolsk {
    la k = builtin.char_code(c)
    returner k >= 48 og k <= 57
}

funksjon _er_ident(c: tekst) -> boolsk {
    la k = builtin.char_code(c)
    returner (k >= 65 og k <= 90) eller (k >= 97 og k <= 122) eller (k >= 48 og k <= 57) eller c == "_" eller c == "." eller k >= 128
}

funksjon _opp(s: tekst) -> tekst {
    returner builtin.upper(s)
}

// Hex-teikn → 0-15. (NB: _hex_siffer finst alt med motsett signatur — difor _hex_val.)
funksjon _hex_val(c: tekst) -> heltall {
    la cc = builtin.char_code(builtin.lower(c))
    hvis cc >= 48 og cc <= 57 { returner cc - 48 }
    hvis cc >= 97 og cc <= 102 { returner cc - 87 }
    returner 0
}

// Dekod hex-par → bytes-som-streng (BLOB-literal x'…'). ASCII-trygt.
funksjon _blob_decode(hex: tekst) -> tekst {
    la h = builtin.split(hex, "")
    la ut = ""
    la i = 0
    mens (i + 1) < lengde(h) {
        la hi = _hex_val(h[i])
        la lo = _hex_val(h[i + 1])
        ut = ut + builtin.chr((hi * 16) + lo)
        i = i + 2
    }
    returner ut
}

funksjon _unquote(v: tekst) -> tekst {
    la s = builtin.trim(v)
    hvis lengde(s) >= 2 og builtin.slice(s, 0, 1) == "'" og builtin.slice(s, lengde(s) - 1, lengde(s)) == "'" {
        returner builtin.slice(s, 1, lengde(s) - 1)
    }
    returner s
}

// Rask tokenisering. Same token-reglar som _tok_referanse (teikn-for-teikn-
// versjonen under), men gjord med få native strengoperasjonar i staden for
// fleire funksjonskall per teikn — tokeniseringa var ein stor del av den faste
// kostnaden per setning. Strenglitteralar (og x'…'-blob) blir først skorne ut
// på apostrofane og erstatta med plasshaldarar; resten blir splitta på
// mellomrom etter at operatorteikn har fått mellomrom rundt seg.
// Byte ≥ 128 (UTF-8, t.d. «utgår») høyrer til identifikatorar.
funksjon _tok(sql: tekst) -> liste {
    hvis builtin.index_of(sql, "'") < 0 {
        returner _tok_ute(sql, [])
    }
    la deler = builtin.split(sql, "'")
    la n = lengde(deler)
    la ute = [deler[0]]
    la strenger = []
    la i = 1
    mens i < n {
        la innhald = deler[i]
        i = i + 1
        // '' inne i ein streng = éin apostrof.
        mens i + 1 < n og deler[i] == "" {
            innhald = innhald + "'" + deler[i + 1]
            i = i + 2
        }
        // x'…' / X'…' (BLOB) når x står fremst i eit token.
        la sist = ute[lengde(ute) - 1]
        la sl = lengde(sist)
        la blob = usann
        hvis sl >= 1 {
            la xc = builtin.slice(sist, sl - 1, sl)
            hvis xc == "x" eller xc == "X" {
                blob = sann
                hvis sl >= 2 og _er_ident(builtin.slice(sist, sl - 2, sl - 1)) { blob = usann }
            }
        }
        hvis blob {
            ute[lengde(ute) - 1] = builtin.slice(sist, 0, sl - 1)
            legg_til(strenger, "x'" + innhald + "'")
        } ellers {
            legg_til(strenger, "'" + innhald + "'")
        }
        legg_til(ute, " " + builtin.chr(5) + tekst_fra_heltall(lengde(strenger) - 1) + " ")
        hvis i < n {
            legg_til(ute, deler[i])
            i = i + 1
        }
    }
    returner _tok_ute(builtin.join(ute, ""), strenger)
}

funksjon _tok_ute(s: tekst, strenger) -> liste {
    la t = builtin.replace(s, "\t", " ")
    t = builtin.replace(t, "\n", " ")
    t = builtin.replace(t, "\r", " ")
    // Fleirteikn-operatorar → plasshaldarar (rekkjefølgja speglar _tok_referanse).
    t = builtin.replace(t, "||", " " + builtin.chr(16) + " ")
    t = builtin.replace(t, "::", " " + builtin.chr(17) + " ")
    t = builtin.replace(t, "<=", " " + builtin.chr(18) + " ")
    t = builtin.replace(t, "<>", " " + builtin.chr(21) + " ")
    t = builtin.replace(t, ">=", " " + builtin.chr(19) + " ")
    t = builtin.replace(t, "!=", " " + builtin.chr(20) + " ")
    // «-» rett før eit siffer startar eit (negativt) tal-token.
    hvis builtin.index_of(t, "-") >= 0 {
        la d = 0
        mens d < 10 {
            t = builtin.replace(t, "-" + tekst_fra_heltall(d), " " + builtin.chr(2) + tekst_fra_heltall(d))
            d = d + 1
        }
    }
    t = builtin.replace(t, "(", " ( ")
    t = builtin.replace(t, ")", " ) ")
    t = builtin.replace(t, ",", " , ")
    t = builtin.replace(t, ";", " ; ")
    t = builtin.replace(t, "=", " = ")
    t = builtin.replace(t, ">", " > ")
    t = builtin.replace(t, "<", " < ")
    t = builtin.replace(t, "!", " ! ")
    t = builtin.replace(t, "*", " * ")
    t = builtin.replace(t, "+", " + ")
    t = builtin.replace(t, "-", " - ")
    t = builtin.replace(t, "/", " / ")
    t = builtin.replace(t, "%", " % ")
    t = builtin.replace(t, "|", " | ")
    t = builtin.replace(t, "?", " ? ")
    t = builtin.replace(t, ":", " : ")
    // Teikn som _tok_referanse hoppar over (skiljer token, blir ikkje token).
    t = builtin.replace(t, "\"", " ")
    t = builtin.replace(t, "#", " ")
    t = builtin.replace(t, "$", " ")
    t = builtin.replace(t, "&", " ")
    t = builtin.replace(t, "@", " ")
    t = builtin.replace(t, "[", " ")
    t = builtin.replace(t, "]", " ")
    t = builtin.replace(t, "\\", " ")
    t = builtin.replace(t, "^", " ")
    t = builtin.replace(t, "`", " ")
    t = builtin.replace(t, "{", " ")
    t = builtin.replace(t, "}", " ")
    t = builtin.replace(t, "~", " ")
    t = builtin.replace(t, builtin.chr(16), "||")
    t = builtin.replace(t, builtin.chr(17), "::")
    t = builtin.replace(t, builtin.chr(18), "<=")
    t = builtin.replace(t, builtin.chr(19), ">=")
    t = builtin.replace(t, builtin.chr(20), "!=")
    t = builtin.replace(t, builtin.chr(21), "<>")
    t = builtin.replace(t, builtin.chr(2), "-")
    la rå = builtin.split(t, " ")
    la ut = []
    la i = 0
    la n = lengde(rå)
    mens i < n {
        la tok = rå[i]
        hvis tok != "" {
            hvis builtin.char_code(tok) == 5 {
                legg_til(ut, strenger[builtin.heltall_fra_tekst(builtin.slice(tok, 1, lengde(tok)))])
            } ellers {
                legg_til(ut, tok)
            }
        }
        i = i + 1
    }
    returner ut
}

funksjon _tok_referanse(sql: tekst) -> liste {
    la chars = builtin.split(sql, "")
    la n = lengde(chars)
    la ut = []
    la i: heltall = 0
    mens i < n {
        la c = chars[i]
        hvis _er_ws(c) {
            i = i + 1
            fortsett
        }
        // BLOB-literal x'…' / X'…' → eige token "x'…'" (før identifikator/streng).
        hvis (c == "x" eller c == "X") og i + 1 < n og chars[i + 1] == "'" {
            la hv = ""
            la j = i + 2
            mens j < n og chars[j] != "'" { hv = hv + chars[j]; j = j + 1 }
            hvis j < n { j = j + 1 }
            legg_til(ut, "x'" + hv + "'")
            i = j
            fortsett
        }
        hvis c == "'" {
            la verdi = ""
            i = i + 1
            mens i < n {
                hvis chars[i] == "'" {
                    hvis i + 1 < n og chars[i + 1] == "'" {
                        verdi = verdi + "'"
                        i = i + 2
                        fortsett
                    }
                    bryt
                }
                verdi = verdi + chars[i]
                i = i + 1
            }
            legg_til(ut, "'" + verdi + "'")
            hvis i < n { i = i + 1 }
            fortsett
        }
        hvis _er_siffer(c) eller (c == "-" og i + 1 < n og _er_siffer(chars[i + 1])) {
            la start = i
            i = i + 1
            mens i < n og (_er_siffer(chars[i]) eller chars[i] == ".") { i = i + 1 }
            legg_til(ut, builtin.slice(sql, start, i))
            fortsett
        }
        hvis c == "|" {
            hvis i + 1 < n og chars[i + 1] == "|" {
                legg_til(ut, "||")
                i = i + 2
                fortsett
            }
            legg_til(ut, "|")
            i = i + 1
            fortsett
        }
        hvis c == "?" {
            legg_til(ut, "?")
            i = i + 1
            fortsett
        }
        hvis c == ":" {
            hvis i + 1 < n og chars[i + 1] == ":" {
                legg_til(ut, "::")
                i = i + 2
                fortsett
            }
            legg_til(ut, ":")
            i = i + 1
            fortsett
        }
        hvis c == "(" eller c == ")" eller c == "," eller c == ";" eller c == "=" eller c == ">" eller c == "<" eller c == "!" eller c == "*" eller c == "+" eller c == "-" eller c == "/" eller c == "%" {
            hvis (c == ">" eller c == "<" eller c == "!") og i + 1 < n og chars[i + 1] == "=" {
                legg_til(ut, c + "=")
                i = i + 2
                fortsett
            }
            hvis c == "<" og i + 1 < n og chars[i + 1] == ">" {
                legg_til(ut, "<>")
                i = i + 2
                fortsett
            }
            legg_til(ut, c)
            i = i + 1
            fortsett
        }
        hvis _er_ident(c) {
            la start = i
            i = i + 1
            mens i < n og _er_ident(chars[i]) { i = i + 1 }
            legg_til(ut, builtin.slice(sql, start, i))
            fortsett
        }
        i = i + 1
    }
    returner ut
}

// ── Verdi-samanlikning (tal-bevisst, som SQLite for WHERE) ────────────
funksjon _er_tal(v: tekst) -> boolsk {
    hvis lengde(v) == 0 { returner usann }
    la ch = builtin.split(v, "")
    la i: heltall = 0
    hvis ch[0] == "-" {
        hvis lengde(ch) == 1 { returner usann }
        i = 1
    }
    mens i < lengde(ch) {
        hvis ikke _er_siffer(ch[i]) og ch[i] != "." { returner usann }
        i = i + 1
    }
    returner sann
}

// ── 3-verdi NULL: sentinel (chr(1)"NUL"chr(1) — finst aldri i SQL-tekst, ≠ "") ──
funksjon _NULLV() -> tekst { returner builtin.chr(1) + "NUL" + builtin.chr(1) }
funksjon _ern(v: tekst) -> boolsk {
    hvis lengde(v) != 5 { returner usann }
    returner v == _NULLV()
}
// Output: sentinel → "" (SQLite viser NULL som tomt i -noheader).
funksjon _null_ut(v: tekst) -> tekst { hvis _ern(v) { returner "" } returner v }
// Fjern alle NULL-sentinelar frå eit ferdig output-streng (sentinelen finst aldri i data).
funksjon _strip_null(s: tekst) -> tekst { returner builtin.join(builtin.split(s, _NULLV()), "") }

// Tal-bevisst samanlikning: er begge numeriske, blir dei samanlikna som tal
// (eksakt, også desimaltal og negative), elles som tekst. Via motoren sin
// sorteringsnøkkel, som gjev same orden som ORDER BY og indeksane.
funksjon _cmp(a: tekst, op: tekst, b: tekst) -> boolsk {
    // NULL-samanlikning er «unknown» → aldri sann (SQLite: WHERE ekskluderer).
    hvis _ern(a) eller _ern(b) { returner usann }
    la ka = motor.sorteringsnøkkel(a)
    la kb = motor.sorteringsnøkkel(b)
    hvis (builtin.char_code(ka) == 51) != (builtin.char_code(kb) == 51) {
        // Blanda tal/tekst: rå tekst-samanlikning (som før).
        ka = a
        kb = b
    }
    hvis op == "=" eller op == "==" { returner ka == kb }
    hvis op == "!=" eller op == "<>" { returner ka != kb }
    hvis op == ">" { returner ka > kb }
    hvis op == ">=" { returner ka >= kb }
    hvis op == "<" { returner ka < kb }
    hvis op == "<=" { returner ka <= kb }
    returner usann
}

// ── Tal-type-lag (Fase 7j): heiltal vs REAL. REAL = numerisk streng med "." ──
funksjon _er_real(s: tekst) -> boolsk {
    returner _er_tal(s) og builtin.index_of(s, ".") >= 0
}

// Trunkér flyt mot null via tekst (ingen kallbar float→int-builtin; `heltall` er reservert).
funksjon _flyt_trunk(f) -> heltall {
    la s = builtin.til_tekst(f)
    la d = builtin.index_of(s, ".")
    hvis d >= 0 { s = builtin.slice(s, 0, d) }
    hvis s == "" eller s == "-" { returner 0 }
    hvis ikke _er_tal(s) { returner 0 }
    returner builtin.heltall_fra_tekst(s)
}

// Rund ein flyt-tekst (til_tekst-output) til maks 15 signifikante siffer, som SQLite
// sin %!.15g. til_tekst skil seg per plattform (arm64-seeden: 15 siffer, x86-seeden:
// kortaste rundtur, opptil 17 — 8.0/3 gav «2.6666666666666665» mot SQLite sin
// «2.66666666666667»). Rein siffer-aritmetikk på teksten: formatet (fast/eksponent)
// og forteiknet blir haldne; ≤15 signifikante siffer og ikkje-numerisk tekst er urørt.
funksjon _rund_15_sig(s: tekst) -> tekst {
    la n = lengde(s)
    la start = 0
    hvis n > 0 og builtin.slice(s, 0, 1) == "-" { start = 1 }
    la epos = builtin.index_of(s, "e")
    hvis epos < 0 { epos = builtin.index_of(s, "E") }
    la slutt = n
    hvis epos >= 0 { slutt = epos }
    la mant = builtin.slice(s, start, slutt)
    la punkt = builtin.index_of(mant, ".")
    la siffer = mant
    la heil = lengde(mant)
    hvis punkt >= 0 {
        siffer = builtin.slice(mant, 0, punkt) + builtin.slice(mant, punkt + 1, lengde(mant))
        heil = punkt
    }
    la i = 0
    mens i < lengde(siffer) {
        la c = builtin.char_code(builtin.slice(siffer, i, i + 1))
        hvis c < 48 eller c > 57 { returner s }
        i = i + 1
    }
    la f = 0
    mens f < lengde(siffer) og builtin.slice(siffer, f, f + 1) == "0" { f = f + 1 }
    hvis lengde(siffer) - f <= 15 { returner s }
    la kutt = f + 15
    la behald = builtin.slice(siffer, 0, kutt)
    hvis builtin.char_code(builtin.slice(siffer, kutt, kutt + 1)) >= 53 {
        la ut = ""
        la mente = 1
        la j = kutt - 1
        mens j >= 0 {
            la d = builtin.char_code(builtin.slice(behald, j, j + 1)) - 48 + mente
            hvis d == 10 { d = 0; mente = 1 } ellers { mente = 0 }
            ut = tekst_fra_heltall(d) + ut
            j = j - 1
        }
        hvis mente == 1 {
            // Overløp forbi fyrste siffer (9.99…→10): eksponentform kan ikkje
            // normaliserast her → behald originalen (ekstremt sjeldan).
            hvis epos >= 0 { returner s }
            ut = "1" + ut
            heil = heil + 1
        }
        behald = ut
    }
    la heildel = behald
    la brok = ""
    hvis lengde(behald) > heil {
        heildel = builtin.slice(behald, 0, heil)
        brok = builtin.slice(behald, heil, lengde(behald))
    } ellers {
        mens lengde(heildel) < heil { heildel = heildel + "0" }
    }
    mens lengde(brok) > 0 og builtin.slice(brok, lengde(brok) - 1, lengde(brok)) == "0" {
        brok = builtin.slice(brok, 0, lengde(brok) - 1)
    }
    la r = heildel
    hvis lengde(brok) > 0 { r = r + "." + brok }
    hvis start == 1 { r = "-" + r }
    hvis epos >= 0 { r = r + builtin.slice(s, epos, n) }
    returner r
}

// Formatér flyt som SQLite: minimal, men alltid med desimalteikn ("5" → "5.0").
funksjon _fmt_real(f) -> tekst {
    la s = _rund_15_sig(builtin.til_tekst(f))
    hvis builtin.index_of(s, ".") < 0 og builtin.index_of(s, "e") < 0 og builtin.index_of(s, "E") < 0 { s = s + ".0" }
    returner s
}

// Type-bevisst binær aritmetikk. REAL om nokon operand er REAL (utanom % = heiltal).
// NULL ("") propagerer; divisjon/modulo med 0 → NULL; ikkje-numerisk tekst → 0 (SQLite).
funksjon _num_bin(a: tekst, op: tekst, b: tekst) -> tekst {
    hvis _ern(a) eller _ern(b) { returner _NULLV() }
    la an = a
    la bn = b
    hvis ikke _er_tal(an) { an = "0" }
    hvis ikke _er_tal(bn) { bn = "0" }
    hvis op == "%" {
        la bi = _flyt_trunk(builtin.desimaltall(bn))
        hvis bi == 0 { returner "" }
        la ai = _flyt_trunk(builtin.desimaltall(an))
        returner tekst_fra_heltall(ai - (ai / bi) * bi)
    }
    hvis _er_real(an) eller _er_real(bn) {
        la x = builtin.desimaltall(an)
        la y = builtin.desimaltall(bn)
        hvis op == "+" { returner _fmt_real(x + y) }
        hvis op == "-" { returner _fmt_real(x - y) }
        hvis op == "*" { returner _fmt_real(x * y) }
        hvis op == "/" {
            hvis y == builtin.desimaltall("0") { returner "" }
            returner _fmt_real(x / y)
        }
        returner ""
    }
    la ai = builtin.heltall_fra_tekst(an)
    la bi = builtin.heltall_fra_tekst(bn)
    hvis op == "+" { returner tekst_fra_heltall(ai + bi) }
    hvis op == "-" { returner tekst_fra_heltall(ai - bi) }
    hvis op == "*" { returner tekst_fra_heltall(ai * bi) }
    hvis op == "/" {
        hvis bi == 0 { returner "" }
        returner tekst_fra_heltall(ai / bi)
    }
    returner ""
}

// WHERE-token frå posisjon `start`: liste av (kol, op, verdi) med AND. Returnerer
// sann om rada matchar. Enkel: berre AND, éin op per vilkår.
funksjon _slice_fra(toks, start: heltall) -> liste {
    la ut = []
    la i = start
    mens i < lengde(toks) {
        legg_til(ut, toks[i])
        i = i + 1
    }
    returner ut
}

// SQL LIKE: % = null/fleire teikn, _ = eitt teikn, case-insensitiv (ASCII).
funksjon _like(verdi: tekst, monster: tekst) -> boolsk {
    la s = builtin.split(_opp(verdi), "")
    la p = builtin.split(_opp(monster), "")
    la n = lengde(s)
    la m = lengde(p)
    la i = 0
    la j = 0
    la star = -1
    la match_i = 0
    mens i < n {
        hvis j < m og (p[j] == "_" eller p[j] == s[i]) {
            i = i + 1
            j = j + 1
        } ellers hvis j < m og p[j] == "%" {
            star = j
            match_i = i
            j = j + 1
        } ellers hvis star >= 0 {
            j = star + 1
            match_i = match_i + 1
            i = match_i
        } ellers {
            returner usann
        }
    }
    mens j < m og p[j] == "%" { j = j + 1 }
    returner j == m
}

// SQL GLOB: * = null/fleire, ? = eitt teikn, [..] teiknklasse ([^..] negert, a-z range),
// CASE-SENSITIV (i motsetnad til LIKE). Éi pattern-eining = literal / ? / [..].
// Returnerer {"match": bool, "next": indeks etter eininga}.
funksjon _glob_unit(p, j: heltall, ch: tekst) -> ordbok {
    la c = p[j]
    hvis c == "?" { returner {"match": sann, "next": j + 1} }
    hvis c == "[" {
        la k = j + 1
        la neg = usann
        hvis k < lengde(p) og p[k] == "^" { neg = sann; k = k + 1 }
        la treff = usann
        la forste = sann
        mens k < lengde(p) og (p[k] != "]" eller forste) {
            forste = usann
            hvis k + 2 < lengde(p) og p[k + 1] == "-" og p[k + 2] != "]" {
                la lo = builtin.char_code(p[k])
                la hi = builtin.char_code(p[k + 2])
                la cc = builtin.char_code(ch)
                hvis cc >= lo og cc <= hi { treff = sann }
                k = k + 3
            } ellers {
                hvis ch == p[k] { treff = sann }
                k = k + 1
            }
        }
        hvis k < lengde(p) og p[k] == "]" { k = k + 1 }
        hvis neg { treff = _ikke(treff) }
        returner {"match": treff, "next": k}
    }
    returner {"match": (ch == c), "next": j + 1}
}

funksjon _glob(verdi: tekst, monster: tekst) -> boolsk {
    la s = builtin.split(verdi, "")
    la p = builtin.split(monster, "")
    la n = lengde(s)
    la m = lengde(p)
    la i = 0
    la j = 0
    la star = 0 - 1
    la match_i = 0
    mens i < n {
        hvis j < m og p[j] != "*" {
            la u = _glob_unit(p, j, s[i])
            hvis u["match"] {
                i = i + 1
                j = u["next"]
            } ellers hvis star >= 0 {
                j = star + 1
                match_i = match_i + 1
                i = match_i
            } ellers {
                returner usann
            }
        } ellers hvis j < m og p[j] == "*" {
            star = j
            match_i = i
            j = j + 1
        } ellers hvis star >= 0 {
            j = star + 1
            match_i = match_i + 1
            i = match_i
        } ellers {
            returner usann
        }
    }
    mens j < m og p[j] == "*" { j = j + 1 }
    returner j == m
}

// ── Uttrykks-evaluator (Fase 7a/7b) ──────────────────────────────────
// Recursive-descent med presedens: cmp → concat(||) → add(+-) → mul(*/%) → unary → primær.
// Evaluerer mot ei rad. Verdiar er strengar ("1"/"0" boolsk, "" tomt). Re-parsar per rad.
funksjon _truthy(v: tekst) -> boolsk {
    hvis _ern(v) { returner usann }
    returner v != "" og v != "0"
}

funksjon _ex_prim(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    hvis pos >= lengde(toks) { returner {"v": "", "n": pos} }
    la t = toks[pos]
    hvis _er_tal(t) { returner {"v": t, "n": pos + 1} }
    // BLOB-literal x'…' → dekod hex til bytes-streng (string-lagring; typeof forblir text).
    hvis lengde(t) >= 3 og builtin.lower(builtin.slice(t, 0, 2)) == "x'" {
        returner {"v": _blob_decode(builtin.slice(t, 2, lengde(t) - 1)), "n": pos + 1}
    }
    hvis lengde(t) >= 2 og builtin.slice(t, 0, 1) == "'" { returner {"v": _unquote(t), "n": pos + 1} }
    // NULL-literal → sentinel (3-verdi NULL).
    hvis _opp(t) == "NULL" { returner {"v": _NULLV(), "n": pos + 1} }
    // EXISTS (SELECT …) → "1"/"0"
    hvis _opp(t) == "EXISTS" og pos + 1 < lengde(toks) og toks[pos + 1] == "(" {
        la sub = _slice_paren(toks, pos + 1)
        la n = _subq_rader(kt["db"], sub["inner"], rad)
        returner {"v": _b(lengde(n) > 0), "n": sub["etter"]}
    }
    hvis t == "(" {
        // Skalar subquery: ( SELECT … ) → første kolonne av første rad, elles "".
        hvis pos + 1 < lengde(toks) og _opp(toks[pos + 1]) == "SELECT" {
            la sub = _slice_paren(toks, pos)
            la verdiar = _subq_verdiar(kt["db"], sub["inner"], rad)
            la sv = ""
            hvis lengde(verdiar) > 0 { sv = verdiar[0] }
            returner {"v": sv, "n": sub["etter"]}
        }
        la e = _ex_or(toks, pos + 1, rad, kt)
        la nn = e["n"]
        hvis nn < lengde(toks) og toks[nn] == ")" { nn = nn + 1 }
        returner {"v": e["v"], "n": nn}
    }
    hvis _opp(t) == "CASE" { returner _ex_case(toks, pos, rad, kt) }
    hvis pos + 1 < lengde(toks) og toks[pos + 1] == "(" { returner _ex_func(toks, pos, rad, kt) }
    la v = ""
    hvis finnes_nøkkel(rad, t) {
        v = rad[t]
    } ellers hvis _kolnavn(t) != t {
        // Kvalifisert namn ("scope.kol"): bind til rett scope — indre om prefikset er
        // denne tabellen/aliaset, elles ytre (korrelasjon). Fell attende til indre til slutt.
        la kn = _kolnavn(t)
        la kval = _kolprefiks(t)
        la denne = finnes_nøkkel(kt, "navn") og (kval == kt["navn"] eller (finnes_nøkkel(kt, "alias") og kt["alias"] != "" og kval == kt["alias"]))
        hvis denne {
            hvis finnes_nøkkel(rad, kn) { v = rad[kn] }
        } ellers hvis finnes_nøkkel(kt, "ytre") og finnes_nøkkel(kt["ytre"], t) {
            v = kt["ytre"][t]
        } ellers hvis finnes_nøkkel(kt, "ytre") og finnes_nøkkel(kt["ytre"], kn) {
            v = kt["ytre"][kn]
        } ellers hvis finnes_nøkkel(rad, kn) {
            v = rad[kn]
        }
    } ellers hvis finnes_nøkkel(kt, "ytre") og finnes_nøkkel(kt["ytre"], t) {
        v = kt["ytre"][t]
    } ellers {
        v = _sql_konstant(t)
    }
    returner {"v": v, "n": pos + 1}
}

// Namnlause SQL-konstantar (når namnet ikkje er ein kolonne): CURRENT_TIMESTAMP/
// CURRENT_DATE/CURRENT_TIME (UTC, som SQLite) og TRUE/FALSE (1/0).
funksjon _sql_konstant(t: tekst) -> tekst {
    la u = _opp(t)
    hvis u == "CURRENT_TIMESTAMP" { returner _kall_funksjon("DATETIME", ["now"]) }
    hvis u == "CURRENT_DATE" { returner _kall_funksjon("DATE", ["now"]) }
    hvis u == "CURRENT_TIME" { returner _kall_funksjon("TIME", ["now"]) }
    hvis u == "TRUE" { returner "1" }
    hvis u == "FALSE" { returner "0" }
    returner ""
}

// Postfix `::type`-cast (Postgres). Typen ignorerast (dynamisk typing) — vi konsumerer
// berre typenamnet (evt. `(n[,m])` eller `[]`) så resten av uttrykket parsar vidare.
funksjon _ex_postfix(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la e = _ex_prim(toks, pos, rad, kt)
    la p = e["n"]
    mens p < lengde(toks) og toks[p] == "::" {
        p = p + 1
        hvis p < lengde(toks) { p = p + 1 }
        hvis p < lengde(toks) og toks[p] == "(" {
            la dybde = 0
            la gaa = sann
            mens p < lengde(toks) og gaa {
                hvis toks[p] == "(" { dybde = dybde + 1 }
                hvis toks[p] == ")" { dybde = dybde - 1 }
                p = p + 1
                hvis dybde == 0 { gaa = usann }
            }
        }
        mens p < lengde(toks) og toks[p] == "[" {
            mens p < lengde(toks) og toks[p] != "]" { p = p + 1 }
            hvis p < lengde(toks) og toks[p] == "]" { p = p + 1 }
        }
    }
    returner {"v": e["v"], "n": p}
}

funksjon _ex_unary(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    hvis pos < lengde(toks) og toks[pos] == "-" {
        la e = _ex_postfix(toks, pos + 1, rad, kt)
        returner {"v": _num_bin("0", "-", e["v"]), "n": e["n"]}
    }
    returner _ex_postfix(toks, pos, rad, kt)
}

funksjon _ex_mul(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la l = _ex_unary(toks, pos, rad, kt)
    la p = l["n"]
    la akk = l["v"]
    mens p < lengde(toks) og (toks[p] == "*" eller toks[p] == "/" eller toks[p] == "%") {
        la op = toks[p]
        la r = _ex_unary(toks, p + 1, rad, kt)
        akk = _num_bin(akk, op, r["v"])
        p = r["n"]
    }
    returner {"v": akk, "n": p}
}

funksjon _ex_add(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la l = _ex_mul(toks, pos, rad, kt)
    la p = l["n"]
    la akk = l["v"]
    mens p < lengde(toks) og (toks[p] == "+" eller toks[p] == "-") {
        la op = toks[p]
        la r = _ex_mul(toks, p + 1, rad, kt)
        akk = _num_bin(akk, op, r["v"])
        p = r["n"]
    }
    returner {"v": akk, "n": p}
}

funksjon _ex_concat(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la l = _ex_add(toks, pos, rad, kt)
    la p = l["n"]
    la akk = l["v"]
    mens p < lengde(toks) og toks[p] == "||" {
        la r = _ex_add(toks, p + 1, rad, kt)
        // SQLite: konkat med NULL → NULL.
        hvis _ern(akk) eller _ern(r["v"]) { akk = _NULLV() } ellers { akk = akk + r["v"] }
        p = r["n"]
    }
    returner {"v": akk, "n": p}
}

funksjon _b(b: boolsk) -> tekst { hvis b { returner "1" } returner "0" }
funksjon _ikke(b: boolsk) -> boolsk { hvis b { returner usann } returner sann }

// Samanlikningsnivå: = != <> < <= > >=, LIKE, IN, BETWEEN, IS [NOT] NULL, m/ infiks-NOT.
funksjon _ex_cmp(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la l = _ex_concat(toks, pos, rad, kt)
    la p = l["n"]
    hvis p >= lengde(toks) { returner l }

    la neg = usann
    hvis _opp(toks[p]) == "NOT" og p + 1 < lengde(toks) {
        la nx = _opp(toks[p + 1])
        hvis nx == "IN" eller nx == "LIKE" eller nx == "ILIKE" eller nx == "GLOB" eller nx == "BETWEEN" {
            neg = sann
            p = p + 1
        }
    }
    la op = toks[p]
    la opp = _opp(op)

    hvis op == "=" eller op == "!=" eller op == "<>" eller op == "<" eller op == "<=" eller op == ">" eller op == ">=" {
        la r = _ex_concat(toks, p + 1, rad, kt)
        returner {"v": _b(_cmp(l["v"], op, r["v"])), "n": r["n"]}
    }
    hvis opp == "LIKE" eller opp == "ILIKE" {
        // ILIKE = eksplisitt case-insensitiv (Postgres). _like uppercaser alt → same åtferd.
        la r = _ex_concat(toks, p + 1, rad, kt)
        la res = _like(l["v"], r["v"])
        hvis neg { res = _ikke(res) }
        returner {"v": _b(res), "n": r["n"]}
    }
    hvis opp == "GLOB" {
        la r = _ex_concat(toks, p + 1, rad, kt)
        la res = _glob(l["v"], r["v"])
        hvis neg { res = _ikke(res) }
        returner {"v": _b(res), "n": r["n"]}
    }
    hvis opp == "IN" {
        // IN (SELECT …) → medlemskap i subquery-resultat.
        hvis p + 1 < lengde(toks) og toks[p + 1] == "(" og p + 2 < lengde(toks) og _opp(toks[p + 2]) == "SELECT" {
            la sub = _slice_paren(toks, p + 1)
            la verdiar = _subq_verdiar(kt["db"], sub["inner"], rad)
            la funnet = usann
            la vi = 0
            mens vi < lengde(verdiar) {
                hvis _cmp(l["v"], "=", verdiar[vi]) { funnet = sann }
                vi = vi + 1
            }
            hvis neg { funnet = _ikke(funnet) }
            returner {"v": _b(funnet), "n": sub["etter"]}
        }
        la j = p + 1
        hvis j < lengde(toks) og toks[j] == "(" { j = j + 1 }
        la funnet = usann
        mens j < lengde(toks) og toks[j] != ")" {
            hvis toks[j] == "," {
                j = j + 1
            } ellers {
                la e = _ex_concat(toks, j, rad, kt)
                hvis _cmp(l["v"], "=", e["v"]) { funnet = sann }
                j = e["n"]
            }
        }
        hvis j < lengde(toks) og toks[j] == ")" { j = j + 1 }
        hvis neg { funnet = _ikke(funnet) }
        returner {"v": _b(funnet), "n": j}
    }
    hvis opp == "BETWEEN" {
        la a = _ex_concat(toks, p + 1, rad, kt)
        la q = a["n"]
        hvis q < lengde(toks) og _opp(toks[q]) == "AND" { q = q + 1 }
        la bb = _ex_concat(toks, q, rad, kt)
        la res = _cmp(l["v"], ">=", a["v"]) og _cmp(l["v"], "<=", bb["v"])
        hvis neg { res = _ikke(res) }
        returner {"v": _b(res), "n": bb["n"]}
    }
    hvis opp == "IS" {
        la q = p + 1
        la isnot = usann
        hvis q < lengde(toks) og _opp(toks[q]) == "NOT" { isnot = sann; q = q + 1 }
        hvis q < lengde(toks) og _opp(toks[q]) == "NULL" { q = q + 1 }
        la ernull = _ern(l["v"])
        hvis isnot { ernull = _ikke(ernull) }
        returner {"v": _b(ernull), "n": q}
    }
    returner l
}

funksjon _ex_not(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    hvis pos < lengde(toks) og _opp(toks[pos]) == "NOT" {
        la e = _ex_cmp(toks, pos + 1, rad, kt)
        returner {"v": _b(_ikke(_truthy(e["v"]))), "n": e["n"]}
    }
    returner _ex_cmp(toks, pos, rad, kt)
}

funksjon _ex_and(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la l = _ex_not(toks, pos, rad, kt)
    la p = l["n"]
    hvis p >= lengde(toks) eller _opp(toks[p]) != "AND" { returner l }
    la akk = _truthy(l["v"])
    mens p < lengde(toks) og _opp(toks[p]) == "AND" {
        la r = _ex_not(toks, p + 1, rad, kt)
        akk = akk og _truthy(r["v"])
        p = r["n"]
    }
    returner {"v": _b(akk), "n": p}
}

funksjon _ex_or(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la l = _ex_and(toks, pos, rad, kt)
    la p = l["n"]
    hvis p >= lengde(toks) eller _opp(toks[p]) != "OR" { returner l }
    la akk = _truthy(l["v"])
    mens p < lengde(toks) og _opp(toks[p]) == "OR" {
        la r = _ex_and(toks, p + 1, rad, kt)
        akk = akk eller _truthy(r["v"])
        p = r["n"]
    }
    returner {"v": _b(akk), "n": p}
}

funksjon _ex_case(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la p = pos + 1
    la resultat = ""
    la satt = usann
    mens p < lengde(toks) og _opp(toks[p]) == "WHEN" {
        la c = _ex_or(toks, p + 1, rad, kt)
        p = c["n"]
        hvis p < lengde(toks) og _opp(toks[p]) == "THEN" { p = p + 1 }
        la v = _ex_or(toks, p, rad, kt)
        p = v["n"]
        hvis ikke satt og _truthy(c["v"]) {
            resultat = v["v"]
            satt = sann
        }
    }
    hvis p < lengde(toks) og _opp(toks[p]) == "ELSE" {
        la e = _ex_or(toks, p + 1, rad, kt)
        p = e["n"]
        hvis ikke satt { resultat = e["v"] }
    }
    hvis p < lengde(toks) og _opp(toks[p]) == "END" { p = p + 1 }
    returner {"v": resultat, "n": p}
}

funksjon _ex_func(toks, pos: heltall, rad, kt) -> ordbok_tekst {
    la fn = _opp(toks[pos])
    la p = pos + 2
    hvis fn == "CAST" {
        la e = _ex_or(toks, p, rad, kt)
        p = e["n"]
        mens p < lengde(toks) og toks[p] != ")" { p = p + 1 }
        hvis p < lengde(toks) og toks[p] == ")" { p = p + 1 }
        returner {"v": e["v"], "n": p}
    }
    la args = []
    mens p < lengde(toks) og toks[p] != ")" {
        hvis toks[p] == "," { p = p + 1; fortsett }
        la e = _ex_or(toks, p, rad, kt)
        legg_til(args, e["v"])
        p = e["n"]
    }
    hvis p < lengde(toks) og toks[p] == ")" { p = p + 1 }
    // Sekvens-funksjonar treng db-konteksten (mutasjon) — handter før den reine dispatchen.
    hvis finnes_nøkkel(kt, "db") {
        hvis fn == "NEXTVAL" og lengde(args) >= 1 { returner {"v": _seq_nextval(kt["db"], args[0]), "n": p} }
        hvis fn == "CURRVAL" og lengde(args) >= 1 { returner {"v": _seq_currval(kt["db"], args[0]), "n": p} }
        hvis fn == "SETVAL" og lengde(args) >= 2 { returner {"v": _seq_setval(kt["db"], args[0], builtin.heltall_fra_tekst(args[1])), "n": p} }
        hvis fn == "LAST_INSERT_ROWID" {
            la lr = 0
            hvis finnes_nøkkel(kt["db"], "_siste_rowid") { lr = kt["db"]["_siste_rowid"] }
            returner {"v": tekst_fra_heltall(lr), "n": p}
        }
    }
    returner {"v": _kall_funksjon(fn, args), "n": p}
}

// ── Dato/tid (SQLite-kompatibel delmengd) ────────────────────────────
// Kalendermatte via Hinnant (civil ↔ dagar sidan epoch), skotår-korrekt for y>=1970.
// Lagringa er strengbasert, so verdiane er ISO-tekst; epoch-heltal berre internt.
funksjon _imod(a: heltall, b: heltall) -> heltall { returner a - (a / b) * b }

// heltall_fra_tekst tolkar leiande null som oktal ("08"/"09" feilar) — strip nullar først.
funksjon _num0(s: tekst) -> heltall {
    la t = s
    mens lengde(t) > 1 og builtin.slice(t, 0, 1) == "0" { t = builtin.slice(t, 1, lengde(t)) }
    returner builtin.heltall_fra_tekst(t)
}

funksjon _pad(n: heltall, bredde: heltall) -> tekst {
    la s = tekst_fra_heltall(n)
    mens lengde(builtin.split(s, "")) < bredde { s = "0" + s }
    returner s
}

funksjon _days_from_civil(y0: heltall, m: heltall, d: heltall) -> heltall {
    la y = y0
    hvis m <= 2 { y = y - 1 }
    la era = y / 400
    la yoe = y - era * 400
    la mm = m + 9
    hvis m > 2 { mm = m - 3 }
    la doy = (153 * mm + 2) / 5 + d - 1
    la doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    returner era * 146097 + doe - 719468
}

funksjon _civil_from_days(z0: heltall) -> ordbok {
    la z = z0 + 719468
    la era = z / 146097
    la doe = z - era * 146097
    la yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    la y = yoe + era * 400
    la doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    la mp = (5 * doy + 2) / 153
    la d = doy - (153 * mp + 2) / 5 + 1
    la m = mp + 3
    hvis mp >= 10 { m = mp - 9 }
    hvis m <= 2 { y = y + 1 }
    returner {"y": y, "m": m, "d": d}
}

// Parse ISO ('YYYY-MM-DD', med valfri ' '/'T' + 'HH:MM[:SS]'), 'now', eller unix-heiltal.
funksjon _dt_parse_val(x: tekst, unixep: boolsk) -> heltall {
    la xl = builtin.lower(builtin.trim(x))
    hvis xl == "now" { returner builtin.timestamp() }
    // unixepoch kan vere flyt (t.d. 1705322096.789) — berre heiltals-sekund tel her;
    // fraksjonen hentar _dt_frac_ms separat.
    hvis unixep og _er_tal(x) { returner builtin.heltall_fra_tekst(builtin.split(x, ".")[0]) }
    la del = builtin.split(x, "T")
    hvis lengde(del) == 1 { del = builtin.split(x, " ") }
    la dp = builtin.split(del[0], "-")
    hvis lengde(dp) < 3 { returner 0 }
    la y = _num0(dp[0])
    la mo = _num0(dp[1])
    la dagnr = _num0(dp[2])
    la hh = 0
    la mi = 0
    la ss = 0
    hvis lengde(del) >= 2 {
        la tp = builtin.split(del[1], ":")
        hvis lengde(tp) >= 1 { hh = _num0(tp[0]) }
        hvis lengde(tp) >= 2 { mi = _num0(tp[1]) }
        // Sekund-feltet kan ha fraksjon (SS.SSS) — strip han før heiltals-parsing.
        hvis lengde(tp) >= 3 { ss = _num0(builtin.split(tp[2], ".")[0]) }
    }
    returner _days_from_civil(y, mo, dagnr) * 86400 + hh * 3600 + mi * 60 + ss
}

funksjon _dt_mod(epoch: heltall, mod: tekst) -> heltall {
    la m = builtin.lower(builtin.trim(mod))
    hvis m == "unixepoch" eller m == "localtime" eller m == "utc" { returner epoch }
    hvis lengde(m) >= 9 og builtin.slice(m, 0, 9) == "start of " {
        la enhet = builtin.slice(m, 9, lengde(m))
        la dag = epoch / 86400
        la c = _civil_from_days(dag)
        hvis enhet == "day" { returner dag * 86400 }
        hvis enhet == "month" { returner _days_from_civil(c["y"], c["m"], 1) * 86400 }
        hvis enhet == "year" { returner _days_from_civil(c["y"], 1, 1) * 86400 }
        returner epoch
    }
    hvis lengde(m) >= 8 og builtin.slice(m, 0, 8) == "weekday " {
        la mål = _num0(builtin.slice(m, 8, lengde(m)))
        la dag = epoch / 86400
        la cur = _imod(dag + 4, 7)
        la delta = _imod(mål - cur + 7, 7)
        returner epoch + delta * 86400
    }
    la deler = builtin.split(m, " ")
    hvis lengde(deler) < 2 { returner epoch }
    la tal_s = deler[0]
    hvis lengde(tal_s) >= 1 og builtin.slice(tal_s, 0, 1) == "+" { tal_s = builtin.slice(tal_s, 1, lengde(tal_s)) }
    la n = builtin.heltall_fra_tekst(tal_s)
    la enhet = deler[1]
    hvis lengde(enhet) >= 1 og builtin.slice(enhet, lengde(enhet) - 1, lengde(enhet)) == "s" {
        enhet = builtin.slice(enhet, 0, lengde(enhet) - 1)
    }
    hvis enhet == "day" { returner epoch + n * 86400 }
    hvis enhet == "hour" { returner epoch + n * 3600 }
    hvis enhet == "minute" { returner epoch + n * 60 }
    hvis enhet == "second" { returner epoch + n }
    hvis enhet == "month" eller enhet == "year" {
        la dag = epoch / 86400
        la tod = epoch - dag * 86400
        la c = _civil_from_days(dag)
        la ny_y = c["y"]
        la ny_m = c["m"]
        hvis enhet == "year" { ny_y = ny_y + n }
        hvis enhet == "month" {
            la tot = ny_y * 12 + (ny_m - 1) + n
            la q = tot / 12
            la r = tot - q * 12
            hvis r < 0 { r = r + 12; q = q - 1 }
            ny_y = q
            ny_m = r + 1
        }
        returner _days_from_civil(ny_y, ny_m, c["d"]) * 86400 + tod
    }
    returner epoch
}

// Fraksjons-millisekund (0–999) frå eit tid-/tal-uttrykk. SS.SSS: berre dei tre
// første siffera etter siste '.' tel; kortare fraksjon høgre-padast (".5" → 500).
funksjon _dt_frac_ms(x: tekst) -> heltall {
    la p = builtin.split(builtin.trim(x), ".")
    hvis lengde(p) < 2 { returner 0 }
    la frac = p[lengde(p) - 1]
    la d = ""
    la i = 0
    la gyldig = sann
    mens i < lengde(frac) og i < 3 og gyldig {
        la ch = builtin.slice(frac, i, i + 1)
        hvis _er_siffer(ch) { d = d + ch } ellers { gyldig = usann }
        i = i + 1
    }
    hvis d == "" { returner 0 }
    mens lengde(d) < 3 { d = d + "0" }
    returner builtin.heltall_fra_tekst(d)
}

// Løyser eit dato/tid-uttrykk til epoke i MILLISEKUND (heiltals-sekund × 1000 +
// fraksjon). Modifikatorane opererer i heiltals-sekund; fraksjonen ligg ved med,
// men 'start of …' nullstiller han (tid-på-dagen vert 00:00:00.000).
funksjon _dt_resolve(args, timeidx: heltall) -> heltall {
    hvis timeidx >= lengde(args) { returner 0 }
    la unixep = usann
    la i = timeidx + 1
    mens i < lengde(args) {
        hvis builtin.lower(builtin.trim(args[i])) == "unixepoch" { unixep = sann }
        i = i + 1
    }
    la epoch = _dt_parse_val(args[timeidx], unixep)
    la frac = _dt_frac_ms(args[timeidx])
    i = timeidx + 1
    mens i < lengde(args) {
        la ml = builtin.lower(builtin.trim(args[i]))
        hvis lengde(ml) >= 9 og builtin.slice(ml, 0, 9) == "start of " { frac = 0 }
        epoch = _dt_mod(epoch, args[i])
        i = i + 1
    }
    returner epoch * 1000 + frac
}

// `ms` = epoke i millisekund (jf. _dt_resolve).
funksjon _dt_fmt(ms: heltall, fmt: tekst) -> tekst {
    la epoch = ms / 1000
    la dag = ms / 86400000
    la tod_ms = ms - dag * 86400000
    la c = _civil_from_days(dag)
    la hh = tod_ms / 3600000
    la mi = (tod_ms - hh * 3600000) / 60000
    la ss = (tod_ms - hh * 3600000 - mi * 60000) / 1000
    la frac_ms = tod_ms - hh * 3600000 - mi * 60000 - ss * 1000
    la ut = ""
    la fc = builtin.split(fmt, "")
    la i = 0
    mens i < lengde(fc) {
        hvis fc[i] == "%" og i + 1 < lengde(fc) {
            la spec = fc[i + 1]
            hvis spec == "Y" { ut = ut + _pad(c["y"], 4) } ellers
            hvis spec == "m" { ut = ut + _pad(c["m"], 2) } ellers
            hvis spec == "d" { ut = ut + _pad(c["d"], 2) } ellers
            hvis spec == "H" { ut = ut + _pad(hh, 2) } ellers
            hvis spec == "M" { ut = ut + _pad(mi, 2) } ellers
            hvis spec == "S" { ut = ut + _pad(ss, 2) } ellers
            hvis spec == "j" { ut = ut + _pad(dag - _days_from_civil(c["y"], 1, 1) + 1, 3) } ellers
            hvis spec == "w" { ut = ut + tekst_fra_heltall(_imod(dag + 4, 7)) } ellers
            hvis spec == "s" { ut = ut + tekst_fra_heltall(epoch) } ellers
            hvis spec == "f" { ut = ut + _pad(ss, 2) + "." + _pad(frac_ms, 3) } ellers
            hvis spec == "%" { ut = ut + "%" } ellers { ut = ut + "%" + spec }
            i = i + 2
        } ellers {
            ut = ut + fc[i]
            i = i + 1
        }
    }
    returner ut
}

funksjon _kall_funksjon(fn: tekst, args) -> tekst {
    hvis fn == "DATE" og lengde(args) >= 1 { returner _dt_fmt(_dt_resolve(args, 0), "%Y-%m-%d") }
    hvis fn == "TIME" og lengde(args) >= 1 { returner _dt_fmt(_dt_resolve(args, 0), "%H:%M:%S") }
    hvis fn == "DATETIME" og lengde(args) >= 1 { returner _dt_fmt(_dt_resolve(args, 0), "%Y-%m-%d %H:%M:%S") }
    hvis fn == "STRFTIME" og lengde(args) >= 2 { returner _dt_fmt(_dt_resolve(args, 1), args[0]) }
    hvis fn == "UNIXEPOCH" og lengde(args) >= 1 { returner tekst_fra_heltall(_dt_resolve(args, 0) / 1000) }
    hvis fn == "JULIANDAY" og lengde(args) >= 1 {
        // _dt_resolve gjev millisekund → del på 86 400 000 ms/dag (fraksjons-korrekt).
        la ep = _dt_resolve(args, 0)
        la jd = builtin.desimaltall(tekst_fra_heltall(ep)) / builtin.desimaltall("86400000") + builtin.desimaltall("2440587.5")
        returner _fmt_real(jd)
    }
    hvis fn == "COALESCE" {
        la i = 0
        mens i < lengde(args) {
            hvis ikke _ern(args[i]) { returner args[i] }
            i = i + 1
        }
        returner _NULLV()
    }
    hvis fn == "UPPER" { hvis lengde(args) > 0 { returner builtin.upper(args[0]) } returner "" }
    hvis fn == "LOWER" { hvis lengde(args) > 0 { returner builtin.lower(args[0]) } returner "" }
    hvis fn == "LENGTH" { hvis lengde(args) > 0 { returner tekst_fra_heltall(lengde(builtin.split(args[0], ""))) } returner "0" }
    hvis fn == "ABS" {
        hvis lengde(args) > 0 {
            la a = builtin.heltall_fra_tekst(args[0])
            hvis a < 0 { returner tekst_fra_heltall(0 - a) }
            returner tekst_fra_heltall(a)
        }
        returner "0"
    }
    hvis fn == "SUBSTR" og lengde(args) >= 2 {
        la s = args[0]
        la slen = lengde(builtin.split(s, ""))
        la p1 = builtin.heltall_fra_tekst(args[1])
        la start = p1 - 1
        hvis p1 < 0 { start = slen + p1 }
        hvis start < 0 { start = 0 }
        la slutt = slen
        hvis lengde(args) >= 3 { slutt = start + builtin.heltall_fra_tekst(args[2]) }
        hvis slutt > slen { slutt = slen }
        hvis start > slen { returner "" }
        hvis slutt < start { returner "" }
        returner builtin.slice(s, start, slutt)
    }
    hvis fn == "REPLACE" og lengde(args) >= 3 {
        returner builtin.join(builtin.split(args[0], args[1]), args[2])
    }
    hvis fn == "CHAR" og lengde(args) >= 1 {
        la ut = ""
        la i = 0
        mens i < lengde(args) {
            ut = ut + builtin.chr(builtin.heltall_fra_tekst(args[i]))
            i = i + 1
        }
        returner ut
    }
    hvis fn == "TRIM" og lengde(args) >= 1 { returner builtin.trim(args[0]) }
    hvis fn == "LTRIM" og lengde(args) >= 1 { returner _ltrim(args[0]) }
    hvis fn == "RTRIM" og lengde(args) >= 1 { returner _rtrim(args[0]) }
    hvis fn == "INSTR" og lengde(args) >= 2 {
        la idx = builtin.index_of(args[0], args[1])
        hvis idx < 0 { returner "0" }
        returner tekst_fra_heltall(idx + 1)
    }
    hvis fn == "IFNULL" og lengde(args) >= 2 {
        hvis ikke _ern(args[0]) { returner args[0] }
        returner args[1]
    }
    hvis fn == "NULLIF" og lengde(args) >= 2 {
        hvis args[0] == args[1] { returner _NULLV() }
        returner args[0]
    }
    hvis fn == "HEX" og lengde(args) >= 1 { returner _hex(args[0]) }
    hvis fn == "QUOTE" og lengde(args) >= 1 {
        returner "'" + builtin.join(builtin.split(args[0], "'"), "''") + "'"
    }
    hvis (fn == "MAX" eller fn == "MIN") og lengde(args) >= 2 {
        la best = args[0]
        la i = 1
        mens i < lengde(args) {
            hvis fn == "MAX" og _cmp(args[i], ">", best) { best = args[i] }
            hvis fn == "MIN" og _cmp(args[i], "<", best) { best = args[i] }
            i = i + 1
        }
        returner best
    }
    hvis fn == "PRINTF" eller fn == "FORMAT" {
        hvis lengde(args) == 0 { returner "" }
        returner _printf(args)
    }
    hvis fn == "ROUND" og lengde(args) >= 1 {
        la nd = 0
        hvis lengde(args) >= 2 { nd = builtin.heltall_fra_tekst(args[1]) }
        returner _round_real(args[0], nd)
    }
    hvis fn == "TYPEOF" og lengde(args) >= 1 {
        la v = args[0]
        hvis _ern(v) { returner "null" }
        hvis _er_real(v) { returner "real" }
        hvis _er_tal(v) { returner "integer" }
        returner "text"
    }
    // ── Postgres-utvidingar (batch 1): streng-/tal-funksjonar utover SQLite ──
    hvis fn == "SPLIT_PART" og lengde(args) >= 3 {
        la felt = builtin.split(args[0], args[1])
        la n = builtin.heltall_fra_tekst(args[2])
        hvis n >= 1 og n <= lengde(felt) { returner felt[n - 1] }
        returner ""
    }
    hvis fn == "LEFT" og lengde(args) >= 2 {
        la fc = builtin.split(args[0], "")
        la n = builtin.heltall_fra_tekst(args[1])
        hvis n < 0 { n = lengde(fc) + n }
        hvis n < 0 { n = 0 }
        hvis n > lengde(fc) { n = lengde(fc) }
        returner builtin.slice(args[0], 0, n)
    }
    hvis fn == "RIGHT" og lengde(args) >= 2 {
        la fc = builtin.split(args[0], "")
        la L = lengde(fc)
        la n = builtin.heltall_fra_tekst(args[1])
        la start = L - n
        hvis n < 0 { start = 0 - n }
        hvis start < 0 { start = 0 }
        hvis start > L { start = L }
        returner builtin.slice(args[0], start, L)
    }
    hvis fn == "REPEAT" og lengde(args) >= 2 {
        la n = builtin.heltall_fra_tekst(args[1])
        la ut = ""
        la i = 0
        mens i < n { ut = ut + args[0]; i = i + 1 }
        returner ut
    }
    hvis fn == "REVERSE" og lengde(args) >= 1 {
        la fc = builtin.split(args[0], "")
        la ut = ""
        la i = lengde(fc) - 1
        mens i >= 0 { ut = ut + fc[i]; i = i - 1 }
        returner ut
    }
    hvis fn == "ASCII" og lengde(args) >= 1 {
        la fc = builtin.split(args[0], "")
        hvis lengde(fc) == 0 { returner "0" }
        returner tekst_fra_heltall(builtin.char_code(fc[0]))
    }
    hvis fn == "CHR" og lengde(args) >= 1 { returner builtin.chr(builtin.heltall_fra_tekst(args[0])) }
    hvis fn == "INITCAP" og lengde(args) >= 1 {
        la ord = builtin.split(builtin.lower(args[0]), " ")
        la ut = []
        la i = 0
        mens i < lengde(ord) {
            la w = ord[i]
            la wc = builtin.split(w, "")
            hvis lengde(wc) > 0 {
                legg_til(ut, builtin.upper(wc[0]) + builtin.slice(w, 1, lengde(wc)))
            } ellers {
                legg_til(ut, "")
            }
            i = i + 1
        }
        returner builtin.join(ut, " ")
    }
    hvis (fn == "LPAD" eller fn == "RPAD") og lengde(args) >= 2 {
        la fill = " "
        hvis lengde(args) >= 3 og lengde(args[2]) > 0 { fill = args[2] }
        la mållen = builtin.heltall_fra_tekst(args[1])
        la fc = builtin.split(args[0], "")
        hvis lengde(fc) >= mållen { returner builtin.slice(args[0], 0, mållen) }
        la pad = ""
        mens lengde(builtin.split(pad, "")) < mållen - lengde(fc) { pad = pad + fill }
        pad = builtin.slice(pad, 0, mållen - lengde(fc))
        hvis fn == "LPAD" { returner pad + args[0] }
        returner args[0] + pad
    }
    hvis fn == "STRPOS" og lengde(args) >= 2 {
        la idx = builtin.index_of(args[0], args[1])
        hvis idx < 0 { returner "0" }
        returner tekst_fra_heltall(idx + 1)
    }
    hvis fn == "CONCAT" {
        la ut = ""
        la i = 0
        mens i < lengde(args) { hvis ikke _ern(args[i]) { ut = ut + args[i] }; i = i + 1 }
        returner ut
    }
    hvis fn == "CONCAT_WS" og lengde(args) >= 1 {
        la sep = args[0]
        la deler = []
        la i = 1
        mens i < lengde(args) { hvis ikke _ern(args[i]) { legg_til(deler, args[i]) }; i = i + 1 }
        returner builtin.join(deler, sep)
    }
    hvis fn == "GREATEST" eller fn == "LEAST" {
        la best = _NULLV()
        la har = usann
        la i = 0
        mens i < lengde(args) {
            hvis ikke _ern(args[i]) {
                hvis ikke har {
                    best = args[i]
                    har = sann
                } ellers {
                    hvis fn == "GREATEST" og _cmp(args[i], ">", best) { best = args[i] }
                    hvis fn == "LEAST" og _cmp(args[i], "<", best) { best = args[i] }
                }
            }
            i = i + 1
        }
        returner best
    }
    hvis fn == "TRANSLATE" og lengde(args) >= 3 {
        la dst = builtin.split(args[2], "")
        la sc = builtin.split(args[0], "")
        la ut = ""
        la i = 0
        mens i < lengde(sc) {
            la k = builtin.index_of(args[1], sc[i])
            hvis k < 0 { ut = ut + sc[i] } ellers {
                hvis k < lengde(dst) { ut = ut + dst[k] }
            }
            i = i + 1
        }
        returner ut
    }
    hvis fn == "BTRIM" og lengde(args) >= 1 {
        hvis lengde(args) == 1 { returner builtin.trim(args[0]) }
        la fc = builtin.split(args[0], "")
        la lo = 0
        la hi = lengde(fc)
        mens lo < hi og builtin.index_of(args[1], fc[lo]) >= 0 { lo = lo + 1 }
        mens hi > lo og builtin.index_of(args[1], fc[hi - 1]) >= 0 { hi = hi - 1 }
        returner builtin.slice(args[0], lo, hi)
    }
    hvis fn == "SIGN" og lengde(args) >= 1 {
        hvis _ern(args[0]) { returner _NULLV() }
        hvis _cmp(args[0], ">", "0") { returner "1" }
        hvis _cmp(args[0], "<", "0") { returner "-1" }
        returner "0"
    }
    hvis fn == "MOD" og lengde(args) >= 2 {
        la a = builtin.heltall_fra_tekst(args[0])
        la b = builtin.heltall_fra_tekst(args[1])
        hvis b == 0 { returner _NULLV() }
        returner tekst_fra_heltall(a - (a / b) * b)
    }
    hvis fn == "TO_HEX" og lengde(args) >= 1 {
        la n = builtin.heltall_fra_tekst(args[0])
        hvis n == 0 { returner "0" }
        la dc = builtin.split("0123456789abcdef", "")
        la ut = ""
        la m = n
        mens m > 0 { la r = m - (m / 16) * 16; ut = dc[r] + ut; m = m / 16 }
        returner ut
    }
    hvis (fn == "CEIL" eller fn == "CEILING") og lengde(args) >= 1 {
        hvis _ern(args[0]) { returner _NULLV() }
        la d = builtin.desimaltall(args[0])
        la t = _flyt_trunk(d)
        hvis d > builtin.desimaltall(tekst_fra_heltall(t)) { returner tekst_fra_heltall(t + 1) }
        returner tekst_fra_heltall(t)
    }
    hvis fn == "FLOOR" og lengde(args) >= 1 {
        hvis _ern(args[0]) { returner _NULLV() }
        la d = builtin.desimaltall(args[0])
        la t = _flyt_trunk(d)
        hvis d < builtin.desimaltall(tekst_fra_heltall(t)) { returner tekst_fra_heltall(t - 1) }
        returner tekst_fra_heltall(t)
    }
    hvis fn == "TRUNC" og lengde(args) >= 1 {
        hvis _ern(args[0]) { returner _NULLV() }
        returner tekst_fra_heltall(_flyt_trunk(builtin.desimaltall(args[0])))
    }
    hvis (fn == "POWER" eller fn == "POW") og lengde(args) >= 2 {
        la base = builtin.desimaltall(args[0])
        la e = builtin.heltall_fra_tekst(args[1])
        la neg = usann
        hvis e < 0 { neg = sann; e = 0 - e }
        la acc = builtin.desimaltall("1")
        la k = 0
        mens k < e { acc = acc * base; k = k + 1 }
        hvis neg { acc = builtin.desimaltall("1") / acc }
        returner _rund_15_sig(builtin.til_tekst(acc))
    }
    hvis fn == "DIV" og lengde(args) >= 2 {
        la bi = builtin.heltall_fra_tekst(args[1])
        hvis bi == 0 { returner _NULLV() }
        returner tekst_fra_heltall(builtin.heltall_fra_tekst(args[0]) / bi)
    }
    hvis fn == "PI" { returner "3.141592653589793" }
    returner ""
}

// ROUND(x, nd): rund halv bort frå null via IEEE-flyt (matchar SQLite si double-avrunding).
// Resultatet er alltid REAL (har "."). nd < 0 ikkje støtta.
funksjon _round_real(s: tekst, nd: heltall) -> tekst {
    hvis ikke _er_tal(s) { returner "0.0" }
    la x = builtin.desimaltall(s)
    la faktor = builtin.desimaltall("1")
    la ti = builtin.desimaltall("10")
    la k = 0
    mens k < nd { faktor = faktor * ti; k = k + 1 }
    la skalert = x * faktor
    la half = builtin.desimaltall("0.5")
    la rundet_i = 0
    hvis skalert < builtin.desimaltall("0") { rundet_i = _flyt_trunk(skalert - half) } ellers { rundet_i = _flyt_trunk(skalert + half) }
    la resultat = builtin.desimaltall(tekst_fra_heltall(rundet_i)) / faktor
    returner _fmt_real(resultat)
}

// LTRIM/RTRIM — berre mellomrom (SQLite-default), ingen builtin finst.
funksjon _ltrim(s: tekst) -> tekst {
    la ch = builtin.split(s, "")
    la i = 0
    mens i < lengde(ch) og (ch[i] == " " eller ch[i] == "\t" eller ch[i] == "\n" eller ch[i] == "\r") { i = i + 1 }
    returner builtin.slice(s, i, lengde(s))
}

funksjon _rtrim(s: tekst) -> tekst {
    la ch = builtin.split(s, "")
    la j = lengde(ch)
    mens j > 0 og (ch[j - 1] == " " eller ch[j - 1] == "\t" eller ch[j - 1] == "\n" eller ch[j - 1] == "\r") { j = j - 1 }
    returner builtin.slice(s, 0, j)
}

funksjon _hex_siffer(n: heltall) -> tekst {
    la d = "0123456789ABCDEF"
    returner builtin.slice(d, n, n + 1)
}

funksjon _hex(s: tekst) -> tekst {
    la ch = builtin.split(s, "")
    la ut = ""
    la i = 0
    mens i < lengde(ch) {
        la k = builtin.char_code(ch[i])
        ut = ut + _hex_siffer(k / 16) + _hex_siffer(k % 16)
        i = i + 1
    }
    returner ut
}

// Formatér flyt med NØYAKTIG nd desimalar (for printf %f).
funksjon _fmt_f(s: tekst, nd: heltall) -> tekst {
    la r = _round_real(s, nd)
    la d = builtin.index_of(r, ".")
    hvis nd == 0 {
        hvis d >= 0 { returner builtin.slice(r, 0, d) }
        returner r
    }
    hvis d < 0 { r = r + "."; d = lengde(r) - 1 }
    la desimaler = lengde(r) - d - 1
    mens desimaler < nd { r = r + "0"; desimaler = desimaler + 1 }
    returner r
}

// printf/format: %d %i %s %x %X %f %% + valfri breidde/presisjon/null-padding (%5d, %05d, %-5d, %.2f).
funksjon _printf(args) -> tekst {
    la fmt = args[0]
    la ch = builtin.split(fmt, "")
    la n = lengde(ch)
    la ut = ""
    la ai = 1
    la i = 0
    mens i < n {
        hvis ch[i] != "%" {
            ut = ut + ch[i]
            i = i + 1
            fortsett
        }
        // %-spesifikator: [flagg -][flagg 0][breidde-siffer]*[konv]
        i = i + 1
        hvis i < n og ch[i] == "%" { ut = ut + "%"; i = i + 1; fortsett }
        la venstre = usann
        la null_pad = usann
        mens i < n og (ch[i] == "-" eller ch[i] == "0") {
            hvis ch[i] == "-" { venstre = sann }
            hvis ch[i] == "0" { null_pad = sann }
            i = i + 1
        }
        la breidde = 0
        mens i < n og _er_siffer(ch[i]) { breidde = breidde * 10 + (builtin.char_code(ch[i]) - 48); i = i + 1 }
        la presisjon = 0 - 1
        hvis i < n og ch[i] == "." {
            i = i + 1
            presisjon = 0
            mens i < n og _er_siffer(ch[i]) { presisjon = presisjon * 10 + (builtin.char_code(ch[i]) - 48); i = i + 1 }
        }
        hvis i >= n { bryt }
        la konv = ch[i]
        i = i + 1
        la verdi = ""
        hvis ai < lengde(args) { verdi = args[ai]; ai = ai + 1 }
        la iverdi = 0
        hvis _er_tal(verdi) { iverdi = _flyt_trunk(builtin.desimaltall(verdi)) }
        hvis konv == "d" eller konv == "i" { verdi = tekst_fra_heltall(iverdi) }
        hvis konv == "x" { verdi = _til_hex_tal(iverdi, usann) }
        hvis konv == "X" { verdi = _til_hex_tal(iverdi, sann) }
        hvis konv == "f" {
            la nd = 6
            hvis presisjon >= 0 { nd = presisjon }
            verdi = _fmt_f(verdi, nd)
        }
        // padding
        mens lengde(builtin.split(verdi, "")) < breidde {
            hvis venstre { verdi = verdi + " " }
            ellers hvis null_pad og (konv == "d" eller konv == "i" eller konv == "x" eller konv == "X" eller konv == "f") { verdi = "0" + verdi }
            ellers { verdi = " " + verdi }
        }
        ut = ut + verdi
    }
    returner ut
}

funksjon _til_hex_tal(n: heltall, stor: boolsk) -> tekst {
    hvis n == 0 { returner "0" }
    la neg = usann
    la m = n
    hvis m < 0 { neg = sann; m = 0 - m }
    la ut = ""
    mens m > 0 {
        la d = _hex_siffer(m % 16)
        hvis ikke stor { d = builtin.lower(d) }
        ut = d + ut
        m = m / 16
    }
    hvis neg { ut = "-" + ut }
    returner ut
}

// Kontekst for evaluatoren: `db` (for subqueries) + `ytre` (ytre rad, for korrelasjon).
funksjon _kt_ny(db, ytre) -> ordbok {
    returner {"db": db, "ytre": ytre}
}
funksjon _kt_tom() -> ordbok {
    returner {"db": {}, "ytre": {}}
}

// Offentleg inngang: evaluer eit SQL-uttrykk mot ei rad (utan subquery-kontekst).
funksjon evaluer_uttrykk(uttrykk: tekst, rad) -> tekst {
    la e = _ex_or(_tok(uttrykk), 0, rad, _kt_tom())
    returner _null_ut(e["v"])
}

// WHERE-matcher: ei WHERE-klausul ER eit boolsk uttrykk. Delegerer til uttrykks-
// evaluatoren, som gjev full presedens + parentesar + uttrykk (7a/7c) + subqueries (7d),
// i tillegg til = != <> < <= > >=, LIKE, IN, BETWEEN, IS [NOT] NULL, NOT, AND, OR.
funksjon _match(rad, toks, kt) -> boolsk {
    hvis lengde(toks) == 0 { returner sann }
    returner _truthy(_ex_or(toks, 0, rad, kt)["v"])
}

funksjon _match_fra(rad, toks, start: heltall, kt) -> boolsk {
    returner _match(rad, _slice_fra(toks, start), kt)
}

// ── Subqueries (Fase 7d) ─────────────────────────────────────────────
// Hent tokens mellom balanserte parentesar. `åpen` = indeks til "(".
// Returnerer {"inner": [tokens inni], "etter": indeks etter matchande ")"}.
funksjon _slice_paren(toks, åpen: heltall) -> ordbok {
    la depth = 0
    la inner = []
    la i = åpen
    mens i < lengde(toks) {
        hvis toks[i] == "(" {
            depth = depth + 1
            hvis depth == 1 {
                i = i + 1
                fortsett
            }
        }
        hvis toks[i] == ")" {
            depth = depth - 1
            hvis depth == 0 { returner {"inner": inner, "etter": i + 1} }
        }
        legg_til(inner, toks[i])
        i = i + 1
    }
    returner {"inner": inner, "etter": i}
}

// Projisér eitt select-felt (indeks) frå ei rad til ein tekstverdi.
funksjon _felt_verdi(felt, idx: heltall, rad, kt) -> tekst {
    la k = felt["kind"][idx]
    hvis k == "expr" { returner _ex_or(felt["expr"][idx], 0, rad, kt)["v"] }
    hvis k == "col" {
        la cn = felt["a"][idx]
        hvis finnes_nøkkel(rad, cn) { returner rad[cn] }
        returner ""
    }
    returner ""
}

// Rå rader frå ein subquery (for EXISTS). `subtoks` startar på SELECT.
funksjon _subq_rader(db, subtoks, ytre) -> liste {
    la p = _parse_select(subtoks)
    returner _filtrer_kt(db, p, ytre)
}

// Verdilista frå første select-kolonne i ein subquery (for skalar + IN).
funksjon _subq_verdiar(db, subtoks, ytre) -> liste {
    la p = _parse_select(subtoks)
    la felt = _sel_felt(p["sel_items"])
    la rader = _filtrer_kt(db, p, ytre)
    // Skalar-aggregat utan GROUP → éin verdi.
    hvis lengde(p["group_by"]) == 0 og _har_agg(felt) {
        returner [_agg_txt(rader, felt["a"][0], felt["b"][0], felt["expr"][0])]
    }
    hvis p["order_col"] != "" { rader = _sorter(rader, p["order_col"], p["order_asc"]) }
    rader = _snitt(rader, p["offset"], p["limit"])
    la kt = _kt_ny(db, ytre)
    la ut = []
    la i = 0
    mens i < lengde(rader) {
        legg_til(ut, _felt_verdi(felt, 0, rader[i], kt))
        i = i + 1
    }
    returner ut
}

// Utnamn for eit select-felt: `AS alias`, elles rein kolonne, elles "colN".
funksjon _sel_label(item, idx: heltall, felt) -> tekst {
    la k = 0
    mens k < lengde(item) {
        hvis _opp(item[k]) == "AS" og k + 1 < lengde(item) { returner item[k + 1] }
        k = k + 1
    }
    hvis felt["kind"][idx] == "col" { returner _kolnavn(felt["a"][idx]) }
    returner "col" + tekst_fra_heltall(idx)
}

// Full projeksjon av ein subquery → rader (ordbøker) med namngjevne kolonnar.
// For FROM (SELECT …). Handterer kolonnar/uttrykk/*; GROUP i subquery ikkje støtta her.
funksjon _subq_projiser(db, subtoks, ytre) -> liste {
    la p = _parse_select(subtoks)
    la felt = _sel_felt(p["sel_items"])
    la items = p["sel_items"]
    la rader0 = _filtrer_kt(db, p, ytre)
    hvis p["order_col"] != "" { rader0 = _sorter(rader0, p["order_col"], p["order_asc"]) }
    rader0 = _snitt(rader0, p["offset"], p["limit"])
    la kt = _kt_ny(db, ytre)
    la ut = []
    la ri = 0
    mens ri < lengde(rader0) {
        la nyrad = {}
        la fi = 0
        mens fi < lengde(felt["kind"]) {
            hvis felt["kind"][fi] == "star" {
                la kk = nøkler(rader0[ri])
                la ki = 0
                mens ki < lengde(kk) { nyrad[kk[ki]] = rader0[ri][kk[ki]]; ki = ki + 1 }
            } ellers {
                nyrad[_sel_label(items[fi], fi, felt)] = _felt_verdi(felt, fi, rader0[ri], kt)
            }
            fi = fi + 1
        }
        legg_til(ut, nyrad)
        ri = ri + 1
    }
    returner ut
}

// ── SQL-typenamn → record-tag ────────────────────────────────────────
funksjon _tag_av_type(t: tekst) -> heltall {
    la u = _opp(t)
    hvis u == "INTEGER" eller u == "INT" { returner motor.tag_int() }
    hvis u == "REAL" eller u == "FLOAT" eller u == "DOUBLE" { returner motor.tag_real() }
    hvis u == "BLOB" { returner motor.tag_blob() }
    returner motor.tag_tekst()
}

// ── Constraints (Fase 7i) ────────────────────────────────────────────
// Er token eit kolonne-constraint-nøkkelord (så det ikkje mistolkast som type)?
funksjon _er_kol_constraint_kw(t: tekst) -> boolsk {
    la u = _opp(t)
    returner u == "NOT" eller u == "NULL" eller u == "PRIMARY" eller u == "UNIQUE" eller u == "DEFAULT" eller u == "CHECK" eller u == "REFERENCES" eller u == "COLLATE" eller u == "AUTOINCREMENT"
}

// Les "( a , b , … )" frå indeks `i` (som peikar på "("). Returnerer {cols, etter}.
funksjon _les_kol_liste(toks, i: heltall) -> ordbok {
    la cols = []
    hvis i < lengde(toks) og toks[i] == "(" { i = i + 1 }
    mens i < lengde(toks) og toks[i] != ")" {
        hvis toks[i] != "," { legg_til(cols, toks[i]) }
        i = i + 1
    }
    hvis i < lengde(toks) og toks[i] == ")" { i = i + 1 }
    returner {"cols": cols, "etter": i}
}

// ── Skjema-metadata: lagring og gjenlesing (punkt 5d) ────────────────
// Constraints (NOT NULL/PK/UNIQUE/DEFAULT/CHECK/FK/rowid-alias), view, trigger og
// sekvensar låg berre i minnet og forsvann etter gjenopning. No blir dei koda til
// ein tekst og lagra i motoren (M-/G-postar i WAL og checkpoint), og dekoda lat
// ved første bruk etter open. Kodinga er netstrings («<lengde>:<innhald>»), nøsta
// for lister — ingen JSON.
funksjon _ns(s: tekst) -> tekst { returner tekst_fra_heltall(lengde(s)) + ":" + s }

funksjon _ns_liste(l) -> tekst {
    la deler = []
    la i = 0
    mens i < lengde(l) {
        legg_til(deler, _ns(l[i]))
        i = i + 1
    }
    returner _ns(builtin.join(deler, ""))
}

// Dekod ein sekvens av netstrings (innhaldet i ei _ns_liste) til liste<tekst>.
funksjon _ns_dekod(s: tekst) -> liste {
    la ut = []
    la pos = 0
    la n = lengde(s)
    mens pos < n {
        la c = builtin.index_of(builtin.slice(s, pos, n), ":")
        hvis c < 0 { returner ut }
        la len = builtin.heltall_fra_tekst(builtin.slice(s, pos, pos + c))
        legg_til(ut, builtin.slice(s, pos + c + 1, pos + c + 1 + len))
        pos = pos + c + 1 + len
    }
    returner ut
}

// Ytste nivå: _ns_liste(x) = _ns(innhald) → innhald.
funksjon _ns_opne(s: tekst) -> liste {
    la ytre = _ns_dekod(s)
    hvis lengde(ytre) == 0 { returner [] }
    returner _ns_dekod(ytre[0])
}

funksjon _enkod_c(c) -> tekst {
    la uq = []
    la i = 0
    mens i < lengde(c["unique"]) { legg_til(uq, _ns_liste(c["unique"][i])); i = i + 1 }
    la def = []
    la dk = nøkler(c["default"])
    i = 0
    mens i < lengde(dk) {
        legg_til(def, dk[i])
        legg_til(def, _ns_liste(c["default"][dk[i]]))
        i = i + 1
    }
    la ch = []
    i = 0
    mens i < lengde(c["checks"]) { legg_til(ch, _ns_liste(c["checks"][i])); i = i + 1 }
    la fk = []
    i = 0
    mens i < lengde(c["fk"]) {
        la f = c["fk"][i]
        legg_til(fk, _ns_liste([f["col"], f["tab"], f["refcol"], f["on_delete"], f["on_update"]]))
        i = i + 1
    }
    la typar = []
    hvis finnes_nøkkel(c, "typar") {
        la tk = nøkler(c["typar"])
        i = 0
        mens i < lengde(tk) { legg_til(typar, tk[i]); legg_til(typar, c["typar"][tk[i]]); i = i + 1 }
    }
    returner _ns_liste(["c1", _ns_liste(c["notnull"]), _ns_liste(c["pk"]), _ns_liste(uq), _ns_liste(def),
                        _ns_liste(ch), _ns_liste(fk), c["rowid_alias"], _ns_liste(typar)])
}

funksjon _dekod_c(meta: tekst) -> ordbok {
    la c = {"notnull": [], "pk": [], "unique": [], "default": {}, "checks": [], "fk": [], "rowid_alias": "", "typar": {}}
    la f = _ns_opne(meta)
    hvis lengde(f) < 8 eller f[0] != "c1" { returner c }
    c["notnull"] = _ns_opne(f[1])
    c["pk"] = _ns_opne(f[2])
    la uq = _ns_opne(f[3])
    la i = 0
    mens i < lengde(uq) { legg_til(c["unique"], _ns_opne(uq[i])); i = i + 1 }
    la def = _ns_opne(f[4])
    i = 0
    mens i + 1 < lengde(def) { c["default"][def[i]] = _ns_opne(def[i + 1]); i = i + 2 }
    la ch = _ns_opne(f[5])
    i = 0
    mens i < lengde(ch) { legg_til(c["checks"], _ns_opne(ch[i])); i = i + 1 }
    la fk = _ns_opne(f[6])
    i = 0
    mens i < lengde(fk) {
        la g = _ns_opne(fk[i])
        legg_til(c["fk"], {"col": g[0], "tab": g[1], "refcol": g[2], "on_delete": g[3], "on_update": g[4]})
        i = i + 1
    }
    c["rowid_alias"] = f[7]
    hvis lengde(f) > 8 {
        la ty = _ns_opne(f[8])
        i = 0
        mens i + 1 < lengde(ty) { c["typar"][ty[i]] = ty[i + 1]; i = i + 2 }
    }
    returner c
}

// Lagre constraints for tabellen (etter endring) i motoren.
funksjon _lagre_c(db, navn: tekst) {
    la t = db["tabellar"][navn]
    motor.db_sett_tabell_meta(db, navn, _enkod_c(t["c"]))
}

funksjon _enkod_db_meta(db) -> tekst {
    la vw = []
    hvis finnes_nøkkel(db, "_views") {
        la vk = nøkler(db["_views"])
        la i = 0
        mens i < lengde(vk) { legg_til(vw, vk[i]); legg_til(vw, _ns_liste(db["_views"][vk[i]])); i = i + 1 }
    }
    la tr = []
    hvis finnes_nøkkel(db, "_triggers") {
        la i = 0
        mens i < lengde(db["_triggers"]) {
            la t = db["_triggers"][i]
            la body = []
            la b = 0
            mens b < lengde(t["body"]) { legg_til(body, _ns_liste(t["body"][b])); b = b + 1 }
            legg_til(tr, _ns_liste([t["navn"], t["when"], t["event"], t["tab"], _ns_liste(body)]))
            i = i + 1
        }
    }
    la sq = []
    hvis finnes_nøkkel(db, "_sequences") {
        la sk = nøkler(db["_sequences"])
        la i = 0
        mens i < lengde(sk) {
            la s = db["_sequences"][sk[i]]
            legg_til(sq, sk[i])
            legg_til(sq, _ns_liste([s["next"], s["inc"], s["last"], s["kalt"]]))
            i = i + 1
        }
    }
    returner _ns_liste(["d1", _ns_liste(vw), _ns_liste(tr), _ns_liste(sq)])
}

// Dekod db-metadata (view/trigger/sekvens) frå motoren om ho er endra sidan sist.
funksjon _sikre_db_meta(db) {
    la v = 0
    hvis finnes_nøkkel(db, "_meta_v") { v = db["_meta_v"] }
    hvis finnes_nøkkel(db, "_meta_v_lasta") og db["_meta_v_lasta"] == v { returner 0 }
    db["_meta_v_lasta"] = v
    la meta = ""
    hvis finnes_nøkkel(db, "meta") { meta = db["meta"] }
    hvis meta == "" { returner 0 }
    la f = _ns_opne(meta)
    hvis lengde(f) < 4 eller f[0] != "d1" { returner 0 }
    la views = {}
    la vw = _ns_opne(f[1])
    la i = 0
    mens i + 1 < lengde(vw) { views[vw[i]] = _ns_opne(vw[i + 1]); i = i + 2 }
    db["_views"] = views
    la trs = []
    la tr = _ns_opne(f[2])
    i = 0
    mens i < lengde(tr) {
        la g = _ns_opne(tr[i])
        la body = []
        la bl = _ns_opne(g[4])
        la b = 0
        mens b < lengde(bl) { legg_til(body, _ns_opne(bl[b])); b = b + 1 }
        legg_til(trs, {"navn": g[0], "when": g[1], "event": g[2], "tab": g[3], "body": body})
        i = i + 1
    }
    db["_triggers"] = trs
    la seqs = {}
    la sq = _ns_opne(f[3])
    i = 0
    mens i + 1 < lengde(sq) {
        la g = _ns_opne(sq[i + 1])
        seqs[sq[i]] = {"next": g[0], "inc": g[1], "last": g[2], "kalt": g[3]}
        i = i + 2
    }
    db["_sequences"] = seqs
    returner 0
}

// Lagre view/trigger/sekvens i motoren (etter endring).
funksjon _lagre_db_meta(db) {
    _sikre_db_meta(db)
    motor.db_sett_meta(db, _enkod_db_meta(db))
    hvis finnes_nøkkel(db, "_meta_v") { db["_meta_v_lasta"] = db["_meta_v"] }
}

funksjon _tab_c(t) -> ordbok {
    hvis finnes_nøkkel(t, "c") { returner t["c"] }
    // Etter gjenopning: dekod lagra constraints frå motoren.
    hvis finnes_nøkkel(t, "meta") og t["meta"] != "" {
        t["c"] = _dekod_c(t["meta"])
        returner t["c"]
    }
    t["c"] = {"notnull": [], "pk": [], "unique": [], "default": {}, "checks": [], "fk": [], "rowid_alias": "", "typar": {}}
    returner t["c"]
}

// Finst det ei anna rad (≠ ekskluder_rowid) som er lik `nyrad` på alle kolonnar i `grp`?
// NULL og "" reknast aldri som like (SQLite-semantikk for UNIQUE). Kandidatane kjem
// frå oppslag på første kolonne (alias/indeks/hash) — ikkje full skann.
funksjon _finst_dup(db, navn: tekst, grp, nyrad, ekskluder_rowid: heltall) -> boolsk {
    la col0 = grp[0]
    la nv0 = ""
    hvis finnes_nøkkel(nyrad, col0) { nv0 = nyrad[col0] }
    hvis nv0 == "" eller _ern(nv0) { returner usann }
    la kand = _lik_kandidatar(db, navn, col0, nv0)
    la r = 0
    mens r < lengde(kand) {
        hvis kand[r] != ekskluder_rowid og _grp_lik(motor.db_hent(db, navn, kand[r]), nyrad, grp) { returner sann }
        r = r + 1
    }
    returner usann
}

funksjon _grp_lik(rad, nyrad, grp) -> boolsk {
    la g = 0
    mens g < lengde(grp) {
        la col = grp[g]
        la ev = ""
        hvis finnes_nøkkel(rad, col) { ev = rad[col] }
        la nv = ""
        hvis finnes_nøkkel(nyrad, col) { nv = nyrad[col] }
        hvis ev != nv eller ev == "" eller _ern(ev) { returner usann }
        g = g + 1
    }
    returner sann
}

funksjon _finst_verdi(db, tab: tekst, col: tekst, v: tekst) -> boolsk {
    hvis ikke finnes_nøkkel(db["tabellar"], tab) { returner usann }
    la kand = _lik_kandidatar(db, tab, col, v)
    la r = 0
    mens r < lengde(kand) {
        la rad = motor.db_hent(db, tab, kand[r])
        hvis finnes_nøkkel(rad, col) og rad[col] == v { returner sann }
        r = r + 1
    }
    returner usann
}

// Rowids som kolliderer med `nyrad` på nokon unik-/PK-gruppe (for OR REPLACE / UPSERT).
funksjon _konflikt_rowids(db, navn: tekst, nyrad) -> liste {
    la c = _tab_c(db["tabellar"][navn])
    la uq = c["unique"]
    la ut = []
    la i = 0
    mens i < lengde(uq) {
        la grp = uq[i]
        la nv0 = ""
        hvis finnes_nøkkel(nyrad, grp[0]) { nv0 = nyrad[grp[0]] }
        hvis nv0 != "" og ikke _ern(nv0) {
            la kand = _lik_kandidatar(db, navn, grp[0], nv0)
            la r = 0
            mens r < lengde(kand) {
                hvis _grp_lik(motor.db_hent(db, navn, kand[r]), nyrad, grp) og ikke _inneheld(ut, kand[r]) { legg_til(ut, kand[r]) }
                r = r + 1
            }
        }
        i = i + 1
    }
    returner motor.sorter_tal(ut)
}

// Sjekk NOT NULL / CHECK / UNIQUE / PK / FK for ei foreslått rad. "" = ok, elles feilmelding.
funksjon _sjekk_constraints(db, navn: tekst, nyrad, ekskluder_rowid: heltall) -> tekst {
    returner _sjekk_constraints_h(db, navn, nyrad, ekskluder_rowid, "")
}

// Som _sjekk_constraints; `hopp_kol` = ein éin-kolonne-UNIQUE som er kjend unik
// (auto-tildelt id) og ikkje treng oppslag.
funksjon _sjekk_constraints_h(db, navn: tekst, nyrad, ekskluder_rowid: heltall, hopp_kol: tekst) -> tekst {
    la c = _tab_c(db["tabellar"][navn])
    la nn = c["notnull"]
    la i = 0
    mens i < lengde(nn) {
        la col = nn[i]
        hvis (ikke finnes_nøkkel(nyrad, col)) eller _ern(nyrad[col]) { returner "NOT NULL constraint failed: " + navn + "." + col }
        i = i + 1
    }
    la kt = _kt_ny(db, {})
    la ch = c["checks"]
    i = 0
    mens i < lengde(ch) {
        hvis ikke _truthy(_ex_or(ch[i], 0, nyrad, kt)["v"]) { returner "CHECK constraint failed: " + navn }
        i = i + 1
    }
    la uq = c["unique"]
    i = 0
    mens i < lengde(uq) {
        la grp = uq[i]
        hvis (lengde(grp) != 1 eller grp[0] != hopp_kol) og _finst_dup(db, navn, grp, nyrad, ekskluder_rowid) { returner "UNIQUE constraint failed: " + navn + "." + grp[0] }
        i = i + 1
    }
    la fk = c["fk"]
    i = 0
    mens i < lengde(fk) {
        la f = fk[i]
        la v = ""
        hvis finnes_nøkkel(nyrad, f["col"]) { v = nyrad[f["col"]] }
        // NULL FK (sentinel eller "") er tillate — berre ikkje-null verdiar må referere.
        hvis (ikke _ern(v)) og v != "" og ikke _finst_verdi(db, f["tab"], f["refcol"], v) { returner "FOREIGN KEY constraint failed" }
        i = i + 1
    }
    returner ""
}

// UPSERT SET-verdi: "excluded.X" → den foreslåtte rada sin X, elles literal.
// Literal-verdi frå eit token: NULL-nøkkelord → sentinel, elles unquote.
funksjon _verdi_lit(tok: tekst) -> tekst {
    hvis _opp(tok) == "NULL" { returner _NULLV() }
    returner _unquote(tok)
}

funksjon _upsert_verdi(tok: tekst, nyrad) -> tekst {
    hvis _opp(_kolprefiks(tok)) == "EXCLUDED" {
        la kn = _kolnavn(tok)
        hvis finnes_nøkkel(nyrad, kn) { returner nyrad[kn] }
        returner ""
    }
    returner _verdi_lit(tok)
}

// ── FOREIGN KEY-referanseaksjonar (ON DELETE/UPDATE) ─────────────────
// Les referanse-aksjonar etter REFERENCES tab(col), fram til , eller ).
funksjon _fk_les_actions(toks, start: heltall) -> ordbok {
    la on_del = "NO ACTION"
    la on_upd = "NO ACTION"
    la i = start
    mens i < lengde(toks) og toks[i] != "," og toks[i] != ")" {
        hvis _opp(toks[i]) == "ON" og i + 1 < lengde(toks) {
            la ev = _opp(toks[i + 1])
            la j = i + 2
            la act = "NO ACTION"
            hvis j < lengde(toks) {
                la a0 = _opp(toks[j])
                hvis a0 == "SET" og j + 1 < lengde(toks) {
                    act = "SET " + _opp(toks[j + 1])
                    j = j + 2
                } ellers hvis a0 == "NO" og j + 1 < lengde(toks) {
                    act = "NO ACTION"
                    j = j + 2
                } ellers {
                    act = a0
                    j = j + 1
                }
            }
            hvis ev == "DELETE" { on_del = act }
            hvis ev == "UPDATE" { on_upd = act }
            i = j
        } ellers {
            i = i + 1
        }
    }
    returner {"on_delete": on_del, "on_update": on_upd}
}

funksjon _fk_act(fk, key: tekst) -> tekst {
    hvis finnes_nøkkel(fk, key) { returner fk[key] }
    returner "NO ACTION"
}

funksjon _sql_lit(v: tekst) -> tekst {
    returner "'" + builtin.join(builtin.split(v, "'"), "''") + "'"
}

// Alle FK-ar (på tvers av tabellar) som peikar på foreldretabellen `ptab`.
funksjon _fk_barn(db, ptab: tekst) -> liste {
    la ut = []
    la tbls = nøkler(db["tabellar"])
    la i = 0
    mens i < lengde(tbls) {
        la c = _tab_c(db["tabellar"][tbls[i]])
        la fks = c["fk"]
        la k = 0
        mens k < lengde(fks) {
            hvis fks[k]["tab"] == ptab {
                legg_til(ut, {"tab": tbls[i], "col": fks[k]["col"], "refcol": fks[k]["refcol"],
                              "on_delete": _fk_act(fks[k], "on_delete"), "on_update": _fk_act(fks[k], "on_update")})
            }
            k = k + 1
        }
        i = i + 1
    }
    returner ut
}

// Pre-sjekk RESTRICT/NO ACTION FØR forelder-mutasjonen (event = DELETE|UPDATE).
// usann = brot (blokkér setninga). CASCADE/SET NULL handterast av _apply etterpå.
funksjon _kaskade_restrict_ok(db, ptab: tekst, oldrad, newrad, event: tekst) -> boolsk {
    la barn = _fk_barn(db, ptab)
    la i = 0
    mens i < lengde(barn) {
        la b = barn[i]
        la act = b["on_delete"]
        hvis event == "UPDATE" { act = b["on_update"] }
        hvis act != "CASCADE" og act != "SET NULL" og act != "SET DEFAULT" {
            la oldv = ""
            hvis finnes_nøkkel(oldrad, b["refcol"]) { oldv = oldrad[b["refcol"]] }
            la endra = sann
            hvis event == "UPDATE" {
                la newv = ""
                hvis finnes_nøkkel(newrad, b["refcol"]) { newv = newrad[b["refcol"]] }
                endra = (oldv != newv)
            }
            hvis oldv != "" og endra og _finst_verdi(db, b["tab"], b["col"], oldv) {
                db["_siste_feil"] = "FOREIGN KEY constraint failed"
                returner usann
            }
        }
        i = i + 1
    }
    returner sann
}

// Bruk CASCADE/SET NULL på barnrader ETTER at forelderrada er sletta.
funksjon _kaskade_delete_apply(db, ptab: tekst, rad) {
    la barn = _fk_barn(db, ptab)
    la i = 0
    mens i < lengde(barn) {
        la b = barn[i]
        la val = ""
        hvis finnes_nøkkel(rad, b["refcol"]) { val = rad[b["refcol"]] }
        hvis val != "" {
            hvis b["on_delete"] == "CASCADE" {
                _exec_t(db, _tok("DELETE FROM " + b["tab"] + " WHERE " + b["col"] + " = " + _sql_lit(val)))
            } ellers hvis b["on_delete"] == "SET NULL" eller b["on_delete"] == "SET DEFAULT" {
                _exec_t(db, _tok("UPDATE " + b["tab"] + " SET " + b["col"] + " = NULL WHERE " + b["col"] + " = " + _sql_lit(val)))
            }
        }
        i = i + 1
    }
    returner 0
}

// Bruk CASCADE/SET NULL på barnrader ETTER at forelder-nøkkelen er oppdatert
// (så barnet sin nye FK-verdi finst i forelderen). Berre når refcol endra seg.
funksjon _kaskade_update_apply(db, ptab: tekst, oldrad, newrad) {
    la barn = _fk_barn(db, ptab)
    la i = 0
    mens i < lengde(barn) {
        la b = barn[i]
        la oldv = ""
        hvis finnes_nøkkel(oldrad, b["refcol"]) { oldv = oldrad[b["refcol"]] }
        la newv = ""
        hvis finnes_nøkkel(newrad, b["refcol"]) { newv = newrad[b["refcol"]] }
        hvis oldv != "" og oldv != newv {
            hvis b["on_update"] == "CASCADE" {
                _exec_t(db, _tok("UPDATE " + b["tab"] + " SET " + b["col"] + " = " + _sql_lit(newv) + " WHERE " + b["col"] + " = " + _sql_lit(oldv)))
            } ellers hvis b["on_update"] == "SET NULL" eller b["on_update"] == "SET DEFAULT" {
                _exec_t(db, _tok("UPDATE " + b["tab"] + " SET " + b["col"] + " = NULL WHERE " + b["col"] + " = " + _sql_lit(oldv)))
            }
        }
        i = i + 1
    }
    returner 0
}

// Finn ON CONFLICT-klausul i INSERT. Returnerer {har, do: NOTHING|UPDATE, set_kol, set_val}.
funksjon _finn_on_conflict(toks) -> ordbok {
    la i = 0
    mens i < lengde(toks) {
        hvis _opp(toks[i]) == "ON" og i + 1 < lengde(toks) og _opp(toks[i + 1]) == "CONFLICT" {
            i = i + 2
            hvis i < lengde(toks) og toks[i] == "(" {
                la g = _les_kol_liste(toks, i)
                i = g["etter"]
            }
            hvis i < lengde(toks) og _opp(toks[i]) == "DO" { i = i + 1 }
            hvis i < lengde(toks) og _opp(toks[i]) == "UPDATE" {
                i = i + 1
                hvis i < lengde(toks) og _opp(toks[i]) == "SET" { i = i + 1 }
                la sk = []
                la sv = []
                mens i < lengde(toks) og _opp(toks[i]) != "WHERE" {
                    hvis toks[i] == "," { i = i + 1; fortsett }
                    hvis i + 2 < lengde(toks) og toks[i + 1] == "=" {
                        legg_til(sk, toks[i])
                        legg_til(sv, toks[i + 2])
                        i = i + 3
                    } ellers {
                        i = i + 1
                    }
                }
                returner {"har": sann, "do": "UPDATE", "set_kol": sk, "set_val": sv}
            }
            returner {"har": sann, "do": "NOTHING", "set_kol": [], "set_val": []}
        }
        i = i + 1
    }
    returner {"har": usann, "do": "", "set_kol": [], "set_val": []}
}

// Bygg posisjonell verdi-liste (skjema-rekkefølge) frå ei rad-ordbok.
funksjon _verdier_av_rad(t, rad) -> liste {
    la ut = []
    la k = 0
    mens k < lengde(t["kolonner"]) {
        la cn = t["kolonner"][k]["navn"]
        la v = ""
        hvis finnes_nøkkel(rad, cn) { v = rad[cn] }
        legg_til(ut, v)
        k = k + 1
    }
    returner ut
}

// Bygg rad-ordbok (kol→verdi) frå posisjonelle verdiar i skjema-rekkefølge.
funksjon _rad_av_verdier(t, verdier) -> ordbok_tekst {
    la rad = {}
    la k = 0
    mens k < lengde(t["kolonner"]) {
        la cn = t["kolonner"][k]["navn"]
        la v = ""
        hvis k < lengde(verdier) { v = verdier[k] }
        rad[cn] = v
        k = k + 1
    }
    returner rad
}

// ── INSERT-hjelparar ─────────────────────────────────────────────────
// Evaluer verdiane i éi VALUES-gruppe. Enkle literalar (tal, 'tekst', NULL) utan
// å gå gjennom heile uttrykks-evaluatoren.
funksjon _verdi_gruppe(inner, kt) -> liste {
    la ut = []
    la grp = []
    la gd = 0
    la gi = 0
    mens gi < lengde(inner) {
        hvis inner[gi] == "(" { gd = gd + 1 } ellers hvis inner[gi] == ")" { gd = gd - 1 }
        hvis inner[gi] == "," og gd == 0 {
            legg_til(ut, _eval_verdi(grp, kt))
            grp = []
        } ellers {
            legg_til(grp, inner[gi])
        }
        gi = gi + 1
    }
    hvis lengde(grp) > 0 { legg_til(ut, _eval_verdi(grp, kt)) }
    returner ut
}

funksjon _eval_verdi(grp, kt) -> tekst {
    hvis lengde(grp) == 1 {
        la t = grp[0]
        la c0 = builtin.char_code(t)
        hvis c0 == 39 { returner _unquote(t) }
        hvis (c0 >= 48 og c0 <= 57) eller c0 == 45 {
            hvis _er_tal(t) { returner t }
        }
        hvis _opp(t) == "NULL" { returner _NULLV() }
    }
    returner _ex_or(grp, 0, {}, kt)["v"]
}

// Evaluer eit lagra DEFAULT-uttrykk (token-liste) — ved kvar INSERT, så t.d.
// datetime('now') og CURRENT_TIMESTAMP gjev tidspunktet for innsetjinga.
// Evaluer eit uttrykk mot ei rad; enkle literalar direkte.
funksjon _eval_uttrykk(toks, rad, kt) -> tekst {
    hvis lengde(toks) == 1 {
        la t = toks[0]
        la c0 = builtin.char_code(t)
        hvis c0 == 39 { returner _unquote(t) }
        hvis ((c0 >= 48 og c0 <= 57) eller c0 == 45) og _er_tal(t) { returner t }
    }
    returner _ex_or(toks, 0, rad, kt)["v"]
}

funksjon _eval_default(db, dt) -> tekst {
    hvis lengde(dt) == 0 { returner _NULLV() }
    returner _eval_verdi(dt, _kt_ny(db, {}))
}

// Er v eit heiltal ≥ 1 (tal-bevisst: "5", "05", "5.0")? Returnerer talet, elles -1.
funksjon _kanonisk_int(v: tekst) -> heltall {
    // Rask veg: kanonisk positivt heiltal ("1".."99999999999999999").
    la n = lengde(v)
    hvis n >= 1 og n <= 17 {
        la c0 = builtin.char_code(v)
        hvis c0 >= 49 og c0 <= 57 {
            prøv {
                la fiv = builtin.heltall_fra_tekst(v)
                hvis tekst_fra_heltall(fiv) == v { returner fiv }
            } fang (e) { }
        }
    }
    la k = motor.sorteringsnøkkel(v)
    hvis builtin.char_code(k) != 50 { returner -1 }
    hvis builtin.index_of(k, ".") >= 0 { returner -1 }
    la hl = builtin.heltall_fra_tekst(builtin.slice(k, 1, 3))
    hvis hl > 17 { returner -1 }
    la iv = builtin.heltall_fra_tekst(builtin.slice(k, 3, 3 + hl))
    hvis iv < 1 { returner -1 }
    returner iv
}

// ── INTEGER PRIMARY KEY (rowid-alias) ────────────────────────────────
// Rada blir lagra på rowid == alias-verdien når det går (som SQLite), så oppslag
// og unikheit på primærnøkkelen er O(1) utan indeks. Rader der det ikkje går
// (negative/svært store/ikkje-heiltal, eller ein UPDATE av id) står i ei lita
// unntaksliste. Byggast lat etter gjenopning (éin skann).
funksjon _alias_sikre(db, navn: tekst, t) {
    hvis finnes_nøkkel(t, "_alias_unntak") { returner 0 }
    la alias = _tab_c(t)["rowid_alias"]
    la unntak = {}
    la maks = 0
    la rowids = motor.db_rowids(db, navn)
    la i = 0
    mens i < lengde(rowids) {
        la r = rowids[i]
        la rad = motor.db_hent(db, navn, r)
        la v = ""
        hvis finnes_nøkkel(rad, alias) { v = rad[alias] }
        la iv = _kanonisk_int(v)
        hvis iv != r { _alias_unntak_legg(unntak, motor.sorteringsnøkkel(v), r) }
        hvis iv > maks { maks = iv }
        i = i + 1
    }
    t["_alias_unntak"] = unntak
    t["_alias_maks"] = maks
    returner 0
}

funksjon _alias_unntak_legg(unntak, k: tekst, r: heltall) {
    hvis finnes_nøkkel(unntak, k) { legg_til(unntak[k], r) } ellers { unntak[k] = [r] }
}

// Etter insert/update av rada `rowid` med alias-verdi v: oppdater unntak/maks.
funksjon _alias_merk(t, rowid: heltall, v: tekst) {
    hvis ikke finnes_nøkkel(t, "_alias_unntak") { returner 0 }
    la iv = _kanonisk_int(v)
    hvis iv != rowid { _alias_unntak_legg(t["_alias_unntak"], motor.sorteringsnøkkel(v), rowid) }
    hvis iv > t["_alias_maks"] { t["_alias_maks"] = iv }
    returner 0
}

// Rowids (levande, stigande) der alias-kolonnen er lik v (tal-bevisst).
funksjon _alias_kandidatar(db, navn: tekst, t, v: tekst) -> liste {
    _alias_sikre(db, navn, t)
    la alias = _tab_c(t)["rowid_alias"]
    la k = motor.sorteringsnøkkel(v)
    la ut = []
    la iv = _kanonisk_int(v)
    hvis iv >= 1 og motor.db_finst(db, navn, iv) {
        la rad = motor.db_hent(db, navn, iv)
        la rv = ""
        hvis finnes_nøkkel(rad, alias) { rv = rad[alias] }
        hvis motor.sorteringsnøkkel(rv) == k { legg_til(ut, iv) }
    }
    hvis finnes_nøkkel(t["_alias_unntak"], k) {
        la l = t["_alias_unntak"][k]
        la i = 0
        mens i < lengde(l) {
            la r = l[i]
            hvis r != iv og motor.db_finst(db, navn, r) {
                la rad = motor.db_hent(db, navn, r)
                la rv = ""
                hvis finnes_nøkkel(rad, alias) { rv = rad[alias] }
                hvis motor.sorteringsnøkkel(rv) == k og ikke _inneheld(ut, r) { legg_til(ut, r) }
            }
            i = i + 1
        }
    }
    returner motor.sorter_tal(ut)
}

funksjon _inneheld(l, x) -> boolsk {
    la i = 0
    mens i < lengde(l) {
        hvis l[i] == x { returner sann }
        i = i + 1
    }
    returner usann
}

// Rowids (levande, stigande) der kolonnen KAN vere lik v (same sorteringsnøkkel):
// alias → direkte, ordna indeks, elles latent hash-indeks. Kallaren verifiserer.
funksjon _lik_kandidatar(db, navn: tekst, kol: tekst, v: tekst) -> liste {
    la t = db["tabellar"][navn]
    la c = _tab_c(t)
    hvis c["rowid_alias"] != "" og c["rowid_alias"] == kol { returner _alias_kandidatar(db, navn, t, v) }
    hvis motor.db_har_indeks(db, navn, kol) { returner motor.db_indeks_søk(db, navn, kol, v) }
    returner motor.sorter_tal(motor.db_hash_søk(db, navn, kol, v))
}

// Set inn rad (motor) — ved alias-rowid om mogleg — og vedlikehald alias-info.
funksjon _sett_inn_rad(db, navn: tekst, t, verdier) -> heltall {
    la c = _tab_c(t)
    la alias = c["rowid_alias"]
    hvis alias == "" { returner motor.db_sett_inn(db, navn, verdier) }
    _alias_sikre(db, navn, t)
    la kn = t["kolnamn"]
    la ai = 0
    mens ai < lengde(kn) og kn[ai] != alias { ai = ai + 1 }
    hvis ai >= lengde(kn) { returner motor.db_sett_inn(db, navn, verdier) }
    la v = verdier[ai]
    la iv = _kanonisk_int(v)
    la r = 0
    hvis iv >= 1 og (ikke motor.db_finst(db, navn, iv)) og iv < motor.db_next_rowid(db, navn) + 100000 {
        r = motor.db_sett_inn_ved(db, navn, iv, verdier)
    } ellers {
        r = motor.db_sett_inn(db, navn, verdier)
    }
    _alias_merk(t, r, v)
    // last_insert_rowid() = id-verdien (i SQLite er rowid og INTEGER PRIMARY KEY det same).
    hvis iv >= 1 { db["_siste_rowid"] = iv }
    returner r
}

funksjon _oppdater_rad(db, navn: tekst, t, rowid: heltall, verdier) {
    motor.db_oppdater(db, navn, rowid, verdier)
    la alias = _tab_c(t)["rowid_alias"]
    hvis alias != "" og finnes_nøkkel(t, "_alias_unntak") {
        la rad = motor.db_hent(db, navn, rowid)
        hvis finnes_nøkkel(rad, alias) { _alias_merk(t, rowid, rad[alias]) }
    }
}

// Éi rad av ein INSERT: DEFAULT, auto-id, constraints, UPSERT/OR-modus, triggerar.
// Returnerer tal på råka rader eller -1.
funksjon _sett_inn_ei_rad(db, navn: tekst, t, pos_av, verdiar_inn, mode: tekst, toks, har_ret: boolsk) -> heltall {
    la kn = t["kolnamn"]
    la c = _tab_c(t)
    la def = c["default"]
    la alias = c["rowid_alias"]
    la verdier = []
    la k = 0
    mens k < lengde(kn) {
        la p = pos_av[k]
        la v = ""
        hvis p >= 0 og p < lengde(verdiar_inn) {
            v = verdiar_inn[p]
        } ellers hvis finnes_nøkkel(def, kn[k]) {
            v = _eval_default(db, def[kn[k]])
        } ellers hvis kn[k] != alias {
            // Utelaten, ingen default, ikkje auto-id → NULL (3-verdi).
            v = _NULLV()
        }
        legg_til(verdier, v)
        k = k + 1
    }
    // Auto-rowid-alias (SQLite-konform, G2): berre ein INTEGER PRIMARY KEY-kolonne
    // (rowid-alias) auto-tildeler når han er utelaten eller NULL. Vanleg
    // `id INTEGER` (utan PK) skal la NULL stå — IKKJE auto-inkrementere. Ny id =
    // max(neste rowid, største id + 1), så ho aldri kolliderer.
    la auto_id = 0
    hvis alias != "" {
        la ai = 0
        mens ai < lengde(kn) {
            hvis kn[ai] == alias og (verdier[ai] == "" eller _ern(verdier[ai])) {
                _alias_sikre(db, navn, t)
                la ny = motor.db_next_rowid(db, navn)
                hvis t["_alias_maks"] + 1 > ny { ny = t["_alias_maks"] + 1 }
                verdier[ai] = tekst_fra_heltall(ny)
                auto_id = ny
            }
            ai = ai + 1
        }
    }
    la nyrad = _rad_av_verdier(t, verdier)
    // Ein auto-tildelt id er større enn alle eksisterande → treng ikkje UNIQUE-oppslag.
    la hopp = ""
    hvis auto_id > 0 { hopp = alias }
    la feil = _sjekk_constraints_h(db, navn, nyrad, 0 - 1, hopp)
    hvis feil != "" {
        la ups = _finn_on_conflict(toks)
        hvis ups["har"] {
            hvis ups["do"] == "NOTHING" { returner 0 }
            la kr = _konflikt_rowids(db, navn, nyrad)
            la oppd = 0
            la ri = 0
            mens ri < lengde(kr) {
                // Kopi av rada (ikkje muter den lagra ordboka direkte).
                la rad = _rad_av_verdier(t, _verdier_av_rad(t, motor.db_hent(db, navn, kr[ri])))
                la sk = 0
                mens sk < lengde(ups["set_kol"]) {
                    rad[ups["set_kol"][sk]] = _upsert_verdi(ups["set_val"][sk], nyrad)
                    sk = sk + 1
                }
                _oppdater_rad(db, navn, t, kr[ri], _verdier_av_rad(t, rad))
                oppd = oppd + 1
                ri = ri + 1
            }
            returner oppd
        }
        hvis mode == "IGNORE" { returner 0 }
        hvis mode == "REPLACE" {
            la kr = _konflikt_rowids(db, navn, nyrad)
            la ri = 0
            mens ri < lengde(kr) { motor.db_slett(db, navn, kr[ri]); ri = ri + 1 }
            la f2 = _sjekk_constraints(db, navn, nyrad, 0 - 1)
            hvis f2 != "" { db["_siste_feil"] = f2; returner 0 - 1 }
            _fyr_triggers(db, "BEFORE", "INSERT", navn, nyrad, {})
            _sett_inn_rad(db, navn, t, verdier)
            _fyr_triggers(db, "AFTER", "INSERT", navn, nyrad, {})
            hvis har_ret { db["_ret_tab"] = navn; legg_til(db["_ret_rows"], nyrad) }
            returner 1
        }
        db["_siste_feil"] = feil
        returner 0 - 1
    }
    _fyr_triggers(db, "BEFORE", "INSERT", navn, nyrad, {})
    hvis auto_id > 0 og auto_id >= motor.db_next_rowid(db, navn) {
        // Auto-id på ny rowid: alias == rowid, ingenting å merke i unntakslista.
        motor.db_sett_inn_ved(db, navn, auto_id, verdier)
        db["_siste_rowid"] = auto_id
        hvis auto_id > t["_alias_maks"] { t["_alias_maks"] = auto_id }
    } ellers {
        _sett_inn_rad(db, navn, t, verdier)
    }
    _fyr_triggers(db, "AFTER", "INSERT", navn, nyrad, {})
    hvis har_ret { db["_ret_tab"] = navn; legg_til(db["_ret_rows"], nyrad) }
    returner 1
}

// ── Public: opne / exec / query ──────────────────────────────────────
funksjon opne(sti: tekst) -> ordbok_tekst {
    hvis sti == "" eller sti == ":memory:" {
        returner motor.db_ny("")
    }
    returner motor.db_åpne(sti)
}

funksjon lukk(db) {
    hvis db["sti"] != "" {
        motor.db_checkpoint(db)
    }
}

// ── Skjema-utviding (Fase 7k): VIEW / TRIGGER / ALTER ────────────────
funksjon _sikre_views(db) {
    _sikre_db_meta(db)
    hvis ikke finnes_nøkkel(db, "_views") { db["_views"] = {} }
}
funksjon _sikre_triggers(db) {
    _sikre_db_meta(db)
    hvis ikke finnes_nøkkel(db, "_triggers") { db["_triggers"] = [] }
}
// ── Sekvensar (Postgres): ikkje-transaksjonelle teljarar. Verdiar lagra som tekst. ──
funksjon _sikre_sequences(db) {
    _sikre_db_meta(db)
    hvis ikke finnes_nøkkel(db, "_sequences") { db["_sequences"] = {} }
}
funksjon _seq_nextval(db, navn: tekst) -> tekst {
    _sikre_sequences(db)
    hvis ikke finnes_nøkkel(db["_sequences"], navn) { returner _NULLV() }
    la seq = db["_sequences"][navn]
    la v = builtin.heltall_fra_tekst(seq["next"])
    seq["next"] = tekst_fra_heltall(v + builtin.heltall_fra_tekst(seq["inc"]))
    seq["last"] = tekst_fra_heltall(v)
    seq["kalt"] = "1"
    _lagre_db_meta(db)
    returner tekst_fra_heltall(v)
}
funksjon _seq_currval(db, navn: tekst) -> tekst {
    _sikre_sequences(db)
    hvis ikke finnes_nøkkel(db["_sequences"], navn) { returner _NULLV() }
    la seq = db["_sequences"][navn]
    hvis seq["kalt"] != "1" { returner _NULLV() }
    returner seq["last"]
}
funksjon _seq_setval(db, navn: tekst, n: heltall) -> tekst {
    _sikre_sequences(db)
    hvis ikke finnes_nøkkel(db["_sequences"], navn) { returner _NULLV() }
    la seq = db["_sequences"][navn]
    seq["last"] = tekst_fra_heltall(n)
    seq["next"] = tekst_fra_heltall(n + builtin.heltall_fra_tekst(seq["inc"]))
    seq["kalt"] = "1"
    _lagre_db_meta(db)
    returner tekst_fra_heltall(n)
}
funksjon _er_view(db, navn: tekst) -> boolsk {
    _sikre_db_meta(db)
    returner finnes_nøkkel(db, "_views") og finnes_nøkkel(db["_views"], navn)
}

// RENAME COLUMN: motoren endrar kolonne + rader (logga); constraints følgjer namnet.
funksjon _rename_kolonne(db, tab: tekst, gammal: tekst, ny: tekst) {
    motor.db_rename_kolonne(db, tab, gammal, ny)
    la c = _tab_c(db["tabellar"][tab])
    c["notnull"] = _byt_i_liste(c["notnull"], gammal, ny)
    c["pk"] = _byt_i_liste(c["pk"], gammal, ny)
    la i = 0
    mens i < lengde(c["unique"]) { c["unique"][i] = _byt_i_liste(c["unique"][i], gammal, ny); i = i + 1 }
    i = 0
    mens i < lengde(c["checks"]) { c["checks"][i] = _byt_i_liste(c["checks"][i], gammal, ny); i = i + 1 }
    hvis finnes_nøkkel(c["default"], gammal) {
        c["default"][ny] = c["default"][gammal]
        fjern_nokkel(c["default"], gammal)
    }
    i = 0
    mens i < lengde(c["fk"]) {
        hvis c["fk"][i]["col"] == gammal { c["fk"][i]["col"] = ny }
        i = i + 1
    }
    hvis c["rowid_alias"] == gammal { c["rowid_alias"] = ny }
    _lagre_c(db, tab)
}

funksjon _byt_i_liste(l, gammal: tekst, ny: tekst) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(l) {
        hvis l[i] == gammal { legg_til(ut, ny) } ellers { legg_til(ut, l[i]) }
        i = i + 1
    }
    returner ut
}

funksjon _drop_kolonne(db, tab: tekst, kn: tekst) {
    motor.db_drop_kolonne(db, tab, kn)
}

// Bytt ut NEW.x / OLD.x i trigger-kropp med siterte verdiar.
funksjon _subst_trigger(bodytoks, newrad, oldrad) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(bodytoks) {
        la tok = bodytoks[i]
        la pre = _opp(_kolprefiks(tok))
        hvis pre == "NEW" eller pre == "OLD" {
            la kn = _kolnavn(tok)
            la kjelde = newrad
            hvis pre == "OLD" { kjelde = oldrad }
            la v = ""
            hvis finnes_nøkkel(kjelde, kn) { v = kjelde[kn] }
            legg_til(ut, "'" + builtin.join(builtin.split(v, "'"), "''") + "'")
        } ellers {
            legg_til(ut, tok)
        }
        i = i + 1
    }
    returner ut
}

funksjon _fyr_triggers(db, when: tekst, event: tekst, tab: tekst, newrad, oldrad) {
    _sikre_db_meta(db)
    hvis ikke finnes_nøkkel(db, "_triggers") { returner 0 }
    hvis lengde(db["_triggers"]) == 0 { returner 0 }
    la trs = db["_triggers"]
    la i = 0
    mens i < lengde(trs) {
        la tr = trs[i]
        hvis tr["when"] == when og tr["event"] == event og tr["tab"] == tab {
            la b = 0
            mens b < lengde(tr["body"]) {
                _exec_t(db, _subst_trigger(tr["body"][b], newrad, oldrad))
                b = b + 1
            }
        }
        i = i + 1
    }
    returner 0
}

// exec: DDL/DML. Returnerer tal på råka rader (CREATE→0, INSERT→1), eller -1 ved ukjend/ugyldig.
// ── RETURNING (Postgres): DML som returnerer dei påverka radene ──────
// Del token-lista ved topp-nivå RETURNING → {har, toks (før), retcols (etter)}.
funksjon _split_returning(toks) -> ordbok {
    la dep = 0
    la i = 0
    mens i < lengde(toks) {
        hvis toks[i] == "(" { dep = dep + 1 } ellers hvis toks[i] == ")" { dep = dep - 1 } ellers hvis dep == 0 og lengde(toks[i]) == 9 og _opp(toks[i]) == "RETURNING" {
            returner {"har": sann, "toks": _slice_range(toks, 0, i), "retcols": _slice_range(toks, i + 1, lengde(toks))}
        }
        i = i + 1
    }
    returner {"har": usann, "toks": toks, "retcols": []}
}

// Splitt token-liste på topp-nivå-komma → liste av token-underlister.
funksjon _split_topp_komma(toks) -> liste {
    la items = []
    la cur = []
    la dep = 0
    la i = 0
    mens i < lengde(toks) {
        hvis toks[i] == "(" { dep = dep + 1 } ellers hvis toks[i] == ")" { dep = dep - 1 }
        hvis toks[i] == "," og dep == 0 {
            legg_til(items, cur)
            cur = []
        } ellers {
            legg_til(cur, toks[i])
        }
        i = i + 1
    }
    hvis lengde(cur) > 0 { legg_til(items, cur) }
    returner items
}

// Projiser dei fanga radene mot RETURNING-kolonnane ("|"-skilt, "\n" mellom rader).
funksjon _projiser_returning(db, tab: tekst, rader, retcols) -> tekst {
    la items = _split_topp_komma(retcols)
    la linjer = []
    la ri = 0
    mens ri < lengde(rader) {
        la rad = rader[ri]
        la felt = []
        la ii = 0
        mens ii < lengde(items) {
            la it = items[ii]
            hvis lengde(it) == 1 og it[0] == "*" {
                la t = db["tabellar"][tab]
                la k = 0
                mens k < lengde(t["kolonner"]) {
                    la cn = t["kolonner"][k]["navn"]
                    la v = ""
                    hvis finnes_nøkkel(rad, cn) { v = rad[cn] }
                    legg_til(felt, _strip_null(v))
                    k = k + 1
                }
            } ellers {
                la e = _ex_or(it, 0, rad, _kt_ny(db, {}))
                legg_til(felt, _strip_null(e["v"]))
            }
            ii = ii + 1
        }
        legg_til(linjer, builtin.join(felt, "|"))
        ri = ri + 1
    }
    returner builtin.join(linjer, "\n")
}

funksjon _har_returning_dml(toks) -> boolsk {
    hvis lengde(toks) == 0 { returner usann }
    la kmd = _opp(toks[0])
    hvis kmd != "INSERT" og kmd != "UPDATE" og kmd != "DELETE" { returner usann }
    returner _split_returning(toks)["har"]
}

// Køyr DML med RETURNING og projiser resultatet.
funksjon _returning_ut(db, toks) -> tekst {
    _exec_t(db, toks)
    hvis ikke finnes_nøkkel(db, "_ret_rows") { returner "" }
    returner _projiser_returning(db, db["_ret_tab"], db["_ret_rows"], db["_ret_cols"])
}

// Token-cache per handle: same SQL-tekst (t.d. bundne/gjentekne spørjingar) blir
// tokenisert éin gong. Avgrensa storleik (tømmast ved 256 oppføringar).
funksjon _tok_c(db, sql: tekst) -> liste {
    hvis finnes_nøkkel(db, "_tokc") {
        la c = db["_tokc"]
        hvis finnes_nøkkel(c, sql) { returner c[sql] }
        hvis db["_tokc_n"] >= 256 {
            db["_tokc"] = {}
            db["_tokc_n"] = 0
        }
    } ellers {
        db["_tokc"] = {}
        db["_tokc_n"] = 0
    }
    la t = _tok(sql)
    db["_tokc"][sql] = t
    db["_tokc_n"] = db["_tokc_n"] + 1
    returner t
}

funksjon exec(db, sql: tekst) -> heltall {
    returner _exec_t(db, _tok_c(db, sql))
}

funksjon _exec_t(db, toks) -> heltall {
    hvis lengde(toks) == 0 { returner 0 }
    la kmd = _opp(toks[0])

    // RETURNING (kun DML): strip klausulen så WHERE-/VALUES-parsing ikkje forvirrast,
    // og opprett fangst-bufferet. Rekursive kall (triggere/kaskade) har inga RETURNING.
    la har_ret = usann
    hvis kmd == "INSERT" eller kmd == "UPDATE" eller kmd == "DELETE" {
        la _rsplit = _split_returning(toks)
        hvis _rsplit["har"] {
            har_ret = sann
            toks = _rsplit["toks"]
            db["_ret_rows"] = []
            db["_ret_cols"] = _rsplit["retcols"]
            db["_ret_tab"] = ""
        }
    }

    hvis kmd == "CREATE" og lengde(toks) >= 5 og _opp(toks[1]) == "INDEX" {
        la j = 2
        // Hopp over «IF NOT EXISTS» før indeksnamnet (elles vart itab="NOT" →
        // db_opprett_indeks på ikkje-eksisterande tabell → null-B-tre-rekursjon).
        hvis j + 2 < lengde(toks) og _opp(toks[j]) == "IF" og _opp(toks[j + 1]) == "NOT" og _opp(toks[j + 2]) == "EXISTS" { j = j + 3 }
        // Hopp over indeksnamnet fram til ON.
        mens j < lengde(toks) og _opp(toks[j]) != "ON" { j = j + 1 }
        hvis j < lengde(toks) og _opp(toks[j]) == "ON" { j = j + 1 }
        la itab = ""
        hvis j < lengde(toks) { itab = toks[j]; j = j + 1 }
        hvis j < lengde(toks) og toks[j] == "(" { j = j + 1 }
        la ikol = ""
        hvis j < lengde(toks) og toks[j] != ")" { ikol = toks[j] }
        hvis itab != "" og ikol != "" {
            motor.db_opprett_indeks(db, itab, ikol)
        }
        returner 0
    }

    hvis kmd == "CREATE" og lengde(toks) >= 3 og _opp(toks[1]) == "SEQUENCE" {
        _sikre_sequences(db)
        la j = 2
        hvis j + 2 < lengde(toks) og _opp(toks[j]) == "IF" og _opp(toks[j + 1]) == "NOT" og _opp(toks[j + 2]) == "EXISTS" { j = j + 3 }
        la snavn = ""
        hvis j < lengde(toks) { snavn = toks[j]; j = j + 1 }
        la start = 1
        la inc = 1
        mens j < lengde(toks) {
            la u = _opp(toks[j])
            hvis u == "START" {
                j = j + 1
                hvis j < lengde(toks) og _opp(toks[j]) == "WITH" { j = j + 1 }
                hvis j < lengde(toks) { start = builtin.heltall_fra_tekst(toks[j]); j = j + 1 }
            } ellers hvis u == "INCREMENT" {
                j = j + 1
                hvis j < lengde(toks) og _opp(toks[j]) == "BY" { j = j + 1 }
                hvis j < lengde(toks) { inc = builtin.heltall_fra_tekst(toks[j]); j = j + 1 }
            } ellers {
                j = j + 1
            }
        }
        hvis snavn != "" {
            db["_sequences"][snavn] = {"next": tekst_fra_heltall(start), "inc": tekst_fra_heltall(inc), "last": "", "kalt": "0"}
            _lagre_db_meta(db)
        }
        returner 0
    }

    hvis kmd == "DROP" og lengde(toks) >= 3 og _opp(toks[1]) == "SEQUENCE" {
        _sikre_sequences(db)
        la j = 2
        hvis j + 1 < lengde(toks) og _opp(toks[j]) == "IF" og _opp(toks[j + 1]) == "EXISTS" { j = j + 2 }
        hvis j < lengde(toks) og finnes_nøkkel(db["_sequences"], toks[j]) {
            fjern_nokkel(db["_sequences"], toks[j])
            _lagre_db_meta(db)
        }
        returner 0
    }

    hvis kmd == "CREATE" og lengde(toks) >= 3 og _opp(toks[1]) == "TABLE" {
        // «CREATE TABLE IF NOT EXISTS namn» — tabellnamnet ligg etter IF NOT EXISTS,
        // ikkje på toks[2]. Utan dette vart tabellen laga med namnet «IF», og seinare
        // operasjonar på det verkelege namnet trefte ei ikkje-eksisterande tabell →
        // null-B-tre → uendeleg rekursjon i _btre_sett_inn_ikke_full.
        la navn_idx = 2
        la if_not_exists = usann
        hvis lengde(toks) >= 6 og _opp(toks[2]) == "IF" og _opp(toks[3]) == "NOT" og _opp(toks[4]) == "EXISTS" {
            navn_idx = 5
            if_not_exists = sann
        }
        la navn = toks[navn_idx]
        // IF NOT EXISTS: tabellen finst alt → inga endring (SQLite-semantikk).
        hvis if_not_exists og finnes_nøkkel(db["tabellar"], navn) { returner 0 }
        la kolonner = []
        la c_notnull = []
        la c_pk = []
        la c_unique = []
        la c_default = {}
        la c_checks = []
        la c_fk = []
        la kol_type_raw = {}
        la i = navn_idx + 1
        hvis i < lengde(toks) og toks[i] == "(" { i = i + 1 }
        mens i < lengde(toks) og toks[i] != ")" {
            hvis toks[i] == "," { i = i + 1; fortsett }
            la u = _opp(toks[i])
            // «CONSTRAINT namn …»: hopp over namnet; sjølve constrainten kjem etter.
            hvis u == "CONSTRAINT" {
                i = i + 2
                fortsett
            }
            // Tabell-nivå constraints
            hvis u == "PRIMARY" {
                i = i + 1
                hvis i < lengde(toks) og _opp(toks[i]) == "KEY" { i = i + 1 }
                la grp = _les_kol_liste(toks, i)
                _legg_alle(c_pk, grp["cols"])
                legg_til(c_unique, grp["cols"])
                i = grp["etter"]
                mens i < lengde(toks) og toks[i] != "," og toks[i] != ")" { i = i + 1 }
                fortsett
            }
            hvis u == "UNIQUE" {
                i = i + 1
                la grp = _les_kol_liste(toks, i)
                legg_til(c_unique, grp["cols"])
                i = grp["etter"]
                mens i < lengde(toks) og toks[i] != "," og toks[i] != ")" { i = i + 1 }
                fortsett
            }
            hvis u == "CHECK" {
                i = i + 1
                la sub = _slice_paren(toks, i)
                legg_til(c_checks, sub["inner"])
                i = sub["etter"]
                mens i < lengde(toks) og toks[i] != "," og toks[i] != ")" { i = i + 1 }
                fortsett
            }
            hvis u == "FOREIGN" {
                i = i + 1
                hvis i < lengde(toks) og _opp(toks[i]) == "KEY" { i = i + 1 }
                la grp = _les_kol_liste(toks, i)
                i = grp["etter"]
                hvis i < lengde(toks) og _opp(toks[i]) == "REFERENCES" {
                    i = i + 1
                    la rtab = ""
                    hvis i < lengde(toks) { rtab = toks[i]; i = i + 1 }
                    la refcol = ""
                    hvis i < lengde(toks) og toks[i] == "(" {
                        la rg = _les_kol_liste(toks, i)
                        hvis lengde(rg["cols"]) > 0 { refcol = rg["cols"][0] }
                        i = rg["etter"]
                    }
                    hvis lengde(grp["cols"]) > 0 {
                        la acts = _fk_les_actions(toks, i)
                        legg_til(c_fk, {"col": grp["cols"][0], "tab": rtab, "refcol": refcol, "on_delete": acts["on_delete"], "on_update": acts["on_update"]})
                    }
                }
                mens i < lengde(toks) og toks[i] != "," og toks[i] != ")" { i = i + 1 }
                fortsett
            }
            // Kolonne-definisjon: namn [type] [constraints…]
            la kol_navn = toks[i]
            la kol_type = "TEXT"
            i = i + 1
            hvis i < lengde(toks) og toks[i] != "," og toks[i] != ")" og ikke _er_kol_constraint_kw(toks[i]) {
                kol_type = toks[i]
                i = i + 1
            }
            mens i < lengde(toks) og toks[i] != "," og toks[i] != ")" {
                la cu = _opp(toks[i])
                hvis cu == "NOT" og i + 1 < lengde(toks) og _opp(toks[i + 1]) == "NULL" {
                    legg_til(c_notnull, kol_navn)
                    i = i + 2
                } ellers hvis cu == "PRIMARY" {
                    i = i + 1
                    hvis i < lengde(toks) og _opp(toks[i]) == "KEY" { i = i + 1 }
                    legg_til(c_pk, kol_navn)
                    legg_til(c_unique, [kol_navn])
                } ellers hvis cu == "UNIQUE" {
                    legg_til(c_unique, [kol_navn])
                    i = i + 1
                } ellers hvis cu == "DEFAULT" {
                    // DEFAULT <literal> | DEFAULT -<tal> | DEFAULT (<uttrykk>) | DEFAULT CURRENT_TIMESTAMP …
                    // Lagra som token-liste og evaluert ved kvar INSERT. (Før vart berre
                    // første token teke: «DEFAULT (datetime('now'))» gav verdien «(» og
                    // resten av kolonnelista forsvann ved den indre «)».)
                    i = i + 1
                    la dt = []
                    hvis i < lengde(toks) og toks[i] == "(" {
                        la dsub = _slice_paren(toks, i)
                        legg_til(dt, "(")
                        _legg_alle(dt, dsub["inner"])
                        legg_til(dt, ")")
                        i = dsub["etter"]
                    } ellers hvis i + 1 < lengde(toks) og (toks[i] == "-" eller toks[i] == "+") {
                        dt = [toks[i], toks[i + 1]]
                        i = i + 2
                    } ellers hvis i < lengde(toks) {
                        dt = [toks[i]]
                        i = i + 1
                    }
                    c_default[kol_navn] = dt
                } ellers hvis cu == "CHECK" {
                    i = i + 1
                    la sub = _slice_paren(toks, i)
                    legg_til(c_checks, sub["inner"])
                    i = sub["etter"]
                } ellers hvis cu == "REFERENCES" {
                    i = i + 1
                    la rtab = ""
                    hvis i < lengde(toks) { rtab = toks[i]; i = i + 1 }
                    la refcol = ""
                    hvis i < lengde(toks) og toks[i] == "(" {
                        la rg = _les_kol_liste(toks, i)
                        hvis lengde(rg["cols"]) > 0 { refcol = rg["cols"][0] }
                        i = rg["etter"]
                    }
                    la acts = _fk_les_actions(toks, i)
                    legg_til(c_fk, {"col": kol_navn, "tab": rtab, "refcol": refcol, "on_delete": acts["on_delete"], "on_update": acts["on_update"]})
                } ellers hvis toks[i] == "(" {
                    // Parentes i kolonnedefinisjonen (t.d. VARCHAR(255), DECIMAL(10, 2),
                    // GENERATED … AS (…)): hopp over balansert, så «,» og «)» inni ikkje
                    // avsluttar kolonnen (eller heile CREATE TABLE).
                    i = _slice_paren(toks, i)["etter"]
                } ellers {
                    i = i + 1
                }
            }
            kol_type_raw[kol_navn] = _opp(kol_type)
            legg_til(kolonner, {"navn": kol_navn, "tag": _tag_av_type(kol_type)})
        }
        // rowid-alias (SQLite): berre ein éin-kolonne PRIMARY KEY med deklarert type
        // NØYAKTIG "INTEGER" (ikkje "INT" o.l.) er alias for rowid og auto-tildeler.
        la rowid_alias = ""
        hvis lengde(c_pk) == 1 og finnes_nøkkel(kol_type_raw, c_pk[0]) og kol_type_raw[c_pk[0]] == "INTEGER" {
            rowid_alias = c_pk[0]
        }
        motor.db_opprett_tabell(db, navn, kolonner)
        db["tabellar"][navn]["c"] = {"notnull": c_notnull, "pk": c_pk, "unique": c_unique, "default": c_default, "checks": c_checks, "fk": c_fk, "rowid_alias": rowid_alias, "typar": kol_type_raw}
        // Persister constraints (overlever close/open og krasj via WAL).
        _lagre_c(db, navn)
        returner 0
    }

    hvis kmd == "DROP" og lengde(toks) >= 3 og _opp(toks[1]) == "TABLE" {
        la idx = 2
        hvis _opp(toks[idx]) == "IF" og idx + 1 < lengde(toks) og _opp(toks[idx + 1]) == "EXISTS" {
            idx = idx + 2
        }
        hvis idx < lengde(toks) {
            la navn = toks[idx]
            hvis finnes_nøkkel(db["tabellar"], navn) {
                motor.db_slett_tabell(db, navn)
            }
        }
        returner 0
    }

    // CREATE VIEW navn AS <select>
    hvis kmd == "CREATE" og lengde(toks) >= 5 og _opp(toks[1]) == "VIEW" {
        la j = 2
        hvis _opp(toks[j]) == "IF" { mens j < lengde(toks) og _opp(toks[j]) != "AS" og toks[j] != "(" { j = j + 1 } }
        la vnavn = ""
        hvis j < lengde(toks) og _opp(toks[j]) != "AS" { vnavn = toks[j]; j = j + 1 }
        hvis j < lengde(toks) og _opp(toks[j]) == "AS" { j = j + 1 }
        _sikre_views(db)
        db["_views"][vnavn] = _slice_range(toks, j, lengde(toks))
        _lagre_db_meta(db)
        returner 0
    }

    // CREATE TRIGGER navn [BEFORE|AFTER] EVENT ON tab [FOR EACH ROW] BEGIN … END
    hvis kmd == "CREATE" og lengde(toks) >= 6 og _opp(toks[1]) == "TRIGGER" {
        la j = 2
        la tnavn = toks[j]
        j = j + 1
        la when = "AFTER"
        hvis j < lengde(toks) og (_opp(toks[j]) == "BEFORE" eller _opp(toks[j]) == "AFTER") { when = _opp(toks[j]); j = j + 1 } ellers hvis j < lengde(toks) og _opp(toks[j]) == "INSTEAD" { when = "INSTEAD"; j = j + 1; hvis j < lengde(toks) og _opp(toks[j]) == "OF" { j = j + 1 } }
        la event = ""
        hvis j < lengde(toks) { event = _opp(toks[j]); j = j + 1 }
        hvis event == "UPDATE" og j < lengde(toks) og _opp(toks[j]) == "OF" { mens j < lengde(toks) og _opp(toks[j]) != "ON" { j = j + 1 } }
        hvis j < lengde(toks) og _opp(toks[j]) == "ON" { j = j + 1 }
        la ttab = ""
        hvis j < lengde(toks) { ttab = toks[j]; j = j + 1 }
        mens j < lengde(toks) og _opp(toks[j]) != "BEGIN" { j = j + 1 }
        hvis j < lengde(toks) og _opp(toks[j]) == "BEGIN" { j = j + 1 }
        // Kropp: setningar skilde med ";" til END.
        la body = []
        la cur = []
        mens j < lengde(toks) og _opp(toks[j]) != "END" {
            hvis toks[j] == ";" {
                hvis lengde(cur) > 0 { legg_til(body, cur); cur = [] }
            } ellers {
                legg_til(cur, toks[j])
            }
            j = j + 1
        }
        hvis lengde(cur) > 0 { legg_til(body, cur) }
        _sikre_triggers(db)
        legg_til(db["_triggers"], {"navn": tnavn, "when": when, "event": event, "tab": ttab, "body": body})
        _lagre_db_meta(db)
        returner 0
    }

    hvis kmd == "DROP" og lengde(toks) >= 3 og _opp(toks[1]) == "VIEW" {
        la idx = 2
        hvis _opp(toks[idx]) == "IF" og idx + 1 < lengde(toks) og _opp(toks[idx + 1]) == "EXISTS" { idx = idx + 2 }
        _sikre_views(db)
        hvis idx < lengde(toks) og finnes_nøkkel(db["_views"], toks[idx]) {
            fjern_nokkel(db["_views"], toks[idx])
            _lagre_db_meta(db)
        }
        returner 0
    }

    hvis kmd == "DROP" og lengde(toks) >= 3 og _opp(toks[1]) == "TRIGGER" {
        la idx = 2
        hvis _opp(toks[idx]) == "IF" og idx + 1 < lengde(toks) og _opp(toks[idx + 1]) == "EXISTS" { idx = idx + 2 }
        _sikre_triggers(db)
        hvis idx < lengde(toks) {
            la nye = []
            la ti = 0
            mens ti < lengde(db["_triggers"]) {
                hvis db["_triggers"][ti]["navn"] != toks[idx] { legg_til(nye, db["_triggers"][ti]) }
                ti = ti + 1
            }
            db["_triggers"] = nye
            _lagre_db_meta(db)
        }
        returner 0
    }

    // ALTER TABLE t (ADD COLUMN | RENAME TO | RENAME COLUMN | DROP COLUMN)
    hvis kmd == "ALTER" og lengde(toks) >= 4 og _opp(toks[1]) == "TABLE" {
        la tnavn = toks[2]
        hvis ikke finnes_nøkkel(db["tabellar"], tnavn) { returner 0 - 1 }
        la t = db["tabellar"][tnavn]
        la j = 3
        la aksjon = _opp(toks[j])
        hvis aksjon == "ADD" {
            j = j + 1
            hvis j < lengde(toks) og _opp(toks[j]) == "COLUMN" { j = j + 1 }
            la kn = ""
            hvis j < lengde(toks) { kn = toks[j]; j = j + 1 }
            la kt = "TEXT"
            hvis j < lengde(toks) og ikke _er_kol_constraint_kw(toks[j]) { kt = toks[j]; j = j + 1 }
            // Valfrie constraints: DEFAULT <uttrykk> og NOT NULL. Eksisterande rader får
            // DEFAULT-verdien (SQLite), elles NULL.
            la c = _tab_c(t)
            la fyll = _NULLV()
            mens j < lengde(toks) {
                la au = _opp(toks[j])
                hvis au == "DEFAULT" og j + 1 < lengde(toks) {
                    j = j + 1
                    la dt = []
                    hvis toks[j] == "(" {
                        la dsub = _slice_paren(toks, j)
                        legg_til(dt, "(")
                        _legg_alle(dt, dsub["inner"])
                        legg_til(dt, ")")
                        j = dsub["etter"]
                    } ellers hvis (toks[j] == "-" eller toks[j] == "+") og j + 1 < lengde(toks) {
                        dt = [toks[j], toks[j + 1]]
                        j = j + 2
                    } ellers {
                        dt = [toks[j]]
                        j = j + 1
                    }
                    c["default"][kn] = dt
                    fyll = _eval_default(db, dt)
                } ellers hvis au == "NOT" og j + 1 < lengde(toks) og _opp(toks[j + 1]) == "NULL" {
                    legg_til(c["notnull"], kn)
                    j = j + 2
                } ellers hvis toks[j] == "(" {
                    j = _slice_paren(toks, j)["etter"]
                } ellers {
                    j = j + 1
                }
            }
            c["typar"][kn] = _opp(kt)
            motor.db_legg_til_kolonne(db, tnavn, kn, _tag_av_type(kt), fyll)
            _lagre_c(db, tnavn)
            returner 0
        }
        hvis aksjon == "RENAME" {
            j = j + 1
            hvis j < lengde(toks) og _opp(toks[j]) == "TO" {
                j = j + 1
                la nynavn = toks[j]
                motor.db_rename_tabell(db, tnavn, nynavn)
                returner 0
            }
            hvis j < lengde(toks) og _opp(toks[j]) == "COLUMN" { j = j + 1 }
            la gammal = ""
            hvis j < lengde(toks) { gammal = toks[j]; j = j + 1 }
            hvis j < lengde(toks) og _opp(toks[j]) == "TO" { j = j + 1 }
            la nynavn = ""
            hvis j < lengde(toks) { nynavn = toks[j] }
            _rename_kolonne(db, tnavn, gammal, nynavn)
            returner 0
        }
        hvis aksjon == "DROP" {
            j = j + 1
            hvis j < lengde(toks) og _opp(toks[j]) == "COLUMN" { j = j + 1 }
            la kn = ""
            hvis j < lengde(toks) { kn = toks[j] }
            _drop_kolonne(db, tnavn, kn)
            returner 0
        }
        returner 0 - 1
    }

    hvis kmd == "INSERT" og lengde(toks) >= 4 {
        la mode = ""
        la ci = 1
        hvis _opp(toks[ci]) == "OR" og ci + 1 < lengde(toks) {
            mode = _opp(toks[ci + 1])
            ci = ci + 2
        }
        hvis ci >= lengde(toks) eller _opp(toks[ci]) != "INTO" { returner -1 }
        ci = ci + 1
        la navn = toks[ci]
        ci = ci + 1
        la kol_namn = []
        la i = ci
        hvis i < lengde(toks) og toks[i] == "(" {
            i = i + 1
            mens i < lengde(toks) og toks[i] != ")" {
                hvis toks[i] != "," { legg_til(kol_namn, toks[i]) }
                i = i + 1
            }
            i = i + 1
        }
        mens i < lengde(toks) og _opp(toks[i]) != "VALUES" { i = i + 1 }
        i = i + 1
        // VALUES ( uttrykk , … ) [, ( … ) …] — kvar gruppe er éi rad (fleire rader i
        // éi setning er støtta). Kvart uttrykk blir evaluert (topp-nivå-komma).
        hvis ikke finnes_nøkkel(db["tabellar"], navn) {
            db["_siste_feil"] = "no such table: " + navn
            returner 0 - 1
        }
        la kt0 = _kt_ny(db, {})
        la grupper = []
        mens i < lengde(toks) og toks[i] == "(" {
            la vp = _slice_paren(toks, i)
            i = vp["etter"]
            legg_til(grupper, _verdi_gruppe(vp["inner"], kt0))
            hvis i < lengde(toks) og toks[i] == "," { i = i + 1 } ellers { bryt }
        }
        hvis lengde(grupper) == 0 { legg_til(grupper, []) }
        la t = db["tabellar"][navn]
        // Posisjon i VALUES for kvar tabellkolonne (-1 = ikkje gitt).
        la kn = t["kolnamn"]
        la pos_av = []
        la k = 0
        hvis lengde(kol_namn) == 0 {
            mens k < lengde(kn) { legg_til(pos_av, k); k = k + 1 }
        } ellers {
            la ip = {}
            la m = 0
            mens m < lengde(kol_namn) { ip[kol_namn[m]] = m; m = m + 1 }
            mens k < lengde(kn) {
                hvis finnes_nøkkel(ip, kn[k]) { legg_til(pos_av, ip[kn[k]]) } ellers { legg_til(pos_av, -1) }
                k = k + 1
            }
        }
        la totalt = 0
        la gi = 0
        mens gi < lengde(grupper) {
            la r = _sett_inn_ei_rad(db, navn, t, pos_av, grupper[gi], mode, toks, har_ret)
            hvis r < 0 { returner r }
            totalt = totalt + r
            gi = gi + 1
        }
        returner totalt
    }

    hvis kmd == "DELETE" og lengde(toks) >= 3 og _opp(toks[1]) == "FROM" {
        la navn = toks[2]
        hvis ikke finnes_nøkkel(db["tabellar"], navn) { db["_siste_feil"] = "no such table: " + navn; returner 0 - 1 }
        la wt = []
        hvis 3 < lengde(toks) og _opp(toks[3]) == "WHERE" { wt = _slice_fra(toks, 4) }
        la kt = _kt_ny(db, {})
        la plan = _enkel_plan(wt, navn, "")
        la kand = _indeks_kandidatar(db, {"tabell": navn, "alias": "", "where": wt})
        la rowids = kand["rowids"]
        hvis ikke kand["brukt"] { rowids = motor.db_rowids(db, navn) }
        la slettet = 0
        la r = 0
        mens r < lengde(rowids) {
            la treff = motor.db_finst(db, navn, rowids[r])
            la rad = {}
            hvis treff {
                rad = motor.db_hent(db, navn, rowids[r])
                treff = _rad_matchar(rad, wt, kt, plan)
            }
            hvis treff {
                hvis ikke _kaskade_restrict_ok(db, navn, rad, {}, "DELETE") { returner 0 - 1 }
                _fyr_triggers(db, "BEFORE", "DELETE", navn, {}, rad)
                motor.db_slett(db, navn, rowids[r])
                _kaskade_delete_apply(db, navn, rad)
                slettet = slettet + 1
                hvis har_ret { db["_ret_tab"] = navn; legg_til(db["_ret_rows"], rad) }
                _fyr_triggers(db, "AFTER", "DELETE", navn, {}, rad)
            }
            r = r + 1
        }
        returner slettet
    }

    hvis kmd == "UPDATE" og lengde(toks) >= 4 og _opp(toks[2]) == "SET" {
        la navn = toks[1]
        la set_kol = []
        la set_expr = []
        la i = 3
        mens i < lengde(toks) og _opp(toks[i]) != "WHERE" {
            hvis toks[i] == "," { i = i + 1; fortsett }
            hvis i + 1 < lengde(toks) og toks[i + 1] == "=" {
                la kol = toks[i]
                i = i + 2
                // RHS = uttrykk til topp-nivå-komma eller WHERE (støttar kol = kol + 1 osv).
                la rhs = []
                la dep = 0
                mens i < lengde(toks) {
                    hvis toks[i] == "(" { dep = dep + 1 } ellers hvis toks[i] == ")" { dep = dep - 1 }
                    hvis dep == 0 og (toks[i] == "," eller _opp(toks[i]) == "WHERE") { bryt }
                    legg_til(rhs, toks[i])
                    i = i + 1
                }
                legg_til(set_kol, kol)
                legg_til(set_expr, rhs)
            } ellers {
                i = i + 1
            }
        }
        la wt = []
        hvis i < lengde(toks) og _opp(toks[i]) == "WHERE" { wt = _slice_fra(toks, i + 1) }
        hvis ikke finnes_nøkkel(db["tabellar"], navn) { db["_siste_feil"] = "no such table: " + navn; returner 0 - 1 }
        la t = db["tabellar"][navn]
        la kt = _kt_ny(db, {})
        la plan = _enkel_plan(wt, navn, "")
        la kand = _indeks_kandidatar(db, {"tabell": navn, "alias": "", "where": wt})
        la rowids = kand["rowids"]
        hvis ikke kand["brukt"] { rowids = motor.db_rowids(db, navn) }
        // SET-uttrykk per kolonne (siste vinn, som før); -1 = uendra.
        la kn = t["kolnamn"]
        la set_av = []
        la k0 = 0
        mens k0 < lengde(kn) {
            la si = -1
            la s0 = 0
            mens s0 < lengde(set_kol) {
                hvis set_kol[s0] == kn[k0] { si = s0 }
                s0 = s0 + 1
            }
            legg_til(set_av, si)
            k0 = k0 + 1
        }
        la oppdatert = 0
        la r = 0
        mens r < lengde(rowids) {
            la treff = motor.db_finst(db, navn, rowids[r])
            la rad = {}
            hvis treff {
                rad = motor.db_hent(db, navn, rowids[r])
                treff = _rad_matchar(rad, wt, kt, plan)
            }
            hvis treff {
                la verdier = []
                la k = 0
                mens k < lengde(kn) {
                    la v = ""
                    hvis set_av[k] >= 0 {
                        v = _eval_uttrykk(set_expr[set_av[k]], rad, kt)
                    } ellers hvis finnes_nøkkel(rad, kn[k]) {
                        v = rad[kn[k]]
                    }
                    legg_til(verdier, v)
                    k = k + 1
                }
                la nyrad = _rad_av_verdier(t, verdier)
                la feil = _sjekk_constraints(db, navn, nyrad, rowids[r])
                hvis feil != "" { db["_siste_feil"] = feil; returner 0 - 1 }
                hvis ikke _kaskade_restrict_ok(db, navn, rad, nyrad, "UPDATE") { returner 0 - 1 }
                _fyr_triggers(db, "BEFORE", "UPDATE", navn, nyrad, rad)
                _oppdater_rad(db, navn, t, rowids[r], verdier)
                _kaskade_update_apply(db, navn, rad, nyrad)
                oppdatert = oppdatert + 1
                hvis har_ret { db["_ret_tab"] = navn; legg_til(db["_ret_rows"], nyrad) }
                _fyr_triggers(db, "AFTER", "UPDATE", navn, nyrad, rad)
            }
            r = r + 1
        }
        returner oppdatert
    }

    // Kjende men uimplementerte kontrollsetningar (PRAGMA + transaksjons-/
    // vedlikehaldsverb) => stille no-op (0), ikkje feilsignal. Speglar
    // selfhost/vm.no sin _vm_db_stmt_known slik at std.db og VM-motoren har
    // same feilsemantikk (jf. test_norsdb_feilsignal). Ukjend/ugyldig SQL
    // (t.d. skrivefeil) held distinkt -1 + siste_feil.
    hvis kmd == "PRAGMA" eller kmd == "BEGIN" eller kmd == "COMMIT" eller
        kmd == "ROLLBACK" eller kmd == "SAVEPOINT" eller kmd == "RELEASE" eller
        kmd == "VACUUM" eller kmd == "ANALYZE" eller kmd == "ATTACH" eller
        kmd == "DETACH" {
        returner 0
    }

    returner -1
}

// Interne: parse SELECT → {kolonner (namn eller *), tabell, where-start-indeks}
// Er token eit klausul-startande nøkkelord (topp-nivå-grense i WHERE/GROUP/HAVING)?
funksjon _er_klausul_kw(u: tekst) -> boolsk {
    returner u == "ORDER" eller u == "LIMIT" eller u == "OFFSET" eller u == "GROUP" eller u == "HAVING"
}

// Kan token vere ein tabell-alias (identifikator, ikkje nøkkelord/teiknsetjing)?
funksjon _er_alias_token(t: tekst) -> boolsk {
    la u = _opp(t)
    hvis u == "WHERE" eller u == "GROUP" eller u == "HAVING" eller u == "ORDER" eller u == "LIMIT" eller u == "OFFSET" eller u == "JOIN" eller u == "INNER" eller u == "LEFT" eller u == "RIGHT" eller u == "FULL" eller u == "CROSS" eller u == "ON" eller u == "AS" eller u == "UNION" eller u == "INTERSECT" eller u == "EXCEPT" { returner usann }
    hvis t == "(" eller t == ")" eller t == "," eller t == ";" { returner usann }
    la c0 = builtin.slice(t, 0, 1)
    returner _er_ident(c0) og ikke _er_siffer(c0)
}

funksjon _parse_select(toks) -> ordbok_tekst {
    la ut = {}
    la sel = []
    la sel_items = []
    la cur = []
    la dep = 0
    la i = 1
    la distinct = usann
    hvis i < lengde(toks) og _opp(toks[i]) == "DISTINCT" { distinct = sann; i = i + 1 } ellers hvis i < lengde(toks) og _opp(toks[i]) == "ALL" { i = i + 1 }
    // SELECT-liste til topp-nivå FROM (paren-djupne-bevisst; hopp over subquery-FROM).
    mens i < lengde(toks) {
        la stk = toks[i]
        hvis stk == "(" { dep = dep + 1 }
        ellers hvis stk == ")" { dep = dep - 1 }
        hvis dep == 0 og _opp(stk) == "FROM" { bryt }
        hvis stk == "," og dep == 0 {
            hvis lengde(cur) > 0 { legg_til(sel_items, cur) }
            cur = []
        } ellers {
            legg_til(sel, stk)
            legg_til(cur, stk)
        }
        i = i + 1
    }
    hvis lengde(cur) > 0 { legg_til(sel_items, cur) }
    hvis i < lengde(toks) og _opp(toks[i]) == "FROM" { i = i + 1 }

    // FROM: enten (SELECT …) subquery, eller tabellnamn. Deretter valfri alias.
    la tabell = ""
    la from_sub = []
    hvis i < lengde(toks) og toks[i] == "(" {
        la fsub = _slice_paren(toks, i)
        from_sub = fsub["inner"]
        i = fsub["etter"]
    } ellers hvis i < lengde(toks) {
        tabell = toks[i]
        i = i + 1
    }
    la alias = ""
    hvis i < lengde(toks) og _opp(toks[i]) == "AS" {
        i = i + 1
        hvis i < lengde(toks) { alias = toks[i]; i = i + 1 }
    } ellers hvis i < lengde(toks) og _er_alias_token(toks[i]) {
        alias = toks[i]
        i = i + 1
    }

    // JOIN-kjede: [INNER|LEFT|RIGHT|FULL|CROSS] JOIN tab [alias] [ON <uttrykk>], eller "," (implisitt CROSS).
    // Kvar join = {type, tabell, alias, on: [tokens]}. Multi-vilkår ON støtta via evaluatoren.
    la joins = []
    mens sann {
        la jtype = "INNER"
        la er_join = usann
        hvis i < lengde(toks) og toks[i] == "," {
            jtype = "CROSS"
            er_join = sann
            i = i + 1
        } ellers {
            la kw = ""
            hvis i < lengde(toks) { kw = _opp(toks[i]) }
            hvis kw == "INNER" eller kw == "LEFT" eller kw == "RIGHT" eller kw == "FULL" eller kw == "CROSS" {
                jtype = kw
                i = i + 1
                hvis i < lengde(toks) og _opp(toks[i]) == "OUTER" { i = i + 1 }
            }
            hvis i < lengde(toks) og _opp(toks[i]) == "JOIN" {
                er_join = sann
                i = i + 1
            }
        }
        hvis ikke er_join { bryt }
        la jtab = ""
        hvis i < lengde(toks) { jtab = toks[i]; i = i + 1 }
        la jalias = ""
        hvis i < lengde(toks) og _opp(toks[i]) == "AS" {
            i = i + 1
            hvis i < lengde(toks) { jalias = toks[i]; i = i + 1 }
        } ellers hvis i < lengde(toks) og _er_alias_token(toks[i]) {
            jalias = toks[i]
            i = i + 1
        }
        la on_toks = []
        hvis i < lengde(toks) og _opp(toks[i]) == "ON" {
            i = i + 1
            la od = 0
            mens i < lengde(toks) {
                la u = _opp(toks[i])
                hvis toks[i] == "(" { od = od + 1 }
                ellers hvis toks[i] == ")" { od = od - 1 }
                hvis od == 0 og (u == "WHERE" eller u == "GROUP" eller u == "HAVING" eller u == "ORDER" eller u == "LIMIT" eller u == "OFFSET" eller u == "JOIN" eller u == "INNER" eller u == "LEFT" eller u == "RIGHT" eller u == "FULL" eller u == "CROSS" eller toks[i] == ",") { bryt }
                legg_til(on_toks, toks[i])
                i = i + 1
            }
        }
        legg_til(joins, {"type": jtype, "tabell": jtab, "alias": jalias, "on": on_toks})
    }

    la where_toks = []
    la order_col = ""
    la order_asc = sann
    la limit_n = -1
    la offset_n = 0
    la group_by = []
    la having_toks = []

    hvis i < lengde(toks) og _opp(toks[i]) == "WHERE" {
        i = i + 1
        la wd = 0
        mens i < lengde(toks) {
            hvis toks[i] == "(" { wd = wd + 1 }
            ellers hvis toks[i] == ")" { wd = wd - 1 }
            hvis wd == 0 og _er_klausul_kw(_opp(toks[i])) { bryt }
            legg_til(where_toks, toks[i])
            i = i + 1
        }
    }
    mens i < lengde(toks) {
        la tk = _opp(toks[i])
        hvis tk == "GROUP" {
            i = i + 1
            hvis i < lengde(toks) og _opp(toks[i]) == "BY" { i = i + 1 }
            la gd = 0
            mens i < lengde(toks) {
                hvis toks[i] == "(" { gd = gd + 1 }
                ellers hvis toks[i] == ")" { gd = gd - 1 }
                hvis gd == 0 og (_opp(toks[i]) == "ORDER" eller _opp(toks[i]) == "LIMIT" eller _opp(toks[i]) == "OFFSET" eller _opp(toks[i]) == "HAVING") { bryt }
                hvis toks[i] != "," { legg_til(group_by, toks[i]) }
                i = i + 1
            }
        } ellers hvis tk == "HAVING" {
            i = i + 1
            la hd = 0
            mens i < lengde(toks) {
                hvis toks[i] == "(" { hd = hd + 1 }
                ellers hvis toks[i] == ")" { hd = hd - 1 }
                hvis hd == 0 og (_opp(toks[i]) == "ORDER" eller _opp(toks[i]) == "LIMIT" eller _opp(toks[i]) == "OFFSET") { bryt }
                legg_til(having_toks, toks[i])
                i = i + 1
            }
        } ellers hvis tk == "ORDER" {
            i = i + 1
            hvis i < lengde(toks) og _opp(toks[i]) == "BY" { i = i + 1 }
            hvis i < lengde(toks) { order_col = toks[i]; i = i + 1 }
            hvis i < lengde(toks) og _opp(toks[i]) == "DESC" {
                order_asc = usann
                i = i + 1
            } ellers hvis i < lengde(toks) og _opp(toks[i]) == "ASC" {
                i = i + 1
            }
        } ellers hvis tk == "LIMIT" {
            i = i + 1
            hvis i < lengde(toks) { limit_n = builtin.heltall_fra_tekst(toks[i]); i = i + 1 }
        } ellers hvis tk == "OFFSET" {
            i = i + 1
            hvis i < lengde(toks) { offset_n = builtin.heltall_fra_tekst(toks[i]); i = i + 1 }
        } ellers {
            i = i + 1
        }
    }

    ut["sel"] = sel
    ut["sel_items"] = sel_items
    ut["distinct"] = distinct
    ut["tabell"] = tabell
    ut["alias"] = alias
    ut["from_sub"] = from_sub
    ut["where"] = where_toks
    ut["order_col"] = order_col
    ut["order_asc"] = order_asc
    ut["limit"] = limit_n
    ut["offset"] = offset_n
    ut["group_by"] = group_by
    ut["having"] = having_toks
    ut["joins"] = joins
    returner ut
}

// Kolonnenamn utan tabell-prefiks: "folk.by" → "by".
funksjon _kolnavn(ref: tekst) -> tekst {
    la idx = builtin.index_of(ref, ".")
    hvis idx >= 0 { returner builtin.slice(ref, idx + 1, lengde(ref)) }
    returner ref
}

// Tabell-/alias-prefiks: "folk.by" → "folk"; utan prefiks → "".
funksjon _kolprefiks(ref: tekst) -> tekst {
    la idx = builtin.index_of(ref, ".")
    hvis idx >= 0 { returner builtin.slice(ref, 0, idx) }
    returner ""
}

// Ei "null-rad" med same kolonnar som `sample`, alle sett til NULL-sentinel.
// For outer-join-utfyll av den umatcha sida (SQLite: umatcha kolonnar → NULL).
funksjon _null_rad(sample) -> ordbok_tekst {
    la m = {}
    la ks = nøkler(sample)
    la i = 0
    mens i < lengde(ks) { m[ks[i]] = _NULLV(); i = i + 1 }
    returner m
}

// Slå saman ei (alt akkumulert) venstre-rad med ei høgre rad. Høgre-kolonnar leggjast
// inn både kvalifisert ("a2.kol") og ukvalifisert ("kol").
funksjon _merge_inn(lr, rr, a2: tekst) -> ordbok_tekst {
    la m = {}
    la lk = nøkler(lr)
    la i = 0
    mens i < lengde(lk) { m[lk[i]] = lr[lk[i]]; i = i + 1 }
    la rk = nøkler(rr)
    i = 0
    mens i < lengde(rk) {
        m[a2 + "." + rk[i]] = rr[rk[i]]
        m[rk[i]] = rr[rk[i]]
        i = i + 1
    }
    returner m
}

// Join av akkumulerte venstre-rader med ei høgre-tabell. ON-uttrykk (`on_toks`) evaluerast
// mot den samanslåtte rada (multi-vilkår via evaluatoren). Handterar INNER/LEFT/RIGHT/FULL/CROSS.
funksjon _join2(venstre, hoyre, a2: tekst, on_toks, jtype: tekst, kt) -> liste {
    la ut = []
    la hoyre_matchet = []
    la hi = 0
    mens hi < lengde(hoyre) { legg_til(hoyre_matchet, usann); hi = hi + 1 }
    la li = 0
    mens li < lengde(venstre) {
        la lr = venstre[li]
        la matchet = usann
        la rj = 0
        mens rj < lengde(hoyre) {
            la merged = _merge_inn(lr, hoyre[rj], a2)
            la ok = sann
            hvis lengde(on_toks) > 0 { ok = _match(merged, on_toks, kt) }
            hvis ok {
                legg_til(ut, merged)
                matchet = sann
                hoyre_matchet[rj] = sann
            }
            rj = rj + 1
        }
        hvis ikke matchet og (jtype == "LEFT" eller jtype == "FULL") {
            la h_null = {}
            hvis lengde(hoyre) > 0 { h_null = _null_rad(hoyre[0]) }
            legg_til(ut, _merge_inn(lr, h_null, a2))
        }
        li = li + 1
    }
    hvis jtype == "RIGHT" eller jtype == "FULL" {
        la v_null = {}
        hvis lengde(venstre) > 0 { v_null = _null_rad(venstre[0]) }
        la rk = 0
        mens rk < lengde(hoyre) {
            hvis ikke hoyre_matchet[rk] {
                legg_til(ut, _merge_inn(v_null, hoyre[rk], a2))
            }
            rk = rk + 1
        }
    }
    returner ut
}

// Bygg join-resultatet ved å folde JOIN-kjeda venstre→høgre.
funksjon _joinede_rader(db, p) -> liste {
    la kt = _kt_ny(db, {})
    la a1 = p["tabell"]
    hvis finnes_nøkkel(p, "alias") og p["alias"] != "" { a1 = p["alias"] }
    la akk = []
    la base = motor.db_alle(db, p["tabell"])
    la bi = 0
    mens bi < lengde(base) { legg_til(akk, _merge_inn({}, base[bi], a1)); bi = bi + 1 }
    la joins = p["joins"]
    la ji = 0
    mens ji < lengde(joins) {
        la jn = joins[ji]
        la a2 = jn["tabell"]
        hvis jn["alias"] != "" { a2 = jn["alias"] }
        akk = _join2(akk, motor.db_alle(db, jn["tabell"]), a2, jn["on"], jn["type"], kt)
        ji = ji + 1
    }
    returner akk
}

funksjon _filtrer_liste(alle, wt, kt) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(alle) {
        hvis _match(alle[i], wt, kt) { legg_til(ut, alle[i]) }
        i = i + 1
    }
    returner ut
}

funksjon _er_range_op(op: tekst) -> boolsk {
    returner op == ">" eller op == "<" eller op == ">=" eller op == "<="
}

funksjon _legg_alle(mål, kjelde) {
    la i = 0
    mens i < lengde(kjelde) { legg_til(mål, kjelde[i]); i = i + 1 }
}

// ── WHERE-analyse: enkle predikat + indeks-kandidatar (punkt 5d) ──────
// Er token eit reint kolonnenamn (ikkje tal/streng/nøkkelord/konstant)?
funksjon _er_kolref(t: tekst) -> boolsk {
    hvis t == "" { returner usann }
    la c0 = builtin.char_code(t)
    hvis ikke ((c0 >= 65 og c0 <= 90) eller (c0 >= 97 og c0 <= 122) eller c0 == 95 eller c0 >= 128) { returner usann }
    la u = _opp(t)
    returner ikke (u == "NOT" eller u == "NULL" eller u == "AND" eller u == "OR" eller u == "CASE" eller u == "EXISTS" eller u == "TRUE" eller u == "FALSE" eller u == "CURRENT_TIMESTAMP" eller u == "CURRENT_DATE" eller u == "CURRENT_TIME" eller u == "SELECT" eller u == "IN" eller u == "IS" eller u == "LIKE" eller u == "BETWEEN")
}

// Er token ein literal (tal eller 'tekst', ikkje x'…'-blob)?
funksjon _er_lit(t: tekst) -> boolsk {
    hvis t == "" { returner usann }
    la c0 = builtin.char_code(t)
    hvis c0 == 39 { returner sann }
    hvis (c0 >= 48 og c0 <= 57) eller c0 == 45 eller c0 == 46 { returner _er_tal(t) }
    returner usann
}

funksjon _lit_v(t: tekst) -> tekst {
    hvis builtin.char_code(t) == 39 { returner _unquote(t) }
    returner t
}

funksjon _er_cmp_op(t: tekst) -> boolsk {
    returner t == "=" eller t == "==" eller t == "!=" eller t == "<>" eller t == "<" eller t == "<=" eller t == ">" eller t == ">="
}

// Kolonnenamn frå ein referanse: "kol" eller "tab.kol" der tab er denne tabellen
// (eller aliaset). Returnerer "" om referansen peikar på noko anna.
funksjon _eigen_kol(ref: tekst, navn: tekst, alias: tekst) -> tekst {
    hvis builtin.index_of(ref, ".") < 0 { returner ref }
    la pre = _kolprefiks(ref)
    hvis pre == navn eller (alias != "" og pre == alias) { returner _kolnavn(ref) }
    returner ""
}

// Plan for ein WHERE som berre er «kol op literal» / «kol IS [NOT] NULL» bunde med
// AND. Då kan rader sjekkast direkte utan uttrykks-evaluatoren (same semantikk).
funksjon _enkel_plan(wt, navn: tekst, alias: tekst) -> ordbok {
    la plan = {"ok": usann, "kol": [], "op": [], "lit": [], "litk": [], "lt": [], "li": []}
    la n = lengde(wt)
    hvis n == 0 { returner plan }
    la i = 0
    mens i < n {
        hvis i + 2 >= n { returner plan }
        la kol = _eigen_kol(wt[i], navn, alias)
        hvis kol == "" eller ikke _er_kolref(kol) { returner plan }
        la op = wt[i + 1]
        la neste = i + 3
        hvis _er_cmp_op(op) og _er_lit(wt[i + 2]) {
            la lv = _lit_v(wt[i + 2])
            la lk = motor.sorteringsnøkkel(lv)
            legg_til(plan["kol"], kol)
            hvis op == "==" { op = "=" }
            legg_til(plan["op"], op)
            legg_til(plan["lit"], lv)
            legg_til(plan["litk"], lk)
            legg_til(plan["lt"], builtin.char_code(lk) == 51)
            // Kanonisk heiltal-literal (t.d. 4, 123): rask likskap utan nøkkel.
            la kan = usann
            hvis builtin.char_code(lk) == 50 og builtin.index_of(lv, ".") < 0 og builtin.char_code(lv) != 43 og (lv == "0" eller builtin.char_code(lv) != 48) { kan = sann }
            legg_til(plan["li"], kan)
        } ellers hvis _opp(op) == "IS" og _opp(wt[i + 2]) == "NULL" {
            legg_til(plan["kol"], kol)
            legg_til(plan["op"], "ISNULL")
            legg_til(plan["lit"], "")
            legg_til(plan["litk"], "")
            legg_til(plan["lt"], usann)
            legg_til(plan["li"], usann)
        } ellers hvis _opp(op) == "IS" og i + 3 < n og _opp(wt[i + 2]) == "NOT" og _opp(wt[i + 3]) == "NULL" {
            legg_til(plan["kol"], kol)
            legg_til(plan["op"], "NOTNULL")
            legg_til(plan["lit"], "")
            legg_til(plan["litk"], "")
            legg_til(plan["lt"], usann)
            legg_til(plan["li"], usann)
            neste = i + 4
        } ellers {
            returner plan
        }
        hvis neste < n {
            hvis _opp(wt[neste]) != "AND" { returner plan }
            neste = neste + 1
            hvis neste >= n { returner plan }
        }
        i = neste
    }
    plan["ok"] = sann
    returner plan
}

// Kan verdien a (≠ ein kanonisk heiltal-literal som tekst) likevel vere numerisk
// lik literalen? Berre om a er ei ikkje-kanonisk talform ("04", "4.0", "-0").
funksjon _kan_ikkje_vere_lik_int(a: tekst) -> boolsk {
    hvis a == "" { returner sann }
    la c = builtin.char_code(a)
    hvis c == 48 eller c == 45 eller c == 46 { returner usann }
    returner builtin.index_of(a, ".") < 0
}

funksjon _enkel_match(rad, plan) -> boolsk {
    la kols = plan["kol"]
    la ops = plan["op"]
    la i = 0
    la n = lengde(kols)
    mens i < n {
        la a = ""
        hvis finnes_nøkkel(rad, kols[i]) { a = rad[kols[i]] }
        la op = ops[i]
        hvis op == "ISNULL" {
            hvis ikke _ern(a) { returner usann }
        } ellers hvis op == "NOTNULL" {
            hvis _ern(a) { returner usann }
        } ellers hvis op == "=" og plan["lt"][i] {
            // Tekst-literal: SQL-likskap er her rein tekstlikskap.
            hvis a != plan["lit"][i] { returner usann }
        } ellers hvis op == "=" og plan["li"][i] og a != plan["lit"][i] og _kan_ikkje_vere_lik_int(a) {
            returner usann
        } ellers hvis op == "=" og plan["li"][i] og a == plan["lit"][i] {
            // Lik tekst og literalen er eit heiltal → lik.
            i = i + 1
            fortsett
        } ellers {
            hvis _ern(a) { returner usann }
            la ka = motor.sorteringsnøkkel(a)
            la kb = plan["litk"][i]
            hvis (builtin.char_code(ka) == 51) != plan["lt"][i] {
                ka = a
                kb = plan["lit"][i]
            }
            hvis op == "=" { hvis ka != kb { returner usann } }
            ellers hvis op == "!=" eller op == "<>" { hvis ka == kb { returner usann } }
            ellers hvis op == "<" { hvis ikke (ka < kb) { returner usann } }
            ellers hvis op == "<=" { hvis ikke (ka <= kb) { returner usann } }
            ellers hvis op == ">" { hvis ikke (ka > kb) { returner usann } }
            ellers hvis op == ">=" { hvis ikke (ka >= kb) { returner usann } }
        }
        i = i + 1
    }
    returner sann
}

// Filtrer rader med WHERE: enkel plan om mogleg, elles uttrykks-evaluatoren.
funksjon _filtrer_med(rader, wt, kt, plan) -> liste {
    hvis lengde(wt) == 0 { returner rader }
    la ut = []
    la i = 0
    la n = lengde(rader)
    hvis plan["ok"] {
        // Vanlegaste forma: éin likskap mot ein tekst- eller heiltal-literal. Ein
        // annan talform med same verdi som eit kanonisk heiltal ("04", "4.0") er
        // alltid lengre, så berre lengre verdiar treng full sjekk.
        hvis lengde(plan["kol"]) == 1 og plan["op"][0] == "=" og (plan["lt"][0] eller plan["li"][0]) {
            la kol = plan["kol"][0]
            la lit = plan["lit"][0]
            la ll = lengde(lit)
            la tekstlit = plan["lt"][0]
            mens i < n {
                la rad = rader[i]
                hvis finnes_nøkkel(rad, kol) {
                    la a = rad[kol]
                    hvis a == lit {
                        legg_til(ut, rad)
                    } ellers hvis (ikke tekstlit) og lengde(a) > ll og _enkel_match(rad, plan) {
                        legg_til(ut, rad)
                    }
                } ellers hvis _enkel_match(rad, plan) {
                    legg_til(ut, rad)
                }
                i = i + 1
            }
            returner ut
        }
        mens i < n {
            hvis _enkel_match(rader[i], plan) { legg_til(ut, rader[i]) }
            i = i + 1
        }
        returner ut
    }
    mens i < n {
        hvis _match(rader[i], wt, kt) { legg_til(ut, rader[i]) }
        i = i + 1
    }
    returner ut
}

funksjon _rad_matchar(rad, wt, kt, plan) -> boolsk {
    hvis lengde(wt) == 0 { returner sann }
    hvis plan["ok"] { returner _enkel_match(rad, plan) }
    returner _match(rad, wt, kt)
}

// Toppnivå-konjunktar av forma «kol op literal» / «kol BETWEEN a AND b» i WHERE.
// Tom liste om WHERE har eit toppnivå-OR (då kan ingen enkeltterm avgrense).
funksjon _where_termar(wt, navn: tekst, alias: tekst) -> liste {
    la ut = []
    la n = lengde(wt)
    la d = 0
    la j = 0
    mens j < n {
        hvis wt[j] == "(" { d = d + 1 } ellers hvis wt[j] == ")" { d = d - 1 }
        hvis d == 0 og _opp(wt[j]) == "OR" { returner [] }
        j = j + 1
    }
    la i = 0
    mens i < n {
        la ferdig = usann
        hvis i + 2 < n og _er_cmp_op(wt[i + 1]) og _er_lit(wt[i + 2]) og (i + 3 == n eller _opp(wt[i + 3]) == "AND") {
            la kol = _eigen_kol(wt[i], navn, alias)
            hvis kol != "" og _er_kolref(kol) {
                la op = wt[i + 1]
                hvis op == "==" { op = "=" }
                legg_til(ut, {"kol": kol, "op": op, "v": _lit_v(wt[i + 2]), "v2": ""})
            }
            i = i + 4
            ferdig = sann
        } ellers hvis i + 4 < n og _opp(wt[i + 1]) == "BETWEEN" og _er_lit(wt[i + 2]) og _opp(wt[i + 3]) == "AND" og _er_lit(wt[i + 4]) og (i + 5 == n eller _opp(wt[i + 5]) == "AND") {
            la kol = _eigen_kol(wt[i], navn, alias)
            hvis kol != "" og _er_kolref(kol) {
                legg_til(ut, {"kol": kol, "op": "BETWEEN", "v": _lit_v(wt[i + 2]), "v2": _lit_v(wt[i + 4])})
            }
            i = i + 6
            ferdig = sann
        }
        hvis ikke ferdig {
            // Hopp til neste toppnivå-AND (BETWEEN … AND … høyrer til termen).
            la dd = 0
            la mellom = usann
            mens i < n {
                la u = _opp(wt[i])
                hvis wt[i] == "(" { dd = dd + 1 } ellers hvis wt[i] == ")" { dd = dd - 1 }
                hvis dd == 0 og u == "BETWEEN" { mellom = sann }
                ellers hvis dd == 0 og u == "AND" {
                    hvis mellom { mellom = usann } ellers { bryt }
                }
                i = i + 1
            }
            i = i + 1
        }
    }
    returner ut
}

// Kandidat-rowids frå ordna indeks for eit område (tal-bevisst, sjå _cmp):
// området innanfor same klasse (tal/tekst) som literalen, pluss alle oppføringar
// av den andre klassen (der _cmp samanliknar rått som tekst). Verifiserast etterpå.
funksjon _område_kand(db, navn: tekst, kol: tekst, op: tekst, v: tekst, v2: tekst) -> liste {
    la k = motor.sorteringsnøkkel(v)
    hvis k == "0" { returner [] }
    la tekst_kl = builtin.char_code(k) == 51
    la ks = "1"
    la ke = "3"
    la ke_har = sann
    hvis tekst_kl { ks = "3"; ke = ""; ke_har = usann }
    la r = []
    hvis op == ">" { r = motor.db_indeks_område(db, navn, kol, sann, k, usann, ke_har, ke, usann) }
    ellers hvis op == ">=" { r = motor.db_indeks_område(db, navn, kol, sann, k, sann, ke_har, ke, usann) }
    ellers hvis op == "<" { r = motor.db_indeks_område(db, navn, kol, sann, ks, sann, sann, k, usann) }
    ellers hvis op == "<=" { r = motor.db_indeks_område(db, navn, kol, sann, ks, sann, sann, k, sann) }
    ellers hvis op == "BETWEEN" {
        la k2 = motor.sorteringsnøkkel(v2)
        hvis (builtin.char_code(k2) == 51) != tekst_kl { returner [] }
        r = motor.db_indeks_område(db, navn, kol, sann, k, sann, sann, k2, sann)
    }
    // Den andre klassen.
    la andre = []
    hvis tekst_kl {
        andre = motor.db_indeks_område(db, navn, kol, sann, "1", sann, sann, "3", usann)
    } ellers {
        andre = motor.db_indeks_område(db, navn, kol, sann, "3", sann, usann, "", sann)
    }
    _legg_alle(r, andre)
    returner motor.sorter_tal(r)
}

funksjon _er_unik_kol(c, kol: tekst) -> boolsk {
    la i = 0
    mens i < lengde(c["unique"]) {
        hvis lengde(c["unique"][i]) > 0 og c["unique"][i][0] == kol { returner sann }
        i = i + 1
    }
    returner usann
}

// Avgrens WHERE med indeks når mogleg. Returnerer {brukt, rowids (stigande), kol, kva}.
// Likskap på INTEGER PRIMARY KEY (rowid-alias) > ordna indeks > UNIQUE-kolonne
// (latent hash); deretter område (>, <, >=, <=, BETWEEN) på ordna indeks.
// Kandidatane blir alltid verifiserte mot heile WHERE etterpå, så svaret er det same
// som ved full skann.
funksjon _indeks_kandidatar(db, p) -> ordbok_tekst {
    la tab = p["tabell"]
    la ingen = {"brukt": usann, "rowids": [], "kol": "", "kva": ""}
    hvis tab == "" eller ikke finnes_nøkkel(db["tabellar"], tab) { returner ingen }
    la alias = ""
    hvis finnes_nøkkel(p, "alias") { alias = p["alias"] }
    la termar = _where_termar(p["where"], tab, alias)
    hvis lengde(termar) == 0 { returner ingen }
    la t = db["tabellar"][tab]
    la c = _tab_c(t)
    la pass = 0
    mens pass < 3 {
        la i = 0
        mens i < lengde(termar) {
            la tm = termar[i]
            hvis tm["op"] == "=" {
                la kol = tm["kol"]
                la ok = usann
                la kva = "INDEX"
                hvis pass == 0 og c["rowid_alias"] != "" og kol == c["rowid_alias"] { ok = sann; kva = "INTEGER PRIMARY KEY" }
                hvis pass == 1 og motor.db_har_indeks(db, tab, kol) { ok = sann }
                hvis pass == 2 og _er_unik_kol(c, kol) { ok = sann }
                hvis ok {
                    // Er heile WHERE berre denne likskapen, er kandidatane sjølve svaret
                    // (indeks-/alias-likskap == SQL-likskap, sjå _cmp); ingen ny sjekk.
                    la eksakt = lengde(termar) == 1 og lengde(p["where"]) == 3
                    returner {"brukt": sann, "rowids": _lik_kandidatar(db, tab, kol, tm["v"]), "kol": kol, "kva": kva, "eksakt": eksakt}
                }
            }
            i = i + 1
        }
        pass = pass + 1
    }
    la j = 0
    mens j < lengde(termar) {
        la tm = termar[j]
        la op = tm["op"]
        hvis (op == "<" eller op == "<=" eller op == ">" eller op == ">=" eller op == "BETWEEN") og motor.db_har_indeks(db, tab, tm["kol"]) {
            returner {"brukt": sann, "rowids": _område_kand(db, tab, tm["kol"], op, tm["v"], tm["v2"]), "kol": tm["kol"], "kva": "INDEX"}
        }
        j = j + 1
    }
    returner ingen
}

// WHERE-filtrerte rader. Handterer JOIN, og brukar indeks (equality + range + BETWEEN)
// når mogleg. Kandidatar re-verifiserast med _match, så resultatet er alltid korrekt.
funksjon _filtrer(db, p) -> liste {
    returner _filtrer_kt(db, p, {})
}

// Som _filtrer, men med ytre rad-scope (`ytre`) for korrelerte subqueries.
// Indeks-snarveg deaktiverast når WHERE er korrelert (ytre ikkje tom), for korrektheit.
funksjon _filtrer_kt(db, p, ytre) -> liste {
    la kt = _kt_ny(db, ytre)
    kt["navn"] = p["tabell"]
    kt["alias"] = ""
    hvis finnes_nøkkel(p, "alias") { kt["alias"] = p["alias"] }
    // FROM (SELECT …): materialiser subquery som baserader, filtrer så ytre WHERE.
    hvis finnes_nøkkel(p, "from_sub") og lengde(p["from_sub"]) > 0 {
        returner _filtrer_liste(_subq_projiser(db, p["from_sub"], ytre), p["where"], kt)
    }
    // FROM <view>: materialiser view-spørjinga som baserader.
    hvis _er_view(db, p["tabell"]) {
        returner _filtrer_liste(_subq_projiser(db, db["_views"][p["tabell"]], ytre), p["where"], kt)
    }
    hvis finnes_nøkkel(p, "joins") og lengde(p["joins"]) > 0 {
        returner _filtrer_liste(_joinede_rader(db, p), p["where"], kt)
    }
    // FROM-laus SELECT (t.d. "SELECT 1"): éi syntetisk rad gjennom WHERE.
    hvis p["tabell"] == "" {
        returner _filtrer_liste([{}], p["where"], kt)
    }
    hvis ikke finnes_nøkkel(db["tabellar"], p["tabell"]) { returner [] }
    hvis lengde(nøkler(ytre)) == 0 {
        la plan = _enkel_plan(p["where"], p["tabell"], kt["alias"])
        la kand = _indeks_kandidatar(db, p)
        hvis kand["brukt"] {
            la rader = motor.db_rader(db, p["tabell"], kand["rowids"])
            hvis finnes_nøkkel(kand, "eksakt") og kand["eksakt"] { returner rader }
            returner _filtrer_med(rader, p["where"], kt, plan)
        }
        returner _filtrer_med(motor.db_alle(db, p["tabell"]), p["where"], kt, plan)
    }
    returner _filtrer_liste(motor.db_alle(db, p["tabell"]), p["where"], kt)
}

// ── ORDER BY utan full sortering (punkt 5d) ──────────────────────────
// Ordna, WHERE-filtrerte rader for ein vanleg SELECT. Er ORDER BY-kolonnen
// indeksert, blir indeksen lesen i orden (og stoppa etter OFFSET+LIMIT treff);
// er det INTEGER PRIMARY KEY (og alle id-ar ligg på sin rowid), blir radlageret
// lese i rowid-orden. Elles: filtrer, så topp-k (med LIMIT) eller full sortering.
// Like nøklar kjem alltid i stigande rowid (som den stabile sorteringa).
funksjon _ordna_rader(db, p) -> liste {
    la oc = p["order_col"]
    hvis oc == "" { returner _filtrer(db, p) }
    la tab = p["tabell"]
    la alias = ""
    hvis finnes_nøkkel(p, "alias") { alias = p["alias"] }
    la grense = -1
    hvis p["limit"] >= 0 og ikke p["distinct"] {
        grense = p["limit"]
        hvis p["offset"] > 0 { grense = grense + p["offset"] }
    }
    hvis tab != "" og lengde(p["from_sub"]) == 0 og lengde(p["joins"]) == 0 og finnes_nøkkel(db["tabellar"], tab) og ikke _er_view(db, tab) {
        la kol = _eigen_kol(oc, tab, alias)
        hvis kol != "" {
            la t = db["tabellar"][tab]
            la c = _tab_c(t)
            la kand = _indeks_kandidatar(db, p)
            hvis ikke kand["brukt"] {
                hvis motor.db_har_indeks(db, tab, kol) { returner _skann_indeks_orden(db, p, tab, alias, kol, grense) }
                hvis c["rowid_alias"] != "" og kol == c["rowid_alias"] {
                    _alias_sikre(db, tab, t)
                    hvis lengde(nøkler(t["_alias_unntak"])) == 0 { returner _skann_rowid_orden(db, p, tab, alias, grense) }
                }
            }
        }
    }
    la rader = _filtrer(db, p)
    hvis grense >= 0 { returner _topp_k(rader, oc, p["order_asc"], grense) }
    returner _sorter(rader, oc, p["order_asc"])
}

funksjon _skann_kt(db, tab: tekst, alias: tekst) -> ordbok {
    la kt = _kt_ny(db, {})
    kt["navn"] = tab
    kt["alias"] = alias
    returner kt
}

funksjon _skann_rowid_orden(db, p, tab: tekst, alias: tekst, grense: heltall) -> liste {
    la kt = _skann_kt(db, tab, alias)
    la plan = _enkel_plan(p["where"], tab, alias)
    la ut = []
    la n = motor.db_next_rowid(db, tab)
    la r = 1
    la skritt = 1
    hvis ikke p["order_asc"] {
        r = n - 1
        skritt = -1
    }
    mens r >= 1 og r < n {
        hvis motor.db_finst(db, tab, r) {
            la rad = motor.db_hent(db, tab, r)
            hvis _rad_matchar(rad, p["where"], kt, plan) {
                legg_til(ut, rad)
                hvis grense >= 0 og lengde(ut) >= grense { returner ut }
            }
        }
        r = r + skritt
    }
    returner ut
}

funksjon _skann_indeks_orden(db, p, tab: tekst, alias: tekst, kol: tekst, grense: heltall) -> liste {
    la kt = _skann_kt(db, tab, alias)
    la plan = _enkel_plan(p["where"], tab, alias)
    la asc = p["order_asc"]
    la ut = []
    la har = usann
    la sk = ""
    la sr = 0
    // Synkande: samle ein heil run med lik nøkkel og snu han, så like nøklar kjem i
    // stigande rowid.
    la run = []
    la run_k = ""
    mens sann {
        la b = motor.db_indeks_skann(db, tab, kol, asc, har, sk, sr, 64)
        la n = lengde(b["k"])
        la i = 0
        mens i < n {
            la k = b["k"][i]
            hvis ikke asc og lengde(run) > 0 og k != run_k {
                // Run ferdig: legg til i stigande rowid.
                la j = lengde(run) - 1
                mens j >= 0 {
                    la rad = motor.db_hent(db, tab, run[j])
                    hvis _rad_matchar(rad, p["where"], kt, plan) { legg_til(ut, rad) }
                    j = j - 1
                }
                run = []
                hvis grense >= 0 og lengde(ut) >= grense { returner _snitt(ut, 0, grense) }
            }
            hvis b["gyldig"][i] == 1 {
                hvis asc {
                    la rad = motor.db_hent(db, tab, b["r"][i])
                    hvis _rad_matchar(rad, p["where"], kt, plan) {
                        legg_til(ut, rad)
                        hvis grense >= 0 og lengde(ut) >= grense { returner ut }
                    }
                } ellers {
                    legg_til(run, b["r"][i])
                    run_k = k
                }
            }
            i = i + 1
        }
        hvis n == 0 { bryt }
        sk = b["k"][n - 1]
        sr = b["r"][n - 1]
        har = sann
        hvis n < 64 { bryt }
    }
    la j = lengde(run) - 1
    mens j >= 0 {
        la rad = motor.db_hent(db, tab, run[j])
        hvis _rad_matchar(rad, p["where"], kt, plan) { legg_til(ut, rad) }
        j = j - 1
    }
    hvis grense >= 0 { returner _snitt(ut, 0, grense) }
    returner ut
}

// Stabil sortering på ein kolonne i SQL-orden (NULL < tal < tekst; tal-bevisst):
// sorteringsnøkkel per rad (éin gong), så flettesortering — O(n log n) mot den
// gamle utvalssorteringa sin O(n²). Like verdiar held skann-rekkjefølgja.
funksjon _sorter(rader, kol: tekst, asc: boolsk) -> liste {
    la n = lengde(rader)
    hvis n < 2 { returner rader }
    la ks = []
    la i = 0
    mens i < n {
        la v = ""
        hvis finnes_nøkkel(rader[i], kol) { v = rader[i][kol] }
        legg_til(ks, motor.sorteringsnøkkel(v))
        i = i + 1
    }
    la orden = motor.sorter_indeksar(ks, asc)
    la ut = []
    i = 0
    mens i < n {
        legg_til(ut, rader[orden[i]])
        i = i + 1
    }
    returner ut
}

// Dei k fyrste radene i sortert orden utan å sortere alt: held ein sortert
// buffer på k (binærsøk + innsetjing). O(n log k) samanlikningar.
funksjon _topp_k(rader, kol: tekst, asc: boolsk, k: heltall) -> liste {
    la n = lengde(rader)
    hvis k <= 0 { returner [] }
    hvis k * 4 >= n { returner _snitt(_sorter(rader, kol, asc), 0, k) }
    la bk = []
    la br = []
    la i = 0
    mens i < n {
        la v = ""
        hvis finnes_nøkkel(rader[i], kol) { v = rader[i][kol] }
        la key = motor.sorteringsnøkkel(v)
        la m = lengde(bk)
        // Hopp over raskt om bufferen er full og rada ikkje slår den verste.
        la med = sann
        hvis m >= k {
            hvis asc { med = key < bk[m - 1] } ellers { med = key > bk[m - 1] }
        }
        hvis med {
            // Første posisjon der rada skal inn (etter like nøklar → stabil).
            la lo = 0
            la hi = m
            mens lo < hi {
                la mid = (lo + hi) / 2
                la etter = usann
                hvis asc { etter = bk[mid] <= key } ellers { etter = bk[mid] >= key }
                hvis etter { lo = mid + 1 } ellers { hi = mid }
            }
            hvis m < k {
                legg_til(bk, key)
                legg_til(br, rader[i])
                m = m + 1
            }
            la j = m - 1
            mens j > lo {
                bk[j] = bk[j - 1]
                br[j] = br[j - 1]
                j = j - 1
            }
            bk[lo] = key
            br[lo] = rader[i]
        }
        i = i + 1
    }
    returner br
}

funksjon _snitt(rader, offset: heltall, limit: heltall) -> liste {
    hvis offset <= 0 og limit < 0 { returner rader }
    la ut = []
    la start = offset
    hvis start < 0 { start = 0 }
    la i = start
    la tatt = 0
    mens i < lengde(rader) {
        hvis limit >= 0 og tatt >= limit { bryt }
        legg_til(ut, rader[i])
        tatt = tatt + 1
        i = i + 1
    }
    returner ut
}

// Del select-items i felt: "col" (kolonne) eller "agg" (COUNT/SUM/AVG/MIN/MAX(arg)).
// Klassifiser SELECT-element (token-lister frå sel_items) i felt:
//   star = "*",  agg = COUNT/SUM/…,  col = eitt reint kolonne-namn,  expr = uttrykk (evaluerast per rad).
funksjon _sel_felt(items) -> ordbok_tekst {
    la kind = []
    la a = []
    la b = []
    la expr = []
    la si = 0
    mens si < lengde(items) {
        la it = items[si]
        la t0 = _opp(it[0])
        hvis lengde(it) == 1 og it[0] == "*" {
            legg_til(kind, "star")
            legg_til(a, "*")
            legg_til(b, "")
            legg_til(expr, [])
        } ellers hvis _item_har_over(it) {
            // Vindusfunksjon: FN(...) OVER (...) — sjekk FØR agg (SUM(x) OVER er vindu, ikkje agg).
            legg_til(kind, "window")
            legg_til(a, _opp(it[0]))
            legg_til(b, "")
            legg_til(expr, it)
        } ellers hvis lengde(it) >= 2 og (t0 == "COUNT" eller t0 == "SUM" eller t0 == "AVG" eller t0 == "MIN" eller t0 == "MAX" eller t0 == "GROUP_CONCAT" eller t0 == "STRING_AGG" eller t0 == "TOTAL") og it[1] == "(" {
            // string_agg = Postgres-namn på group_concat (separator er alltid 2. arg).
            hvis t0 == "STRING_AGG" { t0 = "GROUP_CONCAT" }
            la arg = "*"
            // COUNT(DISTINCT kol) / SUM(DISTINCT kol) osv: hopp over DISTINCT-nøkkelordet
            // og kod distinkt-flagget inn i arg med "DISTINCT "-prefiks (kolonnenamn er
            // enkelt-tokens utan mellomrom, så prefikset kolliderer ikkje).
            la argi = 2
            hvis lengde(it) >= 3 og _opp(it[2]) == "DISTINCT" { argi = 3 }
            hvis lengde(it) > argi og it[argi] != ")" {
                hvis argi == 3 { arg = "DISTINCT " + it[argi] } ellers { arg = it[argi] }
            }
            legg_til(kind, "agg")
            legg_til(a, t0)
            legg_til(b, arg)
            legg_til(expr, it)
        } ellers hvis lengde(it) == 1 og ikke _er_tal(it[0]) og builtin.slice(it[0], 0, 1) != "'" {
            legg_til(kind, "col")
            legg_til(a, it[0])
            legg_til(b, "")
            legg_til(expr, [])
        } ellers {
            legg_til(kind, "expr")
            legg_til(a, "")
            legg_til(b, "")
            legg_til(expr, it)
        }
        si = si + 1
    }
    returner {"kind": kind, "a": a, "b": b, "expr": expr}
}

// DISTINCT-handtering for aggregat: arg med "DISTINCT "-prefiks → dedupliser radene
// på kolonneverdien (behald første rad per verdi) og returner rein kolonne. NULL/""
// blir éin distinkt verdi; COUNT hoppar over den via si eiga v != ""-sjekk (SQLite-likt).
funksjon _agg_dedup(rader, arg: tekst) -> ordbok_tekst {
    hvis lengde(arg) > 9 og builtin.slice(arg, 0, 9) == "DISTINCT " {
        la kol = builtin.slice(arg, 9, lengde(arg))
        la sett = {}
        la nye = []
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], kol) { v = rader[i][kol] }
            hvis ikke finnes_nøkkel(sett, v) { sett[v] = sann; legg_til(nye, rader[i]) }
            i = i + 1
        }
        returner {"arg": kol, "rader": nye}
    }
    returner {"arg": arg, "rader": rader}
}

// Aggregat over ei liste rader. AVG = heiltalsdivisjon (G1).
funksjon _agg_over(rader, fn: tekst, arg: tekst) -> heltall {
    la _dd = _agg_dedup(rader, arg)
    rader = _dd["rader"]
    arg = _dd["arg"]
    hvis fn == "COUNT" {
        hvis arg == "*" { returner lengde(rader) }
        la c = 0
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
            hvis ikke _ern(v) { c = c + 1 }
            i = i + 1
        }
        returner c
    }
    hvis fn == "MIN" eller fn == "MAX" {
        la first = sann
        la best = 0
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
            hvis _er_tal(v) {
                la x = builtin.heltall_fra_tekst(v)
                hvis first {
                    best = x
                    first = usann
                } ellers hvis fn == "MIN" og x < best {
                    best = x
                } ellers hvis fn == "MAX" og x > best {
                    best = x
                }
            }
            i = i + 1
        }
        returner best
    }
    la total = 0
    la cnt = 0
    la i = 0
    mens i < lengde(rader) {
        la v = ""
        hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
        hvis _er_tal(v) {
            total = total + builtin.heltall_fra_tekst(v)
            cnt = cnt + 1
        }
        i = i + 1
    }
    hvis fn == "SUM" eller fn == "TOTAL" { returner total }
    hvis cnt == 0 { returner 0 }
    returner total / cnt
}

// Tekst-aggregat: GROUP_CONCAT gjev tekst; numeriske delegerer til _agg_over.
// `item` = heile token-lista for aggregatet (for å hente valfri separator).
funksjon _agg_txt(rader, fn: tekst, arg: tekst, item) -> tekst {
    la _dd = _agg_dedup(rader, arg)
    rader = _dd["rader"]
    arg = _dd["arg"]
    hvis fn == "GROUP_CONCAT" {
        la sep = ","
        // Finn valfri separator: GROUP_CONCAT(kol, 'sep') → token etter topp-nivå-komma.
        la k = 2
        mens k < lengde(item) og item[k] != "," og item[k] != ")" { k = k + 1 }
        hvis k + 1 < lengde(item) og item[k] == "," { sep = _unquote(item[k + 1]) }
        la deler = []
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
            hvis ikke _ern(v) { legg_til(deler, v) }
            i = i + 1
        }
        returner builtin.join(deler, sep)
    }
    hvis fn == "AVG" {
        la sum = builtin.desimaltall("0")
        la cnt = 0
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
            hvis _er_tal(v) { sum = sum + builtin.desimaltall(v); cnt = cnt + 1 }
            i = i + 1
        }
        hvis cnt == 0 { returner "" }
        returner _fmt_real(sum / builtin.desimaltall(tekst_fra_heltall(cnt)))
    }
    hvis fn == "SUM" eller fn == "TOTAL" {
        la sum = builtin.desimaltall("0")
        la har_real = usann
        la har_verdi = usann
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
            hvis _er_tal(v) {
                sum = sum + builtin.desimaltall(v)
                har_verdi = sann
                hvis _er_real(v) { har_real = sann }
            }
            i = i + 1
        }
        hvis fn == "SUM" og ikke har_verdi { returner "" }
        hvis har_real eller fn == "TOTAL" { returner _fmt_real(sum) }
        returner tekst_fra_heltall(_flyt_trunk(sum))
    }
    hvis fn == "MIN" eller fn == "MAX" {
        la best = ""
        la har = usann
        la i = 0
        mens i < lengde(rader) {
            la v = ""
            hvis finnes_nøkkel(rader[i], arg) { v = rader[i][arg] }
            hvis ikke _ern(v) {
                hvis ikke har { best = v; har = sann } ellers hvis fn == "MIN" og _cmp(v, "<", best) { best = v } ellers hvis fn == "MAX" og _cmp(v, ">", best) { best = v }
            }
            i = i + 1
        }
        returner best
    }
    returner tekst_fra_heltall(_agg_over(rader, fn, arg))
}

// HAVING: eit aggregat-uttrykk samanlikna med ein verdi (t.d. COUNT(*) > 1).
funksjon _having(grp, toks) -> boolsk {
    hvis lengde(toks) < 4 { returner sann }
    la fn = _opp(toks[0])
    la j = 0
    mens j < lengde(toks) og toks[j] != ")" { j = j + 1 }
    la arg = "*"
    hvis j >= 3 { arg = toks[2] }
    hvis j + 2 >= lengde(toks) { returner sann }
    la aggval = _agg_over(grp, fn, arg)
    returner _cmp(tekst_fra_heltall(aggval), toks[j + 1], _unquote(toks[j + 2]))
}

// ── Set-operasjonar + linje-hjelparar (Fase 7e) ──────────────────────
funksjon _slice_range(toks, a: heltall, b: heltall) -> liste {
    la ut = []
    la i = a
    mens i < b { legg_til(ut, toks[i]); i = i + 1 }
    returner ut
}

funksjon _splittlinjer(s: tekst) -> liste {
    hvis s == "" { returner [] }
    returner builtin.split(s, "\n")
}

funksjon _snitt_linjer(linjer, offset: heltall, limit: heltall) -> liste {
    la ut = []
    la i = offset
    hvis i < 0 { i = 0 }
    la tatt = 0
    mens i < lengde(linjer) og (limit < 0 eller tatt < limit) {
        legg_til(ut, linjer[i])
        tatt = tatt + 1
        i = i + 1
    }
    returner ut
}

funksjon _dedup_linjer(linjer) -> liste {
    la sett = {}
    la ut = []
    la i = 0
    mens i < lengde(linjer) {
        hvis ikke finnes_nøkkel(sett, linjer[i]) {
            sett[linjer[i]] = "1"
            legg_til(ut, linjer[i])
        }
        i = i + 1
    }
    returner ut
}

funksjon _linje_felt0(linje: tekst) -> tekst {
    la b = builtin.index_of(linje, "|")
    hvis b >= 0 { returner builtin.slice(linje, 0, b) }
    returner linje
}

funksjon _linje_mindre(a: tekst, b: tekst) -> boolsk {
    la fa = _linje_felt0(a)
    la fb = _linje_felt0(b)
    hvis _er_tal(fa) og _er_tal(fb) { returner _cmp(fa, "<", fb) }
    returner fa < fb
}

// Selection-sort på første felt (tal-bevisst), stigande/synkande.
funksjon _sorter_linjer(linjer, asc: boolsk) -> liste {
    la ut = []
    la n = 0
    mens n < lengde(linjer) { legg_til(ut, linjer[n]); n = n + 1 }
    la i = 0
    mens i < lengde(ut) {
        la best = i
        la j = i + 1
        mens j < lengde(ut) {
            la swap = usann
            hvis asc { swap = _linje_mindre(ut[j], ut[best]) } ellers { swap = _linje_mindre(ut[best], ut[j]) }
            hvis swap { best = j }
            j = j + 1
        }
        la tmp = ut[i]
        ut[i] = ut[best]
        ut[best] = tmp
        i = i + 1
    }
    returner ut
}

// Finn første topp-nivå set-operator. {har, op, venstre, hoyre}.
funksjon _finn_setop(toks) -> ordbok {
    la dep = 0
    la i = 0
    mens i < lengde(toks) {
        hvis toks[i] == "(" { dep = dep + 1 } ellers hvis toks[i] == ")" { dep = dep - 1 } ellers hvis dep == 0 {
            la u = _opp(toks[i])
            hvis u == "UNION" eller u == "INTERSECT" eller u == "EXCEPT" {
                la op = u
                la nxt = i + 1
                hvis u == "UNION" og nxt < lengde(toks) og _opp(toks[nxt]) == "ALL" { op = "UNION ALL"; nxt = nxt + 1 }
                returner {"har": sann, "op": op, "venstre": _slice_range(toks, 0, i), "hoyre": _slice_range(toks, nxt, lengde(toks))}
            }
        }
        i = i + 1
    }
    returner {"har": usann, "op": "", "venstre": [], "hoyre": []}
}

// Trekk ut topp-nivå ORDER BY / LIMIT som gjeld heile set-op-uttrykket.
funksjon _setop_order(toks) -> ordbok {
    la dep = 0
    la op_i = 0 - 1
    la lim_i = 0 - 1
    la i = 0
    mens i < lengde(toks) {
        hvis toks[i] == "(" { dep = dep + 1 } ellers hvis toks[i] == ")" { dep = dep - 1 } ellers hvis dep == 0 {
            la u = _opp(toks[i])
            hvis u == "ORDER" og op_i < 0 { op_i = i }
            hvis u == "LIMIT" og lim_i < 0 { lim_i = i }
        }
        i = i + 1
    }
    la slutt = lengde(toks)
    hvis op_i >= 0 og op_i < slutt { slutt = op_i }
    hvis lim_i >= 0 og lim_i < slutt { slutt = lim_i }
    la order_har = usann
    la asc = sann
    la limit = 0 - 1
    la offset = 0
    hvis op_i >= 0 {
        order_har = sann
        la j = op_i + 1
        hvis j < lengde(toks) og _opp(toks[j]) == "BY" { j = j + 1 }
        hvis j < lengde(toks) { j = j + 1 }
        hvis j < lengde(toks) og _opp(toks[j]) == "DESC" { asc = usann }
    }
    hvis lim_i >= 0 {
        la j = lim_i + 1
        hvis j < lengde(toks) { limit = builtin.heltall_fra_tekst(toks[j]); j = j + 1 }
        hvis j < lengde(toks) og _opp(toks[j]) == "OFFSET" { j = j + 1; hvis j < lengde(toks) { offset = builtin.heltall_fra_tekst(toks[j]) } }
    }
    returner {"kropp": _slice_range(toks, 0, slutt), "order_har": order_har, "asc": asc, "limit": limit, "offset": offset}
}

funksjon _komb_setop(op: tekst, vl, hl) -> liste {
    hvis op == "UNION ALL" {
        la ut = []
        _legg_alle(ut, vl)
        _legg_alle(ut, hl)
        returner ut
    }
    hvis op == "INTERSECT" eller op == "EXCEPT" {
        la hs = {}
        la i = 0
        mens i < lengde(hl) { hs[hl[i]] = "1"; i = i + 1 }
        la ut = []
        i = 0
        mens i < lengde(vl) {
            la inn = finnes_nøkkel(hs, vl[i])
            hvis (op == "INTERSECT" og inn) eller (op == "EXCEPT" og ikke inn) { legg_til(ut, vl[i]) }
            i = i + 1
        }
        returner _dedup_linjer(ut)
    }
    // UNION
    la ut = []
    _legg_alle(ut, vl)
    _legg_alle(ut, hl)
    returner _dedup_linjer(ut)
}

// ── Vindusfunksjonar (Fase 7g) ───────────────────────────────────────
funksjon _item_har_over(it) -> boolsk {
    la i = 0
    mens i < lengde(it) {
        hvis _opp(it[i]) == "OVER" { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon _har_vindu(felt) -> boolsk {
    la i = 0
    mens i < lengde(felt["kind"]) {
        hvis felt["kind"][i] == "window" { returner sann }
        i = i + 1
    }
    returner usann
}

// Parse "FN(arg) OVER (PARTITION BY … ORDER BY … [ASC|DESC])".
funksjon _parse_window(item) -> ordbok {
    la fn = _opp(item[0])
    la i = 1
    la arg = "*"
    la wargs = []
    hvis i < lengde(item) og item[i] == "(" {
        i = i + 1
        mens i < lengde(item) og item[i] != ")" {
            hvis item[i] != "," { legg_til(wargs, item[i]) }
            i = i + 1
        }
        hvis i < lengde(item) og item[i] == ")" { i = i + 1 }
    }
    hvis lengde(wargs) > 0 { arg = wargs[0] }
    hvis i < lengde(item) og _opp(item[i]) == "OVER" { i = i + 1 }
    la part = []
    la ocol = ""
    la oasc = sann
    hvis i < lengde(item) og item[i] == "(" {
        i = i + 1
        mens i < lengde(item) og item[i] != ")" {
            la u = _opp(item[i])
            hvis u == "PARTITION" {
                i = i + 1
                hvis i < lengde(item) og _opp(item[i]) == "BY" { i = i + 1 }
                mens i < lengde(item) og item[i] != ")" og _opp(item[i]) != "ORDER" {
                    hvis item[i] != "," { legg_til(part, item[i]) }
                    i = i + 1
                }
            } ellers hvis u == "ORDER" {
                i = i + 1
                hvis i < lengde(item) og _opp(item[i]) == "BY" { i = i + 1 }
                hvis i < lengde(item) og item[i] != ")" { ocol = item[i]; i = i + 1 }
                hvis i < lengde(item) og _opp(item[i]) == "DESC" { oasc = usann; i = i + 1 } ellers hvis i < lengde(item) og _opp(item[i]) == "ASC" { i = i + 1 }
            } ellers {
                i = i + 1
            }
        }
    }
    returner {"fn": fn, "arg": arg, "args": wargs, "part": part, "ocol": ocol, "oasc": oasc}
}

funksjon _part_key(rad, part) -> tekst {
    la deler = []
    la i = 0
    mens i < lengde(part) {
        la v = ""
        hvis finnes_nøkkel(rad, part[i]) { v = rad[part[i]] }
        legg_til(deler, v)
        i = i + 1
    }
    returner builtin.join(deler, "")
}

// Stabil sortering av rad-indeksar på ein kolonne (tal-bevisst, bevar orden ved likheit).
funksjon _stabil_sort_idx(rader, idxs, kol: tekst, asc: boolsk) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(idxs) { legg_til(ut, idxs[i]); i = i + 1 }
    // insertion sort (stabil)
    i = 1
    mens i < lengde(ut) {
        la cur = ut[i]
        la cv = ""
        hvis finnes_nøkkel(rader[cur], kol) { cv = rader[cur][kol] }
        la j = i - 1
        mens j >= 0 {
            la jv = ""
            hvis finnes_nøkkel(rader[ut[j]], kol) { jv = rader[ut[j]][kol] }
            la storre = usann
            hvis asc { storre = _cmp(jv, ">", cv) } ellers { storre = _cmp(cv, ">", jv) }
            hvis ikke storre { bryt }
            ut[j + 1] = ut[j]
            j = j - 1
        }
        ut[j + 1] = cur
        i = i + 1
    }
    returner ut
}

funksjon _vindu_ein_part(rader, idxs, w, resultat) {
    la fn = w["fn"]
    hvis fn == "ROW_NUMBER" {
        la rn = 1
        la j = 0
        mens j < lengde(idxs) { resultat[idxs[j]] = tekst_fra_heltall(rn); rn = rn + 1; j = j + 1 }
        returner 0
    }
    hvis fn == "RANK" eller fn == "DENSE_RANK" {
        la prev = ""
        la har_prev = usann
        la rank = 0
        la dense = 0
        la count = 0
        la j = 0
        mens j < lengde(idxs) {
            count = count + 1
            la val = ""
            hvis finnes_nøkkel(rader[idxs[j]], w["ocol"]) { val = rader[idxs[j]][w["ocol"]] }
            hvis (ikke har_prev) eller val != prev { dense = dense + 1; rank = count; prev = val; har_prev = sann }
            hvis fn == "DENSE_RANK" { resultat[idxs[j]] = tekst_fra_heltall(dense) } ellers { resultat[idxs[j]] = tekst_fra_heltall(rank) }
            j = j + 1
        }
        returner 0
    }
    // LAG/LEAD — verdi frå rad `offset` før/etter i den ordna partisjonen (default 1).
    hvis fn == "LAG" eller fn == "LEAD" {
        la off = 1
        hvis lengde(w["args"]) >= 2 { off = builtin.heltall_fra_tekst(w["args"][1]) }
        la defv = _NULLV()
        hvis lengde(w["args"]) >= 3 {
            la dt = w["args"][2]
            hvis lengde(dt) >= 2 og builtin.slice(dt, 0, 1) == "'" { defv = _unquote(dt) } ellers { defv = dt }
        }
        la col = w["arg"]
        la j = 0
        mens j < lengde(idxs) {
            la src = j - off
            hvis fn == "LEAD" { src = j + off }
            hvis src >= 0 og src < lengde(idxs) {
                la r = rader[idxs[src]]
                hvis finnes_nøkkel(r, col) { resultat[idxs[j]] = r[col] } ellers { resultat[idxs[j]] = "" }
            } ellers {
                resultat[idxs[j]] = defv
            }
            j = j + 1
        }
        returner 0
    }
    // FIRST_VALUE — fyrste rad i partisjonen (default-ramme).
    hvis fn == "FIRST_VALUE" {
        la fv = ""
        hvis lengde(idxs) > 0 og finnes_nøkkel(rader[idxs[0]], w["arg"]) { fv = rader[idxs[0]][w["arg"]] }
        la j = 0
        mens j < lengde(idxs) { resultat[idxs[j]] = fv; j = j + 1 }
        returner 0
    }
    // LAST_VALUE — default-ramma sluttar på CURRENT ROW → gjeldande rad sin verdi (Postgres-quirk).
    hvis fn == "LAST_VALUE" {
        la j = 0
        mens j < lengde(idxs) {
            hvis finnes_nøkkel(rader[idxs[j]], w["arg"]) { resultat[idxs[j]] = rader[idxs[j]][w["arg"]] } ellers { resultat[idxs[j]] = "" }
            j = j + 1
        }
        returner 0
    }
    // NTH_VALUE(col, n) — n-te verdi (1-basert); NULL til ramma har nådd rad n.
    hvis fn == "NTH_VALUE" {
        la nn = 1
        hvis lengde(w["args"]) >= 2 { nn = builtin.heltall_fra_tekst(w["args"][1]) }
        la j = 0
        mens j < lengde(idxs) {
            hvis nn >= 1 og j + 1 >= nn {
                hvis finnes_nøkkel(rader[idxs[nn - 1]], w["arg"]) { resultat[idxs[j]] = rader[idxs[nn - 1]][w["arg"]] } ellers { resultat[idxs[j]] = "" }
            } ellers {
                resultat[idxs[j]] = _NULLV()
            }
            j = j + 1
        }
        returner 0
    }
    // NTILE(n) — del partisjonen i n bøtter; dei første `rem` bøttene får éi rad ekstra.
    hvis fn == "NTILE" {
        la nb = builtin.heltall_fra_tekst(w["arg"])
        hvis nb < 1 { nb = 1 }
        la cnt = lengde(idxs)
        la base = cnt / nb
        la rem = cnt - base * nb
        la bucket = 1
        la in_b = 0
        la cap = base
        hvis rem > 0 { cap = base + 1 }
        la j = 0
        mens j < lengde(idxs) {
            mens in_b >= cap og bucket < nb {
                bucket = bucket + 1
                in_b = 0
                cap = base
                hvis bucket <= rem { cap = base + 1 }
            }
            resultat[idxs[j]] = tekst_fra_heltall(bucket)
            in_b = in_b + 1
            j = j + 1
        }
        returner 0
    }
    // Aggregat OVER: heile partisjon (utan ORDER) eller løpande (med ORDER, ROWS-ramme).
    hvis w["ocol"] == "" {
        la delrader = []
        la j = 0
        mens j < lengde(idxs) { legg_til(delrader, rader[idxs[j]]); j = j + 1 }
        la aggv = _agg_txt(delrader, fn, w["arg"], [])
        j = 0
        mens j < lengde(idxs) { resultat[idxs[j]] = aggv; j = j + 1 }
    } ellers {
        la delrader = []
        la j = 0
        mens j < lengde(idxs) {
            legg_til(delrader, rader[idxs[j]])
            resultat[idxs[j]] = _agg_txt(delrader, fn, w["arg"], [])
            j = j + 1
        }
    }
    returner 0
}

// Rekn ut vindus-verdiar for alle rader (justert til `rader`-indeks).
funksjon _vindu_verdiar(rader, w) -> liste {
    la resultat = []
    la z = 0
    mens z < lengde(rader) { legg_til(resultat, ""); z = z + 1 }
    la pkeys = []
    la pmap = {}
    la i = 0
    mens i < lengde(rader) {
        la key = _part_key(rader[i], w["part"])
        hvis ikke finnes_nøkkel(pmap, key) { pmap[key] = []; legg_til(pkeys, key) }
        legg_til(pmap[key], i)
        i = i + 1
    }
    la pi = 0
    mens pi < lengde(pkeys) {
        la idxs = pmap[pkeys[pi]]
        hvis w["ocol"] != "" { idxs = _stabil_sort_idx(rader, idxs, w["ocol"], w["oasc"]) }
        _vindu_ein_part(rader, idxs, w, resultat)
        pi = pi + 1
    }
    returner resultat
}

// ── CTE (Fase 7f): WITH [RECURSIVE] n AS (…), … <hovudspørjing> ───────
funksjon _er_with(toks) -> boolsk {
    returner lengde(toks) > 0 og _opp(toks[0]) == "WITH"
}

// Sett CTE-temp-tabell `navn` = rader (drop+opprett+insert). Kolonnar frå `cols`.
funksjon _sett_cte_tabell(db, navn: tekst, cols, rader) {
    la kolonner = []
    la ci = 0
    mens ci < lengde(cols) { legg_til(kolonner, {"navn": cols[ci], "tag": motor.tag_tekst()}); ci = ci + 1 }
    // Mellombels tabell: aldri logga til WAL. Ein ekte tabell med same namn blir
    // skugga og lagd attende i _rydd_cte.
    hvis finnes_nøkkel(db["tabellar"], navn) {
        la gml = db["tabellar"][navn]
        hvis ikke (finnes_nøkkel(gml, "temp") og gml["temp"]) {
            hvis ikke finnes_nøkkel(db, "_cte_skugga") { db["_cte_skugga"] = {} }
            db["_cte_skugga"][navn] = gml
        }
        fjern_nokkel(db["tabellar"], navn)
    }
    motor.db_opprett_temp(db, navn, kolonner)
    la ri = 0
    mens ri < lengde(rader) {
        la verdier = []
        la k = 0
        mens k < lengde(cols) {
            la v = ""
            hvis finnes_nøkkel(rader[ri], cols[k]) { v = rader[ri][cols[k]] }
            legg_til(verdier, v)
            k = k + 1
        }
        motor.db_sett_inn(db, navn, verdier)
        ri = ri + 1
    }
}

funksjon _rad_lik(a, b, cols) -> boolsk {
    la k = 0
    mens k < lengde(cols) {
        la av = ""
        hvis finnes_nøkkel(a, cols[k]) { av = a[cols[k]] }
        la bv = ""
        hvis finnes_nøkkel(b, cols[k]) { bv = b[cols[k]] }
        hvis av != bv { returner usann }
        k = k + 1
    }
    returner sann
}

funksjon _rad_finst(liste, rad, cols) -> boolsk {
    la i = 0
    mens i < lengde(liste) {
        hvis _rad_lik(liste[i], rad, cols) { returner sann }
        i = i + 1
    }
    returner usann
}

// Nøkle-om til deklarerte CTE-kolonnenamn (posisjonelt).
funksjon _remap_rader(rader, frakols, tilkols) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(rader) {
        la nr = {}
        la k = 0
        mens k < lengde(tilkols) {
            la v = ""
            hvis k < lengde(frakols) og finnes_nøkkel(rader[i], frakols[k]) { v = rader[i][frakols[k]] }
            nr[tilkols[k]] = v
            k = k + 1
        }
        legg_til(ut, nr)
        i = i + 1
    }
    returner ut
}

// Ikkje-rekursiv CTE: materialiser subquery-resultatet som temp-tabell.
// `declcols` = deklarerte kolonnenamn (frå "navn(a,b)"), tom om ikkje oppgitt.
funksjon _materialiser_ett_cte(db, navn: tekst, subtoks, declcols) {
    la rader = _subq_projiser(db, subtoks, {})
    la derived = []
    hvis lengde(rader) > 0 { derived = nøkler(rader[0]) }
    la cols = derived
    hvis lengde(declcols) > 0 {
        rader = _remap_rader(rader, derived, declcols)
        cols = declcols
    }
    _sett_cte_tabell(db, navn, cols, rader)
}

// Rekursiv CTE: base UNION [ALL] rekursiv. Semi-naiv fikspunkt-iterasjon.
funksjon _materialiser_rec_cte(db, navn: tekst, subtoks, declcols) {
    la sp = _finn_setop(subtoks)
    hvis ikke sp["har"] {
        _materialiser_ett_cte(db, navn, subtoks, declcols)
        returner 0
    }
    la result = _subq_projiser(db, sp["venstre"], {})
    la derived = []
    hvis lengde(result) > 0 { derived = nøkler(result[0]) }
    la cols = derived
    hvis lengde(declcols) > 0 { result = _remap_rader(result, derived, declcols); cols = declcols }
    la working = result
    la iter = 0
    mens lengde(working) > 0 og iter < 10000 {
        _sett_cte_tabell(db, navn, cols, working)
        la kand = _subq_projiser(db, sp["hoyre"], {})
        hvis lengde(declcols) > 0 og lengde(kand) > 0 { kand = _remap_rader(kand, nøkler(kand[0]), declcols) }
        la nye = []
        la j = 0
        mens j < lengde(kand) {
            hvis (ikke _rad_finst(result, kand[j], cols)) og (ikke _rad_finst(nye, kand[j], cols)) { legg_til(nye, kand[j]) }
            j = j + 1
        }
        hvis lengde(nye) == 0 { bryt }
        _legg_alle(result, nye)
        working = nye
        iter = iter + 1
    }
    _sett_cte_tabell(db, navn, cols, result)
    returner 0
}

// Materialiser alle CTE-ar. Returnerer {main: hovud-toks, temp: [namn]}.
funksjon _materialiser_cte(db, toks) -> ordbok {
    la i = 1
    la recursive = usann
    hvis i < lengde(toks) og _opp(toks[i]) == "RECURSIVE" { recursive = sann; i = i + 1 }
    la temp = []
    mens i < lengde(toks) {
        la navn = toks[i]
        i = i + 1
        // valfri deklarert kolonneliste ( a , b , … )
        la declcols = []
        hvis i < lengde(toks) og toks[i] == "(" {
            la g = _les_kol_liste(toks, i)
            declcols = g["cols"]
            i = g["etter"]
        }
        hvis i < lengde(toks) og _opp(toks[i]) == "AS" { i = i + 1 }
        hvis i >= lengde(toks) eller toks[i] != "(" { bryt }
        la sub = _slice_paren(toks, i)
        i = sub["etter"]
        hvis recursive { _materialiser_rec_cte(db, navn, sub["inner"], declcols) } ellers { _materialiser_ett_cte(db, navn, sub["inner"], declcols) }
        legg_til(temp, navn)
        hvis i < lengde(toks) og toks[i] == "," { i = i + 1; fortsett }
        bryt
    }
    returner {"main": _slice_range(toks, i, lengde(toks)), "temp": temp}
}

funksjon _rydd_cte(db, temp) {
    la i = 0
    mens i < lengde(temp) {
        hvis finnes_nøkkel(db["tabellar"], temp[i]) { fjern_nokkel(db["tabellar"], temp[i]) }
        hvis finnes_nøkkel(db, "_cte_skugga") og finnes_nøkkel(db["_cte_skugga"], temp[i]) {
            db["tabellar"][temp[i]] = db["_cte_skugga"][temp[i]]
            fjern_nokkel(db["_cte_skugga"], temp[i])
        }
        i = i + 1
    }
}

// query_int: COUNT/SUM/AVG/MIN/MAX over WHERE-filtrerte rader (skalar; ignorer GROUP/ORDER/LIMIT).
funksjon query_int(db, sql: tekst) -> heltall {
    la toks0 = _tok_c(db, sql)
    la temp = []
    hvis _er_with(toks0) {
        la cte = _materialiser_cte(db, toks0)
        toks0 = cte["main"]
        temp = cte["temp"]
    }
    la p = _parse_select(toks0)
    la rader = _filtrer(db, p)
    la felt = _sel_felt(p["sel_items"])
    la svar = lengde(rader)
    hvis lengde(felt["kind"]) >= 1 og felt["kind"][0] == "agg" {
        svar = _agg_over(rader, felt["a"][0], felt["b"][0])
    } ellers hvis lengde(felt["kind"]) >= 1 og felt["kind"][0] == "expr" {
        // Skalar uttrykk (t.d. SELECT last_insert_rowid(), SELECT 1+1): evaluer
        // uttrykket på fyrste rad i staden for å returnere radtalet.
        la rad0 = {}
        hvis lengde(rader) > 0 { rad0 = rader[0] }
        la ev = _ex_or(felt["expr"][0], 0, rad0, _kt_ny(db, {}))
        svar = builtin.heltall_fra_tekst(tekst(ev["v"]))
    }
    _rydd_cte(db, temp)
    returner svar
}

// GROUP BY-eksekusjon → "|"/"\n"-delimitert (som query_rader). Grupper sortert på
// gruppenøkkel (SQLite default) om inga ORDER BY.
funksjon _group_rader(db, p) -> tekst {
    la rader = _filtrer(db, p)
    la group_cols = p["group_by"]
    la felt = _sel_felt(p["sel_items"])
    la having = p["having"]

    la keys = []
    la groups = {}
    la r = 0
    mens r < lengde(rader) {
        la kdel = []
        la g = 0
        mens g < lengde(group_cols) {
            la gv = ""
            hvis finnes_nøkkel(rader[r], group_cols[g]) { gv = rader[r][group_cols[g]] }
            legg_til(kdel, gv)
            g = g + 1
        }
        la key = builtin.join(kdel, "|")
        hvis ikke finnes_nøkkel(groups, key) {
            groups[key] = []
            legg_til(keys, key)
        }
        legg_til(groups[key], rader[r])
        r = r + 1
    }

    la resultrader = []
    la ki = 0
    mens ki < lengde(keys) {
        la grp = groups[keys[ki]]
        hvis lengde(having) == 0 eller _having(grp, having) {
            la rr = {}
            la fi = 0
            mens fi < lengde(felt["kind"]) {
                hvis felt["kind"][fi] == "agg" {
                    rr["f" + tekst_fra_heltall(fi)] = _agg_txt(grp, felt["a"][fi], felt["b"][fi], felt["expr"][fi])
                } ellers hvis felt["kind"][fi] == "expr" {
                    rr["f" + tekst_fra_heltall(fi)] = _ex_or(felt["expr"][fi], 0, grp[0], _kt_ny(db, {}))["v"]
                } ellers {
                    la cn = felt["a"][fi]
                    la v = ""
                    hvis finnes_nøkkel(grp[0], cn) { v = grp[0][cn] }
                    rr["f" + tekst_fra_heltall(fi)] = v
                    rr[cn] = v
                }
                fi = fi + 1
            }
            legg_til(resultrader, rr)
        }
        ki = ki + 1
    }

    la sort_col = p["order_col"]
    hvis sort_col == "" og lengde(group_cols) > 0 { sort_col = group_cols[0] }
    resultrader = _sorter(resultrader, sort_col, p["order_asc"])
    resultrader = _snitt(resultrader, p["offset"], p["limit"])

    la linjer = []
    la rj = 0
    mens rj < lengde(resultrader) {
        la ut_felt = []
        la fi = 0
        mens fi < lengde(felt["kind"]) {
            legg_til(ut_felt, resultrader[rj]["f" + tekst_fra_heltall(fi)])
            fi = fi + 1
        }
        legg_til(linjer, builtin.join(ut_felt, "|"))
        rj = rj + 1
    }
    returner builtin.join(linjer, "\n")
}

funksjon _har_agg(felt) -> boolsk {
    la i = 0
    mens i < lengde(felt["kind"]) {
        hvis felt["kind"][i] == "agg" { returner sann }
        i = i + 1
    }
    returner usann
}

// query_rader: SELECT ... [WHERE] [GROUP BY] [HAVING] [ORDER BY] [LIMIT/OFFSET].
funksjon query_rader(db, sql: tekst) -> tekst {
    la toks = _tok_c(db, sql)
    // DML med RETURNING → køyr og projiser dei påverka radene.
    hvis _har_returning_dml(toks) { returner _returning_ut(db, toks) }
    returner _strip_null(_query_rader_t(db, toks))
}

funksjon _query_rader_t(db, toks) -> tekst {
    // CTE: materialiser WITH-ledda som temp-tabellar, køyr hovudspørjinga, rydd opp.
    hvis _er_with(toks) {
        la cte = _materialiser_cte(db, toks)
        la res = _query_rader_t(db, cte["main"])
        _rydd_cte(db, cte["temp"])
        returner res
    }
    // Set-operasjonar (UNION/UNION ALL/INTERSECT/EXCEPT) på topp-nivå.
    hvis _finn_setop(toks)["har"] {
        la ordinfo = _setop_order(toks)
        la sp = _finn_setop(ordinfo["kropp"])
        la vl = _splittlinjer(_query_rader_t(db, sp["venstre"]))
        la hl = _splittlinjer(_query_rader_t(db, sp["hoyre"]))
        la komb = _komb_setop(sp["op"], vl, hl)
        hvis ordinfo["order_har"] { komb = _sorter_linjer(komb, ordinfo["asc"]) } ellers hvis sp["op"] != "UNION ALL" { komb = _sorter_linjer(komb, sann) }
        hvis ordinfo["limit"] >= 0 eller ordinfo["offset"] > 0 { komb = _snitt_linjer(komb, ordinfo["offset"], ordinfo["limit"]) }
        returner builtin.join(komb, "\n")
    }
    la p = _parse_select(toks)
    hvis lengde(p["group_by"]) > 0 {
        returner _group_rader(db, p)
    }
    // Skalar-aggregat utan GROUP BY (éin eller fleire) → éi rad med aggregata.
    la felt0 = _sel_felt(p["sel_items"])
    hvis _har_agg(felt0) {
        la agg_rader = _filtrer(db, p)
        la ut_felt = []
        la fi = 0
        mens fi < lengde(felt0["kind"]) {
            hvis felt0["kind"][fi] == "agg" {
                legg_til(ut_felt, _agg_txt(agg_rader, felt0["a"][fi], felt0["b"][fi], felt0["expr"][fi]))
            } ellers hvis felt0["kind"][fi] == "expr" {
                la ev = ""
                hvis lengde(agg_rader) > 0 { ev = _ex_or(felt0["expr"][fi], 0, agg_rader[0], _kt_ny(db, {}))["v"] }
                legg_til(ut_felt, ev)
            } ellers {
                la v = ""
                hvis lengde(agg_rader) > 0 og finnes_nøkkel(agg_rader[0], felt0["a"][fi]) { v = agg_rader[0][felt0["a"][fi]] }
                legg_til(ut_felt, v)
            }
            fi = fi + 1
        }
        returner builtin.join(ut_felt, "|")
    }
    // Vindusfunksjonar: rekn vindus-kolonnar over (filtrerte) rader, sorter så på ytre ORDER BY.
    hvis _har_vindu(felt0) {
        la wrader = _filtrer(db, p)
        la wv = {}
        la wk = 0
        mens wk < lengde(felt0["kind"]) {
            hvis felt0["kind"][wk] == "window" {
                wv["w" + tekst_fra_heltall(wk)] = _vindu_verdiar(wrader, _parse_window(felt0["expr"][wk]))
            }
            wk = wk + 1
        }
        la widx = []
        la wz = 0
        mens wz < lengde(wrader) { legg_til(widx, wz); wz = wz + 1 }
        hvis p["order_col"] != "" { widx = _stabil_sort_idx(wrader, widx, p["order_col"], p["order_asc"]) }
        la wlinjer = []
        la wr = 0
        mens wr < lengde(widx) {
            la ii = widx[wr]
            la wfelt = []
            la wc = 0
            mens wc < lengde(felt0["kind"]) {
                hvis felt0["kind"][wc] == "window" {
                    legg_til(wfelt, wv["w" + tekst_fra_heltall(wc)][ii])
                } ellers hvis felt0["kind"][wc] == "expr" {
                    legg_til(wfelt, _ex_or(felt0["expr"][wc], 0, wrader[ii], _kt_ny(db, {}))["v"])
                } ellers hvis felt0["kind"][wc] == "star" {
                    la kn = nøkler(wrader[ii])
                    la kk = 0
                    mens kk < lengde(kn) { legg_til(wfelt, wrader[ii][kn[kk]]); kk = kk + 1 }
                } ellers {
                    la v = ""
                    hvis finnes_nøkkel(wrader[ii], felt0["a"][wc]) { v = wrader[ii][felt0["a"][wc]] }
                    legg_til(wfelt, v)
                }
                wc = wc + 1
            }
            legg_til(wlinjer, builtin.join(wfelt, "|"))
            wr = wr + 1
        }
        wlinjer = _snitt_linjer(wlinjer, p["offset"], p["limit"])
        returner builtin.join(wlinjer, "\n")
    }
    la rader = _ordna_rader(db, p)
    // Tabell-metadata for star-ekspansjon (kan mangle ved FROM-subquery → bruk rada sine nøklar).
    la har_t = finnes_nøkkel(db["tabellar"], p["tabell"])
    la t = {}
    hvis har_t { t = db["tabellar"][p["tabell"]] }

    la linjer = []
    la i = 0
    mens i < lengde(rader) {
        la feltvals = []
        la k = 0
        mens k < lengde(felt0["kind"]) {
            hvis felt0["kind"][k] == "star" {
                la kolnavn = []
                hvis har_t {
                    la kk = 0
                    mens kk < lengde(t["kolonner"]) { legg_til(kolnavn, t["kolonner"][kk]["navn"]); kk = kk + 1 }
                } ellers {
                    kolnavn = nøkler(rader[i])
                }
                la kk = 0
                mens kk < lengde(kolnavn) {
                    la sv = ""
                    hvis finnes_nøkkel(rader[i], kolnavn[kk]) { sv = rader[i][kolnavn[kk]] }
                    legg_til(feltvals, sv)
                    kk = kk + 1
                }
            } ellers hvis felt0["kind"][k] == "expr" {
                legg_til(feltvals, _ex_or(felt0["expr"][k], 0, rader[i], _kt_ny(db, {}))["v"])
            } ellers {
                la v = ""
                hvis finnes_nøkkel(rader[i], felt0["a"][k]) { v = rader[i][felt0["a"][k]] }
                legg_til(feltvals, v)
            }
            k = k + 1
        }
        legg_til(linjer, builtin.join(feltvals, "|"))
        i = i + 1
    }
    hvis finnes_nøkkel(p, "distinct") og p["distinct"] { linjer = _dedup_linjer(linjer) }
    linjer = _snitt_linjer(linjer, p["offset"], p["limit"])
    returner builtin.join(linjer, "\n")
}

// query_text: første verdi (som JSON-std.db). Skalar-aggregat → talet som tekst.
funksjon query_text(db, sql: tekst) -> tekst {
    // Alt (inkl. skalar-aggregat) via query_rader, som brukar _agg_txt (REAL-bevisst).
    la r = query_rader(db, sql)
    hvis r == "" { returner "" }
    la linje0 = r
    la nl = builtin.index_of(r, "\n")
    hvis nl >= 0 { linje0 = builtin.slice(r, 0, nl) }
    la bar = builtin.index_of(linje0, "|")
    hvis bar >= 0 { returner builtin.slice(linje0, 0, bar) }
    returner linje0
}

// ── EXPLAIN (7l) — rapporter vald tilgangs-plan (scan vs indeks-søk) ──
funksjon explain(db, sql: tekst) -> tekst {
    la toks = _tok(sql)
    hvis _er_with(toks) { returner "COMPOUND (CTE)" }
    hvis _finn_setop(toks)["har"] { returner "COMPOUND (set-op)" }
    la p = _parse_select(toks)
    la linjer = []
    hvis lengde(p["from_sub"]) > 0 {
        legg_til(linjer, "SCAN (subquery)")
    } ellers hvis lengde(p["joins"]) > 0 {
        legg_til(linjer, "SCAN " + p["tabell"])
        la j = 0
        mens j < lengde(p["joins"]) { legg_til(linjer, p["joins"][j]["type"] + " JOIN " + p["joins"][j]["tabell"]); j = j + 1 }
    } ellers hvis _er_view(db, p["tabell"]) {
        legg_til(linjer, "SCAN VIEW " + p["tabell"])
    } ellers hvis p["tabell"] != "" {
        la kand = _indeks_kandidatar(db, p)
        hvis kand["brukt"] { legg_til(linjer, "SEARCH " + p["tabell"] + " USING " + kand["kva"] + " (" + kand["kol"] + ")") } ellers { legg_til(linjer, "SCAN " + p["tabell"]) }
    }
    returner builtin.join(linjer, "\n")
}

// ── Prepared statements (8e) — pre-tokeniser éin gong, køyr fleire med params ──
// Bind ?-plassholdarar med siterte parameter-verdiar.
funksjon _bind_toks(toks, params) -> liste {
    la ut = []
    la pi = 0
    la i = 0
    mens i < lengde(toks) {
        hvis toks[i] == "?" og pi < lengde(params) {
            legg_til(ut, "'" + builtin.join(builtin.split(params[pi], "'"), "''") + "'")
            pi = pi + 1
        } ellers {
            legg_til(ut, toks[i])
        }
        i = i + 1
    }
    returner ut
}

funksjon prepar(db, sql: tekst) -> ordbok {
    returner {"toks": _tok(sql)}
}

funksjon kjor_forberedt_rader(db, stmt, params) -> tekst {
    returner _query_rader_t(db, _bind_toks(stmt["toks"], params))
}

funksjon kjor_forberedt_int(db, stmt, params) -> heltall {
    la bt = _bind_toks(stmt["toks"], params)
    la p = _parse_select(bt)
    la rader = _filtrer(db, p)
    la felt = _sel_felt(p["sel_items"])
    hvis lengde(felt["kind"]) >= 1 og felt["kind"][0] == "agg" { returner _agg_over(rader, felt["a"][0], felt["b"][0]) }
    returner lengde(rader)
}

funksjon kjor_forberedt(db, stmt, params) -> heltall {
    returner _exec_t(db, _bind_toks(stmt["toks"], params))
}
