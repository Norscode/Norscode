# Norscode Desktop Text v0.1: deterministisk tekstbuffer for IDE.
# Byte-/strengindekser følgjer aktiv runtime; full Unicode-grapheme-editor manglar.

funksjon ny_buffer(id: tekst, innhald: tekst) -> ordbok_tekst {
    la b: ordbok_tekst = {}
    b["id"] = id
    b["text"] = innhald
    b["saved"] = innhald
    b["revision"] = "0"
    b["dirty"] = "usann"
    returner b
}

funksjon _ny_revisjon(b: ordbok_tekst, oppdatert: tekst) {
    b["text"] = oppdatert
    b["revision"] = tekst_fra_heltall(heltall_fra_tekst(b["revision"]) + 1)
    hvis oppdatert == b["saved"] { b["dirty"] = "usann" }
    ellers { b["dirty"] = "sann" }
}

funksjon erstatt_område(b: ordbok_tekst, start: heiltall, slutt: heiltall, verdi: tekst) -> bool {
    la original = b["text"]
    hvis start < 0 eller slutt < start eller slutt > lengde(original) { returner usann }
    hvis lengde(original) - (slutt - start) + lengde(verdi) > 8388608 { returner usann }
    la venstre = builtin.slice(original, 0, start)
    la hogre = builtin.slice(original, slutt, lengde(original))
    _ny_revisjon(b, venstre + verdi + hogre)
    returner sann
}

funksjon sett_lagret(b: ordbok_tekst) {
    b["saved"] = b["text"]
    b["dirty"] = "usann"
}

funksjon linje_antall(b: ordbok_tekst) -> heiltall {
    la delar = builtin.split(b["text"], "\n")
    returner lengde(delar)
}

funksjon buffer_status(b: ordbok_tekst) -> ordbok_tekst {
    returner {
        "id": b["id"],
        "revision": b["revision"],
        "dirty": b["dirty"],
        "length": tekst_fra_heltall(lengde(b["text"])),
        "lines": tekst_fra_heltall(linje_antall(b))
    }
}
