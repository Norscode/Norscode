# std/verdiform.no — strukturell nøkkel, likskap og visingsform for vilkårlege verdiar.
#
# tekst(v) gjev den same konstanten "[verdi]" for ALLE lister og ordbøker, så
# tekst(v) kan korkje brukast som likskapsnøkkel eller som visingsform for
# samlingar. Denne modulen er grunnlaget for distinkt/grupper_etter i std.straum
# og til_tekst i std.tremap, std.tresett og std.valfri.
#
# Bruk:
#   bruk std.verdiform som vfm
#   vfm.lik([1, {"a": 2}], [1, {"a": 2}])        # sann (strukturell, som Java equals)
#   vfm.lik({"a": 1, "b": 2}, {"b": 2, "a": 1})  # sann (rekkjefølgja i ordbøker tel ikkje)
#   vfm.lik(1, "1")                              # usann (typen tel)
#   vfm.vis([1, "a", {"k": [2]}])                # "[1, a, {k=[2]}]"
#
# API:
#   nøkkel(v) -> tekst   kanonisk, injektiv koding: nøkkel(a) == nøkkel(b) viss og
#                        berre viss a og b er strukturelt like (Java equals/hashCode):
#                        - typen tel: 1, 1.0, "1" og sann er fire ulike verdiar
#                        - lister: same lengd og like element i same rekkjefølgje
#                        - ordbøker: same nøkkelsett og like verdiar, uavhengig av
#                          innsetjingsrekkjefølgja (som Java Map.equals)
#                        - bytes: same byteverdiar i same rekkjefølgje
#   lik(a, b) -> bool    nøkkel(a) == nøkkel(b)
#   vis(v) -> tekst      lesbar form som Java toString: [1, 2] og {a=1, b=[x]} (ordbøker
#                        i innsetjingsrekkjefølgje), tekst rått, ingenting som
#                        "ingenting", bytes som bytes[1, 2], ein std.valfri som
#                        Valfri[v] / Valfri.tom; andre skalarar som tekst(v).
#                        vis er IKKJE injektiv (1 og "1" gjev begge "1") — bruk
#                        nøkkel til likskap.
#
# Koding (kvar del er sjølvavgrensa og prefiksfri, så samankjeding er eintydig):
#   n              ingenting          b0 / b1              bool
#   i<siffer>;     heiltall           d<tekst(v)>;         desimaltall
#   t<lengd>:<v>   tekst              l<n>[<element>]      liste
#   y<n>[<byte>]   bytes              o<n>{<nøkkel><verdi>} ordbok, sortert på nøkkelkodinga
#   x<lengd>:<type><lengd>:<tekst(v)>  andre typar (t.d. funksjonsverdiar i native AOT)
#
# Avgrensingar: funksjonsverdiar har inga påliteleg likskap (i VM-en er dei
# ordbøker og blir samanlikna på innhald; i native AOT fell dei til tekst(v)).
# Sirkulære eller svært djupe strukturar (over 100 nivå) gjev
# "TilstandsFeil: ..." i staden for uendeleg rekursjon. Grensa ligg godt under
# rekursjonsvakta i VM-en (NORSCODE_NATIVE_MAX_DEPTH, standard 256), så feilen
# kjem frå denne modulen med ei klar melding og kan fangast.
#
# Ingen import: modulen brukar berre builtins som VM-en og native AOT har
# (builtin.type, nøkler, lengde, indeksering, builtin.join).

funksjon _maks_djupn() -> heiltall {
    returner 100
}

funksjon _er_heiltall_type(ty: tekst) -> bool {
    returner ty == "heltall" eller ty == "heiltall"
}

funksjon _er_bool_type(ty: tekst) -> bool {
    returner ty == "boolsk" eller ty == "bool"
}

funksjon _lengd_tekst(s: tekst) -> tekst {
    returner tekst(lengde(s)) + ":" + s
}

# Stabil flettesortering av tekstar (botn-opp, ingen rekursjon).
funksjon _sorter_tekstar(xs) -> liste {
    la n = lengde(xs)
    la a = []
    for x i xs {
        legg_til(a, x)
    }
    la breidd = 1
    mens breidd < n {
        la b = []
        la lo = 0
        mens lo < n {
            la midt = lo + breidd
            hvis midt > n { midt = n }
            la hi = lo + 2 * breidd
            hvis hi > n { hi = n }
            la i = lo
            la j = midt
            mens i < midt og j < hi {
                hvis a[j] < a[i] {
                    legg_til(b, a[j])
                    j = j + 1
                } ellers {
                    legg_til(b, a[i])
                    i = i + 1
                }
            }
            mens i < midt {
                legg_til(b, a[i])
                i = i + 1
            }
            mens j < hi {
                legg_til(b, a[j])
                j = j + 1
            }
            lo = hi
        }
        a = b
        breidd = breidd * 2
    }
    returner a
}

funksjon _nøkkel(v, djupn: heiltall) -> tekst {
    hvis djupn > _maks_djupn() {
        kast "TilstandsFeil: verdiform: strukturen er sirkulær eller djupare enn " + tekst(_maks_djupn()) + " nivå"
    }
    la ty = builtin.type(v)
    hvis ty == "ingenting" { returner "n" }
    hvis _er_bool_type(ty) {
        hvis v { returner "b1" }
        returner "b0"
    }
    hvis _er_heiltall_type(ty) { returner "i" + tekst(v) + ";" }
    hvis ty == "desimaltall" { returner "d" + tekst(v) + ";" }
    hvis ty == "tekst" { returner "t" + _lengd_tekst(v) }
    hvis ty == "liste" {
        la delar = ["l", tekst(lengde(v)), "["]
        for x i v {
            legg_til(delar, _nøkkel(x, djupn + 1))
        }
        legg_til(delar, "]")
        returner builtin.join(delar, "")
    }
    hvis ty == "ordbok" {
        # Kvar oppføring = nøkkel(k) + nøkkel(v). Nøkkelkodingane er prefiksfrie og
        # ulike, så sortering av heile oppføringa gjev same rekkjefølgje som
        # sortering på nøkkelkodinga åleine: resultatet er uavhengig av
        # innsetjingsrekkjefølgja.
        la ks = nøkler(v)
        la oppf = []
        for k i ks {
            legg_til(oppf, _nøkkel(k, djupn + 1) + _nøkkel(v[k], djupn + 1))
        }
        la delar = ["o", tekst(lengde(ks)), "{"]
        for e i _sorter_tekstar(oppf) {
            legg_til(delar, e)
        }
        legg_til(delar, "}")
        returner builtin.join(delar, "")
    }
    hvis ty == "bytes" {
        la n = lengde(v)
        la delar = ["y", tekst(n), "["]
        la i = 0
        mens i < n {
            legg_til(delar, tekst(v[i]) + ";")
            i = i + 1
        }
        legg_til(delar, "]")
        returner builtin.join(delar, "")
    }
    returner "x" + _lengd_tekst(ty) + _lengd_tekst(tekst(v))
}

funksjon nøkkel(v) -> tekst {
    returner _nøkkel(v, 0)
}

funksjon lik(a, b) -> bool {
    returner _nøkkel(a, 0) == _nøkkel(b, 0)
}

funksjon _vis(v, djupn: heiltall) -> tekst {
    hvis djupn > _maks_djupn() {
        kast "TilstandsFeil: verdiform: strukturen er sirkulær eller djupare enn " + tekst(_maks_djupn()) + " nivå"
    }
    la ty = builtin.type(v)
    hvis ty == "ingenting" { returner "ingenting" }
    hvis ty == "tekst" { returner v }
    hvis ty == "liste" {
        la delar = []
        for x i v {
            legg_til(delar, _vis(x, djupn + 1))
        }
        returner "[" + builtin.join(delar, ", ") + "]"
    }
    hvis ty == "ordbok" {
        hvis har_nokkel(v, "__valfri__") og har_nokkel(v, "har") {
            hvis v["har"] { returner "Valfri[" + _vis(v["v"], djupn + 1) + "]" }
            returner "Valfri.tom"
        }
        la delar = []
        for k i nøkler(v) {
            legg_til(delar, _vis(k, djupn + 1) + "=" + _vis(v[k], djupn + 1))
        }
        returner "{" + builtin.join(delar, ", ") + "}"
    }
    hvis ty == "bytes" {
        la delar = []
        la i = 0
        mens i < lengde(v) {
            legg_til(delar, tekst(v[i]))
            i = i + 1
        }
        returner "bytes[" + builtin.join(delar, ", ") + "]"
    }
    returner tekst(v)
}

funksjon vis(v) -> tekst {
    returner _vis(v, 0)
}
