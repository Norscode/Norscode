# std/wasm_pwa_klient.no — service worker frå sida (W8): registrering og oppdateringsflyt for
# Norscode-klientmodular i WebAssembly.
#
#   bruk std.wasm_pwa_klient som pwa
#
#   pwa.registrer(fun(s) -> sw_endra(s))     # s = status(): {"hending", "kontrollert", …}
#   pwa.aktiver_ny()                          # brukaren klikka «Oppdater»: skipWaiting
#
# Hendingane (s["hending"]):
#   registrert  registreringa er ferdig
#   klar        det finst ein aktiv worker (første gong: precachen er ferdig)
#   ventar      ein ny versjon er installert og ventar (sida er kontrollert av den gamle):
#               vis ein knapp; aktiver_ny() når brukaren klikkar
#   aktivert    ein ny worker har teke over sida (controllerchange). Klientkoden som køyrer, er
#               framleis den gamle, så neste navigasjon bør vere ei full sidelasting (t.d.
#               vert.gå_til(vert.hent_sti()) når brukaren sjølv bad om oppdateringa)
#   feil <namn> registreringa feila (t.d. SecurityError)
#   ustøtta     nettlesaren har ikkje service worker (eller sida er ikkje sikker: http utanom
#               localhost)
# Ny versjon blir aldri teken i bruk midt i ei økt utan at brukaren har bede om det, unnateke
# når det berre finst éi fane (konfigurasjonen «aktiver_éi_fane» i std/wasm_pwa.no).
bruk std.wasm_vert som vert

la _lyttar = null

funksjon sw_sti() -> tekst {
    returner "/sw.js"
}

# «<hending> <k><i><v><a>» frå vert.sw_status() → {"hending", "kontrollert", "installerer",
# "ventar", "aktiv"}. Rein (same resultat i VM-en og i WASM).
funksjon tolk_status(t: tekst) -> ordbok {
    la s = builtin.trim(t)
    la p = -1
    la i = lengde(s) - 1
    mens i >= 0 {
        hvis builtin.slice(s, i, i + 1) == " " {
            p = i
            bryt
        }
        i = i - 1
    }
    la hending = s
    la flagg = "0000"
    hvis p >= 0 {
        hending = builtin.slice(s, 0, p)
        flagg = builtin.slice(s, p + 1, lengde(s))
    }
    hvis lengde(flagg) != 4 { flagg = "0000" }
    returner {"hending": hending, "kontrollert": builtin.slice(flagg, 0, 1) == "1", "installerer": builtin.slice(flagg, 1, 2) == "1",
              "ventar": builtin.slice(flagg, 2, 3) == "1", "aktiv": builtin.slice(flagg, 3, 4) == "1"}
}

funksjon status() -> ordbok {
    returner tolk_status(vert.sw_status())
}

# Registrer service workeren. `ved_endring` (closure med éin parameter, eller null) får
# status() ved kvar hending.
funksjon registrer(ved_endring) -> heltall {
    _lyttar = ved_endring
    vert.sw_registrer(sw_sti(), "_sw_endra")
    returner 0
}

# Ta i bruk den ventande versjonen (brukaren har klikka). Ingenting skjer når ingen ventar.
funksjon aktiver_ny() -> heltall {
    vert.sw_send(vert.sw_skip_melding())
    returner 0
}

funksjon _sw_endra() -> heltall {
    hvis _lyttar != null { builtin.ncb_call_fn(_lyttar, status()) }
    returner 0
}
