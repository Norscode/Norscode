# tls13_keyschedule.no - TLS 1.3 nøkkelplan (RFC 8446 §7) over HKDF-SHA256.
bruk std.hkdf som hkdf
bruk std.sha256 som sha

funksjon _str_bytes(s: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(s) { legg_til(ut, builtin.char_code(builtin.slice(s, i, i+1)) & 255) i = i + 1 }
    returner ut
}
funksjon _nullbytes(n: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = 0
    mens i < n { legg_til(ut, 0) i = i + 1 }
    returner ut
}

# HKDF-Expand-Label (RFC 8446 §7.1).
funksjon expand_label(secret: liste_heiltall, label: tekst, context: liste_heiltall, lengde_ut: heiltall) -> liste_heiltall {
    la full_label = _str_bytes("tls13 " + label)
    la info: liste_heiltall = [(lengde_ut >> 8) & 255, lengde_ut & 255, lengde(full_label)]
    la i = 0
    mens i < lengde(full_label) { legg_til(info, full_label[i]) i = i + 1 }
    legg_til(info, lengde(context))
    i = 0
    mens i < lengde(context) { legg_til(info, context[i]) i = i + 1 }
    returner hkdf.expand(secret, info, lengde_ut)
}

# Derive-Secret(secret, label, transcript-hash) (RFC 8446 §7.1). thash er ferdig SHA-256-digest.
funksjon derive_secret(secret: liste_heiltall, label: tekst, thash: liste_heiltall) -> liste_heiltall {
    returner expand_label(secret, label, thash, 32)
}

# Early Secret = HKDF-Extract(0, PSK). Tom PSK -> 32 nullbytes.
funksjon early_secret(psk: liste_heiltall) -> liste_heiltall {
    la ikm = psk
    hvis lengde(ikm) == 0 { ikm = _nullbytes(32) }
    returner hkdf.extract([], ikm)
}

# Handshake Secret = HKDF-Extract(Derive-Secret(early,"derived",H("")), (EC)DHE).
funksjon handshake_secret(derived: liste_heiltall, ecdhe: liste_heiltall) -> liste_heiltall {
    returner hkdf.extract(derived, ecdhe)
}

# Master Secret = HKDF-Extract(Derive-Secret(handshake,"derived",H("")), 0).
funksjon master_secret(derived2: liste_heiltall) -> liste_heiltall {
    returner hkdf.extract(derived2, _nullbytes(32))
}

# SHA-256 av byte-liste som digest-bytes (transcript-hash-hjelpar).
funksjon transcript_hash(data: liste_heiltall) -> liste_heiltall {
    la hexs = sha.hash_bytes(data)
    la ut: liste_heiltall = []
    la i = 0
    mens i < 32 {
        legg_til(ut, builtin.index_of("0123456789abcdef", builtin.slice(hexs, i*2, i*2+1))*16 + builtin.index_of("0123456789abcdef", builtin.slice(hexs, i*2+1, i*2+2)))
        i = i + 1
    }
    returner ut
}

funksjon status() { returner { "abi": "norscode-tls13-keyschedule-v1", "hash": "sha256" } }
