// RFC 4648 Base32 utan ekstern runtime.

funksjon alfabet() -> tekst { returner "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567" }

funksjon normaliser(input: tekst) -> tekst {
    la stor = builtin.upper(input)
    la ut = ""
    la padding = usann
    la i: heiltall = 0
    mens i < lengde(stor) {
        la c = stor[i]
        hvis c == "=" {
            padding = sann
        } ellers hvis c != " " og c != "-" og c != "\n" og c != "\r" og c != "\t" {
            hvis padding { kast "Base32Feil: data etter padding" }
            hvis builtin.index_of(alfabet(), c) < 0 { kast "Base32Feil: ugyldig teikn" }
            ut = ut + c
        }
        i = i + 1
    }
    returner ut
}

funksjon dekod_bytes(input: tekst) -> liste_heiltall {
    la data = normaliser(input)
    la ut: liste_heiltall = []
    la buffer: heiltall = 0
    la bitar: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(data) {
        la verdi = builtin.index_of(alfabet(), data[i])
        buffer = (buffer << 5) | verdi
        bitar = bitar + 5
        hvis bitar >= 8 {
            bitar = bitar - 8
            legg_til(ut, (buffer >> bitar) & 255)
            hvis bitar == 0 { buffer = 0 }
            ellers { buffer = buffer & ((1 << bitar) - 1) }
        }
        i = i + 1
    }
    hvis bitar > 0 og buffer != 0 { kast "Base32Feil: ikkje-null sluttbitar" }
    returner ut
}

funksjon kod_bytes(data: liste_heiltall, med_padding: boolsk) -> tekst {
    la ut = ""
    la buffer: heiltall = 0
    la bitar: heiltall = 0
    la i: heiltall = 0
    mens i < lengde(data) {
        la b = data[i]
        hvis b < 0 eller b > 255 { kast "Base32Feil: byte utanfor 0..255" }
        buffer = (buffer << 8) | b
        bitar = bitar + 8
        mens bitar >= 5 {
            bitar = bitar - 5
            la verdi = (buffer >> bitar) & 31
            ut = ut + alfabet()[verdi]
            hvis bitar == 0 { buffer = 0 }
            ellers { buffer = buffer & ((1 << bitar) - 1) }
        }
        i = i + 1
    }
    hvis bitar > 0 { ut = ut + alfabet()[(buffer << (5 - bitar)) & 31] }
    hvis med_padding {
        mens lengde(ut) % 8 != 0 { ut = ut + "=" }
    }
    returner ut
}

funksjon tekst_til_bytes(data: tekst) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(data) {
        la kode = builtin.char_code(data[i])
        hvis kode > 255 { kast "Base32Feil: berre byte-tekst kan kodast" }
        legg_til(ut, kode)
        i = i + 1
    }
    returner ut
}

funksjon bytes_til_tekst(data: liste_heiltall) -> tekst {
    la ut = ""
    la i: heiltall = 0
    mens i < lengde(data) {
        ut = ut + builtin.chr(data[i])
        i = i + 1
    }
    returner ut
}

funksjon kod(data: tekst) -> tekst { returner kod_bytes(tekst_til_bytes(data), sann) }
funksjon dekod(data: tekst) -> tekst { returner bytes_til_tekst(dekod_bytes(data)) }
