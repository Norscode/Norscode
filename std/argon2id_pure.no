# Rein Norscode Argon2id v1.3 etter RFC 9106.
# 64-bit-ord er [lo32,hi32] i flate blokklister. Ingen native krypto-backend.

bruk std.blake2b som blake

funksjon _u32(x: heiltall) -> heiltall { returner x & 4294967295 }

funksjon _le32(v: heiltall) -> liste_heiltall {
    returner [v & 255, (v >> 8) & 255, (v >> 16) & 255, (v >> 24) & 255]
}

funksjon _legg_bytes(ut: liste_heiltall, del: liste_heiltall) -> heiltall {
    la i: heiltall = 0
    mens i < lengde(del) { legg_til(ut, del[i] & 255) i = i + 1 }
    returner 0
}

funksjon _slice_bytes(src: liste_heiltall, start: heiltall, slutt: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la i = start
    mens i < slutt og i < lengde(src) { legg_til(ut, src[i]) i = i + 1 }
    returner ut
}

funksjon _h_prime(data: liste_heiltall, out_len: heiltall) -> liste_heiltall {
    la input = _le32(out_len)
    _legg_bytes(input, data)
    hvis out_len <= 64 { returner blake.hash_bytes(input, out_len) }
    la r = (out_len + 31) / 32 - 2
    la v = blake.hash_bytes(input, 64)
    la out: liste_heiltall = []
    la i: heiltall = 0
    mens i < r {
        _legg_bytes(out, _slice_bytes(v, 0, 32))
        hvis i + 1 < r { v = blake.hash_bytes(v, 64) }
        i = i + 1
    }
    la siste_len = out_len - 32 * r
    _legg_bytes(out, blake.hash_bytes(v, siste_len))
    returner out
}

funksjon _zero_block() -> liste_heiltall {
    la b: liste_heiltall = []
    la i: heiltall = 0
    mens i < 256 { legg_til(b, 0) i = i + 1 }
    returner b
}

funksjon _copy_block(src: liste_heiltall) -> liste_heiltall {
    la b: liste_heiltall = []
    la i: heiltall = 0
    mens i < 256 { legg_til(b, src[i]) i = i + 1 }
    returner b
}

funksjon _copy_bytes(src: liste_heiltall) -> liste_heiltall {
    la b: liste_heiltall = []
    la i: heiltall = 0
    mens i < lengde(src) { legg_til(b, src[i]) i = i + 1 }
    returner b
}

funksjon _bytes_to_block(bytes: liste_heiltall) -> liste_heiltall {
    hvis lengde(bytes) != 1024 { kast "Argon2id: intern blokk må vere 1024 byte" }
    la b: liste_heiltall = []
    la i: heiltall = 0
    mens i < 128 {
        la p = i * 8
        la lo = bytes[p] | (bytes[p+1] << 8) | (bytes[p+2] << 16) | (bytes[p+3] << 24)
        la hi = bytes[p+4] | (bytes[p+5] << 8) | (bytes[p+6] << 16) | (bytes[p+7] << 24)
        legg_til(b, _u32(lo))
        legg_til(b, _u32(hi))
        i = i + 1
    }
    returner b
}

funksjon _block_to_bytes(b: liste_heiltall) -> liste_heiltall {
    la out: liste_heiltall = []
    la i: heiltall = 0
    mens i < 128 {
        la lo = b[i*2]
        la hi = b[i*2+1]
        legg_til(out, lo & 255)
        legg_til(out, (lo >> 8) & 255)
        legg_til(out, (lo >> 16) & 255)
        legg_til(out, (lo >> 24) & 255)
        legg_til(out, hi & 255)
        legg_til(out, (hi >> 8) & 255)
        legg_til(out, (hi >> 16) & 255)
        legg_til(out, (hi >> 24) & 255)
        i = i + 1
    }
    returner out
}

funksjon _add_at(v: liste_heiltall, a: heiltall, blo: heiltall, bhi: heiltall) -> heiltall {
    la p = a * 2
    la sum = v[p] + blo
    la carry: heiltall = 0
    hvis sum >= 4294967296 { carry = 1 }
    v[p] = _u32(sum)
    v[p+1] = _u32(v[p+1] + bhi + carry)
    returner 0
}

funksjon _mul2_lo32(a: heiltall, b: heiltall) -> liste_heiltall {
    la a0 = a & 65535
    la a1 = a >> 16
    la b0 = b & 65535
    la b1 = b >> 16
    la p0 = a0 * b0
    la middle = (p0 >> 16) + a1 * b0 + a0 * b1
    la lo = _u32((p0 & 65535) | ((middle & 65535) << 16))
    la hi = _u32(a1 * b1 + (middle >> 16))
    returner [_u32(lo << 1), _u32((hi << 1) | (lo >> 31))]
}

funksjon _blamka(v: liste_heiltall, a: heiltall, b: heiltall) -> heiltall {
    la ap = a * 2
    la bp = b * 2
    la m = _mul2_lo32(v[ap], v[bp])
    _add_at(v, a, v[bp], v[bp+1])
    _add_at(v, a, m[0], m[1])
    returner 0
}

funksjon _xor_word(v: liste_heiltall, a: heiltall, b: heiltall) -> heiltall {
    la ap = a * 2
    la bp = b * 2
    v[ap] = _u32(v[ap] ^ v[bp])
    v[ap+1] = _u32(v[ap+1] ^ v[bp+1])
    returner 0
}

funksjon _rotr(v: liste_heiltall, ord: heiltall, n: heiltall) -> heiltall {
    la p = ord * 2
    la lo = v[p]
    la hi = v[p+1]
    hvis n == 32 { v[p] = hi v[p+1] = lo returner 0 }
    hvis n < 32 {
        v[p] = _u32((lo >> n) | _u32(hi << (32-n)))
        v[p+1] = _u32((hi >> n) | _u32(lo << (32-n)))
        returner 0
    }
    la k = n - 32
    v[p] = _u32((hi >> k) | _u32(lo << (32-k)))
    v[p+1] = _u32((lo >> k) | _u32(hi << (32-k)))
    returner 0
}

funksjon _gb(v: liste_heiltall, a: heiltall, b: heiltall,
             c: heiltall, d: heiltall) -> heiltall {
    _blamka(v,a,b) _xor_word(v,d,a) _rotr(v,d,32)
    _blamka(v,c,d) _xor_word(v,b,c) _rotr(v,b,24)
    _blamka(v,a,b) _xor_word(v,d,a) _rotr(v,d,16)
    _blamka(v,c,d) _xor_word(v,b,c) _rotr(v,b,63)
    returner 0
}

funksjon _round16(v: liste_heiltall, x: liste_heiltall) -> heiltall {
    _gb(v,x[0],x[4],x[8],x[12])
    _gb(v,x[1],x[5],x[9],x[13])
    _gb(v,x[2],x[6],x[10],x[14])
    _gb(v,x[3],x[7],x[11],x[15])
    _gb(v,x[0],x[5],x[10],x[15])
    _gb(v,x[1],x[6],x[11],x[12])
    _gb(v,x[2],x[7],x[8],x[13])
    _gb(v,x[3],x[4],x[9],x[14])
    returner 0
}

funksjon _compress(x: liste_heiltall, y: liste_heiltall,
                    gammel, xor_gammel: boolsk) -> liste_heiltall {
    la r: liste_heiltall = []
    la z: liste_heiltall = []
    la i: heiltall = 0
    mens i < 256 {
        la q = _u32(x[i] ^ y[i])
        legg_til(r, q) legg_til(z, q)
        i = i + 1
    }
    la row: heiltall = 0
    mens row < 8 {
        la idx: liste_heiltall = []
        i = 0
        mens i < 16 { legg_til(idx, row*16+i) i = i + 1 }
        _round16(z, idx)
        row = row + 1
    }
    la col: heiltall = 0
    mens col < 8 {
        la idx: liste_heiltall = []
        row = 0
        mens row < 8 {
            legg_til(idx, row*16 + col*2)
            legg_til(idx, row*16 + col*2 + 1)
            row = row + 1
        }
        _round16(z, idx)
        col = col + 1
    }
    i = 0
    mens i < 256 {
        z[i] = _u32(z[i] ^ r[i])
        hvis xor_gammel { z[i] = _u32(z[i] ^ gammel[i]) }
        i = i + 1
    }
    returner z
}

funksjon _set_u64(block: liste_heiltall, word: heiltall, lo: heiltall, hi: heiltall) -> heiltall {
    block[word*2] = _u32(lo)
    block[word*2+1] = _u32(hi)
    returner 0
}

funksjon _address_block(pass_no: heiltall, lane: heiltall, slice_no: heiltall,
                        memory_blocks: heiltall, passes: heiltall,
                        counter: heiltall) -> liste_heiltall {
    la zero = _zero_block()
    la input = _zero_block()
    _set_u64(input,0,pass_no,0)
    _set_u64(input,1,lane,0)
    _set_u64(input,2,slice_no,0)
    _set_u64(input,3,memory_blocks,0)
    _set_u64(input,4,passes,0)
    _set_u64(input,5,2,0)
    _set_u64(input,6,counter,0)
    la tmp = _compress(zero,input,null,usann)
    returner _compress(zero,tmp,null,usann)
}

funksjon _mul_hi32(a: heiltall, b: heiltall) -> heiltall {
    la a0 = a & 65535
    la a1 = a >> 16
    la b0 = b & 65535
    la b1 = b >> 16
    la middle = ((a0*b0) >> 16) + a1*b0 + a0*b1
    returner _u32(a1*b1 + (middle >> 16))
}

funksjon _reference_index(pass_no: heiltall, slice_no: heiltall, index: heiltall,
                          same_lane: boolsk, j1: heiltall,
                          lane_length: heiltall, segment_length: heiltall) -> heiltall {
    la area: heiltall = 0
    hvis pass_no == 0 {
        hvis slice_no == 0 { area = index - 1 }
        ellers hvis same_lane { area = slice_no*segment_length + index - 1 }
        ellers { area = slice_no*segment_length hvis index == 0 { area = area - 1 } }
    } ellers {
        hvis same_lane { area = lane_length - segment_length + index - 1 }
        ellers { area = lane_length - segment_length hvis index == 0 { area = area - 1 } }
    }
    la x = _mul_hi32(j1,j1)
    la y = _mul_hi32(area,x)
    la relative = area - 1 - y
    la start: heiltall = 0
    hvis pass_no != 0 og slice_no != 3 { start = (slice_no + 1) * segment_length }
    returner (start + relative) % lane_length
}

funksjon _h0(password: liste_heiltall, salt: liste_heiltall,
             secret: liste_heiltall, ad: liste_heiltall,
             memory_kib: heiltall, passes: heiltall,
             lanes: heiltall, out_len: heiltall) -> liste_heiltall {
    la input: liste_heiltall = []
    _legg_bytes(input,_le32(lanes))
    _legg_bytes(input,_le32(out_len))
    _legg_bytes(input,_le32(memory_kib))
    _legg_bytes(input,_le32(passes))
    _legg_bytes(input,_le32(19))
    _legg_bytes(input,_le32(2))
    _legg_bytes(input,_le32(lengde(password))) _legg_bytes(input,password)
    _legg_bytes(input,_le32(lengde(salt))) _legg_bytes(input,salt)
    _legg_bytes(input,_le32(lengde(secret))) _legg_bytes(input,secret)
    _legg_bytes(input,_le32(lengde(ad))) _legg_bytes(input,ad)
    returner blake.hash_bytes(input,64)
}

funksjon hash_bytes_utvida(password: liste_heiltall, salt: liste_heiltall,
                           secret: liste_heiltall, ad: liste_heiltall,
                           memory_kib: heiltall, passes: heiltall,
                           lanes: heiltall, out_len: heiltall) -> liste_heiltall {
    hvis lengde(salt) < 8 eller memory_kib < 8*lanes eller passes < 1 eller
       lanes < 1 eller out_len < 4 { kast "Argon2id: ugyldige parameter" }
    la memory_blocks = 4 * lanes * (memory_kib / (4*lanes))
    la lane_length = memory_blocks / lanes
    la segment_length = lane_length / 4
    la h0 = _h0(password,salt,secret,ad,memory_kib,passes,lanes,out_len)
    la memory = []
    la mi: heiltall = 0
    mens mi < memory_blocks { legg_til(memory,null) mi = mi + 1 }
    la lane: heiltall = 0
    mens lane < lanes {
        la init0 = _copy_bytes(h0)
        _legg_bytes(init0,_le32(0)) _legg_bytes(init0,_le32(lane))
        la init1 = _copy_bytes(h0)
        _legg_bytes(init1,_le32(1)) _legg_bytes(init1,_le32(lane))
        memory[lane*lane_length] = _bytes_to_block(_h_prime(init0,1024))
        memory[lane*lane_length+1] = _bytes_to_block(_h_prime(init1,1024))
        lane = lane + 1
    }
    la pass_no: heiltall = 0
    mens pass_no < passes {
        la slice_no: heiltall = 0
        mens slice_no < 4 {
            lane = 0
            mens lane < lanes {
                la start_index: heiltall = 0
                hvis pass_no == 0 og slice_no == 0 { start_index = 2 }
                la data_independent = pass_no == 0 og slice_no < 2
                la counter: heiltall = 1
                la addresses = hvis data_independent da _address_block(pass_no,lane,slice_no,memory_blocks,passes,counter) ellers null
                la index = start_index
                mens index < segment_length {
                    hvis data_independent og index > start_index og index % 128 == 0 {
                        counter = counter + 1
                        addresses = _address_block(pass_no,lane,slice_no,memory_blocks,passes,counter)
                    }
                    la current = slice_no*segment_length + index
                    la prev = current - 1
                    hvis current == 0 { prev = lane_length - 1 }
                    la prev_block = memory[lane*lane_length + prev]
                    la j1: heiltall = 0
                    la j2: heiltall = 0
                    hvis data_independent {
                        la ai = (index % 128) * 2
                        j1 = addresses[ai] j2 = addresses[ai+1]
                    } ellers { j1 = prev_block[0] j2 = prev_block[1] }
                    la ref_lane = j2 % lanes
                    hvis pass_no == 0 og slice_no == 0 { ref_lane = lane }
                    la ref_index = _reference_index(pass_no,slice_no,index,ref_lane==lane,j1,lane_length,segment_length)
                    la old = memory[lane*lane_length + current]
                    memory[lane*lane_length + current] = _compress(
                        prev_block, memory[ref_lane*lane_length + ref_index], old, pass_no > 0)
                    index = index + 1
                }
                lane = lane + 1
            }
            slice_no = slice_no + 1
        }
        pass_no = pass_no + 1
    }
    la final = _copy_block(memory[lane_length-1])
    lane = 1
    mens lane < lanes {
        la other = memory[lane*lane_length + lane_length - 1]
        mi = 0
        mens mi < 256 { final[mi] = _u32(final[mi] ^ other[mi]) mi = mi + 1 }
        lane = lane + 1
    }
    returner _h_prime(_block_to_bytes(final),out_len)
}

funksjon hash_pure(passord: tekst, salt: tekst, memory_kib: heiltall,
                   passes: heiltall, lanes: heiltall, out_len: heiltall) -> tekst {
    returner blake.hex_bytes(hash_bytes_utvida(blake.tekst_bytes(passord),blake.tekst_bytes(salt),
        [],[],memory_kib,passes,lanes,out_len))
}

funksjon test_h0(password: liste_heiltall, salt: liste_heiltall,
                 secret: liste_heiltall, ad: liste_heiltall,
                 memory_kib: heiltall, passes: heiltall,
                 lanes: heiltall, out_len: heiltall) -> tekst {
    returner blake.hex_bytes(_h0(password,salt,secret,ad,memory_kib,passes,lanes,out_len))
}

funksjon konstanttid_lik(a: tekst, b: tekst) -> boolsk {
    la maks = lengde(a)
    hvis lengde(b) > maks { maks = lengde(b) }
    la diff = lengde(a) ^ lengde(b)
    la i: heiltall = 0
    mens i < maks {
        la ca: heiltall = 0
        la cb: heiltall = 0
        hvis i < lengde(a) { ca = builtin.char_code(builtin.slice(a,i,i+1)) }
        hvis i < lengde(b) { cb = builtin.char_code(builtin.slice(b,i,i+1)) }
        diff = diff | (ca ^ cb)
        i = i + 1
    }
    returner diff == 0
}

funksjon status() -> ordbok_tekst {
    returner {"abi":"norscode-argon2id-pure-v1","status":"pure","standard":"RFC 9106","version":"19"}
}
