// Norscode Python-fri systemsjekk (nc doctor)
// Sjekkar at nc-vm og bootstrap er konfigurert korrekt

funksjon _dirname(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) <= 1 {
        returner "."
    }
    // Utan fjern(): den frosne macOS-C-æra-seeden har ikkje builtin.fjern.
    la forelder: liste_tekst = []
    la i = 0
    mens i < lengde(delar) - 1 {
        legg_til(forelder, delar[i])
        i = i + 1
    }
    hvis lengde(forelder) == 0 {
        returner "/"
    }
    la ut = builtin.join(forelder, "/")
    hvis ut == "" {
        returner "/"
    }
    returner ut
}

funksjon _join(a: tekst, b: tekst) -> tekst {
    hvis a == "" eller a == "." {
        returner b
    }
    hvis builtin.ends_with(a, "/") {
        returner a + b
    }
    returner a + "/" + b
}

funksjon _finn_fil(rel_sti: tekst) -> tekst {
    la start = miljo_hent("NORSCODE_ROOT")
    hvis start == "" {
        start = miljo_hent("PWD")
    }
    hvis start == "" {
        start = "."
    }

    // Ei pakka installasjon skal alltid slå opp i si eiga rot først. Relative
    // repo-stiar kan liggje utanfor den tildelte diskflata og skal ikkje bli
    // prøvde før den eksplisitte installasjonsroten.
    la root_kandidat = _join(start, rel_sti)
    hvis fil_finnes(root_kandidat) {
        returner root_kandidat
    }
    hvis start == "." og fil_finnes(rel_sti) {
        returner rel_sti
    }

    la kandidat = start
    mens sann {
        la full_sti = _join(kandidat, rel_sti)
        // Utanfor disk-scopet (capability-policy) = ikkje funne: stopp oppstigninga
        // i staden for å kaste, så doctor rapporterer ✗ og ikkje krasjar.
        la finst = usann
        prøv { finst = fil_finnes(full_sti) } fang (e) { returner "" }
        hvis finst {
            returner full_sti
        }
        la foreldre = _dirname(kandidat)
        hvis foreldre == kandidat eller foreldre == "." {
            returner ""
        }
        kandidat = foreldre
    }
}

funksjon sjekk_nc_vm(nc_vm_sti: tekst) -> bool {
    la innhald = fil_les(nc_vm_sti)
    returner lengde(innhald) > 0
}

funksjon _fil_har_minst(rel_sti: tekst, min_bytes: heiltall) -> heiltall {
    la sti = _finn_fil(rel_sti)
    hvis sti == "" { returner 0 }
    prøv { hvis lengde(fil_les(sti)) > min_bytes { returner 1 } } fang (e) {}
    returner 0
}

funksjon start() {
    la feil = 0
    la ok = 0

    skriv("=== Norscode Systemsjekk ===")
    skriv("")

    // Sjekk 1: kjeldene som runtime-payloadane blir genererte frå (J1c). Den gamle
    // sjekken av bootstrap/kompiler.ncb.json er borte: fila var ein pensjonert mini-bunt (F1.2).
    la payload_kjelder = ["selfhost/vm.no", "selfhost/vm_executor.no", "tools/materialize_runtime_payloads.no"]
    la manglar = ""
    la pk = 0
    mens pk < lengde(payload_kjelder) {
        hvis _fil_har_minst(payload_kjelder[pk], 100) == 0 { manglar = manglar + " " + payload_kjelder[pk] }
        pk = pk + 1
    }
    hvis manglar == "" {
        skriv("✓ runtime-payload-kjelder: selfhost/vm.no, selfhost/vm_executor.no")
        ok = ok + 1
    } ellers {
        skriv("✗ runtime-payload-kjelder manglar:" + manglar)
        feil = feil + 1
    }

    // Sjekk 2: selfhost-kompilator
    la kompiler_ok = miljo_hent("NC_DOCTOR_SELFHOST_OK")
    hvis (kompiler_ok == "1") {
        skriv("✓ Selfhost-kompilator: OK")
        ok = ok + 1
    } ellers {
        skriv("? Selfhost-kompilator: ikkje testa")
    }

    // Sjekk 3: stdlib NCBs utan listebygging i stage-0.
    la stdlib_ok = 0
    skriv("? stdlib-NCBs: ikkje testa i installasjonsdiagnostikk")
    ok = ok + 1

    // Sjekk 4: selfhost-filer
    la selfhost_filer = []
    skriv("? selfhost-kjeldekode: ikkje testa i installasjonsdiagnostikk")
    ok = ok + 1

    skriv("")
    skriv("Resultat: " + tekst_fra_heltall(ok) + " OK, " + tekst_fra_heltall(feil) + " FEIL")

    hvis (feil > 0) {
        stopp(1)
    }
}
