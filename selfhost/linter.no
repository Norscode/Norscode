// Norscode Python-fri linter v3 — `nc lint <fil.no> [--check]`
//
// nc_main rutar `nc lint` hit via nc_køyr_verktøy (kompilert frå kjelde ved
// kvar køyring, så endringar verkar utan reseed). Miljø:
//   NC_LINT_FILE   absolutt sti til fila (set av nc_main)
//   NC_LINT_CHECK  "1" ved --check
//
// Reglane ligg i selfhost/linter_kjerne.no (delt med `nc lsp`): syntaksfeil,
// statisk typesjekk (selfhost/compiler/typecheck.no), ubrukte variablar,
// re-deklarasjon (same blokk, eller ein indre `la` som skriv over ein ytre
// variabel: `la` er funksjonsskopa), uoppnåeleg kode og import-reglar.
//
// Utdata: éi linje per funn, sortert etter posisjon:
//   - <severity> <regel>: <melding> (linje N[, kolonne K])
//
// Exit-kode: 1 berre når det finst funn på error-nivå (syntax-error,
// type-error), elles 0 — òg med --check, slik at åtvaringar ikkje knekk CI.
// --check endrar difor ikkje exit-regelen; flagget er behalde for kompatibilitet.
//
// Merk: fila må liggje innanfor VM-disk-scopet (NORSCODE_VM_DISK_ROOT, standard
// NORSCODE_ROOT, «.», /tmp og /private/tmp). Scopet blir sett av nc_main
// (nc_run_policy) FØR dette verktøyet startar, og VM-en les det berre ved
// oppstart, så linteren kan ikkje (og skal ikkje) utvide det sjølv. Ei fil
// utanfor gjev exit 2 med eit hint om NORSCODE_VM_DISK_ROOT. Ein varig fiks
// (leggje mappa til lint-fila inn i scopet, berre disk.read) høyrer heime i
// nc_main sin nc_format_lint_cli og krev reseed.

bruk selfhost.linter_kjerne som lk

funksjon lint_kjelde(kilde: tekst) {
    returner lk.lint_kjelde(kilde)
}

funksjon posisjon_tekst(f) -> tekst {
    la ut = "linje " + tekst(f["linje"])
    hvis f["kolonne"] > 0 { ut = ut + ", kolonne " + tekst(f["kolonne"]) }
    returner ut
}

funksjon start() -> heiltall {
    la sti = miljo_hent("NC_LINT_FILE")
    hvis lengde(sti) == 0 {
        skriv("Bruk: nc lint <fil.no> [--check]\n")
        returner 2
    }

    la kilde = ""
    prøv {
        kilde = fil_les(sti)
    } fang (e) {
        la grunn = tekst(e)
        skriv("Feil: kan ikkje lese " + sti + ": " + grunn + "\n")
        hvis builtin.contains(grunn, "outside disk scope") {
            skriv("Tips: fila ligg utanfor VM-disk-scopet. Legg ho under NORSCODE_ROOT " +
                  "eller /tmp, eller utvid scopet, t.d. " +
                  "NORSCODE_VM_DISK_ROOT=\"<prosjektrot>,.,/tmp,/private/tmp,<mappa til fila>\" nc lint <fil>\n")
        }
        returner 2
    }

    la funn = lint_kjelde(kilde)
    la n = lengde(funn)
    la feil = lk.tal_med_severity(funn, "error")
    la aatvaringar = lk.tal_med_severity(funn, "warning")

    hvis n == 0 {
        skriv("OK: " + sti + " (0 funn)\n")
        returner 0
    }
    la status = "OK"
    hvis aatvaringar > 0 { status = "ÅTVARING" }
    hvis feil > 0 { status = "FEIL" }
    skriv(status + ": " + sti + " (" + tekst(n) + " funn: " + tekst(feil) + " feil, " +
          tekst(aatvaringar) + " åtvaringar)\n")
    la i = 0
    mens i < n {
        la f = funn[i]
        skriv("  - " + f["severity"] + " " + f["code"] + ": " + f["melding"] + " (" + posisjon_tekst(f) + ")\n")
        i = i + 1
    }
    hvis feil > 0 { returner 1 }
    returner 0
}
