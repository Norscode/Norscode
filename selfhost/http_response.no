// Smal, Norscode-eigd HTTP-responsserialisering utan CLI-/kompilatoravhengigheit.

funksjon har(res, namn: tekst) -> boolsk {
    prøv { returner finnes_nøkkel(res, namn) } fang (e) { returner usann }
    returner usann
}

funksjon hent(res, namn: tekst, internt: tekst) {
    hvis har(res, namn) { returner res[namn] }
    hvis har(res, internt) { returner res[internt] }
    returner null
}

funksjon legg_header(resp: tekst, res, namn: tekst, internt: tekst,
                     http_namn: tekst) -> tekst {
    la verdi = hent(res, namn, internt)
    hvis verdi != null og tekst(verdi) != "" {
        returner resp + http_namn + ": " + tekst(verdi) + "\r\n"
    }
    returner resp
}

funksjon status_tekst(kode: tekst) -> tekst {
    hvis kode == "201" { returner "Created" }
    hvis kode == "204" { returner "No Content" }
    hvis kode == "304" { returner "Not Modified" }
    hvis kode == "400" { returner "Bad Request" }
    hvis kode == "403" { returner "Forbidden" }
    hvis kode == "404" { returner "Not Found" }
    hvis kode == "405" { returner "Method Not Allowed" }
    hvis kode == "500" { returner "Internal Server Error" }
    returner "OK"
}

funksjon response_to_http(res) -> tekst {
    la status = hent(res, "status", "__status__")
    hvis status == null eller tekst(status) == "" { status = 200 }
    la body_verdi = hent(res, "body", "__body__")
    la body = hvis body_verdi == null da "" ellers tekst(body_verdi)
    la head_only = har(res, "__head__")
    la status_kode = tekst(status)
    la status_namn = status_tekst(status_kode)
    la overstyring = hent(res, "status_text", "__status_text__")
    hvis overstyring != null og tekst(overstyring) != "" { status_namn = tekst(overstyring) }

    la resp = "HTTP/1.1 " + status_kode + " " + status_namn + "\r\n"
    resp = legg_header(resp, res, "content_type", "__content_type__", "Content-Type")
    resp = legg_header(resp, res, "allow", "__allow__", "Allow")
    resp = legg_header(resp, res, "cache_control", "__cache_control__", "Cache-Control")
    resp = legg_header(resp, res, "location", "__location__", "Location")
    resp = legg_header(resp, res, "set_cookie", "__set_cookie__", "Set-Cookie")
    resp = legg_header(resp, res, "x_content_type_options", "__x_content_type_options__", "X-Content-Type-Options")
    resp = legg_header(resp, res, "content_security_policy", "__content_security_policy__", "Content-Security-Policy")
    resp = legg_header(resp, res, "content_security_policy_report_only", "__content_security_policy_report_only__", "Content-Security-Policy-Report-Only")
    resp = legg_header(resp, res, "content_disposition", "__content_disposition__", "Content-Disposition")
    resp = legg_header(resp, res, "etag", "__etag__", "ETag")
    resp = legg_header(resp, res, "access_control_allow_origin", "__access_control_allow_origin__", "Access-Control-Allow-Origin")
    resp = legg_header(resp, res, "vary", "__vary__", "Vary")
    resp = legg_header(resp, res, "referrer_policy", "__referrer_policy__", "Referrer-Policy")
    resp = legg_header(resp, res, "permissions_policy", "__permissions_policy__", "Permissions-Policy")
    resp = legg_header(resp, res, "strict_transport_security", "__strict_transport_security__", "Strict-Transport-Security")
    resp = legg_header(resp, res, "x_frame_options", "__x_frame_options__", "X-Frame-Options")
    resp = legg_header(resp, res, "cross_origin_opener_policy", "__cross_origin_opener_policy__", "Cross-Origin-Opener-Policy")
    resp = legg_header(resp, res, "cross_origin_opener_policy_report_only", "__cross_origin_opener_policy_report_only__", "Cross-Origin-Opener-Policy-Report-Only")
    resp = legg_header(resp, res, "cross_origin_resource_policy", "__cross_origin_resource_policy__", "Cross-Origin-Resource-Policy")
    resp = legg_header(resp, res, "cross_origin_resource_policy_report_only", "__cross_origin_resource_policy_report_only__", "Cross-Origin-Resource-Policy-Report-Only")
    resp = legg_header(resp, res, "cross_origin_embedder_policy", "__cross_origin_embedder_policy__", "Cross-Origin-Embedder-Policy")
    resp = legg_header(resp, res, "cross_origin_embedder_policy_report_only", "__cross_origin_embedder_policy_report_only__", "Cross-Origin-Embedder-Policy-Report-Only")
    resp = legg_header(resp, res, "x_permitted_cross_domain_policies", "__x_permitted_cross_domain_policies__", "X-Permitted-Cross-Domain-Policies")
    resp = legg_header(resp, res, "link", "__link__", "Link")
    resp = legg_header(resp, res, "retry_after", "__retry_after__", "Retry-After")
    resp = legg_header(resp, res, "server", "__server__", "Server")
    resp = legg_header(resp, res, "last_modified", "__last_modified__", "Last-Modified")
    resp = legg_header(resp, res, "accept_ranges", "__accept_ranges__", "Accept-Ranges")
    resp = legg_header(resp, res, "expires", "__expires__", "Expires")
    resp = legg_header(resp, res, "content_language", "__content_language__", "Content-Language")
    resp = legg_header(resp, res, "content_encoding", "__content_encoding__", "Content-Encoding")
    resp = legg_header(resp, res, "transfer_encoding", "__transfer_encoding__", "Transfer-Encoding")
    resp = legg_header(resp, res, "pragma", "__pragma__", "Pragma")
    resp = legg_header(resp, res, "connection", "__connection__", "Connection")
    resp = legg_header(resp, res, "www_authenticate", "__www_authenticate__", "WWW-Authenticate")
    resp = legg_header(resp, res, "proxy_authenticate", "__proxy_authenticate__", "Proxy-Authenticate")
    resp = legg_header(resp, res, "clear_site_data", "__clear_site_data__", "Clear-Site-Data")
    resp = legg_header(resp, res, "refresh", "__refresh__", "Refresh")
    resp = legg_header(resp, res, "timing_allow_origin", "__timing_allow_origin__", "Timing-Allow-Origin")

    la eksplisitt_content_type = hent(res, "content_type", "__content_type__")
    la har_content_type = eksplisitt_content_type != null og tekst(eksplisitt_content_type) != ""
    la headers = hent(res, "headers", "__headers__")
    hvis headers != null {
        la namn = nøkler(headers)
        la i: heiltall = 0
        mens i < lengde(namn) {
            la hk = tekst(namn[i])
            hvis hk != "" {
                la liten = builtin.lower(hk)
                hvis liten == "content-type" { har_content_type = sann }
                hvis ikkje (liten == "content-type" og eksplisitt_content_type != null og tekst(eksplisitt_content_type) != "") {
                    resp = resp + hk + ": " + tekst(headers[hk]) + "\r\n"
                }
            }
            i = i + 1
        }
    }
    hvis ikkje har_content_type og body != "" og ikkje head_only og status_kode != "204" {
        resp = resp + "Content-Type: text/plain; charset=utf-8\r\n"
    }
    hvis status_kode != "204" og status_kode != "304" {
        resp = resp + "Content-Length: " + tekst_fra_heiltall(lengde(body)) + "\r\n"
    }
    resp = resp + "\r\n"
    hvis ikkje head_only og status_kode != "204" og status_kode != "304" { resp = resp + body }
    returner resp
}
