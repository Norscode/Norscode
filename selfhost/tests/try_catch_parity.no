bruk selfhost.kompiler som komp

funksjon start()
    kilde = "funksjon start() -> tekst { prøv { kast(\"boom\") } fang (feil) { returner feil } }"
    la ncb = komp.kompiler_fil(kilde, "__main__")
    assert(builtin.contains(ncb, "[\"TRY_BEGIN\""))
    assert(builtin.contains(ncb, "[\"THROW\"]"))
    assert(builtin.contains(ncb, "[\"LOAD_EXCEPTION\"]"))
    skriv("try_catch_parity OK")
    returner 0
slutt
