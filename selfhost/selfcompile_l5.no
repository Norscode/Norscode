// selfhost/selfcompile_l5.no — L5: deterministisk kompilator-bundle
//
// Kompilerer alle aktive selfhost-kompilatormodular frå kjelde to gonger,
// slår funksjonane saman til gyldige NCB-bundles og krev byte-identisk output.
//
// Bruk:
//   ./bin/nc selfcompile-l5
//   ./bin/nc run selfhost/selfcompile_l5.no

bruk tools.process_runner som prosess

funksjon standard_kompilator_modular(root: tekst) -> liste<tekst> {
    returner builtin.split("selfhost.lexer.lexer_m1=" + root + "/selfhost/lexer/lexer_m1.no\nselfhost.parser=" + root + "/selfhost/parser.no\nselfhost.compiler.semantic=" + root + "/selfhost/compiler/semantic.no\nselfhost.compiler.ir_to_bytecode=" + root + "/selfhost/compiler/ir_to_bytecode.no\nselfhost.kompiler=" + root + "/selfhost/kompiler.no\nselfhost.json=" + root + "/selfhost/json.no\nselfhost.vm=" + root + "/selfhost/vm.no\nselfhost.bundler=" + root + "/selfhost/bundler.no\nselfhost.l5b_host=" + root + "/selfhost/l5b_host.no", "\n")
}

funksjon kompiler_modul(modul: tekst, sti: tekst, utfil: tekst) -> tekst {
    la executable = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis executable == "" { executable = "./dist/norscode_native" }
    la miljø = {
        "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": sti,
        "NORSCODE_OUTPUT": utfil,
        "NORSCODE_MODULE": modul,
        "NORSCODE_ROOT": ".",
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": "."
    }
    la res = prosess.køyr(executable, [], ".", miljø, 120000)
    hvis ikkje prosess.ok(res) {
        prosess.skriv_resultat(res)
        kast "L5: kompilering feila for " + modul +
            " status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) +
            " error=" + tekst(res["error"])
    }
    returner fil_les(utfil)
}

funksjon slå_saman_funksjonar(dest, src) -> heltall {
    la keys = nøkler(src)
    la i: heltall = 0
    mens i < lengde(keys) {
        dest[keys[i]] = src[keys[i]]
        i = i + 1
    }
    returner lengde(keys)
}

funksjon slå_saman_modulmetadata(alle_initializers, alle_global_names, ncb) -> heltall {
    hvis har_nokkel(ncb, "module_initializers") {
        la initializers = ncb["module_initializers"]
        la i: heltall = 0
        mens i < lengde(initializers) {
            la finst = usann
            la j: heltall = 0
            mens j < lengde(alle_initializers) {
                hvis alle_initializers[j] == initializers[i] { finst = sann }
                j = j + 1
            }
            hvis ikkje finst { legg_til(alle_initializers, initializers[i]) }
            i = i + 1
        }
    }
    hvis har_nokkel(ncb, "global_names") {
        la kjelde_globalar = ncb["global_names"]
        la modular = nøkler(kjelde_globalar)
        la i: heltall = 0
        mens i < lengde(modular) {
            alle_global_names[modular[i]] = kjelde_globalar[modular[i]]
            i = i + 1
        }
    }
    returner 0
}

funksjon bygg_generasjon(modular: liste<tekst>, utfil: tekst) -> tekst {
    la alle_fns = {}
    la alle_initializers = []
    la alle_global_names = {}
    la i: heltall = 0
    mens i < lengde(modular) {
        la spec = modular[i]
        la eq = builtin.index_of(spec, "=")
        hvis eq <= 0 { kast "L5: ugyldig modulspesifikasjon: " + spec }

        la modul = builtin.slice(spec, 0, eq)
        la sti = builtin.slice(spec, eq + 1, lengde(spec))
        la del_sti = utfil + ".part.ncb.json"
        la ncb_json = kompiler_modul(modul, sti, del_sti)
        la ncb = builtin.json_parse_raw(ncb_json)
        la fns = ncb["functions"]
        la tal = slå_saman_funksjonar(alle_fns, fns)
        slå_saman_modulmetadata(alle_initializers, alle_global_names, ncb)
        skriv("  [OK] " + modul + " (" + tekst_fra_heltall(tal) + " funksjonar)\n")
        i = i + 1
    }

    la bundle = {}
    bundle["format"] = "ncb-v1"
    // Kandidaten skal kunne brukast som komplett Norscode-host i L5b, ikkje
    // berre som oppslagstabell for stage0 sin compiler-dispatch.
    bundle["entry"] = "selfhost.l5b_host.start"
    // Same kanoniske toppnivårekkefølgje som selfhost.bundler.
    bundle["module_initializers"] = alle_initializers
    bundle["global_names"] = alle_global_names
    bundle["imports"] = []
    bundle["route_handlers"] = {}
    bundle["dependency_providers"] = {}
    bundle["guard_providers"] = {}
    bundle["request_middlewares"] = []
    bundle["response_middlewares"] = []
    bundle["error_middlewares"] = []
    bundle["startup_hooks"] = []
    bundle["shutdown_hooks"] = []
    bundle["tests"] = {}
    bundle["functions"] = alle_fns

    // Native NCB-verdiar kan bere historiske tekstkodar som "0", "null"
    // eller rå JSON gjennom den første samanslåinga. Éin eksplisitt
    // parse/serialize-kanonisering gjer representasjonen typa og stabil før
    // både cachematerialisering og byteparitet samanliknar artefaktet.
    la resultat = builtin.json_stringify(builtin.json_parse_raw(builtin.json_stringify(bundle)))
    fil_skriv(utfil, resultat)
    prøv { fil_slett(utfil + ".part.ncb.json") } fang (e) {}
    returner resultat
}

funksjon start() -> heltall {
    skriv("=== Norscode L5 (full kompilator-bundle) ===\n")

    // CLI-gaten køyrer frå prosjektreisa. Relative stiar held både den ytre
    // stage-0-policyen og mål-VM-policyen innan same dokumenterte disk-scope.
    la root = "."
    la v1_sti = root + "/build/l5/compiler_v1.ncb.json"
    la v2_sti = root + "/build/l5/compiler_v2.ncb.json"
    la modular = standard_kompilator_modular(root)
    builtin.mkdir_p(root + "/build/l5")

    skriv("[1/2] Gen1 frå selfhost-kjelder...\n")
    la v1 = bygg_generasjon(modular, v1_sti)

    skriv("[2/2] Gen2 frå same selfhost-kjelder...\n")
    la v2 = bygg_generasjon(modular, v2_sti)

    skriv("[3/3] Byte-paritet...\n")
    hvis v1 == v2 {
        skriv("  [OK] " + tekst_fra_heltall(lengde(v1)) + " bytes identiske\n")
        skriv("\n=== L5: BESTÅTT ===\n")
        returner 0
    }

    skriv("[FEIL] Gen1 og Gen2 er ikkje identiske\n")
    returner 1
}
