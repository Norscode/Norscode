// selfhost/selfcompile_l5.no — L5: deterministisk kompilator-bundle
//
// Kompilerer alle aktive selfhost-kompilatormodular frå kjelde to gonger,
// slår funksjonane saman til gyldige NCB-bundles og krev byte-identisk output.
//
// Bruk:
//   ./bin/nc selfcompile-l5
//   ./bin/nc run selfhost/selfcompile_l5.no

bruk tools.process_runner som prosess
bruk selfhost.ncb_stream som ncb_stream

funksjon standard_kompilator_modular(root: tekst) -> liste<tekst> {
    returner builtin.split("selfhost.lexer.lexer_m1=" + root + "/selfhost/lexer/lexer_m1.no\nselfhost.parser=" + root + "/selfhost/parser.no\nselfhost.compiler.semantic=" + root + "/selfhost/compiler/semantic.no\nselfhost.compiler.ir_to_bytecode=" + root + "/selfhost/compiler/ir_to_bytecode.no\nselfhost.kompiler=" + root + "/selfhost/kompiler.no\nselfhost.json=" + root + "/selfhost/json.no\nselfhost.vm=" + root + "/selfhost/vm.no\nselfhost.bundler=" + root + "/selfhost/bundler.no\nselfhost.l5b_host=" + root + "/selfhost/l5b_host.no\nselfhost.l5b_vm_runner=" + root + "/selfhost/l5b_vm_runner.no", "\n")
}

funksjon kompiler_modul(modul: tekst, sti: tekst, utfil: tekst) -> tekst {
    la executable = miljo_hent("NORSCODE_NATIVE_BIN")
    hvis executable == "" { executable = "./dist/norscode_native" }
    la miljø = {
        "NORSCODE_CMD": "compile",
        "NORSCODE_FILE": sti,
        "NORSCODE_OUTPUT": utfil,
        "NORSCODE_MODULE": modul,
        "NORSCODE_ROOT": ".",
        "NORSCODE_VM_CAPABILITIES": "env.read,disk.read,disk.write",
        "NORSCODE_VM_DISK_ROOT": "."
    }
    la res = prosess.køyr(executable, [], ".", miljø, 120000)
    hvis ikkje prosess.ok(res) {
        prosess.skriv_resultat(res)
        kast "L5: kompilering feila for " + modul +
            " status=" + tekst(res["status"]) + " exit=" + tekst(res["exit_code"]) +
            " error=" + tekst(res["error"])
    }
    returner fil_les(utfil)
}

funksjon slå_saman_funksjonar(dest, src) -> heltall {
    la keys = nøkler(src)
    la i: heltall = 0
    mens i < lengde(keys) {
        dest[keys[i]] = src[keys[i]]
        i = i + 1
    }
    returner lengde(keys)
}

funksjon slå_saman_modulmetadata(alle_initializers, alle_global_names, ncb) -> heltall {
    hvis har_nokkel(ncb, "module_initializers") {
        la initializers = ncb["module_initializers"]
        la i: heltall = 0
        mens i < lengde(initializers) {
            la finst = usann
            la j: heltall = 0
            mens j < lengde(alle_initializers) {
                hvis alle_initializers[j] == initializers[i] { finst = sann }
                j = j + 1
            }
            hvis ikkje finst { legg_til(alle_initializers, initializers[i]) }
            i = i + 1
        }
    }
    hvis har_nokkel(ncb, "global_names") {
        la kjelde_globalar = ncb["global_names"]
        la modular = nøkler(kjelde_globalar)
        la i: heltall = 0
        mens i < lengde(modular) {
            alle_global_names[modular[i]] = kjelde_globalar[modular[i]]
            i = i + 1
        }
    }
    returner 0
}

funksjon driver_utan_debugmetadata(ncb, lazy: boolsk) -> tekst {
    // Driveren er eit avgrensa utføringsartefakt. Klon først slik at full L5
    // framleis bevarer kjeldeposisjonane i den same generasjonen.
    la driver = builtin.json_parse_raw(builtin.json_skriv(ncb))
    la fns = driver["functions"]
    la namn = nøkler(fns)
    la i: heiltall = 0
    mens i < lengde(namn) {
        la fn = fns[namn[i]]
        hvis har_nokkel(fn, "source_lines") { fjern_nokkel(fn, "source_lines") }
        hvis har_nokkel(fn, "source_columns") { fjern_nokkel(fn, "source_columns") }
        hvis lazy { fns[namn[i]] = {"__ncb_lazy_json__": builtin.json_skriv(fn)} }
        i = i + 1
    }
    returner builtin.json_skriv(builtin.json_parse_raw(builtin.json_skriv(driver)))
}

funksjon skriv_driver_json_stream(ncb, utfil: tekst, lazy: boolsk) -> heiltall {
    builtin.fil_skriv(utfil, "{")
    builtin.fil_append(utfil, "\"format\":" + builtin.json_skriv(ncb["format"]) + ",")
    builtin.fil_append(utfil, "\"entry\":" + builtin.json_skriv(ncb["entry"]) + ",")
    builtin.fil_append(utfil, "\"module_initializers\":" + builtin.json_skriv(ncb["module_initializers"]) + ",")
    builtin.fil_append(utfil, "\"global_names\":" + builtin.json_skriv(ncb["global_names"]) + ",")
    builtin.fil_append(utfil, "\"imports\":" + builtin.json_skriv(ncb["imports"]) + ",")
    builtin.fil_append(utfil, "\"route_handlers\":" + builtin.json_skriv(ncb["route_handlers"]) + ",")
    builtin.fil_append(utfil, "\"dependency_providers\":" + builtin.json_skriv(ncb["dependency_providers"]) + ",")
    builtin.fil_append(utfil, "\"guard_providers\":" + builtin.json_skriv(ncb["guard_providers"]) + ",")
    builtin.fil_append(utfil, "\"request_middlewares\":" + builtin.json_skriv(ncb["request_middlewares"]) + ",")
    builtin.fil_append(utfil, "\"response_middlewares\":" + builtin.json_skriv(ncb["response_middlewares"]) + ",")
    builtin.fil_append(utfil, "\"error_middlewares\":" + builtin.json_skriv(ncb["error_middlewares"]) + ",")
    builtin.fil_append(utfil, "\"startup_hooks\":" + builtin.json_skriv(ncb["startup_hooks"]) + ",")
    builtin.fil_append(utfil, "\"shutdown_hooks\":" + builtin.json_skriv(ncb["shutdown_hooks"]) + ",")
    builtin.fil_append(utfil, "\"tests\":" + builtin.json_skriv(ncb["tests"]) + ",\"functions\":{")
    la fns = ncb["functions"]
    la namn = nøkler(fns)
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis i > 0 { builtin.fil_append(utfil, ",") }
        la fn_namn = tekst(namn[i])
        la fn = fns[fn_namn]
        la hadde_linjer = har_nokkel(fn, "source_lines")
        la hadde_kolonnar = har_nokkel(fn, "source_columns")
        la gamle_linjer = []
        la gamle_kolonnar = []
        hvis hadde_linjer {
            gamle_linjer = fn["source_lines"]
            fjern_nokkel(fn, "source_lines")
        }
        hvis hadde_kolonnar {
            gamle_kolonnar = fn["source_columns"]
            fjern_nokkel(fn, "source_columns")
        }
        la fn_json = builtin.json_skriv(fn)
        hvis hadde_linjer { fn["source_lines"] = gamle_linjer }
        hvis hadde_kolonnar { fn["source_columns"] = gamle_kolonnar }
        hvis lazy { fn_json = builtin.json_skriv({"__ncb_lazy_json__": fn_json}) }
        builtin.fil_append(utfil, builtin.json_skriv(fn_namn) + ":" + fn_json)
        i = i + 1
    }
    builtin.fil_append(utfil, "}}")
    returner lengde(namn)
}

funksjon skriv_driver_stream(ncb, utfil: tekst) -> heiltall {
    // NCBS er allereie record-streama. Unngå fullobjekt-kloning; debugfeltene
    // er tillatne i dette interne streamformatet og blir lesne lazy.
    la resultat = ncb_stream.skriv_fil(utfil, ncb)
    hvis resultat["status"] != "ok" { kast "L5: kunne ikkje skrive bundler-stream" }
    returner heltall_fra_tekst(resultat["records"])
}

funksjon skriv_full_bundle_stream(bundle, utfil: tekst) -> heiltall {
    // Full compiler-NCB er for stor for gjenteken tekstkonkatenering gjennom
    // ein generell map-skrivar. Skriv den kanoniske toppnivårekkefølgja og
    // éin funksjon om gongen; alle verdiar går framleis gjennom Norscode sin
    // typesikre JSON-skrivar.
    builtin.fil_skriv(utfil, "{")
    builtin.fil_append(utfil, "\"format\":" + builtin.json_skriv(bundle["format"]) + ",")
    builtin.fil_append(utfil, "\"entry\":" + builtin.json_skriv(bundle["entry"]) + ",")
    builtin.fil_append(utfil, "\"module_initializers\":" + builtin.json_skriv(bundle["module_initializers"]) + ",")
    builtin.fil_append(utfil, "\"global_names\":" + builtin.json_skriv(bundle["global_names"]) + ",")
    builtin.fil_append(utfil, "\"imports\":" + builtin.json_skriv(bundle["imports"]) + ",")
    builtin.fil_append(utfil, "\"route_handlers\":" + builtin.json_skriv(bundle["route_handlers"]) + ",")
    builtin.fil_append(utfil, "\"dependency_providers\":" + builtin.json_skriv(bundle["dependency_providers"]) + ",")
    builtin.fil_append(utfil, "\"guard_providers\":" + builtin.json_skriv(bundle["guard_providers"]) + ",")
    builtin.fil_append(utfil, "\"request_middlewares\":" + builtin.json_skriv(bundle["request_middlewares"]) + ",")
    builtin.fil_append(utfil, "\"response_middlewares\":" + builtin.json_skriv(bundle["response_middlewares"]) + ",")
    builtin.fil_append(utfil, "\"error_middlewares\":" + builtin.json_skriv(bundle["error_middlewares"]) + ",")
    builtin.fil_append(utfil, "\"startup_hooks\":" + builtin.json_skriv(bundle["startup_hooks"]) + ",")
    builtin.fil_append(utfil, "\"shutdown_hooks\":" + builtin.json_skriv(bundle["shutdown_hooks"]) + ",")
    builtin.fil_append(utfil, "\"tests\":" + builtin.json_skriv(bundle["tests"]) + ",\"functions\":{")
    la fns = bundle["functions"]
    la namn = nøkler(fns)
    la i: heiltall = 0
    mens i < lengde(namn) {
        hvis i > 0 { builtin.fil_append(utfil, ",") }
        la fn_namn = tekst(namn[i])
        builtin.fil_append(utfil, builtin.json_skriv(fn_namn) + ":" + builtin.json_skriv(fns[fn_namn]))
        i = i + 1
    }
    builtin.fil_append(utfil, "}}")
    returner lengde(namn)
}

funksjon bygg_generasjon(modular: liste<tekst>, utfil: tekst, bundler_utfil: tekst, bundler_stream_utfil: tekst, compiler_driver_utfil: tekst, vm_runner_utfil: tekst) -> tekst {
    la alle_fns = {}
    la alle_initializers = []
    la alle_global_names = {}
    la i: heltall = 0
    mens i < lengde(modular) {
        la spec = modular[i]
        la eq = builtin.index_of(spec, "=")
        hvis eq <= 0 { kast "L5: ugyldig modulspesifikasjon: " + spec }

        la modul = builtin.slice(spec, 0, eq)
        la sti = builtin.slice(spec, eq + 1, lengde(spec))
        la del_sti = utfil + ".part.ncb.json"
        la ncb_json = kompiler_modul(modul, sti, del_sti)
        la ncb = builtin.json_parse_raw(ncb_json)
        // L5b treng berre bundleren og importane hans for å slå saman ferdig
        // materialiserte modular. Ta vare på det allereie kompilerte
        // modulproduktet; ikkje last heile fullhost-bundlen inn i den indre VM-en.
        hvis modul == "selfhost.bundler" {
            skriv_driver_json_stream(ncb, bundler_utfil, sann)
            skriv_driver_stream(ncb, bundler_stream_utfil)
        }
        // Source-only L5b treng berre hosten som importerer kompilatoren.
        // Eit eige driverartefakt held fullhost-funksjonar ute av grunnheapen.
        hvis modul == "selfhost.l5b_host" { skriv_driver_json_stream(ncb, compiler_driver_utfil, sann) }
        hvis modul == "selfhost.l5b_vm_runner" { skriv_driver_json_stream(ncb, vm_runner_utfil, usann) }
        la fns = ncb["functions"]
        la tal = slå_saman_funksjonar(alle_fns, fns)
        slå_saman_modulmetadata(alle_initializers, alle_global_names, ncb)
        skriv("  [OK] " + modul + " (" + tekst_fra_heltall(tal) + " funksjonar)\n")
        i = i + 1
    }

    la bundle = {}
    bundle["format"] = "ncb-v1"
    // Kandidaten skal kunne brukast som komplett Norscode-host i L5b, ikkje
    // berre som oppslagstabell for stage0 sin compiler-dispatch.
    bundle["entry"] = "selfhost.l5b_host.start"
    // Same kanoniske toppnivårekkefølgje som selfhost.bundler.
    bundle["module_initializers"] = alle_initializers
    bundle["global_names"] = alle_global_names
    bundle["imports"] = []
    bundle["route_handlers"] = {}
    bundle["dependency_providers"] = {}
    bundle["guard_providers"] = {}
    bundle["request_middlewares"] = []
    bundle["response_middlewares"] = []
    bundle["error_middlewares"] = []
    bundle["startup_hooks"] = []
    bundle["shutdown_hooks"] = []
    bundle["tests"] = {}
    bundle["functions"] = alle_fns

    la metadata = {}
    la metadata_felt = nøkler(bundle)
    la metadata_i: heiltall = 0
    mens metadata_i < lengde(metadata_felt) {
        hvis metadata_felt[metadata_i] != "functions" { metadata[metadata_felt[metadata_i]] = bundle[metadata_felt[metadata_i]] }
        metadata_i = metadata_i + 1
    }
    fil_skriv(utfil + ".metadata.json", builtin.json_skriv(metadata))

    skriv_full_bundle_stream(bundle, utfil)
    la resultat = fil_les(utfil)
    prøv { fil_slett(utfil + ".part.ncb.json") } fang (e) {}
    returner resultat
}

funksjon start() -> heltall {
    skriv("=== Norscode L5 (full kompilator-bundle) ===\n")

    // CLI-gaten køyrer frå prosjektreisa. Relative stiar held både den ytre
    // stage-0-policyen og mål-VM-policyen innan same dokumenterte disk-scope.
    la root = "."
    la v1_sti = root + "/build/l5/compiler_v1.ncb.json"
    la v2_sti = root + "/build/l5/compiler_v2.ncb.json"
    la bundler_v1_sti = root + "/build/l5/bundler_driver_v1.ncb.json"
    la bundler_v2_sti = root + "/build/l5/bundler_driver_v2.ncb.json"
    la bundler_sti = root + "/build/l5/bundler_driver.ncb.json"
    la bundler_stream_v1_sti = "build/l5/bundler_driver_v1.ncbs"
    la bundler_stream_v2_sti = "build/l5/bundler_driver_v2.ncbs"
    la bundler_stream_sti = "build/l5/bundler_driver.ncbs"
    la compiler_driver_v1_sti = root + "/build/l5/compiler_driver_v1.ncb.json"
    la compiler_driver_v2_sti = root + "/build/l5/compiler_driver_v2.ncb.json"
    la compiler_driver_sti = root + "/build/l5/compiler_driver.ncb.json"
    la vm_runner_v1_sti = root + "/build/l5/vm_runner_v1.ncb.json"
    la vm_runner_v2_sti = root + "/build/l5/vm_runner_v2.ncb.json"
    la vm_runner_sti = root + "/build/l5/vm_runner.ncb.json"
    la raw_bundler_v1_sti = root + "/build/l5/l5b_raw_bundler_v1.ncb.json"
    la raw_bundler_v2_sti = root + "/build/l5/l5b_raw_bundler_v2.ncb.json"
    la raw_bundler_sti = root + "/build/l5/l5b_raw_bundler.ncb.json"
    la modular = standard_kompilator_modular(root)
    builtin.mkdir_p(root + "/build/l5")

    skriv("[1/2] Gen1 frå selfhost-kjelder...\n")
    la v1 = bygg_generasjon(modular, v1_sti, bundler_v1_sti, bundler_stream_v1_sti, compiler_driver_v1_sti, vm_runner_v1_sti)

    skriv("[2/2] Gen2 frå same selfhost-kjelder...\n")
    la v2 = bygg_generasjon(modular, v2_sti, bundler_v2_sti, bundler_stream_v2_sti, compiler_driver_v2_sti, vm_runner_v2_sti)

    // Den avgrensa raw-bundleren er ein eigen L5-artefakt. Han importerer
    // berre stream- og filesystem-ABI og blir verifisert i to generasjonar.
    la raw_bundler_v1 = kompiler_modul("selfhost.l5b_raw_bundler", root + "/selfhost/l5b_raw_bundler.no", raw_bundler_v1_sti)
    la raw_bundler_v2 = kompiler_modul("selfhost.l5b_raw_bundler", root + "/selfhost/l5b_raw_bundler.no", raw_bundler_v2_sti)

    skriv("[3/3] Byte-paritet...\n")
    la bundler_v1 = fil_les(bundler_v1_sti)
    la bundler_v2 = fil_les(bundler_v2_sti)
    la bundler_stream_v1 = fil_les(bundler_stream_v1_sti)
    la bundler_stream_v2 = fil_les(bundler_stream_v2_sti)
    la compiler_driver_v1 = fil_les(compiler_driver_v1_sti)
    la compiler_driver_v2 = fil_les(compiler_driver_v2_sti)
    la vm_runner_v1 = fil_les(vm_runner_v1_sti)
    la vm_runner_v2 = fil_les(vm_runner_v2_sti)
    la metadata_v1 = fil_les(v1_sti + ".metadata.json")
    la metadata_v2 = fil_les(v2_sti + ".metadata.json")
    hvis v1 == v2 og metadata_v1 == metadata_v2 og bundler_v1 == bundler_v2 og bundler_stream_v1 == bundler_stream_v2 og compiler_driver_v1 == compiler_driver_v2 og vm_runner_v1 == vm_runner_v2 og raw_bundler_v1 == raw_bundler_v2 {
        fil_skriv(root + "/build/l5/compiler_metadata.json", metadata_v1)
        fil_skriv(bundler_sti, bundler_v1)
        fil_skriv(bundler_stream_sti, bundler_stream_v1)
        fil_skriv(compiler_driver_sti, compiler_driver_v1)
        fil_skriv(vm_runner_sti, vm_runner_v1)
        fil_skriv(raw_bundler_sti, raw_bundler_v1)
        skriv("  [OK] " + tekst_fra_heltall(lengde(v1)) + " bytes identiske\n")
        skriv("  [OK] L5b bundler-driver: " + tekst_fra_heltall(lengde(bundler_v1)) + " bytes identiske\n")
        skriv("  [OK] L5b compiler-driver: " + tekst_fra_heltall(lengde(compiler_driver_v1)) + " bytes identiske\n")
        skriv("  [OK] L5b VM-runner: " + tekst_fra_heltall(lengde(vm_runner_v1)) + " bytes identiske\n")
        skriv("  [OK] L5b raw-bundler: " + tekst_fra_heltall(lengde(raw_bundler_v1)) + " bytes identiske\n")
        skriv("\n=== L5: BESTÅTT ===\n")
        returner 0
    }

    skriv("[FEIL] Gen1/Gen2 eller ein L5b-driver er ikkje identisk\n")
    returner 1
}
