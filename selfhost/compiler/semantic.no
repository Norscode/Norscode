// Norscode Selfhost Semantisk Analyse — Minimal
// Fase 3 — Semantikk
//
// Dette er eit minimalt semantisk pass som berre:
//   1. Samlar opp alle funksjonsdefinisjonar (namn → parameterliste)
//   2. Sjekkar at refererte funksjonar finst (utan type-sjekking)
//
// Full type-sjekking kjem seinare. For bootstrap-formål er det nok
// å vite kva som er brukardefinerte funksjonar vs. innebygde.
//
// R1/#182 (re-implementert mot dagens AST): ein VALFRI streng statisk typesjekk
// er kopla inn nedst i analyser_program bak miljøvariabelen NORSCODE_STRICT_TYPAR.
// Han ligg i selfhost/compiler/typecheck.no (tc.kt_koyr). Utan flagget er det
// INGEN åtferdsendring — analyser_program oppfører seg akkurat som før.
// R1 F06: på same vis er ein valfri namnesjekk (udefinerte namn, duplikate
// deklarasjonar) kopla inn bak NORSCODE_STRICT_NAMN (selfhost/compiler/namnesjekk.no).

bruk selfhost.compiler.typecheck som tc
bruk selfhost.compiler.namnesjekk som nk

// ─── Innebygde funksjonar ────────────────────────────────────────────────────

funksjon er_builtin(namn)
    // Tekst-operasjonar
    hvis namn == "tekst_fra_heltall"    returner sann slutt
    hvis namn == "tekst_fra_bool"       returner sann slutt
    hvis namn == "heltall_fra_tekst"    returner sann slutt
    hvis namn == "tekst_starter_med"    returner sann slutt
    hvis namn == "tekst_slutter_med"    returner sann slutt
    hvis namn == "tekst_inneholder"     returner sann slutt
    hvis namn == "tekst_trim"           returner sann slutt
    hvis namn == "del_ord"              returner sann slutt
    // Liste/kart
    hvis namn == "lengde"               returner sann slutt
    hvis namn == "legg_til"             returner sann slutt
    hvis namn == "pop_siste"            returner sann slutt
    hvis namn == "fjern_siste"          returner sann slutt
    hvis namn == "fjern_indeks"         returner sann slutt
    hvis namn == "sett_inn"             returner sann slutt
    hvis namn == "har_nokkel"           returner sann slutt
    hvis namn == "finnes_nøkkel"        returner sann slutt
    hvis namn == "nøkler"               returner sann slutt
    hvis namn == "fjern_nokkel"         returner sann slutt
    // IO
    hvis namn == "skriv"                returner sann slutt
    hvis namn == "les_input"            returner sann slutt
    hvis namn == "fil_les"              returner sann slutt
    hvis namn == "fil_skriv"            returner sann slutt
    hvis namn == "fil_skriv_binær"      returner sann slutt
    hvis namn == "fil_append"           returner sann slutt
    hvis namn == "fil_finnes"           returner sann slutt
    // Konvertering
    hvis namn == "til_tekst"            returner sann slutt
    // Feil
    hvis namn == "feil"                 returner sann slutt
    // Vanlege ukvalifiserte innebygde (2026-09-06): brukt av ir_to_bytecode
    // for å hindre at importerte modulfunksjonar med same namn skuggar
    // builtin-en i ukvalifiserte kall (jf. std.dns.legg_til).
    hvis namn == "assert"               returner sann slutt
    hvis namn == "assert_eq"            returner sann slutt
    hvis namn == "assert_ne"            returner sann slutt
    hvis namn == "assert_inneholder"    returner sann slutt
    hvis namn == "tekst"                returner sann slutt
    hvis namn == "heltall"              returner sann slutt
    hvis namn == "heiltall"             returner sann slutt
    hvis namn == "tekst_fra_heiltall"   returner sann slutt
    hvis namn == "heiltall_fra_tekst"   returner sann slutt
    hvis namn == "tekst_erstatt"        returner sann slutt
    hvis namn == "tekst_saman"          returner sann slutt
    hvis namn == "tekst_til_liten"      returner sann slutt
    hvis namn == "tekst_til_store"      returner sann slutt
    hvis namn == "miljo_hent"           returner sann slutt
    hvis namn == "miljo_sett"           returner sann slutt
    hvis namn == "json_parse_raw"       returner sann slutt
    hvis namn == "json_skriv"           returner sann slutt
    hvis namn == "exec_prosess"         returner sann slutt
    hvis namn == "fil_les_binær"        returner sann slutt
    hvis namn == "fil_les_binary"       returner sann slutt
    hvis namn == "tid_ms"               returner sann slutt
    hvis namn == "type"                 returner sann slutt
    hvis namn == "slice"                returner sann slutt
    hvis namn == "split"                returner sann slutt
    hvis namn == "trim"                 returner sann slutt
    hvis namn == "upper"                returner sann slutt
    hvis namn == "lower"                returner sann slutt
    hvis namn == "contains"             returner sann slutt
    hvis namn == "starts_with"          returner sann slutt
    hvis namn == "ends_with"            returner sann slutt
    hvis namn == "index_of"             returner sann slutt
    hvis namn == "char_code"            returner sann slutt
    hvis namn == "chr"                  returner sann slutt
    returner usann
slutt

// ─── Symbol-register ─────────────────────────────────────────────────────────

funksjon ny_symbol_tabell()
    tabell = {}
    tabell["funksjonar"] = {}
    tabell["feil"] = []
    returner tabell
slutt

funksjon registrer_funksjon(tabell, namn, params)
    tabell["funksjonar"][namn] = params
slutt

funksjon funksjon_finst(tabell, namn)
    la funksjonar = tabell["funksjonar"]
    hvis funksjonar == null {
        returner usann
    }
    la finst = har_nokkel(funksjonar, namn)
    returner finst
slutt

funksjon legg_til_feil(tabell, melding)
    legg_til(tabell["feil"], melding)
slutt

// ─── Analyse-pass ────────────────────────────────────────────────────────────

funksjon samle_funksjonar(tabell, program_node)
    // Første pass: registrer alle funksjonsnamnsom
    i = 0
    mens i < lengde(program_node["barn"])
        node = program_node["barn"][i]
        hvis node["type"] == "Funksjon"
            // Samle parameter-namn
            params = []
            param_node = node["barn"][0]
            j = 0
            mens j < lengde(param_node["barn"])
                legg_til(params, param_node["barn"][j]["verdi"])
                j = j + 1
            slutt
            registrer_funksjon(tabell, node["verdi"], params)
        slutt
        i = i + 1
    slutt
slutt

funksjon sjekk_kall_i_uttrykk(tabell, node)
    t = node["type"]

    hvis t == "Kall"
        fn_nam = node["barn"][0]["verdi"]
        la lokal_funksjon = funksjon_finst(tabell, fn_nam)
        la innebygd_funksjon = er_builtin(fn_nam)
        hvis ikkje lokal_funksjon og ikkje innebygd_funksjon
            // Kan vere ein ekstern funksjon — ikkje ein hard feil i bootstrap
            // legg_til_feil(tabell, "Ukjent funksjon: " + fn_nam)
        slutt
        // Sjekk argument-uttrykk
        argumenter = node["barn"][1]
        k = 0
        mens k < lengde(argumenter["barn"])
            sjekk_kall_i_uttrykk(tabell, argumenter["barn"][k])
            k = k + 1
        slutt
        returner sann
    slutt

    la barn = node["barn"]
    i = 0
    mens i < lengde(barn)
        sjekk_kall_i_uttrykk(tabell, barn[i])
        i = i + 1
    slutt
    returner sann
slutt

// ─── Streng typesjekk (opt-in: NORSCODE_STRICT_TYPAR=1) ──────────────────────
// R1/#182 re-implementert. Desse hjelparane blir berre nytta når strengt
// typing er slått på; dei rører ikkje den vanlege (mjuke) analysen.

funksjon sem_streng_aktiv()
    la flagg = ""
    prøv { flagg = miljo_hent("NORSCODE_STRICT_TYPAR") } fang (e) { flagg = "" }
    returner flagg == "1"
slutt

funksjon sem_barn_av_type(node, t)
    la barn = node["barn"]
    la i = 0
    mens i < lengde(barn)
        la b = barn[i]
        hvis b["type"] == t returner b slutt
        i = i + 1
    slutt
    returner null
slutt

// Deklarerte parametertypar for ein funksjon (same reglar som linter_kjerne):
// vararg samlar resten i ei liste, så elementa har ikkje parametertypen og blir
// lagt inn som "" (utypa → ikkje sjekka ved kall).
funksjon sem_param_typar(fn_node)
    la ut = []
    la pnode = sem_barn_av_type(fn_node, "Parametere")
    hvis pnode == null returner ut slutt
    la barn = pnode["barn"]
    la vararg = usann
    la i = 0
    mens i < lengde(barn)
        la p = barn[i]
        la er_var = har_nokkel(p, "vararg")
        hvis er_var vararg = sann slutt
        hvis vararg
            legg_til(ut, "")
        ellers
            legg_til(ut, tc.kt_param_type(p))
        slutt
        i = i + 1
    slutt
    returner ut
slutt

// Fyll tabellen med param-/returtypar som tc.kt_koyr forventar. Dette er dagens
// ekvivalent til samle_funksjonar sitt type-steg frå #182.
funksjon sem_populer_typar(tabell, program_node)
    tabell["param_typar"] = {}
    tabell["retur_typar"] = {}
    tabell["typefeil"] = []
    tabell["typeaatvaringar"] = []
    la barn = program_node["barn"]
    la i = 0
    mens i < lengde(barn)
        la node = barn[i]
        hvis node["type"] == "Funksjon"
            la namn = node["verdi"]
            tabell["param_typar"][namn] = sem_param_typar(node)
            la rt = sem_barn_av_type(node, "Returtype")
            hvis rt != null tabell["retur_typar"][namn] = tc.kt_typetekst(rt) slutt
        slutt
        i = i + 1
    slutt
    returner 0
slutt

// Køyr den strenge typesjekken og kast fyrste typefeil. Ein intern krasj i
// sjekken skal ikkje blokkere kompileringa, difor er kt_koyr pakka i prøv/fang;
// berre ekte typefeil (samla i tabell["typefeil"]) blir kasta.
funksjon sem_streng_typesjekk(tabell, program_node)
    sem_populer_typar(tabell, program_node)
    // R3/F27: fine typar, strukturar/grensesnitt, generiske, flyt (sjå typecheck.no).
    tabell["streng"] = sann
    prøv { tc.kt_koyr(tabell, program_node) } fang (e) { }
    la feilliste = tabell["typefeil"]
    // R3/F27: alle typefeil, éin per linje (fyrste linje er den fyrste feilen).
    hvis lengde(feilliste) > 0
        feil(builtin.join(feilliste, "\n"))
    slutt
    returner 0
slutt

// ─── R2/F15: konst-bindingar ────────────────────────────────────────────────
// `konst X = v` (La-node med konst=sann, sjå parser.parse_la) kan ikkje
// tilordnast på nytt. Ein Sett/AugSett med X som mål er ein kompileringsfeil
// når X i skopet er ein konstant: ein lokal konst i funksjonen, eller ein
// modulkonstant som ikkje er skugga av ein lokal deklarasjon (parameter, la,
// for-/fang-/komprehensjonsvariabel) i funksjonen. Skopet er funksjonsvidt,
// som `la` elles i språket.

funksjon konst_er_node(node)
    hvis node == null returner usann slutt
    returner builtin.type(node) == "ordbok"
slutt

// Samlar deklarerte namn i ei funksjonskropp: vanlege namn i `lokale`,
// konstantar i `konstar`. Går ikkje inn i nøsta funksjonar (eige skop).
funksjon konst_samle_dekl(node, lokale, konstar)
    hvis ikkje konst_er_node(node) returner 0 slutt
    la t = node["type"]
    hvis t == "Funksjon"
        lokale[node["verdi"]] = sann
        returner 0
    slutt
    hvis t == "La"
        hvis har_nokkel(node, "konst") og node["konst"] == sann
            konstar[node["verdi"]] = sann
        ellers
            lokale[node["verdi"]] = sann
        slutt
    slutt
    hvis t == "For" eller t == "ForRange" eller t == "ListeKomprehensjon" eller t == "PrøvFang"
        lokale[node["verdi"]] = sann
    slutt
    hvis t == "Parametere"
        la pi = 0
        mens pi < lengde(node["barn"])
            lokale[node["barn"][pi]["verdi"]] = sann
            pi = pi + 1
        slutt
    slutt
    hvis t == "LaDestrukt" og lengde(node["barn"]) > 0
        la mål = node["barn"][0]
        la mi = 0
        mens mi < lengde(mål["barn"])
            lokale[mål["barn"][mi]["verdi"]] = sann
            mi = mi + 1
        slutt
    slutt
    la barn = node["barn"]
    hvis barn == null returner 0 slutt
    la i = 0
    mens i < lengde(barn)
        konst_samle_dekl(barn[i], lokale, konstar)
        i = i + 1
    slutt
    returner 0
slutt

// Finn Sett/AugSett på eit konstant namn. `modul_konst` er modulkonstantane,
// `lokale`/`konstar` deklarasjonane i gjeldande funksjon.
funksjon konst_sjekk_tilordning(node, modul_konst, lokale, konstar)
    hvis ikkje konst_er_node(node) returner 0 slutt
    la t = node["type"]
    hvis t == "Funksjon" returner 0 slutt
    hvis (t == "Sett" eller t == "AugSett") og lengde(node["barn"]) > 0
        la mål = node["barn"][0]
        hvis konst_er_node(mål) og mål["type"] == "Ident"
            la n = mål["verdi"]
            la er_konst = har_nokkel(konstar, n)
            hvis ikkje er_konst og har_nokkel(modul_konst, n) og ikkje har_nokkel(lokale, n)
                er_konst = sann
            slutt
            hvis er_konst
                kast "Konstfeil linje " + tekst(node["linje"]) + ": kan ikkje tilordne til konstanten " + n
            slutt
        slutt
    slutt
    la barn = node["barn"]
    hvis barn == null returner 0 slutt
    la i = 0
    mens i < lengde(barn)
        konst_sjekk_tilordning(barn[i], modul_konst, lokale, konstar)
        i = i + 1
    slutt
    returner 0
slutt

funksjon sjekk_konst(program_node)
    hvis ikkje har_nokkel(program_node, "har_konst") eller program_node["har_konst"] != sann returner 0 slutt
    la modul_konst = {}
    la barn = program_node["barn"]
    la i = 0
    mens i < lengde(barn)
        la node = barn[i]
        hvis node["type"] == "La" og har_nokkel(node, "konst") og node["konst"] == sann
            modul_konst[node["verdi"]] = sann
        slutt
        i = i + 1
    slutt
    // Toppnivå-setningar (modul-init) og kvar funksjon/test for seg.
    la tomme = {}
    i = 0
    mens i < lengde(barn)
        la node = barn[i]
        hvis node["type"] == "Funksjon" eller node["type"] == "Test"
            la lokale = {}
            la konstar = {}
            la fb = node["barn"]
            la fi = 0
            mens fi < lengde(fb)
                konst_samle_dekl(fb[fi], lokale, konstar)
                fi = fi + 1
            slutt
            fi = 0
            mens fi < lengde(fb)
                konst_sjekk_tilordning(fb[fi], modul_konst, lokale, konstar)
                fi = fi + 1
            slutt
        ellers
            konst_sjekk_tilordning(node, modul_konst, tomme, tomme)
        slutt
        i = i + 1
    slutt
    returner 0
slutt

funksjon analyser_program(program_node)
    tabell = ny_symbol_tabell()

    // R2/F15: konst kan ikkje tilordnast på nytt (alltid aktiv).
    sjekk_konst(program_node)

    // Pass 1: registrer funksjonar
    samle_funksjonar(tabell, program_node)

    // Pass 2: sjekk kall (mjuk — rapporterer ikkje feil for bootstrap)
    i = 0
    mens i < lengde(program_node["barn"])
        node = program_node["barn"][i]
        hvis node["type"] == "Funksjon"
            sjekk_kall_i_uttrykk(tabell, node)
        slutt
        i = i + 1
    slutt

    // Pass 3 (valfritt): streng statisk typesjekk. Berre aktiv med
    // NORSCODE_STRICT_TYPAR=1; elles ingen åtferdsendring (bakoverkompatibelt).
    la streng = sem_streng_aktiv()
    hvis streng
        sem_streng_typesjekk(tabell, program_node)
    slutt

    // Pass 4 (valfritt): namnesjekk (R1 F06). Berre aktiv med
    // NORSCODE_STRICT_NAMN=1; sjå selfhost/compiler/namnesjekk.no.
    la namn_streng = nk.nk_aktiv()
    hvis namn_streng
        nk.nk_koyr(program_node)
    slutt

    returner tabell
slutt

// ─── Offentleg API ───────────────────────────────────────────────────────────

funksjon hent_funksjon_param(tabell, namn)
    hvis har_nokkel(tabell["funksjonar"], namn)
        returner tabell["funksjonar"][namn]
    slutt
    returner []
slutt

funksjon start()
    returner "semantic_ready"
slutt
