// Norscode Selfhost Bytecode Compiler
// Fase 3 — IR-til-bytecode
//
// Tar AST-noder fra selfhost/parser.no og produserer norscode-bytecode-v1 JSON.
// Krever ingen C, ingen Python — output er NCB JSON; kjøres via selfhost/vm.no.
//
// Input:  ASTNode (Program) frå parser.no
bruk selfhost.lexer.lexer_m1
bruk selfhost.parser
bruk selfhost.compiler.semantic
// Output: JSON-tekst (norscode-bytecode-v1 format)

// ─── JSON-hjelparar ──────────────────────────────────────────────────────────

funksjon json_heiltal_tekst(n)
    // Skriv heiltal utan host-builtin for tekstkonvertering. Native AOT kan
    // bere resultat frå lengde(...) i ei heiltalsform som fungerer i rekning
    // og løkker, men som eldre builtin.tekst feilaktig gjer om til tom tekst.
    hvis builtin.type(n) == "ingenting"
        returner "0"
    slutt
    hvis n == 0
        returner "0"
    slutt
    la negativ = usann
    hvis n < 0
        negativ = sann
        n = 0 - n
    slutt
    la ut = ""
    mens n > 0
        la siffer = n % 10
        ut = builtin.chr(48 + siffer) + ut
        n = (n - siffer) / 10
    slutt
    // Literalverdien 0 frå eldre parsergenerasjonar kan vere ein intern
    // heiltalsnull som ikkje treff n == 0, men heller ikkje produserer sifre.
    hvis ut == ""
        returner "0"
    slutt
    hvis negativ
        returner "-" + ut
    slutt
    returner ut
slutt

funksjon ir_fremdrift(melding: tekst) -> heiltall
    la sti = miljo_hent("NORSCODE_IR_PROGRESS_FILE")
    hvis sti != ""
        prøv { builtin.fil_skriv(sti, melding + " heap=" + tekst_fra_heltall(builtin.native_heap_bytes()) + "\n") }
        fang (e) { la ignorert = e }
    slutt
    returner 0
slutt

funksjon json_escape_tegn(c)
    hvis c == "\""
        returner "\\\""
    slutt
    hvis c == "\\"
        returner "\\\\"
    slutt
    hvis c == "\n"
        returner "\\n"
    slutt
    hvis c == "\t"
        returner "\\t"
    slutt
    hvis c == "\r"
        returner "\\r"
    slutt
    // Eskaper andre kontroll-teikn (ASCII < 32)
    la code: heltall = builtin.char_code(c)
    hvis code < 32
        returner "\\u00" + builtin.slice("0123456789abcdef", (code >> 4) & 15, ((code >> 4) & 15) + 1) + builtin.slice("0123456789abcdef", code & 15, (code & 15) + 1)
    slutt
    returner c
slutt

funksjon json_escape_tekst(t)
    // Funksjonsnamn, opcodes og dei fleste literalane er rein ASCII utan
    // JSON-kontrollteikn. Unngå då ei teiknliste og eitt VM-kall per teikn;
    // den generelle ruta under blir berre brukt når escaping faktisk trengst.
    la må_escape = usann
    la sjekk_i = 0
    mens sjekk_i < lengde(t)
        la sjekk_tegn = t[sjekk_i]
        la sjekk_kode: heltall = builtin.char_code(sjekk_tegn)
        hvis sjekk_tegn == "\"" eller sjekk_tegn == "\\" eller sjekk_kode < 32
            må_escape = sann
            bryt
        slutt
        sjekk_i = sjekk_i + 1
    slutt
    hvis ikkje må_escape
        returner "\"" + t + "\""
    slutt
    // Hald lista ikkje-tom også når parseren ber ein eldre native-tagga
    // tomstreng. Då treng me verken samanlikne den med "" eller køyre join([]).
    deler = ["\""]
    i = 0
    mens i < lengde(t)
        legg_til(deler, json_escape_tegn(t[i]))
        i = i + 1
    slutt
    legg_til(deler, "\"")
    returner builtin.join(deler, "")
slutt

funksjon json_liste(element)
    // Kjeldekart brukar heiltal. Serialiser verdiane som rå JSON-tal, ikkje
    // som tekst; den gamle ruta sende heiltal inn i streng-escaparen.
    deler = []
    i = 0
    mens i < lengde(element)
        legg_til(deler, json_heiltal_tekst(element[i]))
        i = i + 1
    slutt
    returner "[" + builtin.join(deler, ",") + "]"
slutt

funksjon json_liste_tekst(element)
    // element er ein liste med tekst-strenger
    deler = []
    i = 0
    mens i < lengde(element)
        legg_til(deler, json_escape_tekst(element[i]))
        i = i + 1
    slutt
    returner "[" + builtin.join(deler, ",") + "]"
slutt

funksjon json_instruksjon(instr)
    // instr = [opcode_tekst, arg1, arg2, ...]  (liste av blanda verdiar)
    ut = "["
    i = 0
    mens i < lengde(instr)
        hvis i > 0
            ut = ut + ","
        slutt
        del = instr[i]
        // Første element er alltid opcode-tekst
        ut = ut + json_escape_tekst(del)
        i = i + 1
    slutt
    returner ut + "]"
slutt

funksjon json_instruksjon_med_int(opcode, n)
    returner "[" + json_escape_tekst(opcode) + "," + json_heiltal_tekst(n) + "]"
slutt

funksjon json_instruksjon_med_desimal(opcode, n)
    returner "[" + json_escape_tekst(opcode) + "," + tekst(n) + "]"
slutt

funksjon json_instruksjon_med_tekst(opcode, s)
    la opcode_json = json_escape_tekst(opcode)
    la verdi_json = json_escape_tekst(s)
    returner "[" + opcode_json + "," + verdi_json + "]"
slutt

funksjon json_instruksjon_med_bool(opcode, b)
    hvis b
        returner "[" + json_escape_tekst(opcode) + ",true]"
    slutt
    returner "[" + json_escape_tekst(opcode) + ",false]"
slutt

funksjon normaliser_builtin_kall_namn(fn_navn)
    hvis fn_navn == "builtin.finnes_nøkkel" eller fn_navn == "builtin.finnes_nokkel" eller fn_navn == "builtin.builtin.finnes_nøkkel" eller fn_navn == "builtin.builtin.finnes_nokkel"
        returner "builtin.har_nokkel"
    slutt
    hvis fn_navn == "builtin.tekst_til_store" eller fn_navn == "builtin.builtin.tekst_til_store"
        returner "builtin.upper"
    slutt
    hvis fn_navn == "builtin.tekst_til_liten" eller fn_navn == "builtin.builtin.tekst_til_liten"
        returner "builtin.lower"
    slutt
    returner fn_navn
slutt

funksjon json_kall(fn_navn, arg_antal)
    hvis builtin.starts_with(fn_navn, "builtin.finnes_") eller builtin.starts_with(fn_navn, "builtin.builtin.finnes_")
        fn_navn = "builtin.har_nokkel"
    slutt
    returner "[\"CALL\"," + json_escape_tekst(normaliser_builtin_kall_namn(fn_navn)) + "," + json_heiltal_tekst(arg_antal) + "]"
slutt

funksjon json_instruksjon_uten_arg(opcode)
    returner "[" + json_escape_tekst(opcode) + "]"
slutt

funksjon legg_til_implisitt_return(kode)
    // Unngå samansett `lengde == 0 eller siste != RETURN` her. Eldre
    // bootstrap-/hybridgenerasjonar har kompilert den kortslutninga ulikt og
    // lagt ein ekstra null-retur etter ein eksplisitt RETURN.
    hvis lengde(kode) > 0
        hvis kode[lengde(kode) - 1] == json_instruksjon_uten_arg("RETURN")
            returner 0
        slutt
    slutt
    legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
    legg_til(kode, json_instruksjon_uten_arg("RETURN"))
    returner 1
slutt

funksjon json_try_begin(catch_label, catch_type)
    returner "[\"TRY_BEGIN\"," + json_escape_tekst(catch_label) + "," + json_escape_tekst(catch_type) + "]"
slutt

funksjon json_bool(verdien)
    hvis verdien
        returner "true"
    slutt
    returner "false"
slutt

funksjon json_fra_tekstliste(liste)
    hvis liste == null
        returner "[]"
    slutt
    returner json_liste_tekst(liste)
slutt

funksjon json_fra_map_parliste(par_liste)
    hvis par_liste == null
        returner "{}"
    slutt
    ut = "{"
    i = 0
    mens i < lengde(par_liste)
        hvis i > 0
            ut = ut + ","
        slutt
        par = par_liste[i]
        sep = 0
        j = 0
        mens j < lengde(par)
            hvis par[j] == "|" og j + 4 < lengde(par)
                chunk = par[j] + par[j+1] + par[j+2] + par[j+3] + par[j+4]
                hvis chunk == "|SEP|"
                    sep = j
                    bryt
                slutt
            slutt
            j = j + 1
        slutt
        nøkkel = builtin.slice(par, 0, sep)
        verdi = builtin.slice(par, sep + 5, lengde(par))
        ut = ut + json_escape_tekst(nøkkel) + ":" + json_escape_tekst(verdi)
        i = i + 1
    slutt
    returner ut + "}"
slutt

funksjon web_type_til_schema(type_namn)
    hvis type_namn == "heltall" eller type_namn == "int"
        returner "{\"type\":\"integer\"}"
    slutt
    hvis type_namn == "bool" eller type_namn == "boolsk"
        returner "{\"type\":\"boolean\"}"
    slutt
    hvis type_namn == "liste_heltall"
        returner "{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}"
    slutt
    hvis type_namn == "liste_tekst"
        returner "{\"type\":\"array\",\"items\":{\"type\":\"string\"}}"
    slutt
    hvis type_namn == "ordbok_heltall"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"integer\"}}"
    slutt
    hvis type_namn == "ordbok_bool"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"boolean\"}}"
    slutt
    hvis type_namn == "ordbok_tekst"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}"
    slutt
    // Generisk ordbok<tekst, ordbok<tekst, tekst>> og liknande
    hvis tekst_starter_med(type_namn, "ordbok<")
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}}"
    slutt
    // Plain 'ordbok' utan generisk annotasjon — treat as nested dict
    hvis type_namn == "ordbok"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}}"
    slutt
    returner "{\"type\":\"string\"}"
slutt

funksjon web_type_til_eksempel(type_namn)
    hvis type_namn == "heltall" eller type_namn == "int"
        returner "1"
    slutt
    hvis type_namn == "bool" eller type_namn == "boolsk"
        returner "true"
    slutt
    hvis type_namn == "liste_heltall"
        returner "[1]"
    slutt
    hvis type_namn == "liste_tekst"
        returner "[\"eksempel\"]"
    slutt
    hvis tekst_starter_med(type_namn, "ordbok<") eller type_namn == "ordbok"
        returner "{\"verdi\":{\"verdi\":\"eksempel\"}}"
    slutt
    hvis type_namn == "ordbok_heltall"
        returner "{\"verdi\":1}"
    slutt
    hvis type_namn == "ordbok_bool"
        returner "{\"verdi\":true}"
    slutt
    hvis type_namn == "ordbok_tekst"
        returner "{\"verdi\":\"eksempel\"}"
    slutt
    returner json_escape_tekst("eksempel")
slutt

funksjon web_normaliser_sti(sti)
    normalisert = sti
    hvis normalisert == ""
        returner "/"
    slutt
    hvis normalisert[0] != "/"
        returner "/" + normalisert
    slutt
    returner normalisert
slutt

funksjon web_kombiner_prefiks(prefiks, spec)
    hvis prefiks == ""
        returner spec
    slutt
    // Finn metode og sti
    metode = ""
    sti = spec
    pos = -1
    k = 0
    mens k < lengde(spec)
        hvis spec[k] == " "
            pos = k
            bryt
        slutt
        k = k + 1
    slutt
    hvis pos > 0
        metode = builtin.slice(spec, 0, pos)
        sti = builtin.slice(spec, pos + 1, lengde(spec))
    slutt
    // Normaliser prefiks
    prefix_n = web_normaliser_sti(prefiks)
    hvis lengde(prefix_n) > 1 og prefix_n[lengde(prefix_n) - 1] == "/"
        prefix_n = builtin.slice(prefix_n, 0, lengde(prefix_n) - 1)
    slutt
    // Legg saman
    hvis sti == "" eller sti == "/"
        kombinert2 = prefix_n
        hvis metode == ""
            returner kombinert2
        slutt
        returner metode + " " + kombinert2
    slutt
    hvis sti[0] != "/"
        sti = "/" + sti
    slutt
    kombinert3 = prefix_n + sti
    hvis metode == ""
        returner kombinert3
    slutt
    returner metode + " " + kombinert3
slutt

funksjon web_split_spec(spec)
    metode = ""
    sti = spec
    mellomrom_pos = 0
    i = 0
    mens i < lengde(spec)
        hvis spec[i] == " "
            mellomrom_pos = i
            bryt
        slutt
        i = i + 1
    slutt
    hvis mellomrom_pos > 0
        metode = builtin.slice(spec, 0, mellomrom_pos)
        sti = builtin.slice(spec, mellomrom_pos + 1, lengde(spec))
    slutt
    returner [metode, sti]
slutt

funksjon web_metode_liten(metode)
    hvis metode == "GET"
        returner "get"
    slutt
    hvis metode == "POST"
        returner "post"
    slutt
    hvis metode == "PUT"
        returner "put"
    slutt
    hvis metode == "PATCH"
        returner "patch"
    slutt
    hvis metode == "DELETE"
        returner "delete"
    slutt
    hvis metode == "HEAD"
        returner "head"
    slutt
    hvis metode == "OPTIONS"
        returner "options"
    slutt
    hvis metode == "TRACE"
        returner "trace"
    slutt
    hvis metode == "CONNECT"
        returner "connect"
    slutt
    returner metode
slutt

funksjon route_felt_liste(route, nøkkel)
    hvis har_nokkel(route, nøkkel)
        returner route[nøkkel]
    slutt
    returner []
slutt

funksjon web_rute_til_json(route)
    response_type = route_felt_tekst(route, "response_type")
    hvis response_type == ""
        response_type = "tekst"
    slutt
    spec_delar = web_split_spec(route_felt_tekst(route, "spec"))
    request_method = web_metode_liten(spec_delar[0])
    request_path = spec_delar[1]
    hvis request_method == ""
        request_method = route_felt_tekst(route, "method")
    slutt
    hvis request_method == ""
        request_method = "get"
    slutt
    hvis request_path == ""
        request_path = route_felt_tekst(route, "path")
    slutt
    route_json = "{"
    route_json = route_json + "\"function\":" + json_escape_tekst(route_felt_tekst(route, "function")) + ","
    route_json = route_json + "\"method\":" + json_escape_tekst(request_method) + ","
    route_json = route_json + "\"path\":" + json_escape_tekst(request_path) + ","
    route_json = route_json + "\"path_params\":" + json_fra_tekstliste(route_felt_liste(route, "path_params")) + ","
    route_json = route_json + "\"query_params\":" + json_fra_tekstliste(route_felt_liste(route, "query_params")) + ","
    route_json = route_json + "\"body_fields\":" + json_fra_tekstliste(route_felt_liste(route, "body_fields")) + ","
    route_json = route_json + "\"deps\":" + json_fra_tekstliste(route_felt_liste(route, "deps")) + ","
    route_json = route_json + "\"guards\":" + json_fra_tekstliste(route_felt_liste(route, "guards")) + ","
    route_json = route_json + "\"response_type\":" + json_escape_tekst(response_type) + ","
    route_json = route_json + "\"summary\":" + json_escape_tekst(route_felt_tekst(route, "summary")) + ","
    route_json = route_json + "\"operation_id\":" + json_escape_tekst(route_felt_tekst(route, "operation_id")) + ","
    route_json = route_json + "\"spec\":" + json_escape_tekst(route_felt_tekst(route, "spec")) + ","
    route_json = route_json + "\"request_example\":{"
    route_json = route_json + "\"method\":" + json_escape_tekst(request_method) + ","
    route_json = route_json + "\"path\":" + json_escape_tekst(request_path)
    route_json = route_json + "},"
    route_json = route_json + "\"response_example\":" + web_type_til_eksempel(response_type) + ","
    route_json = route_json + "\"response_schema\":" + web_type_til_schema(response_type) + ","
    // Serialiser error_responses som liste av {status, message}-objekt
    la errs_json: tekst = "["
    la errs_list = route_felt_liste(route, "error_responses")
    la ei: heltall = 0
    mens ei < lengde(errs_list)
        la er_item = errs_list[ei]
        la er_status = ""
        la er_msg = ""
        hvis har_nokkel(er_item, "status")
            er_status = tekst(er_item["status"])
        slutt
        hvis har_nokkel(er_item, "message")
            er_msg = tekst(er_item["message"])
        slutt
        la er_json = "{\"status\":\"" + er_status + "\",\"message\":\"" + er_msg + "\"}"
        hvis ei > 0
            errs_json = errs_json + ","
        slutt
        errs_json = errs_json + er_json
        ei = ei + 1
    slutt
    errs_json = errs_json + "]"
    route_json = route_json + "\"error_responses\":" + errs_json + ","
    route_json = route_json + "\"responses\":{"
    route_json = route_json + "\"200\":{"
    route_json = route_json + "\"description\":\"OK\","
    route_json = route_json + "\"content\":{"
    route_json = route_json + "\"application/json\":{"
    route_json = route_json + "\"schema\":" + web_type_til_schema(response_type) + ","
    route_json = route_json + "\"example\":" + web_type_til_eksempel(response_type)
    route_json = route_json + "}}}"
    route_json = route_json + "}"
    // 2.10(b): OpenAPI-markørar
    route_json = route_json + ",\"tags\":" + json_fra_tekstliste(route_felt_liste(route, "tags"))
    route_json = route_json + ",\"description\":" + json_escape_tekst(route_felt_tekst(route, "description"))
    la depr = "false"
    hvis har_nokkel(route, "deprecated") og route["deprecated"] == sann
        depr = "true"
    slutt
    route_json = route_json + ",\"deprecated\":" + depr
    la skjul_t = "false"
    hvis har_nokkel(route, "hidden") og route["hidden"] == sann
        skjul_t = "true"
    slutt
    route_json = route_json + ",\"hidden\":" + skjul_t
    la extra_json: tekst = "["
    la extra_list = route_felt_liste(route, "extra_responses")
    la xi: heltall = 0
    mens xi < lengde(extra_list)
        la x_item = extra_list[xi]
        la x_status = ""
        la x_desc = ""
        hvis har_nokkel(x_item, "status")
            x_status = tekst(x_item["status"])
        slutt
        hvis har_nokkel(x_item, "description")
            x_desc = tekst(x_item["description"])
        slutt
        hvis xi > 0
            extra_json = extra_json + ","
        slutt
        extra_json = extra_json + "{\"status\":" + json_escape_tekst(x_status) + ",\"description\":" + json_escape_tekst(x_desc) + "}"
        xi = xi + 1
    slutt
    extra_json = extra_json + "]"
    route_json = route_json + ",\"extra_responses\":" + extra_json
    route_json = route_json + "}"
    returner route_json
slutt

funksjon json_fra_ruteliste(handlers)
    hvis handlers == null
        returner "[]"
    slutt
    ut = "["
    i = 0
    mens i < lengde(handlers)
        hvis i > 0
            ut = ut + ","
        slutt
        ut = ut + web_rute_til_json(handlers[i])
        i = i + 1
    slutt
    returner ut + "]"
slutt

funksjon felt_kjede_tekst(node)
    hvis node == null
        returner ""
    slutt
    hvis node["type"] == "Ident"
        returner node["verdi"]
    slutt
    hvis node["type"] == "Felt"
        base = felt_kjede_tekst(node["barn"][0])
        hvis base == ""
            returner node["verdi"]
        slutt
        returner base + "." + node["verdi"]
    slutt
    returner ""
slutt

funksjon tekst_ender_med(tekstverdi, suffiks)
    hvis lengde(tekstverdi) < lengde(suffiks)
        returner usann
    slutt
    start = lengde(tekstverdi) - lengde(suffiks)
    returner builtin.slice(tekstverdi, start, lengde(tekstverdi)) == suffiks
slutt

funksjon web_kall_namn(node)
    hvis node == null eller node["type"] != "Kall" eller lengde(node["barn"]) == 0
        returner ""
    slutt
    returner felt_kjede_tekst(node["barn"][0])
slutt

funksjon er_web_kall(node, namn)
    target = web_kall_namn(node)
    hvis target == ""
        returner usann
    slutt
    hvis target == namn
        returner sann
    slutt
    hvis tekst_ender_med(target, "." + namn)
        returner sann
    slutt
    returner usann
slutt

// Rekursiv skann for request_query/request_json_field/response_error-kall.
// Går inn i nøsta blokker (hvis/mens/for/prøv) slik at metadata frå kall inne
// i greiner også vert fanga for OpenAPI. Akkumulatorlistene vert muterte.
funksjon skann_rute_metadata(stmts, qp, bf, er)
    la sk = 0
    mens sk < lengde(stmts)
        la scan_stmt = stmts[sk]
        la scan_kall = scan_stmt
        hvis scan_stmt["type"] == "La" og lengde(scan_stmt["barn"]) > 0
            scan_kall = scan_stmt["barn"][0]
        ellers hvis scan_stmt["type"] == "Returner" og lengde(scan_stmt["barn"]) > 0
            scan_kall = scan_stmt["barn"][0]
        slutt
        la scan_nm = web_kall_namn(scan_kall)
        hvis scan_nm != "" og lengde(scan_kall["barn"]) > 1 og lengde(scan_kall["barn"][1]["barn"]) > 0
            scan_arg = scan_kall["barn"][1]["barn"]
            hvis tekst_ender_med(scan_nm, ".request_query_int") eller tekst_ender_med(scan_nm, ".request_query_param") eller tekst_ender_med(scan_nm, ".request_query_required") eller tekst_ender_med(scan_nm, ".request_query_float")
                hvis lengde(scan_arg) >= 2 og scan_arg[1]["type"] == "Tekst"
                    legg_til(qp, scan_arg[1]["verdi"])
                slutt
            slutt
            hvis tekst_ender_med(scan_nm, ".request_json_field") eller tekst_ender_med(scan_nm, ".request_json_field_or") eller tekst_ender_med(scan_nm, ".request_json_field_int") eller tekst_ender_med(scan_nm, ".request_json_field_bool") eller tekst_ender_med(scan_nm, ".request_json_field_float")
                hvis lengde(scan_arg) >= 2 og scan_arg[1]["type"] == "Tekst"
                    legg_til(bf, scan_arg[1]["verdi"])
                slutt
            slutt
            hvis tekst_ender_med(scan_nm, ".response_error")
                hvis lengde(scan_arg) >= 2
                    la err_entry = {}
                    err_entry["status"] = scan_arg[0]["verdi"]
                    hvis scan_arg[1]["type"] == "Tekst"
                        err_entry["message"] = scan_arg[1]["verdi"]
                    ellers
                        err_entry["message"] = "error"
                    slutt
                    legg_til(er, err_entry)
                slutt
            slutt
        slutt
        // Rekurser inn i nøsta blokker (hvis-then/else, mens, for, prøv/fang …).
        hvis har_nokkel(scan_stmt, "barn")
            la bi = 0
            mens bi < lengde(scan_stmt["barn"])
                la kid = scan_stmt["barn"][bi]
                hvis har_nokkel(kid, "type") og kid["type"] == "Blokk"
                    skann_rute_metadata(kid["barn"], qp, bf, er)
                slutt
                bi = bi + 1
            slutt
        slutt
        sk = sk + 1
    slutt
slutt

funksjon samla_web_annotasjonar(ast_program, modul_namn)
    handlers = []
    providers = []
    guard_providers = []
    request_middlewares = []
    response_middlewares = []
    error_middlewares = []
    startup_hooks = []
    shutdown_hooks = []

    i = 0
    mens i < lengde(ast_program["barn"])
        fn = ast_program["barn"][i]
        hvis fn["type"] != "Funksjon" eller lengde(fn["barn"]) < 3
            i = i + 1
            fortsett
        slutt

        blokk = fn["barn"][2]
        statements = blokk["barn"]
        specs = []
        route_prefix = ""
        route_deps = []
        route_guards = []
        route_provided = []
        route_guard = usann
        // 2.10(b): OpenAPI-markørar samla i prologen.
        route_tags = []
        route_beskriving = ""
        route_forelda = usann
        route_skjul = usann
        route_responser = []

        j = 0
        mens j < lengde(statements)
            stmt = statements[j]
            hvis stmt["type"] != "Kall"
                bryt
            slutt

            target_namn = web_kall_namn(stmt)
            hvis target_namn == ""
                bryt
            slutt

            har_args = lengde(stmt["barn"]) > 1 og lengde(stmt["barn"][1]["barn"]) > 0

            hvis tekst_ender_med(target_namn, ".request_middleware") og ikkje har_args
                legg_til(request_middlewares, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".response_middleware") og ikkje har_args
                legg_til(response_middlewares, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".error_middleware") og ikkje har_args
                legg_til(error_middlewares, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".startup_hook") og ikkje har_args
                legg_til(startup_hooks, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".shutdown_hook") og ikkje har_args
                legg_til(shutdown_hooks, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            // web.guard() er PARAMETERLAUS. Sjekken låg tidlegare NEDANFOR
            // «hvis ikkje har_args → bryt», altså i argument-seksjonen, og var
            // difor DAUD KODE: guard-provideren vart aldri registrert. Resultatet
            // var at use_guard("namn") sette kravet på ruta medan provideren
            // mangla — API-et kompilerte og såg vernande ut utan å verne noko.
            hvis tekst_ender_med(target_namn, ".guard") og ikkje har_args
                route_guard = sann
                j = j + 1
                fortsett
            slutt
            // 2.10(b): parameterlause OpenAPI-markørar.
            hvis tekst_ender_med(target_namn, ".forelda") og ikkje har_args
                route_forelda = sann
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".skjul") og ikkje har_args
                route_skjul = sann
                j = j + 1
                fortsett
            slutt

            hvis ikkje har_args
                bryt
            slutt

            første_arg = stmt["barn"][1]["barn"][0]
            hvis første_arg["type"] != "Tekst"
                bryt
            slutt

            hvis tekst_ender_med(target_namn, ".route")
                legg_til(specs, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt
            // 2.10(b): OpenAPI-markørar. web.tags("a","b"), web.beskriving("..."),
            // web.respons("404","..."). Alle argument er allereie validerte som
            // Tekst ovanfor (første_arg). Fleire tag/respons-argument vert samla.
            hvis tekst_ender_med(target_namn, ".tags")
                la ta = stmt["barn"][1]["barn"]
                la ti = 0
                mens ti < lengde(ta)
                    hvis ta[ti]["type"] == "Tekst"
                        legg_til(route_tags, ta[ti]["verdi"])
                    slutt
                    ti = ti + 1
                slutt
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".beskriving")
                route_beskriving = første_arg["verdi"]
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".respons")
                la ra = stmt["barn"][1]["barn"]
                la r_entry = {}
                r_entry["status"] = ra[0]["verdi"]
                hvis lengde(ra) >= 2 og ra[1]["type"] == "Tekst"
                    r_entry["description"] = ra[1]["verdi"]
                ellers
                    r_entry["description"] = ""
                slutt
                legg_til(route_responser, r_entry)
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".router") eller tekst_ender_med(target_namn, ".subrouter")
                hvis route_prefix == ""
                    route_prefix = første_arg["verdi"]
                slutt
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".use_dependency")
                legg_til(route_deps, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".use_guard")
                legg_til(route_guards, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".dependency")
                legg_til(route_provided, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt

            bryt
        slutt

        hvis route_guard
            legg_til(guard_providers, fn["verdi"] + "|SEP|" + modul_namn + "." + fn["verdi"])
            slutt

        // Metadata-skannen (rekursiv, inkl. hvis/mens-greiner) er lik for alle
        // rutene til funksjonen → rekn ut éin gong før spec-løkka.
        route_query_params = []
        route_body_fields = []
        route_error_responses = []
        skann_rute_metadata(statements, route_query_params, route_body_fields, route_error_responses)

        route_response_type = "tekst"
        hvis lengde(fn["barn"]) > 1 og fn["barn"][1]["type"] == "Returtype" og fn["barn"][1]["verdi"] != "tom"
            route_response_type = fn["barn"][1]["verdi"]
        slutt

        // 2.10(a): fleire web.route()-kall per handler → éi route-oppføring kvar.
        si = 0
        mens si < lengde(specs)
            spec = specs[si]
            combined_spec = web_kombiner_prefiks(route_prefix, spec)
            spec_delar = web_split_spec(combined_spec)
            route = {}
            route["function"] = modul_namn + "." + fn["verdi"]
            route["spec"] = combined_spec
            route["method"] = spec_delar[0]
            route["path"] = spec_delar[1]
            route["summary"] = fn["verdi"]
            route["operation_id"] = fn["verdi"]
            route["path_params"] = []
            route["query_params"] = route_query_params
            route["body_fields"] = route_body_fields
            route["error_responses"] = route_error_responses
            route["deps"] = route_deps
            route["guards"] = route_guards
            // 2.10(b): OpenAPI-markørar
            route["tags"] = route_tags
            route["description"] = route_beskriving
            route["deprecated"] = route_forelda
            route["hidden"] = route_skjul
            route["extra_responses"] = route_responser
            route["request_example"] = {}
            route["request_example"]["method"] = "get"
            route["request_example"]["path"] = combined_spec
            route["response_type"] = route_response_type
            route["response_example"] = web_type_til_eksempel(route["response_type"])
            route["response_schema"] = web_type_til_schema(route["response_type"])
            route["responses"] = {}
            route["responses"]["200"] = {}
            route["responses"]["200"]["description"] = "OK"
            route["responses"]["200"]["content"] = {}
            route["responses"]["200"]["content"]["application/json"] = {}
            route["responses"]["200"]["content"]["application/json"]["schema"] = {}
            route["responses"]["200"]["content"]["application/json"]["schema"] = route["response_schema"]
            route["responses"]["200"]["content"]["application/json"]["example"] = route["response_example"]
            legg_til(handlers, route)
            si = si + 1
        slutt

        l = 0
        mens l < lengde(route_provided)
            legg_til(providers, route_provided[l] + "|SEP|" + modul_namn + "." + fn["verdi"])
            l = l + 1
        slutt

        i = i + 1
    slutt

    resultat = {}
    resultat["route_handlers"] = handlers
    resultat["dependency_providers"] = providers
    resultat["guard_providers"] = guard_providers
    resultat["request_middlewares"] = request_middlewares
    resultat["response_middlewares"] = response_middlewares
    resultat["error_middlewares"] = error_middlewares
    resultat["startup_hooks"] = startup_hooks
    resultat["shutdown_hooks"] = shutdown_hooks
    returner resultat
slutt

funksjon route_felt_tekst(route, nøkkel)
    hvis har_nokkel(route, nøkkel)
        returner route[nøkkel]
    slutt
    returner ""
slutt

funksjon samanfatt_rute(route)
    summary = {}
    summary["function"] = route_felt_tekst(route, "function")
    summary["method"] = route_felt_tekst(route, "method")
    summary["path"] = route_felt_tekst(route, "path")
    summary["spec"] = route_felt_tekst(route, "spec")
    summary["summary"] = route_felt_tekst(route, "summary")
    summary["operation_id"] = route_felt_tekst(route, "operation_id")
    returner summary
slutt

// Samlar alle Ident-namn som blir referert i eit AST-undertre. Brukt til å
// finne frie variablar ein lambda må fange frå den omsluttande ramma.
funksjon samle_ident_namn(node, ut)
    hvis node == null
        returner 0
    slutt
    hvis node["type"] == "Ident"
        ut[node["verdi"]] = sann
    slutt
    hvis har_nokkel(node, "barn")
        la barn = node["barn"]
        la i = 0
        mens i < lengde(barn)
            samle_ident_namn(barn[i], ut)
            i = i + 1
        slutt
    slutt
    returner 0
slutt

funksjon emit_lambda_hjelpefunksjon(komp, lambda_node, helper_namn)
    // Lambdaen har sitt eige lokale namnrom. Ta vare på funksjonstilstanden
    // medan hjelpekoden blir generert, elles kan eit parameternamn som òg er
    // modulglobalt feilaktig bli skrive med STORE_GLOBAL.
    la førre_lokale = komp["current_locals"]
    la førre_init = komp["in_module_init"]
    la førre_source_lines = komp["current_source_lines"]
    la førre_source_columns = komp["current_source_columns"]
    komp["current_locals"] = {}
    komp["current_function"] = "__module_init__"
    komp["in_module_init"] = usann
    komp["source_map_active"] = sann
    hvis miljo_hent("NORSCODE_COMPILE_SOURCE_MAP") == "0"
        komp["source_map_active"] = usann
    slutt
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    param_node = lambda_node["barn"][0]
    blokk_indeks = 1

    hvis lengde(lambda_node["barn"]) > 1 og lambda_node["barn"][1]["type"] == "Returtype"
        blokk_indeks = 2
    slutt

    blokk = lambda_node["barn"][blokk_indeks]

    params = []
    la param_sett = {}
    i = 0
    mens i < lengde(param_node["barn"])
        la param_namn = param_node["barn"][i]["verdi"]
        legg_til(params, param_namn)
        param_sett[param_namn] = sann
        la lokale = komp["current_locals"]
        lokale[param_namn] = sann
        i = i + 1
    slutt

    // Frie variablar: namn i den omsluttande ramma (førre_lokale) som blir
    // referert i lambda-kroppen og ikkje er parametrar. Desse blir fanga
    // by-value i BUILD_LAMBDA sin capture-liste.
    la body_idents = {}
    samle_ident_namn(blokk, body_idents)
    la captures = []
    la enclosing_namn = nøkler(førre_lokale)
    la ci = 0
    mens ci < lengde(enclosing_namn)
        la kandidat = enclosing_namn[ci]
        hvis har_nokkel(body_idents, kandidat) og ikkje har_nokkel(param_sett, kandidat)
            legg_til(captures, kandidat)
            // Fanga namn er lokale i lambda-ramma (F04: metodekall på fanga self).
            la fanga_lokale = komp["current_locals"]
            fanga_lokale[kandidat] = sann
        slutt
        ci = ci + 1
    slutt

    kode = []
    emit_blokk(komp, blokk, kode)

    legg_til_implisitt_return(kode)

    modul = komp["modul"]
    fullt_namn = modul + "." + helper_namn

    params_json = "["
    j = 0
    mens j < lengde(params)
        hvis j > 0
            params_json = params_json + ","
        slutt
        params_json = params_json + json_escape_tekst(params[j])
        j = j + 1
    slutt
    params_json = params_json + "]"

    kode_json = "[" + builtin.join(kode, ",") + "]"

    fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(helper_namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(modul) + ","
    fn_json = fn_json + "\"params\":" + params_json + ","
    fn_json = fn_json + "\"is_async\":false,"
    fn_json = fn_json + "\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":" + kode_json
    fn_json = fn_json + "}"

    legg_til(komp["lambda_funk_par"], fullt_namn + "|SEP|" + fn_json)
    komp["current_locals"] = førre_lokale
    komp["in_module_init"] = førre_init
    komp["current_source_lines"] = førre_source_lines
    komp["current_source_columns"] = førre_source_columns
    returner captures
slutt

// ─── Kompilator-tilstand ──────────────────────────────────────────────────────

funksjon ny_komp()
    komp = {}
    komp["teller"] = 0         // etikett-teller
    komp["modul"] = "__main__" // gjeldande modul-namn
    komp["funk_kart"] = {}     // name → params (for CALL-resolving)
    komp["funk_defaults"] = {} // name → liste med standard-uttrykk (eller null) per parameter
    komp["enum_kart"] = {}     // enum-namn → enum-info {"variantar": {variant → indeks}, "namn": [...]}
    komp["modul_enum_kart"] = {} // importert modulnamn → {enum-namn → enum-info}
    komp["funk_vararg"] = {}   // name → tal faste parametrar før vararg-parameteren (siste ...p)
    komp["grensesnitt_kart"] = {} // grensesnitt-namn → liste med påkravde metodenamn
    komp["struktur_impl"] = []    // liste med [struktur-namn, grensesnitt-namn] for validering
    // R2/F20: strukturar i denne modulen (namn → Struktur-node) og i importerte
    // modular (modulnamn → {namn → Struktur-node}). Ukvalifiserte importerte
    // strukturnamn går via importert_struktur_kart (namn → modul eller __AMBIGUOUS__).
    komp["struktur_kart"] = {}
    komp["modul_struktur_kart"] = {}
    komp["importert_struktur_kart"] = {}
    komp["modul_funk_kart"] = {}  // importert modulnamn → {funksjonsnamn → sann}
    // R2/F21: grensesnitt i importerte modular (modul → {namn → sann}) og
    // ukvalifiserte importerte grensesnittnamn (namn → modul / __AMBIGUOUS__).
    komp["modul_grensesnitt_kart"] = {}
    komp["importert_grensesnitt_kart"] = {}
    // R2/F14: modulglobalar i importerte modular (modul → {namn → "la"/"konst"}).
    komp["modul_global_kart"] = {}
    komp["import_alias"] = {}  // alias → fullt modulnamn
    komp["imported_funk_kart"] = {} // unqualified importert funksjon -> fullt namn
    komp["importert_modul_cache"] = {} // modulnamn -> sann
    komp["lambda_funk_par"] = []
    komp["lambda_teller"] = 0
    komp["loop_start"] = []    // stack: start-etiketter for løkker (continue)
    komp["loop_slutt"] = []    // stack: slutt-etiketter for løkker (break)
    komp["prov_stakk"] = []    // stack: opne prøv-blokker (F03, sjå emit_lykkjestyring)
    komp["defer_blocks"] = []
    // Modulglobale namn er eksplisitte i NCB. Dette hindrar at toppnivå-`la`
    // blir kasta vekk og at native backend må gjette globale namn frå prefiks.
    komp["global_kart"] = {}
    komp["global_namn"] = []
    komp["current_locals"] = {}
    komp["in_module_init"] = usann
    komp["source_map_active"] = sann
    hvis miljo_hent("NORSCODE_COMPILE_SOURCE_MAP") == "0"
        komp["source_map_active"] = usann
    slutt
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    returner komp
slutt

// Samlar standard-uttrykka (eller null) for kvar parameter i ein Parametere-node.
funksjon _samle_standardar(param_node) {
    la ut = []
    hvis param_node == null { returner ut }
    la i: heiltall = 0
    mens i < lengde(param_node["barn"]) {
        la p = param_node["barn"][i]
        la std = null
        hvis har_nokkel(p, "barn") {
            la c: heiltall = 0
            mens c < lengde(p["barn"]) {
                hvis p["barn"][c]["type"] == "Standard" { std = p["barn"][c]["barn"][0] }
                c = c + 1
            }
        }
        legg_til(ut, std)
        i = i + 1
    }
    returner ut
}

// Liste-literal med valfrie spread-element (...x). Utan spread er BUILD_LIST den
// raske, uendra vegen. Med spread byggjer vi lista inkrementelt: append kvart
// normale element, og loop-append kvart element frå spread-kjeldene.
funksjon emit_liste(komp, node, kode) -> boolsk {
    la har_spread = usann
    la si: heiltall = 0
    mens si < lengde(node["barn"]) {
        hvis node["barn"][si]["type"] == "Spread" { har_spread = sann }
        si = si + 1
    }
    hvis ikkje har_spread {
        la i: heiltall = 0
        mens i < lengde(node["barn"]) {
            emit_uttrykk(komp, node["barn"][i], kode)
            i = i + 1
        }
        legg_til(kode, json_instruksjon_med_int("BUILD_LIST", lengde(node["barn"])))
        returner sann
    }
    la sn = tekst_fra_heltall(komp["teller"])
    komp["teller"] = komp["teller"] + 1
    la res_var = "__spread_res_" + sn + "__"
    legg_til(kode, json_instruksjon_med_int("BUILD_LIST", 0))
    emit_store_namn(komp, kode, res_var, sann)
    la i: heiltall = 0
    mens i < lengde(node["barn"]) {
        la barn = node["barn"][i]
        hvis barn["type"] == "Spread" {
            la ln = tekst_fra_heltall(komp["teller"])
            komp["teller"] = komp["teller"] + 1
            la src_var = "__spread_src_" + ln + "__"
            la idx_var = "__spread_idx_" + ln + "__"
            la lbl_s = "__spread_start_" + ln + "__"
            la lbl_e = "__spread_end_" + ln + "__"
            emit_uttrykk(komp, barn["barn"][0], kode)
            emit_store_namn(komp, kode, src_var, sann)
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
            emit_store_namn(komp, kode, idx_var, sann)
            legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_s))
            emit_load_namn(komp, kode, idx_var)
            emit_load_namn(komp, kode, src_var)
            legg_til(kode, json_kall("builtin.lengde", 1))
            legg_til(kode, json_instruksjon_uten_arg("COMPARE_LT"))
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", lbl_e))
            emit_load_namn(komp, kode, res_var)
            emit_load_namn(komp, kode, src_var)
            emit_load_namn(komp, kode, idx_var)
            legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
            legg_til(kode, json_kall("builtin.legg_til", 2))
            legg_til(kode, json_instruksjon_uten_arg("POP"))
            emit_load_namn(komp, kode, idx_var)
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
            legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
            emit_store_namn(komp, kode, idx_var, usann)
            legg_til(kode, json_instruksjon_med_tekst("JUMP", lbl_s))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_e))
        } ellers {
            emit_load_namn(komp, kode, res_var)
            emit_uttrykk(komp, barn, kode)
            legg_til(kode, json_kall("builtin.legg_til", 2))
            legg_til(kode, json_instruksjon_uten_arg("POP"))
        }
        i = i + 1
    }
    emit_load_namn(komp, kode, res_var)
    returner sann
}

// Enum-info for ein Enum-AST-node: {"variantar": {variant → indeks},
// "namn": [variantnamn i deklarasjonsrekkjefølgje]}. Lista finst fordi
// kompilatoren ikkje skal vere avhengig av nøkkeliterasjon over ordbøker.
funksjon lag_enum_info(enum_node) {
    la variantar = {}
    la namn = []
    la vi: heiltall = 0
    mens vi < lengde(enum_node["barn"]) {
        la vn = enum_node["barn"][vi]["verdi"]
        variantar[vn] = vi
        legg_til(namn, vn)
        vi = vi + 1
    }
    returner {"variantar": variantar, "namn": namn}
}

// Enum-oppslag ved kompilering. Gjev enum-info for eit uttrykk som namngjev
// ein enum, elles null:
//   Farge         — enum i same modul (ikkje skugga av ein lokal variabel)
//   fg.Farge      — enum i importert modul (bruk ggmod.fargar som fg)
funksjon enum_info_for(komp, obj) {
    hvis obj["type"] == "Ident" {
        la namn = obj["verdi"]
        hvis har_nokkel(komp["enum_kart"], namn) og ikkje har_nokkel(komp["current_locals"], namn) {
            returner komp["enum_kart"][namn]
        }
        returner null
    }
    hvis obj["type"] == "Felt" og obj["barn"][0]["type"] == "Ident" {
        la alias = obj["barn"][0]["verdi"]
        hvis har_nokkel(komp["import_alias"], alias) og ikkje har_nokkel(komp["current_locals"], alias) {
            la modul_namn = komp["import_alias"][alias]
            hvis har_nokkel(komp["modul_enum_kart"], modul_namn) {
                la mk = komp["modul_enum_kart"][modul_namn]
                hvis har_nokkel(mk, obj["verdi"]) { returner mk[obj["verdi"]] }
            }
        }
    }
    returner null
}

funksjon enum_namn_tekst(obj) -> tekst {
    hvis obj["type"] == "Felt" { returner tekst(obj["barn"][0]["verdi"]) + "." + tekst(obj["verdi"]) }
    returner tekst(obj["verdi"])
}

funksjon enum_feil(node, melding: tekst) {
    kast "Enumfeil " + tekst(node["linje"]) + ":" + tekst(node["kolonne"]) + " - " + melding
}

// Enum.metode(args): verdiar() → [0, 1, …], namn(v) → variantnamnet,
// fraa_tekst(t) → indeksen (ingenting om t ikkje er ein variant). Gjev usann når
// kallet ikkje er på ein enum, slik at vanleg kall-kompilering held fram.
funksjon emit_enum_kall(komp, node, kode) -> boolsk {
    la fn_ident = node["barn"][0]
    la info = enum_info_for(komp, fn_ident["barn"][0])
    hvis info == null { returner usann }
    la metode = fn_ident["verdi"]
    la args = node["barn"][1]["barn"]
    la namn = info["namn"]
    la enum_namn = enum_namn_tekst(fn_ident["barn"][0])
    hvis metode == "verdiar" eller metode == "verdier" {
        hvis lengde(args) != 0 { enum_feil(node, enum_namn + ".verdiar() tek ingen argument") }
        la i: heiltall = 0
        mens i < lengde(namn) {
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", i))
            i = i + 1
        }
        legg_til(kode, json_instruksjon_med_int("BUILD_LIST", lengde(namn)))
        returner sann
    }
    hvis metode == "namn" eller metode == "navn" {
        hvis lengde(args) != 1 { enum_feil(node, enum_namn + ".namn(v) tek eitt argument") }
        la k: heiltall = 0
        mens k < lengde(namn) {
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", namn[k]))
            k = k + 1
        }
        legg_til(kode, json_instruksjon_med_int("BUILD_LIST", lengde(namn)))
        emit_uttrykk(komp, args[0], kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    }
    hvis metode == "fraa_tekst" eller metode == "frå_tekst" eller metode == "fra_tekst" {
        hvis lengde(args) != 1 { enum_feil(node, enum_namn + ".fraa_tekst(t) tek eitt argument") }
        la j: heiltall = 0
        mens j < lengde(namn) {
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", namn[j]))
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", j))
            j = j + 1
        }
        legg_til(kode, json_instruksjon_med_int("BUILD_MAP", lengde(namn)))
        emit_uttrykk(komp, args[0], kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    }
    enum_feil(node, "ukjend enum-metode " + enum_namn + "." + metode + "() (kjende: verdiar, namn, fraa_tekst)")
    returner usann
}

// Feltoppslag obj.felt. Spesialfall: EnumNamn.Variant → PUSH_CONST med
// variant-indeksen (kompileringstid-konstant), og ukjend variant er
// kompileringsfeil. EnumNamn.Variant.namn → variantnamnet som tekst.
// Elles obj["felt"] via INDEX_GET.
funksjon emit_felt(komp, node, kode) -> boolsk {
    la obj = node["barn"][0]
    la info = enum_info_for(komp, obj)
    hvis info != null {
        la variantar = info["variantar"]
        hvis har_nokkel(variantar, node["verdi"]) {
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", variantar[node["verdi"]]))
            returner sann
        }
        enum_feil(node, "ukjend variant " + enum_namn_tekst(obj) + "." + tekst(node["verdi"]))
    }
    hvis obj["type"] == "Felt" og (node["verdi"] == "namn" eller node["verdi"] == "navn") {
        la ei = enum_info_for(komp, obj["barn"][0])
        hvis ei != null og har_nokkel(ei["variantar"], obj["verdi"]) {
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", obj["verdi"]))
            returner sann
        }
    }
    // R2/F14: alias.NAMN der NAMN er ein modulglobal i den importerte modulen
    // → LOAD_GLOBAL NAMN modul (global i ein annan modul).
    la mg = modulglobal_mål(komp, node)
    hvis mg != "" {
        legg_til(kode, "[\"LOAD_GLOBAL\"," + json_escape_tekst(node["verdi"]) + "," + json_escape_tekst(mg) + "]")
        returner sann
    }
    emit_uttrykk(komp, obj, kode)
    legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
    legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
    returner sann
}

// R2/F14: er Felt-noden alias.NAMN der alias er eit importalias (ikkje skugga av
// ein lokal) og NAMN ein modulglobal i den modulen? Returnerer modulnamnet,
// elles "".
funksjon modulglobal_mål(komp, node) -> tekst {
    la obj = node["barn"][0]
    hvis obj["type"] != "Ident" { returner "" }
    la alias = tekst(obj["verdi"])
    hvis har_nokkel(komp["current_locals"], alias) eller ikkje har_nokkel(komp["import_alias"], alias) { returner "" }
    la m = komp["import_alias"][alias]
    hvis ikkje har_nokkel(komp["modul_global_kart"], m) { returner "" }
    hvis ikkje har_nokkel(komp["modul_global_kart"][m], node["verdi"]) { returner "" }
    returner m
}

// R2/F14/F15: STORE_GLOBAL til alias.NAMN (verdien ligg på stacken). Ein
// konst i den andre modulen kan ikkje tilordnast.
funksjon emit_modulglobal_lagring(komp, node, m: tekst, kode) -> heiltall {
    hvis komp["modul_global_kart"][m][node["verdi"]] == "konst" {
        kast "Konstfeil linje " + tekst(node["linje"]) + ": kan ikkje tilordne til konstanten " + m + "." + tekst(node["verdi"])
    }
    legg_til(kode, "[\"STORE_GLOBAL\"," + json_escape_tekst(node["verdi"]) + "," + json_escape_tekst(m) + "]")
    returner 0
}

// Uttømmande match over enum: når kvart case-mønster er EnumNamn.Variant for
// same enum og det ikkje finst `ellers`/`case _`, må alle variantane vere dekte.
// Elles kompileringsfeil. Andre match-former blir ikkje sjekka.
funksjon sjekk_enum_match_dekning(komp, node) -> heiltall {
    la info = null
    la enum_tekst = ""
    la dekt = {}
    la ci: heiltall = 1
    mens ci < lengde(node["barn"]) {
        la case_node = node["barn"][ci]
        hvis case_node["type"] == "MatchElse" eller case_node["verdi"] == "wildcard" { returner 0 }
        la mønster = case_node["barn"][0]
        hvis mønster["type"] != "Felt" { returner 0 }
        la mi = enum_info_for(komp, mønster["barn"][0])
        hvis mi == null { returner 0 }
        la mt = enum_namn_tekst(mønster["barn"][0])
        hvis info == null {
            info = mi
            enum_tekst = mt
        } ellers hvis mt != enum_tekst {
            returner 0
        }
        dekt[mønster["verdi"]] = sann
        ci = ci + 1
    }
    hvis info == null { returner 0 }
    la manglar = ""
    la namn = info["namn"]
    la ni: heiltall = 0
    mens ni < lengde(namn) {
        hvis ikkje har_nokkel(dekt, namn[ni]) {
            hvis manglar != "" { manglar = manglar + ", " }
            manglar = manglar + namn[ni]
        }
        ni = ni + 1
    }
    hvis manglar != "" {
        enum_feil(node, "match over " + enum_tekst + " er ikkje uttømmande, manglar " + manglar + " (legg til case eller ellers)")
    }
    returner 0
}

funksjon emit_load_namn(komp, kode, namn: tekst) -> heiltall {
    // R2/F14: i modul-init blir toppnivå-`la` lagra med STORE_GLOBAL, så seinare
    // toppnivåkode (`la x = 2` så `skriv(x)`) må lese han med LOAD_GLOBAL òg.
    hvis komp["in_module_init"] og har_nokkel(komp["global_kart"], namn) {
        legg_til(kode, json_instruksjon_med_tekst("LOAD_GLOBAL", namn))
        returner 0
    }
    hvis ikkje komp["in_module_init"] og har_nokkel(komp["global_kart"], namn) og ikkje har_nokkel(komp["current_locals"], namn) {
        legg_til(kode, json_instruksjon_med_tekst("LOAD_GLOBAL", namn))
    } ellers {
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", namn))
    }
    returner 0
}

funksjon emit_store_namn(komp, kode, namn: tekst, deklarasjon: boolsk) -> heiltall {
    hvis komp["in_module_init"] {
        legg_til(kode, json_instruksjon_med_tekst("STORE_GLOBAL", namn))
        returner 0
    }
    hvis deklarasjon {
        la lokale = komp["current_locals"]
        lokale[namn] = sann
    }
    hvis har_nokkel(komp["global_kart"], namn) og ikkje har_nokkel(komp["current_locals"], namn) {
        legg_til(kode, json_instruksjon_med_tekst("STORE_GLOBAL", namn))
    } ellers {
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", namn))
    }
    returner 0
}

funksjon finn_modul_filsti(modul_namn)
    la basis = builtin.replace(modul_namn, ".", "/")

    // Prioriter .nors, men støtt eldre .no for bakoverkompatibilitet.
    la nors_filsti = basis + ".nors"
    la no_filsti = basis + ".no"
    hvis fil_finnes(nors_filsti) {
        returner nors_filsti
    }
    hvis fil_finnes(no_filsti) {
        returner no_filsti
    }
    // Fallback for ikkje-materialisert modulsti: bruk .nors som standard.
    returner nors_filsti
slutt

// Ein sti utanfor disk-scopet gjer at fil_finnes kastar (Sikkerheitsfeil). For
// modulsøket tyder det berre at modulen ikkje ligg der: prøv neste base i staden
// for å avbryte kompileringa (t.d. PWD="/" gav «//tests/...» i CI).
funksjon fil_finnes_i_scope(sti)
    la finst = usann
    prøv { finst = fil_finnes(sti) }
    fang (e) { finst = usann }
    returner finst
slutt

funksjon finn_modul_i_base(base, modul_namn)
    hvis base == ""
        returner ""
    slutt
    la basis = base + "/" + builtin.replace(modul_namn, ".", "/")
    la nors_filsti = basis + ".nors"
    la no_filsti = basis + ".no"
    hvis fil_finnes_i_scope(nors_filsti)
        returner nors_filsti
    slutt
    hvis fil_finnes_i_scope(no_filsti)
        returner no_filsti
    slutt
    returner ""
slutt

// ─── F42: felles moduloppløysing ─────────────────────────────────────────────
// Same resolver for kompilatoren (registrer_importerte_funksjonar), bundle-
// vegen i nc_main (run/test/serve) og `nc check`. Søkjerekkjefølgje for
// `bruk a.b.c` importert frå fila F:
//   1. std./selfhost./bootstrap. → NORSCODE_ROOT (systemmodular)
//   2. søskenmodul: mappa til F (a/b/c.no ved sida av importøren)
//   3. prosjektrota: næraste mappe over F med norcode.toml/innstillingar.toml
//   4. NORSCODE_IMPORT_BASE og PWD (eldre køyrekontekst)
//   5. NORSCODE_PATH: fleire røter, «:»-skilde eller JSON-liste
//   6. NORSCODE_ROOT
// I kvar rot vinn .nors over .no. Tom tekst når modulen ikkje finst.

funksjon modul_mappe_av(sti)
    hvis sti == "" { returner "" }
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) <= 1 { returner "." }
    fjern(delar, lengde(delar) - 1)
    la ut = builtin.join(delar, "/")
    hvis ut == "" { returner "/" }
    returner ut
slutt

// Mappa over `mappe`; tom tekst ved filsystemrota. Relative stiar blir
// verande relative (".." på slutten) så besøkt-nøklane i bundlen held seg like.
funksjon modul_foreldremappe(mappe)
    hvis mappe == "/" eller mappe == "" { returner "" }
    hvis mappe == "." { returner ".." }
    hvis mappe == ".." eller builtin.ends_with(mappe, "/..") { returner mappe + "/.." }
    la forelder = modul_mappe_av(mappe)
    returner forelder
slutt

funksjon modul_er_prosjektrot(mappe)
    hvis fil_finnes_i_scope(mappe + "/norcode.toml") { returner sann }
    hvis fil_finnes_i_scope(mappe + "/innstillingar.toml") { returner sann }
    returner usann
slutt

// Næraste mappe frå `mappe` og oppover som har norcode.toml eller
// innstillingar.toml. Tom tekst når ingen finst innan 16 nivå.
funksjon finn_prosjektrot(mappe)
    la gjeldande = mappe
    hvis gjeldande == "" { gjeldande = "." }
    la nivå = 0
    mens gjeldande != "" og nivå < 16
        hvis modul_er_prosjektrot(gjeldande) { returner gjeldande }
        gjeldande = modul_foreldremappe(gjeldande)
        nivå = nivå + 1
    slutt
    returner ""
slutt

// NORSCODE_PATH: «a:b:c» eller JSON-lista «["a","b"]» (std.sys.path-forma).
funksjon norscode_path_røter()
    la råverdi = builtin.trim(miljo_hent("NORSCODE_PATH"))
    la røter = []
    hvis råverdi == "" { returner røter }
    la delar = []
    hvis builtin.starts_with(råverdi, "[")
        la indre = builtin.slice(råverdi, 1, lengde(råverdi) - 1)
        delar = builtin.split(indre, ",")
    ellers
        delar = builtin.split(råverdi, ":")
    slutt
    la i = 0
    mens i < lengde(delar)
        la del = builtin.trim(builtin.replace(delar[i], "\"", ""))
        hvis del != "" { legg_til(røter, del) }
        i = i + 1
    slutt
    returner røter
slutt

funksjon er_systemmodul(modul_namn)
    returner builtin.starts_with(modul_namn, "std.") eller builtin.starts_with(modul_namn, "selfhost.") eller builtin.starts_with(modul_namn, "bootstrap.")
slutt

funksjon finn_modulfil(modul_namn, importør_fil)
    la root = miljo_hent("NORSCODE_ROOT")
    hvis er_systemmodul(modul_namn)
        la system_filsti = finn_modul_i_base(root, modul_namn)
        hvis system_filsti != "" { returner system_filsti }
    slutt
    la treff = ""
    la importør_mappe = ""
    hvis importør_fil != "" og importør_fil != null
        importør_mappe = modul_mappe_av(importør_fil)
        treff = finn_modul_i_base(importør_mappe, modul_namn)
        hvis treff != "" { returner treff }
        la prosjektrot = finn_prosjektrot(importør_mappe)
        hvis prosjektrot != ""
            treff = finn_modul_i_base(prosjektrot, modul_namn)
            hvis treff != "" { returner treff }
        slutt
    slutt
    treff = finn_modul_i_base(miljo_hent("NORSCODE_IMPORT_BASE"), modul_namn)
    hvis treff != "" { returner treff }
    la pwd = miljo_hent("PWD")
    treff = finn_modul_i_base(pwd, modul_namn)
    hvis treff != "" { returner treff }
    hvis pwd != ""
        la pwd_rot = finn_prosjektrot(pwd)
        hvis pwd_rot != ""
            treff = finn_modul_i_base(pwd_rot, modul_namn)
            hvis treff != "" { returner treff }
        slutt
    slutt
    la røter = norscode_path_røter()
    la ri = 0
    mens ri < lengde(røter)
        treff = finn_modul_i_base(røter[ri], modul_namn)
        hvis treff != "" { returner treff }
        ri = ri + 1
    slutt
    returner finn_modul_i_base(root, modul_namn)
slutt

// Kompilatoren sitt oppslag. Importøren er fila som blir kompilert no
// (NORSCODE_KJELDEFIL, sett av nc_main/nc check før kvar kompilering).
funksjon modul_til_filsti(modul_namn)
    la funne = finn_modulfil(modul_namn, miljo_hent("NORSCODE_KJELDEFIL"))
    hvis funne != "" { returner funne }
    // Ikkje funne: behald den gamle gjetta stien så feilmeldinga peikar ein stad.
    la root = miljo_hent("NORSCODE_ROOT")
    la import_base = miljo_hent("NORSCODE_IMPORT_BASE")
    la pwd = miljo_hent("PWD")
    la basis = builtin.replace(modul_namn, ".", "/")
    hvis er_systemmodul(modul_namn) { returner root + "/" + basis + ".nors" }
    hvis import_base != "" { returner import_base + "/" + basis + ".nors" }
    hvis pwd != "" { returner pwd + "/" + basis + ".nors" }
    returner basis + ".nors"
slutt

funksjon siste_moduldel(sti)
    delar = builtin.split(sti, ".")
    hvis lengde(delar) == 0
        returner sti
    slutt
    returner delar[lengde(delar) - 1]
slutt

funksjon ny_etikett(komp)
    n = komp["teller"]
    hvis n == null
        n = 0
        komp["teller"] = 0
    slutt
    komp["teller"] = n + 1
    returner "__L" + tekst_fra_heltall(n) + "__"
slutt

funksjon push_loop(komp, start, slutt)
    legg_til(komp["loop_start"], start)
    legg_til(komp["loop_slutt"], slutt)
slutt

funksjon pop_loop(komp)
    n = lengde(komp["loop_start"])
    hvis n > 0
        komp["loop_start"] = komp["loop_start"]
        komp["loop_slutt"] = komp["loop_slutt"]
        // Begge loopstakkane blir alltid poppa frå toppen. Bruk den smalare
        // operasjonen som er tilgjengeleg i committed VM-generasjonar òg.
        fjern_siste(komp["loop_start"])
        fjern_siste(komp["loop_slutt"])
    slutt
slutt

funksjon gjeldande_loop_start(komp)
    n = lengde(komp["loop_start"])
    hvis n == 0
        returner ""
    slutt
    returner komp["loop_start"][n - 1]
slutt

funksjon gjeldande_loop_slutt(komp)
    n = lengde(komp["loop_slutt"])
    hvis n == 0
        returner ""
    slutt
    returner komp["loop_slutt"][n - 1]
slutt

// ─── Operator-mapping ────────────────────────────────────────────────────────

funksjon binop_til_opcode(op)
    hvis op == "PLUS"    returner "BINARY_ADD"  slutt
    hvis op == "MINUS"   returner "BINARY_SUB"  slutt
    hvis op == "STAR"    returner "BINARY_MUL"  slutt
    hvis op == "MUL"     returner "BINARY_MUL"  slutt
    hvis op == "SLASH"   returner "BINARY_DIV"  slutt
    hvis op == "DIV"     returner "BINARY_DIV"  slutt
    hvis op == "PERCENT" returner "BINARY_MOD"  slutt
    hvis op == "EQ"      returner "COMPARE_EQ"  slutt
    hvis op == "NE"      returner "COMPARE_NE"  slutt
    hvis op == "GT"      returner "COMPARE_GT"  slutt
    hvis op == "LT"      returner "COMPARE_LT"  slutt
    hvis op == "GTE"     returner "COMPARE_GE"  slutt
    hvis op == "LTE"     returner "COMPARE_LE"  slutt
    // Logiske operatorar — behandla som short-circuit i emit_uttrykk
    hvis op == "AND"     returner "LOGICAL_AND" slutt
    hvis op == "OG"      returner "LOGICAL_AND" slutt
    hvis op == "OR"      returner "LOGICAL_OR"  slutt
    hvis op == "ELLER"   returner "LOGICAL_OR"  slutt
    // Bitwise
    hvis op == "BAND"    returner "BINARY_AND"  slutt
    hvis op == "BOR"     returner "BINARY_OR"   slutt
    hvis op == "BXOR"    returner "BINARY_XOR"  slutt
    hvis op == "LSHIFT"  returner "BINARY_LSHIFT" slutt
    hvis op == "RSHIFT"  returner "BINARY_RSHIFT" slutt
    returner "BINARY_ADD"  // fallback
slutt

funksjon unar_til_opcode(op)
    hvis op == "MINUS"  returner "UNARY_NEG"  slutt
    hvis op == "NOT"    returner "UNARY_NOT"  slutt
    hvis op == "IKKJE"  returner "UNARY_NOT"  slutt
    hvis op == "IKKE"   returner "UNARY_NOT"  slutt
    hvis op == "BNOT"   returner "UNARY_BNOT" slutt
    returner "UNARY_NEG"
slutt

funksjon aug_til_binop(aug_type)
    hvis aug_type == "PLUS_ASSIGN"    returner "BINARY_ADD" slutt
    hvis aug_type == "MINUS_ASSIGN"   returner "BINARY_SUB" slutt
    hvis aug_type == "STAR_ASSIGN"    returner "BINARY_MUL" slutt
    hvis aug_type == "SLASH_ASSIGN"   returner "BINARY_DIV" slutt
    hvis aug_type == "PERCENT_ASSIGN" returner "BINARY_MOD" slutt
    returner "BINARY_ADD"
slutt

// ─── Kompiler uttrykk ────────────────────────────────────────────────────────
// Appendar instruksjonar til `kode`-lista

// `a ?? b`: a om a ikkje er ingenting, elles b. b blir berre evaluert når a
// er ingenting (kortslutting). Same null-test som OptionalFelt (DUP + COMPARE_EQ).
funksjon emit_nullish(komp, node, kode) -> boolsk {
    la ferdig = ny_etikett(komp)
    emit_uttrykk(komp, node["barn"][0], kode)
    legg_til(kode, json_instruksjon_uten_arg("DUP"))
    legg_til(kode, "[\"PUSH_CONST\",null]")
    legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
    legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", ferdig))
    legg_til(kode, json_instruksjon_uten_arg("POP"))
    emit_uttrykk(komp, node["barn"][1], kode)
    legg_til(kode, json_instruksjon_med_tekst("LABEL", ferdig))
    returner sann
}

funksjon emit_listekomprehensjon(komp, node, kode) -> boolsk {
    la n = tekst_fra_heltall(komp["teller"])
    komp["teller"] = komp["teller"] + 1
    la res_var = "__comp_res_" + n + "__"
    la lst_var = "__comp_lst_" + n + "__"
    la idx_var = "__comp_idx_" + n + "__"
    la lbl_start = "__comp_start_" + n + "__"
    la lbl_cont = "__comp_cont_" + n + "__"
    la lbl_end = "__comp_end_" + n + "__"
    la loop_var = node["verdi"]
    la barn = node["barn"]

    legg_til(kode, json_instruksjon_med_int("BUILD_LIST", 0))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", res_var))
    emit_uttrykk(komp, barn[0], kode)
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", lst_var))
    legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_start))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", lst_var))
    legg_til(kode, json_kall("builtin.lengde", 1))
    legg_til(kode, json_instruksjon_uten_arg("COMPARE_LT"))
    legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", lbl_end))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", lst_var))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", idx_var))
    legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", loop_var))
    hvis lengde(barn) > 2 {
        emit_uttrykk(komp, barn[2], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", lbl_cont))
    }
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", res_var))
    emit_uttrykk(komp, barn[1], kode)
    legg_til(kode, json_kall("builtin.legg_til", 2))
    legg_til(kode, json_instruksjon_uten_arg("POP"))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_cont))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
    legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_tekst("JUMP", lbl_start))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_end))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", res_var))
    returner sann
}

funksjon emit_uttrykk(komp, node, kode)
    t = node["type"]

    hvis t == "Ident"
        emit_load_namn(komp, kode, node["verdi"])
        returner sann
    slutt

    hvis t == "Heltall"
        // Lexer/parser bevarer kjeldeforma som tekst. Konverter eksplisitt før
        // den reine heiltalsserialiseringen; elles blir til dømes "42" tolka
        // som ei ikkje-numerisk nullform i native AOT.
        la literal_heiltal = heltall_fra_tekst(node["verdi"])
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", literal_heiltal))
        returner sann
    slutt

    hvis t == "Desimal"
        legg_til(kode, json_instruksjon_med_desimal("PUSH_CONST", node["verdi"]))
        returner sann
    slutt

    hvis t == "Tekst"
        // Semantisk kontrakt: node["verdi"] == "__nclit__empty_text_v1".
        // Literalane er delte for den eldre stage0-materialiseraren.
        hvis node["verdi"] == "__nclit__empty_" + "text_v1"
            // Ikkje legg den ferdige JSON-instruksjonen inn som ein literal.
            // Eldre NCB-transport kan dekode ein slik tekst til ei faktisk
            // liste og sluttserialiseringa endar då som den ugyldige opkoden
            // [null]. Bygg instruksjonen gjennom den kanoniske JSON-skrivaren.
            la tom_tekst = builtin.slice("x", 0, 0)
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", tom_tekst))
        ellers
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        slutt
        returner sann
    slutt

    hvis t == "Bool"
        hvis node["verdi"] == "sann"
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", sann))
        ellers
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", usann))
        slutt
        returner sann
    slutt

    // Parseren representerer null/ingenting som ein eigen Null-node. Utan
    // denne grenen produserer uttrykket ingen operand, slik at til dømes
    // `verdi == null` køyrer COMPARE_EQ med berre venstre operand på stakken.
    hvis t == "Null"
        // Bygg instruksjonen dynamisk. Eldre bootstrap-transport kan tolke
        // den komplette JSON-litteralen som ei liste og seinare redusere han
        // til [null], som fjernar operandverdien før neste opcode.
        legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        returner sann
    slutt

    hvis t == "Binop"
        hvis node["verdi"] == "NULLISH"
            returner emit_nullish(komp, node, kode)
        slutt
        opcode = binop_til_opcode(node["verdi"])

        // Short-circuit AND
        hvis opcode == "LOGICAL_AND"
            etikett_false = ny_etikett(komp)
            etikett_ferdig = ny_etikett(komp)
            emit_uttrykk(komp, node["barn"][0], kode)
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", etikett_false))
            emit_uttrykk(komp, node["barn"][1], kode)
            legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_ferdig))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_false))
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", usann))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ferdig))
            returner sann
        slutt

        // Short-circuit OR
        hvis opcode == "LOGICAL_OR"
            etikett_true = ny_etikett(komp)
            etikett_ferdig = ny_etikett(komp)
            emit_uttrykk(komp, node["barn"][0], kode)
            legg_til(kode, "[\"JUMP_IF_FALSE\"," + json_escape_tekst(etikett_true) + "]")
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", sann))
            legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_ferdig))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_true))
            emit_uttrykk(komp, node["barn"][1], kode)
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ferdig))
            returner sann
        slutt

        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_uten_arg(opcode))
        returner sann
    slutt

    hvis t == "Unar"
        opcode = unar_til_opcode(node["verdi"])
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_uten_arg(opcode))
        returner sann
    slutt

    // Liste-literal må ligge før kall-grenen. Eldre stage0-kompilering kan
    // avgrense emit-funksjonen ved den lange kall-delen; denne tidlege grenen
    // sikrar at BUILD_LIST finst i den sjølvstendige kompilatorflata.
    hvis t == "Liste"
        returner emit_liste(komp, node, kode)
    slutt

    // Felt- og indeksoppslag må også ligge før kall-grenen. Den eldre
    // stage0-kompilatoren kan ellers miste grenene som står etter den lange
    // kall-emitteren, og generere lengde(fn["barn"]) utan objekt på stacken.
    hvis t == "Indeks"
        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    hvis t == "Felt"
        returner emit_felt(komp, node, kode)
    slutt

    // Optional chaining: o?.felt → er o ingenting, gjev ingenting; elles o["felt"].
    // Evaluerer o éin gong (DUP) og kortsluttar med ein null-samanlikning.
    hvis t == "OptionalFelt"
        la on = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        la opt_do = "__opt_do_" + on + "__"
        la opt_end = "__opt_end_" + on + "__"
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_uten_arg("DUP"))
        legg_til(kode, "[\"PUSH_CONST\",null]")
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", opt_do))
        legg_til(kode, json_instruksjon_med_tekst("JUMP", opt_end))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", opt_do))
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", opt_end))
        returner sann
    slutt

    hvis t == "Indeks"
        // Barn: [liste-uttrykk, indeks-uttrykk]
        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    hvis t == "Felt"
        // obj.felt lesast som obj["felt"] for ordbok/struktur-literals.
        returner emit_felt(komp, node, kode)
    slutt

    // Slice: [start:end] — kall builtin.slice(obj, start, end)
    hvis t == "Slice"
        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        emit_uttrykk(komp, node["barn"][2], kode)
        legg_til(kode, json_kall("builtin.slice", 3))
        returner sann
    slutt

    hvis t == "Await"
        hvis lengde(node["barn"]) > 0
            emit_uttrykk(komp, node["barn"][0], kode)
        ellers
            legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        slutt
        legg_til(kode, json_kall("builtin.await_value", 1))
        returner sann
    slutt

    hvis t == "Lambda"
        helper_namn = "__lambda_" + tekst_fra_heltall(komp["lambda_teller"])
        komp["lambda_teller"] = komp["lambda_teller"] + 1
        la lam_captures = emit_lambda_hjelpefunksjon(komp, node, helper_namn)
        legg_til(kode, "[\"BUILD_LAMBDA\"," + json_escape_tekst(komp["modul"] + "." + helper_namn) + "," + json_liste_tekst(lam_captures) + "]")
        returner sann
    slutt

    // IfUttrykk: hvis cond da then ellers else
    hvis t == "IfUttrykk"
        n = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        else_lbl = "__ifexpr_else_" + n + "__"
        end_lbl  = "__ifexpr_end_"  + n + "__"
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", else_lbl))
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", else_lbl))
        emit_uttrykk(komp, node["barn"][2], kode)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", end_lbl))
        returner sann
    slutt

    hvis t == "Felt"
        // Barn: [objekt-uttrykk]  verdi = feltnamn
        returner emit_felt(komp, node, kode)
    slutt

    hvis t == "Liste"
        returner emit_liste(komp, node, kode)
    slutt

    // ─── List comprehension: [expr for var i liste (hvis cond)] ────────────────
    hvis t == "ListeKomprehensjon"
        returner emit_listekomprehensjon(komp, node, kode)
    slutt

    hvis t == "Map"
        i = 0
        mens i < lengde(node["barn"])
            par = node["barn"][i]
            emit_uttrykk(komp, par["barn"][0], kode)  // nøkkel
            emit_uttrykk(komp, par["barn"][1], kode)  // verdi
            i = i + 1
        slutt
        legg_til(kode, json_instruksjon_med_int("BUILD_MAP", lengde(node["barn"])))
        returner sann
    slutt

    hvis t == "StructLiteral"
        i = 0
        mens i < lengde(node["barn"])
            par = node["barn"][i]
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", par["verdi"]))
            emit_uttrykk(komp, par["barn"][0], kode)
            i = i + 1
        slutt
        legg_til(kode, json_instruksjon_med_int("BUILD_MAP", lengde(node["barn"])))
        returner sann
    slutt

    // Kall-grenen må ligge sist blant dei kjende uttrykkstypane. Eldre stage0
    // kan avgrense funksjonen etter den djupt nøsta kall-dispatchen. Når alle
    // andre uttrykk ligg først, kan stage0 likevel byggje ein komplett Gen1.
    hvis t == "Kall"
        // Barn: [Ident(kallenavn) eller Felt(modul.fn), Argumenter[arg0, arg1, ...]]
        fn_ident = node["barn"][0]
        argumenter = node["barn"][1]
        arg_antal = lengde(argumenter["barn"])

        // Enum.verdiar() / Enum.namn(v) / Enum.fraa_tekst(t) blir løyst ved kompilering.
        hvis fn_ident["type"] == "Felt"
            hvis emit_enum_kall(komp, node, kode)
                returner sann
            slutt
        slutt

        // Metode-kall: mott.metode(args) der mott er ein verdi (lokal variabel,
        // feltkjede frå ein lokal, kall- eller indeksresultat …), ikkje ein
        // modulsti. Eksakt dispatch på __struktur__, sjå emit_metodekall (F04/F20).
        // Stacken må vere [mott, metodenamn, args…], so dette må skje FØR arg-løkka.
        hvis fn_ident["type"] == "Felt"
            hvis er_metode_mottakar(komp, fn_ident["barn"][0])
                returner emit_metodekall(komp, node, kode)
            slutt
        slutt

        // R2/F21: er_instans(v, Type) — Type er eit struktur- eller
        // grensesnittnamn (ev. alias.Type) som blir løyst ved kompilering til
        // det modulkvalifiserte namnet; VM-en samanliknar med __struktur__ og
        // grensesnittlista til konstruktøren.
        hvis fn_ident["type"] == "Ident" og fn_ident["verdi"] == "er_instans" og arg_antal == 2 og ikkje har_nokkel(komp["funk_kart"], "er_instans") og ikkje har_nokkel(komp["current_locals"], "er_instans")
            emit_uttrykk(komp, argumenter["barn"][0], kode)
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", løys_typenamn(komp, argumenter["barn"][1])))
            legg_til(kode, json_kall("builtin.er_instans", 2))
            returner sann
        slutt

        // Varargs: kallar vi ein kjend vararg-funksjon, pakk overskotet av
        // argumenta i ei liste på kallstaden (ir-only, ingen VM-endring).
        la vararg_faste = -1
        hvis fn_ident["type"] == "Ident" og har_nokkel(komp["funk_vararg"], fn_ident["verdi"])
            vararg_faste = komp["funk_vararg"][fn_ident["verdi"]]
        slutt

        hvis vararg_faste >= 0 og arg_antal >= vararg_faste
            la vfi = 0
            mens vfi < vararg_faste
                emit_uttrykk(komp, argumenter["barn"][vfi], kode)
                vfi = vfi + 1
            slutt
            la vri = vararg_faste
            mens vri < arg_antal
                emit_uttrykk(komp, argumenter["barn"][vri], kode)
                vri = vri + 1
            slutt
            legg_til(kode, json_instruksjon_med_int("BUILD_LIST", arg_antal - vararg_faste))
            arg_antal = vararg_faste + 1
        ellers
            // Evaluer alle argument
            i = 0
            mens i < arg_antal
                emit_uttrykk(komp, argumenter["barn"][i], kode)
                i = i + 1
            slutt
        slutt

        // Resolve funksjonsnavn
        modul = komp["modul"]

        // Felt-mål: modul.funksjon(args) — t.d. sikkerhet.passord_hash(...)
        hvis fn_ident["type"] == "Felt"
            modul_del = fn_ident["barn"][0]["verdi"]
            fn_del = fn_ident["verdi"]
            hvis modul_del == "builtin"
                legg_til(kode, json_kall("builtin." + fn_del, arg_antal))
                returner sann
            slutt
            hvis fn_ident["barn"][0]["type"] == "Felt" og fn_ident["barn"][0]["barn"][0]["verdi"] == "builtin"
                legg_til(kode, json_kall("builtin." + modul_del + "." + fn_del, arg_antal))
                returner sann
            slutt
            // R2/F05: statisk kall Type.m(args) på ein struktur i denne modulen
            // (eller eintydig importert) → direkte CALL modul.Type.m.
            hvis fn_ident["barn"][0]["type"] == "Ident" og ikkje har_nokkel(komp["import_alias"], modul_del)
                hvis har_nokkel(komp["struktur_kart"], modul_del)
                    returner emit_statisk_kall(komp, modul, modul_del, fn_del, arg_antal, kode)
                slutt
                hvis har_nokkel(komp["importert_struktur_kart"], modul_del) og komp["importert_struktur_kart"][modul_del] != "__AMBIGUOUS__"
                    returner emit_statisk_kall(komp, komp["importert_struktur_kart"][modul_del], modul_del, fn_del, arg_antal, kode)
                slutt
            slutt
            // R2/F05: alias.Type.m(args) → CALL modul.Type.m.
            hvis fn_ident["barn"][0]["type"] == "Felt" og fn_ident["barn"][0]["barn"][0]["type"] == "Ident"
                la st_alias = fn_ident["barn"][0]["barn"][0]["verdi"]
                hvis har_nokkel(komp["import_alias"], st_alias)
                    la st_modul = komp["import_alias"][st_alias]
                    hvis importert_struktur(komp, st_modul, modul_del) != null
                        returner emit_statisk_kall(komp, st_modul, modul_del, fn_del, arg_antal, kode)
                    slutt
                slutt
            slutt
            hvis har_nokkel(komp["import_alias"], modul_del)
                fullt_modul = komp["import_alias"][modul_del]
                // R2/F20: alias.Type(args) kallar konstruktøren i modulen.
                la imp_s = importert_struktur(komp, fullt_modul, fn_del)
                hvis imp_s != null
                    returner emit_konstruktørkall(komp, imp_s, fullt_modul, arg_antal, kode)
                slutt
                // Ukjent namn med typeform (stor forbokstav) i ein kjend modul:
                // kompileringsfeil i staden for eit runtime-kall som ikkje finst.
                hvis er_typenamn_form(fn_del) og har_nokkel(komp["modul_funk_kart"], fullt_modul) og ikkje har_nokkel(komp["modul_funk_kart"][fullt_modul], fn_del)
                    kast "Typefeil: ukjend type " + modul_del + "." + fn_del + " (modulen " + fullt_modul + " har ingen struktur eller funksjon " + fn_del + ")"
                slutt
                legg_til(kode, json_kall(fullt_modul + "." + fn_del, arg_antal))
                returner sann
            slutt
            legg_til(kode, json_kall("builtin." + modul_del + "." + fn_del, arg_antal))
            returner sann
        slutt

        // Kall på eit uttrykksresultat (m["f"](x), f()(x), (funksjon(..){..})(x)):
        // argumenta ligg alt på stacken; evaluer kallaren og bruk CALL_VALUE (F04).
        // Berre ekte uttrykkstypar: `null()` (Null-node med namnet null) skal
        // framleis kalle ein brukarfunksjon som heiter null (std/storttal.no).
        la kallar_type = fn_ident["type"]
        hvis kallar_type == "Indeks" eller kallar_type == "Kall" eller kallar_type == "Lambda" eller kallar_type == "IfUttrykk" eller kallar_type == "OptionalFelt"
            emit_uttrykk(komp, fn_ident, kode)
            legg_til(kode, json_instruksjon_med_int("CALL_VALUE", arg_antal))
            returner sann
        slutt

        fn_navn = fn_ident["verdi"]
        fullt_namn = modul + "." + fn_navn

        // Kall på ein lokal variabel som held ein closure-verdi: last verdien
        // (øvst på stacken, etter argumenta) og bruk CALL_VALUE. Kjende
        // funksjonar (funk_kart) har framleis forrang som direkte CALL.
        hvis fn_ident["type"] == "Ident" og har_nokkel(komp["current_locals"], fn_navn) og ikkje har_nokkel(komp["funk_kart"], fn_navn)
            emit_load_namn(komp, kode, fn_navn)
            legg_til(kode, json_instruksjon_med_int("CALL_VALUE", arg_antal))
            returner sann
        slutt

        // R2/F20: Namn(args) der Namn er ein struktur i denne modulen (eller
        // eintydig importert ukvalifisert) kallar den kompilerte konstruktøren.
        hvis fn_ident["type"] == "Ident" og har_nokkel(komp["struktur_kart"], fn_navn)
            returner emit_konstruktørkall(komp, komp["struktur_kart"][fn_navn], modul, arg_antal, kode)
        slutt
        hvis fn_ident["type"] == "Ident" og har_nokkel(komp["importert_struktur_kart"], fn_navn) og ikkje har_nokkel(komp["funk_kart"], fn_navn)
            la is_modul = komp["importert_struktur_kart"][fn_navn]
            hvis is_modul == "__AMBIGUOUS__"
                kast "Typefeil: strukturnamnet " + fn_navn + " er tvitydig (finst i fleire importerte modular); bruk alias." + fn_navn + "()"
            slutt
            returner emit_konstruktørkall(komp, komp["modul_struktur_kart"][is_modul][fn_navn], is_modul, arg_antal, kode)
        slutt

        // Sjekk om det er ein brukardefinert funksjon i same modul
        hvis builtin.starts_with(fn_navn, "builtin.")
            legg_til(kode, json_kall(fn_navn, arg_antal))
        ellers hvis har_nokkel(komp["funk_kart"], fn_navn)
            // Standardargument: fyll manglande etterfølgjande parametrar med
            // default-uttrykka sine (evaluert på kallstaden) før CALL.
            la n_pushed = arg_antal
            hvis har_nokkel(komp["funk_defaults"], fn_navn)
                la defs = komp["funk_defaults"][fn_navn]
                mens n_pushed < lengde(defs) og defs[n_pushed] != null
                    emit_uttrykk(komp, defs[n_pushed], kode)
                    n_pushed = n_pushed + 1
                slutt
            slutt
            legg_til(kode, json_kall(fullt_namn, n_pushed))
        ellers
            // Antatt builtin eller ekstern
            hvis har_nokkel(komp["imported_funk_kart"], fn_navn)
                importert = komp["imported_funk_kart"][fn_navn]
                hvis importert != "__AMBIGUOUS__"
                    legg_til(kode, json_kall(importert, arg_antal))
                ellers
                    legg_til(kode, json_kall("builtin." + fn_navn, arg_antal))
                slutt
            ellers
                // R2/F05: eit ukjent kallnamn med typeform (stor forbokstav) kan
                // berre vere ein struktur — ingen innebygd funksjon har stor
                // forbokstav. Pnukt() er difor ein kompileringsfeil, ikkje ei
                // tom ordbok frå ein runtime-heuristikk.
                hvis er_typenamn_form(fn_navn)
                    kast "Typefeil linje " + tekst(node["linje"]) + ": ukjend type eller funksjon " + fn_navn + " (ingen struktur eller funksjon med det namnet i " + modul + " eller importerte modular)"
                slutt
                legg_til(kode, json_kall("builtin." + fn_navn, arg_antal))
            slutt
        slutt
        returner sann
    slutt

    // Fallback: ukjent node-type.
    // Me prøver ikkje å fjerne verdiar her; om noden har barn blir det siste barnets
    // uttrykk halde igjen, slik at wrapper-liknande strukturar ikkje blir svelta.
    hvis lengde(node["barn"]) == 0
        legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        returner usann
    slutt

    indeks = 0
    mens indeks < lengde(node["barn"])
        emit_uttrykk(komp, node["barn"][indeks], kode)
        hvis indeks < lengde(node["barn"]) - 1
            legg_til(kode, json_instruksjon_uten_arg("POP"))
        slutt
        indeks = indeks + 1
    slutt

    returner sann
slutt

// ─── Kompiler setningar ──────────────────────────────────────────────────────

funksjon emit_sett_verdi(komp, mål, verdi_node, kode)
    // Hjelpefunksjon: kompiler venstre side av x = expr
    // Skilt ut for å unngå 'ellers + hvis' som slår saman til 'ellers_hvis'
    hvis mål["type"] == "Ident"
        emit_uttrykk(komp, verdi_node, kode)
        emit_store_namn(komp, kode, mål["verdi"], usann)
    slutt
    hvis mål["type"] == "Indeks"
        // liste[i] = verdi → LOAD liste, eval i, eval verdi, INDEX_SET, POP
        // POP er påkravd: INDEX_SET pushar oppdatert objekt på stakk, men dette er
        // ein setning — resultatet vert aldri brukt, og POP held stakken ren.
        emit_uttrykk(komp, mål["barn"][0], kode)
        emit_uttrykk(komp, mål["barn"][1], kode)
        emit_uttrykk(komp, verdi_node, kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
        legg_til(kode, json_instruksjon_uten_arg("POP"))
    slutt
    // R2/F14: alias.NAMN = verdi → STORE_GLOBAL NAMN modul.
    hvis mål["type"] == "Felt" og modulglobal_mål(komp, mål) != ""
        emit_uttrykk(komp, verdi_node, kode)
        emit_modulglobal_lagring(komp, mål, modulglobal_mål(komp, mål), kode)
        returner 0
    slutt
    hvis mål["type"] == "Felt"
        // obj.felt = verdi → LOAD obj, PUSH felt, eval verdi, INDEX_SET, POP
        emit_uttrykk(komp, mål["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", mål["verdi"]))
        emit_uttrykk(komp, verdi_node, kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
        legg_til(kode, json_instruksjon_uten_arg("POP"))
    slutt
slutt

// Ei literal som står åleine som setning har ingen bivirkningar. Den gamle
// banen laga PUSH_CONST etterfølgt av POP; fjern begge før kjeldekartet blir
// skrive. Andre uttrykk, særleg CALL/INDEX_GET, må framleis evaluerast.
funksjon fjern_ubrukte_literal_setning(kode, start_ip: heiltall) -> boolsk
    hvis lengde(kode) != start_ip + 1
        returner usann
    slutt
    la instr = tekst(kode[start_ip])
    hvis ikkje builtin.starts_with(instr, "[\"PUSH_CONST\",")
        returner usann
    slutt
    fjern_siste(kode)
    returner sann
slutt

// ─── Metodekall på vilkårlege mottakarar (F04) ──────────────────────────────
// Rot-identifikatoren i ei feltkjede (a.b.c → "a"), eller "" om kjeda ikkje
// startar i eit namn (t.d. f().b eller l[0].b).
funksjon felt_kjede_rot(node) -> tekst {
    la n = node
    mens n["type"] == "Felt" {
        n = n["barn"][0]
    }
    hvis n["type"] == "Ident" { returner tekst(n["verdi"]) }
    returner ""
}

// Er `mott` i `mott.metode(...)` ein verdi (struktur-instans) og ikkje ein
// modulsti (modul.fn, std.x.fn, builtin.x.fn)?
//   - lokal variabel (inkl. parameter, for- og fang-variabel): metode
//   - feltkjede med rot i ein lokal verdi: metode
//   - feltkjede med rot i builtin, eit importalias, ein modulglobal eller eit
//     ukjent namn: uendra (modulsti; globale mottakarar er ikkje dekte enno)
//   - alle andre uttrykk (kall, indeks, …): metode
funksjon er_metode_mottakar(komp, mott) -> boolsk {
    la t = mott["type"]
    hvis t == "Ident" {
        la namn = mott["verdi"]
        hvis har_nokkel(komp["current_locals"], namn) { returner sann }
        // R2/F20: ein modulglobal (som ikkje er eit importalias) er òg ein verdi.
        hvis har_nokkel(komp["global_kart"], namn) og ikkje har_nokkel(komp["import_alias"], namn) { returner sann }
        returner usann
    }
    hvis t == "Felt" {
        la rot = felt_kjede_rot(mott)
        hvis rot == "" { returner sann }
        hvis rot == "builtin" { returner usann }
        hvis har_nokkel(komp["current_locals"], rot) { returner sann }
        hvis har_nokkel(komp["global_kart"], rot) og ikkje har_nokkel(komp["import_alias"], rot) { returner sann }
        returner usann
    }
    returner sann
}

// R2/F20: mott.metode(args) blir
//   <mott> PUSH_CONST "metode" <args…> CALL builtin.kall_metode (n + 2)
// Mottakaren blir evaluert éin gong. Runtime slår opp funksjonen
// "<mott.__struktur__>.metode" EKSAKT (modulkvalifisert strukturmerke, sjå
// kompiler_konstruktør); manglande metode eller ingenting-mottakar gjev ein
// fangbar MetodeFeil. Ingen fuzzy siste-segment-oppslag.
funksjon emit_metodekall(komp, node, kode) -> boolsk {
    la fn_ident = node["barn"][0]
    la mott = fn_ident["barn"][0]
    la args = node["barn"][1]["barn"]
    emit_uttrykk(komp, mott, kode)
    legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", fn_ident["verdi"]))
    la ai: heiltall = 0
    mens ai < lengde(args) {
        emit_uttrykk(komp, args[ai], kode)
        ai = ai + 1
    }
    legg_til(kode, json_kall("builtin.kall_metode", lengde(args) + 2))
    returner sann
}

// ─── Strukturar (R2/F20, F05) ───────────────────────────────────────────────
// Ein struktur-instans er ei ordbok med to skjulte merke:
//   "__struktur__" = modulkvalifisert typenamn ("modul.Punkt"), nøkkelen for
//                    eksakt metodeoppslag ("modul.Punkt.metode");
//   "__type__"     = kort typenamn ("Punkt") for `fang (e: Punkt)` og eldre kode.
// VM-en gøymer merka i nøkler/verdier/lengde/for/json. Kvar struktur får ein
// kompilert konstruktør «modul.Namn» med parametrane felt1..feltN, __antal__.
// Kallstaden pushar dei gjevne argumenta (posisjonelt), fyller resten med
// ingenting og pushar talet gjevne argument; konstruktøren evaluerer
// standardverdien (`x: heltall = 5`) i strukturens eigen modul for kvart felt
// utan argument. Felt utan argument og utan standardverdi er ingenting.

funksjon struktur_felt(s_node) {
    la ut = []
    la i: heiltall = 0
    mens i < lengde(s_node["barn"]) {
        hvis s_node["barn"][i]["type"] == "Felt" { legg_til(ut, s_node["barn"][i]) }
        i = i + 1
    }
    returner ut
}

funksjon kompiler_konstruktør(komp, s_node) -> tekst {
    la namn = tekst(s_node["verdi"])
    la modul = komp["modul"]
    la felt = struktur_felt(s_node)
    komp["current_function"] = namn
    komp["current_locals"] = {}
    komp["in_module_init"] = usann
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    komp["defer_blocks"] = []
    la lokale = komp["current_locals"]
    la params = []
    la i: heiltall = 0
    mens i < lengde(felt) {
        legg_til(params, tekst(felt[i]["verdi"]))
        lokale[tekst(felt[i]["verdi"])] = sann
        i = i + 1
    }
    legg_til(params, "__antal__")
    lokale["__antal__"] = sann

    la kode = []
    // Standardverdiar: hvis __antal__ <= i { felt_i = <standard> }
    i = 0
    mens i < lengde(felt) {
        hvis lengde(felt[i]["barn"]) > 0 {
            la ok_lbl = ny_etikett(komp)
            legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", "__antal__"))
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", i))
            legg_til(kode, json_instruksjon_uten_arg("COMPARE_LE"))
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", ok_lbl))
            emit_uttrykk(komp, felt[i]["barn"][0], kode)
            legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", tekst(felt[i]["verdi"])))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", ok_lbl))
        }
        i = i + 1
    }
    legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", "__type__"))
    legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", namn))
    legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", "__struktur__"))
    legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", modul + "." + namn))
    i = 0
    mens i < lengde(felt) {
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", tekst(felt[i]["verdi"])))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", tekst(felt[i]["verdi"])))
        i = i + 1
    }
    legg_til(kode, json_instruksjon_med_int("BUILD_MAP", lengde(felt) + 2))
    legg_til(kode, json_instruksjon_uten_arg("RETURN"))

    la fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(modul) + ","
    fn_json = fn_json + "\"params\":" + json_fra_tekstliste(params) + ","
    fn_json = fn_json + "\"is_async\":false,\"struct\":true,"
    // R2/F21: grensesnitta strukturen implementerer (modulkvalifiserte), for
    // er_instans(v, Grensesnitt).
    la impl_liste = []
    hvis har_nokkel(s_node, "implementerer") { legg_til(impl_liste, løys_grensesnitt(komp, tekst(s_node["implementerer"]))) }
    fn_json = fn_json + "\"interfaces\":" + json_fra_tekstliste(impl_liste) + ","
    fn_json = fn_json + "\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":[" + builtin.join(kode, ",") + "],"
    fn_json = fn_json + "\"source_lines\":[],\"source_columns\":[]"
    fn_json = fn_json + "}"
    returner modul + "." + namn + "|SEP|" + fn_json
}

// Kall av konstruktøren til s_node (i modulen fullt_modul). Argumenta ligg alt
// på stacken; fyll manglande felt med ingenting og push talet gjevne argument.
funksjon emit_konstruktørkall(komp, s_node, fullt_modul: tekst, arg_antal: heiltall, kode) -> boolsk {
    la n_felt: heiltall = lengde(struktur_felt(s_node))
    hvis arg_antal > n_felt {
        kast "Typefeil: " + tekst(s_node["verdi"]) + " har " + tekst_fra_heltall(n_felt) + " felt, men konstruktøren fekk " + tekst_fra_heltall(arg_antal) + " argument"
    }
    la i: heiltall = arg_antal
    mens i < n_felt {
        legg_til(kode, "[\"PUSH_CONST\",null]")
        i = i + 1
    }
    legg_til(kode, json_instruksjon_med_int("PUSH_CONST", arg_antal))
    legg_til(kode, json_kall(fullt_modul + "." + tekst(s_node["verdi"]), n_felt + 1))
    returner sann
}

// R2/F05: har namnet typeform, dvs. stor forbokstav (A–Z, Æ, Ø, Å)? Ingen
// innebygd funksjon har det, så eit ukjent kallnamn på denne forma kan berre
// vere ein (feilstava) struktur.
funksjon er_typenamn_form(namn) -> boolsk {
    la t = tekst(namn)
    hvis lengde(t) == 0 { returner usann }
    la c = builtin.slice(t, 0, 1)
    hvis c >= "A" og c <= "Z" { returner sann }
    hvis builtin.starts_with(t, "Æ") eller builtin.starts_with(t, "Ø") eller builtin.starts_with(t, "Å") { returner sann }
    returner usann
}

// R2/F21: modulkvalifisert namn for grensesnittet `namn` sett frå denne
// modulen: lokalt grensesnitt, elles eintydig importert. Eit ukjent namn blir
// kvalifisert med denne modulen (som før: ukjende grensesnitt er ikkje feil).
funksjon løys_grensesnitt(komp, namn: tekst) -> tekst {
    hvis har_nokkel(komp["grensesnitt_kart"], namn) { returner komp["modul"] + "." + namn }
    hvis har_nokkel(komp["importert_grensesnitt_kart"], namn) {
        la gm = komp["importert_grensesnitt_kart"][namn]
        hvis gm != "__AMBIGUOUS__" { returner gm + "." + namn }
    }
    returner komp["modul"] + "." + namn
}

// R2/F21: typeargumentet til er_instans(v, Type): Type eller alias.Type, der
// Type er ein struktur eller eit grensesnitt. Returnerer det modulkvalifiserte
// namnet; alt anna er ein kompileringsfeil.
funksjon løys_typenamn(komp, node) -> tekst {
    hvis node["type"] == "Ident" {
        la t = tekst(node["verdi"])
        hvis har_nokkel(komp["struktur_kart"], t) eller har_nokkel(komp["grensesnitt_kart"], t) { returner komp["modul"] + "." + t }
        hvis har_nokkel(komp["importert_struktur_kart"], t) og komp["importert_struktur_kart"][t] != "__AMBIGUOUS__" { returner komp["importert_struktur_kart"][t] + "." + t }
        hvis har_nokkel(komp["importert_grensesnitt_kart"], t) og komp["importert_grensesnitt_kart"][t] != "__AMBIGUOUS__" { returner komp["importert_grensesnitt_kart"][t] + "." + t }
        kast "Typefeil linje " + tekst(node["linje"]) + ": er_instans: ukjend struktur eller grensesnitt " + t
    }
    hvis node["type"] == "Felt" og node["barn"][0]["type"] == "Ident" og har_nokkel(komp["import_alias"], node["barn"][0]["verdi"]) {
        la m = komp["import_alias"][node["barn"][0]["verdi"]]
        la t2 = tekst(node["verdi"])
        hvis importert_struktur(komp, m, t2) != null { returner m + "." + t2 }
        hvis har_nokkel(komp["modul_grensesnitt_kart"], m) og har_nokkel(komp["modul_grensesnitt_kart"][m], t2) { returner m + "." + t2 }
        kast "Typefeil linje " + tekst(node["linje"]) + ": er_instans: modulen " + m + " har ingen struktur eller grensesnitt " + t2
    }
    kast "Typefeil linje " + tekst(node["linje"]) + ": er_instans krev eit struktur- eller grensesnittnamn som andre argument"
}

// Struktur-noden for `namn` i den importerte modulen `modul_namn`, eller null.
funksjon importert_struktur(komp, modul_namn: tekst, namn: tekst) {
    la msk = komp["modul_struktur_kart"]
    hvis ikkje har_nokkel(msk, modul_namn) { returner null }
    la ms = msk[modul_namn]
    hvis ikkje har_nokkel(ms, namn) { returner null }
    returner ms[namn]
}

// R2/F05: statisk kall Type.m(args) (fabrikk o.l.) → CALL modul.Type.m.
// Argumenta ligg alt på stacken. I same modul blir standardargumenta til
// Type.m fylte på kallstaden, og ein ukjend Type.m er ein kompileringsfeil.
funksjon emit_statisk_kall(komp, fullt_modul: tekst, type_namn: tekst, metode: tekst, arg_antal: heiltall, kode) -> boolsk {
    la lokal_namn = type_namn + "." + metode
    la n_pushed: heiltall = arg_antal
    hvis fullt_modul == komp["modul"] {
        hvis ikkje har_nokkel(komp["funk_kart"], lokal_namn) {
            kast "Typefeil: " + type_namn + " har ingen funksjon " + metode + " (venta funksjon " + lokal_namn + ")"
        }
        hvis har_nokkel(komp["funk_defaults"], lokal_namn) {
            la defs = komp["funk_defaults"][lokal_namn]
            mens n_pushed < lengde(defs) og defs[n_pushed] != null {
                emit_uttrykk(komp, defs[n_pushed], kode)
                n_pushed = n_pushed + 1
            }
        }
    }
    legg_til(kode, json_kall(fullt_modul + "." + lokal_namn, n_pushed))
    returner sann
}

// Registrer eit namn som ramme-lokalt (for-/fang-variabel) slik at seinare
// oppslag ikkje går til ein modulglobal med same namn, og slik at metodekall
// på variabelen blir dynamisk dispatcha.
funksjon merk_lokal(komp, namn) -> heiltall {
    hvis komp["in_module_init"] { returner 0 }
    la lokale = komp["current_locals"]
    lokale[namn] = sann
    returner 0
}

// ─── bryt/fortsett ut av prøv/endeleg (F03) ─────────────────────────────────
// komp["prov_stakk"] held ein post per prøv-blokk som er under kompilering:
// {"har_fang", "har_endeleg", "i_fang", "ctl", "etter", "loop_djupn"}.
// Ein bryt/fortsett kryssar alle prøv-postar som vart opna inne i den
// gjeldande løkka (loop_djupn == talet opne løkker). For kvar slik post:
//   - handleren (TRY_BEGIN) blir fjerna med TRY_END, om han framleis er aktiv
//     (i fang-blokka er han alt fjerna);
//   - har posten endeleg, blir kontrollvariabelen sett (1 = bryt,
//     2 = fortsett) og endeleg-blokka køyrt via FINALLY_RUN. Etter endeleg
//     les prøv-setninga kontrollvariabelen og gjer bryt/fortsett på nytt i
//     den ytre konteksten (sjå emit_prov_fang).

// Sann om blokka inneheld ein bryt/fortsett som høyrer til ei løkke utanfor
// blokka (dvs. ikkje inne i ei nøsta løkke, lambda eller funksjon).
funksjon prov_har_lykkjestyring(node) -> boolsk {
    hvis node == null { returner usann }
    hvis builtin.type(node) != "ordbok" { returner usann }
    la t = node["type"]
    hvis t == "Bryt" eller t == "Fortsett" { returner sann }
    hvis t == "For" eller t == "ForRange" eller t == "Mens" eller t == "Lambda" eller t == "Funksjon" eller t == "ListeKomprehensjon" { returner usann }
    la barn = node["barn"]
    hvis barn == null { returner usann }
    hvis builtin.type(barn) != "liste" { returner usann }
    la i: heiltall = 0
    mens i < lengde(barn) {
        hvis prov_har_lykkjestyring(barn[i]) { returner sann }
        i = i + 1
    }
    returner usann
}

// Emitterer bryt (kind 1) eller fortsett (kind 2) frå gjeldande stad.
funksjon emit_lykkjestyring(komp, kind: heiltall, kode) -> heiltall {
    la mål = gjeldande_loop_slutt(komp)
    hvis kind == 2 { mål = gjeldande_loop_start(komp) }
    hvis mål == "" { returner 0 }
    la djupn: heiltall = lengde(komp["loop_start"])
    la ps = komp["prov_stakk"]
    la pi: heiltall = lengde(ps) - 1
    mens pi >= 0 {
        la p = ps[pi]
        hvis p["loop_djupn"] != djupn { bryt }
        hvis p["har_fang"] og ikkje p["i_fang"] {
            legg_til(kode, json_instruksjon_uten_arg("TRY_END"))
        }
        hvis p["har_endeleg"] og p["ctl"] != "" {
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", kind))
            legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", p["ctl"]))
            legg_til(kode, json_instruksjon_med_tekst("FINALLY_RUN", p["etter"]))
            returner 0
        }
        pi = pi - 1
    }
    legg_til(kode, json_instruksjon_med_tekst("JUMP", mål))
    returner 0
}

funksjon emit_prov_fang(komp, node, kode) -> boolsk {
    la catch_lbl = ny_etikett(komp)
    la after_lbl = ny_etikett(komp)
    la finally_lbl = ny_etikett(komp)
    la finally_return_lbl = ny_etikett(komp)
    la finally_throw_lbl = ny_etikett(komp)
    la catch_type = "*"
    hvis node["catch_type"] != null og node["catch_type"] != "" {
        catch_type = node["catch_type"]
    }

    la har_fang = node["has_catch"] != usann
    la har_endeleg = node["has_finally"] == sann
    // F03: kontrollvariabel berre når ein bryt/fortsett kan forlate prøv- eller
    // fang-blokka gjennom endeleg. Elles er NCB-en uendra.
    la ctl_var = ""
    hvis har_endeleg {
        la kryssar = prov_har_lykkjestyring(node["barn"][0])
        hvis ikkje kryssar og har_fang { kryssar = prov_har_lykkjestyring(node["barn"][1]) }
        hvis kryssar {
            ctl_var = "__prov_ctl_" + tekst_fra_heltall(komp["teller"]) + "__"
            komp["teller"] = komp["teller"] + 1
        }
    }
    la post = {"har_fang": har_fang, "har_endeleg": har_endeleg, "i_fang": usann, "ctl": ctl_var, "etter": after_lbl, "loop_djupn": lengde(komp["loop_start"])}
    legg_til(komp["prov_stakk"], post)

    hvis har_endeleg {
        legg_til(kode, json_instruksjon_med_tekst("FINALLY_PUSH", finally_lbl))
    }
    hvis har_fang { legg_til(kode, json_try_begin(catch_lbl, catch_type)) }
    emit_blokk(komp, node["barn"][0], kode)
    hvis har_fang { legg_til(kode, json_instruksjon_uten_arg("TRY_END")) }
    hvis har_endeleg {
        hvis ctl_var != "" {
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
            legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", ctl_var))
        }
        legg_til(kode, json_instruksjon_med_tekst("FINALLY_RUN", after_lbl))
    } ellers {
        legg_til(kode, json_instruksjon_med_tekst("JUMP", after_lbl))
    }
    hvis har_fang {
        legg_til(kode, json_instruksjon_med_tekst("LABEL", catch_lbl))
        legg_til(kode, json_instruksjon_uten_arg("TRY_END"))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_EXCEPTION"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
        merk_lokal(komp, node["verdi"])
        post["i_fang"] = sann
        emit_blokk(komp, node["barn"][1], kode)
        hvis har_endeleg {
            hvis ctl_var != "" {
                legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
                legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", ctl_var))
            }
            legg_til(kode, json_instruksjon_med_tekst("FINALLY_RUN", after_lbl))
        } ellers {
            legg_til(kode, json_instruksjon_med_tekst("JUMP", after_lbl))
        }
    }
    // Endeleg-blokka og alt etter prøv-setninga er utanfor denne posten.
    fjern_siste(komp["prov_stakk"])
    hvis har_endeleg {
        legg_til(kode, json_instruksjon_med_tekst("LABEL", finally_lbl))
        emit_blokk(komp, node["barn"][2], kode)
        legg_til(kode, "[\"FINALLY_END\"," + json_escape_tekst(after_lbl) + "," + json_escape_tekst(finally_return_lbl) + "," + json_escape_tekst(finally_throw_lbl) + "]")
        legg_til(kode, json_instruksjon_med_tekst("LABEL", finally_return_lbl))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("RETURN"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", finally_throw_lbl))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("THROW"))
    }
    legg_til(kode, json_instruksjon_med_tekst("LABEL", after_lbl))
    hvis ctl_var != "" {
        // Etter endeleg: hald fram med bryt (1) / fortsett (2) i ytre kontekst.
        la ikkje_bryt_lbl = ny_etikett(komp)
        la ikkje_fortsett_lbl = ny_etikett(komp)
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", ctl_var))
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", ikkje_bryt_lbl))
        emit_lykkjestyring(komp, 1, kode)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", ikkje_bryt_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", ctl_var))
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 2))
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", ikkje_fortsett_lbl))
        emit_lykkjestyring(komp, 2, kode)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", ikkje_fortsett_lbl))
    }
    returner sann
}

funksjon emit_for_range(komp, node, kode) -> boolsk {
    la loop_n = tekst_fra_heltall(komp["teller"])
    komp["teller"] = komp["teller"] + 1
    la loop_start_lbl = "__forr_start_" + loop_n + "__"
    la loop_end_lbl = "__forr_end_" + loop_n + "__"
    la loop_cont_lbl = "__forr_cont_" + loop_n + "__"

    emit_uttrykk(komp, node["barn"][0], kode)
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
    merk_lokal(komp, node["verdi"])
    push_loop(komp, loop_cont_lbl, loop_end_lbl)
    legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_start_lbl))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", node["verdi"]))
    emit_uttrykk(komp, node["barn"][1], kode)
    legg_til(kode, json_instruksjon_uten_arg("COMPARE_LE"))
    legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", loop_end_lbl))
    emit_blokk(komp, node["barn"][3], kode)
    legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_cont_lbl))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", node["verdi"]))
    emit_uttrykk(komp, node["barn"][2], kode)
    legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
    legg_til(kode, json_instruksjon_med_tekst("JUMP", loop_start_lbl))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_end_lbl))
    pop_loop(komp)
    returner sann
}

funksjon emit_setning(komp, node, kode)
    t = node["type"]

    hvis t == "Blokk"
        emit_blokk(komp, node, kode)
        returner sann
    slutt

    hvis t == "Match"
        hvis lengde(node["barn"]) == 0
            returner sann
        slutt
        sjekk_enum_match_dekning(komp, node)

        subject_var = "match_subject_" + tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        end_lbl = ny_etikett(komp)

        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", subject_var))

        case_indeks = 1
        mens case_indeks < lengde(node["barn"])
            case_node = node["barn"][case_indeks]

            hvis case_node["type"] == "MatchElse"
                emit_blokk(komp, case_node["barn"][0], kode)
                legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
                bryt
            slutt

            hvis case_node["verdi"] == "wildcard"
                emit_blokk(komp, case_node["barn"][0], kode)
                legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
                bryt
            slutt

            next_lbl = ny_etikett(komp)
            emit_uttrykk(komp, case_node["barn"][0], kode)
            legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", subject_var))
            legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", next_lbl))
            emit_blokk(komp, case_node["barn"][1], kode)
            legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", next_lbl))

            case_indeks = case_indeks + 1
        slutt

        legg_til(kode, json_instruksjon_med_tekst("LABEL", end_lbl))
        returner sann
    slutt

    // La x = expr  (variabel-deklarasjon)
    hvis t == "La"
        namn = node["verdi"]
        hvis lengde(node["barn"]) > 0
            // Siste barn er verdi-uttrykket (etter eventuell Type-node)
            siste = node["barn"][lengde(node["barn"]) - 1]
            hvis siste["type"] != "Type" og siste["type"] != "Returtype"
                emit_uttrykk(komp, siste, kode)
            ellers
                legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
            slutt
        ellers
            legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        slutt
        emit_store_namn(komp, kode, namn, sann)
        returner sann
    slutt

    // la [a, b] = liste  /  la {a, b} = ordbok  (destrukturering)
    // Lagra verdien i ein temp og hent kvart mål via INDEX_GET — med heiltals-
    // indeks for liste-modus og målnamnet som tekstnøkkel for ordbok-modus.
    hvis t == "LaDestrukt"
        mål = node["barn"][0]
        verdi = node["barn"][1]
        la er_ordbok = node["verdi"] == "ordbok"
        n = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        tmp = "__destr_" + n + "__"
        emit_uttrykk(komp, verdi, kode)
        // Temp er RAMME-lokal (STORE_NAME), ikkje global — emit_store_namn ville
        // globalisert han i modul-init, og __destr_N__ ville kollidert på tvers av
        // modular (delt global-slot) → miscompilert kompilator. Berre MÅLA er globale.
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", tmp))
        di = 0
        mens di < lengde(mål["barn"])
            la mnamn = mål["barn"][di]["verdi"]
            legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", tmp))
            hvis er_ordbok
                legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", mnamn))
            ellers
                legg_til(kode, json_instruksjon_med_int("PUSH_CONST", di))
            slutt
            legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
            emit_store_namn(komp, kode, mnamn, sann)
            di = di + 1
        slutt
        returner sann
    slutt

    // x = expr  (tilordning)
    hvis t == "Sett"
        mål = node["barn"][0]
        verdi_node = node["barn"][1]
        emit_sett_verdi(komp, mål, verdi_node, kode)
        returner sann
    slutt

    // x += expr  (augmented tilordning)
    hvis t == "AugSett"
        mål = node["barn"][0]
        verdi_node = node["barn"][1]
        binop_opcode = aug_til_binop(node["verdi"])

        hvis mål["type"] == "Ident"
            emit_uttrykk(komp, mål, kode)
            emit_uttrykk(komp, verdi_node, kode)
            legg_til(kode, json_instruksjon_uten_arg(binop_opcode))
            emit_store_namn(komp, kode, mål["verdi"], usann)
        slutt

        // liste[i] += expr
        // Stack must be [obj, idx, val3] before INDEX_SET (val3 on top)
        // Push obj+idx first, then dup to read old value, compute new value
        hvis mål["type"] == "Indeks"
            // Push obj and idx that INDEX_SET will consume
            emit_uttrykk(komp, mål["barn"][0], kode)
            emit_uttrykk(komp, mål["barn"][1], kode)
            // Load obj and idx again to read current value via INDEX_GET
            emit_uttrykk(komp, mål["barn"][0], kode)
            emit_uttrykk(komp, mål["barn"][1], kode)
            legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
            // Compute new value
            emit_uttrykk(komp, verdi_node, kode)
            legg_til(kode, json_instruksjon_uten_arg(binop_opcode))
            // Stack is now [obj, idx, new_val] — INDEX_SET: val3=new_val, idx=idx, obj=obj ✓
            legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
            legg_til(kode, "[\"POP\"]")
        slutt

        // R2/F14: alias.NAMN += expr (modulglobal) og obj.felt += expr. Før
        // vart ein Felt-mål stilt hoppa over (ingen kode i det heile).
        hvis mål["type"] == "Felt"
            la aug_mg = modulglobal_mål(komp, mål)
            hvis aug_mg != ""
                emit_uttrykk(komp, mål, kode)
                emit_uttrykk(komp, verdi_node, kode)
                legg_til(kode, json_instruksjon_uten_arg(binop_opcode))
                emit_modulglobal_lagring(komp, mål, aug_mg, kode)
            ellers
                emit_uttrykk(komp, mål["barn"][0], kode)
                legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", mål["verdi"]))
                emit_uttrykk(komp, mål["barn"][0], kode)
                legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", mål["verdi"]))
                legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
                emit_uttrykk(komp, verdi_node, kode)
                legg_til(kode, json_instruksjon_uten_arg(binop_opcode))
                legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
                legg_til(kode, "[\"POP\"]")
            slutt
        slutt
        returner sann
    slutt

    // returner [uttrykk]
    hvis t == "Returner"
        hvis lengde(node["barn"]) > 0
            emit_uttrykk(komp, node["barn"][0], kode)
        ellers
            legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        slutt
        legg_til(kode, json_instruksjon_uten_arg("RETURN"))
        returner sann
    slutt

    hvis t == "Utsett"
        defer_lbl = ny_etikett(komp)
        defer_return_lbl = ny_etikett(komp)
        defer_throw_lbl = ny_etikett(komp)
        legg_til(kode, json_instruksjon_med_tekst("FINALLY_PUSH", defer_lbl))
        legg_til(komp["defer_blocks"], {
            "label": defer_lbl,
            "return_label": defer_return_lbl,
            "throw_label": defer_throw_lbl,
            "block": node["barn"][0]
        })
        returner sann
    slutt

    // hvis uttrykk blokk [ellers blokk]
    hvis t == "Hvis"
        etikett_ellers = ny_etikett(komp)
        etikett_ferdig = ny_etikett(komp)

        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", etikett_ellers))

        emit_blokk(komp, node["barn"][1], kode)

        hvis lengde(node["barn"]) > 2
            legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_ferdig))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ellers))
            emit_blokk(komp, node["barn"][2], kode)
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ferdig))
        ellers
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ellers))
        slutt
        returner sann
    slutt

    // mens uttrykk blokk
    hvis t == "Mens"
        etikett_start = ny_etikett(komp)
        etikett_slutt = ny_etikett(komp)

        push_loop(komp, etikett_start, etikett_slutt)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_start))
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", etikett_slutt))
        emit_blokk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_start))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_slutt))
        pop_loop(komp)
        returner sann
    slutt

    // bryt (ryddar opne prøv-blokker og køyrer endeleg, sjå emit_lykkjestyring)
    hvis t == "Bryt"
        emit_lykkjestyring(komp, 1, kode)
        returner sann
    slutt

    // fortsett
    hvis t == "Fortsett"
        emit_lykkjestyring(komp, 2, kode)
        returner sann
    slutt

    // kast <uttrykk>
    hvis t == "Kast"
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_uten_arg("THROW"))
        returner sann
    slutt

    // prøv { } fang (e) { }
    // node["verdi"] = fangst-variabel-namn, barn[0]=prøv-blokk, barn[1]=fang-blokk
    hvis t == "PrøvFang"
        returner emit_prov_fang(komp, node, kode)
    slutt

    // for var i liste { kropp }
    // node["verdi"] = løkkevariabel-namn, barn[0]=liste-uttrykk, barn[1]=kropp
    hvis t == "For"
        loop_n = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        iter_liste_var = "__iter_lst_" + loop_n + "__"
        iter_idx_var   = "__iter_idx_" + loop_n + "__"
        loop_start_lbl = "__for_start_" + loop_n + "__"
        loop_end_lbl   = "__for_end_"   + loop_n + "__"
        loop_cont_lbl  = "__for_cont_"  + loop_n + "__"

        iter_txt_var   = "__iter_txt_" + loop_n + "__"
        iter_steg_var  = "__iter_steg_" + loop_n + "__"
        iter_b_var     = "__iter_b_" + loop_n + "__"
        ordbok_lbl     = "__for_ikkje_ordbok_" + loop_n + "__"
        liste_lbl      = "__for_liste_" + loop_n + "__"
        kropp_lbl      = "__for_kropp_" + loop_n + "__"

        // Evaluer iterabelen og lagre. F01/F19 (R1): ei ordbok blir iterert over
        // nøklane, ein tekst per teikn (UTF-8-skalar), ei liste per element. Alt er
        // vanleg bytekode over builtins som finst i VM og begge AOT-codegenane.
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_liste_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_kall("builtin.type", 1))
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", "ordbok"))
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", ordbok_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_kall("builtin.nøkler", 1))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_liste_var))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", ordbok_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_kall("builtin.type", 1))
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", "tekst"))
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_txt_var))
        // Indeks = 0
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_idx_var))

        merk_lokal(komp, node["verdi"])
        push_loop(komp, loop_cont_lbl, loop_end_lbl)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_start_lbl))

        // if idx < lengde(liste): gå inn i kroppen
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_kall("builtin.lengde", 1))
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_LT"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", loop_end_lbl))

        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_txt_var))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", liste_lbl))
        // Tekst: teiknlengda kjem av leiebyten (<0xC0: 1, <0xE0: 2, <0xF0: 3, elles 4).
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
        legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
        legg_til(kode, json_kall("builtin.slice", 3))
        legg_til(kode, json_kall("builtin.char_code", 1))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_b_var))
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_steg_var))
        la grenser = [192, 224, 240]
        la gj = 0
        mens gj < 3
            la neste_lbl = "__for_utf8_" + loop_n + "_" + tekst_fra_heltall(gj) + "__"
            legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_b_var))
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", grenser[gj]))
            legg_til(kode, json_instruksjon_uten_arg("COMPARE_GE"))
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", neste_lbl))
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", gj + 2))
            legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_steg_var))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", neste_lbl))
            gj = gj + 1
        slutt
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_steg_var))
        legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
        legg_til(kode, json_kall("builtin.slice", 3))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
        legg_til(kode, json_instruksjon_med_tekst("JUMP", kropp_lbl))

        // Liste: var = liste[idx]
        legg_til(kode, json_instruksjon_med_tekst("LABEL", liste_lbl))
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_steg_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", kropp_lbl))

        emit_blokk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_cont_lbl))
        // idx = idx + steg
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_steg_var))
        legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("JUMP", loop_start_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_end_lbl))
        pop_loop(komp)
        returner sann
    slutt

    // ForRange: for i = start til end [steg s]
    hvis t == "ForRange"
        returner emit_for_range(komp, node, kode)
    slutt

    // Uttrykk-setning (kall osv.)
    // Reine literalar har ingen observerbar effekt og skal ikkje leggje noko
    // på operandstacken. Avgjer dette frå AST-typen før kodegenerering; det er
    // meir robust enn å kjenne att serialisert JSON-bytecode etterpå.
    hvis t == "Heltall" eller t == "Desimal" eller t == "Tekst" eller
       t == "Bool" eller t == "Null"
        returner sann
    slutt
    la uttrykk_start = lengde(kode)
    emit_uttrykk(komp, node, kode)
    hvis ikkje fjern_ubrukte_literal_setning(kode, uttrykk_start)
        legg_til(kode, json_instruksjon_uten_arg("POP"))
    slutt
    returner sann
slutt

funksjon emit_blokk(komp, blokk, kode)
    i = 0
    mens i < lengde(blokk["barn"])
        node = blokk["barn"][i]
        start_ip = lengde(kode)
        emit_setning(komp, node, kode)
        slutt_ip = lengde(kode)
        // Parallelle heiltalslister er langt billegare enn eitt hashoppslag og
        // ein ny "line:column"-tekst per bytekodeinstruksjon. Indeksane blir
        // fylte direkte, medan indre blokker får behalde den mest presise
        // posisjonen dei alt har registrert.
        la source_lines = komp["current_source_lines"]
        la source_columns = komp["current_source_columns"]
        ip = start_ip
        mens komp["source_map_active"] og ip < slutt_ip
            mens lengde(source_lines) <= ip
                legg_til(source_lines, 0)
                legg_til(source_columns, 0)
            slutt
            hvis source_lines[ip] == 0
                la node_linje = node["linje"]
                la node_kolonne = node["kolonne"]
                hvis builtin.type(node_linje) == "ingenting"
                    node_linje = 0
                slutt
                hvis builtin.type(node_kolonne) == "ingenting"
                    node_kolonne = 0
                slutt
                source_lines[ip] = node_linje
                source_columns[ip] = node_kolonne
            slutt
            ip = ip + 1
        slutt
        i = i + 1
    slutt
slutt

funksjon registrer_importerte_funksjonar(komp, alias, modul_namn)
    // Oppdag importerte topnivå-funksjonar for unqualified-kall.
    hvis har_nokkel(komp["importert_modul_cache"], modul_namn)
        returner 0
    slutt

    importert_cache = komp["importert_modul_cache"]
    importert_cache[modul_namn] = sann
    modul_fil = modul_til_filsti(modul_namn)
    modul_kjelde = fil_les(modul_fil)
    ast = selfhost.parser.parse_program(selfhost.lexer.lexer_m1.lex(modul_kjelde))
    ast_barn = ast["barn"]
    i = 0

    mens i < lengde(ast_barn)
        node = ast_barn[i]
        // Enumar i importerte modular: fg.Farge.GRON blir konstant ved kompilering.
        hvis node["type"] == "Enum"
            la mek = komp["modul_enum_kart"]
            hvis ikkje har_nokkel(mek, modul_namn)
                mek[modul_namn] = {}
            slutt
            la modul_enumar = mek[modul_namn]
            modul_enumar[node["verdi"]] = lag_enum_info(node)
        slutt
        // R2/F20/F05: strukturar i importerte modular — alias.Namn() og
        // eintydige ukvalifiserte Namn() kallar konstruktøren «modul.Namn».
        hvis node["type"] == "Struktur"
            la msk = komp["modul_struktur_kart"]
            hvis ikkje har_nokkel(msk, modul_namn)
                msk[modul_namn] = {}
            slutt
            la modul_strukturar = msk[modul_namn]
            modul_strukturar[node["verdi"]] = node
            la isk = komp["importert_struktur_kart"]
            hvis har_nokkel(isk, node["verdi"])
                hvis isk[node["verdi"]] != modul_namn
                    isk[node["verdi"]] = "__AMBIGUOUS__"
                slutt
            ellers
                isk[node["verdi"]] = modul_namn
            slutt
        slutt
        // R2/F14: modulglobalar i importerte modular (alias.NAMN les/skriv).
        // Verdien er "konst" for konst-bindingar (F15), elles "la".
        hvis node["type"] == "La" eller node["type"] == "LaDestrukt"
            la mgl = komp["modul_global_kart"]
            hvis ikkje har_nokkel(mgl, modul_namn)
                mgl[modul_namn] = {}
            slutt
            la modul_globalar = mgl[modul_namn]
            hvis node["type"] == "La"
                hvis har_nokkel(node, "konst") og node["konst"] == sann
                    modul_globalar[node["verdi"]] = "konst"
                ellers
                    modul_globalar[node["verdi"]] = "la"
                slutt
            ellers hvis lengde(node["barn"]) > 0
                la dm = node["barn"][0]
                la dmi = 0
                mens dmi < lengde(dm["barn"])
                    modul_globalar[dm["barn"][dmi]["verdi"]] = "la"
                    dmi = dmi + 1
                slutt
            slutt
        slutt
        // R2/F21: grensesnitt i importerte modular (er_instans / implementerer).
        hvis node["type"] == "Grensesnitt"
            la mgk = komp["modul_grensesnitt_kart"]
            hvis ikkje har_nokkel(mgk, modul_namn)
                mgk[modul_namn] = {}
            slutt
            la modul_grensesnitt = mgk[modul_namn]
            modul_grensesnitt[node["verdi"]] = sann
            la igk = komp["importert_grensesnitt_kart"]
            hvis har_nokkel(igk, node["verdi"])
                hvis igk[node["verdi"]] != modul_namn
                    igk[node["verdi"]] = "__AMBIGUOUS__"
                slutt
            ellers
                igk[node["verdi"]] = modul_namn
            slutt
        slutt
        hvis node["type"] == "Funksjon"
            fn_namn = node["verdi"]
            fullt_namn = modul_namn + "." + fn_namn
            // R2/F05: alle funksjonsnamn per modul (for alias.Namn()-sjekken).
            la mfk = komp["modul_funk_kart"]
            hvis ikkje har_nokkel(mfk, modul_namn)
                mfk[modul_namn] = {}
            slutt
            la modul_funksjonar = mfk[modul_namn]
            modul_funksjonar[fn_namn] = sann

            // Innebygde namn må ALDRI skuggast av ukvalifiserte importar.
            // std.dns definerer t.d. `legg_til(sone, r)`; utan denne sperra
            // vart `legg_til(liste, x)` i __main__ kompilert til
            // CALL std.dns.legg_til (tom liste → feil SHA-256 i
            // test_dns_ds_record på fersk seed, 2026-09-06). Den committa
            // kompilatoren skreiv builtin.legg_til; hald same kontrakt.
            // Kvalifiserte kall (dns.legg_til) går framleis Felt-vegen.
            hvis selfhost.compiler.semantic.er_builtin(fn_namn)
                i = i + 1
                fortsett
            slutt

            imported_kart = komp["imported_funk_kart"]
            har_importert = har_nokkel(imported_kart, fn_namn)
            hvis har_importert
                ifalt = imported_kart[fn_namn]
                hvis ifalt != "__AMBIGUOUS__"
                    imported_kart[fn_namn] = "__AMBIGUOUS__"
                slutt
            slutt
            hvis har_importert == usann
                imported_kart[fn_namn] = fullt_namn
            slutt
        slutt
        i = i + 1
    slutt

    // `alias` er reservert for mogleg konfliktavklaring ved samstundes importar.
    returner 0
slutt

// F42: `fra M bruk a, b` — bind dei valde namna ukvalifisert til M (vinn over
// tvetydige ukvalifiserte importar). Eit namn som ikkje er ein funksjon eller
// struktur i M er ein kompileringsfeil. `*` endrar ingenting: alle
// toppnivåfunksjonane i M er alt tilgjengelege ukvalifisert.
funksjon registrer_importutval(komp, bruk_node)
    la modul_namn = bruk_node["verdi"]
    la bi = 1
    mens bi < lengde(bruk_node["barn"])
        la u = bruk_node["barn"][bi]
        bi = bi + 1
        hvis u["type"] != "Utval" eller u["verdi"] == "*"
            fortsett
        slutt
        la namn = u["verdi"]
        la mfk = komp["modul_funk_kart"]
        la msk = komp["modul_struktur_kart"]
        hvis har_nokkel(mfk, modul_namn) og har_nokkel(mfk[modul_namn], namn)
            la ifk = komp["imported_funk_kart"]
            ifk[namn] = modul_namn + "." + namn
        ellers hvis har_nokkel(msk, modul_namn) og har_nokkel(msk[modul_namn], namn)
            la isk = komp["importert_struktur_kart"]
            isk[namn] = modul_namn
        ellers
            kast "Importfeil linje " + tekst(u["linje"]) + ": modulen " + modul_namn + " har ingen funksjon eller struktur " + namn
        slutt
    slutt
    returner 0
slutt

// ─── Kompiler funksjonar ─────────────────────────────────────────────────────

funksjon kompiler_funksjon(komp, fn_node)
    ir_fremdrift("compile-function-enter " + fn_node["verdi"])
    komp["current_function"] = fn_node["verdi"]
    // fn_node["barn"] = [Parametere, Returtype, Blokk]
    fn_barn = fn_node["barn"]
    param_node = fn_barn[0]  // Parametere
    blokk = fn_barn[2]       // Blokk (etter Parametere og Returtype)

    // Samle parameter-namn
    params = []
    komp["current_locals"] = {}
    komp["in_module_init"] = usann
    i = 0
    param_barn = param_node["barn"]
    mens i < lengde(param_barn)
        la param_namn = param_barn[i]["verdi"]
        legg_til(params, param_namn)
        la lokale = komp["current_locals"]
        lokale[param_namn] = sann
        i = i + 1
    slutt
    ir_fremdrift("compile-function-params " + fn_node["verdi"])

    // Bygg kode-lista
    kode = []
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    komp["defer_blocks"] = []
    ir_fremdrift("compile-function-body " + fn_node["verdi"])
    emit_blokk(komp, blokk, kode)

    // Legg til implisitt returner null berre når blokka ikkje alt avsluttar med RETURN
    legg_til_implisitt_return(kode)

    defer_i = 0
    mens defer_i < lengde(komp["defer_blocks"])
        defer_post = komp["defer_blocks"][defer_i]
        defer_after_lbl = ny_etikett(komp)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_post["label"]))
        emit_blokk(komp, defer_post["block"], kode)
        legg_til(kode, "[\"FINALLY_END\"," + json_escape_tekst(defer_after_lbl) + "," + json_escape_tekst(defer_post["return_label"]) + "," + json_escape_tekst(defer_post["throw_label"]) + "]")
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_post["return_label"]))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("RETURN"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_post["throw_label"]))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("THROW"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_after_lbl))
        defer_i = defer_i + 1
    slutt

    source_lines = komp["current_source_lines"]
    source_columns = komp["current_source_columns"]
    source_ip = 0
    mens komp["source_map_active"] og source_ip < lengde(kode)
        hvis source_ip >= lengde(source_lines)
            legg_til(source_lines, fn_node["linje"])
            legg_til(source_columns, fn_node["kolonne"])
        ellers hvis source_lines[source_ip] == 0
            source_lines[source_ip] = fn_node["linje"]
            source_columns[source_ip] = fn_node["kolonne"]
        slutt
        source_ip = source_ip + 1
    slutt

    // Serialiser til JSON
    modul = komp["modul"]
    fn_namn = fn_node["verdi"]
    fullt_namn = modul + "." + fn_namn

    // Bygg params JSON
    params_json = "["
    j = 0
    mens j < lengde(params)
        hvis j > 0
            params_json = params_json + ","
        slutt
        params_json = params_json + json_escape_tekst(params[j])
        j = j + 1
    slutt
    params_json = params_json + "]"

    // Bygg code JSON
    kode_json = "[" + builtin.join(kode, ",") + "]"

    // Fullt funksjon-objekt
    fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(fn_namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(modul) + ","
    fn_json = fn_json + "\"params\":" + params_json + ","
    la er_async = usann
    hvis har_nokkel(fn_node, "is_async")
        er_async = fn_node["is_async"] == sann
    slutt
    hvis er_async
        fn_json = fn_json + "\"is_async\":true,"
    ellers
        fn_json = fn_json + "\"is_async\":false,"
    slutt
    fn_json = fn_json + "\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":" + kode_json + ","
    fn_json = fn_json + "\"source_lines\":" + json_liste(source_lines) + ","
    fn_json = fn_json + "\"source_columns\":" + json_liste(source_columns)
    fn_json = fn_json + "}"

    returner fullt_namn + "|SEP|" + fn_json
slutt

// R2/F14: er toppnivå-noden det gamle Python-idiomet `start()` nedst i fila?
// Runtime kallar start() sjølv; når toppnivå-setningar no køyrer som modul-
// init, ville start() elles køyrt to gonger. Kallet blir difor hoppa over.
funksjon er_toppnivå_startkall(komp, node) -> boolsk {
    hvis node["type"] != "Kall" { returner usann }
    la f = node["barn"][0]
    hvis f["type"] != "Ident" eller f["verdi"] != "start" { returner usann }
    hvis lengde(node["barn"][1]["barn"]) != 0 { returner usann }
    returner har_nokkel(komp["funk_kart"], "start")
}

// R2/F14: har programmet køyrbare toppnivå-setningar (ikkje berre
// deklarasjonar og `la`)? Då treng modulen __module_init__ sjølv utan globalar.
// Reine namn- og literaluttrykk (t.d. eldre `import x.y`-linjer) har ingen
// verknad og tel ikkje.
funksjon har_toppnivå_setning(komp, ast_program) -> boolsk {
    la i: heiltall = 0
    mens i < lengde(ast_program["barn"]) {
        la node = ast_program["barn"][i]
        la t = node["type"]
        hvis t != "Funksjon" og t != "Test" og t != "Bruk" og t != "Enum" og t != "Grensesnitt" og t != "Struktur" og t != "La" og t != "LaDestrukt" og t != "Ident" og t != "Felt" og t != "Tekst" og t != "Heltall" og t != "Desimal" og t != "Bool" og t != "Null" og ikkje er_toppnivå_startkall(komp, node) {
            returner sann
        }
        i = i + 1
    }
    returner usann
}

funksjon kompiler_modul_init(komp, ast_program) -> tekst {
    la kode = []
    komp["current_locals"] = {}
    komp["in_module_init"] = sann
    la i: heiltall = 0
    mens i < lengde(ast_program["barn"]) {
        la node = ast_program["barn"][i]
        // Enum/Grensesnitt/Struktur er kompilerings-tids-deklarasjonar (ingen runtime-verdi);
        // emit_setning har ingen case for dei → fall-through til uvilkårleg POP →
        // modul-init-stakk-underflow. Hopp over dei som Funksjon/Test/Bruk.
        hvis node["type"] != "Funksjon" og node["type"] != "Test" og node["type"] != "Bruk" og node["type"] != "Enum" og node["type"] != "Grensesnitt" og node["type"] != "Struktur" og ikkje er_toppnivå_startkall(komp, node) {
            emit_setning(komp, node, kode)
        }
        i = i + 1
    }
    legg_til_implisitt_return(kode)
    komp["in_module_init"] = usann
    la namn = "__module_init__"
    la fullt_namn = komp["modul"] + "." + namn
    la fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(komp["modul"]) + ","
    fn_json = fn_json + "\"params\":[],\"is_async\":false,\"module_init\":true,\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":[" + builtin.join(kode, ",") + "],"
    fn_json = fn_json + "\"source_lines\":[],\"source_columns\":[]"
    fn_json = fn_json + "}"
    returner fullt_namn + "|SEP|" + fn_json
}

funksjon kompiler_test(komp, test_node)
    blokk = test_node["barn"][0]

    kode = []
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    emit_blokk(komp, blokk, kode)

    legg_til_implisitt_return(kode)

    modul = komp["modul"]
    kode_json = "[" + builtin.join(kode, ",") + "]"

    test_json = "{"
    test_json = test_json + "\"name\":" + json_escape_tekst(test_node["verdi"]) + ","
    test_json = test_json + "\"module\":" + json_escape_tekst(modul) + ","
    test_json = test_json + "\"kind\":\"test\"," 
    test_json = test_json + "\"params\":[],"
    test_json = test_json + "\"is_async\":false,"
    test_json = test_json + "\"string_encoding\":\"decoded-v1\","
    test_json = test_json + "\"code\":" + kode_json
    test_json = test_json + "}"

    returner test_json
slutt

// ─── Kompiler heile programmet ────────────────────────────────────────────────

funksjon samla_importar(ast_program) -> liste_tekst {
    la imports: liste_tekst = []
    la sett: ordbok_tekst = {}
    la barn = ast_program["barn"]
    la i: heiltall = 0
    mens i < lengde(barn) {
        la node = barn[i]
        la modul = node["verdi"]
        hvis node["type"] == "Bruk" og ikkje har_nokkel(sett, modul) {
            legg_til(imports, modul)
            sett[modul] = sann
        }
        i = i + 1
    }
    returner imports
}

funksjon kompiler_program(ast_program, modul_namn)
    ir_fremdrift("program-start " + modul_namn)
    komp = ny_komp()
    ir_fremdrift("program-state-ready " + modul_namn)
    komp["modul"] = modul_namn
    ir_fremdrift("program-web-start " + modul_namn)
    web_meta = samla_web_annotasjonar(ast_program, modul_namn)
    ir_fremdrift("program-web-done " + modul_namn)

    // Første pass: registrer alle funksjonar
    // NB: To-nivå indeks-tilordning (komp["funk_kart"][namn] = sann) er ikkje støtta
    // av Python-kompilatoren sin IndexSetNode — bruk temporær variabel i staden.
    fk = komp["funk_kart"]
    // Inkrementell/source-only kompilering kan dele ein stor modul ved
    // funksjonsgrenser. Registrer då heile modulens deklarasjonsflate før
    // delen blir kompilert, slik at krysskall ikkje blir feilklassifiserte
    // som builtin-kall.
    la kjende_funksjonar = miljo_hent("NORSCODE_COMPILER_KNOWN_FUNCTIONS")
    hvis kjende_funksjonar != "" {
        la kjende = builtin.split(kjende_funksjonar, ",")
        la kjent_i: heiltall = 0
        mens kjent_i < lengde(kjende) {
            hvis kjende[kjent_i] != "" { fk[kjende[kjent_i]] = sann }
            kjent_i = kjent_i + 1
        }
    }
    i = 0
    mens i < lengde(ast_program["barn"])
        node = ast_program["barn"][i]
        ir_fremdrift("first-pass " + json_heiltal_tekst(i) + " " + node["type"] + " " + node["verdi"])
        hvis node["type"] == "Funksjon"
            fk[node["verdi"]] = sann
            la fd = komp["funk_defaults"]
            fd[node["verdi"]] = _samle_standardar(node["barn"][0])
            // Varargs: siste parameter markert med ... samlar resten. Lagra talet
            // faste parametrar før han slik at kallstaden kan pakke overskotet.
            la pnode = node["barn"][0]
            hvis lengde(pnode["barn"]) > 0
                la siste_p = pnode["barn"][lengde(pnode["barn"]) - 1]
                hvis har_nokkel(siste_p, "vararg") og siste_p["vararg"] == sann
                    la fv = komp["funk_vararg"]
                    fv[node["verdi"]] = lengde(pnode["barn"]) - 1
                slutt
            slutt
        slutt
        hvis node["type"] == "Enum" {
            la ek = komp["enum_kart"]
            ek[node["verdi"]] = lag_enum_info(node)
        }
        hvis node["type"] == "Grensesnitt" {
            la gk = komp["grensesnitt_kart"]
            la metodar = []
            la gi: heiltall = 0
            mens gi < lengde(node["barn"]) {
                hvis node["barn"][gi]["type"] == "Metodekrav" { legg_til(metodar, node["barn"][gi]["verdi"]) }
                gi = gi + 1
            }
            gk[node["verdi"]] = metodar
        }
        hvis node["type"] == "Struktur" og har_nokkel(node, "implementerer") {
            legg_til(komp["struktur_impl"], [node["verdi"], node["implementerer"]])
        }
        hvis node["type"] == "Struktur" {
            la sk = komp["struktur_kart"]
            sk[node["verdi"]] = node
        }
        hvis node["type"] == "La" {
            la global_namn = node["verdi"]
            hvis ikkje har_nokkel(komp["global_kart"], global_namn) {
                la globale = komp["global_kart"]
                globale[global_namn] = sann
                legg_til(komp["global_namn"], global_namn)
            }
        }
        // Destrukturering på toppnivå (la [a,b]=… / la {a,b}=…): registrer KVART
        // mål som modul-global, elles feilar seinare funksjonar med «Ukjent variabel».
        hvis node["type"] == "LaDestrukt" og lengde(node["barn"]) > 0 {
            la d_mål = node["barn"][0]
            la d_i: heiltall = 0
            mens d_i < lengde(d_mål["barn"]) {
                la d_namn = d_mål["barn"][d_i]["verdi"]
                hvis ikkje har_nokkel(komp["global_kart"], d_namn) {
                    la d_globale = komp["global_kart"]
                    d_globale[d_namn] = sann
                    legg_til(komp["global_namn"], d_namn)
                }
                d_i = d_i + 1
            }
        }
        hvis node["type"] == "Bruk"
            alias = node["barn"][0]["verdi"]
            hvis alias == node["verdi"]
                alias = siste_moduldel(node["verdi"])
            slutt
            komp["import_alias"][alias] = node["verdi"]
            registrer_importerte_funksjonar(komp, alias, node["verdi"])
            registrer_importutval(komp, node)
        slutt
        i = i + 1
    slutt

    // Grensesnitt-kontrakt: kvar struktur som implementerer eit grensesnitt må ha
    // alle metodane (funksjon Struktur.metode), elles kompileringsfeil.
    la impl_i = 0
    mens impl_i < lengde(komp["struktur_impl"])
        la par = komp["struktur_impl"][impl_i]
        la s_namn = par[0]
        la iface = par[1]
        hvis har_nokkel(komp["grensesnitt_kart"], iface)
            la krav = komp["grensesnitt_kart"][iface]
            la ki = 0
            mens ki < lengde(krav)
                hvis ikkje har_nokkel(fk, s_namn + "." + krav[ki])
                    kast "Grensesnittfeil: " + s_namn + " implementerer " + iface + " men manglar metode " + krav[ki]
                slutt
                ki = ki + 1
            slutt
        slutt
        impl_i = impl_i + 1
    slutt

    // Andre pass: kompiler kvar funksjon
    funk_json_par = []
    test_json_par = []
    // R2/F14: __module_init__ blir emittert når modulen har globalar ELLER
    // toppnivå-setningar (t.d. ein modul som berre skriv ved init). Før vart
    // toppnivå-setningar i ein modul utan globalar stilt kasta.
    la toppnivå_setning = har_toppnivå_setning(komp, ast_program)
    la treng_init = lengde(komp["global_namn"]) > 0 eller toppnivå_setning
    hvis treng_init {
        legg_til(funk_json_par, kompiler_modul_init(komp, ast_program))
    }
    // R2/F14: skriptmodus — hovudmodulen utan start() men med toppnivå-
    // setningar får ein tom start(); toppnivåkoden køyrer som modul-init.
    hvis modul_namn == "__main__" og toppnivå_setning og ikkje har_nokkel(fk, "start") {
        legg_til(funk_json_par, "__main__.start|SEP|{\"name\":\"start\",\"module\":\"__main__\",\"params\":[],\"is_async\":false,\"string_encoding\":\"decoded-v1\",\"code\":[[\"PUSH_CONST\",0],[\"RETURN\"]],\"source_lines\":[],\"source_columns\":[]}")
    }
    j = 0
    mens j < lengde(ast_program["barn"])
        node = ast_program["barn"][j]
        hvis node["type"] == "Funksjon"
            ir_fremdrift("function-start " + json_heiltal_tekst(j) + " " + node["verdi"])
            resultat = kompiler_funksjon(komp, node)
            ir_fremdrift("function-done " + json_heiltal_tekst(j) + " " + node["verdi"])
            legg_til(funk_json_par, resultat)
        slutt
        hvis node["type"] == "Test"
            resultat = kompiler_test(komp, node)
            legg_til(test_json_par, resultat)
        slutt
        // R2/F20: konstruktøren «modul.Namn» for kvar struktur.
        hvis node["type"] == "Struktur"
            legg_til(funk_json_par, kompiler_konstruktør(komp, node))
        slutt
        j = j + 1
    slutt

    // Lambda-hjelpefunksjonar kjem etter toppnivå-funksjonane
    j = 0
    mens j < lengde(komp["lambda_funk_par"])
        legg_til(funk_json_par, komp["lambda_funk_par"][j])
        j = j + 1
    slutt

    // Bygg functions-objekt — saml fragment i liste og join éin gong (O(N) ikkje O(N²))
    funk_deler = []
    k = 0
    mens k < lengde(funk_json_par)
        par = funk_json_par[k]
        // finn |SEP| separator med builtin.index_of
        sep_str = "|SEP|"
        sep_pos = builtin.index_of(par, sep_str)
        hvis sep_pos < 0
            sep_pos = 0
        slutt

        // Bruk slice (O(M) ikkje O(M²))
        fn_key = builtin.slice(par, 0, sep_pos)
        fn_val = builtin.slice(par, sep_pos + 5, lengde(par))

        la del = json_escape_tekst(fn_key) + ":" + fn_val
        legg_til(funk_deler, del)
        k = k + 1
    slutt
    funk_obj = "{" + builtin.join(funk_deler, ",") + "}"

    // Bygg tests-objekt
    test_deler = []
    k = 0
    mens k < lengde(test_json_par)
        legg_til(test_deler, test_json_par[k])
        k = k + 1
    slutt
    test_obj = "[" + builtin.join(test_deler, ",") + "]"

    // Bygg heile bytecode-dokumentet
    entry = modul_namn + ".start"
    doc = "{"
    doc = doc + "\"format\":\"norscode-bytecode-v1\","
    doc = doc + "\"entry\":" + json_escape_tekst(entry) + ","
    la init_liste = []
    hvis treng_init { legg_til(init_liste, modul_namn + ".__module_init__") }
    doc = doc + "\"module_initializers\":" + json_fra_tekstliste(init_liste) + ","
    doc = doc + "\"global_names\":{" + json_escape_tekst(modul_namn) + ":" + json_fra_tekstliste(komp["global_namn"]) + "},"
    doc = doc + "\"imports\":" + json_fra_tekstliste(samla_importar(ast_program)) + ","
    doc = doc + "\"route_handlers\":" + json_fra_ruteliste(web_meta["route_handlers"]) + ","
    doc = doc + "\"dependency_providers\":" + json_fra_map_parliste(web_meta["dependency_providers"]) + ","
    doc = doc + "\"guard_providers\":" + json_fra_map_parliste(web_meta["guard_providers"]) + ","
    doc = doc + "\"request_middlewares\":" + json_fra_tekstliste(web_meta["request_middlewares"]) + ","
    doc = doc + "\"response_middlewares\":" + json_fra_tekstliste(web_meta["response_middlewares"]) + ","
    doc = doc + "\"error_middlewares\":" + json_fra_tekstliste(web_meta["error_middlewares"]) + ","
    doc = doc + "\"startup_hooks\":" + json_fra_tekstliste(web_meta["startup_hooks"]) + ","
    doc = doc + "\"shutdown_hooks\":" + json_fra_tekstliste(web_meta["shutdown_hooks"]) + ","
    doc = doc + "\"tests\":" + test_obj + ","
    doc = doc + "\"functions\":" + funk_obj
    doc = doc + "}"

    returner doc
slutt

// ─── Offentleg API ───────────────────────────────────────────────────────────

funksjon kompiler_til_ncb_json(ast_program, modul_namn)
    returner kompiler_program(ast_program, modul_namn)
slutt

funksjon start()
    returner "ir_to_bytecode_ready"
slutt
