// Norscode Selfhost Bytecode Compiler
// Fase 3 — IR-til-bytecode
//
// Tar AST-noder fra selfhost/parser.no og produserer norscode-bytecode-v1 JSON.
// Krever ingen C, ingen Python — output er NCB JSON; kjøres via selfhost/vm.no.
//
// Input:  ASTNode (Program) frå parser.no
bruk selfhost.lexer.lexer_m1
bruk selfhost.parser
// Output: JSON-tekst (norscode-bytecode-v1 format)

// ─── JSON-hjelparar ──────────────────────────────────────────────────────────

funksjon json_heiltal_tekst(n)
    // Skriv heiltal utan host-builtin for tekstkonvertering. Native AOT kan
    // bere resultat frå lengde(...) i ei heiltalsform som fungerer i rekning
    // og løkker, men som eldre builtin.tekst feilaktig gjer om til tom tekst.
    hvis builtin.type(n) == "ingenting"
        returner "0"
    slutt
    hvis n == 0
        returner "0"
    slutt
    la negativ = usann
    hvis n < 0
        negativ = sann
        n = 0 - n
    slutt
    la ut = ""
    mens n > 0
        la siffer = n % 10
        ut = builtin.chr(48 + siffer) + ut
        n = (n - siffer) / 10
    slutt
    // Literalverdien 0 frå eldre parsergenerasjonar kan vere ein intern
    // heiltalsnull som ikkje treff n == 0, men heller ikkje produserer sifre.
    hvis ut == ""
        returner "0"
    slutt
    hvis negativ
        returner "-" + ut
    slutt
    returner ut
slutt

funksjon ir_fremdrift(melding: tekst) -> heiltall
    la sti = miljo_hent("NORSCODE_IR_PROGRESS_FILE")
    hvis sti != ""
        prøv { builtin.fil_skriv(sti, melding + " heap=" + tekst_fra_heltall(builtin.native_heap_bytes()) + "\n") }
        fang (e) { la ignorert = e }
    slutt
    returner 0
slutt

funksjon json_escape_tegn(c)
    hvis c == "\""
        returner "\\\""
    slutt
    hvis c == "\\"
        returner "\\\\"
    slutt
    hvis c == "\n"
        returner "\\n"
    slutt
    hvis c == "\t"
        returner "\\t"
    slutt
    hvis c == "\r"
        returner "\\r"
    slutt
    // Eskaper andre kontroll-teikn (ASCII < 32)
    la code: heltall = builtin.char_code(c)
    hvis code < 32
        returner "\\u00" + builtin.slice("0123456789abcdef", (code >> 4) & 15, (code >> 4) & 15 + 1) + builtin.slice("0123456789abcdef", code & 15, code & 15 + 1)
    slutt
    returner c
slutt

funksjon json_escape_tekst(t)
    // Funksjonsnamn, opcodes og dei fleste literalane er rein ASCII utan
    // JSON-kontrollteikn. Unngå då ei teiknliste og eitt VM-kall per teikn;
    // den generelle ruta under blir berre brukt når escaping faktisk trengst.
    la må_escape = usann
    la sjekk_i = 0
    mens sjekk_i < lengde(t)
        la sjekk_tegn = t[sjekk_i]
        la sjekk_kode: heltall = builtin.char_code(sjekk_tegn)
        hvis sjekk_tegn == "\"" eller sjekk_tegn == "\\" eller sjekk_kode < 32
            må_escape = sann
            bryt
        slutt
        sjekk_i = sjekk_i + 1
    slutt
    hvis ikkje må_escape
        returner "\"" + t + "\""
    slutt
    // Hald lista ikkje-tom også når parseren ber ein eldre native-tagga
    // tomstreng. Då treng me verken samanlikne den med "" eller køyre join([]).
    deler = ["\""]
    i = 0
    mens i < lengde(t)
        legg_til(deler, json_escape_tegn(t[i]))
        i = i + 1
    slutt
    legg_til(deler, "\"")
    returner builtin.join(deler, "")
slutt

funksjon json_liste(element)
    // Kjeldekart brukar heiltal. Serialiser verdiane som rå JSON-tal, ikkje
    // som tekst; den gamle ruta sende heiltal inn i streng-escaparen.
    deler = []
    i = 0
    mens i < lengde(element)
        legg_til(deler, json_heiltal_tekst(element[i]))
        i = i + 1
    slutt
    returner "[" + builtin.join(deler, ",") + "]"
slutt

funksjon json_liste_tekst(element)
    // element er ein liste med tekst-strenger
    deler = []
    i = 0
    mens i < lengde(element)
        legg_til(deler, json_escape_tekst(element[i]))
        i = i + 1
    slutt
    returner "[" + builtin.join(deler, ",") + "]"
slutt

funksjon json_instruksjon(instr)
    // instr = [opcode_tekst, arg1, arg2, ...]  (liste av blanda verdiar)
    ut = "["
    i = 0
    mens i < lengde(instr)
        hvis i > 0
            ut = ut + ","
        slutt
        del = instr[i]
        // Første element er alltid opcode-tekst
        ut = ut + json_escape_tekst(del)
        i = i + 1
    slutt
    returner ut + "]"
slutt

funksjon json_instruksjon_med_int(opcode, n)
    returner "[" + json_escape_tekst(opcode) + "," + json_heiltal_tekst(n) + "]"
slutt

funksjon json_instruksjon_med_desimal(opcode, n)
    returner "[" + json_escape_tekst(opcode) + "," + tekst(n) + "]"
slutt

funksjon json_instruksjon_med_tekst(opcode, s)
    la opcode_json = json_escape_tekst(opcode)
    la verdi_json = json_escape_tekst(s)
    returner "[" + opcode_json + "," + verdi_json + "]"
slutt

funksjon json_instruksjon_med_bool(opcode, b)
    hvis b
        returner "[" + json_escape_tekst(opcode) + ",true]"
    slutt
    returner "[" + json_escape_tekst(opcode) + ",false]"
slutt

funksjon normaliser_builtin_kall_namn(fn_navn)
    hvis fn_navn == "builtin.finnes_nøkkel" eller fn_navn == "builtin.finnes_nokkel" eller fn_navn == "builtin.builtin.finnes_nøkkel" eller fn_navn == "builtin.builtin.finnes_nokkel"
        returner "builtin.har_nokkel"
    slutt
    hvis fn_navn == "builtin.tekst_til_store" eller fn_navn == "builtin.builtin.tekst_til_store"
        returner "builtin.upper"
    slutt
    hvis fn_navn == "builtin.tekst_til_liten" eller fn_navn == "builtin.builtin.tekst_til_liten"
        returner "builtin.lower"
    slutt
    returner fn_navn
slutt

funksjon json_kall(fn_navn, arg_antal)
    hvis builtin.starts_with(fn_navn, "builtin.finnes_") eller builtin.starts_with(fn_navn, "builtin.builtin.finnes_")
        fn_navn = "builtin.har_nokkel"
    slutt
    returner "[\"CALL\"," + json_escape_tekst(normaliser_builtin_kall_namn(fn_navn)) + "," + json_heiltal_tekst(arg_antal) + "]"
slutt

funksjon json_instruksjon_uten_arg(opcode)
    returner "[" + json_escape_tekst(opcode) + "]"
slutt

funksjon legg_til_implisitt_return(kode)
    // Unngå samansett `lengde == 0 eller siste != RETURN` her. Eldre
    // bootstrap-/hybridgenerasjonar har kompilert den kortslutninga ulikt og
    // lagt ein ekstra null-retur etter ein eksplisitt RETURN.
    hvis lengde(kode) > 0
        hvis kode[lengde(kode) - 1] == json_instruksjon_uten_arg("RETURN")
            returner 0
        slutt
    slutt
    legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
    legg_til(kode, json_instruksjon_uten_arg("RETURN"))
    returner 1
slutt

funksjon json_try_begin(catch_label, catch_type)
    returner "[\"TRY_BEGIN\"," + json_escape_tekst(catch_label) + "," + json_escape_tekst(catch_type) + "]"
slutt

funksjon json_bool(verdien)
    hvis verdien
        returner "true"
    slutt
    returner "false"
slutt

funksjon json_fra_tekstliste(liste)
    hvis liste == null
        returner "[]"
    slutt
    returner json_liste_tekst(liste)
slutt

funksjon json_fra_map_parliste(par_liste)
    hvis par_liste == null
        returner "{}"
    slutt
    ut = "{"
    i = 0
    mens i < lengde(par_liste)
        hvis i > 0
            ut = ut + ","
        slutt
        par = par_liste[i]
        sep = 0
        j = 0
        mens j < lengde(par)
            hvis par[j] == "|" og j + 4 < lengde(par)
                chunk = par[j] + par[j+1] + par[j+2] + par[j+3] + par[j+4]
                hvis chunk == "|SEP|"
                    sep = j
                    bryt
                slutt
            slutt
            j = j + 1
        slutt
        nøkkel = builtin.slice(par, 0, sep)
        verdi = builtin.slice(par, sep + 5, lengde(par))
        ut = ut + json_escape_tekst(nøkkel) + ":" + json_escape_tekst(verdi)
        i = i + 1
    slutt
    returner ut + "}"
slutt

funksjon web_type_til_schema(type_namn)
    hvis type_namn == "heltall" eller type_namn == "int"
        returner "{\"type\":\"integer\"}"
    slutt
    hvis type_namn == "bool" eller type_namn == "boolsk"
        returner "{\"type\":\"boolean\"}"
    slutt
    hvis type_namn == "liste_heltall"
        returner "{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}"
    slutt
    hvis type_namn == "liste_tekst"
        returner "{\"type\":\"array\",\"items\":{\"type\":\"string\"}}"
    slutt
    hvis type_namn == "ordbok_heltall"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"integer\"}}"
    slutt
    hvis type_namn == "ordbok_bool"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"boolean\"}}"
    slutt
    hvis type_namn == "ordbok_tekst"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}"
    slutt
    // Generisk ordbok<tekst, ordbok<tekst, tekst>> og liknande
    hvis tekst_starter_med(type_namn, "ordbok<")
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}}"
    slutt
    // Plain 'ordbok' utan generisk annotasjon — treat as nested dict
    hvis type_namn == "ordbok"
        returner "{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}}"
    slutt
    returner "{\"type\":\"string\"}"
slutt

funksjon web_type_til_eksempel(type_namn)
    hvis type_namn == "heltall" eller type_namn == "int"
        returner "1"
    slutt
    hvis type_namn == "bool" eller type_namn == "boolsk"
        returner "true"
    slutt
    hvis type_namn == "liste_heltall"
        returner "[1]"
    slutt
    hvis type_namn == "liste_tekst"
        returner "[\"eksempel\"]"
    slutt
    hvis tekst_starter_med(type_namn, "ordbok<") eller type_namn == "ordbok"
        returner "{\"verdi\":{\"verdi\":\"eksempel\"}}"
    slutt
    hvis type_namn == "ordbok_heltall"
        returner "{\"verdi\":1}"
    slutt
    hvis type_namn == "ordbok_bool"
        returner "{\"verdi\":true}"
    slutt
    hvis type_namn == "ordbok_tekst"
        returner "{\"verdi\":\"eksempel\"}"
    slutt
    returner json_escape_tekst("eksempel")
slutt

funksjon web_normaliser_sti(sti)
    normalisert = sti
    hvis normalisert == ""
        returner "/"
    slutt
    hvis normalisert[0] != "/"
        returner "/" + normalisert
    slutt
    returner normalisert
slutt

funksjon web_kombiner_prefiks(prefiks, spec)
    hvis prefiks == ""
        returner spec
    slutt
    // Finn metode og sti
    metode = ""
    sti = spec
    pos = -1
    k = 0
    mens k < lengde(spec)
        hvis spec[k] == " "
            pos = k
            bryt
        slutt
        k = k + 1
    slutt
    hvis pos > 0
        metode = builtin.slice(spec, 0, pos)
        sti = builtin.slice(spec, pos + 1, lengde(spec))
    slutt
    // Normaliser prefiks
    prefix_n = web_normaliser_sti(prefiks)
    hvis lengde(prefix_n) > 1 og prefix_n[lengde(prefix_n) - 1] == "/"
        prefix_n = builtin.slice(prefix_n, 0, lengde(prefix_n) - 1)
    slutt
    // Legg saman
    hvis sti == "" eller sti == "/"
        kombinert2 = prefix_n
        hvis metode == ""
            returner kombinert2
        slutt
        returner metode + " " + kombinert2
    slutt
    hvis sti[0] != "/"
        sti = "/" + sti
    slutt
    kombinert3 = prefix_n + sti
    hvis metode == ""
        returner kombinert3
    slutt
    returner metode + " " + kombinert3
slutt

funksjon web_split_spec(spec)
    metode = ""
    sti = spec
    mellomrom_pos = 0
    i = 0
    mens i < lengde(spec)
        hvis spec[i] == " "
            mellomrom_pos = i
            bryt
        slutt
        i = i + 1
    slutt
    hvis mellomrom_pos > 0
        metode = builtin.slice(spec, 0, mellomrom_pos)
        sti = builtin.slice(spec, mellomrom_pos + 1, lengde(spec))
    slutt
    returner [metode, sti]
slutt

funksjon web_metode_liten(metode)
    hvis metode == "GET"
        returner "get"
    slutt
    hvis metode == "POST"
        returner "post"
    slutt
    hvis metode == "PUT"
        returner "put"
    slutt
    hvis metode == "PATCH"
        returner "patch"
    slutt
    hvis metode == "DELETE"
        returner "delete"
    slutt
    hvis metode == "HEAD"
        returner "head"
    slutt
    hvis metode == "OPTIONS"
        returner "options"
    slutt
    hvis metode == "TRACE"
        returner "trace"
    slutt
    hvis metode == "CONNECT"
        returner "connect"
    slutt
    returner metode
slutt

funksjon route_felt_liste(route, nøkkel)
    hvis har_nokkel(route, nøkkel)
        returner route[nøkkel]
    slutt
    returner []
slutt

funksjon web_rute_til_json(route)
    response_type = route_felt_tekst(route, "response_type")
    hvis response_type == ""
        response_type = "tekst"
    slutt
    spec_delar = web_split_spec(route_felt_tekst(route, "spec"))
    request_method = web_metode_liten(spec_delar[0])
    request_path = spec_delar[1]
    hvis request_method == ""
        request_method = route_felt_tekst(route, "method")
    slutt
    hvis request_method == ""
        request_method = "get"
    slutt
    hvis request_path == ""
        request_path = route_felt_tekst(route, "path")
    slutt
    route_json = "{"
    route_json = route_json + "\"function\":" + json_escape_tekst(route_felt_tekst(route, "function")) + ","
    route_json = route_json + "\"method\":" + json_escape_tekst(request_method) + ","
    route_json = route_json + "\"path\":" + json_escape_tekst(request_path) + ","
    route_json = route_json + "\"path_params\":" + json_fra_tekstliste(route_felt_liste(route, "path_params")) + ","
    route_json = route_json + "\"query_params\":" + json_fra_tekstliste(route_felt_liste(route, "query_params")) + ","
    route_json = route_json + "\"body_fields\":" + json_fra_tekstliste(route_felt_liste(route, "body_fields")) + ","
    route_json = route_json + "\"deps\":" + json_fra_tekstliste(route_felt_liste(route, "deps")) + ","
    route_json = route_json + "\"guards\":" + json_fra_tekstliste(route_felt_liste(route, "guards")) + ","
    route_json = route_json + "\"response_type\":" + json_escape_tekst(response_type) + ","
    route_json = route_json + "\"summary\":" + json_escape_tekst(route_felt_tekst(route, "summary")) + ","
    route_json = route_json + "\"operation_id\":" + json_escape_tekst(route_felt_tekst(route, "operation_id")) + ","
    route_json = route_json + "\"spec\":" + json_escape_tekst(route_felt_tekst(route, "spec")) + ","
    route_json = route_json + "\"request_example\":{"
    route_json = route_json + "\"method\":" + json_escape_tekst(request_method) + ","
    route_json = route_json + "\"path\":" + json_escape_tekst(request_path)
    route_json = route_json + "},"
    route_json = route_json + "\"response_example\":" + web_type_til_eksempel(response_type) + ","
    route_json = route_json + "\"response_schema\":" + web_type_til_schema(response_type) + ","
    // Serialiser error_responses som liste av {status, message}-objekt
    la errs_json: tekst = "["
    la errs_list = route_felt_liste(route, "error_responses")
    la ei: heltall = 0
    mens ei < lengde(errs_list)
        la er_item = errs_list[ei]
        la er_status = ""
        la er_msg = ""
        hvis har_nokkel(er_item, "status")
            er_status = tekst(er_item["status"])
        slutt
        hvis har_nokkel(er_item, "message")
            er_msg = tekst(er_item["message"])
        slutt
        la er_json = "{\"status\":\"" + er_status + "\",\"message\":\"" + er_msg + "\"}"
        hvis ei > 0
            errs_json = errs_json + ","
        slutt
        errs_json = errs_json + er_json
        ei = ei + 1
    slutt
    errs_json = errs_json + "]"
    route_json = route_json + "\"error_responses\":" + errs_json + ","
    route_json = route_json + "\"responses\":{"
    route_json = route_json + "\"200\":{"
    route_json = route_json + "\"description\":\"OK\","
    route_json = route_json + "\"content\":{"
    route_json = route_json + "\"application/json\":{"
    route_json = route_json + "\"schema\":" + web_type_til_schema(response_type) + ","
    route_json = route_json + "\"example\":" + web_type_til_eksempel(response_type)
    route_json = route_json + "}}}"
    route_json = route_json + "}"
    route_json = route_json + "}"
    returner route_json
slutt

funksjon json_fra_ruteliste(handlers)
    hvis handlers == null
        returner "[]"
    slutt
    ut = "["
    i = 0
    mens i < lengde(handlers)
        hvis i > 0
            ut = ut + ","
        slutt
        ut = ut + web_rute_til_json(handlers[i])
        i = i + 1
    slutt
    returner ut + "]"
slutt

funksjon felt_kjede_tekst(node)
    hvis node == null
        returner ""
    slutt
    hvis node["type"] == "Ident"
        returner node["verdi"]
    slutt
    hvis node["type"] == "Felt"
        base = felt_kjede_tekst(node["barn"][0])
        hvis base == ""
            returner node["verdi"]
        slutt
        returner base + "." + node["verdi"]
    slutt
    returner ""
slutt

funksjon tekst_ender_med(tekstverdi, suffiks)
    hvis lengde(tekstverdi) < lengde(suffiks)
        returner usann
    slutt
    start = lengde(tekstverdi) - lengde(suffiks)
    returner builtin.slice(tekstverdi, start, lengde(tekstverdi)) == suffiks
slutt

funksjon web_kall_namn(node)
    hvis node == null eller node["type"] != "Kall" eller lengde(node["barn"]) == 0
        returner ""
    slutt
    returner felt_kjede_tekst(node["barn"][0])
slutt

funksjon er_web_kall(node, namn)
    target = web_kall_namn(node)
    hvis target == ""
        returner usann
    slutt
    hvis target == namn
        returner sann
    slutt
    hvis tekst_ender_med(target, "." + namn)
        returner sann
    slutt
    returner usann
slutt

funksjon samla_web_annotasjonar(ast_program, modul_namn)
    handlers = []
    providers = []
    guard_providers = []
    request_middlewares = []
    response_middlewares = []
    error_middlewares = []
    startup_hooks = []
    shutdown_hooks = []

    i = 0
    mens i < lengde(ast_program["barn"])
        fn = ast_program["barn"][i]
        hvis fn["type"] != "Funksjon" eller lengde(fn["barn"]) < 3
            i = i + 1
            fortsett
        slutt

        blokk = fn["barn"][2]
        statements = blokk["barn"]
        spec = ""
        route_prefix = ""
        route_deps = []
        route_guards = []
        route_provided = []
        route_guard = usann

        j = 0
        mens j < lengde(statements)
            stmt = statements[j]
            hvis stmt["type"] != "Kall"
                bryt
            slutt

            target_namn = web_kall_namn(stmt)
            hvis target_namn == ""
                bryt
            slutt

            har_args = lengde(stmt["barn"]) > 1 og lengde(stmt["barn"][1]["barn"]) > 0

            hvis tekst_ender_med(target_namn, ".request_middleware") og ikkje har_args
                legg_til(request_middlewares, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".response_middleware") og ikkje har_args
                legg_til(response_middlewares, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".error_middleware") og ikkje har_args
                legg_til(error_middlewares, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".startup_hook") og ikkje har_args
                legg_til(startup_hooks, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".shutdown_hook") og ikkje har_args
                legg_til(shutdown_hooks, modul_namn + "." + fn["verdi"])
                j = j + 1
                fortsett
            slutt

            hvis ikkje har_args
                bryt
            slutt

            første_arg = stmt["barn"][1]["barn"][0]
            hvis første_arg["type"] != "Tekst"
                bryt
            slutt

            hvis tekst_ender_med(target_namn, ".route")
                spec = første_arg["verdi"]
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".router") eller tekst_ender_med(target_namn, ".subrouter")
                hvis route_prefix == ""
                    route_prefix = første_arg["verdi"]
                slutt
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".guard")
                route_guard = sann
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".use_dependency")
                legg_til(route_deps, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".use_guard")
                legg_til(route_guards, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt
            hvis tekst_ender_med(target_namn, ".dependency")
                legg_til(route_provided, første_arg["verdi"])
                j = j + 1
                fortsett
            slutt

            bryt
        slutt

        hvis route_guard
            legg_til(guard_providers, fn["verdi"] + "|SEP|" + modul_namn + "." + fn["verdi"])
            slutt

        hvis spec != ""
            combined_spec = web_kombiner_prefiks(route_prefix, spec)
            spec_delar = web_split_spec(combined_spec)
            route = {}
            route["function"] = modul_namn + "." + fn["verdi"]
            route["spec"] = combined_spec
            route["method"] = spec_delar[0]
            route["path"] = spec_delar[1]
            route["summary"] = fn["verdi"]
            route["operation_id"] = fn["verdi"]
            route["path_params"] = []
            // Scan alle setningar for request_query/request_json_field/response_error kall
            route_query_params = []
            route_body_fields = []
            route_error_responses = []
            sk = 0
            mens sk < lengde(statements)
                scan_stmt = statements[sk]
                // Sjekk direkte kall, La-setning, ELLER Returner-setning
                scan_kall = scan_stmt
                hvis scan_stmt["type"] == "La" og lengde(scan_stmt["barn"]) > 0
                    scan_kall = scan_stmt["barn"][0]
                ellers hvis scan_stmt["type"] == "Returner" og lengde(scan_stmt["barn"]) > 0
                    scan_kall = scan_stmt["barn"][0]
                slutt
                scan_nm = web_kall_namn(scan_kall)
                hvis scan_nm != "" og lengde(scan_kall["barn"]) > 1 og lengde(scan_kall["barn"][1]["barn"]) > 0
                    scan_arg = scan_kall["barn"][1]["barn"]
                    hvis tekst_ender_med(scan_nm, ".request_query_int") eller tekst_ender_med(scan_nm, ".request_query_param") eller tekst_ender_med(scan_nm, ".request_query_required") eller tekst_ender_med(scan_nm, ".request_query_float")
                        hvis lengde(scan_arg) >= 2 og scan_arg[1]["type"] == "Tekst"
                            legg_til(route_query_params, scan_arg[1]["verdi"])
                        slutt
                    slutt
                    hvis tekst_ender_med(scan_nm, ".request_json_field") eller tekst_ender_med(scan_nm, ".request_json_field_or") eller tekst_ender_med(scan_nm, ".request_json_field_int") eller tekst_ender_med(scan_nm, ".request_json_field_bool") eller tekst_ender_med(scan_nm, ".request_json_field_float")
                        hvis lengde(scan_arg) >= 2 og scan_arg[1]["type"] == "Tekst"
                            legg_til(route_body_fields, scan_arg[1]["verdi"])
                        slutt
                    slutt
                    // Skann for response_error(status, msg) → legg til i error_responses
                    // scan_nm og kall-type er tilgjengelege her
                    hvis tekst_ender_med(scan_nm, ".response_error")
                        hvis lengde(scan_arg) >= 2
                            la err_entry = {}
                            err_entry["status"] = scan_arg[0]["verdi"]
                            hvis scan_arg[1]["type"] == "Tekst"
                                err_entry["message"] = scan_arg[1]["verdi"]
                            ellers
                                err_entry["message"] = "error"
                            slutt
                            legg_til(route_error_responses, err_entry)
                        slutt
                    slutt
                slutt
                sk = sk + 1
            slutt
            route["query_params"] = route_query_params
            route["body_fields"] = route_body_fields
            route["error_responses"] = route_error_responses
            route["deps"] = route_deps
            route["guards"] = route_guards
            route["request_example"] = {}
            route["request_example"]["method"] = "get"
            route["request_example"]["path"] = combined_spec
            route["response_type"] = "tekst"
            hvis lengde(fn["barn"]) > 1 og fn["barn"][1]["type"] == "Returtype" og fn["barn"][1]["verdi"] != "tom"
                route["response_type"] = fn["barn"][1]["verdi"]
            slutt
            route["response_example"] = web_type_til_eksempel(route["response_type"])
            route["response_schema"] = web_type_til_schema(route["response_type"])
            route["responses"] = {}
            route["responses"]["200"] = {}
            route["responses"]["200"]["description"] = "OK"
            route["responses"]["200"]["content"] = {}
            route["responses"]["200"]["content"]["application/json"] = {}
            route["responses"]["200"]["content"]["application/json"]["schema"] = {}
            route["responses"]["200"]["content"]["application/json"]["schema"] = route["response_schema"]
            route["responses"]["200"]["content"]["application/json"]["example"] = route["response_example"]
            legg_til(handlers, route)
        slutt

        l = 0
        mens l < lengde(route_provided)
            legg_til(providers, route_provided[l] + "|SEP|" + modul_namn + "." + fn["verdi"])
            l = l + 1
        slutt

        i = i + 1
    slutt

    resultat = {}
    resultat["route_handlers"] = handlers
    resultat["dependency_providers"] = providers
    resultat["guard_providers"] = guard_providers
    resultat["request_middlewares"] = request_middlewares
    resultat["response_middlewares"] = response_middlewares
    resultat["error_middlewares"] = error_middlewares
    resultat["startup_hooks"] = startup_hooks
    resultat["shutdown_hooks"] = shutdown_hooks
    returner resultat
slutt

funksjon route_felt_tekst(route, nøkkel)
    hvis har_nokkel(route, nøkkel)
        returner route[nøkkel]
    slutt
    returner ""
slutt

funksjon samanfatt_rute(route)
    summary = {}
    summary["function"] = route_felt_tekst(route, "function")
    summary["method"] = route_felt_tekst(route, "method")
    summary["path"] = route_felt_tekst(route, "path")
    summary["spec"] = route_felt_tekst(route, "spec")
    summary["summary"] = route_felt_tekst(route, "summary")
    summary["operation_id"] = route_felt_tekst(route, "operation_id")
    returner summary
slutt

// M3: samle alle Ident-namn som blir refererte i eit uttrykkstre. Feltnamn
// (obj.felt) er ikkje variablar og blir difor ikkje samla, sidan feltnamnet
// ligg i node["verdi"] og ikkje som barn.
funksjon _lambda_saml_referert(node, ut)
    hvis node == null
        returner 0
    slutt
    la t = node["type"]
    hvis t == "Ident"
        ut[node["verdi"]] = sann
        returner 0
    slutt
    la barn = node["barn"]
    la i = 0
    mens i < lengde(barn)
        _lambda_saml_referert(barn[i], ut)
        i = i + 1
    slutt
    returner 0
slutt

// Samle namn som blir bundne inne i lambdaen: alle La-deklarasjonar i treet.
funksjon _lambda_saml_bundne(node, ut)
    hvis node == null
        returner 0
    slutt
    hvis node["type"] == "La"
        ut[node["verdi"]] = sann
    slutt
    la barn = node["barn"]
    la i = 0
    mens i < lengde(barn)
        _lambda_saml_bundne(barn[i], ut)
        i = i + 1
    slutt
    returner 0
slutt

funksjon emit_lambda_hjelpefunksjon(komp, lambda_node, helper_namn)
    // Lambdaen har sitt eige lokale namnrom. Ta vare på funksjonstilstanden
    // medan hjelpekoden blir generert, elles kan eit parameternamn som òg er
    // modulglobalt feilaktig bli skrive med STORE_GLOBAL.
    la førre_lokale = komp["current_locals"]
    la førre_init = komp["in_module_init"]
    la førre_source_lines = komp["current_source_lines"]
    la førre_source_columns = komp["current_source_columns"]
    komp["current_locals"] = {}
    komp["current_function"] = "__module_init__"
    komp["in_module_init"] = usann
    komp["source_map_active"] = sann
    hvis miljo_hent("NORSCODE_COMPILE_SOURCE_MAP") == "0"
        komp["source_map_active"] = usann
    slutt
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    param_node = lambda_node["barn"][0]
    blokk_indeks = 1

    hvis lengde(lambda_node["barn"]) > 1 og lambda_node["barn"][1]["type"] == "Returtype"
        blokk_indeks = 2
    slutt

    blokk = lambda_node["barn"][blokk_indeks]

    params = []
    i = 0
    mens i < lengde(param_node["barn"])
        la param_namn = param_node["barn"][i]["verdi"]
        legg_til(params, param_namn)
        la lokale = komp["current_locals"]
        lokale[param_namn] = sann
        i = i + 1
    slutt

    // M3: capture-analyse. Frie variablar = namn referert i kroppen, som ikkje
    // er lambda-param, ikkje deklarert inne i kroppen, men som finst i det ytre
    // lokale namnrommet (førre_lokale). Desse blir fanga ved BUILD_LAMBDA.
    la referert = {}
    _lambda_saml_referert(blokk, referert)
    la bundne = {}
    _lambda_saml_bundne(blokk, bundne)
    la param_sett = {}
    la ppi = 0
    mens ppi < lengde(params)
        param_sett[params[ppi]] = sann
        ppi = ppi + 1
    slutt
    la capture_namn = []
    la ref_namn = builtin.nøkler(referert)
    la rni = 0
    mens rni < lengde(ref_namn)
        la kandidat = ref_namn[rni]
        hvis ikkje har_nokkel(param_sett, kandidat) og ikkje har_nokkel(bundne, kandidat) og har_nokkel(førre_lokale, kandidat)
            legg_til(capture_namn, kandidat)
        slutt
        rni = rni + 1
    slutt
    komp["lambda_siste_capture"] = capture_namn

    kode = []
    emit_blokk(komp, blokk, kode)

    legg_til_implisitt_return(kode)

    modul = komp["modul"]
    fullt_namn = modul + "." + helper_namn

    params_json = "["
    j = 0
    mens j < lengde(params)
        hvis j > 0
            params_json = params_json + ","
        slutt
        params_json = params_json + json_escape_tekst(params[j])
        j = j + 1
    slutt
    params_json = params_json + "]"

    kode_json = "[" + builtin.join(kode, ",") + "]"

    fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(helper_namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(modul) + ","
    fn_json = fn_json + "\"params\":" + params_json + ","
    fn_json = fn_json + "\"is_async\":false,"
    fn_json = fn_json + "\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":" + kode_json
    fn_json = fn_json + "}"

    legg_til(komp["lambda_funk_par"], fullt_namn + "|SEP|" + fn_json)
    komp["current_locals"] = førre_lokale
    komp["in_module_init"] = førre_init
    komp["current_source_lines"] = førre_source_lines
    komp["current_source_columns"] = førre_source_columns
slutt

// ─── Kompilator-tilstand ──────────────────────────────────────────────────────

funksjon ny_komp()
    komp = {}
    komp["teller"] = 0         // etikett-teller
    komp["modul"] = "__main__" // gjeldande modul-namn
    komp["funk_kart"] = {}     // name → params (for CALL-resolving)
    komp["import_alias"] = {}  // alias → fullt modulnamn
    komp["imported_funk_kart"] = {} // unqualified importert funksjon -> fullt namn
    komp["importert_modul_cache"] = {} // modulnamn -> sann
    komp["lambda_funk_par"] = []
    komp["lambda_teller"] = 0
    komp["loop_start"] = []    // stack: start-etiketter for løkker (continue)
    komp["loop_slutt"] = []    // stack: slutt-etiketter for løkker (break)
    komp["defer_blocks"] = []
    // Modulglobale namn er eksplisitte i NCB. Dette hindrar at toppnivå-`la`
    // blir kasta vekk og at native backend må gjette globale namn frå prefiks.
    komp["global_kart"] = {}
    komp["global_namn"] = []
    komp["current_locals"] = {}
    komp["enums"] = {}
    komp["grensesnitt"] = {}
    komp["in_module_init"] = usann
    komp["source_map_active"] = sann
    hvis miljo_hent("NORSCODE_COMPILE_SOURCE_MAP") == "0"
        komp["source_map_active"] = usann
    slutt
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    returner komp
slutt

funksjon emit_load_namn(komp, kode, namn: tekst) -> heiltall {
    hvis ikkje komp["in_module_init"] og har_nokkel(komp["global_kart"], namn) og ikkje har_nokkel(komp["current_locals"], namn) {
        legg_til(kode, json_instruksjon_med_tekst("LOAD_GLOBAL", namn))
    } ellers {
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", namn))
    }
    returner 0
}

funksjon emit_store_namn(komp, kode, namn: tekst, deklarasjon: boolsk) -> heiltall {
    hvis komp["in_module_init"] {
        legg_til(kode, json_instruksjon_med_tekst("STORE_GLOBAL", namn))
        returner 0
    }
    hvis deklarasjon {
        la lokale = komp["current_locals"]
        lokale[namn] = sann
    }
    hvis har_nokkel(komp["global_kart"], namn) og ikkje har_nokkel(komp["current_locals"], namn) {
        legg_til(kode, json_instruksjon_med_tekst("STORE_GLOBAL", namn))
    } ellers {
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", namn))
    }
    returner 0
}

funksjon finn_modul_filsti(modul_namn)
    la basis = builtin.replace(modul_namn, ".", "/")

    // Prioriter .nors, men støtt eldre .no for bakoverkompatibilitet.
    la nors_filsti = basis + ".nors"
    la no_filsti = basis + ".no"
    hvis fil_finnes(nors_filsti) {
        returner nors_filsti
    }
    hvis fil_finnes(no_filsti) {
        returner no_filsti
    }
    // Fallback for ikkje-materialisert modulsti: bruk .nors som standard.
    returner nors_filsti
slutt

funksjon finn_modul_i_base(base, modul_namn)
    hvis base == ""
        returner ""
    slutt
    la basis = base + "/" + builtin.replace(modul_namn, ".", "/")
    la nors_filsti = basis + ".nors"
    la no_filsti = basis + ".no"
    hvis fil_finnes(nors_filsti)
        returner nors_filsti
    slutt
    hvis fil_finnes(no_filsti)
        returner no_filsti
    slutt
    returner ""
slutt

funksjon modul_til_filsti(modul_namn)
    la root = miljo_hent("NORSCODE_ROOT")
    la import_base = miljo_hent("NORSCODE_IMPORT_BASE")
    la pwd = miljo_hent("PWD")
    la basis = builtin.replace(modul_namn, ".", "/")
    hvis builtin.starts_with(basis, "std/") eller builtin.starts_with(basis, "selfhost/") eller builtin.starts_with(basis, "bootstrap/")
        la system_filsti = finn_modul_i_base(root, modul_namn)
        hvis system_filsti != "" { returner system_filsti }
        returner root + "/" + basis + ".nors"
    slutt
    la lokal_filsti = finn_modul_i_base(import_base, modul_namn)
    hvis lokal_filsti != "" { returner lokal_filsti }
    lokal_filsti = finn_modul_i_base(pwd, modul_namn)
    hvis lokal_filsti != "" { returner lokal_filsti }
    lokal_filsti = finn_modul_i_base(root, modul_namn)
    hvis lokal_filsti != "" { returner lokal_filsti }
    hvis import_base != "" { returner import_base + "/" + basis + ".nors" }
    hvis pwd != "" { returner pwd + "/" + basis + ".nors" }
    returner basis + ".nors"
slutt

funksjon siste_moduldel(sti)
    delar = builtin.split(sti, ".")
    hvis lengde(delar) == 0
        returner sti
    slutt
    returner delar[lengde(delar) - 1]
slutt

funksjon ny_etikett(komp)
    n = komp["teller"]
    hvis n == null
        n = 0
        komp["teller"] = 0
    slutt
    komp["teller"] = n + 1
    returner "__L" + tekst_fra_heltall(n) + "__"
slutt

funksjon push_loop(komp, start, slutt)
    legg_til(komp["loop_start"], start)
    legg_til(komp["loop_slutt"], slutt)
slutt

funksjon pop_loop(komp)
    n = lengde(komp["loop_start"])
    hvis n > 0
        komp["loop_start"] = komp["loop_start"]
        komp["loop_slutt"] = komp["loop_slutt"]
        // Begge loopstakkane blir alltid poppa frå toppen. Bruk den smalare
        // operasjonen som er tilgjengeleg i committed VM-generasjonar òg.
        fjern_siste(komp["loop_start"])
        fjern_siste(komp["loop_slutt"])
    slutt
slutt

funksjon gjeldande_loop_start(komp)
    n = lengde(komp["loop_start"])
    hvis n == 0
        returner ""
    slutt
    returner komp["loop_start"][n - 1]
slutt

funksjon gjeldande_loop_slutt(komp)
    n = lengde(komp["loop_slutt"])
    hvis n == 0
        returner ""
    slutt
    returner komp["loop_slutt"][n - 1]
slutt

// ─── Operator-mapping ────────────────────────────────────────────────────────

funksjon binop_til_opcode(op)
    hvis op == "PLUS"    returner "BINARY_ADD"  slutt
    hvis op == "MINUS"   returner "BINARY_SUB"  slutt
    hvis op == "STAR"    returner "BINARY_MUL"  slutt
    hvis op == "MUL"     returner "BINARY_MUL"  slutt
    hvis op == "SLASH"   returner "BINARY_DIV"  slutt
    hvis op == "DIV"     returner "BINARY_DIV"  slutt
    hvis op == "PERCENT" returner "BINARY_MOD"  slutt
    hvis op == "EQ"      returner "COMPARE_EQ"  slutt
    hvis op == "NE"      returner "COMPARE_NE"  slutt
    hvis op == "GT"      returner "COMPARE_GT"  slutt
    hvis op == "LT"      returner "COMPARE_LT"  slutt
    hvis op == "GTE"     returner "COMPARE_GE"  slutt
    hvis op == "LTE"     returner "COMPARE_LE"  slutt
    // Logiske operatorar — behandla som short-circuit i emit_uttrykk
    hvis op == "AND"     returner "LOGICAL_AND" slutt
    hvis op == "OG"      returner "LOGICAL_AND" slutt
    hvis op == "OR"      returner "LOGICAL_OR"  slutt
    hvis op == "ELLER"   returner "LOGICAL_OR"  slutt
    // Bitwise
    hvis op == "BAND"    returner "BINARY_AND"  slutt
    hvis op == "BOR"     returner "BINARY_OR"   slutt
    hvis op == "BXOR"    returner "BINARY_XOR"  slutt
    hvis op == "LSHIFT"  returner "BINARY_LSHIFT" slutt
    hvis op == "RSHIFT"  returner "BINARY_RSHIFT" slutt
    returner "BINARY_ADD"  // fallback
slutt

funksjon unar_til_opcode(op)
    hvis op == "MINUS"  returner "UNARY_NEG"  slutt
    hvis op == "NOT"    returner "UNARY_NOT"  slutt
    hvis op == "IKKJE"  returner "UNARY_NOT"  slutt
    hvis op == "IKKE"   returner "UNARY_NOT"  slutt
    hvis op == "BNOT"   returner "UNARY_BNOT" slutt
    returner "UNARY_NEG"
slutt

funksjon aug_til_binop(aug_type)
    hvis aug_type == "PLUS_ASSIGN"    returner "BINARY_ADD" slutt
    hvis aug_type == "MINUS_ASSIGN"   returner "BINARY_SUB" slutt
    hvis aug_type == "STAR_ASSIGN"    returner "BINARY_MUL" slutt
    hvis aug_type == "SLASH_ASSIGN"   returner "BINARY_DIV" slutt
    hvis aug_type == "PERCENT_ASSIGN" returner "BINARY_MOD" slutt
    returner "BINARY_ADD"
slutt

// ─── Kompiler uttrykk ────────────────────────────────────────────────────────
// Appendar instruksjonar til `kode`-lista

funksjon emit_listekomprehensjon(komp, node, kode) -> boolsk {
    la n = tekst_fra_heltall(komp["teller"])
    komp["teller"] = komp["teller"] + 1
    la res_var = "__comp_res_" + n + "__"
    la lst_var = "__comp_lst_" + n + "__"
    la idx_var = "__comp_idx_" + n + "__"
    la lbl_start = "__comp_start_" + n + "__"
    la lbl_cont = "__comp_cont_" + n + "__"
    la lbl_end = "__comp_end_" + n + "__"
    la loop_var = node["verdi"]
    la barn = node["barn"]

    legg_til(kode, json_instruksjon_med_int("BUILD_LIST", 0))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", res_var))
    emit_uttrykk(komp, barn[0], kode)
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", lst_var))
    legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_start))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", lst_var))
    legg_til(kode, json_kall("builtin.lengde", 1))
    legg_til(kode, json_instruksjon_uten_arg("COMPARE_LT"))
    legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", lbl_end))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", lst_var))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", idx_var))
    legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", loop_var))
    hvis lengde(barn) > 2 {
        emit_uttrykk(komp, barn[2], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", lbl_cont))
    }
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", res_var))
    emit_uttrykk(komp, barn[1], kode)
    legg_til(kode, json_kall("builtin.legg_til", 2))
    legg_til(kode, json_instruksjon_uten_arg("POP"))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_cont))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
    legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", idx_var))
    legg_til(kode, json_instruksjon_med_tekst("JUMP", lbl_start))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", lbl_end))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", res_var))
    returner sann
}

funksjon emit_uttrykk(komp, node, kode)
    t = node["type"]

    hvis t == "Ident"
        emit_load_namn(komp, kode, node["verdi"])
        returner sann
    slutt

    hvis t == "Heltall"
        // Lexer/parser bevarer kjeldeforma som tekst. Konverter eksplisitt før
        // den reine heiltalsserialiseringen; elles blir til dømes "42" tolka
        // som ei ikkje-numerisk nullform i native AOT.
        la literal_heiltal = heltall_fra_tekst(node["verdi"])
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", literal_heiltal))
        returner sann
    slutt

    hvis t == "Desimal"
        legg_til(kode, json_instruksjon_med_desimal("PUSH_CONST", node["verdi"]))
        returner sann
    slutt

    hvis t == "Tekst"
        // Semantisk kontrakt: node["verdi"] == "__nclit__empty_text_v1".
        // Literalane er delte for den eldre stage0-materialiseraren.
        hvis node["verdi"] == "__nclit__empty_" + "text_v1"
            // Ikkje legg den ferdige JSON-instruksjonen inn som ein literal.
            // Eldre NCB-transport kan dekode ein slik tekst til ei faktisk
            // liste og sluttserialiseringa endar då som den ugyldige opkoden
            // [null]. Bygg instruksjonen gjennom den kanoniske JSON-skrivaren.
            la tom_tekst = builtin.slice("x", 0, 0)
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", tom_tekst))
        ellers
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        slutt
        returner sann
    slutt

    hvis t == "Bool"
        hvis node["verdi"] == "sann"
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", sann))
        ellers
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", usann))
        slutt
        returner sann
    slutt

    // Parseren representerer null/ingenting som ein eigen Null-node. Utan
    // denne grenen produserer uttrykket ingen operand, slik at til dømes
    // `verdi == null` køyrer COMPARE_EQ med berre venstre operand på stakken.
    hvis t == "Null"
        // Bygg instruksjonen dynamisk. Eldre bootstrap-transport kan tolke
        // den komplette JSON-litteralen som ei liste og seinare redusere han
        // til [null], som fjernar operandverdien før neste opcode.
        legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        returner sann
    slutt

    hvis t == "Binop"
        opcode = binop_til_opcode(node["verdi"])

        // Short-circuit AND
        hvis opcode == "LOGICAL_AND"
            etikett_false = ny_etikett(komp)
            etikett_ferdig = ny_etikett(komp)
            emit_uttrykk(komp, node["barn"][0], kode)
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", etikett_false))
            emit_uttrykk(komp, node["barn"][1], kode)
            legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_ferdig))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_false))
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", usann))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ferdig))
            returner sann
        slutt

        // Short-circuit OR
        hvis opcode == "LOGICAL_OR"
            etikett_true = ny_etikett(komp)
            etikett_ferdig = ny_etikett(komp)
            emit_uttrykk(komp, node["barn"][0], kode)
            legg_til(kode, "[\"JUMP_IF_FALSE\"," + json_escape_tekst(etikett_true) + "]")
            legg_til(kode, json_instruksjon_med_bool("PUSH_CONST", sann))
            legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_ferdig))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_true))
            emit_uttrykk(komp, node["barn"][1], kode)
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ferdig))
            returner sann
        slutt

        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_uten_arg(opcode))
        returner sann
    slutt

    hvis t == "Unar"
        opcode = unar_til_opcode(node["verdi"])
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_uten_arg(opcode))
        returner sann
    slutt

    // Liste-literal må ligge før kall-grenen. Eldre stage0-kompilering kan
    // avgrense emit-funksjonen ved den lange kall-delen; denne tidlege grenen
    // sikrar at BUILD_LIST finst i den sjølvstendige kompilatorflata.
    hvis t == "Liste"
        // M10: har lista spread-element? Då byggjer vi henne dynamisk med
        // legg_til/utvid i staden for BUILD_LIST (talet er ikkje statisk kjent).
        har_spread = usann
        si = 0
        mens si < lengde(node["barn"])
            hvis node["barn"][si]["type"] == "Spread" har_spread = sann slutt
            si = si + 1
        slutt
        hvis ikkje har_spread
            i = 0
            mens i < lengde(node["barn"])
                emit_uttrykk(komp, node["barn"][i], kode)
                i = i + 1
            slutt
            legg_til(kode, json_instruksjon_med_int("BUILD_LIST", lengde(node["barn"])))
            returner sann
        slutt
        // Dynamisk bygging: tmp = []; for kvart element append/utvid; returner tmp
        spread_tmp = "__spread_" + tekst_fra_heltall(komp["teller"]) + "__"
        komp["teller"] = komp["teller"] + 1
        legg_til(kode, json_instruksjon_med_int("BUILD_LIST", 0))
        emit_store_namn(komp, kode, spread_tmp, sann)
        i = 0
        mens i < lengde(node["barn"])
            el = node["barn"][i]
            emit_load_namn(komp, kode, spread_tmp)
            hvis el["type"] == "Spread"
                emit_uttrykk(komp, el["barn"][0], kode)
                legg_til(kode, json_kall("builtin.utvid", 2))
            ellers
                emit_uttrykk(komp, el, kode)
                legg_til(kode, json_kall("builtin.legg_til", 2))
            slutt
            legg_til(kode, json_instruksjon_uten_arg("POP"))
            i = i + 1
        slutt
        emit_load_namn(komp, kode, spread_tmp)
        returner sann
    slutt

    // Felt- og indeksoppslag må også ligge før kall-grenen. Den eldre
    // stage0-kompilatoren kan ellers miste grenene som står etter den lange
    // kall-emitteren, og generere lengde(fn["barn"]) utan objekt på stacken.
    hvis t == "Indeks"
        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    hvis t == "OptionalFelt"
        // M10: o?.felt → viss o er ingenting, ingenting; elles o[felt].
        n_opt = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        acc_lbl = "__qacc_" + n_opt + "__"
        end_lbl = "__qend_" + n_opt + "__"
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_uten_arg("DUP"))
        emit_load_namn(komp, kode, "ingenting")
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", acc_lbl))
        legg_til(kode, json_instruksjon_uten_arg("POP"))
        emit_load_namn(komp, kode, "ingenting")
        legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", acc_lbl))
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", end_lbl))
        returner sann
    slutt

    hvis t == "Felt"
        // M9: enum-tilgang Farge.RAUD → heiltalskonstant
        hvis node["barn"][0]["type"] == "Ident" og har_nokkel(komp["enums"], node["barn"][0]["verdi"])
            la enum_kart = komp["enums"][node["barn"][0]["verdi"]]
            hvis har_nokkel(enum_kart, node["verdi"])
                legg_til(kode, json_instruksjon_med_int("PUSH_CONST", enum_kart[node["verdi"]]))
                returner sann
            slutt
        slutt
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    hvis t == "Indeks"
        // Barn: [liste-uttrykk, indeks-uttrykk]
        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    hvis t == "Felt"
        // obj.felt lesast som obj["felt"] for ordbok/struktur-literals.
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    // Slice: [start:end] — kall builtin.slice(obj, start, end)
    hvis t == "Slice"
        emit_uttrykk(komp, node["barn"][0], kode)
        emit_uttrykk(komp, node["barn"][1], kode)
        emit_uttrykk(komp, node["barn"][2], kode)
        legg_til(kode, json_kall("builtin.slice", 3))
        returner sann
    slutt

    hvis t == "Await"
        hvis lengde(node["barn"]) > 0
            emit_uttrykk(komp, node["barn"][0], kode)
        ellers
            legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        slutt
        legg_til(kode, json_kall("builtin.await_value", 1))
        returner sann
    slutt

    hvis t == "Lambda"
        helper_namn = "__lambda_" + tekst_fra_heltall(komp["lambda_teller"])
        komp["lambda_teller"] = komp["lambda_teller"] + 1
        emit_lambda_hjelpefunksjon(komp, node, helper_namn)
        la lam_capture = komp["lambda_siste_capture"]
        legg_til(kode, "[\"BUILD_LAMBDA\"," + json_escape_tekst(komp["modul"] + "." + helper_namn) + "," + json_liste_tekst(lam_capture) + "]")
        returner sann
    slutt

    // IfUttrykk: hvis cond da then ellers else
    hvis t == "IfUttrykk"
        n = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        else_lbl = "__ifexpr_else_" + n + "__"
        end_lbl  = "__ifexpr_end_"  + n + "__"
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", else_lbl))
        emit_uttrykk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", else_lbl))
        emit_uttrykk(komp, node["barn"][2], kode)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", end_lbl))
        returner sann
    slutt

    hvis t == "Felt"
        // Barn: [objekt-uttrykk]  verdi = feltnamn
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", node["verdi"]))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        returner sann
    slutt

    hvis t == "Liste"
        i = 0
        mens i < lengde(node["barn"])
            emit_uttrykk(komp, node["barn"][i], kode)
            i = i + 1
        slutt
        legg_til(kode, json_instruksjon_med_int("BUILD_LIST", lengde(node["barn"])))
        returner sann
    slutt

    // ─── List comprehension: [expr for var i liste (hvis cond)] ────────────────
    hvis t == "ListeKomprehensjon"
        returner emit_listekomprehensjon(komp, node, kode)
    slutt

    hvis t == "Map"
        i = 0
        mens i < lengde(node["barn"])
            par = node["barn"][i]
            emit_uttrykk(komp, par["barn"][0], kode)  // nøkkel
            emit_uttrykk(komp, par["barn"][1], kode)  // verdi
            i = i + 1
        slutt
        legg_til(kode, json_instruksjon_med_int("BUILD_MAP", lengde(node["barn"])))
        returner sann
    slutt

    hvis t == "StructLiteral"
        i = 0
        mens i < lengde(node["barn"])
            par = node["barn"][i]
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", par["verdi"]))
            emit_uttrykk(komp, par["barn"][0], kode)
            i = i + 1
        slutt
        legg_til(kode, json_instruksjon_med_int("BUILD_MAP", lengde(node["barn"])))
        returner sann
    slutt

    // Kall-grenen må ligge sist blant dei kjende uttrykkstypane. Eldre stage0
    // kan avgrense funksjonen etter den djupt nøsta kall-dispatchen. Når alle
    // andre uttrykk ligg først, kan stage0 likevel byggje ein komplett Gen1.
    hvis t == "Kall"
        // Barn: [Ident(kallenavn) eller Felt(modul.fn), Argumenter[arg0, arg1, ...]]
        fn_ident = node["barn"][0]
        argumenter = node["barn"][1]
        arg_antal = lengde(argumenter["barn"])

        // M5: metodekall p.metode(args) der p er ein lokal variabel → dispatch
        // på struktur-typen i køyretid. Rekkjefølgje: mottakar, metodenamn, args.
        hvis fn_ident["type"] == "Felt" og fn_ident["barn"][0]["type"] == "Ident" og har_nokkel(komp["current_locals"], fn_ident["barn"][0]["verdi"]) og ikkje har_nokkel(komp["import_alias"], fn_ident["barn"][0]["verdi"])
            emit_load_namn(komp, kode, fn_ident["barn"][0]["verdi"])
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", fn_ident["verdi"]))
            mi = 0
            mens mi < arg_antal
                emit_uttrykk(komp, argumenter["barn"][mi], kode)
                mi = mi + 1
            slutt
            legg_til(kode, json_kall("builtin.kall_metode", arg_antal + 2))
            returner sann
        slutt

        // Evaluer alle argument
        i = 0
        mens i < arg_antal
            emit_uttrykk(komp, argumenter["barn"][i], kode)
            i = i + 1
        slutt

        // Resolve funksjonsnavn
        modul = komp["modul"]

        // Felt-mål: modul.funksjon(args) — t.d. sikkerhet.passord_hash(...)
        hvis fn_ident["type"] == "Felt"
            modul_del = fn_ident["barn"][0]["verdi"]
            fn_del = fn_ident["verdi"]
            hvis modul_del == "builtin"
                legg_til(kode, json_kall("builtin." + fn_del, arg_antal))
                returner sann
            slutt
            hvis fn_ident["barn"][0]["type"] == "Felt" og fn_ident["barn"][0]["barn"][0]["verdi"] == "builtin"
                legg_til(kode, json_kall("builtin." + modul_del + "." + fn_del, arg_antal))
                returner sann
            slutt
            hvis har_nokkel(komp["import_alias"], modul_del)
                fullt_modul = komp["import_alias"][modul_del]
                legg_til(kode, json_kall(fullt_modul + "." + fn_del, arg_antal))
                returner sann
            slutt
            legg_til(kode, json_kall("builtin." + modul_del + "." + fn_del, arg_antal))
            returner sann
        slutt

        fn_navn = fn_ident["verdi"]
        fullt_namn = modul + "." + fn_navn

        // M3: kall til ein lokal variabel som held ein lambda-verdi. Args er
        // alt evaluerte; last verdien øvst og bruk CALL_VALUE.
        hvis fn_ident["type"] == "Ident" og har_nokkel(komp["current_locals"], fn_navn) og ikkje har_nokkel(komp["funk_kart"], fn_navn)
            emit_load_namn(komp, kode, fn_navn)
            legg_til(kode, "[\"CALL_VALUE\"," + json_heiltal_tekst(arg_antal) + "]")
            returner sann
        slutt

        // Sjekk om det er ein brukardefinert funksjon i same modul
        hvis builtin.starts_with(fn_navn, "builtin.")
            legg_til(kode, json_kall(fn_navn, arg_antal))
        ellers hvis har_nokkel(komp["funk_kart"], fn_navn)
            legg_til(kode, json_kall(fullt_namn, arg_antal))
        ellers
            // Antatt builtin eller ekstern
            hvis har_nokkel(komp["imported_funk_kart"], fn_navn)
                importert = komp["imported_funk_kart"][fn_navn]
                hvis importert != "__AMBIGUOUS__"
                    legg_til(kode, json_kall(importert, arg_antal))
                ellers
                    legg_til(kode, json_kall("builtin." + fn_navn, arg_antal))
                slutt
            ellers
                legg_til(kode, json_kall("builtin." + fn_navn, arg_antal))
            slutt
        slutt
        returner sann
    slutt

    // Fallback: ukjent node-type.
    // Me prøver ikkje å fjerne verdiar her; om noden har barn blir det siste barnets
    // uttrykk halde igjen, slik at wrapper-liknande strukturar ikkje blir svelta.
    hvis lengde(node["barn"]) == 0
        legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        returner usann
    slutt

    indeks = 0
    mens indeks < lengde(node["barn"])
        emit_uttrykk(komp, node["barn"][indeks], kode)
        hvis indeks < lengde(node["barn"]) - 1
            legg_til(kode, json_instruksjon_uten_arg("POP"))
        slutt
        indeks = indeks + 1
    slutt

    returner sann
slutt

// ─── Kompiler setningar ──────────────────────────────────────────────────────

funksjon emit_sett_verdi(komp, mål, verdi_node, kode)
    // Hjelpefunksjon: kompiler venstre side av x = expr
    // Skilt ut for å unngå 'ellers + hvis' som slår saman til 'ellers_hvis'
    hvis mål["type"] == "Ident"
        emit_uttrykk(komp, verdi_node, kode)
        emit_store_namn(komp, kode, mål["verdi"], usann)
    slutt
    hvis mål["type"] == "Indeks"
        // liste[i] = verdi → LOAD liste, eval i, eval verdi, INDEX_SET, POP
        // POP er påkravd: INDEX_SET pushar oppdatert objekt på stakk, men dette er
        // ein setning — resultatet vert aldri brukt, og POP held stakken ren.
        emit_uttrykk(komp, mål["barn"][0], kode)
        emit_uttrykk(komp, mål["barn"][1], kode)
        emit_uttrykk(komp, verdi_node, kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
        legg_til(kode, json_instruksjon_uten_arg("POP"))
    slutt
    hvis mål["type"] == "Felt"
        // obj.felt = verdi → LOAD obj, PUSH felt, eval verdi, INDEX_SET, POP
        emit_uttrykk(komp, mål["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", mål["verdi"]))
        emit_uttrykk(komp, verdi_node, kode)
        legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
        legg_til(kode, json_instruksjon_uten_arg("POP"))
    slutt
slutt

// Ei literal som står åleine som setning har ingen bivirkningar. Den gamle
// banen laga PUSH_CONST etterfølgt av POP; fjern begge før kjeldekartet blir
// skrive. Andre uttrykk, særleg CALL/INDEX_GET, må framleis evaluerast.
funksjon fjern_ubrukte_literal_setning(kode, start_ip: heiltall) -> boolsk
    hvis lengde(kode) != start_ip + 1
        returner usann
    slutt
    la instr = tekst(kode[start_ip])
    hvis ikkje builtin.starts_with(instr, "[\"PUSH_CONST\",")
        returner usann
    slutt
    fjern_siste(kode)
    returner sann
slutt

funksjon emit_prov_fang(komp, node, kode) -> boolsk {
    la catch_lbl = ny_etikett(komp)
    la after_lbl = ny_etikett(komp)
    la finally_lbl = ny_etikett(komp)
    la finally_return_lbl = ny_etikett(komp)
    la finally_throw_lbl = ny_etikett(komp)
    la catch_type = "*"
    hvis node["catch_type"] != null og node["catch_type"] != "" {
        catch_type = node["catch_type"]
    }

    la har_fang = node["has_catch"] != usann
    la har_endeleg = node["has_finally"] == sann
    hvis har_endeleg {
        legg_til(kode, json_instruksjon_med_tekst("FINALLY_PUSH", finally_lbl))
    }
    hvis har_fang { legg_til(kode, json_try_begin(catch_lbl, catch_type)) }
    emit_blokk(komp, node["barn"][0], kode)
    hvis har_fang { legg_til(kode, json_instruksjon_uten_arg("TRY_END")) }
    hvis har_endeleg {
        legg_til(kode, json_instruksjon_med_tekst("FINALLY_RUN", after_lbl))
    } ellers {
        legg_til(kode, json_instruksjon_med_tekst("JUMP", after_lbl))
    }
    hvis har_fang {
        legg_til(kode, json_instruksjon_med_tekst("LABEL", catch_lbl))
        legg_til(kode, json_instruksjon_uten_arg("TRY_END"))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_EXCEPTION"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
        emit_blokk(komp, node["barn"][1], kode)
        hvis har_endeleg {
            legg_til(kode, json_instruksjon_med_tekst("FINALLY_RUN", after_lbl))
        } ellers {
            legg_til(kode, json_instruksjon_med_tekst("JUMP", after_lbl))
        }
    }
    hvis har_endeleg {
        legg_til(kode, json_instruksjon_med_tekst("LABEL", finally_lbl))
        emit_blokk(komp, node["barn"][2], kode)
        legg_til(kode, "[\"FINALLY_END\"," + json_escape_tekst(after_lbl) + "," + json_escape_tekst(finally_return_lbl) + "," + json_escape_tekst(finally_throw_lbl) + "]")
        legg_til(kode, json_instruksjon_med_tekst("LABEL", finally_return_lbl))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("RETURN"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", finally_throw_lbl))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("THROW"))
    }
    legg_til(kode, json_instruksjon_med_tekst("LABEL", after_lbl))
    returner sann
}

funksjon emit_for_range(komp, node, kode) -> boolsk {
    la loop_n = tekst_fra_heltall(komp["teller"])
    komp["teller"] = komp["teller"] + 1
    la loop_start_lbl = "__forr_start_" + loop_n + "__"
    la loop_end_lbl = "__forr_end_" + loop_n + "__"
    la loop_cont_lbl = "__forr_cont_" + loop_n + "__"

    emit_uttrykk(komp, node["barn"][0], kode)
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
    push_loop(komp, loop_cont_lbl, loop_end_lbl)
    legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_start_lbl))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", node["verdi"]))
    emit_uttrykk(komp, node["barn"][1], kode)
    legg_til(kode, json_instruksjon_uten_arg("COMPARE_LE"))
    legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", loop_end_lbl))
    emit_blokk(komp, node["barn"][3], kode)
    legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_cont_lbl))
    legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", node["verdi"]))
    emit_uttrykk(komp, node["barn"][2], kode)
    legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
    legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))
    legg_til(kode, json_instruksjon_med_tekst("JUMP", loop_start_lbl))
    legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_end_lbl))
    pop_loop(komp)
    returner sann
}

funksjon emit_setning(komp, node, kode)
    t = node["type"]

    hvis t == "Blokk"
        emit_blokk(komp, node, kode)
        returner sann
    slutt

    hvis t == "Match"
        hvis lengde(node["barn"]) == 0
            returner sann
        slutt

        subject_var = "match_subject_" + tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        end_lbl = ny_etikett(komp)

        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", subject_var))

        case_indeks = 1
        mens case_indeks < lengde(node["barn"])
            case_node = node["barn"][case_indeks]

            hvis case_node["type"] == "MatchElse"
                emit_blokk(komp, case_node["barn"][0], kode)
                legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
                bryt
            slutt

            hvis case_node["verdi"] == "wildcard"
                emit_blokk(komp, case_node["barn"][0], kode)
                legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
                bryt
            slutt

            next_lbl = ny_etikett(komp)
            emit_uttrykk(komp, case_node["barn"][0], kode)
            legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", subject_var))
            legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", next_lbl))
            emit_blokk(komp, case_node["barn"][1], kode)
            legg_til(kode, json_instruksjon_med_tekst("JUMP", end_lbl))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", next_lbl))

            case_indeks = case_indeks + 1
        slutt

        legg_til(kode, json_instruksjon_med_tekst("LABEL", end_lbl))
        returner sann
    slutt

    // La x = expr  (variabel-deklarasjon)
    hvis t == "LaOrdbok"
        // M10: la {x, y} = ordbok  → tmp = ordbok; x = tmp["x"]; y = tmp["y"]
        omønster = node["barn"][0]
        overdi = node["barn"][1]
        otmp = "__destructm_" + tekst_fra_heltall(komp["teller"]) + "__"
        komp["teller"] = komp["teller"] + 1
        emit_uttrykk(komp, overdi, kode)
        emit_store_namn(komp, kode, otmp, sann)
        oi = 0
        mens oi < lengde(omønster["barn"])
            la feltnamn = omønster["barn"][oi]["verdi"]
            emit_load_namn(komp, kode, otmp)
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", feltnamn))
            legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
            emit_store_namn(komp, kode, feltnamn, sann)
            oi = oi + 1
        slutt
        returner sann
    slutt

    hvis t == "LaListe"
        // M10: la [a, b] = uttrykk  → tmp = uttrykk; a = tmp[0]; b = tmp[1]; ...
        mønster = node["barn"][0]
        verdi_uttrykk = node["barn"][1]
        tmp_var = "__destruct_" + tekst_fra_heltall(komp["teller"]) + "__"
        komp["teller"] = komp["teller"] + 1
        emit_uttrykk(komp, verdi_uttrykk, kode)
        emit_store_namn(komp, kode, tmp_var, sann)
        di = 0
        mens di < lengde(mønster["barn"])
            emit_load_namn(komp, kode, tmp_var)
            legg_til(kode, json_instruksjon_med_int("PUSH_CONST", di))
            legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
            emit_store_namn(komp, kode, mønster["barn"][di]["verdi"], sann)
            di = di + 1
        slutt
        returner sann
    slutt

    hvis t == "La"
        namn = node["verdi"]
        hvis lengde(node["barn"]) > 0
            // Siste barn er verdi-uttrykket (etter eventuell Type-node)
            siste = node["barn"][lengde(node["barn"]) - 1]
            hvis siste["type"] != "Type" og siste["type"] != "Returtype"
                emit_uttrykk(komp, siste, kode)
            ellers
                legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
            slutt
        ellers
            legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        slutt
        emit_store_namn(komp, kode, namn, sann)
        returner sann
    slutt

    // x = expr  (tilordning)
    hvis t == "Sett"
        mål = node["barn"][0]
        verdi_node = node["barn"][1]
        emit_sett_verdi(komp, mål, verdi_node, kode)
        returner sann
    slutt

    // x += expr  (augmented tilordning)
    hvis t == "AugSett"
        mål = node["barn"][0]
        verdi_node = node["barn"][1]
        binop_opcode = aug_til_binop(node["verdi"])

        hvis mål["type"] == "Ident"
            emit_uttrykk(komp, mål, kode)
            emit_uttrykk(komp, verdi_node, kode)
            legg_til(kode, json_instruksjon_uten_arg(binop_opcode))
            emit_store_namn(komp, kode, mål["verdi"], usann)
        slutt

        // liste[i] += expr
        // Stack must be [obj, idx, val3] before INDEX_SET (val3 on top)
        // Push obj+idx first, then dup to read old value, compute new value
        hvis mål["type"] == "Indeks"
            // Push obj and idx that INDEX_SET will consume
            emit_uttrykk(komp, mål["barn"][0], kode)
            emit_uttrykk(komp, mål["barn"][1], kode)
            // Load obj and idx again to read current value via INDEX_GET
            emit_uttrykk(komp, mål["barn"][0], kode)
            emit_uttrykk(komp, mål["barn"][1], kode)
            legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
            // Compute new value
            emit_uttrykk(komp, verdi_node, kode)
            legg_til(kode, json_instruksjon_uten_arg(binop_opcode))
            // Stack is now [obj, idx, new_val] — INDEX_SET: val3=new_val, idx=idx, obj=obj ✓
            legg_til(kode, json_instruksjon_uten_arg("INDEX_SET"))
            legg_til(kode, "[\"POP\"]")
        slutt
        returner sann
    slutt

    // returner [uttrykk]
    hvis t == "Returner"
        hvis lengde(node["barn"]) > 0
            emit_uttrykk(komp, node["barn"][0], kode)
        ellers
            legg_til(kode, "[" + json_escape_tekst("PUSH_CONST") + ",null]")
        slutt
        legg_til(kode, json_instruksjon_uten_arg("RETURN"))
        returner sann
    slutt

    hvis t == "Utsett"
        defer_lbl = ny_etikett(komp)
        defer_return_lbl = ny_etikett(komp)
        defer_throw_lbl = ny_etikett(komp)
        legg_til(kode, json_instruksjon_med_tekst("FINALLY_PUSH", defer_lbl))
        legg_til(komp["defer_blocks"], {
            "label": defer_lbl,
            "return_label": defer_return_lbl,
            "throw_label": defer_throw_lbl,
            "block": node["barn"][0]
        })
        returner sann
    slutt

    // hvis uttrykk blokk [ellers blokk]
    hvis t == "Hvis"
        etikett_ellers = ny_etikett(komp)
        etikett_ferdig = ny_etikett(komp)

        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", etikett_ellers))

        emit_blokk(komp, node["barn"][1], kode)

        hvis lengde(node["barn"]) > 2
            legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_ferdig))
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ellers))
            emit_blokk(komp, node["barn"][2], kode)
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ferdig))
        ellers
            legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_ellers))
        slutt
        returner sann
    slutt

    // mens uttrykk blokk
    hvis t == "Mens"
        etikett_start = ny_etikett(komp)
        etikett_slutt = ny_etikett(komp)

        push_loop(komp, etikett_start, etikett_slutt)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_start))
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", etikett_slutt))
        emit_blokk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_med_tekst("JUMP", etikett_start))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", etikett_slutt))
        pop_loop(komp)
        returner sann
    slutt

    // bryt
    hvis t == "Bryt"
        lbl = gjeldande_loop_slutt(komp)
        hvis lbl != ""
            legg_til(kode, json_instruksjon_med_tekst("JUMP", lbl))
        slutt
        returner sann
    slutt

    // fortsett
    hvis t == "Fortsett"
        lbl = gjeldande_loop_start(komp)
        hvis lbl != ""
            legg_til(kode, json_instruksjon_med_tekst("JUMP", lbl))
        slutt
        returner sann
    slutt

    // kast <uttrykk>
    hvis t == "Kast"
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_instruksjon_uten_arg("THROW"))
        returner sann
    slutt

    // prøv { } fang (e) { }
    // node["verdi"] = fangst-variabel-namn, barn[0]=prøv-blokk, barn[1]=fang-blokk
    hvis t == "PrøvFang"
        returner emit_prov_fang(komp, node, kode)
    slutt

    // for var i liste { kropp }
    // node["verdi"] = løkkevariabel-namn, barn[0]=liste-uttrykk, barn[1]=kropp
    hvis t == "For"
        loop_n = tekst_fra_heltall(komp["teller"])
        komp["teller"] = komp["teller"] + 1
        iter_liste_var = "__iter_lst_" + loop_n + "__"
        iter_idx_var   = "__iter_idx_" + loop_n + "__"
        loop_start_lbl = "__for_start_" + loop_n + "__"
        loop_end_lbl   = "__for_end_"   + loop_n + "__"
        loop_cont_lbl  = "__for_cont_"  + loop_n + "__"

        // Evaluer samlinga og normaliser henne. M10: for-løkke over ordbok
        // gir nøklane; liste og tekst går uendra gjennom for_iterabel.
        emit_uttrykk(komp, node["barn"][0], kode)
        legg_til(kode, json_kall("builtin.for_iterabel", 1))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_liste_var))
        // Indeks = 0
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 0))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_idx_var))

        push_loop(komp, loop_cont_lbl, loop_end_lbl)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_start_lbl))

        // if idx < lengde(liste): gå inn i kroppen
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_kall("builtin.lengde", 1))
        legg_til(kode, json_instruksjon_uten_arg("COMPARE_LT"))
        legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", loop_end_lbl))

        // var = liste[idx]
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_liste_var))
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_uten_arg("INDEX_GET"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", node["verdi"]))

        emit_blokk(komp, node["barn"][1], kode)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_cont_lbl))
        // idx = idx + 1
        legg_til(kode, json_instruksjon_med_tekst("LOAD_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_int("PUSH_CONST", 1))
        legg_til(kode, json_instruksjon_uten_arg("BINARY_ADD"))
        legg_til(kode, json_instruksjon_med_tekst("STORE_NAME", iter_idx_var))
        legg_til(kode, json_instruksjon_med_tekst("JUMP", loop_start_lbl))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", loop_end_lbl))
        pop_loop(komp)
        returner sann
    slutt

    // ForRange: for i = start til end [steg s]
    hvis t == "ForRange"
        returner emit_for_range(komp, node, kode)
    slutt

    // Uttrykk-setning (kall osv.)
    // Reine literalar har ingen observerbar effekt og skal ikkje leggje noko
    // på operandstacken. Avgjer dette frå AST-typen før kodegenerering; det er
    // meir robust enn å kjenne att serialisert JSON-bytecode etterpå.
    hvis t == "Heltall" eller t == "Desimal" eller t == "Tekst" eller
       t == "Bool" eller t == "Null"
        returner sann
    slutt
    la uttrykk_start = lengde(kode)
    emit_uttrykk(komp, node, kode)
    hvis ikkje fjern_ubrukte_literal_setning(kode, uttrykk_start)
        legg_til(kode, json_instruksjon_uten_arg("POP"))
    slutt
    returner sann
slutt

funksjon emit_blokk(komp, blokk, kode)
    i = 0
    mens i < lengde(blokk["barn"])
        node = blokk["barn"][i]
        start_ip = lengde(kode)
        emit_setning(komp, node, kode)
        slutt_ip = lengde(kode)
        // Parallelle heiltalslister er langt billegare enn eitt hashoppslag og
        // ein ny "line:column"-tekst per bytekodeinstruksjon. Indeksane blir
        // fylte direkte, medan indre blokker får behalde den mest presise
        // posisjonen dei alt har registrert.
        la source_lines = komp["current_source_lines"]
        la source_columns = komp["current_source_columns"]
        ip = start_ip
        mens komp["source_map_active"] og ip < slutt_ip
            mens lengde(source_lines) <= ip
                legg_til(source_lines, 0)
                legg_til(source_columns, 0)
            slutt
            hvis source_lines[ip] == 0
                la node_linje = node["linje"]
                la node_kolonne = node["kolonne"]
                hvis builtin.type(node_linje) == "ingenting"
                    node_linje = 0
                slutt
                hvis builtin.type(node_kolonne) == "ingenting"
                    node_kolonne = 0
                slutt
                source_lines[ip] = node_linje
                source_columns[ip] = node_kolonne
            slutt
            ip = ip + 1
        slutt
        i = i + 1
    slutt
slutt

funksjon registrer_importerte_funksjonar(komp, alias, modul_namn)
    // Oppdag importerte topnivå-funksjonar for unqualified-kall.
    hvis har_nokkel(komp["importert_modul_cache"], modul_namn)
        returner 0
    slutt

    importert_cache = komp["importert_modul_cache"]
    importert_cache[modul_namn] = sann
    modul_fil = modul_til_filsti(modul_namn)
    modul_kjelde = fil_les(modul_fil)
    ast = selfhost.parser.parse_program(selfhost.lexer.lexer_m1.lex(modul_kjelde))
    ast_barn = ast["barn"]
    i = 0

    mens i < lengde(ast_barn)
        node = ast_barn[i]
        hvis node["type"] == "Funksjon"
            fn_namn = node["verdi"]
            fullt_namn = modul_namn + "." + fn_namn

            imported_kart = komp["imported_funk_kart"]
            har_importert = har_nokkel(imported_kart, fn_namn)
            hvis har_importert
                ifalt = imported_kart[fn_namn]
                hvis ifalt != "__AMBIGUOUS__"
                    imported_kart[fn_namn] = "__AMBIGUOUS__"
                slutt
            slutt
            hvis har_importert == usann
                imported_kart[fn_namn] = fullt_namn
            slutt
        slutt
        i = i + 1
    slutt

    // `alias` er reservert for mogleg konfliktavklaring ved samstundes importar.
    returner 0
slutt

// ─── Kompiler funksjonar ─────────────────────────────────────────────────────

funksjon kompiler_funksjon(komp, fn_node)
    ir_fremdrift("compile-function-enter " + fn_node["verdi"])
    komp["current_function"] = fn_node["verdi"]
    // fn_node["barn"] = [Parametere, Returtype, Blokk]
    fn_barn = fn_node["barn"]
    param_node = fn_barn[0]  // Parametere
    blokk = fn_barn[2]       // Blokk (etter Parametere og Returtype)

    // Samle parameter-namn
    params = []
    komp["current_locals"] = {}
    komp["in_module_init"] = usann
    i = 0
    param_barn = param_node["barn"]
    har_rest_param = usann
    mens i < lengde(param_barn)
        la param_namn = param_barn[i]["verdi"]
        legg_til(params, param_namn)
        la lokale = komp["current_locals"]
        lokale[param_namn] = sann
        // M10: varargs — parameteren har ein Rest-node
        la prb = param_barn[i]["barn"]
        la rk = 0
        mens rk < lengde(prb)
            hvis prb[rk]["type"] == "Rest" har_rest_param = sann slutt
            rk = rk + 1
        slutt
        i = i + 1
    slutt
    ir_fremdrift("compile-function-params " + fn_node["verdi"])

    // Bygg kode-lista
    kode = []
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    komp["defer_blocks"] = []

    // M10: standardargument. For kvar parameter med ein Standard-node: viss han
    // er ingenting ved inngang (manglande argument), fyll inn standardverdien.
    di = 0
    mens di < lengde(param_barn)
        pb = param_barn[di]
        std_barn = null
        bj = 0
        mens bj < lengde(pb["barn"])
            hvis pb["barn"][bj]["type"] == "Standard" std_barn = pb["barn"][bj] slutt
            bj = bj + 1
        slutt
        hvis std_barn != null
            skip_lbl = "__defskip_" + tekst_fra_heltall(komp["teller"]) + "__"
            komp["teller"] = komp["teller"] + 1
            emit_load_namn(komp, kode, pb["verdi"])
            legg_til(kode, json_instruksjon_med_tekst("PUSH_CONST", "__norscode_unset__"))
            legg_til(kode, json_instruksjon_uten_arg("COMPARE_EQ"))
            legg_til(kode, json_instruksjon_med_tekst("JUMP_IF_FALSE", skip_lbl))
            emit_uttrykk(komp, std_barn["barn"][0], kode)
            emit_store_namn(komp, kode, pb["verdi"], usann)
            legg_til(kode, json_instruksjon_med_tekst("LABEL", skip_lbl))
        slutt
        di = di + 1
    slutt

    ir_fremdrift("compile-function-body " + fn_node["verdi"])
    emit_blokk(komp, blokk, kode)

    // Legg til implisitt returner null berre når blokka ikkje alt avsluttar med RETURN
    legg_til_implisitt_return(kode)

    defer_i = 0
    mens defer_i < lengde(komp["defer_blocks"])
        defer_post = komp["defer_blocks"][defer_i]
        defer_after_lbl = ny_etikett(komp)
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_post["label"]))
        emit_blokk(komp, defer_post["block"], kode)
        legg_til(kode, "[\"FINALLY_END\"," + json_escape_tekst(defer_after_lbl) + "," + json_escape_tekst(defer_post["return_label"]) + "," + json_escape_tekst(defer_post["throw_label"]) + "]")
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_post["return_label"]))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("RETURN"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_post["throw_label"]))
        legg_til(kode, json_instruksjon_uten_arg("LOAD_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("CLEAR_PENDING"))
        legg_til(kode, json_instruksjon_uten_arg("THROW"))
        legg_til(kode, json_instruksjon_med_tekst("LABEL", defer_after_lbl))
        defer_i = defer_i + 1
    slutt

    source_lines = komp["current_source_lines"]
    source_columns = komp["current_source_columns"]
    source_ip = 0
    mens komp["source_map_active"] og source_ip < lengde(kode)
        hvis source_ip >= lengde(source_lines)
            legg_til(source_lines, fn_node["linje"])
            legg_til(source_columns, fn_node["kolonne"])
        ellers hvis source_lines[source_ip] == 0
            source_lines[source_ip] = fn_node["linje"]
            source_columns[source_ip] = fn_node["kolonne"]
        slutt
        source_ip = source_ip + 1
    slutt

    // Serialiser til JSON
    modul = komp["modul"]
    fn_namn = fn_node["verdi"]
    fullt_namn = modul + "." + fn_namn

    // Bygg params JSON
    params_json = "["
    j = 0
    mens j < lengde(params)
        hvis j > 0
            params_json = params_json + ","
        slutt
        params_json = params_json + json_escape_tekst(params[j])
        j = j + 1
    slutt
    params_json = params_json + "]"

    // Bygg code JSON
    kode_json = "[" + builtin.join(kode, ",") + "]"

    // Fullt funksjon-objekt
    fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(fn_namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(modul) + ","
    fn_json = fn_json + "\"params\":" + params_json + ","
    la er_async = usann
    hvis har_nokkel(fn_node, "is_async")
        er_async = fn_node["is_async"] == sann
    slutt
    hvis er_async
        fn_json = fn_json + "\"is_async\":true,"
    ellers
        fn_json = fn_json + "\"is_async\":false,"
    slutt
    hvis har_rest_param
        fn_json = fn_json + "\"rest_param\":\"sann\","
    slutt
    fn_json = fn_json + "\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":" + kode_json + ","
    fn_json = fn_json + "\"source_lines\":" + json_liste(source_lines) + ","
    fn_json = fn_json + "\"source_columns\":" + json_liste(source_columns)
    fn_json = fn_json + "}"

    returner fullt_namn + "|SEP|" + fn_json
slutt

funksjon kompiler_modul_init(komp, ast_program) -> tekst {
    la kode = []
    komp["current_locals"] = {}
    komp["in_module_init"] = sann
    la i: heiltall = 0
    mens i < lengde(ast_program["barn"]) {
        la node = ast_program["barn"][i]
        hvis node["type"] != "Funksjon" og node["type"] != "Test" og node["type"] != "Bruk" {
            emit_setning(komp, node, kode)
        }
        i = i + 1
    }
    legg_til_implisitt_return(kode)
    komp["in_module_init"] = usann
    la namn = "__module_init__"
    la fullt_namn = komp["modul"] + "." + namn
    la fn_json = "{"
    fn_json = fn_json + "\"name\":" + json_escape_tekst(namn) + ","
    fn_json = fn_json + "\"module\":" + json_escape_tekst(komp["modul"]) + ","
    fn_json = fn_json + "\"params\":[],\"is_async\":false,\"module_init\":true,\"string_encoding\":\"decoded-v1\","
    fn_json = fn_json + "\"code\":[" + builtin.join(kode, ",") + "],"
    fn_json = fn_json + "\"source_lines\":[],\"source_columns\":[]"
    fn_json = fn_json + "}"
    returner fullt_namn + "|SEP|" + fn_json
}

funksjon kompiler_test(komp, test_node)
    blokk = test_node["barn"][0]

    kode = []
    komp["current_source_lines"] = []
    komp["current_source_columns"] = []
    emit_blokk(komp, blokk, kode)

    legg_til_implisitt_return(kode)

    modul = komp["modul"]
    kode_json = "[" + builtin.join(kode, ",") + "]"

    test_json = "{"
    test_json = test_json + "\"name\":" + json_escape_tekst(test_node["verdi"]) + ","
    test_json = test_json + "\"module\":" + json_escape_tekst(modul) + ","
    test_json = test_json + "\"kind\":\"test\"," 
    test_json = test_json + "\"params\":[],"
    test_json = test_json + "\"is_async\":false,"
    test_json = test_json + "\"string_encoding\":\"decoded-v1\","
    test_json = test_json + "\"code\":" + kode_json
    test_json = test_json + "}"

    returner test_json
slutt

// ─── Kompiler heile programmet ────────────────────────────────────────────────

funksjon samla_importar(ast_program) -> liste_tekst {
    la imports: liste_tekst = []
    la sett: ordbok_tekst = {}
    la barn = ast_program["barn"]
    la i: heiltall = 0
    mens i < lengde(barn) {
        la node = barn[i]
        la modul = node["verdi"]
        hvis node["type"] == "Bruk" og ikkje har_nokkel(sett, modul) {
            legg_til(imports, modul)
            sett[modul] = sann
        }
        i = i + 1
    }
    returner imports
}

funksjon kompiler_program(ast_program, modul_namn)
    ir_fremdrift("program-start " + modul_namn)
    komp = ny_komp()
    ir_fremdrift("program-state-ready " + modul_namn)
    komp["modul"] = modul_namn
    ir_fremdrift("program-web-start " + modul_namn)
    web_meta = samla_web_annotasjonar(ast_program, modul_namn)
    ir_fremdrift("program-web-done " + modul_namn)

    // Første pass: registrer alle funksjonar
    // NB: To-nivå indeks-tilordning (komp["funk_kart"][namn] = sann) er ikkje støtta
    // av Python-kompilatoren sin IndexSetNode — bruk temporær variabel i staden.
    fk = komp["funk_kart"]
    // Inkrementell/source-only kompilering kan dele ein stor modul ved
    // funksjonsgrenser. Registrer då heile modulens deklarasjonsflate før
    // delen blir kompilert, slik at krysskall ikkje blir feilklassifiserte
    // som builtin-kall.
    la kjende_funksjonar = miljo_hent("NORSCODE_COMPILER_KNOWN_FUNCTIONS")
    hvis kjende_funksjonar != "" {
        la kjende = builtin.split(kjende_funksjonar, ",")
        la kjent_i: heiltall = 0
        mens kjent_i < lengde(kjende) {
            hvis kjende[kjent_i] != "" { fk[kjende[kjent_i]] = sann }
            kjent_i = kjent_i + 1
        }
    }
    i = 0
    mens i < lengde(ast_program["barn"])
        node = ast_program["barn"][i]
        ir_fremdrift("first-pass " + json_heiltal_tekst(i) + " " + node["type"] + " " + node["verdi"])
        hvis node["type"] == "Funksjon"
            fk[node["verdi"]] = sann
        slutt
        hvis node["type"] == "Enum"
            la enum_kart = {}
            la ei = 0
            mens ei < lengde(node["barn"])
                enum_kart[node["barn"][ei]["verdi"]] = ei
                ei = ei + 1
            slutt
            komp["enums"][node["verdi"]] = enum_kart
        slutt
        hvis node["type"] == "Grensesnitt"
            la metodar = []
            la gi = 0
            mens gi < lengde(node["barn"])
                hvis node["barn"][gi]["type"] == "MetodeSig"
                    legg_til(metodar, node["barn"][gi]["verdi"])
                slutt
                gi = gi + 1
            slutt
            komp["grensesnitt"][node["verdi"]] = metodar
        slutt
        hvis node["type"] == "La" {
            la global_namn = node["verdi"]
            hvis ikkje har_nokkel(komp["global_kart"], global_namn) {
                la globale = komp["global_kart"]
                globale[global_namn] = sann
                legg_til(komp["global_namn"], global_namn)
            }
        }
        hvis node["type"] == "Bruk"
            alias = node["barn"][0]["verdi"]
            hvis alias == node["verdi"]
                alias = siste_moduldel(node["verdi"])
            slutt
            komp["import_alias"][alias] = node["verdi"]
            registrer_importerte_funksjonar(komp, alias, node["verdi"])
        slutt
        i = i + 1
    slutt

    // M9: sjekk at strukturar som implementerer eit grensesnitt har alle
    // metodane. Metodar er registrerte som "Struktur.metode" i fk.
    ci = 0
    mens ci < lengde(ast_program["barn"])
        cnode = ast_program["barn"][ci]
        hvis cnode["type"] == "Struktur"
            bi = 0
            mens bi < lengde(cnode["barn"])
                hvis cnode["barn"][bi]["type"] == "Implementerer"
                    la grnamn = cnode["barn"][bi]["verdi"]
                    hvis har_nokkel(komp["grensesnitt"], grnamn)
                        la krav = komp["grensesnitt"][grnamn]
                        la ki = 0
                        mens ki < lengde(krav)
                            la mnamn = cnode["verdi"] + "." + krav[ki]
                            hvis ikkje har_nokkel(fk, mnamn)
                                kast "Grensesnittfeil: " + cnode["verdi"] + " implementerer " + grnamn + " men manglar metoden " + krav[ki]
                            slutt
                            ki = ki + 1
                        slutt
                    slutt
                slutt
                bi = bi + 1
            slutt
        slutt
        ci = ci + 1
    slutt

    // Andre pass: kompiler kvar funksjon
    funk_json_par = []
    test_json_par = []
    hvis lengde(komp["global_namn"]) > 0 {
        legg_til(funk_json_par, kompiler_modul_init(komp, ast_program))
    }
    j = 0
    mens j < lengde(ast_program["barn"])
        node = ast_program["barn"][j]
        hvis node["type"] == "Funksjon"
            ir_fremdrift("function-start " + json_heiltal_tekst(j) + " " + node["verdi"])
            resultat = kompiler_funksjon(komp, node)
            ir_fremdrift("function-done " + json_heiltal_tekst(j) + " " + node["verdi"])
            legg_til(funk_json_par, resultat)
        slutt
        hvis node["type"] == "Test"
            resultat = kompiler_test(komp, node)
            legg_til(test_json_par, resultat)
        slutt
        j = j + 1
    slutt

    // Lambda-hjelpefunksjonar kjem etter toppnivå-funksjonane
    j = 0
    mens j < lengde(komp["lambda_funk_par"])
        legg_til(funk_json_par, komp["lambda_funk_par"][j])
        j = j + 1
    slutt

    // Bygg functions-objekt — saml fragment i liste og join éin gong (O(N) ikkje O(N²))
    funk_deler = []
    k = 0
    mens k < lengde(funk_json_par)
        par = funk_json_par[k]
        // finn |SEP| separator med builtin.index_of
        sep_str = "|SEP|"
        sep_pos = builtin.index_of(par, sep_str)
        hvis sep_pos < 0
            sep_pos = 0
        slutt

        // Bruk slice (O(M) ikkje O(M²))
        fn_key = builtin.slice(par, 0, sep_pos)
        fn_val = builtin.slice(par, sep_pos + 5, lengde(par))

        la del = json_escape_tekst(fn_key) + ":" + fn_val
        legg_til(funk_deler, del)
        k = k + 1
    slutt
    funk_obj = "{" + builtin.join(funk_deler, ",") + "}"

    // Bygg tests-objekt
    test_deler = []
    k = 0
    mens k < lengde(test_json_par)
        legg_til(test_deler, test_json_par[k])
        k = k + 1
    slutt
    test_obj = "[" + builtin.join(test_deler, ",") + "]"

    // Bygg heile bytecode-dokumentet
    entry = modul_namn + ".start"
    doc = "{"
    doc = doc + "\"format\":\"norscode-bytecode-v1\","
    doc = doc + "\"entry\":" + json_escape_tekst(entry) + ","
    la init_liste = []
    hvis lengde(komp["global_namn"]) > 0 { legg_til(init_liste, modul_namn + ".__module_init__") }
    doc = doc + "\"module_initializers\":" + json_fra_tekstliste(init_liste) + ","
    doc = doc + "\"global_names\":{" + json_escape_tekst(modul_namn) + ":" + json_fra_tekstliste(komp["global_namn"]) + "},"
    doc = doc + "\"imports\":" + json_fra_tekstliste(samla_importar(ast_program)) + ","
    doc = doc + "\"route_handlers\":" + json_fra_ruteliste(web_meta["route_handlers"]) + ","
    doc = doc + "\"dependency_providers\":" + json_fra_map_parliste(web_meta["dependency_providers"]) + ","
    doc = doc + "\"guard_providers\":" + json_fra_map_parliste(web_meta["guard_providers"]) + ","
    doc = doc + "\"request_middlewares\":" + json_fra_tekstliste(web_meta["request_middlewares"]) + ","
    doc = doc + "\"response_middlewares\":" + json_fra_tekstliste(web_meta["response_middlewares"]) + ","
    doc = doc + "\"error_middlewares\":" + json_fra_tekstliste(web_meta["error_middlewares"]) + ","
    doc = doc + "\"startup_hooks\":" + json_fra_tekstliste(web_meta["startup_hooks"]) + ","
    doc = doc + "\"shutdown_hooks\":" + json_fra_tekstliste(web_meta["shutdown_hooks"]) + ","
    doc = doc + "\"tests\":" + test_obj + ","
    doc = doc + "\"functions\":" + funk_obj
    doc = doc + "}"

    returner doc
slutt

// ─── Offentleg API ───────────────────────────────────────────────────────────

funksjon kompiler_til_ncb_json(ast_program, modul_namn)
    returner kompiler_program(ast_program, modul_namn)
slutt

funksjon start()
    returner "ir_to_bytecode_ready"
slutt
