// typecheck.no — M1 valfri streng type-sjekk. Splitta ut frå semantic.no fordi
// stage0-kompilatoren trunkerer store modular. Halden mager og med enkle
// konstruksjonar (ingen ø-variabelnamn, ingen nøsta uttrykk rett inn i
// builtin-kall) for å unngå kjende kodegen-quirkar i seed-kompilatoren.
//
// Inngang: kt_koyr(tabell, program) -> tekst  ("" = ok, elles fyrste feil).
//   tabell["param_typar"][fn]  liste av deklarerte parametertypar ("" = utypa)
//   tabell["retur_typar"][fn]  deklarert returtype
//   tabell["typefeil"]         fyllast med "Typefeil L:K - …" (alle feil)
//   tabell["typeaatvaringar"]  (valfri liste) fyllast med "Typeendring L:K - …"
//
// Modulen er ikkje kopla inn i semantic.no (fjerna i #183), men blir brukt av
// `nc lint` og `nc lsp` via selfhost/linter_kjerne.no (køyrt frå kjelde).
//
// Reglar (typar kanoniserte til tal/tekst/bool/liste/ordbok/ukjend; ukjend blir
// aldri rapportert, så dynamisk kode gjev ikkje falske positive):
//   - argument til kjende funksjonar i same modul vs parametertypar (òg i nøsta kall)
//   - returverdi vs deklarert returtype (per funksjon, òg nøsta funksjonar)
//   - la x: T = v  og  x = v  der x har deklarert type (la x: T eller typa parameter)
//   - la x = v utan type som seinare får ein verdi av annan type: berre åtvaring
//     (Typeendring), fordi Norscode tillèt dynamisk omtypeing.
//   - `la` er funksjonsskopa (ein `la v` i kvar grein av hvis/ellers er same
//     variabel). Er eit namn deklarert fleire gonger i funksjonen (la eller
//     parameter) og minst éin av deklarasjonane er utypa, eller dei har ulik
//     type, veit ein ikkje statisk kva som gjeld etterpå: namnet blir ukjend
//     etter kvar slik `la` (sjølve `la x: T = v`-sjekken gjeld framleis).
//   - variablar/parametrar som koden sjekkar med type(x)/builtin.type(x) blir
//     rekna som ukjende i heile funksjonen (enkel innsnevring: koden handterer
//     fleire typar med vilje).
// Operatorar: parseren lagrar token-typen (EQ, LT, PLUS, OG …) som Binop-verdi;
// begge former (EQ og ==) blir forstått. Samanlikningar gjev bool. `og`/`eller`
// returnerer ein av operandane (som i Python: `null eller "x"` er tekst,
// `"x" og 5` er heltall), så typen er operandtypen berre når begge sider har
// same kjende type; elles ukjend. Standardverdi-idiomet `x eller ""` gjev
// difor aldri falsk typefeil.

funksjon kt_kanon(t)
    hvis t == null returner "ukjend" slutt
    // R3/F28: valfri-markøren (heltall?) endrar ikkje familien.
    la valfri_n = lengde(t)
    hvis valfri_n > 1
        la valfri_siste = builtin.slice(t, valfri_n - 1, valfri_n)
        hvis valfri_siste == "?" returner kt_kanon(builtin.slice(t, 0, valfri_n - 1)) slutt
    slutt
    hvis t == "" eller t == "tom" eller t == "ukjend" eller t == "any" returner "ukjend" slutt
    hvis t == "heltall" eller t == "heiltall" eller t == "desimaltall" eller t == "desimal" eller t == "tal" returner "tal" slutt
    hvis t == "tekst" returner "tekst" slutt
    hvis t == "bool" eller t == "boolsk" returner "bool" slutt
    la er_liste = builtin.starts_with(t, "liste")
    hvis er_liste returner "liste" slutt
    la er_ordbok = builtin.starts_with(t, "ordbok")
    hvis er_ordbok returner "ordbok" slutt
    returner "ukjend"
slutt

funksjon kt_ok(deklarert, faktisk)
    la d = kt_kanon(deklarert)
    la f = kt_kanon(faktisk)
    hvis d == "ukjend" returner sann slutt
    hvis f == "ukjend" returner sann slutt
    returner d == f
slutt

funksjon kt_param_type(pnode)
    la barn = pnode["barn"]
    hvis lengde(barn) > 0
        la fyrste = barn[0]
        hvis fyrste["type"] == "Type" returner kt_typetekst(fyrste) slutt
    slutt
    returner ""
slutt

// R3/F28: full typetekst (liste<heltall>) når parseren har lagra han, elles grunnamnet.
funksjon kt_typetekst(tnode)
    la har = har_nokkel(tnode, "typetekst")
    hvis har returner tnode["typetekst"] slutt
    returner tnode["verdi"]
slutt

// R3/F27 (streng): les av ein variabel som er deklarert utan verdi (la x: T)
// og ikkje tilordna sidan.
funksjon kt_sjekk_uinit(tabell, env, node)
    la namn = node["verdi"]
    la har = har_nokkel(env, "!" + namn)
    hvis ikkje har returner 0 slutt
    hvis env["!" + namn] == sann
        kt_feil(tabell, node, namn + " er brukt før han har fått ein verdi")
        env["!" + namn] = usann
    slutt
    returner 0
slutt

funksjon kt_env_type(env, namn)
    la har = har_nokkel(env, namn)
    hvis har returner env[namn] slutt
    returner "ukjend"
slutt

funksjon kt_feil(tabell, node, melding)
    la linje = tekst_fra_heltall(node["linje"])
    la kol = tekst_fra_heltall(node["kolonne"])
    la m = "Typefeil " + linje + ":" + kol + " - " + melding
    legg_til(tabell["typefeil"], m)
    returner 0
slutt

funksjon kt_aatvaring(tabell, node, melding)
    la har = har_nokkel(tabell, "typeaatvaringar")
    hvis ikkje har returner 0 slutt
    la linje = tekst_fra_heltall(node["linje"])
    la kol = tekst_fra_heltall(node["kolonne"])
    la m = "Typeendring " + linje + ":" + kol + " - " + melding
    legg_til(tabell["typeaatvaringar"], m)
    returner 0
slutt

// Besøk barna til eit uttrykk (for nøsta kall), utan å bry seg om typen.
funksjon kt_besok_barn(tabell, env, node)
    la barn = node["barn"]
    la i = 0
    mens i < lengde(barn)
        kt_type(tabell, env, barn[i])
        i = i + 1
    slutt
    returner 0
slutt

funksjon kt_type(tabell, env, node)
    hvis node == null returner "ukjend" slutt
    la t = node["type"]
    // R3/F27: fine literaltypar; kt_kanon gjer begge til «tal» utan streng modus.
    hvis t == "Heltall" returner "heltall" slutt
    hvis t == "Desimal" returner "desimaltall" slutt
    hvis t == "Tekst" returner "tekst" slutt
    hvis t == "Bool" returner "bool" slutt
    hvis t == "Ident"
        kt_sjekk_uinit(tabell, env, node)
        returner kt_env_type(env, node["verdi"])
    slutt
    hvis t == "Binop" returner kt_binop(tabell, env, node) slutt
    hvis t == "Unar" returner kt_unar(tabell, env, node) slutt
    la streng = kt_streng(tabell)
    hvis t == "Kall"
        hvis streng returner kt_kall_s(tabell, env, node) slutt
        returner kt_kall(tabell, env, node)
    slutt
    hvis streng
        hvis t == "Liste" returner kt_liste_type(tabell, env, node) slutt
        hvis t == "Map" returner kt_map_type(tabell, env, node) slutt
        hvis t == "Felt" returner kt_felt_type(tabell, env, node) slutt
        hvis t == "Indeks" returner kt_indeks_type(tabell, env, node) slutt
    slutt
    // Lambda-/funksjonskroppar blir sjekka i eige miljø (returtype, argument);
    // list comprehension har eigen løkkevariabel: ikkje gå inn.
    hvis t == "Lambda" eller t == "Funksjon"
        kt_funksjon(tabell, node)
        returner "ukjend"
    slutt
    hvis t == "ListeKomprehensjon" returner "liste" slutt
    kt_besok_barn(tabell, env, node)
    hvis t == "Liste" returner "liste" slutt
    hvis t == "Map" returner "ordbok" slutt
    returner "ukjend"
slutt

funksjon kt_er_samanlikning(op)
    hvis op == "EQ" eller op == "NE" eller op == "LT" eller op == "GT" eller op == "LTE" eller op == "GTE" returner sann slutt
    hvis op == "==" eller op == "!=" eller op == "<" eller op == ">" eller op == "<=" eller op == ">=" returner sann slutt
    returner usann
slutt

// `og`/`eller` er IKKJE samanlikningar: VM-en returnerer ein av operandane.
funksjon kt_er_logisk(op)
    hvis op == "OG" eller op == "ELLER" eller op == "AND" eller op == "OR" eller op == "NULLISH" returner sann slutt
    hvis op == "og" eller op == "eller" returner sann slutt
    returner usann
slutt

funksjon kt_binop(tabell, env, node)
    la op = node["verdi"]
    la venstre = node["barn"][0]
    la hogre = node["barn"][1]
    la vt = kt_type(tabell, env, venstre)
    la ht = kt_type(tabell, env, hogre)
    la cmp = kt_er_samanlikning(op)
    hvis cmp returner "bool" slutt
    la vk = kt_kanon(vt)
    la hk = kt_kanon(ht)
    la logisk = kt_er_logisk(op)
    hvis logisk
        hvis vk == hk returner vk slutt
        returner "ukjend"
    slutt
    hvis op == "PLUS" eller op == "+"
        hvis vk == "tekst" returner "tekst" slutt
        hvis hk == "tekst" returner "tekst" slutt
        hvis vk == "tal" og hk == "tal" returner kt_tal_resultat(tabell, op, vt, ht) slutt
        // R2/F08: + utan tekst krev tal på begge sider (VM-en kastar TypeFeil).
        la pluss_feil = kt_ikkje_tal(vk) eller kt_ikkje_tal(hk)
        hvis pluss_feil
            kt_feil(tabell, node, "operatoren + krev tal eller tekst, fekk " + vk + " og " + hk)
        slutt
        returner "ukjend"
    slutt
    // R2/F08: - * / % krev tal; ein kjend ikkje-tal-type er ein typefeil.
    la er_aritmetikk = kt_er_aritmetikk(op)
    hvis er_aritmetikk
        la ar_feil = kt_ikkje_tal(vk) eller kt_ikkje_tal(hk)
        hvis ar_feil
            kt_feil(tabell, node, "operatoren " + kt_op_teikn(op) + " krev tal, fekk " + vk + " og " + hk)
        slutt
    slutt
    hvis vk == "tal" og hk == "tal" returner kt_tal_resultat(tabell, op, vt, ht) slutt
    returner "ukjend"
slutt

// R3/F27: resultattypen til aritmetikk på tal. Utan streng modus «tal» (som før);
// streng: desimaltall smittar, heltall op heltall er heltall (unnateke /).
funksjon kt_tal_resultat(tabell, op, vt, ht)
    la s = kt_streng(tabell)
    hvis ikkje s returner "tal" slutt
    la a = kt_ks(tabell, vt)
    la b = kt_ks(tabell, ht)
    hvis a == "desimaltall" eller b == "desimaltall" returner "desimaltall" slutt
    la deling = op == "SLASH" eller op == "DIV" eller op == "/"
    hvis a == "heltall" og b == "heltall" og ikkje deling returner "heltall" slutt
    returner "tal"
slutt

// R2/F08: kjend type som ikkje er tal (ukjend blir aldri rapportert).
funksjon kt_ikkje_tal(k)
    hvis k == "ukjend" returner usann slutt
    returner k != "tal"
slutt

funksjon kt_er_aritmetikk(op)
    hvis op == "MINUS" eller op == "STAR" eller op == "MUL" eller op == "SLASH" eller op == "DIV" eller op == "PERCENT" returner sann slutt
    hvis op == "-" eller op == "*" eller op == "/" eller op == "%" returner sann slutt
    returner usann
slutt

funksjon kt_op_teikn(op)
    hvis op == "MINUS" returner "-" slutt
    hvis op == "STAR" eller op == "MUL" returner "*" slutt
    hvis op == "SLASH" eller op == "DIV" returner "/" slutt
    hvis op == "PERCENT" returner "%" slutt
    returner op
slutt

funksjon kt_unar(tabell, env, node)
    la op = node["verdi"]
    la barn = node["barn"]
    la ot = "ukjend"
    hvis lengde(barn) > 0 ot = kt_type(tabell, env, barn[0]) slutt
    hvis op == "NOT" eller op == "IKKJE" eller op == "IKKE" returner "bool" slutt
    la ok = kt_kanon(ot)
    hvis ok == "tal" returner kt_tal_resultat(tabell, op, ot, ot) slutt
    returner "ukjend"
slutt

funksjon kt_kall(tabell, env, node)
    kt_sjekk_args(tabell, env, node)
    la fn_node = node["barn"][0]
    hvis fn_node["type"] != "Ident" returner "ukjend" slutt
    la namn = fn_node["verdi"]
    la rt_kart = tabell["retur_typar"]
    la har = har_nokkel(rt_kart, namn)
    hvis har returner rt_kart[namn] slutt
    returner "ukjend"
slutt

funksjon kt_sjekk_args(tabell, env, node)
    la fn_node = node["barn"][0]
    la argnode = node["barn"][1]
    la argbarn = argnode["barn"]
    la ptypar = []
    la p_kart = tabell["param_typar"]
    // NB: i slutt-syntaks bind `ellers` rett etter ein indre `hvis … slutt` til
    // den INDRE hvis-en, så den indre hvis-en står sist i ellers-greina.
    hvis fn_node["type"] != "Ident"
        kt_type(tabell, env, fn_node)
    ellers
        la har = har_nokkel(p_kart, fn_node["verdi"])
        hvis har ptypar = p_kart[fn_node["verdi"]] slutt
    slutt
    la namn = fn_node["verdi"]
    la k = 0
    mens k < lengde(argbarn)
        la at = kt_type(tabell, env, argbarn[k])
        hvis k < lengde(ptypar)
            la god = kt_ok_t(tabell, ptypar[k], at)
            hvis ikkje god
                la nr = tekst_fra_heltall(k + 1)
                kt_feil(tabell, argbarn[k], "argument " + nr + " til " + namn + "() er " + kt_vis(tabell, at) + ", venta " + kt_vis(tabell, ptypar[k]))
            slutt
        slutt
        k = k + 1
    slutt
    returner 0
slutt

// Namn som får ny verdi (x = …, x += …) ein stad i funksjonskroppen.
funksjon kt_samle_tilordna(node, ut)
    hvis node == null returner 0 slutt
    la t = node["type"]
    la barn = node["barn"]
    hvis t == "Sett" eller t == "AugSett"
        hvis lengde(barn) > 0
            la maal = barn[0]
            hvis maal["type"] == "Ident" ut[maal["verdi"]] = sann slutt
        slutt
    slutt
    la i = 0
    mens i < lengde(barn)
        kt_samle_tilordna(barn[i], ut)
        i = i + 1
    slutt
    returner 0
slutt

// Namn som koden sjekkar køyretidstypen til (type(x) / builtin.type(x)).
// Slik kode handterer fleire typar med vilje, så den deklarerte typen blir
// ikkje brukt for feilsjekkar på x i funksjonen (enkel flyt-innsnevring).
funksjon kt_er_typekall(fn_node)
    la ft = fn_node["type"]
    hvis ft != "Ident" og ft != "Felt" returner usann slutt
    la namn = fn_node["verdi"]
    returner namn == "type" eller namn == "type_av"
slutt

funksjon kt_samle_dynamisk(node, ut)
    hvis node == null returner 0 slutt
    la barn = node["barn"]
    hvis node["type"] == "Kall" og lengde(barn) > 1
        la er_typekall = kt_er_typekall(barn[0])
        la args = barn[1]["barn"]
        hvis er_typekall og lengde(args) > 0
            la a0 = args[0]
            hvis a0["type"] == "Ident" ut[a0["verdi"]] = sann slutt
        slutt
    slutt
    la i = 0
    mens i < lengde(barn)
        kt_samle_dynamisk(barn[i], ut)
        i = i + 1
    slutt
    returner 0
slutt

funksjon kt_setningar(tabell, env, blokk, retur_type)
    hvis blokk == null returner 0 slutt
    la barn = blokk["barn"]
    la i = 0
    mens i < lengde(barn)
        la stmt = barn[i]
        la st = stmt["type"]
        // R3/F27 (streng): setning etter returner/kast/bryt/fortsett i same blokk.
        hvis i > 0
            la forrige = barn[i - 1]
            la hopp = kt_hoppar(forrige)
            la s_aktiv = kt_streng(tabell)
            hvis hopp og s_aktiv
                kt_feil(tabell, stmt, "uoppnåeleg kode etter " + tekst(forrige["type"]))
            slutt
        slutt
        hvis st == "La"
            kt_la(tabell, env, stmt)
        ellers hvis st == "Sett"
            kt_sett(tabell, env, stmt)
        ellers hvis st == "Returner"
            kt_returner(tabell, env, stmt, retur_type)
        ellers hvis st == "Kall"
            kt_type(tabell, env, stmt)
        ellers hvis st == "Funksjon" eller st == "Lambda"
            kt_funksjon(tabell, stmt)
        ellers hvis st == "LaDestrukt"
            kt_la_destrukt(tabell, env, stmt)
        ellers hvis st == "For" eller st == "ForRange" eller st == "PrøvFang"
            kt_bind_ukjend(env, stmt["verdi"])
            kt_flyt(tabell, env, stmt, retur_type)
        ellers
            kt_flyt(tabell, env, stmt, retur_type)
        slutt
        i = i + 1
    slutt
    returner 0
slutt

funksjon kt_bind_ukjend(env, namn)
    hvis namn == null returner 0 slutt
    hvis namn == "" returner 0 slutt
    env[namn] = "ukjend"
    env["#" + namn] = usann
    env["~" + namn] = "ukjend"
    returner 0
slutt

funksjon kt_la_destrukt(tabell, env, stmt)
    la barn = stmt["barn"]
    hvis lengde(barn) > 1 kt_type(tabell, env, barn[1]) slutt
    hvis lengde(barn) > 0
        la maal = barn[0]["barn"]
        la i = 0
        mens i < lengde(maal)
            kt_bind_ukjend(env, maal[i]["verdi"])
            i = i + 1
        slutt
    slutt
    returner 0
slutt

funksjon kt_la(tabell, env, stmt)
    la barn = stmt["barn"]
    la deklarert = ""
    la verdi_node = null
    la bi = 0
    mens bi < lengde(barn)
        la b = barn[bi]
        la bt = b["type"]
        hvis bt == "Type"
            deklarert = kt_typetekst(b)
            kt_sjekk_typenode(tabell, b)
        slutt
        hvis bt != "Type" og bt != "Returtype" verdi_node = b slutt
        bi = bi + 1
    slutt
    la vt = "ukjend"
    hvis verdi_node != null vt = kt_type(tabell, env, verdi_node) slutt
    hvis deklarert != "" og verdi_node != null
        la god = kt_ok_t(tabell, deklarert, vt)
        hvis ikkje god
            kt_feil(tabell, stmt, "la " + stmt["verdi"] + ": " + deklarert + " får " + kt_vis(tabell, vt))
        slutt
    slutt
    la namn = stmt["verdi"]
    // R3/F27 (streng): la x: T utan verdi er ikkje initialisert.
    la s_uinit = kt_streng(tabell)
    hvis s_uinit
        env["!" + namn] = deklarert != "" og verdi_node == null
    slutt
    hvis deklarert != ""
        env[namn] = deklarert
        env["#" + namn] = sann
        env["~" + namn] = deklarert
    ellers
        // Utypa la: typen er berre utleidd. Blir variabelen tilordna på nytt
        // ein stad i funksjonen, kan typen endre seg (flytufølsam analyse),
        // så han blir ukjend for feilsjekkar.
        la tilordna = env["__tilordna__"]
        la endrast = har_nokkel(tilordna, namn)
        env["#" + namn] = usann
        env["~" + namn] = vt
        hvis endrast
            env[namn] = "ukjend"
        ellers
            env[namn] = vt
        slutt
    slutt
    la dekl = env["__deklarasjonar__"]
    la fleir = kt_fleirtydig(dekl, namn)
    hvis fleir
        env[namn] = "ukjend"
        env["~" + namn] = "ukjend"
    slutt
    la dyn = env["__dynamisk__"]
    la er_dyn = har_nokkel(dyn, namn)
    hvis er_dyn kt_bind_ukjend(env, namn) slutt
    returner 0
slutt

// Deklarasjonstypar per namn i ein funksjonskropp: kvar `la` gjev éin oppføring
// ("" = utypa). Nøsta funksjonar/lambdaer har eige miljø og blir ikkje talde.
funksjon kt_samle_la(node, ut)
    hvis node == null returner 0 slutt
    la t = node["type"]
    hvis t == "Funksjon" eller t == "Lambda" returner 0 slutt
    la barn = node["barn"]
    hvis t == "La"
        la dt = ""
        la bi = 0
        mens bi < lengde(barn)
            la b = barn[bi]
            hvis b["type"] == "Type" dt = b["verdi"] slutt
            bi = bi + 1
        slutt
        kt_legg_deklarasjon(ut, node["verdi"], dt)
    slutt
    la i = 0
    mens i < lengde(barn)
        kt_samle_la(barn[i], ut)
        i = i + 1
    slutt
    returner 0
slutt

funksjon kt_legg_deklarasjon(ut, namn, dt)
    hvis namn == null returner 0 slutt
    la har = har_nokkel(ut, namn)
    hvis ikkje har ut[namn] = [] slutt
    legg_til(ut[namn], dt)
    returner 0
slutt

// Fleire deklarasjonar av same namn der minst éin er utypa eller typane er
// ulike: typen etter deklarasjonen er ikkje statisk kjend (la er funksjonsskopa,
// så ein `la` i kvar grein av ein hvis/ellers er same variabel).
funksjon kt_fleirtydig(deklarasjonar, namn)
    hvis deklarasjonar == null returner usann slutt
    la har = har_nokkel(deklarasjonar, namn)
    hvis ikkje har returner usann slutt
    la typar = deklarasjonar[namn]
    hvis lengde(typar) < 2 returner usann slutt
    la fyrste = kt_kanon(typar[0])
    la i = 0
    mens i < lengde(typar)
        hvis typar[i] == "" returner sann slutt
        la k = kt_kanon(typar[i])
        hvis k != fyrste returner sann slutt
        i = i + 1
    slutt
    returner usann
slutt

funksjon kt_sett(tabell, env, stmt)
    la maal = stmt["barn"][0]
    la vnode = stmt["barn"][1]
    la vt = kt_type(tabell, env, vnode)
    la s = kt_streng(tabell)
    hvis maal["type"] != "Ident"
        hvis s returner kt_sett_maal_s(tabell, env, maal, vt, stmt) slutt
        kt_type(tabell, env, maal)
        returner 0
    slutt
    la namn = maal["verdi"]
    hvis s env["!" + namn] = usann slutt
    la har_decl = har_nokkel(env, "#" + namn)
    hvis ikkje har_decl returner 0 slutt
    la deklarert = env["#" + namn]
    hvis deklarert
        la kjend = kt_env_type(env, namn)
        la god = kt_ok_t(tabell, kjend, vt)
        hvis ikkje god
            kt_feil(tabell, stmt, namn + " er " + kt_vis(tabell, kjend) + ", får " + kt_vis(tabell, vt))
        slutt
        returner 0
    slutt
    la utleidd = env["~" + namn]
    la god2 = kt_ok_t(tabell, utleidd, vt)
    // R3/F27 (streng): utleidd type er bindande, omtilordning til annan type er feil.
    hvis ikkje god2 og s
        kt_feil(tabell, stmt, namn + " er " + kt_vis(tabell, utleidd) + " (utleidd frå la), får " + kt_vis(tabell, vt))
        env["~" + namn] = "ukjend"
        returner 0
    slutt
    hvis ikkje god2
        kt_aatvaring(tabell, stmt, namn + " var " + kt_kanon(utleidd) + " (la utan typeannotasjon), får " + kt_kanon(vt))
        env["~" + namn] = "ukjend"
    slutt
    returner 0
slutt

funksjon kt_returner(tabell, env, stmt, retur_type)
    la barn = stmt["barn"]
    hvis lengde(barn) > 0
        la rt = kt_type(tabell, env, barn[0])
        la god = kt_ok_t(tabell, retur_type, rt)
        hvis ikkje god
            kt_feil(tabell, stmt, "returnerer " + kt_vis(tabell, rt) + ", funksjonen er deklarert " + kt_vis(tabell, retur_type))
        slutt
    slutt
    returner 0
slutt

funksjon kt_flyt(tabell, env, stmt, retur_type)
    la barn = stmt["barn"]
    la ci = 0
    mens ci < lengde(barn)
        la b = barn[ci]
        la bt = b["type"]
        hvis bt == "Blokk"
            kt_setningar(tabell, env, b, retur_type)
        ellers hvis bt == "MatchCase" eller bt == "MatchElse"
            kt_flyt(tabell, env, b, retur_type)
        ellers
            kt_type(tabell, env, b)
        slutt
        ci = ci + 1
    slutt
    returner 0
slutt

funksjon kt_barn_av_type(node, t)
    la barn = node["barn"]
    la i = 0
    mens i < lengde(barn)
        la b = barn[i]
        hvis b["type"] == t returner b slutt
        i = i + 1
    slutt
    returner null
slutt

funksjon kt_funksjon(tabell, node)
    la fn_barn = node["barn"]
    la env = {}
    la tilordna = {}
    la n_barn = lengde(fn_barn)
    hvis n_barn == 0 returner 0 slutt
    la kropp = fn_barn[n_barn - 1]
    kt_samle_tilordna(kropp, tilordna)
    env["__tilordna__"] = tilordna
    la dynamisk = {}
    // R3/F27: i streng modus er deklarerte og utleidde typar bindande sjølv om
    // koden testar type(x) (ingen dynamisk innsnevring).
    la utan_dyn = kt_streng(tabell)
    hvis ikkje utan_dyn kt_samle_dynamisk(kropp, dynamisk) slutt
    env["__dynamisk__"] = dynamisk
    la deklarasjonar = {}
    kt_samle_la(kropp, deklarasjonar)
    env["__deklarasjonar__"] = deklarasjonar
    la param_node = kt_barn_av_type(node, "Parametere")
    la pbarn = []
    hvis param_node != null pbarn = param_node["barn"] slutt
    // R3/F27 (streng): typeparametrane til funksjonen er i skop i signatur og kropp.
    la streng = kt_streng(tabell)
    la ytre_typeparam = null
    hvis streng
        ytre_typeparam = tabell["kt_typeparam"]
        la skop = kt_kopi_kart(ytre_typeparam)
        kt_legg_typeparam(skop, node)
        tabell["kt_typeparam"] = skop
    slutt
    // Parametrar er deklarasjonar òg: `la n = …` i kroppen overskriv parameteren n.
    la pk = 0
    mens pk < lengde(pbarn)
        la pk_node = pbarn[pk]
        la pk_type = kt_param_type(pk_node)
        la pk_vararg = har_nokkel(pk_node, "vararg")
        hvis pk_vararg pk_type = "liste" slutt
        kt_legg_deklarasjon(deklarasjonar, pk_node["verdi"], pk_type)
        pk = pk + 1
    slutt
    la j = 0
    mens j < lengde(pbarn)
        la pnode = pbarn[j]
        la pnamn = pnode["verdi"]
        la ptype = kt_param_type(pnode)
        la er_vararg = har_nokkel(pnode, "vararg")
        hvis er_vararg ptype = "liste" slutt
        env[pnamn] = ptype
        env["#" + pnamn] = ptype != ""
        env["~" + pnamn] = ptype
        hvis streng
            hvis lengde(pnode["barn"]) > 0 kt_sjekk_typenode(tabell, pnode["barn"][0]) slutt
            // self i metoden Struktur.m(self, …) har strukturtypen.
            la s_namn = kt_metode_struktur(tabell, node)
            hvis j == 0 og ptype == "" og s_namn != "" og pnamn == "self"
                env[pnamn] = s_namn
                env["~" + pnamn] = s_namn
            slutt
        slutt
        la p_dyn = har_nokkel(dynamisk, pnamn)
        hvis p_dyn kt_bind_ukjend(env, pnamn) slutt
        la p_fleir = kt_fleirtydig(deklarasjonar, pnamn)
        hvis p_fleir
            env[pnamn] = "ukjend"
            env["~" + pnamn] = "ukjend"
        slutt
        j = j + 1
    slutt
    la retur_type = ""
    la rt_node = kt_barn_av_type(node, "Returtype")
    hvis rt_node != null retur_type = kt_typetekst(rt_node) slutt
    hvis kropp["type"] == "Blokk"
        kt_setningar(tabell, env, kropp, retur_type)
    slutt
    hvis streng
        kt_sjekk_typenode(tabell, rt_node)
        kt_sjekk_manglande_retur(tabell, node, rt_node, kropp)
        tabell["kt_typeparam"] = ytre_typeparam
    slutt
    returner 0
slutt

// R3/F27: strukturnamnet S for metoden «S.m» når S er ein kjend struktur, elles "".
funksjon kt_metode_struktur(tabell, node)
    la namn = node["verdi"]
    hvis namn == null returner "" slutt
    la p = builtin.index_of(namn, ".")
    hvis p <= 0 returner "" slutt
    la s = builtin.slice(namn, 0, p)
    la har = har_nokkel(tabell["kt_strukturar"], s)
    hvis har returner s slutt
    returner ""
slutt

// R3/F27: funksjon med eksplisitt returtype må returnere på alle vegar.
funksjon kt_sjekk_manglande_retur(tabell, node, rt_node, kropp)
    hvis rt_node == null returner 0 slutt
    la har = har_nokkel(rt_node, "typeuttrykk")
    hvis ikkje har returner 0 slutt
    la rt = kt_typetekst(rt_node)
    hvis rt == "tom" eller rt == "ingenting" eller rt == "null" returner 0 slutt
    hvis kropp["type"] != "Blokk" returner 0 slutt
    la term = kt_terminerer_blokk(kropp)
    hvis term returner 0 slutt
    la namn = node["verdi"]
    hvis namn == "" namn = "lambda" slutt
    kt_feil(tabell, node, "funksjon " + tekst(namn) + " manglar returner på minst éin veg (deklarert -> " + rt + ")")
    returner 0
slutt

funksjon kt_koyr(tabell, program)
    la barn = program["barn"]
    la streng = kt_streng(tabell)
    hvis streng kt_samle_streng(tabell, program) slutt
    la i = 0
    mens i < lengde(barn)
        la node = barn[i]
        hvis node["type"] == "Funksjon"
            kt_funksjon(tabell, node)
        slutt
        i = i + 1
    slutt
    la feilliste = tabell["typefeil"]
    hvis lengde(feilliste) > 0 returner feilliste[0] slutt
    returner ""
slutt

// ─── R3/F27: streng modus ────────────────────────────────────────────────────
// semantic.sem_streng_typesjekk set tabell["streng"] = sann (NORSCODE_STRICT_TYPAR=1
// eller `nc check --strict`). Då gjeld i tillegg til reglane over:
//   - typane er fine: heltall og desimaltall er ulike (heltall -> desimaltall er
//     lov, motsett ikkje), liste<T>/ordbok<K,V> blir sjekka på elementtype,
//     strukturar og grensesnitt er eigne typar (ein struktur passar til eit
//     grensesnitt han implementerer, òg via grensesnitt-arv);
//   - ukjende typenamn i annotasjonar er feil;
//   - felt: ukjent felt på ein kjend struktur, og felttype ved p.x = v;
//   - indeks: o[k] = v mot ordbok<K,V>/liste<T>, legg_til(l, v) mot liste<T>;
//   - generiske funksjonar: typeparametrar blir bundne frå argumenta og
//     substituerte i parameter- og returtypen (typane er erased ved køyring);
//   - metodekall på kjend struktur: argumenttypar og ukjend metode;
//   - la utan typeannotasjon held den utleidde typen: omtilordning til ein
//     annan type er feil (ikkje berre åtvaring);
//   - manglande returner i funksjon med returtype, bruk før tilordning
//     (la x: T utan verdi) og uoppnåeleg kode etter returner/kast/bryt/fortsett.
// Truthiness i vilkår (hvis 5) er framleis lov (R1-val) og 1 + "x" er tekst (A3).

funksjon kt_streng(tabell)
    la har = har_nokkel(tabell, "streng")
    hvis ikkje har returner usann slutt
    returner tabell["streng"] == sann
slutt

funksjon kt_ok_t(tabell, d, f)
    la s = kt_streng(tabell)
    hvis s returner kt_ok_s(tabell, d, f) slutt
    returner kt_ok(d, f)
slutt

// Typen slik han blir vist i meldingar: grov familie utan streng modus (som før).
funksjon kt_vis(tabell, t)
    la s = kt_streng(tabell)
    hvis s
        hvis t == null returner "ukjend" slutt
        hvis t == "" returner "ukjend" slutt
        returner t
    slutt
    returner kt_kanon(t)
slutt

funksjon kt_utan_valfri(t)
    la n = lengde(t)
    hvis n > 1
        la siste = builtin.slice(t, n - 1, n)
        hvis siste == "?" returner builtin.slice(t, 0, n - 1) slutt
    slutt
    returner t
slutt

// Grunnamnet til ein typetekst: liste<heltall> -> liste, funksjon(a)->b -> funksjon.
funksjon kt_grunn(t)
    la u = kt_utan_valfri(t)
    la p = builtin.index_of(u, "<")
    la q = builtin.index_of(u, "(")
    la slutt_pos = lengde(u)
    hvis p >= 0 slutt_pos = p slutt
    hvis q >= 0 og q < slutt_pos slutt_pos = q slutt
    returner builtin.slice(u, 0, slutt_pos)
slutt

// Typeargumenta på toppnivå: ordbok<tekst,liste<heltall>> -> [tekst, liste<heltall>].
funksjon kt_args(t)
    la ut = []
    la u = kt_utan_valfri(t)
    la n = lengde(u)
    la p = builtin.index_of(u, "<")
    hvis p < 0 returner ut slutt
    la q = builtin.index_of(u, "(")
    hvis q >= 0 og q < p returner ut slutt
    la djup = 0
    la start = p + 1
    la i = p + 1
    mens i < n - 1
        la c = builtin.slice(u, i, i + 1)
        hvis c == "<" eller c == "(" djup = djup + 1 slutt
        hvis c == ")" djup = djup - 1 slutt
        hvis c == ">"
            la forr = builtin.slice(u, i - 1, i)
            hvis forr != "-" djup = djup - 1 slutt
        slutt
        hvis c == "," og djup == 0
            legg_til(ut, builtin.slice(u, start, i))
            start = i + 1
        slutt
        i = i + 1
    slutt
    legg_til(ut, builtin.slice(u, start, n - 1))
    returner ut
slutt

// Fin typefamilie i streng modus: heltall, desimaltall, tal (eitt av dei),
// tekst, bool, liste, ordbok, funksjon, S:<struktur>, G:<grensesnitt>, ukjend.
funksjon kt_ks(tabell, t)
    hvis t == null returner "ukjend" slutt
    hvis t == "" eller t == "tom" eller t == "ukjend" eller t == "any" returner "ukjend" slutt
    hvis t == "verdi" eller t == "objekt" eller t == "ingenting" eller t == "null" returner "ukjend" slutt
    la u = kt_utan_valfri(t)
    hvis u == "heltall" eller u == "heiltall" eller u == "int" returner "heltall" slutt
    hvis u == "desimaltall" eller u == "desimal" eller u == "flyttal" returner "desimaltall" slutt
    hvis u == "tal" returner "tal" slutt
    hvis u == "tekst" returner "tekst" slutt
    hvis u == "bool" eller u == "boolsk" returner "bool" slutt
    la g = kt_grunn(u)
    la er_liste = g == "liste" eller builtin.starts_with(g, "liste_")
    hvis er_liste returner "liste" slutt
    la er_ordbok = g == "ordbok" eller builtin.starts_with(g, "ordbok_")
    hvis er_ordbok returner "ordbok" slutt
    hvis g == "funksjon" returner "funksjon" slutt
    la tp = tabell["kt_typeparam"]
    la er_tp = har_nokkel(tp, g)
    hvis er_tp returner "ukjend" slutt
    la er_s = har_nokkel(tabell["kt_strukturar"], g)
    hvis er_s returner "S:" + g slutt
    la er_g = har_nokkel(tabell["kt_grensesnitt"], g)
    hvis er_g returner "G:" + g slutt
    returner "ukjend"
slutt

funksjon kt_tal_familie(k)
    returner k == "tal" eller k == "heltall" eller k == "desimaltall"
slutt

funksjon kt_ok_s(tabell, d, f)
    la dk = kt_ks(tabell, d)
    la fk = kt_ks(tabell, f)
    hvis dk == "ukjend" eller fk == "ukjend" returner sann slutt
    hvis dk == "tal" returner kt_tal_familie(fk) slutt
    hvis fk == "tal" returner kt_tal_familie(dk) slutt
    hvis dk == "desimaltall" og fk == "heltall" returner sann slutt
    la d_g = builtin.starts_with(dk, "G:")
    hvis d_g
        la gnamn = builtin.slice(dk, 2, lengde(dk))
        la f_s = builtin.starts_with(fk, "S:")
        hvis f_s returner kt_struktur_implementerer(tabell, builtin.slice(fk, 2, lengde(fk)), gnamn) slutt
        la f_g = builtin.starts_with(fk, "G:")
        hvis f_g returner kt_grensesnitt_er(tabell, builtin.slice(fk, 2, lengde(fk)), gnamn, 0) slutt
        returner usann
    slutt
    hvis dk != fk returner usann slutt
    hvis dk == "liste" eller dk == "ordbok"
        la d_args = kt_args(d)
        la f_args = kt_args(f)
        hvis lengde(d_args) == lengde(f_args)
            la i = 0
            mens i < lengde(d_args)
                la god = kt_ok_s(tabell, d_args[i], f_args[i])
                hvis ikkje god returner usann slutt
                i = i + 1
            slutt
        slutt
    slutt
    returner sann
slutt

// Er grensesnittet g lik eller (via utvider/implementerer-arv) ein undertype av maal?
funksjon kt_grensesnitt_er(tabell, g, maal, djup)
    hvis g == maal returner sann slutt
    hvis djup > 20 returner usann slutt
    la gk = tabell["kt_grensesnitt"]
    la har = har_nokkel(gk, g)
    hvis ikkje har returner usann slutt
    la foreldre = gk[g]
    la i = 0
    mens i < lengde(foreldre)
        la ja = kt_grensesnitt_er(tabell, foreldre[i], maal, djup + 1)
        hvis ja returner sann slutt
        i = i + 1
    slutt
    returner usann
slutt

funksjon kt_struktur_implementerer(tabell, s, g)
    la ik = tabell["kt_impl"]
    la har = har_nokkel(ik, s)
    hvis ikkje har returner usann slutt
    la liste = ik[s]
    la i = 0
    mens i < lengde(liste)
        la ja = kt_grensesnitt_er(tabell, liste[i], g, 0)
        hvis ja returner sann slutt
        i = i + 1
    slutt
    returner usann
slutt

// Kjende typenamn: innebygde, deklarerte strukturar/grensesnitt/enum,
// typeparametrar i skopet, modulkvalifiserte namn (a.B) og, når modulen
// importerer noko, namn med stor forbokstav (kan kome frå ein annan modul).
funksjon kt_innebygd_typenamn(n)
    hvis n == "heltall" eller n == "heiltall" eller n == "desimaltall" eller n == "desimal" eller n == "tal" returner sann slutt
    hvis n == "tekst" eller n == "bool" eller n == "boolsk" eller n == "liste" eller n == "ordbok" returner sann slutt
    hvis n == "funksjon" eller n == "tom" eller n == "ingenting" eller n == "null" eller n == "ukjend" returner sann slutt
    hvis n == "any" eller n == "verdi" eller n == "objekt" eller n == "bytes" eller n == "int" eller n == "flyttal" returner sann slutt
    la l = builtin.starts_with(n, "liste_")
    hvis l returner sann slutt
    la o = builtin.starts_with(n, "ordbok_")
    hvis o returner sann slutt
    returner usann
slutt

funksjon kt_stor_forbokstav(n)
    hvis lengde(n) == 0 returner usann slutt
    la c = builtin.slice(n, 0, 1)
    returner c != builtin.lower(c)
slutt

funksjon kt_kjend_typenamn(tabell, n)
    la inne = kt_innebygd_typenamn(n)
    hvis inne returner sann slutt
    la er_tp = har_nokkel(tabell["kt_typeparam"], n)
    hvis er_tp returner sann slutt
    la er_s = har_nokkel(tabell["kt_strukturar"], n)
    hvis er_s returner sann slutt
    la er_g = har_nokkel(tabell["kt_grensesnitt"], n)
    hvis er_g returner sann slutt
    la er_e = har_nokkel(tabell["kt_enum"], n)
    hvis er_e returner sann slutt
    la kval = builtin.index_of(n, ".")
    hvis kval >= 0 returner sann slutt
    hvis tabell["kt_har_import"]
        la stor = kt_stor_forbokstav(n)
        hvis stor returner sann slutt
    slutt
    returner usann
slutt

// Sjekk alle namn i eit typeuttrykk (AST-forma frå parseren, docs/TYPEMETADATA.md).
funksjon kt_sjekk_typeuttrykk(tabell, node, tu)
    hvis tu == null returner 0 slutt
    la k = tu["kind"]
    hvis k == "optional" returner kt_sjekk_typeuttrykk(tabell, node, tu["inner"]) slutt
    hvis k == "function"
        la i = 0
        mens i < lengde(tu["params"])
            kt_sjekk_typeuttrykk(tabell, node, tu["params"][i])
            i = i + 1
        slutt
        kt_sjekk_typeuttrykk(tabell, node, tu["returns"])
        returner 0
    slutt
    la n = tekst(tu["name"])
    la kjend = kt_kjend_typenamn(tabell, n)
    hvis ikkje kjend
        kt_feil(tabell, node, "ukjend type " + n)
    slutt
    hvis k == "apply"
        la j = 0
        mens j < lengde(tu["args"])
            kt_sjekk_typeuttrykk(tabell, node, tu["args"][j])
            j = j + 1
        slutt
    slutt
    returner 0
slutt

funksjon kt_sjekk_typenode(tabell, node)
    hvis node == null returner 0 slutt
    la s = kt_streng(tabell)
    hvis ikkje s returner 0 slutt
    la har = har_nokkel(node, "typeuttrykk")
    hvis ikkje har returner 0 slutt
    returner kt_sjekk_typeuttrykk(tabell, node, node["typeuttrykk"])
slutt

// Typeparametrar til ein deklarasjon -> kart namn -> sann (lagt til i skopet).
funksjon kt_legg_typeparam(skop, node)
    la har = har_nokkel(node, "typeparametrar")
    hvis ikkje har returner 0 slutt
    la tp = node["typeparametrar"]
    la i = 0
    mens i < lengde(tp)
        skop[tp[i]["namn"]] = sann
        i = i + 1
    slutt
    returner 0
slutt

funksjon kt_kopi_kart(k)
    la ut = {}
    la nk = nøkler(k)
    la i = 0
    mens i < lengde(nk)
        ut[nk[i]] = k[nk[i]]
        i = i + 1
    slutt
    returner ut
slutt

funksjon kt_implementerer_liste(node)
    la har_alle = har_nokkel(node, "implementerer_alle")
    hvis har_alle returner node["implementerer_alle"] slutt
    la har = har_nokkel(node, "implementerer")
    hvis har returner [node["implementerer"]] slutt
    returner []
slutt

// Registra for streng modus: strukturar (felt -> typetekst), grensesnitt
// (-> foreldre), implementerer-lister, enum, generiske funksjonar.
funksjon kt_samle_streng(tabell, program)
    tabell["kt_strukturar"] = {}
    tabell["kt_grensesnitt"] = {}
    tabell["kt_gmetodar"] = {}
    tabell["kt_impl"] = {}
    tabell["kt_enum"] = {}
    tabell["kt_typeparam"] = {}
    tabell["kt_generisk"] = {}
    tabell["kt_har_import"] = usann
    la barn = program["barn"]
    la i = 0
    mens i < lengde(barn)
        la node = barn[i]
        la t = node["type"]
        hvis t == "Bruk" tabell["kt_har_import"] = sann slutt
        hvis t == "Enum" tabell["kt_enum"][node["verdi"]] = sann slutt
        hvis t == "Struktur"
            la felt = {}
            la fi = 0
            mens fi < lengde(node["barn"])
                la f = node["barn"][fi]
                hvis f["type"] == "Felt"
                    la ft = ""
                    la har_t = har_nokkel(f, "typetekst")
                    hvis har_t ft = f["typetekst"] slutt
                    felt[f["verdi"]] = ft
                slutt
                fi = fi + 1
            slutt
            tabell["kt_strukturar"][node["verdi"]] = felt
            tabell["kt_impl"][node["verdi"]] = kt_implementerer_liste(node)
        slutt
        hvis t == "Grensesnitt"
            la foreldre = []
            la har_u = har_nokkel(node, "utvider")
            hvis har_u foreldre = node["utvider"] slutt
            tabell["kt_grensesnitt"][node["verdi"]] = foreldre
            la metodar = {}
            la mi = 0
            mens mi < lengde(node["barn"])
                la m = node["barn"][mi]
                hvis m["type"] == "Metodekrav" metodar[m["verdi"]] = sann slutt
                mi = mi + 1
            slutt
            tabell["kt_gmetodar"][node["verdi"]] = metodar
        slutt
        hvis t == "Funksjon"
            la har_tp = har_nokkel(node, "typeparametrar")
            hvis har_tp
                la tpk = {}
                kt_legg_typeparam(tpk, node)
                tabell["kt_generisk"][node["verdi"]] = tpk
            slutt
        slutt
        i = i + 1
    slutt
    // Felttypar blir sjekka med typeparametrane til strukturen i skopet.
    i = 0
    mens i < lengde(barn)
        la snode = barn[i]
        hvis snode["type"] == "Struktur"
            la skop = {}
            kt_legg_typeparam(skop, snode)
            tabell["kt_typeparam"] = skop
            la si = 0
            mens si < lengde(snode["barn"])
                la sf = snode["barn"][si]
                hvis sf["type"] == "Felt" kt_sjekk_typenode(tabell, sf) slutt
                si = si + 1
            slutt
            tabell["kt_typeparam"] = {}
        slutt
        i = i + 1
    slutt
    returner 0
slutt

// Liste-/ordbok-literal: liste<E> / ordbok<K,V> når alle elementa har same
// kjende type, elles berre liste / ordbok.
funksjon kt_liste_type(tabell, env, node)
    la barn = node["barn"]
    la et = ""
    la blanda = usann
    la i = 0
    mens i < lengde(barn)
        la b = barn[i]
        la bt = kt_type(tabell, env, b)
        hvis b["type"] == "Spread" blanda = sann slutt
        la bk = kt_ks(tabell, bt)
        hvis bk == "ukjend" blanda = sann slutt
        hvis et == ""
            et = bt
        ellers
            la ek = kt_ks(tabell, et)
            hvis ek != bk blanda = sann slutt
        slutt
        i = i + 1
    slutt
    hvis blanda returner "liste" slutt
    hvis et == "" returner "liste" slutt
    returner "liste<" + et + ">"
slutt

funksjon kt_map_type(tabell, env, node)
    la barn = node["barn"]
    la kt = ""
    la vt = ""
    la blanda = usann
    la i = 0
    mens i < lengde(barn)
        la par = barn[i]
        hvis par["type"] != "MapPar"
            kt_type(tabell, env, par)
            blanda = sann
        ellers
            la a = kt_type(tabell, env, par["barn"][0])
            la b = kt_type(tabell, env, par["barn"][1])
            la ak = kt_ks(tabell, a)
            la bk = kt_ks(tabell, b)
            hvis ak == "ukjend" eller bk == "ukjend" blanda = sann slutt
            hvis kt == ""
                kt = a
                vt = b
            ellers
                hvis kt_ks(tabell, kt) != ak blanda = sann slutt
                hvis kt_ks(tabell, vt) != bk blanda = sann slutt
            slutt
        slutt
        i = i + 1
    slutt
    hvis blanda returner "ordbok" slutt
    hvis kt == "" returner "ordbok" slutt
    returner "ordbok<" + kt + "," + vt + ">"
slutt

// Strukturnamnet til ein typetekst, eller "".
funksjon kt_struktur_av(tabell, t)
    la k = kt_ks(tabell, t)
    la er_s = builtin.starts_with(k, "S:")
    hvis er_s returner builtin.slice(k, 2, lengde(k)) slutt
    returner ""
slutt

funksjon kt_felt_type(tabell, env, node)
    la ot = kt_type(tabell, env, node["barn"][0])
    la s = kt_struktur_av(tabell, ot)
    hvis s == "" returner "ukjend" slutt
    la felt = tabell["kt_strukturar"][s]
    la f = node["verdi"]
    la har = har_nokkel(felt, f)
    hvis har returner felt[f] slutt
    la er_metode = har_nokkel(tabell["param_typar"], s + "." + f)
    hvis ikkje er_metode
        kt_feil(tabell, node, s + " har ikkje feltet " + f)
    slutt
    returner "ukjend"
slutt

funksjon kt_indeks_type(tabell, env, node)
    la barn = node["barn"]
    hvis lengde(barn) < 2
        kt_besok_barn(tabell, env, node)
        returner "ukjend"
    slutt
    la ot = kt_type(tabell, env, barn[0])
    kt_type(tabell, env, barn[1])
    la k = kt_ks(tabell, ot)
    la args = kt_args(ot)
    hvis k == "liste" og lengde(args) == 1 returner args[0] slutt
    hvis k == "ordbok" og lengde(args) == 2 returner args[1] slutt
    hvis k == "tekst" returner "tekst" slutt
    returner "ukjend"
slutt

// Bind typeparametrar (tp: namn -> sann) frå parametertype pt mot argumenttype at.
funksjon kt_bind(tabell, tp, pt, at, bind)
    la pu = kt_utan_valfri(pt)
    la er_tp = har_nokkel(tp, pu)
    hvis er_tp
        la alt = har_nokkel(bind, pu)
        la ak = kt_ks(tabell, at)
        hvis ikkje alt og ak != "ukjend" bind[pu] = at slutt
        returner 0
    slutt
    la pa = kt_args(pu)
    la aa = kt_args(at)
    hvis lengde(pa) > 0 og lengde(pa) == lengde(aa)
        la i = 0
        mens i < lengde(pa)
            kt_bind(tabell, tp, pa[i], aa[i], bind)
            i = i + 1
        slutt
    slutt
    returner 0
slutt

// Substituer bundne typeparametrar; ubundne blir ukjend.
funksjon kt_subst(tp, t, bind)
    hvis t == null returner "" slutt
    la valfri = kt_utan_valfri(t) != t
    la u = kt_utan_valfri(t)
    la er_tp = har_nokkel(tp, u)
    hvis er_tp
        la har = har_nokkel(bind, u)
        hvis har returner bind[u] slutt
        returner "ukjend"
    slutt
    la args = kt_args(u)
    hvis lengde(args) == 0 returner t slutt
    la delar = []
    la i = 0
    mens i < lengde(args)
        legg_til(delar, kt_subst(tp, args[i], bind))
        i = i + 1
    slutt
    la ut = kt_grunn(u) + "<" + builtin.join(delar, ",") + ">"
    hvis valfri ut = ut + "?" slutt
    returner ut
slutt

funksjon kt_brukarfunksjon(tabell, namn)
    returner har_nokkel(tabell["param_typar"], namn)
slutt

// Returtypen til nokre innebygde (berre når namnet ikkje er ein brukarfunksjon).
funksjon kt_innebygd_retur(namn)
    hvis namn == "lengde" eller namn == "heltall_fra_tekst" eller namn == "heiltall_fra_tekst" returner "heltall" slutt
    hvis namn == "tekst" eller namn == "til_tekst" eller namn == "tekst_fra_heltall" eller namn == "tekst_fra_heiltall" returner "tekst" slutt
    hvis namn == "tekst_fra_bool" eller namn == "fil_les" eller namn == "tekst_trim" returner "tekst" slutt
    returner "ukjend"
slutt

// Kall i streng modus: argument (med generisk binding), metodar, konstruktørar
// og legg_til mot liste<T>. Returnerer returtypen.
funksjon kt_kall_s(tabell, env, node)
    la fn_node = node["barn"][0]
    la argbarn = node["barn"][1]["barn"]
    la atypar = []
    la k = 0
    mens k < lengde(argbarn)
        legg_til(atypar, kt_type(tabell, env, argbarn[k]))
        k = k + 1
    slutt
    la ft = fn_node["type"]
    la namn = ""
    la skift = 0
    hvis ft == "Ident"
        namn = fn_node["verdi"]
    ellers hvis ft == "Felt"
        la ot = kt_type(tabell, env, fn_node["barn"][0])
        la s = kt_struktur_av(tabell, ot)
        hvis s == "" returner "ukjend" slutt
        namn = s + "." + fn_node["verdi"]
        skift = 1
        la finst = kt_brukarfunksjon(tabell, namn)
        hvis ikkje finst
            la standard = kt_struktur_har_gmetode(tabell, s, fn_node["verdi"])
            hvis ikkje standard
                kt_feil(tabell, fn_node, s + " har ingen metode " + fn_node["verdi"] + "()")
            slutt
            returner "ukjend"
        slutt
    ellers
        kt_type(tabell, env, fn_node)
        returner "ukjend"
    slutt
    la brukar = kt_brukarfunksjon(tabell, namn)
    hvis ikkje brukar
        la er_s = har_nokkel(tabell["kt_strukturar"], namn)
        hvis er_s returner namn slutt
        hvis namn == "legg_til" og lengde(atypar) == 2
            la lk = kt_ks(tabell, atypar[0])
            la la_args = kt_args(atypar[0])
            hvis lk == "liste" og lengde(la_args) == 1
                la god_e = kt_ok_s(tabell, la_args[0], atypar[1])
                hvis ikkje god_e
                    kt_feil(tabell, argbarn[1], "legg_til: " + atypar[0] + " får element av type " + kt_vis(tabell, atypar[1]))
                slutt
            slutt
        slutt
        returner kt_innebygd_retur(namn)
    slutt
    la ptypar = tabell["param_typar"][namn]
    la tp = {}
    la er_gen = har_nokkel(tabell["kt_generisk"], namn)
    hvis er_gen tp = tabell["kt_generisk"][namn] slutt
    la bind = {}
    k = 0
    mens k < lengde(atypar)
        la pi = k + skift
        hvis pi < lengde(ptypar) kt_bind(tabell, tp, ptypar[pi], atypar[k], bind) slutt
        k = k + 1
    slutt
    k = 0
    mens k < lengde(atypar)
        la pj = k + skift
        hvis pj < lengde(ptypar)
            la pt = kt_subst(tp, ptypar[pj], bind)
            la god = kt_ok_s(tabell, pt, atypar[k])
            hvis ikkje god
                la nr = tekst_fra_heltall(k + 1)
                kt_feil(tabell, argbarn[k], "argument " + nr + " til " + namn + "() er " + kt_vis(tabell, atypar[k]) + ", venta " + kt_vis(tabell, pt))
            slutt
        slutt
        k = k + 1
    slutt
    la rt_kart = tabell["retur_typar"]
    la har_rt = har_nokkel(rt_kart, namn)
    hvis ikkje har_rt returner "ukjend" slutt
    returner kt_subst(tp, rt_kart[namn], bind)
slutt

funksjon kt_struktur_har_gmetode(tabell, s, m)
    la ik = tabell["kt_impl"]
    la har = har_nokkel(ik, s)
    hvis ikkje har returner usann slutt
    la liste = ik[s]
    la i = 0
    mens i < lengde(liste)
        la ja = kt_grensesnitt_har_metode(tabell, liste[i], m, 0)
        hvis ja returner sann slutt
        i = i + 1
    slutt
    returner usann
slutt

funksjon kt_grensesnitt_har_metode(tabell, g, m, djup)
    hvis djup > 20 returner usann slutt
    la gm = tabell["kt_gmetodar"]
    la har = har_nokkel(gm, g)
    hvis ikkje har returner usann slutt
    la direkte = har_nokkel(gm[g], m)
    hvis direkte returner sann slutt
    la foreldre = tabell["kt_grensesnitt"][g]
    la i = 0
    mens i < lengde(foreldre)
        la ja = kt_grensesnitt_har_metode(tabell, foreldre[i], m, djup + 1)
        hvis ja returner sann slutt
        i = i + 1
    slutt
    returner usann
slutt

// Tilordning til eit felt/indeks i streng modus: p.x = v, o[k] = v, l[i] = v.
funksjon kt_sett_maal_s(tabell, env, maal, vt, stmt)
    la mt = maal["type"]
    hvis mt == "Felt"
        la ot = kt_type(tabell, env, maal["barn"][0])
        la s = kt_struktur_av(tabell, ot)
        hvis s == "" returner 0 slutt
        la felt = tabell["kt_strukturar"][s]
        la f = maal["verdi"]
        la har = har_nokkel(felt, f)
        hvis ikkje har
            kt_feil(tabell, maal, s + " har ikkje feltet " + f)
            returner 0
        slutt
        la god = kt_ok_s(tabell, felt[f], vt)
        hvis ikkje god
            kt_feil(tabell, stmt, s + "." + f + " er " + kt_vis(tabell, felt[f]) + ", får " + kt_vis(tabell, vt))
        slutt
        returner 0
    slutt
    hvis mt == "Indeks" og lengde(maal["barn"]) > 1
        la it = kt_type(tabell, env, maal["barn"][0])
        kt_type(tabell, env, maal["barn"][1])
        la ik = kt_ks(tabell, it)
        la args = kt_args(it)
        la elem = ""
        hvis ik == "liste" og lengde(args) == 1 elem = args[0] slutt
        hvis ik == "ordbok" og lengde(args) == 2 elem = args[1] slutt
        hvis elem != ""
            la god2 = kt_ok_s(tabell, elem, vt)
            hvis ikkje god2
                kt_feil(tabell, stmt, "element i " + it + " er " + elem + ", får " + kt_vis(tabell, vt))
            slutt
        slutt
        returner 0
    slutt
    kt_type(tabell, env, maal)
    returner 0
slutt

// ─── Flyt: terminering, uoppnåeleg kode ─────────────────────────────────────

funksjon kt_har_bryt(node)
    hvis node == null returner usann slutt
    la t = node["type"]
    hvis t == "Bryt" returner sann slutt
    hvis t == "Mens" eller t == "For" eller t == "ForRange" eller t == "Funksjon" eller t == "Lambda" returner usann slutt
    la barn = node["barn"]
    la i = 0
    mens i < lengde(barn)
        la ja = kt_har_bryt(barn[i])
        hvis ja returner sann slutt
        i = i + 1
    slutt
    returner usann
slutt

funksjon kt_terminerer_blokk(blokk)
    hvis blokk == null returner usann slutt
    la barn = blokk["barn"]
    la n = lengde(barn)
    hvis n == 0 returner usann slutt
    returner kt_terminerer(barn[n - 1])
slutt

funksjon kt_terminerer(s)
    la t = s["type"]
    hvis t == "Returner" eller t == "Kast" returner sann slutt
    hvis t == "Blokk" returner kt_terminerer_blokk(s) slutt
    la barn = s["barn"]
    hvis t == "Kall"
        la f = barn[0]
        hvis f["type"] == "Ident" og f["verdi"] == "feil" returner sann slutt
        returner usann
    slutt
    hvis t == "Hvis"
        hvis lengde(barn) < 3 returner usann slutt
        la a = kt_terminerer_blokk(barn[1])
        la b = kt_terminerer_blokk(barn[2])
        returner a og b
    slutt
    hvis t == "Mens"
        la c = barn[0]
        la evig = c["type"] == "Bool" og c["verdi"] == "sann"
        hvis ikkje evig returner usann slutt
        la br = kt_har_bryt(barn[1])
        returner ikkje br
    slutt
    hvis t == "PrøvFang"
        la fin = har_nokkel(s, "has_finally") og s["has_finally"] == sann
        hvis fin
            la ft = kt_terminerer_blokk(barn[2])
            hvis ft returner sann slutt
        slutt
        la pt = kt_terminerer_blokk(barn[0])
        hvis ikkje pt returner usann slutt
        la har_fang = har_nokkel(s, "has_catch") og s["has_catch"] == sann
        hvis har_fang returner kt_terminerer_blokk(barn[1]) slutt
        returner sann
    slutt
    hvis t == "Match"
        la har_else = usann
        la i = 1
        mens i < lengde(barn)
            la mc = barn[i]
            la mt = mc["type"]
            hvis mt == "MatchCase" eller mt == "MatchElse"
                hvis mt == "MatchElse" har_else = sann slutt
                la mb = mc["barn"]
                hvis lengde(mb) == 0 returner usann slutt
                la siste = mb[lengde(mb) - 1]
                la st = kt_terminerer(siste)
                hvis ikkje st returner usann slutt
            slutt
            i = i + 1
        slutt
        returner har_else
    slutt
    returner usann
slutt

funksjon kt_hoppar(s)
    la t = s["type"]
    returner t == "Returner" eller t == "Kast" eller t == "Bryt" eller t == "Fortsett"
slutt
