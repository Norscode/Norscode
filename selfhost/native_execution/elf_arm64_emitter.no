// Norscode-eigd statisk ELF64/AArch64-emitter.

funksjon u8(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    legg_til(buf, verdi & 255)
    returner 0
}

funksjon u16(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    u8(buf, verdi)
    u8(buf, verdi >> 8)
    returner 0
}

funksjon u32(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 0
    mens i < 4 { u8(buf, verdi >> (i * 8)) i = i + 1 }
    returner 0
}

funksjon u64(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 0
    mens i < 8 { u8(buf, verdi >> (i * 8)) i = i + 1 }
    returner 0
}

funksjon pad(buf: liste_heiltall, storleik: heiltall) -> heiltall {
    mens lengde(buf) < storleik { u8(buf, 0) }
    returner 0
}

funksjon bygg_program(aot_kode: liste_heiltall) -> liste_heiltall {
    hvis lengde(aot_kode) == 0 { kast "Linux arm64 AOT-kode kan ikkje vere tom" }
    la base = 0x400000
    la kode_offset = 4096
    la start_stub: liste_heiltall = []
    // _start: rekn ut envp frå stakken (Linux ABI: sp→argc, argv[], NULL, envp[])
    // og pass han i x2 til main, slik at entry-prologen sin `mov x27,x2` fangar
    // envp native (miljo_hent/NORSCODE_CMD virkar). Deretter bl main; exit(w0).
    u32(start_stub, 0xF94003E0)                 // ldr x0, [sp]            (argc)
    u32(start_stub, 0x910023E1)                 // add x1, sp, #8          (argv)
    u32(start_stub, 0x8B000C22)                 // add x2, x1, x0, lsl #3  (&argv[argc])
    u32(start_stub, 0x91002042)                 // add x2, x2, #8          (skip NULL → envp)
    // main ligg tre instruksjonar etter BL-adressa (mov x8, svc, så main).
    u32(start_stub, 0x94000003)                 // bl main
    u32(start_stub, 0xD2800000 | (93 << 5) | 8) // mov x8, #93 (exit)
    u32(start_stub, 0xD4000001)                 // svc #0
    la total = kode_offset + lengde(start_stub) + lengde(aot_kode)
    la elf: liste_heiltall = []

    // ELF64-header.
    u8(elf, 0x7F) u8(elf, 0x45) u8(elf, 0x4C) u8(elf, 0x46)
    u8(elf, 2) u8(elf, 1) u8(elf, 1) u8(elf, 0)
    la ident_pad = 0
    mens ident_pad < 8 { u8(elf, 0) ident_pad = ident_pad + 1 }
    u16(elf, 2)       // ET_EXEC
    u16(elf, 183)     // EM_AARCH64
    u32(elf, 1)
    u64(elf, base + kode_offset)
    u64(elf, 64)
    u64(elf, 0)
    u32(elf, 0)
    u16(elf, 64)
    u16(elf, 56)
    u16(elf, 1)
    u16(elf, 64)
    u16(elf, 0)
    u16(elf, 0)

    // Eitt RX PT_LOAD frå offset null inkluderer headerane og koden.
    u32(elf, 1)
    u32(elf, 5)
    u64(elf, 0)
    u64(elf, base)
    u64(elf, base)
    u64(elf, total)
    u64(elf, total)
    u64(elf, 4096)

    pad(elf, kode_offset)
    la i = 0
    mens i < lengde(start_stub) { u8(elf, start_stub[i]) i = i + 1 }
    // O(n): for-iterasjon i staden for aot_kode[i]-indeksering. Indeksert lese er
    // O(n) i tolken → indeksloopen var O(n²) på det store seed-imaget (12t+ CPU).
    for b i aot_kode { u8(elf, b) }
    returner elf
}
