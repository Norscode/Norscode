// Norscode-eigd statisk ELF64/AArch64-emitter.

funksjon u8(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    legg_til(buf, verdi & 255)
    returner 0
}

funksjon u16(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    u8(buf, verdi)
    u8(buf, verdi >> 8)
    returner 0
}

funksjon u32(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 0
    mens i < 4 { u8(buf, verdi >> (i * 8)) i = i + 1 }
    returner 0
}

funksjon u64(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 0
    mens i < 8 { u8(buf, verdi >> (i * 8)) i = i + 1 }
    returner 0
}

funksjon pad(buf: liste_heiltall, storleik: heiltall) -> heiltall {
    mens lengde(buf) < storleik { u8(buf, 0) }
    returner 0
}

// Byggjer alt FØR aot-koden: ELF64-header + eitt PT_LOAD + fyll til kode_offset +
// _start-stubben. Treng berre LENGDA på aot-koden (for p_filesz/p_memsz), ikkje koden
// sjølv — so strøyme-vegen (skriv_program) slepp å halde ein kopi av koden i minnet.
funksjon bygg_hode(aot_lengd: heiltall) -> liste_heiltall {
    hvis aot_lengd == 0 { kast "Linux arm64 AOT-kode kan ikkje vere tom" }
    la base = 0x400000
    la kode_offset = 4096
    la start_stub: liste_heiltall = []
    // _start: rekn ut envp frå stakken (Linux ABI: sp→argc, argv[], NULL, envp[])
    // og pass han i x2 til main, slik at entry-prologen sin `mov x27,x2` fangar
    // envp native (miljo_hent/NORSCODE_CMD virkar). Deretter bl main; exit(w0).
    u32(start_stub, 0xF94003E0)                 // ldr x0, [sp]            (argc)
    u32(start_stub, 0x910023E1)                 // add x1, sp, #8          (argv)
    u32(start_stub, 0x8B000C22)                 // add x2, x1, x0, lsl #3  (&argv[argc])
    u32(start_stub, 0x91002042)                 // add x2, x2, #8          (skip NULL → envp)
    // main ligg tre instruksjonar etter BL-adressa (mov x8, svc, så main).
    u32(start_stub, 0x94000003)                 // bl main
    u32(start_stub, 0xD2800000 | (93 << 5) | 8) // mov x8, #93 (exit)
    u32(start_stub, 0xD4000001)                 // svc #0
    la total = kode_offset + lengde(start_stub) + aot_lengd
    la elf: liste_heiltall = []

    // ELF64-header.
    u8(elf, 0x7F) u8(elf, 0x45) u8(elf, 0x4C) u8(elf, 0x46)
    u8(elf, 2) u8(elf, 1) u8(elf, 1) u8(elf, 0)
    la ident_pad = 0
    mens ident_pad < 8 { u8(elf, 0) ident_pad = ident_pad + 1 }
    u16(elf, 2)       // ET_EXEC
    u16(elf, 183)     // EM_AARCH64
    u32(elf, 1)
    u64(elf, base + kode_offset)
    u64(elf, 64)
    u64(elf, 0)
    u32(elf, 0)
    u16(elf, 64)
    u16(elf, 56)
    u16(elf, 1)
    u16(elf, 64)
    u16(elf, 0)
    u16(elf, 0)

    // Eitt RX PT_LOAD frå offset null inkluderer headerane og koden.
    u32(elf, 1)
    u32(elf, 5)
    u64(elf, 0)
    u64(elf, base)
    u64(elf, base)
    u64(elf, total)
    u64(elf, total)
    u64(elf, 4096)

    pad(elf, kode_offset)
    la i = 0
    mens i < lengde(start_stub) { u8(elf, start_stub[i]) i = i + 1 }
    returner elf
}

funksjon bygg_program(aot_kode: liste_heiltall) -> liste_heiltall {
    // Byte-identisk med den gamle emitteren: hode ‖ aot-kode. Held framleis heile
    // biletet i minnet; strøyme-vegen (skriv_program) er for store seed-image.
    la elf = bygg_hode(lengde(aot_kode))
    // O(n): for-iterasjon i staden for aot_kode[i]-indeksering. Indeksert lese er
    // O(n) i tolken → indeksloopen var O(n²) på det store seed-imaget (12t+ CPU).
    for b i aot_kode { u8(elf, b) }
    returner elf
}

// Legg bytes til fila i bitar på 512 KiB: fil_append_binær på x86-verten går via
// bytes_to_text, som klemmer til 1 MiB (stakkbuffer) — eitt kall med heile koden skreiv
// berre den første MiB-en. Same handtering som macho.append_i_bitar, men lokal so ELF-
// emitteren ikkje dreg inn macho/std.sha256 i kryss-codegen-bunten.
funksjon append_i_bitar(sti: tekst, bytes: liste_heiltall) -> heiltall {
    la bit = 524288
    la n = lengde(bytes)
    hvis n <= bit {
        builtin.fil_append_binær(sti, bytes)
        returner n
    }
    la a = 0
    mens a < n {
        la b = a + bit
        hvis b > n { b = n }
        la del = []
        la del_ok = usann
        prøv {
            del = builtin.slice(bytes, a, b)
            del_ok = builtin.type(del) == "liste" og lengde(del) == b - a
        } fang (e) { del_ok = usann }
        hvis ikkje del_ok {
            del = []
            la p = a
            mens p < b { u8(del, bytes[p]) p = p + 1 }
        }
        builtin.fil_append_binær(sti, del)
        a = b
    }
    returner n
}

// Skriv ELF-biletet direkte til fil (same bytes som bygg_program), utan ein samla kopi
// av koden i minnet: hovudet fyrst, deretter aot-koden strøyma i 512 KiB-bitar. Dette
// unngår at hode‖kode-kopien lever saman med aot-koden — det var det doble levande settet
// som sprengde 1 GiB-heapen til kryss-codegen-en (GC-heap full, exit 199). Returnerer
// talet på byte. ELF har ingen hale/signatur, so biletet er berre hode ‖ aot-kode.
funksjon skriv_program(sti: tekst, aot_kode: liste_heiltall) -> heiltall {
    returner skriv_program_delar(sti, [aot_kode], lengde(aot_kode))
}

// Som skriv_program, men aot-koden kjem som delar (ncval_compile_program_delar: eitt
// fragment per funksjon + hale) med samla lengd kode_lengd; bytane er hode ‖ delar[0] ‖
// delar[1] ‖ …. Kvar del går rett til fil_append_binær (via append_i_bitar for delar over
// 512 KiB), so skrivinga allokerer berre teksten fil_append_binær lagar (~1 B per byte) —
// ingen samla kopi og ingen heiltalsboksar per byte. Kryss-codegen-en på x86 har monoton
// bump-heap, so det er sum allokert som tel.
funksjon skriv_program_delar(sti: tekst, delar, kode_lengd: heiltall) -> heiltall {
    la hode = bygg_hode(kode_lengd)
    builtin.fil_skriv_binær(sti, hode)
    la n = lengde(hode)
    la i = 0
    mens i < lengde(delar) {
        la del: liste_heiltall = delar[i]
        hvis lengde(del) > 0 { n = n + append_i_bitar(sti, del) }
        i = i + 1
    }
    hvis n != lengde(hode) + kode_lengd { kast "ELF-emitter: delane gav " + tekst(n - lengde(hode)) + " byte, venta " + tekst(kode_lengd) }
    returner n
}
