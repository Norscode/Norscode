    la mrt_pnext1 = lengde(bytes) - 4
    copy(bytes, [0x48, 0x39, 0xC8])                // cmp rax,rcx (bump)
    copy(bytes, [0x0F, 0x83])                      // jae scan_next
    u32(bytes, 0)
    la mrt_pnext2 = lengde(bytes) - 4
    // BOUND: stopp om mark-stakk full (r11 >= live-map base) → hindrar overflow-write
    copy(bytes, [0x49, 0x81, 0xFB, 0x00, 0x00, 0x34, 0x10]) // cmp r11,0x10340000
    copy(bytes, [0x0F, 0x83])                      // jae scan_done
    u32(bytes, 0)
    la mrt_pscanfull = lengde(bytes) - 4
    copy(bytes, [0x49, 0x89, 0x03])                // mov [r11],rax (push root)
    copy(bytes, [0x49, 0x83, 0xC3, 0x08])          // add r11,8
    la mrt_next = lengde(bytes)                    // .scan_next:
    patch_jump(bytes, mrt_pnext1, mrt_next)
    patch_jump(bytes, mrt_pnext2, mrt_next)
    copy(bytes, [0x48, 0x83, 0xC6, 0x08])          // add rsi,8
    copy(bytes, [0xE9])                            // jmp scan
    u32(bytes, (mrt_scan - (lengde(bytes) + 4)) & 4294967295)
    la mrt_scandone = lengde(bytes)                // .scan_done:
