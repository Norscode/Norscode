    copy(bytes, [0x48, 0x3B, 0x34, 0x25, 0x00, 0x00, 0x60, 0x00]) // cmp rsi,[bump]
    copy(bytes, [0x0F, 0x83])                      // jae loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x06])                // mov rax,[rsi] (len@payload[0])
    copy(bytes, [0x48, 0x3D, 0x00, 0x00, 0x01, 0x00]) // cmp rax,0x10000 (65536)
    copy(bytes, [0x0F, 0x87])                      // ja loop (len for stor → falsk streng)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
