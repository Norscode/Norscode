    copy(bytes, [0x48, 0x2D, 0x00, 0x00, 0x60, 0x00]) // sub rax,0x600000
    copy(bytes, [0x48, 0xC1, 0xE8, 0x04])          // shr rax,4
    copy(bytes, [0x48, 0x89, 0xC1])                // mov rcx,rax
    copy(bytes, [0x48, 0x83, 0xE1, 0x07])          // and rcx,7
    copy(bytes, [0x48, 0xC1, 0xE8, 0x03])          // shr rax,3
    copy(bytes, [0x48, 0x05, 0x00, 0x00, 0x40, 0x10]) // add rax,0x10400000
    copy(bytes, [0x0F, 0xB6, 0x10])                // movzx edx,[rax]
    copy(bytes, [0x48, 0x89, 0xD6])                // mov rsi,rdx
    copy(bytes, [0x48, 0xD3, 0xEA])                // shr rdx,cl
    copy(bytes, [0x48, 0x83, 0xE2, 0x01])          // and rdx,1
    copy(bytes, [0x48, 0x85, 0xD2])                // test rdx,rdx
    copy(bytes, [0x0F, 0x85])                      // jnz loop (alt markert)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x41, 0xB8, 0x01, 0x00, 0x00, 0x00]) // mov r8d,1
    copy(bytes, [0x49, 0xD3, 0xE0])                // shl r8,cl
    copy(bytes, [0x4C, 0x09, 0xC6])                // or rsi,r8
    copy(bytes, [0x40, 0x88, 0x30])                // mov [rax],sil
    copy(bytes, [0x49, 0x89, 0x3A])                // mov [r10],rdi
    copy(bytes, [0x49, 0xC7, 0x42, 0x08, 0x10, 0x00, 0x00, 0x00]) // mov q[r10+8],16
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    copy(bytes, [0x49, 0xFF, 0xC1])                // inc r9
    copy(bytes, [0x48, 0x8B, 0x07])                // mov rax,[rdi] (type)
