    la mrt_pmapdone1 = lengde(bytes) - 4
    copy(bytes, [0x49, 0x81, 0xFB, 0x00, 0x00, 0x34, 0x10]) // cmp r11,0x10340000
    copy(bytes, [0x0F, 0x83])                      // jae map_done
    u32(bytes, 0)
    la mrt_pmapdone2 = lengde(bytes) - 4
    copy(bytes, [0x48, 0x8B, 0x3A])                // mov rdi,[rdx] (val)
    copy(bytes, [0x49, 0x89, 0x3B])                // mov [r11],rdi (push)
    copy(bytes, [0x49, 0x83, 0xC3, 0x08])          // add r11,8
    copy(bytes, [0x48, 0x83, 0xC2, 0x08])          // add rdx,8
    copy(bytes, [0x48, 0xFF, 0xC8])                // dec rax
    copy(bytes, [0xE9])                            // jmp valloop
    u32(bytes, (mrt_valloop - (lengde(bytes) + 4)) & 4294967295)
