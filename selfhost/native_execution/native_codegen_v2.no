    copy(bytes, [0xE9])                            // jmp loop
    u32(bytes, (swp_loop - (lengde(bytes) + 4)) & 4294967295)
    la swp_done = lengde(bytes)                    // done:
    patch_jump(bytes, swp_pdone, swp_done)
    copy(bytes, [0x4C, 0x89, 0xDF])                // mov rdi,r11 (freed)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC (iii): FRI-LISTE-STØTTA int-boksar (byggjekloss for allokator-re-pek) ──
    // gc_box_int(v) -> boksa int. Som RT_INT, men allokerer 16B via fri-lista (head-
    // fit >=16, elles bump) i staden for rein bump → gc_collect kan hauste boksen.
    // rdi = boksa arg; rsi = rå verdi. Fyller [type=1][verdi]. INGEN RT_INT-kall.
    atomics["gc_box_int"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x77, 0x08])          // mov rsi,[rdi+8] (unbox verdi)
    copy(bytes, [0x4C, 0x8B, 0x04, 0x25])          // mov r8,[head]
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x4D, 0x85, 0xC0])                // test r8,r8
    la gbi_empty = emit_je_placeholder(bytes)      // jz L_bump
    copy(bytes, [0x4D, 0x8B, 0x48, 0x08])          // mov r9,[r8+8] (blokk-size)
    copy(bytes, [0x49, 0x83, 0xF9, 0x10])          // cmp r9,16
    copy(bytes, [0x0F, 0x83])                       // jae L_reuse
    u32(bytes, 0)
    la gbi_reuse = lengde(bytes) - 4
    la gbi_Lbump = lengde(bytes)                   // L_bump:
    patch_jump(bytes, gbi_empty, gbi_Lbump)
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])          // mov rax,[bump]
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0x8D, 0x48, 0x10])          // lea rcx,[rax+16]
    copy(bytes, [0x48, 0x89, 0x0C, 0x25])          // mov [bump],rcx
    u32(bytes, HEAP_VA())
    la gbi_box = emit_jmp_placeholder(bytes)       // jmp L_fill
    la gbi_Lreuse = lengde(bytes)                  // L_reuse:
    patch_jump(bytes, gbi_reuse, gbi_Lreuse)
    copy(bytes, [0x4D, 0x8B, 0x10])                // mov r10,[r8] (next)
    copy(bytes, [0x4C, 0x89, 0x14, 0x25])          // mov [head],r10
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x4C, 0x89, 0xC0])                // mov rax,r8
    la gbi_Lfill = lengde(bytes)                   // L_fill:
    patch_jump(bytes, gbi_box, gbi_Lfill)
    copy(bytes, [0x48, 0xC7, 0x00, 0x01, 0x00, 0x00, 0x00]) // mov q[rax],1 (type int)
    copy(bytes, [0x48, 0x89, 0x70, 0x08])          // mov [rax+8],rsi (verdi)
    copy(bytes, [0xC3])                            // ret

