// selfhost/native_execution/native_codegen_v2.no
// NCB → x86-64 ELF med komplett NcVal-runtime og innebygd NCB-trailer
//
// Alle verdiar er NcVal* (16-byte heap-struct: {type, val})
// Full runtime: skriv, fil-I/O, JSON, map/list, string-ops, miljø
//
// Bruk: NC_INPUT=fil.ncb.json NC_OUTPUT=fil \
//           ./bin/nc run selfhost/native_execution/native_codegen_v2.no


// ─── Adressar ────────────────────────────────────────────────────────────────
funksjon TEXT_VA()   { returner 4198400 }
// 0x540000 held full nc_main-texten skild frå konstantsegmentet. Den gamle
// 0x500000-basen overlappa dei siste ~70 KiB av full-host-texten og gav SIGSEGV.
funksjon DATA_VA()   { returner 5505024 }
// Eige skrivebart verts-ABI-segment for rå prosesspekere. Konstantsegmentet
// held fram som read-only, og GC-/heap-kontrollblokka blir ikkje overlagd.
funksjon HOST_ABI_VA() { returner 6225920 } // 0x5f0000
// Bootstrap-kodegeneratoren køyrer som éi fil. Baseadresse og kontrollblokk
// følger std.runtime.memory_abi; den fysiske bootstrap-reserven kan vere større.
funksjon HEAP_VA()   { returner 6291456 }
// Den breie sjølvhost-VM-en held framleis alle AOT-objekt levande mellom
// safepoint-ar. Full source-only nc_main har 938 funksjonar og to deterministiske
// emitterpass; målt bootstrap kom forbi 890 funksjonar etter at traceallokering
// vart fjerna, før den monotone prototyperuntimen nådde 256 MiB. Med korrekt
// starts_with/ends_with-semantikk (og dermed full CALL-emittering) nådde den
// levande 938-funksjonsgrafen den tidlegare 1-GiB-grensa deterministisk ved
// emit-indeks 687. Segmentet er derfor 2 GiB virtuelt (berre rørte sider blir
// fysiske) fram til komprimerande native GC kan gjenvinne målebufferane mellom
// passa; fase-6-minneporten står framleis open.
funksjon HEAP_SZ() {
    // GC-gata: under NORSCODE_GC_ALLOC=1 er GC-scratchen (mark-stakk 0x10300000, live-map
    // 0x10340000, bitmap 0x10400000, unnatak-handler [0x10600000,0x10700000)) lagt på TOPPEN
    // av heapen. 269484032 = 256MB heap/scratch + 1MB handler-region sizera EKSAKT for dette:
    // heap-segmentet endar rett etter handler-regionen, så bump aldri kan klatre forbi
    // scratchen (naturleg tak). Hev IKKJE til 2GiB under GC — då blir scratchen liggande MIDT
    // i det allokerbare området og ei einaste rømt bump-løype korrupterer han (jf. cache-
    // fallback-regresjonen). Paritet-løypa (flagg AV) brukar main sin 2GiB for store program.
    hvis miljo_hent("NORSCODE_GC_ALLOC") == "1" { returner 269484032 }
    returner 2147483648
}
funksjon HEAP_CONTROLSZ() { returner 64 }
// VM-i-VM gjenbruker svært mange små heiltal og boolverdiar. Desse er
// immutable og kan derfor bu i ein kanonisk cache i starten av heap-segmentet
// i staden for å fylle den monotone prototypheapen. Området dekkjer
// -32768..32767 (65536 * 16 byte) og to boolverdiar.
funksjon SMALL_INT_CACHE_BASE() { returner HEAP_VA() + HEAP_CONTROLSZ() }
funksjon SMALL_INT_CACHE_COUNT() { returner 65536 }
funksjon BOOL_CACHE_BASE() { returner SMALL_INT_CACHE_BASE() + SMALL_INT_CACHE_COUNT() * 16 }
funksjon CHAR_CACHE_BASE() { returner BOOL_CACHE_BASE() + 32 }
funksjon CHAR_CACHE_COUNT() { returner 256 }
funksjon HEAP_ALLOC_START() { returner CHAR_CACHE_BASE() + CHAR_CACHE_COUNT() * 32 }
funksjon GC_SAFEPOINT_OFFSET() { returner 32 }
funksjon ENVP_OFFSET() { returner 8 }

funksjon native_codegen_trace(melding: tekst) -> heiltall {
    prøv {
        hvis miljo_hent("NC_NATIVE_CODEGEN_TRACE") == "1" {
            skriv("[AOT-TRACE] " + melding + "\n")
        }
    } fang (e) { }
    returner 0
}

// ─── Runtime-funksjon VA ─────────────────────────────────────────────────────
funksjon RT_NIL() { returner 4198400 }
funksjon RT_INT() { returner 4198432 }
funksjon RT_BOOL() { returner 4198464 }
funksjon RT_STR_RAW() { returner 4198512 }
funksjon RT_CONCAT() { returner 4208967 }       // TEXT_VA + 6464 (JTE[256] → 0x402940)
funksjon RT_SLICE() { returner 4204821 }        // TEXT_VA + 6421 (JTE[432] → 0x402915)
funksjon RT_INDEX_OF_STR() { returner 4206595 } // TEXT_VA + 8195 (JTE[496] → 0x403003)
funksjon RT_CONTAINS() { returner 4206595 }     // TEXT_VA + 8195 (JTE[688] → 0x403003, same entry)
funksjon RT_STARTS_WITH() { returner 4205936 }  // TEXT_VA + 7536 (JTE[720] → 0x402d70)
funksjon RT_ENDS_WITH() { returner 4207641 }    // TEXT_VA + 9241 (JTE[800] → 0x403419)
funksjon RT_TRIM() { returner 4208885 }         // TEXT_VA + 10485 (JTE[880] → 0x4038f5)
funksjon RT_REPLACE() { returner 4199472 }      // TEXT_VA + 1072 (actual code in base blob)
funksjon RT_INT_TO_STR() { returner 4209111 } // 0x4039d7, lengdekorrigert heiltalstekst
funksjon RT_STR_TO_INT() { returner 4200112 }
funksjon RT_CHAR_CODE() { returner 4200128 }
funksjon RT_CHR() { returner 4200160 }
funksjon RT_LOWER() { returner 4200192 }
funksjon RT_UPPER() { returner 4200320 }
// Legacy-peikar: faktisk type_av er no inline-emittert i kodegen.
funksjon RT_TYPE_OF() { returner 4200448 }
funksjon RT_LIST_NEW() { returner 4200624 }
funksjon RT_LIST_APP() { returner 4200704 }
funksjon RT_LIST_GET() { returner 4200816 }
funksjon RT_LIST_SET() { returner 4200864 }
funksjon RT_LIST_LEN() { returner 4200896 }
funksjon RT_LIST_POP() { returner 4200928 }
funksjon RT_LIST_SLICE() { returner 4200976 }
funksjon RT_LIST_REMOVE() { returner 4201088 }
funksjon RT_SPLIT() { returner 4201168 }
funksjon RT_JOIN() { returner 4201424 }
funksjon RT_MAP_NEW() { returner 4201568 }
funksjon RT_MAP_GET() { returner 4201664 }
funksjon RT_MAP_SET() { returner 4201808 }
funksjon RT_MAP_HAS() { returner 4202064 }
funksjon RT_MAP_KEYS() { returner 4202208 } // 0x401ee0, faktisk funksjonsstart
funksjon RT_MAP_VALS() { returner 4202304 } // 0x401f40, faktisk funksjonsstart
funksjon RT_MAP_DEL() { returner 4202400 }
funksjon RT_INDEX_GET() { returner 4202592 }
funksjon RT_INDEX_SET() { returner 4202720 } // 0x4020e0, faktisk funksjonsstart
funksjon RT_SKRIV() { returner 4202784 }
funksjon RT_FIL_LES() { returner 4202832 }
funksjon RT_FIL_SKRIV() { returner 4203136 }
funksjon RT_FIL_SKRIV_BINAR() { returner 4203280 }
funksjon RT_MILJO_HENT() { returner 4203488 }
funksjon RT_MILJO_FINNES() { returner 4203664 }
funksjon RT_FIL_FINNES() { returner 4203712 } // 0x4024c0, faktisk funksjonsstart
funksjon RT_EQ() { returner 4203856 }
// Legacy-peikar: vanleg dynamisk `+` går no via inline type-sjekk i kodegen.
funksjon RT_ADD() { returner 4203648 }
funksjon RT_JSON_STR() { returner 4204128 } // legacy-dispatch har defekt hopp-tabell
funksjon RT_JSON_PARSE() { returner 4205248 }
funksjon RT_TO_TEKST() { returner 4206368 }
funksjon RT_TO_INT() { returner 4206464 }
funksjon RT_FEIL() { returner 4207220 }
funksjon RT_LENGDE() { returner 4200896 }
funksjon RT_KAST() { returner 4207428 }
funksjon RT_INIT_HEAP() { returner 4207520 }  // TEXT_VA + 9120 (etter mmap→store-patch)
funksjon RT_TRUTHY() { returner 4207584 }
funksjon RT_NOT() { returner 4207648 }
funksjon RT_NE() { returner 4207696 }
funksjon RT_LT() { returner 4207744 }
funksjon RT_GT() { returner 4207872 }
funksjon RT_LE() { returner 4207904 }
funksjon RT_GE() { returner 4208000 }
funksjon RT_SUB() { returner 4208096 }
funksjon RT_MUL() { returner 4208128 }
funksjon RT_DIV() { returner 4208160 }
funksjon RT_MOD() { returner 4208208 }
funksjon RT_NEG() { returner 4208256 }
funksjon RT_BUILD_LIST_REV() { returner 4208336 } // 0x4036d0, faktisk funksjonsstart
funksjon RT_BUILD_MAP_REV() { returner 4208432 }  // 0x403730, faktisk funksjonsstart
funksjon RT_THROW() { returner 4208528 }
funksjon GC_SAFEPOINT_STUB_BYTES() { returner 93 } // 49 + 44 (14×push/pop caller+callee-saved rundt collect)

// ASCII lower/upper på ein ny streng. Dei gamle faste peikarane til
// RT_LOWER/RT_UPPER landar i den endra legacy-runtime-tabellen etter at
// runtime-biten blir utvida. Denne emitteren held derfor sjølve operasjonen
// i same bytebuffer som resten av v2-runtimeen.
funksjon emit_ascii_case_runtime(bytes, upper: boolsk) {
    legg_til(bytes, 0x48)
    legg_til(bytes, 0x81)
    legg_til(bytes, 0xEC)
    u32(bytes, 256)
    copy(bytes, [0x48, 0x8B, 0x47, 0x08, 0x48, 0x8B, 0x08, 0x45, 0x31, 0xC0])
    la loop = lengde(bytes)
    copy(bytes, [0x49, 0x39, 0xC8])
    legg_til(bytes, 0x0F)
    legg_til(bytes, 0x83)
    la je_done = lengde(bytes)
    u32(bytes, 0)
    copy(bytes, [0x42, 0x8A, 0x54, 0x00, 0x08, 0x80, 0xFA])
    hvis upper { legg_til(bytes, 0x61) } ellers { legg_til(bytes, 0x41) }
    legg_til(bytes, 0x0F)
    legg_til(bytes, 0x82)
    la je_store1 = lengde(bytes)
    u32(bytes, 0)
    legg_til(bytes, 0x80)
    legg_til(bytes, 0xFA)
    hvis upper { legg_til(bytes, 0x7A) } ellers { legg_til(bytes, 0x5A) }
    legg_til(bytes, 0x0F)
    legg_til(bytes, 0x87)
    la ja_store = lengde(bytes)
    u32(bytes, 0)
    legg_til(bytes, 0x80)
    legg_til(bytes, 0xC2)
    hvis upper { legg_til(bytes, 0xE0) } ellers { legg_til(bytes, 0x20) }
    la store = lengde(bytes)
    copy(bytes, [0x42, 0x88, 0x14, 0x04, 0x49, 0xFF, 0xC0])
    legg_til(bytes, 0xE9)
    la jmp_loop = lengde(bytes)
    u32(bytes, 0)
    la done = lengde(bytes)
    copy(bytes, [0x48, 0x89, 0xE7, 0x48, 0x89, 0xCE])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x81, 0xC4])
    u32(bytes, 256)
    legg_til(bytes, 0xC3)
    patch_jump(bytes, je_done, done)
    patch_jump(bytes, je_store1, store)
    patch_jump(bytes, ja_store, store)
    patch_jump(bytes, jmp_loop, loop)
}

// ─── Byte-emitering ──────────────────────────────────────────────────────────
funksjon u8(buf, v)  { legg_til(buf, v & 255) }
funksjon u16(buf, v) { legg_til(buf, v & 255)
legg_til(buf, (v >> 8) & 255) }
funksjon u32(buf, v) {
    legg_til(buf, v & 255)
    legg_til(buf, (v >> 8) & 255)
    legg_til(buf, (v >> 16) & 255)
    legg_til(buf, (v >> 24) & 255)
}
funksjon u64(buf, v) {
    legg_til(buf, v & 255)
    legg_til(buf, (v >> 8) & 255)
    legg_til(buf, (v >> 16) & 255)
    legg_til(buf, (v >> 24) & 255)
    legg_til(buf, (v >> 32) & 255)
    legg_til(buf, (v >> 40) & 255)
    legg_til(buf, (v >> 48) & 255)
    legg_til(buf, (v >> 56) & 255)
}
funksjon zeros(buf, n)  { la i: heltall = 0
mens i < n { legg_til(buf, 0)
i = i + 1 } }
funksjon copy(dst, src) { la i: heltall = 0
mens i < lengde(src) { legg_til(dst, src[i])
i = i + 1 } }
funksjon pad(buf, target) { mens lengde(buf) < target { legg_til(buf, 0) } }

funksjon patch_abs_jump(bytes, start: heiltall, slutt: heiltall, target: heiltall) {
    // movabs rax,target; jmp rax; NOP fram til neste faste runtime-entry.
    bytes[start] = 0x48
    bytes[start + 1] = 0xB8
    la encoded: liste = []
    u64(encoded, target)
    la i: heiltall = 0
    mens i < 8 {
        bytes[start + 2 + i] = encoded[i]
        i = i + 1
    }
    bytes[start + 10] = 0xFF
    bytes[start + 11] = 0xE0
    i = start + 12
    mens i < slutt {
        bytes[i] = 0x90
        i = i + 1
    }
}

funksjon patch_u64_verdi(bytes, gammal: heiltall, ny: heiltall, venta: heiltall) {
    la gammal_bytes: liste = []
    la ny_bytes: liste = []
    u64(gammal_bytes, gammal)
    u64(ny_bytes, ny)
    la funne: heiltall = 0
    la i: heiltall = 0
    mens i + 7 < lengde(bytes) {
        la lik = sann
        la j: heiltall = 0
        mens j < 8 {
            hvis bytes[i + j] != gammal_bytes[j] { lik = usann }
            j = j + 1
        }
        hvis lik {
            j = 0
            mens j < 8 {
                bytes[i + j] = ny_bytes[j]
                j = j + 1
            }
            funne = funne + 1
            i = i + 8
        } ellers {
            i = i + 1
        }
    }
    hvis funne != venta {
        kast "native codegen: venta " + tekst_fra_heltall(venta) + " u64-relokering(ar), fann " + tekst_fra_heltall(funne)
    }
}

funksjon emit_cached_int_runtime(bytes) -> heiltall {
    la va = TEXT_VA() + lengde(bytes)
    // rdi = rå i64. Cache berre det trygge, tett brukte intervallet.
    copy(bytes, [0x48, 0x81, 0xFF])              // cmp rdi,-32768
    u32(bytes, 4294934528)
    copy(bytes, [0x0F, 0x8C])                    // jl fallback
    la jl_fallback = lengde(bytes)
    u32(bytes, 0)
    copy(bytes, [0x48, 0x81, 0xFF])              // cmp rdi,32767
    u32(bytes, 32767)
    copy(bytes, [0x0F, 0x8F])                    // jg fallback
    la jg_fallback = lengde(bytes)
    u32(bytes, 0)
    copy(bytes, [0x48, 0x89, 0xF8])              // mov rax,rdi
    copy(bytes, [0x48, 0x05])                    // add rax,32768
    u32(bytes, 32768)
    copy(bytes, [0x48, 0xC1, 0xE0, 0x04])        // shl rax,4
    copy(bytes, [0x48, 0xB9])
    u64(bytes, SMALL_INT_CACHE_BASE())            // movabs rcx,cache
    copy(bytes, [0x48, 0x01, 0xC8])              // add rax,rcx
    copy(bytes, [0x48, 0xC7, 0x00])
    u32(bytes, 1)                                 // type=int
    copy(bytes, [0x48, 0x89, 0x78, 0x08, 0xC3])  // payload; ret

    la fallback = lengde(bytes)
    copy(bytes, [0x48, 0xB9])
    u64(bytes, HEAP_VA())                         // rcx=&bump
    copy(bytes, [0x48, 0x8B, 0x01])              // rax=[rcx]
    copy(bytes, [0x48, 0x8D, 0x50, 0x10])        // rdx=rax+16
    copy(bytes, [0x48, 0x89, 0x11])              // [rcx]=rdx
    copy(bytes, [0x48, 0xC7, 0x00])
    u32(bytes, 1)
    copy(bytes, [0x48, 0x89, 0x78, 0x08, 0xC3])
    patch_jump(bytes, jl_fallback, fallback)
    patch_jump(bytes, jg_fallback, fallback)
    returner va
}

funksjon emit_cached_bool_runtime(bytes) -> heiltall {
    la va = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x85, 0xFF])              // test rdi,rdi
    copy(bytes, [0x40, 0x0F, 0x95, 0xC7])        // setne dil
    copy(bytes, [0x48, 0x0F, 0xB6, 0xFF])        // movzx rdi,dil
    copy(bytes, [0x48, 0x89, 0xF8])              // mov rax,rdi
    copy(bytes, [0x48, 0xC1, 0xE0, 0x04])        // shl rax,4
    copy(bytes, [0x48, 0xB9])
    u64(bytes, BOOL_CACHE_BASE())
    copy(bytes, [0x48, 0x01, 0xC8])
    copy(bytes, [0x48, 0xC7, 0x00])
    u32(bytes, 5)                                 // type=bool
    copy(bytes, [0x48, 0x89, 0x78, 0x08, 0xC3])
    returner va
}

funksjon emit_cached_str_raw_runtime(bytes) -> heiltall {
    la va = TEXT_VA() + lengde(bytes)
    // rdi=rå bytes, rsi=lengd. Tekstindeksering produserer alltid eitt byte;
    // returner då ein kanonisk, immutable NcVal frå 256-postars cache.
    copy(bytes, [0x48, 0x83, 0xFE, 0x01])                 // cmp rsi,1
    copy(bytes, [0x0F, 0x85])                             // jne fallback
    la jne_fallback = lengde(bytes)
    u32(bytes, 0)
    copy(bytes, [0x0F, 0xB6, 0x07])                       // movzx eax,byte [rdi]
    copy(bytes, [0x48, 0xC1, 0xE0, 0x05])                 // shl rax,5
    copy(bytes, [0x48, 0xB9])
    u64(bytes, CHAR_CACHE_BASE())
    copy(bytes, [0x48, 0x01, 0xC8])                       // add rax,rcx
    copy(bytes, [0x48, 0xC7, 0x00])
    u32(bytes, 2)                                          // NcVal type=str
    copy(bytes, [0x48, 0x8D, 0x50, 0x10])                 // rdx=rax+16
    copy(bytes, [0x48, 0x89, 0x50, 0x08])                 // payload=rdx
    copy(bytes, [0x48, 0xC7, 0x02])
    u32(bytes, 1)                                          // string len=1
    copy(bytes, [0x8A, 0x0F, 0x88, 0x4A, 0x08])           // byte payload
    copy(bytes, [0xC6, 0x42, 0x09, 0x00, 0xC3])           // NUL; ret

    la fallback = lengde(bytes)
    // Generell dynamisk streng: alloker [len,bytes,NUL] og NcVal.
    copy(bytes, [0x53, 0x41, 0x54, 0x41, 0x55])            // save
    copy(bytes, [0x49, 0x89, 0xFC, 0x49, 0x89, 0xF5])      // r12=src;r13=len
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])
    u32(bytes, HEAP_VA())                                  // rax=bump
    copy(bytes, [0x48, 0x89, 0xC3])                        // rbx=obj
    copy(bytes, [0x4A, 0x8D, 0x4C, 0x28, 0x09])            // rcx=rax+r13+9
    copy(bytes, [0x48, 0x89, 0x0C, 0x25])
    u32(bytes, HEAP_VA())
    copy(bytes, [0x4C, 0x89, 0x2B, 0x48, 0x31, 0xC9])      // len; i=0
    la copy_loop = lengde(bytes)
    copy(bytes, [0x4C, 0x39, 0xE9])                        // cmp rcx,r13
    la je_copied = emit_je_placeholder(bytes)
    copy(bytes, [0x41, 0x8A, 0x14, 0x0C])                 // dl=[r12+rcx]
    copy(bytes, [0x88, 0x54, 0x0B, 0x08])                 // [rbx+rcx+8]=dl
    copy(bytes, [0x48, 0xFF, 0xC1])                        // inc rcx
    copy(bytes, [0xE9])
    la loop_jump = lengde(bytes)
    u32(bytes, 0)
    la copied = lengde(bytes)
    copy(bytes, [0x42, 0xC6, 0x44, 0x2B, 0x08, 0x00])      // trailing NUL
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0x8D, 0x48, 0x10, 0x48, 0x89, 0x0C, 0x25])
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0xC7, 0x00])
    u32(bytes, 2)
    copy(bytes, [0x48, 0x89, 0x58, 0x08])
    copy(bytes, [0x41, 0x5D, 0x41, 0x5C, 0x5B, 0xC3])
    patch_jump(bytes, jne_fallback, fallback)
    patch_jump(bytes, loop_jump, copy_loop)
    patch_jump(bytes, je_copied, copied)
    returner va
}

// Lineær tekst-join for liste<NcVal-tekst>. Legacy-rutinen bygde resultatet
// med eitt RT_CONCAT-kall per del og heldt alle mellomstrengane levande i den
// monotone AOT-heapen. Denne rutinen måler total lengd, allokerer éin råstreng
// og kopierer separator/delar direkte før han materialiserer eitt NcVal.
funksjon emit_linear_join_runtime(bytes) -> heiltall {
    la va = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x55, 0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57])
    copy(bytes, [0x48, 0x8B, 0x47, 0x08])                 // rax=listobj
    copy(bytes, [0x4C, 0x8B, 0x20])                       // r12=count
    copy(bytes, [0x4C, 0x8B, 0x68, 0x10])                 // r13=items
    // builtin.join stringifiserer ikkje-streng-element (VM: join([1,2,3],",")
    // = "1,2,3"). Måle-/kopipassa under antek streng-payload; deref av eit
    // heiltals-NcVal (item+8 = rå verdi, ikkje peikar) gav signal 139. Normaliser
    // difor kvart ikkje-streng-element (type != 2) til eit streng-NcVal via
    // RT_INT_TO_STR før passa. rsi(sep)/rbp/r12/r13 blir bevarte over kallet.
    copy(bytes, [0x31, 0xED])                             // i=0
    la norm_loop = lengde(bytes)
    copy(bytes, [0x4C, 0x39, 0xE5])                       // cmp i,count
    la je_norm_done = emit_je_placeholder(bytes)
    copy(bytes, [0x49, 0x8B, 0x44, 0xED, 0x00])           // item=items[i]
    copy(bytes, [0x48, 0x83, 0x38, 0x02])                 // type==str(2)?
    la je_norm_next = emit_je_placeholder(bytes)
    copy(bytes, [0x56, 0x55, 0x41, 0x54, 0x41, 0x55])     // push rsi,rbp,r12,r13
    copy(bytes, [0x48, 0x89, 0xC7])                       // rdi=item (int NcVal)
    call_rel32(bytes, RT_INT_TO_STR(), TEXT_VA())         // rax=streng-NcVal
    copy(bytes, [0x41, 0x5D, 0x41, 0x5C, 0x5D, 0x5E])     // pop r13,r12,rbp,rsi
    copy(bytes, [0x49, 0x89, 0x44, 0xED, 0x00])           // items[i]=rax
    la norm_next = lengde(bytes)
    patch_jump(bytes, je_norm_next, norm_next)
    copy(bytes, [0x48, 0xFF, 0xC5])                       // i++
    la jmp_norm = emit_jmp_placeholder(bytes)
    patch_jump(bytes, jmp_norm, norm_loop)
    la norm_done = lengde(bytes)
    patch_jump(bytes, je_norm_done, norm_done)
    copy(bytes, [0x48, 0x8B, 0x46, 0x08])                 // rax=sep raw
    copy(bytes, [0x49, 0x89, 0xC6])                       // r14=sep raw
    copy(bytes, [0x4C, 0x8B, 0x38])                       // r15=sep len
    copy(bytes, [0x31, 0xDB, 0x31, 0xED])                 // total=0;i=0

    la sum_loop = lengde(bytes)
    copy(bytes, [0x4C, 0x39, 0xE5])                       // cmp i,count
    la je_sum_done = emit_je_placeholder(bytes)
    copy(bytes, [0x49, 0x8B, 0x44, 0xED, 0x00])           // item=items[i]
    copy(bytes, [0x48, 0x8B, 0x40, 0x08])                 // raw=item.payload
    copy(bytes, [0x48, 0x03, 0x18])                       // total += raw.len
    copy(bytes, [0x48, 0xFF, 0xC5])                       // i++
    la jmp_sum = emit_jmp_placeholder(bytes)
    patch_jump(bytes, jmp_sum, sum_loop)
    la sum_done = lengde(bytes)
    patch_jump(bytes, je_sum_done, sum_done)
    copy(bytes, [0x49, 0x83, 0xFC, 0x01])                 // count <= 1?
    copy(bytes, [0x0F, 0x86])                             // jbe no_separator_total
    la jbe_no_sep_total = lengde(bytes)
    u32(bytes, 0)
    copy(bytes, [0x4C, 0x89, 0xE0, 0x48, 0xFF, 0xC8])     // rax=count-1
    copy(bytes, [0x49, 0x0F, 0xAF, 0xC7])                 // rax*=sep_len
    copy(bytes, [0x48, 0x01, 0xC3])                       // total+=rax
    la no_sep_total = lengde(bytes)
    patch_jump(bytes, jbe_no_sep_total, no_sep_total)

    copy(bytes, [0x4C, 0x8B, 0x1C, 0x25])
    u32(bytes, HEAP_VA())                                  // r11=raw object
    copy(bytes, [0x49, 0x89, 0x1B])                       // raw.len=total
    copy(bytes, [0x4D, 0x8D, 0x53, 0x08])                 // r10=write cursor
    copy(bytes, [0x31, 0xED])                             // i=0

    la copy_loop = lengde(bytes)
    copy(bytes, [0x4C, 0x39, 0xE5])                       // cmp i,count
    la je_copy_done = emit_je_placeholder(bytes)
    copy(bytes, [0x48, 0x85, 0xED])                       // first item?
    la je_skip_separator = emit_je_placeholder(bytes)
    copy(bytes, [0x4C, 0x89, 0xD7])                       // rdi=cursor
    copy(bytes, [0x49, 0x8D, 0x76, 0x08])                 // rsi=sep bytes
    copy(bytes, [0x4C, 0x89, 0xF9])                       // rcx=sep len
    copy(bytes, [0xF3, 0xA4, 0x49, 0x89, 0xFA])           // copy;cursor=rdi
    la skip_separator = lengde(bytes)
    patch_jump(bytes, je_skip_separator, skip_separator)
    copy(bytes, [0x49, 0x8B, 0x44, 0xED, 0x00])           // item=items[i]
    copy(bytes, [0x48, 0x8B, 0x40, 0x08])                 // raw=item.payload
    copy(bytes, [0x48, 0x8B, 0x08])                       // rcx=raw.len
    copy(bytes, [0x48, 0x8D, 0x70, 0x08])                 // rsi=raw.bytes
    copy(bytes, [0x4C, 0x89, 0xD7, 0xF3, 0xA4])           // rdi=cursor;copy
    copy(bytes, [0x49, 0x89, 0xFA, 0x48, 0xFF, 0xC5])     // cursor=rdi;i++
    la jmp_copy = emit_jmp_placeholder(bytes)
    patch_jump(bytes, jmp_copy, copy_loop)

    la copy_done = lengde(bytes)
    patch_jump(bytes, je_copy_done, copy_done)
    copy(bytes, [0x41, 0xC6, 0x02, 0x00])                 // trailing NUL
    copy(bytes, [0x49, 0x8D, 0x42, 0x01])                 // bump=cursor+1
    copy(bytes, [0x48, 0x89, 0x04, 0x25])
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])
    u32(bytes, HEAP_VA())                                  // rax=NcVal
    copy(bytes, [0x48, 0x8D, 0x48, 0x10])
    copy(bytes, [0x48, 0x89, 0x0C, 0x25])
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0xC7, 0x00])
    u32(bytes, 2)                                          // type=str
    copy(bytes, [0x4C, 0x89, 0x58, 0x08])                 // payload=raw
    copy(bytes, [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B, 0x5D, 0xC3])
    returner va
}

// ─── Innebygd NCB-format ────────────────────────────────────────────────────
//
// ELF-fila endar med:
//   [rå NCB JSON]["NORSCODE_NCB_V1"][u64 payload-lengde, little-endian]
//
// Data etter siste lastbare ELF-segment blir ignorerte av OS-loaderen. Dermed
// er binæren framleis direkte køyrbar, medan eksakt NCB kan verifiserast eller
// hentast ut utan ei ekstern .ncb.json-fil.
funksjon NCB_EMBED_MAGIC() -> tekst { returner "NORSCODE_NCB_V1" }

funksjon legg_innebygd_named_ncb(bytes, namn: tekst, payload: tekst) {
    // Skriv tekst direkte i sluttbufferen. Store compiler-/runtime-payloadar
    // skal ikkje materialiserast som ei ekstra liste<heiltall> før kopiering.
    copy_tekst_bytes(bytes, payload)
    copy_tekst_bytes(bytes, namn)
    u64(bytes, lengde(payload))
    u32(bytes, lengde(namn))
    copy_tekst_bytes(bytes, "NCB_RECORD_V1")
    u32(bytes, 1)
    copy_tekst_bytes(bytes, "NORSCODE_NCB_IMAGE_V1")
}

funksjon copy_tekst_bytes(dst: liste<heltall>, verdi: tekst) {
    la i = 0
    mens i < lengde(verdi) {
        legg_til(dst, builtin.char_code(verdi[i]) & 255)
        i = i + 1
    }
}

funksjon tekst_til_bytes(verdi: tekst) -> liste<heltall> {
    la bytes: liste<heltall> = []
    la i = 0
    mens i < lengde(verdi) {
        legg_til(bytes, builtin.char_code(verdi[i]) & 255)
        i = i + 1
    }
    returner bytes
}

funksjon legg_innebygd_ncb(binær: liste<heltall>, ncb_json: tekst) -> liste<heltall> {
    copy_tekst_bytes(binær, ncb_json)
    copy_tekst_bytes(binær, NCB_EMBED_MAGIC())
    u64(binær, lengde(ncb_json))
    returner binær
}

funksjon les_u64_le_fra(bytes: liste<heltall>, start: heiltall) -> heiltall {
    la verdi: heiltall = 0
    la i = 7
    mens i >= 0 {
        verdi = (verdi << 8) | bytes[start + i]
        i = i - 1
    }
    returner verdi
}

funksjon har_innebygd_ncb(bytes: liste<heltall>) -> boolsk {
    la magic = tekst_til_bytes(NCB_EMBED_MAGIC())
    la trailer_lengde = lengde(magic) + 8
    hvis lengde(bytes) < trailer_lengde { returner usann }
    la magic_start = lengde(bytes) - trailer_lengde
    la i = 0
    mens i < lengde(magic) {
        hvis bytes[magic_start + i] != magic[i] { returner usann }
        i = i + 1
    }
    la payload_lengde = les_u64_le_fra(bytes, lengde(bytes) - 8)
    returner payload_lengde > 0 og payload_lengde <= magic_start
}

funksjon hent_innebygd_ncb(bytes: liste<heltall>) -> tekst {
    hvis ikkje har_innebygd_ncb(bytes) { kast "Native binær manglar innebygd NCB" }
    la payload_lengde = les_u64_le_fra(bytes, lengde(bytes) - 8)
    la payload_start = lengde(bytes) - 8 - lengde(NCB_EMBED_MAGIC()) - payload_lengde
    la ut = ""
    la i = 0
    mens i < payload_lengde {
        ut = ut + builtin.chr(bytes[payload_start + i])
        i = i + 1
    }
    returner ut
}
funksjon call_rel32(buf, va, code_va) {
    // call target_va: E8 rel32 — code_va = absolut VA for buf[0]
    legg_til(buf, 0xE8)
    la rel = (va - (code_va + lengde(buf) + 4)) & 0xFFFFFFFF
    u32(buf, rel)
}
funksjon jump_rel32(buf, va, code_va) {
    legg_til(buf, 0xE9)
    la rel = (va - (code_va + lengde(buf) + 4)) & 0xFFFFFFFF
    u32(buf, rel)
}
// ─── Runtime-kall-hjelparar ───────────────────────────────────────────────────
// call_rt_1arg: pop rdi
funksjon emit_rt_call_1(buf, rt_va, code_va) {
    legg_til(buf, 0x5F)           // pop rdi
    call_rel32(buf, rt_va, code_va)
    legg_til(buf, 0x50)           // push rax
}
// call_rt_2arg: pop rsi (b/top)
funksjon emit_rt_call_2(buf, rt_va, code_va) {
    legg_til(buf, 0x5E)           // pop rsi
    legg_til(buf, 0x5F)           // pop rdi
    call_rel32(buf, rt_va, code_va)
    legg_til(buf, 0x50)           // push rax
}
// call_rt_3arg: pop rdx (c)
funksjon emit_rt_call_3(buf, rt_va, code_va) {
    legg_til(buf, 0x5A)           // pop rdx
    legg_til(buf, 0x5E)           // pop rsi
    legg_til(buf, 0x5F)           // pop rdi
    call_rel32(buf, rt_va, code_va)
    legg_til(buf, 0x50)           // push rax
}
funksjon emit_raw_bool_rt_call_2(buf, rt_va, code_va) {
    legg_til(buf, 0x5E)           // pop rsi
    legg_til(buf, 0x5F)           // pop rdi
    call_rel32(buf, rt_va, code_va)
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xC7)           // mov rdi, rax
    call_rel32(buf, RT_BOOL(), code_va)
    legg_til(buf, 0x50)
}
funksjon emit_int_order_compare_inline(buf, op: tekst, code_va) {
    legg_til(buf, 0x5E)                       // pop rsi = høgre NcVal*
    legg_til(buf, 0x5F)                       // pop rdi = venstre NcVal*
    copy(buf, [0x48, 0x8B, 0x47, 0x08])       // rax = venstre payload
    copy(buf, [0x48, 0x3B, 0x46, 0x08])       // cmp rax,[rsi+8]
    hvis op == "ge" { copy(buf, [0x0F, 0x9D, 0xC0]) }
    ellers { copy(buf, [0x0F, 0x9E, 0xC0]) }
    copy(buf, [0x0F, 0xB6, 0xF8])             // movzx edi,al
    call_rel32(buf, RT_BOOL(), code_va)
    legg_til(buf, 0x50)
}
funksjon emit_null_safe_compare(buf, rt_va, ulik: boolsk, code_va) {
    legg_til(buf, 0x5E)
    legg_til(buf, 0x5F)
    copy(buf, [0x48, 0x85, 0xFF])
    la je_null_l = emit_je_placeholder(buf)
    copy(buf, [0x48, 0x85, 0xF6])
    la je_null_r = emit_je_placeholder(buf)
    call_rel32(buf, rt_va, code_va)
    legg_til(buf, 0x50)
    la jmp_end = emit_jmp_placeholder(buf)
    la lbl_null = lengde(buf)
    copy(buf, [0x48, 0x39, 0xF7])
    hvis ulik { copy(buf, [0x0F, 0x95, 0xC0]) }
    ellers { copy(buf, [0x0F, 0x94, 0xC0]) }
    copy(buf, [0x0F, 0xB6, 0xF8])
    call_rel32(buf, RT_BOOL(), code_va)
    legg_til(buf, 0x50)
    la lbl_end = lengde(buf)
    patch_jump(buf, je_null_l, lbl_null)
    patch_jump(buf, je_null_r, lbl_null)
    patch_jump(buf, jmp_end, lbl_end)
}

funksjon emit_null_safe_index_get(buf, code_va) {
    legg_til(buf, 0x5E)
    legg_til(buf, 0x5F)
    copy(buf, [0x48, 0x85, 0xFF])
    la je_null = emit_je_placeholder(buf)
    call_rel32(buf, RT_INDEX_GET(), code_va)
    legg_til(buf, 0x50)
    la jmp_end = emit_jmp_placeholder(buf)
    la lbl_null = lengde(buf)
    copy(buf, [0x48, 0x31, 0xC0, 0x50])   // xor rax,rax; push (behald rå NULL-semantikk)
    la lbl_end = lengde(buf)
    patch_jump(buf, je_null, lbl_null)
    patch_jump(buf, jmp_end, lbl_end)
}
// Null-trygg INDEX_SET: speglar emit_null_safe_index_get, men poppar 3 operandar
// (verdi=rdx, nøkkel=rsi, container=rdi) og hoppar over RT_INDEX_SET når
// containeren er Norscode-null (rå 0) — elles skreiv INDEX_SET gjennom
// nullpeikaren og gav signal 139. Resultatet blir null ved null-container,
// same silent-null-semantikk som INDEX_GET.
funksjon emit_null_safe_index_set(buf, code_va) {
    legg_til(buf, 0x5A)                  // pop rdx (verdi)
    legg_til(buf, 0x5E)                  // pop rsi (nøkkel)
    legg_til(buf, 0x5F)                  // pop rdi (container)
    copy(buf, [0x48, 0x85, 0xFF])        // test rdi, rdi
    la je_null = emit_je_placeholder(buf)
    call_rel32(buf, RT_INDEX_SET(), code_va)
    legg_til(buf, 0x50)                  // push rax (resultat)
    la jmp_end = emit_jmp_placeholder(buf)
    la lbl_null = lengde(buf)
    copy(buf, [0x48, 0x31, 0xC0, 0x50])  // xor rax, rax ; push rax  (= null)
    la lbl_end = lengde(buf)
    patch_jump(buf, je_null, lbl_null)
    patch_jump(buf, jmp_end, lbl_end)
}
// emit_push_imm64: mov rax, imm64
funksjon emit_push_imm64(buf, v) {
    legg_til(buf, 0x48)
    legg_til(buf, 0xB8)
    u64(buf, v)  // mov rax, v
    legg_til(buf, 0x50)                                      // push rax
}
funksjon emit_sys_write_marker(buf, ch: tekst) {
    la code: heltall = builtin.char_code(ch)
    la imm: heltall = code + (10 * 256)  // "<ch>\\n"
    emit_push_imm64(buf, imm)
    // write(2, rsp, 2)
    legg_til(buf, 0x48)
    legg_til(buf, 0xC7)
    legg_til(buf, 0xC0)
    u32(buf, 1)   // mov rax, 1
    legg_til(buf, 0x48)
    legg_til(buf, 0xC7)
    legg_til(buf, 0xC7)
    u32(buf, 2)   // mov rdi, 2
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xE6)  // mov rsi, rsp
    legg_til(buf, 0x48)
    legg_til(buf, 0xC7)
    legg_til(buf, 0xC2)
    u32(buf, 2)   // mov rdx, 2
    legg_til(buf, 0x0F)
    legg_til(buf, 0x05)  // syscall
    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xC4)
    legg_til(buf, 0x08)  // add rsp, 8
}
// ─── Funksjonsprolog/epilog ───────────────────────────────────────────────────
funksjon prolog(buf, n_local) {
    legg_til(buf, 0x55)                             // push rbp
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xE5)  // mov rbp, rsp
    la raw: heltall = (n_local + 1) * 8
    la sz: heltall = ((raw + 15) / 16) * 16         // SysV: RSP ≡ 8 (mod 16) før call
    legg_til(buf, 0x48)
    legg_til(buf, 0x81)
    legg_til(buf, 0xEC)
    u32(buf, sz)                                    // sub rsp, sz
}
funksjon epilog(buf) {
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xEC)  // mov rsp, rbp
    legg_til(buf, 0x5D)                             // pop rbp
    legg_til(buf, 0xC3)                             // ret
}
// ─── Variablar (rbp-relative slottar, 8 bytes kvar) ──────────────────────────
funksjon samle_vars(kode, params) {
    la vars = {}
    la slot: heltall = 0
    la pi: heiltall = 0
    mens pi < lengde(params) {
        la pnm = tekst(params[pi])
        hvis ikke finnes_nøkkel(vars, pnm) {
            slot = slot + 1
            vars[pnm] = slot
        }
        pi = pi + 1
    }
    la i: heltall = 0
    mens i < lengde(kode) {
        la op = kode[i][0]
        la er_store = op == "STORE_NAME"
        la er_param = op == "PARAM"
        hvis er_store eller er_param {
            la nm = tekst(kode[i][1])
            hvis ikke finnes_nøkkel(vars, nm) {
                slot = slot + 1
                vars[nm] = slot
            }
        }
        i = i + 1
    }
    returner vars
}
// rbp_offset(slot): adresse = rbp - slot*8
funksjon rbp_off(slot) { returner (0 - slot * 8) & 0xFFFFFFFF }
// emit_store_var: pop rax; mov [rbp+disp], rax
funksjon emit_store(buf, slot) {
    la disp = rbp_off(slot)
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0x85)
    u32(buf, disp)  // mov [rbp + disp], rax — but we need to pop first
    // Actually: pop rax first
}
funksjon emit_store_var(buf, vars, nm) {
    la slot: heltall = 0
    hvis finnes_nøkkel(vars, nm) { slot = vars[nm] }
    la disp = rbp_off(slot)
    legg_til(buf, 0x58)  // pop rax
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0x85)
    u32(buf, disp)
}
funksjon emit_load_var(buf, vars, nm) {
    la slot: heltall = 0
    hvis finnes_nøkkel(vars, nm) { slot = vars[nm] }
    la disp = rbp_off(slot)
    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x85)
    u32(buf, disp)       // mov rax, [rbp + disp]
    legg_til(buf, 0x50)  // push rax
}
// ─── Hopp-instruksjonar ───────────────────────────────────────────────────────
funksjon emit_jmp_placeholder(buf) {
    legg_til(buf, 0xE9)
    u32(buf, 0)  // jmp rel32 (5 bytes)
    returner lengde(buf) - 4          // posisjon til rel32-feltet
}
funksjon emit_jz_placeholder(buf, code_va) {
    // JUMP_IF_FALSE: pop rdi
    legg_til(buf, 0x5F)               // pop rdi (NcVal*)
    la rt_va = RT_TRUTHY()
    call_rel32(buf, rt_va, code_va)
    legg_til(buf, 0x48)
    legg_til(buf, 0x85)
    legg_til(buf, 0xC0)  // test rax,rax
    legg_til(buf, 0x0F)
    legg_til(buf, 0x84)
    u32(buf, 0)  // jz rel32
    returner lengde(buf) - 4          // posisjon til rel32-feltet
}
funksjon emit_jz_bool_placeholder(buf) {
    legg_til(buf, 0x5F)               // pop rdi = bool NcVal*
    copy(buf, [0x48, 0x8B, 0x47, 0x08]) // rax = bool payload
    copy(buf, [0x48, 0x85, 0xC0])     // test rax,rax
    legg_til(buf, 0x0F)
    legg_til(buf, 0x84)
    u32(buf, 0)
    returner lengde(buf) - 4
}
funksjon emit_je_placeholder(buf) {
    legg_til(buf, 0x0F)
    legg_til(buf, 0x84)
    u32(buf, 0)  // je rel32
    returner lengde(buf) - 4
}
funksjon emit_jne_placeholder(buf) {
    legg_til(buf, 0x0F)
    legg_til(buf, 0x85)
    u32(buf, 0)  // jne rel32
    returner lengde(buf) - 4
}
funksjon patch_jump(buf, patch_pos, target_pos) {
    la rel = (target_pos - (patch_pos + 4)) & 0xFFFFFFFF
    buf[patch_pos]     = rel & 255
    buf[patch_pos + 1] = (rel >> 8) & 255
    buf[patch_pos + 2] = (rel >> 16) & 255
    buf[patch_pos + 3] = (rel >> 24) & 255
}

funksjon tstack_top(tstack) {
    hvis lengde(tstack) == 0 { returner "any" }
    returner tstack[lengde(tstack) - 1]
}

funksjon tstack_top_2(tstack) {
    hvis lengde(tstack) < 2 { returner "any" }
    returner tstack[lengde(tstack) - 2]
}

funksjon tstack_drop(tstack, n) {
    la i: heltall = 0
    mens i < n og lengde(tstack) > 0 {
        fjern_siste(tstack)
        i = i + 1
    }
}

funksjon legg_til_streng_ein_gong(strenger, s: tekst) {
    la funnen: boolsk = usann
    la si: heiltall = 0
    mens si < lengde(strenger) {
        hvis strenger[si] == s { funnen = sann }
        si = si + 1
    }
    hvis ikke funnen { legg_til(strenger, s) }
}

funksjon call_result_type(fn_nm: tekst) {
    hvis fn_nm == "builtin.exit" eller fn_nm == "exit" eller fn_nm == "stopp" eller builtin.ends_with(fn_nm, ".exit") eller builtin.ends_with(fn_nm, ".stopp") { returner "null" }
    hvis builtin.ends_with(fn_nm, ".tekst_fra_heltall") eller fn_nm == "tekst_fra_heltall" { returner "str" }
    hvis builtin.ends_with(fn_nm, ".tekst") eller fn_nm == "tekst" eller fn_nm == "til_tekst" eller builtin.ends_with(fn_nm, ".til_tekst") { returner "str" }
    hvis builtin.ends_with(fn_nm, ".heltall_fra_tekst") eller fn_nm == "heltall_fra_tekst" eller fn_nm == "heltall" eller builtin.ends_with(fn_nm, ".heltall") { returner "int" }
    hvis builtin.ends_with(fn_nm, ".lengde") eller fn_nm == "lengde" { returner "int" }
    hvis builtin.ends_with(fn_nm, ".char_code") eller fn_nm == "char_code" { returner "int" }
    hvis fn_nm == "builtin.native_heap_bytes" { returner "int" }
    hvis builtin.ends_with(fn_nm, ".atomic_load_ptr") eller builtin.ends_with(fn_nm, ".atomic_store_ptr") eller builtin.ends_with(fn_nm, ".atomic_exchange_ptr") eller builtin.ends_with(fn_nm, ".atomic_compare_exchange_ptr") eller builtin.ends_with(fn_nm, ".atomic_fetch_add_ptr") eller builtin.ends_with(fn_nm, ".atomic_fence") { returner "int" }
    hvis builtin.ends_with(fn_nm, ".fil_les") eller fn_nm == "fil_les" { returner "str" }
    hvis builtin.ends_with(fn_nm, ".fil_skriv") eller fn_nm == "fil_skriv" { returner "null" }
    hvis builtin.ends_with(fn_nm, ".fil_skriv_binar") eller fn_nm == "fil_skriv_binar" eller builtin.ends_with(fn_nm, ".fil_skriv_binary") eller fn_nm == "fil_skriv_binary" { returner "null" }
    hvis builtin.ends_with(fn_nm, ".fil_finnes") eller fn_nm == "fil_finnes" { returner "bool" }
    hvis builtin.ends_with(fn_nm, ".miljo_hent") eller fn_nm == "miljo_hent" { returner "str" }
    hvis fn_nm == "builtin.system_info" eller fn_nm == "system_info" { returner "map" }
    hvis builtin.ends_with(fn_nm, ".miljo_finnes") eller fn_nm == "miljo_finnes" { returner "bool" }
    hvis builtin.ends_with(fn_nm, ".ny_liste") eller fn_nm == "ny_liste" eller fn_nm == "liste_ny" eller fn_nm == "ny_tekst_liste" { returner "list" }
    hvis builtin.ends_with(fn_nm, ".ny_map") eller builtin.ends_with(fn_nm, ".ny_map_native") eller fn_nm == "ny_map" eller fn_nm == "ny_map_native" { returner "map" }
    hvis fn_nm == "map_get" eller builtin.ends_with(fn_nm, ".map_get") { returner "any" }
    hvis fn_nm == "map_set" eller builtin.ends_with(fn_nm, ".map_set") { returner "null" }
    hvis builtin.ends_with(fn_nm, ".har_nokkel") eller fn_nm == "har_nokkel" eller builtin.ends_with(fn_nm, ".finnes_nøkkel") eller fn_nm == "finnes_nokkel" { returner "bool" }
    hvis fn_nm == "nøkler" eller builtin.ends_with(fn_nm, ".nøkler") { returner "list" }
    hvis fn_nm == "verdier" eller builtin.ends_with(fn_nm, ".verdier") { returner "list" }
    hvis fn_nm == "fjern_nokkel" eller builtin.ends_with(fn_nm, ".fjern_nokkel") { returner "any" }
    hvis fn_nm == "json_parse" eller fn_nm == "json_parse_raw" eller builtin.ends_with(fn_nm, ".json_parse") eller builtin.ends_with(fn_nm, ".json_parse_raw") { returner "map" }
    hvis fn_nm == "json_stringify" eller fn_nm == "json_skriv" eller builtin.ends_with(fn_nm, ".json_stringify") eller builtin.ends_with(fn_nm, ".json_skriv") { returner "str" }
    hvis builtin.ends_with(fn_nm, ".skriv") eller fn_nm == "skriv" { returner "null" }
    returner "any"
}

// ─── PUSH_CONST ──────────────────────────────────────────────────────────────
funksjon emit_push_const(buf, v, rd_offs, code_va) {
    la detaljsporing = miljo_hent("NC_NATIVE_CODEGEN_TRACE_INSTR") == "1"
    hvis detaljsporing { native_codegen_trace("push_const enter") }
    la vtype = builtin.type(v)
    hvis detaljsporing { native_codegen_trace("push_const type=" + vtype) }
    hvis v == null {
        // KRITISK: i stage0-VM-en som køyrer denne codegen-en er null ≡ heiltal 0
        // (0 == null er sann, type(null)=="heltall", json/tekst(null)=="0"). Difor
        // fangar `v == null` òg heiltalskonstanten 0. Ein rå NULL-peikar her gjer at
        // COMPARE_* (og andre som dereferer operanden) krasjar på PUSH_CONST 0 —
        // t.d. `lengde(x) > 0`. Boks som ein gyldig int-0-NcVal (som ARM64-codegen),
        // så både 0-literalen og null blir eit trygt dereferbart NcVal.
        emit_push_imm64(buf, 0)           // push 0
        legg_til(buf, 0x5F)               // pop rdi
        call_rel32(buf, RT_INT(), code_va)
        legg_til(buf, 0x50)               // push rax
        returner
    }
    hvis vtype == "heltall" {
        hvis detaljsporing { native_codegen_trace("push_const int branch") }
        // nc_int(i64)
        // Typeporten over har alt stadfesta heiltal. Ei ny heiltall(v)-
        // konvertering blir i AOT-bana sendt til tekst-til-heiltal-runtimen,
        // som er feil for ein allereie boksa heiltalsverdi.
        emit_push_imm64(buf, v)           // push imm64
        hvis detaljsporing { native_codegen_trace("push_const int immediate") }
        legg_til(buf, 0x5F)               // pop rdi (= value)
        hvis detaljsporing { native_codegen_trace("push_const int pop") }
        call_rel32(buf, RT_INT(), code_va)
        hvis detaljsporing { native_codegen_trace("push_const int call") }
        legg_til(buf, 0x50)
        returner
    }
    hvis vtype == "boolsk" {
        la bval: heltall = 0
        hvis v { bval = 1 }
        emit_push_imm64(buf, bval)
        legg_til(buf, 0x5F)
        call_rel32(buf, RT_BOOL(), code_va)
        legg_til(buf, 0x50)
        returner
    }
    // Strengliteralane er immutable, ferdige NcVal-ar i read-only data.
    la s: tekst = tekst(v)
    la rd_off: heltall = 0
    hvis finnes_nøkkel(rd_offs, s) { rd_off = rd_offs[s] }
    la data_ptr: heltall = DATA_VA() + rd_off
    copy(buf, [0x49, 0xBB])  // mov r11, &NcVal
    u64(buf, data_ptr)
    copy(buf, [0x41, 0x53])   // push r11
}

funksjon emit_type_of_inline(buf, rd_offs, code_va) {
    legg_til(buf, 0x5F)  // pop rdi
    legg_til(buf, 0x48)
    legg_til(buf, 0x85)
    legg_til(buf, 0xFF)  // test rdi, rdi
    la je_null = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x07)  // mov rax, [rdi]

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x01)  // cmp rax, 1
    la je_int = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x05)  // cmp rax, 5
    la je_bool = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x02)  // cmp rax, 2
    la je_str = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x03)  // cmp rax, 3
    la je_list = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x04)  // cmp rax, 4
    la je_map = emit_je_placeholder(buf)

    la lbl_default = lengde(buf)
    emit_push_const(buf, "ingenting", rd_offs, code_va)
    la jmp_end_default = emit_jmp_placeholder(buf)

    la lbl_int = lengde(buf)
    emit_push_const(buf, "heltall", rd_offs, code_va)
    la jmp_end_int = emit_jmp_placeholder(buf)

    la lbl_bool = lengde(buf)
    emit_push_const(buf, "boolsk", rd_offs, code_va)
    la jmp_end_bool = emit_jmp_placeholder(buf)

    la lbl_str = lengde(buf)
    emit_push_const(buf, "tekst", rd_offs, code_va)
    la jmp_end_str = emit_jmp_placeholder(buf)

    la lbl_list = lengde(buf)
    emit_push_const(buf, "liste", rd_offs, code_va)
    la jmp_end_list = emit_jmp_placeholder(buf)

    la lbl_map = lengde(buf)
    emit_push_const(buf, "ordbok", rd_offs, code_va)
    la jmp_end_map = emit_jmp_placeholder(buf)

    la lbl_null = lengde(buf)
    emit_push_const(buf, "ingenting", rd_offs, code_va)

    la lbl_end = lengde(buf)
    patch_jump(buf, je_null, lbl_null)
    patch_jump(buf, je_int, lbl_int)
    patch_jump(buf, je_bool, lbl_bool)
    patch_jump(buf, je_str, lbl_str)
    patch_jump(buf, je_list, lbl_list)
    patch_jump(buf, je_map, lbl_map)
    patch_jump(buf, jmp_end_default, lbl_end)
    patch_jump(buf, jmp_end_int, lbl_end)
    patch_jump(buf, jmp_end_bool, lbl_end)
    patch_jump(buf, jmp_end_str, lbl_end)
    patch_jump(buf, jmp_end_list, lbl_end)
    patch_jump(buf, jmp_end_map, lbl_end)
}

funksjon emit_dynamic_add_inline(buf, code_va) {
    legg_til(buf, 0x5E)  // pop rsi
    legg_til(buf, 0x5F)  // pop rdi

    legg_til(buf, 0x48)
    legg_til(buf, 0x85)
    legg_til(buf, 0xFF)  // test rdi, rdi
    la je_fallback_l = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x85)
    legg_til(buf, 0xF6)  // test rsi, rsi
    la je_fallback_r = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x07)  // mov rax, [rdi]
    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x0E)  // mov rcx, [rsi]

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x02)  // cmp rax, 2
    la je_check_rhs_str = emit_je_placeholder(buf)

    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF8)
    legg_til(buf, 0x01)  // cmp rax, 1
    la je_check_rhs_int = emit_je_placeholder(buf)

    la jmp_fallback_from_lhs = emit_jmp_placeholder(buf)

    la lbl_check_rhs_str = lengde(buf)
    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF9)
    legg_til(buf, 0x02)  // cmp rcx, 2
    la je_concat = emit_je_placeholder(buf)
    la jmp_fallback_from_str = emit_jmp_placeholder(buf)

    la lbl_check_rhs_int = lengde(buf)
    legg_til(buf, 0x48)
    legg_til(buf, 0x83)
    legg_til(buf, 0xF9)
    legg_til(buf, 0x01)  // cmp rcx, 1
    la je_add_int = emit_je_placeholder(buf)
    la jmp_fallback_from_int = emit_jmp_placeholder(buf)

    la lbl_concat = lengde(buf)
    call_rel32(buf, RT_CONCAT(), code_va)
    legg_til(buf, 0x50)
    la jmp_end_concat = emit_jmp_placeholder(buf)

    la lbl_add_int = lengde(buf)
    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x47)
    legg_til(buf, 0x08)  // mov rax, [rdi+8]
    legg_til(buf, 0x48)
    legg_til(buf, 0x03)
    legg_til(buf, 0x46)
    legg_til(buf, 0x08)  // add rax, [rsi+8]
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xC7)  // mov rdi, rax
    call_rel32(buf, RT_INT(), code_va)
    legg_til(buf, 0x50)
    la jmp_end_int = emit_jmp_placeholder(buf)

    la lbl_fallback = lengde(buf)
    call_rel32(buf, RT_ADD(), code_va)
    legg_til(buf, 0x50)

    la lbl_end = lengde(buf)
    patch_jump(buf, je_fallback_l, lbl_fallback)
    patch_jump(buf, je_fallback_r, lbl_fallback)
    patch_jump(buf, je_check_rhs_str, lbl_check_rhs_str)
    patch_jump(buf, je_check_rhs_int, lbl_check_rhs_int)
    patch_jump(buf, jmp_fallback_from_lhs, lbl_fallback)
    patch_jump(buf, je_concat, lbl_concat)
    patch_jump(buf, jmp_fallback_from_str, lbl_fallback)
    patch_jump(buf, je_add_int, lbl_add_int)
    patch_jump(buf, jmp_fallback_from_int, lbl_fallback)
    patch_jump(buf, jmp_end_concat, lbl_end)
    patch_jump(buf, jmp_end_int, lbl_end)
}

// Heiltalsoperasjonar på v2-ABI-en. Evalueringsstakken inneheld NcVal*, så
// payloaden må hentast frå +8 før maskininstruksjonen og pakkast med RT_INT.
funksjon emit_int_binary_inline(buf, op: tekst, code_va: heiltall) -> heiltall {
    legg_til(buf, 0x5E) // pop rsi = høgre NcVal*
    legg_til(buf, 0x5F) // pop rdi = venstre NcVal*
    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x47)
    legg_til(buf, 0x08) // mov rax, [rdi+8]
    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x4E)
    legg_til(buf, 0x08) // mov rcx, [rsi+8]
    hvis op == "BINARY_ADD" {
        legg_til(buf, 0x48) legg_til(buf, 0x01) legg_til(buf, 0xC8) // add rax, rcx
    } ellers hvis op == "BINARY_AND" {
        legg_til(buf, 0x48) legg_til(buf, 0x21) legg_til(buf, 0xC8) // and rax, rcx
    } ellers hvis op == "BINARY_OR" {
        legg_til(buf, 0x48) legg_til(buf, 0x09) legg_til(buf, 0xC8) // or rax, rcx
    } ellers hvis op == "BINARY_XOR" {
        legg_til(buf, 0x48) legg_til(buf, 0x31) legg_til(buf, 0xC8) // xor rax, rcx
    } ellers hvis op == "BINARY_LSHIFT" {
        legg_til(buf, 0x48) legg_til(buf, 0xD3) legg_til(buf, 0xE0) // shl rax, cl
    } ellers hvis op == "BINARY_RSHIFT" {
        legg_til(buf, 0x48) legg_til(buf, 0xD3) legg_til(buf, 0xF8) // sar rax, cl
    } ellers {
        kast "Ukjend v2 heiltalsoperasjon: " + op
    }
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xC7) // mov rdi, rax
    call_rel32(buf, RT_INT(), code_va)
    legg_til(buf, 0x50)
    returner 0
}

funksjon emit_int_bnot_inline(buf, code_va: heiltall) -> heiltall {
    legg_til(buf, 0x5F) // pop rdi = NcVal*
    legg_til(buf, 0x48)
    legg_til(buf, 0x8B)
    legg_til(buf, 0x47)
    legg_til(buf, 0x08) // mov rax, [rdi+8]
    legg_til(buf, 0x48)
    legg_til(buf, 0xF7)
    legg_til(buf, 0xD0) // not rax
    legg_til(buf, 0x48)
    legg_til(buf, 0x89)
    legg_til(buf, 0xC7)
    call_rel32(buf, RT_INT(), code_va)
    legg_til(buf, 0x50)
    returner 0
}
// ─── Brukarkall (N argument) ─────────────────────────────────────────────────
// System V: rdi, rsi, rdx, rcx, r8, r9 (arg 0-5)
// Args på stack: arg0 nedst (push sist), arg(n-1) øvst (push fyrst)
// For call f(arg0, arg1): stack=[arg1(top), arg0]
funksjon emit_user_call(buf, fn_va, nargs, code_va) {
    // Breie kall må først hente registerargumenta frå den urørte operandstacken.
    // Elles startar den gamle pop-løkka på indeks 6 og flyttar ingen argument.
    hvis nargs > 6 {
        copy(buf, [0x49, 0x89, 0xE3]) // mov r11,rsp
        la arg_modrm: liste<heltall> = [0xBB, 0xB3, 0x93, 0x8B]
        la ri: heiltall = 0
        mens ri < 6 {
            la arg_disp: heiltall = (nargs - 1 - ri) * 8
            hvis ri < 4 {
                copy(buf, [0x49, 0x8B])
                legg_til(buf, arg_modrm[ri])
            } ellers hvis ri == 4 {
                copy(buf, [0x4D, 0x8B, 0x83]) // mov r8,[r11+disp32]
            } ellers {
                copy(buf, [0x4D, 0x8B, 0x8B]) // mov r9,[r11+disp32]
            }
            u32(buf, arg_disp)
            ri = ri + 1
        }
        // Fjern alle operandargumenta. Legg deretter stackargumenta tilbake
        // høgre-til-venstre, slik at arg6 ligg på [rbp+16] i callee.
        copy(buf, [0x48, 0x81, 0xC4])
        u32(buf, nargs * 8)
        la stack_n: heiltall = nargs - 6
        la stack_pad: heiltall = 0
        hvis stack_n % 2 == 1 {
            copy(buf, [0x48, 0x83, 0xEC, 0x08])
            stack_pad = 8
        }
        la si: heiltall = nargs - 1
        mens si >= 6 {
            copy(buf, [0x49, 0x8B, 0x83]) // mov rax,[r11+disp32]
            u32(buf, (nargs - 1 - si) * 8)
            legg_til(buf, 0x50)
            si = si - 1
        }
        call_rel32(buf, fn_va, code_va)
        copy(buf, [0x48, 0x81, 0xC4])
        u32(buf, stack_n * 8 + stack_pad)
        legg_til(buf, 0x50)
        returner
    }
    // Pop args til register (reverst slik at arg0 er i rdi). r8/r9 treng
    // REX-prefiks og blir derfor emitterte særskilt.
    la arg_pops: liste<heltall> = [0x5F, 0x5E, 0x5A, 0x59]  // rdi,rsi,rdx,rcx
    // Pop i omvendt rekkjefølge: siste arg (øvst på stack) → siste register
    la i = nargs - 1
    mens i >= 0 og i < 6 {
        hvis i < 4 {
            legg_til(buf, arg_pops[i])
        } ellers hvis i == 4 {
            copy(buf, [0x41, 0x58]) // pop r8
        } ellers {
            copy(buf, [0x41, 0x59]) // pop r9
        }
        i = i - 1
    }
    call_rel32(buf, fn_va, code_va)
    legg_til(buf, 0x50)  // push result (NcVal*)
}
// ─── Strengliteralar (.data-seksjon) ─────────────────────────────────────────
funksjon char_to_byte(ch) {
    hvis ch == "\n" { returner 10 }
    ellers hvis ch == "\t" { returner 9 }
    ellers hvis ch == "\r" { returner 13 }
    ellers hvis ch == "\\" { returner 92 }
    ellers hvis ch == "\"" { returner 34 }
    ellers { returner builtin.char_code(ch) }
}

funksjon samle_strenger(fns) {
    la strenger: liste = []
    la sett: ordbok = {}
    // Emittergenererte literalar finst ikkje nødvendigvis i input-NCB-en.
    // Hald alle slike runtime-ABI-strengar i den faste dataseksjonen, elles
    // ville manglande oppslag peike på offset 0 ("ingenting").
    la standard: liste_tekst = [
        "ingenting", "heltall", "boolsk", "tekst", "liste", "ordbok", "",
        "norscode-process-spawn-v1", "executable", "args", "cwd", "stdin",
        "timeout_ms", "max_output_bytes", "environment", "inherit_env",
        "abi", "status", "ferdig", "timeout", "feil", "signal", "pid",
        "exit_code", "stdout", "stderr", "error", "output limit",
        "process spawn failed", "wall_ms", "peak_rss_bytes"
    ]
    la std_i: heiltall = 0
    mens std_i < lengde(standard) {
        sett[standard[std_i]] = sann
        legg_til(strenger, standard[std_i])
        std_i = std_i + 1
    }
    la nk = nøkler(fns)
    la fi: heltall = 0
    mens fi < lengde(nk) {
        hvis fi % 100 == 0 { native_codegen_trace("strengpass funksjon=" + tekst_fra_heltall(fi)) }
        la kode = fns[nk[fi]]["code"]
        la ci: heltall = 0
        mens ci < lengde(kode) {
            la instr = kode[ci]
            hvis instr[0] == "PUSH_CONST" og builtin.type(instr[1]) == "tekst" {
                la s: tekst = tekst(instr[1])
                hvis ikkje finnes_nøkkel(sett, s) {
                    sett[s] = sann
                    legg_til(strenger, s)
                }
            }
            ci = ci + 1
        }
        fi = fi + 1
    }
    returner strenger
}

funksjon bygg_data(strenger) {
    la bytes: liste = []
    la offs: ordbok = {}
    la i: heltall = 0
    // Sjølvkalibrering av escape-dekoding (sjå notat i løkka under): parse ein kjend
    // JSON-tekst `["a\nb"]` — kjem elementet ut som 3 teikn (a, LF, b) dekodar parseren
    // sjølv og vi må IKKJE dekode ein gong til; 4 teikn (a, \, n, b) → parseren er rå.
    la parser_dekodar = usann
    prøv {
        la kal = builtin.json_parse_raw("[\"a\\nb\"]")
        hvis lengde(kal) == 1 og lengde(tekst(kal[0])) == 3 { parser_dekodar = sann }
    } fang (e) { }
    mens i < lengde(strenger) {
        la s = strenger[i]
        mens lengde(bytes) % 16 != 0 { legg_til(bytes, 0) }
        offs[s] = lengde(bytes)
        la sbytes: liste = []
        la j: heltall = 0
        // json_parse_raw(fil_les(...)) unescapar JSON-escapes i NCB-strengar i NOKRE
        // runtimes (stage-0-seed) men IKKJE i andre (host-runtime-inkonsistens). Dekodar
        // vi escape-sekvensar her når parseren ALT har dekoda, dobbeltdekodar vi:
        // "a\\b" (rå a,\,b) → `\b` → backspace → korrupt konstant (RAW=[a]). Dekodar vi
        // IKKJE når parseren er rå, lagrast `\"` som 2 byte → òg korrupt. Difor:
        // SJØLVKALIBRER éin gong — parse ein kjend JSON-tekst og sjå om `\n` kom ut som
        // ekte LF (parser dekodar) eller som `\`+`n` (rå). \uXXXX finst ikkje i NCB-ar.
        mens j < lengde(s) {
            hvis s[j] == "\\" og ikkje parser_dekodar og j + 1 < lengde(s) {
                la e = s[j + 1]
                hvis e == "n" { legg_til(sbytes, 10) }
                ellers hvis e == "t" { legg_til(sbytes, 9) }
                ellers hvis e == "r" { legg_til(sbytes, 13) }
                ellers hvis e == "b" { legg_til(sbytes, 8) }
                ellers hvis e == "f" { legg_til(sbytes, 12) }
                ellers hvis e == "\"" { legg_til(sbytes, 34) }
                ellers hvis e == "\\" { legg_til(sbytes, 92) }
                ellers hvis e == "/" { legg_til(sbytes, 47) }
                ellers { legg_til(sbytes, char_to_byte(e)) }
                j = j + 2
            } ellers {
                legg_til(sbytes, char_to_byte(s[j]))
                j = j + 1
            }
        }
        // Immutable NcVal direkte i read-only datasegmentet:
        // {type=2, payload=&[len,bytes...]}. PUSH_CONST kan dermed gjenbruke
        // same literal utan ei heapallokering per løkkeiterasjon.
        u64(bytes, 2)
        u64(bytes, DATA_VA() + lengde(bytes) + 8)
        u64(bytes, lengde(sbytes))
        copy(bytes, sbytes)
        i = i + 1
    }
    returner [bytes, offs]
}

// ─── Runtime hex-dekoding ─────────────────────────────────────────────────────
funksjon hex_nibble(ch: tekst) -> heltall {
    la code = builtin.char_code(ch)
    hvis code >= 48 og code <= 57 { returner code - 48 }
    hvis code >= 97 og code <= 102 { returner code - 87 }
    returner 0
}
funksjon hex_to_bytes(hex: tekst) -> liste {
    la out = []
    la i: heltall = 0
    la n = lengde(hex)
    mens i + 1 < n {
        la hi = hex_nibble(builtin.slice(hex, i, i + 1))
        la lo = hex_nibble(builtin.slice(hex, i + 1, i + 2))
        legg_til(out, hi * 16 + lo)
        i = i + 2
    }
    returner out
}
funksjon rt_hex_del0() { returner "" }
funksjon rt_hex_del1() { returner "" }
funksjon rt_hex_del2() { returner "" }
funksjon rt_hex_del3() { returner "" }
funksjon rt_hex_del4() { returner "" }
funksjon rt_hex_del5() { returner "" }
funksjon rt_hex_del6() { returner "" }

// Den eldre JSON-runtimen peika på einskildbyte-liberalar inne i den gamle
// tekstlayouten og lét samtidig RSI vera uinitialisert. Etter at dei faste
// runtime-inngangane vart trampolinar, peika desse kallstadene på instruksjonar
// i staden for '[', ']', '{', '}', ',' og ':'. Materialiser byteverdien på
// maskinstacken og kall RT_STR_RAW med eksplisitt lengd 1. Erstatninga er
// nøyaktig 22 byte, så alle ABI-adresser etter kallstaden blir uendra.
funksjon patch_legacy_json_literal(bytes, peikar_låg: heiltall, literal: heiltall, venta: heiltall) {
    la funne: heiltall = 0
    la i: heiltall = 0
    mens i + 21 < lengde(bytes) {
        la treff = usann
        hvis bytes[i] == 0x48 og bytes[i + 1] == 0xBF og bytes[i + 2] == peikar_låg {
            hvis bytes[i + 3] == 0x10 og bytes[i + 4] == 0x40 og bytes[i + 5] == 0 og bytes[i + 6] == 0 og bytes[i + 7] == 0 og bytes[i + 8] == 0 og bytes[i + 9] == 0 {
                hvis bytes[i + 10] == 0x48 og bytes[i + 11] == 0xB8 og bytes[i + 12] == 0x90 og bytes[i + 13] == 0x10 og bytes[i + 14] == 0x40 og bytes[i + 15] == 0 og bytes[i + 16] == 0 og bytes[i + 17] == 0 og bytes[i + 18] == 0 og bytes[i + 19] == 0 og bytes[i + 20] == 0xFF og bytes[i + 21] == 0xD0 {
                    treff = sann
                }
            }
        }
        hvis treff {
            la ny: liste = [0x6A, literal, 0x48, 0x89, 0xE7, 0xBE, 0x01, 0, 0, 0]
            call_rel32(ny, RT_STR_RAW(), TEXT_VA() + i)
            legg_til(ny, 0x59)
            mens lengde(ny) < 22 { legg_til(ny, 0x90) }
            la j: heiltall = 0
            mens j < 22 {
                bytes[i + j] = ny[j]
                j = j + 1
            }
            funne = funne + 1
            i = i + 22
        } ellers {
            i = i + 1
        }
    }
    hvis funne != venta {
        kast "native codegen: venta " + tekst_fra_heltall(venta) + " legacy JSON-literal(er), fann " + tekst_fra_heltall(funne)
    }
}

// Ikkje-muterande sjekk: finst det minst éin legacy JSON-literal-sekvens for
// gitt peikar_låg? Gate-hjelpar for bygg_runtime_v2 slik at program utan
// JSON-runtime (t.d. minimale modul-globals-program) ikkje feilar fail-closed
// på "fann 0". Same match-logikk som patch_legacy_json_literal.
funksjon har_legacy_json_literal(bytes, peikar_låg: heiltall) -> boolsk {
    la i: heiltall = 0
    mens i + 21 < lengde(bytes) {
        hvis bytes[i] == 0x48 og bytes[i + 1] == 0xBF og bytes[i + 2] == peikar_låg {
            hvis bytes[i + 3] == 0x10 og bytes[i + 4] == 0x40 og bytes[i + 5] == 0 og bytes[i + 6] == 0 og bytes[i + 7] == 0 og bytes[i + 8] == 0 og bytes[i + 9] == 0 {
                hvis bytes[i + 10] == 0x48 og bytes[i + 11] == 0xB8 og bytes[i + 12] == 0x90 og bytes[i + 13] == 0x10 og bytes[i + 14] == 0x40 og bytes[i + 15] == 0 og bytes[i + 16] == 0 og bytes[i + 17] == 0 og bytes[i + 18] == 0 og bytes[i + 19] == 0 og bytes[i + 20] == 0xFF og bytes[i + 21] == 0xD0 {
                    returner sann
                }
            }
        }
        i = i + 1
    }
    returner usann
}
// Linux x86-64 freestanding process-ABI. Denne rutinen er posisjonsuavhengig
// bortsett frå dei versjonerte runtime-ABI-adressene for map_get/map_keys og
// den dokumenterte envp-slotten. Han brukar berre Linux-systemkall og returnerer
// eit rått resultatområde som Norscode-emitteren pakkar til eit ABI-kart.
funksjon rt_hex_process_spawn_linux_x86_64() { returner "" }

// Rå byte-søk for NcVal-tekstar. Resultatet blir lagt i rdi som indeks eller
// -1. Dermed kan både index_of og contains bruke ei gyldig Norscode-emittert
// funksjonsinngang i staden for historiske hopp-tabelladresser.
funksjon emit_text_index_of_raw(bytes) {
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08, 0x48, 0x8B, 0x56, 0x08,
        0x4C, 0x8B, 0x00, 0x4C, 0x8B, 0x1A, 0x4D, 0x39, 0xD8,
        0x72, 0x1E, 0x4D, 0x29, 0xD8, 0x45, 0x31, 0xD2,
        0x4A, 0x8D, 0x7C, 0x10, 0x08, 0x48, 0x8D, 0x72, 0x08,
        0x4C, 0x89, 0xD9, 0xF3, 0xA6, 0x74, 0x11,
        0x49, 0xFF, 0xC2, 0x4D, 0x39, 0xC2, 0x76, 0xE8,
        0x48, 0xC7, 0xC7, 0xFF, 0xFF, 0xFF, 0xFF, 0xEB, 0x03,
        0x4C, 0x89, 0xD7
    ])
}

// (iii) hex-patch: erstattar den frosne runtime-en sin faste 16B-bump-prolog
//   mov rax,[0x600000]; lea rcx,[rax+16]; mov [0x600000],rcx   (20 byte)
// med ein POSISJONS-UAVHENGIG absolutt-kall til gc_alloc16 (fri-liste-støtta):
//   mov rax, ga16_va; call rax; nop*8                          (20 byte)
// Same lengde → alle andre VA-ar er urørte. Skannar BERRE den frosne regionen
// [0, frozen_len) — mine eigne primitiv (gc_box_int/gc_alloc) har same prolog-
// mønster og må IKKJE patchast (elles uendeleg rekursjon).
funksjon patch_bump_prologer(bytes, ga16_va, frozen_len) -> liste {
    // Begge 20-byte 16B-bump-prolog-variantane: rcx-variant (lea rcx,[rax+16]) og
    // rdx-variant (lea rdx,[rax+16]). gc_alloc16 klobrar berre rax → trygg for begge.
    la pat_rcx = [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x60, 0x00, 0x48, 0x8D, 0x48, 0x10, 0x48, 0x89, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00]
    la pat_rdx = [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x60, 0x00, 0x48, 0x8D, 0x50, 0x10, 0x48, 0x89, 0x14, 0x25, 0x00, 0x00, 0x60, 0x00]
    la repl = []
    copy(repl, [0x48, 0xB8])
    u64(repl, ga16_va)
    copy(repl, [0xFF, 0xD0])
    copy(repl, [0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
    la ut = []
    la n: heltall = lengde(bytes)
    la plen: heltall = 20
    la i: heltall = 0
    la treff: heltall = 0
    mens i < n {
        la m: heltall = 0
        hvis i + plen <= frozen_len {
            m = 1
            la mrdx: heltall = 1
            la j: heltall = 0
            mens j < plen {
                hvis bytes[i + j] != pat_rcx[j] { m = 0 }
                hvis bytes[i + j] != pat_rdx[j] { mrdx = 0 }
                j = j + 1
            }
            hvis mrdx == 1 { m = 1 }
        }
        hvis m == 1 {
            copy(ut, repl)
            i = i + plen
            treff = treff + 1
        } ellers {
            legg_til(ut, bytes[i])
            i = i + 1
        }
    }
    skriv("native_codegen_v2: (iii) hex-patcha " + tekst_fra_heltall(treff) + " bump-prologar → gc_alloc16\n")
    returner ut
}

// (3b) hex-patch: STRENG-payload-allokatoren (variabel storleik). Frosen mønster (24B):
//   mov rax,[bump]; lea rsi,[rax+rsi*2]; add rsi,11; mov [bump],rsi
// → new_bump = rax + 2·len + 11, dvs size = 2·len + 11 (len i rsi). Erstatt med (24B):
//   lea rcx,[rsi*2+11]; mov rax,gc_alloc_var_va; call rax; nop*4
// gc_alloc_var(size i rcx) allokerer via fri-lista (head-fit+split) elles bump. Bevarar
// rsi/rdi (fill-kode). Skannar berre frosen region. (Liste-payload-advance er skjult i
// fill-koden etter bug-fiks @linje-27 → treng djupare analyse; streng er rein her.)
funksjon patch_var_allocators(bytes, gav_va, frozen_len) -> liste {
    // Streng-payload-allokator, BEGGE base-variantar (rax @6071, rcx @6381). Same size
    // (2·len+11, len i rsi) → same erstatning (lea rcx,[rsi*2+11]; call gc_alloc_var).
    la pat_rax = [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x60, 0x00, 0x48, 0x8D, 0x34, 0x70, 0x48, 0x83, 0xC6, 0x0B, 0x48, 0x89, 0x34, 0x25, 0x00, 0x00, 0x60, 0x00]
    la pat_rcx = [0x48, 0x8B, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00, 0x48, 0x8D, 0x34, 0x71, 0x48, 0x83, 0xC6, 0x0B, 0x48, 0x89, 0x34, 0x25, 0x00, 0x00, 0x60, 0x00]
    la repl = []
    copy(repl, [0x48, 0x8D, 0x0C, 0x75, 0x0B, 0x00, 0x00, 0x00]) // lea rcx,[rsi*2+11]
    copy(repl, [0x48, 0xB8])
    u64(repl, gav_va)
    copy(repl, [0xFF, 0xD0])                        // call rax
    copy(repl, [0x90, 0x90, 0x90, 0x90])
    // pat_rcx-variant: etterfølgjande kode brukar RCX som buffer, men gc_alloc_var gjev rax
    // (og BEVARER rcx = storleiken) → må leggje til mov rcx,rax. Elles skriv koden til
    // [storleik+8] → segfault (t.d. json_string_case under GC). Same lengd (24B).
    // json_string_case brukar OGSÅ rax = kjelde-payload ([rdi+8], lest før). gc_alloc_var
    // klobrar rax → gjenopprett rax=[rdi+8] (rdi bevart). 32-bit `mov eax,gav` (gav<2^32)
    // for å få plass til mov rcx,rax + mov rax,[rdi+8] i den faste 24-byte-luka.
    la repl_rcx = []
    copy(repl_rcx, [0x48, 0x8D, 0x0C, 0x75, 0x0B, 0x00, 0x00, 0x00]) // lea rcx,[rsi*2+11] (8)
    copy(repl_rcx, [0xB8])
    u32(repl_rcx, gav_va)                           // mov eax, gav32 (5)
    copy(repl_rcx, [0xFF, 0xD0])                    // call rax (2)
    copy(repl_rcx, [0x48, 0x89, 0xC1])              // mov rcx,rax (buffer) (3)
    copy(repl_rcx, [0x48, 0x8B, 0x47, 0x08])        // mov rax,[rdi+8] (gjenopprett kjelde) (4)
    copy(repl_rcx, [0x90, 0x90])                    // nop nop (2) → 24
    la ut = []
    la n: heltall = lengde(bytes)
    la plen: heltall = 24
    la i: heltall = 0
    la treff: heltall = 0
    mens i < n {
        la m: heltall = 0
        la mr: heltall = 0
        hvis i + plen <= frozen_len {
            m = 1
            mr = 1
            la j: heltall = 0
            mens j < plen {
                hvis bytes[i + j] != pat_rax[j] { m = 0 }
                hvis bytes[i + j] != pat_rcx[j] { mr = 0 }
                j = j + 1
            }
        }
        hvis m == 1 {
            copy(ut, repl)
            i = i + plen
            treff = treff + 1
        } ellers hvis mr == 1 {
            copy(ut, repl_rcx)
            i = i + plen
            treff = treff + 1
        } ellers {
            legg_til(ut, bytes[i])
            i = i + 1
        }
    }
    skriv("native_codegen_v2: (3b) hex-patcha " + tekst_fra_heltall(treff) + " streng-payload-allokatorar → gc_alloc_var\n")
    returner ut
}

// (3b) hex-patch: RT_LIST_NEW sin faste 88-byte payload-alloc. Frosen mønster (24B):
//   mov rcx,[bump]; lea rax,[rcx+0x18]; lea rdx,[rcx+0x58]; mov [bump],rdx
// → 88B payload (cap 8). Erstatt med (24B): mov ecx,88; mov rax,gav; call rax; mov rcx,rax;
//   lea rax,[rcx+0x18]. gc_alloc_var(88) via fri-lista → rcx=blokk, rax=blokk+0x18 (som før).
funksjon patch_list_new(bytes, gav_va, frozen_len) -> liste {
    la pat = [0x48, 0x8B, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00, 0x48, 0x8D, 0x41, 0x18, 0x48, 0x8D, 0x51, 0x58, 0x48, 0x89, 0x14, 0x25, 0x00, 0x00, 0x60, 0x00]
    la repl = []
    copy(repl, [0xB9, 0x58, 0x00, 0x00, 0x00])     // mov ecx,88
    copy(repl, [0x48, 0xB8])
    u64(repl, gav_va)
    copy(repl, [0xFF, 0xD0])                        // call rax
    copy(repl, [0x48, 0x89, 0xC1])                 // mov rcx,rax (blokk)
    copy(repl, [0x48, 0x8D, 0x41, 0x18])           // lea rax,[rcx+0x18]
    la ut = []
    la n: heltall = lengde(bytes)
    la plen: heltall = 24
    la i: heltall = 0
    la treff: heltall = 0
    mens i < n {
        la m: heltall = 0
        hvis i + plen <= frozen_len {
            m = 1
            la j: heltall = 0
            mens j < plen {
                hvis bytes[i + j] != pat[j] { m = 0 }
                j = j + 1
            }
        }
        hvis m == 1 {
            copy(ut, repl)
            i = i + plen
            treff = treff + 1
        } ellers {
            legg_til(ut, bytes[i])
            i = i + 1
        }
    }
    skriv("native_codegen_v2: (3b) hex-patcha " + tekst_fra_heltall(treff) + " RT_LIST_NEW-payload → gc_alloc_var\n")
    returner ut
}

// (3b) hex-patch: RT_LIST_APP grow-path (variabel — byte-lister som veks forbi cap 8).
// Etter `shl r9,4` (r9=cap*16=ny size). Frosen mønster (19B):
//   mov r8,[bump]; add r9,r8; mov [bump],r9
// Erstatt med (19B): mov r10,gav_r8; call r10; nop*6. gc_alloc_var_r8(size i r9) → r8=blokk
// (bevarer rax=gamal payload-struct som grow oppdaterer etterpå). Kalla via r10 (scratch).
funksjon patch_list_grow(bytes, gav_r8_va, frozen_len) -> liste {
    la pat = [0x4C, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x60, 0x00, 0x4D, 0x01, 0xC1, 0x4C, 0x89, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00]
    la repl = []
    copy(repl, [0x49, 0xBA])
    u64(repl, gav_r8_va)
    copy(repl, [0x41, 0xFF, 0xD2])                  // call r10
    copy(repl, [0x90, 0x90, 0x90, 0x90, 0x90, 0x90])
    la ut = []
    la n: heltall = lengde(bytes)
    la plen: heltall = 19
    la i: heltall = 0
    la treff: heltall = 0
    mens i < n {
        la m: heltall = 0
        hvis i + plen <= frozen_len {
            m = 1
            la j: heltall = 0
            mens j < plen {
                hvis bytes[i + j] != pat[j] { m = 0 }
                j = j + 1
            }
        }
        hvis m == 1 {
            copy(ut, repl)
            i = i + plen
            treff = treff + 1
        } ellers {
            legg_til(ut, bytes[i])
            i = i + 1
        }
    }
    skriv("native_codegen_v2: (3b) hex-patcha " + tekst_fra_heltall(treff) + " RT_LIST_APP-grow → gc_alloc_var_r8\n")
    returner ut
}

funksjon bygg_runtime_v2(argv_store_va: heiltall) -> liste {
    la gc_mode = miljo_hent("NORSCODE_GC_ALLOC")   // (iii) "1" = fri-liste-boksing (flagg-gata)
    la hex = rt_hex_del0() + rt_hex_del1() + rt_hex_del2() + rt_hex_del3() + rt_hex_del4() + rt_hex_del5() + rt_hex_del6()
    la nop_pad = ""
    la i: heltall = 0
    mens i < 98 {
        nop_pad = nop_pad + "90"
        i = i + 1
    }
    hex = builtin.replace(hex, "48b80010400000000000ffe0", "31c0c3900f1f840000000000")
    // Tre legacy-epilogar brukte 0x401000 som om det var RT_NIL-kode. Adressa
    // er eigentleg starten på type-tabellen. Returner null-peikar direkte,
    // utan å endre dei legitime tabelloppslaga mot same adresse.
    hex = builtin.replace(hex, "48b800104000000000005b5dffe0", "31c090909090909090905b5dc390")
    hex = builtin.replace(hex, "48b800104000000000004883c4085b415c415d415e415f5dffe0", "31c090909090909090904883c4085b415c415d415e415f5dc390")
    hex = builtin.replace(hex, "48b800104000000000005b415e415fffe0", "31c090909090909090905b415e415fc390")
    hex = builtin.replace(hex, "488b042500006000488d481048890c250000600048c7000300000048897808c39090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090909090", "488b042500006000488d481048890c250000600048c7000300000048897808c3" + nop_pad)
    hex = builtin.replace(hex, "e527400000000000e5274000000000003328400000000000e527400000000000e527400000000000e527400000000000", "488b042500006000488d481048890c250000600048c7000500000048897808c390909090909090909090909090909090")
    // Fiks: miljo_hent las envp frå feil adresse (0x045FFFF8); korriger til HEAP_VA+8 = 0x600008
    hex = builtin.replace(hex, "488b1c25f8ff5f04", "488b1c2508006000")
    hex = builtin.replace(hex, "48b840104000000000005b415e415fffe0", "5b415e415fc39090909090909090909090")
    hex = builtin.replace(hex, "e010400000000000", "9010400000000000")
    // Fiks: json_streng las feilaktig frå absolutt adresse 0x8; les lengda frå parser-state i rdi i staden.
    hex = builtin.replace(hex, "488b042508000000488b10", "488b571090909090909090")
    // JSON-strengparseren reserverte heile inputlengda + 64 KiB for kvar
    // einaste streng. Bruk objektstart direkte og skriv payload på +8; dette
    // gjer minnebruken proporsjonal med faktisk dekoda strenglengd.
    hex = builtin.replace(hex, "488d0c104881c108000100", "4889c19090909090909090")
    hex = builtin.replace(hex, "4801d0480510000100", "4883c0089090909090")
    // INDEX_GET på tekst utanfor grensene returnerer tom tekst. Legacy-
    // epilogen sette peikaren, men ikkje lengda i rsi, og RT_STR_RAW kopierte
    // dermed ei vilkårleg enorm mengd. RIP-relativ peikar frigjer plass til 0.
    hex = builtin.replace(
        hex,
        "48bf271040000000000048b89010400000000000ffe0",
        "488d3d61efffff31f648b89010400000000000ffe090"
    )
    // miljo_hent sin ikkje-funnen-epilog sette berre ein peikar til tomtekst,
    // men lét rsi innehalde siste samanlikningslengd. RT_STR_RAW kopierte då
    // vilkårlege runtimebytes. Nullstill både peikar og lengd i same bytebudsjett.
    hex = builtin.replace(
        hex,
        "48bf27104000000000004c89e85b415c415d415e415fffe0",
        "31ff31f69090909090904c89e85b415c415d415e415fffe0"
    )
    // Legacy JSON-/JOIN-rutinar kalla den gamle concat-adressa 0x401110, som
    // no ligg i runtime-tabellen. Peik alle fem registervariantane til den
    // aktive, bytebevarande concat-rutinen på 0x403947. Tom liste må dessutan
    // sende lengd 0 til RT_STR_RAW; elles blir siste separatorlengd brukt.
    hex = builtin.replace(hex, "48b91011400000000000", "48b94739400000000000")
    hex = builtin.replace(hex, "49bc1011400000000000", "49bc4739400000000000")
    hex = builtin.replace(hex, "49bd1011400000000000", "49bd4739400000000000")
    hex = builtin.replace(hex, "49be1011400000000000", "49be4739400000000000")
    hex = builtin.replace(
        hex,
        "48bf271040000000000048b890104000000000005b415c415d415e415fffe0",
        "488d3de4f3ffff31f648b890104000000000005b415c415d415e415fffe090"
    )
    // Den aktive legacy JSON-listegreina brukar no 0x401033 som tom
    // strengpeikar, men lét framleis RSI arve førre separatorlengd. For ei
    // tom liste skal RT_STR_RAW få både nullpeikar og eksakt lengd 0.
    hex = builtin.replace(
        hex,
        "48bf331040000000000048b89010400000000000ffd0",
        "31ff31f690909090909048b89010400000000000ffd0"
    )
    // Fiks: fil_skriv-rutinane hoppa til 0x401000 etter close; returner rått 0 i staden.
    hex = builtin.replace(hex, "48b80010400000000000ffd04881c408100000c3", "4831c09090909090909090904881c408100000c3")
    // rt_init_heap: den innebygde mmap-en er overflødig (ELF-programhovudet
    // mapper alt heap-segmentet RW) OG den gamle bump-init-en sette
    // bump=0x600008, som er NØYAKTIG same slot der _start lagrar envp
    // (HEAP_VA+ENVP_OFFSET). Første heap-allokering skreiv då over envp, og
    // miljo_hent las etterpå ein skitten peikar → SIGSEGV i sjølv-boota ELF.
    // Denne replace byter ut heile mmap+bump-sekvensen med berre
    // «mov [0x600000], HEAP_ALLOC_START(=0x702060); ret», som lét kanon-cachen
    // (0x600040..0x702060) og envp-sloten (0x600008) stå urørt.
    // MERK: mønsteret må matche dei faktiske emitterte bytane. Heap-mmap-lengda
    // vart tidlegare bumpa 64 MiB→1 GiB (be00000004→be00000040) i rt_hex_del5
    // utan at dette mønsteret vart oppdatert, så replace slutta stilt å fyre og
    // den kolliderande bump=0x600008 kom tilbake. Hald esi-immediaten synkron.
    hex = builtin.replace(
        hex,
        "b809000000bf00006000be00000040ba0300000041ba2200000049c7c0ffffffff4531c90f0548c704250000600008006000c3",
        "48c704250000600060207000c39090909090909090909090909090909090909090909090909090909090909090909090909090"
    )
    hex = hex + "4c8b47084c8b4e08498b08498b114989ca4901d248b800006000000000004c8b184d8913498d7b08498d70084885c9740f8a06880748ffc648ffc748ffc975f1498d71084889d14885c9740f8a06880748ffc648ffc748ffc975f1c607004b8d4c130948b800006000000000004889084889c8488d481048be000060000000000048890e48c700020000004c895808c3"
    hex = hex + ""
    la bytes = hex_to_bytes(hex)
    // Gate: berre program som faktisk emitterer JSON-runtime har desse
    // sekvensane. Minimale program (t.d. modul-globals utan JSON-op) har null og
    // skal ikkje feile fail-closed. Er nokon til stades, krev vi framleis dei
    // eksakte antalla per literal (delvis/korrupt mønster feilar då lukka).
    // Per-peikar-gate. Nokre replace-kall ovanfor (t.d. 0x33-tom-liste-greina på
    // "48bf331040..ffd0") forbrukar enkelte JSON-literal-sekvensar, så eit
    // alt-eller-ingenting-gate (TRUE når EIN peikar finst) ville køyre patch på ein
    // FORBRUKT peikar og feile fail-closed "fann 0". Gate difor kvar patch på om
    // nett den sekvensen framleis finst; ein NÆRVERANDE peikar med feil tal feilar
    // framleis lukka via venta-talet i patch_legacy_json_literal.
    hvis har_legacy_json_literal(bytes, 0x33) { patch_legacy_json_literal(bytes, 0x33, 0x5B, 1) }
    hvis har_legacy_json_literal(bytes, 0x35) { patch_legacy_json_literal(bytes, 0x35, 0x5D, 1) }
    hvis har_legacy_json_literal(bytes, 0x37) { patch_legacy_json_literal(bytes, 0x37, 0x7B, 1) }
    hvis har_legacy_json_literal(bytes, 0x39) { patch_legacy_json_literal(bytes, 0x39, 0x7D, 1) }
    hvis har_legacy_json_literal(bytes, 0x64) { patch_legacy_json_literal(bytes, 0x64, 0x2C, 2) }
    hvis har_legacy_json_literal(bytes, 0x66) { patch_legacy_json_literal(bytes, 0x66, 0x3A, 1) }
    // Tre eldre map-/listesamanføyingar brukte 0x401430, ein utdatert
    // tre-argumentsrutine. Dei har NcVal-tekst i RDI/RSI og skal bruke den
    // same aktive concat-ABI-en som vanleg ADD på tekst.
    patch_u64_verdi(bytes, 4199472, RT_CONCAT(), 3)
    la frozen_len: heltall = lengde(bytes)         // (iii) grense (etter JSON-patch)
    la atomics: ordbok = {}
    atomics["process_spawn_argv"] = TEXT_VA() + lengde(bytes)
    copy(bytes, hex_to_bytes(rt_hex_process_spawn_linux_x86_64()))

    // Heiltal og boolverdiar er immutable. VM-i-VM-kompilering lagar millionar
    // av dei same indeks-, lengde- og samanlikningsverdiane; la dei peike på
    // eit kanonisk område i staden for å tømme den monotone prototypeheapen.
    // Legacy-inngangane blir bevarte som ABI-stabile trampolinar, slik at alle
    // eksisterande runtime- og emitterkall får same eigde implementasjon.
    la cached_int_va = emit_cached_int_runtime(bytes)
    la cached_bool_va = emit_cached_bool_runtime(bytes)
    la cached_str_raw_va = emit_cached_str_raw_runtime(bytes)
    la linear_join_va = emit_linear_join_runtime(bytes)
    // GC-gata: main sin cache-optimalisering (kanoniske int/bool/char + lineær join)
    // flyttar allokeringa ut av den frosne, patchbare regionen. Cache-FALLBACK-ane
    // (int utanfor [-32768,32767], fleir-byte str_raw, join) bump-allokerer RÅTT via
    // `movabs rcx,&bump` — eit mønster patch_bump_prologer/patch_var_allocators IKKJE
    // fangar, OG dei ligg forbi frozen_len. Under GC lek dei difor (aldri fri-liste-
    // gjenbruk) → bump klatrar inn i GC-scratch (0x10300000+) → korrupsjon. sha256 sine
    // 32-bit-ord treff int-fallbacken pervasivt. Difor: berre installer trampolinane i
    // paritet-løypa (flagg AV). Under GC held RT_INT/RT_BOOL/RT_STR_RAW dei opphavlege
    // inline-allokatorane (bump-prologar @32/@64 …) som patch_bump_prologer rutar til
    // gc_alloc16 (fri-liste) — nett den grøne før-flettings-ruta (11 prologar, ikkje 9).
    hvis gc_mode != "1" {
        patch_abs_jump(bytes, RT_INT() - TEXT_VA(), RT_BOOL() - TEXT_VA(), cached_int_va)
        patch_abs_jump(bytes, RT_BOOL() - TEXT_VA(), RT_STR_RAW() - TEXT_VA(), cached_bool_va)
        patch_abs_jump(bytes, RT_STR_RAW() - TEXT_VA(), RT_STR_RAW() - TEXT_VA() + 12, cached_str_raw_va)
        patch_abs_jump(bytes, RT_JOIN() - TEXT_VA(), RT_MAP_NEW() - TEXT_VA(), linear_join_va)
    }

    atomics["load"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08, 0x48, 0x8B, 0x3F])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["store"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08, 0x48, 0x8B, 0x76, 0x08, 0x48, 0x89, 0x37, 0x0F, 0xAE, 0xF0, 0x48, 0x89, 0xF7])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["exchange"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08, 0x48, 0x8B, 0x76, 0x08, 0x48, 0x89, 0xF0, 0x48, 0x87, 0x07, 0x48, 0x89, 0xC7])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["compare_exchange"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08, 0x48, 0x8B, 0x76, 0x08, 0x48, 0x8B, 0x52, 0x08, 0x48, 0x89, 0xF0, 0xF0, 0x48, 0x0F, 0xB1, 0x17, 0x48, 0x89, 0xC7])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["fetch_add"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08, 0x48, 0x8B, 0x76, 0x08, 0x48, 0x89, 0xF0, 0xF0, 0x48, 0x0F, 0xC1, 0x07, 0x48, 0x89, 0xC7])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["fence"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x0F, 0xAE, 0xF0, 0x31, 0xFF])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    // Kompakt bytebevarande tekst-slice. Den historiske RT_SLICE-peikaren
    // landa midt i JSON-escape-rutinen og gav SIGSEGV i trailerlesaren.
    atomics["slice"] = TEXT_VA() + lengde(bytes)
    // FIKS: slice dispatcha ALLTID til streng-slice → slice(liste) gav STRENG (feil type) →
    // legg_til på han krasja. Rut liste (type 3) til RT_LIST_SLICE (same args rdi/rsi/rdx).
    copy(bytes, [0x48, 0x83, 0x3F, 0x03])   // cmp qword[rdi],3 (liste?)
    copy(bytes, [0x0F, 0x85])               // jne string_slice
    u32(bytes, 0)
    la slice_pstr = lengde(bytes) - 4
    copy(bytes, [0x48, 0xB8])               // mov rax, RT_LIST_SLICE
    u64(bytes, RT_LIST_SLICE())
    copy(bytes, [0xFF, 0xE0])               // jmp rax (tail-call)
    patch_jump(bytes, slice_pstr, lengde(bytes)) // string_slice:
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,             // rax = stringobj
        0x48, 0x8B, 0x08,                   // rcx = lengd
        0x4C, 0x8B, 0x46, 0x08,             // r8 = start
        0x4C, 0x8B, 0x4A, 0x08,             // r9 = slutt
        0x45, 0x31, 0xD2,                   // r10 = 0
        0x4D, 0x85, 0xC0,                   // test start
        0x4D, 0x0F, 0x48, 0xC2,             // cmovs r8,r10
        0x4C, 0x39, 0xC9,                   // cmp rcx,r9
        0x4C, 0x0F, 0x42, 0xC9,             // cmovb r9,rcx
        0x4D, 0x39, 0xC1,                   // cmp r9,r8
        0x4D, 0x0F, 0x42, 0xC8,             // cmovb r9,r8
        0x4A, 0x8D, 0x7C, 0x00, 0x08,       // rdi = bytes + start
        0x4C, 0x89, 0xCE,                   // rsi = slutt
        0x4C, 0x29, 0xC6                    // rsi -= start
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    legg_til(bytes, 0xC3)

    // NcVal-tekst til fyrste råbyte. Legacy RT_CHAR_CODE peika midt i
    // heiltall_fra_tekst og var ikkje ei gyldig funksjonsinngang.
    atomics["char_code"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,             // rax = stringobj
        0x31, 0xFF,                         // edi = 0
        0x48, 0x83, 0x38, 0x00,             // cmp qword [rax],0
        0x74, 0x04,                         // tom tekst -> 0
        0x0F, 0xB6, 0x78, 0x08              // edi = fyrste byte
    ])
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    // chr(int): legacy-peikaren RT_CHR landar ikkje lenger på ein stabil
    // funksjonsstart i den utvida runtimeblobben. Bygg éin rå byte direkte og
    // send han gjennom den versjonerte strengkonstruktøren.
    atomics["chr"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,       // mov rax,[rdi+8]
        0x48, 0x83, 0xEC, 0x08,       // sub rsp,8
        0x88, 0x04, 0x24,             // mov [rsp],al
        0x48, 0x89, 0xE7,             // mov rdi,rsp
        0xBE, 0x01, 0x00, 0x00, 0x00  // mov esi,1
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])

    atomics["trim"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,             // rax = stringobj
        0x48, 0x8B, 0x08,                   // rcx = lengd
        0x48, 0x8D, 0x50, 0x08,             // rdx = bytes
        0x45, 0x31, 0xC0,                   // r8 = start = 0
        0x49, 0x39, 0xC8,                   // start: cmp r8,rcx
        0x73, 0x0C,
        0x42, 0x80, 0x3C, 0x02, 0x20,       // byte[start] <= ASCII space
        0x77, 0x05,
        0x49, 0xFF, 0xC0,
        0xEB, 0xEF,
        0x49, 0x89, 0xC9,                   // r9 = end = len
        0x4D, 0x39, 0xC1,                   // end: cmp r9,r8
        0x76, 0x11,
        0x46, 0x0F, 0xB6, 0x54, 0x0A, 0xFF,
        0x41, 0x80, 0xFA, 0x20,
        0x77, 0x05,
        0x49, 0xFF, 0xC9,
        0xEB, 0xEA,
        0x4A, 0x8D, 0x3C, 0x02,             // rdi = bytes + start
        0x4C, 0x89, 0xCE,
        0x4C, 0x29, 0xC6                    // rsi = end - start
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["lower"] = TEXT_VA() + lengde(bytes)
    emit_ascii_case_runtime(bytes, false)
    atomics["upper"] = TEXT_VA() + lengde(bytes)
    emit_ascii_case_runtime(bytes, true)

    // tekst(x): streng (type 2) → som han er; heiltal (type 1) → RT_INT_TO_STR (desimal);
    // elles tom streng. FIKS: gamal kode handterte BERRE type 2 → tekst(heiltall) gav tom
    // streng (t.d. litmus «sum[0]=», tekst(i)). No har heiltal-greina.
    atomics["to_text"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x85, 0xFF])                // test rdi,rdi
    copy(bytes, [0x0F, 0x84])                      // jz make_empty
    u32(bytes, 0)
    la tt_pempty1 = lengde(bytes) - 4
    copy(bytes, [0x48, 0x8B, 0x07])                // mov rax,[rdi] (type)
    copy(bytes, [0x48, 0x83, 0xF8, 0x02])          // cmp rax,2
    copy(bytes, [0x0F, 0x85])                      // jne check_int
    u32(bytes, 0)
    la tt_pnotstr = lengde(bytes) - 4
    copy(bytes, [0x48, 0x89, 0xF8])                // mov rax,rdi (streng som han er)
    copy(bytes, [0xC3])                            // ret
    la tt_checkint = lengde(bytes)                 // check_int:
    patch_jump(bytes, tt_pnotstr, tt_checkint)
    copy(bytes, [0x48, 0x83, 0xF8, 0x01])          // cmp rax,1
    copy(bytes, [0x0F, 0x85])                      // jne make_empty
    u32(bytes, 0)
    la tt_pempty2 = lengde(bytes) - 4
    call_rel32(bytes, RT_INT_TO_STR(), TEXT_VA())  // heiltal → desimalstreng (rdi=NcVal, rax=streng)
    copy(bytes, [0xC3])                            // ret
    la tt_empty = lengde(bytes)                    // make_empty:
    patch_jump(bytes, tt_pempty1, tt_empty)
    patch_jump(bytes, tt_pempty2, tt_empty)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    copy(bytes, [0xC6, 0x04, 0x24, 0x00])          // mov byte[rsp],0
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0x31, 0xF6])                       // xor esi,esi
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])

    // ── Unnatak: throw_unwind(rdi=unntak-NcVal) — unwind til næraste handler ──────
    // Handler-stakk i utvida mmap-region: teljar @0x106F0000 (0-init av loader), last_exc
    // @0x106F0008, frames @0x10600000 (32B: [catch_va][saved_rsp][saved_rbp][pad]).
    // TRY_BEGIN pushar, TRY_END poppar. Kast → finn TOPP-handler (catch-all), sett last_exc,
    // restore rsp/rbp, hopp til catch. Handler vert IKKJE poppa her — catch sin TRY_END gjer
    // det (som VM-en, vm.no:6451). Ingen handler → jmp RT_THROW (skriv melding + avslutt).
    atomics["throw_unwind"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x6F, 0x10]) // mov rax,[0x106F0000] (count)
    copy(bytes, [0x48, 0x85, 0xC0])                // test rax,rax
    copy(bytes, [0x74, 0x1F])                      // jz .no_handler (+31)
    copy(bytes, [0x48, 0xFF, 0xC8])                // dec rax (index = count-1)
    copy(bytes, [0x48, 0xC1, 0xE0, 0x05])          // shl rax,5 (*32)
    copy(bytes, [0x48, 0x05, 0x00, 0x00, 0x60, 0x10]) // add rax,0x10600000 (frame)
    copy(bytes, [0x48, 0x89, 0x3C, 0x25, 0x08, 0x00, 0x6F, 0x10]) // mov [0x106F0008],rdi (last_exc)
    copy(bytes, [0x48, 0x8B, 0x68, 0x10])          // mov rbp,[rax+16] (restore rbp)
    copy(bytes, [0x48, 0x8B, 0x60, 0x08])          // mov rsp,[rax+8] (restore rsp)
    copy(bytes, [0xFF, 0x20])                      // jmp [rax] (catch_va)
    copy(bytes, [0x48, 0xB8])                      // .no_handler: mov rax, RT_THROW
    u64(bytes, RT_THROW())
    copy(bytes, [0xFF, 0xE0])                      // jmp rax (skriv + avslutt)

    atomics["starts_with"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,
        0x48, 0x8B, 0x56, 0x08,
        0x48, 0x8B, 0x0A,
        0x48, 0x39, 0x08,
        0x72, 0x14,
        0x48, 0x8D, 0x72, 0x08,
        0x48, 0x8D, 0x78, 0x08,
        0xF3, 0xA6,
        0x40, 0x0F, 0x94, 0xC7,
        0x48, 0x0F, 0xB6, 0xFF,             // nullstill øvre bitar i rdi
        0xEB, 0x02,
        0x31, 0xFF
    ])
    call_rel32(bytes, RT_BOOL(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["ends_with"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,
        0x48, 0x8B, 0x56, 0x08,
        0x48, 0x8B, 0x0A,
        0x4C, 0x8B, 0x00,
        0x49, 0x39, 0xC8,
        0x72, 0x18,
        0x49, 0x29, 0xC8,
        0x4A, 0x8D, 0x7C, 0x00, 0x08,
        0x48, 0x8D, 0x72, 0x08,
        0xF3, 0xA6,
        0x40, 0x0F, 0x94, 0xC7,
        0x48, 0x0F, 0xB6, 0xFF,             // nullstill øvre bitar i rdi
        0xEB, 0x02,
        0x31, 0xFF
    ])
    call_rel32(bytes, RT_BOOL(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["index_of"] = TEXT_VA() + lengde(bytes)
    emit_text_index_of_raw(bytes)
    call_rel32(bytes, RT_INT(), TEXT_VA())
    legg_til(bytes, 0xC3)

    atomics["contains"] = TEXT_VA() + lengde(bytes)
    emit_text_index_of_raw(bytes)
    copy(bytes, [
        0x48, 0x85, 0xFF,
        0x40, 0x0F, 0x99, 0xC7,
        0x48, 0x0F, 0xB6, 0xFF
    ])
    call_rel32(bytes, RT_BOOL(), TEXT_VA())
    legg_til(bytes, 0xC3)

    // Reimplementerte JSON-list/map-greiner (dei frosne C-rutinane hadde lengd-bug →
    // krasj på lister/map). Rekursive call json_stringify (definert SEINARE) → forward-ref
    // samla her og patcha etter json_stringify er emittert.
    la json_recur_patches: liste = []
    // Interne JSON-greiner deler prolog/epilog med legacy-dispatchen.
    atomics["json_string_case"] = TEXT_VA() + lengde(bytes)
    // REIMPLEMENTERT: den frosne rutinen @0x4028d2 escapa IKKJE bakstrek ("a\b" → "a",
    // einsleg "\" → ugyldig JSON `"\"`) → Gen1-ELF-skrivne NCB-ar korrupte → ELF stage-0-
    // fixpunktet divergerte. Kroppen (treng gc_alloc_var, emittert seinare) ligg etter
    // gc_alloc_var; framover-jmp herifrå blir patcha der.
    la json_str_body_patch = emit_jmp_placeholder(bytes)

    // json_list_case(rdi=liste) → rax = "[e0,e1,...]". rbx=elem_ptr r12=len r13=i r14=acc.
    atomics["json_list_case"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x55, 0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57]) // push rbp,rbx,r12,r13,r14,r15
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8 (align)
    copy(bytes, [0x48, 0x8B, 0x47, 0x08])          // mov rax,[rdi+8] (payload)
    copy(bytes, [0x4C, 0x8B, 0x20])                // mov r12,[rax] (len)
    copy(bytes, [0x48, 0x8B, 0x58, 0x10])          // mov rbx,[rax+16] (elem_ptr)
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x5B])          // mov byte[rsp],'['
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    copy(bytes, [0x4D, 0x31, 0xED])                // xor r13,r13 (i=0)
    la jlc_loop = lengde(bytes)
    copy(bytes, [0x4D, 0x39, 0xE5])                // cmp r13,r12
    copy(bytes, [0x0F, 0x83]) u32(bytes, 0)        // jae done
    la jlc_pdone = lengde(bytes) - 4
    copy(bytes, [0x4D, 0x85, 0xED])                // test r13,r13
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // jz nocomma
    la jlc_pnocomma = lengde(bytes) - 4
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x2C])          // mov byte[rsp],','
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    patch_jump(bytes, jlc_pnocomma, lengde(bytes)) // nocomma:
    copy(bytes, [0x4A, 0x8B, 0x3C, 0xEB])          // mov rdi,[rbx+r13*8] (element)
    copy(bytes, [0xE8]) u32(bytes, 0)              // call json_stringify (recur-patch)
    legg_til(json_recur_patches, lengde(bytes) - 4)
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    copy(bytes, [0x49, 0xFF, 0xC5])                // inc r13
    copy(bytes, [0xE9]) u32(bytes, (jlc_loop - (lengde(bytes) + 4)) & 4294967295) // jmp loop
    patch_jump(bytes, jlc_pdone, lengde(bytes))    // done:
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x5D])          // mov byte[rsp],']'
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())      // rax = resultat
    copy(bytes, [0x48, 0x83, 0xC4, 0x08])          // add rsp,8
    copy(bytes, [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B, 0x5D]) // pop r15,r14,r13,r12,rbx,rbp
    copy(bytes, [0xC3])                            // ret

    // json_map_case(rdi=map) → rax = "{k0:v0,...}". rbx=keys_ptr r15=vals_ptr r12=count r13=i r14=acc.
    atomics["json_map_case"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x55, 0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57]) // push rbp,rbx,r12,r13,r14,r15
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    copy(bytes, [0x48, 0x8B, 0x47, 0x08])          // mov rax,[rdi+8] (payload)
    copy(bytes, [0x4C, 0x8B, 0x20])                // mov r12,[rax] (count)
    copy(bytes, [0x48, 0x8B, 0x58, 0x10])          // mov rbx,[rax+16] (keys_ptr)
    copy(bytes, [0x4C, 0x8B, 0x78, 0x18])          // mov r15,[rax+24] (vals_ptr)
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x7B])          // mov byte[rsp],'{'
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    copy(bytes, [0x4D, 0x31, 0xED])                // xor r13,r13
    la jmc_loop = lengde(bytes)
    copy(bytes, [0x4D, 0x39, 0xE5])                // cmp r13,r12
    copy(bytes, [0x0F, 0x83]) u32(bytes, 0)        // jae done
    la jmc_pdone = lengde(bytes) - 4
    copy(bytes, [0x4D, 0x85, 0xED])                // test r13,r13
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // jz nocomma
    la jmc_pnocomma = lengde(bytes) - 4
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x2C])          // mov byte[rsp],','
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    patch_jump(bytes, jmc_pnocomma, lengde(bytes)) // nocomma:
    // key: json_stringify([keys_ptr+i*8]) → concat
    copy(bytes, [0x4A, 0x8B, 0x3C, 0xEB])          // mov rdi,[rbx+r13*8] (key)
    copy(bytes, [0xE8]) u32(bytes, 0)              // call json_stringify
    legg_til(json_recur_patches, lengde(bytes) - 4)
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    // ":"
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x3A])          // mov byte[rsp],':'
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    // val: json_stringify([vals_ptr+i*8]) → concat
    copy(bytes, [0x4B, 0x8B, 0x3C, 0xEF])          // mov rdi,[r15+r13*8] (val)
    copy(bytes, [0xE8]) u32(bytes, 0)              // call json_stringify
    legg_til(json_recur_patches, lengde(bytes) - 4)
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax
    copy(bytes, [0x49, 0xFF, 0xC5])                // inc r13
    copy(bytes, [0xE9]) u32(bytes, (jmc_loop - (lengde(bytes) + 4)) & 4294967295) // jmp loop
    patch_jump(bytes, jmc_pdone, lengde(bytes))    // done:
    copy(bytes, [0x48, 0x83, 0xEC, 0x10])          // sub rsp,16
    copy(bytes, [0xC6, 0x04, 0x24, 0x7D])          // mov byte[rsp],'}'
    copy(bytes, [0x48, 0x89, 0xE7])                // mov rdi,rsp
    copy(bytes, [0xBE, 0x01, 0x00, 0x00, 0x00])    // mov esi,1
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x10])          // add rsp,16
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    call_rel32(bytes, RT_CONCAT(), TEXT_VA())      // rax = resultat
    copy(bytes, [0x48, 0x83, 0xC4, 0x08])          // add rsp,8
    copy(bytes, [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B, 0x5D]) // pop r15,r14,r13,r12,rbx,rbp
    copy(bytes, [0xC3])                            // ret

    atomics["json_bool_case"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x83, 0x7F, 0x08, 0x00]) // cmp qword [rdi+8],0
    la json_bool_false = emit_je_placeholder(bytes)
    copy(bytes, [
        0x48, 0x83, 0xEC, 0x08,
        0x48, 0xB8, 0x74, 0x72, 0x75, 0x65, 0x00, 0x00, 0x00, 0x00,
        0x48, 0x89, 0x04, 0x24,
        0x48, 0x89, 0xE7,
        0xBE, 0x04, 0x00, 0x00, 0x00
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])
    la json_bool_false_target = lengde(bytes)
    copy(bytes, [
        0x48, 0x83, 0xEC, 0x08,
        0x48, 0xB8, 0x66, 0x61, 0x6C, 0x73, 0x65, 0x00, 0x00, 0x00,
        0x48, 0x89, 0x04, 0x24,
        0x48, 0x89, 0xE7,
        0xBE, 0x05, 0x00, 0x00, 0x00
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])
    patch_jump(bytes, json_bool_false, json_bool_false_target)

    // Den historiske JSON-dispatchen på 0x402660 hoppa via data som ikkje var
    // funksjonsadresser. Vel gyldig typeinngang direkte frå NcVal.type.
    atomics["json_stringify"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        // null er ein gyldig JSON-verdi og må testast før NcVal.type blir lesen.
        0x48, 0x85, 0xFF, 0x74, 0x1E,
        0x48, 0x83, 0x3F, 0x01, 0x74, 0x35,
        0x48, 0x83, 0x3F, 0x02, 0x74, 0x35,
        0x48, 0x83, 0x3F, 0x03, 0x74, 0x35,
        0x48, 0x83, 0x3F, 0x04, 0x74, 0x35,
        0x48, 0x83, 0x3F, 0x05, 0x74, 0x35,
        0x48, 0x83, 0xEC, 0x08,
        0xC7, 0x04, 0x24, 0x6E, 0x75, 0x6C, 0x6C,
        0x48, 0x89, 0xE7,
        0xBE, 0x04, 0x00, 0x00, 0x00
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])
    call_rel32(bytes, RT_INT_TO_STR(), TEXT_VA())
    legg_til(bytes, 0xC3)
    call_rel32(bytes, atomics["json_string_case"], TEXT_VA())
    legg_til(bytes, 0xC3)
    call_rel32(bytes, atomics["json_list_case"], TEXT_VA())
    legg_til(bytes, 0xC3)
    call_rel32(bytes, atomics["json_map_case"], TEXT_VA())
    legg_til(bytes, 0xC3)
    call_rel32(bytes, atomics["json_bool_case"], TEXT_VA())
    legg_til(bytes, 0xC3)

    // Patch forward-ref: json_list_case/json_map_case sine `call json_stringify` (rel32 @0)
    // → no som json_stringify-VA er kjend. rel = js_va - (TEXT_VA + pos + 4).
    la js_va: heltall = atomics["json_stringify"]
    la jrp: heltall = 0
    mens jrp < lengde(json_recur_patches)
        la jpos: heltall = json_recur_patches[jrp]
        la jrel: heltall = (js_va - (TEXT_VA() + jpos + 4)) & 4294967295
        bytes[jpos] = jrel & 255
        bytes[jpos + 1] = (jrel >> 8) & 255
        bytes[jpos + 2] = (jrel >> 16) & 255
        bytes[jpos + 3] = (jrel >> 24) & 255
        jrp = jrp + 1
    slutt
    // Legacy liste-/map-greinene gjenbrukast framleis for sjølve serialiseringa,
    // men dei fire rekursive kallstadene må gå tilbake til den validerte
    // dispatchen over. Den gamle 0x402660-tabellen inneheld ikkje lenger
    // funksjonsadresser og skal aldri vera nåbar frå levande JSON.
    patch_u64_verdi(bytes, 4204128, atomics["json_stringify"], 4)

    // Bygg argv-lista frå det rå {argv**, argc}-paret som _start lagrar i ein
    // eigen skrivebar verts-ABI-side. Det eksplisitte talet gjer at runtimeen
    // ikkje er avhengig av å finne NULL-markøren etter siste argument.
    atomics["argv_list"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x53, 0x41, 0x54, 0x41, 0x55])            // save rbx/r12/r13
    call_rel32(bytes, RT_LIST_NEW(), TEXT_VA())
    copy(bytes, [0x49, 0x89, 0xC4])                        // r12 = resultatliste
    copy(bytes, [0x4C, 0x8B, 0x2C, 0x25])                  // r13 = [argv-slot]
    u32(bytes, argv_store_va)
    copy(bytes, [0x31, 0xDB])                              // ebx = argc/count
    la argv_loop = lengde(bytes)
    copy(bytes, [0x48, 0x3B, 0x1C, 0x25])                  // count == [argc-slot]
    u32(bytes, argv_store_va + 8)
    la argv_done = emit_je_placeholder(bytes)
    copy(bytes, [0x49, 0x8B, 0x7D, 0x00])                  // rdi=*argv
    copy(bytes, [0x31, 0xF6])                              // esi=0
    la argv_measure = lengde(bytes)
    copy(bytes, [0x80, 0x3C, 0x37, 0x00])                  // byte[rdi+rsi] == 0
    la argv_measured = emit_je_placeholder(bytes)
    copy(bytes, [0x48, 0xFF, 0xC6, 0xE9])                  // inc rsi; jmp measure
    la argv_measure_jump = lengde(bytes)
    u32(bytes, 0)
    la argv_string = lengde(bytes)
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    copy(bytes, [0x4C, 0x89, 0xE7, 0x48, 0x89, 0xC6])      // rdi=list; rsi=string
    call_rel32(bytes, RT_LIST_APP(), TEXT_VA())
    copy(bytes, [0x48, 0xFF, 0xC3])                        // count++
    copy(bytes, [0x49, 0x83, 0xC5, 0x08, 0xE9])            // argv++; jmp loop
    la argv_loop_jump = lengde(bytes)
    u32(bytes, 0)
    la argv_slutt = lengde(bytes)
    copy(bytes, [0x4C, 0x89, 0xE0])                        // rax=resultatliste
    copy(bytes, [0x41, 0x5D, 0x41, 0x5C, 0x5B, 0xC3])
    patch_jump(bytes, argv_done, argv_slutt)
    patch_jump(bytes, argv_measured, argv_string)
    patch_jump(bytes, argv_measure_jump, argv_measure)
    patch_jump(bytes, argv_loop_jump, argv_loop)

    // miljo_hent i den opphavlege runtime-bloba sende vidare ei vilkårleg
    // lengd i rsi. Resultatet kunne difor innehalde resten av envp-blokka.
    // Denne Norscode-emitterte hjelparen måler den NUL-avslutta verdien før
    // han byggjer NcVal-strengen.
    la miljo_verdi_va = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x31, 0xF6,                         // xor esi, esi
        0x80, 0x3C, 0x37, 0x00,             // cmp byte [rdi+rsi], 0
        0x74, 0x05,                         // je ferdig
        0x48, 0xFF, 0xC6,                   // inc rsi
        0xEB, 0xF5                          // jmp måleløkke
    ])
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())
    legg_til(bytes, 0xC3)

    // Erstatt berre verdikonverteringa inne i legacy miljo_hent:
    // add rdi,rcx; inc rdi; call hjelpefunksjon; nop*4.
    la miljo_call_start = 0x1451
    bytes[miljo_call_start] = 0x48
    bytes[miljo_call_start + 1] = 0x01
    bytes[miljo_call_start + 2] = 0xCF
    bytes[miljo_call_start + 3] = 0x48
    bytes[miljo_call_start + 4] = 0xFF
    bytes[miljo_call_start + 5] = 0xC7
    bytes[miljo_call_start + 6] = 0xE8
    patch_jump(bytes, miljo_call_start + 7, miljo_verdi_va - TEXT_VA())
    la miljo_nop = miljo_call_start + 11
    mens miljo_nop < miljo_call_start + 15 {
        bytes[miljo_nop] = 0x90
        miljo_nop = miljo_nop + 1
    }

    // ── GC F1: råminne-inspeksjonsprimitiv (appenda; ingen rt_hex-endring) ──
    // Fundamentet for den sjølvhosta GC-en: lèt Norscode lese/skrive heapen og
    // lese bump-peikaren. Boksar via RT_INT (alloc for store adresser — greit for
    // inspeksjon/test; kjerne-GC-løkka blir allokeringsfri seinare).
    // raw_load64(addr) -> boksa int [addr]. rdi = NcVal int (adresse).
    atomics["raw_load64"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x83, 0xEC, 0x08,                   // sub rsp, 8   (align)
        0x48, 0x8B, 0x7F, 0x08,                   // mov rdi, [rdi+8]  (unbox addr)
        0x48, 0x8B, 0x3F                          // mov rdi, [rdi]    (load [addr])
    ])
    call_rel32(bytes, RT_INT(), TEXT_VA())        // box rdi → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp, 8; ret

    // raw_store64(addr, val) -> val. rdi=addr NcVal, rsi=val NcVal. Ingen alloc.
    atomics["raw_store64"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,                   // mov rax, [rdi+8]  (unbox addr)
        0x48, 0x8B, 0x56, 0x08,                   // mov rdx, [rsi+8]  (unbox val)
        0x48, 0x89, 0x10,                         // mov [rax], rdx    (store)
        0x48, 0x89, 0xF0,                         // mov rax, rsi      (return val)
        0xC3                                      // ret
    ])

    // heap_bump() -> boksa bump-peikar ([HEAP_VA]).
    atomics["heap_bump"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x83, 0xEC, 0x08,                   // sub rsp, 8
        0x48, 0x8B, 0x3C, 0x25                    // mov rdi, [moffs32]
    ])
    u32(bytes, HEAP_VA())                          // [HEAP_VA] = bump-slot
    call_rel32(bytes, RT_INT(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp, 8; ret

    // GC F2: obj_addr(x) -> boksa adresse til x sin NcVal-boks. rdi = NcVal*;
    // boksar sjølve peikaren (ikkje innhaldet) → lèt oss probe eksakt objekt-
    // layout (type-tag @ addr, payload-peikar @ addr+8, element-peikarar osv.).
    atomics["obj_addr"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])         // sub rsp, 8 (rdi = arg, uendra)
    call_rel32(bytes, RT_INT(), TEXT_VA())        // box rdi (adressa) → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp, 8; ret

    // GC F3: konservativ rot-skann-grenser (native stakk = komplett rotsett).
    // stack_base() -> boksa initiell rsp ([HEAP_VA+48]; høg adresse, øvre grense).
    atomics["stack_base"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8 (align)
    copy(bytes, [0x48, 0x8B, 0x3C, 0x25])          // mov rdi,[moffs32]
    u32(bytes, HEAP_VA() + 48)
    call_rel32(bytes, RT_INT(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // stack_ptr() -> boksa rsp til KALLAREN (nedre grense for rot-skann).
    atomics["stack_ptr"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8D, 0x7C, 0x24, 0x08])    // lea rdi,[rsp+8] (kallarens rsp)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8 (align)
    call_rel32(bytes, RT_INT(), TEXT_VA())
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC reclaim-motor (porta frå b2-F4): fri-liste-allokator ──
    // heap_set_bump(addr) -> addr. Set bump-peikaren (berre trygt ETTER mark).
    atomics["heap_set_bump"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x48, 0x8B, 0x47, 0x08,                   // mov rax, [rdi+8]  (unbox addr)
        0x48, 0x89, 0x04, 0x25                     // mov [moffs32], rax
    ])
    u32(bytes, HEAP_VA())                          // [0x600000] = bump-slot
    copy(bytes, [0x48, 0x89, 0xF8, 0xC3])          // mov rax, rdi; ret

    // gc_alloc(size) -> boksa adresse. Fri-liste-hovud @ HEAP_VA+40. v1 head-fit:
    // gjenbruk hovudblokka om >= size, elles bump. Header-laust (live-map sweep).
    atomics["gc_alloc"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x47, 0x08])          // mov rax,[rdi+8]  (size)
    copy(bytes, [0x4C, 0x8B, 0x04, 0x25])          // mov r8,[moffs32] (head)
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x4D, 0x85, 0xC0])                // test r8,r8
    la ga_empty = emit_je_placeholder(bytes)       // jz L_bump
    copy(bytes, [0x4D, 0x8B, 0x48, 0x08])          // mov r9,[r8+8]  (blokk-size)
    copy(bytes, [0x49, 0x39, 0xC1])                // cmp r9,rax
    copy(bytes, [0x0F, 0x83])                       // jae L_reuse
    u32(bytes, 0)
    la ga_reuse = lengde(bytes) - 4
    la ga_Lbump = lengde(bytes)                    // L_bump:
    patch_jump(bytes, ga_empty, ga_Lbump)
    copy(bytes, [0x48, 0x8B, 0x0C, 0x25])          // mov rcx,[moffs32] (bump)
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0x89, 0xCF])                // mov rdi,rcx
    copy(bytes, [0x48, 0x01, 0xC1])                // add rcx,rax
    copy(bytes, [0x48, 0x89, 0x0C, 0x25])          // mov [moffs32],rcx
    u32(bytes, HEAP_VA())
    la ga_box = emit_jmp_placeholder(bytes)        // jmp L_box
    la ga_Lreuse = lengde(bytes)                   // L_reuse:
    patch_jump(bytes, ga_reuse, ga_Lreuse)
    copy(bytes, [0x4D, 0x8B, 0x10])                // mov r10,[r8]  (next)
    copy(bytes, [0x4C, 0x89, 0x14, 0x25])          // mov [moffs32],r10 (head=next)
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x4C, 0x89, 0xC7])                // mov rdi,r8
    la ga_Lbox = lengde(bytes)                     // L_box:
    patch_jump(bytes, ga_box, ga_Lbox)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8 (align)
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box rdi → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

