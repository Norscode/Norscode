    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC (iv): KONSERVATIV ROT-SKANN + DFS-mark (gc_mark_roots) ────────────────
    // gc_mark_roots() -> boksa mark-teljar. Nullstill bitmap; scan [rsp+8, stack_base)
    // etter heap-peikarar (lokalvariablar er rbp-relative PÅ stakken → dekt); push kvar
    // til mark-stakk; DFS-drain (som gc_mark_native) → live-map + teljar @0x600038.
    // Klobrar berre caller-saved (rax,rcx,rdx,rsi,rdi,r8-r11) — trygt ved safepoint
    // (verdiar ligg på stakken, ikkje i register). r11=mstack, r10=live-map, r9=count.
