    copy(bytes, [0x48, 0x83, 0xFE, 0x10])          // cmp rsi,16
    copy(bytes, [0x0F, 0x82])                      // jb tail_skip
    u32(bytes, 0)
    la swf_ptail = lengde(bytes) - 4
    copy(bytes, [0x48, 0x8B, 0x04, 0x25, 0x28, 0x00, 0x60, 0x00]) // mov rax,[head]
    copy(bytes, [0x49, 0x89, 0x01])                // mov [r9],rax
    copy(bytes, [0x49, 0x89, 0x71, 0x08])          // mov [r9+8],rsi
    copy(bytes, [0x4C, 0x89, 0x0C, 0x25, 0x28, 0x00, 0x60, 0x00]) // mov [head],r9
    copy(bytes, [0x49, 0xFF, 0xC3])                // inc r11
