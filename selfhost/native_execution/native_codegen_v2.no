    copy(bytes, [0x48, 0x83, 0xC0, 0x0B])          // add rax,11 (2*len+11 = alloc-storleik)
    copy(bytes, [0x49, 0x89, 0x42, 0x08])          // mov [r10+8],rax (payload size)
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    copy(bytes, [0xE9])                            // jmp loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    la mrt_checklist = lengde(bytes)               // check_list:
    patch_jump(bytes, mrt_pcl, mrt_checklist)
    copy(bytes, [0x48, 0x83, 0xF8, 0x03])          // cmp rax,3
    copy(bytes, [0x0F, 0x85])                      // jne loop (ikkje liste)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x77, 0x08])          // mov rsi,[rdi+8] (payload)
    // KONSERVATIV robustheit: falske roter (stakk-heiltal som aliasar heap) kan ha
    // type==3 med søppel-payload/len. Valider payload i [0x600000, bump) + cap len før
    // vi følgjer «lista» — elles wild deref / mark-stakk-overflow → krasj.
    copy(bytes, [0x48, 0x81, 0xFE, 0x40, 0x00, 0x60, 0x00]) // cmp rsi,0x600040 (over kontrollblokk)
    copy(bytes, [0x0F, 0x82])                      // jb loop (payload under heap)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x3B, 0x34, 0x25, 0x00, 0x00, 0x60, 0x00]) // cmp rsi,[0x600000] (bump)
    copy(bytes, [0x0F, 0x83])                      // jae loop (payload >= bump)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x06])                // mov rax,[rsi] (len)
    copy(bytes, [0x48, 0x3D, 0x00, 0x00, 0x01, 0x00]) // cmp rax,0x10000 (65536)
    copy(bytes, [0x0F, 0x87])                      // ja loop (len for stor → falsk liste)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    // FIKS (collect-korrektheit): ekte liste-layout = payload[len,cap,elem_ptr]; element-
    // arrayen er via elem_ptr=[payload+16] (RT_LIST_GET: elem=[[payload+16]+i*8]). Gamal kode
    // las element INLINE @payload+16 (=elem_ptr sjølv som «element0») → følgde feil adresser
    // OG verna ALDRI den separate (grodde) element-arrayen → sweep frigjorde levande element-
    // array → reallokering overskreiv → korrupsjon (rsi=1 @sha256). No: (a) ver payload-struct
    // +inline, (b) deref+valider elem_ptr, (c) ver element-array separat, (d) push [elem_ptr+i*8].
    // (a) live-map: RT_LIST_NEW-payload er ALLTID 88B fast blokk (gc_alloc_var(88), cap 8,
    //     inline-element @payload+24). Rekn IKKJE 24+len*8 — under-rekna for len<8 → prev_end
    //     hamna INNI den levande blokka → sweep skreiv fri-liste-lenkjer der → korrupsjon.
    copy(bytes, [0x49, 0x89, 0x32])                // mov [r10],rsi (payload addr)
    copy(bytes, [0x49, 0xC7, 0x42, 0x08, 0x58, 0x00, 0x00, 0x00]) // mov q[r10+8],88 (fast RT_LIST_NEW-blokk)
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    // (b) elem_ptr = [payload+16]; valider i [0x600040, bump) — falsk liste → hopp element-følging
    copy(bytes, [0x48, 0x8B, 0x4E, 0x10])          // mov rcx,[rsi+16] (elem_ptr)
    copy(bytes, [0x48, 0x81, 0xF9, 0x40, 0x00, 0x60, 0x00]) // cmp rcx,0x600040 (over kontrollblokk)
    copy(bytes, [0x0F, 0x82])                      // jb loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x3B, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00]) // cmp rcx,[0x600000] (bump)
    copy(bytes, [0x0F, 0x83])                      // jae loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    // (c) BERRE grodde lister (elem_ptr utanfor 88B-blokka): ver element-array cap*16
    //     (RT_LIST_APP grow: `shl r9,4` = cap*16). Inline (elem_ptr-payload<88) er alt dekt
    //     av payload=88-entryen; separat cap*16-entry der ville over-strekt inn i neste objekt.
    copy(bytes, [0x48, 0x89, 0xCA])                // mov rdx,rcx (elem_ptr)
    copy(bytes, [0x48, 0x29, 0xF2])                // sub rdx,rsi (elem_ptr - payload)
    copy(bytes, [0x48, 0x83, 0xFA, 0x58])          // cmp rdx,88
    copy(bytes, [0x0F, 0x82])                      // jb push_elems (inline → dekt)
    u32(bytes, 0)
    la mrt_pinline = lengde(bytes) - 4
    copy(bytes, [0x49, 0x89, 0x0A])                // mov [r10],rcx (elem_ptr)
    copy(bytes, [0x48, 0x8B, 0x56, 0x08])          // mov rdx,[rsi+8] (cap)
    copy(bytes, [0x48, 0xC1, 0xE2, 0x03])          // shl rdx,3 (cap*8 = ny_cap*8 = faktisk array-storleik; grow `shl r9,4`=old_cap*16=new_cap*8)
    copy(bytes, [0x49, 0x89, 0x52, 0x08])          // mov [r10+8],rdx (elem-array size)
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    la mrt_pushelems = lengde(bytes)               // push_elems:
    patch_jump(bytes, mrt_pinline, mrt_pushelems)
    // (d) push element-NcVals frå [elem_ptr + i*8]  (rdx = cursor)
    copy(bytes, [0x48, 0x89, 0xCA])                // mov rdx,rcx (cursor = elem_ptr)
    la mrt_elem = lengde(bytes)                    // .elem_loop:
    copy(bytes, [0x48, 0x85, 0xC0])                // test rax,rax
    copy(bytes, [0x0F, 0x84])                      // jz loop (len==0)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    // BOUND: mark-stakk full (r11 >= live-map base) → stopp push (elles overflow-write
    // inn i live-map → korrupte entryar → sweep frigjer levande). Same vakt som rot-scan.
    copy(bytes, [0x49, 0x81, 0xFB, 0x00, 0x00, 0x34, 0x10]) // cmp r11,0x10340000
    copy(bytes, [0x0F, 0x83])                      // jae loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x3A])                // mov rdi,[rdx] (element)
    copy(bytes, [0x49, 0x89, 0x3B])                // mov [r11],rdi (push)
    copy(bytes, [0x49, 0x83, 0xC3, 0x08])          // add r11,8
    copy(bytes, [0x48, 0x83, 0xC2, 0x08])          // add rdx,8
    copy(bytes, [0x48, 0xFF, 0xC8])                // dec rax
    copy(bytes, [0xE9])                            // jmp elem_loop
    u32(bytes, (mrt_elem - (lengde(bytes) + 4)) & 4294967295)
    la mrt_done = lengde(bytes)                    // done:
    patch_jump(bytes, mrt_pdone, mrt_done)
    copy(bytes, [0x4C, 0x89, 0xD0])                // mov rax,r10 (lm end)
    copy(bytes, [0x48, 0x2D, 0x00, 0x00, 0x34, 0x10]) // sub rax,0x10340000
    copy(bytes, [0x48, 0xC1, 0xE8, 0x04])          // shr rax,4 (entries)
    copy(bytes, [0x48, 0x89, 0x04, 0x25, 0x38, 0x00, 0x60, 0x00]) // mov [0x600038],rax
    copy(bytes, [0x4C, 0x89, 0xCF])                // mov rdi,r9 (count)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC (iv): SAMLA collect (gc_collect_native) = mark-roots → sort → sweep-full ──
    // gc_collect_native() -> boksa 0. Kallar gc_mark_roots (nullstill+scan+DFS+teljar
    // @0x600038), les n, sorterer live-map, full-range sweep. n-boksinga går via RT_INT
    // (som med flagg PÅ sjølv er patcha → gc_alloc16). Klobrar berre caller-saved.
    atomics["gc_collect_native"] = TEXT_VA() + lengde(bytes)
    // Nullstill fri-liste-hovudet FØRST: sweepen byggjer fri-lista på nytt frå ALL
    // noverande garbage, så blokkar som alt låg fritt (men ikkje er reallokerte) ikkje
    // vert frigjort to gonger (double-free → syklus i fri-lista → korrupsjon over mange
    // collects). Reset + full re-sweep gjev kvar garbage-blokk PÅ fri-lista nøyaktig éin gong.
    copy(bytes, [0x48, 0xC7, 0x04, 0x25, 0x28, 0x00, 0x60, 0x00, 0x00, 0x00, 0x00, 0x00]) // mov q[0x600028],0
    call_rel32(bytes, atomics["gc_mark_roots"], TEXT_VA()) // mark (side-effekt)
    copy(bytes, [0x48, 0x8B, 0x3C, 0x25, 0x38, 0x00, 0x60, 0x00]) // mov rdi,[0x600038] (n)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box n → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08])          // add rsp,8
    copy(bytes, [0x48, 0x89, 0xC7])                // mov rdi,rax (boksa n)
    call_rel32(bytes, atomics["gc_sort_livemap"], TEXT_VA())
    copy(bytes, [0x48, 0x8B, 0x3C, 0x25, 0x38, 0x00, 0x60, 0x00]) // mov rdi,[0x600038] (n)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box n → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08])          // add rsp,8
    copy(bytes, [0x48, 0x89, 0xC7])                // mov rdi,rax
    call_rel32(bytes, atomics["gc_sweep_full"], TEXT_VA())
    copy(bytes, [0xC3])                            // ret

    // ── mkdir_p: rekursiv katalog-oppretting (Linux x86_64 sys_mkdir=83) ──
    // Appenda HEILT til slutt (før safepoint) så ingen eksisterande atomic-/
    // json-adresse skiftar. rdi = sti-NcVal (streng). Kopierer stien til ein
    // NUL-avslutta stakk-buffer, mkdir-ar kvar "/"-prefiks, så full sti. Ignorer
    // EEXIST. Returnerer boksa int (syscall-resultat; kallar bryr seg ikkje).
    atomics["mkdir_p"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [
        0x55,                                     // push rbp
        0x48, 0x89, 0xE5,                         // mov rbp, rsp
        0x48, 0x81, 0xEC, 0x00, 0x10, 0x00, 0x00, // sub rsp, 0x1000
        0x48, 0x8B, 0x47, 0x08,                   // mov rax, [rdi+8]  (payload)
        0x48, 0x8B, 0x08,                         // mov rcx, [rax]    (len)
        0x48, 0x8D, 0x70, 0x08,                   // lea rsi, [rax+8]  (chars)
        0x48, 0x89, 0xE7,                         // mov rdi, rsp      (dest)
        0x49, 0x89, 0xE0,                         // mov r8, rsp       (buf-start)
        0x48, 0x85, 0xC9                          // test rcx, rcx
    ])
    la mk_skipcopy = emit_je_placeholder(bytes)   // jz done_copy
    la mk_copyloop = lengde(bytes)
    copy(bytes, [
        0x8A, 0x16,                               // mov dl, [rsi]
        0x88, 0x17,                               // mov [rdi], dl
        0x48, 0xFF, 0xC6,                         // inc rsi
        0x48, 0xFF, 0xC7,                         // inc rdi
        0x48, 0xFF, 0xC9                          // dec rcx
    ])
    la mk_jnz = lengde(bytes)
    legg_til(bytes, 0x75)                          // jnz copy_loop (rel8)
    legg_til(bytes, (mk_copyloop - (mk_jnz + 2)) & 255)
    la mk_donecopy = lengde(bytes)
    patch_jump(bytes, mk_skipcopy, mk_donecopy)
    copy(bytes, [
        0xC6, 0x07, 0x00,                         // mov byte [rdi], 0  (NUL-term)
        0x4D, 0x89, 0xC1                          // mov r9, r8         (scan-ptr)
    ])
    la mk_scan = lengde(bytes)
    copy(bytes, [
        0x41, 0x8A, 0x01,                         // mov al, [r9]
        0x84, 0xC0                                // test al, al
    ])
    la mk_tofinal = emit_je_placeholder(bytes)    // jz final
    copy(bytes, [0x3C, 0x2F])                     // cmp al, '/'
    la mk_tonext1 = emit_jne_placeholder(bytes)   // jne next
    copy(bytes, [0x4D, 0x39, 0xC1])               // cmp r9, r8
    la mk_tonext2 = emit_je_placeholder(bytes)    // je next (leiande '/')
    copy(bytes, [
        0x41, 0xC6, 0x01, 0x00,                   // mov byte [r9], 0  (temp NUL)
        0xB8, 0x53, 0x00, 0x00, 0x00,             // mov eax, 83
        0x4C, 0x89, 0xC7,                         // mov rdi, r8
        0xBE, 0xFF, 0x01, 0x00, 0x00,             // mov esi, 0x1FF (0777)
        0x0F, 0x05,                               // syscall
        0x41, 0xC6, 0x01, 0x2F                    // mov byte [r9], '/' (restore)
    ])
    la mk_next = lengde(bytes)
    patch_jump(bytes, mk_tonext1, mk_next)
    patch_jump(bytes, mk_tonext2, mk_next)
    copy(bytes, [0x49, 0xFF, 0xC1])               // inc r9
    la mk_jmp = lengde(bytes)
    legg_til(bytes, 0xEB)                          // jmp scan (rel8)
    legg_til(bytes, (mk_scan - (mk_jmp + 2)) & 255)
    la mk_final = lengde(bytes)
    patch_jump(bytes, mk_tofinal, mk_final)
    copy(bytes, [
        0xB8, 0x53, 0x00, 0x00, 0x00,             // mov eax, 83
        0x4C, 0x89, 0xC7,                         // mov rdi, r8
        0xBE, 0xFF, 0x01, 0x00, 0x00,             // mov esi, 0x1FF
        0x0F, 0x05,                               // syscall
        0x48, 0x89, 0xC7                          // mov rdi, rax  (resultat)
    ])
    call_rel32(bytes, RT_INT(), TEXT_VA())        // rsp≡0 mod 16 her → aligna
    copy(bytes, [
        0x48, 0x89, 0xEC,                         // mov rsp, rbp
        0x5D,                                     // pop rbp
        0xC3                                      // ret
    ])

    la safepoint_adresse = HEAP_VA() + GC_SAFEPOINT_OFFSET()
    // Safepoint-stub (fast 49 byte, sjå GC_SAFEPOINT_STUB_BYTES): tel opp; når teljaren
    // når terskelen → nullstill + kall gc_collect_native. Terskel = 0x7FFFFFFF (aldri) i
    // standard-modus, 1000 i GC-modus (NORSCODE_GC_ALLOC=1). Same storleik i begge modus
    // → gc_safepoint_va stabil, paritet urørt.
    la sp_terskel: heltall = 2147483647            // 0x7FFFFFFF (av)
    hvis gc_mode == "1" { sp_terskel = 1000 }
    copy(bytes, [0x48, 0xA1])                       // mov rax,[counter]
    u64(bytes, safepoint_adresse)
    copy(bytes, [0x48, 0xFF, 0xC0])                // inc rax
    copy(bytes, [0x48, 0xA3])                       // mov [counter],rax
    u64(bytes, safepoint_adresse)
    copy(bytes, [0x48, 0x3D])                       // cmp rax, terskel
    u32(bytes, sp_terskel)
    copy(bytes, [0x72, 0x3D])                       // jb .skip (+61, forbi save/call/restore)
    copy(bytes, [0x31, 0xC0])                       // xor eax,eax
    copy(bytes, [0x48, 0xA3])                       // mov [counter],rax (nullstill)
    u64(bytes, safepoint_adresse)
    // KRITISK: safepoint kan fyre midt i uttrykk der levande NcVal-ar ligg i register.
    // (1) gc_collect_native klobrar caller-saved (rcx/rdx/rsi/rdi/r8-r11) → må lagrast.
    // (2) codegen held levande NcVal-ar i CALLEE-saved (rbx/r12-r15, jf. `mov rdi,r12`)
    //     som collect BEVARER men den konservative stakk-skanninga ALDRI ser (ikkje på
    //     stakken) → objektet vert ikkje markert → sweep frigjer det → korrupsjon.
    // Push ALLE (14, 16-justert) FØR collect: bevarer caller-saved OG legg callee-saved
    // på stakken slik at [rsp+8, stack_base)-skanninga finn dei som røter. rax er daud her.
    copy(bytes, [0x51, 0x52, 0x56, 0x57])          // push rcx,rdx,rsi,rdi
    copy(bytes, [0x41, 0x50, 0x41, 0x51, 0x41, 0x52, 0x41, 0x53]) // push r8,r9,r10,r11
    copy(bytes, [0x53, 0x55])                       // push rbx,rbp
    copy(bytes, [0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57]) // push r12,r13,r14,r15
    call_rel32(bytes, atomics["gc_collect_native"], TEXT_VA()) // call gc_collect_native (5B)
    copy(bytes, [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C]) // pop r15,r14,r13,r12
    copy(bytes, [0x5D, 0x5B])                       // pop rbp,rbx
    copy(bytes, [0x41, 0x5B, 0x41, 0x5A, 0x41, 0x59, 0x41, 0x58]) // pop r11,r10,r9,r8
    copy(bytes, [0x5F, 0x5E, 0x5A, 0x59])          // pop rdi,rsi,rdx,rcx
    copy(bytes, [0xC3])                            // .skip: ret
    hvis gc_mode == "1" {
        bytes = patch_bump_prologer(bytes, atomics["gc_alloc16"], frozen_len)
        bytes = patch_var_allocators(bytes, atomics["gc_alloc_var"], frozen_len)
        bytes = patch_list_new(bytes, atomics["gc_alloc_var"], frozen_len)
        bytes = patch_list_grow(bytes, atomics["gc_alloc_var_r8"], frozen_len)
    }
    returner [bytes, atomics]
}

// ─── Hovud kodegenererator ────────────────────────────────────────────────────

funksjon kompiler_fn_v2(fn_def, vars, fn_vas, rd_offs, eiga_va,
                        gc_safepoint_va, atomic_vas, global_vas) {
    la detaljsporing = miljo_hent("NC_NATIVE_CODEGEN_TRACE_INSTR") == "1"
    hvis detaljsporing { native_codegen_trace("kompiler_fn enter") }
    la kode = fn_def["code"]
    hvis detaljsporing { native_codegen_trace("kompiler_fn code") }
    la params = fn_def["params"]
    hvis detaljsporing { native_codegen_trace("kompiler_fn params") }
    la buf: liste = []
    hvis detaljsporing { native_codegen_trace("kompiler_fn buf") }
    la tstack: liste = []
    hvis detaljsporing { native_codegen_trace("kompiler_fn tstack") }
    la var_types: ordbok = {}
    hvis detaljsporing { native_codegen_trace("kompiler_fn var_types") }
    la var_namn = nøkler(vars)
    hvis detaljsporing { native_codegen_trace("kompiler_fn var_namn") }
    la n_vars: heltall = lengde(var_namn)
    hvis detaljsporing { native_codegen_trace("kompiler_fn n_vars=" + tekst_fra_heltall(n_vars)) }
    prolog(buf, n_vars + 8)
    hvis detaljsporing { native_codegen_trace("kompiler_fn prolog") }

    // Lagre parameter-register (System V: rdi, rsi, rdx, rcx)
    la param_regs: liste = [0xBD, 0xB5, 0x95, 0x8D]  // mov [rbp+disp], rdi/rsi/rdx/rcx
    hvis detaljsporing { native_codegen_trace("kompiler_fn param_regs") }
    la pi: heltall = 0
    mens pi < lengde(params)
        la pnm: tekst = tekst(params[pi])
        la slot: heltall = 1
        hvis finnes_nøkkel(vars, pnm) { slot = vars[pnm] }
        la disp = rbp_off(slot)
        hvis pi < 4 {
            legg_til(buf, 0x48)
            legg_til(buf, 0x89)
            u8(buf, param_regs[pi])
        } ellers hvis pi < 6 {
            legg_til(buf, 0x4C)
            legg_til(buf, 0x89)
            hvis pi == 4 { legg_til(buf, 0x85) } // mov [rbp+disp],r8
            ellers { legg_til(buf, 0x8D) }        // mov [rbp+disp],r9
        } ellers {
            // System V stackargument: arg6 på [rbp+16], deretter stigande.
            copy(buf, [0x48, 0x8B, 0x85])
            u32(buf, 16 + (pi - 6) * 8)
            copy(buf, [0x48, 0x89, 0x85])
        }
        u32(buf, disp)
        pi = pi + 1
    slutt

    // Label-kart (label → buf offset) og patch-liste
    la lbl_kart: ordbok = {}
    la patches: liste = []  // [{type: "jmp"/"jz", pos: heltall, lbl: tekst}]

    la ci: heltall = 0
    mens ci < lengde(kode)
        la instr = kode[ci]
        la op: tekst = instr[0]
        hvis detaljsporing {
            native_codegen_trace("instr=" + tekst_fra_heltall(ci) + " op=" + op)
        }
        // ─── LABEL ────────────────────────────────────────────────────────────
        hvis op == "LABEL"
            lbl_kart[tekst(instr[1])] = lengde(buf)

        // ─── PUSH_CONST ───────────────────────────────────────────────────────
        ellers hvis op == "PUSH_CONST"
            emit_push_const(buf, instr[1], rd_offs, eiga_va)
            la vtype: tekst = builtin.type(instr[1])
            hvis instr[1] == null { vtype = "null" }
            hvis vtype == "tekst" { vtype = "str" }
            hvis vtype == "heltall" { vtype = "int" }
            hvis vtype == "boolsk" { vtype = "bool" }
            legg_til(tstack, vtype)

        // ─── POP ──────────────────────────────────────────────────────────────
        ellers hvis op == "POP"
            legg_til(buf, 0x58)  // pop rax (discard)
            tstack_drop(tstack, 1)

        ellers hvis op == "DUP"
            copy(buf, [0x48, 0x8B, 0x04, 0x24])  // mov rax,[rsp]
            legg_til(buf, 0x50)                  // push rax
            legg_til(tstack, tstack_top(tstack))

        // ─── STORE_NAME ───────────────────────────────────────────────────────
        ellers hvis op == "STORE_NAME"
            la nm_store: tekst = tekst(instr[1])
            la stype: tekst = tstack_top(tstack)
            var_types[nm_store] = stype
            emit_store_var(buf, vars, tekst(instr[1]))
            tstack_drop(tstack, 1)

        // ─── LOAD_NAME ────────────────────────────────────────────────────────
        ellers hvis op == "LOAD_NAME"
            emit_load_var(buf, vars, tekst(instr[1]))
            la nm_load: tekst = tekst(instr[1])
            la ltype: tekst = "any"
            hvis finnes_nøkkel(var_types, nm_load) { ltype = var_types[nm_load] }
            legg_til(tstack, ltype)

        // ─── Modulglobale verdiar ────────────────────────────────────────────
        // Slotane ligg i den skrivebare host-ABI-sida og er nullinitialiserte
        // av ELF-lasteren. Nøkkelen bind modul + namn, slik at like globale
        // namn i ulike modular aldri aliasar kvarandre.
        ellers hvis op == "STORE_GLOBAL"
            la global_store_key = tekst(fn_def["module"]) + "." + tekst(instr[1])
            hvis ikkje finnes_nøkkel(global_vas, global_store_key) {
                kast "native codegen: manglar globalslot for " + global_store_key
            }
            legg_til(buf, 0x58)                              // pop rax
            copy(buf, [0x49, 0xBB])                         // movabs r11,slot
            u64(buf, global_vas[global_store_key])
            copy(buf, [0x49, 0x89, 0x03])                   // mov [r11],rax
            tstack_drop(tstack, 1)

        ellers hvis op == "LOAD_GLOBAL"
            la global_load_key = tekst(fn_def["module"]) + "." + tekst(instr[1])
            hvis ikkje finnes_nøkkel(global_vas, global_load_key) {
                kast "native codegen: manglar globalslot for " + global_load_key
            }
            copy(buf, [0x49, 0xBB])                         // movabs r11,slot
            u64(buf, global_vas[global_load_key])
            copy(buf, [0x49, 0x8B, 0x03])                   // mov rax,[r11]
            legg_til(buf, 0x50)                             // push rax
            legg_til(tstack, "any")

        // ─── BINARY ops ───────────────────────────────────────────────────────
        ellers hvis op == "BINARY_ADD"
            la t2: tekst = tstack_top(tstack)
            la t1: tekst = tstack_top_2(tstack)
            tstack_drop(tstack, 2)
            hvis t1 == "str" eller t2 == "str" {
                // Streng-konkat: VM-en konverterer den andre operanden (`"b" + 7` →
                // "b7", `"x" + null` → "x"). RT_CONCAT kopierer rått frå [payload] og
                // segfaulta på int/null (krasj @0x4010ab, 1 MB-kopi frå kodeadresse —
                // fann det i fersk seed sin parser-feilmeldingsveg). Konverter operandar
                // som ikkje er statisk "str" via to_text-atomet (str→same, int→desimal,
                // elles tom streng) FØR kallet. Stakk: [.., venstre, høgre(topp)].
                // Statisk "str" er ikkje garantert (deklarert `: tekst` kan halde null/
                // bool/tal ved køyring — fersk seed krasja i parser-vegen sjølv med
                // statisk-gata konvertering). Konverter difor ALLTID begge (to_text er
                // rein passthrough for ekte strengar: cmp type,2 → ret).
                hvis sann {
                    legg_til(buf, 0x5F)                              // pop rdi (høgre)
                    call_rel32(buf, atomic_vas["to_text"], eiga_va)  // rax = streng
                    legg_til(buf, 0x50)                              // push rax
                }
                hvis sann {
                    legg_til(buf, 0x5E)                              // pop rsi (høgre)
                    legg_til(buf, 0x5F)                              // pop rdi (venstre)
                    legg_til(buf, 0x56)                              // push rsi (spar høgre)
                    call_rel32(buf, atomic_vas["to_text"], eiga_va)  // rax = streng(venstre)
                    legg_til(buf, 0x5E)                              // pop rsi (høgre)
                    legg_til(buf, 0x50)                              // push rax (venstre')
                    legg_til(buf, 0x56)                              // push rsi (høgre)
                }
                emit_rt_call_2(buf, RT_CONCAT(), eiga_va)
                legg_til(tstack, "str")
            } ellers hvis t1 == "int" og t2 == "int" {
                emit_int_binary_inline(buf, op, eiga_va)
                legg_til(tstack, "int")
            } ellers {
                emit_dynamic_add_inline(buf, eiga_va)
                legg_til(tstack, "any")
            }

        ellers hvis op == "BINARY_SUB"
            emit_rt_call_2(buf, RT_SUB(), eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "int")

        ellers hvis op == "BINARY_MUL"
            emit_rt_call_2(buf, RT_MUL(), eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "int")

        ellers hvis op == "BINARY_DIV"
            emit_rt_call_2(buf, RT_DIV(), eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "int")

        ellers hvis op == "BINARY_MOD"
            emit_rt_call_2(buf, RT_MOD(), eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "int")

        ellers hvis op == "BINARY_AND" eller op == "BINARY_OR" eller op == "BINARY_XOR" eller op == "BINARY_LSHIFT" eller op == "BINARY_RSHIFT"
            emit_int_binary_inline(buf, op, eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "int")

        ellers hvis op == "UNARY_NEG"
            emit_rt_call_1(buf, RT_NEG(), eiga_va)
            tstack_drop(tstack, 1)
            legg_til(tstack, "int")
        ellers hvis op == "UNARY_NOT"
            emit_rt_call_1(buf, RT_NOT(), eiga_va)
            tstack_drop(tstack, 1)
            legg_til(tstack, "bool")
        ellers hvis op == "UNARY_BNOT"
            emit_int_bnot_inline(buf, eiga_va)
            tstack_drop(tstack, 1)
            legg_til(tstack, "int")

        // ─── COMPARE ops ──────────────────────────────────────────────────────
        ellers hvis op == "COMPARE_EQ"
            emit_null_safe_compare(buf, RT_EQ(), usann, eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "bool")
        ellers hvis op == "COMPARE_NE"
            emit_null_safe_compare(buf, RT_NE(), sann, eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "bool")
        ellers hvis op == "COMPARE_LT"
            emit_rt_call_2(buf, RT_LT(), eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "bool")
        ellers hvis op == "COMPARE_GT"
            emit_rt_call_2(buf, RT_GT(), eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "bool")
        ellers hvis op == "COMPARE_LE"
            hvis tstack_top_2(tstack) == "int" og tstack_top(tstack) == "int" {
                emit_int_order_compare_inline(buf, "le", eiga_va)
            } ellers {
                emit_raw_bool_rt_call_2(buf, RT_LE(), eiga_va)
            }
            tstack_drop(tstack, 2)
            legg_til(tstack, "bool")
        ellers hvis op == "COMPARE_GE"
            hvis tstack_top_2(tstack) == "int" og tstack_top(tstack) == "int" {
                emit_int_order_compare_inline(buf, "ge", eiga_va)
            } ellers {
                emit_raw_bool_rt_call_2(buf, RT_GE(), eiga_va)
            }
            tstack_drop(tstack, 2)
            legg_til(tstack, "bool")

        // ─── JUMP ─────────────────────────────────────────────────────────────
        ellers hvis op == "JUMP"
            la lbl: tekst = tekst(instr[1])
            la ppos = emit_jmp_placeholder(buf)
            legg_til(patches, {"type": "jmp", "pos": ppos, "lbl": lbl})

        // ─── JUMP_IF_FALSE ────────────────────────────────────────────────────
        ellers hvis op == "JUMP_IF_FALSE"
            la lbl2: tekst = tekst(instr[1])
            la ppos2: heiltall = 0
            hvis tstack_top(tstack) == "bool" {
                ppos2 = emit_jz_bool_placeholder(buf)
            } ellers {
                ppos2 = emit_jz_placeholder(buf, eiga_va)
            }
            legg_til(patches, {"type": "jz", "pos": ppos2, "lbl": lbl2})
            tstack_drop(tstack, 1)

        // ─── INDEX_GET ────────────────────────────────────────────────────────
        ellers hvis op == "INDEX_GET"
            emit_null_safe_index_get(buf, eiga_va)
            tstack_drop(tstack, 2)
            legg_til(tstack, "any")

        // ─── INDEX_SET ────────────────────────────────────────────────────────
        ellers hvis op == "INDEX_SET"
            emit_null_safe_index_set(buf, eiga_va)  // pop rdx=val/rsi=key/rdi=obj, null-trygg
            tstack_drop(tstack, 3)
            legg_til(tstack, "any")

        // ─── BUILD_LIST ───────────────────────────────────────────────────────
        ellers hvis op == "BUILD_LIST"
            la blen: heltall = instr[1]
            hvis blen == 0
                call_rel32(buf, RT_LIST_NEW(), eiga_va)
                legg_til(buf, 0x50)
            ellers
                // mov rdi, rsp (ptr to items on stack)
                legg_til(buf, 0x48)
                legg_til(buf, 0x89)
                legg_til(buf, 0xE7)
                // mov rsi, n (u64 immediate)
                legg_til(buf, 0x48)
                legg_til(buf, 0xBE)
                u64(buf, blen)
                call_rel32(buf, RT_BUILD_LIST_REV(), eiga_va)
                // add rsp, blen*8
                legg_til(buf, 0x48)
                legg_til(buf, 0x81)
                legg_til(buf, 0xC4)
                u32(buf, blen * 8)
                legg_til(buf, 0x50)  // push list
            slutt
            call_rel32(buf, gc_safepoint_va, eiga_va)

        // ─── BUILD_MAP ────────────────────────────────────────────────────────
        ellers hvis op == "BUILD_MAP"
            la mlen: heiltall = instr[1]
            hvis mlen == 0
                call_rel32(buf, RT_MAP_NEW(), eiga_va)
                legg_til(buf, 0x50)
            ellers
                // mov rdi, rsp
                legg_til(buf, 0x48)
                legg_til(buf, 0x89)
                legg_til(buf, 0xE7)
                // mov rsi, n
                legg_til(buf, 0x48)
                legg_til(buf, 0xBE)
                u64(buf, mlen)
                call_rel32(buf, RT_BUILD_MAP_REV(), eiga_va)
                // add rsp, mlen*16 (2 items per pair)
                legg_til(buf, 0x48)
                legg_til(buf, 0x81)
                legg_til(buf, 0xC4)
                u32(buf, mlen * 16)
                legg_til(buf, 0x50)  // push map
            slutt
            call_rel32(buf, gc_safepoint_va, eiga_va)

        // ─── CALL ─────────────────────────────────────────────────────────────
        ellers hvis op == "CALL"
            la fn_nm: tekst = tekst(instr[1])
            la nargs: heiltall = instr[2]
            emit_builtin_or_user_call(buf, fn_nm, nargs, fn_vas, rd_offs, eiga_va, atomic_vas)
            call_rel32(buf, gc_safepoint_va, eiga_va)
            tstack_drop(tstack, nargs)
            legg_til(tstack, call_result_type(fn_nm))

        // ─── RETURN ───────────────────────────────────────────────────────────
        ellers hvis op == "RETURN"
            legg_til(buf, 0x58)  // pop rax (return value = NcVal*)
            tstack_drop(tstack, 1)
            epilog(buf)

        // ─── THROW ────────────────────────────────────────────────────────────
        ellers hvis op == "THROW"
            emit_rt_call_1(buf, atomic_vas["throw_unwind"], eiga_va)

        // ─── TRY_BEGIN (push handler {catch_va, rsp, rbp}) ──────────────────────
        ellers hvis op == "TRY_BEGIN"
            la catch_lbl3: tekst = tekst(instr[1])
            copy(buf, [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x6F, 0x10]) // mov rax,[0x106F0000] (count)
            copy(buf, [0x48, 0x89, 0xC1])                // mov rcx,rax
            copy(buf, [0x48, 0xC1, 0xE0, 0x05])          // shl rax,5 (*32)
            copy(buf, [0x48, 0x05, 0x00, 0x00, 0x60, 0x10]) // add rax,0x10600000 (frame)
            copy(buf, [0x49, 0xB8])                       // mov r8, imm64 (catch_va — abs64-patch)
            u64(buf, 0)
            legg_til(patches, {"type": "abs64", "pos": lengde(buf) - 8, "lbl": catch_lbl3})
            copy(buf, [0x4C, 0x89, 0x00])                // mov [rax],r8 (catch_va)
            copy(buf, [0x48, 0x89, 0x60, 0x08])          // mov [rax+8],rsp
            copy(buf, [0x48, 0x89, 0x68, 0x10])          // mov [rax+16],rbp
            copy(buf, [0x48, 0xFF, 0xC1])                // inc rcx
            copy(buf, [0x48, 0x89, 0x0C, 0x25, 0x00, 0x00, 0x6F, 0x10]) // mov [0x106F0000],rcx (count++)

        // ─── TRY_END (pop handler) ──────────────────────────────────────────────
        ellers hvis op == "TRY_END"
            copy(buf, [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x6F, 0x10]) // mov rax,[0x106F0000]
            copy(buf, [0x48, 0x85, 0xC0])                // test rax,rax
            copy(buf, [0x74, 0x0B])                      // jz +11
            copy(buf, [0x48, 0xFF, 0xC8])                // dec rax
            copy(buf, [0x48, 0x89, 0x04, 0x25, 0x00, 0x00, 0x6F, 0x10]) // mov [0x106F0000],rax

        // ─── LOAD_EXCEPTION (push last_exception) ───────────────────────────────
        ellers hvis op == "LOAD_EXCEPTION"
            copy(buf, [0x48, 0x8B, 0x04, 0x25, 0x08, 0x00, 0x6F, 0x10]) // mov rax,[0x106F0008]
            legg_til(buf, 0x50)                          // push rax
            legg_til(tstack, "any")

        slutt
        ci = ci + 1
    slutt

    // Fallthrough: returner null-peikar
    legg_til(buf, 0x48)
    legg_til(buf, 0x31)
    legg_til(buf, 0xC0)   // xor rax, rax
    epilog(buf)

    // Patch jump-labels
    la pi2: heltall = 0
    mens pi2 < lengde(patches)
        la p = patches[pi2]
        la target: heltall = 0
        la lbl_nm = p["lbl"]
        hvis finnes_nøkkel(lbl_kart, lbl_nm) { target = lbl_kart[lbl_nm] }
        hvis p["type"] == "abs64"
            // absolutt catch-VA = funksjonens eiga_va + etikett-offset, skriv 8 byte LE
            la abs_va: heltall = eiga_va + target
            la bi: heltall = 0
            mens bi < 8
                buf[p["pos"] + bi] = (abs_va >> (bi * 8)) & 255
                bi = bi + 1
            slutt
        ellers
            patch_jump(buf, p["pos"], target)
        slutt
        pi2 = pi2 + 1
    slutt

    returner buf
}

// ─── Builtin og brukarkall dispatch ──────────────────────────────────────────
funksjon builtin_va(fn_nm: tekst, atomic_vas) -> heltall {
    // GC F1: råminne-inspeksjonsprimitiv.
    hvis fn_nm == "builtin.raw_load64" eller fn_nm == "raw_load64" { returner atomic_vas["raw_load64"] }
    hvis fn_nm == "builtin.raw_store64" eller fn_nm == "raw_store64" { returner atomic_vas["raw_store64"] }
    hvis fn_nm == "builtin.heap_bump" eller fn_nm == "heap_bump" { returner atomic_vas["heap_bump"] }
    hvis fn_nm == "builtin.obj_addr" eller fn_nm == "obj_addr" { returner atomic_vas["obj_addr"] }
    hvis fn_nm == "builtin.stack_base" eller fn_nm == "stack_base" { returner atomic_vas["stack_base"] }
    hvis fn_nm == "builtin.stack_ptr" eller fn_nm == "stack_ptr" { returner atomic_vas["stack_ptr"] }
    hvis fn_nm == "builtin.heap_set_bump" eller fn_nm == "heap_set_bump" { returner atomic_vas["heap_set_bump"] }
    hvis fn_nm == "builtin.gc_alloc" eller fn_nm == "gc_alloc" { returner atomic_vas["gc_alloc"] }
    hvis fn_nm == "builtin.gc_free" eller fn_nm == "gc_free" { returner atomic_vas["gc_free"] }
    hvis fn_nm == "builtin.gc_mark_bit" eller fn_nm == "gc_mark_bit" { returner atomic_vas["gc_mark_bit"] }
    hvis fn_nm == "builtin.gc_mark_native" eller fn_nm == "gc_mark_native" { returner atomic_vas["gc_mark_native"] }
    hvis fn_nm == "builtin.gc_sweep_native" eller fn_nm == "gc_sweep_native" { returner atomic_vas["gc_sweep_native"] }
    hvis fn_nm == "builtin.gc_box_int" eller fn_nm == "gc_box_int" { returner atomic_vas["gc_box_int"] }
    hvis fn_nm == "builtin.gc_alloc16" eller fn_nm == "gc_alloc16" { returner atomic_vas["gc_alloc16"] }
    hvis fn_nm == "builtin.gc_bitmap_clear" eller fn_nm == "gc_bitmap_clear" { returner atomic_vas["gc_bitmap_clear"] }
    hvis fn_nm == "builtin.gc_sort_livemap" eller fn_nm == "gc_sort_livemap" { returner atomic_vas["gc_sort_livemap"] }
    hvis fn_nm == "builtin.gc_sweep_full" eller fn_nm == "gc_sweep_full" { returner atomic_vas["gc_sweep_full"] }
    hvis fn_nm == "builtin.gc_mark_roots" eller fn_nm == "gc_mark_roots" { returner atomic_vas["gc_mark_roots"] }
    hvis fn_nm == "builtin.gc_collect_native" eller fn_nm == "gc_collect_native" { returner atomic_vas["gc_collect_native"] }
    // String-ops
    la er_split        = fn_nm == "builtin.split" eller builtin.ends_with(fn_nm, ".split") eller fn_nm == "tekst_splitt"
    la er_join         = fn_nm == "builtin.join" eller builtin.ends_with(fn_nm, ".join") eller fn_nm == "tekst_join"
    la er_contains     = fn_nm == "builtin.contains" eller builtin.ends_with(fn_nm, ".contains") eller fn_nm == "tekst_inneholder"
    la er_starts_with  = fn_nm == "builtin.starts_with" eller builtin.ends_with(fn_nm, ".starts_with") eller fn_nm == "tekst_starter_med"
    la er_ends_with    = fn_nm == "builtin.ends_with" eller builtin.ends_with(fn_nm, ".ends_with") eller fn_nm == "tekst_slutter_med"
    la er_slice        = fn_nm == "builtin.slice" eller builtin.ends_with(fn_nm, ".slice")
    la er_index_of     = fn_nm == "index_of" eller fn_nm == "builtin.index_of" eller builtin.ends_with(fn_nm, ".index_of")
    la er_replace      = fn_nm == "builtin.replace" eller fn_nm == "tekst_erstatt" eller builtin.ends_with(fn_nm, ".replace")
    la er_trim         = fn_nm == "builtin.trim" eller fn_nm == "tekst_trim" eller builtin.ends_with(fn_nm, ".trim")
    la er_lower        = fn_nm == "builtin.lower" eller builtin.ends_with(fn_nm, "tekst_til_liten") eller builtin.ends_with(fn_nm, "tekst_sma") eller builtin.ends_with(fn_nm, ".lower")
    la er_upper        = fn_nm == "builtin.upper" eller builtin.ends_with(fn_nm, "tekst_til_store") eller builtin.ends_with(fn_nm, "tekst_store") eller builtin.ends_with(fn_nm, ".upper")
    la er_char_code    = fn_nm == "builtin.char_code" eller fn_nm == "char_code"
    la er_chr          = fn_nm == "builtin.chr" eller fn_nm == "chr"
    la er_type         = fn_nm == "builtin.type" eller fn_nm == "builtin.type_av" eller fn_nm == "type_av" eller fn_nm == "type"
    la er_atomic_load  = fn_nm == "builtin.atomic_load_ptr" eller builtin.ends_with(fn_nm, ".atomic_load_ptr")
    la er_atomic_store = fn_nm == "builtin.atomic_store_ptr" eller builtin.ends_with(fn_nm, ".atomic_store_ptr")
    la er_atomic_xchg  = fn_nm == "builtin.atomic_exchange_ptr" eller builtin.ends_with(fn_nm, ".atomic_exchange_ptr")
    la er_atomic_cas   = fn_nm == "builtin.atomic_compare_exchange_ptr" eller builtin.ends_with(fn_nm, ".atomic_compare_exchange_ptr")
    la er_atomic_add   = fn_nm == "builtin.atomic_fetch_add_ptr" eller builtin.ends_with(fn_nm, ".atomic_fetch_add_ptr")
    la er_atomic_fence = fn_nm == "builtin.atomic_fence" eller builtin.ends_with(fn_nm, ".atomic_fence")
    // Int/bool/str conv
    la er_itos         = fn_nm == "tekst_fra_heltall" eller builtin.ends_with(fn_nm, ".tekst_fra_heltall")
    la er_stoi         = fn_nm == "heltall_fra_tekst" eller builtin.ends_with(fn_nm, ".heltall_fra_tekst") eller fn_nm == "heltall" eller builtin.ends_with(fn_nm, ".heltall")
    la er_to_tekst     = fn_nm == "tekst" eller fn_nm == "builtin.tekst" eller fn_nm == "til_tekst" eller fn_nm == "builtin.til_tekst" eller builtin.ends_with(fn_nm, ".til_tekst")
    la er_to_int       = fn_nm == "builtin.desimaltall"
    // IO
    la er_skriv        = fn_nm == "skriv" eller builtin.ends_with(fn_nm, ".skriv")
    la er_fil_les      = fn_nm == "fil_les" eller builtin.ends_with(fn_nm, ".fil_les")
    la er_fil_skriv    = fn_nm == "fil_skriv" eller builtin.ends_with(fn_nm, ".fil_skriv")
    la er_fil_binar    = fn_nm == "fil_skriv_binar" eller fn_nm == "fil_skriv_binary" eller builtin.ends_with(fn_nm, ".fil_skriv_binar") eller builtin.ends_with(fn_nm, ".fil_skriv_binary") eller builtin.ends_with(fn_nm, ".fil_skriv_binær")
    la er_fil_finnes   = fn_nm == "fil_finnes" eller builtin.ends_with(fn_nm, ".fil_finnes")
    la er_mkdir        = fn_nm == "builtin.mkdir_p" eller fn_nm == "mkdir_p" eller builtin.ends_with(fn_nm, ".mkdir_p") eller fn_nm == "builtin.mkdir" eller fn_nm == "mkdir"
    la er_miljo_hent   = fn_nm == "miljo_hent" eller builtin.ends_with(fn_nm, ".miljo_hent")
    la er_miljo_finnes = fn_nm == "miljo_finnes" eller builtin.ends_with(fn_nm, ".miljo_finnes")
    // JSON
    la er_json_parse   = fn_nm == "json_parse_raw" eller fn_nm == "json_parse" eller builtin.ends_with(fn_nm, ".json_parse_raw") eller builtin.ends_with(fn_nm, ".json_parse")
    // Brukardefinerte funksjonar som selfhost.json.json_skriv må relokerast
    // som ordinære Norscode-kall. Berre eksplisitte builtin-/ukvalifiserte
    // JSON-intrinsics skal gå til den native skalarrutinen.
    la er_json_str     = fn_nm == "json_stringify" eller fn_nm == "json_skriv" eller fn_nm == "builtin.json_stringify" eller fn_nm == "builtin.json_skriv"
    // List
    la er_legg_til     = fn_nm == "legg_til" eller builtin.ends_with(fn_nm, ".legg_til")
    la er_lengde       = fn_nm == "lengde" eller builtin.ends_with(fn_nm, ".lengde")
    la er_fjern_siste  = fn_nm == "fjern_siste" eller fn_nm == "pop_siste" eller builtin.ends_with(fn_nm, ".fjern_siste")
    la er_fjern        = fn_nm == "fjern" eller fn_nm == "fjern_indeks" eller builtin.ends_with(fn_nm, ".fjern")
    // Map
    la er_finnes_nokkel = fn_nm == "finnes_nøkkel" eller fn_nm == "har_nokkel" eller builtin.ends_with(fn_nm, ".finnes_nøkkel") eller builtin.ends_with(fn_nm, ".har_nokkel")
    la er_map_set       = fn_nm == "map_set" eller builtin.ends_with(fn_nm, ".map_set")
    la er_map_get       = fn_nm == "map_get" eller builtin.ends_with(fn_nm, ".map_get")
    la er_nokler       = fn_nm == "nøkler" eller builtin.ends_with(fn_nm, ".nøkler")
    la er_verdier      = fn_nm == "verdier" eller builtin.ends_with(fn_nm, ".verdier")
    la er_fjern_nokkel = fn_nm == "fjern_nokkel" eller builtin.ends_with(fn_nm, ".fjern_nokkel")
    // Other
    la er_feil         = fn_nm == "feil" eller builtin.ends_with(fn_nm, ".feil")
    la er_exit         = fn_nm == "stopp" eller fn_nm == "exit" eller fn_nm == "builtin.exit" eller builtin.ends_with(fn_nm, ".stopp") eller builtin.ends_with(fn_nm, ".exit")
    la er_kast         = fn_nm == "kast"

    hvis er_split       { returner RT_SPLIT() }
    hvis er_join        { returner RT_JOIN() }
    hvis er_contains    { returner atomic_vas["contains"] }
    hvis er_starts_with { returner atomic_vas["starts_with"] }
    hvis er_ends_with   { returner atomic_vas["ends_with"] }
    hvis er_slice       { returner atomic_vas["slice"] }
    hvis er_index_of    { returner atomic_vas["index_of"] }
    hvis er_replace     { returner RT_REPLACE() }
    hvis er_trim        { returner atomic_vas["trim"] }
    hvis er_lower       { returner atomic_vas["lower"] }
    hvis er_upper       { returner atomic_vas["upper"] }
    hvis er_char_code   { returner atomic_vas["char_code"] }
    hvis er_chr         { returner atomic_vas["chr"] }
    hvis er_type        { returner RT_TYPE_OF() }
    hvis er_atomic_load  { returner atomic_vas["load"] }
    hvis er_atomic_store { returner atomic_vas["store"] }
    hvis er_atomic_xchg  { returner atomic_vas["exchange"] }
    hvis er_atomic_cas   { returner atomic_vas["compare_exchange"] }
    hvis er_atomic_add   { returner atomic_vas["fetch_add"] }
    hvis er_atomic_fence { returner atomic_vas["fence"] }
    hvis er_itos        { returner RT_INT_TO_STR() }
    hvis er_stoi        { returner RT_STR_TO_INT() }
    hvis er_to_tekst    { returner atomic_vas["to_text"] }
    hvis er_to_int      { returner RT_TO_INT() }
    hvis er_skriv       { returner RT_SKRIV() }
    hvis er_fil_les     { returner RT_FIL_LES() }
    hvis er_fil_skriv   { returner RT_FIL_SKRIV() }
    hvis er_fil_binar   { returner RT_FIL_SKRIV_BINAR() }
    hvis er_fil_finnes  { returner RT_FIL_FINNES() }
    hvis er_mkdir       { returner atomic_vas["mkdir_p"] }
    hvis er_miljo_hent  { returner RT_MILJO_HENT() }
    hvis er_miljo_finnes { returner RT_MILJO_FINNES() }
    hvis er_json_parse  { returner RT_JSON_PARSE() }
    hvis er_json_str    { returner atomic_vas["json_stringify"] }
    hvis er_map_set     { returner RT_MAP_SET() }
    hvis er_map_get     { returner RT_MAP_GET() }
    hvis er_legg_til    { returner RT_LIST_APP() }
    hvis er_lengde      { returner RT_LENGDE() }
    hvis er_fjern_siste { returner RT_LIST_POP() }
    hvis er_fjern       { returner RT_LIST_REMOVE() }
    hvis er_finnes_nokkel { returner RT_MAP_HAS() }
    hvis er_nokler      { returner RT_MAP_KEYS() }
    hvis er_verdier     { returner RT_MAP_VALS() }
    hvis er_fjern_nokkel { returner RT_MAP_DEL() }
    hvis er_feil        { returner RT_FEIL() }
    hvis er_exit        { returner 0 }
    returner 0
}

// Gap-ruting (speglar macho_arm64_codegen.ncval_gap_rute): builtin-namn som
// native_codegen_v2 IKKJE har ei eiga runtime-rutine for, men som bundlaren
// har tvangs-inkludert ein rein-Norscode-impl for. Returner kandidat-nøklar;
// emit vel den fyrste som finst i fn_vas. Tom liste = inga ruting.
// Utan dette fall builtin.sha256 til siste-segment-matching og traff
// std.krypto.sha256 (som sjølv kallar builtin.sha256) → uendeleg sjølv-
// rekursjon → native stakk-overflow (signal 139).
funksjon gap_rute_v2(fn_nm: tekst) -> liste {
    la n = fn_nm
    hvis builtin.starts_with(n, "builtin.") { n = builtin.slice(n, 8, lengde(n)) }
    la delar = builtin.split(n, ".")
    la kort = delar[lengde(delar) - 1]
    // BERRE type-trygg rute: sha256 tek tekst→tekst → rein bit-ops-impl
    // std.sha256.hash. sha256_bytes/hmac_sha256_bytes tek liste_heiltall, men
    // kallarane (nc_main modulcache) sender streng frå builtin.fil_les_binær
    // (RT_FIL_LES gjev streng) → dei må IKKJE rutast til hash_bytes (liste-
    // iterasjon på streng → krasj). Lat dei falle til null-fallbacken (gamal,
    // trygg åtferd). Ruta aktiverer seg berre når std.sha256.hash faktisk er i
    // bunten (nc_main via vm.no-importen); elles inert (t.d. stage-0-modulane).
    hvis kort == "sha256"     { returner ["std.sha256.hash"] }
    // pbkdf2_sha256(tekst,tekst,int,int) → pure tekst-signatur std.sha256.pbkdf2_hex.
    hvis kort == "pbkdf2_sha256" { returner ["std.sha256.pbkdf2_hex"] }
    // random_hex(int) → pure LCG std.sha256.random_hex_pure (unngår vm_random_hex-heng).
    hvis kort == "random_hex" { returner ["std.sha256.random_hex_pure"] }
    returner []
}


funksjon emit_process_request_field(buf, nøkkel: tekst, offset: heiltall, rd_offs, code_va) {
    emit_push_const(buf, nøkkel, rd_offs, code_va)
    copy(buf, [0x5E, 0x4C, 0x89, 0xE7])
    call_rel32(buf, RT_MAP_GET(), code_va)
    copy(buf, [0x48, 0x89, 0x44, 0x24, offset])
}

funksjon emit_process_result_set(buf, nøkkel: tekst, rd_offs, code_va) {
    copy(buf, [0x48, 0x89, 0xC2])
    emit_push_const(buf, nøkkel, rd_offs, code_va)
    copy(buf, [0x5E, 0x4C, 0x89, 0xF7])
    call_rel32(buf, RT_MAP_SET(), code_va)
}

funksjon emit_process_raw_number_text(buf, offset: heiltall, code_va) {
    copy(buf, [0x49, 0x8B, 0x7D, offset])
    call_rel32(buf, RT_INT(), code_va)
    copy(buf, [0x48, 0x89, 0xC7])
    call_rel32(buf, RT_INT_TO_STR(), code_va)
}

funksjon er_strukturkonstruktør(fn_nm: tekst, nargs: heiltall) -> boolsk {
    // Strukturkall blir senka til `builtin.<Strukturnamn>()` av selfhost-
    // kompilatoren. Pure VM representerer instansen som ei tom ordbok før
    // feltinitialiseringa. AOT må ha same semantikk; null-fallback etterfølgt
    // av INDEX_SET skreiv elles gjennom nullpeikar og gav signal 139.
    hvis nargs != 0 eller ikkje builtin.starts_with(fn_nm, "builtin.") eller
       lengde(fn_nm) <= 8 { returner usann }
    la første = builtin.slice(fn_nm, 8, 9)
    returner første >= "A" og første <= "Z"
}

funksjon emit_builtin_or_user_call(buf, fn_nm: tekst, nargs: heltall, fn_vas, rd_offs, code_va, atomic_vas) {
    la er_exit = fn_nm == "stopp" eller fn_nm == "exit" eller fn_nm == "builtin.exit" eller builtin.ends_with(fn_nm, ".stopp") eller builtin.ends_with(fn_nm, ".exit")
    la er_type = fn_nm == "builtin.type" eller fn_nm == "builtin.type_av" eller fn_nm == "type_av" eller fn_nm == "type"
    hvis er_exit {
        hvis nargs >= 1 {
            legg_til(buf, 0x5F)   // pop rdi (NcVal* / exit code)
            // NcVal heiltall/bool lagrar payload på +8. null skal bli exit 0.
            legg_til(buf, 0x48)
            legg_til(buf, 0x85)
            legg_til(buf, 0xFF)   // test rdi, rdi
            legg_til(buf, 0x74)
            legg_til(buf, 0x04)   // je +4
            legg_til(buf, 0x48)
            legg_til(buf, 0x8B)
            legg_til(buf, 0x7F)
            legg_til(buf, 0x08)   // mov rdi, [rdi+8]
        } ellers {
            legg_til(buf, 0x48)
            legg_til(buf, 0xC7)
            legg_til(buf, 0xC7)
            u32(buf, 0)           // mov rdi, 0
        }
        legg_til(buf, 0x48)
        legg_til(buf, 0xC7)
        legg_til(buf, 0xC0)
        u32(buf, 60)              // mov rax, 60
        legg_til(buf, 0x0F)
        legg_til(buf, 0x05)       // syscall
        // Om syscall mot formodning returnerer, legg på ein null-retur
        // slik at bytecode-stacken held seg konsistent.
        legg_til(buf, 0x48)
        legg_til(buf, 0x31)
        legg_til(buf, 0xC0)       // xor rax, rax
        legg_til(buf, 0x50)       // push rax
        returner
    }
    hvis er_type {
        emit_type_of_inline(buf, rd_offs, code_va)
        returner
    }
    hvis er_strukturkonstruktør(fn_nm, nargs) {
        call_rel32(buf, RT_MAP_NEW(), code_va)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.native_heap_bytes" {
        la heap_arg_i: heiltall = 0
        mens heap_arg_i < nargs {
            legg_til(buf, 0x58)
            heap_arg_i = heap_arg_i + 1
        }
        copy(buf, [0x48, 0x8B, 0x3C, 0x25])
        u32(buf, HEAP_VA())
        copy(buf, [0x48, 0x81, 0xEF])
        u32(buf, HEAP_ALLOC_START())
        call_rel32(buf, RT_INT(), code_va)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.system_info" eller fn_nm == "system_info" {
        // Linux x86-64: uname(#63) + getcwd(#79) + readlink(#89 "/proc/self/exe") →
        // map {system, machine, cwd, executable, status:"ok"}. Manglande builtin gav
        // null → RT_MAP_KEYS(null) SIGSEGV (0x401ee9) i fersk seed; nc_main/harness/
        // verktøy les system_info()["system"|"machine"|"cwd"|"executable"|"status"].
        // Scratch på maskinstakken (r12 = base): [0,512) utsname (sysname@0,
        // machine@260), [512,1536) cwd, [1536,2560) exe, [2400,2416) "/proc/self/exe",
        // [2496,2536) 5 NcVal-slot. Strengar via RT_STR_RAW(rdi=ptr, rsi=len).
        la si_drop: heiltall = 0
        mens si_drop < nargs {
            legg_til(buf, 0x58)
            si_drop = si_drop + 1
        }
        copy(buf, [0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56])   // push rbx,r12,r13,r14
        copy(buf, [0x48, 0x81, 0xEC])                           // sub rsp,2560
        u32(buf, 2560)
        copy(buf, [0x49, 0x89, 0xE4])                           // mov r12,rsp
        // "/proc/self/exe\0" → [r12+2400]
        copy(buf, [0x48, 0xB8, 0x2F, 0x70, 0x72, 0x6F, 0x63, 0x2F, 0x73, 0x65]) // mov rax,"/proc/se"
        copy(buf, [0x49, 0x89, 0x84, 0x24]) u32(buf, 2400)                        // mov [r12+2400],rax
        copy(buf, [0x48, 0xB8, 0x6C, 0x66, 0x2F, 0x65, 0x78, 0x65, 0x00, 0x00]) // mov rax,"lf/exe\0\0"
        copy(buf, [0x49, 0x89, 0x84, 0x24]) u32(buf, 2408)                        // mov [r12+2408],rax
        // nullstill fyrste byte i sysname/cwd/exe (om syscall feilar → tom streng)
        copy(buf, [0x41, 0xC6, 0x04, 0x24, 0x00])                                  // mov byte[r12],0
        copy(buf, [0x41, 0xC6, 0x84, 0x24]) u32(buf, 260) legg_til(buf, 0x00)      // mov byte[r12+260],0
        copy(buf, [0x41, 0xC6, 0x84, 0x24]) u32(buf, 512) legg_til(buf, 0x00)      // mov byte[r12+512],0
        copy(buf, [0x41, 0xC6, 0x84, 0x24]) u32(buf, 1536) legg_til(buf, 0x00)     // mov byte[r12+1536],0
        // uname(r12)
        copy(buf, [0xB8, 0x3F, 0x00, 0x00, 0x00, 0x4C, 0x89, 0xE7, 0x0F, 0x05])   // mov eax,63; mov rdi,r12; syscall
        // getcwd(r12+512, 1024)
        copy(buf, [0xB8, 0x4F, 0x00, 0x00, 0x00])                                  // mov eax,79
        copy(buf, [0x49, 0x8D, 0xBC, 0x24]) u32(buf, 512)                          // lea rdi,[r12+512]
        copy(buf, [0xBE, 0x00, 0x04, 0x00, 0x00, 0x0F, 0x05])                      // mov esi,1024; syscall
        // readlink(r12+2400, r12+1536, 1023) → rax=len; NUL-terminer
        copy(buf, [0xB8, 0x59, 0x00, 0x00, 0x00])                                  // mov eax,89
        copy(buf, [0x49, 0x8D, 0xBC, 0x24]) u32(buf, 2400)                         // lea rdi,[r12+2400]
        copy(buf, [0x49, 0x8D, 0xB4, 0x24]) u32(buf, 1536)                         // lea rsi,[r12+1536]
        copy(buf, [0xBA, 0xFF, 0x03, 0x00, 0x00, 0x0F, 0x05])                      // mov edx,1023; syscall
        copy(buf, [0x48, 0x85, 0xC0, 0x78, 0x04])                                  // test rax,rax; js +4
        copy(buf, [0xC6, 0x04, 0x06, 0x00])                                        // mov byte[rsi+rax],0
        // fire C-strengar → NcVal-slot [r12+2496+8*i]: sysname@0, machine@260, cwd@512, exe@1536
        la si_felt = [0, 260, 512, 1536]
        la si_i: heiltall = 0
        mens si_i < 4 {
            copy(buf, [0x49, 0x8D, 0xBC, 0x24]) u32(buf, si_felt[si_i])            // lea rdi,[r12+felt]
            copy(buf, [0x31, 0xC9])                                                // xor ecx,ecx
            copy(buf, [0x80, 0x3C, 0x0F, 0x00])                                    // cmp byte[rdi+rcx],0
            copy(buf, [0x74, 0x05])                                                // je +5
            copy(buf, [0x48, 0xFF, 0xC1])                                          // inc rcx
            copy(buf, [0xEB, 0xF5])                                                // jmp cmp
            copy(buf, [0x48, 0x89, 0xCE])                                          // mov rsi,rcx
            call_rel32(buf, RT_STR_RAW(), code_va)                                 // rax = streng-NcVal
            copy(buf, [0x49, 0x89, 0x84, 0x24]) u32(buf, 2496 + 8 * si_i)          // mov [r12+slot],rax
            si_i = si_i + 1
        }
        // par: (system, machine, cwd, executable, status) → RT_BUILD_MAP_REV(rsp, 5)
        la si_nøklar = ["system", "machine", "cwd", "executable"]
        si_i = 0
        mens si_i < 4 {
            emit_push_const(buf, si_nøklar[si_i], rd_offs, code_va)               // push nøkkel
            copy(buf, [0x49, 0x8B, 0x84, 0x24]) u32(buf, 2496 + 8 * si_i)          // mov rax,[r12+slot]
            legg_til(buf, 0x50)                                                    // push verdi
            si_i = si_i + 1
        }
        emit_push_const(buf, "status", rd_offs, code_va)
        emit_push_const(buf, "ok", rd_offs, code_va)
        copy(buf, [0x48, 0x89, 0xE7])                                              // mov rdi,rsp
        copy(buf, [0x48, 0xC7, 0xC6, 0x05, 0x00, 0x00, 0x00])                      // mov rsi,5
        call_rel32(buf, RT_BUILD_MAP_REV(), code_va)                               // rax = map
        copy(buf, [0x48, 0x83, 0xC4, 0x50])                                        // add rsp,80
        copy(buf, [0x48, 0x81, 0xC4]) u32(buf, 2560)                               // add rsp,2560
        copy(buf, [0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B])                      // pop r14,r13,r12,rbx
        legg_til(buf, 0x50)                                                        // push map
        returner
    }
    hvis fn_nm == "builtin.tid_ms" eller fn_nm == "tid_ms" {
        la tid_i: heltall = 0
        mens tid_i < nargs {
            legg_til(buf, 0x58)
            tid_i = tid_i + 1
        }
        // Linux x86-64 clock_gettime(CLOCK_REALTIME) til epoch-millisekund.
        copy(buf, [0x48, 0x83, 0xEC, 0x10])
        copy(buf, [0x48, 0xC7, 0xC0])
        u32(buf, 228)
        copy(buf, [0x31, 0xFF, 0x48, 0x89, 0xE6, 0x0F, 0x05])
        copy(buf, [0x48, 0x69, 0x3C, 0x24])
        u32(buf, 1000)
        copy(buf, [0x48, 0x8B, 0x44, 0x24, 0x08, 0x31, 0xD2])
        copy(buf, [0x48, 0xB9])
        u64(buf, 1000000)
        copy(buf, [0x48, 0xF7, 0xF1, 0x48, 0x01, 0xC7, 0x48, 0x83, 0xC4, 0x10])
        call_rel32(buf, RT_INT(), code_va)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.vent.sov" eller fn_nm == "vent.sov" {
        // Linux x86-64 nanosleep(#35) med timespec på stakken. Argumentet er
        // millisekund (NcVal-int, payload @+8). Negativt → 0. Returnerer int 0.
        // (Seed-runtime FØR denne fiksen var no-op → test_vm_vent_sleep raud.)
        hvis nargs == 0 {
            copy(buf, [0x31, 0xC0])                       // xor eax,eax
        } ellers {
            legg_til(buf, 0x5F)                           // pop rdi (ms)
            la sov_drop_i: heiltall = 1
            mens sov_drop_i < nargs {
                legg_til(buf, 0x58)
                sov_drop_i = sov_drop_i + 1
            }
            copy(buf, [0x48, 0x8B, 0x47, 0x08])           // mov rax,[rdi+8]
        }
        copy(buf, [0x48, 0x85, 0xC0, 0x79, 0x02, 0x31, 0xC0]) // test rax,rax; jns +2; xor eax,eax
        copy(buf, [0x48, 0x83, 0xEC, 0x10])               // sub rsp,16
        copy(buf, [0x31, 0xD2])                           // xor edx,edx
        copy(buf, [0x48, 0xC7, 0xC1])                     // mov rcx,1000
        u32(buf, 1000)
        copy(buf, [0x48, 0xF7, 0xF1])                     // div rcx → rax=sek, rdx=ms-rest
        copy(buf, [0x48, 0x89, 0x04, 0x24])               // mov [rsp],rax (tv_sec)
        copy(buf, [0x48, 0x69, 0xD2])                     // imul rdx,rdx,1000000
        u32(buf, 1000000)
        copy(buf, [0x48, 0x89, 0x54, 0x24, 0x08])         // mov [rsp+8],rdx (tv_nsec)
        copy(buf, [0x48, 0x89, 0xE7])                     // mov rdi,rsp
        copy(buf, [0x31, 0xF6])                           // xor esi,esi
        copy(buf, [0x48, 0xC7, 0xC0])                     // mov rax,35 (nanosleep)
        u32(buf, 35)
        copy(buf, [0x0F, 0x05])                           // syscall
        copy(buf, [0x48, 0x83, 0xC4, 0x10])               // add rsp,16
        copy(buf, [0x31, 0xFF])                           // xor edi,edi
        call_rel32(buf, RT_INT(), code_va)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.thread_current_id" eller fn_nm == "thread_current_id" {
        la thread_id_i: heiltall = 0
        mens thread_id_i < nargs {
            legg_til(buf, 0x58)
            thread_id_i = thread_id_i + 1
        }
        // Freestanding single-thread VM brukar stabil hovudtråd-id 0.
        legg_til(buf, 0x31)
        legg_til(buf, 0xFF)
        call_rel32(buf, RT_INT(), code_va)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.process_spawn_argv" eller fn_nm == "process_spawn_argv" {
        // Materialiser det versjonerte request-kartet som eit smalt rå-ABI-
        // område. Sjølve prosessarbeidet ligg i Norscode-emittert Linux-kode;
        // resultatet blir pakka tilbake til vanlege Norscode-verdiar her.
        legg_til(buf, 0x5F)                           // rdi=request
        la process_drop_i: heiltall = 1
        mens process_drop_i < nargs {
            legg_til(buf, 0x58)
            process_drop_i = process_drop_i + 1
        }
        copy(buf, [0x41, 0x54, 0x41, 0x55, 0x41, 0x56])
        copy(buf, [0x49, 0x89, 0xFC, 0x48, 0x83, 0xEC, 0x40])
        emit_process_request_field(buf, "executable", 0, rd_offs, code_va)
        emit_process_request_field(buf, "args", 8, rd_offs, code_va)
        emit_process_request_field(buf, "cwd", 16, rd_offs, code_va)
        emit_process_request_field(buf, "stdin", 24, rd_offs, code_va)
        emit_process_request_field(buf, "timeout_ms", 32, rd_offs, code_va)
        emit_process_request_field(buf, "max_output_bytes", 40, rd_offs, code_va)
        emit_process_request_field(buf, "environment", 48, rd_offs, code_va)
        emit_process_request_field(buf, "inherit_env", 56, rd_offs, code_va)
        copy(buf, [0x48, 0x89, 0xE7])
        call_rel32(buf, atomic_vas["process_spawn_argv"], code_va)
        copy(buf, [0x49, 0x89, 0xC5, 0x48, 0x83, 0xC4, 0x40])
        call_rel32(buf, RT_MAP_NEW(), code_va)
        copy(buf, [0x49, 0x89, 0xC6])

        emit_push_const(buf, "norscode-process-spawn-v1", rd_offs, code_va)
        legg_til(buf, 0x58)
        emit_process_result_set(buf, "abi", rd_offs, code_va)

        // statuskode: 0 ferdig, 1 timeout, 2 output-limit, 3 signal, 4 feil.
        copy(buf, [0x49, 0x83, 0x7D, 0x00, 0x00])
        la process_status_timeout = emit_jne_placeholder(buf)
        emit_push_const(buf, "ferdig", rd_offs, code_va)
        la process_status_done = emit_jmp_placeholder(buf)
        la process_status_timeout_label = lengde(buf)
        copy(buf, [0x49, 0x83, 0x7D, 0x00, 0x01])
        la process_status_limit = emit_jne_placeholder(buf)
        emit_push_const(buf, "timeout", rd_offs, code_va)
        la process_status_done_2 = emit_jmp_placeholder(buf)
        la process_status_limit_label = lengde(buf)
        copy(buf, [0x49, 0x83, 0x7D, 0x00, 0x02])
        la process_status_signal = emit_jne_placeholder(buf)
        emit_push_const(buf, "feil", rd_offs, code_va)
        la process_status_done_3 = emit_jmp_placeholder(buf)
        la process_status_signal_label = lengde(buf)
        copy(buf, [0x49, 0x83, 0x7D, 0x00, 0x03])
        la process_status_error = emit_jne_placeholder(buf)
        emit_push_const(buf, "signal", rd_offs, code_va)
        la process_status_done_4 = emit_jmp_placeholder(buf)
        la process_status_error_label = lengde(buf)
        emit_push_const(buf, "feil", rd_offs, code_va)
        la process_status_selected = lengde(buf)
        patch_jump(buf, process_status_timeout, process_status_timeout_label)
        patch_jump(buf, process_status_limit, process_status_limit_label)
        patch_jump(buf, process_status_signal, process_status_signal_label)
        patch_jump(buf, process_status_error, process_status_error_label)
        patch_jump(buf, process_status_done, process_status_selected)
        patch_jump(buf, process_status_done_2, process_status_selected)
        patch_jump(buf, process_status_done_3, process_status_selected)
        patch_jump(buf, process_status_done_4, process_status_selected)
        legg_til(buf, 0x58)
        emit_process_result_set(buf, "status", rd_offs, code_va)

        emit_process_raw_number_text(buf, 8, code_va)
        emit_process_result_set(buf, "pid", rd_offs, code_va)
        emit_process_raw_number_text(buf, 16, code_va)
        emit_process_result_set(buf, "exit_code", rd_offs, code_va)
        copy(buf, [0x49, 0x8B, 0x7D, 0x18, 0x49, 0x8B, 0x75, 0x20])
        call_rel32(buf, RT_STR_RAW(), code_va)
        emit_process_result_set(buf, "stdout", rd_offs, code_va)
        copy(buf, [0x49, 0x8B, 0x7D, 0x28, 0x49, 0x8B, 0x75, 0x30])
        call_rel32(buf, RT_STR_RAW(), code_va)
        emit_process_result_set(buf, "stderr", rd_offs, code_va)

        copy(buf, [0x49, 0x83, 0x7D, 0x38, 0x01])
        la process_error_spawn = emit_jne_placeholder(buf)
        emit_push_const(buf, "output limit", rd_offs, code_va)
        la process_error_done = emit_jmp_placeholder(buf)
        la process_error_spawn_label = lengde(buf)
        copy(buf, [0x49, 0x83, 0x7D, 0x38, 0x02])
        la process_error_empty = emit_jne_placeholder(buf)
        emit_push_const(buf, "process spawn failed", rd_offs, code_va)
        la process_error_done_2 = emit_jmp_placeholder(buf)
        la process_error_empty_label = lengde(buf)
        emit_push_const(buf, "", rd_offs, code_va)
        la process_error_selected = lengde(buf)
        patch_jump(buf, process_error_spawn, process_error_spawn_label)
        patch_jump(buf, process_error_empty, process_error_empty_label)
        patch_jump(buf, process_error_done, process_error_selected)
        patch_jump(buf, process_error_done_2, process_error_selected)
        legg_til(buf, 0x58)
        emit_process_result_set(buf, "error", rd_offs, code_va)

        emit_process_raw_number_text(buf, 64, code_va)
        emit_process_result_set(buf, "wall_ms", rd_offs, code_va)
        emit_process_raw_number_text(buf, 72, code_va)
        emit_process_result_set(buf, "peak_rss_bytes", rd_offs, code_va)
        copy(buf, [0x4C, 0x89, 0xF0, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x50])
        returner
    }
    hvis fn_nm == "builtin.atomic_operation" {
        // Den breie stdlib-en sonderer denne valfrie native-backenden og
        // fell tilbake til VM-seq-cst når status ikkje er "ok".
        la ao_i: heltall = 0
        mens ao_i < nargs {
            legg_til(buf, 0x58)
            ao_i = ao_i + 1
        }
        emit_push_const(buf, "status", rd_offs, code_va)
        emit_push_const(buf, "unsupported", rd_offs, code_va)
        legg_til(buf, 0x48)
        legg_til(buf, 0x89)
        legg_til(buf, 0xE7)
        legg_til(buf, 0x48)
        legg_til(buf, 0xBE)
        u64(buf, 1)
        call_rel32(buf, RT_BUILD_MAP_REV(), code_va)
        legg_til(buf, 0x48)
        legg_til(buf, 0x81)
        legg_til(buf, 0xC4)
        u32(buf, 16)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.argv_list_v1" {
        la argv_list_i: heiltall = 0
        mens argv_list_i < nargs {
            legg_til(buf, 0x58)
            argv_list_i = argv_list_i + 1
        }
        call_rel32(buf, atomic_vas["argv_list"], code_va)
        legg_til(buf, 0x50)
        returner
    }
    hvis fn_nm == "builtin.argv_operation" {
        la argv_i: heltall = 0
        mens argv_i < nargs {
            legg_til(buf, 0x58)
            argv_i = argv_i + 1
        }
        // Bygg resultatkartet eksplisitt. Den generiske reverse-stack-
        // byggjaren er rett for BUILD_MAP-bytecode, men gav ein ugyldig
        // listeverdi når argv-lista kom frå eit runtime-kall mellom konstante
        // nøkkel/verdi-par. r12/r13 held lista og kartet over runtime-kalla.
        copy(buf, [0x41, 0x54, 0x41, 0x55])
        call_rel32(buf, atomic_vas["argv_list"], code_va)
        copy(buf, [0x49, 0x89, 0xC4])
        call_rel32(buf, RT_MAP_NEW(), code_va)
        copy(buf, [0x49, 0x89, 0xC5])

        emit_push_const(buf, "status", rd_offs, code_va)
        emit_push_const(buf, "ok", rd_offs, code_va)
        copy(buf, [0x5A, 0x5E, 0x4C, 0x89, 0xEF])
        call_rel32(buf, RT_MAP_SET(), code_va)

        emit_push_const(buf, "argv", rd_offs, code_va)
        copy(buf, [0x5E, 0x4C, 0x89, 0xE2, 0x4C, 0x89, 0xEF])
        call_rel32(buf, RT_MAP_SET(), code_va)

        copy(buf, [0x4C, 0x89, 0xE8, 0x41, 0x5D, 0x41, 0x5C])
        legg_til(buf, 0x50)
        returner
    }

    la rt_va = builtin_va(fn_nm, atomic_vas)
    hvis rt_va != 0 {
        hvis nargs == 0 {
            call_rel32(buf, rt_va, code_va)
            legg_til(buf, 0x50)
            returner
        }
        hvis nargs == 1 {
            emit_rt_call_1(buf, rt_va, code_va)
            returner
        }
        hvis nargs == 2 {
            emit_rt_call_2(buf, rt_va, code_va)
            returner
        }
        hvis nargs == 3 {
            emit_rt_call_3(buf, rt_va, code_va)
            returner
        }
        ellers {
            la ai: heltall = 0
            mens ai < nargs {
                legg_til(buf, 0x58)
                ai = ai + 1
            }
            call_rel32(buf, rt_va, code_va)
            legg_til(buf, 0x50)
            returner
        }
    }

    // Gap-ruting: builtin utan eiga native rutine → bundla rein-Norscode-impl.
    // Køyr FØR siste-segment-matchinga slik at builtin.sha256 ikkje bind seg
    // til std.krypto.sha256 (uendeleg rekursjon).
    la gap_kand = gap_rute_v2(fn_nm)
    hvis lengde(gap_kand) > 0 {
        la gap_va: heltall = 0
        la gi: heltall = 0
        mens gi < lengde(gap_kand) og gap_va == 0 {
            hvis finnes_nøkkel(fn_vas, gap_kand[gi]) { gap_va = fn_vas[gap_kand[gi]] }
            gi = gi + 1
        }
        hvis gap_va != 0 {
            emit_user_call(buf, gap_va, nargs, code_va)
            returner
        }
    }

    // Brukarkall — finn VA frå fn_vas
    la fn_va: heltall = 0
    hvis finnes_nøkkel(fn_vas, fn_nm) { fn_va = fn_vas[fn_nm] }
    ellers {
        // Prøv siste segment
        la last = builtin.split(fn_nm, ".")
        la last_nm = last[lengde(last) - 1]
        la nk = nøkler(fn_vas)
        la i: heltall = 0
        mens i < lengde(nk) og fn_va == 0 {
            la k = nk[i]
            la k_parts = builtin.split(k, ".")
            hvis k_parts[lengde(k_parts) - 1] == last_nm { fn_va = fn_vas[k] }
            i = i + 1
        }
    }
    hvis fn_va == 0 {
        // Ukjende kall må aldri bli rel32-kall til adresse 0. Det gav heng eller
        // segmentfeil i breie AOT-buntar (mellom anna valfri atomic backend).
        // Returner Norscode-null slik at frivillige backend-krokar kan bruke
        // den reine VM-fallbacken sin.
        la ui: heiltall = 0
        mens ui < nargs {
            legg_til(buf, 0x58)
            ui = ui + 1
        }
        legg_til(buf, 0x48)
        legg_til(buf, 0x31)
        legg_til(buf, 0xC0)  // xor rax, rax = Norscode-null (rå NULL for VM-fallback-krok)
        legg_til(buf, 0x50)
        returner
    }
    emit_user_call(buf, fn_va, nargs, code_va)
}

// ─── Hovud-kompilator v2 ─────────────────────────────────────────────────────
funksjon kompiler_v2(ncb_json) {
    native_codegen_trace("parse start")
    la ncb = json_parse_raw(ncb_json)
    la fns = ncb["functions"]
    native_codegen_trace("parse ferdig funksjonar=" + tekst_fra_heltall(lengde(nøkler(fns))))

    // Reserver éin deterministisk 8-byte peikarslot per modulglobal i resten
    // av den skrivebare host-ABI-sida. Dei første 16 byta er argv**/argc.
    // Segmentet har 4096 byte minnestorleik og blir nullfylt av ELF-lasteren.
    la global_vas: ordbok = {}
    la global_slot_count: heiltall = 0
    la global_metadata = ncb["global_names"]
    hvis global_metadata != null {
        la global_modules = nøkler(global_metadata)
        la gmi: heiltall = 0
        mens gmi < lengde(global_modules) {
            la global_module: tekst = tekst(global_modules[gmi])
            la module_globals = global_metadata[global_module]
            la gni: heiltall = 0
            mens gni < lengde(module_globals) {
                la global_key = global_module + "." + tekst(module_globals[gni])
                hvis ikkje finnes_nøkkel(global_vas, global_key) {
                    hvis global_slot_count >= 510 {
                        kast "native codegen: host-ABI globalslotar er fulle"
                    }
                    global_vas[global_key] = HOST_ABI_VA() + 16 + global_slot_count * 8
                    global_slot_count = global_slot_count + 1
                }
                gni = gni + 1
            }
            gmi = gmi + 1
        }
    }
    native_codegen_trace("modulglobalar=" + tekst_fra_heltall(global_slot_count))

    la strenger = samle_strenger(fns)
    native_codegen_trace("strenger samla=" + tekst_fra_heltall(lengde(strenger)))
    la data_res = bygg_data(strenger)
    la data_bytes = data_res[0]
    la rd_offs = data_res[1]
    // Rå vertspekere skal ikkje dele den 64-byte heap-kontrollblokka med GC.
    la argv_store_va: heiltall = HOST_ABI_VA()
    // Runtimeen les envp frå kontrollslotten på HEAP_VA+8.
    // _start må lagre til same adresse før første miljo_hent().
    la envp_store_va: heltall = HEAP_VA() + ENVP_OFFSET()

    la rt_package = bygg_runtime_v2(argv_store_va)
    la rt = rt_package[0]
    la atomic_vas = rt_package[1]
    la rt_size: heltall = lengde(rt)
    la gc_safepoint_va: heltall = TEXT_VA() + rt_size - GC_SAFEPOINT_STUB_BYTES()
    native_codegen_trace("runtime bygd bytes=" + tekst_fra_heltall(rt_size))

    // Finn entry: NCB entry-felt, deretter __main__.start / *.start
    la fn_list = nøkler(fns)
    la sorted: liste = []
    la start_fn: tekst = ""
    la entry_felt = ncb["entry"]
    hvis entry_felt != "" og finnes_nøkkel(fns, entry_felt)
        start_fn = entry_felt
    slutt
    hvis start_fn == ""
        la si: heltall = 0
        mens si < lengde(fn_list)
            la fn: tekst = fn_list[si]
            la er_start: boolsk = fn == "__main__.start" eller builtin.ends_with(fn, ".start")
            hvis er_start
                start_fn = fn
            slutt
            hvis fn != start_fn
                legg_til(sorted, fn)
            slutt
            si = si + 1
        slutt
    ellers
        la si: heltall = 0
        mens si < lengde(fn_list)
            la fn: tekst = fn_list[si]
            hvis fn != start_fn
                legg_til(sorted, fn)
            slutt
            si = si + 1
        slutt
    slutt
    hvis start_fn == ""
        start_fn = "__main__.start"
    slutt
    legg_til(sorted, start_fn)
    native_codegen_trace("funksjonsrekkje ferdig=" + tekst_fra_heltall(lengde(sorted)))

    // NCB-modular kan ha toppnivåtilstand som er materialisert i eigne
    // __module_init__-funksjonar. VM-bana køyrer desse før entry; den native
    // Linux-bana må ha nøyaktig same oppstartskontrakt. Filtrer metadata mot
    // den faktiske funksjonsgrafen, slik at eit utdatert metadatafelt aldri
    // blir til eit rel32-kall mot adresse 0.
    la module_initializers: liste = []
    la initializer_metadata = ncb["module_initializers"]
    hvis initializer_metadata != null {
        la init_i: heiltall = 0
        mens init_i < lengde(initializer_metadata) {
            la init_namn: tekst = tekst(initializer_metadata[init_i])
            hvis finnes_nøkkel(fns, init_namn) {
                legg_til(module_initializers, init_namn)
            }
            init_i = init_i + 1
        }
    }
    native_codegen_trace("modulinitialisatorar=" +
                         tekst_fra_heltall(lengde(module_initializers)))

    // Pass 1a: lag eit komplett, mellombels VA-kart. Rel32-kall har fast
    // storleik, så kartet kan brukast til å måle eksakt funksjonsstorleik.
    la fn_vas: ordbok = {}
    la curr_off: heltall = rt_size

    la fi2: heltall = 0
    mens fi2 < lengde(sorted)
        la fn: tekst = sorted[fi2]
        fn_vas[fn] = TEXT_VA() + curr_off
        la fn_def = fns[fn]
        la est: heltall = 300 + lengde(fn_def["code"]) * 80
        curr_off = curr_off + est
        fi2 = fi2 + 1
    slutt

    // Pass 1b: kompilér til målebuffer og bygg eksakte adresser. Den gamle
    // løypa oppdaterte adressene medan ho emitterte og gav dermed feil rel32
    // for kall framover i funksjonslista.
    la fn_sizes: ordbok = {}
    fi2 = 0
    mens fi2 < lengde(sorted) {
        hvis fi2 % 100 == 0 { native_codegen_trace("målepass funksjon=" + tekst_fra_heltall(fi2)) }
        la m_fn: tekst = sorted[fi2]
        // Funksjonsnamnet er alltid med i opt-in-sporet. Dette gjer eit krasj
        // i ein stor full-host-graf direkte reduserbart til éi NCB-funksjon.
        native_codegen_trace("målepass start=" + tekst_fra_heltall(fi2) + " namn=" + m_fn)
        la m_def = fns[m_fn]
        la m_vars = samle_vars(m_def["code"], m_def["params"])
        hvis fi2 < 100 { native_codegen_trace("målepass vars=" + tekst_fra_heltall(fi2)) }
        la m_code = kompiler_fn_v2(m_def, m_vars, fn_vas, rd_offs,
            fn_vas[m_fn], gc_safepoint_va, atomic_vas, global_vas)
        hvis fi2 < 100 { native_codegen_trace("målepass kode=" + tekst_fra_heltall(fi2)) }
        fn_sizes[m_fn] = lengde(m_code)
        fi2 = fi2 + 1
    }

    curr_off = rt_size
    fi2 = 0
    mens fi2 < lengde(sorted) {
        la e_fn: tekst = sorted[fi2]
        fn_vas[e_fn] = TEXT_VA() + curr_off
        curr_off = curr_off + fn_sizes[e_fn]
        fi2 = fi2 + 1
    }

    // Valfri symboloversikt for feilsøking av sjølvstendige binærar. ELF-en
    // er med vilje utan eksterne symboltabellar, så kartet blir berre skrive
    // når byggaren uttrykkeleg ber om det.
    la symbol_map_sti = miljo_hent("NC_NATIVE_SYMBOL_MAP")
    hvis symbol_map_sti != "" {
        la symbol_map: tekst = ""
        fi2 = 0
        mens fi2 < lengde(sorted) {
            la s_fn: tekst = sorted[fi2]
            la s_start: heltall = fn_vas[s_fn]
            la s_end: heltall = s_start + fn_sizes[s_fn]
            symbol_map = symbol_map + tekst_fra_heltall(s_start) + "\t" + tekst_fra_heltall(s_end) + "\t" + s_fn + "\n"
            fi2 = fi2 + 1
        }
        fil_skriv(symbol_map_sti, symbol_map)
    }

    // Pass 2: kompilér kvar funksjon med endelege rel32-adresser.
    la text: liste = []
    copy(text, rt)

    la fi3: heltall = 0
    mens fi3 < lengde(sorted)
        hvis fi3 % 100 == 0 { native_codegen_trace("emitpass funksjon=" + tekst_fra_heltall(fi3)) }
        la fn: tekst = sorted[fi3]
        la fn_def2 = fns[fn]
        la fn_vars = samle_vars(fn_def2["code"], fn_def2["params"])
        la fn_code = kompiler_fn_v2(fn_def2, fn_vars, fn_vas, rd_offs,
            TEXT_VA() + lengde(text), gc_safepoint_va, atomic_vas, global_vas)
        copy(text, fn_code)
        fi3 = fi3 + 1
    slutt
    native_codegen_trace("emitpass ferdig bytes=" + tekst_fra_heltall(lengde(text)))
    native_codegen_trace("post-emit start-prolog")

    // _start: capture envp, init heap, call main, exit(0)
    la entry_va: heltall = TEXT_VA() + lengde(text)

    // On Linux _start entry: rsp → argc, rsp+8 → argv[0], ..., NULL, envp[0], ...
    // Kopier original rsp til r12 for lesing, og align den faktiske stacken før
    // første call inn i runtime.
    // mov r12, rsp
    legg_til(text, 0x49)
    legg_til(text, 0x89)
    legg_til(text, 0xE4)
    // GC F3 rot-skann: lagra initiell rsp (stakk-base, høg adresse) i kontrollblokk-
    // slot HEAP_VA+48. stack_base() les denne som øvre grense for rot-skann.
    legg_til(text, 0x4C)              // mov [moffs32], r12
    legg_til(text, 0x89)
    legg_til(text, 0x24)
    legg_til(text, 0x25)
    u32(text, HEAP_VA() + 48)
    // mov rdi, [r12] = argc
    legg_til(text, 0x49)
    legg_til(text, 0x8B)
    legg_til(text, 0x3C)
    legg_til(text, 0x24)
    // lea rsi, [r12+8] → argv
    legg_til(text, 0x49)
    legg_til(text, 0x8D)
    legg_til(text, 0x74)
    legg_til(text, 0x24)
    legg_til(text, 0x08)
    // Store {argv**, argc} i den reserverte verts-ABI-sida.
    legg_til(text, 0x49)
    legg_til(text, 0xBB)
    u64(text, argv_store_va)
    legg_til(text, 0x49)
    legg_til(text, 0x89)
    legg_til(text, 0x33)
    legg_til(text, 0x49)
    legg_til(text, 0x89)
    legg_til(text, 0x7B)
    legg_til(text, 0x08)
    // Skip argv: lea rdx, [r12 + rdi*8] + 16 → envp
    // lea rdx, [r12 + rdi*8]
    legg_til(text, 0x49)
    legg_til(text, 0x8D)
    legg_til(text, 0x14)
    legg_til(text, 0xFC)  // lea rdx, [r12+rdi*8]
    legg_til(text, 0x48)
    legg_til(text, 0x83)
    legg_til(text, 0xC2)
    legg_til(text, 0x10)   // add rdx, 16
    // Store envp i ein ekte skrivebar .data-slot.
    // mov r11, envp_store_va
    legg_til(text, 0x49)
    legg_til(text, 0xBB)
    u64(text, envp_store_va)
    // mov [r11], rdx
    legg_til(text, 0x49)
    legg_til(text, 0x89)
    legg_til(text, 0x13)
    // and rsp, -16
    legg_til(text, 0x48)
    legg_til(text, 0x83)
    legg_til(text, 0xE4)
    legg_til(text, 0xF0)
    // code_va for call_rel32 MÅ vera VA for buf[0] = TEXT_VA(), ikkje entry_va
    // Call rt_init_heap (no args)
    call_rel32(text, RT_INIT_HEAP(), TEXT_VA())

    // Køyr modulinitialisatorane i den deterministiske rekkjefølgja frå
    // NCB-metadata før hovud-entry. Returverdien ligg i rax og blir med vilje
    // overskriven av neste kall; initialisatorane tek ingen argument.
    la entry_init_i: heiltall = 0
    mens entry_init_i < lengde(module_initializers) {
        la entry_init_namn: tekst = module_initializers[entry_init_i]
        la entry_init_va: heiltall = fn_vas[entry_init_namn]
        call_rel32(text, entry_init_va, TEXT_VA())
        entry_init_i = entry_init_i + 1
    }

    // Call start()
    la main_va: heltall = fn_vas[start_fn]
    hvis main_va == 0 {
        // Feilbar tryggleik: kunne ikkje slå opp start-funksjon.
        // I staden for call til 0 (kan gi illegal instruction), avslutt
        // med avgrensa feilstatus.
        legg_til(text, 0x48)
        legg_til(text, 0xC7)
        legg_til(text, 0xC0)
        u32(text, 60)   // mov rax, 60
        legg_til(text, 0x48)
        legg_til(text, 0xC7)
        legg_til(text, 0xC7)
        u32(text, 4)    // mov rdi, 4
        legg_til(text, 0x0F)
        legg_til(text, 0x05)  // syscall
    }
    call_rel32(text, main_va, TEXT_VA())

    // sys_exit(start-returverdien): AOT-program skal ha same prosesskontrakt
    // som VM-løypa, også når returverdien kjem frå kart-/tekst-runtime.
    legg_til(text, 0x31)
    legg_til(text, 0xFF)  // default exit 0 for null
    legg_til(text, 0x48)
    legg_til(text, 0x85)
    legg_til(text, 0xC0)  // test rax,rax
    legg_til(text, 0x74)
    legg_til(text, 0x04)  // skip payload load for null
    legg_til(text, 0x48)
    legg_til(text, 0x8B)
    legg_til(text, 0x78)
    legg_til(text, 0x08)  // mov rdi,[rax+8]
    legg_til(text, 0x48)
    legg_til(text, 0xC7)
    legg_til(text, 0xC0)
    u32(text, 60) // mov rax, 60
    legg_til(text, 0x0F)
    legg_til(text, 0x05)  // syscall
    native_codegen_trace("post-emit start-prolog ferdig")

    la text_size: heltall = lengde(text)
    la data_size: heltall = lengde(data_bytes)
    hvis TEXT_VA() + text_size > DATA_VA() {
        kast "native codegen: .text overlappar .data"
    }
    hvis DATA_VA() + data_size > HEAP_VA() {
        kast "native codegen: .data overlappar .heap"
    }
    hvis DATA_VA() + data_size > HOST_ABI_VA() {
        kast "native codegen: .data overlappar verts-ABI-segmentet"
    }
    hvis HOST_ABI_VA() + 4096 > HEAP_VA() {
        kast "native codegen: verts-ABI-segmentet overlappar .heap"
    }
    native_codegen_trace("post-emit segmentgrenser ferdig")

    // Bygg ELF64 med fire segment: RX text, R constants, RW host ABI og RW heap.
    la elf: liste = []
    la ph_off: heltall = 64
    la text_file_off: heltall = 4096
    la text_segment_va: heltall = TEXT_VA() - text_file_off
    la data_file_off: heltall = ((text_file_off + text_size + 4095) / 4096) * 4096
    la host_file_off: heiltall = ((data_file_off + data_size + 4095) / 4096) * 4096
    la heap_file_off: heiltall = host_file_off + 4096
    la heap_filesz: heiltall = HEAP_CONTROLSZ()

    // ELF header
    u8(elf, 0x7F)
    u8(elf, 0x45)
    u8(elf, 0x4C)
    u8(elf, 0x46)
    u8(elf, 2)
    u8(elf, 1)
    u8(elf, 1)
    u8(elf, 0)
    zeros(elf, 8)
    u16(elf, 2)
    u16(elf, 62)
    u32(elf, 1)
    u64(elf, entry_va)
    u64(elf, ph_off)
    u64(elf, 0)
    u32(elf, 0)
    u16(elf, 64)
    u16(elf, 56)
    u16(elf, 4)
    u16(elf, 64)
    u16(elf, 0)
    u16(elf, 0)

    // PH .text (RX)
    u32(elf, 1)
    u32(elf, 5)
    u64(elf, 0)
    u64(elf, text_segment_va)
    u64(elf, text_segment_va)
    u64(elf, text_file_off + text_size)
    u64(elf, text_file_off + text_size)
    u64(elf, 4096)

    // PH .data (R)
    u32(elf, 1)
    u32(elf, 4)
    u64(elf, data_file_off)
    u64(elf, DATA_VA())
    u64(elf, DATA_VA())
    u64(elf, data_size)
    u64(elf, data_size)
    u64(elf, 4096)

    // PH .hostabi (RW — éi side, argv** og argc i dei to første slotane)
    u32(elf, 1)
    u32(elf, 6)
    u64(elf, host_file_off)
    u64(elf, HOST_ABI_VA())
    u64(elf, HOST_ABI_VA())
    u64(elf, 16)
    u64(elf, 4096)
    u64(elf, 4096)

    // PH .heap (RW — 64MB)
    u32(elf, 1)
    u32(elf, 6)
    u64(elf, heap_file_off)
    u64(elf, HEAP_VA())
    u64(elf, HEAP_VA())
    u64(elf, heap_filesz)
    u64(elf, HEAP_SZ())
    u64(elf, 4096)
    native_codegen_trace("post-emit elf-hovud ferdig")

    pad(elf, text_file_off)
    copy(elf, text)
    native_codegen_trace("post-emit text kopiert")
    pad(elf, data_file_off)
    copy(elf, data_bytes)
    native_codegen_trace("post-emit data kopiert")
    pad(elf, host_file_off)
    zeros(elf, 16)
    pad(elf, heap_file_off)
    zeros(elf, heap_filesz)
    native_codegen_trace("post-emit segmentkopi ferdig")

    // Full-host-bygg kan la den Norscode-eigde orkestratoren strøyme
    // payloaden etter at ELF-bufferen er skriven. Det held den store NCB-en
    // utanfor den monotone prototypeheapen; standardkall bevarer same API.
    hvis miljo_hent("NC_NATIVE_EXTERNAL_EMBED_NCB") != "1" {
        legg_innebygd_ncb(elf, ncb_json)
        native_codegen_trace("post-emit ncb innebygd")
    } ellers {
        native_codegen_trace("post-emit ncb delegert til byggorkestrator")
    }

    returner elf
}

// ─── Batch-codegen for x86_64 (låg-minne, prosess-isolerte fasar) ─────────────
// Speglar kompiler_v2 sin 2-pass (mål + emit), men splitta i batchar slik at
// toppminnet held seg på ~éin batch i staden for ~11 GB for heile programmet i
// eitt kall. Kvar fase rekomputerer det DETERMINISTISKE oppsettet (global_vas,
// data, rt, sorted, module_initializers) frå NCB-en; det einaste som kryssar
// fase-grensa er `sizes` (funksjonsnamn→byte-storleik) frå målebarrieren.
// Storleik er posisjons-uavhengig (call rel32 er alltid 5 byte), så målepasset
// kan bruke placeholder-adresser og likevel gje eksakte storleikar — nøyaktig
// same invariant som kompiler_v2 sitt Pass 1b→Pass 2 alt kviler på.

// Rekomputer alt oppsettet unntatt fn_vas. Returnerer ei ordbok med delane.
funksjon ncval_x86_setup(ncb) {
    la fns = ncb["functions"]

    la global_vas: ordbok = {}
    la global_slot_count: heiltall = 0
    la global_metadata = ncb["global_names"]
    hvis global_metadata != null {
        la global_modules = nøkler(global_metadata)
        la gmi: heiltall = 0
        mens gmi < lengde(global_modules) {
            la global_module: tekst = tekst(global_modules[gmi])
            la module_globals = global_metadata[global_module]
            la gni: heiltall = 0
            mens gni < lengde(module_globals) {
                la global_key = global_module + "." + tekst(module_globals[gni])
                hvis ikkje finnes_nøkkel(global_vas, global_key) {
                    hvis global_slot_count >= 510 {
                        kast "native codegen: host-ABI globalslotar er fulle"
                    }
                    global_vas[global_key] = HOST_ABI_VA() + 16 + global_slot_count * 8
                    global_slot_count = global_slot_count + 1
                }
                gni = gni + 1
            }
            gmi = gmi + 1
        }
    }

    la strenger = samle_strenger(fns)
    la data_res = bygg_data(strenger)
    la data_bytes = data_res[0]
    la rd_offs = data_res[1]
    la argv_store_va: heiltall = HOST_ABI_VA()
    la rt_package = bygg_runtime_v2(argv_store_va)
    la rt = rt_package[0]
    la atomic_vas = rt_package[1]
    la rt_size: heltall = lengde(rt)
    la gc_safepoint_va: heltall = TEXT_VA() + rt_size - GC_SAFEPOINT_STUB_BYTES()

    la fn_list = nøkler(fns)
    la sorted: liste = []
    la start_fn: tekst = ""
    la entry_felt = ncb["entry"]
    hvis entry_felt != "" og finnes_nøkkel(fns, entry_felt)
        start_fn = entry_felt
    slutt
    hvis start_fn == ""
        la si: heltall = 0
        mens si < lengde(fn_list)
            la fn: tekst = fn_list[si]
            la er_start: boolsk = fn == "__main__.start" eller builtin.ends_with(fn, ".start")
            hvis er_start
                start_fn = fn
            slutt
            hvis fn != start_fn
                legg_til(sorted, fn)
            slutt
            si = si + 1
        slutt
    ellers
        la si: heltall = 0
        mens si < lengde(fn_list)
            la fn: tekst = fn_list[si]
            hvis fn != start_fn
                legg_til(sorted, fn)
            slutt
            si = si + 1
        slutt
    slutt
    hvis start_fn == ""
        start_fn = "__main__.start"
    slutt
    legg_til(sorted, start_fn)

    la module_initializers: liste = []
    la initializer_metadata = ncb["module_initializers"]
    hvis initializer_metadata != null {
        la init_i: heiltall = 0
        mens init_i < lengde(initializer_metadata) {
            la init_namn: tekst = tekst(initializer_metadata[init_i])
            hvis finnes_nøkkel(fns, init_namn) {
                legg_til(module_initializers, init_namn)
            }
            init_i = init_i + 1
        }
    }

    returner {
        "fns": fns, "global_vas": global_vas, "data_bytes": data_bytes,
        "rd_offs": rd_offs, "rt": rt, "atomic_vas": atomic_vas,
        "gc_safepoint_va": gc_safepoint_va, "rt_size": rt_size,
        "sorted": sorted, "start_fn": start_fn,
        "module_initializers": module_initializers
    }
}

// Plan: returner funksjonsrekkja (order) slik orkestratoren kjenner totalen og
// batch-grensene. Deterministisk og lett å serialisere.
funksjon ncval_x86_plan(ncb) -> ordbok_tekst {
    la oppsett = ncval_x86_setup(ncb)
    returner {"ok": "sann", "error": "", "order": oppsett["sorted"]}
}

// Eksakt fn_vas-kart frå sizes (namn→storleik). Speglar kompiler_v2 sitt andre
// VA-oppsett: TEXT_VA + rt_size + kumulativ storleik i sorted-rekkjefølgje.
funksjon ncval_x86_fn_vas(oppsett, sizes) -> ordbok {
    la sorted = oppsett["sorted"]
    la fn_vas: ordbok = {}
    la off: heltall = oppsett["rt_size"]
    la i: heltall = 0
    mens i < lengde(sorted) {
        la fn: tekst = sorted[i]
        fn_vas[fn] = TEXT_VA() + off
        off = off + sizes[fn]
        i = i + 1
    }
    returner fn_vas
}

// Målepass for utsnittet [start, start+count): kompiler kvar funksjon med
// placeholder-adresser og returner byte-storleiken. Storleik er uavhengig av
// adressane, så placeholder er trygt.
funksjon ncval_x86_measure(ncb, start: heiltall, count: heiltall) -> ordbok_tekst {
    returner ncval_x86_measure_with(ncval_x86_setup(ncb), start, count)
}
funksjon ncval_x86_measure_with(oppsett, start: heiltall, count: heiltall) -> ordbok_tekst {
    la fns = oppsett["fns"]
    la sorted = oppsett["sorted"]
    la rd_offs = oppsett["rd_offs"]
    la atomic_vas = oppsett["atomic_vas"]
    la global_vas = oppsett["global_vas"]
    la gc_safepoint_va = oppsett["gc_safepoint_va"]
    la placeholder: ordbok = {}
    la pi: heltall = 0
    mens pi < lengde(sorted) { placeholder[sorted[pi]] = TEXT_VA() pi = pi + 1 }
    la sizes: ordbok = {}
    la slutt = start + count
    hvis slutt > lengde(sorted) { slutt = lengde(sorted) }
    la fi: heltall = start
    mens fi < slutt {
        la fn: tekst = sorted[fi]
        la fn_def = fns[fn]
        la fn_vars = samle_vars(fn_def["code"], fn_def["params"])
        la fn_code = kompiler_fn_v2(fn_def, fn_vars, placeholder, rd_offs,
            TEXT_VA(), gc_safepoint_va, atomic_vas, global_vas)
        sizes[fn] = lengde(fn_code)
        fi = fi + 1
    }
    returner {"ok": "sann", "error": "", "sizes": sizes}
}

// Emitpass for utsnittet [start, start+count): kompiler kvar funksjon med
// EKSAKTE adressar (frå sizes) og returner den konkatenerte byte-lista for
// utsnittet. Byta blir plasserte i order-rekkjefølgje av linkaren.
funksjon ncval_x86_emit(ncb, sizes, start: heiltall, count: heiltall) -> ordbok_tekst {
    returner ncval_x86_emit_with(ncval_x86_setup(ncb), sizes, start, count)
}
funksjon ncval_x86_emit_with(oppsett, sizes, start: heiltall, count: heiltall) -> ordbok_tekst {
    la fns = oppsett["fns"]
    la sorted = oppsett["sorted"]
    la rd_offs = oppsett["rd_offs"]
    la atomic_vas = oppsett["atomic_vas"]
    la global_vas = oppsett["global_vas"]
    la gc_safepoint_va = oppsett["gc_safepoint_va"]
    la fn_vas = ncval_x86_fn_vas(oppsett, sizes)
    la bytes: liste = []
    la slutt = start + count
    hvis slutt > lengde(sorted) { slutt = lengde(sorted) }
    la fi: heltall = start
    mens fi < slutt {
        la fn: tekst = sorted[fi]
        la fn_def = fns[fn]
        la fn_vars = samle_vars(fn_def["code"], fn_def["params"])
        // eiga_va = den endelege VA-en for denne funksjonen (= fn_vas[fn]).
        la fn_code = kompiler_fn_v2(fn_def, fn_vars, fn_vas, rd_offs,
            fn_vas[fn], gc_safepoint_va, atomic_vas, global_vas)
        copy(bytes, fn_code)
        fi = fi + 1
    }
    returner {"ok": "sann", "error": "", "bytes": bytes}
}

// Link: bygg det ferdige ELF-biletet frå rt + emit-fragmenta (i order) + _start-
// prologen + datasegmentet, og bygg inn NCB-en. `frag_byte_lists` er emit-utsnitta
// i rekkjefølgje. Held berre biletet (~få MB) + NCB — lett nok for éin prosess.
funksjon ncval_x86_link(ncb_json, ncb, sizes, frag_byte_lists) -> ordbok_tekst {
    returner ncval_x86_link_with(ncb_json, ncval_x86_setup(ncb), sizes, frag_byte_lists)
}
funksjon ncval_x86_link_with(ncb_json, oppsett, sizes, frag_byte_lists) -> ordbok_tekst {
    la data_bytes = oppsett["data_bytes"]
    la rt = oppsett["rt"]
    la module_initializers = oppsett["module_initializers"]
    la start_fn = oppsett["start_fn"]
    la fn_vas = ncval_x86_fn_vas(oppsett, sizes)

    la argv_store_va: heiltall = HOST_ABI_VA()
    la envp_store_va: heltall = HEAP_VA() + ENVP_OFFSET()

    la text: liste = []
    copy(text, rt)
    la fbi: heltall = 0
    mens fbi < lengde(frag_byte_lists) {
        copy(text, frag_byte_lists[fbi])
        fbi = fbi + 1
    }

    // _start-prolog — identisk med kompiler_v2 (fanga envp, init heap, køyr
    // modulinitialisatorar, kall start(), sys_exit med returverdien).
    la entry_va: heltall = TEXT_VA() + lengde(text)
    legg_til(text, 0x49) legg_til(text, 0x89) legg_til(text, 0xE4)          // mov r12, rsp
    legg_til(text, 0x49) legg_til(text, 0x8B) legg_til(text, 0x3C) legg_til(text, 0x24) // mov rdi,[r12]=argc
    legg_til(text, 0x49) legg_til(text, 0x8D) legg_til(text, 0x74) legg_til(text, 0x24) legg_til(text, 0x08) // lea rsi,[r12+8]
    legg_til(text, 0x49) legg_til(text, 0xBB) u64(text, argv_store_va)
    legg_til(text, 0x49) legg_til(text, 0x89) legg_til(text, 0x33)          // mov [r11],rsi
    legg_til(text, 0x49) legg_til(text, 0x89) legg_til(text, 0x7B) legg_til(text, 0x08) // mov [r11+8],rdi
    legg_til(text, 0x49) legg_til(text, 0x8D) legg_til(text, 0x14) legg_til(text, 0xFC) // lea rdx,[r12+rdi*8]
    legg_til(text, 0x48) legg_til(text, 0x83) legg_til(text, 0xC2) legg_til(text, 0x10) // add rdx,16
    legg_til(text, 0x49) legg_til(text, 0xBB) u64(text, envp_store_va)
    legg_til(text, 0x49) legg_til(text, 0x89) legg_til(text, 0x13)          // mov [r11],rdx
    legg_til(text, 0x48) legg_til(text, 0x83) legg_til(text, 0xE4) legg_til(text, 0xF0) // and rsp,-16
    call_rel32(text, RT_INIT_HEAP(), TEXT_VA())

    la entry_init_i: heiltall = 0
    mens entry_init_i < lengde(module_initializers) {
        la entry_init_namn: tekst = module_initializers[entry_init_i]
        call_rel32(text, fn_vas[entry_init_namn], TEXT_VA())
        entry_init_i = entry_init_i + 1
    }

    la main_va: heltall = fn_vas[start_fn]
    hvis main_va == 0 {
        legg_til(text, 0x48) legg_til(text, 0xC7) legg_til(text, 0xC0) u32(text, 60)
        legg_til(text, 0x48) legg_til(text, 0xC7) legg_til(text, 0xC7) u32(text, 4)
        legg_til(text, 0x0F) legg_til(text, 0x05)
    }
    call_rel32(text, main_va, TEXT_VA())

    legg_til(text, 0x31) legg_til(text, 0xFF)                               // xor edi,edi
    legg_til(text, 0x48) legg_til(text, 0x85) legg_til(text, 0xC0)          // test rax,rax
    legg_til(text, 0x74) legg_til(text, 0x04)                              // je +4
    legg_til(text, 0x48) legg_til(text, 0x8B) legg_til(text, 0x78) legg_til(text, 0x08) // mov rdi,[rax+8]
    legg_til(text, 0x48) legg_til(text, 0xC7) legg_til(text, 0xC0) u32(text, 60)
    legg_til(text, 0x0F) legg_til(text, 0x05)                              // syscall

    la text_size: heltall = lengde(text)
    la data_size: heltall = lengde(data_bytes)
    hvis TEXT_VA() + text_size > DATA_VA() { kast "native codegen: .text overlappar .data" }
    hvis DATA_VA() + data_size > HEAP_VA() { kast "native codegen: .data overlappar .heap" }
    hvis DATA_VA() + data_size > HOST_ABI_VA() { kast "native codegen: .data overlappar verts-ABI-segmentet" }
    hvis HOST_ABI_VA() + 4096 > HEAP_VA() { kast "native codegen: verts-ABI-segmentet overlappar .heap" }

    la elf: liste = []
    la ph_off: heltall = 64
    la text_file_off: heltall = 4096
    la text_segment_va: heltall = TEXT_VA() - text_file_off
    la data_file_off: heltall = ((text_file_off + text_size + 4095) / 4096) * 4096
    la host_file_off: heiltall = ((data_file_off + data_size + 4095) / 4096) * 4096
    la heap_file_off: heiltall = host_file_off + 4096
    la heap_filesz: heiltall = HEAP_CONTROLSZ()

    u8(elf, 0x7F) u8(elf, 0x45) u8(elf, 0x4C) u8(elf, 0x46)
    u8(elf, 2) u8(elf, 1) u8(elf, 1) u8(elf, 0)
    zeros(elf, 8)
    u16(elf, 2) u16(elf, 62) u32(elf, 1)
    u64(elf, entry_va) u64(elf, ph_off) u64(elf, 0)
    u32(elf, 0) u16(elf, 64) u16(elf, 56) u16(elf, 4) u16(elf, 64) u16(elf, 0) u16(elf, 0)

    u32(elf, 1) u32(elf, 5) u64(elf, 0)
    u64(elf, text_segment_va) u64(elf, text_segment_va)
    u64(elf, text_file_off + text_size) u64(elf, text_file_off + text_size) u64(elf, 4096)

    u32(elf, 1) u32(elf, 4) u64(elf, data_file_off)
    u64(elf, DATA_VA()) u64(elf, DATA_VA())
    u64(elf, data_size) u64(elf, data_size) u64(elf, 4096)

    u32(elf, 1) u32(elf, 6) u64(elf, host_file_off)
    u64(elf, HOST_ABI_VA()) u64(elf, HOST_ABI_VA())
    u64(elf, 16) u64(elf, 4096) u64(elf, 4096)

    u32(elf, 1) u32(elf, 6) u64(elf, heap_file_off)
    u64(elf, HEAP_VA()) u64(elf, HEAP_VA())
    u64(elf, heap_filesz) u64(elf, HEAP_SZ()) u64(elf, 4096)

    pad(elf, text_file_off)
    copy(elf, text)
    pad(elf, data_file_off)
    copy(elf, data_bytes)
    pad(elf, host_file_off)
    zeros(elf, 16)
    pad(elf, heap_file_off)
    zeros(elf, heap_filesz)

    hvis miljo_hent("NC_NATIVE_EXTERNAL_EMBED_NCB") != "1" {
        legg_innebygd_ncb(elf, ncb_json)
    }
    returner {"ok": "sann", "error": "", "elf": elf}
}

// ─── Inngangspunkt ───────────────────────────────────────────────────────────
funksjon start() {
    la inp = miljo_hent("NC_INPUT")
    la out = miljo_hent("NC_OUTPUT")
    hvis inp == ""
        skriv("native_codegen_v2: NC_INPUT=fil.ncb.json NC_OUTPUT=fil\n")
        returner 1
    slutt
    hvis out == "" { out = "a.out" }
    skriv("native_codegen_v2: " + inp + " → " + out + "\n")
    la ncb_json = fil_les(inp)
    la bytes = kompiler_v2(ncb_json)
    la payload_fil = miljo_hent("NC_EMBED_PAYLOAD_FILE")
    la payload_namn = miljo_hent("NC_EMBED_PAYLOAD_NAME")
    hvis payload_fil != "" {
        hvis payload_namn == "" { payload_namn = "program" }
        la payload = fil_les(payload_fil)
        legg_innebygd_named_ncb(bytes, payload_namn, payload)
    }
    native_codegen_trace("post-emit klar for filskriv")
    fil_skriv_binær(out, bytes)
    native_codegen_trace("post-emit filskriv ferdig")
    hvis miljo_hent("NC_NATIVE_EXTERNAL_EMBED_NCB") == "1" {
        skriv("native_codegen_v2: " + tekst_fra_heltall(lengde(bytes)) + " ELF-bytes (NCB-trailer delegert)\n")
    } ellers {
        skriv("native_codegen_v2: " + tekst_fra_heltall(lengde(bytes)) + " bytes (NCB innebygd)\n")
    }
    returner 0
slutt
}
