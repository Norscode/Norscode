    copy(bytes, [0x48, 0x81, 0xF9, 0x40, 0x00, 0x60, 0x00]) // cmp rcx,0x600040
    copy(bytes, [0x0F, 0x82])                      // jb loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x3B, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00]) // cmp rcx,[bump]
    copy(bytes, [0x0F, 0x83])                      // jae loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x49, 0x89, 0x0A])                // mov [r10],rcx (keys_ptr)
    copy(bytes, [0x4C, 0x8B, 0x46, 0x08])          // mov r8,[rsi+8] (cap)
    copy(bytes, [0x4C, 0x89, 0xC2])                // mov rdx,r8
    copy(bytes, [0x48, 0xC1, 0xE2, 0x03])          // shl rdx,3 (cap*8)
    copy(bytes, [0x49, 0x89, 0x52, 0x08])          // mov [r10+8],rdx
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    copy(bytes, [0x48, 0x89, 0xCA])                // mov rdx,rcx (cursor)
    la mrt_keyloop = lengde(bytes)                 // .keyloop:
    copy(bytes, [0x48, 0x85, 0xC0])                // test rax,rax
