    copy(bytes, [0x4D, 0x89, 0xD3])                // mov r11,r10
    copy(bytes, [0x49, 0xFF, 0xC3])                // inc r11 (j+1)
    copy(bytes, [0x49, 0xC1, 0xE3, 0x04])          // shl r11,4
    copy(bytes, [0x4B, 0x89, 0x04, 0x18])          // mov [r8+r11],rax (key.addr)
    copy(bytes, [0x4B, 0x89, 0x54, 0x18, 0x08])    // mov [r8+r11+8],rdx (key.size)
    copy(bytes, [0x48, 0xFF, 0xC1])                // inc rcx (i++)
    copy(bytes, [0xE9])                            // jmp outer
    u32(bytes, (srt_outer - (lengde(bytes) + 4)) & 4294967295)
    la srt_done = lengde(bytes)                    // done:
    patch_jump(bytes, srt_pdone, srt_done)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8 (rdi held n)
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box n → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC (iv): FULL-RANGE sweep — indre hol + HALEN [last_live_end, bump) ──────
    // gc_sweep_full(n) -> boksa tal frigjorde hol. Som gc_sweep_native (indre hol
    // mellom påfølgjande live objekt), PLUSS frigjer halen frå siste live-slutt til
    // bump. Krev SORTERT live-map. r8=lm-base, r9=prev_end, r11=freed, rcx=j, rdi=n.
    atomics["gc_sweep_full"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08])          // mov rdi,[rdi+8] (unbox n)
    copy(bytes, [0x41, 0xB8, 0x00, 0x00, 0x34, 0x10]) // mov r8d,0x10340000
    copy(bytes, [0x4D, 0x8B, 0x08])                // mov r9,[r8] (lm[0].addr)
    copy(bytes, [0x4D, 0x03, 0x48, 0x08])          // add r9,[r8+8] (prev_end)
    copy(bytes, [0x4D, 0x31, 0xDB])                // xor r11,r11 (freed=0)
    copy(bytes, [0x48, 0xC7, 0xC1, 0x01, 0x00, 0x00, 0x00]) // mov rcx,1 (j=1)
    la swf_loop = lengde(bytes)                    // .loop:
    copy(bytes, [0x48, 0x39, 0xF9])                // cmp rcx,rdi
    copy(bytes, [0x0F, 0x83])                      // jae done
    u32(bytes, 0)
    la swf_pdone = lengde(bytes) - 4
    copy(bytes, [0x48, 0x89, 0xC8])                // mov rax,rcx
    copy(bytes, [0x48, 0xC1, 0xE0, 0x04])          // shl rax,4
    copy(bytes, [0x4C, 0x01, 0xC0])                // add rax,r8 (&lm[j])
    copy(bytes, [0x48, 0x8B, 0x10])                // mov rdx,[rax] (lm[j].addr)
    // KRITISK: overlappande/nøsta live-entry (cur_addr <= prev_end) → gap ville underflyte
    // (rdx-r9 < 0 → HUGE unsigned → cmp,16/jb slår IKKJE til → frigjer bogus enorm region →
    // korrupsjon). Nøsta entryar er lovlege (liste-payload dekkjer inline-element, streng-
    // over-vern). Klamp: cur_addr <= prev_end → hopp (ingen hol).
    copy(bytes, [0x4C, 0x39, 0xCA])                // cmp rdx,r9
    copy(bytes, [0x0F, 0x86])                      // jbe skip
    u32(bytes, 0)
    la swf_pskip0 = lengde(bytes) - 4
    copy(bytes, [0x48, 0x89, 0xD6])                // mov rsi,rdx
    copy(bytes, [0x4C, 0x29, 0xCE])                // sub rsi,r9 (gap)
    copy(bytes, [0x48, 0x83, 0xFE, 0x10])          // cmp rsi,16
    copy(bytes, [0x0F, 0x82])                      // jb skip
    u32(bytes, 0)
    la swf_pskip = lengde(bytes) - 4
    copy(bytes, [0x48, 0x8B, 0x04, 0x25, 0x28, 0x00, 0x60, 0x00]) // mov rax,[head]
    copy(bytes, [0x49, 0x89, 0x01])                // mov [r9],rax (next)
    copy(bytes, [0x49, 0x89, 0x71, 0x08])          // mov [r9+8],rsi (size)
    copy(bytes, [0x4C, 0x89, 0x0C, 0x25, 0x28, 0x00, 0x60, 0x00]) // mov [head],r9
    copy(bytes, [0x49, 0xFF, 0xC3])                // inc r11 (freed)
    la swf_skip = lengde(bytes)                    // .skip:
    patch_jump(bytes, swf_pskip, swf_skip)
    patch_jump(bytes, swf_pskip0, swf_skip)
    copy(bytes, [0x48, 0x89, 0xC8])                // mov rax,rcx
    copy(bytes, [0x48, 0xC1, 0xE0, 0x04])          // shl rax,4
    copy(bytes, [0x4C, 0x01, 0xC0])                // add rax,r8
    copy(bytes, [0x48, 0x8B, 0x10])                // mov rdx,[rax] (addr)
    copy(bytes, [0x48, 0x03, 0x50, 0x08])          // add rdx,[rax+8] (end)
    copy(bytes, [0x4C, 0x39, 0xCA])                // cmp rdx,r9
    copy(bytes, [0x0F, 0x86])                      // jbe no_upd
    u32(bytes, 0)
    la swf_pnoupd = lengde(bytes) - 4
    copy(bytes, [0x49, 0x89, 0xD1])                // mov r9,rdx (prev_end=end)
    la swf_noupd = lengde(bytes)                   // .no_upd:
    patch_jump(bytes, swf_pnoupd, swf_noupd)
