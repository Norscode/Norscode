    copy(bytes, [0x0F, 0x83])                      // jae scan_done
    u32(bytes, 0)
    la mrt_pscandone = lengde(bytes) - 4
    copy(bytes, [0x48, 0x8B, 0x06])                // mov rax,[rsi]
    copy(bytes, [0x48, 0x3D, 0x40, 0x00, 0x60, 0x00]) // cmp rax,0x600040 (over kontrollblokk)
    copy(bytes, [0x0F, 0x82])                      // jb scan_next
