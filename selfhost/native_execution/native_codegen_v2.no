    copy(bytes, [0x48, 0x81, 0xFE, 0x40, 0x00, 0x60, 0x00]) // cmp rsi,0x600040
    copy(bytes, [0x0F, 0x82])                      // jb loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x3B, 0x34, 0x25, 0x00, 0x00, 0x60, 0x00]) // cmp rsi,[bump]
    copy(bytes, [0x0F, 0x83])                      // jae loop
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x06])                // mov rax,[rsi] (count)
    copy(bytes, [0x48, 0x3D, 0x00, 0x00, 0x01, 0x00]) // cmp rax,0x10000
    copy(bytes, [0x0F, 0x87])                      // ja loop (sanity)
    u32(bytes, (mrt_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x49, 0x89, 0x32])                // mov [r10],rsi (payload)
    copy(bytes, [0x49, 0xC7, 0x42, 0x08, 0x20, 0x00, 0x00, 0x00]) // mov q[r10+8],32
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
