    copy(bytes, [0x48, 0x8B, 0x08])                // mov rcx,[rax] (next)
    copy(bytes, [0x48, 0x83, 0xEA, 0x10])          // sub rdx,16 (rest-size)
    copy(bytes, [0x48, 0x83, 0xFA, 0x10])          // cmp rdx,16
    copy(bytes, [0x0F, 0x82])                       // jb nosplit
    u32(bytes, 0)
    la a16_pnosplit = lengde(bytes) - 4
    copy(bytes, [0x48, 0x89, 0x48, 0x10])          // mov [rax+16],rcx (rest.next)
    copy(bytes, [0x48, 0x89, 0x50, 0x18])          // mov [rax+24],rdx (rest.size)
    copy(bytes, [0x48, 0x8D, 0x48, 0x10])          // lea rcx,[rax+16] (rest-addr)
    copy(bytes, [0x48, 0x89, 0x0C, 0x25])          // mov [head],rcx
    u32(bytes, HEAP_VA() + 40)
    la a16_prdone = emit_jmp_placeholder(bytes)    // jmp Rdone
    la a16_nosplit = lengde(bytes)                 // nosplit:
    patch_jump(bytes, a16_pnosplit, a16_nosplit)
    copy(bytes, [0x48, 0x89, 0x0C, 0x25])          // mov [head],rcx (pop heile)
    u32(bytes, HEAP_VA() + 40)
    la a16_Rdone = lengde(bytes)                   // Rdone:
    patch_jump(bytes, a16_prdone, a16_Rdone)
    la a16_pdone = emit_jmp_placeholder(bytes)     // jmp done
    la a16_Lbump = lengde(bytes)                   // L_bump:
    patch_jump(bytes, a16_empty, a16_Lbump)
    patch_jump(bytes, a16_pbump, a16_Lbump)
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])          // mov rax,[bump]
    u32(bytes, HEAP_VA())
    copy(bytes, [0x48, 0x89, 0xC2])                // mov rdx,rax
    copy(bytes, [0x48, 0x83, 0xC2, 0x10])          // add rdx,16
    copy(bytes, [0x48, 0x89, 0x14, 0x25])          // mov [bump],rdx
    u32(bytes, HEAP_VA())
    la a16_Ldone = lengde(bytes)                   // done:
    patch_jump(bytes, a16_pdone, a16_Ldone)
    copy(bytes, [0x5A])                            // pop rdx
    copy(bytes, [0x59])                            // pop rcx
    copy(bytes, [0x9D])                            // popfq
    copy(bytes, [0xC3])                            // ret

    // ── GC (iii/3b): STORLEIK-BEVISST allokator for variabel-storleik-payloadar ──
    // gc_alloc_var(size i rcx) -> rax = blokk på >= size byte. Head-fit på fri-lista
    // (splittar resten når rom for header), elles bump. Klobrar rax + r9/r10/r11 (alle
    // caller-saved; frosen fill-kode set r8-r10 friskt, r11 urørt av fill). Bevarar rdi/
    // rsi/rdx/rcx → trygt midt i variabel-allokator-sites.
    atomics["gc_alloc_var"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x9C])                            // pushfq
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])          // mov rax,[head]
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x48, 0x85, 0xC0])                // test rax,rax
    la av_empty = emit_je_placeholder(bytes)       // jz V_bump
    copy(bytes, [0x4C, 0x8B, 0x50, 0x08])          // mov r10,[rax+8] (blokk-size)
    copy(bytes, [0x49, 0x39, 0xCA])                // cmp r10,rcx (blokk-size >= req?)
    copy(bytes, [0x0F, 0x82])                       // jb V_bump
    u32(bytes, 0)
    la av_pbump = lengde(bytes) - 4
    copy(bytes, [0x4C, 0x8B, 0x18])                // mov r11,[rax] (next)
    copy(bytes, [0x49, 0x29, 0xCA])                // sub r10,rcx (rest-size)
    copy(bytes, [0x49, 0x83, 0xFA, 0x10])          // cmp r10,16
    copy(bytes, [0x0F, 0x82])                       // jb V_nosplit
    u32(bytes, 0)
    la av_pnosplit = lengde(bytes) - 4
    copy(bytes, [0x49, 0x89, 0xC1])                // mov r9,rax
    copy(bytes, [0x49, 0x01, 0xC9])                // add r9,rcx (rest-addr = rax+req)
    copy(bytes, [0x4D, 0x89, 0x19])                // mov [r9],r11 (rest.next)
    copy(bytes, [0x4D, 0x89, 0x51, 0x08])          // mov [r9+8],r10 (rest.size)
    copy(bytes, [0x4C, 0x89, 0x0C, 0x25])          // mov [head],r9
    u32(bytes, HEAP_VA() + 40)
    la av_prdone = emit_jmp_placeholder(bytes)     // jmp V_done
    la av_nosplit = lengde(bytes)                  // V_nosplit:
    patch_jump(bytes, av_pnosplit, av_nosplit)
    copy(bytes, [0x4C, 0x89, 0x1C, 0x25])          // mov [head],r11 (pop heile)
    u32(bytes, HEAP_VA() + 40)
    la av_prdone2 = emit_jmp_placeholder(bytes)    // jmp V_done
    la av_Vbump = lengde(bytes)                    // V_bump:
    patch_jump(bytes, av_empty, av_Vbump)
    patch_jump(bytes, av_pbump, av_Vbump)
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])          // mov rax,[bump]
    u32(bytes, HEAP_VA())
    copy(bytes, [0x49, 0x89, 0xC2])                // mov r10,rax  (FIKS: var 4C89D2=mov rdx,r10!)
    copy(bytes, [0x49, 0x01, 0xCA])                // add r10,rcx (new bump = rax+size)
    copy(bytes, [0x4C, 0x89, 0x14, 0x25])          // mov [bump],r10
    u32(bytes, HEAP_VA())
    la av_done = lengde(bytes)                     // V_done:
    patch_jump(bytes, av_prdone, av_done)
    patch_jump(bytes, av_prdone2, av_done)
    copy(bytes, [0x9D])                            // popfq
    copy(bytes, [0xC3])                            // ret

    // ── json_string_case KROPP (rdi=streng-NcVal → rax=JSON-streng-NcVal) ──
    // Den frosne rutinen @0x4028d2 escapa ikkje bakstrek. Sidan codegen DEKODAR escape-
    // sekvensar ved innbaking av konstantar, er runtime-strengar rå og MÅ escapast her:
    // " → \"   \ → \\   LF → \n   CR → \r   TAB → \t  (andre byte kopierast rått).
    // Scratch (2*len+16) via gc_alloc_var (GC-vennleg, ikkje rå bump), resultat via
    // RT_STR_RAW. Framover-jmp-en frå atomics["json_string_case"] landar her.
    la json_str_body = lengde(bytes)
    patch_jump(bytes, json_str_body_patch, json_str_body)
    copy(bytes, [0x55, 0x53, 0x41, 0x54, 0x41, 0x55, 0x41, 0x56, 0x41, 0x57]) // push rbp,rbx,r12,r13,r14,r15
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8 (align)
    copy(bytes, [0x48, 0x8B, 0x47, 0x08])          // mov rax,[rdi+8] (payload)
    copy(bytes, [0x4C, 0x8B, 0x20])                // mov r12,[rax] (len)
    copy(bytes, [0x4C, 0x8D, 0x68, 0x08])          // lea r13,[rax+8] (kjeldebyte)
    copy(bytes, [0x4B, 0x8D, 0x4C, 0x24, 0x10])    // lea rcx,[r12+r12+16] (scratch-storleik)
    call_rel32(bytes, atomics["gc_alloc_var"], TEXT_VA()) // rax = scratch
    copy(bytes, [0x49, 0x89, 0xC6])                // mov r14,rax (dst-base)
    copy(bytes, [0x48, 0x89, 0xC3])                // mov rbx,rax (dst-markør)
    copy(bytes, [0xC6, 0x03, 0x22])                // mov byte[rbx],'"'
    copy(bytes, [0x48, 0xFF, 0xC3])                // inc rbx
    copy(bytes, [0x4D, 0x31, 0xFF])                // xor r15,r15 (i=0)
    la jsc_loop = lengde(bytes)
    copy(bytes, [0x4D, 0x39, 0xE7])                // cmp r15,r12
    copy(bytes, [0x0F, 0x83]) u32(bytes, 0)        // jae done
    la jsc_pdone = lengde(bytes) - 4
    copy(bytes, [0x43, 0x0F, 0xB6, 0x44, 0x2F, 0x00]) // movzx eax,byte[r13+r15]
    copy(bytes, [0x3C, 0x22])                      // cmp al,'"'
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // je esc_q
    la jsc_pq = lengde(bytes) - 4
    copy(bytes, [0x3C, 0x5C])                      // cmp al,'\'
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // je esc_b
    la jsc_pb = lengde(bytes) - 4
    copy(bytes, [0x3C, 0x0A])                      // cmp al,LF
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // je esc_n
    la jsc_pn = lengde(bytes) - 4
    copy(bytes, [0x3C, 0x0D])                      // cmp al,CR
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // je esc_r
    la jsc_pr = lengde(bytes) - 4
    copy(bytes, [0x3C, 0x09])                      // cmp al,TAB
    copy(bytes, [0x0F, 0x84]) u32(bytes, 0)        // je esc_t
    la jsc_pt = lengde(bytes) - 4
    copy(bytes, [0x88, 0x03])                      // mov [rbx],al (rå byte)
    copy(bytes, [0x48, 0xFF, 0xC3])                // inc rbx
    copy(bytes, [0xE9]) u32(bytes, 0)              // jmp next
    la jsc_pnext0 = lengde(bytes) - 4
    la jsc_esc_q = lengde(bytes)
    copy(bytes, [0x66, 0xC7, 0x03, 0x5C, 0x22])    // mov word[rbx],'\"'
    copy(bytes, [0x48, 0x83, 0xC3, 0x02])          // add rbx,2
    copy(bytes, [0xE9]) u32(bytes, 0)              // jmp next
    la jsc_pnext1 = lengde(bytes) - 4
    la jsc_esc_b = lengde(bytes)
    copy(bytes, [0x66, 0xC7, 0x03, 0x5C, 0x5C])    // mov word[rbx],'\\'
    copy(bytes, [0x48, 0x83, 0xC3, 0x02])          // add rbx,2
    copy(bytes, [0xE9]) u32(bytes, 0)              // jmp next
    la jsc_pnext2 = lengde(bytes) - 4
    la jsc_esc_n = lengde(bytes)
    copy(bytes, [0x66, 0xC7, 0x03, 0x5C, 0x6E])    // mov word[rbx],'\n'
    copy(bytes, [0x48, 0x83, 0xC3, 0x02])          // add rbx,2
    copy(bytes, [0xE9]) u32(bytes, 0)              // jmp next
    la jsc_pnext3 = lengde(bytes) - 4
    la jsc_esc_r = lengde(bytes)
    copy(bytes, [0x66, 0xC7, 0x03, 0x5C, 0x72])    // mov word[rbx],'\r'
    copy(bytes, [0x48, 0x83, 0xC3, 0x02])          // add rbx,2
    copy(bytes, [0xE9]) u32(bytes, 0)              // jmp next
    la jsc_pnext4 = lengde(bytes) - 4
    la jsc_esc_t = lengde(bytes)
    copy(bytes, [0x66, 0xC7, 0x03, 0x5C, 0x74])    // mov word[rbx],'\t'
    copy(bytes, [0x48, 0x83, 0xC3, 0x02])          // add rbx,2
    la jsc_next = lengde(bytes)                    // next: (fell gjennom)
    copy(bytes, [0x49, 0xFF, 0xC7])                // inc r15
    copy(bytes, [0xE9]) u32(bytes, (jsc_loop - (lengde(bytes) + 4)) & 4294967295) // jmp loop
    la jsc_done = lengde(bytes)
    copy(bytes, [0xC6, 0x03, 0x22])                // mov byte[rbx],'"'
    copy(bytes, [0x48, 0xFF, 0xC3])                // inc rbx
    copy(bytes, [0x4C, 0x89, 0xF7])                // mov rdi,r14 (peikar)
    copy(bytes, [0x48, 0x89, 0xDE])                // mov rsi,rbx
    copy(bytes, [0x4C, 0x29, 0xF6])                // sub rsi,r14 (lengd)
    call_rel32(bytes, RT_STR_RAW(), TEXT_VA())     // rax = NcVal
    copy(bytes, [0x48, 0x83, 0xC4, 0x08])          // add rsp,8
    copy(bytes, [0x41, 0x5F, 0x41, 0x5E, 0x41, 0x5D, 0x41, 0x5C, 0x5B, 0x5D]) // pop r15,r14,r13,r12,rbx,rbp
    copy(bytes, [0xC3])                            // ret
    patch_jump(bytes, jsc_pdone, jsc_done)
    patch_jump(bytes, jsc_pq, jsc_esc_q)
    patch_jump(bytes, jsc_pb, jsc_esc_b)
    patch_jump(bytes, jsc_pn, jsc_esc_n)
    patch_jump(bytes, jsc_pr, jsc_esc_r)
    patch_jump(bytes, jsc_pt, jsc_esc_t)
    patch_jump(bytes, jsc_pnext0, jsc_next)
    patch_jump(bytes, jsc_pnext1, jsc_next)
    patch_jump(bytes, jsc_pnext2, jsc_next)
    patch_jump(bytes, jsc_pnext3, jsc_next)
    patch_jump(bytes, jsc_pnext4, jsc_next)

    // ── GC (3b): variabel-allokator som returnerer i R8 (for RT_LIST_APP grow) ──
    // gc_alloc_var_r8(size i r9) -> r8 = blokk. Head-fit+split på fri-lista, elles bump.
    // BEVARER rax (grow held gamal payload-struct i rax!), rcx/rdx/rdi/rsi. Klobrar r8/
    // r10/r11 (grow-copy-loopen set r9/r10 friskt etterpå). Kalla via `mov r10,va; call r10`.
    atomics["gc_alloc_var_r8"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x9C])                            // pushfq
    copy(bytes, [0x4C, 0x8B, 0x04, 0x25])          // mov r8,[head]
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x4D, 0x85, 0xC0])                // test r8,r8
    la r8_empty = emit_je_placeholder(bytes)       // jz V_bump
    copy(bytes, [0x4D, 0x8B, 0x50, 0x08])          // mov r10,[r8+8] (blokk-size)
    copy(bytes, [0x4D, 0x39, 0xCA])                // cmp r10,r9 (>= req?)
    copy(bytes, [0x0F, 0x82])                       // jb V_bump
    u32(bytes, 0)
    la r8_pbump = lengde(bytes) - 4
    copy(bytes, [0x4D, 0x8B, 0x18])                // mov r11,[r8] (next)
    copy(bytes, [0x4D, 0x29, 0xCA])                // sub r10,r9 (rest-size)
    copy(bytes, [0x49, 0x83, 0xFA, 0x10])          // cmp r10,16
    copy(bytes, [0x0F, 0x82])                       // jb V_nosplit
    u32(bytes, 0)
    la r8_pnosplit = lengde(bytes) - 4
    copy(bytes, [0x4F, 0x89, 0x1C, 0x08])          // mov [r8+r9],r11 (rest.next)
    copy(bytes, [0x4F, 0x89, 0x54, 0x08, 0x08])    // mov [r8+r9+8],r10 (rest.size)
    copy(bytes, [0x4F, 0x8D, 0x14, 0x08])          // lea r10,[r8+r9] (rest-addr)
    copy(bytes, [0x4C, 0x89, 0x14, 0x25])          // mov [head],r10
    u32(bytes, HEAP_VA() + 40)
    la r8_prdone = emit_jmp_placeholder(bytes)     // jmp V_done
    la r8_nosplit = lengde(bytes)                  // V_nosplit:
    patch_jump(bytes, r8_pnosplit, r8_nosplit)
    copy(bytes, [0x4C, 0x89, 0x1C, 0x25])          // mov [head],r11 (pop heile)
    u32(bytes, HEAP_VA() + 40)
    la r8_prdone2 = emit_jmp_placeholder(bytes)    // jmp V_done
    la r8_Vbump = lengde(bytes)                    // V_bump:
    patch_jump(bytes, r8_empty, r8_Vbump)
    patch_jump(bytes, r8_pbump, r8_Vbump)
    copy(bytes, [0x4C, 0x8B, 0x04, 0x25])          // mov r8,[bump]
    u32(bytes, HEAP_VA())
    copy(bytes, [0x4D, 0x89, 0xC2])                // mov r10,r8
    copy(bytes, [0x4D, 0x01, 0xCA])                // add r10,r9 (new bump = r8+size)
    copy(bytes, [0x4C, 0x89, 0x14, 0x25])          // mov [bump],r10
    u32(bytes, HEAP_VA())
    la r8_done = lengde(bytes)                     // V_done:
    patch_jump(bytes, r8_prdone, r8_done)
    patch_jump(bytes, r8_prdone2, r8_done)
    copy(bytes, [0x9D])                            // popfq
    copy(bytes, [0xC3])                            // ret

    // ── GC (iv): nullstill mark-bitmap (2MB @0x10400000) — per collect ──
    // gc_bitmap_clear() -> boksa 0. rep stosq over 262144 qwords = 2MB.
    atomics["gc_bitmap_clear"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0xBF, 0x00, 0x00, 0x40, 0x10])    // mov edi,0x10400000 (bitmap base)
    copy(bytes, [0xB9, 0x00, 0x00, 0x04, 0x00])    // mov ecx,0x40000 (262144 qwords)
    copy(bytes, [0x31, 0xC0])                       // xor eax,eax
    copy(bytes, [0xF3, 0x48, 0xAB])                 // rep stosq (nullstill 2MB)
    copy(bytes, [0x31, 0xFF])                       // xor edi,edi (box 0)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC (iv): INSERTION-SORT live-map[0..n] etter adresse (DFS-orden ≠ adr-orden) ──
    // gc_sort_livemap(n) -> boksa n. In-place @0x10340000, kvar entry 16B [addr][size].
    // rdi=n, r8=lm-base, rcx=i, r10=j, rax=key.addr, rdx=key.size, r9/r11/rsi=scratch.
    atomics["gc_sort_livemap"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08])          // mov rdi,[rdi+8] (unbox n)
    copy(bytes, [0x41, 0xB8, 0x00, 0x00, 0x34, 0x10]) // mov r8d,0x10340000 (lm base)
    copy(bytes, [0x48, 0xC7, 0xC1, 0x01, 0x00, 0x00, 0x00]) // mov rcx,1 (i=1)
    la srt_outer = lengde(bytes)                   // .outer:
    copy(bytes, [0x48, 0x39, 0xF9])                // cmp rcx,rdi
    copy(bytes, [0x0F, 0x83])                       // jae done
