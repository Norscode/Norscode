    // frigjer ALT umarkert heap-område → MÅ registrere payload + keys/vals-arrays (cap*8) OG
    // pushe key-strengar + verdi-boksar (GC-managed) — elles frigjort → dangling → krasj.
    copy(bytes, [0x48, 0x83, 0xF8, 0x04])          // cmp rax,4
    copy(bytes, [0x0F, 0x85])                      // jne not_map
