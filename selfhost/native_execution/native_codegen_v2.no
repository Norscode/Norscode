    copy(bytes, [0x48, 0x8B, 0x14, 0x25, 0x30, 0x00, 0x60, 0x00]) // mov rdx,[0x600030] (stack_base)
    copy(bytes, [0x48, 0x8B, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00]) // mov rcx,[0x600000] (bump)
    la mrt_scan = lengde(bytes)                    // .scan:
