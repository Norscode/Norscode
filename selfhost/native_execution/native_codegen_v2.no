    // gc_alloc16() -> rax = 16B blokk (fri-liste head-fit >=16, elles bump). Fyller
    // IKKJE (den frosne allokatoren si eiga fill-kode køyrer etter). Klobrar BERRE
    // rax+rcx (som den originale bump-prologen `mov rax,[bump];lea rcx,[rax+16];mov
    // [bump],rcx`) og BEVARER flagg (pushfq/popfq) → trygt å kalle midt i frosen kode.
    // Klobrar BERRE rax (rcx/rdx via push/pop; rsi/rdi/flagg bevart) → trygt for BEGGE
    // 16B-prolog-variantane: rcx-variant (verdi i rsi) OG rdx-variant (verdi i rcx).
    atomics["gc_alloc16"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x9C])                            // pushfq (bevar flagg)
    copy(bytes, [0x51])                            // push rcx
    copy(bytes, [0x52])                            // push rdx
    copy(bytes, [0x48, 0x8B, 0x04, 0x25])          // mov rax,[head]
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x48, 0x85, 0xC0])                // test rax,rax
    la a16_empty = emit_je_placeholder(bytes)      // jz L_bump
    copy(bytes, [0x48, 0x8B, 0x50, 0x08])          // mov rdx,[rax+8] (blokk-size)
    copy(bytes, [0x48, 0x83, 0xFA, 0x10])          // cmp rdx,16
    copy(bytes, [0x0F, 0x82])                       // jb L_bump
    u32(bytes, 0)
    la a16_pbump = lengde(bytes) - 4
