    copy(bytes, [0x49, 0xC1, 0xE3, 0x04])          // shl r11,4 (i*16)
    copy(bytes, [0x4B, 0x8B, 0x04, 0x18])          // mov rax,[r8+r11] (key.addr)
    copy(bytes, [0x4B, 0x8B, 0x54, 0x18, 0x08])    // mov rdx,[r8+r11+8] (key.size)
    copy(bytes, [0x49, 0x89, 0xCA])                // mov r10,rcx
    copy(bytes, [0x49, 0xFF, 0xCA])                // dec r10 (j=i-1)
    la srt_inner = lengde(bytes)                   // .inner:
    copy(bytes, [0x4D, 0x85, 0xD2])                // test r10,r10
    copy(bytes, [0x0F, 0x88])                       // js place (j<0)
    u32(bytes, 0)
    la srt_pplace1 = lengde(bytes) - 4
    copy(bytes, [0x4D, 0x89, 0xD3])                // mov r11,r10
    copy(bytes, [0x49, 0xC1, 0xE3, 0x04])          // shl r11,4 (j*16)
    copy(bytes, [0x4B, 0x8B, 0x34, 0x18])          // mov rsi,[r8+r11] (lm[j].addr)
    copy(bytes, [0x48, 0x39, 0xC6])                // cmp rsi,rax
    copy(bytes, [0x0F, 0x86])                       // jbe place (lm[j].addr<=key)
    u32(bytes, 0)
    la srt_pplace2 = lengde(bytes) - 4
    copy(bytes, [0x4F, 0x8B, 0x4C, 0x18, 0x08])    // mov r9,[r8+r11+8] (lm[j].size) — REX.X for r11-indeks
    copy(bytes, [0x4B, 0x89, 0x74, 0x18, 0x10])    // mov [r8+r11+16],rsi (lm[j+1].addr)
    copy(bytes, [0x4F, 0x89, 0x4C, 0x18, 0x18])    // mov [r8+r11+24],r9 (lm[j+1].size) — REX.X for r11-indeks
    copy(bytes, [0x49, 0xFF, 0xCA])                // dec r10 (j--)
    copy(bytes, [0xE9])                            // jmp inner
    u32(bytes, (srt_inner - (lengde(bytes) + 4)) & 4294967295)
    la srt_place = lengde(bytes)                   // .place:
