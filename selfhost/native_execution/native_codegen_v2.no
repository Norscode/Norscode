    copy(bytes, [0x49, 0x89, 0x3B])                // mov [r11],rdi (push)
    copy(bytes, [0x49, 0x83, 0xC3, 0x08])          // add r11,8
    copy(bytes, [0x48, 0x83, 0xC2, 0x08])          // add rdx,8
    copy(bytes, [0x48, 0xFF, 0xC8])                // dec rax
    copy(bytes, [0xE9])                            // jmp keyloop
