    copy(bytes, [0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x60, 0x00]) // mov rax,[bump]
    copy(bytes, [0x48, 0x89, 0xC6])                // mov rsi,rax
    // KLAMP: last_live_end (r9) kan overstige bump om eit objekt er over-rekna (falsk rot
    // nær bump, mis-sizea som streng) → hale-size = bump - r9 < 0 → HUGE unsigned → frigjer
    // bogus enorm region → korrupsjon. bump <= r9 → hopp hale.
    copy(bytes, [0x4C, 0x39, 0xC8])                // cmp rax,r9 (bump vs last_live_end)
    copy(bytes, [0x0F, 0x86])                      // jbe tail_skip
