    copy(bytes, [0x48, 0x8B, 0x4E, 0x18])          // mov rcx,[rsi+24] (vals_ptr)
    copy(bytes, [0x48, 0x81, 0xF9, 0x40, 0x00, 0x60, 0x00]) // cmp rcx,0x600040
    copy(bytes, [0x0F, 0x82])                      // jb loop
