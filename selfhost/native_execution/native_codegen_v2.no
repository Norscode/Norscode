    // head=addr. rdi=addr, rsi=size (boksa).
    atomics["gc_free"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x47, 0x08])          // mov rax,[rdi+8] (addr)
    copy(bytes, [0x48, 0x8B, 0x56, 0x08])          // mov rdx,[rsi+8] (size)
    copy(bytes, [0x4C, 0x8B, 0x04, 0x25])          // mov r8,[moffs32] (old head)
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x4C, 0x89, 0x00])                // mov [rax],r8  (next=old head)
    copy(bytes, [0x48, 0x89, 0x50, 0x08])          // mov [rax+8],rdx (size)
    copy(bytes, [0x48, 0x89, 0x04, 0x25])          // mov [moffs32],rax (head=addr)
    u32(bytes, HEAP_VA() + 40)
    copy(bytes, [0x48, 0x89, 0xF8, 0xC3])          // mov rax,rdi; ret

    // ── GC mark-fase (F5): allokeringsfri mark-bitmap i scratch @ 0x10400000 ──
    // (2 MB på toppen av 256 MB-heapen; bump når han aldri når GC held bump lågt.)
    // gc_mark_bit(addr) -> boksa gammal-bit (0=ny, 1=alt markert). 1 bit / 16B-slot.
    atomics["gc_mark_bit"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08])          // mov rdi,[rdi+8]  (unbox addr)
    copy(bytes, [0x48, 0x81, 0xEF, 0x00, 0x00, 0x60, 0x00]) // sub rdi, 0x600000
    copy(bytes, [0x48, 0xC1, 0xEF, 0x04])          // shr rdi, 4  (slot-index)
    copy(bytes, [0x48, 0x89, 0xF9])                // mov rcx, rdi
    copy(bytes, [0x48, 0x83, 0xE1, 0x07])          // and rcx, 7  (bit-pos)
    copy(bytes, [0x48, 0xC1, 0xEF, 0x03])          // shr rdi, 3  (byte-index)
    copy(bytes, [0xB8, 0x00, 0x00, 0x40, 0x10])    // mov eax, 0x10400000 (bitmap-base)
    copy(bytes, [0x48, 0x01, 0xC7])                // add rdi, rax  (byte-adresse)
    copy(bytes, [0x48, 0x0F, 0xB6, 0x17])          // movzx rdx,[rdi] (byte)
    copy(bytes, [0x48, 0x89, 0xD0])                // mov rax, rdx
    copy(bytes, [0x48, 0xD3, 0xE8])                // shr rax, cl
    copy(bytes, [0x48, 0x83, 0xE0, 0x01])          // and rax, 1  (gammal bit)
    copy(bytes, [0x49, 0xC7, 0xC0, 0x01, 0x00, 0x00, 0x00]) // mov r8, 1
    copy(bytes, [0x49, 0xD3, 0xE0])                // shl r8, cl  (maske)
    copy(bytes, [0x4C, 0x09, 0xC2])                // or rdx, r8
    copy(bytes, [0x88, 0x17])                      // mov [rdi], dl (sett bit)
    copy(bytes, [0x48, 0x89, 0xC7])                // mov rdi, rax (gammal bit)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp, 8 (align)
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box rdi → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp, 8; ret

    // ── GC (ii): ALLOKERINGSFRI mark-fase i rein maskinkode ──────────────────
    // gc_mark_native(root) -> boksa mark-teljar. Full DFS med rå register + scratch
    // (mark-stakk @0x10300000, live-map @0x10340000, bitmap @0x10400000). INGEN
    // boksing i løkka → trygg for safepoint. r11=mstack, r10=live-map, r9=count.
    // (Bitmap må nullstillast mellom collections; single-call her.)
    atomics["gc_mark_native"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08])          // mov rdi,[rdi+8] (unbox root)
    copy(bytes, [0x41, 0xBB, 0x00, 0x00, 0x30, 0x10]) // mov r11d,0x10300000 (mstack)
    copy(bytes, [0x41, 0xBA, 0x00, 0x00, 0x34, 0x10]) // mov r10d,0x10340000 (live-map)
    copy(bytes, [0x41, 0xB9, 0x00, 0x00, 0x00, 0x00]) // mov r9d,0 (count)
    copy(bytes, [0x49, 0x89, 0x3B])                // mov [r11],rdi (push root)
    copy(bytes, [0x49, 0x83, 0xC3, 0x08])          // add r11,8
    la mnat_loop = lengde(bytes)                   // .loop:
    copy(bytes, [0x49, 0x81, 0xFB, 0x00, 0x00, 0x30, 0x10]) // cmp r11,0x10300000
    copy(bytes, [0x0F, 0x86])                      // jbe done
    u32(bytes, 0)
    la mnat_pdone = lengde(bytes) - 4
    copy(bytes, [0x49, 0x83, 0xEB, 0x08])          // sub r11,8
    copy(bytes, [0x49, 0x8B, 0x03])                // mov rax,[r11] (pop)
    copy(bytes, [0x48, 0x3D, 0x40, 0x00, 0x60, 0x00]) // cmp rax,0x600040 (over kontrollblokk)
    copy(bytes, [0x0F, 0x82])                      // jb loop
    u32(bytes, (mnat_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x0C, 0x25, 0x00, 0x00, 0x60, 0x00]) // mov rcx,[0x600000] (bump)
    copy(bytes, [0x48, 0x39, 0xC8])                // cmp rax,rcx
    copy(bytes, [0x0F, 0x83])                      // jae loop
    u32(bytes, (mnat_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x89, 0xC7])                // mov rdi,rax (addr)
    copy(bytes, [0x48, 0x2D, 0x00, 0x00, 0x60, 0x00]) // sub rax,0x600000
    copy(bytes, [0x48, 0xC1, 0xE8, 0x04])          // shr rax,4
    copy(bytes, [0x48, 0x89, 0xC1])                // mov rcx,rax
    copy(bytes, [0x48, 0x83, 0xE1, 0x07])          // and rcx,7
    copy(bytes, [0x48, 0xC1, 0xE8, 0x03])          // shr rax,3
    copy(bytes, [0x48, 0x05, 0x00, 0x00, 0x40, 0x10]) // add rax,0x10400000
    copy(bytes, [0x0F, 0xB6, 0x10])                // movzx edx,[rax]
    copy(bytes, [0x48, 0x89, 0xD6])                // mov rsi,rdx
    copy(bytes, [0x48, 0xD3, 0xEA])                // shr rdx,cl
    copy(bytes, [0x48, 0x83, 0xE2, 0x01])          // and rdx,1
    copy(bytes, [0x48, 0x85, 0xD2])                // test rdx,rdx
    copy(bytes, [0x0F, 0x85])                      // jnz loop (alt markert)
    u32(bytes, (mnat_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x41, 0xB8, 0x01, 0x00, 0x00, 0x00]) // mov r8d,1
    copy(bytes, [0x49, 0xD3, 0xE0])                // shl r8,cl
    copy(bytes, [0x4C, 0x09, 0xC6])                // or rsi,r8
    copy(bytes, [0x40, 0x88, 0x30])                // mov [rax],sil
    copy(bytes, [0x49, 0x89, 0x3A])                // mov [r10],rdi (live-map addr)
    copy(bytes, [0x49, 0xC7, 0x42, 0x08, 0x10, 0x00, 0x00, 0x00]) // mov q[r10+8],16
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    copy(bytes, [0x49, 0xFF, 0xC1])                // inc r9
    copy(bytes, [0x48, 0x8B, 0x07])                // mov rax,[rdi] (type)
    copy(bytes, [0x48, 0x83, 0xF8, 0x03])          // cmp rax,3
    copy(bytes, [0x0F, 0x85])                      // jne loop (ikkje liste)
    u32(bytes, (mnat_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x77, 0x08])          // mov rsi,[rdi+8] (payload)
    copy(bytes, [0x48, 0x8B, 0x06])                // mov rax,[rsi] (len)
    copy(bytes, [0x49, 0x89, 0x32])                // mov [r10],rsi (payload addr)
    copy(bytes, [0x48, 0x89, 0xC2])                // mov rdx,rax
    copy(bytes, [0x48, 0xC1, 0xE2, 0x03])          // shl rdx,3 (len*8)
    copy(bytes, [0x48, 0x83, 0xC2, 0x10])          // add rdx,16
    copy(bytes, [0x49, 0x89, 0x52, 0x08])          // mov [r10+8],rdx (payload size)
    copy(bytes, [0x49, 0x83, 0xC2, 0x10])          // add r10,16
    copy(bytes, [0x48, 0x8D, 0x56, 0x10])          // lea rdx,[rsi+16] (elem-array)
    la mnat_elem = lengde(bytes)                   // .elem_loop:
    copy(bytes, [0x48, 0x85, 0xC0])                // test rax,rax
    copy(bytes, [0x0F, 0x84])                      // jz loop (len==0)
    u32(bytes, (mnat_loop - (lengde(bytes) + 4)) & 4294967295)
    copy(bytes, [0x48, 0x8B, 0x3A])                // mov rdi,[rdx] (element)
    copy(bytes, [0x49, 0x89, 0x3B])                // mov [r11],rdi (push)
    copy(bytes, [0x49, 0x83, 0xC3, 0x08])          // add r11,8
    copy(bytes, [0x48, 0x83, 0xC2, 0x08])          // add rdx,8
    copy(bytes, [0x48, 0xFF, 0xC8])                // dec rax
    copy(bytes, [0xE9])                            // jmp elem_loop
    u32(bytes, (mnat_elem - (lengde(bytes) + 4)) & 4294967295)
    la mnat_done = lengde(bytes)                   // done:
    patch_jump(bytes, mnat_pdone, mnat_done)
    // bru til sweep: lagre live-map ENTRY-teljar (r10-lm_base)>>4 @0x600038
    copy(bytes, [0x4C, 0x89, 0xD0])                // mov rax,r10 (lm end)
    copy(bytes, [0x48, 0x2D, 0x00, 0x00, 0x34, 0x10]) // sub rax,0x10340000
    copy(bytes, [0x48, 0xC1, 0xE8, 0x04])          // shr rax,4 (entries)
    copy(bytes, [0x48, 0x89, 0x04, 0x25, 0x38, 0x00, 0x60, 0x00]) // mov [0x600038],rax
    copy(bytes, [0x4C, 0x89, 0xCF])                // mov rdi,r9 (count)
    copy(bytes, [0x48, 0x83, 0xEC, 0x08])          // sub rsp,8
    call_rel32(bytes, RT_INT(), TEXT_VA())         // box → rax
    copy(bytes, [0x48, 0x83, 0xC4, 0x08, 0xC3])   // add rsp,8; ret

    // ── GC (ii): ALLOKERINGSFRI maskinkode-SWEEP ──────────────────────────────
    // gc_sweep_native(n) -> boksa tal frigjorde hol. Walk live-map[0..n] @0x10340000
    // (ADRESSE-ORDNA; sort er refinement), gc_free-ar hola mellom påfølgjande live
    // objekt via inline fri-liste-push (rå, ingen boksing). r8=lm-base, r9=prev_end,
    // r11=freed, rcx=j, rdi=n. Fri-liste-hovud @0x600028 (HEAP_VA+40).
    atomics["gc_sweep_native"] = TEXT_VA() + lengde(bytes)
    copy(bytes, [0x48, 0x8B, 0x7F, 0x08])          // mov rdi,[rdi+8] (unbox n)
    copy(bytes, [0x41, 0xB8, 0x00, 0x00, 0x34, 0x10]) // mov r8d,0x10340000 (lm base)
    copy(bytes, [0x4D, 0x8B, 0x08])                // mov r9,[r8]  (lm[0].addr)
    copy(bytes, [0x4D, 0x03, 0x48, 0x08])          // add r9,[r8+8] (prev_end)
    copy(bytes, [0x4D, 0x31, 0xDB])                // xor r11,r11 (freed=0)
    copy(bytes, [0x48, 0xC7, 0xC1, 0x01, 0x00, 0x00, 0x00]) // mov rcx,1 (j=1)
    la swp_loop = lengde(bytes)                    // .loop:
    copy(bytes, [0x48, 0x39, 0xF9])                // cmp rcx,rdi
    copy(bytes, [0x0F, 0x83])                      // jae done
    u32(bytes, 0)
    la swp_pdone = lengde(bytes) - 4
    copy(bytes, [0x48, 0x89, 0xC8])                // mov rax,rcx
    copy(bytes, [0x48, 0xC1, 0xE0, 0x04])          // shl rax,4 (j*16)
    copy(bytes, [0x4C, 0x01, 0xC0])                // add rax,r8 (&lm[j])
    copy(bytes, [0x48, 0x8B, 0x10])                // mov rdx,[rax] (lm[j].addr)
    copy(bytes, [0x48, 0x89, 0xD6])                // mov rsi,rdx
    copy(bytes, [0x4C, 0x29, 0xCE])                // sub rsi,r9 (gap)
    copy(bytes, [0x48, 0x83, 0xFE, 0x10])          // cmp rsi,16
    copy(bytes, [0x0F, 0x82])                      // jb skip
    u32(bytes, 0)
    la swp_pskip = lengde(bytes) - 4
