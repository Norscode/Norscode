    la mrt_loop = lengde(bytes)                    // .loop:
    copy(bytes, [0x49, 0x81, 0xFB, 0x00, 0x00, 0x30, 0x10]) // cmp r11,0x10300000
    copy(bytes, [0x0F, 0x86])                      // jbe done
    u32(bytes, 0)
    la mrt_pdone = lengde(bytes) - 4
    copy(bytes, [0x49, 0x83, 0xEB, 0x08])          // sub r11,8
