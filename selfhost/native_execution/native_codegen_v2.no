    // annan levande liste/int-payload vert overskriven → korrupsjon (t.d. list-elem=1).
    copy(bytes, [0x48, 0x83, 0xF8, 0x02])          // cmp rax,2
    copy(bytes, [0x0F, 0x85])                      // jne check_list
