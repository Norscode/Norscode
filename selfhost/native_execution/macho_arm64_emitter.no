// Minimal Norscode-eigd Mach-O/arm64-emitter.
// Dette er første native macOS-grunnlag for same AOT-kjede som ELF/PE.

bruk std.sha256 som sha256

funksjon u8(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    legg_til(buf, verdi & 255)
    returner 0
}

funksjon u32(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 0
    mens i < 4 {
        u8(buf, verdi >> (i * 8))
        i = i + 1
    }
    returner 0
}

funksjon u64(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 0
    mens i < 8 {
        u8(buf, verdi >> (i * 8))
        i = i + 1
    }
    returner 0
}

funksjon be32(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    u8(buf, verdi >> 24)
    u8(buf, verdi >> 16)
    u8(buf, verdi >> 8)
    u8(buf, verdi)
    returner 0
}

funksjon be64(buf: liste_heiltall, verdi: heiltall) -> heiltall {
    la i = 7
    mens i >= 0 {
        u8(buf, verdi >> (i * 8))
        i = i - 1
    }
    returner 0
}

funksjon hex_verdi(tegn: tekst) -> heiltall {
    // Samanlikn kodepunkt, ikkje tekst mot numeriske strengliteralar.
    // Det gjer bootstrap-/AOT-kompilering stabil også når eldre compiler
    // normaliserer "0" til heiltalsliteralen 0 i samanlikningsuttrykk.
    la kode = builtin.char_code(tegn)
    hvis kode >= 48 og kode <= 57 { returner kode - 48 }
    hvis kode >= 97 og kode <= 102 { returner kode - 97 + 10 }
    hvis kode >= 65 og kode <= 70 { returner kode - 65 + 10 }
    kast "Ugyldig hextegn"
}

funksjon hex_til_bytes(hex: tekst) -> liste_heiltall {
    hvis lengde(hex) % 2 != 0 { kast "Ugyldig hexlengd" }
    la ut: liste_heiltall = []
    la i = 0
    mens i < lengde(hex) {
        legg_til(ut, (hex_verdi(hex[i]) << 4) | hex_verdi(hex[i + 1]))
        i = i + 2
    }
    returner ut
}

funksjon fast_namn(buf: liste_heiltall, namn: tekst) -> heiltall {
    la i = 0
    mens i < 16 {
        hvis i < lengde(namn) { u8(buf, builtin.char_code(namn[i])) } ellers { u8(buf, 0) }
        i = i + 1
    }
    returner 0
}

funksjon fast_tekst(buf: liste_heiltall, verdi: tekst, storleik: heiltall) -> heiltall {
    la i = 0
    mens i < storleik {
        hvis i < lengde(verdi) { u8(buf, builtin.char_code(verdi[i])) } ellers { u8(buf, 0) }
        i = i + 1
    }
    returner 0
}

funksjon pad(buf: liste_heiltall, storleik: heiltall) -> heiltall {
    mens lengde(buf) < storleik { u8(buf, 0) }
    returner 0
}

funksjon arm64_exit_kode(exitkode: heiltall) -> liste_heiltall {
    la kode: liste_heiltall = []
    // LC_MAIN blir kalla av dyld som ein vanleg main-funksjon. Returner
    // exitkoden i w0 og bruk lr i staden for direkte Darwin-syscall.
    u32(kode, 0x52800000 | ((exitkode & 0xFFFF) << 5)) // movz w0, #imm
    u32(kode, 0xD65F03C0) // ret
    returner kode
}

funksjon code_directory(code_hashar: liste_heiltall, code_limit: heiltall, code_slots: heiltall, exec_lengd: heiltall) -> liste_heiltall {
    la ut: liste_heiltall = []
    la ident = "norscode.aot"
    la fast_lengd = 88
    la ident_offset = fast_lengd
    la hash_offset = ident_offset + lengde(ident) + 1
    la total_lengd = hash_offset + (32 * code_slots)
    be32(ut, 0xFADE0C02)
    be32(ut, total_lengd)
    be32(ut, 0x00020400)
    be32(ut, 0x00020002) // CS_ADHOC | CS_LINKER_SIGNED
    be32(ut, hash_offset)
    be32(ut, ident_offset)
    be32(ut, 0) // nSpecialSlots
    be32(ut, code_slots)
    be32(ut, code_limit)
    u8(ut, 32) // SHA-256 hashstorleik
    u8(ut, 2)  // CS_HASHTYPE_SHA256
    u8(ut, 0)  // platform
    u8(ut, 12) // 4096-byte side
    be32(ut, 0) // spare2
    be32(ut, 0) // scatterOffset
    be32(ut, 0) // teamOffset
    be32(ut, 0) // spare3
    be64(ut, 0)    // codeLimit64, 32-bit codeLimit er brukt
    be64(ut, 0)    // execSegBase
    be64(ut, exec_lengd) // execSegLimit for generert AOT-kode
    be64(ut, 1)    // CS_EXECSEG_MAIN_BINARY
    la i = 0
    mens i < lengde(ident) { u8(ut, builtin.char_code(ident[i])) i = i + 1 }
    u8(ut, 0)
    i = 0
    mens i < lengde(code_hashar) { u8(ut, code_hashar[i]) i = i + 1 }
    hvis lengde(ut) != total_lengd { kast "CodeDirectory-lengd er inkonsistent" }
    returner ut
}

funksjon signatur_blob(code_hashar: liste_heiltall, code_limit: heiltall, code_slots: heiltall, exec_lengd: heiltall) -> liste_heiltall {
    la directory = code_directory(code_hashar, code_limit, code_slots, exec_lengd)
    la ut: liste_heiltall = []
    be32(ut, 0xFADE0CC0) // CSMAGIC_EMBEDDED_SIGNATURE
    be32(ut, 20 + lengde(directory))
    be32(ut, 1)
    be32(ut, 0)  // CSSLOT_CODEDIRECTORY
    be32(ut, 20)
    la i = 0
    mens i < lengde(directory) { u8(ut, directory[i]) i = i + 1 }
    returner ut
}

// Bruk native SHA-256 når runtime-ABI-en har den, men behold rein Norscode
// som bootstrap-/pure-VM-fallback. Bytes-vegen er bytebevarande også for NUL.
// M1: sha256_bytes_hex fyrst — det er det native x86-atomet (native_codegen_v2), og kryss-
// codegen-en (bygd utan std.native_gap i bunten) rutar elles builtin.sha256_bytes til den
// reine std.sha256.hash_bytes. Då kosta sidehashane for eit 12 MB nc_main (3000 sider) fleire
// GB søppel på bump-heapen (GC-heap full, 88 s); med atomet tek dei under eitt sekund.
funksjon hash_bytes_rask(bytes: liste_heiltall) -> tekst {
    prøv { returner builtin.sha256_bytes_hex(bytes) } fang (e) { }
    prøv { returner builtin.sha256_bytes(bytes) } fang (e) { }
    returner sha256.hash_bytes(bytes)
}

funksjon chained_fixups_tom() -> liste_heiltall {
    la ut: liste_heiltall = []
    u32(ut, 0)  // fixups_version
    u32(ut, 32) // starts_offset
    u32(ut, 48) // imports_offset
    u32(ut, 48) // symbols_offset
    u32(ut, 0)  // imports_count
    u32(ut, 1)  // imports_format
    u32(ut, 0)  // symbols_format
    u32(ut, 0)  // reserve til starts_offset
    u32(ut, 3)  // seg_count
    u32(ut, 0)
    u32(ut, 0)
    u32(ut, 0)
    pad(ut, 56)
    returner ut
}

funksjon exports_trie_exit() -> liste_heiltall {
    // Eksporter _main ved file-offset 696 og __mh_execute_header ved 0.
    returner [
        0x00, 0x01, 0x5F, 0x00, 0x12, 0x00, 0x00, 0x00,
        0x00, 0x02, 0x00, 0x00, 0x00, 0x03, 0x00, 0xB8,
        0x05, 0x00, 0x00, 0x02, 0x5F, 0x6D, 0x68, 0x5F,
        0x65, 0x78, 0x65, 0x63, 0x75, 0x74, 0x65, 0x5F, 0x68,
        0x65, 0x61, 0x64, 0x65, 0x72, 0x00, 0x09, 0x6D, 0x61,
        0x69, 0x6E, 0x00, 0x0D, 0x00, 0x00
    ]
}

// M1: Mach-O-biletet er hode ‖ kode ‖ hale ‖ signatur:
//   hode      mach_header_64 + load commands (kode_offset byte);
//   hale      __TEXT-fyll etter koden + __LINKEDIT-innhaldet fram til signaturen;
//   signatur  ad-hoc SuperBlob med SHA-256 per 4 KiB-side over hode ‖ kode ‖ hale.
// Sidehashane blir rekna over den virtuelle samankoplinga (virtuell_side), so store program
// ikkje treng ein kopi av koden i minnet: skriv_program strøymer delane til fil. Før bygde
// bygg_program eit nytt 12 M-element-bilete av nc_main, og samla levande sett (kode, kopien
// og veksten hans) sprengde 1 GiB-heapen til kryss-codegen-en på x86 (GC-heap full).
funksjon virtuell_side(hode: liste_heiltall, kode: liste_heiltall, hale: liste_heiltall, start: heiltall, slutt: heiltall) -> liste_heiltall {
    la ko = lengde(hode)
    la ke = ko + lengde(kode)
    hvis start >= ko og slutt <= ke {
        // Heile sida ligg i koden: éin native delliste-kopi (list_slice). Runtimar der
        // slice på lister ikkje gjev ei liste, fell til byte-løkka under.
        la del = []
        la del_ok = usann
        prøv {
            del = builtin.slice(kode, start - ko, slutt - ko)
            del_ok = builtin.type(del) == "liste" og lengde(del) == slutt - start
        } fang (e) { del_ok = usann }
        hvis del_ok { returner del }
    }
    la ut: liste_heiltall = []
    la p = start
    mens p < slutt {
        hvis p < ko {
            u8(ut, hode[p])
        } ellers hvis p < ke {
            u8(ut, kode[p - ko])
        } ellers {
            u8(ut, hale[p - ke])
        }
        p = p + 1
    }
    returner ut
}

funksjon bygg_hode_hale(kode_lengd: heiltall) -> ordbok {
    la ut: liste_heiltall = []
    la base: heiltall = 0x100000000
    la header_lengd = 32
    la pagezero_lengd = 72
    la segment_lengd = 152
    la linkedit_lengd = 72
    la dylinker_lengd = 32
    la byggversjon_lengd = 32
    la kjeldeversjon_lengd = 16
    la libsystem_lengd = 56
    la linkedit_data_cmd_lengd = 16
    la symtab_lengd = 24
    la dysymtab_lengd = 80
    la uuid_lengd = 24
    la funksjonsstart_lengd = 16
    la data_i_kode_lengd = 16
    la main_lengd = 24
    la signatur_cmd_lengd = 16
    la kommando_lengd = pagezero_lengd + segment_lengd + linkedit_lengd + (2 * linkedit_data_cmd_lengd) + symtab_lengd + dysymtab_lengd + dylinker_lengd + uuid_lengd + byggversjon_lengd + kjeldeversjon_lengd + libsystem_lengd + main_lengd + funksjonsstart_lengd + data_i_kode_lengd + signatur_cmd_lengd
    la kode_offset = header_lengd + kommando_lengd
    hvis kode_lengd == 0 eller kode_lengd > 67108864 { kast "Ugyldig Mach-O AOT-kodelengd" }
    // A5: __TEXT er kode_offset + kode runda opp til 16 KiB-sider (før fast éi side, dvs.
    // eit kodetak på 15000 byte). __LINKEDIT (fixups/exports/symtab/signatur) ligg rett
    // etter; signaturen hashar alle 4 KiB-sider fram til seg sjølv. Kode som fekk plass i
    // éi side gjev byte-identisk utdata med før.
    la tekst_seg = ((kode_offset + kode_lengd + 16383) / 16384) * 16384
    la signatur_offset = tekst_seg + 4096
    la sider = signatur_offset / 4096
    la signatur_lengd = 20 + 88 + lengde("norscode.aot") + 1 + 32 * sider

    // mach_header_64
    u32(ut, 0xFEEDFACF)
    u32(ut, 0x0100000C) // CPU_TYPE_ARM64
    u32(ut, 0)          // CPU_SUBTYPE_ARM64_ALL
    u32(ut, 2)          // MH_EXECUTE
    u32(ut, 16)         // seksten load commands
    u32(ut, kommando_lengd)
    u32(ut, 0x200085)   // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    u32(ut, 0)

    // __PAGEZERO vernar nullpeikaren og gir standard 4 GiB image-base.
    u32(ut, 0x19)
    u32(ut, pagezero_lengd)
    fast_namn(ut, "__PAGEZERO")
    u64(ut, 0)
    u64(ut, base)
    u64(ut, 0)
    u64(ut, 0)
    u32(ut, 0)
    u32(ut, 0)
    u32(ut, 0)
    u32(ut, 0)

    // LC_SEGMENT_64 med ein __text-section.
    u32(ut, 0x19)
    u32(ut, segment_lengd)
    fast_namn(ut, "__TEXT")
    u64(ut, base)
    u64(ut, tekst_seg)
    u64(ut, 0)
    u64(ut, tekst_seg)
    u32(ut, 5) // maxprot r-x
    u32(ut, 5) // initprot r-x
    u32(ut, 1)
    u32(ut, 0)

    fast_namn(ut, "__text")
    fast_namn(ut, "__TEXT")
    u64(ut, base + kode_offset)
    u64(ut, kode_lengd)
    u32(ut, kode_offset)
    u32(ut, 2)
    u32(ut, 0)
    u32(ut, 0)
    u32(ut, 0x80000400)
    u32(ut, 0)
    u32(ut, 0)
    u32(ut, 0)

    // __LINKEDIT inneheld den innebygde ad-hoc-signaturen.
    u32(ut, 0x19)
    u32(ut, linkedit_lengd)
    fast_namn(ut, "__LINKEDIT")
    u64(ut, base + tekst_seg)
    u64(ut, ((4096 + signatur_lengd + 16383) / 16384) * 16384)
    u64(ut, tekst_seg)
    u64(ut, 4096 + signatur_lengd)
    u32(ut, 1)
    u32(ut, 1)
    u32(ut, 0)
    u32(ut, 0)

    u32(ut, 0x80000034) // LC_DYLD_CHAINED_FIXUPS
    u32(ut, linkedit_data_cmd_lengd)
    u32(ut, tekst_seg)
    u32(ut, 56)

    u32(ut, 0x80000033) // LC_DYLD_EXPORTS_TRIE
    u32(ut, linkedit_data_cmd_lengd)
    u32(ut, tekst_seg + 56)
    u32(ut, 48)

    u32(ut, 0x02) // LC_SYMTAB, tom symboltabell
    u32(ut, symtab_lengd)
    u32(ut, tekst_seg + 104)
    u32(ut, 2)
    u32(ut, tekst_seg + 136)
    u32(ut, 32)

    u32(ut, 0x0B) // LC_DYSYMTAB
    u32(ut, dysymtab_lengd)
    u32(ut, 0) // ilocalsym
    u32(ut, 0) // nlocalsym
    u32(ut, 0) // iextdefsym
    u32(ut, 2) // nextdefsym
    u32(ut, 2) // iundefsym
    u32(ut, 0) // nundefsym
    la dysym_i = 0
    mens dysym_i < 12 { u32(ut, 0) dysym_i = dysym_i + 1 }

    // Moderne arm64 macOS startar executable gjennom dyld og LC_MAIN.
    u32(ut, 0x0E) // LC_LOAD_DYLINKER
    u32(ut, dylinker_lengd)
    u32(ut, 12)   // lc_str-offset
    fast_tekst(ut, "/usr/lib/dyld", dylinker_lengd - 12)

    u32(ut, 0x1B) // LC_UUID
    u32(ut, uuid_lengd)
    fast_tekst(ut, "NORSCODE-AOT-V1", 16)

    u32(ut, 0x32) // LC_BUILD_VERSION
    u32(ut, byggversjon_lengd)
    u32(ut, 1)          // PLATFORM_MACOS
    u32(ut, 0x000B0000) // macOS 11.0
    u32(ut, 0x000B0000)
    u32(ut, 1)
    u32(ut, 3) // TOOL_LD
    u32(ut, 0)

    u32(ut, 0x2A) // LC_SOURCE_VERSION
    u32(ut, kjeldeversjon_lengd)
    u64(ut, 0)

    u32(ut, 0x80000028) // LC_MAIN
    u32(ut, main_lengd)
    u64(ut, kode_offset)
    u64(ut, 0)

    u32(ut, 0x0C) // LC_LOAD_DYLIB
    u32(ut, libsystem_lengd)
    u32(ut, 24)
    u32(ut, 2)
    u32(ut, 0x054C0000)
    u32(ut, 0x00010000)
    fast_tekst(ut, "/usr/lib/libSystem.B.dylib", libsystem_lengd - 24)

    u32(ut, 0x26) // LC_FUNCTION_STARTS
    u32(ut, funksjonsstart_lengd)
    u32(ut, tekst_seg + 168)
    u32(ut, 8)

    u32(ut, 0x29) // LC_DATA_IN_CODE
    u32(ut, data_i_kode_lengd)
    u32(ut, tekst_seg + 176)
    u32(ut, 0)

    // LC_CODE_SIGNATURE peikar på SuperBlob i __LINKEDIT.
    u32(ut, 0x1D)
    u32(ut, signatur_cmd_lengd)
    u32(ut, signatur_offset)
    u32(ut, signatur_lengd)

    hvis lengde(ut) != kode_offset { kast "Mach-O header/load-command-lengd er inkonsistent" }
    la i = 0
    // Halen: __TEXT-fyll etter koden + __LINKEDIT-innhaldet fram til signaturen.
    la kode_slutt = kode_offset + kode_lengd
    la hale: liste_heiltall = []
    pad(hale, tekst_seg - kode_slutt)
    la fixups = chained_fixups_tom()
    i = 0
    mens i < lengde(fixups) { u8(hale, fixups[i]) i = i + 1 }
    la exports = exports_trie_exit()
    i = 0
    mens i < lengde(exports) { u8(hale, exports[i]) i = i + 1 }
    pad(hale, tekst_seg + 104 - kode_slutt)
    // To eksternt definerte symbol: __mh_execute_header og _main.
    u32(hale, 2)
    u8(hale, 0x0F)
    u8(hale, 1)
    u8(hale, 0x10)
    u8(hale, 0)
    u64(hale, base)
    u32(hale, 22)
    u8(hale, 0x0F)
    u8(hale, 1)
    u8(hale, 0)
    u8(hale, 0)
    u64(hale, base + kode_offset)
    // 32-byte stringtabell, same indeksar som nlist_64 over.
    la strtab: liste_heiltall = [
        0x20, 0x00, 0x5F, 0x5F, 0x6D, 0x68, 0x5F, 0x65,
        0x78, 0x65, 0x63, 0x75, 0x74, 0x65, 0x5F, 0x68,
        0x65, 0x61, 0x64, 0x65, 0x72, 0x00, 0x5F, 0x6D,
        0x61, 0x69, 0x6E, 0x00, 0x00, 0x00, 0x00, 0x00
    ]
    i = 0
    mens i < lengde(strtab) { u8(hale, strtab[i]) i = i + 1 }
    // ULEB128-delta 696 til _main, deretter sluttmarkør.
    u8(hale, 0xB8)
    u8(hale, 0x05)
    u8(hale, 0)
    pad(hale, tekst_seg + 176 - kode_slutt)
    pad(hale, signatur_offset - kode_slutt)
    returner {"hode": ut, "hale": hale, "sider": sider, "signatur_offset": signatur_offset,
              "signatur_lengd": signatur_lengd, "kode_lengd": kode_lengd}
}

// SHA-256 av éi 4 KiB-side som 32 rå byte, lagt til i hashar (CodeDirectory-slottane).
funksjon legg_til_sidehash(hashar: liste_heiltall, side: liste_heiltall) -> heiltall {
    la side_hash = hex_til_bytes(hash_bytes_rask(side))
    la i = 0
    mens i < lengde(side_hash) { u8(hashar, side_hash[i]) i = i + 1 }
    returner 0
}

// Ad-hoc-signaturen (SuperBlob) frå sidehashane over hode ‖ kode ‖ hale.
funksjon signatur_frå_hashar(delar: ordbok, hashar: liste_heiltall) -> liste_heiltall {
    la signatur_offset: heiltall = delar["signatur_offset"]
    la sider: heiltall = delar["sider"]
    la kode_lengd: heiltall = delar["kode_lengd"]
    la signatur_lengd: heiltall = delar["signatur_lengd"]
    la signatur = signatur_blob(hashar, signatur_offset, sider, kode_lengd)
    hvis lengde(signatur) != signatur_lengd { kast "Mach-O signaturlengd er inkonsistent" }
    returner signatur
}

funksjon bygg_delar(kode: liste_heiltall) -> ordbok {
    la delar = bygg_hode_hale(lengde(kode))
    la hode = delar["hode"]
    la hale = delar["hale"]
    la sider: heiltall = delar["sider"]
    la hashar: liste_heiltall = []
    la side = 0
    mens side < sider {
        legg_til_sidehash(hashar, virtuell_side(hode, kode, hale, side * 4096, (side + 1) * 4096))
        side = side + 1
    }
    returner {"hode": hode, "hale": hale, "signatur": signatur_frå_hashar(delar, hashar)}
}

funksjon bygg_program(kode: liste_heiltall) -> liste_heiltall {
    la delar = bygg_delar(kode)
    la ut: liste_heiltall = []
    for b i delar["hode"] { u8(ut, b) }
    // O(n): for-iterasjon, ikkje kode[i] (indeksert lese er O(n) i tolken).
    for b i kode { u8(ut, b) }
    for b i delar["hale"] { u8(ut, b) }
    for b i delar["signatur"] { u8(ut, b) }
    returner ut
}

// Legg bytes til fila i bitar på 512 KiB: fil_append_binær på x86-verten går via
// bytes_to_text, som klemmer til 1 MiB (stakkbuffer) — eitt kall med heile koden skreiv
// berre den første MiB-en.
funksjon append_i_bitar(sti: tekst, bytes: liste_heiltall) -> heiltall {
    la bit = 524288
    la n = lengde(bytes)
    hvis n <= bit {
        builtin.fil_append_binær(sti, bytes)
        returner n
    }
    la a = 0
    mens a < n {
        la b = a + bit
        hvis b > n { b = n }
        la del = []
        la del_ok = usann
        prøv {
            del = builtin.slice(bytes, a, b)
            del_ok = builtin.type(del) == "liste" og lengde(del) == b - a
        } fang (e) { del_ok = usann }
        hvis ikkje del_ok {
            del = []
            la p = a
            mens p < b { u8(del, bytes[p]) p = p + 1 }
        }
        builtin.fil_append_binær(sti, del)
        a = b
    }
    returner n
}

// Skriv Mach-O-biletet direkte til fil (same bytes som bygg_program) i ÉI passering over
// sidene: kvar 4 KiB-side av hode ‖ kode ‖ hale blir sett saman éin gong, hasha til
// CodeDirectory-en og lagd til fila; signaturen kjem til slutt. Returnerer talet på byte.
// Kryss-codegen-en på x86 køyrer med monoton bump-heap (ingen frigjering), so det er SUM
// allokert som tel mot taket, ikkje levande sett (sjå skriv_program_delar).
funksjon skriv_program(sti: tekst, kode: liste_heiltall) -> heiltall {
    returner skriv_program_delar(sti, [kode], lengde(kode))
}

// Som skriv_program, men koden kjem som delar (ncval_compile_program_delar: eitt fragment per
// funksjon + hale) med samla lengd kode_lengd. Sidene av hode ‖ delar… ‖ hale blir fylte inn
// i éin gjenbrukt 4 KiB-buffer med indekstilordning: indeksane (side- og del-posisjon) held
// seg stort sett under 32768 (int-cachen), so fyllinga allokerer ingenting, og hash +
// skriving kostar ~1 B per byte. Før kosta kvar side ein list_slice (~16 B per byte) —
// saman med det samla biletet sprengde det 2 GiB-taket for R2-nc_main.
funksjon skriv_program_delar(sti: tekst, delar, kode_lengd: heiltall) -> heiltall {
    la dh = bygg_hode_hale(kode_lengd)
    la hode = dh["hode"]
    la hale = dh["hale"]
    la sider: heiltall = dh["sider"]
    la segment = [hode]
    la sum = 0
    la i = 0
    mens i < lengde(delar) {
        la del: liste_heiltall = delar[i]
        hvis lengde(del) > 0 { legg_til(segment, del) sum = sum + lengde(del) }
        i = i + 1
    }
    hvis sum != kode_lengd { kast "Mach-O-emitter: delane gav " + tekst(sum) + " byte, venta " + tekst(kode_lengd) }
    legg_til(segment, hale)
    la buf: liste_heiltall = []
    la j = 0
    mens j < 4096 { u8(buf, 0) j = j + 1 }
    la hashar: liste_heiltall = []
    la si = 0
    la seg: liste_heiltall = segment[0]
    // Lengda blir halden i seg_n: lengde() på ein del over 32767 byte gjev ein ny heiltalsboks
    // (16 B) per kall, og eitt kall per byte kosta ~190 MB for R2-nc_main. k sjølv boksar
    // berre over 32767 (store fragment, ~7,6 MB av R2).
    la seg_n = lengde(seg)
    la k = 0
    la side = 0
    mens side < sider {
        j = 0
        mens j < 4096 {
            mens k >= seg_n {
                si = si + 1
                hvis si >= lengde(segment) { kast "Mach-O-emitter: biletet er kortare enn sidene" }
                seg = segment[si]
                seg_n = lengde(seg)
                k = 0
            }
            buf[j] = seg[k]
            j = j + 1
            k = k + 1
        }
        legg_til_sidehash(hashar, buf)
        hvis side == 0 { builtin.fil_skriv_binær(sti, buf) } ellers { builtin.fil_append_binær(sti, buf) }
        side = side + 1
    }
    la signatur = signatur_frå_hashar(dh, hashar)
    la n: heiltall = dh["signatur_offset"]
    n = n + append_i_bitar(sti, signatur)
    returner n
}

funksjon bygg_exit(exitkode: heiltall) -> liste_heiltall {
    returner bygg_program(arm64_exit_kode(exitkode))
}

funksjon skriv_exit(sti: tekst, exitkode: heiltall) -> heiltall {
    la bytes = bygg_exit(exitkode)
    builtin.fil_skriv_binær(sti, bytes)
    returner lengde(bytes)
}
