// NCB -> køyrbar macOS arm64 Mach-O.
// AOT-flate for heiltalsuttrykk: konstantar og vanleg aritmetikk blir ekte
// arm64-instruksjonar. Resultatet frå RETURN blir native main-retur.

bruk selfhost.native_execution.macho_arm64_emitter som macho
bruk std.runtime_filesystem som native_fs

funksjon opcode(instruksjon) -> tekst {
    hvis builtin.type(instruksjon) != "liste" eller lengde(instruksjon) == 0 { returner "" }
    returner tekst(instruksjon[0])
}

funksjon legg_u32(kode: liste_heiltall, verdi: heiltall) -> heiltall {
    legg_til(kode, verdi & 255)
    legg_til(kode, (verdi >> 8) & 255)
    legg_til(kode, (verdi >> 16) & 255)
    legg_til(kode, (verdi >> 24) & 255)
    returner 0
}

funksjon skriv_u32(kode: liste_heiltall, posisjon: heiltall, verdi: heiltall) -> heiltall {
    kode[posisjon] = verdi & 255
    kode[posisjon + 1] = (verdi >> 8) & 255
    kode[posisjon + 2] = (verdi >> 16) & 255
    kode[posisjon + 3] = (verdi >> 24) & 255
    returner 0
}

funksjon last_heiltall(kode: liste_heiltall, register: heiltall, verdi: heiltall) -> heiltall {
    hvis verdi < -2147483648 eller verdi > 2147483647 { kast "macOS AOT-heiltall må vere 32-bit" }
    la bits = verdi & 0xFFFFFFFF
    legg_u32(kode, 0x52800000 | ((bits & 0xFFFF) << 5) | register) // movz wN, low16
    hvis ((bits >> 16) & 0xFFFF) != 0 {
        legg_u32(kode, 0x72A00000 | (((bits >> 16) & 0xFFFF) << 5) | register) // movk wN, high16, lsl 16
    }
    returner 0
}

// Full 64-bit konstant-last i eit x-register (movz + inntil 3 movk). Brukt for
// PUSH_CONST utanfor int32 (t.d. usignert 32-bit SHA-konstantar som 0xFFFFFFFF)
// og for 64-bit-aritmetikk. Negativt handterast som 64-bit tomannskomplement.
funksjon last_heiltall_64(kode: liste_heiltall, register: heiltall, verdi: heiltall) -> heiltall {
    la bits = verdi & 0xFFFFFFFFFFFFFFFF
    la h0 = bits & 0xFFFF
    la h1 = (bits >> 16) & 0xFFFF
    la h2 = (bits >> 32) & 0xFFFF
    la h3 = (bits >> 48) & 0xFFFF
    legg_u32(kode, 0xD2800000 | (h0 << 5) | register)          // movz xN, #h0
    hvis h1 != 0 { legg_u32(kode, 0xF2A00000 | (h1 << 5) | register) } // movk xN, #h1, lsl 16
    hvis h2 != 0 { legg_u32(kode, 0xF2C00000 | (h2 << 5) | register) } // movk xN, #h2, lsl 32
    hvis h3 != 0 { legg_u32(kode, 0xF2E00000 | (h3 << 5) | register) } // movk xN, #h3, lsl 48
    returner 0
}

funksjon variabel_register(indeks: heiltall) -> heiltall {
    hvis indeks < 6 { returner 12 + indeks }
    returner 1 + (indeks - 6)
}

// Runtime-builtins som NcVal-maskina (kompiler_arm64_ncval) emitterer direkte.
// Desse må sleppast gjennom inline_kall i staden for å bli tolka som
// brukarfunksjonar. Utvidast etter kvart som fleire Fase 3/4-ops kjem inn.
funksjon er_ncval_builtin(namn: tekst) -> boolsk {
    la n = namn
    hvis builtin.starts_with(n, "builtin.") { n = builtin.slice(n, 8, lengde(n)) }
    hvis n == "skriv" eller n == "print" eller n == "lengde" eller n == "char_code" eller
       n == "chr" eller n == "lower" eller n == "upper" eller n == "slice" eller
       n == "trim" eller n == "replace" eller n == "contains" eller n == "starts_with" eller
       n == "ends_with" eller n == "index_of" eller n == "tekst" eller n == "heltall" eller
       n == "har_nokkel" eller n == "finnes_nøkkel" eller
       n == "fil_skriv" eller n == "fil_les" eller n == "fil_finnes" eller n == "miljo_hent" eller
       n == "json_stringify" eller n == "json_parse" eller n == "json_parse_raw" eller
       n == "fjern_nokkel" eller
       n == "socket_new" eller n == "socket_bind" eller n == "socket_connect" eller
       n == "socket_listen" eller n == "socket_accept" eller n == "socket_send" eller
       n == "socket_recv" eller n == "socket_close" eller n == "legg_til" eller
       n == "tekst_fra_heltall" eller n == "tekst_fra_heiltall" eller n == "til_tekst" eller
       n == "heltall_fra_tekst" eller n == "heiltall_fra_tekst" eller n == "type" eller
       n == "nøkler" eller n == "verdier" eller n == "fjern_siste" eller n == "split" eller n == "join" eller
       n == "tid_ms" eller n == "now_ms" eller
       n == "tekst_erstatt" eller n == "tekst_starter_med" eller n == "nøkkel_finnes" eller
       n == "json_skriv" eller n == "exit" eller n == "miljo_sett" eller
       n == "bytes_new" eller n == "bytes_from_list" eller n == "bytes_to_list" eller
       n == "assert" eller n == "assert_eq" eller
       n == "fil_slett" eller n == "fil_sett_kjorbar" eller n == "fil_append" eller
       n == "bytes_to_text" eller n == "fil_skriv_binær" eller n == "fil_skriv_binary" eller
       n == "fil_les_binær" eller n == "fil_les_binary" eller
       n == "random_hex" eller n == "miljo_finnes" eller n == "miljø_finnes" eller
       n == "fil_append_binær" eller n == "fil_append_binary" eller
       n == "feil" eller n == "fjern" eller n == "fjern_indeks" eller n == "sett_inn" eller
       n == "system_info" eller n == "native_heap_bytes" eller n == "vent.sov" eller
       n == "tekst_til_heltall" eller n == "_rt_env_finnes" {
        returner sann
    }
    hvis ncval_gap_stub(n) { returner sann }
    returner usann
}

// Fase 1 (SELFHOST_ARM64_FULLHOST_CODEGEN_PLAN.md): ekte runtime `skriv` av eit
// heiltal. Verdien i wArg (32-bit stakkslot) blir sign-extenda, formatert til
// desimal-ASCII på maskinstakken og skrive til stdout via write-syscall. Ingen
// heap enno. Syscall-nummer/`svc`-immediat er OS-spesifikke (macOS: x16=4,
// svc #0x80; Linux: x8=64, svc #0). Callee-saved x19–x26 blir brukt som scratch
// (leaf under `_start`, som ikkje krev at dei blir bevart); dei syscall-klobba
// register x1/x2/x8/x16 blir lagra og gjenoppretta rundt svc.
funksjon emit_skriv_int(native: liste_heiltall, arg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD10103FF)                    // sub  sp, sp, #64
    legg_u32(native, 0xF90013E1)                    // str  x1,  [sp,#32]
    legg_u32(native, 0xF90017E2)                    // str  x2,  [sp,#40]
    legg_u32(native, 0xF9001BE8)                    // str  x8,  [sp,#48]
    legg_u32(native, 0xF9001FF0)                    // str  x16, [sp,#56]
    legg_u32(native, 0x93407C00 | (arg << 5) | 19)  // sxtw x19, wArg
    legg_u32(native, 0x910083FA)                    // add  x26, sp, #32  (buffer-slutt)
    legg_u32(native, 0x910083F4)                    // add  x20, sp, #32  (skrivepeikar)
    legg_u32(native, 0xD2800017)                    // mov  x23, #0       (negativflagg)
    legg_u32(native, 0xD2800158)                    // mov  x24, #10
    legg_u32(native, 0xF100027F)                    // cmp  x19, #0
    la p_bne = lengde(native)
    legg_u32(native, 0)                             // b.ne notzero       (patch)
    legg_u32(native, 0x52800616)                    // mov  w22, #48      ('0')
    legg_u32(native, 0xD1000694)                    // sub  x20, x20, #1
    legg_u32(native, 0x39000296)                    // strb w22, [x20]
    la p_bzero = lengde(native)
    legg_u32(native, 0)                             // b    done          (patch)
    la lbl_notzero = lengde(native)
    la p_bge = lengde(native)
    legg_u32(native, 0)                             // b.ge positive/loop (patch)
    legg_u32(native, 0xD2800037)                    // mov  x23, #1       (negativ)
    legg_u32(native, 0xCB1303F3)                    // neg  x19, x19
    la lbl_loop = lengde(native)
    legg_u32(native, 0x9AD80A79)                    // udiv x25, x19, x24
    legg_u32(native, 0x9B18CF36)                    // msub x22, x25, x24, x19  (rest)
    legg_u32(native, 0x1100C2D6)                    // add  w22, w22, #48
    legg_u32(native, 0xD1000694)                    // sub  x20, x20, #1
    legg_u32(native, 0x39000296)                    // strb w22, [x20]
    legg_u32(native, 0xAA1903F3)                    // mov  x19, x25
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                             // cbnz x19, loop     (patch)
    la p_cbz = lengde(native)
    legg_u32(native, 0)                             // cbz  x23, no_sign  (patch)
    legg_u32(native, 0x528005B6)                    // mov  w22, #45      ('-')
    legg_u32(native, 0xD1000694)                    // sub  x20, x20, #1
    legg_u32(native, 0x39000296)                    // strb w22, [x20]
    la lbl_done = lengde(native)
    legg_u32(native, 0xCB140355)                    // sub  x21, x26, x20 (lengd)
    legg_u32(native, 0xD2800020)                    // mov  x0, #1        (fd=stdout)
    legg_u32(native, 0xAA1403E1)                    // mov  x1, x20       (buf)
    legg_u32(native, 0xAA1503E2)                    // mov  x2, x21       (len)
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                // mov  x8, #64       (Linux write)
        legg_u32(native, 0xD4000001)                // svc  #0
    } ellers {
        legg_u32(native, 0xD2800090)                // mov  x16, #4       (macOS write)
        legg_u32(native, 0xD4001001)                // svc  #0x80
    }
    legg_u32(native, 0xF94013E1)                    // ldr  x1,  [sp,#32]
    legg_u32(native, 0xF94017E2)                    // ldr  x2,  [sp,#40]
    legg_u32(native, 0xF9401BE8)                    // ldr  x8,  [sp,#48]
    legg_u32(native, 0xF9401FF0)                    // ldr  x16, [sp,#56]
    legg_u32(native, 0x910103FF)                    // add  sp, sp, #64
    legg_u32(native, 0x52800000 | arg)              // mov  wArg, #0      (skriv → nil/0)
    // Grein-patchar (same maskemønster som JUMP/JUMP_IF_FALSE i kompiler_arm64).
    skriv_u32(native, p_bne,   0x54000001 | ((((lbl_notzero - p_bne)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bzero, 0x14000000 |  (((lbl_done    - p_bzero) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bge,   0x5400000A | ((((lbl_loop    - p_bge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz,  0xB5000013 | ((((lbl_loop    - p_cbnz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz,   0xB4000017 | ((((lbl_done    - p_cbz)   / 4) & 0x7FFFF) << 5))
    returner 0
}

// ─── Fase 2: mmap-heap + NcVal-runtime ──────────────────────────────────────
// NcVal er ei 16-byte heap-struct {i64 type, i64 val} (same taggar som x86-64:
// 1=int, 2=bool). Heapen blir reservert med ein anonym mmap; bump-peikaren bur
// i den callee-saved x28 gjennom heile køyringa (ingen skrivbart datasegment
// trengst). x27 held heap-grensa. Ingen GC enno — Fase 6-minneporten står open.
//
// mmap er OS-spesifikk: macOS x16=197, svc #0x80, flags MAP_PRIVATE|MAP_ANON
// =0x1002; Linux x8=222, svc #0, flags MAP_PRIVATE|MAP_ANONYMOUS=0x22.
funksjon emit_heap_init(native: liste_heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD2800000)                    // movz x0, #0        (addr = NULL)
    legg_u32(native, 0xD2800001)                    // movz x1, #0
    legg_u32(native, 0xF2C00021)                    // movk x1, #1, lsl #32  (len=4 GiB; anon mmap er lat, ingen GC enno)
    legg_u32(native, 0xD2800062)                    // movz x2, #3        (PROT_READ|WRITE)
    hvis os == "linux" {
        legg_u32(native, 0xD2800443)                // movz x3, #0x22     (MAP_PRIVATE|ANONYMOUS)
    } ellers {
        legg_u32(native, 0xD2820043)                // movz x3, #0x1002   (MAP_PRIVATE|MAP_ANON)
    }
    legg_u32(native, 0x92800004)                    // movn x4, #0        (fd = -1)
    legg_u32(native, 0xD2800005)                    // movz x5, #0        (offset = 0)
    hvis os == "linux" {
        legg_u32(native, 0xD2801BC8)                // movz x8, #222      (Linux mmap)
        legg_u32(native, 0xD4000001)                // svc #0
    } ellers {
        legg_u32(native, 0xD28018B0)                // movz x16, #197     (macOS mmap)
        legg_u32(native, 0xD4001001)                // svc #0x80
    }
    legg_u32(native, 0xAA0003FC)                    // mov x28, x0        (bump = heap-start)
    // (x27 er reservert til envp for miljo_hent — ikkje klobb her.)
    returner 0
}

// Allokerer ein NcVal med gitt tagg frå heiltalet i Wval_reg; peikar i Xdst_reg.
// Brukar x13/x14 som scratch (daude etter kvar alloc). type_imm: 1=int, 2=bool.
funksjon emit_ncval_alloc(native: liste_heiltall, val_reg: heiltall, dst_reg: heiltall, type_imm: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03E0 | dst_reg)          // mov Xdst, x28      (peikar = bump)
    legg_u32(native, 0xD2800000 | (type_imm << 5) | 13) // movz x13, #type
    legg_u32(native, 0xF900038D)                    // str x13, [x28]
    legg_u32(native, 0x93407C00 | (val_reg << 5) | 14) // sxtw x14, Wval
    legg_u32(native, 0xF900078E)                    // str x14, [x28, #8]
    legg_u32(native, 0x9100439C)                    // add x28, x28, #16  (bump += 16)
    returner 0
}

funksjon emit_ncval_alloc_int(native: liste_heiltall, val_reg: heiltall, dst_reg: heiltall) -> heiltall {
    returner emit_ncval_alloc(native, val_reg, dst_reg, 1)
}

// Som emit_ncval_alloc, men lagrar heile 64-bit-peikaren i Xval_reg som `val`
// (utan sxtw). Brukt for NcVal-strengar (type=3) der val er ein strdata-peikar.
funksjon emit_ncval_alloc_ptr(native: liste_heiltall, ptr_reg: heiltall, dst_reg: heiltall, type_imm: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03E0 | dst_reg)          // mov Xdst, x28
    legg_u32(native, 0xD2800000 | (type_imm << 5) | 13) // movz x13, #type
    legg_u32(native, 0xF900038D)                    // str x13, [x28]
    legg_u32(native, 0xF9000780 | ptr_reg)          // str Xptr, [x28, #8]
    legg_u32(native, 0x9100439C)                    // add x28, x28, #16
    returner 0
}

// Fase 3: allokerer ein heap-streng frå ein compile-time-literal og legg NcVal-
// peikaren (type=3) i Xdst_reg. strdata-layout: [i64 lengd][bytes]. Byte blir
// materialiserte med movz/strb (kort literal). VM-strengar er byte-baserte
// (lengde/slice/char_code opererer på byte), så char_code per 1-byte-slice gjev
// rette råbytes også for UTF-8 (ikkje-ASCII).
funksjon emit_ncval_str_const(native: liste_heiltall, s: tekst, dst_reg: heiltall) -> heiltall {
    la n = lengde(s)
    legg_u32(native, 0xAA1C03E9)                    // mov x9, x28  (strdata-base)
    prøv { last_heiltall(native, 10, n) } fang (e) { kast "NcVal strengkonstant for lang" }
    legg_u32(native, 0xF900012A)                    // str x10, [x9]  (lengd)
    la i = 0
    mens i < n {
        la b = builtin.char_code(builtin.slice(s, i, i + 1)) & 255
        legg_u32(native, 0x52800000 | ((b & 0xFFFF) << 5) | 10)         // movz w10, #b
        legg_u32(native, 0x39000000 | ((8 + i) << 10) | (9 << 5) | 10)  // strb w10, [x9, #8+i]
        i = i + 1
    }
    la total = ((8 + n + 15) / 16) * 16
    hvis total > 4095 { kast "NcVal strengkonstant for stor for eitt add-steg" }
    legg_u32(native, 0x91000000 | (total << 10) | (28 << 5) | 28)       // add x28, x28, #total
    emit_ncval_alloc_ptr(native, 9, dst_reg, 3)
    returner 0
}

// Fase 3-delt hjelpar: allokerer ein ny heap-streng med `len`-byte kopiert frå
// ein byte-peikar, med valfri ASCII-case-transform. Forventar src-peikar i x9 og
// lengd i x10 (64-bit). case_mode: 0=ingen, 1=lower, 2=upper. Legg NcVal i Xdst.
// Scratch: x0, x14–x17.
funksjon emit_alloc_str_copy(native: liste_heiltall, dst_reg: heiltall, case_mode: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03EE)                    // mov x14, x28  (ny strdata-base)
    legg_u32(native, 0xF90001CA)                    // str x10, [x14]  (lengd)
    legg_u32(native, 0x910021CF)                    // add x15, x14, #8 (dst)
    legg_u32(native, 0xAA0903F0)                    // mov x16, x9   (src)
    legg_u32(native, 0xAA0A03F1)                    // mov x17, x10  (count)
    la p_cbz = lengde(native)
    legg_u32(native, 0)                             // cbz x17, done
    la lbl_loop = lengde(native)
    legg_u32(native, 0x39400200)                    // ldrb w0, [x16]
    la p_sk1 = -1
    la p_sk2 = -1
    hvis case_mode == 1 {
        legg_u32(native, 0x7101041F)                // cmp w0, #65 ('A')
        p_sk1 = lengde(native)
        legg_u32(native, 0)                         // b.lt skip
        legg_u32(native, 0x7101681F)                // cmp w0, #90 ('Z')
        p_sk2 = lengde(native)
        legg_u32(native, 0)                         // b.gt skip
        legg_u32(native, 0x11008000)                // add w0, w0, #32
    }
    hvis case_mode == 2 {
        legg_u32(native, 0x7101841F)                // cmp w0, #97 ('a')
        p_sk1 = lengde(native)
        legg_u32(native, 0)                         // b.lt skip
        legg_u32(native, 0x7101E81F)                // cmp w0, #122 ('z')
        p_sk2 = lengde(native)
        legg_u32(native, 0)                         // b.gt skip
        legg_u32(native, 0x51008000)                // sub w0, w0, #32
    }
    la lbl_skip = lengde(native)
    legg_u32(native, 0x390001E0)                    // strb w0, [x15]
    legg_u32(native, 0x91000610)                    // add x16, x16, #1
    legg_u32(native, 0x910005EF)                    // add x15, x15, #1
    legg_u32(native, 0xD1000631)                    // sub x17, x17, #1
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                             // cbnz x17, loop
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0F03FC)                    // mov x28, x15
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    skriv_u32(native, p_cbz,  0xB4000011 | ((((lbl_done - p_cbz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz, 0xB5000011 | ((((lbl_loop - p_cbnz) / 4) & 0x7FFFF) << 5))
    hvis p_sk1 >= 0 {
        skriv_u32(native, p_sk1, 0x5400000B | ((((lbl_skip - p_sk1) / 4) & 0x7FFFF) << 5)) // b.lt
        skriv_u32(native, p_sk2, 0x5400000C | ((((lbl_skip - p_sk2) / 4) & 0x7FFFF) << 5)) // b.gt
    }
    returner 0
}

// char_code(streng) → første byte som int.
funksjon emit_char_code(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 9)  // ldr x9, [Xarg, #8]  (strdata)
    legg_u32(native, 0x3940212A)                       // ldrb w10, [x9, #8]  (første byte)
    emit_ncval_alloc(native, 10, dst_reg, 1)
    returner 0
}

// chr(int) → 1-byte streng.
funksjon emit_chr(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xB9400800 | (arg_reg << 5) | 9)  // ldr w9, [Xarg, #8]  (kode)
    legg_u32(native, 0xAA1C03EE)                       // mov x14, x28
    legg_u32(native, 0xD280002A)                       // movz x10, #1
    legg_u32(native, 0xF90001CA)                       // str x10, [x14]
    legg_u32(native, 0x390021C9)                       // strb w9, [x14, #8]
    legg_u32(native, 0x9100439C)                       // add x28, x28, #16
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    returner 0
}

// slice(streng, start, end) → delstreng [start, end).
funksjon emit_slice(native: liste_heiltall, s_reg: heiltall, start_reg: heiltall, end_reg: heiltall, dst_reg: heiltall) -> heiltall {
    // Type-dispatch: liste (type=4) → delliste (kopier element-peikarar); elles
    // streng (type=3) → delstreng (kopier bytes). Krypto skiv lister (keystream).
    legg_u32(native, 0xF9400000 | (s_reg << 5) | 9)     // ldr x9, [Xs]  (type)
    legg_u32(native, 0xF100113F)                        // cmp x9, #4
    la p_bne_str = lengde(native)
    legg_u32(native, 0)                                 // b.ne str_path
    // --- liste-slice ---
    legg_u32(native, 0xF9400400 | (s_reg << 5) | 9)     // ldr x9, [Xs, #8]   (listdata)
    legg_u32(native, 0xB9400800 | (start_reg << 5) | 10) // ldr w10, [Xstart, #8]
    legg_u32(native, 0xB9400800 | (end_reg << 5) | 11)   // ldr w11, [Xend, #8]
    legg_u32(native, 0x4B0A016C)                        // sub w12, w11, w10  (count, øvre 32 nullstilt)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28       (ny listdata-base)
    legg_u32(native, 0xF90001CC)                        // str x12, [x14]     (count)
    legg_u32(native, 0x9100212D)                        // add x13, x9, #8    (&elem[0])
    legg_u32(native, 0x8B0A0DAD)                        // add x13, x13, x10, lsl #3  (&elem[start])
    legg_u32(native, 0x910021CF)                        // add x15, x14, #8   (dst write-ptr)
    la lbl_lloop = lengde(native)
    la p_cbz_ldone = lengde(native)
    legg_u32(native, 0)                                 // cbz w12, ldone
    legg_u32(native, 0xF94001B0)                        // ldr x16, [x13]
    legg_u32(native, 0xF90001F0)                        // str x16, [x15]
    legg_u32(native, 0x910021AD)                        // add x13, x13, #8
    legg_u32(native, 0x910021EF)                        // add x15, x15, #8
    legg_u32(native, 0x5100058C)                        // sub w12, w12, #1
    la p_b_lloop = lengde(native)
    legg_u32(native, 0x14000000)                        // b lloop
    la lbl_ldone = lengde(native)
    legg_u32(native, 0xAA0F03FC)                        // mov x28, x15       (bump forbi listdata)
    emit_ncval_alloc_ptr(native, 14, dst_reg, 4)        // boks som liste
    la p_b_end = lengde(native)
    legg_u32(native, 0x14000000)                        // b end
    // --- streng-slice (uendra) ---
    la lbl_str = lengde(native)
    legg_u32(native, 0xF9400400 | (s_reg << 5) | 9)     // ldr x9, [Xs, #8]     (strdata)
    legg_u32(native, 0xB9400800 | (start_reg << 5) | 10) // ldr w10, [Xstart, #8]
    legg_u32(native, 0xB9400800 | (end_reg << 5) | 11)   // ldr w11, [Xend, #8]
    legg_u32(native, 0x4B0A016C)                        // sub w12, w11, w10  (len)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8
    legg_u32(native, 0x8B0A0129)                        // add x9, x9, x10    (src = base+8+start)
    legg_u32(native, 0xAA0C03EA)                        // mov x10, x12       (len 64-bit)
    emit_alloc_str_copy(native, dst_reg, 0)
    la lbl_end = lengde(native)
    skriv_u32(native, p_bne_str,  0x54000001 | ((((lbl_str   - p_bne_str)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_ldone, 0x3400000C | ((((lbl_ldone - p_cbz_ldone) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_lloop,  0x14000000 |  (((lbl_lloop - p_b_lloop)  / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_end,    0x14000000 |  (((lbl_end   - p_b_end)    / 4) & 0x03FFFFFF))
    returner 0
}

// lower/upper(streng) → ny streng med case-transform. case_mode 1=lower,2=upper.
funksjon emit_case(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall, case_mode: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 9)  // ldr x9, [Xarg, #8]  (strdata)
    legg_u32(native, 0xF940012A)                       // ldr x10, [x9]       (len)
    legg_u32(native, 0x91002129)                       // add x9, x9, #8      (src)
    emit_alloc_str_copy(native, dst_reg, case_mode)
    returner 0
}

// Streng-likskap (byte-samanlikning) → bool NcVal (1 lik, 0 ulik).
funksjon emit_str_eq(native: liste_heiltall, left_reg: heiltall, right_reg: heiltall, dst_reg: heiltall) -> heiltall {
    // Typevakt: høgre operand må òg vere streng (type 3). Utan denne deref-a
    // str_eq [høgre+8] som strdata sjølv når høgre er int/null/bool — der [+8]
    // er den rå verdien (t.d. 0 for `null`), som gjev `ldr [0]`-krasj på
    // `streng == null`. VM-en gjer ulike typar → ulike.
    legg_u32(native, 0xD280000D)                        // movz x13, #0    (resultat = ulik)
    legg_u32(native, 0xF9400000 | (right_reg << 5) | 9) // ldr x9, [Xright]  (høgre type)
    legg_u32(native, 0xF1000D3F)                        // cmp x9, #3
    la p_bne_type = lengde(native)
    legg_u32(native, 0)                                 // b.ne eqdone  (høgre ikkje streng)
    legg_u32(native, 0xF9400400 | (left_reg << 5) | 9)  // ldr x9,  [Xleft, #8]
    legg_u32(native, 0xF9400400 | (right_reg << 5) | 10) // ldr x10, [Xright, #8]
    legg_u32(native, 0xF940012B)                        // ldr x11, [x9]   (lenL)
    legg_u32(native, 0xF940014C)                        // ldr x12, [x10]  (lenR)
    legg_u32(native, 0xEB0C017F)                        // cmp x11, x12
    la p_bne = lengde(native)
    legg_u32(native, 0)                                 // b.ne eqdone
    legg_u32(native, 0x91002129)                        // add x9, x9, #8
    legg_u32(native, 0x9100214A)                        // add x10, x10, #8
    la lbl_loop = lengde(native)
    la p_cbz = lengde(native)
    legg_u32(native, 0)                                 // cbz x11, eqmatch
    legg_u32(native, 0x39400120)                        // ldrb w0, [x9]
    legg_u32(native, 0x39400141)                        // ldrb w1, [x10]
    legg_u32(native, 0x6B01001F)                        // cmp w0, w1
    la p_bne2 = lengde(native)
    legg_u32(native, 0)                                 // b.ne eqdone
    legg_u32(native, 0x91000529)                        // add x9, x9, #1
    legg_u32(native, 0x9100054A)                        // add x10, x10, #1
    legg_u32(native, 0xD100056B)                        // sub x11, x11, #1
    la p_b_loop = lengde(native)
    legg_u32(native, 0)                                 // b loop
    la lbl_match = lengde(native)
    legg_u32(native, 0xD280002D)                        // movz x13, #1
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0D03E9)                        // mov x9, x13  (emit_ncval_alloc klobbar x13)
    emit_ncval_alloc(native, 9, dst_reg, 2)
    skriv_u32(native, p_bne_type, 0x54000001 | ((((lbl_done  - p_bne_type) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne,   0x54000001 | ((((lbl_done  - p_bne)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz,   0xB400000B | ((((lbl_match - p_cbz)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne2,  0x54000001 | ((((lbl_done  - p_bne2)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_loop,0x14000000 |  (((lbl_loop  - p_b_loop) / 4) & 0x03FFFFFF))
    returner 0
}

// index_of/contains: finn første posisjon av needle i hay. as_bool=usann →
// boks posisjonen (int, -1 om ikkje funne); as_bool=sann → boks (pos>=0) som bool.
funksjon emit_str_find(native: liste_heiltall, hay_reg: heiltall, needle_reg: heiltall, dst_reg: heiltall, as_bool: boolsk) -> heiltall {
    legg_u32(native, 0xF9400400 | (hay_reg << 5) | 9)    // ldr x9,  [Xhay, #8]
    legg_u32(native, 0xF9400400 | (needle_reg << 5) | 10) // ldr x10, [Xneedle, #8]
    legg_u32(native, 0xF940012B)                         // ldr x11, [x9]   (hlen)
    legg_u32(native, 0xF940014C)                         // ldr x12, [x10]  (nlen)
    legg_u32(native, 0x91002129)                         // add x9, x9, #8
    legg_u32(native, 0x9100214A)                         // add x10, x10, #8
    legg_u32(native, 0x9280000D)                         // movn x13, #0    (resultat = -1)
    legg_u32(native, 0xCB0C016F)                         // sub x15, x11, x12 (maxstart)
    legg_u32(native, 0xD280000E)                         // movz x14, #0    (i)
    la lbl_outer = lengde(native)
    legg_u32(native, 0xEB0F01DF)                         // cmp x14, x15
    la p_bgt_done = lengde(native)
    legg_u32(native, 0)                                  // b.gt done
    legg_u32(native, 0x8B0E0130)                         // add x16, x9, x14 (hayptr)
    legg_u32(native, 0xAA0A03F1)                         // mov x17, x10    (needleptr)
    legg_u32(native, 0xAA0C03E0)                         // mov x0, x12     (remaining)
    la p_cbz_match = lengde(native)
    legg_u32(native, 0)                                  // cbz x0, matchhere
    la lbl_cmploop = lengde(native)
    legg_u32(native, 0x39400201)                         // ldrb w1, [x16]
    legg_u32(native, 0x39400222)                         // ldrb w2, [x17]
    legg_u32(native, 0x6B02003F)                         // cmp w1, w2
    la p_bne_nomatch = lengde(native)
    legg_u32(native, 0)                                  // b.ne nomatch
    legg_u32(native, 0x91000610)                         // add x16, x16, #1
    legg_u32(native, 0x91000631)                         // add x17, x17, #1
    legg_u32(native, 0xD1000400)                         // sub x0, x0, #1
    la p_cbnz_cmp = lengde(native)
    legg_u32(native, 0)                                  // cbnz x0, cmploop
    la lbl_match = lengde(native)
    legg_u32(native, 0xAA0E03ED)                         // mov x13, x14    (resultat = i)
    la p_b_done = lengde(native)
    legg_u32(native, 0)                                  // b done
    la lbl_nomatch = lengde(native)
    legg_u32(native, 0x910005CE)                         // add x14, x14, #1
    la p_b_outer = lengde(native)
    legg_u32(native, 0)                                  // b outer
    la lbl_done = lengde(native)
    hvis as_bool {
        legg_u32(native, 0xF10001BF)                     // cmp x13, #0
        legg_u32(native, 0x1A9FB7E9)                     // cset w9, ge  (resultat i x9)
        emit_ncval_alloc(native, 9, dst_reg, 2)
    } ellers {
        legg_u32(native, 0xAA0D03E9)                     // mov x9, x13  (emit_ncval_alloc klobbar x13)
        emit_ncval_alloc(native, 9, dst_reg, 1)
    }
    skriv_u32(native, p_bgt_done,    0x5400000C | ((((lbl_done    - p_bgt_done)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_match,   0xB4000000 | ((((lbl_match   - p_cbz_match)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_nomatch, 0x54000001 | ((((lbl_nomatch - p_bne_nomatch) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_cmp,    0xB5000000 | ((((lbl_cmploop - p_cbnz_cmp)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_done,      0x14000000 |  (((lbl_done    - p_b_done)      / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_outer,     0x14000000 |  (((lbl_outer   - p_b_outer)     / 4) & 0x03FFFFFF))
    returner 0
}

// starts_with/ends_with: samanlikn needle mot hay ved offset 0 (starts) eller
// hlen-nlen (ends). ends=sann gjev ends_with. Resultat er bool.
funksjon emit_str_matchat(native: liste_heiltall, hay_reg: heiltall, needle_reg: heiltall, dst_reg: heiltall, ends: boolsk) -> heiltall {
    legg_u32(native, 0xF9400400 | (hay_reg << 5) | 9)    // ldr x9,  [Xhay, #8]
    legg_u32(native, 0xF9400400 | (needle_reg << 5) | 10) // ldr x10, [Xneedle, #8]
    legg_u32(native, 0xF940012B)                         // ldr x11, [x9]   (hlen)
    legg_u32(native, 0xF940014C)                         // ldr x12, [x10]  (nlen)
    legg_u32(native, 0xD280000D)                         // movz x13, #0    (resultat)
    legg_u32(native, 0xEB0B019F)                         // cmp x12, x11    (nlen ? hlen)
    la p_bgt_done = lengde(native)
    legg_u32(native, 0)                                  // b.gt done  (nlen>hlen → false)
    legg_u32(native, 0x91002129)                         // add x9, x9, #8
    hvis ends {
        legg_u32(native, 0xCB0C016E)                     // sub x14, x11, x12 (start=hlen-nlen)
        legg_u32(native, 0x8B0E0129)                     // add x9, x9, x14
    }
    legg_u32(native, 0x9100214A)                         // add x10, x10, #8
    la lbl_loop = lengde(native)
    la p_cbz_match = lengde(native)
    legg_u32(native, 0)                                  // cbz x12, match
    legg_u32(native, 0x39400120)                         // ldrb w0, [x9]
    legg_u32(native, 0x39400141)                         // ldrb w1, [x10]
    legg_u32(native, 0x6B01001F)                         // cmp w0, w1
    la p_bne_done = lengde(native)
    legg_u32(native, 0)                                  // b.ne done
    legg_u32(native, 0x91000529)                         // add x9, x9, #1
    legg_u32(native, 0x9100054A)                         // add x10, x10, #1
    legg_u32(native, 0xD100058C)                         // sub x12, x12, #1
    la p_b_loop = lengde(native)
    legg_u32(native, 0)                                  // b loop
    la lbl_match = lengde(native)
    legg_u32(native, 0xD280002D)                         // movz x13, #1
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0D03E9)                         // mov x9, x13  (emit_ncval_alloc klobbar x13)
    emit_ncval_alloc(native, 9, dst_reg, 2)
    skriv_u32(native, p_bgt_done,  0x5400000C | ((((lbl_done  - p_bgt_done)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_match, 0xB400000C | ((((lbl_match - p_cbz_match) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_done,  0x54000001 | ((((lbl_done  - p_bne_done)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_loop,    0x14000000 |  (((lbl_loop  - p_b_loop)    / 4) & 0x03FFFFFF))
    returner 0
}

// trim(streng): fjern leiande/etterfølgjande whitespace (byte <= 32) → ny streng.
funksjon emit_trim(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 9)  // ldr x9, [Xarg, #8]  (strdata)
    legg_u32(native, 0xF940012B)                       // ldr x11, [x9]  (len)
    legg_u32(native, 0x91002129)                       // add x9, x9, #8 (base)
    la lbl_lead = lengde(native)
    la p_cbz1 = lengde(native)
    legg_u32(native, 0)                                // cbz x11, tdone
    legg_u32(native, 0x39400120)                       // ldrb w0, [x9]
    legg_u32(native, 0x7100801F)                       // cmp w0, #32
    la p_bgt1 = lengde(native)
    legg_u32(native, 0)                                // b.gt leaddone
    legg_u32(native, 0x91000529)                       // add x9, x9, #1
    legg_u32(native, 0xD100056B)                       // sub x11, x11, #1
    la p_b_lead = lengde(native)
    legg_u32(native, 0)                                // b lead
    la lbl_leaddone = lengde(native)
    la lbl_trail = lengde(native)
    la p_cbz2 = lengde(native)
    legg_u32(native, 0)                                // cbz x11, tdone
    legg_u32(native, 0x8B0B012C)                       // add x12, x9, x11
    legg_u32(native, 0xD100058C)                       // sub x12, x12, #1  (siste byte)
    legg_u32(native, 0x39400180)                       // ldrb w0, [x12]
    legg_u32(native, 0x7100801F)                       // cmp w0, #32
    la p_bgt2 = lengde(native)
    legg_u32(native, 0)                                // b.gt traildone
    legg_u32(native, 0xD100056B)                       // sub x11, x11, #1
    la p_b_trail = lengde(native)
    legg_u32(native, 0)                                // b trail
    la lbl_traildone = lengde(native)
    la lbl_tdone = lengde(native)
    legg_u32(native, 0xAA0B03EA)                       // mov x10, x11  (len)
    emit_alloc_str_copy(native, dst_reg, 0)
    skriv_u32(native, p_cbz1, 0xB400000B | ((((lbl_tdone    - p_cbz1)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bgt1, 0x5400000C | ((((lbl_leaddone - p_bgt1)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_lead, 0x14000000 | (((lbl_lead    - p_b_lead) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz2, 0xB400000B | ((((lbl_tdone    - p_cbz2)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bgt2, 0x5400000C | ((((lbl_traildone- p_bgt2)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_trail, 0x14000000 | (((lbl_trail  - p_b_trail) / 4) & 0x03FFFFFF))
    returner 0
}

// tekst(int): formater heiltal → heap-streng (desimal). Byggjer siffera på
// maskinstakken (som emit_skriv_int) og kopierer inn i ein heap-streng.
funksjon emit_tekst_int(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xD10083FF)                       // sub sp, sp, #32
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 10) // ldr x10, [Xarg, #8]  (val)
    legg_u32(native, 0x910083EB)                       // add x11, sp, #32
    legg_u32(native, 0xAA0B03EC)                       // mov x12, x11
    legg_u32(native, 0xD280000D)                       // mov x13, #0  (neg)
    legg_u32(native, 0xD280014E)                       // mov x14, #10
    legg_u32(native, 0xF100015F)                       // cmp x10, #0
    la p_bne = lengde(native)
    legg_u32(native, 0)                                // b.ne notzero
    legg_u32(native, 0x52800609)                       // mov w9, #48
    legg_u32(native, 0xD100058C)                       // sub x12, x12, #1
    legg_u32(native, 0x39000189)                       // strb w9, [x12]
    la p_bzero = lengde(native)
    legg_u32(native, 0)                                // b conv_done
    la lbl_notzero = lengde(native)
    la p_bge = lengde(native)
    legg_u32(native, 0)                                // b.ge loop
    legg_u32(native, 0xD280002D)                       // mov x13, #1
    legg_u32(native, 0xCB0A03EA)                       // neg x10, x10
    la lbl_loop = lengde(native)
    legg_u32(native, 0x9ACE094F)                       // udiv x15, x10, x14
    legg_u32(native, 0x9B0EA9E9)                       // msub x9, x15, x14, x10
    legg_u32(native, 0x1100C129)                       // add w9, w9, #48
    legg_u32(native, 0xD100058C)                       // sub x12, x12, #1
    legg_u32(native, 0x39000189)                       // strb w9, [x12]
    legg_u32(native, 0xAA0F03EA)                       // mov x10, x15
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                                // cbnz x10, loop
    la p_cbz = lengde(native)
    legg_u32(native, 0)                                // cbz x13, conv_done
    legg_u32(native, 0x528005A9)                       // mov w9, #45
    legg_u32(native, 0xD100058C)                       // sub x12, x12, #1
    legg_u32(native, 0x39000189)                       // strb w9, [x12]
    la lbl_convdone = lengde(native)
    legg_u32(native, 0xCB0C0169)                       // sub x9, x11, x12  (len → x9 midlertidig)
    legg_u32(native, 0xAA0903EA)                       // mov x10, x9       (len)
    legg_u32(native, 0xAA0C03E9)                       // mov x9, x12       (src = writeptr)
    emit_alloc_str_copy(native, dst_reg, 0)
    legg_u32(native, 0x910083FF)                       // add sp, sp, #32
    skriv_u32(native, p_bne,   0x54000001 | ((((lbl_notzero - p_bne)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bzero, 0x14000000 |  (((lbl_convdone- p_bzero) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bge,   0x5400000A | ((((lbl_loop    - p_bge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz,  0xB500000A | ((((lbl_loop    - p_cbnz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz,   0xB400000D | ((((lbl_convdone- p_cbz)   / 4) & 0x7FFFF) << 5))
    returner 0
}

// tekst(x): type-bevisst. Streng (type=3) → identitet (som VM-en); elles →
// desimalformater heiltalet. Utan dette gjev tekst(streng) strdata-peikaren.
funksjon emit_tekst_ncval(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400000 | (arg_reg << 5) | 9)  // ldr x9, [Xarg]  (type)
    legg_u32(native, 0xF1000D3F)                       // cmp x9, #3
    la p_bne_int = lengde(native)
    legg_u32(native, 0)                                // b.ne do_int
    legg_u32(native, 0xAA0003E0 | (arg_reg << 16) | dst_reg)  // mov Xdst, Xarg (identitet)
    la p_b_end = lengde(native)
    legg_u32(native, 0)                                // b end
    la lbl_int = lengde(native)
    emit_tekst_int(native, arg_reg, dst_reg)
    la lbl_end = lengde(native)
    skriv_u32(native, p_bne_int, 0x54000001 | ((((lbl_int - p_bne_int) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_end,   0x14000000 |  (((lbl_end - p_b_end) / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 8: aliasnamn for tekst-/heltall-konvertering som nc_main brukar.
funksjon ncval_avkort_builtin(namn: tekst) -> tekst {
    hvis builtin.starts_with(namn, "builtin.") { returner builtin.slice(namn, 8, lengde(namn)) }
    returner namn
}
funksjon ncval_er_tekst_kall(namn: tekst) -> boolsk {
    la n = ncval_avkort_builtin(namn)
    returner n == "tekst" eller n == "tekst_fra_heltall" eller n == "tekst_fra_heiltall" eller n == "til_tekst"
}
funksjon ncval_er_heltall_kall(namn: tekst) -> boolsk {
    la n = ncval_avkort_builtin(namn)
    returner n == "heltall" eller n == "heltall_fra_tekst" eller n == "heiltall_fra_tekst" eller
        n == "tekst_til_heltall"
}

// Builtins utan native emitter enno: fail-closed stubb som kastar
// "NATIV-GAP:<namn>" som unnatak. Sidan nc_main-flata konsekvent pakkar desse
// i prøv/fang (grasiøs degradering, jf. native_argv), gjev throw ærleg
// "ikkje støtta"-semantikk utan å rive heile prosessen. Lista SKAL krympe
// etter kvart som ekte emitterar kjem inn; kvar fjerning må ha litmus.
funksjon ncval_gap_stub(namn: tekst) -> boolsk {
    la n = ncval_avkort_builtin(namn)
    hvis builtin.starts_with(n, "web.") { returner sann }
    hvis builtin.starts_with(n, "thread_") { returner sann }
    hvis builtin.starts_with(n, "semantic_") { returner sann }
    returner n == "argv_list_v1" eller n == "argv_operation" eller
        n == "host_exec_ncb_json" eller n == "system_operation" eller
        n == "sha256_bytes" eller n == "sha256" eller
        n == "filesystem_write_operation" eller n == "filesystem_read_operation" eller
        n == "jit_operation" eller n == "pbkdf2_sha256" eller n == "argon2id" eller
        n == "acme_sign" eller n == "acme_verify" eller n == "dns_lookup" eller
        n == "ncb_call_fn" eller n == "kompiler_fil" eller
        n == "exec_prosess" eller n == "process_spawn_argv" eller n == "process_operation" eller
        n == "native_mkdir_p" eller n == "mkdir_p" eller n == "network_operation" eller
        n == "atomic_operation" eller n == "tensor_operation" eller
        n == "socket_send_bytes" eller n == "socket_recv_bytes" eller n == "socket_settimeout" eller
        n == "wasm_selftest" eller n == "ncb_route_handlers" eller
        n == "n" eller n == "desimaltall"
}

// Fase 8: builtin.type(x) → typenamn-streng (køyretids-dispatch på NcVal-tagg).
// 1→"heltall", 2→"boolsk", 3→"tekst", 4→"liste", 5→"kart".
funksjon emit_type_ncval(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400000 | (arg_reg << 5) | 9)  // ldr x9, [Xarg]  (type)
    legg_u32(native, 0xF100113F)                       // cmp x9, #4
    la p_liste = lengde(native)
    legg_u32(native, 0)                                // b.eq liste
    legg_u32(native, 0xF100153F)                       // cmp x9, #5
    la p_kart = lengde(native)
    legg_u32(native, 0)                                // b.eq kart
    legg_u32(native, 0xF1000D3F)                       // cmp x9, #3
    la p_tekst = lengde(native)
    legg_u32(native, 0)                                // b.eq tekst
    legg_u32(native, 0xF100093F)                       // cmp x9, #2
    la p_boolsk = lengde(native)
    legg_u32(native, 0)                                // b.eq boolsk
    emit_ncval_str_const(native, "heltall", dst_reg)   // default (int)
    la p_end1 = lengde(native)
    legg_u32(native, 0)                                // b end
    la lbl_boolsk = lengde(native)
    emit_ncval_str_const(native, "boolsk", dst_reg)
    la p_end2 = lengde(native)
    legg_u32(native, 0)                                // b end
    la lbl_tekst = lengde(native)
    emit_ncval_str_const(native, "tekst", dst_reg)
    la p_end3 = lengde(native)
    legg_u32(native, 0)                                // b end
    la lbl_kart = lengde(native)
    emit_ncval_str_const(native, "ordbok", dst_reg)     // VM-en kallar kart "ordbok"
    la p_end4 = lengde(native)
    legg_u32(native, 0)                                // b end
    la lbl_liste = lengde(native)
    emit_ncval_str_const(native, "liste", dst_reg)
    la lbl_end = lengde(native)
    skriv_u32(native, p_liste,  0x54000000 | ((((lbl_liste  - p_liste)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_kart,   0x54000000 | ((((lbl_kart   - p_kart)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_tekst,  0x54000000 | ((((lbl_tekst  - p_tekst)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_boolsk, 0x54000000 | ((((lbl_boolsk - p_boolsk) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_end1,   0x14000000 |  (((lbl_end - p_end1) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_end2,   0x14000000 |  (((lbl_end - p_end2) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_end3,   0x14000000 |  (((lbl_end - p_end3) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_end4,   0x14000000 |  (((lbl_end - p_end4) / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 8: nøkler(kart) → liste av nøklane (kvar andre slot i mapdata).
funksjon emit_noekler(native: liste_heiltall, map_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (map_reg << 5) | 9)  // ldr x9, [Xmap, #8] (mapdata)
    legg_u32(native, 0xF940012A)                       // ldr x10, [x9]  (count)
    legg_u32(native, 0x91002129)                       // add x9, x9, #8 (&par[0])
    legg_u32(native, 0xAA1C03EE)                       // mov x14, x28  (ny listdata)
    legg_u32(native, 0xF90001CA)                       // str x10, [x14] (count)
    legg_u32(native, 0x910021CF)                       // add x15, x14, #8
    legg_u32(native, 0xD280000B)                       // movz x11, #0
    la lbl_loop = lengde(native)
    legg_u32(native, 0xEB0A017F)                       // cmp x11, x10
    la p_ge = lengde(native)
    legg_u32(native, 0)                                // b.ge done
    legg_u32(native, 0xF940012C)                       // ldr x12, [x9]  (nøkkel)
    legg_u32(native, 0xF90001EC)                       // str x12, [x15]
    legg_u32(native, 0x91004129)                       // add x9, x9, #16 (neste par)
    legg_u32(native, 0x910021EF)                       // add x15, x15, #8
    legg_u32(native, 0x9100056B)                       // add x11, x11, #1
    la p_loop = lengde(native)
    legg_u32(native, 0)                                // b loop
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0F03FC)                       // mov x28, x15
    emit_ncval_alloc_ptr(native, 14, dst_reg, 4)       // boks som liste
    skriv_u32(native, p_ge,   0x5400000A | ((((lbl_done - p_ge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_loop, 0x14000000 |  (((lbl_loop - p_loop) / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 8: verdier(kart) → liste av verdiane (kvar andre slot frå og med val0).
funksjon emit_verdier(native: liste_heiltall, map_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (map_reg << 5) | 9)  // ldr x9, [Xmap, #8] (mapdata)
    legg_u32(native, 0xF940012A)                       // ldr x10, [x9]  (count)
    legg_u32(native, 0x91004129)                       // add x9, x9, #16 (&val[0])
    legg_u32(native, 0xAA1C03EE)                       // mov x14, x28
    legg_u32(native, 0xF90001CA)                       // str x10, [x14] (count)
    legg_u32(native, 0x910021CF)                       // add x15, x14, #8
    legg_u32(native, 0xD280000B)                       // movz x11, #0
    la lbl_loop = lengde(native)
    legg_u32(native, 0xEB0A017F)                       // cmp x11, x10
    la p_ge = lengde(native)
    legg_u32(native, 0)                                // b.ge done
    legg_u32(native, 0xF940012C)                       // ldr x12, [x9]  (verdi)
    legg_u32(native, 0xF90001EC)                       // str x12, [x15]
    legg_u32(native, 0x91004129)                       // add x9, x9, #16 (neste par)
    legg_u32(native, 0x910021EF)                       // add x15, x15, #8
    legg_u32(native, 0x9100056B)                       // add x11, x11, #1
    la p_loop = lengde(native)
    legg_u32(native, 0)                                // b loop
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0F03FC)                       // mov x28, x15
    emit_ncval_alloc_ptr(native, 14, dst_reg, 4)       // boks som liste
    skriv_u32(native, p_ge,   0x5400000A | ((((lbl_done - p_ge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_loop, 0x14000000 |  (((lbl_loop - p_loop) / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 8: fjern_siste(liste) → fjern og returner siste element (dekrementer count).
// Muterer lista på plass (count-1); resultat = det poppa elementet i Xdst.
funksjon emit_fjern_siste(native: liste_heiltall, list_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (list_reg << 5) | 9) // ldr x9, [Xliste, #8] (listdata)
    legg_u32(native, 0xF940012A)                       // ldr x10, [x9]  (count)
    legg_u32(native, 0xD100054B)                       // sub x11, x10, #1 (count-1)
    legg_u32(native, 0xF900012B)                       // str x11, [x9]  (dekrementer count)
    legg_u32(native, 0x9100212C)                       // add x12, x9, #8 (&elem[0])
    legg_u32(native, 0x8B0B0D8C)                       // add x12, x12, x11, lsl #3 (&elem[count-1])
    legg_u32(native, 0xF9400180 | dst_reg)             // ldr Xdst, [x12]  (siste element)
    returner 0
}

// Fase 8: fjern_nokkel(kart, nøkkel) — finn nøkkelen og fjern paret (skyv
// resterande par ned 16 byte, dekrementer count). Muterer kartet på plass.
// Scratch x0–x6, x9–x17.
funksjon emit_fjern_nokkel(native: liste_heiltall, map_reg: heiltall, key_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (map_reg << 5) | 9)  // ldr x9, [Xmap, #8] (mapdata)
    legg_u32(native, 0xF940012A)                       // ldr x10, [x9]  (count)
    legg_u32(native, 0x91002129)                       // add x9, x9, #8 (&par[0])
    legg_u32(native, 0xF9400400 | (key_reg << 5) | 11) // ldr x11, [Xkey, #8] (nøkkel-strdata)
    legg_u32(native, 0xF940016C)                       // ldr x12, [x11] (nøkkel-len)
    legg_u32(native, 0x9100216B)                       // add x11, x11, #8 (nøkkel-bytes)
    legg_u32(native, 0xD280000E)                       // movz x14, #0 (i)
    la lbl_scan = lengde(native)
    legg_u32(native, 0xEB0A01DF)                       // cmp x14, x10
    la p_ge = lengde(native)
    legg_u32(native, 0)                                // b.ge done
    legg_u32(native, 0x8B0E112F)                       // add x15, x9, x14, lsl #4 (&par[i])
    legg_u32(native, 0xF94001E0)                       // ldr x0, [x15] (lagra nøkkel)
    legg_u32(native, 0xF9400401)                       // ldr x1, [x0, #8]
    legg_u32(native, 0xF9400022)                       // ldr x2, [x1] (len)
    legg_u32(native, 0xEB0C005F)                       // cmp x2, x12
    la p_bne = lengde(native)
    legg_u32(native, 0)                                // b.ne next
    legg_u32(native, 0x91002021)                       // add x1, x1, #8
    legg_u32(native, 0xAA0B03E3)                       // mov x3, x11
    legg_u32(native, 0xAA0C03E4)                       // mov x4, x12
    la p_cbz_match = lengde(native)
    legg_u32(native, 0)                                // cbz x4, matched
    la lbl_byte = lengde(native)
    legg_u32(native, 0x39400025)                       // ldrb w5, [x1]
    legg_u32(native, 0x39400066)                       // ldrb w6, [x3]
    legg_u32(native, 0x6B0600BF)                       // cmp w5, w6
    la p_bne2 = lengde(native)
    legg_u32(native, 0)                                // b.ne next
    legg_u32(native, 0x91000421)                       // add x1, x1, #1
    legg_u32(native, 0x91000463)                       // add x3, x3, #1
    legg_u32(native, 0xD1000484)                       // sub x4, x4, #1
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                                // cbnz x4, byte
    la lbl_matched = lengde(native)
    legg_u32(native, 0x910041F0)                       // add x16, x15, #16 (src = &par[i+1])
    legg_u32(native, 0xAA0F03F1)                       // mov x17, x15 (dst = &par[i])
    legg_u32(native, 0xCB0E0140)                       // sub x0, x10, x14 (count-i)
    legg_u32(native, 0xD1000400)                       // sub x0, x0, #1 (par å skyve)
    legg_u32(native, 0x8B000000)                       // add x0, x0, x0 (*2 = slots)
    la lbl_shift = lengde(native)
    la p_cbz_shift = lengde(native)
    legg_u32(native, 0)                                // cbz x0, shiftdone
    legg_u32(native, 0xF9400201)                       // ldr x1, [x16]
    legg_u32(native, 0xF9000221)                       // str x1, [x17]
    legg_u32(native, 0x91002210)                       // add x16, x16, #8
    legg_u32(native, 0x91002231)                       // add x17, x17, #8
    legg_u32(native, 0xD1000400)                       // sub x0, x0, #1
    la p_b_shift = lengde(native)
    legg_u32(native, 0)                                // b shift
    la lbl_shiftdone = lengde(native)
    legg_u32(native, 0xD100054A)                       // sub x10, x10, #1 (ny count)
    legg_u32(native, 0xF9400400 | (map_reg << 5) | 9)  // ldr x9, [Xmap, #8]
    legg_u32(native, 0xF900012A)                       // str x10, [x9]
    la p_b_done = lengde(native)
    legg_u32(native, 0)                                // b done
    la lbl_next = lengde(native)
    legg_u32(native, 0x910005CE)                       // add x14, x14, #1
    la p_b_scan = lengde(native)
    legg_u32(native, 0)                                // b scan
    la lbl_done = lengde(native)
    skriv_u32(native, p_ge,        0x5400000A | ((((lbl_done     - p_ge)        / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne,       0x54000001 | ((((lbl_next     - p_bne)       / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_match, 0xB4000004 | ((((lbl_matched  - p_cbz_match) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne2,      0x54000001 | ((((lbl_next     - p_bne2)      / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz,      0xB5000004 | ((((lbl_byte     - p_cbnz)      / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_shift, 0xB4000000 | ((((lbl_shiftdone - p_cbz_shift)/ 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_shift,   0x14000000 |  (((lbl_shift    - p_b_shift)   / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_done,    0x14000000 |  (((lbl_done     - p_b_done)    / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_scan,    0x14000000 |  (((lbl_scan     - p_b_scan)    / 4) & 0x03FFFFFF))
    returner 0
}

// heltall(streng): parse desimalstreng → int (valfri leiande '-').
funksjon emit_heltall_str(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 9)  // ldr x9, [Xarg, #8]
    legg_u32(native, 0xF940012B)                       // ldr x11, [x9]  (len)
    legg_u32(native, 0x91002129)                       // add x9, x9, #8 (base)
    legg_u32(native, 0xD280000A)                       // movz x10, #0  (resultat)
    legg_u32(native, 0xD280000D)                       // movz x13, #0  (neg)
    legg_u32(native, 0xD280014E)                       // mov x14, #10
    la p_cbz_len = lengde(native)
    legg_u32(native, 0)                                // cbz x11, hdone
    legg_u32(native, 0x39400120)                       // ldrb w0, [x9]
    legg_u32(native, 0x7100B41F)                       // cmp w0, #45 ('-')
    la p_bne_digits = lengde(native)
    legg_u32(native, 0)                                // b.ne digits
    legg_u32(native, 0xD280002D)                       // movz x13, #1
    legg_u32(native, 0x91000529)                       // add x9, x9, #1
    legg_u32(native, 0xD100056B)                       // sub x11, x11, #1
    la lbl_digits = lengde(native)
    la p_cbz_d = lengde(native)
    legg_u32(native, 0)                                // cbz x11, applysign
    legg_u32(native, 0x39400120)                       // ldrb w0, [x9]
    legg_u32(native, 0x5100C000)                       // sub w0, w0, #48
    legg_u32(native, 0x9B0E7D4A)                       // mul x10, x10, x14
    legg_u32(native, 0x8B00014A)                       // add x10, x10, x0
    legg_u32(native, 0x91000529)                       // add x9, x9, #1
    legg_u32(native, 0xD100056B)                       // sub x11, x11, #1
    la p_b_digits = lengde(native)
    legg_u32(native, 0)                                // b digits
    la lbl_applysign = lengde(native)
    la p_cbz_sign = lengde(native)
    legg_u32(native, 0)                                // cbz x13, hdone
    legg_u32(native, 0xCB0A03EA)                       // neg x10, x10
    la lbl_hdone = lengde(native)
    emit_ncval_alloc(native, 10, dst_reg, 1)
    skriv_u32(native, p_cbz_len,    0xB400000B | ((((lbl_hdone     - p_cbz_len)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_digits, 0x54000001 | ((((lbl_digits    - p_bne_digits) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_d,      0xB400000B | ((((lbl_applysign - p_cbz_d)      / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_digits,   0x14000000 |  (((lbl_digits    - p_b_digits)   / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz_sign,   0xB400000D | ((((lbl_hdone     - p_cbz_sign)   / 4) & 0x7FFFF) << 5))
    returner 0
}

// replace(s, from, to): erstatt alle førekomstar av `from` med `to` → ny streng.
// Variabel utlengd. Scratch: x1–x15 (ingen syscall, så x8 er fri). x9/x10/x11 =
// s/from/to bytes; x1/x2/x3 = lengder; x4 = i; x14/x15 = ut-base/skrivepeikar.
funksjon emit_replace(native: liste_heiltall, s_reg: heiltall, from_reg: heiltall, to_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (s_reg << 5) | 9)     // ldr x9,  [Xs, #8]
    legg_u32(native, 0xF9400400 | (from_reg << 5) | 10) // ldr x10, [Xfrom, #8]
    legg_u32(native, 0xF9400400 | (to_reg << 5) | 11)   // ldr x11, [Xto, #8]
    legg_u32(native, 0xF9400121)                        // ldr x1, [x9]   (slen)
    legg_u32(native, 0xF9400142)                        // ldr x2, [x10]  (fromlen)
    legg_u32(native, 0xF9400163)                        // ldr x3, [x11]  (tolen)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8
    legg_u32(native, 0x9100214A)                        // add x10, x10, #8
    legg_u32(native, 0x9100216B)                        // add x11, x11, #8
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28   (ut-base)
    legg_u32(native, 0x910021CF)                        // add x15, x14, #8 (skrivepeikar)
    legg_u32(native, 0xD2800004)                        // movz x4, #0    (i)
    la lbl_outer = lengde(native)
    legg_u32(native, 0xEB01009F)                        // cmp x4, x1
    la p_bge_done = lengde(native)
    legg_u32(native, 0)                                 // b.ge repdone
    legg_u32(native, 0xCB040025)                        // sub x5, x1, x4 (remaining)
    la p_cbz_from = lengde(native)
    legg_u32(native, 0)                                 // cbz x2, copybyte
    legg_u32(native, 0xEB0200BF)                        // cmp x5, x2
    la p_blt_copy = lengde(native)
    legg_u32(native, 0)                                 // b.lt copybyte
    legg_u32(native, 0x8B040126)                        // add x6, x9, x4 (sptr)
    legg_u32(native, 0xAA0A03E7)                        // mov x7, x10   (fromptr)
    legg_u32(native, 0xAA0203E8)                        // mov x8, x2    (count)
    la lbl_matchloop = lengde(native)
    legg_u32(native, 0x394000CC)                        // ldrb w12, [x6]
    legg_u32(native, 0x394000ED)                        // ldrb w13, [x7]
    legg_u32(native, 0x6B0D019F)                        // cmp w12, w13
    la p_bne_copy = lengde(native)
    legg_u32(native, 0)                                 // b.ne copybyte
    legg_u32(native, 0x910004C6)                        // add x6, x6, #1
    legg_u32(native, 0x910004E7)                        // add x7, x7, #1
    legg_u32(native, 0xD1000508)                        // sub x8, x8, #1
    la p_cbnz_match = lengde(native)
    legg_u32(native, 0)                                 // cbnz x8, matchloop
    // matcha: kopier `to`, hopp i fram med fromlen
    legg_u32(native, 0xAA0B03E6)                        // mov x6, x11   (toptr)
    legg_u32(native, 0xAA0303E8)                        // mov x8, x3    (tolen)
    la p_cbz_to = lengde(native)
    legg_u32(native, 0)                                 // cbz x8, skip_to
    la lbl_tocopy = lengde(native)
    legg_u32(native, 0x394000CC)                        // ldrb w12, [x6]
    legg_u32(native, 0x390001EC)                        // strb w12, [x15]
    legg_u32(native, 0x910004C6)                        // add x6, x6, #1
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0xD1000508)                        // sub x8, x8, #1
    la p_cbnz_to = lengde(native)
    legg_u32(native, 0)                                 // cbnz x8, tocopy
    la lbl_skipto = lengde(native)
    legg_u32(native, 0x8B020084)                        // add x4, x4, x2 (i += fromlen)
    la p_b_outer1 = lengde(native)
    legg_u32(native, 0)                                 // b outer
    la lbl_copybyte = lengde(native)
    legg_u32(native, 0x8B040126)                        // add x6, x9, x4
    legg_u32(native, 0x394000CC)                        // ldrb w12, [x6]
    legg_u32(native, 0x390001EC)                        // strb w12, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0x91000484)                        // add x4, x4, #1
    la p_b_outer2 = lengde(native)
    legg_u32(native, 0)                                 // b outer
    la lbl_repdone = lengde(native)
    legg_u32(native, 0xCB0E01E5)                        // sub x5, x15, x14  (8 + outlen)
    legg_u32(native, 0xD10020A5)                        // sub x5, x5, #8    (outlen)
    legg_u32(native, 0xF90001C5)                        // str x5, [x14]     (lengd)
    legg_u32(native, 0xAA0F03FC)                        // mov x28, x15
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    skriv_u32(native, p_bge_done,   0x5400000A | ((((lbl_repdone  - p_bge_done)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_from,   0xB4000002 | ((((lbl_copybyte - p_cbz_from)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_blt_copy,   0x5400000B | ((((lbl_copybyte - p_blt_copy)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_copy,   0x54000001 | ((((lbl_copybyte - p_bne_copy)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_match, 0xB5000008 | ((((lbl_matchloop- p_cbnz_match) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_to,     0xB4000008 | ((((lbl_skipto   - p_cbz_to)     / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_to,    0xB5000008 | ((((lbl_tocopy   - p_cbnz_to)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_outer1,   0x14000000 |  (((lbl_outer    - p_b_outer1)   / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_outer2,   0x14000000 |  (((lbl_outer    - p_b_outer2)   / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 4: NcVal-liste (type=4) = {val → [i64 count][elem0 ptr][elem1 ptr]…}.
// Elementa ligg i påfølgjande operand-register (OPREG(d)=19+d) frå first_reg.
funksjon emit_build_list(native: liste_heiltall, n: heiltall, first_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28  (listdata-base)
    prøv { last_heiltall(native, 9, n) } fang (e) { kast "NcVal liste for lang" }
    legg_u32(native, 0xF90001C9)                        // str x9, [x14]  (count)
    la i = 0
    mens i < n {
        la src = first_reg + i
        legg_u32(native, 0xF9000000 | ((1 + i) << 10) | (14 << 5) | src) // str Xsrc, [x14, #8+i*8]
        i = i + 1
    }
    la total = 8 + n * 8
    hvis total > 4095 { kast "NcVal liste for stor for eitt add-steg" }
    legg_u32(native, 0x91000000 | (total << 10) | (14 << 5) | 28)       // add x28, x14, #total
    emit_ncval_alloc_ptr(native, 14, dst_reg, 4)
    returner 0
}

// Fase 4: NcVal-kart (type=5) = {val → [i64 count][key0 ptr][val0 ptr]…}.
// Para ligg i påfølgjande register frå first_reg (key0,val0,key1,val1,…).
funksjon emit_build_map(native: liste_heiltall, npairs: heiltall, first_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28
    prøv { last_heiltall(native, 9, npairs) } fang (e) { kast "NcVal kart for stort" }
    legg_u32(native, 0xF90001C9)                        // str x9, [x14]  (count)
    la m = npairs * 2
    la i = 0
    mens i < m {
        la src = first_reg + i
        legg_u32(native, 0xF9000000 | ((1 + i) << 10) | (14 << 5) | src) // str Xsrc, [x14, #8+i*8]
        i = i + 1
    }
    la total = 8 + m * 8
    hvis total > 4095 { kast "NcVal kart for stort for eitt add-steg" }
    legg_u32(native, 0x91000000 | (total << 10) | (14 << 5) | 28)       // add x28, x14, #total
    emit_ncval_alloc_ptr(native, 14, dst_reg, 5)
    returner 0
}

// Fase 4: lineær kart-oppslag. want_bool=sann → boks (funne?1:0); elles → legg
// verdipeikaren (eller nil=0) i Xdst. Nøklane er NcVal-strengar (byte-samanlikning).
// Scratch: x0–x6, x9–x17.
funksjon emit_map_get(native: liste_heiltall, map_reg: heiltall, key_reg: heiltall, dst_reg: heiltall, want_bool: boolsk) -> heiltall {
    legg_u32(native, 0xF9400400 | (map_reg << 5) | 9)   // ldr x9,  [Xmap, #8]  (mapdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]   (count)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8  (første par)
    legg_u32(native, 0xF9400400 | (key_reg << 5) | 11)  // ldr x11, [Xkey, #8] (nøkkel-strdata)
    legg_u32(native, 0xF940016C)                        // ldr x12, [x11]  (nøkkel-lengd)
    legg_u32(native, 0x9100216B)                        // add x11, x11, #8 (nøkkel-bytes)
    legg_u32(native, 0xD280000D)                        // movz x13, #0    (resultat = nil)
    legg_u32(native, 0xD280000E)                        // movz x14, #0    (funne)
    legg_u32(native, 0xD280000F)                        // movz x15, #0    (i)
    la lbl_outer = lengde(native)
    legg_u32(native, 0xEB0A01FF)                        // cmp x15, x10
    la p_bge_done = lengde(native)
    legg_u32(native, 0)                                 // b.ge done
    legg_u32(native, 0x8B0F1131)                        // add x17, x9, x15, lsl #4  (par-base)
    legg_u32(native, 0xF9400220)                        // ldr x0, [x17]   (lagra nøkkel-NcVal)
    legg_u32(native, 0xF9400401)                        // ldr x1, [x0, #8] (lagra nøkkel-strdata)
    legg_u32(native, 0xF9400022)                        // ldr x2, [x1]    (lagra nøkkel-lengd)
    legg_u32(native, 0xEB0C005F)                        // cmp x2, x12
    la p_bne_next1 = lengde(native)
    legg_u32(native, 0)                                 // b.ne nextpair
    legg_u32(native, 0x91002021)                        // add x1, x1, #8  (lagra nøkkel-bytes)
    legg_u32(native, 0xAA0B03E3)                        // mov x3, x11     (søkenøkkel-bytes)
    legg_u32(native, 0xAA0C03E4)                        // mov x4, x12     (att)
    la p_cbz_match = lengde(native)
    legg_u32(native, 0)                                 // cbz x4, matchpair
    la lbl_byteloop = lengde(native)
    legg_u32(native, 0x39400025)                        // ldrb w5, [x1]
    legg_u32(native, 0x39400066)                        // ldrb w6, [x3]
    legg_u32(native, 0x6B0600BF)                        // cmp w5, w6
    la p_bne_next2 = lengde(native)
    legg_u32(native, 0)                                 // b.ne nextpair
    legg_u32(native, 0x91000421)                        // add x1, x1, #1
    legg_u32(native, 0x91000463)                        // add x3, x3, #1
    legg_u32(native, 0xD1000484)                        // sub x4, x4, #1
    la p_cbnz_byte = lengde(native)
    legg_u32(native, 0)                                 // cbnz x4, byteloop
    la lbl_matchpair = lengde(native)
    legg_u32(native, 0xF940062D)                        // ldr x13, [x17, #8]  (verdipeikar)
    legg_u32(native, 0xD280002E)                        // movz x14, #1    (funne)
    la p_b_done = lengde(native)
    legg_u32(native, 0)                                 // b done
    la lbl_nextpair = lengde(native)
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    la p_b_outer = lengde(native)
    legg_u32(native, 0)                                 // b outer
    la lbl_done = lengde(native)
    hvis want_bool {
        legg_u32(native, 0xAA0E03E9)                    // mov x9, x14
        emit_ncval_alloc(native, 9, dst_reg, 2)
    } ellers {
        legg_u32(native, 0xAA0D03E0 | dst_reg)          // mov Xdst, x13  (verdipeikar/nil)
    }
    skriv_u32(native, p_bge_done,  0x5400000A | ((((lbl_done      - p_bge_done)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_next1, 0x54000001 | ((((lbl_nextpair  - p_bne_next1) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_match, 0xB4000004 | ((((lbl_matchpair - p_cbz_match) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_next2, 0x54000001 | ((((lbl_nextpair  - p_bne_next2) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_byte, 0xB5000004 | ((((lbl_byteloop  - p_cbnz_byte) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_done,    0x14000000 |  (((lbl_done      - p_b_done)    / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_outer,   0x14000000 |  (((lbl_outer     - p_b_outer)   / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 4: INDEX_GET — container[index]. type-dispatch: liste (int-indeks) eller
// kart (streng-nøkkel). Resultat i Xdst.
funksjon emit_index_get(native: liste_heiltall, cont_reg: heiltall, idx_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400000 | (cont_reg << 5) | 9)  // ldr x9, [Xcont]  (type)
    legg_u32(native, 0xF100113F)                        // cmp x9, #4  (liste?)
    la p_bne_notlist = lengde(native)
    legg_u32(native, 0)                                 // b.ne notlist
    // liste: elem = [listdata + 8 + idx*8]
    legg_u32(native, 0xF9400400 | (cont_reg << 5) | 10) // ldr x10, [Xcont, #8] (listdata)
    legg_u32(native, 0xB9400800 | (idx_reg << 5) | 11)  // ldr w11, [Xidx, #8]  (int-indeks)
    legg_u32(native, 0x9100214A)                        // add x10, x10, #8
    legg_u32(native, 0x8B0B0D4A)                        // add x10, x10, x11, lsl #3
    legg_u32(native, 0xF9400140 | dst_reg)              // ldr Xdst, [x10]
    la p_b_end1 = lengde(native)
    legg_u32(native, 0)                                 // b end
    la lbl_notlist = lengde(native)
    // streng (type 3): s[i] = 1-teikns streng frå byte i. Utan denne grena fall
    // strengindeksering ned i kart-vegen og deref-a int-indeksen som peikar
    // (null-deref på indeks 0). VM-en returnerer eit 1-teikns byte-substreng.
    legg_u32(native, 0xF1000D3F)                        // cmp x9, #3  (streng?)
    la p_bne_map = lengde(native)
    legg_u32(native, 0)                                 // b.ne map
    legg_u32(native, 0xF9400400 | (cont_reg << 5) | 10) // ldr x10, [Xcont, #8] (strdata)
    legg_u32(native, 0xB9400800 | (idx_reg << 5) | 11)  // ldr w11, [Xidx, #8]  (int-indeks)
    legg_u32(native, 0x9100214A)                        // add x10, x10, #8     (bytes-start)
    legg_u32(native, 0x386B694C)                        // ldrb w12, [x10, x11] (byte i)
    legg_u32(native, 0xAA1C03E9)                        // mov x9, x28          (ny strdata-base)
    legg_u32(native, 0xD280002D)                        // movz x13, #1
    legg_u32(native, 0xF900012D)                        // str x13, [x9]        (lengd = 1)
    legg_u32(native, 0x3900212C)                        // strb w12, [x9, #8]   (byten)
    legg_u32(native, 0x9100439C)                        // add x28, x28, #16
    emit_ncval_alloc_ptr(native, 9, dst_reg, 3)         // boks som streng (type 3)
    la p_b_end2 = lengde(native)
    legg_u32(native, 0)                                 // b end
    la lbl_map = lengde(native)
    emit_map_get(native, cont_reg, idx_reg, dst_reg, usann)
    la lbl_end = lengde(native)
    skriv_u32(native, p_bne_notlist, 0x54000001 | ((((lbl_notlist - p_bne_notlist) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_end1,      0x14000000 |  (((lbl_end - p_b_end1)   / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bne_map,     0x54000001 | ((((lbl_map - p_bne_map)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_end2,      0x14000000 |  (((lbl_end - p_b_end2)   / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 8: INDEX_SET — obj[indeks] = verdi (køyretids-type-dispatch). Liste(4):
// skriv verdi-peikaren på plass i listdata[8+idx*8]. Kart(5): finn nøkkelen
// (byte-samanlikning) og oppdater verdipeikaren; finst han ikkje, veks kartet
// (nytt mapdata med count+1 par, kopier, legg til) og oppdater [Xobj+8]. Obj-
// NcVal-peikaren blir ståande i Xobj_reg (kompilatoren ventar obj att på stakken).
// Scratch: x0–x6, x9–x17. Rører ikkje operand-/locals-/heap-registera (utanom x28).
funksjon emit_index_set(native: liste_heiltall, obj_reg: heiltall, idx_reg: heiltall, val_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400000 | (obj_reg << 5) | 9)   // ldr x9, [Xobj]  (type)
    legg_u32(native, 0xF100113F)                        // cmp x9, #4  (liste?)
    la p_bne_map = lengde(native)
    legg_u32(native, 0)                                 // b.ne map
    // --- liste ---
    legg_u32(native, 0xF9400400 | (obj_reg << 5) | 10)  // ldr x10, [Xobj, #8] (listdata)
    legg_u32(native, 0xF9400400 | (idx_reg << 5) | 11)  // ldr x11, [Xidx, #8] (idx)
    legg_u32(native, 0x9100214C)                        // add x12, x10, #8   (&elem[0])
    legg_u32(native, 0x8B0B0D8C)                        // add x12, x12, x11, lsl #3
    legg_u32(native, 0xF9000180 | val_reg)              // str Xval, [x12]
    la p_b_done1 = lengde(native)
    legg_u32(native, 0)                                 // b done
    // --- kart: skann etter nøkkel ---
    la lbl_map = lengde(native)
    legg_u32(native, 0xF9400400 | (obj_reg << 5) | 9)   // ldr x9, [Xobj, #8] (mapdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (count)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8 (&par[0])
    legg_u32(native, 0xF9400400 | (idx_reg << 5) | 11)  // ldr x11, [Xidx, #8] (nøkkel-strdata)
    legg_u32(native, 0xF940016C)                        // ldr x12, [x11] (nøkkel-len)
    legg_u32(native, 0x9100216B)                        // add x11, x11, #8 (nøkkel-bytes)
    legg_u32(native, 0xD280000E)                        // movz x14, #0  (i)
    legg_u32(native, 0xD2800011)                        // movz x17, #0  (funnen par-base, 0=nei)
    la lbl_scan = lengde(native)
    legg_u32(native, 0xEB0A01DF)                        // cmp x14, x10
    la p_scan_ge = lengde(native)
    legg_u32(native, 0)                                 // b.ge scan_done
    legg_u32(native, 0x8B0E112F)                        // add x15, x9, x14, lsl #4  (&par[i])
    legg_u32(native, 0xF94001E0)                        // ldr x0, [x15]  (lagra nøkkel)
    legg_u32(native, 0xF9400401)                        // ldr x1, [x0, #8] (lagra nøkkel-strdata)
    legg_u32(native, 0xF9400022)                        // ldr x2, [x1]   (lagra nøkkel-len)
    legg_u32(native, 0xEB0C005F)                        // cmp x2, x12
    la p_bne_next = lengde(native)
    legg_u32(native, 0)                                 // b.ne map_next
    legg_u32(native, 0x91002021)                        // add x1, x1, #8 (lagra nøkkel-bytes)
    legg_u32(native, 0xAA0B03E3)                        // mov x3, x11
    legg_u32(native, 0xAA0C03E4)                        // mov x4, x12
    la p_cbz_match = lengde(native)
    legg_u32(native, 0)                                 // cbz x4, matched
    la lbl_byteloop = lengde(native)
    legg_u32(native, 0x39400025)                        // ldrb w5, [x1]
    legg_u32(native, 0x39400066)                        // ldrb w6, [x3]
    legg_u32(native, 0x6B0600BF)                        // cmp w5, w6
    la p_bne_next2 = lengde(native)
    legg_u32(native, 0)                                 // b.ne map_next
    legg_u32(native, 0x91000421)                        // add x1, x1, #1
    legg_u32(native, 0x91000463)                        // add x3, x3, #1
    legg_u32(native, 0xD1000484)                        // sub x4, x4, #1
    la p_cbnz_byte = lengde(native)
    legg_u32(native, 0)                                 // cbnz x4, byteloop
    la lbl_matched = lengde(native)
    legg_u32(native, 0xAA0F03F1)                        // mov x17, x15  (par-base funnen)
    la p_b_scandone = lengde(native)
    legg_u32(native, 0)                                 // b scan_done
    la lbl_next = lengde(native)
    legg_u32(native, 0x910005CE)                        // add x14, x14, #1
    la p_b_scan = lengde(native)
    legg_u32(native, 0)                                 // b scan
    la lbl_scan_done = lengde(native)
    la p_cbz_grow = lengde(native)
    legg_u32(native, 0)                                 // cbz x17, grow
    legg_u32(native, 0xF9000620 | val_reg)              // str Xval, [x17, #8]  (oppdater verdi)
    la p_b_done2 = lengde(native)
    legg_u32(native, 0)                                 // b done
    // --- kart-vekst: nytt mapdata med count+1 par ---
    la lbl_grow = lengde(native)
    legg_u32(native, 0xF9400400 | (obj_reg << 5) | 9)   // ldr x9, [Xobj, #8] (gammal mapdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (gammal count)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28   (ny mapdata-base)
    legg_u32(native, 0x9100054B)                        // add x11, x10, #1 (ny count)
    legg_u32(native, 0xF90001CB)                        // str x11, [x14]
    legg_u32(native, 0x91002120)                        // add x0, x9, #8  (src)
    legg_u32(native, 0x910021C1)                        // add x1, x14, #8 (dst)
    legg_u32(native, 0x8B0A0142)                        // add x2, x10, x10 (slots = count*2)
    la lbl_copy = lengde(native)
    la p_cbz_copydone = lengde(native)
    legg_u32(native, 0)                                 // cbz x2, copydone
    legg_u32(native, 0xF9400003)                        // ldr x3, [x0]
    legg_u32(native, 0xF9000023)                        // str x3, [x1]
    legg_u32(native, 0x91002000)                        // add x0, x0, #8
    legg_u32(native, 0x91002021)                        // add x1, x1, #8
    legg_u32(native, 0xD1000442)                        // sub x2, x2, #1
    la p_b_copy = lengde(native)
    legg_u32(native, 0)                                 // b copy
    la lbl_copydone = lengde(native)
    legg_u32(native, 0xF9000020 | idx_reg)              // str Xidx, [x1]   (ny nøkkel)
    legg_u32(native, 0xF9000420 | val_reg)              // str Xval, [x1, #8] (ny verdi)
    legg_u32(native, 0x91004021)                        // add x1, x1, #16
    legg_u32(native, 0xAA0103FC)                        // mov x28, x1  (bump)
    legg_u32(native, 0xF9000400 | (obj_reg << 5) | 14)  // str x14, [Xobj, #8] (peik obj til nytt mapdata)
    la lbl_done = lengde(native)
    skriv_u32(native, p_bne_map,     0x54000001 | ((((lbl_map      - p_bne_map)     / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_done1,     0x14000000 |  (((lbl_done     - p_b_done1)     / 4) & 0x03FFFFFF))
    skriv_u32(native, p_scan_ge,     0x5400000A | ((((lbl_scan_done - p_scan_ge)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_next,    0x54000001 | ((((lbl_next     - p_bne_next)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_match,   0xB4000004 | ((((lbl_matched  - p_cbz_match)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_next2,   0x54000001 | ((((lbl_next     - p_bne_next2)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_byte,   0xB5000004 | ((((lbl_byteloop - p_cbnz_byte)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_scandone,  0x14000000 |  (((lbl_scan_done - p_b_scandone) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_scan,      0x14000000 |  (((lbl_scan     - p_b_scan)      / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz_grow,    0xB4000011 | ((((lbl_grow     - p_cbz_grow)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_done2,     0x14000000 |  (((lbl_done     - p_b_done2)     / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz_copydone,0xB4000002 | ((((lbl_copydone - p_cbz_copydone)/ 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_copy,      0x14000000 |  (((lbl_copy     - p_b_copy)      / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 8: legg_til(liste, verdi) — appenderer verdi ved å vekse lista (nytt
// listdata med count+1 element, kopier, legg til), og peikar Xliste sin verdi til
// den nye bufferen. Same realloc-mønster som kart-veksten (men 1 peikar per
// element). Liste-NcVal-peikaren blir ståande i Xlist_reg (resultat på stakken).
funksjon emit_legg_til(native: liste_heiltall, list_reg: heiltall, val_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (list_reg << 5) | 9)  // ldr x9, [Xlist, #8] (gammal listdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (gammal count)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28   (ny listdata-base)
    legg_u32(native, 0x9100054B)                        // add x11, x10, #1 (ny count)
    legg_u32(native, 0xF90001CB)                        // str x11, [x14]
    legg_u32(native, 0x91002120)                        // add x0, x9, #8 (src)
    legg_u32(native, 0x910021C1)                        // add x1, x14, #8 (dst)
    legg_u32(native, 0xAA0A03E2)                        // mov x2, x10   (slots = count)
    la lbl_copy = lengde(native)
    la p_cbz_done = lengde(native)
    legg_u32(native, 0)                                 // cbz x2, copydone
    legg_u32(native, 0xF9400003)                        // ldr x3, [x0]
    legg_u32(native, 0xF9000023)                        // str x3, [x1]
    legg_u32(native, 0x91002000)                        // add x0, x0, #8
    legg_u32(native, 0x91002021)                        // add x1, x1, #8
    legg_u32(native, 0xD1000442)                        // sub x2, x2, #1
    la p_b_copy = lengde(native)
    legg_u32(native, 0)                                 // b copy
    la lbl_done = lengde(native)
    legg_u32(native, 0xF9000020 | val_reg)              // str Xval, [x1]  (nytt element)
    legg_u32(native, 0x91002021)                        // add x1, x1, #8
    legg_u32(native, 0xAA0103FC)                        // mov x28, x1  (bump)
    legg_u32(native, 0xF9000400 | (list_reg << 5) | 14) // str x14, [Xlist, #8]
    skriv_u32(native, p_cbz_done, 0xB4000002 | ((((lbl_done - p_cbz_done) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_copy,   0x14000000 |  (((lbl_copy - p_b_copy)   / 4) & 0x03FFFFFF))
    returner 0
}

// fjern(liste, indeks): fjern element på indeks in-place — skift etterfølgjande
// slots eitt hakk ned (framoverkopi, trygt sidan dst<src) og count-1.
// Scratch: x9–x14. Muterer lista; NcVal-boksen er delt så alias ser endringa.
funksjon emit_fjern_indeks(native: liste_heiltall, list_reg: heiltall, idx_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (list_reg << 5) | 9)  // ldr x9, [Xlist, #8] (listdata)
    legg_u32(native, 0xF9400400 | (idx_reg << 5) | 10)  // ldr x10, [Xidx, #8] (indeks)
    legg_u32(native, 0xF940012B)                        // ldr x11, [x9]  (count)
    legg_u32(native, 0xD100056B)                        // sub x11, x11, #1 (ny count)
    legg_u32(native, 0xF900012B)                        // str x11, [x9]
    legg_u32(native, 0x8B0A0D2C)                        // add x12, x9, x10, lsl #3
    legg_u32(native, 0x9100218C)                        // add x12, x12, #8  (&slot[idx])
    legg_u32(native, 0xCB0A016D)                        // sub x13, x11, x10 (slots å flytte)
    la p_cbz = lengde(native)
    legg_u32(native, 0)                                 // cbz x13, done
    la lbl_loop = lengde(native)
    legg_u32(native, 0xF940058E)                        // ldr x14, [x12, #8]
    legg_u32(native, 0xF900018E)                        // str x14, [x12]
    legg_u32(native, 0x9100218C)                        // add x12, x12, #8
    legg_u32(native, 0xD10005AD)                        // sub x13, x13, #1
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                                 // cbnz x13, loop
    la lbl_done = lengde(native)
    skriv_u32(native, p_cbz,  0xB400000D | ((((lbl_done - p_cbz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz, 0xB500000D | ((((lbl_loop - p_cbnz) / 4) & 0x7FFFF) << 5))
    returner 0
}

// sett_inn(liste, indeks, verdi): innsetjing med grow-kopi (same realloc-mønster
// som emit_legg_til): ny listdata count+1, kopier [0,idx), verdien, [idx,count),
// repoint [Xlist+8]. Scratch: x0–x3, x9–x12, x14.
funksjon emit_sett_inn(native: liste_heiltall, list_reg: heiltall, idx_reg: heiltall, val_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (list_reg << 5) | 9)  // ldr x9, [Xlist, #8] (gammal listdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (count)
    legg_u32(native, 0xF9400400 | (idx_reg << 5) | 11)  // ldr x11, [Xidx, #8] (indeks)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28   (ny listdata)
    legg_u32(native, 0x9100054C)                        // add x12, x10, #1 (ny count)
    legg_u32(native, 0xF90001CC)                        // str x12, [x14]
    legg_u32(native, 0x91002120)                        // add x0, x9, #8  (src)
    legg_u32(native, 0x910021C1)                        // add x1, x14, #8 (dst)
    legg_u32(native, 0xAA0B03E2)                        // mov x2, x11    (slots før indeks)
    la lbl_k1 = lengde(native)
    la p_cbz1 = lengde(native)
    legg_u32(native, 0)                                 // cbz x2, k1done
    legg_u32(native, 0xF9400003)                        // ldr x3, [x0]
    legg_u32(native, 0xF9000023)                        // str x3, [x1]
    legg_u32(native, 0x91002000)                        // add x0, x0, #8
    legg_u32(native, 0x91002021)                        // add x1, x1, #8
    legg_u32(native, 0xD1000442)                        // sub x2, x2, #1
    la p_b1 = lengde(native)
    legg_u32(native, 0)                                 // b k1
    la lbl_k1done = lengde(native)
    legg_u32(native, 0xF9000020 | val_reg)              // str Xval, [x1] (ny verdi)
    legg_u32(native, 0x91002021)                        // add x1, x1, #8
    legg_u32(native, 0xCB0B0142)                        // sub x2, x10, x11 (slots etter)
    la lbl_k2 = lengde(native)
    la p_cbz2 = lengde(native)
    legg_u32(native, 0)                                 // cbz x2, k2done
    legg_u32(native, 0xF9400003)                        // ldr x3, [x0]
    legg_u32(native, 0xF9000023)                        // str x3, [x1]
    legg_u32(native, 0x91002000)                        // add x0, x0, #8
    legg_u32(native, 0x91002021)                        // add x1, x1, #8
    legg_u32(native, 0xD1000442)                        // sub x2, x2, #1
    la p_b2 = lengde(native)
    legg_u32(native, 0)                                 // b k2
    la lbl_k2done = lengde(native)
    legg_u32(native, 0xAA0103FC)                        // mov x28, x1 (bump)
    legg_u32(native, 0xF9000400 | (list_reg << 5) | 14) // str x14, [Xlist, #8]
    skriv_u32(native, p_cbz1, 0xB4000002 | ((((lbl_k1done - p_cbz1) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b1,   0x14000000 |  (((lbl_k1 - p_b1)       / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz2, 0xB4000002 | ((((lbl_k2done - p_cbz2) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b2,   0x14000000 |  (((lbl_k2 - p_b2)       / 4) & 0x03FFFFFF))
    returner 0
}

// system_info() → NcVal-kart {"system": ..., "machine": ...}. Verdiane er
// compile-time-konstantar per målplattform (codegen kjenner OS-et), så kartet
// materialiserast frå strengkonstantar. Kallarane i repoet les berre desse to
// felta. Scratch: x9/x10/x13/x14 (via str_const/alloc) + x11/x12/x15/x16.
funksjon emit_system_info(native: liste_heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    la sysnamn = "Darwin"
    la maskin = "arm64"
    hvis os == "linux" {
        sysnamn = "Linux"
        maskin = "aarch64"
    }
    emit_ncval_str_const(native, "system", 11)
    emit_ncval_str_const(native, sysnamn, 12)
    emit_ncval_str_const(native, "machine", 15)
    emit_ncval_str_const(native, maskin, 16)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28 (mapdata)
    legg_u32(native, 0xD2800049)                        // movz x9, #2  (count)
    legg_u32(native, 0xF90001C9)                        // str x9, [x14]
    legg_u32(native, 0xF90005CB)                        // str x11, [x14, #8]
    legg_u32(native, 0xF90009CC)                        // str x12, [x14, #16]
    legg_u32(native, 0xF9000DCF)                        // str x15, [x14, #24]
    legg_u32(native, 0xF90011D0)                        // str x16, [x14, #32]
    legg_u32(native, 0x9100A1DC)                        // add x28, x14, #40
    emit_ncval_alloc_ptr(native, 14, dst_reg, 5)
    returner 0
}

// vent.sov(ms): Linux → ekte nanosleep-syscall (#101) med timespec på stakken.
// macOS-målet har ingen direkte nanosleep-svc; der er kallet no-op (selftest-
// attestasjonsmålet er Linux ARM64; macOS-full-host er uansett blokkert av
// Mach-O-emitterens __TEXT-tak). Scratch: x0/x1, x9–x13.
funksjon emit_vent_sov(native: liste_heiltall, ms_reg: heiltall, os: tekst) -> heiltall {
    hvis os != "linux" { returner 0 }
    legg_u32(native, 0xF9400400 | (ms_reg << 5) | 9)    // ldr x9, [Xms, #8]
    legg_u32(native, 0xD2807D0A)                        // movz x10, #1000
    legg_u32(native, 0x9ACA092B)                        // udiv x11, x9, x10 (sek)
    legg_u32(native, 0x9B0AA56C)                        // msub x12, x11, x10, x9 (ms-rest)
    last_heiltall_64(native, 13, 1000000)
    legg_u32(native, 0x9B0D7D8C)                        // mul x12, x12, x13 (nsek)
    legg_u32(native, 0xD10043FF)                        // sub sp, sp, #16
    legg_u32(native, 0xF90003EB)                        // str x11, [sp]
    legg_u32(native, 0xF90007EC)                        // str x12, [sp, #8]
    legg_u32(native, 0x910003E0)                        // mov x0, sp
    legg_u32(native, 0xAA1F03E1)                        // mov x1, xzr
    emit_syscall(native, 101, os)                       // nanosleep
    legg_u32(native, 0x910043FF)                        // add sp, sp, #16
    returner 0
}

// Fase 6-delt hjelpar: kopier ein NcVal-streng (Xstr_reg) som null-terminert
// C-streng til stakk-bufferen ved sp (kallaren har alt gjort sub sp,#4096).
// Legg peikaren i sp; brukar x9–x14 som scratch.
funksjon emit_cstr_to_sp(native: liste_heiltall, str_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (str_reg << 5) | 9)   // ldr x9, [Xstr, #8]  (strdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (len)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8 (bytes)
    legg_u32(native, 0x910003EB)                        // mov x11, sp    (dst)
    legg_u32(native, 0xAA0903EC)                        // mov x12, x9    (src)
    legg_u32(native, 0xAA0A03ED)                        // mov x13, x10   (remaining)
    la p_cbz = lengde(native)
    legg_u32(native, 0)                                 // cbz x13, skip
    la lbl_loop = lengde(native)
    legg_u32(native, 0x3940018E)                        // ldrb w14, [x12]
    legg_u32(native, 0x3900016E)                        // strb w14, [x11]
    legg_u32(native, 0x9100058C)                        // add x12, x12, #1
    legg_u32(native, 0x9100056B)                        // add x11, x11, #1
    legg_u32(native, 0xD10005AD)                        // sub x13, x13, #1
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                                 // cbnz x13, loop
    la lbl_skip = lengde(native)
    legg_u32(native, 0x3900017F)                        // strb wzr, [x11]  (null)
    skriv_u32(native, p_cbz,  0xB400000D | ((((lbl_skip - p_cbz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz, 0xB500000D | ((((lbl_loop - p_cbnz) / 4) & 0x7FFFF) << 5))
    returner 0
}

// fil_skriv(path, content): opna/lag fila og skriv innhaldet. Returnerer int 0.
funksjon emit_fil_skriv(native: liste_heiltall, path_reg: heiltall, content_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99  (AT_FDCWD=-100)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2804822)                    // movz x2, #0x241 (O_WRONLY|CREAT|TRUNC)
        legg_u32(native, 0xD2803483)                    // movz x3, #0x1A4 (0644)
        legg_u32(native, 0xD2800708)                    // movz x8, #56  (openat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD280C021)                    // movz x1, #0x601
        legg_u32(native, 0xD2803482)                    // movz x2, #0x1A4
        legg_u32(native, 0xD28000B0)                    // movz x16, #5  (open)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0  (fd)
    legg_u32(native, 0xF9400400 | (content_reg << 5) | 10) // ldr x10, [Xcontent, #8]
    legg_u32(native, 0xF9400142)                        // ldr x2, [x10]  (len)
    legg_u32(native, 0x91002141)                        // add x1, x10, #8 (bytes)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9  (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                    // movz x8, #64 (write)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800090)                    // movz x16, #4 (write)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9  (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800728)                    // movz x8, #57 (close)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD28000D0)                    // movz x16, #6 (close)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0x52800009)                        // movz w9, #0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// fil_les(path): les heile fila inn i ein NcVal-streng (read-loop til EOF).
funksjon emit_fil_les(native: liste_heiltall, path_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2800002)                    // movz x2, #0 (O_RDONLY)
        legg_u32(native, 0xD2800003)                    // movz x3, #0
        legg_u32(native, 0xD2800708)                    // movz x8, #56 (openat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2800001)                    // movz x1, #0
        legg_u32(native, 0xD2800002)                    // movz x2, #0
        legg_u32(native, 0xD28000B0)                    // movz x16, #5 (open)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0  (fd)
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0xAA1C03EA)                        // mov x10, x28  (strdata-base)
    legg_u32(native, 0x9100214B)                        // add x11, x10, #8 (skrivepeikar)
    legg_u32(native, 0xD280000C)                        // movz x12, #0 (total)
    la lbl_read = lengde(native)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9  (fd)
    legg_u32(native, 0xAA0B03E1)                        // mov x1, x11 (buf)
    legg_u32(native, 0xD2800002)                        // movz x2, #0
    legg_u32(native, 0xF2A00022)                        // movk x2, #1, lsl #16  (65536)
    hvis os == "linux" {
        legg_u32(native, 0xD28007E8)                    // movz x8, #63 (read)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800070)                    // movz x16, #3 (read)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xF100041F)                        // cmp x0, #1
    la p_blt_done = lengde(native)
    legg_u32(native, 0)                                 // b.lt readdone
    legg_u32(native, 0x8B00016B)                        // add x11, x11, x0
    legg_u32(native, 0x8B00018C)                        // add x12, x12, x0
    la p_b_read = lengde(native)
    legg_u32(native, 0)                                 // b read
    la lbl_readdone = lengde(native)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9  (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800728)                    // movz x8, #57 (close)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD28000D0)                    // movz x16, #6 (close)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xF900014C)                        // str x12, [x10]  (length)
    legg_u32(native, 0xAA0B03FC)                        // mov x28, x11  (bump)
    emit_ncval_alloc_ptr(native, 10, dst_reg, 3)
    skriv_u32(native, p_blt_done, 0x5400000B | ((((lbl_readdone - p_blt_done) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_read,   0x14000000 |  (((lbl_read     - p_b_read)   / 4) & 0x03FFFFFF))
    returner 0
}

// fil_finnes(path) → bool (access F_OK).
// fil_slett(path) → bool. unlink (macOS 10) / unlinkat(AT_FDCWD,path,0) (Linux 35).
funksjon emit_fil_slett(native: liste_heiltall, path_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99  (AT_FDCWD=-100)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2800002)                    // movz x2, #0
        legg_u32(native, 0xD2800468)                    // movz x8, #35  (unlinkat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2800150)                    // movz x16, #10 (unlink)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0xF100001F)                        // cmp x0, #0
    legg_u32(native, 0x1A9F17E9)                        // cset w9, eq  (0 = suksess → sann)
    emit_ncval_alloc(native, 9, dst_reg, 2)
    returner 0
}

// fil_sett_kjorbar(path) → bool. chmod path 0755 (macOS 15) /
// fchmodat(AT_FDCWD,path,0755,0) (Linux 53).
funksjon emit_fil_sett_kjorbar(native: liste_heiltall, path_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99  (AT_FDCWD)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2803DA2)                    // movz x2, #0x1ED (0755)
        legg_u32(native, 0xD2800003)                    // movz x3, #0
        legg_u32(native, 0xD28006A8)                    // movz x8, #53  (fchmodat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2803DA1)                    // movz x1, #0x1ED (0755)
        legg_u32(native, 0xD28001F0)                    // movz x16, #15 (chmod)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0xF100001F)                        // cmp x0, #0
    legg_u32(native, 0x1A9F17E9)                        // cset w9, eq
    emit_ncval_alloc(native, 9, dst_reg, 2)
    returner 0
}

// fil_append(path, content) → bool. Som fil_skriv, men O_APPEND i staden for O_TRUNC.
funksjon emit_fil_append(native: liste_heiltall, path_reg: heiltall, content_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99  (AT_FDCWD)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2808822)                    // movz x2, #0x441 (O_WRONLY|CREAT|APPEND)
        legg_u32(native, 0xD2803483)                    // movz x3, #0x1A4 (0644)
        legg_u32(native, 0xD2800708)                    // movz x8, #56  (openat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2804121)                    // movz x1, #0x209 (O_WRONLY|CREAT|APPEND)
        legg_u32(native, 0xD2803482)                    // movz x2, #0x1A4
        legg_u32(native, 0xD28000B0)                    // movz x16, #5  (open)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0  (fd)
    legg_u32(native, 0xF9400400 | (content_reg << 5) | 10) // ldr x10, [Xcontent, #8]
    legg_u32(native, 0xF9400142)                        // ldr x2, [x10]  (len)
    legg_u32(native, 0x91002141)                        // add x1, x10, #8 (bytes)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9  (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                    // movz x8, #64 (write)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800090)                    // movz x16, #4 (write)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9  (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800728)                    // movz x8, #57 (close)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD28000D0)                    // movz x16, #6 (close)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0x52800029)                        // movz w9, #1  (sann)
    emit_ncval_alloc(native, 9, dst_reg, 2)
    returner 0
}

// bytes_to_text(byteliste) → streng. bytes ≡ NcVal-liste av byte-heiltal; bygg ein
// strdata [len][bytes] ved å pakke ut kvart element sin lågbyte.
funksjon emit_bytes_to_text(native: liste_heiltall, list_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (list_reg << 5) | 9)  // ldr x9, [Xliste, #8] (listdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9] (count)
    legg_u32(native, 0x9100212B)                        // add x11, x9, #8 (&elem[0])
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28 (strdata-base)
    legg_u32(native, 0xF90001CA)                        // str x10, [x14] (length)
    legg_u32(native, 0x910021CF)                        // add x15, x14, #8 (skrive-ptr)
    legg_u32(native, 0xD2800010)                        // movz x16, #0 (i)
    la lbl_loop = lengde(native)
    legg_u32(native, 0xEB0A021F)                        // cmp x16, x10
    la p_bge = lengde(native)
    legg_u32(native, 0)                                 // b.ge done
    legg_u32(native, 0x8B100D6C)                        // add x12, x11, x16, lsl #3 (&elem[i])
    legg_u32(native, 0xF940018C)                        // ldr x12, [x12] (elem NcVal)
    legg_u32(native, 0xB940098D)                        // ldr w13, [x12, #8] (byteverdi)
    legg_u32(native, 0x390001ED)                        // strb w13, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0x91000610)                        // add x16, x16, #1
    la p_bloop = lengde(native)
    legg_u32(native, 0x14000000)                        // b loop
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0F03FC)                        // mov x28, x15 (bump)
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    skriv_u32(native, p_bge,   0x5400000A | ((((lbl_done - p_bge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bloop, 0x14000000 |  (((lbl_loop - p_bloop) / 4) & 0x03FFFFFF))
    returner 0
}

// fil_skriv_binær(path, byteliste) → bool. Samlar liste-bytane i ein heap-buffer og
// skriv dei til fila (open O_WRONLY|CREAT|TRUNC, write, close).
funksjon emit_fil_skriv_binaer(native: liste_heiltall, path_reg: heiltall, content_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99 (AT_FDCWD)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2804822)                    // movz x2, #0x241 (O_WRONLY|CREAT|TRUNC)
        legg_u32(native, 0xD2803483)                    // movz x3, #0x1A4 (0644)
        legg_u32(native, 0xD2800708)                    // movz x8, #56 (openat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD280C021)                    // movz x1, #0x601
        legg_u32(native, 0xD2803482)                    // movz x2, #0x1A4
        legg_u32(native, 0xD28000B0)                    // movz x16, #5 (open)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0 (fd)
    // samle bytar i heap-buffer ved x28
    legg_u32(native, 0xF9400400 | (content_reg << 5) | 10) // ldr x10, [Xcontent, #8] (listdata)
    legg_u32(native, 0xF9400142)                        // ldr x2, [x10] (count)
    legg_u32(native, 0x9100214B)                        // add x11, x10, #8 (&elem[0])
    legg_u32(native, 0xAA1C03ED)                        // mov x13, x28 (buffer-base)
    legg_u32(native, 0xAA0D03EF)                        // mov x15, x13 (skrive-ptr)
    legg_u32(native, 0xD2800010)                        // movz x16, #0 (i)
    la lbl_g = lengde(native)
    legg_u32(native, 0xEB02021F)                        // cmp x16, x2
    la p_bge = lengde(native)
    legg_u32(native, 0)                                 // b.ge gdone
    legg_u32(native, 0x8B100D6C)                        // add x12, x11, x16, lsl #3 (&elem[i])
    legg_u32(native, 0xF940018C)                        // ldr x12, [x12] (elem)
    legg_u32(native, 0xB940098C)                        // ldr w12, [x12, #8] (byte)
    legg_u32(native, 0x390001EC)                        // strb w12, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0x91000610)                        // add x16, x16, #1
    la p_bg = lengde(native)
    legg_u32(native, 0x14000000)                        // b g
    la lbl_gdone = lengde(native)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9 (fd)
    legg_u32(native, 0xAA0D03E1)                        // mov x1, x13 (buffer)
    // x2 = count (framleis)
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                    // movz x8, #64 (write)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800090)                    // movz x16, #4 (write)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9 (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800728)                    // movz x8, #57 (close)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD28000D0)                    // movz x16, #6 (close)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0x52800029)                        // movz w9, #1 (sann)
    emit_ncval_alloc(native, 9, dst_reg, 2)
    skriv_u32(native, p_bge, 0x5400000A | ((((lbl_gdone - p_bge) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bg,  0x14000000 |  (((lbl_g     - p_bg)  / 4) & 0x03FFFFFF))
    returner 0
}

// fil_les_binær(path) → byteliste. Les råbytes til ein heap-buffer, boks kvar byte
// som int-NcVal og bygg ei liste (bytes ≡ liste). Registerbruk unngår x13/x14 som
// emit_ncval_alloc klobbar; val-reg (x9) ≠ dst-reg (x0) i boks-løkka.
funksjon emit_fil_les_binaer(native: liste_heiltall, path_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99 (AT_FDCWD)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2800002)                    // movz x2, #0 (O_RDONLY)
        legg_u32(native, 0xD2800003)                    // movz x3, #0
        legg_u32(native, 0xD2800708)                    // movz x8, #56 (openat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2800001)                    // movz x1, #0
        legg_u32(native, 0xD2800002)                    // movz x2, #0
        legg_u32(native, 0xD28000B0)                    // movz x16, #5 (open)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0 (fd)
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    // les råbytes til buffer ved x28
    legg_u32(native, 0xAA1C03EF)                        // mov x15, x28 (rawbase)
    legg_u32(native, 0xAA0F03EA)                        // mov x10, x15 (skrive-ptr)
    // NB: N i x7, IKKJE x16 — macOS legg syscall-nummeret (read=3, close=6) i x16,
    // så N i x16 vart klobba (alltid 6 = close-nr) rett før count-lagringa. x7 er
    // urørt av read/close-syscall og av emit_ncval_alloc (x13/x14).
    legg_u32(native, 0xD2800007)                        // movz x7, #0 (total N)
    la lbl_read = lengde(native)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9 (fd)
    legg_u32(native, 0xAA0A03E1)                        // mov x1, x10 (buf)
    legg_u32(native, 0xD2800002)                        // movz x2, #0
    legg_u32(native, 0xF2A00022)                        // movk x2, #1, lsl #16 (65536)
    hvis os == "linux" {
        legg_u32(native, 0xD28007E8)                    // movz x8, #63 (read)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800070)                    // movz x16, #3 (read)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xF100041F)                        // cmp x0, #1
    la p_blt = lengde(native)
    legg_u32(native, 0)                                 // b.lt readdone
    legg_u32(native, 0x8B00014A)                        // add x10, x10, x0
    legg_u32(native, 0x8B0000E7)                        // add x7, x7, x0 (N += lese)
    la p_bread = lengde(native)
    legg_u32(native, 0x14000000)                        // b read
    la lbl_readdone = lengde(native)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9 (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800728)                    // movz x8, #57 (close)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD28000D0)                    // movz x16, #6 (close)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    // bygg listdata ved x10 (rett etter råbufferet): [N][elem-ptrar]
    legg_u32(native, 0xAA0A03F1)                        // mov x17, x10 (lbase)
    legg_u32(native, 0xF9000227)                        // str x7, [x17] (count = N)
    legg_u32(native, 0x9100223C)                        // add x28, x17, #8 (elem-array start)
    legg_u32(native, 0x8B070F9C)                        // add x28, x28, x7, lsl #3 (reserver N ptrar)
    // boks kvar råbyte som int-NcVal, lagra ptr i elem-arrayet
    legg_u32(native, 0xAA0F03EA)                        // mov x10, x15 (rå-cursor)
    legg_u32(native, 0x9100222C)                        // add x12, x17, #8 (elem-cursor)
    legg_u32(native, 0xD280000B)                        // movz x11, #0 (i)
    la lbl_box = lengde(native)
    legg_u32(native, 0xEB07017F)                        // cmp x11, x7 (i < N)
    la p_bge = lengde(native)
    legg_u32(native, 0)                                 // b.ge boxdone
    legg_u32(native, 0x39400149)                        // ldrb w9, [x10] (råbyte)
    emit_ncval_alloc(native, 9, 0, 1)                   // boks int → x0 (dst≠val)
    legg_u32(native, 0xF9000180)                        // str x0, [x12] (elem[i] = ptr)
    legg_u32(native, 0x9100054A)                        // add x10, x10, #1
    legg_u32(native, 0x9100218C)                        // add x12, x12, #8
    legg_u32(native, 0x9100056B)                        // add x11, x11, #1
    la p_bbox = lengde(native)
    legg_u32(native, 0x14000000)                        // b box
    la lbl_boxdone = lengde(native)
    emit_ncval_alloc_ptr(native, 17, dst_reg, 4)        // boks liste (val = lbase)
    skriv_u32(native, p_blt,  0x5400000B | ((((lbl_readdone - p_blt)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bread, 0x14000000 |  (((lbl_read    - p_bread) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bge,  0x5400000A | ((((lbl_boxdone - p_bge)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bbox,  0x14000000 |  (((lbl_box     - p_bbox) / 4) & 0x03FFFFFF))
    returner 0
}

funksjon emit_fil_finnes(native: liste_heiltall, path_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2800002)                    // movz x2, #0 (F_OK)
        legg_u32(native, 0xD2800003)                    // movz x3, #0
        legg_u32(native, 0xD2800608)                    // movz x8, #48 (faccessat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2800001)                    // movz x1, #0 (F_OK)
        legg_u32(native, 0xD2800430)                    // movz x16, #33 (access)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0xF100001F)                        // cmp x0, #0
    legg_u32(native, 0x1A9F17E9)                        // cset w9, eq
    emit_ncval_alloc(native, 9, dst_reg, 2)
    returner 0
}

// Skriv ein hex-nibble (verdi 0..15 i w0) som ASCII-teikn til [x14], x14++.
// Alle greiner er framover og sjølvlukka.
funksjon emit_hex_nibble(native: liste_heiltall) -> heiltall {
    legg_u32(native, 0x7100281F)                        // cmp w0, #10
    la p_hs = lengde(native)
    legg_u32(native, 0)                                 // b.hs alpha
    legg_u32(native, 0x1100C000)                        // add w0, w0, #0x30 ('0')
    la p_b = lengde(native)
    legg_u32(native, 0)                                 // b store
    la lbl_alpha = lengde(native)
    legg_u32(native, 0x11015C00)                        // add w0, w0, #0x57 ('a'-10)
    la lbl_store = lengde(native)
    legg_u32(native, 0x390001C0)                        // strb w0, [x14]
    legg_u32(native, 0x910005CE)                        // add x14, x14, #1
    skriv_u32(native, p_hs, 0x54000002 | ((((lbl_alpha - p_hs) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b,  0x14000000 |  (((lbl_store - p_b)  / 4) & 0x03FFFFFF))
    returner 0
}

// random_hex(n) → hex-streng med 2n teikn frå OS-entropi. Linux: getrandom(278);
// macOS: getentropy(500). Skriv n råbytes til sp-buffer, konverter til hex i strdata
// ved x28. NB: native brukar ekte OS-entropi (sterkare enn VM sin PRNG).
funksjon emit_random_hex(native: liste_heiltall, n_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (n_reg << 5) | 10)    // ldr x10, [Xn, #8] (n bytes)
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    legg_u32(native, 0x910003E0)                        // mov x0, sp (buf)
    legg_u32(native, 0xAA0A03E1)                        // mov x1, x10 (len)
    hvis os == "linux" {
        legg_u32(native, 0xD2800002)                    // movz x2, #0 (flags)
        legg_u32(native, 0xD28022C8)                    // movz x8, #278 (getrandom)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2803E90)                    // movz x16, #500 (getentropy)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x910003EB)                        // mov x11, sp (rå-cursor)
    legg_u32(native, 0xAA1C03EC)                        // mov x12, x28 (strdata-base)
    legg_u32(native, 0x8B0A014D)                        // add x13, x10, x10 (2n = out-len)
    legg_u32(native, 0xF900018D)                        // str x13, [x12] (length)
    legg_u32(native, 0x9100218E)                        // add x14, x12, #8 (skrive-ptr)
    legg_u32(native, 0xD280000F)                        // movz x15, #0 (i)
    la lbl_loop = lengde(native)
    legg_u32(native, 0xEB0A01FF)                        // cmp x15, x10
    la p_bge = lengde(native)
    legg_u32(native, 0)                                 // b.ge done
    legg_u32(native, 0x386F6970)                        // ldrb w16, [x11, x15]
    legg_u32(native, 0x53047E00)                        // lsr w0, w16, #4 (høg nibble)
    emit_hex_nibble(native)
    legg_u32(native, 0x12000E00)                        // and w0, w16, #0xf (låg nibble)
    emit_hex_nibble(native)
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    la p_bloop = lengde(native)
    legg_u32(native, 0x14000000)                        // b loop
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0E03FC)                        // mov x28, x14 (bump)
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    emit_ncval_alloc_ptr(native, 12, dst_reg, 3)
    skriv_u32(native, p_bge,   0x5400000A | ((((lbl_done - p_bge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bloop, 0x14000000 |  (((lbl_loop - p_bloop) / 4) & 0x03FFFFFF))
    returner 0
}

// fil_append_binær(path, byteliste) → bool. Som fil_skriv_binær, men O_APPEND
// (open O_WRONLY|CREAT|APPEND) i staden for TRUNC.
funksjon emit_fil_append_binaer(native: liste_heiltall, path_reg: heiltall, content_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD14007FF)                        // sub sp, sp, #4096
    emit_cstr_to_sp(native, path_reg)
    hvis os == "linux" {
        legg_u32(native, 0x92800C60)                    // movn x0, #99 (AT_FDCWD)
        legg_u32(native, 0x910003E1)                    // mov x1, sp
        legg_u32(native, 0xD2808822)                    // movz x2, #0x441 (O_WRONLY|CREAT|APPEND)
        legg_u32(native, 0xD2803483)                    // movz x3, #0x1A4 (0644)
        legg_u32(native, 0xD2800708)                    // movz x8, #56 (openat)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0x910003E0)                    // mov x0, sp
        legg_u32(native, 0xD2804121)                    // movz x1, #0x209 (O_WRONLY|CREAT|APPEND)
        legg_u32(native, 0xD2803482)                    // movz x2, #0x1A4
        legg_u32(native, 0xD28000B0)                    // movz x16, #5 (open)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0 (fd)
    legg_u32(native, 0xF9400400 | (content_reg << 5) | 10) // ldr x10, [Xcontent, #8] (listdata)
    legg_u32(native, 0xF9400142)                        // ldr x2, [x10] (count)
    legg_u32(native, 0x9100214B)                        // add x11, x10, #8 (&elem[0])
    legg_u32(native, 0xAA1C03ED)                        // mov x13, x28 (buffer-base)
    legg_u32(native, 0xAA0D03EF)                        // mov x15, x13 (skrive-ptr)
    legg_u32(native, 0xD2800010)                        // movz x16, #0 (i)
    la lbl_g = lengde(native)
    legg_u32(native, 0xEB02021F)                        // cmp x16, x2
    la p_bge = lengde(native)
    legg_u32(native, 0)                                 // b.ge gdone
    legg_u32(native, 0x8B100D6C)                        // add x12, x11, x16, lsl #3 (&elem[i])
    legg_u32(native, 0xF940018C)                        // ldr x12, [x12] (elem)
    legg_u32(native, 0xB940098C)                        // ldr w12, [x12, #8] (byte)
    legg_u32(native, 0x390001EC)                        // strb w12, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0x91000610)                        // add x16, x16, #1
    la p_bg = lengde(native)
    legg_u32(native, 0x14000000)                        // b g
    la lbl_gdone = lengde(native)
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9 (fd)
    legg_u32(native, 0xAA0D03E1)                        // mov x1, x13 (buffer)
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                    // movz x8, #64 (write)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800090)                    // movz x16, #4 (write)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0xAA0903E0)                        // mov x0, x9 (fd)
    hvis os == "linux" {
        legg_u32(native, 0xD2800728)                    // movz x8, #57 (close)
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD28000D0)                    // movz x16, #6 (close)
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    legg_u32(native, 0x914007FF)                        // add sp, sp, #4096
    legg_u32(native, 0x52800029)                        // movz w9, #1 (sann)
    emit_ncval_alloc(native, 9, dst_reg, 2)
    skriv_u32(native, p_bge, 0x5400000A | ((((lbl_gdone - p_bge) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bg,  0x14000000 |  (((lbl_g     - p_bg)  / 4) & 0x03FFFFFF))
    returner 0
}

// miljo_hent(namn) → verdistreng (skann envp i x27 etter "namn=verdi"). Tom
// streng om ikkje funne (eller envp=NULL, t.d. Linux-_start før fase 7/8).
funksjon emit_miljo_hent(native: liste_heiltall, name_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (name_reg << 5) | 9)  // ldr x9, [Xname, #8]  (strdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (namn-len)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8 (namn-bytes)
    legg_u32(native, 0xAA1B03EB)                        // mov x11, x27  (envp-walker)
    // Linux _start gjev ikkje envp i x2 → x27 = 0. Vakt mot null-deref (ldr [0]):
    // tom envp → hopp til notfound (returner "").
    la p_cbz_nullenvp = lengde(native)
    legg_u32(native, 0)                                 // cbz x11, notfound
    la lbl_envloop = lengde(native)
    legg_u32(native, 0xF940016C)                        // ldr x12, [x11]  (entry char*)
    la p_cbz_notfound = lengde(native)
    legg_u32(native, 0)                                 // cbz x12, notfound
    legg_u32(native, 0xAA0903ED)                        // mov x13, x9   (namn-walker)
    legg_u32(native, 0xAA0A03EE)                        // mov x14, x10  (att)
    legg_u32(native, 0xAA0C03EF)                        // mov x15, x12  (entry-walker)
    la lbl_cmploop = lengde(native)
    la p_cbz_checkeq = lengde(native)
    legg_u32(native, 0)                                 // cbz x14, checkeq
    legg_u32(native, 0x394001E0)                        // ldrb w0, [x15]
    la p_cbz_next1 = lengde(native)
    legg_u32(native, 0)                                 // cbz w0, nextenv
    legg_u32(native, 0x394001A1)                        // ldrb w1, [x13]
    legg_u32(native, 0x6B01001F)                        // cmp w0, w1
    la p_bne_next = lengde(native)
    legg_u32(native, 0)                                 // b.ne nextenv
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0x910005AD)                        // add x13, x13, #1
    legg_u32(native, 0xD10005CE)                        // sub x14, x14, #1
    la p_b_cmploop = lengde(native)
    legg_u32(native, 0)                                 // b cmploop
    la lbl_checkeq = lengde(native)
    legg_u32(native, 0x394001E0)                        // ldrb w0, [x15]
    legg_u32(native, 0x7100F41F)                        // cmp w0, #61 ('=')
    la p_bne_next2 = lengde(native)
    legg_u32(native, 0)                                 // b.ne nextenv
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1  (verdi-peikar)
    la p_b_found = lengde(native)
    legg_u32(native, 0)                                 // b found
    la lbl_nextenv = lengde(native)
    legg_u32(native, 0x9100216B)                        // add x11, x11, #8
    la p_b_envloop = lengde(native)
    legg_u32(native, 0)                                 // b envloop
    la lbl_notfound = lengde(native)
    legg_u32(native, 0xD2800003)                        // movz x3, #0  (len 0)
    la p_b_build1 = lengde(native)
    legg_u32(native, 0)                                 // b build
    la lbl_found = lengde(native)
    legg_u32(native, 0xAA0F03E2)                        // mov x2, x15  (verdi-peikar)
    legg_u32(native, 0xAA0F03F0)                        // mov x16, x15 (strlen-walker)
    la lbl_strlen = lengde(native)
    legg_u32(native, 0x39400200)                        // ldrb w0, [x16]
    la p_cbz_strlendone = lengde(native)
    legg_u32(native, 0)                                 // cbz w0, strlendone
    legg_u32(native, 0x91000610)                        // add x16, x16, #1
    la p_b_strlen = lengde(native)
    legg_u32(native, 0)                                 // b strlen
    la lbl_strlendone = lengde(native)
    legg_u32(native, 0xCB0F0203)                        // sub x3, x16, x15 (verdi-len)
    la lbl_build = lengde(native)
    legg_u32(native, 0xAA1C03E4)                        // mov x4, x28  (strdata-base)
    legg_u32(native, 0xF9000083)                        // str x3, [x4]  (length)
    legg_u32(native, 0x91002085)                        // add x5, x4, #8 (dst)
    la p_cbz_builddone = lengde(native)
    legg_u32(native, 0)                                 // cbz x3, builddone
    la lbl_bcopy = lengde(native)
    legg_u32(native, 0x39400040)                        // ldrb w0, [x2]
    legg_u32(native, 0x390000A0)                        // strb w0, [x5]
    legg_u32(native, 0x91000442)                        // add x2, x2, #1
    legg_u32(native, 0x910004A5)                        // add x5, x5, #1
    legg_u32(native, 0xD1000463)                        // sub x3, x3, #1
    la p_cbnz_bcopy = lengde(native)
    legg_u32(native, 0)                                 // cbnz x3, bcopy
    la lbl_builddone = lengde(native)
    legg_u32(native, 0xAA0503FC)                        // mov x28, x5  (bump)
    emit_ncval_alloc_ptr(native, 4, dst_reg, 3)
    skriv_u32(native, p_cbz_nullenvp,   0xB400000B | ((((lbl_notfound   - p_cbz_nullenvp)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_notfound,   0xB400000C | ((((lbl_notfound   - p_cbz_notfound)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_checkeq,    0xB400000E | ((((lbl_checkeq    - p_cbz_checkeq)    / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_next1,      0xB4000000 | ((((lbl_nextenv    - p_cbz_next1)      / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bne_next,       0x54000001 | ((((lbl_nextenv    - p_bne_next)       / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_cmploop,      0x14000000 |  (((lbl_cmploop    - p_b_cmploop)      / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bne_next2,      0x54000001 | ((((lbl_nextenv    - p_bne_next2)      / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_found,        0x14000000 |  (((lbl_found      - p_b_found)        / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_envloop,      0x14000000 |  (((lbl_envloop    - p_b_envloop)      / 4) & 0x03FFFFFF))
    skriv_u32(native, p_b_build1,       0x14000000 |  (((lbl_build      - p_b_build1)       / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz_strlendone, 0xB4000000 | ((((lbl_strlendone - p_cbz_strlendone) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_strlen,       0x14000000 |  (((lbl_strlen     - p_b_strlen)       / 4) & 0x03FFFFFF))
    skriv_u32(native, p_cbz_builddone,  0xB4000003 | ((((lbl_builddone  - p_cbz_builddone)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_bcopy,     0xB5000003 | ((((lbl_bcopy      - p_cbnz_bcopy)     / 4) & 0x7FFFF) << 5))
    returner 0
}

// Fase 7: emitter eit OS-parametrisert syscall (mov nummer → svc). macOS: x16 +
// svc #0x80; Linux: x8 + svc #0. Nummeret er BSD- (macOS) eller AArch64-Linux-tal.
funksjon emit_syscall(native: liste_heiltall, num: heiltall, os: tekst) -> heiltall {
    hvis os == "linux" {
        legg_u32(native, 0xD2800008 | (num << 5))       // movz x8, #num
        legg_u32(native, 0xD4000001)                    // svc #0
    } ellers {
        legg_u32(native, 0xD2800010 | (num << 5))       // movz x16, #num
        legg_u32(native, 0xD4001001)                    // svc #0x80
    }
    returner 0
}

// Fase 7: byggjer ein sockaddr_in (16 byte) på maskinstakken (sub sp,#16).
// macOS-layout: [sin_len=16][sin_family=2][port hi][port lo][a][b][c][d][0×8].
// Linux-layout: [family lo=2][0][port hi][port lo][a][b][c][d][0×8]. Verten
// (NcVal-streng i host_reg) blir parsa som punkt-desimal → 4 addr-byte. Etter
// kallet står strukturen på [sp..sp+16); den som kallar set x1=sp og add sp,#16.
funksjon emit_sockaddr_in(native: liste_heiltall, host_reg: heiltall, port_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD10043FF)                        // sub sp, sp, #16
    legg_u32(native, 0xF90003FF)                        // str xzr, [sp]
    legg_u32(native, 0xF90007FF)                        // str xzr, [sp, #8]
    hvis os == "linux" {
        legg_u32(native, 0xD2800049)                    // movz x9, #2
        legg_u32(native, 0x390003E9)                    // strb w9, [sp]  (family lo)
    } ellers {
        legg_u32(native, 0xD2800209)                    // movz x9, #16
        legg_u32(native, 0x390003E9)                    // strb w9, [sp]  (sin_len)
        legg_u32(native, 0xD2800049)                    // movz x9, #2
        legg_u32(native, 0x390007E9)                    // strb w9, [sp, #1] (sin_family)
    }
    // port → nettverksrekkjefølgje (big-endian) i [sp+2],[sp+3]
    legg_u32(native, 0xF9400400 | (port_reg << 5) | 9)  // ldr x9, [Xport, #8]
    legg_u32(native, 0xD348FD2A)                        // lsr x10, x9, #8
    legg_u32(native, 0x39000BEA)                        // strb w10, [sp, #2]
    legg_u32(native, 0x39000FE9)                        // strb w9, [sp, #3]
    // vert → 4 addr-byte i [sp+4..7]  (punkt-desimal-parser)
    legg_u32(native, 0xF9400400 | (host_reg << 5) | 11) // ldr x11, [Xhost, #8] (strdata)
    legg_u32(native, 0xF940016C)                        // ldr x12, [x11]      (len)
    legg_u32(native, 0x9100216B)                        // add x11, x11, #8    (bytes)
    legg_u32(native, 0x8B0C016C)                        // add x12, x11, x12   (end)
    legg_u32(native, 0x910013EF)                        // add x15, sp, #4     (dst)
    legg_u32(native, 0xD280000E)                        // movz x14, #0        (oktett-teljar)
    la lbl_oct = lengde(native)
    legg_u32(native, 0xD2800009)                        // movz x9, #0         (acc)
    la lbl_digit = lengde(native)
    legg_u32(native, 0xEB0C017F)                        // cmp x11, x12
    la p_dig_ge = lengde(native)
    legg_u32(native, 0)                                 // b.ge oct_done
    legg_u32(native, 0x3940016A)                        // ldrb w10, [x11]
    legg_u32(native, 0x7100C15F)                        // cmp w10, #48
    la p_dig_lt = lengde(native)
    legg_u32(native, 0)                                 // b.lt oct_done
    legg_u32(native, 0x7100E55F)                        // cmp w10, #57
    la p_dig_gt = lengde(native)
    legg_u32(native, 0)                                 // b.gt oct_done
    legg_u32(native, 0xD280014D)                        // movz x13, #10
    legg_u32(native, 0x9B0D7D29)                        // mul x9, x9, x13
    legg_u32(native, 0x5100C14A)                        // sub w10, w10, #48
    legg_u32(native, 0x8B0A0129)                        // add x9, x9, x10
    legg_u32(native, 0x9100056B)                        // add x11, x11, #1
    la p_dig_loop = lengde(native)
    legg_u32(native, 0)                                 // b digit_loop
    la lbl_oct_done = lengde(native)
    legg_u32(native, 0x390001E9)                        // strb w9, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0xEB0C017F)                        // cmp x11, x12
    la p_dot_ge = lengde(native)
    legg_u32(native, 0)                                 // b.ge oct_next
    legg_u32(native, 0x3940016A)                        // ldrb w10, [x11]
    legg_u32(native, 0x7100B95F)                        // cmp w10, #46 ('.')
    la p_dot_ne = lengde(native)
    legg_u32(native, 0)                                 // b.ne oct_next
    legg_u32(native, 0x9100056B)                        // add x11, x11, #1 (hopp '.')
    la lbl_oct_next = lengde(native)
    legg_u32(native, 0x910005CE)                        // add x14, x14, #1
    legg_u32(native, 0xF10011DF)                        // cmp x14, #4
    la p_oct_lt = lengde(native)
    legg_u32(native, 0)                                 // b.lt oct_loop
    skriv_u32(native, p_dig_ge,   0x5400000A | ((((lbl_oct_done - p_dig_ge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_dig_lt,   0x5400000B | ((((lbl_oct_done - p_dig_lt)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_dig_gt,   0x5400000C | ((((lbl_oct_done - p_dig_gt)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_dig_loop, 0x14000000 |  (((lbl_digit    - p_dig_loop) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_dot_ge,   0x5400000A | ((((lbl_oct_next - p_dot_ge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_dot_ne,   0x54000001 | ((((lbl_oct_next - p_dot_ne)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_oct_lt,   0x5400000B | ((((lbl_oct     - p_oct_lt)   / 4) & 0x7FFFF) << 5))
    returner 0
}

// Fase 7: socket_new(family, type) → socket(family, type, 0); fd i int-NcVal.
funksjon emit_socket_new(native: liste_heiltall, fam_reg: heiltall, type_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (fam_reg << 5) | 0)   // ldr x0, [Xfam, #8]
    legg_u32(native, 0xF9400400 | (type_reg << 5) | 1)  // ldr x1, [Xtype, #8]
    legg_u32(native, 0xD2800002)                        // movz x2, #0
    hvis os == "linux" { emit_syscall(native, 198, os) } ellers { emit_syscall(native, 97, os) }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0  (fd)
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 7: socket_bind(fd, host, port) → bind(fd, &sockaddr, 16); status i NcVal.
// Set fyrst SO_REUSEADDR så testen ikkje feilar mot ein port i TIME_WAIT.
funksjon emit_socket_bind(native: liste_heiltall, fd_reg: heiltall, host_reg: heiltall, port_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    // setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, 4)
    legg_u32(native, 0xD10043FF)                        // sub sp, sp, #16
    legg_u32(native, 0xD2800029)                        // movz x9, #1
    legg_u32(native, 0xF90003E9)                        // str x9, [sp]  (one=1)
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    hvis os == "linux" {
        legg_u32(native, 0xD2800021)                    // movz x1, #1  (SOL_SOCKET)
        legg_u32(native, 0xD2800042)                    // movz x2, #2  (SO_REUSEADDR)
    } ellers {
        legg_u32(native, 0xD29FFFE1)                    // movz x1, #0xffff (SOL_SOCKET)
        legg_u32(native, 0xD2800082)                    // movz x2, #4  (SO_REUSEADDR)
    }
    legg_u32(native, 0x910003E3)                        // add x3, sp, #0  (&one)
    legg_u32(native, 0xD2800084)                        // movz x4, #4  (optlen)
    hvis os == "linux" { emit_syscall(native, 208, os) } ellers { emit_syscall(native, 105, os) }
    legg_u32(native, 0x910043FF)                        // add sp, sp, #16
    emit_sockaddr_in(native, host_reg, port_reg, os)
    legg_u32(native, 0x910003E1)                        // add x1, sp, #0  (&addr)
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    legg_u32(native, 0xD2800202)                        // movz x2, #16
    hvis os == "linux" { emit_syscall(native, 200, os) } ellers { emit_syscall(native, 104, os) }
    legg_u32(native, 0x910043FF)                        // add sp, sp, #16
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 7: socket_connect(fd, host, port) → connect(fd, &sockaddr, 16).
funksjon emit_socket_connect(native: liste_heiltall, fd_reg: heiltall, host_reg: heiltall, port_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    emit_sockaddr_in(native, host_reg, port_reg, os)
    legg_u32(native, 0x910003E1)                        // add x1, sp, #0
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    legg_u32(native, 0xD2800202)                        // movz x2, #16
    hvis os == "linux" { emit_syscall(native, 203, os) } ellers { emit_syscall(native, 98, os) }
    legg_u32(native, 0x910043FF)                        // add sp, sp, #16
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 7: socket_listen(fd, backlog) → listen(fd, backlog).
funksjon emit_socket_listen(native: liste_heiltall, fd_reg: heiltall, back_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    legg_u32(native, 0xF9400400 | (back_reg << 5) | 1)  // ldr x1, [Xbacklog, #8]
    hvis os == "linux" { emit_syscall(native, 201, os) } ellers { emit_syscall(native, 106, os) }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 7: socket_accept(fd) → accept(fd, NULL, NULL); ny fd i NcVal.
funksjon emit_socket_accept(native: liste_heiltall, fd_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    legg_u32(native, 0xD2800001)                        // movz x1, #0
    legg_u32(native, 0xD2800002)                        // movz x2, #0
    hvis os == "linux" { emit_syscall(native, 202, os) } ellers { emit_syscall(native, 30, os) }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 7: socket_send(fd, data) → write(fd, bytes, len); tal sende byte i NcVal.
funksjon emit_socket_send(native: liste_heiltall, fd_reg: heiltall, data_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    legg_u32(native, 0xF9400400 | (data_reg << 5) | 9)  // ldr x9, [Xdata, #8] (strdata)
    legg_u32(native, 0xF9400122)                        // ldr x2, [x9]  (len)
    legg_u32(native, 0x91002121)                        // add x1, x9, #8 (bytes)
    hvis os == "linux" { emit_syscall(native, 64, os) } ellers { emit_syscall(native, 4, os) }
    legg_u32(native, 0xAA0003E9)                        // mov x9, x0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 7: socket_recv(fd, max) → read(fd, heap, max); data som NcVal-streng.
funksjon emit_socket_recv(native: liste_heiltall, fd_reg: heiltall, max_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    legg_u32(native, 0x91002381)                        // add x1, x28, #8  (buf = strdata+8)
    legg_u32(native, 0xF9400400 | (max_reg << 5) | 2)   // ldr x2, [Xmax, #8]
    hvis os == "linux" { emit_syscall(native, 63, os) } ellers { emit_syscall(native, 3, os) }
    legg_u32(native, 0xF100001F)                        // cmp x0, #0
    legg_u32(native, 0x5400004A)                        // b.ge +2 (hopp over movz)
    legg_u32(native, 0xD2800000)                        // movz x0, #0  (klamp negativ)
    legg_u32(native, 0xF9000380)                        // str x0, [x28]  (lengd)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28   (strdata-base)
    legg_u32(native, 0x9100239C)                        // add x28, x28, #8
    legg_u32(native, 0x8B00039C)                        // add x28, x28, x0 (bump forbi bytes)
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    returner 0
}

// Fase 7: socket_close(fd) → close(fd); returnerer 0.
funksjon emit_socket_close(native: liste_heiltall, fd_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400400 | (fd_reg << 5) | 0)    // ldr x0, [Xfd, #8]
    hvis os == "linux" { emit_syscall(native, 57, os) } ellers { emit_syscall(native, 6, os) }
    legg_u32(native, 0xD2800009)                        // movz x9, #0
    emit_ncval_alloc(native, 9, dst_reg, 1)
    returner 0
}

// Fase 8: tid_ms() → millisekund sidan epoke via gettimeofday. timeval på stakken;
// ms = tv_sec*1000 + tv_usec/1000. tv_usec er 4 byte på macOS, 8 på Linux.
funksjon emit_tid_ms(native: liste_heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xD10043FF)                        // sub sp, sp, #16 (timeval)
    legg_u32(native, 0x910003E0)                        // mov x0, sp (&tv)
    legg_u32(native, 0xD2800001)                        // movz x1, #0 (tzp)
    hvis os == "linux" { emit_syscall(native, 169, os) } ellers { emit_syscall(native, 116, os) }
    legg_u32(native, 0xF94003E9)                        // ldr x9, [sp] (tv_sec)
    hvis os == "linux" {
        legg_u32(native, 0xF94007EA)                    // ldr x10, [sp, #8] (tv_usec 64-bit)
    } ellers {
        legg_u32(native, 0xB9400BEA)                    // ldr w10, [sp, #8] (tv_usec 32-bit)
    }
    legg_u32(native, 0xD2807D0B)                        // movz x11, #1000
    legg_u32(native, 0x9B0B7D29)                        // mul x9, x9, x11 (sec*1000)
    legg_u32(native, 0xD2807D0C)                        // movz x12, #1000
    legg_u32(native, 0x9ACC094A)                        // udiv x10, x10, x12 (usec/1000)
    legg_u32(native, 0x8B0A0129)                        // add x9, x9, x10 (ms)
    legg_u32(native, 0x910043FF)                        // add sp, sp, #16
    // ms er ein ekte 64-bit-verdi (~1.7e12) — box heile registeret utan sxtw
    // (emit_ncval_alloc trunkerer til 32-bit via sxtw, som gjer ms negativ).
    emit_ncval_alloc_ptr(native, 9, dst_reg, 1)
    returner 0
}

// Fase 6-JSON (skalarar): json_stringify(v) → JSON-streng. int→desimal,
// bool→"true"/"false", streng→"…" (sitatpakka), elles (liste/kart/nil)→"" som
// trygg reserve inntil rekursiv container-JSON kjem. Runtime type-dispatch.
funksjon emit_json_stringify(native: liste_heiltall, arg_reg: heiltall, dst_reg: heiltall, os: tekst) -> heiltall {
    legg_u32(native, 0xF9400000 | (arg_reg << 5) | 9)   // ldr x9, [Xarg]  (type)
    legg_u32(native, 0xF100053F)                        // cmp x9, #1  (int?)
    la p_bne_c2 = lengde(native)
    legg_u32(native, 0)                                 // b.ne c2
    emit_tekst_int(native, arg_reg, dst_reg)
    la p_end1 = lengde(native)
    legg_u32(native, 0)                                 // b end
    la lbl_c2 = lengde(native)
    legg_u32(native, 0xF100093F)                        // cmp x9, #2  (bool?)
    la p_bne_c3 = lengde(native)
    legg_u32(native, 0)                                 // b.ne c3
    // bool: [x28] = "true"/"false"
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 9)   // ldr x9, [Xarg, #8]  (val)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28
    la p_cbz_false = lengde(native)
    legg_u32(native, 0)                                 // cbz x9, bfalse
    legg_u32(native, 0xD280008B)                        // movz x11, #4
    legg_u32(native, 0xF90001CB)                        // str x11, [x14]
    legg_u32(native, 0x52800E80)                        // movz w0, #116 't'
    legg_u32(native, 0x390021C0)                        // strb w0, [x14, #8]
    legg_u32(native, 0x52800E40)                        // movz w0, #114 'r'
    legg_u32(native, 0x390025C0)                        // strb w0, [x14, #9]
    legg_u32(native, 0x52800EA0)                        // movz w0, #117 'u'
    legg_u32(native, 0x390029C0)                        // strb w0, [x14, #10]
    legg_u32(native, 0x52800CA0)                        // movz w0, #101 'e'
    legg_u32(native, 0x39002DC0)                        // strb w0, [x14, #11]
    legg_u32(native, 0x910041DC)                        // add x28, x14, #16
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    la p_b_boolend = lengde(native)
    legg_u32(native, 0)                                 // b boolend
    la lbl_bfalse = lengde(native)
    legg_u32(native, 0xD28000AB)                        // movz x11, #5
    legg_u32(native, 0xF90001CB)                        // str x11, [x14]
    legg_u32(native, 0x52800CC0)                        // movz w0, #102 'f'
    legg_u32(native, 0x390021C0)                        // strb w0, [x14, #8]
    legg_u32(native, 0x52800C20)                        // movz w0, #97 'a'
    legg_u32(native, 0x390025C0)                        // strb w0, [x14, #9]
    legg_u32(native, 0x52800D80)                        // movz w0, #108 'l'
    legg_u32(native, 0x390029C0)                        // strb w0, [x14, #10]
    legg_u32(native, 0x52800E60)                        // movz w0, #115 's'
    legg_u32(native, 0x39002DC0)                        // strb w0, [x14, #11]
    legg_u32(native, 0x52800CA0)                        // movz w0, #101 'e'
    legg_u32(native, 0x390031C0)                        // strb w0, [x14, #12]
    legg_u32(native, 0x910041DC)                        // add x28, x14, #16
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    la lbl_boolend = lengde(native)
    la p_end2 = lengde(native)
    legg_u32(native, 0)                                 // b end
    la lbl_c3 = lengde(native)
    legg_u32(native, 0xF1000D3F)                        // cmp x9, #3  (streng?)
    la p_bne_empty = lengde(native)
    legg_u32(native, 0)                                 // b.ne c_empty
    // streng: "\"" + bytes + "\""
    legg_u32(native, 0xF9400400 | (arg_reg << 5) | 9)   // ldr x9, [Xarg, #8]  (strdata)
    legg_u32(native, 0xF940012A)                        // ldr x10, [x9]  (len)
    legg_u32(native, 0x91002129)                        // add x9, x9, #8 (bytes)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28
    legg_u32(native, 0x9100094B)                        // add x11, x10, #2 (newlen)
    legg_u32(native, 0xF90001CB)                        // str x11, [x14]
    legg_u32(native, 0x910021CF)                        // add x15, x14, #8 (dst)
    legg_u32(native, 0x52800440)                        // movz w0, #34 '"'
    legg_u32(native, 0x390001E0)                        // strb w0, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0xAA0903F0)                        // mov x16, x9  (src)
    legg_u32(native, 0xAA0A03F1)                        // mov x17, x10 (count)
    la p_cbz_qafter = lengde(native)
    legg_u32(native, 0)                                 // cbz x17, qafter
    la lbl_qcopy = lengde(native)
    legg_u32(native, 0x39400200)                        // ldrb w0, [x16]
    legg_u32(native, 0x390001E0)                        // strb w0, [x15]
    legg_u32(native, 0x91000610)                        // add x16, x16, #1
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0xD1000631)                        // sub x17, x17, #1
    la p_cbnz_qcopy = lengde(native)
    legg_u32(native, 0)                                 // cbnz x17, qcopy
    la lbl_qafter = lengde(native)
    legg_u32(native, 0x52800440)                        // movz w0, #34 '"'
    legg_u32(native, 0x390001E0)                        // strb w0, [x15]
    legg_u32(native, 0x910005EF)                        // add x15, x15, #1
    legg_u32(native, 0xAA0F03FC)                        // mov x28, x15
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    la p_end3 = lengde(native)
    legg_u32(native, 0)                                 // b end
    la lbl_empty = lengde(native)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28
    legg_u32(native, 0xD280000B)                        // movz x11, #0
    legg_u32(native, 0xF90001CB)                        // str x11, [x14]
    legg_u32(native, 0x910021DC)                        // add x28, x14, #8
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    la lbl_end = lengde(native)
    skriv_u32(native, p_bne_c2,     0x54000001 | ((((lbl_c2      - p_bne_c2)     / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_end1,       0x14000000 |  (((lbl_end     - p_end1)       / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bne_c3,     0x54000001 | ((((lbl_c3      - p_bne_c3)     / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_false,  0xB4000009 | ((((lbl_bfalse  - p_cbz_false)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_boolend,  0x14000000 |  (((lbl_boolend - p_b_boolend)  / 4) & 0x03FFFFFF))
    skriv_u32(native, p_end2,       0x14000000 |  (((lbl_end     - p_end2)       / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bne_empty,  0x54000001 | ((((lbl_empty   - p_bne_empty)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz_qafter, 0xB4000011 | ((((lbl_qafter  - p_cbz_qafter) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz_qcopy, 0xB5000011 | ((((lbl_qcopy   - p_cbnz_qcopy) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_end3,       0x14000000 |  (((lbl_end     - p_end3)       / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 3: konkatenerer to NcVal-strengar (Xleft_reg, Xright_reg) og legg den nye
// NcVal-strengen i Xdst_reg. Ny strdata = [lenL+lenR][L-bytes][R-bytes] på heapen.
// AArch64 tillèt uinnretta ldr/str, så x28 blir bumpa med nøyaktig 8+total (dei
// neste NcVal-ane blir framleis korrekt lesne). Scratch: x0, x9–x16.
funksjon emit_str_concat(native: liste_heiltall, left_reg: heiltall, right_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (left_reg << 5) | 9)   // ldr x9,  [Xleft, #8]  (strdataL)
    legg_u32(native, 0xF9400400 | (right_reg << 5) | 10) // ldr x10, [Xright, #8] (strdataR)
    legg_u32(native, 0xF940012B)                         // ldr x11, [x9]   (lenL)
    legg_u32(native, 0xF940014C)                         // ldr x12, [x10]  (lenR)
    legg_u32(native, 0x8B0C016D)                         // add x13, x11, x12 (total)
    legg_u32(native, 0xAA1C03EE)                         // mov x14, x28    (ny strdata-base)
    legg_u32(native, 0xF90001CD)                         // str x13, [x14]  (lengd)
    legg_u32(native, 0x910021CF)                         // add x15, x14, #8 (dst-peikar)
    legg_u32(native, 0x91002130)                         // add x16, x9, #8  (srcL)
    la p_cbzL = lengde(native)
    legg_u32(native, 0)                                  // cbz x11, doneL
    la lblL = lengde(native)
    legg_u32(native, 0x39400200)                         // ldrb w0, [x16]
    legg_u32(native, 0x390001E0)                         // strb w0, [x15]
    legg_u32(native, 0x91000610)                         // add x16, x16, #1
    legg_u32(native, 0x910005EF)                         // add x15, x15, #1
    legg_u32(native, 0xD100056B)                         // sub x11, x11, #1
    la p_cbnzL = lengde(native)
    legg_u32(native, 0)                                  // cbnz x11, lblL
    la lbldoneL = lengde(native)
    legg_u32(native, 0x91002150)                         // add x16, x10, #8 (srcR)
    la p_cbzR = lengde(native)
    legg_u32(native, 0)                                  // cbz x12, doneR
    la lblR = lengde(native)
    legg_u32(native, 0x39400200)                         // ldrb w0, [x16]
    legg_u32(native, 0x390001E0)                         // strb w0, [x15]
    legg_u32(native, 0x91000610)                         // add x16, x16, #1
    legg_u32(native, 0x910005EF)                         // add x15, x15, #1
    legg_u32(native, 0xD100058C)                         // sub x12, x12, #1
    la p_cbnzR = lengde(native)
    legg_u32(native, 0)                                  // cbnz x12, lblR
    la lbldoneR = lengde(native)
    legg_u32(native, 0xAA0F03FC)                         // mov x28, x15   (bump = strdata-slutt)
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    skriv_u32(native, p_cbzL,  0xB400000B | ((((lbldoneL - p_cbzL)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnzL, 0xB500000B | ((((lblL     - p_cbnzL) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbzR,  0xB400000C | ((((lbldoneR - p_cbzR)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnzR, 0xB500000C | ((((lblR     - p_cbnzR) / 4) & 0x7FFFF) << 5))
    returner 0
}

// Fase 6-JSON: bygg ein 1-byte NcVal-streng (byte `ch`) i Xdst_reg. Nyttast av
// den rekursive json_stringify-rutina til å lage skiljeteikn ("[", "]", ",", …).
funksjon emit_char_str(native: liste_heiltall, ch: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03EE)                    // mov x14, x28
    legg_u32(native, 0xD280002B)                    // movz x11, #1
    legg_u32(native, 0xF90001CB)                    // str x11, [x14]     (lengd=1)
    legg_u32(native, 0x52800000 | (ch << 5))        // movz w0, #ch
    legg_u32(native, 0x390021C0)                    // strb w0, [x14, #8]
    legg_u32(native, 0x910041DC)                    // add x28, x14, #16
    emit_ncval_alloc_ptr(native, 14, dst_reg, 3)
    returner 0
}

// Fase 6-JSON: rekursiv runtime-rutine __json_stringify(x0=NcVal*) → x0=streng.
// Ekte funksjon (bl-kalla, sjølv-rekursiv). Skalar → emit_json_stringify inline;
// liste(4) → "[" + barn "," … + "]"; kart(5) → "{" + "key":val "," … + "}".
// Kallekonvensjon: lagrar x19–x24 + x30 (operandstakken x19–x25 og x26/x27 er
// urørte for kvar utover x19–x24; x25 rører me ikkje; x28-heapen veks globalt).
// Tilstand over rekursjon: x19=akkumulator, x20=&element, x21=tal, x22=indeks.
// Sjølv-bl-ane blir patcha lokalt (mål = offset 0 i fragmentet, uavhengig av base).
funksjon emit_json_stringify_routine(os: tekst) -> liste_heiltall {
    la r: liste_heiltall = []
    // prolog
    legg_u32(r, 0xD10103FF)                          // sub sp, sp, #64
    legg_u32(r, 0xA90053F3)                          // stp x19, x20, [sp, #0]
    legg_u32(r, 0xA9015BF5)                          // stp x21, x22, [sp, #16]
    legg_u32(r, 0xA90263F7)                          // stp x23, x24, [sp, #32]
    legg_u32(r, 0xF9001BFE)                          // str x30, [sp, #48]
    // dispatch på type
    legg_u32(r, 0xF9400009)                          // ldr x9, [x0]  (type)
    legg_u32(r, 0xF100113F)                          // cmp x9, #4  (liste?)
    la p_beq_list = lengde(r)
    legg_u32(r, 0)                                   // b.eq list
    legg_u32(r, 0xF100153F)                          // cmp x9, #5  (kart?)
    la p_beq_map = lengde(r)
    legg_u32(r, 0)                                   // b.eq map
    emit_json_stringify(r, 0, 0, os)                 // skalar → x0 = streng
    la p_b_done1 = lengde(r)
    legg_u32(r, 0)                                   // b done
    // --- liste ---
    la lbl_list = lengde(r)
    legg_u32(r, 0xF9400409)                          // ldr x9, [x0, #8]  (listdata)
    legg_u32(r, 0xF9400135)                          // ldr x21, [x9]     (tal)
    legg_u32(r, 0x91002134)                          // add x20, x9, #8   (&elem[0])
    emit_char_str(r, 91, 19)                         // acc = "["  (x19)
    legg_u32(r, 0xD2800016)                          // movz x22, #0  (i=0)
    la lbl_lloop = lengde(r)
    legg_u32(r, 0xEB1502DF)                          // cmp x22, x21
    la p_bge_lend = lengde(r)
    legg_u32(r, 0)                                   // b.ge lend
    la p_cbz_sk1 = lengde(r)
    legg_u32(r, 0)                                   // cbz x22, sk1
    emit_char_str(r, 44, 0)                          // x0 = ","
    emit_str_concat(r, 19, 0, 19)                    // acc += ","
    la lbl_sk1 = lengde(r)
    legg_u32(r, 0x8B160E91)                          // add x17, x20, x22, lsl #3
    legg_u32(r, 0xF9400220)                          // ldr x0, [x17]  (elem[i])
    la p_bl1 = lengde(r)
    legg_u32(r, 0x94000000)                          // bl self
    emit_str_concat(r, 19, 0, 19)                    // acc += stringify(elem)
    legg_u32(r, 0x910006D6)                          // add x22, x22, #1
    la p_bloop = lengde(r)
    legg_u32(r, 0)                                   // b lloop
    la lbl_lend = lengde(r)
    emit_char_str(r, 93, 0)                          // x0 = "]"
    emit_str_concat(r, 19, 0, 19)                    // acc += "]"
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19
    la p_b_done2 = lengde(r)
    legg_u32(r, 0)                                   // b done
    // --- kart ---
    la lbl_map = lengde(r)
    legg_u32(r, 0xF9400409)                          // ldr x9, [x0, #8]  (mapdata)
    legg_u32(r, 0xF9400135)                          // ldr x21, [x9]     (tal par)
    legg_u32(r, 0x91002134)                          // add x20, x9, #8   (&par[0])
    emit_char_str(r, 123, 19)                        // acc = "{"
    legg_u32(r, 0xD2800016)                          // movz x22, #0
    la lbl_mloop = lengde(r)
    legg_u32(r, 0xEB1502DF)                          // cmp x22, x21
    la p_bge_mend = lengde(r)
    legg_u32(r, 0)                                   // b.ge mend
    la p_cbz_sk2 = lengde(r)
    legg_u32(r, 0)                                   // cbz x22, sk2
    emit_char_str(r, 44, 0)                          // ","
    emit_str_concat(r, 19, 0, 19)
    la lbl_sk2 = lengde(r)
    legg_u32(r, 0x8B161291)                          // add x17, x20, x22, lsl #4  (&par[i])
    legg_u32(r, 0xF9400220)                          // ldr x0, [x17]  (nøkkel)
    la p_bl2 = lengde(r)
    legg_u32(r, 0x94000000)                          // bl self  (stringify(nøkkel) → "\"k\"")
    emit_str_concat(r, 19, 0, 19)                    // acc += "\"k\""
    emit_char_str(r, 58, 0)                          // ":"
    emit_str_concat(r, 19, 0, 19)                    // acc += ":"
    legg_u32(r, 0x8B161291)                          // add x17, x20, x22, lsl #4  (rekn på ny)
    legg_u32(r, 0xF9400620)                          // ldr x0, [x17, #8]  (verdi)
    la p_bl3 = lengde(r)
    legg_u32(r, 0x94000000)                          // bl self
    emit_str_concat(r, 19, 0, 19)                    // acc += stringify(verdi)
    legg_u32(r, 0x910006D6)                          // add x22, x22, #1
    la p_bmloop = lengde(r)
    legg_u32(r, 0)                                   // b mloop
    la lbl_mend = lengde(r)
    emit_char_str(r, 125, 0)                         // "}"
    emit_str_concat(r, 19, 0, 19)
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19
    // --- done / epilog ---
    la lbl_done = lengde(r)
    legg_u32(r, 0xF9401BFE)                          // ldr x30, [sp, #48]
    legg_u32(r, 0xA94263F7)                          // ldp x23, x24, [sp, #32]
    legg_u32(r, 0xA9415BF5)                          // ldp x21, x22, [sp, #16]
    legg_u32(r, 0xA94053F3)                          // ldp x19, x20, [sp, #0]
    legg_u32(r, 0x910103FF)                          // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                          // ret
    // patch greiner
    skriv_u32(r, p_beq_list, 0x54000000 | ((((lbl_list - p_beq_list) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_beq_map,  0x54000000 | ((((lbl_map  - p_beq_map)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_b_done1,  0x14000000 |  (((lbl_done  - p_b_done1)  / 4) & 0x03FFFFFF))
    skriv_u32(r, p_bge_lend, 0x5400000A | ((((lbl_lend  - p_bge_lend) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_cbz_sk1,  0xB4000016 | ((((lbl_sk1   - p_cbz_sk1)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_bloop,    0x14000000 |  (((lbl_lloop - p_bloop)    / 4) & 0x03FFFFFF))
    skriv_u32(r, p_b_done2,  0x14000000 |  (((lbl_done  - p_b_done2)  / 4) & 0x03FFFFFF))
    skriv_u32(r, p_bge_mend, 0x5400000A | ((((lbl_mend  - p_bge_mend) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_cbz_sk2,  0xB4000016 | ((((lbl_sk2   - p_cbz_sk2)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_bmloop,   0x14000000 |  (((lbl_mloop - p_bmloop)   / 4) & 0x03FFFFFF))
    // patch sjølv-bl (mål = offset 0 = rutinestart)
    skriv_u32(r, p_bl1, 0x94000000 | (((0 - p_bl1) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_bl2, 0x94000000 | (((0 - p_bl2) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_bl3, 0x94000000 | (((0 - p_bl3) / 4) & 0x03FFFFFF))
    returner r
}

// Fase 6-JSON: hopp over kvitrom (space/tab/nl/cr) frå cur (x19) opp til end (x20).
// Inline; rører berre x9 + x19 (cur). Nyttast av json_parse-rutina fleire stader.
funksjon emit_skip_ws(r: liste_heiltall) -> heiltall {
    la lbl_ws = lengde(r)
    legg_u32(r, 0xEB14027F)                          // cmp x19, x20
    la p_ge = lengde(r)
    legg_u32(r, 0)                                   // b.ge done
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100813F)                          // cmp w9, #32 (' ')
    la p32 = lengde(r)
    legg_u32(r, 0)                                   // b.eq adv
    legg_u32(r, 0x7100253F)                          // cmp w9, #9 ('\t')
    la p9 = lengde(r)
    legg_u32(r, 0)                                   // b.eq adv
    legg_u32(r, 0x7100293F)                          // cmp w9, #10 ('\n')
    la p10 = lengde(r)
    legg_u32(r, 0)                                   // b.eq adv
    legg_u32(r, 0x7100353F)                          // cmp w9, #13 ('\r')
    la p13 = lengde(r)
    legg_u32(r, 0)                                   // b.eq adv
    la p_b = lengde(r)
    legg_u32(r, 0)                                   // b done (ikkje kvitrom)
    la lbl_adv = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1
    la p_loop = lengde(r)
    legg_u32(r, 0)                                   // b ws
    la lbl_done = lengde(r)
    skriv_u32(r, p_ge,   0x5400000A | ((((lbl_done - p_ge) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p32,    0x54000000 | ((((lbl_adv - p32) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p9,     0x54000000 | ((((lbl_adv - p9)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p10,    0x54000000 | ((((lbl_adv - p10) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p13,    0x54000000 | ((((lbl_adv - p13) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_b,    0x14000000 |  (((lbl_done - p_b) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_loop, 0x14000000 |  (((lbl_ws - p_loop) / 4) & 0x03FFFFFF))
    returner 0
}

// Fase 6-JSON: rekursiv-descent parser __json_parse. Inn: x0=cur (bytepeikar),
// x1=end. Ut: x0=NcVal*, x1=ny cur. Peikar-kursor (ikkje base+indeks) for enkle
// ldrb. Liste/kart samlar element-peikarar på ein 256 KiB maskinstakk-buffer og
// kopierer til heap-listdata/mapdata etterpå (opptil 32768 slots per nivå — nok
// til ekte NCB-ar: functions-map ~2000 slots, største code-array ~6300). Streng
// utan escape-handtering; null → int 0. x19=cur, x20=end, x21=buffer-base,
// x22=skrivepeikar, x23=slot-tal. Sjølv-bl patcha lokalt (mål=offset 0).
funksjon emit_json_parse_routine() -> liste_heiltall {
    la r: liste_heiltall = []
    // prolog
    legg_u32(r, 0xD10103FF)                          // sub sp, sp, #64
    legg_u32(r, 0xA90053F3)                          // stp x19, x20, [sp]
    legg_u32(r, 0xA9015BF5)                          // stp x21, x22, [sp, #16]
    legg_u32(r, 0xA90263F7)                          // stp x23, x24, [sp, #32]
    legg_u32(r, 0xF9001BFE)                          // str x30, [sp, #48]
    legg_u32(r, 0xAA0003F3)                          // mov x19, x0  (cur)
    legg_u32(r, 0xAA0103F4)                          // mov x20, x1  (end)
    emit_skip_ws(r)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]  (fyrste teikn)
    legg_u32(r, 0x7101ED3F)                          // cmp w9, #123 ('{')
    la p_obj = lengde(r)
    legg_u32(r, 0)                                   // b.eq obj
    legg_u32(r, 0x71016D3F)                          // cmp w9, #91 ('[')
    la p_arr = lengde(r)
    legg_u32(r, 0)                                   // b.eq arr
    legg_u32(r, 0x7100893F)                          // cmp w9, #34 ('"')
    la p_strv = lengde(r)
    legg_u32(r, 0)                                   // b.eq str
    legg_u32(r, 0x7101D13F)                          // cmp w9, #116 ('t')
    la p_truev = lengde(r)
    legg_u32(r, 0)                                   // b.eq true
    legg_u32(r, 0x7101993F)                          // cmp w9, #102 ('f')
    la p_falsev = lengde(r)
    legg_u32(r, 0)                                   // b.eq false
    legg_u32(r, 0x7101B93F)                          // cmp w9, #110 ('n')
    la p_nullv = lengde(r)
    legg_u32(r, 0)                                   // b.eq null
    // --- tal (fallthrough) ---
    legg_u32(r, 0xD280000A)                          // movz x10, #0  (acc)
    legg_u32(r, 0xD280000B)                          // movz x11, #0  (neg-flagg)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100B53F)                          // cmp w9, #45 ('-')
    la p_num_notneg = lengde(r)
    legg_u32(r, 0)                                   // b.ne num_loop
    legg_u32(r, 0xD280002B)                          // movz x11, #1
    legg_u32(r, 0x91000673)                          // add x19, x19, #1
    la lbl_num_loop = lengde(r)
    legg_u32(r, 0xEB14027F)                          // cmp x19, x20
    la p_num_end1 = lengde(r)
    legg_u32(r, 0)                                   // b.ge num_done
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100C13F)                          // cmp w9, #48 ('0')
    la p_num_lt = lengde(r)
    legg_u32(r, 0)                                   // b.lt num_done
    legg_u32(r, 0x7100E53F)                          // cmp w9, #57 ('9')
    la p_num_gt = lengde(r)
    legg_u32(r, 0)                                   // b.gt num_done
    legg_u32(r, 0xD280014C)                          // movz x12, #10
    legg_u32(r, 0x9B0C7D4A)                          // mul x10, x10, x12
    legg_u32(r, 0x5100C129)                          // sub w9, w9, #48
    legg_u32(r, 0x8B09014A)                          // add x10, x10, x9
    legg_u32(r, 0x91000673)                          // add x19, x19, #1
    la p_num_loop = lengde(r)
    legg_u32(r, 0)                                   // b num_loop
    la lbl_num_done = lengde(r)
    legg_u32(r, 0xB400004B)                          // cbz x11, num_pos
    legg_u32(r, 0xCB0A03EA)                          // neg x10, x10
    la lbl_num_pos = lengde(r)
    legg_u32(r, 0xAA0A03E9)                          // mov x9, x10
    emit_ncval_alloc(r, 9, 0, 1)                     // boks int → x0
    la p_num_bdone = lengde(r)
    legg_u32(r, 0)                                   // b parse_done
    // --- streng ---
    la lbl_str = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp ")
    legg_u32(r, 0xAA1C03EE)                          // mov x14, x28  (strdata-base)
    legg_u32(r, 0x910021CF)                          // add x15, x14, #8 (skrivepeikar)
    la lbl_str_loop = lengde(r)
    legg_u32(r, 0xEB14027F)                          // cmp x19, x20
    la p_str_end1 = lengde(r)
    legg_u32(r, 0)                                   // b.ge str_end
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100893F)                          // cmp w9, #34 (")
    la p_str_close = lengde(r)
    legg_u32(r, 0)                                   // b.eq str_close
    legg_u32(r, 0x7101713F)                          // cmp w9, #92 (\)
    la p_str_esc = lengde(r)
    legg_u32(r, 0)                                   // b.eq str_esc
    la lbl_str_store = lengde(r)
    legg_u32(r, 0x390001E9)                          // strb w9, [x15]
    legg_u32(r, 0x910005EF)                          // add x15, x15, #1
    legg_u32(r, 0x91000673)                          // add x19, x19, #1
    la p_str_loop = lengde(r)
    legg_u32(r, 0)                                   // b str_loop
    // --- escape-handtering (JSON \" \\ \/ \n \r \t \b \f); \uXXXX ikkje i NCB-ar ---
    la lbl_str_esc = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp \)
    legg_u32(r, 0xEB14027F)                          // cmp x19, x20
    la p_str_esc_end = lengde(r)
    legg_u32(r, 0)                                   // b.ge str_end (daudt \ på slutten)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19] (escape-teikn)
    legg_u32(r, 0x7101BB3F)                          // cmp w9, #110 (n)
    la p_esc_n = lengde(r)
    legg_u32(r, 0)                                   // b.eq set_n
    legg_u32(r, 0x7101D13F)                          // cmp w9, #116 (t)
    la p_esc_t = lengde(r)
    legg_u32(r, 0)                                   // b.eq set_t
    legg_u32(r, 0x7101CB3F)                          // cmp w9, #114 (r)
    la p_esc_r = lengde(r)
    legg_u32(r, 0)                                   // b.eq set_r
    legg_u32(r, 0x7101893F)                          // cmp w9, #98 (b)
    la p_esc_b = lengde(r)
    legg_u32(r, 0)                                   // b.eq set_b
    legg_u32(r, 0x7101993F)                          // cmp w9, #102 (f)
    la p_esc_f = lengde(r)
    legg_u32(r, 0)                                   // b.eq set_f
    la p_esc_lit = lengde(r)
    legg_u32(r, 0)                                   // b str_store (", \, / og andre → literal w9)
    la lbl_set_n = lengde(r)
    legg_u32(r, 0x52800149)                          // movz w9, #10
    la p_setn = lengde(r)
    legg_u32(r, 0)                                   // b str_store
    la lbl_set_t = lengde(r)
    legg_u32(r, 0x52800129)                          // movz w9, #9
    la p_sett = lengde(r)
    legg_u32(r, 0)                                   // b str_store
    la lbl_set_r = lengde(r)
    legg_u32(r, 0x528001A9)                          // movz w9, #13
    la p_setr = lengde(r)
    legg_u32(r, 0)                                   // b str_store
    la lbl_set_b = lengde(r)
    legg_u32(r, 0x52800109)                          // movz w9, #8
    la p_setb = lengde(r)
    legg_u32(r, 0)                                   // b str_store
    la lbl_set_f = lengde(r)
    legg_u32(r, 0x52800189)                          // movz w9, #12
    la p_setf = lengde(r)
    legg_u32(r, 0)                                   // b str_store
    la lbl_str_close = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp sluttande ")
    la lbl_str_end = lengde(r)
    legg_u32(r, 0xCB0E01EA)                          // sub x10, x15, x14
    legg_u32(r, 0xD100214A)                          // sub x10, x10, #8  (lengd)
    legg_u32(r, 0xF90001CA)                          // str x10, [x14]
    legg_u32(r, 0xAA0F03FC)                          // mov x28, x15
    emit_ncval_alloc_ptr(r, 14, 0, 3)               // boks streng → x0
    la p_str_bdone = lengde(r)
    legg_u32(r, 0)                                   // b parse_done
    // --- true ---
    la lbl_true = lengde(r)
    legg_u32(r, 0x91001273)                          // add x19, x19, #4
    legg_u32(r, 0xD2800029)                          // movz x9, #1
    emit_ncval_alloc(r, 9, 0, 2)                     // boks bool → x0
    la p_true_b = lengde(r)
    legg_u32(r, 0)                                   // b parse_done
    // --- false ---
    la lbl_false = lengde(r)
    legg_u32(r, 0x91001673)                          // add x19, x19, #5
    legg_u32(r, 0xD2800009)                          // movz x9, #0
    emit_ncval_alloc(r, 9, 0, 2)
    la p_false_b = lengde(r)
    legg_u32(r, 0)                                   // b parse_done
    // --- null → int 0 ---
    la lbl_null = lengde(r)
    legg_u32(r, 0x91001273)                          // add x19, x19, #4
    legg_u32(r, 0xD2800009)                          // movz x9, #0
    emit_ncval_alloc(r, 9, 0, 1)
    la p_null_b = lengde(r)
    legg_u32(r, 0)                                   // b parse_done
    // --- liste ---
    la lbl_arr = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp [)
    legg_u32(r, 0xD14103FF)                          // sub sp, sp, #262144 (32768 slots)
    legg_u32(r, 0x910003F5)                          // add x21, sp, #0  (buffer-base)
    legg_u32(r, 0xAA1503F6)                          // mov x22, x21     (skrivepeikar)
    legg_u32(r, 0xD2800017)                          // movz x23, #0     (tal)
    emit_skip_ws(r)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7101753F)                          // cmp w9, #93 (])
    la p_arr_empty = lengde(r)
    legg_u32(r, 0)                                   // b.eq arr_end
    la lbl_arr_loop = lengde(r)
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19
    legg_u32(r, 0xAA1403E1)                          // mov x1, x20
    la p_arr_bl = lengde(r)
    legg_u32(r, 0x94000000)                          // bl self
    legg_u32(r, 0xAA0103F3)                          // mov x19, x1
    legg_u32(r, 0xF90002C0)                          // str x0, [x22]
    legg_u32(r, 0x910022D6)                          // add x22, x22, #8
    legg_u32(r, 0x910006F7)                          // add x23, x23, #1
    emit_skip_ws(r)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100B13F)                          // cmp w9, #44 (,)
    la p_arr_notcomma = lengde(r)
    legg_u32(r, 0)                                   // b.ne arr_end
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp ,)
    emit_skip_ws(r)
    la p_arr_loop = lengde(r)
    legg_u32(r, 0)                                   // b arr_loop
    la lbl_arr_end = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp ])
    legg_u32(r, 0xAA1C03EE)                          // mov x14, x28
    legg_u32(r, 0xF90001D7)                          // str x23, [x14]  (count)
    legg_u32(r, 0x910021CF)                          // add x15, x14, #8
    legg_u32(r, 0xAA1503E9)                          // mov x9, x21     (src)
    legg_u32(r, 0xD280000C)                          // movz x12, #0    (i)
    la lbl_arr_copy = lengde(r)
    legg_u32(r, 0xEB17019F)                          // cmp x12, x23
    la p_arr_copyend = lengde(r)
    legg_u32(r, 0)                                   // b.ge arr_copy_done
    legg_u32(r, 0xF940012A)                          // ldr x10, [x9]
    legg_u32(r, 0xF90001EA)                          // str x10, [x15]
    legg_u32(r, 0x91002129)                          // add x9, x9, #8
    legg_u32(r, 0x910021EF)                          // add x15, x15, #8
    legg_u32(r, 0x9100058C)                          // add x12, x12, #1
    la p_arr_copyloop = lengde(r)
    legg_u32(r, 0)                                   // b arr_copy
    la lbl_arr_copy_done = lengde(r)
    legg_u32(r, 0xAA0F03FC)                          // mov x28, x15
    legg_u32(r, 0x914103FF)                          // add sp, sp, #262144
    emit_ncval_alloc_ptr(r, 14, 0, 4)               // boks liste → x0
    la p_arr_bdone = lengde(r)
    legg_u32(r, 0)                                   // b parse_done
    // --- kart ---
    la lbl_obj = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp {)
    legg_u32(r, 0xD14103FF)                          // sub sp, sp, #262144 (32768 slots)
    legg_u32(r, 0x910003F5)                          // add x21, sp, #0
    legg_u32(r, 0xAA1503F6)                          // mov x22, x21
    legg_u32(r, 0xD2800017)                          // movz x23, #0
    emit_skip_ws(r)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7101F53F)                          // cmp w9, #125 (})
    la p_obj_empty = lengde(r)
    legg_u32(r, 0)                                   // b.eq obj_end
    la lbl_obj_loop = lengde(r)
    emit_skip_ws(r)
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19
    legg_u32(r, 0xAA1403E1)                          // mov x1, x20
    la p_obj_bl1 = lengde(r)
    legg_u32(r, 0x94000000)                          // bl self (nøkkel)
    legg_u32(r, 0xAA0103F3)                          // mov x19, x1
    legg_u32(r, 0xF90002C0)                          // str x0, [x22]
    legg_u32(r, 0x910022D6)                          // add x22, x22, #8
    legg_u32(r, 0x910006F7)                          // add x23, x23, #1
    emit_skip_ws(r)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100E93F)                          // cmp w9, #58 (:)
    la p_obj_nocolon = lengde(r)
    legg_u32(r, 0)                                   // b.ne obj_aftercolon
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp :)
    la lbl_obj_aftercolon = lengde(r)
    emit_skip_ws(r)
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19
    legg_u32(r, 0xAA1403E1)                          // mov x1, x20
    la p_obj_bl2 = lengde(r)
    legg_u32(r, 0x94000000)                          // bl self (verdi)
    legg_u32(r, 0xAA0103F3)                          // mov x19, x1
    legg_u32(r, 0xF90002C0)                          // str x0, [x22]
    legg_u32(r, 0x910022D6)                          // add x22, x22, #8
    legg_u32(r, 0x910006F7)                          // add x23, x23, #1
    emit_skip_ws(r)
    legg_u32(r, 0x39400269)                          // ldrb w9, [x19]
    legg_u32(r, 0x7100B13F)                          // cmp w9, #44 (,)
    la p_obj_notcomma = lengde(r)
    legg_u32(r, 0)                                   // b.ne obj_end
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp ,)
    la p_obj_loop = lengde(r)
    legg_u32(r, 0)                                   // b obj_loop
    la lbl_obj_end = lengde(r)
    legg_u32(r, 0x91000673)                          // add x19, x19, #1 (hopp })
    legg_u32(r, 0xAA1C03EE)                          // mov x14, x28
    legg_u32(r, 0xD341FEEB)                          // lsr x11, x23, #1 (npar)
    legg_u32(r, 0xF90001CB)                          // str x11, [x14]
    legg_u32(r, 0x910021CF)                          // add x15, x14, #8
    legg_u32(r, 0xAA1503E9)                          // mov x9, x21
    legg_u32(r, 0xD280000C)                          // movz x12, #0
    la lbl_obj_copy = lengde(r)
    legg_u32(r, 0xEB17019F)                          // cmp x12, x23
    la p_obj_copyend = lengde(r)
    legg_u32(r, 0)                                   // b.ge obj_copy_done
    legg_u32(r, 0xF940012A)                          // ldr x10, [x9]
    legg_u32(r, 0xF90001EA)                          // str x10, [x15]
    legg_u32(r, 0x91002129)                          // add x9, x9, #8
    legg_u32(r, 0x910021EF)                          // add x15, x15, #8
    legg_u32(r, 0x9100058C)                          // add x12, x12, #1
    la p_obj_copyloop = lengde(r)
    legg_u32(r, 0)                                   // b obj_copy
    la lbl_obj_copy_done = lengde(r)
    legg_u32(r, 0xAA0F03FC)                          // mov x28, x15
    legg_u32(r, 0x914103FF)                          // add sp, sp, #262144
    emit_ncval_alloc_ptr(r, 14, 0, 5)               // boks kart → x0
    // fall to parse_done
    la lbl_parse_done = lengde(r)
    legg_u32(r, 0xAA1303E1)                          // mov x1, x19  (ny cur)
    legg_u32(r, 0xF9401BFE)                          // ldr x30, [sp, #48]
    legg_u32(r, 0xA94263F7)                          // ldp x23, x24, [sp, #32]
    legg_u32(r, 0xA9415BF5)                          // ldp x21, x22, [sp, #16]
    legg_u32(r, 0xA94053F3)                          // ldp x19, x20, [sp]
    legg_u32(r, 0x910103FF)                          // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                          // ret
    // patch dispatch-greiner
    skriv_u32(r, p_obj,    0x54000000 | ((((lbl_obj   - p_obj)    / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_arr,    0x54000000 | ((((lbl_arr   - p_arr)    / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_strv,   0x54000000 | ((((lbl_str   - p_strv)   / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_truev,  0x54000000 | ((((lbl_true  - p_truev)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_falsev, 0x54000000 | ((((lbl_false - p_falsev) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_nullv,  0x54000000 | ((((lbl_null  - p_nullv)  / 4) & 0x7FFFF) << 5))
    // tal
    skriv_u32(r, p_num_notneg, 0x54000001 | ((((lbl_num_loop - p_num_notneg) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_num_end1,   0x5400000A | ((((lbl_num_done - p_num_end1) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_num_lt,     0x5400000B | ((((lbl_num_done - p_num_lt) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_num_gt,     0x5400000C | ((((lbl_num_done - p_num_gt) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_num_loop,   0x14000000 |  (((lbl_num_loop - p_num_loop) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_num_bdone,  0x14000000 |  (((lbl_parse_done - p_num_bdone) / 4) & 0x03FFFFFF))
    // streng
    skriv_u32(r, p_str_end1,   0x5400000A | ((((lbl_str_end - p_str_end1) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_str_close,  0x54000000 | ((((lbl_str_close - p_str_close) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_str_loop,   0x14000000 |  (((lbl_str_loop - p_str_loop) / 4) & 0x03FFFFFF))
    // streng-escape-greiner
    skriv_u32(r, p_str_esc,     0x54000000 | ((((lbl_str_esc - p_str_esc) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_str_esc_end, 0x5400000A | ((((lbl_str_end - p_str_esc_end) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_esc_n,       0x54000000 | ((((lbl_set_n - p_esc_n) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_esc_t,       0x54000000 | ((((lbl_set_t - p_esc_t) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_esc_r,       0x54000000 | ((((lbl_set_r - p_esc_r) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_esc_b,       0x54000000 | ((((lbl_set_b - p_esc_b) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_esc_f,       0x54000000 | ((((lbl_set_f - p_esc_f) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_esc_lit,     0x14000000 |  (((lbl_str_store - p_esc_lit) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_setn,        0x14000000 |  (((lbl_str_store - p_setn) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_sett,        0x14000000 |  (((lbl_str_store - p_sett) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_setr,        0x14000000 |  (((lbl_str_store - p_setr) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_setb,        0x14000000 |  (((lbl_str_store - p_setb) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_setf,        0x14000000 |  (((lbl_str_store - p_setf) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_str_bdone,  0x14000000 |  (((lbl_parse_done - p_str_bdone) / 4) & 0x03FFFFFF))
    // true/false/null
    skriv_u32(r, p_true_b,  0x14000000 | (((lbl_parse_done - p_true_b) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_false_b, 0x14000000 | (((lbl_parse_done - p_false_b) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_null_b,  0x14000000 | (((lbl_parse_done - p_null_b) / 4) & 0x03FFFFFF))
    // liste
    skriv_u32(r, p_arr_empty,    0x54000000 | ((((lbl_arr_end - p_arr_empty) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_arr_notcomma, 0x54000001 | ((((lbl_arr_end - p_arr_notcomma) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_arr_loop,     0x14000000 | (((lbl_arr_loop - p_arr_loop) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_arr_copyend,  0x5400000A | ((((lbl_arr_copy_done - p_arr_copyend) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_arr_copyloop, 0x14000000 | (((lbl_arr_copy - p_arr_copyloop) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_arr_bdone,    0x14000000 | (((lbl_parse_done - p_arr_bdone) / 4) & 0x03FFFFFF))
    // kart
    skriv_u32(r, p_obj_empty,    0x54000000 | ((((lbl_obj_end - p_obj_empty) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_obj_nocolon,  0x54000001 | ((((lbl_obj_aftercolon - p_obj_nocolon) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_obj_notcomma, 0x54000001 | ((((lbl_obj_end - p_obj_notcomma) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_obj_loop,     0x14000000 | (((lbl_obj_loop - p_obj_loop) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_obj_copyend,  0x5400000A | ((((lbl_obj_copy_done - p_obj_copyend) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_obj_copyloop, 0x14000000 | (((lbl_obj_copy - p_obj_copyloop) / 4) & 0x03FFFFFF))
    // sjølv-bl (mål = offset 0)
    skriv_u32(r, p_arr_bl,  0x94000000 | (((0 - p_arr_bl)  / 4) & 0x03FFFFFF))
    skriv_u32(r, p_obj_bl1, 0x94000000 | (((0 - p_obj_bl1) / 4) & 0x03FFFFFF))
    skriv_u32(r, p_obj_bl2, 0x94000000 | (((0 - p_obj_bl2) / 4) & 0x03FFFFFF))
    returner r
}

// Fase 8: byggjer ein NcVal-streng frå bytes [Xsreg..Xereg) og legg peikaren i x0.
// Scratch x0, x10, x14–x17, x28. Rører ikkje Xsreg/Xereg (utanom å lese dei).
funksjon emit_substr(r: liste_heiltall, sreg: heiltall, ereg: heiltall) -> heiltall {
    legg_u32(r, 0xCB000000 | (sreg << 16) | (ereg << 5) | 10) // sub x10, Xereg, Xsreg (lengd)
    legg_u32(r, 0xAA1C03EE)                          // mov x14, x28 (strdata-base)
    legg_u32(r, 0xF90001CA)                          // str x10, [x14]
    legg_u32(r, 0x910021CF)                          // add x15, x14, #8 (dst)
    legg_u32(r, 0xAA0003F0 | (sreg << 16))           // mov x16, Xsreg (src)
    legg_u32(r, 0xAA0A03F1)                          // mov x17, x10 (count)
    la p_cbz = lengde(r)
    legg_u32(r, 0)                                   // cbz x17, after
    la lbl_loop = lengde(r)
    legg_u32(r, 0x39400200)                          // ldrb w0, [x16]
    legg_u32(r, 0x390001E0)                          // strb w0, [x15]
    legg_u32(r, 0x91000610)                          // add x16, x16, #1
    legg_u32(r, 0x910005EF)                          // add x15, x15, #1
    legg_u32(r, 0xD1000631)                          // sub x17, x17, #1
    la p_cbnz = lengde(r)
    legg_u32(r, 0)                                   // cbnz x17, loop
    la lbl_after = lengde(r)
    legg_u32(r, 0xAA0F03FC)                          // mov x28, x15
    emit_ncval_alloc_ptr(r, 14, 0, 3)               // boks streng → x0
    skriv_u32(r, p_cbz,  0xB4000011 | ((((lbl_after - p_cbz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_cbnz, 0xB5000011 | ((((lbl_loop  - p_cbnz) / 4) & 0x7FFFF) << 5))
    returner 0
}

// Fase 8: rekursiv-fri runtime-rutine __split(x0=streng, x1=delim) → x0=liste av
// delstrengar. x19=segmentstart, x20=skann-pos, x21=input-end, x22=delim-bytes,
// x23=delim-len, x24=buffer-skrivepeikar; buffer-basen er sp (etter sub sp,#512).
// Generell (fleirteikns) delim via byte-samanlikning.
funksjon emit_split_routine() -> liste_heiltall {
    la r: liste_heiltall = []
    legg_u32(r, 0xD10103FF)                          // sub sp, sp, #64
    legg_u32(r, 0xA90053F3)                          // stp x19, x20, [sp]
    legg_u32(r, 0xA9015BF5)                          // stp x21, x22, [sp, #16]
    legg_u32(r, 0xA90263F7)                          // stp x23, x24, [sp, #32]
    legg_u32(r, 0xF9001BFE)                          // str x30, [sp, #48]
    legg_u32(r, 0xF9400409)                          // ldr x9, [x0, #8] (streng strdata)
    legg_u32(r, 0xF940012A)                          // ldr x10, [x9]   (len)
    legg_u32(r, 0x91002133)                          // add x19, x9, #8 (seg_start = bytes)
    legg_u32(r, 0x8B0A0275)                          // add x21, x19, x10 (input_end)
    legg_u32(r, 0xAA1303F4)                          // mov x20, x19    (scan_pos)
    legg_u32(r, 0xF9400429)                          // ldr x9, [x1, #8] (delim strdata)
    legg_u32(r, 0xF9400137)                          // ldr x23, [x9]   (delim_len)
    legg_u32(r, 0x91002136)                          // add x22, x9, #8 (delim_bytes)
    // Segment-peikarbuffer på stakken. 32768 slots (som __json_parse, linjene
    // 2785/2839) — nok til å splitte den største kjeldefila (vm.no, 5561 linjer)
    // med rikeleg margin; buffer blir frigjort ved ret (add sp,#262144 under).
    // TIDLEGARE 512 byte (64 slots) → split av fil med >64 segment skreiv forbi
    // bufferet og smadra lagra x30/LR → ret hoppa i heapen (SIGBUS/SIGSEGV).
    legg_u32(r, 0xD14103FF)                          // sub sp, sp, #262144 (32768 slots)
    legg_u32(r, 0x910003F8)                          // add x24, sp, #0  (write ptr)
    la lbl_scan = lengde(r)
    legg_u32(r, 0x8B170289)                          // add x9, x20, x23 (pos+dlen)
    legg_u32(r, 0xEB15013F)                          // cmp x9, x21
    la p_scan_gt = lengde(r)
    legg_u32(r, 0)                                   // b.gt final
    legg_u32(r, 0xAA1403E0)                          // mov x0, x20 (input ptr)
    legg_u32(r, 0xAA1603E1)                          // mov x1, x22 (delim ptr)
    legg_u32(r, 0xAA1703E2)                          // mov x2, x23 (count)
    la lbl_cmp = lengde(r)
    la p_cbz_match = lengde(r)
    legg_u32(r, 0)                                   // cbz x2, matched
    legg_u32(r, 0x39400009)                          // ldrb w9, [x0]
    legg_u32(r, 0x3940002A)                          // ldrb w10, [x1]
    legg_u32(r, 0x6B0A013F)                          // cmp w9, w10
    la p_bne_nm = lengde(r)
    legg_u32(r, 0)                                   // b.ne notmatch
    legg_u32(r, 0x91000400)                          // add x0, x0, #1
    legg_u32(r, 0x91000421)                          // add x1, x1, #1
    legg_u32(r, 0xD1000442)                          // sub x2, x2, #1
    la p_b_cmp = lengde(r)
    legg_u32(r, 0)                                   // b cmp
    la lbl_matched = lengde(r)
    emit_substr(r, 19, 20)                           // delstreng [seg_start, scan_pos) → x0
    legg_u32(r, 0xF9000300)                          // str x0, [x24]
    legg_u32(r, 0x91002318)                          // add x24, x24, #8
    legg_u32(r, 0x8B170293)                          // add x19, x20, x23 (seg_start = pos+dlen)
    legg_u32(r, 0xAA1303F4)                          // mov x20, x19
    la p_b_scan1 = lengde(r)
    legg_u32(r, 0)                                   // b scan
    la lbl_notmatch = lengde(r)
    legg_u32(r, 0x91000694)                          // add x20, x20, #1
    la p_b_scan2 = lengde(r)
    legg_u32(r, 0)                                   // b scan
    la lbl_final = lengde(r)
    emit_substr(r, 19, 21)                           // siste delstreng [seg_start, input_end)
    legg_u32(r, 0xF9000300)                          // str x0, [x24]
    legg_u32(r, 0x91002318)                          // add x24, x24, #8
    // bygg listdata frå [sp..x24)
    legg_u32(r, 0x910003E9)                          // mov x9, sp (buffer-base)
    legg_u32(r, 0xCB09030A)                          // sub x10, x24, x9 (byte)
    legg_u32(r, 0xD343FD4A)                          // lsr x10, x10, #3 (count)
    legg_u32(r, 0xAA1C03EE)                          // mov x14, x28
    legg_u32(r, 0xF90001CA)                          // str x10, [x14] (count)
    legg_u32(r, 0x910021CF)                          // add x15, x14, #8
    legg_u32(r, 0xD280000B)                          // movz x11, #0
    la lbl_copy = lengde(r)
    legg_u32(r, 0xEB0A017F)                          // cmp x11, x10
    la p_copy_ge = lengde(r)
    legg_u32(r, 0)                                   // b.ge copydone
    legg_u32(r, 0xF940012C)                          // ldr x12, [x9]
    legg_u32(r, 0xF90001EC)                          // str x12, [x15]
    legg_u32(r, 0x91002129)                          // add x9, x9, #8
    legg_u32(r, 0x910021EF)                          // add x15, x15, #8
    legg_u32(r, 0x9100056B)                          // add x11, x11, #1
    la p_b_copy = lengde(r)
    legg_u32(r, 0)                                   // b copy
    la lbl_copydone = lengde(r)
    legg_u32(r, 0xAA0F03FC)                          // mov x28, x15
    emit_ncval_alloc_ptr(r, 14, 0, 4)               // boks liste → x0
    legg_u32(r, 0x914103FF)                          // add sp, sp, #262144 (frigi buffer)
    legg_u32(r, 0xF9401BFE)                          // ldr x30, [sp, #48]
    legg_u32(r, 0xA94263F7)                          // ldp x23, x24, [sp, #32]
    legg_u32(r, 0xA9415BF5)                          // ldp x21, x22, [sp, #16]
    legg_u32(r, 0xA94053F3)                          // ldp x19, x20, [sp]
    legg_u32(r, 0x910103FF)                          // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                          // ret
    skriv_u32(r, p_scan_gt,  0x5400000C | ((((lbl_final    - p_scan_gt)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_cbz_match, 0xB4000002 | ((((lbl_matched - p_cbz_match) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_bne_nm,   0x54000001 | ((((lbl_notmatch - p_bne_nm)   / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_b_cmp,    0x14000000 |  (((lbl_cmp      - p_b_cmp)    / 4) & 0x03FFFFFF))
    skriv_u32(r, p_b_scan1,  0x14000000 |  (((lbl_scan     - p_b_scan1)  / 4) & 0x03FFFFFF))
    skriv_u32(r, p_b_scan2,  0x14000000 |  (((lbl_scan     - p_b_scan2)  / 4) & 0x03FFFFFF))
    skriv_u32(r, p_copy_ge,  0x5400000A | ((((lbl_copydone - p_copy_ge)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_b_copy,   0x14000000 |  (((lbl_copy     - p_b_copy)   / 4) & 0x03FFFFFF))
    returner r
}

// Fase 8: runtime-rutine __join(x0=liste, x1=sep) → x0=streng. Konkatenerer
// element med separator. x19=akkumulator, x20=sep, x21=&element[0], x22=count,
// x23=indeks; emit_str_concat rører berre x9–x16/x0/x28, så tilstanden overlever.
funksjon emit_join_routine() -> liste_heiltall {
    la r: liste_heiltall = []
    legg_u32(r, 0xD10103FF)                          // sub sp, sp, #64
    legg_u32(r, 0xA90053F3)                          // stp x19, x20, [sp]
    legg_u32(r, 0xA9015BF5)                          // stp x21, x22, [sp, #16]
    legg_u32(r, 0xA90263F7)                          // stp x23, x24, [sp, #32]
    legg_u32(r, 0xF9001BFE)                          // str x30, [sp, #48]
    legg_u32(r, 0xAA0103F4)                          // mov x20, x1 (sep)
    legg_u32(r, 0xF9400409)                          // ldr x9, [x0, #8] (listdata)
    legg_u32(r, 0xF9400136)                          // ldr x22, [x9]   (count)
    legg_u32(r, 0x91002135)                          // add x21, x9, #8 (&elem[0])
    // akkumulator = tom streng
    legg_u32(r, 0xAA1C03EE)                          // mov x14, x28
    legg_u32(r, 0xD280000B)                          // movz x11, #0
    legg_u32(r, 0xF90001CB)                          // str x11, [x14] (len 0)
    legg_u32(r, 0x910021DC)                          // add x28, x14, #8
    emit_ncval_alloc_ptr(r, 14, 19, 3)              // acc = "" i x19
    legg_u32(r, 0xD2800017)                          // movz x23, #0 (i)
    la lbl_loop = lengde(r)
    legg_u32(r, 0xEB1602FF)                          // cmp x23, x22
    la p_ge = lengde(r)
    legg_u32(r, 0)                                   // b.ge done
    la p_cbz = lengde(r)
    legg_u32(r, 0)                                   // cbz x23, skip_sep
    emit_str_concat(r, 19, 20, 19)                   // acc += sep
    la lbl_skip = lengde(r)
    legg_u32(r, 0x8B170EA9)                          // add x9, x21, x23, lsl #3 (&elem[i])
    legg_u32(r, 0xF9400120)                          // ldr x0, [x9] (elem[i])
    emit_str_concat(r, 19, 0, 19)                    // acc += elem[i]
    legg_u32(r, 0x910006F7)                          // add x23, x23, #1
    la p_bloop = lengde(r)
    legg_u32(r, 0)                                   // b loop
    la lbl_done = lengde(r)
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19 (resultat)
    legg_u32(r, 0xF9401BFE)                          // ldr x30, [sp, #48]
    legg_u32(r, 0xA94263F7)                          // ldp x23, x24, [sp, #32]
    legg_u32(r, 0xA9415BF5)                          // ldp x21, x22, [sp, #16]
    legg_u32(r, 0xA94053F3)                          // ldp x19, x20, [sp]
    legg_u32(r, 0x910103FF)                          // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                          // ret
    skriv_u32(r, p_ge,    0x5400000A | ((((lbl_done - p_ge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_cbz,   0xB4000017 | ((((lbl_skip - p_cbz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_bloop, 0x14000000 |  (((lbl_loop - p_bloop) / 4) & 0x03FFFFFF))
    returner r
}

// ─── Miljø-overlay (miljo_sett/miljo_hent) ──────────────────────────────────
// AOT har ingen setenv-syscall, så miljo_sett skriv til eit heap-overlay-kart i
// den skjulte globalen __env_overlay__ (eit NcVal-kart), og miljo_hent sjekkar
// overlayet FØR han skannar envp. Begge er bl-kalla rutiner som gjenbrukar
// emit_index_set/emit_map_get (som bevarer x19–x26), så vi slepp register-press.

// __env_set(x0=kart, x1=nøkkel, x2=verdi) → x0=kart (kan vere vakse/repointa).
funksjon emit_env_set_routine() -> liste_heiltall {
    la r: liste_heiltall = []
    legg_u32(r, 0xD10103FF)                          // sub sp, sp, #64
    legg_u32(r, 0xA90053F3)                          // stp x19, x20, [sp]
    legg_u32(r, 0xA9015BF5)                          // stp x21, x22, [sp, #16]
    legg_u32(r, 0xF9001BFE)                          // str x30, [sp, #48]
    legg_u32(r, 0xAA0003F3)                          // mov x19, x0 (kart)
    legg_u32(r, 0xAA0103F4)                          // mov x20, x1 (nøkkel)
    legg_u32(r, 0xAA0203F5)                          // mov x21, x2 (verdi)
    emit_index_set(r, 19, 20, 21)                    // kart-upsert (grow repointar [x19+8])
    legg_u32(r, 0xAA1303E0)                          // mov x0, x19 (returner kart)
    legg_u32(r, 0xA94053F3)                          // ldp x19, x20, [sp]
    legg_u32(r, 0xA9415BF5)                          // ldp x21, x22, [sp, #16]
    legg_u32(r, 0xF9401BFE)                          // ldr x30, [sp, #48]
    legg_u32(r, 0x910103FF)                          // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                          // ret
    returner r
}

// __env_get(x0=kart, x1=nøkkel) → x0=verdi-peikar (eller 0 om ikkje funne).
funksjon emit_env_get_routine() -> liste_heiltall {
    la r: liste_heiltall = []
    legg_u32(r, 0xD10103FF)                          // sub sp, sp, #64
    legg_u32(r, 0xA90053F3)                          // stp x19, x20, [sp]
    legg_u32(r, 0xF9000BFE)                          // str x30, [sp, #16]
    legg_u32(r, 0xAA0003F3)                          // mov x19, x0 (kart)
    legg_u32(r, 0xAA0103F4)                          // mov x20, x1 (nøkkel)
    emit_map_get(r, 19, 20, 0, usann)                // x0 = verdi-peikar eller 0
    legg_u32(r, 0xA94053F3)                          // ldp x19, x20, [sp]
    legg_u32(r, 0xF9400BFE)                          // ldr x30, [sp, #16]
    legg_u32(r, 0x910103FF)                          // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                          // ret
    returner r
}

// ─── bytes-type (representert som NcVal-liste) ───────────────────────────────
// std.bytes byggjer på ein liste av byte-heiltal (indeksert + lengde), så vi
// representerer NC_BYTES som ei vanleg NcVal-liste (type 4). bytes_from_list/
// bytes_to_list er difor identitet, og bytes.er_bytes (som spør builtin.type)
// gjev "liste" → _liste-hjelparane i krypto-stakken tek rett gren uansett.
// bytes_new(storleik, fyll) allokerer ei liste med `storleik` element = fyll.
funksjon emit_bytes_new(native: liste_heiltall, size_reg: heiltall, fill_reg: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xF9400400 | (size_reg << 5) | 9)  // ldr x9, [Xsize, #8]  (count)
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28  (listdata-base)
    legg_u32(native, 0xF90001C9)                        // str x9, [x14]  (count)
    legg_u32(native, 0x910021CF)                        // add x15, x14, #8  (write-ptr)
    legg_u32(native, 0xD2800010)                        // movz x16, #0  (i)
    la lbl_loop = lengde(native)
    legg_u32(native, 0xEB09021F)                        // cmp x16, x9
    la p_bge = lengde(native)
    legg_u32(native, 0)                                 // b.ge done
    legg_u32(native, 0xF90001E0 | fill_reg)             // str Xfill, [x15]
    legg_u32(native, 0x910021EF)                        // add x15, x15, #8
    legg_u32(native, 0x91000610)                        // add x16, x16, #1
    la p_bloop = lengde(native)
    legg_u32(native, 0x14000000)                        // b loop
    la lbl_done = lengde(native)
    legg_u32(native, 0xAA0F03FC)                        // mov x28, x15  (bump)
    emit_ncval_alloc_ptr(native, 14, dst_reg, 4)
    skriv_u32(native, p_bge,   0x5400000A | ((((lbl_done - p_bge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bloop, 0x14000000 |  (((lbl_loop - p_bloop) / 4) & 0x03FFFFFF))
    returner 0
}

// ─── assert / assert_eq (test-/attestasjonsbuiltins) ────────────────────────
// __assert(x0=vilkår): terminerer med exit(1) dersom val==0, elles retur.
funksjon emit_assert_routine(os: tekst) -> liste_heiltall {
    la exitnum = 1
    hvis os == "linux" { exitnum = 93 }
    la r: liste_heiltall = []
    legg_u32(r, 0xB9400809)                             // ldr w9, [x0, #8]
    la p_cbnz = lengde(r)
    legg_u32(r, 0)                                      // cbnz w9, ok
    legg_u32(r, 0x52800020)                             // movz w0, #1
    emit_syscall(r, exitnum, os)                        // exit(1)
    la lbl_ok = lengde(r)
    legg_u32(r, 0xD65F03C0)                             // ret
    skriv_u32(r, p_cbnz, 0x35000009 | ((((lbl_ok - p_cbnz) / 4) & 0x7FFFF) << 5))
    returner r
}

// __assert_eq(x0=a, x1=b): exit(1) dersom a != b (type-bevisst: streng→byte,
// elles 64-bit val-samanlikning), elles retur.
funksjon emit_assert_eq_routine(os: tekst) -> liste_heiltall {
    la exitnum = 1
    hvis os == "linux" { exitnum = 93 }
    la r: liste_heiltall = []
    legg_u32(r, 0xD10103FF)                             // sub sp, sp, #64
    legg_u32(r, 0xF9000BFE)                             // str x30, [sp, #16]
    // type-dispatch: type==3 (streng) → byte-samanlikning, elles 64-bit val
    legg_u32(r, 0xF9400009)                             // ldr x9, [x0]  (type a)
    legg_u32(r, 0xF1000D3F)                             // cmp x9, #3
    la p_bne_int = lengde(r)
    legg_u32(r, 0)                                      // b.ne intcmp
    emit_str_eq(r, 0, 1, 2)                             // x2 = bool NcVal (a==b)
    legg_u32(r, 0xB9400849)                             // ldr w9, [x2, #8]
    la p_cbz_fail1 = lengde(r)
    legg_u32(r, 0)                                      // cbz w9, fail
    la p_b_ok1 = lengde(r)
    legg_u32(r, 0x14000000)                             // b ok
    la lbl_int = lengde(r)
    legg_u32(r, 0xF9400409)                             // ldr x9, [x0, #8]
    legg_u32(r, 0xF940042A)                             // ldr x10, [x1, #8]
    legg_u32(r, 0xEB0A013F)                             // cmp x9, x10
    la p_bne_fail = lengde(r)
    legg_u32(r, 0)                                      // b.ne fail
    la p_b_ok2 = lengde(r)
    legg_u32(r, 0x14000000)                             // b ok
    la lbl_fail = lengde(r)
    legg_u32(r, 0x52800020)                             // movz w0, #1
    emit_syscall(r, exitnum, os)                        // exit(1)
    la lbl_ok = lengde(r)
    legg_u32(r, 0xF9400BFE)                             // ldr x30, [sp, #16]
    legg_u32(r, 0x910103FF)                             // add sp, sp, #64
    legg_u32(r, 0xD65F03C0)                             // ret
    skriv_u32(r, p_bne_int,   0x54000001 | ((((lbl_int  - p_bne_int)   / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_cbz_fail1, 0xB4000009 | ((((lbl_fail - p_cbz_fail1) / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_b_ok1,     0x14000000 |  (((lbl_ok   - p_b_ok1)     / 4) & 0x03FFFFFF))
    skriv_u32(r, p_bne_fail,  0x54000001 | ((((lbl_fail - p_bne_fail)  / 4) & 0x7FFFF) << 5))
    skriv_u32(r, p_b_ok2,     0x14000000 |  (((lbl_ok   - p_b_ok2)     / 4) & 0x03FFFFFF))
    returner r
}

// `skriv` av ein NcVal-peikar i Xptr_reg (les val, formater desimal, write).
// Til skilnad frå emit_skriv_int rører han berre scratch x9–x15 + x0/x1/x2 og
// syscall-registeret, så operand-stakken (x19–x25), locals-basen (x26) og heap-
// registera (x27/x28) i NcVal-maskina er urørte. Ingen register-bevaring trengst.
funksjon emit_skriv_ncval(native: liste_heiltall, ptr_reg: heiltall, os: tekst) -> heiltall {
    // Fase 3: dispatch på NcVal-tagg. type=3 (streng) → skriv råbytes direkte;
    // elles → desimalformater heiltalet (Fase 1-vegen under int_path).
    legg_u32(native, 0xF9400000 | (ptr_reg << 5) | 9)  // ldr x9, [Xptr]  (type)
    legg_u32(native, 0xF1000D3F)                    // cmp x9, #3
    la p_bne_int = lengde(native)
    legg_u32(native, 0)                             // b.ne int_path
    // --- strengveg: write(1, strdata+8, [strdata]) ---
    legg_u32(native, 0xF9400400 | (ptr_reg << 5) | 10) // ldr x10, [Xptr, #8]  (strdata)
    legg_u32(native, 0xF9400142)                    // ldr x2, [x10]      (lengd)
    legg_u32(native, 0x91002141)                    // add x1, x10, #8    (buf)
    legg_u32(native, 0xD2800020)                    // mov x0, #1
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                // mov x8, #64
        legg_u32(native, 0xD4000001)                // svc #0
    } ellers {
        legg_u32(native, 0xD2800090)                // mov x16, #4
        legg_u32(native, 0xD4001001)                // svc #0x80
    }
    la p_b_end = lengde(native)
    legg_u32(native, 0)                             // b end
    // --- int_path (Fase 1 desimalformatering) ---
    la lbl_int = lengde(native)
    legg_u32(native, 0xD10083FF)                    // sub sp, sp, #32
    legg_u32(native, 0xF9400400 | (ptr_reg << 5) | 10) // ldr x10, [Xptr, #8]  (signert val)
    legg_u32(native, 0x910083EB)                    // add x11, sp, #32   (buffer-slutt)
    legg_u32(native, 0xAA0B03EC)                    // mov x12, x11       (skrivepeikar)
    legg_u32(native, 0xD280000D)                    // mov x13, #0        (negativflagg)
    legg_u32(native, 0xD280014E)                    // mov x14, #10
    legg_u32(native, 0xF100015F)                    // cmp x10, #0
    la p_bne = lengde(native)
    legg_u32(native, 0)                             // b.ne notzero
    legg_u32(native, 0x52800609)                    // mov w9, #48
    legg_u32(native, 0xD100058C)                    // sub x12, x12, #1
    legg_u32(native, 0x39000189)                    // strb w9, [x12]
    la p_bzero = lengde(native)
    legg_u32(native, 0)                             // b done
    la lbl_notzero = lengde(native)
    la p_bge = lengde(native)
    legg_u32(native, 0)                             // b.ge loop
    legg_u32(native, 0xD280002D)                    // mov x13, #1
    legg_u32(native, 0xCB0A03EA)                    // neg x10, x10
    la lbl_loop = lengde(native)
    legg_u32(native, 0x9ACE094F)                    // udiv x15, x10, x14
    legg_u32(native, 0x9B0EA9E9)                    // msub x9, x15, x14, x10
    legg_u32(native, 0x1100C129)                    // add w9, w9, #48
    legg_u32(native, 0xD100058C)                    // sub x12, x12, #1
    legg_u32(native, 0x39000189)                    // strb w9, [x12]
    legg_u32(native, 0xAA0F03EA)                    // mov x10, x15
    la p_cbnz = lengde(native)
    legg_u32(native, 0)                             // cbnz x10, loop
    la p_cbz = lengde(native)
    legg_u32(native, 0)                             // cbz x13, done
    legg_u32(native, 0x528005A9)                    // mov w9, #45 ('-')
    legg_u32(native, 0xD100058C)                    // sub x12, x12, #1
    legg_u32(native, 0x39000189)                    // strb w9, [x12]
    la lbl_done = lengde(native)
    legg_u32(native, 0xCB0C0169)                    // sub x9, x11, x12   (lengd)
    legg_u32(native, 0xD2800020)                    // mov x0, #1         (stdout)
    legg_u32(native, 0xAA0C03E1)                    // mov x1, x12        (buf)
    legg_u32(native, 0xAA0903E2)                    // mov x2, x9         (len)
    hvis os == "linux" {
        legg_u32(native, 0xD2800808)                // mov x8, #64
        legg_u32(native, 0xD4000001)                // svc #0
    } ellers {
        legg_u32(native, 0xD2800090)                // mov x16, #4
        legg_u32(native, 0xD4001001)                // svc #0x80
    }
    legg_u32(native, 0x910083FF)                    // add sp, sp, #32
    la lbl_end = lengde(native)
    skriv_u32(native, p_bne_int, 0x54000001 | ((((lbl_int    - p_bne_int) / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_b_end,   0x14000000 |  (((lbl_end     - p_b_end)   / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bne,   0x54000001 | ((((lbl_notzero - p_bne)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_bzero, 0x14000000 |  (((lbl_done    - p_bzero) / 4) & 0x03FFFFFF))
    skriv_u32(native, p_bge,   0x5400000A | ((((lbl_loop    - p_bge)   / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbnz,  0xB500000A | ((((lbl_loop    - p_cbnz)  / 4) & 0x7FFFF) << 5))
    skriv_u32(native, p_cbz,   0xB400000D | ((((lbl_done    - p_cbz)   / 4) & 0x7FFFF) << 5))
    returner 0
}

// Sjølvståande Fase 2-prøve: reserver heap, alloker NcVal-int(20) og
// NcVal-int(22), legg dei saman over NcVal (last val, add, alloker resultat) og
// returner det utpakka heiltalet som exit-kode (= 42). Provar heile
// mmap+alloc+aritmetikk+utpakking-kjeda på ekte AArch64-maskinvare.
funksjon phase2_ncval_probe(os: tekst) -> liste_heiltall {
    la native: liste_heiltall = []
    emit_heap_init(native, os)
    legg_u32(native, 0x52800289)                    // movz w9, #20
    emit_ncval_alloc_int(native, 9, 10)             // x10 = NcVal-int(20)
    legg_u32(native, 0x528002C9)                    // movz w9, #22
    emit_ncval_alloc_int(native, 9, 11)             // x11 = NcVal-int(22)
    legg_u32(native, 0xF940054D)                    // ldr x13, [x10, #8]
    legg_u32(native, 0xF940056E)                    // ldr x14, [x11, #8]
    legg_u32(native, 0x8B0E01A9)                    // add x9, x13, x14
    emit_ncval_alloc_int(native, 9, 12)             // x12 = NcVal-int(42)
    legg_u32(native, 0xF9400580)                    // ldr x0, [x12, #8]  (pakk ut)
    legg_u32(native, 0xD65F03C0)                    // ret
    returner native
}

// Pakkar Fase 2-prøva i ein køyrbar Mach-O (macOS-verifikasjon). Linux-ELF-
// wrappinga ligg i elf_arm64_codegen og blir køyrt på ekte Linux ARM64-host.
funksjon phase2_ncval_probe_image() -> liste_heiltall {
    returner macho.bygg_program(phase2_ncval_probe("macos"))
}

// ─── Fase 2: full NcVal stakk-VM ────────────────────────────────────────────
// Erstattar den registerbaserte kompiler_arm64: kvar operand er ein NcVal-peikar.
// Operand-stakken bur i callee-saved x19–x25 (djupn 0–6); locals ligg som NcVal*
// i heapen ved [x26 + i*8]; heap-bump i x28. Aritmetikk skjer i 32-bit w-register
// (som den gamle maskina) og resultatet blir pakka i ein ny NcVal. Exit-kodene
// er difor byte-for-byte like dei gamle heiltalsfixturane, men no over ekte heap.
funksjon ncval_opreg(djupn: heiltall) -> heiltall { returner 19 + djupn }

// ─── Fase 5: ekte kall/rekursjon ────────────────────────────────────────────
// Kvar funksjon får eigen prolog/epilog og ekte AArch64-kall (bl/ret). Callee-
// saved x19–x26 (operand-stakk + locals-base) og x30 (lr) blir lagra/gjenoppretta
// på maskinstakken; x28 (heap-bump) er global (aldri lagra). Locals ligg i heapen
// ved [x26+i*8] og blir allokerte per kall (rekursjon fungerer; ingen frigjering
// før fase-6-GC). Argument i x0–x7; resultat i x0. Entry gjer heap-init først og
// returnerer utpakka exit-kode i w0.
funksjon emit_fn_prologue(native: liste_heiltall, is_entry: boolsk, nlocals: heiltall, nparams: heiltall, os: tekst, nglobals: heiltall) -> heiltall {
    hvis is_entry {
        // Fase 6/8: fang envp for miljo_hent i den globale x27 (aldri klobba).
        // macOS dyld kallar _main(argc,argv,envp) med envp i x2. Linux ELF-
        // _start (elf_arm64_emitter.bygg_program) reknar no ut envp frå stakken
        // og passar han i x2 før `bl main`, så begge OS held envp i x2 her.
        legg_u32(native, 0xAA0203FB)                // mov x27, x2  (envp)
        emit_heap_init(native, os)
        // Fase 8: modul-globalar. x25 = globals-base = heap-start (mmap nullstiller,
        // så alle globalar startar som null-peikar). Heapen (x28) startar etter
        // globals-arrayet. x25 er reservert globalt (operandstakken er x19–x24).
        legg_u32(native, 0xAA1C03F9)                // mov x25, x28  (globals-base)
        hvis nglobals > 0 {
            la gsize = ((nglobals * 8 + 15) / 16) * 16
            legg_u32(native, 0x91000000 | (gsize << 10) | (28 << 5) | 28) // add x28,x28,#gsize
        }
    }
    legg_u32(native, 0xD10143FF)                    // sub sp, sp, #80
    legg_u32(native, 0xA90053F3)                    // stp x19, x20, [sp, #0]
    legg_u32(native, 0xA9015BF5)                    // stp x21, x22, [sp, #16]
    legg_u32(native, 0xA90263F7)                    // stp x23, x24, [sp, #32]
    legg_u32(native, 0xA9036BF9)                    // stp x25, x26, [sp, #48]
    legg_u32(native, 0xF90023FE)                    // str x30, [sp, #64]
    legg_u32(native, 0xAA1C03FA)                    // mov x26, x28  (ny locals-base)
    hvis nlocals > 0 {
        la localsize = ((nlocals * 8 + 15) / 16) * 16
        hvis localsize <= 4095 {
            legg_u32(native, 0x91000000 | (localsize << 10) | (28 << 5) | 28) // add x28,x28,#localsize
        } ellers {
            // Mem-modus-ramma kan vere større enn add-immediatet (4095 byte); last
            // storleiken i x9 og bruk register-add.
            last_heiltall(native, 9, localsize)
            legg_u32(native, 0x8B09039C)                                     // add x28, x28, x9
        }
    }
    la i = 0
    mens i < nparams {
        legg_u32(native, 0xF9000000 | (i << 10) | (26 << 5) | i)  // str x_i, [x26, #i*8]
        i = i + 1
    }
    returner 0
}

funksjon emit_fn_epilogue(native: liste_heiltall) -> heiltall {
    legg_u32(native, 0xA94053F3)                    // ldp x19, x20, [sp, #0]
    legg_u32(native, 0xA9415BF5)                    // ldp x21, x22, [sp, #16]
    legg_u32(native, 0xA94263F7)                    // ldp x23, x24, [sp, #32]
    legg_u32(native, 0xA9436BF9)                    // ldp x25, x26, [sp, #48]
    legg_u32(native, 0xF94023FE)                    // ldr x30, [sp, #64]
    legg_u32(native, 0x910143FF)                    // add sp, sp, #80
    legg_u32(native, 0xD65F03C0)                    // ret
    returner 0
}

// ─── Operand-spilling (mem-modus) ───────────────────────────────────────────
// Den register-baserte operand-stakken (x19–x24, maks djupn 6) sprekk for store
// literalar og djup uttrykksnøsting (målt: 22 % av funksjonane i ekte nc_main-NCB
// går djupare enn 6, maks djupn 254). Løysinga: når reg-modus feilar med
// «operand-stakk full», rekompilerer ncval_compile_program funksjonen i MEM-MODUS
// der operandane bur i minne-«heimar» rett etter lokalvariablane:
//   home(i) = [x26 + (home_off + i)*8],  home_off = tal lokalvariablar.
// x19/x20/x21 blir reine scratch (slot 0/1/2) som operandane blir lasta inn i før
// ein emitter kjører, og resultatet blir skrive tilbake til heimen. I reg-modus
// er desse hjelparane bit-identiske med før (returner x(19+idx), emitter ingenting).

// Les operand ved logisk indeks `idx` inn i scratch-slot `slot` (0/1/2 → x19/x20/x21
// i mem-modus). Returnerer registeret koden skal bruke som operanden.
funksjon opnd_les(native: liste_heiltall, idx: heiltall, slot: heiltall, memmode: boolsk, home_off: heiltall) -> heiltall {
    hvis ikkje memmode { returner 19 + idx }
    la r = 19 + slot
    legg_u32(native, 0xF9400340 | ((home_off + idx) << 10) | r)  // ldr Xr, [x26, #(home_off+idx)*8]
    returner r
}

// Skriv resultatet i register `rr` tilbake til operand-heimen ved logisk indeks `idx`.
// reg-modus: sørg for at verdien er i x(19+idx) (mov om rr avvik — normalt ikkje).
// mem-modus: str Xrr → home(idx).
funksjon opnd_ut(native: liste_heiltall, idx: heiltall, rr: heiltall, memmode: boolsk, home_off: heiltall) -> heiltall {
    hvis ikkje memmode {
        hvis rr != 19 + idx { legg_u32(native, 0xAA0003E0 | (rr << 16) | (19 + idx)) }  // mov X(19+idx), Xrr
        returner 0
    }
    legg_u32(native, 0xF9000340 | ((home_off + idx) << 10) | rr)  // str Xrr, [x26, #(home_off+idx)*8]
    returner 0
}

// Målregisteret for ein push-operasjon ved djupn `d`: x(19+d) i reg-modus, x19 i
// mem-modus (slot 0; opnd_ut lagrar det til home(d) etterpå).
funksjon opnd_push_reg(d: heiltall, memmode: boolsk) -> heiltall {
    hvis memmode { returner 19 }
    returner 19 + d
}

// Eksakt maks operand-djupn for ein funksjonskropp (same djupn-aritmetikk som
// kompileringssløyfa: kvart CALL forbruker instr[2] og pusher 1 → netto 1-nargs).
funksjon ncval_maxdjupn(kode) -> heiltall {
    la d = 0
    la maks = 0
    la i = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        la op = opcode(instr)
        hvis op == "PUSH_CONST" eller op == "LOAD_NAME" eller op == "LOAD_GLOBAL" eller op == "LOAD_EXCEPTION" {
            d = d + 1
        } ellers hvis op == "POP" eller op == "STORE_NAME" eller op == "STORE_GLOBAL" eller op == "JUMP_IF_FALSE" eller op == "RETURN" eller op == "THROW" eller op == "INDEX_GET" {
            d = d - 1
        } ellers hvis op == "INDEX_SET" {
            d = d - 2
        } ellers hvis op == "BINARY_ADD" eller op == "ADD" eller op == "BINARY_SUB" eller op == "SUB" eller op == "BINARY_MUL" eller op == "MUL" eller op == "BINARY_DIV" eller op == "DIV" eller op == "BINARY_MOD" eller op == "BINARY_AND" eller op == "BINARY_OR" eller op == "BINARY_XOR" eller op == "BINARY_LSHIFT" eller op == "BINARY_RSHIFT" {
            d = d - 1
        } ellers hvis op == "COMPARE_EQ" eller op == "COMPARE_NE" eller op == "COMPARE_LT" eller op == "COMPARE_LE" eller op == "COMPARE_GT" eller op == "COMPARE_GE" {
            d = d - 1
        } ellers hvis op == "BUILD_LIST" og lengde(instr) == 2 {
            d = d - instr[1] + 1
        } ellers hvis op == "BUILD_MAP" og lengde(instr) == 2 {
            d = d - instr[1] * 2 + 1
        } ellers hvis op == "CALL" og lengde(instr) == 3 {
            d = d - instr[2] + 1
        }
        // (UNARY_*, LABEL, JUMP, TRY_BEGIN, TRY_END = netto 0)
        hvis d > maks { maks = d }
        i = i + 1
    }
    returner maks
}

// mem-modus BUILD_LIST: element-operandane ligg i heimar [base_idx .. base_idx+n-1];
// samlar dei i ei fersk listdata på heapen og boksar resultatet i `dst_reg`.
funksjon emit_build_list_mem(native: liste_heiltall, n: heiltall, base_idx: heiltall, home_off: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28  (listdata-base)
    prøv { last_heiltall(native, 9, n) } fang (e) { kast "NcVal liste for lang" }
    legg_u32(native, 0xF90001C9)                        // str x9, [x14]  (count)
    la i = 0
    mens i < n {
        legg_u32(native, 0xF9400340 | ((home_off + base_idx + i) << 10) | 9)  // ldr x9, [x26, #home]
        legg_u32(native, 0xF9000000 | ((1 + i) << 10) | (14 << 5) | 9)        // str x9, [x14, #8+i*8]
        i = i + 1
    }
    la total = 8 + n * 8
    hvis total > 4095 { kast "NcVal liste for stor for eitt add-steg" }
    legg_u32(native, 0x91000000 | (total << 10) | (14 << 5) | 28)             // add x28, x14, #total
    emit_ncval_alloc_ptr(native, 14, dst_reg, 4)
    returner 0
}

// mem-modus BUILD_MAP: key/val-operandane ligg i heimar [base_idx .. base_idx+2*np-1].
funksjon emit_build_map_mem(native: liste_heiltall, npairs: heiltall, base_idx: heiltall, home_off: heiltall, dst_reg: heiltall) -> heiltall {
    legg_u32(native, 0xAA1C03EE)                        // mov x14, x28
    prøv { last_heiltall(native, 9, npairs) } fang (e) { kast "NcVal kart for stort" }
    legg_u32(native, 0xF90001C9)                        // str x9, [x14]  (count)
    la m = npairs * 2
    la i = 0
    mens i < m {
        legg_u32(native, 0xF9400340 | ((home_off + base_idx + i) << 10) | 9)  // ldr x9, [x26, #home]
        legg_u32(native, 0xF9000000 | ((1 + i) << 10) | (14 << 5) | 9)        // str x9, [x14, #8+i*8]
        i = i + 1
    }
    la total = 8 + m * 8
    hvis total > 4095 { kast "NcVal kart for stort for eitt add-steg" }
    legg_u32(native, 0x91000000 | (total << 10) | (14 << 5) | 28)             // add x28, x14, #total
    emit_ncval_alloc_ptr(native, 14, dst_reg, 5)
    returner 0
}

// Funksjonar som er nåbare frå entry (og modul-initialisatorane) via CALL til
// brukarfunksjonar (ikkje builtins).
funksjon ncval_reachable(entry: tekst, funksjonar, ekstra_roter) -> liste_tekst {
    la order: liste_tekst = [entry]
    la sett = {}
    sett[entry] = 1
    hvis ekstra_roter != null {
        la r = 0
        mens r < lengde(ekstra_roter) {
            la rn = tekst(ekstra_roter[r])
            hvis finnes_nøkkel(funksjonar, rn) og ikkje finnes_nøkkel(sett, rn) {
                sett[rn] = 1
                legg_til(order, rn)
            }
            r = r + 1
        }
    }
    la k = 0
    mens k < lengde(order) {
        la fname = order[k]
        la mål = funksjonar[fname]
        hvis mål != null og mål["code"] != null {
            la kode = mål["code"]
            la i = 0
            mens i < lengde(kode) {
                la ins = kode[i]
                hvis opcode(ins) == "CALL" og lengde(ins) == 3 og builtin.type(ins[1]) == "tekst" {
                    la namn = ins[1]
                    hvis finnes_nøkkel(funksjonar, namn) og ikkje er_ncval_builtin(namn) og ikkje finnes_nøkkel(sett, namn) {
                        sett[namn] = 1
                        legg_til(order, namn)
                    }
                }
                i = i + 1
            }
        }
        k = k + 1
    }
    returner order
}

// Fase 5: kompiler éin funksjonskropp til eit fragment med prolog/epilog og ekte
// bl-kall. funksjonar = heile NCB-funksjonstabellen (for å kjenne att brukarkall);
// params = parameternamn (locals 0..n-1); is_entry avgjer heap-init + w0-exit;
// bl_patchar samlar [pos_i_native, mål-namn] for bl-lenking av multi-drivaren.
funksjon kompiler_arm64_ncval(kode, os, funksjonar, params, is_entry: boolsk, bl_patchar, globals, initializers, memmode: boolsk) -> ordbok_tekst {
    hvis memmode == null { memmode = usann }
    hvis builtin.type(kode) != "liste" {
        returner {"ok": "usann", "error": "AArch64 NcVal krev instruksjonsliste", "image": []}
    }
    hvis globals == null { globals = {} }
    hvis initializers == null { initializers = [] }
    hvis params == null { params = [] }
    hvis lengde(params) > 8 { returner {"ok": "usann", "error": "NcVal funksjon støttar høgst 8 parametrar", "image": []} }
    // Forhandsskanning: parametrar først (locals 0..n-1), så STORE_NAME-namn.
    la variablar = {}
    la variabel_antal = 0
    la pi = 0
    mens pi < lengde(params) {
        hvis ikkje finnes_nøkkel(variablar, params[pi]) {
            variablar[params[pi]] = variabel_antal
            variabel_antal = variabel_antal + 1
        }
        pi = pi + 1
    }
    la s = 0
    mens s < lengde(kode) {
        hvis opcode(kode[s]) == "STORE_NAME" og lengde(kode[s]) == 2 og builtin.type(kode[s][1]) == "tekst" {
            // finnes_nøkkel, ikkje [key]==null: committed stage0 gjev absent-key-
            // oppslag på tomme/populerte dict ustabile ikkje-null-verdiar.
            // Modul-globalar (registrert i `globals` av ncval_compile_program sin
            // fri-variabel-skann) er IKKJE lokale — STORE_NAME rutar til x25-slotet.
            hvis ikkje finnes_nøkkel(variablar, kode[s][1]) og ikkje finnes_nøkkel(globals, kode[s][1]) {
                variablar[kode[s][1]] = variabel_antal
                variabel_antal = variabel_antal + 1
            }
        }
        s = s + 1
    }
    // Mem-modus: operandane bur i minne-heimar rett etter lokalvariablane.
    // home_off = tal lokalvariablar; reserver maks operand-djupn (+margin) ekstra slots.
    la home_off = variabel_antal
    la maxdjupn = 0
    la prolog_locals = variabel_antal
    hvis memmode {
        maxdjupn = ncval_maxdjupn(kode)
        prolog_locals = variabel_antal + maxdjupn + 4
        hvis (home_off + maxdjupn + 4) > 4000 {
            returner {"ok": "usann", "error": "NcVal mem-modus ramme for stor (lokalar+djupn > 4000)", "image": []}
        }
    }
    la native: liste_heiltall = []
    emit_fn_prologue(native, is_entry, prolog_locals, lengde(params), os, lengde(nøkler(globals)))
    // Fase 8: køyr modul-initialisatorane (STORE_GLOBAL av toppnivå-verdiar) før
    // entry-kroppen. x25/x28 er alt sett opp av entry-prologen.
    hvis is_entry {
        // Fase 8: unnataks-handler-region (om try/catch brukast). __exc_top__ =
        // handler-stakk-topp = x28; reserver 256 record × 80 byte framfor heapen.
        hvis finnes_nøkkel(globals, "__exc_top__") {
            la gET0 = globals["__exc_top__"]
            legg_u32(native, 0xAA1C03E9)                // mov x9, x28  (handler-base)
            legg_u32(native, 0xF9000320 | (gET0 << 10) | 9) // str x9, [x25, #ET*8]
            legg_u32(native, 0x9140179C)                // add x28, x28, #5, lsl #12 (20480)
        }
        // Miljø-overlay: initialiser __env_overlay__ til eit tomt kart (type 5).
        hvis finnes_nøkkel(globals, "__env_overlay__") {
            la gOV0 = globals["__env_overlay__"]
            legg_u32(native, 0xAA1C03EE)                // mov x14, x28  (mapdata-base)
            legg_u32(native, 0xD2800009)                // movz x9, #0
            legg_u32(native, 0xF90001C9)                // str x9, [x14]  (count 0)
            legg_u32(native, 0x910021DC)                // add x28, x14, #8
            emit_ncval_alloc_ptr(native, 14, 9, 5)      // x9 = kart-NcVal (type 5)
            legg_u32(native, 0xF9000320 | (gOV0 << 10) | 9) // str x9, [x25, #OV*8]
        }
        la mi = 0
        mens mi < lengde(initializers) {
            legg_u32(native, 0xAA0003E0)                // mov x0, xzr  (0 arg-plassholder)
            la p_bl_init = lengde(native)
            legg_u32(native, 0x94000000)                // bl <initializer>
            legg_til(bl_patchar, [p_bl_init, tekst(initializers[mi])])
            mi = mi + 1
        }
    }
    la djupn = 0
    la etikettar = {}
    // Operand-djupn ved kvar grein til ei etikett. Codegen sporar djupn LINEÆRT,
    // men ved kontrollflyt-samanslåing (t.d. kortslutta `og`/`eller`) er den
    // lineære djupna feil på fall-inn til ei etikett som berre nås via hopp.
    // Vi noterer djupna ved kvart hopp og set djupn = notert verdi på etiketten,
    // så registeret/heimen JUMP_IF_FALSE les stemmer med runtime-stakken.
    la label_djupn = {}
    la grein_patchar = []
    la ferdig = usann
    la i = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        la op = opcode(instr)
        hvis op == "PUSH_CONST" {
            hvis lengde(instr) != 2 { returner {"ok": "usann", "error": "NcVal PUSH_CONST krev verdi", "image": []} }
            hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
            la mål_pc = opnd_push_reg(djupn, memmode)
            la konstant = instr[1]
            la kt = builtin.type(konstant)
            hvis kt == "tekst" {
                prøv { emit_ncval_str_const(native, konstant, mål_pc) } fang melding {
                    returner {"ok": "usann", "error": tekst(melding), "image": []}
                }
            } ellers hvis kt == "heltall" eller kt == "boolsk" {
                la tag = 1
                hvis kt == "boolsk" {
                    tag = 2   // bool-tagg (som COMPARE_*), så json_stringify gjev true/false
                    hvis konstant { konstant = 1 } ellers { konstant = 0 }
                }
                hvis konstant >= -2147483648 og konstant <= 2147483647 {
                    // 32-bit-veg (byte-identisk med før): sxtw-boksing.
                    prøv { last_heiltall(native, 9, konstant) } fang melding {
                        returner {"ok": "usann", "error": tekst(melding), "image": []}
                    }
                    emit_ncval_alloc(native, 9, mål_pc, tag)
                } ellers {
                    // 64-bit konstant (t.d. usignert 32-bit SHA-konstant): full x-last + 64-bit boks.
                    last_heiltall_64(native, 9, konstant)
                    emit_ncval_alloc_ptr(native, 9, mål_pc, tag)
                }
            } ellers hvis kt == "ingenting" {
                // null → int 0 (same null-representasjon som json_parse). Modul-init
                // returnerer ofte PUSH_CONST null; RETURN treng ein verdi på stakken.
                prøv { last_heiltall(native, 9, 0) } fang melding {
                    returner {"ok": "usann", "error": tekst(melding), "image": []}
                }
                emit_ncval_alloc(native, 9, mål_pc, 1)
            } ellers {
                returner {"ok": "usann", "error": "NcVal PUSH_CONST ustøtta type: " + kt, "image": []}
            }
            opnd_ut(native, djupn, mål_pc, memmode, home_off)
            djupn = djupn + 1
        } ellers hvis op == "POP" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved POP", "image": []} }
            djupn = djupn - 1
        } ellers hvis op == "BINARY_ADD" eller op == "ADD" {
            // Fase 3: runtime type-dispatch på `+`. Streng-konkatenering når
            // venstre er ein streng (type=3), elles heiltalsaddisjon. Kjelda er
            // typekonsistent, så venstre-taggen avgjer.
            hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved " + op, "image": []} }
            la venstre = opnd_les(native, djupn - 2, 0, memmode, home_off)
            la høgre = opnd_les(native, djupn - 1, 1, memmode, home_off)
            legg_u32(native, 0xF9400000 | (venstre << 5) | 9)   // ldr x9, [Xvenstre]  (type)
            legg_u32(native, 0xF1000D3F)                        // cmp x9, #3
            la p_bne_int = lengde(native)
            legg_u32(native, 0)                                 // b.ne int_add
            emit_str_concat(native, venstre, høgre, venstre)    // streng-konkatenering
            la p_b_end = lengde(native)
            legg_u32(native, 0)                                 // b add_end
            la lbl_int = lengde(native)
            legg_u32(native, 0xF9400400 | (venstre << 5) | 9)   // ldr x9, [Xvenstre, #8]  (64-bit)
            legg_u32(native, 0xF9400400 | (høgre << 5) | 10)    // ldr x10, [Xhøgre, #8]
            legg_u32(native, 0x8B0A0129)                        // add x9, x9, x10
            emit_ncval_alloc_ptr(native, 9, venstre, 1)         // 64-bit boks
            la lbl_end = lengde(native)
            skriv_u32(native, p_bne_int, 0x54000001 | ((((lbl_int - p_bne_int) / 4) & 0x7FFFF) << 5))
            skriv_u32(native, p_b_end,   0x14000000 |  (((lbl_end - p_b_end)   / 4) & 0x03FFFFFF))
            opnd_ut(native, djupn - 2, venstre, memmode, home_off)
            djupn = djupn - 1
        } ellers hvis op == "BINARY_SUB" eller op == "SUB" eller op == "BINARY_MUL" eller op == "MUL" eller op == "BINARY_DIV" eller op == "DIV" eller op == "BINARY_MOD" eller op == "BINARY_AND" eller op == "BINARY_OR" eller op == "BINARY_XOR" eller op == "BINARY_LSHIFT" eller op == "BINARY_RSHIFT" {
            hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved " + op, "image": []} }
            la venstre = opnd_les(native, djupn - 2, 0, memmode, home_off)
            la høgre = opnd_les(native, djupn - 1, 1, memmode, home_off)
            legg_u32(native, 0xF9400400 | (venstre << 5) | 9)   // ldr x9, [Xvenstre, #8]  (64-bit)
            legg_u32(native, 0xF9400400 | (høgre << 5) | 10)    // ldr x10, [Xhøgre, #8]
            hvis op == "BINARY_ADD" eller op == "ADD" {
                legg_u32(native, 0x8B0A0129)                    // add x9, x9, x10
            } ellers hvis op == "BINARY_SUB" eller op == "SUB" {
                legg_u32(native, 0xCB0A0129)                    // sub x9, x9, x10
            } ellers hvis op == "BINARY_MUL" eller op == "MUL" {
                legg_u32(native, 0x9B0A7D29)                    // mul x9, x9, x10
            } ellers hvis op == "BINARY_DIV" eller op == "DIV" {
                legg_u32(native, 0x9ACA0D29)                    // sdiv x9, x9, x10
            } ellers hvis op == "BINARY_MOD" {
                legg_u32(native, 0x9ACA0D2B)                    // sdiv x11, x9, x10
                legg_u32(native, 0x9B0AA569)                    // msub x9, x11, x10, x9
            } ellers hvis op == "BINARY_AND" {
                legg_u32(native, 0x8A0A0129)                    // and x9, x9, x10
            } ellers hvis op == "BINARY_OR" {
                legg_u32(native, 0xAA0A0129)                    // orr x9, x9, x10
            } ellers hvis op == "BINARY_XOR" {
                legg_u32(native, 0xCA0A0129)                    // eor x9, x9, x10
            } ellers hvis op == "BINARY_LSHIFT" {
                legg_u32(native, 0x9ACA2129)                    // lslv x9, x9, x10
            } ellers {
                legg_u32(native, 0x9ACA2929)                    // asrv x9, x9, x10
            }
            emit_ncval_alloc_ptr(native, 9, venstre, 1)         // 64-bit boks
            opnd_ut(native, djupn - 2, venstre, memmode, home_off)
            djupn = djupn - 1
        } ellers hvis op == "UNARY_NEG" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved UNARY_NEG", "image": []} }
            la topp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            legg_u32(native, 0xF9400400 | (topp << 5) | 9)      // ldr x9, [Xtopp, #8]
            legg_u32(native, 0xCB0903E9)                        // neg x9, x9
            emit_ncval_alloc_ptr(native, 9, topp, 1)
            opnd_ut(native, djupn - 1, topp, memmode, home_off)
        } ellers hvis op == "UNARY_NOT" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved UNARY_NOT", "image": []} }
            la topp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            legg_u32(native, 0xF9400400 | (topp << 5) | 9)      // ldr x9, [Xtopp, #8]
            legg_u32(native, 0xF100013F)                        // cmp x9, #0
            legg_u32(native, 0x1A9F17E9)                        // cset w9, eq
            emit_ncval_alloc(native, 9, topp, 2)
            opnd_ut(native, djupn - 1, topp, memmode, home_off)
        } ellers hvis op == "UNARY_BNOT" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved UNARY_BNOT", "image": []} }
            la topp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            legg_u32(native, 0xF9400400 | (topp << 5) | 9)      // ldr x9, [Xtopp, #8]
            legg_u32(native, 0xAA2903E9)                        // mvn x9, x9
            emit_ncval_alloc_ptr(native, 9, topp, 1)
            opnd_ut(native, djupn - 1, topp, memmode, home_off)
        } ellers hvis op == "COMPARE_EQ" {
            // Fase 3: type-dispatch på `==`. Streng-byte-likskap når venstre er
            // streng (type=3), elles heiltalslikskap.
            hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved COMPARE_EQ", "image": []} }
            la venstre = opnd_les(native, djupn - 2, 0, memmode, home_off)
            la høgre = opnd_les(native, djupn - 1, 1, memmode, home_off)
            legg_u32(native, 0xF9400000 | (venstre << 5) | 9)   // ldr x9, [Xvenstre]  (type)
            legg_u32(native, 0xF1000D3F)                        // cmp x9, #3
            la p_bne_int = lengde(native)
            legg_u32(native, 0)                                 // b.ne int_eq
            emit_str_eq(native, venstre, høgre, venstre)        // streng-likskap
            la p_b_end = lengde(native)
            legg_u32(native, 0)                                 // b eq_end
            la lbl_int = lengde(native)
            legg_u32(native, 0xF9400400 | (venstre << 5) | 9)   // ldr x9, [Xvenstre, #8]  (full 64-bit)
            legg_u32(native, 0xF9400400 | (høgre << 5) | 10)    // ldr x10, [Xhøgre, #8]
            legg_u32(native, 0xEB0A013F)                        // cmp x9, x10
            legg_u32(native, 0x1A9F17E9)                        // cset w9, eq
            emit_ncval_alloc(native, 9, venstre, 2)
            la lbl_end = lengde(native)
            skriv_u32(native, p_bne_int, 0x54000001 | ((((lbl_int - p_bne_int) / 4) & 0x7FFFF) << 5))
            skriv_u32(native, p_b_end,   0x14000000 |  (((lbl_end - p_b_end)   / 4) & 0x03FFFFFF))
            opnd_ut(native, djupn - 2, venstre, memmode, home_off)
            djupn = djupn - 1
        } ellers hvis op == "COMPARE_NE" {
            // Type-dispatch på `!=` (som COMPARE_EQ): streng-byte-ulikskap når venstre
            // er streng (type=3), elles 64-bit heiltalsulikskap. Utan strengvegen
            // samanlikna `!=` strdata-PEIKARANE → `"ok" != "ok"` vart alltid sann.
            hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved COMPARE_NE", "image": []} }
            la venstre = opnd_les(native, djupn - 2, 0, memmode, home_off)
            la høgre = opnd_les(native, djupn - 1, 1, memmode, home_off)
            legg_u32(native, 0xF9400000 | (venstre << 5) | 9)   // ldr x9, [Xvenstre]  (type)
            legg_u32(native, 0xF1000D3F)                        // cmp x9, #3
            la p_bne_int = lengde(native)
            legg_u32(native, 0)                                 // b.ne int_ne
            emit_str_eq(native, venstre, høgre, venstre)        // eq-bool i venstre
            legg_u32(native, 0xB9400800 | (venstre << 5) | 9)   // ldr w9, [Xvenstre, #8]
            legg_u32(native, 0x7100013F)                        // cmp w9, #0
            legg_u32(native, 0x1A9F17E9)                        // cset w9, eq  (inverter eq → ne)
            emit_ncval_alloc(native, 9, venstre, 2)
            la p_b_end = lengde(native)
            legg_u32(native, 0)                                 // b ne_end
            la lbl_int = lengde(native)
            legg_u32(native, 0xF9400400 | (venstre << 5) | 9)   // ldr x9, [Xvenstre, #8]
            legg_u32(native, 0xF9400400 | (høgre << 5) | 10)    // ldr x10, [Xhøgre, #8]
            legg_u32(native, 0xEB0A013F)                        // cmp x9, x10
            legg_u32(native, 0x1A9F07E9)                        // cset w9, ne
            emit_ncval_alloc(native, 9, venstre, 2)
            la lbl_end = lengde(native)
            skriv_u32(native, p_bne_int, 0x54000001 | ((((lbl_int - p_bne_int) / 4) & 0x7FFFF) << 5))
            skriv_u32(native, p_b_end,   0x14000000 |  (((lbl_end - p_b_end)   / 4) & 0x03FFFFFF))
            opnd_ut(native, djupn - 2, venstre, memmode, home_off)
            djupn = djupn - 1
        } ellers hvis op == "COMPARE_LT" eller op == "COMPARE_LE" eller op == "COMPARE_GT" eller op == "COMPARE_GE" {
            hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal stakk underflyt ved " + op, "image": []} }
            la venstre = opnd_les(native, djupn - 2, 0, memmode, home_off)
            la høgre = opnd_les(native, djupn - 1, 1, memmode, home_off)
            legg_u32(native, 0xF9400400 | (venstre << 5) | 9)   // ldr x9, [Xvenstre, #8]  (full 64-bit)
            legg_u32(native, 0xF9400400 | (høgre << 5) | 10)    // ldr x10, [Xhøgre, #8]
            legg_u32(native, 0xEB0A013F)                        // cmp x9, x10
            la cset = 0x1A9F07E9
            hvis op == "COMPARE_LT" { cset = 0x1A9FA7E9 }
            hvis op == "COMPARE_GE" { cset = 0x1A9FB7E9 }
            hvis op == "COMPARE_LE" { cset = 0x1A9FC7E9 }
            hvis op == "COMPARE_GT" { cset = 0x1A9FD7E9 }
            legg_u32(native, cset)                              // cset w9, cond
            emit_ncval_alloc(native, 9, venstre, 2)
            opnd_ut(native, djupn - 2, venstre, memmode, home_off)
            djupn = djupn - 1
        } ellers hvis op == "BUILD_LIST" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "heltall" {
                returner {"ok": "usann", "error": "NcVal BUILD_LIST krev tal", "image": []}
            }
            la n = instr[1]
            hvis djupn < n { returner {"ok": "usann", "error": "NcVal BUILD_LIST stakk underflyt", "image": []} }
            hvis memmode {
                emit_build_list_mem(native, n, djupn - n, home_off, 19)
                opnd_ut(native, djupn - n, 19, memmode, home_off)
            } ellers {
                hvis (djupn - n + 1) > 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full etter BUILD_LIST", "overflow": "sann", "image": []} }
                emit_build_list(native, n, ncval_opreg(djupn - n), ncval_opreg(djupn - n))
            }
            djupn = djupn - n + 1
        } ellers hvis op == "BUILD_MAP" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "heltall" {
                returner {"ok": "usann", "error": "NcVal BUILD_MAP krev tal", "image": []}
            }
            la npairs = instr[1]
            hvis djupn < npairs * 2 { returner {"ok": "usann", "error": "NcVal BUILD_MAP stakk underflyt", "image": []} }
            hvis memmode {
                emit_build_map_mem(native, npairs, djupn - npairs * 2, home_off, 19)
                opnd_ut(native, djupn - npairs * 2, 19, memmode, home_off)
            } ellers {
                hvis (djupn - npairs * 2 + 1) > 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full etter BUILD_MAP", "overflow": "sann", "image": []} }
                emit_build_map(native, npairs, ncval_opreg(djupn - npairs * 2), ncval_opreg(djupn - npairs * 2))
            }
            djupn = djupn - npairs * 2 + 1
        } ellers hvis op == "INDEX_GET" {
            hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal INDEX_GET krev container og indeks", "image": []} }
            la ig_c = opnd_les(native, djupn - 2, 0, memmode, home_off)
            la ig_i = opnd_les(native, djupn - 1, 1, memmode, home_off)
            emit_index_get(native, ig_c, ig_i, ig_c)
            opnd_ut(native, djupn - 2, ig_c, memmode, home_off)
            djupn = djupn - 1
        } ellers hvis op == "INDEX_SET" {
            // [obj, indeks, verdi] → obj[indeks] = verdi; let obj bli att på stakken.
            hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal INDEX_SET krev obj/indeks/verdi", "image": []} }
            la is_o = opnd_les(native, djupn - 3, 0, memmode, home_off)
            la is_i = opnd_les(native, djupn - 2, 1, memmode, home_off)
            la is_v = opnd_les(native, djupn - 1, 2, memmode, home_off)
            emit_index_set(native, is_o, is_i, is_v)
            opnd_ut(native, djupn - 3, is_o, memmode, home_off)
            djupn = djupn - 2
        } ellers hvis op == "STORE_NAME" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" eller djupn < 1 {
                returner {"ok": "usann", "error": "NcVal STORE_NAME krev namn og stakkverdi", "image": []}
            }
            la topp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            // Modul-global (NAME-opcode for ein global): skriv til x25-slotet, ikkje lokal.
            hvis finnes_nøkkel(globals, instr[1]) {
                la gslotn = globals[instr[1]]
                legg_u32(native, 0xF9000320 | (gslotn << 10) | topp) // str Xtopp, [x25, #slot*8]
            } ellers {
                la idx = variablar[instr[1]]
                legg_u32(native, 0xF9000000 | (idx << 10) | (26 << 5) | topp) // str Xtopp, [x26, #idx*8]
            }
            djupn = djupn - 1
        } ellers hvis op == "LOAD_NAME" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "NcVal LOAD_NAME krev namn", "image": []}
            }
            la ln = instr[1]
            hvis ikkje finnes_nøkkel(variablar, ln) {
                // Modul-global via LOAD_NAME (kompilatoren emitterte NAME i staden for
                // GLOBAL for ein modul-global): last frå x25-slotet. Registrert i
                // `globals` av fri-variabel-skannen i ncval_compile_program.
                hvis finnes_nøkkel(globals, ln) {
                    hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                    la gslotl = globals[ln]
                    la gmåll = opnd_push_reg(djupn, memmode)
                    legg_u32(native, 0xF9400320 | (gslotl << 10) | gmåll) // ldr Xmål, [x25, #slot*8]
                    opnd_ut(native, djupn, gmåll, memmode, home_off)
                    djupn = djupn + 1
                } ellers hvis ln == "null" eller ln == "ingenting" eller ln == "sann" eller ln == "usann" eller ln == "true" eller ln == "false" {
                    hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                    la kdst = opnd_push_reg(djupn, memmode)
                    hvis ln == "null" eller ln == "ingenting" {
                        legg_u32(native, 0xD2800009)             // movz x9, #0
                        emit_ncval_alloc(native, 9, kdst, 1)     // int 0
                    } ellers {
                        la bv = 0
                        hvis ln == "sann" eller ln == "true" { bv = 1 }
                        legg_u32(native, 0xD2800009 | (bv << 5)) // movz x9, #bv
                        emit_ncval_alloc(native, 9, kdst, 2)     // bool
                    }
                    opnd_ut(native, djupn, kdst, memmode, home_off)
                    djupn = djupn + 1
                } ellers {
                    returner {"ok": "usann", "error": "NcVal ukjend lokal variabel: " + ln, "image": []}
                }
            } ellers {
                hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                la idx = variablar[ln]
                la mål = opnd_push_reg(djupn, memmode)
                legg_u32(native, 0xF9400000 | (idx << 10) | (26 << 5) | mål) // ldr Xmål, [x26, #idx*8]
                opnd_ut(native, djupn, mål, memmode, home_off)
                djupn = djupn + 1
            }
        } ellers hvis op == "STORE_GLOBAL" {
            // Fase 8: modul-global = [x25 + slot*8]. slot tildelt i ncval_compile_program.
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" eller djupn < 1 {
                returner {"ok": "usann", "error": "NcVal STORE_GLOBAL krev namn og stakkverdi", "image": []}
            }
            hvis ikkje finnes_nøkkel(globals, instr[1]) { returner {"ok": "usann", "error": "NcVal ukjend global: " + instr[1], "image": []} }
            la gslot = globals[instr[1]]
            la gtopp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            legg_u32(native, 0xF9000320 | (gslot << 10) | gtopp) // str Xtopp, [x25, #slot*8]
            djupn = djupn - 1
        } ellers hvis op == "LOAD_GLOBAL" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "NcVal LOAD_GLOBAL krev namn", "image": []}
            }
            hvis ikkje finnes_nøkkel(globals, instr[1]) { returner {"ok": "usann", "error": "NcVal ukjend global: " + instr[1], "image": []} }
            hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
            la gslot2 = globals[instr[1]]
            la gmål = opnd_push_reg(djupn, memmode)
            legg_u32(native, 0xF9400320 | (gslot2 << 10) | gmål) // ldr Xmål, [x25, #slot*8]
            opnd_ut(native, djupn, gmål, memmode, home_off)
            djupn = djupn + 1
        } ellers hvis op == "LABEL" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "NcVal LABEL krev namn", "image": []}
            }
            hvis finnes_nøkkel(etikettar, instr[1]) { returner {"ok": "usann", "error": "NcVal duplikatetikett: " + instr[1], "image": []} }
            // Kontrollflyt-samanslåing: set djupn til den noterte grein-djupna når
            // etiketten berre nås via hopp (t.d. kortslutta og/eller-samanslåing),
            // så den lineære fall-inn-djupna ikkje gjev feil register/heim.
            hvis finnes_nøkkel(label_djupn, instr[1]) { djupn = label_djupn[instr[1]] }
            etikettar[instr[1]] = lengde(native)
        } ellers hvis op == "JUMP" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "NcVal JUMP krev namn", "image": []}
            }
            label_djupn[instr[1]] = djupn
            la posisjon = lengde(native)
            legg_u32(native, 0x14000000)
            legg_til(grein_patchar, [posisjon, instr[1], "b", 0])
        } ellers hvis op == "JUMP_IF_FALSE" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" eller djupn < 1 {
                returner {"ok": "usann", "error": "NcVal JUMP_IF_FALSE krev namn og stakkverdi", "image": []}
            }
            djupn = djupn - 1
            label_djupn[instr[1]] = djupn
            la topp = opnd_les(native, djupn, 0, memmode, home_off)
            legg_u32(native, 0xB9400800 | (topp << 5) | 9)      // ldr w9, [Xtopp, #8]
            la posisjon = lengde(native)
            legg_u32(native, 0x34000009)                        // cbz w9, <patch>
            legg_til(grein_patchar, [posisjon, instr[1], "cbz", 9])
        } ellers hvis op == "RETURN" {
            // Fase 5: RETURN kan stå kvar som helst (tidleg retur i greiner). Entry
            // pakkar ut heiltalet til w0 (exit); brukarfunksjon returnerer NcVal* i x0.
            hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal RETURN krev stakkverdi", "image": []} }
            la topp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            hvis is_entry {
                legg_u32(native, 0xB9400800 | (topp << 5) | 0)  // ldr w0, [Xtopp, #8]  (utpakka int)
            } ellers {
                legg_u32(native, 0xAA0003E0 | (topp << 16))     // mov x0, Xtopp        (NcVal*)
            }
            emit_fn_epilogue(native)
            ferdig = sann
            djupn = djupn - 1
        } ellers hvis op == "TRY_BEGIN" {
            // Fase 8: installer unnataks-handler. Record (80 byte) på handler-stakken
            // ([x25+ET*8]-topp): catch-adresse (adr), sp, x19–x24, x26. THROW rullar
            // tilbake til dette (setjmp/longjmp). x28-heapen blir IKKJE rulla (unnatak
            // og allokeringar overlever).
            hvis lengde(instr) < 2 eller builtin.type(instr[1]) != "tekst" { returner {"ok": "usann", "error": "NcVal TRY_BEGIN krev catch-etikett", "image": []} }
            la gET = globals["__exc_top__"]
            la p_adr = lengde(native)
            legg_u32(native, 0x10000009)                        // adr x9, catch (patch)
            legg_til(grein_patchar, [p_adr, instr[1], "adr", 9])
            legg_u32(native, 0xF9400320 | (gET << 10) | 10)     // ldr x10, [x25, #ET*8]
            legg_u32(native, 0xF9000149)                        // str x9, [x10]  (catch-adr)
            legg_u32(native, 0x910003E9)                        // add x9, sp, #0
            legg_u32(native, 0xF9000549)                        // str x9, [x10, #8]  (sp)
            legg_u32(native, 0xF9000953)                        // str x19, [x10, #16]
            legg_u32(native, 0xF9000D54)                        // str x20, [x10, #24]
            legg_u32(native, 0xF9001155)                        // str x21, [x10, #32]
            legg_u32(native, 0xF9001556)                        // str x22, [x10, #40]
            legg_u32(native, 0xF9001957)                        // str x23, [x10, #48]
            legg_u32(native, 0xF9001D58)                        // str x24, [x10, #56]
            legg_u32(native, 0xF900215A)                        // str x26, [x10, #64]
            legg_u32(native, 0x9101414A)                        // add x10, x10, #80
            legg_u32(native, 0xF9000320 | (gET << 10) | 10)     // str x10, [x25, #ET*8]
        } ellers hvis op == "TRY_END" {
            la gET2 = globals["__exc_top__"]
            legg_u32(native, 0xF9400320 | (gET2 << 10) | 10)    // ldr x10, [x25, #ET*8]
            legg_u32(native, 0xD101414A)                        // sub x10, x10, #80
            legg_u32(native, 0xF9000320 | (gET2 << 10) | 10)    // str x10, [x25, #ET*8]
        } ellers hvis op == "THROW" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal THROW krev stakkverdi", "image": []} }
            la gET3 = globals["__exc_top__"]
            la gEV3 = globals["__exc_val__"]
            la etopp = opnd_les(native, djupn - 1, 0, memmode, home_off)
            legg_u32(native, 0xF9000320 | (gEV3 << 10) | etopp) // str Xtopp, [x25, #EV*8] (unnatak)
            legg_u32(native, 0xF9400320 | (gET3 << 10) | 10)    // ldr x10, [x25, #ET*8]
            legg_u32(native, 0xD101414A)                        // sub x10, x10, #80  (gjeldande handler — IKKJE pop; catch-blokka sin TRY_END popper)
            legg_u32(native, 0xF9400149)                        // ldr x9, [x10]  (catch-adr)
            legg_u32(native, 0xF940054B)                        // ldr x11, [x10, #8] (sp)
            legg_u32(native, 0x9100017F)                        // mov sp, x11
            legg_u32(native, 0xF9400953)                        // ldr x19, [x10, #16]
            legg_u32(native, 0xF9400D54)                        // ldr x20, [x10, #24]
            legg_u32(native, 0xF9401155)                        // ldr x21, [x10, #32]
            legg_u32(native, 0xF9401556)                        // ldr x22, [x10, #40]
            legg_u32(native, 0xF9401957)                        // ldr x23, [x10, #48]
            legg_u32(native, 0xF9401D58)                        // ldr x24, [x10, #56]
            legg_u32(native, 0xF940215A)                        // ldr x26, [x10, #64]
            legg_u32(native, 0xD61F0120)                        // br x9  (til catch)
            djupn = djupn - 1
        } ellers hvis op == "LOAD_EXCEPTION" {
            hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
            la gEV4 = globals["__exc_val__"]
            la edst = opnd_push_reg(djupn, memmode)
            legg_u32(native, 0xF9400320 | (gEV4 << 10) | edst) // ldr Xdst, [x25, #EV*8]
            opnd_ut(native, djupn, edst, memmode, home_off)
            djupn = djupn + 1
        } ellers hvis op == "CALL" {
            la kallnamn = tekst(instr[1])
            hvis finnes_nøkkel(funksjonar, kallnamn) og ikkje er_ncval_builtin(kallnamn) og lengde(instr) == 3 {
                // Fase 5: ekte kall til brukarfunksjon. Argument i x0..x(n-1), bl, resultat i x0.
                la nargs = instr[2]
                hvis djupn < nargs { returner {"ok": "usann", "error": "NcVal kall-argument underflyt: " + kallnamn, "image": []} }
                hvis nargs > 8 { returner {"ok": "usann", "error": "NcVal kall støttar høgst 8 argument: " + kallnamn, "image": []} }
                la a = 0
                mens a < nargs {
                    hvis memmode {
                        legg_u32(native, 0xF9400340 | ((home_off + djupn - nargs + a) << 10) | a)  // ldr x_a, [x26, #home]
                    } ellers {
                        la src = ncval_opreg(djupn - nargs + a)
                        legg_u32(native, 0xAA0003E0 | (src << 16) | a)  // mov x_a, Xsrc
                    }
                    a = a + 1
                }
                la p_bl = lengde(native)
                legg_u32(native, 0x94000000)                        // bl <patch>
                legg_til(bl_patchar, [p_bl, kallnamn])
                hvis memmode {
                    legg_u32(native, 0xF9000340 | ((home_off + djupn - nargs) << 10) | 0)  // str x0, [x26, #home(dst)]
                } ellers {
                    legg_u32(native, 0xAA0003E0 | ncval_opreg(djupn - nargs)) // mov Xdst, x0  (resultat)
                }
                djupn = djupn - nargs + 1
            } ellers {
                // Builtin-hale. Last topp-operandane éin gong (r1=djupn-1, r2=djupn-2,
                // r3=djupn-3) inn i x21/x20/x19 i mem-modus; i reg-modus er dette berre
                // reg-nummer (opnd_les emitterer ingenting) så bytene er uendra. Kvar
                // sak skriv resultatet tilbake med opnd_ut før djupn justerast.
                la r1 = 0
                la r2 = 0
                la r3 = 0
                hvis djupn >= 1 { r1 = opnd_les(native, djupn - 1, 2, memmode, home_off) }
                hvis djupn >= 2 { r2 = opnd_les(native, djupn - 2, 1, memmode, home_off) }
                hvis djupn >= 3 { r3 = opnd_les(native, djupn - 3, 0, memmode, home_off) }
                la env_ov = 0 - 1
                hvis finnes_nøkkel(globals, "__env_overlay__") { env_ov = globals["__env_overlay__"] }
                hvis (kallnamn == "skriv" eller kallnamn == "builtin.skriv" eller kallnamn == "print" eller kallnamn == "builtin.print") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal skriv krev éin stakkverdi", "image": []} }
                    emit_skriv_ncval(native, r1, os)
                    // skriv gjev nil→held argumentet som dummy-resultat; djupn uendra.
                } ellers hvis (kallnamn == "lengde" eller kallnamn == "builtin.lengde") og lengde(instr) == 3 og instr[2] == 1 {
                    // Fase 3: lengde(streng) = byte-lengda i strdata-headeren, boksa som int.
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal lengde krev éin stakkverdi", "image": []} }
                    legg_u32(native, 0xF9400400 | (r1 << 5) | 9)  // ldr x9, [Xtopp, #8]  (strdata)
                    legg_u32(native, 0xF940012A)                    // ldr x10, [x9]        (lengd)
                    emit_ncval_alloc(native, 10, r1, 1)             // boks som int → same slot
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "char_code" eller kallnamn == "builtin.char_code") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal char_code krev 1 arg", "image": []} }
                    emit_char_code(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "chr" eller kallnamn == "builtin.chr") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal chr krev 1 arg", "image": []} }
                    emit_chr(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "lower" eller kallnamn == "builtin.lower") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal lower krev 1 arg", "image": []} }
                    emit_case(native, r1, r1, 1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "upper" eller kallnamn == "builtin.upper") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal upper krev 1 arg", "image": []} }
                    emit_case(native, r1, r1, 2)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "slice" eller kallnamn == "builtin.slice") og lengde(instr) == 3 og instr[2] == 3 {
                    hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal slice krev 3 arg", "image": []} }
                    emit_slice(native, r3, r2, r1, r3)
                    opnd_ut(native, djupn - 3, r3, memmode, home_off)
                    djupn = djupn - 2
                } ellers hvis (kallnamn == "index_of" eller kallnamn == "builtin.index_of") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal index_of krev 2 arg", "image": []} }
                    emit_str_find(native, r2, r1, r2, usann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "contains" eller kallnamn == "builtin.contains") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal contains krev 2 arg", "image": []} }
                    emit_str_find(native, r2, r1, r2, sann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "starts_with" eller kallnamn == "builtin.starts_with") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal starts_with krev 2 arg", "image": []} }
                    emit_str_matchat(native, r2, r1, r2, usann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "ends_with" eller kallnamn == "builtin.ends_with") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal ends_with krev 2 arg", "image": []} }
                    emit_str_matchat(native, r2, r1, r2, sann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "trim" eller kallnamn == "builtin.trim") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal trim krev 1 arg", "image": []} }
                    emit_trim(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis ncval_er_tekst_kall(kallnamn) og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal tekst krev 1 arg", "image": []} }
                    emit_tekst_ncval(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis ncval_er_heltall_kall(kallnamn) og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal heltall krev 1 arg", "image": []} }
                    emit_heltall_str(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "type" eller kallnamn == "builtin.type") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal type krev 1 arg", "image": []} }
                    emit_type_ncval(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "nøkler" eller kallnamn == "builtin.nøkler") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal nøkler krev 1 arg", "image": []} }
                    emit_noekler(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "tid_ms" eller kallnamn == "builtin.tid_ms" eller kallnamn == "now_ms" eller kallnamn == "builtin.now_ms") og lengde(instr) == 3 og instr[2] == 0 {
                    hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                    la td = opnd_push_reg(djupn, memmode)
                    emit_tid_ms(native, td, os)
                    opnd_ut(native, djupn, td, memmode, home_off)
                    djupn = djupn + 1
                } ellers hvis (kallnamn == "verdier" eller kallnamn == "builtin.verdier") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal verdier krev 1 arg", "image": []} }
                    emit_verdier(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fjern_siste" eller kallnamn == "builtin.fjern_siste") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal fjern_siste krev 1 arg", "image": []} }
                    emit_fjern_siste(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "split" eller kallnamn == "builtin.split") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal split krev 2 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r2 << 16))     // mov x0, Xstr
                    legg_u32(native, 0xAA0003E1 | (r1 << 16))     // mov x1, Xdelim
                    la p_bl_split = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __split
                    legg_til(bl_patchar, [p_bl_split, "__split"])
                    legg_u32(native, 0xAA0003E0 | r2)             // mov Xstr, x0
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "fjern_nokkel" eller kallnamn == "builtin.fjern_nokkel") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal fjern_nokkel krev 2 arg", "image": []} }
                    emit_fjern_nokkel(native, r2, r1)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "join" eller kallnamn == "builtin.join") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal join krev 2 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r2 << 16))     // mov x0, Xliste
                    legg_u32(native, 0xAA0003E1 | (r1 << 16))   // mov x1, Xsep
                    la p_bl_join = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __join
                    legg_til(bl_patchar, [p_bl_join, "__join"])
                    legg_u32(native, 0xAA0003E0 | r2)             // mov Xliste, x0
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "replace" eller kallnamn == "builtin.replace") og lengde(instr) == 3 og instr[2] == 3 {
                    hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal replace krev 3 arg", "image": []} }
                    emit_replace(native, r3, r2, r1, r3)
                    opnd_ut(native, djupn - 3, r3, memmode, home_off)
                    djupn = djupn - 2
                } ellers hvis (kallnamn == "har_nokkel" eller kallnamn == "builtin.har_nokkel" eller kallnamn == "finnes_nøkkel" eller kallnamn == "builtin.finnes_nøkkel") og lengde(instr) == 3 og instr[2] == 2 {
                    // Fase 4: finnes_nøkkel(kart, nøkkel) → bool.
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal har_nokkel krev 2 arg", "image": []} }
                    emit_map_get(native, r2, r1, r2, sann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "fil_skriv" eller kallnamn == "builtin.fil_skriv") og lengde(instr) == 3 og instr[2] == 2 {
                    // Fase 6: fil_skriv(path, content).
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal fil_skriv krev 2 arg", "image": []} }
                    emit_fil_skriv(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "fil_les" eller kallnamn == "builtin.fil_les") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal fil_les krev 1 arg", "image": []} }
                    emit_fil_les(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fil_finnes" eller kallnamn == "builtin.fil_finnes") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal fil_finnes krev 1 arg", "image": []} }
                    emit_fil_finnes(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fil_slett" eller kallnamn == "builtin.fil_slett") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal fil_slett krev 1 arg", "image": []} }
                    emit_fil_slett(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fil_sett_kjorbar" eller kallnamn == "builtin.fil_sett_kjorbar") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal fil_sett_kjorbar krev 1 arg", "image": []} }
                    emit_fil_sett_kjorbar(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fil_append" eller kallnamn == "builtin.fil_append") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal fil_append krev 2 arg", "image": []} }
                    emit_fil_append(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "bytes_to_text" eller kallnamn == "builtin.bytes_to_text") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal bytes_to_text krev 1 arg", "image": []} }
                    emit_bytes_to_text(native, r1, r1)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fil_skriv_binær" eller kallnamn == "builtin.fil_skriv_binær" eller kallnamn == "fil_skriv_binary" eller kallnamn == "builtin.fil_skriv_binary") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal fil_skriv_binær krev 2 arg", "image": []} }
                    emit_fil_skriv_binaer(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "fil_les_binær" eller kallnamn == "builtin.fil_les_binær" eller kallnamn == "fil_les_binary" eller kallnamn == "builtin.fil_les_binary") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal fil_les_binær krev 1 arg", "image": []} }
                    emit_fil_les_binaer(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "random_hex" eller kallnamn == "builtin.random_hex") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal random_hex krev 1 arg", "image": []} }
                    emit_random_hex(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "fil_append_binær" eller kallnamn == "builtin.fil_append_binær" eller kallnamn == "fil_append_binary" eller kallnamn == "builtin.fil_append_binary") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal fil_append_binær krev 2 arg", "image": []} }
                    emit_fil_append_binaer(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "miljo_finnes" eller kallnamn == "builtin.miljo_finnes" eller kallnamn == "miljø_finnes" eller kallnamn == "builtin.miljø_finnes" eller kallnamn == "_rt_env_finnes" eller kallnamn == "builtin._rt_env_finnes") og lengde(instr) == 3 og instr[2] == 1 {
                    // miljo_finnes(namn) → bool. Hent verdi (overlay + envp) og sjekk om
                    // strlengda > 0. (Tom-verdi-eksisterer-kanten aksepterast; nc_main
                    // brukar berre miljo_finnes på ikkje-tomme konfigvariablar.)
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal miljo_finnes krev 1 arg", "image": []} }
                    hvis env_ov >= 0 {
                        legg_u32(native, 0xF9400320 | (env_ov << 10) | 0)   // ldr x0, [x25, #OV*8]
                        legg_u32(native, 0xAA0003E1 | (r1 << 16))           // mov x1, Xnamn
                        la p_bl_ef = lengde(native)
                        legg_u32(native, 0x94000000)                        // bl __env_get
                        legg_til(bl_patchar, [p_bl_ef, "__env_get"])
                        la p_cbz_ef = lengde(native)
                        legg_u32(native, 0xB4000000)                        // cbz x0, envp (patch)
                        legg_u32(native, 0xAA0003E0 | r1)                   // mov Xres, x0 (funne)
                        la p_b_efdone = lengde(native)
                        legg_u32(native, 0x14000000)                        // b done (patch)
                        la lbl_efenvp = lengde(native)
                        skriv_u32(native, p_cbz_ef, 0xB4000000 | ((((lbl_efenvp - p_cbz_ef) / 4) & 0x7FFFF) << 5) | 0)
                        emit_miljo_hent(native, r1, r1)
                        la lbl_efdone = lengde(native)
                        skriv_u32(native, p_b_efdone, 0x14000000 | (((lbl_efdone - p_b_efdone) / 4) & 0x03FFFFFF))
                    } ellers {
                        emit_miljo_hent(native, r1, r1)
                    }
                    // r1 held no ein streng-NcVal; bool = (strlengd != 0)
                    legg_u32(native, 0xF9400400 | (r1 << 5) | 9)        // ldr x9, [Xres, #8] (strdata)
                    legg_u32(native, 0xF9400129)                        // ldr x9, [x9] (lengd)
                    legg_u32(native, 0xF100013F)                        // cmp x9, #0
                    legg_u32(native, 0x1A9F07E9)                        // cset w9, ne
                    emit_ncval_alloc(native, 9, r1, 2)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "miljo_hent" eller kallnamn == "builtin.miljo_hent") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal miljo_hent krev 1 arg", "image": []} }
                    hvis env_ov >= 0 {
                        // Sjekk overlayet fyrst (bl __env_get); funne → resultat, elles envp.
                        legg_u32(native, 0xF9400320 | (env_ov << 10) | 0)   // ldr x0, [x25, #OV*8]
                        legg_u32(native, 0xAA0003E1 | (r1 << 16))           // mov x1, Xnamn
                        la p_bl_eg = lengde(native)
                        legg_u32(native, 0x94000000)                        // bl __env_get
                        legg_til(bl_patchar, [p_bl_eg, "__env_get"])
                        la p_cbz_envp = lengde(native)
                        legg_u32(native, 0xB4000000)                        // cbz x0, envp (patch)
                        legg_u32(native, 0xAA0003E0 | r1)                   // mov Xres, x0 (funne)
                        la p_b_hentdone = lengde(native)
                        legg_u32(native, 0x14000000)                        // b done (patch)
                        la lbl_envp = lengde(native)
                        skriv_u32(native, p_cbz_envp, 0xB4000000 | ((((lbl_envp - p_cbz_envp) / 4) & 0x7FFFF) << 5) | 0)
                        emit_miljo_hent(native, r1, r1)
                        la lbl_hentdone = lengde(native)
                        skriv_u32(native, p_b_hentdone, 0x14000000 | (((lbl_hentdone - p_b_hentdone) / 4) & 0x03FFFFFF))
                    } ellers {
                        emit_miljo_hent(native, r1, r1)
                    }
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "miljo_sett" eller kallnamn == "builtin.miljo_sett") og lengde(instr) == 3 og instr[2] == 2 {
                    // miljo_sett(namn, verdi): skriv til overlay-kartet (bl __env_set),
                    // lagra (evt. vakse) kart tilbake i globalen. Resultat = verdi.
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal miljo_sett krev 2 arg", "image": []} }
                    hvis env_ov < 0 { returner {"ok": "usann", "error": "NcVal miljo_sett utan overlay-global", "image": []} }
                    legg_u32(native, 0xF9400320 | (env_ov << 10) | 0)   // ldr x0, [x25, #OV*8]  (kart)
                    legg_u32(native, 0xAA0003E1 | (r2 << 16))           // mov x1, Xnamn
                    legg_u32(native, 0xAA0003E2 | (r1 << 16))           // mov x2, Xverdi
                    la p_bl_es = lengde(native)
                    legg_u32(native, 0x94000000)                        // bl __env_set
                    legg_til(bl_patchar, [p_bl_es, "__env_set"])
                    legg_u32(native, 0xF9000320 | (env_ov << 10) | 0)   // str x0, [x25, #OV*8]  (oppdatert kart)
                    opnd_ut(native, djupn - 2, r1, memmode, home_off)   // resultat = verdi
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "json_stringify" eller kallnamn == "builtin.json_stringify") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal json_stringify krev 1 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r1 << 16))  // mov x0, Xtopp
                    la p_bl_js = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __json_stringify
                    legg_til(bl_patchar, [p_bl_js, "__json_stringify"])
                    legg_u32(native, 0xAA0003E0 | r1)          // mov Xtopp, x0
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "json_parse" eller kallnamn == "builtin.json_parse" eller kallnamn == "json_parse_raw" eller kallnamn == "builtin.json_parse_raw") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal json_parse krev 1 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r1 << 16))  // mov x0, Xtopp  (arg-streng)
                    legg_u32(native, 0xF9400409)                    // ldr x9, [x0, #8]  (strdata)
                    legg_u32(native, 0xF940012A)                    // ldr x10, [x9]     (lengd)
                    legg_u32(native, 0x91002120)                    // add x0, x9, #8    (cur)
                    legg_u32(native, 0x8B0A0001)                    // add x1, x0, x10   (end)
                    la p_bl_jp = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __json_parse
                    legg_til(bl_patchar, [p_bl_jp, "__json_parse"])
                    legg_u32(native, 0xAA0003E0 | r1)          // mov Xtopp, x0
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "socket_new" eller kallnamn == "builtin.socket_new") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal socket_new krev 2 arg", "image": []} }
                    emit_socket_new(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "socket_bind" eller kallnamn == "builtin.socket_bind") og lengde(instr) == 3 og instr[2] == 3 {
                    hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal socket_bind krev 3 arg", "image": []} }
                    emit_socket_bind(native, r3, r2, r1, r3, os)
                    opnd_ut(native, djupn - 3, r3, memmode, home_off)
                    djupn = djupn - 2
                } ellers hvis (kallnamn == "socket_connect" eller kallnamn == "builtin.socket_connect") og lengde(instr) == 3 og instr[2] == 3 {
                    hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal socket_connect krev 3 arg", "image": []} }
                    emit_socket_connect(native, r3, r2, r1, r3, os)
                    opnd_ut(native, djupn - 3, r3, memmode, home_off)
                    djupn = djupn - 2
                } ellers hvis (kallnamn == "socket_listen" eller kallnamn == "builtin.socket_listen") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal socket_listen krev 2 arg", "image": []} }
                    emit_socket_listen(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "socket_accept" eller kallnamn == "builtin.socket_accept") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal socket_accept krev 1 arg", "image": []} }
                    emit_socket_accept(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "socket_send" eller kallnamn == "builtin.socket_send") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal socket_send krev 2 arg", "image": []} }
                    emit_socket_send(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "socket_recv" eller kallnamn == "builtin.socket_recv") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal socket_recv krev 2 arg", "image": []} }
                    emit_socket_recv(native, r2, r1, r2, os)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "socket_close" eller kallnamn == "builtin.socket_close") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal socket_close krev 1 arg", "image": []} }
                    emit_socket_close(native, r1, r1, os)
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "legg_til" eller kallnamn == "builtin.legg_til") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal legg_til krev 2 arg", "image": []} }
                    emit_legg_til(native, r2, r1)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "tekst_erstatt" eller kallnamn == "builtin.tekst_erstatt") og lengde(instr) == 3 og instr[2] == 3 {
                    // alias for replace(s, frå, til)
                    hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal tekst_erstatt krev 3 arg", "image": []} }
                    emit_replace(native, r3, r2, r1, r3)
                    opnd_ut(native, djupn - 3, r3, memmode, home_off)
                    djupn = djupn - 2
                } ellers hvis (kallnamn == "tekst_starter_med" eller kallnamn == "builtin.tekst_starter_med") og lengde(instr) == 3 og instr[2] == 2 {
                    // alias for starts_with(s, prefiks)
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal tekst_starter_med krev 2 arg", "image": []} }
                    emit_str_matchat(native, r2, r1, r2, usann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "nøkkel_finnes" eller kallnamn == "builtin.nøkkel_finnes") og lengde(instr) == 3 og instr[2] == 2 {
                    // alias for finnes_nøkkel(kart, nøkkel) → bool
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal nøkkel_finnes krev 2 arg", "image": []} }
                    emit_map_get(native, r2, r1, r2, sann)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "json_skriv" eller kallnamn == "builtin.json_skriv") og lengde(instr) == 3 og instr[2] == 1 {
                    // alias for json_stringify(verdi)
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal json_skriv krev 1 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r1 << 16))  // mov x0, Xtopp
                    la p_bl_jsk = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __json_stringify
                    legg_til(bl_patchar, [p_bl_jsk, "__json_stringify"])
                    legg_u32(native, 0xAA0003E0 | r1)          // mov Xtopp, x0
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "exit" eller kallnamn == "builtin.exit") og lengde(instr) == 3 og instr[2] == 1 {
                    // exit(kode): pakk ut heiltalet til w0 og kall exit-syscall (macOS x16=1,
                    // Linux x8=93). Prosessen terminerer; resultatet er uråkeleg.
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal exit krev 1 arg", "image": []} }
                    legg_u32(native, 0xB9400800 | (r1 << 5) | 0)  // ldr w0, [Xkode, #8]
                    hvis os == "linux" { emit_syscall(native, 93, os) } ellers { emit_syscall(native, 1, os) }
                    // djupn uendra (dummy-resultat, aldri nådd)
                } ellers hvis (kallnamn == "bytes_new" eller kallnamn == "builtin.bytes_new") og lengde(instr) == 3 og instr[2] == 2 {
                    // bytes som NcVal-liste: bytes_new(storleik, fyll) → liste av fyll.
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal bytes_new krev 2 arg", "image": []} }
                    emit_bytes_new(native, r2, r1, r2)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "bytes_from_list" eller kallnamn == "builtin.bytes_from_list" eller kallnamn == "bytes_to_list" eller kallnamn == "builtin.bytes_to_list") og lengde(instr) == 3 og instr[2] == 1 {
                    // bytes ≡ liste → begge er identitet (operanden ligg alt på plass).
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal bytes_from/to_list krev 1 arg", "image": []} }
                    opnd_ut(native, djupn - 1, r1, memmode, home_off)
                } ellers hvis (kallnamn == "assert" eller kallnamn == "builtin.assert") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal assert krev 1 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r1 << 16))       // mov x0, Xvilkår
                    la p_bl_as = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __assert
                    legg_til(bl_patchar, [p_bl_as, "__assert"])
                    // resultat = vilkåret (uendra); djupn uendra
                } ellers hvis (kallnamn == "assert_eq" eller kallnamn == "builtin.assert_eq") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal assert_eq krev 2 arg", "image": []} }
                    legg_u32(native, 0xAA0003E0 | (r2 << 16))       // mov x0, Xa
                    legg_u32(native, 0xAA0003E1 | (r1 << 16))       // mov x1, Xb
                    la p_bl_ae = lengde(native)
                    legg_u32(native, 0x94000000)                    // bl __assert_eq
                    legg_til(bl_patchar, [p_bl_ae, "__assert_eq"])
                    opnd_ut(native, djupn - 2, r1, memmode, home_off)   // resultat = b (uråkeleg)
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "fjern" eller kallnamn == "builtin.fjern" eller kallnamn == "fjern_indeks" eller kallnamn == "builtin.fjern_indeks") og lengde(instr) == 3 og instr[2] == 2 {
                    hvis djupn < 2 { returner {"ok": "usann", "error": "NcVal fjern krev 2 arg", "image": []} }
                    emit_fjern_indeks(native, r2, r1)
                    opnd_ut(native, djupn - 2, r2, memmode, home_off)   // resultat = lista
                    djupn = djupn - 1
                } ellers hvis (kallnamn == "sett_inn" eller kallnamn == "builtin.sett_inn") og lengde(instr) == 3 og instr[2] == 3 {
                    hvis djupn < 3 { returner {"ok": "usann", "error": "NcVal sett_inn krev 3 arg", "image": []} }
                    emit_sett_inn(native, r3, r2, r1)
                    opnd_ut(native, djupn - 3, r3, memmode, home_off)   // resultat = lista
                    djupn = djupn - 2
                } ellers hvis (kallnamn == "system_info" eller kallnamn == "builtin.system_info") og lengde(instr) == 3 og instr[2] == 0 {
                    hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                    la si_d = opnd_push_reg(djupn, memmode)
                    emit_system_info(native, si_d, os)
                    opnd_ut(native, djupn, si_d, memmode, home_off)
                    djupn = djupn + 1
                } ellers hvis (kallnamn == "native_heap_bytes" eller kallnamn == "builtin.native_heap_bytes") og lengde(instr) == 3 og instr[2] == 0 {
                    // Dokumentert fallback-verdi: kallarane (kompiler_heap_bytes)
                    // behandlar -1 som "ikkje tilgjengeleg" og loggar berre talet.
                    hvis ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                    la hb_d = opnd_push_reg(djupn, memmode)
                    legg_u32(native, 0x92800009)                    // movn x9, #0  (-1)
                    emit_ncval_alloc(native, 9, hb_d, 1)
                    opnd_ut(native, djupn, hb_d, memmode, home_off)
                    djupn = djupn + 1
                } ellers hvis (kallnamn == "vent.sov" eller kallnamn == "builtin.vent.sov") og lengde(instr) == 3 og instr[2] == 1 {
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal vent.sov krev 1 arg", "image": []} }
                    emit_vent_sov(native, r1, os)
                    // resultat: argumentet står att som dummy; djupn uendra
                } ellers hvis (kallnamn == "feil" eller kallnamn == "builtin.feil") og lengde(instr) == 3 og instr[2] == 1 {
                    // feil(melding) = THROW med meldinga som unnatak (same
                    // handler-maskineri som THROW-opcoden; catch-blokkas TRY_END
                    // popper handleren).
                    hvis djupn < 1 { returner {"ok": "usann", "error": "NcVal feil krev 1 arg", "image": []} }
                    la gETf = globals["__exc_top__"]
                    la gEVf = globals["__exc_val__"]
                    legg_u32(native, 0xF9000320 | (gEVf << 10) | r1)    // str Xmsg, [x25, #EV*8]
                    legg_u32(native, 0xF9400320 | (gETf << 10) | 10)    // ldr x10, [x25, #ET*8]
                    legg_u32(native, 0xD101414A)                        // sub x10, x10, #80
                    legg_u32(native, 0xF9400149)                        // ldr x9, [x10]
                    legg_u32(native, 0xF940054B)                        // ldr x11, [x10, #8]
                    legg_u32(native, 0x9100017F)                        // mov sp, x11
                    legg_u32(native, 0xF9400953)                        // ldr x19, [x10, #16]
                    legg_u32(native, 0xF9400D54)                        // ldr x20, [x10, #24]
                    legg_u32(native, 0xF9401155)                        // ldr x21, [x10, #32]
                    legg_u32(native, 0xF9401556)                        // ldr x22, [x10, #40]
                    legg_u32(native, 0xF9401957)                        // ldr x23, [x10, #48]
                    legg_u32(native, 0xF9401D58)                        // ldr x24, [x10, #56]
                    legg_u32(native, 0xF940215A)                        // ldr x26, [x10, #64]
                    legg_u32(native, 0xD61F0120)                        // br x9  (til catch)
                    // djupn-bokføring: konsumerer 1, "produserer" 1 (uråkeleg)
                } ellers hvis ncval_gap_stub(kallnamn) og lengde(instr) == 3 {
                    // Fail-closed stubb: kast "NATIV-GAP:<namn>" (sjå ncval_gap_stub).
                    la nargs_st = instr[2]
                    hvis djupn < nargs_st { returner {"ok": "usann", "error": "NcVal stubb-arg underflyt: " + kallnamn, "image": []} }
                    hvis nargs_st == 0 og ikkje memmode og djupn >= 6 { returner {"ok": "usann", "error": "NcVal operand-stakk full (>6, x25 reservert globals)", "overflow": "sann", "image": []} }
                    prøv { emit_ncval_str_const(native, "NATIV-GAP:" + ncval_avkort_builtin(kallnamn), 11) } fang melding {
                        returner {"ok": "usann", "error": tekst(melding), "image": []}
                    }
                    la gETs = globals["__exc_top__"]
                    la gEVs = globals["__exc_val__"]
                    legg_u32(native, 0xF9000320 | (gEVs << 10) | 11)    // str x11, [x25, #EV*8]
                    legg_u32(native, 0xF9400320 | (gETs << 10) | 10)    // ldr x10, [x25, #ET*8]
                    legg_u32(native, 0xD101414A)                        // sub x10, x10, #80
                    legg_u32(native, 0xF9400149)                        // ldr x9, [x10]
                    legg_u32(native, 0xF940054B)                        // ldr x11, [x10, #8]
                    legg_u32(native, 0x9100017F)                        // mov sp, x11
                    legg_u32(native, 0xF9400953)                        // ldr x19, [x10, #16]
                    legg_u32(native, 0xF9400D54)                        // ldr x20, [x10, #24]
                    legg_u32(native, 0xF9401155)                        // ldr x21, [x10, #32]
                    legg_u32(native, 0xF9401556)                        // ldr x22, [x10, #40]
                    legg_u32(native, 0xF9401957)                        // ldr x23, [x10, #48]
                    legg_u32(native, 0xF9401D58)                        // ldr x24, [x10, #56]
                    legg_u32(native, 0xF940215A)                        // ldr x26, [x10, #64]
                    legg_u32(native, 0xD61F0120)                        // br x9  (til catch)
                    djupn = djupn - nargs_st + 1
                } ellers {
                    returner {"ok": "usann", "error": "NcVal støttar ikkje kall: " + kallnamn, "image": []}
                }
            }
        } ellers {
            returner {"ok": "usann", "error": "NcVal støttar ikkje opcode: " + op, "image": []}
        }
        i = i + 1
    }
    hvis ikkje ferdig { returner {"ok": "usann", "error": "NcVal-program manglar RETURN", "image": []} }
    la p = 0
    mens p < lengde(grein_patchar) {
        la patch = grein_patchar[p]
        hvis ikkje finnes_nøkkel(etikettar, patch[1]) { returner {"ok": "usann", "error": "NcVal manglar etikett: " + patch[1], "image": []} }
        la mål = etikettar[patch[1]]
        la ord_delta = (mål - patch[0]) / 4
        hvis patch[2] == "b" {
            hvis ord_delta < -33554432 eller ord_delta > 33554431 { returner {"ok": "usann", "error": "NcVal JUMP utanfor rekkevidde", "image": []} }
            skriv_u32(native, patch[0], 0x14000000 | (ord_delta & 0x03FFFFFF))
        } ellers hvis patch[2] == "adr" {
            // Fase 8: ADR Xd, etikett (PC-relativ absolutt-adresse for catch-blokk).
            // Offset er i byte; måla er ord-justerte så immlo = 0.
            la byte_delta = mål - patch[0]
            skriv_u32(native, patch[0], 0x10000000 | (((byte_delta / 4) & 0x7FFFF) << 5) | patch[3])
        } ellers {
            hvis ord_delta < -262144 eller ord_delta > 262143 { returner {"ok": "usann", "error": "NcVal JUMP_IF_FALSE utanfor rekkevidde", "image": []} }
            skriv_u32(native, patch[0], 0x34000000 | ((ord_delta & 0x7FFFF) << 5) | patch[3])
        }
        p = p + 1
    }
    returner {"ok": "sann", "error": "", "image": native}
}

funksjon kompiler_arm64(kode, os) -> ordbok_tekst {
    hvis builtin.type(kode) != "liste" {
        returner {"ok": "usann", "error": "macOS kodegen krev instruksjonsliste", "image": []}
    }
    la native: liste_heiltall = []
    la djupn = 0
    la variablar = {}
    la variabel_antal = 0
    la etikettar = {}
    la grein_patchar = []
    la ferdig = usann
    la i = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        la op = opcode(instr)
        hvis op == "PUSH_CONST" {
            hvis lengde(instr) != 2 eller (builtin.type(instr[1]) != "heltall" og builtin.type(instr[1]) != "boolsk") {
                returner {"ok": "usann", "error": "macOS AOT PUSH_CONST krev heiltall", "image": []}
            }
            hvis djupn >= 4 { returner {"ok": "usann", "error": "macOS AOT-stakk støttar høgst 4 verdiar", "image": []} }
            la konstant = instr[1]
            hvis builtin.type(konstant) == "boolsk" {
                hvis konstant { konstant = 1 } ellers { konstant = 0 }
            }
            prøv { last_heiltall(native, 8 + djupn, konstant) } fang melding {
                returner {"ok": "usann", "error": tekst(melding), "image": []}
            }
            djupn = djupn + 1
        } ellers hvis op == "POP" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "macOS AOT-stakk underflyt ved POP", "image": []} }
            djupn = djupn - 1
        } ellers hvis op == "BINARY_ADD" eller op == "ADD" eller op == "BINARY_SUB" eller op == "SUB" eller op == "BINARY_MUL" eller op == "MUL" eller op == "BINARY_DIV" eller op == "DIV" eller op == "BINARY_MOD" eller op == "BINARY_AND" eller op == "BINARY_OR" eller op == "BINARY_XOR" eller op == "BINARY_LSHIFT" eller op == "BINARY_RSHIFT" {
            hvis djupn < 2 { returner {"ok": "usann", "error": "macOS AOT-stakk underflyt ved " + op, "image": []} }
            la venstre = 8 + djupn - 2
            la høgre = 8 + djupn - 1
            hvis op == "BINARY_ADD" eller op == "ADD" {
                legg_u32(native, 0x0B000000 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_SUB" eller op == "SUB" {
                legg_u32(native, 0x4B000000 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_MUL" eller op == "MUL" {
                legg_u32(native, 0x1B007C00 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_DIV" eller op == "DIV" {
                legg_u32(native, 0x1AC00C00 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_MOD" {
                legg_u32(native, 0x1AC00C00 | (høgre << 16) | (venstre << 5)) // sdiv w0, wVenstre, wHøgre
                legg_u32(native, 0x1B008000 | (høgre << 16) | (venstre << 10) | venstre) // msub wVenstre, w0, wHøgre, wVenstre
            } ellers hvis op == "BINARY_AND" {
                legg_u32(native, 0x0A000000 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_OR" {
                legg_u32(native, 0x2A000000 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_XOR" {
                legg_u32(native, 0x4A000000 | (høgre << 16) | (venstre << 5) | venstre)
            } ellers hvis op == "BINARY_LSHIFT" {
                legg_u32(native, 0x1AC02000 | (høgre << 16) | (venstre << 5) | venstre) // lslv
            } ellers {
                legg_u32(native, 0x1AC02800 | (høgre << 16) | (venstre << 5) | venstre) // asrv
            }
            djupn = djupn - 1
        } ellers hvis op == "UNARY_NEG" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "macOS AOT-stakk underflyt ved UNARY_NEG", "image": []} }
            la register = 8 + djupn - 1
            legg_u32(native, 0x4B0003E0 | (register << 16) | register) // neg wN, wN
        } ellers hvis op == "UNARY_NOT" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "macOS AOT-stakk underflyt ved UNARY_NOT", "image": []} }
            la register = 8 + djupn - 1
            legg_u32(native, 0x7100001F | (register << 5)) // cmp wN, #0
            legg_u32(native, 0x1A9F17E0 | register) // cset wN, eq
        } ellers hvis op == "UNARY_BNOT" {
            hvis djupn < 1 { returner {"ok": "usann", "error": "macOS AOT-stakk underflyt ved UNARY_BNOT", "image": []} }
            la register = 8 + djupn - 1
            legg_u32(native, 0x2A2003E0 | (register << 16) | register) // mvn wN, wN
        } ellers hvis op == "COMPARE_EQ" eller op == "COMPARE_NE" eller op == "COMPARE_LT" eller op == "COMPARE_LE" eller op == "COMPARE_GT" eller op == "COMPARE_GE" {
            hvis djupn < 2 { returner {"ok": "usann", "error": "macOS AOT-stakk underflyt ved " + op, "image": []} }
            la venstre = 8 + djupn - 2
            la høgre = 8 + djupn - 1
            legg_u32(native, 0x6B00001F | (høgre << 16) | (venstre << 5)) // cmp wVenstre, wHøgre
            la cset = 0
            hvis op == "COMPARE_EQ" { cset = 0x1A9F17E0 }
            hvis op == "COMPARE_NE" { cset = 0x1A9F07E0 }
            hvis op == "COMPARE_LT" { cset = 0x1A9FA7E0 }
            hvis op == "COMPARE_GE" { cset = 0x1A9FB7E0 }
            hvis op == "COMPARE_LE" { cset = 0x1A9FC7E0 }
            hvis op == "COMPARE_GT" { cset = 0x1A9FD7E0 }
            legg_u32(native, cset | venstre)
            djupn = djupn - 1
        } ellers hvis op == "STORE_NAME" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" eller djupn < 1 {
                returner {"ok": "usann", "error": "macOS AOT STORE_NAME krev namn og stakkverdi", "image": []}
            }
            la namn = instr[1]
            la mål = variablar[namn]
            hvis mål == null {
                hvis variabel_antal >= 13 { returner {"ok": "usann", "error": "macOS AOT støttar høgst 13 lokale variablar", "image": []} }
                mål = variabel_register(variabel_antal)
                variablar[namn] = mål
                variabel_antal = variabel_antal + 1
            }
            la kjelde = 8 + djupn - 1
            legg_u32(native, 0x2A0003E0 | (kjelde << 16) | mål) // mov wMål, wKjelde
            djupn = djupn - 1
        } ellers hvis op == "LOAD_NAME" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "macOS AOT LOAD_NAME krev namn", "image": []}
            }
            la kjelde = variablar[instr[1]]
            hvis kjelde == null { returner {"ok": "usann", "error": "macOS AOT ukjend lokal variabel: " + instr[1], "image": []} }
            hvis djupn >= 4 { returner {"ok": "usann", "error": "macOS AOT-stakk støttar høgst 4 verdiar", "image": []} }
            la mål = 8 + djupn
            legg_u32(native, 0x2A0003E0 | (kjelde << 16) | mål) // mov wMål, wKjelde
            djupn = djupn + 1
        } ellers hvis op == "LABEL" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "macOS AOT LABEL krev namn", "image": []}
            }
            hvis etikettar[instr[1]] != null { returner {"ok": "usann", "error": "macOS AOT duplikatetikett: " + instr[1], "image": []} }
            etikettar[instr[1]] = lengde(native)
        } ellers hvis op == "JUMP" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "macOS AOT JUMP krev namn", "image": []}
            }
            la posisjon = lengde(native)
            legg_u32(native, 0x14000000)
            legg_til(grein_patchar, [posisjon, instr[1], "b", 0])
        } ellers hvis op == "JUMP_IF_FALSE" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" eller djupn < 1 {
                returner {"ok": "usann", "error": "macOS AOT JUMP_IF_FALSE krev namn og stakkverdi", "image": []}
            }
            djupn = djupn - 1
            la register = 8 + djupn
            la posisjon = lengde(native)
            legg_u32(native, 0x34000000 | register)
            legg_til(grein_patchar, [posisjon, instr[1], "cbz", register])
        } ellers hvis op == "RETURN" {
            hvis djupn != 1 eller i != lengde(kode) - 1 {
                returner {"ok": "usann", "error": "macOS AOT RETURN krev éin stakkverdi og må vere sist", "image": []}
            }
            la resultat = 8 + djupn - 1
            legg_u32(native, 0x2A0003E0 | (resultat << 16)) // mov w0, wN
            legg_u32(native, 0xD65F03C0) // ret
            ferdig = sann
        } ellers hvis op == "CALL" {
            // Fase 1: berre `skriv`/`print` av eit heiltal er ein ekte runtime-
            // operasjon. Andre kall blir framleis avviste (Fase 5 gir ekte kall).
            la kallnamn = tekst(instr[1])
            hvis (kallnamn == "skriv" eller kallnamn == "builtin.skriv" eller kallnamn == "print" eller kallnamn == "builtin.print") og lengde(instr) == 3 og instr[2] == 1 {
                hvis djupn < 1 { returner {"ok": "usann", "error": "macOS AOT skriv krev éin stakkverdi", "image": []} }
                la arg = 8 + djupn - 1
                emit_skriv_int(native, arg, os)
                // skriv forbruker argumentet og legg att nil→0 på same slot;
                // djupn er difor uendra (etterfølgjande POP balanserer statementet).
            } ellers {
                returner {"ok": "usann", "error": "macOS AOT støttar ikkje kall: " + kallnamn, "image": []}
            }
        } ellers {
            returner {"ok": "usann", "error": "macOS AOT støttar ikkje opcode: " + op, "image": []}
        }
        i = i + 1
    }
    hvis ikkje ferdig { returner {"ok": "usann", "error": "macOS AOT-program manglar RETURN", "image": []} }
    la p = 0
    mens p < lengde(grein_patchar) {
        la patch = grein_patchar[p]
        la mål = etikettar[patch[1]]
        hvis mål == null { returner {"ok": "usann", "error": "macOS AOT manglar etikett: " + patch[1], "image": []} }
        la ord_delta = (mål - patch[0]) / 4
        hvis patch[2] == "b" {
            hvis ord_delta < -33554432 eller ord_delta > 33554431 { returner {"ok": "usann", "error": "macOS AOT JUMP utanfor rekkevidde", "image": []} }
            skriv_u32(native, patch[0], 0x14000000 | (ord_delta & 0x03FFFFFF))
        } ellers {
            hvis ord_delta < -262144 eller ord_delta > 262143 { returner {"ok": "usann", "error": "macOS AOT JUMP_IF_FALSE utanfor rekkevidde", "image": []} }
            skriv_u32(native, patch[0], 0x34000000 | ((ord_delta & 0x7FFFF) << 5) | patch[3])
        }
        p = p + 1
    }
    returner {"ok": "sann", "error": "", "image": native}
}

funksjon kompiler_instruksjoner(kode) -> ordbok_tekst {
    la kontroll = kompiler_arm64(kode, "macos")
    hvis kontroll["ok"] != "sann" {
        returner {"ok": "usann", "error": kontroll["error"], "format": "Mach-O arm64", "image": []}
    }
    returner {
        "ok": "sann",
        "error": "",
        "format": "Mach-O arm64",
        "image": macho.bygg_program(kontroll["image"])
    }
}

// Fyrste funksjons-AOT brukar statisk inlining. Det fjernar VM-kallet heilt,
// held argument/retursemantikken og gir resten av kodegeneratoren eitt samla
// kontrollflytgraf. Rekursjon og tidlege returar blir avviste eksplisitt.
funksjon inline_kall(kode, funksjonar, prefiks: tekst, behald_return: boolsk, djupn: heiltall) -> ordbok_tekst {
    hvis djupn > 16 { returner {"ok": "usann", "error": "macOS AOT funksjonskall er for djupt eller rekursivt", "code": []} }
    hvis builtin.type(kode) != "liste" { returner {"ok": "usann", "error": "macOS AOT funksjon manglar kode", "code": []} }
    la ut = []
    la retur_namn = prefiks + "__returverdi"
    la retur_etikett = prefiks + "__returslutt"
    la har_inline_return = usann
    la i = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        la op = opcode(instr)
        hvis op == "CALL" {
            hvis lengde(instr) != 3 eller builtin.type(instr[1]) != "tekst" eller builtin.type(instr[2]) != "heltall" {
                returner {"ok": "usann", "error": "macOS AOT CALL har ugyldig format", "code": []}
            }
            la kallnamn = tekst(instr[1])
            hvis er_ncval_builtin(kallnamn) {
                // Runtime-builtins (ikkje inline-funksjonar). Slepp gjennom til
                // kompiler_arm64_ncval; NcVal-maskina emitterer dei direkte.
                // (Merk: committed stage0 gjev funksjonar[absent]≠null, så ei
                // liste her er tryggare enn eit null-oppslag.)
                legg_til(ut, instr)
            } ellers {
                la mål = funksjonar[instr[1]]
                hvis mål == null { returner {"ok": "usann", "error": "macOS AOT støttar ikkje eksternt kall: " + instr[1], "code": []} }
                la params = mål["params"]
                hvis params == null { params = [] }
                hvis instr[2] != lengde(params) { returner {"ok": "usann", "error": "macOS AOT argumenttal stemmer ikkje for " + instr[1], "code": []} }
                la barneprefiks = prefiks + "k" + tekst_fra_heiltall(i) + "_"
                la p = lengde(params) - 1
                mens p >= 0 {
                    legg_til(ut, ["STORE_NAME", barneprefiks + params[p]])
                    p = p - 1
                }
                la kropp = mål["code"]
                hvis lengde(kropp) == 0 eller opcode(kropp[lengde(kropp) - 1]) != "RETURN" {
                    returner {"ok": "usann", "error": "macOS AOT inline-funksjon må ende med RETURN: " + instr[1], "code": []}
                }
                la utvida = inline_kall(kropp, funksjonar, barneprefiks, usann, djupn + 1)
                hvis utvida["ok"] != "sann" { returner utvida }
                la j = 0
                mens j < lengde(utvida["code"]) { legg_til(ut, utvida["code"][j]) j = j + 1 }
            }
        } ellers hvis op == "RETURN" {
            hvis behald_return {
                hvis i != lengde(kode) - 1 { returner {"ok": "usann", "error": "macOS AOT entry støttar ikkje tidleg RETURN", "code": []} }
                legg_til(ut, instr)
            } ellers {
                legg_til(ut, ["STORE_NAME", retur_namn])
                har_inline_return = sann
                hvis i != lengde(kode) - 1 { legg_til(ut, ["JUMP", retur_etikett]) }
            }
        } ellers hvis op == "LOAD_NAME" eller op == "STORE_NAME" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "macOS AOT ugyldig lokalnamn", "code": []}
            }
            legg_til(ut, [op, prefiks + instr[1]])
        } ellers hvis op == "LABEL" eller op == "JUMP" eller op == "JUMP_IF_FALSE" {
            hvis lengde(instr) != 2 eller builtin.type(instr[1]) != "tekst" {
                returner {"ok": "usann", "error": "macOS AOT ugyldig etikettnamn", "code": []}
            }
            legg_til(ut, [op, prefiks + instr[1]])
        } ellers {
            legg_til(ut, instr)
        }
        i = i + 1
    }
    hvis ikkje behald_return og har_inline_return {
        legg_til(ut, ["LABEL", retur_etikett])
        legg_til(ut, ["LOAD_NAME", retur_namn])
    }
    returner {"ok": "sann", "error": "", "code": ut}
}

// Konstante liste-/tekstoperasjonar kan foldast før den smale arm64-emitteren.
// Det held AOT-binæren fri for ein skjult VM-runtime, men gjer vanlege
// lengde/contains-kall på compile-time-konstantar reelle native operasjonar.
funksjon fold_konstant_runtime(kode) {
    hvis builtin.type(kode) != "liste" { returner kode }
    la ut = []
    la stakk = []
    la kjend_type = {}
    la kjend_verdi = {}
    la i: heiltall = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        la op = opcode(instr)
        hvis op == "PUSH_CONST" {
            hvis builtin.type(instr[1]) == "tekst" {
                // Placeholderen er berre registerinnhald; strengverdien blir
                // halden i den abstrakte stakken for vidare constant folding.
                legg_til(ut, ["PUSH_CONST", 0])
                legg_til(stakk, {"type": "tekst", "verdi": instr[1]})
            } ellers {
                legg_til(ut, instr)
                legg_til(stakk, {"type": "tal", "verdi": instr[1]})
            }
        } ellers hvis op == "BUILD_LIST" {
            la antal = heiltall(instr[1])
            la element = []
            la kan_bevare = sann
            la j: heiltall = 0
            mens j < antal og lengde(stakk) > 0 {
                la topp = fjern_siste(stakk)
                legg_til(element, topp)
                hvis topp["type"] == "ukjent" { kan_bevare = usann }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                j = j + 1
            }
            la i_element = lengde(element) - 1
            la liste_verdi = []
            mens i_element >= 0 {
                legg_til(liste_verdi, element[i_element]["verdi"])
                i_element = i_element - 1
            }
            legg_til(ut, ["PUSH_CONST", antal])
            hvis kan_bevare og lengde(element) == antal {
                legg_til(stakk, {"type": "liste", "verdi": liste_verdi})
            } ellers {
                legg_til(stakk, {"type": "liste_lengd", "verdi": antal})
            }
        } ellers hvis op == "BUILD_MAP" {
            la antal_par = heiltall(instr[1])
            la element = []
            la kan_bevare = sann
            la j_map: heiltall = 0
            mens j_map < antal_par * 2 og lengde(stakk) > 0 {
                la topp_map = fjern_siste(stakk)
                legg_til(element, topp_map)
                hvis topp_map["type"] == "ukjent" { kan_bevare = usann }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                j_map = j_map + 1
            }
            la kart_verdi = {}
            la par: heiltall = 0
            mens par < antal_par {
                la key_pos = antal_par * 2 - 1 - par * 2
                la val_pos = key_pos - 1
                hvis key_pos >= 0 og val_pos >= 0 og key_pos < lengde(element) og val_pos < lengde(element) {
                    kart_verdi[element[key_pos]["verdi"]] = element[val_pos]["verdi"]
                }
                par = par + 1
            }
            legg_til(ut, ["PUSH_CONST", 0])
            hvis kan_bevare og lengde(element) == antal_par * 2 {
                legg_til(stakk, {"type": "kart", "verdi": kart_verdi})
            } ellers {
                legg_til(stakk, {"type": "ukjent", "verdi": null})
            }
        } ellers hvis op == "STORE_NAME" {
            la verdi = null
            hvis lengde(stakk) > 0 { verdi = fjern_siste(stakk) }
            legg_til(ut, instr)
            hvis verdi != null {
                kjend_type[instr[1]] = verdi["type"]
                kjend_verdi[instr[1]] = verdi["verdi"]
            }
        } ellers hvis op == "LOAD_NAME" {
            legg_til(ut, instr)
            hvis kjend_type[instr[1]] != null {
                legg_til(stakk, {"type": kjend_type[instr[1]], "verdi": kjend_verdi[instr[1]]})
            } ellers {
                legg_til(stakk, {"type": "ukjent", "verdi": null})
            }
        } ellers hvis op == "INDEX_GET" {
            la indeks = null
            la behaldar = null
            hvis lengde(stakk) > 0 { indeks = fjern_siste(stakk) }
            hvis lengde(stakk) > 0 { behaldar = fjern_siste(stakk) }
            la kan_liste = behaldar != null og indeks != null og behaldar["type"] == "liste" og indeks["type"] == "tal" og
                indeks["verdi"] >= 0 og indeks["verdi"] < lengde(behaldar["verdi"])
            la kan_kart = behaldar != null og indeks != null og behaldar["type"] == "kart" og indeks["type"] == "tekst" og
                finnes_nøkkel(behaldar["verdi"], indeks["verdi"])
            hvis kan_liste eller kan_kart {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = null
                hvis kan_liste { verdi = behaldar["verdi"][indeks["verdi"]] }
                ellers { verdi = behaldar["verdi"][indeks["verdi"]] }
                hvis builtin.type(verdi) == "tekst" {
                    legg_til(ut, ["PUSH_CONST", 0])
                    legg_til(stakk, {"type": "tekst", "verdi": verdi})
                } ellers {
                    legg_til(ut, ["PUSH_CONST", verdi])
                    legg_til(stakk, {"type": "tal", "verdi": verdi})
                }
            } ellers {
                legg_til(ut, instr)
                legg_til(stakk, {"type": "ukjent", "verdi": null})
            }
        } ellers hvis op == "CALL" {
            la nargs = heiltall(instr[2])
            la argument = []
            la j2: heiltall = 0
            mens j2 < nargs og lengde(stakk) > 0 {
                legg_til(argument, fjern_siste(stakk))
                j2 = j2 + 1
            }
            la namn = tekst(instr[1])
            hvis (namn == "builtin.lengde" eller namn == "lengde") og lengde(argument) == 1 og
               (argument[0]["type"] == "liste_lengd" eller argument[0]["type"] == "liste" eller argument[0]["type"] == "tekst") {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la lengd = 0
                hvis argument[0]["type"] == "liste_lengd" { lengd = argument[0]["verdi"] }
                ellers hvis argument[0]["type"] == "liste" { lengd = lengde(argument[0]["verdi"]) }
                ellers { lengd = lengde(argument[0]["verdi"]) }
                legg_til(ut, ["PUSH_CONST", lengd])
                legg_til(stakk, {"type": "tal", "verdi": lengd})
            } ellers hvis (namn == "builtin.lower" eller namn == "lower") og lengde(argument) == 1 og argument[0]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = builtin.lower(argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", 0])
                legg_til(stakk, {"type": "tekst", "verdi": verdi})
            } ellers hvis (namn == "builtin.upper" eller namn == "upper") og lengde(argument) == 1 og argument[0]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = builtin.upper(argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", 0])
                legg_til(stakk, {"type": "tekst", "verdi": verdi})
            } ellers hvis (namn == "builtin.trim" eller namn == "trim") og lengde(argument) == 1 og argument[0]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = builtin.trim(argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", 0])
                legg_til(stakk, {"type": "tekst", "verdi": verdi})
            } ellers hvis (namn == "builtin.replace" eller namn == "replace") og lengde(argument) == 3 og
                       argument[0]["type"] == "tekst" og argument[1]["type"] == "tekst" og argument[2]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = builtin.replace(argument[2]["verdi"], argument[1]["verdi"], argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", 0])
                legg_til(stakk, {"type": "tekst", "verdi": verdi})
            } ellers hvis (namn == "builtin.slice" eller namn == "slice") og lengde(argument) == 3 og
                       argument[0]["type"] == "tal" og argument[1]["type"] == "tal" og argument[2]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = builtin.slice(argument[2]["verdi"], argument[1]["verdi"], argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", 0])
                legg_til(stakk, {"type": "tekst", "verdi": verdi})
            } ellers hvis (namn == "builtin.char_code" eller namn == "char_code") og lengde(argument) == 1 og argument[0]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la verdi = builtin.char_code(argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", verdi])
                legg_til(stakk, {"type": "tal", "verdi": verdi})
            } ellers hvis (namn == "builtin.finnes_nøkkel" eller namn == "finnes_nøkkel" eller namn == "builtin.har_nokkel" eller namn == "har_nokkel") og lengde(argument) == 2 og
                       argument[0]["type"] == "tekst" og argument[1]["type"] == "kart" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la funnen = finnes_nøkkel(argument[1]["verdi"], argument[0]["verdi"])
                hvis funnen { legg_til(ut, ["PUSH_CONST", 1]) } ellers { legg_til(ut, ["PUSH_CONST", 0]) }
                legg_til(stakk, {"type": "tal", "verdi": funnen})
            } ellers hvis (namn == "builtin.contains" eller namn == "contains") og lengde(argument) == 2 og
                       argument[0]["type"] == "tekst" og argument[1]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la funnen = builtin.index_of(argument[1]["verdi"], argument[0]["verdi"]) >= 0
                hvis funnen { legg_til(ut, ["PUSH_CONST", 1]) } ellers { legg_til(ut, ["PUSH_CONST", 0]) }
                legg_til(stakk, {"type": "tal", "verdi": funnen})
            } ellers hvis (namn == "builtin.starts_with" eller namn == "starts_with") og lengde(argument) == 2 og
                       argument[0]["type"] == "tekst" og argument[1]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la funnen = builtin.starts_with(argument[1]["verdi"], argument[0]["verdi"])
                hvis funnen { legg_til(ut, ["PUSH_CONST", 1]) } ellers { legg_til(ut, ["PUSH_CONST", 0]) }
                legg_til(stakk, {"type": "tal", "verdi": funnen})
            } ellers hvis (namn == "builtin.ends_with" eller namn == "ends_with") og lengde(argument) == 2 og
                       argument[0]["type"] == "tekst" og argument[1]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la funnen = builtin.ends_with(argument[1]["verdi"], argument[0]["verdi"])
                hvis funnen { legg_til(ut, ["PUSH_CONST", 1]) } ellers { legg_til(ut, ["PUSH_CONST", 0]) }
                legg_til(stakk, {"type": "tal", "verdi": funnen})
            } ellers hvis (namn == "builtin.index_of" eller namn == "index_of") og lengde(argument) == 2 og
                       argument[0]["type"] == "tekst" og argument[1]["type"] == "tekst" {
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                hvis lengde(ut) > 0 { fjern_siste(ut) }
                la posisjon = builtin.index_of(argument[1]["verdi"], argument[0]["verdi"])
                legg_til(ut, ["PUSH_CONST", posisjon])
                legg_til(stakk, {"type": "tal", "verdi": posisjon})
            } ellers {
                legg_til(ut, instr)
                legg_til(stakk, {"type": "ukjent", "verdi": null})
            }
        } ellers {
            legg_til(ut, instr)
            hvis op == "POP" eller op == "JUMP_IF_FALSE" eller op == "RETURN" {
                hvis lengde(stakk) > 0 { fjern_siste(stakk) }
            } ellers hvis op == "BINARY_ADD" eller op == "ADD" eller op == "BINARY_SUB" eller op == "SUB" eller
                      op == "BINARY_MUL" eller op == "MUL" eller op == "BINARY_DIV" eller op == "DIV" eller
                      op == "BINARY_MOD" eller op == "BINARY_AND" eller op == "BINARY_OR" eller op == "BINARY_XOR" {
                hvis lengde(stakk) > 0 { fjern_siste(stakk) }
                hvis lengde(stakk) > 0 { fjern_siste(stakk) }
                legg_til(stakk, {"type": "tal", "verdi": null})
            }
        }
        i = i + 1
    }
    returner ut
}

funksjon kompiler_ncb(ncb, output: tekst) -> ordbok_tekst {
    la entry = ncb["entry"]
    la funksjonar = ncb["functions"]
    hvis entry == null eller funksjonar == null eller funksjonar[entry] == null {
        returner {"ok": "usann", "error": "NCB manglar gyldig entry", "format": "Mach-O arm64", "image": []}
    }
    la folda = fold_konstant_runtime(funksjonar[entry]["code"])
    la utvida = inline_kall(folda, funksjonar, "entry_", sann, 0)
    hvis utvida["ok"] != "sann" {
        returner {"ok": "usann", "error": utvida["error"], "format": "Mach-O arm64", "image": []}
    }
    la resultat = kompiler_instruksjoner(utvida["code"])
    hvis resultat["ok"] != "sann" { returner resultat }
    builtin.fil_skriv_binær(output, resultat["image"])
    resultat["output"] = output
    returner resultat
}

// Fase 2: NCB → Mach-O via den fulle NcVal-stakk-VM-en. Same fold/inline-front
// som kompiler_ncb, men kompilerer over heap-NcVal i staden for rå register.
// Fase 5: kompiler heile programmet (entry + alle nåbare brukarfunksjonar) til
// éin kode-image med ekte bl-kall. Ingen inline_kall, ingen fold. Rekursjon
// fungerer. Deld av macOS- og Linux-driverane. Returnerer rå AArch64-kode.
funksjon ncval_compile_program(ncb, os) -> ordbok_tekst {
    la entry = ncb["entry"]
    la funksjonar = ncb["functions"]
    hvis entry == null eller funksjonar == null eller funksjonar[entry] == null {
        returner {"ok": "usann", "error": "NCB manglar gyldig entry", "image": []}
    }
    la initializers = ncb["module_initializers"]
    hvis initializers == null { initializers = [] }
    la order = ncval_reachable(entry, funksjonar, initializers)
    // Fase 8: forhandsskann alle nåbare funksjonar for LOAD/STORE_GLOBAL-namn og
    // tildel kvar global ein fast slot (delt på tvers av funksjonar → x25-base).
    la globals = {}
    la gcount = 0
    la brukar_try = usann
    la brukar_env = usann
    la gf = 0
    mens gf < lengde(order) {
        la gcode = funksjonar[order[gf]]["code"]
        la gi = 0
        mens gi < lengde(gcode) {
            la gop = opcode(gcode[gi])
            hvis (gop == "LOAD_GLOBAL" eller gop == "STORE_GLOBAL") og lengde(gcode[gi]) == 2 og builtin.type(gcode[gi][1]) == "tekst" {
                hvis ikkje finnes_nøkkel(globals, gcode[gi][1]) {
                    globals[gcode[gi][1]] = gcount
                    gcount = gcount + 1
                }
            }
            hvis gop == "TRY_BEGIN" { brukar_try = sann }
            hvis gop == "CALL" og lengde(gcode[gi]) == 3 og (gcode[gi][1] == "miljo_sett" eller gcode[gi][1] == "builtin.miljo_sett") { brukar_env = sann }
            // feil()-builtinen og NATIV-GAP-stubbane kastar via same handler-
            // maskineri som THROW; sørg for at __exc-globalane finst.
            hvis gop == "CALL" og lengde(gcode[gi]) == 3 og builtin.type(gcode[gi][1]) == "tekst" {
                la gapnamn = tekst(gcode[gi][1])
                hvis gapnamn == "feil" eller gapnamn == "builtin.feil" eller ncval_gap_stub(gapnamn) {
                    brukar_try = sann
                }
            }
            gi = gi + 1
        }
        gf = gf + 1
    }
    // Modul-globalar aksessert via LOAD_NAME (fri variabel): kompilatoren kan emittere
    // NAME-opcode i staden for GLOBAL for ein modul-global (t.d. `vm_active_functions`
    // i selfhost.vm — STORE_NAME i vm_sett_kontekst, LOAD_NAME i køyr_med_kontekst).
    // Identifiser: eit namn som blir LOAD_NAME'a i ein funksjon UTAN å vere param eller
    // STORE_NAME'a der = fri variabel = modul-global. Registrer det som global (eigen
    // x25-slot) så LOAD_NAME/STORE_NAME kan rute til global-lageret i staden for å
    // feile med «ukjend lokal variabel» / skrive til feil (per-funksjon) lokal-slot.
    // NC_FREEVAR_SCAN=0 hoppar over (treg i tolka bootstrap; sjå ncval_plan).
    hvis miljo_hent("NC_FREEVAR_SCAN") != "0" {
    la fg = 0
    mens fg < lengde(order) {
        la fgcode = funksjonar[order[fg]]["code"]
        la fgparams = funksjonar[order[fg]]["params"]
        hvis fgparams == null { fgparams = [] }
        la fglokale = {}
        la fgp = 0
        mens fgp < lengde(fgparams) { fglokale[tekst(fgparams[fgp])] = 1  fgp = fgp + 1 }
        // Éin samle-pass (STORE→lokale, LOAD→unike frie); dedup gjer at den dyre
        // finnes_nøkkel-sjekken berre køyrer per UNIKT lasta namn (yting).
        la fgfri = {}
        la fgs = 0
        mens fgs < lengde(fgcode) {
            la fgop = opcode(fgcode[fgs])
            hvis fgop == "STORE_NAME" og lengde(fgcode[fgs]) == 2 og builtin.type(fgcode[fgs][1]) == "tekst" {
                fglokale[tekst(fgcode[fgs][1])] = 1
            } ellers hvis fgop == "LOAD_NAME" og lengde(fgcode[fgs]) == 2 og builtin.type(fgcode[fgs][1]) == "tekst" {
                fgfri[tekst(fgcode[fgs][1])] = 1
            }
            fgs = fgs + 1
        }
        la fgnavn = nøkler(fgfri)
        la fgi = 0
        mens fgi < lengde(fgnavn) {
            la fgnm = tekst(fgnavn[fgi])
            hvis ikkje finnes_nøkkel(fglokale, fgnm) og fgnm != "null" og fgnm != "ingenting" og fgnm != "sann" og fgnm != "usann" og fgnm != "true" og fgnm != "false" {
                hvis ikkje finnes_nøkkel(globals, fgnm) {
                    globals[fgnm] = gcount
                    gcount = gcount + 1
                }
            }
            fgi = fgi + 1
        }
        fg = fg + 1
    }
    }
    // Fase 8: skjulte globalar for unnataks-tilstand (handler-topp + gjeldande verdi).
    hvis brukar_try {
        globals["__exc_top__"] = gcount
        globals["__exc_val__"] = gcount + 1
        gcount = gcount + 2
    }
    // Miljø-overlay: skjult global for miljo_sett/miljo_hent (in-heap kart).
    hvis brukar_env {
        globals["__env_overlay__"] = gcount
        gcount = gcount + 1
    }
    la image: liste_heiltall = []
    la fn_start = {}
    la all_patchar = []
    la fi = 0
    mens fi < lengde(order) {
        la fname = order[fi]
        la mål = funksjonar[fname]
        la params = mål["params"]
        hvis params == null { params = [] }
        la bl_patchar = []
        // Prøv rask reg-modus (x19–x24, byte-identisk med før). Sprekk operand-
        // stakken (>6), rekompiler funksjonen i mem-modus der operandane bur i
        // minne-heimar etter lokalvariablane (operand-spilling).
        la res = kompiler_arm64_ncval(mål["code"], os, funksjonar, params, fname == entry, bl_patchar, globals, initializers, usann)
        hvis res["ok"] != "sann" og finnes_nøkkel(res, "overflow") og res["overflow"] == "sann" {
            bl_patchar = []
            res = kompiler_arm64_ncval(mål["code"], os, funksjonar, params, fname == entry, bl_patchar, globals, initializers, sann)
        }
        hvis res["ok"] != "sann" { returner {"ok": "usann", "error": "[" + fname + "] " + tekst(res["error"]), "image": []} }
        la frag = res["image"]
        la base = lengde(image)
        fn_start[fname] = base
        la j = 0
        mens j < lengde(frag) { legg_til(image, frag[j]) j = j + 1 }
        la pj = 0
        mens pj < lengde(bl_patchar) {
            legg_til(all_patchar, [base + bl_patchar[pj][0], bl_patchar[pj][1]])
            pj = pj + 1
        }
        fi = fi + 1
    }
    // Append dei rekursive JSON-rutinane berre om dei vert kalla (bl-mål).
    la treng_str = usann
    la treng_parse = usann
    la pj0 = 0
    mens pj0 < lengde(all_patchar) {
        hvis all_patchar[pj0][1] == "__json_stringify" { treng_str = sann }
        hvis all_patchar[pj0][1] == "__json_parse" { treng_parse = sann }
        pj0 = pj0 + 1
    }
    hvis treng_str {
        la rut = emit_json_stringify_routine(os)
        fn_start["__json_stringify"] = lengde(image)
        la jr = 0
        mens jr < lengde(rut) { legg_til(image, rut[jr]) jr = jr + 1 }
    }
    hvis treng_parse {
        la rutp = emit_json_parse_routine()
        fn_start["__json_parse"] = lengde(image)
        la jp = 0
        mens jp < lengde(rutp) { legg_til(image, rutp[jp]) jp = jp + 1 }
    }
    la treng_split = usann
    la ps0 = 0
    mens ps0 < lengde(all_patchar) {
        hvis all_patchar[ps0][1] == "__split" { treng_split = sann }
        ps0 = ps0 + 1
    }
    hvis treng_split {
        la ruts = emit_split_routine()
        fn_start["__split"] = lengde(image)
        la sp2 = 0
        mens sp2 < lengde(ruts) { legg_til(image, ruts[sp2]) sp2 = sp2 + 1 }
    }
    la treng_join = usann
    la pjn0 = 0
    mens pjn0 < lengde(all_patchar) {
        hvis all_patchar[pjn0][1] == "__join" { treng_join = sann }
        pjn0 = pjn0 + 1
    }
    hvis treng_join {
        la rutj = emit_join_routine()
        fn_start["__join"] = lengde(image)
        la jn2 = 0
        mens jn2 < lengde(rutj) { legg_til(image, rutj[jn2]) jn2 = jn2 + 1 }
    }
    la treng_env_set = usann
    la treng_env_get = usann
    la pev = 0
    mens pev < lengde(all_patchar) {
        hvis all_patchar[pev][1] == "__env_set" { treng_env_set = sann }
        hvis all_patchar[pev][1] == "__env_get" { treng_env_get = sann }
        pev = pev + 1
    }
    hvis treng_env_set {
        la rutes = emit_env_set_routine()
        fn_start["__env_set"] = lengde(image)
        la es2 = 0
        mens es2 < lengde(rutes) { legg_til(image, rutes[es2]) es2 = es2 + 1 }
    }
    hvis treng_env_get {
        la ruteg = emit_env_get_routine()
        fn_start["__env_get"] = lengde(image)
        la eg2 = 0
        mens eg2 < lengde(ruteg) { legg_til(image, ruteg[eg2]) eg2 = eg2 + 1 }
    }
    la treng_assert = usann
    la treng_assert_eq = usann
    la pas = 0
    mens pas < lengde(all_patchar) {
        hvis all_patchar[pas][1] == "__assert" { treng_assert = sann }
        hvis all_patchar[pas][1] == "__assert_eq" { treng_assert_eq = sann }
        pas = pas + 1
    }
    hvis treng_assert {
        la ruta = emit_assert_routine(os)
        fn_start["__assert"] = lengde(image)
        la as2 = 0
        mens as2 < lengde(ruta) { legg_til(image, ruta[as2]) as2 = as2 + 1 }
    }
    hvis treng_assert_eq {
        la rutae = emit_assert_eq_routine(os)
        fn_start["__assert_eq"] = lengde(image)
        la ae2 = 0
        mens ae2 < lengde(rutae) { legg_til(image, rutae[ae2]) ae2 = ae2 + 1 }
    }
    la pk = 0
    mens pk < lengde(all_patchar) {
        la pos = all_patchar[pk][0]
        la target = all_patchar[pk][1]
        hvis ikkje finnes_nøkkel(fn_start, target) {
            returner {"ok": "usann", "error": "NcVal ukjend kallmål: " + target, "image": []}
        }
        la delta = (fn_start[target] - pos) / 4
        skriv_u32(image, pos, 0x94000000 | (delta & 0x03FFFFFF))
        pk = pk + 1
    }
    returner {"ok": "sann", "error": "", "image": image}
}

funksjon kompiler_ncb_ncval(ncb, output: tekst, os: tekst) -> ordbok_tekst {
    la res = ncval_compile_program(ncb, os)
    hvis res["ok"] != "sann" {
        returner {"ok": "usann", "error": res["error"], "format": "Mach-O arm64", "image": []}
    }
    la image = macho.bygg_program(res["image"])
    builtin.fil_skriv_binær(output, image)
    returner {"ok": "sann", "error": "", "format": "Mach-O arm64", "image": image, "output": output}
}

// ─── BATCH-CODEGEN: kompiler-i-batchar + lenk-til-slutt ─────────────────────
// ncval_compile_program held HEILE programmet i minne i eitt kall — for full
// nc_main (966 fns) toppar det ~11 GB sjølv under vm.no sin GC (arbeidssettet
// veks med funksjonstalet). Løysinga: éin plan-passering fastset deterministisk
// `order` + globals-slots; kvar batch kompilerer eit disjunkt utsnitt i ein
// EIGEN prosess (run-ncb-pure → GC + prosess-isolasjon frigjer minnet per
// batch); linkaren set saman fragmenta, emitterer delte runtime-rutinar éin
// gong, og resolverer bl-patchane. Toppminnet = éin batch (~få hundre MB) i
// staden for heile programmet.

// Plan: deterministisk order + globals + flagg. Serialiserbar (namn/heiltal).
funksjon ncval_plan(ncb) -> ordbok_tekst {
    la entry = ncb["entry"]
    la funksjonar = ncb["functions"]
    hvis entry == null eller funksjonar == null eller funksjonar[entry] == null {
        returner {"ok": "usann", "error": "NCB manglar gyldig entry"}
    }
    la initializers = ncb["module_initializers"]
    hvis initializers == null { initializers = [] }
    la order = ncval_reachable(entry, funksjonar, initializers)
    la globals = {}
    la gcount = 0
    la brukar_try = usann
    la brukar_env = usann
    la gf = 0
    mens gf < lengde(order) {
        la gcode = funksjonar[order[gf]]["code"]
        la gi = 0
        mens gi < lengde(gcode) {
            la gop = opcode(gcode[gi])
            hvis (gop == "LOAD_GLOBAL" eller gop == "STORE_GLOBAL") og lengde(gcode[gi]) == 2 og builtin.type(gcode[gi][1]) == "tekst" {
                hvis ikkje finnes_nøkkel(globals, gcode[gi][1]) {
                    globals[gcode[gi][1]] = gcount
                    gcount = gcount + 1
                }
            }
            hvis gop == "TRY_BEGIN" { brukar_try = sann }
            hvis gop == "CALL" og lengde(gcode[gi]) == 3 og (gcode[gi][1] == "miljo_sett" eller gcode[gi][1] == "builtin.miljo_sett") { brukar_env = sann }
            hvis gop == "CALL" og lengde(gcode[gi]) == 3 og builtin.type(gcode[gi][1]) == "tekst" {
                la gapnamn = tekst(gcode[gi][1])
                hvis gapnamn == "feil" eller gapnamn == "builtin.feil" eller ncval_gap_stub(gapnamn) {
                    brukar_try = sann
                }
            }
            gi = gi + 1
        }
        gf = gf + 1
    }
    // Modul-globalar aksessert via LOAD_NAME (fri variabel) — SAME skann som i
    // ncval_compile_program. MÅ vere her òg: batch-vegen (elf_batch_host) brukar
    // desse globals-slottane via ncval_compile_range, så utan skannen feilar
    // køyr_med_kontekst med «ukjend lokal variabel: vm_active_functions».
    // NC_FREEVAR_SCAN=0 hoppar over skannen (treg i tolka bootstrap-bygg der dict-
    // oppslag er O(n); då må NCB-en pre-transformerast så modul-globalar brukar
    // GLOBAL-opcode). Standard = på (native seed: rask, robust for AOT av vilkårlege
    // program som brukar modul-globalar via NAME-opcode).
    hvis miljo_hent("NC_FREEVAR_SCAN") != "0" {
    la pfg = 0
    mens pfg < lengde(order) {
        la pfgcode = funksjonar[order[pfg]]["code"]
        la pfgparams = funksjonar[order[pfg]]["params"]
        hvis pfgparams == null { pfgparams = [] }
        la pfglokale = {}
        la pfgp = 0
        mens pfgp < lengde(pfgparams) { pfglokale[tekst(pfgparams[pfgp])] = 1  pfgp = pfgp + 1 }
        // Éin samle-pass: STORE_NAME → lokale, LOAD_NAME → unike frie kandidatar.
        // (Dedup i pfgfri gjer at den dyre finnes_nøkkel-sjekken berre køyrer per
        // UNIKT lasta namn, ikkje per LOAD_NAME-førekomst — held plan-steget raskt.)
        la pfgfri = {}
        la pfgs = 0
        mens pfgs < lengde(pfgcode) {
            la pfgop = opcode(pfgcode[pfgs])
            hvis pfgop == "STORE_NAME" og lengde(pfgcode[pfgs]) == 2 og builtin.type(pfgcode[pfgs][1]) == "tekst" {
                pfglokale[tekst(pfgcode[pfgs][1])] = 1
            } ellers hvis pfgop == "LOAD_NAME" og lengde(pfgcode[pfgs]) == 2 og builtin.type(pfgcode[pfgs][1]) == "tekst" {
                pfgfri[tekst(pfgcode[pfgs][1])] = 1
            }
            pfgs = pfgs + 1
        }
        la pfgnavn = nøkler(pfgfri)
        la pfgi = 0
        mens pfgi < lengde(pfgnavn) {
            la pfgnm = tekst(pfgnavn[pfgi])
            hvis ikkje finnes_nøkkel(pfglokale, pfgnm) og pfgnm != "null" og pfgnm != "ingenting" og pfgnm != "sann" og pfgnm != "usann" og pfgnm != "true" og pfgnm != "false" {
                hvis ikkje finnes_nøkkel(globals, pfgnm) {
                    globals[pfgnm] = gcount
                    gcount = gcount + 1
                }
            }
            pfgi = pfgi + 1
        }
        pfg = pfg + 1
    }
    }
    hvis brukar_try {
        globals["__exc_top__"] = gcount
        globals["__exc_val__"] = gcount + 1
        gcount = gcount + 2
    }
    hvis brukar_env {
        globals["__env_overlay__"] = gcount
        gcount = gcount + 1
    }
    returner {"ok": "sann", "error": "", "order": order, "globals": globals}
}

// Kompiler utsnittet order[start .. start+count). Returnerer per-funksjon
// {name, words, patches} der patches = [[rel_off, target], ...] RELATIVE til
// fragmentstarten (linkaren gjer dei absolutte). globals/order kjem frå planen.
funksjon ncval_compile_range(ncb, os: tekst, order, globals, start: heiltall, count: heiltall) -> ordbok_tekst {
    la funksjonar = ncb["functions"]
    la entry = ncb["entry"]
    la initializers = ncb["module_initializers"]
    hvis initializers == null { initializers = [] }
    la frags = []
    la slutt = start + count
    hvis slutt > lengde(order) { slutt = lengde(order) }
    la fi = start
    mens fi < slutt {
        la fname = order[fi]
        la mål = funksjonar[fname]
        la params = mål["params"]
        hvis params == null { params = [] }
        la bl_patchar = []
        la res = kompiler_arm64_ncval(mål["code"], os, funksjonar, params, fname == entry, bl_patchar, globals, initializers, usann)
        hvis res["ok"] != "sann" og finnes_nøkkel(res, "overflow") og res["overflow"] == "sann" {
            bl_patchar = []
            res = kompiler_arm64_ncval(mål["code"], os, funksjonar, params, fname == entry, bl_patchar, globals, initializers, sann)
        }
        hvis res["ok"] != "sann" { returner {"ok": "usann", "error": "[" + fname + "] " + tekst(res["error"]), "frags": []} }
        legg_til(frags, {"name": fname, "words": res["image"], "patches": bl_patchar})
        fi = fi + 1
    }
    returner {"ok": "sann", "error": "", "frags": frags}
}

// Lenk: entries = alle {name, words, patches} i order-rekkjefølgje (frå alle
// batchane). Byggjer image, emitterer delte runtime-rutinar som er bl-referert,
// og resolverer alle bl-patchar. Held berre image (~få MB) — lett nok til å
// køyre i éin run-ncb-pure-prosess.
funksjon ncval_link(os: tekst, entries) -> ordbok_tekst {
    la image: liste_heiltall = []
    la fn_start = {}
    la all_patchar = []
    la ei = 0
    mens ei < lengde(entries) {
        la e = entries[ei]
        la words = e["words"]
        la base = lengde(image)
        fn_start[tekst(e["name"])] = base
        la j = 0
        mens j < lengde(words) { legg_til(image, words[j]) j = j + 1 }
        la pat = e["patches"]
        la pj = 0
        mens pj < lengde(pat) {
            legg_til(all_patchar, [base + pat[pj][0], tekst(pat[pj][1])])
            pj = pj + 1
        }
        ei = ei + 1
    }
    // Delte runtime-rutinar — emitter berre om bl-referert (identisk med
    // ncval_compile_program sin hale).
    la treng_str = usann
    la treng_parse = usann
    la treng_split = usann
    la treng_join = usann
    la treng_env_set = usann
    la treng_env_get = usann
    la treng_assert = usann
    la treng_assert_eq = usann
    la pj0 = 0
    mens pj0 < lengde(all_patchar) {
        la t = all_patchar[pj0][1]
        hvis t == "__json_stringify" { treng_str = sann }
        hvis t == "__json_parse" { treng_parse = sann }
        hvis t == "__split" { treng_split = sann }
        hvis t == "__join" { treng_join = sann }
        hvis t == "__env_set" { treng_env_set = sann }
        hvis t == "__env_get" { treng_env_get = sann }
        hvis t == "__assert" { treng_assert = sann }
        hvis t == "__assert_eq" { treng_assert_eq = sann }
        pj0 = pj0 + 1
    }
    hvis treng_str {
        la rut = emit_json_stringify_routine(os)
        fn_start["__json_stringify"] = lengde(image)
        la k = 0 mens k < lengde(rut) { legg_til(image, rut[k]) k = k + 1 }
    }
    hvis treng_parse {
        la rutp = emit_json_parse_routine()
        fn_start["__json_parse"] = lengde(image)
        la k = 0 mens k < lengde(rutp) { legg_til(image, rutp[k]) k = k + 1 }
    }
    hvis treng_split {
        la ruts = emit_split_routine()
        fn_start["__split"] = lengde(image)
        la k = 0 mens k < lengde(ruts) { legg_til(image, ruts[k]) k = k + 1 }
    }
    hvis treng_join {
        la rutj = emit_join_routine()
        fn_start["__join"] = lengde(image)
        la k = 0 mens k < lengde(rutj) { legg_til(image, rutj[k]) k = k + 1 }
    }
    hvis treng_env_set {
        la rutes = emit_env_set_routine()
        fn_start["__env_set"] = lengde(image)
        la k = 0 mens k < lengde(rutes) { legg_til(image, rutes[k]) k = k + 1 }
    }
    hvis treng_env_get {
        la ruteg = emit_env_get_routine()
        fn_start["__env_get"] = lengde(image)
        la k = 0 mens k < lengde(ruteg) { legg_til(image, ruteg[k]) k = k + 1 }
    }
    hvis treng_assert {
        la ruta = emit_assert_routine(os)
        fn_start["__assert"] = lengde(image)
        la k = 0 mens k < lengde(ruta) { legg_til(image, ruta[k]) k = k + 1 }
    }
    hvis treng_assert_eq {
        la rutae = emit_assert_eq_routine(os)
        fn_start["__assert_eq"] = lengde(image)
        la k = 0 mens k < lengde(rutae) { legg_til(image, rutae[k]) k = k + 1 }
    }
    la pk = 0
    mens pk < lengde(all_patchar) {
        la pos = all_patchar[pk][0]
        la target = all_patchar[pk][1]
        hvis ikkje finnes_nøkkel(fn_start, target) {
            returner {"ok": "usann", "error": "NcVal ukjend kallmål: " + target, "image": []}
        }
        la delta = (fn_start[target] - pos) / 4
        skriv_u32(image, pos, 0x94000000 | (delta & 0x03FFFFFF))
        pk = pk + 1
    }
    returner {"ok": "sann", "error": "", "image": image}
}

funksjon start() -> heiltall {
    la input = miljo_hent("NC_INPUT")
    la output = miljo_hent("NC_OUTPUT")
    hvis input == "" eller output == "" {
        skriv("macho_arm64_codegen: NC_INPUT og NC_OUTPUT er påkravde\n")
        returner 2
    }
    la ncb = builtin.json_parse_raw(builtin.fil_les(input))
    // Fase 4: standardvegen for macOS-arm64 er no den fulle NcVal-maskina (heap-
    // NcVal, strengar, lister, kart). Den runtime-lause registermaskina
    // (kompiler_ncb) blir berre halden for test_macho_arm64_codegen.
    la resultat = kompiler_ncb_ncval(ncb, output, "macos")
    hvis resultat["ok"] != "sann" { kast resultat["error"] }
    la mode = native_fs.native_sett_modus_sti(output, 493)
    hvis mode["status"] != "ok" {
        skriv("macho_arm64_codegen: filmodus-ABI er ikkje tilgjengeleg i denne stage0-generasjonen\n")
    }
    skriv("macho_arm64_codegen: Mach-O arm64 skrive til " + output + "\n")
    returner 0
}
