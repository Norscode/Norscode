// NCB -> statisk Linux arm64 ELF via den felles arm64-instruksjonsflata.

bruk selfhost.native_execution.macho_arm64_codegen som arm64
bruk selfhost.native_execution.elf_arm64_emitter som elf
// Filmodus via arm64.sett_utdata_kjorbar, ikkje std.runtime_filesystem (dreg inn std.sched
// og builtin.network_operation/random_hex → null-fallback i kryss-codegen-bunten, A1).

funksjon kompiler_ncb(ncb, output: tekst) -> ordbok_tekst {
    la entry = ncb["entry"]
    la funksjonar = ncb["functions"]
    hvis entry == null eller funksjonar == null eller funksjonar[entry] == null {
        returner {"ok": "usann", "error": "NCB manglar gyldig entry", "format": "ELF64 AArch64", "image": []}
    }
    // Fase 5: heile programmet (entry + nåbare brukarfunksjonar) med ekte bl-kall.
    la native = arm64.ncval_compile_program(ncb, "linux")
    // Den parsa NCB-en trengst ikkje lenger; slepp han før emisjonen så han ikkje er
    // ein del av det levande settet saman med biletet (1 GiB-heapen på x86-verten).
    ncb = null
    hvis native["ok"] != "sann" {
        returner {"ok": "usann", "error": native["error"], "format": "ELF64 AArch64", "image": []}
    }
    // Strøym biletet til fil (elf.skriv_program: same bytes som bygg_program, utan ein
    // samla hode‖kode-kopi i minnet). Den gamle vegen bygde eit heilt nytt ~13,6 MB-bilete
    // ved sida av native["image"] → dobbelt levande sett → GC-heap full (exit 199).
    la emit_ok = sann
    la emitfeil = ""
    prøv { elf.skriv_program(output, native["image"]) } fang (e) { emit_ok = usann  emitfeil = tekst(e) }
    hvis ikkje emit_ok {
        returner {"ok": "usann", "error": "ELF-emitter: " + emitfeil, "format": "ELF64 AArch64", "image": []}
    }
    // NC_NATIVE_SYMBOL_MAP=<fil>: «VA namn» per funksjon (profilering/gdb, som x86).
    // main ligg etter den 7-instruksjonars _start-stubben ved 0x401000.
    la symkart = miljo_hent("NC_NATIVE_SYMBOL_MAP")
    hvis symkart != "" og native["fn_start"] != null {
        la fs = native["fn_start"]
        la linjer: liste_tekst = []
        for namn i nøkler(fs) {
            legg_til(linjer, tekst(4198428 + fs[namn]) + " " + tekst(namn))
        }
        builtin.fil_skriv(symkart, builtin.join(linjer, "\n") + "\n")
    }
    returner {"ok": "sann", "error": "", "format": "ELF64 AArch64", "image": [], "output": output}
}

funksjon start() -> heiltall {
    la input = miljo_hent("NC_INPUT")
    la output = miljo_hent("NC_OUTPUT")
    hvis input == "" eller output == "" {
        skriv("elf_arm64_codegen: NC_INPUT og NC_OUTPUT er påkravde\n")
        returner 2
    }
    la resultat = kompiler_ncb(arm64.les_ncb_fil(input), output)
    // NC_BUILTIN_REPORT=1: skriv rapporten (heile gapet, sjå arm64.ncval_rapport_skriv);
    // exit 3 som x86 når noko er uløyst.
    hvis arm64.ncval_rapport_på() {
        la uløyste = arm64.ncval_rapport_skriv()
        hvis resultat["ok"] != "sann" eller uløyste > 0 {
            skriv("elf_arm64_codegen: FEIL " + tekst(resultat["error"]) + "\n")
            returner 3
        }
    }
    hvis resultat["ok"] != "sann" { kast resultat["error"] }
    la mode = arm64.sett_utdata_kjorbar(output)
    hvis mode["status"] != "ok" {
        skriv("elf_arm64_codegen: filmodus-ABI er ikkje tilgjengeleg i denne stage0-generasjonen\n")
    }
    skriv("elf_arm64_codegen: ELF64 AArch64 skrive til " + output + "\n")
    returner 0
}
