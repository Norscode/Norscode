// NCB -> statisk Linux arm64 ELF via den felles arm64-instruksjonsflata.

bruk selfhost.native_execution.macho_arm64_codegen som arm64
bruk selfhost.native_execution.elf_arm64_emitter som elf
// Filmodus via arm64.sett_utdata_kjorbar, ikkje std.runtime_filesystem (dreg inn std.sched
// og builtin.network_operation/random_hex → null-fallback i kryss-codegen-bunten, A1).

funksjon kompiler_ncb(ncb, output: tekst) -> ordbok_tekst {
    la entry = ncb["entry"]
    la funksjonar = ncb["functions"]
    hvis entry == null eller funksjonar == null eller funksjonar[entry] == null {
        returner {"ok": "usann", "error": "NCB manglar gyldig entry", "format": "ELF64 AArch64", "image": []}
    }
    // Fase 5: heile programmet (entry + nåbare brukarfunksjonar) med ekte bl-kall.
    la native = arm64.ncval_compile_program(ncb, "linux")
    hvis native["ok"] != "sann" {
        returner {"ok": "usann", "error": native["error"], "format": "ELF64 AArch64", "image": []}
    }
    la image = elf.bygg_program(native["image"])
    builtin.fil_skriv_binær(output, image)
    returner {"ok": "sann", "error": "", "format": "ELF64 AArch64", "image": image, "output": output}
}

funksjon start() -> heiltall {
    la input = miljo_hent("NC_INPUT")
    la output = miljo_hent("NC_OUTPUT")
    hvis input == "" eller output == "" {
        skriv("elf_arm64_codegen: NC_INPUT og NC_OUTPUT er påkravde\n")
        returner 2
    }
    la resultat = kompiler_ncb(arm64.les_ncb_fil(input), output)
    hvis resultat["ok"] != "sann" {
        // NC_BUILTIN_REPORT=1: rapporten er skriven (arm64.ncval_ukjende_kallmål); exit 3 som x86.
        hvis arm64.ncval_rapport_på() {
            skriv("elf_arm64_codegen: FEIL " + tekst(resultat["error"]) + "\n")
            returner 3
        }
        kast resultat["error"]
    }
    hvis arm64.ncval_rapport_på() { skriv("arm64-codegen: BUILTIN-RAPPORT uløyste=0\n") }
    la mode = arm64.sett_utdata_kjorbar(output)
    hvis mode["status"] != "ok" {
        skriv("elf_arm64_codegen: filmodus-ABI er ikkje tilgjengeleg i denne stage0-generasjonen\n")
    }
    skriv("elf_arm64_codegen: ELF64 AArch64 skrive til " + output + "\n")
    returner 0
}
