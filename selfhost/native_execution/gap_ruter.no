// selfhost/native_execution/gap_ruter.no
// Delt gap-rutetabell for dei native codegenane (F2.3 / X0.2, 2026-09-25).
//
// Flytta ordrett frå native_codegen_v2.gap_rute_v2; x86-output er byte-identisk
// (seed-SHA-porten). ARM64 (macho_arm64_codegen.ncval_gap_rute) tek same tabell i bruk
// i A0, slik at dei to codegenane ikkje driv frå kvarandre.
//
// Gap-ruting (speglar macho_arm64_codegen.ncval_gap_rute): builtin-namn som
// codegenen IKKJE har ei eiga runtime-rutine for, men som bundlaren
// har tvangs-inkludert ein rein-Norscode-impl for. Returner kandidat-nøklar;
// emit vel den fyrste som finst i fn_vas. Tom liste = inga ruting.
// Utan dette fall builtin.sha256 til siste-segment-matching og traff
// std.krypto.sha256 (som sjølv kallar builtin.sha256) → uendeleg sjølv-
// rekursjon → native stakk-overflow (signal 139).
funksjon gap_rute(fn_nm: tekst) -> liste {
    la n = fn_nm
    hvis builtin.starts_with(n, "builtin.") { n = builtin.slice(n, 8, lengde(n)) }
    la delar = builtin.split(n, ".")
    la kort = delar[lengde(delar) - 1]
    // BERRE type-trygg rute: sha256 tek tekst→tekst → rein bit-ops-impl
    // std.sha256.hash. sha256_bytes/hmac_sha256_bytes tek liste_heiltall, men
    // kallarane (nc_main modulcache) sender streng frå builtin.fil_les_binær
    // (RT_FIL_LES gjev streng) → dei må IKKJE rutast til hash_bytes (liste-
    // iterasjon på streng → krasj). Lat dei falle til null-fallbacken (gamal,
    // trygg åtferd). Ruta aktiverer seg berre når std.sha256.hash faktisk er i
    // bunten (nc_main via vm.no-importen); elles inert (t.d. stage-0-modulane).
    hvis kort == "sha256"     { returner ["std.sha256.hash"] }
    // 2026-09-06: reine erstatningar i std/native_gap.no (nc_main importerer modulen).
    // builtin.bytes_new blir no fanga av eige atom i emit_builtin_or_user_call; ruta
    // under står att for kvalifiserte *.bytes_new utan eksakt treff.
    hvis kort == "bytes_new"  { returner ["std.native_gap.bytes_new"] }
    // kompiler_fil_aktiv (bundler.no kjelde-modus): C-æra-vertsbuiltin. Rut til
    // stubben i native_gap (fail-closed: kastar «krev VM-i-VM / L5b-host») i staden
    // for null-fallback. Den baka kompilatoren skal IKKJE brukast her (maskerer kjelde).
    hvis kort == "kompiler_fil_aktiv" { returner ["std.native_gap.kompiler_fil_aktiv"] }
    // host_exec_ncb_json → selfhost.vm.host_exec_ncb_json_gap. C-æra-vertsbuiltin
    // utan rute: i kompilert nc_main vart kallet null-fallback (returnerte 0), so
    // `nc bygg-native` på fersk seed skreiv INGEN ELF men rapporterte rc=0.
    hvis kort == "host_exec_ncb_json" { returner ["selfhost.vm.host_exec_ncb_json_gap"] }
    // F3.6 (J5.3): host_exec_ncb(objekt | binær | JSON) → selfhost.vm.host_exec_ncb_gap.
    hvis kort == "host_exec_ncb" { returner ["selfhost.vm.host_exec_ncb_gap"] }
    // fil_sett_kjorbar(sti) → chmod 0755 via native_fs_chmod-syscallen (#90).
    // Var null-fallback: ELF-ar og seed-kopiar vart skrivne utan x-bit, og
    // ci_runtime_fileops/verify_seed_only kasta på fersk seed.
    hvis kort == "fil_sett_kjorbar" { returner ["std.native_gap.fil_sett_kjorbar_gap"] }
    hvis kort == "sett_inn"   { returner ["std.native_gap.sett_inn"] }
    hvis kort == "system_operation" { returner ["std.native_gap.system_operation"] }
    hvis kort == "process_operation" { returner ["std.native_gap.process_operation"] }
    hvis builtin.starts_with(kort, "socket_") { returner ["std.native_gap." + kort] }
    hvis kort == "network_operation" { returner ["std.native_gap.network_operation"] }
    // acme_sign(alg,pem,input) → JWS RS256-signering (RSA PKCS#1v1.5). C-æra-builtin;
    // utan rute vart JWS-signaturen tom → ACME new-account «status= body=».
    hvis kort == "acme_sign" { returner ["std.native_gap.acme_sign"] }
    // acme_verify: motstykket (RS256/ES256). Utan rute var kallet null-fallback på
    // fersk seed, so DNSSEC-/JWS-verifisering alltid feila (test_dns_zone_validation).
    hvis kort == "acme_verify" { returner ["std.native_gap.acme_verify"] }
    // jit_operation (norscode-jit-v1): C-seeden hadde JIT-en i verten; på fersk seed
    // var kallet null-fallback, so VM-en kompilerte aldri noko og jit.status() gav null.
    hvis kort == "jit_operation" { returner ["std.native_gap.jit_operation"] }
    hvis kort == "atomic_operation" { returner ["std.native_gap.atomic_operation"] }
    // tensor_operation (norscode-tensor-v1): eksplisitt rute (critic C11), so ein
    // *.tensor_operation i bunten ikkje kan kapre builtin-kallet via siste-segment-matching.
    // Ho kan heller ikkje kapre ein brukarfunksjon: eksakte ikkje-builtin-namn i fn_vas blir
    // emitterte FØR gap-ruta («Bundla brukarfunksjon … vinn ALLTID»). Finst ikkje målet i
    // bunten, fell kallet vidare til same siste-segment-/null-fallback som før.
    hvis kort == "tensor_operation" { returner ["std.native_gap.tensor_operation"] }
    // Native trådar (thread.*-primitiv): clone(2) + futex, GC-/VM-fri veg.
    hvis kort == "thread_spawn" { returner ["std.native_gap.thread_spawn"] }
    hvis kort == "thread_join" { returner ["std.native_gap.thread_join"] }
    hvis kort == "thread_sync" { returner ["std.native_gap.thread_sync"] }
    hvis kort == "thread_current_id" { returner ["std.native_gap.thread_current_id"] }
    hvis kort == "dns_lookup" { returner ["std.native_gap.dns_lookup"] }
    // sha256_bytes(liste_heiltall): fil_les_binær gjev no liste (fil_les_bin-atomet),
    // så rein std.sha256.hash_bytes er type-trygg (kommentaren over var frå streng-tida).
    // sha256_bytes(liste) → native SHA-256-atom via native_gap (var pure std.sha256.hash_bytes).
    // Andre kandidat (A1): buntar utan std.native_gap (kryss-codegen for arm64:
    // macho_arm64_emitter.hash_bytes_rask for Mach-O-kodesignaturen) fekk null-fallback,
    // altså ein tom hash utan unnatak. Rein std.sha256.hash_bytes gjev same hex.
    // nc_main har native_gap i bunten → første kandidat vinn, x86-output er uendra.
    hvis kort == "sha256_bytes" { returner ["std.native_gap.sha256_hex_gap", "std.sha256.hash_bytes"] }
    // argon2id(passord,salt,minne_kib,iter,par,lengde) → rå-minne Argon2id.
    // Var null-fallback (tom streng) → Linux-attestasjonsprobe linje 32 feila.
    // hash_raw_hex held matrisa i mmap'a rå minne (sys6 #9 + raw_load/store64) i
    // staden for VM-lister som OOM-ar ved 64 MiB. nc_main importerer argon2id_pure
    // så ruta er i bunten.
    hvis kort == "argon2id" { returner ["std.argon2id_pure.hash_raw_hex"] }
    // pbkdf2_sha256(tekst,tekst,int,int) → pure tekst-signatur std.sha256.pbkdf2_hex.
    // pbkdf2_sha256 → native (native_gap.pbkdf2_gap brukar sha256_bytes_hex-atomet).
    // Var pure std.sha256.pbkdf2_hex = 120k pure HMAC-iterasjonar → 1 GiB-heng.
    hvis kort == "pbkdf2_sha256" { returner ["std.native_gap.pbkdf2_gap"] }
    // random_hex(int) → pure LCG std.sha256.random_hex_pure (unngår vm_random_hex-heng).
    // random_hex(int) → std.native_gap.random_hex_secure (getrandom(2)-basert; EKTE entropi).
    // Den gamle LCG-ruta (std.sha256.random_hex_pure, seeda berre frå tid_ms) gav
    // same-ms-kollisjonar → duplikate tryggleikskodar. Sjå random_byte-atomet.
    hvis kort == "random_hex" { returner ["std.native_gap.random_hex_secure"] }
    // Filsystem-ABI (list/list_typed/walk_files/stat/path_stat/mkdir_p/delete/rmdir/
    // chmod/file_replace/symlink_replace) → rein-Norscode-impl på native_fs_*-primitiv.
    // desimaltall(tekst) → rein-Norscode-parsing. Den gamle ruta var er_to_int →
    // RT_TO_INT, altså HEILTALSRUTINA: builtin.desimaltall("3.5") las bita som
    // heiltal og segfaulta. Sjå std/native_gap.no for parsing og formatering.
    hvis kort == "desimaltall" { returner ["std.desimaltall_tekst.desimal_frå_tekst"] }
    hvis kort == "filesystem_read_operation" { returner ["std.runtime_filesystem_native.read_operation"] }
    hvis kort == "filesystem_write_operation" { returner ["std.runtime_filesystem_native.write_operation"] }
    // db.* er ein BUILTIN-namespace i VM-en (vm.no: db.open/db.query_text/db.ping,
    // capability-gata). Difor bind `bruk std.db som db` + `db.open(...)` seg til
    // builtin.db.open og IKKJE til aliaset — verifisert: same modul under aliaset
    // `mydb` resolverer korrekt til std.db.open. Den committa C-æra-seeden har
    // native db-builtins; fersk seed har dei ikkje → «Ukjent innebygd funksjon:
    // builtin.db.open» (test_admin_relations). Rut til den reine Norscode-impl.
    // std/db.no. Dispatchen er gata på finnes_nøkkel(fn_vas, mål), så ruta er
    // inert når std.db ikkje er i bunten.
    hvis builtin.starts_with(n, "db.") { returner ["std.db." + builtin.slice(n, 3, lengde(n))] }
    returner []
}
