# Fase 5 - LSP grunnmur
# Minimal JSON-RPC-flate for seinare utviding.
#
# `nc lsp` rutar hit via nc_køyr_verktøy (frå kjelde, ingen reseed). Modusar:
#   NORSCODE_LSP_USE_STDIN=1  batch-LSP over stdin: les ALLE Content-Length-
#       ramma meldingar til EOF (fil_les("/dev/stdin")), handterer dei i
#       rekkjefølgje og skriv ramma JSON-RPC-svar + publishDiagnostics-varsel
#       til stdout. VM-disk-scopet må tillate /dev/stdin, t.d.
#       NORSCODE_VM_DISK_ROOT="$PWD,.,/tmp,/private/tmp,/dev/stdin".
#       Vedvarande dialog med ein editor krev ein strøymande stdin-builtin i
#       vm.no (reseed) og er ikkje støtta enno.
#   NORSCODE_LSP_PAYLOAD / NORSCODE_LSP_STREAM  diagnosemodus: same handtering,
#       men skriv statusoppsummeringar og uramma svar (éin per linje).
# Diagnostikk ved didOpen/didChange kjem frå selfhost/linter_kjerne.no:
# syntaksfeil og typefeil (severity 1), ubrukte variablar, re-deklarasjon,
# uoppnåeleg kode og import-reglar (severity 2). Posisjonar er 0-baserte
# linjer/byte-kolonnar. hover/definition tek standard textDocument+position
# (ordet under markøren; definisjon = `funksjon <ord>` i same dokument) og
# den eldre {"symbol": …}-forma.

bruk selfhost.linter_kjerne som lk

// ─── JSON- og protokollhjelparar ─────────────────────────────────────────────

funksjon lsp_json_tekst(t) -> tekst {
    hvis t == null { returner "null" }
    la s = tekst(t)
    la ut = "\""
    la i = 0
    la n = lengde(s)
    mens i < n {
        la c = builtin.slice(s, i, i + 1)
        la k = builtin.char_code(c)
        hvis c == "\"" {
            ut = ut + "\\\""
        } ellers hvis k == 92 {
            ut = ut + "\\\\"
        } ellers hvis k == 10 {
            ut = ut + "\\n"
        } ellers hvis k == 13 {
            ut = ut + "\\r"
        } ellers hvis k == 9 {
            ut = ut + "\\t"
        } ellers hvis k < 32 {
            ut = ut + " "
        } ellers {
            ut = ut + c
        }
        i = i + 1
    }
    returner ut + "\""
}

funksjon lsp_id_json(id) -> tekst {
    hvis id == null { returner "null" }
    hvis type(id) == "tekst" { returner lsp_json_tekst(id) }
    returner tekst(id)
}

funksjon lsp_ramme(body: tekst) -> tekst {
    returner "Content-Length: " + tekst(lengde(body)) + "\r\n\r\n" + body
}

funksjon lsp_har_id(req) -> boolsk {
    hvis type(req) != "ordbok" { returner usann }
    hvis ikkje finnes_nøkkel(req, "id") { returner usann }
    returner req["id"] != null
}

// Tekst for didOpen/didChange: textDocument.text, contentChanges (full sync,
// siste endring vinn) eller den eldre params.content-forma.
funksjon lsp_dokument_tekst(params) {
    hvis params == null { returner "" }
    la td = params["textDocument"]
    hvis td != null og td["text"] != null { returner tekst(td["text"]) }
    la endringar = params["contentChanges"]
    hvis endringar != null og type(endringar) == "liste" og lengde(endringar) > 0 {
        la siste = endringar[lengde(endringar) - 1]
        hvis siste != null og siste["text"] != null { returner tekst(siste["text"]) }
    }
    hvis params["content"] != null { returner tekst(params["content"]) }
    returner ""
}

funksjon lsp_severity(s: tekst) -> heiltall {
    hvis s == "error" { returner 1 }
    hvis s == "warning" { returner 2 }
    hvis s == "info" { returner 3 }
    returner 4
}

// Lint-funn → LSP-diagnostikk (0-baserte posisjonar).
funksjon lsp_diagnostikk_fra_kjelde(content: tekst) {
    la ut = []
    la funn = []
    prøv {
        funn = lk.lint_kjelde(content)
    } fang (e) {
        la d0 = {}
        d0["message"] = "norscode-lint stoppa: " + tekst(e)
        d0["severity"] = 3
        d0["source"] = "norscode-lint"
        d0["code"] = "lint-internal"
        d0["line"] = 0
        d0["character"] = 0
        legg_til(ut, d0)
        returner ut
    }
    la i = 0
    mens i < lengde(funn) {
        la f = funn[i]
        la d = {}
        d["message"] = f["melding"]
        d["severity"] = lsp_severity(f["severity"])
        d["source"] = "norscode-lint"
        d["code"] = f["code"]
        la linje = f["linje"] - 1
        la kol = f["kolonne"] - 1
        hvis linje < 0 { linje = 0 }
        hvis kol < 0 { kol = 0 }
        d["line"] = linje
        d["character"] = kol
        legg_til(ut, d)
        i = i + 1
    }
    returner ut
}

funksjon lsp_diagnose_json(d) -> tekst {
    la linje = 0
    la kol = 0
    hvis d["line"] != null { linje = d["line"] }
    hvis d["character"] != null { kol = d["character"] }
    la kode = ""
    hvis d["code"] != null { kode = ",\"code\":" + lsp_json_tekst(d["code"]) }
    la severity = 1
    hvis d["severity"] != null { severity = d["severity"] }
    la kjelde = "norscode-lsp"
    hvis d["source"] != null { kjelde = tekst(d["source"]) }
    returner "{\"range\":{\"start\":{\"line\":" + tekst(linje) + ",\"character\":" + tekst(kol) +
        "},\"end\":{\"line\":" + tekst(linje) + ",\"character\":" + tekst(kol + 1) + "}},\"severity\":" +
        tekst(severity) + kode + ",\"source\":" + lsp_json_tekst(kjelde) + ",\"message\":" +
        lsp_json_tekst(d["message"]) + "}"
}

funksjon lsp_er_ordteikn(c: tekst) -> boolsk {
    hvis c == "" { returner usann }
    la k = builtin.char_code(c)
    returner (k >= 97 og k <= 122) eller (k >= 65 og k <= 90) eller (k >= 48 og k <= 57) eller k == 95 eller k >= 128
}

// Ordet under (linje, teikn) i dokumentet, 0-basert.
funksjon lsp_ord_ved(content, linje, teikn) -> tekst {
    hvis content == null eller linje == null eller teikn == null { returner "" }
    la linjer = builtin.split(tekst(content), "\n")
    hvis linje < 0 eller linje >= lengde(linjer) { returner "" }
    la l = linjer[linje]
    la pos = teikn
    hvis pos > lengde(l) { pos = lengde(l) }
    la a = pos
    mens a > 0 og lsp_er_ordteikn(builtin.slice(l, a - 1, a)) { a = a - 1 }
    la b = pos
    mens b < lengde(l) og lsp_er_ordteikn(builtin.slice(l, b, b + 1)) { b = b + 1 }
    hvis b <= a { returner "" }
    returner builtin.slice(l, a, b)
}

// Finn `funksjon <namn>(` i dokumentet: [linje, teikn, signaturlinje] eller null.
funksjon lsp_finn_definisjon(content, namn: tekst) {
    hvis content == null eller namn == "" { returner null }
    la linjer = builtin.split(tekst(content), "\n")
    la i = 0
    mens i < lengde(linjer) {
        la l = linjer[i]
        la p = builtin.index_of(l, "funksjon " + namn + "(")
        hvis p >= 0 {
            la sig = builtin.trim(l)
            hvis builtin.ends_with(sig, "{") { sig = builtin.trim(builtin.slice(sig, 0, lengde(sig) - 1)) }
            returner [i, p + lengde("funksjon "), sig]
        }
        i = i + 1
    }
    returner null
}

// Symbolet ein hover/definition-førespurnad gjeld: eldre {"symbol": …} eller
// ordet under textDocument+position.
funksjon lsp_symbol_for(server, params) -> tekst {
    hvis params == null { returner "" }
    hvis params["symbol"] != null { returner tekst(params["symbol"]) }
    la td = params["textDocument"]
    la pos = params["position"]
    hvis td == null eller pos == null { returner "" }
    la uri = td["uri"]
    hvis uri == null { returner "" }
    la content = server.documents[uri]
    returner lsp_ord_ved(content, pos["line"], pos["character"])
}

funksjon lsp_dokument_for(server, params) {
    hvis params == null { returner null }
    la td = params["textDocument"]
    hvis td == null { returner null }
    hvis td["uri"] == null { returner null }
    returner server.documents[td["uri"]]
}

funksjon lsp_server()
    returner {
        initialized: usann,
        documents: {},
        document_versions: {},
        diagnostics: {},
        methods: []
    }
slutt

funksjon lsp_initialize(server)
    server.initialized = sann
    returner '{"jsonrpc":"2.0","result":{"capabilities":{"textDocumentSync":1,"hoverProvider":true,"definitionProvider":true,"completionProvider":true,"documentSymbolProvider":true,"documentFormattingProvider":true}}}'
slutt

funksjon lsp_capabilities_summary()
    returner "textDocumentSync=1, hoverProvider=true, definitionProvider=true, completionProvider=true, documentSymbolProvider=true, documentFormattingProvider=true"
slutt

funksjon lsp_notifications_summary()
    returner "notifications=textDocument/publishDiagnostics"
slutt

funksjon lsp_notifications_count_summary(session)
    returner "notifications_count=" + til_tekst(lengde(session.notifications))
slutt

funksjon lsp_notifications_health_summary(session)
    hvis lengde(session.notifications) == 0
        returner "notifications_health=idle"
    slutt
    returner "notifications_health=active"
slutt

funksjon lsp_notifications_overview_summary(session)
    returner lsp_notifications_count_summary(session) + " | " + lsp_notifications_health_summary(session)
slutt

funksjon lsp_notification_type_summary(notification)
    hvis builtin.contains(notification, "textDocument/publishDiagnostics")
        returner "notification=textDocument/publishDiagnostics"
    slutt
    returner "notification=unknown"
slutt

funksjon lsp_output_summary(server, session)
    returner "output=responses:" + til_tekst(lengde(session.responses)) + ", notifications:" + til_tekst(lengde(session.notifications)) + ", documents:" + til_tekst(lengde(server.documents))
slutt

funksjon lsp_document_health_summary(server)
    la keys = nøkler(server.documents)
    hvis lengde(keys) == 0
        returner "document_health=empty"
    slutt

    la healthy = 0
    la i = 0
    mens i < lengde(keys)
        la path = keys[i]
        la probe = lsp_semantic_probe_from_document(server, path)
        hvis probe.ok
            healthy = healthy + 1
        slutt
        i = i + 1
    slutt

    returner "document_health=" + til_tekst(healthy) + "/" + til_tekst(lengde(keys))
slutt

funksjon lsp_document_health_state_summary(server)
    la health = lsp_document_health_summary(server)
    hvis builtin.contains(health, "document_health=empty")
        returner "document_health_state=empty"
    slutt
    hvis builtin.contains(health, "0/")
        returner "document_health_state=unhealthy"
    slutt
    hvis builtin.contains(health, "/")
        returner "document_health_state=partial"
    slutt
    returner "document_health_state=unknown"
slutt

funksjon lsp_document_versions_summary(server)
    la keys = nøkler(server.document_versions)
    hvis lengde(keys) == 0
        returner "document_versions=empty"
    slutt

    la total = 0
    la i = 0
    mens i < lengde(keys)
        total = total + lsp_document_version(server, keys[i])
        i = i + 1
    slutt

    returner "document_versions=" + til_tekst(lengde(keys)) + ", total=" + til_tekst(total)
slutt

funksjon lsp_latest_document_version_summary(server)
    la keys = nøkler(server.document_versions)
    hvis lengde(keys) == 0
        returner "latest_document_version=empty"
    slutt

    la latest_path = keys[0]
    la latest_version = lsp_document_version(server, latest_path)
    la i = 1
    mens i < lengde(keys)
        la path = keys[i]
        la v = lsp_document_version(server, path)
        hvis v > latest_version
            latest_version = v
            latest_path = path
        slutt
        i = i + 1
    slutt

    returner "latest_document_version=" + latest_path + "@" + til_tekst(latest_version)
slutt

funksjon lsp_version_health_summary(server)
    la versions = lsp_document_versions_summary(server)
    hvis builtin.contains(versions, "document_versions=empty")
        returner "version_health=empty"
    slutt
    hvis builtin.contains(versions, "total=0")
        returner "version_health=stalled"
    slutt
    hvis builtin.contains(versions, "total=")
        returner "version_health=active"
    slutt
    returner "version_health=unknown"
slutt

funksjon lsp_transport_summary()
    returner "transport=batch/session,json-batch-stdio,content-length"
slutt

funksjon lsp_io_summary()
    returner "io=json-batch-stdio,content-length"
slutt

funksjon lsp_framing_summary()
    returner "framing=json-batch+content-length"
slutt

funksjon lsp_entrypoint_summary()
    returner "entrypoint=lsp_stdio_main"
slutt

funksjon lsp_transport_overview_summary()
    returner lsp_transport_summary() + " | " + lsp_io_summary() + " | " + lsp_framing_summary()
slutt

funksjon lsp_message_count_summary(session)
    returner "messages=" + til_tekst(lengde(session.responses) + lengde(session.notifications))
slutt

funksjon lsp_session_methods_summary(session)
    hvis lengde(session.methods) == 0
        returner "session_methods=empty"
    slutt
    returner "session_methods=" + til_tekst(lengde(session.methods))
slutt

funksjon lsp_activity_summary(session)
    returner lsp_message_count_summary(session) + " | " + lsp_session_methods_summary(session)
slutt

funksjon lsp_activity_health_summary(session)
    hvis lengde(session.methods) == 0
        returner "activity_health=idle"
    slutt
    hvis lengde(session.notifications) == 0
        returner "activity_health=quiet"
    slutt
    returner "activity_health=active"
slutt

funksjon lsp_overall_health_summary(server, session)
    returner lsp_document_health_state_summary(server) + " | " + lsp_activity_health_summary(session) + " | " + lsp_notifications_health_summary(session) + " | " + lsp_version_health_summary(server)
slutt

funksjon lsp_top_status_summary(server, session)
    returner "top_status=" + lsp_overall_health_summary(server, session)
slutt

funksjon lsp_banner_summary(server, session)
    la status = lsp_top_status_summary(server, session)
    hvis builtin.contains(status, "document_health_state=empty") eller builtin.contains(status, "activity_health=idle")
        returner "banner=uklar"
    slutt
    hvis builtin.contains(status, "version_health=stalled")
        returner "banner=delvis"
    slutt
    hvis builtin.contains(status, "activity_health=quiet") eller builtin.contains(status, "notifications_health=idle")
        returner "banner=delvis"
    slutt
    returner "banner=klar"
slutt

funksjon lsp_document_exists_summary(server, path)
    hvis lsp_has_document(server, path)
        returner "document_exists=true"
    slutt
    returner "document_exists=false"
slutt

funksjon lsp_document_version_summary(server, path)
    returner "document_version=" + til_tekst(lsp_document_version(server, path))
slutt

funksjon lsp_full_summary(server, session, probe)
    returner lsp_protocol_summary(server, session, probe) + " | full=ok"
slutt

funksjon lsp_route_summary()
    returner "routes=initialize/didOpen/didChange/hover/definition/completion/documentSymbol/formatting/textDocument/publishDiagnostics/shutdown/exit"
slutt

funksjon lsp_supported_methods_summary()
    returner "initialize,didOpen,didChange,hover,definition,completion,documentSymbol,formatting,textDocument/publishDiagnostics,shutdown,exit"
slutt

funksjon lsp_open_document(server, path, content)
    server.documents[path] = content
    hvis server.document_versions[path] == null
        server.document_versions[path] = 0
    slutt
    server.document_versions[path] = server.document_versions[path] + 1
    hvis server.diagnostics[path] == null
        server.diagnostics[path] = []
    slutt
    returner sann
slutt

funksjon lsp_publish_diagnostic(server, path, diagnostic)
    hvis server.diagnostics[path] == null
        server.diagnostics[path] = []
    slutt
    legg_til(server.diagnostics[path], diagnostic)
    returner sann
slutt

funksjon lsp_clear_diagnostics(server, path)
    server.diagnostics[path] = []
    returner sann
slutt

funksjon lsp_document_version(server, path)
    hvis server.document_versions[path] == null
        returner 0
    slutt
    returner server.document_versions[path]
slutt

funksjon lsp_has_document(server, path)
    hvis server.documents[path] == null
        returner usann
    slutt
    returner sann
slutt

// Køyr lint-kjerna (syntaks, typesjekk, AST-reglar) og lagra diagnostikken
// som publishDiagnostics-varselet for dokumentet blir laga av.
funksjon lsp_validate_document(server, path, content)
    lsp_clear_diagnostics(server, path)
    la diagnostikk = lsp_diagnostikk_fra_kjelde(content)
    la ok = sann
    la i = 0
    mens i < lengde(diagnostikk)
        la d = diagnostikk[i]
        lsp_publish_diagnostic(server, path, d)
        hvis d["severity"] == 1
            ok = usann
        slutt
        i = i + 1
    slutt
    returner ok
slutt

// Oppsummering av eit dokument frå den lagra diagnostikken (ingen ny lint).
funksjon lsp_semantic_probe_from_document(server, path)
    hvis lsp_has_document(server, path) == usann
        returner {
            ok: usann,
            severity: 1,
            message: "Dokumentet finst ikkje i servertilstand"
        }
    slutt
    returner lsp_probe_fra_diagnostikk(server.diagnostics[path])
slutt

funksjon lsp_probe_fra_diagnostikk(diagnostikk)
    hvis diagnostikk == null
        returner { ok: sann, severity: 0, message: "OK" }
    slutt
    la i = 0
    mens i < lengde(diagnostikk)
        la d = diagnostikk[i]
        hvis d["severity"] == 1
            returner { ok: usann, severity: 1, message: d["message"] }
        slutt
        i = i + 1
    slutt
    hvis lengde(diagnostikk) > 0
        la fyrste = diagnostikk[0]
        returner { ok: sann, severity: fyrste["severity"], message: fyrste["message"] }
    slutt
    returner { ok: sann, severity: 0, message: "OK" }
slutt

funksjon lsp_semantic_probe(content)
    returner lsp_probe_fra_diagnostikk(lsp_diagnostikk_fra_kjelde(content))
slutt

funksjon lsp_semantic_probe_summary(probe)
    returner "ok=" + til_tekst(probe.ok) + ", severity=" + til_tekst(probe.severity) + ", message=" + probe.message
slutt

funksjon lsp_document_summary(server)
    la doc_count = lengde(server.documents)
    la version_count = lengde(server.document_versions)
    la diag_count = 0
    la keys = nøkler(server.diagnostics)
    la i = 0
    mens i < lengde(keys)
        diag_count = diag_count + lengde(server.diagnostics[keys[i]])
        i = i + 1
    slutt
    returner "documents=" + til_tekst(doc_count) + ", diagnostics=" + til_tekst(diag_count) + ", versions=" + til_tekst(version_count)
slutt

funksjon lsp_state_summary(server, session, probe)
    la docs = lsp_document_summary(server)
    la versions = lsp_document_versions_summary(server)
    la latest_version = lsp_latest_document_version_summary(server)
    la sess = lsp_session_summary(session)
    la probe_text = lsp_semantic_probe_summary(probe)
    la notifications_health = lsp_notifications_health_summary(session)
    la notifications_overview = lsp_notifications_overview_summary(session)
    returner docs + " | " + versions + " | " + latest_version + " | " + sess + " | methods_seen=" + til_tekst(lengde(server.methods)) + " | session_methods=" + til_tekst(lengde(session.methods)) + " | " + notifications_health + " | " + notifications_overview + " | " + probe_text + " | caps=" + lsp_capabilities_summary()
slutt

funksjon lsp_protocol_summary(server, session, probe)
    la state = lsp_state_summary(server, session, probe)
    la notifications = lsp_notifications_summary()
    la notifications_count = lsp_notifications_count_summary(session)
    la notifications_health = lsp_notifications_health_summary(session)
    la notifications_overview = lsp_notifications_overview_summary(session)
    la transport = lsp_transport_summary()
    la methods = lsp_supported_methods_summary()
    la io = lsp_io_summary()
    la framing = lsp_framing_summary()
    la entry = lsp_entrypoint_summary()
    la messages = lsp_message_count_summary(session)
    la versions = lsp_document_versions_summary(server)
    la session_methods = "session_methods=" + til_tekst(lengde(session.methods))
    la activity_health = lsp_activity_health_summary(session)
    la doc_health_state = lsp_document_health_state_summary(server)
    la version_health = lsp_version_health_summary(server)
    returner state + " | protocol=JSON-RPC | notifications=" + notifications + " | " + notifications_count + " | " + notifications_health + " | " + notifications_overview + " | transport=" + transport + " | methods=" + methods + " | io=" + io + " | " + framing + " | entrypoint=" + entry + " | " + messages + " | " + versions + " | " + session_methods + " | " + activity_health + " | " + doc_health_state + " | " + version_health
slutt

funksjon lsp_status_bundle_summary(server, session, probe)
    la summary = lsp_session_summary(session)
    la protocol_summary = lsp_protocol_summary(server, session, probe)
    la activity_summary = lsp_activity_summary(session)
    la notifications_count_summary = lsp_notifications_count_summary(session)
    la notifications_health_summary = lsp_notifications_health_summary(session)
    la notifications_overview_summary = lsp_notifications_overview_summary(session)
    la activity_health_summary = lsp_activity_health_summary(session)
    la overall_health_summary = lsp_overall_health_summary(server, session)
    la transport_overview_summary = lsp_transport_overview_summary()
    la top_status_summary = lsp_top_status_summary(server, session)
    la banner_summary = lsp_banner_summary(server, session)
    la document_summary = lsp_document_summary(server)
    la state_summary = lsp_state_summary(server, session, probe)
    la probe_summary = lsp_semantic_probe_summary(probe)
    la output_summary = lsp_output_summary(server, session)
    la document_health_summary = lsp_document_health_summary(server)
    la document_health_state_summary = lsp_document_health_state_summary(server)
    la document_versions_summary = lsp_document_versions_summary(server)
    la latest_document_version_summary = lsp_latest_document_version_summary(server)
    la version_health_summary = lsp_version_health_summary(server)
    la stream_source_summary = lsp_stream_source_summary("", json_skriv(lsp_demo_requests()))
    la stream_mode_inputs = builtin.split("a b", " ")
    la stream_overview_responses = builtin.split("{}\n{}", "\n")
    la stream_overview_methods = builtin.split("initialize shutdown", " ")
    la stream_overview_summary = lsp_stream_overview_summary(stream_mode_inputs, { requests_total: 2, responses: stream_overview_responses, notifications: [], methods: stream_overview_methods, trace: [] })
    la stream_mode_summary = lsp_stream_mode_summary(stream_mode_inputs)
    returner summary + "\n" + protocol_summary + "\n" + activity_summary + "\n" + notifications_count_summary + "\n" + notifications_health_summary + "\n" + notifications_overview_summary + "\n" + activity_health_summary + "\n" + overall_health_summary + "\n" + transport_overview_summary + "\n" + top_status_summary + "\n" + banner_summary + "\n" + probe_summary + "\n" + document_summary + "\n" + state_summary + "\n" + output_summary + "\n" + document_health_summary + "\n" + document_health_state_summary + "\n" + document_versions_summary + "\n" + latest_document_version_summary + "\n" + version_health_summary + "\n" + stream_source_summary + "\n" + stream_mode_summary + "\n" + stream_overview_summary
slutt

funksjon lsp_format_diagnostics_notification(path, diagnostics)
    la items = "["
    hvis diagnostics != null
        la i = 0
        mens i < lengde(diagnostics)
            hvis i > 0
                items = items + ","
            slutt
            items = items + lsp_diagnose_json(diagnostics[i])
            i = i + 1
        slutt
    slutt
    items = items + "]"
    returner '{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":' + lsp_json_tekst(path) + ',"diagnostics":' + items + '}}'
slutt

funksjon lsp_hover(server, symbol)
    hvis server.initialized == usann
        returner '"LSP ikkje initialisert"'
    slutt
    hvis symbol == null eller symbol == ""
        returner 'null'
    slutt
    returner '{"contents":{"kind":"markdown","value":' + lsp_json_tekst(symbol) + '}}'
slutt

// hover med dokumentkontekst: signaturen til ein funksjon i same dokument.
funksjon lsp_hover_i_dokument(server, params)
    la symbol = lsp_symbol_for(server, params)
    la content = lsp_dokument_for(server, params)
    la def = lsp_finn_definisjon(content, symbol)
    hvis def == null eller server.initialized == usann
        returner lsp_hover(server, symbol)
    slutt
    returner '{"contents":{"kind":"markdown","value":' + lsp_json_tekst("```norscode\n" + def[2] + "\n```") + '}}'
slutt

funksjon lsp_definition(server, symbol)
    hvis server.initialized == usann
        returner 'null'
    slutt
    returner '{"uri":"file:///norscode/' + symbol + '.no","range":{"start":{"line":0,"character":0},"end":{"line":0,"character":0}}}'
slutt

// definition med dokumentkontekst: `funksjon <ord>` i same dokument, elles null.
funksjon lsp_definition_i_dokument(server, params)
    hvis params != null og params["symbol"] != null
        returner lsp_definition(server, tekst(params["symbol"]))
    slutt
    hvis server.initialized == usann
        returner 'null'
    slutt
    la symbol = lsp_symbol_for(server, params)
    la def = lsp_finn_definisjon(lsp_dokument_for(server, params), symbol)
    hvis def == null
        returner 'null'
    slutt
    la uri = params["textDocument"]["uri"]
    la l = tekst(def[0])
    la start = tekst(def[1])
    la slutt_kol = tekst(def[1] + lengde(symbol))
    returner '{"uri":' + lsp_json_tekst(uri) + ',"range":{"start":{"line":' + l + ',"character":' + start + '},"end":{"line":' + l + ',"character":' + slutt_kol + '}}}'
slutt

funksjon lsp_completion(server, prefix)
    hvis server.initialized == usann
        returner '[]'
    slutt
    returner '[{"label":"funksjon"},{"label":"hvis"},{"label":"sann"}]'
slutt

funksjon lsp_document_symbols(server, path)
    hvis server.initialized == usann
        returner '[]'
    slutt
    hvis lsp_has_document(server, path) == usann
        returner '[]'
    slutt
    returner '[{"name":"main","kind":12}]'
slutt

funksjon lsp_format_document(server, path)
    hvis server.initialized == usann
        returner '[]'
    slutt
    hvis lsp_has_document(server, path) == usann
        returner '[]'
    slutt
    returner '[{"newText":"funksjon main()\\n"}]'
slutt

funksjon lsp_supports_method(method)
    hvis method == "shutdown" eller method == "exit" eller method == "initialize"
        returner sann
    slutt
    hvis method == "initialized" eller method == "textDocument/didClose" eller method == "textDocument/didSave"
        returner sann
    slutt
    hvis method == "textDocument/didOpen" eller method == "textDocument/didChange" eller method == "textDocument/hover"
        returner sann
    slutt
    hvis method == "textDocument/definition" eller method == "textDocument/completion"
        returner sann
    slutt
    hvis method == "textDocument/documentSymbol" eller method == "textDocument/formatting"
        returner sann
    slutt
    hvis method == "textDocument/publishDiagnostics"
        returner sann
    slutt
    returner usann
slutt

funksjon lsp_handle_request(server, method, id, params)
    la idj = lsp_id_json(id)
    hvis params == null
        params = {}
    slutt
    hvis lsp_supports_method(method) == usann
        returner '{"jsonrpc":"2.0","id":' + idj + ',"error":{"code":-32601,"message":"Metode ikkje støtta"}}'
    slutt

    hvis method == "shutdown"
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":null}'
    slutt

    hvis method == "exit"
        returner ''
    slutt

    hvis method == "initialize"
        server.initialized = sann
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":{"capabilities":{"textDocumentSync":1,"hoverProvider":true,"definitionProvider":true,"completionProvider":true,"documentSymbolProvider":true,"documentFormattingProvider":true}}}'
    slutt

    hvis method == "initialized" eller method == "textDocument/didSave"
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":null}'
    slutt

    hvis method == "textDocument/didClose"
        la lukka = params["textDocument"]["uri"]
        lsp_clear_diagnostics(server, lukka)
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":null}'
    slutt

    hvis method == "textDocument/didOpen"
        la path = params["textDocument"]["uri"]
        la content = lsp_dokument_tekst(params)
        lsp_open_document(server, path, content)
        lsp_validate_document(server, path, content)
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":null}'
    slutt

    hvis method == "textDocument/didChange"
        la path = params["textDocument"]["uri"]
        la content = lsp_dokument_tekst(params)
        lsp_open_document(server, path, content)
        lsp_validate_document(server, path, content)
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":null}'
    slutt

    hvis method == "textDocument/hover"
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":' + lsp_hover_i_dokument(server, params) + '}'
    slutt

    hvis method == "textDocument/definition"
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":' + lsp_definition_i_dokument(server, params) + '}'
    slutt

    hvis method == "textDocument/completion"
        la prefix = params["prefix"]
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":' + lsp_completion(server, prefix) + '}'
    slutt

    hvis method == "textDocument/documentSymbol"
        la path = params["textDocument"]["uri"]
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":' + lsp_document_symbols(server, path) + '}'
    slutt

    hvis method == "textDocument/formatting"
        la path = params["textDocument"]["uri"]
        returner '{"jsonrpc":"2.0","id":' + idj + ',"result":' + lsp_format_document(server, path) + '}'
    slutt

    returner '{"jsonrpc":"2.0","id":' + idj + ',"error":{"code":-32601,"message":"Metode ikkje støtta"}}'
slutt

funksjon lsp_handle_batch(server, requests)
    la responses = []
    la i = 0
    mens i < lengde(requests)
        la req = requests[i]
        legg_til(server.methods, req["method"])
        la res = lsp_handle_request(server, req["method"], req["id"], req["params"])
        legg_til(responses, res)
        i = i + 1
    slutt
    returner responses
slutt

funksjon lsp_handle_session(server, requests)
    la responses = []
    la notifications = []
    la methods = []
    la i = 0
    mens i < lengde(requests)
        la req = requests[i]
        legg_til(methods, req["method"])
        la res = lsp_handle_request(server, req["method"], req["id"], req["params"])
        legg_til(responses, res)

        hvis req["method"] == "textDocument/didOpen" eller req["method"] == "textDocument/didChange"
            la path = req["params"]["textDocument"]["uri"]
            la note = lsp_format_diagnostics_notification(path, server.diagnostics[path])
            legg_til(notifications, note)
        slutt

        i = i + 1
    slutt

    returner { responses: responses, notifications: notifications, methods: methods }
slutt

funksjon lsp_session_summary(session)
    la diagnostics_count = 0
    la version_events = 0
    la i = 0
    mens i < lengde(session.notifications)
        hvis builtin.contains(session.notifications[i], "textDocument/publishDiagnostics")
            diagnostics_count = diagnostics_count + 1
        slutt
        i = i + 1
    slutt
    la j = 0
    mens j < lengde(session.methods)
        hvis session.methods[j] == "textDocument/didOpen" eller session.methods[j] == "textDocument/didChange"
            version_events = version_events + 1
        slutt
        j = j + 1
    slutt
    returner "responses=" + til_tekst(lengde(session.responses)) + ", notifications=" + til_tekst(lengde(session.notifications)) + ", diagnostics=" + til_tekst(diagnostics_count) + ", version_events=" + til_tekst(version_events) + ", methods=" + til_tekst(lengde(session.methods))
slutt

funksjon lsp_trace_batch(requests, responses)
    la trace = []
    la i = 0
    mens i < lengde(requests)
        la req = requests[i]
        la res = responses[i]
        legg_til(trace, lsp_request_summary(req) + " -> " + res)
        i = i + 1
    slutt
    returner trace
slutt

funksjon lsp_request_summary(req)
    returner req["method"] + "#" + req["id"]
slutt

funksjon lsp_extract_body_from_framed_payload(payload)
    hvis builtin.contains(payload, "Content-Length:") == usann
        returner payload
    slutt

    la i = 0
    mens i + 3 < lengde(payload)
        hvis builtin.slice(payload, i, i + 4) == "\r\n\r\n"
            returner builtin.slice(payload, i + 4, lengde(payload))
        slutt
        hvis builtin.slice(payload, i, i + 2) == "\n\n"
            returner builtin.slice(payload, i + 2, lengde(payload))
        slutt
        i = i + 1
    slutt

    returner payload
slutt

funksjon lsp_parse_content_length(header)
    la lines = builtin.split(header, "\n")
    la i = 0
    mens i < lengde(lines)
        la line = lines[i]
        hvis builtin.contains(line, "Content-Length:")
            la parts = builtin.split(line, ":")
            hvis lengde(parts) >= 2
                returner heltall(builtin.trim(parts[1]))
            slutt
        slutt
        i = i + 1
    slutt
    returner 0
slutt

funksjon lsp_peel_framed_request(payload)
    hvis builtin.contains(payload, "Content-Length:") == usann
        returner { body: payload, rest: "" }
    slutt

    la header_end = -1
    la body_start = -1
    la i = 0
    mens i + 3 < lengde(payload)
        hvis builtin.slice(payload, i, i + 4) == "\r\n\r\n"
            header_end = i
            body_start = i + 4
            bryt
        slutt
        hvis builtin.slice(payload, i, i + 2) == "\n\n"
            header_end = i
            body_start = i + 2
            bryt
        slutt
        i = i + 1
    slutt

    hvis header_end < 0 eller body_start < 0
        returner { body: payload, rest: "" }
    slutt

    la header = builtin.slice(payload, 0, header_end)
    la body_len = lsp_parse_content_length(header)
    hvis body_len <= 0
        returner { body: builtin.slice(payload, body_start, lengde(payload)), rest: "" }
    slutt

    la body_end = body_start + body_len
    hvis body_end > lengde(payload)
        body_end = lengde(payload)
    slutt

    la body = builtin.slice(payload, body_start, body_end)
    la rest = ""
    hvis body_end < lengde(payload)
        rest = builtin.slice(payload, body_end, lengde(payload))
    slutt
    returner { body: body, rest: rest }
slutt

funksjon lsp_requests_from_stdin(payload)
    hvis payload == ""
        returner null
    slutt

    la rest = builtin.trim(payload)
    la requests = []
    la trykker = 0
    mens lengde(rest) > 0 og trykker < 100000
        la part = lsp_peel_framed_request(rest)
        la body = part.body
        rest = builtin.trim(part.rest)
        hvis body == ""
            bryt
        slutt
        la parsed = json_parse_raw(body)
        hvis parsed == null
            returner null
        slutt
        hvis type(parsed) == "liste"
            la j = 0
            mens j < lengde(parsed)
                legg_til(requests, parsed[j])
                j = j + 1
            slutt
        ellers
            legg_til(requests, parsed)
        slutt
        trykker = trykker + 1
        hvis rest == ""
            bryt
        slutt
    slutt

    hvis lengde(requests) == 0
        returner null
    slutt

    returner requests
slutt

funksjon lsp_input_mode_summary(payload)
    hvis payload == ""
        returner "input_mode=empty"
    slutt
    hvis builtin.contains(payload, "Content-Length:")
        hvis builtin.contains(payload, "\r\n\r\n") eller builtin.contains(payload, "\n\n")
            hvis builtin.contains(payload, "Content-Length:") og builtin.contains(builtin.trim(payload), "Content-Length:") og builtin.contains(payload, "}\r\n\r\nContent-Length:") eller builtin.contains(payload, "}]Content-Length:")
                returner "input_mode=content-length-batch"
            slutt
            returner "input_mode=content-length"
        slutt
    slutt
    hvis builtin.trim(payload) == "" 
        returner "input_mode=empty"
    slutt
    hvis builtin.slice(builtin.trim(payload), 0, 1) == "[" eller builtin.slice(builtin.trim(payload), 0, 1) == "{"
        returner "input_mode=raw-json"
    slutt
    returner "input_mode=unknown"
slutt

funksjon lsp_stdio_report_summary(payload, requests)
    la mode = lsp_input_mode_summary(payload)
    la stage = "stdio"
    la kind = lsp_request_kind_summary(requests)
    hvis mode == "input_mode=empty"
        stage = "fallback"
    slutt
    hvis mode != "input_mode=empty" og lengde(requests) == 0
        stage = "decode-fallback"
    slutt
    returner "stdin_bytes=" + til_tekst(lengde(payload)) + " | " + mode + " | " + kind + " | request_count=" + til_tekst(lengde(requests)) + " | stage=" + stage
slutt

funksjon lsp_transport_probe_summary(payload, requests)
    returner lsp_stdio_report_summary(payload, requests)
slutt

funksjon lsp_request_kind_summary(requests)
    hvis requests == null
        returner "request_kind=none"
    slutt
    hvis lengde(requests) == 0
        returner "request_kind=empty"
    slutt
    hvis lengde(requests) == 1
        returner "request_kind=single"
    slutt
    returner "request_kind=batch"
slutt

funksjon lsp_stream_payloads_from_text(raw)
    hvis raw == null eller raw == ""
        returner null
    slutt

    la parsed = json_parse_raw(raw)
    hvis parsed == null
        returner null
    slutt

    hvis type(parsed) == "liste"
        hvis lengde(parsed) == 0
            returner null
        slutt
        hvis type(parsed[0]) == "tekst"
            returner parsed
        slutt
        returner null
    slutt

    hvis builtin.contains(raw, "\n")
        la deler = builtin.split(raw, "\n")
        la chunks = []
        la i = 0
        mens i < lengde(deler)
            la chunk = builtin.trim(deler[i])
            hvis chunk != ""
                legg_til(chunks, chunk)
            slutt
            i = i + 1
        slutt
        hvis lengde(chunks) > 0
            returner chunks
        slutt
    slutt

    returner [raw]
slutt

funksjon lsp_stream_summary(payloads)
    hvis payloads == null
        returner "stream=none"
    slutt
    returner "stream_chunks=" + til_tekst(lengde(payloads))
slutt

funksjon lsp_stream_chunk_count_summary(payloads)
    hvis payloads == null
        returner "stream_chunk_count=0"
    slutt
    returner "stream_chunk_count=" + til_tekst(lengde(payloads))
slutt

funksjon lsp_stream_overview_summary(payloads, stream_run)
    hvis payloads == null eller stream_run == null
        returner "stream_overview=none"
    slutt
    la mode = lsp_stream_mode_summary(payloads)
    returner "stream_overview=chunks=" + til_tekst(lengde(payloads)) + ", requests=" + til_tekst(stream_run.requests_total) + ", responses=" + til_tekst(lengde(stream_run.responses)) + ", notifications=" + til_tekst(lengde(stream_run.notifications)) + ", " + mode
slutt

funksjon lsp_stream_mode_summary(payloads)
    hvis payloads == null
        returner "stream_mode=none"
    slutt
    hvis type(payloads) == "liste" og lengde(payloads) > 1 og type(payloads[0]) == "tekst" og type(payloads[1]) == "tekst"
        returner "stream_mode=hybrid"
    slutt
    hvis lengde(payloads) <= 1
        returner "stream_mode=single"
    slutt
    returner "stream_mode=stream"
slutt

funksjon lsp_stream_source_summary(raw_stream, single_payload)
    la has_stream = raw_stream != null og raw_stream != ""
    la has_payload = single_payload != null og single_payload != ""
    hvis has_stream og has_payload
        returner "stream_source=NORSCODE_LSP_STREAM+NORSCODE_LSP_PAYLOAD"
    slutt
    hvis has_stream
        returner "stream_source=NORSCODE_LSP_STREAM"
    slutt
    hvis has_payload
        returner "stream_source=NORSCODE_LSP_PAYLOAD"
    slutt
    returner "stream_source=empty"
slutt

funksjon lsp_env_true(namn)
    la v = miljo_hent(namn)
    hvis v == null
        returner usann
    slutt
    la t = builtin.trim(v)
    hvis t == "1" eller t == "sann" eller t == "true" eller t == "ja"
        returner sann
    slutt
    returner usann
slutt

// Les heile stdin til EOF. VM-en har ingen strøymande stdin-builtin, så
// /dev/stdin blir lesen som fil (krev at stien er i NORSCODE_VM_DISK_ROOT).
// Returnerer {"ok": boolsk, "data": tekst, "feil": tekst}.
funksjon lsp_les_stdin() {
    la r = {}
    r["ok"] = usann
    r["data"] = ""
    r["feil"] = ""
    prøv {
        r["data"] = fil_les("/dev/stdin")
        r["ok"] = sann
    } fang (e) {
        r["feil"] = tekst(e)
    }
    returner r
}

funksjon lsp_read_stdin_payload()
    la r = lsp_les_stdin()
    returner r["data"]
slutt

funksjon lsp_read_stdin_stream_until_empty()
    la data = lsp_read_stdin_payload()
    hvis data == ""
        returner null
    slutt
    returner [data]
slutt

// Batch-LSP over stdin: kvar ramma melding blir handtert i rekkjefølgje.
// Førespurnader (med id) får eit ramma svar; didOpen/didChange/didClose gjev
// eit ramma textDocument/publishDiagnostics-varsel. Ugyldig JSON gjev
// JSON-RPC-feil -32700. `exit` stoppar handteringa.
funksjon lsp_stdin_batch(server) -> boolsk {
    la inn = lsp_les_stdin()
    hvis ikkje inn["ok"] {
        skriv("nc lsp: kan ikkje lese stdin: " + inn["feil"] + "\n")
        skriv("nc lsp: NORSCODE_LSP_USE_STDIN=1 krev /dev/stdin i NORSCODE_VM_DISK_ROOT\n")
        returner usann
    }
    la rest = builtin.trim(inn["data"])
    la vakt = 0
    mens lengde(rest) > 0 og vakt < 100000 {
        la del = lsp_peel_framed_request(rest)
        la body = del.body
        rest = builtin.trim(del.rest)
        vakt = vakt + 1
        hvis builtin.trim(body) == "" { fortsett }
        la req = null
        prøv {
            req = json_parse_raw(body)
        } fang (e) {
            req = null
        }
        hvis req == null eller (type(req) != "ordbok" og type(req) != "liste") {
            skriv(lsp_ramme("{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32700,\"message\":\"Ugyldig JSON\"}}"))
            fortsett
        }
        // Ei JSON-liste er ein batch (òg uramma, på éi linje).
        la meldingar = [req]
        hvis type(req) == "liste" { meldingar = req }
        la mi = 0
        la avslutt = usann
        mens mi < lengde(meldingar) og ikkje avslutt {
            avslutt = lsp_stdin_melding(server, meldingar[mi])
            mi = mi + 1
        }
        hvis avslutt { bryt }
    }
    returner sann
}

// Handter éi melding i batch-stdin-modus. Returnerer sann ved `exit`.
funksjon lsp_stdin_melding(server, req) -> boolsk {
    hvis req == null eller type(req) != "ordbok" {
        skriv(lsp_ramme("{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32600,\"message\":\"Ugyldig førespurnad\"}}"))
        returner usann
    }
    la method = tekst(req["method"])
    legg_til(server.methods, method)
    la params = req["params"]
    hvis params == null { params = {} }
    la svar = lsp_handle_request(server, method, req["id"], params)
    hvis lsp_har_id(req) og svar != "" {
        skriv(lsp_ramme(svar))
    }
    hvis method == "textDocument/didOpen" eller method == "textDocument/didChange" eller method == "textDocument/didClose" {
        la uri = params["textDocument"]["uri"]
        skriv(lsp_ramme(lsp_format_diagnostics_notification(uri, server.diagnostics[uri])))
    }
    returner method == "exit"
}

funksjon lsp_join_payloads(payloads)
    hvis payloads == null
        returner ""
    slutt
    hvis lengde(payloads) == 0
        returner ""
    slutt
    returner builtin.join(payloads, "\n")
slutt

funksjon lsp_run_stream_payloads(server, payloads)
    la responses = []
    la notifications = []
    la methods = []
    la trace = []
    la requests_total = 0
    la i = 0
    mens i < lengde(payloads)
        la payload = payloads[i]
        la requests = lsp_requests_from_stdin(payload)
        hvis requests == null
            returner null
        slutt

        la session = lsp_handle_session(server, requests)
        la batch_trace = lsp_trace_batch(requests, session.responses)

        la j = 0
        mens j < lengde(session.responses)
            legg_til(responses, session.responses[j])
            j = j + 1
        slutt

        la k = 0
        mens k < lengde(session.notifications)
            legg_til(notifications, session.notifications[k])
            k = k + 1
        slutt

        la m = 0
        mens m < lengde(session.methods)
            legg_til(methods, session.methods[m])
            m = m + 1
        slutt

        la t = 0
        mens t < lengde(batch_trace)
            legg_til(trace, batch_trace[t])
            t = t + 1
        slutt

        requests_total = requests_total + lengde(requests)
        i = i + 1
    slutt

    returner {
        responses: responses,
        notifications: notifications,
        methods: methods,
        trace: trace,
        requests_total: requests_total
    }
slutt

funksjon lsp_demo_requests()
    returner [
        { "method": "initialize", "id": "1", "params": {} },
        { "method": "textDocument/didOpen", "id": "2", "params": { "textDocument": { "uri": "file:///tmp/lsp.no", "text": "funksjon main()" } } },
        { "method": "textDocument/didChange", "id": "3", "params": { "textDocument": { "uri": "file:///tmp/lsp.no" }, "content": "funksjon main() feil" } },
        { "method": "textDocument/hover", "id": "4", "params": { "symbol": "main" } },
        { "method": "textDocument/definition", "id": "5", "params": { "symbol": "main" } },
        { "method": "textDocument/completion", "id": "6", "params": { "prefix": "ma" } },
        { "method": "shutdown", "id": "7", "params": {} }
    ]
slutt

funksjon lsp_main()
    la server = lsp_server()
    la requests = lsp_demo_requests()
    la stream_source_summary = lsp_stream_source_summary("", json_skriv(requests))
    la input_mode_summary = lsp_input_mode_summary(json_skriv(requests))
    la request_kind_summary = lsp_request_kind_summary(requests)
    la transport_report = lsp_stdio_report_summary(json_skriv(requests), requests)
    la responses = lsp_handle_batch(server, requests)
    la session = lsp_handle_session(server, requests)
    la trace = lsp_trace_batch(requests, responses)
    la summary = lsp_session_summary(session)
    la probe_summary = lsp_semantic_probe_summary(lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))
    la document_summary = lsp_document_summary(server)
    la state_summary = lsp_state_summary(server, session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))
    la caps_summary = lsp_capabilities_summary()
    la protocol_summary = lsp_protocol_summary(server, session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))
    la notifications_summary = lsp_notifications_summary()
    la transport_summary = lsp_transport_summary()
    la methods_summary = lsp_supported_methods_summary()
    la io_summary = lsp_io_summary()
    la framing_summary = lsp_framing_summary()
    la entrypoint_summary = lsp_entrypoint_summary()
    la messages_summary = lsp_message_count_summary(session)
    la session_methods_summary = lsp_session_methods_summary(session)
    la activity_summary = lsp_activity_summary(session)
    la activity_health_summary = lsp_activity_health_summary(session)
    la overall_health_summary = lsp_overall_health_summary(server, session)
    la top_status_summary = lsp_top_status_summary(server, session)
    la banner_summary = lsp_banner_summary(server, session)
    la full_summary = lsp_full_summary(server, session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))
    la route_summary = lsp_route_summary()
    la doc_exists_summary = lsp_document_exists_summary(server, "file:///tmp/lsp.no")
    la doc_version_summary = lsp_document_version_summary(server, "file:///tmp/lsp.no")
    la notification_type_summary = lsp_notification_type_summary(session.notifications[0])
    la output_summary = lsp_output_summary(server, session)
    la document_health_summary = lsp_document_health_summary(server)
    la document_health_state_summary = lsp_document_health_state_summary(server)
    la document_versions_summary = lsp_document_versions_summary(server)
    la latest_document_version_summary = lsp_latest_document_version_summary(server)
    la version_health_summary = lsp_version_health_summary(server)
    la status_bundle = lsp_status_bundle_summary(server, session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))

    skriv("=== lsp_main ===" + "\n")
    skriv("LSP demo-runner starta" + "\n")
    skriv(stream_source_summary + "\n")
    skriv(input_mode_summary + "\n")
    skriv(request_kind_summary + "\n")
    skriv(transport_report + "\n")
    skriv(status_bundle + "\n")
    skriv(caps_summary + "\n")
    skriv(notifications_summary + "\n")
    skriv(transport_summary + "\n")
    skriv(methods_summary + "\n")
    skriv(io_summary + "\n")
    skriv(framing_summary + "\n")
    skriv(entrypoint_summary + "\n")
    skriv(messages_summary + "\n")
    skriv(session_methods_summary + "\n")
    skriv(full_summary + "\n")
    skriv(route_summary + "\n")
    skriv(doc_exists_summary + "\n")
    skriv(doc_version_summary + "\n")
    skriv(notification_type_summary + "\n")
    skriv(output_summary + "\n")
    skriv(document_health_summary + "\n")
    skriv(document_health_state_summary + "\n")
    skriv(document_versions_summary + "\n")
    skriv(latest_document_version_summary + "\n")
    skriv(version_health_summary + "\n")
    la i = 0
    mens i < lengde(session.responses)
        skriv(session.responses[i] + "\n")
        i = i + 1
    slutt
    la j = 0
    mens j < lengde(trace)
        skriv(trace[j] + "\n")
        j = j + 1
    slutt
    la k = 0
    mens k < lengde(session.notifications)
        skriv(session.notifications[k] + "\n")
        k = k + 1
    slutt
    skriv("lsp_main OK" + "\n")
    returner sann
slutt

funksjon lsp_stdio_main()
    la server = lsp_server()
    la raw_stream = miljo_hent("NORSCODE_LSP_STREAM")
    la single_payload = miljo_hent("NORSCODE_LSP_PAYLOAD")
    la stdin_mode = lsp_env_true("NORSCODE_LSP_USE_STDIN")
    hvis raw_stream == null
        raw_stream = ""
    slutt
    hvis single_payload == null
        single_payload = ""
    slutt

    la stream_payloads = lsp_stream_payloads_from_text(raw_stream)
    la stream_source_summary = lsp_stream_source_summary(raw_stream, single_payload)
    hvis stdin_mode og raw_stream == "" og single_payload == ""
        returner lsp_stdin_batch(server)
    slutt
    la payload = single_payload
    hvis payload == ""
        payload = raw_stream
    slutt
    hvis stdin_mode og payload == "" og stream_payloads != null
        payload = lsp_join_payloads(stream_payloads)
    slutt
    la stdin_summary = "stdin_bytes=" + til_tekst(lengde(payload))
    hvis payload == "" og stream_payloads == null
        returner sann
    slutt

    la input_mode_summary = lsp_input_mode_summary(payload)

    la requests = lsp_requests_from_stdin(payload)
    hvis requests == null og stream_payloads != null
        la stream_run = lsp_run_stream_payloads(server, stream_payloads)
        hvis stream_run == null
            returner sann
        slutt

        la stream_session = {
            responses: stream_run.responses,
            notifications: stream_run.notifications,
            methods: stream_run.methods
        }
        la request_kind_summary = lsp_request_kind_summary(stream_run.methods)
        la trace = stream_run.trace
        la stream_mode_summary = lsp_stream_mode_summary(stream_payloads)
        la stream_overview = lsp_stream_overview_summary(stream_payloads, stream_run)
        la stream_chunk_count_summary = lsp_stream_chunk_count_summary(stream_payloads)
        la summary = lsp_session_summary(stream_session)
        la protocol_summary = lsp_protocol_summary(server, stream_session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))
        la activity_summary = lsp_activity_summary(stream_session)
        la activity_health_summary = lsp_activity_health_summary(stream_session)
        la overall_health_summary = lsp_overall_health_summary(server, stream_session)
        la top_status_summary = lsp_top_status_summary(server, stream_session)
        la banner_summary = lsp_banner_summary(server, stream_session)
        la status_bundle = lsp_status_bundle_summary(server, stream_session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))

        skriv("=== lsp_stdio_main ===" + "\n")
        skriv("LSP JSON-stream over stdio starta" + "\n")
        skriv(stdin_summary + "\n")
        skriv(input_mode_summary + "\n")
        skriv(stream_source_summary + "\n")
        skriv(stream_mode_summary + "\n")
        skriv(stream_chunk_count_summary + "\n")
        skriv(lsp_stream_summary(stream_payloads) + "\n")
        skriv(stream_overview + "\n")
        skriv("transport_report=" + lsp_transport_probe_summary(json_skriv(stream_payloads), stream_run.methods) + "\n")
        skriv(status_bundle + "\n")

        la i = 0
        mens i < lengde(stream_run.responses)
            skriv(stream_run.responses[i] + "\n")
            i = i + 1
        slutt

        la j = 0
        mens j < lengde(trace)
            skriv(trace[j] + "\n")
            j = j + 1
        slutt

        la k = 0
        mens k < lengde(stream_run.notifications)
            skriv(stream_run.notifications[k] + "\n")
            k = k + 1
        slutt

        skriv("lsp_stdio_main OK" + "\n")
        returner sann
    slutt

    hvis requests == null
        returner sann
    slutt

    la request_kind_summary = lsp_request_kind_summary(requests)
    la session = lsp_handle_session(server, requests)
    la trace = lsp_trace_batch(requests, session.responses)
    la summary = lsp_session_summary(session)
    la protocol_summary = lsp_protocol_summary(server, session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))
    la activity_summary = lsp_activity_summary(session)
    la activity_health_summary = lsp_activity_health_summary(session)
    la overall_health_summary = lsp_overall_health_summary(server, session)
    la top_status_summary = lsp_top_status_summary(server, session)
    la banner_summary = lsp_banner_summary(server, session)
    la status_bundle = lsp_status_bundle_summary(server, session, lsp_semantic_probe_from_document(server, "file:///tmp/lsp.no"))

    skriv("=== lsp_stdio_main ===" + "\n")
    skriv("LSP JSON-batch over stdio starta" + "\n")
    skriv(stdin_summary + "\n")
    skriv(input_mode_summary + "\n")
    skriv(stream_source_summary + "\n")
    la payload_list = builtin.split(payload, "\n---payload-break---\n")
    skriv(lsp_stream_mode_summary(payload_list) + "\n")
    skriv(lsp_stream_summary(payload_list) + "\n")
    skriv("transport_report=" + lsp_transport_probe_summary(payload, requests) + "\n")
    skriv(status_bundle + "\n")

    la i = 0
    mens i < lengde(session.responses)
        skriv(session.responses[i] + "\n")
        i = i + 1
    slutt

    la j = 0
    mens j < lengde(trace)
        skriv(trace[j] + "\n")
        j = j + 1
    slutt

    la k = 0
    mens k < lengde(session.notifications)
        skriv(session.notifications[k] + "\n")
        k = k + 1
    slutt

    skriv("lsp_stdio_main OK" + "\n")
    returner sann
slutt

funksjon lsp_selftest()
    la server = lsp_server()
    hvis server.initialized != usann
        returner usann
    slutt

    la init = lsp_initialize(server)
    hvis server.initialized != sann
        returner usann
    slutt

    la open_ok = lsp_open_document(server, "file:///tmp/main.no", "funksjon main()")
    hvis open_ok != sann
        returner usann
    slutt

    hvis lengde(server.documents) != 1
        returner usann
    slutt

    hvis lsp_has_document(server, "file:///tmp/main.no") != sann
        returner usann
    slutt

    la hov = lsp_hover(server, "main")
    la def = lsp_definition(server, "main")
    la comp = lsp_completion(server, "ma")

    hvis init == null eller hov == null eller def == null eller comp == null
        returner usann
    slutt

    hvis builtin.contains(init, "hoverProvider") == usann
        returner usann
    slutt

    hvis builtin.contains(hov, "main") == usann
        returner usann
    slutt

    hvis builtin.contains(def, "file:///norscode/main.no") == usann
        returner usann
    slutt

    hvis builtin.contains(comp, "funksjon") == usann
        returner usann
    slutt

    hvis lsp_supports_method("initialize") != sann
        returner usann
    slutt

    hvis lsp_supports_method("textDocument/hover") != sann
        returner usann
    slutt

    hvis lsp_supports_method("textDocument/publishDiagnostics") != sann
        returner usann
    slutt

    la rpc_init = lsp_handle_request(server, "initialize", "1", {})
    la rpc_open = lsp_handle_request(server, "textDocument/didOpen", "2", { "textDocument": { "uri": "file:///tmp/main.no", "text": "funksjon main()" } })
    la rpc_change = lsp_handle_request(server, "textDocument/didChange", "2b", { "textDocument": { "uri": "file:///tmp/main.no" }, "content": "funksjon main() feil" })
    la rpc_hover = lsp_handle_request(server, "textDocument/hover", "3", { "symbol": "main" })
    la rpc_shutdown = lsp_handle_request(server, "shutdown", "6", {})
    la rpc_exit = lsp_handle_request(server, "exit", "7", {})
    la batch = lsp_handle_batch(server, [
        { "method": "initialize", "id": "10", "params": {} },
        { "method": "textDocument/didOpen", "id": "11", "params": { "textDocument": { "uri": "file:///tmp/batch.no", "text": "funksjon main()" } } },
        { "method": "textDocument/hover", "id": "12", "params": { "symbol": "main" } }
    ])
    la session = lsp_handle_session(server, [
        { "method": "textDocument/didOpen", "id": "13", "params": { "textDocument": { "uri": "file:///tmp/session.no", "text": "returner a" } } },
        { "method": "textDocument/didChange", "id": "14", "params": { "textDocument": { "uri": "file:///tmp/session.no" }, "content": "funksjon main()" } }
    ])

    hvis builtin.contains(rpc_init, "hoverProvider") == usann
        returner usann
    slutt

    hvis builtin.contains(rpc_open, "\"result\":null") == usann
        returner usann
    slutt

    hvis builtin.contains(rpc_change, "\"result\":null") == usann
        returner usann
    slutt

    hvis lengde(server.diagnostics["file:///tmp/main.no"]) < 1
        returner usann
    slutt

    hvis lsp_document_version(server, "file:///tmp/main.no") < 1
        returner usann
    slutt

    la version_before_change = lsp_document_version(server, "file:///tmp/main.no")
    lsp_open_document(server, "file:///tmp/main.no", "funksjon main()")
    hvis lsp_document_version(server, "file:///tmp/main.no") <= version_before_change
        returner usann
    slutt

    la diag2 = lsp_handle_request(server, "textDocument/didOpen", "8", { "textDocument": { "uri": "file:///tmp/missing.no", "text": "skriv \"hei\"" } })
    hvis builtin.contains(diag2, "\"result\":null") == usann
        returner usann
    slutt

    la notif = lsp_format_diagnostics_notification("file:///tmp/missing.no", server.diagnostics["file:///tmp/missing.no"])
    hvis builtin.contains(notif, "textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis lengde(server.diagnostics["file:///tmp/missing.no"]) < 1
        returner usann
    slutt

    la bad = lsp_handle_request(server, "textDocument/didOpen", "9", { "textDocument": { "uri": "file:///tmp/bad.no", "text": "returner a" } })
    hvis builtin.contains(bad, "\"result\":null") == usann
        returner usann
    slutt

    hvis lengde(server.diagnostics["file:///tmp/bad.no"]) < 1
        returner usann
    slutt

    hvis builtin.contains(rpc_hover, "main") == usann
        returner usann
    slutt

    hvis builtin.contains(rpc_shutdown, "\"result\":null") == usann
        returner usann
    slutt

    hvis rpc_exit != ""
        returner usann
    slutt

    hvis lengde(batch) != 3
        returner usann
    slutt

    hvis lengde(lsp_demo_requests()) != 7
        returner usann
    slutt

    hvis lengde(session.notifications) != 2
        returner usann
    slutt

    hvis lengde(session.methods) != 2
        returner usann
    slutt

    hvis builtin.contains(session.notifications[0], "textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis builtin.contains(batch[0], "hoverProvider") == usann
        returner usann
    slutt

    hvis builtin.contains(batch[2], "main") == usann
        returner usann
    slutt

    la trace = lsp_trace_batch([
        { "method": "initialize", "id": "10", "params": {} },
        { "method": "textDocument/hover", "id": "11", "params": { "symbol": "main" } }
    ], batch)
    hvis lengde(trace) != 2
        returner usann
    slutt

    hvis builtin.contains(trace[0], "#") == usann
        returner usann
    slutt

    la summary = lsp_session_summary(session)
    hvis builtin.contains(summary, "responses=") == usann
        returner usann
    slutt

    hvis builtin.contains(summary, "diagnostics=") == usann
        returner usann
    slutt

    hvis builtin.contains(summary, "methods=") == usann
        returner usann
    slutt

    hvis builtin.contains(summary, "version_events=") == usann
        returner usann
    slutt

    hvis builtin.contains(summary, "methods=7") == usann
        returner usann
    slutt

    hvis lengde(server.methods) < 2
        returner usann
    slutt

    hvis builtin.contains(probe_summary, "ok=") == usann
        returner usann
    slutt

    hvis builtin.contains(probe_summary, "Dokumentet") == usann og builtin.contains(probe_summary, "OK") == usann
        returner usann
    slutt

    hvis builtin.contains(document_summary, "documents=") == usann
        returner usann
    slutt

    hvis builtin.contains(document_summary, "versions=") == usann
        returner usann
    slutt

    hvis builtin.contains(state_summary, "documents=") == usann
        returner usann
    slutt

    hvis builtin.contains(state_summary, "methods_seen=") == usann
        returner usann
    slutt

    hvis builtin.contains(state_summary, "notifications_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(state_summary, "notifications_overview=") == usann
        returner usann
    slutt

    hvis builtin.contains(caps_summary, "hoverProvider=true") == usann
        returner usann
    slutt

    hvis builtin.contains(protocol_summary, "protocol=JSON-RPC") == usann
        returner usann
    slutt

    hvis builtin.contains(protocol_summary, "notifications=textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis builtin.contains(protocol_summary, "notifications_count=") == usann
        returner usann
    slutt

    hvis builtin.contains(protocol_summary, "notifications_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(protocol_summary, "notifications_overview=") == usann
        returner usann
    slutt

    hvis builtin.contains(lsp_stream_source_summary("", json_skriv(lsp_demo_requests())), "stream_source=NORSCODE_LSP_PAYLOAD") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "transport=batch/session,json-batch-stdio,content-length") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "io=json-batch-stdio,content-length") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "stream_source=NORSCODE_LSP_PAYLOAD") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "stream_mode=hybrid") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "stream_overview=chunks=2") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "framing=json-batch+content-length") == usann
        returner usann
    slutt

    hvis builtin.contains(protocol_summary, "methods=") == usann
        returner usann
    slutt

    hvis builtin.contains(notifications_summary, "notifications=textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis builtin.contains(transport_summary, "json-batch-stdio") == usann
        returner usann
    slutt

    hvis builtin.contains(methods_summary, "initialize") == usann
        returner usann
    slutt

    hvis builtin.contains(methods_summary, "textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis builtin.contains(route_summary, "textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis builtin.contains(io_summary, "json-batch-stdio") == usann
        returner usann
    slutt

    hvis builtin.contains(framing_summary, "framing=") == usann
        returner usann
    slutt

    hvis builtin.contains(entrypoint_summary, "lsp_stdio_main") == usann
        returner usann
    slutt

    la raw_payload = "[{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}]"
    la framed_payload = "Content-Length: 46\r\n\r\n[{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}]"
    la multi_framed_payload = framed_payload + "\r\nContent-Length: 46\r\n\r\n[{\"method\":\"initialize\",\"id\":\"2\",\"params\":{}}]"
    la padded_payload = "   " + framed_payload + "   "
    la stdin_requests = lsp_requests_from_stdin(raw_payload)
    la stdin_single_request = lsp_requests_from_stdin("{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}")
    la framed_requests = lsp_requests_from_stdin(framed_payload)
    la multi_framed_requests = lsp_requests_from_stdin(multi_framed_payload)
    la padded_requests = lsp_requests_from_stdin(padded_payload)
    la raw_input_mode = lsp_input_mode_summary(raw_payload)
    la framed_input_mode = lsp_input_mode_summary(framed_payload)
    la stream_payloads = lsp_stream_payloads_from_text(json_skriv([
        "{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}",
        "{\"method\":\"shutdown\",\"id\":\"2\",\"params\":{}}"
    ]))
    la newline_stream_payloads = lsp_stream_payloads_from_text("{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}\n{\"method\":\"shutdown\",\"id\":\"2\",\"params\":{}}")
    la stream_run = lsp_run_stream_payloads(lsp_server(), stream_payloads)
    la stream_summary = lsp_stream_summary(stream_payloads)
    la none_stream_summary = lsp_stream_summary(null)
    la stream_mode = lsp_stream_mode_summary(stream_payloads)
    la none_stream_mode = lsp_stream_mode_summary(null)
    la stream_source = lsp_stream_source_summary("[{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}]\n[{\"method\":\"shutdown\",\"id\":\"2\",\"params\":{}}]", "")
    la combined_source = lsp_stream_source_summary("stream", "payload")
    la empty_stream_source = lsp_stream_source_summary(null, null)
    la combined_mode_inputs = builtin.split("a b", " ")
    la joined_payload_inputs = builtin.split("a b", " ")
    la empty_joined_payload_inputs = builtin.split("", "\n")
    la combined_mode = lsp_stream_mode_summary(combined_mode_inputs)
    la joined_payloads = lsp_join_payloads(joined_payload_inputs)
    la empty_joined_payloads = lsp_join_payloads(empty_joined_payload_inputs)
    la none_notification_type = lsp_notification_type_summary(null)
    la empty_notifications_session = { notifications: [] }
    la stream_overview = lsp_stream_overview_summary(stream_payloads, stream_run)
    la stream_overview_none = lsp_stream_overview_summary(null, null)
    la stream_chunk_count = lsp_stream_chunk_count_summary(stream_payloads)
    la stream_chunk_count_none = lsp_stream_chunk_count_summary(null)
    la stream_transport_report = ""
    la decode_fallback_report = lsp_stdio_report_summary("garbage", [])
    la empty_transport_report = lsp_transport_probe_summary("", null)
    la batch_kind = lsp_request_kind_summary([
        { "method": "initialize", "id": "1", "params": {} },
        { "method": "shutdown", "id": "2", "params": {} }
    ])
    la none_kind = lsp_request_kind_summary(null)
    la single_kind = lsp_request_kind_summary([
        { "method": "initialize", "id": "1", "params": {} }
    ])

    hvis lengde(stdin_requests) != 1
        returner usann
    slutt

    hvis lengde(stdin_single_request) != 1
        returner usann
    slutt

    hvis lengde(framed_requests) != 1
        returner usann
    slutt

    hvis lengde(multi_framed_requests) != 2
        returner usann
    slutt

    hvis lengde(padded_requests) != 1
        returner usann
    slutt

    hvis builtin.contains(raw_input_mode, "input_mode=raw-json") == usann
        returner usann
    slutt

    hvis builtin.contains(framed_input_mode, "input_mode=content-length") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_summary, "stream_chunks=2") == usann
        returner usann
    slutt

    hvis builtin.contains(none_stream_summary, "stream=none") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_mode, "stream_mode=stream") == usann
        returner usann
    slutt

    hvis builtin.contains(none_stream_mode, "stream_mode=none") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_chunk_count, "stream_chunk_count=2") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_chunk_count_none, "stream_chunk_count=0") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_source, "stream_source=NORSCODE_LSP_STREAM") == usann
        returner usann
    slutt

    hvis builtin.contains(combined_source, "stream_source=NORSCODE_LSP_STREAM+NORSCODE_LSP_PAYLOAD") == usann
        returner usann
    slutt

    hvis builtin.contains(empty_stream_source, "stream_source=empty") == usann
        returner usann
    slutt

    hvis builtin.contains(combined_mode, "stream_mode=hybrid") == usann
        returner usann
    slutt

    hvis joined_payloads != "a\nb"
        returner usann
    slutt

    hvis empty_joined_payloads != ""
        returner usann
    slutt

    hvis builtin.contains(none_notification_type, "notification=unknown") == usann
        returner usann
    slutt

    hvis builtin.contains(lsp_notifications_overview_summary(empty_notifications_session), "notifications_count=0") == usann
        returner usann
    slutt

    hvis builtin.contains(lsp_notifications_overview_summary(empty_notifications_session), "notifications_health=idle") == usann
        returner usann
    slutt

    hvis lengde(newline_stream_payloads) != 2
        returner usann
    slutt

    hvis builtin.contains(lsp_stream_summary(newline_stream_payloads), "stream_chunks=2") == usann
        returner usann
    slutt

    hvis stream_run == null
        returner usann
    slutt

    stream_transport_report = lsp_transport_probe_summary(json_skriv(stream_payloads), stream_run.methods)

    hvis lengde(stream_run.responses) != 2
        returner usann
    slutt

    hvis builtin.contains(stream_overview, "stream_overview=chunks=2") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_overview, "requests=2") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_overview_none, "stream_overview=none") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_overview, "responses=2") == usann
        returner usann
    slutt

    hvis builtin.contains(stream_transport_report, "request_kind=batch") == usann
        returner usann
    slutt

    hvis builtin.contains(stdin_summary, "stdin_bytes=") == usann
        returner usann
    slutt

    hvis builtin.contains(transport_report, "transport_report=") == usann
        returner usann
    slutt

    hvis builtin.contains(transport_report, "stage=") == usann
        returner usann
    slutt

    hvis builtin.contains(decode_fallback_report, "stage=decode-fallback") == usann
        returner usann
    slutt

    hvis builtin.contains(empty_transport_report, "stage=fallback") == usann
        returner usann
    slutt

    hvis builtin.contains(empty_transport_report, "request_kind=none") == usann
        returner usann
    slutt

    hvis builtin.contains(batch_kind, "request_kind=batch") == usann
        returner usann
    slutt

    hvis builtin.contains(none_kind, "request_kind=none") == usann
        returner usann
    slutt

    hvis builtin.contains(single_kind, "request_kind=single") == usann
        returner usann
    slutt

    hvis builtin.contains(lsp_extract_body_from_framed_payload("Content-Length: 46\r\n\r\n[{\"method\":\"initialize\",\"id\":\"1\",\"params\":{}}]"), "\"method\":\"initialize\"") == usann
        returner usann
    slutt

    hvis builtin.contains(messages_summary, "messages=") == usann
        returner usann
    slutt

    hvis builtin.contains(session_methods_summary, "session_methods=") == usann
        returner usann
    slutt

    hvis builtin.contains(activity_summary, "messages=") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "notifications_count=") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "notifications_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(status_bundle, "notifications_count=") == usann
        returner usann
    slutt

    hvis builtin.contains(activity_health_summary, "activity_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(overall_health_summary, "document_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(overall_health_summary, "notifications_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(top_status_summary, "top_status=") == usann
        returner usann
    slutt

    hvis builtin.contains(banner_summary, "banner=") == usann
        returner usann
    slutt

    hvis builtin.contains(input_mode_summary, "input_mode=") == usann
        returner usann
    slutt

    hvis builtin.contains(banner_summary, "banner=klar") == usann og builtin.contains(banner_summary, "banner=delvis") == usann og builtin.contains(banner_summary, "banner=uklar") == usann
        returner usann
    slutt

    hvis builtin.contains(full_summary, "full=ok") == usann
        returner usann
    slutt

    hvis builtin.contains(doc_exists_summary, "document_exists=true") == usann
        returner usann
    slutt

    hvis builtin.contains(doc_version_summary, "document_version=") == usann
        returner usann
    slutt

    hvis builtin.contains(notification_type_summary, "textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis builtin.contains(output_summary, "output=") == usann
        returner usann
    slutt

    hvis builtin.contains(document_health_summary, "document_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(document_health_state_summary, "document_health_state=") == usann
        returner usann
    slutt

    hvis builtin.contains(document_versions_summary, "document_versions=") == usann
        returner usann
    slutt

    hvis builtin.contains(latest_document_version_summary, "latest_document_version=") == usann
        returner usann
    slutt

    hvis builtin.contains(version_health_summary, "version_health=") == usann
        returner usann
    slutt

    hvis builtin.contains(route_summary, "routes=") == usann
        returner usann
    slutt

    hvis builtin.contains(route_summary, "textDocument/publishDiagnostics") == usann
        returner usann
    slutt

    hvis lsp_main() != sann
        returner usann
    slutt

    hvis builtin.contains("LSP demo-runner starta", "LSP demo-runner") == usann
        returner usann
    slutt

    returner sann
slutt

funksjon hoved()
    hvis lsp_stdio_main()
        returner sann
    ellers
        returner usann
    slutt
slutt

funksjon main()
    returner hoved()
slutt

funksjon start()
    hvis hoved()
        returner 0
    slutt
    returner 1
slutt
