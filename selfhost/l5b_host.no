// Minimal Norscode-host for L5b.
//
// Denne entrypointen blir bundla saman med compiler, VM og bundler. Han
// unngår at L5b må gå gjennom stage0 sin statisk genererte nc_main/VM-flate.

bruk selfhost.kompiler som komp

funksjon kompiler_kjeldekandidat() -> heiltall {
    la kjelde_sti = miljo_hent("NORSCODE_L5B_COMPILE_SOURCE")
    la utfil = miljo_hent("NORSCODE_L5B_COMPILE_OUTPUT")
    la modul = miljo_hent("NORSCODE_L5B_COMPILE_MODULE")
    hvis kjelde_sti == "" eller utfil == "" eller modul == "" {
        skriv("Feil: ufullstendig L5b source-compile miljø\n")
        returner 1
    }
    la resultat = ""
    prøv {
        resultat = komp.kompiler_fil(fil_les(kjelde_sti), modul)
    } fang melding {
        skriv("Feil: Gen1-kompilering av " + modul + ": " + tekst(melding) + "\n")
        returner 1
    }
    hvis resultat == "" {
        skriv("Feil: Gen1-kompilatoren returnerte tom NCB for " + modul + "\n")
        returner 1
    }
    fil_skriv(utfil, resultat)
    skriv("[L5b-source] " + modul + " → " + utfil + " (" + tekst_fra_heltall(lengde(resultat)) + " bytes)\n")
    returner 0
}

funksjon start() -> heiltall {
    hvis miljo_hent("NORSCODE_L5B_COMPILE_SOURCE") != "" {
        returner kompiler_kjeldekandidat()
    }
    la v1 = miljo_hent("NORSCODE_L5B_V1")
    la v2 = miljo_hent("NORSCODE_L5B_V2")
    la args_str = miljo_hent("NORSCODE_BUNDLE_ARGS")
    hvis v1 == "" eller v2 == "" {
        skriv("Feil: NORSCODE_L5B_V1/V2 ikkje sett\n")
        returner 1
    }

    la modular: liste = []
    la delar = builtin.split(args_str, " ")
    la i: heiltall = 0
    mens i < lengde(delar) {
        la del = builtin.trim(delar[i])
        hvis del != "" { legg_til(modular, del) }
        i = i + 1
    }

    skriv("[L5b-2] Bundle via Gen1-bytekode (bygg_bundle i NCB) → " + v2 + "\n")
    la ncb = builtin.json_parse_raw(fil_les(v1))
    la fns = ncb["functions"]
    hvis fns == null {
        skriv("Feil: manglar functions i v1 NCB\n")
        returner 1
    }

    fns["__vm_inherit_env__"] = "sann"
    builtin.ncb_call_fn("selfhost.vm.vm_runtime_init", fns, sann)
    la args: liste = []
    legg_til(args, modular)
    legg_til(args, v2)

    prøv {
        builtin.ncb_call_fn("selfhost.vm.køyr_funksjon", "selfhost.bundler.bygg_bundle", args, fns, 0)
        skriv("[L5b-2] bygg_bundle returnerte.\n")
    } fang melding {
        skriv("Feil i l5b-host: " + melding + "\n")
        returner 1
    }
    hvis ikkje builtin.fil_finnes(v2) {
        skriv("Feil i l5b-host: bygg_bundle returnerte utan kandidatfil\n")
        returner 1
    }
    returner 0
}
