// selfhost/nc_main.no — Norscode inngangspunkt (erstatter archive/legacy_c_backend/nc_native_main.c)
//
// Handterar NORSCODE_CMD og NORSCODE_FILE miljøvariablar.
// Kompilerer via selfhost-pipeline; køyring går via selfhost.vm (utan C-host).

bruk selfhost.kompiler som komp
bruk selfhost.json
bruk selfhost.bundler
bruk selfhost.vm
bruk std.socket som sok
bruk std.runtime_filesystem som native_fs
bruk selfhost.http_response som http_response

// ─── Kompiler kjeldekode-fil til NCB ─────────────────────────────────────────

funksjon nc_kompiler_fil(src_sti: tekst, modul: tekst) -> tekst {
    la kjelde = fil_les(src_sti)
    returner komp.kompiler_fil(kjelde, modul)
}

// ─── Køyr NCB via selfhost/vm.no (utan C-host) ────────────────────────────────

funksjon nc_runtime_trace(melding: tekst) -> heiltall {
    hvis miljo_hent("NORSCODE_RUNTIME_TRACE") == "1" {
        skriv("[NC-RUNTIME] " + melding + "\n")
    }
    returner 0
}

funksjon nc_køyr_ncb_json_modus(ncb_json: tekst, rask_verktøymodus: boolsk) -> tekst {
    nc_runtime_trace("json parse start")
    la ncb = null
    prøv {
        // Moderne compiler-NCB er allereie streng JSON. Parse han direkte;
        // den eldre kontrollteiknnormaliseringa er berre ein kompatibilitets-
        // fallback og skal ikkje kopiere kvar gyldige fleirmegabyte-NCB.
        ncb = json_parse_raw(ncb_json)
    } fang (første_parsefeil) {
        nc_runtime_trace("raw parse feila; normalize fallback start bytes=" +
                         tekst_fra_heltall(lengde(ncb_json)))
        ncb_json = normaliser_json_kontrollteikn(ncb_json)
        nc_runtime_trace("normalize fallback done bytes=" +
                         tekst_fra_heltall(lengde(ncb_json)))
        ncb = json_parse_raw(ncb_json)
    }
    nc_runtime_trace("json parse done")
    hvis ncb == null {
        skriv("Feil: ugyldig NCB-json\n")
        returner 1
    }

    la entry = ncb["entry"]
    la fns = ncb["functions"]
    hvis entry == null eller fns == null {
        skriv("Feil: manglar entry/functions i NCB\n")
        returner 1
    }
    hvis rask_verktøymodus { fns["__vm_force_fast__"] = "sann" }

    prøv {
        nc_runtime_trace("vm start entry=" + tekst(entry) +
                         " functions=" + tekst_fra_heltall(lengde(nøkler(fns))))
        returner køyr_ncb(ncb)
    } fang melding {
        skriv("ERROR: " + melding + "\n")
        returner 1
    }
}

funksjon nc_køyr_ncb_json(ncb_json: tekst) -> tekst {
    returner nc_køyr_ncb_json_modus(ncb_json, usann)
}

// ─── NORSCODE_CMD=serve (native runtime) ──────────────────────────────────

funksjon path_segments(path: tekst) -> liste<tekst> {
    la segments = builtin.split(path, "/")
    hvis lengde(segments) > 0 og segments[0] == "" {
        fjern(segments, 0)
    }
    la len = lengde(segments)
    hvis len > 0 og segments[len - 1] == "" {
        fjern(segments, len - 1)
    }
    returner segments
}

funksjon is_int_text(v: tekst) -> boolsk {
    hvis v == "" {
        returner usann
    }
    la i: heltall = 0
    mens i < lengde(v) {
        la tegn = builtin.slice(v, i, i + 1)
        hvis tegn < "0" eller tegn > "9" {
            hvis i == 0 og tegn == "-" {
                i = i + 1
                fortsett
            }
            returner usann
        }
        i = i + 1
    }
    returner sann
}

funksjon path_match(pattern: tekst, sti: tekst) -> ordbok<tekst, tekst> {
    la params: ordbok<tekst, tekst> = {}
    la pattern_delar = path_segments(pattern)
    la sti_delar = path_segments(sti)
    hvis lengde(pattern_delar) != lengde(sti_delar) {
        returner {}
    }

    la i: heiltall = 0
    mens i < lengde(pattern_delar) {
        la p = pattern_delar[i]
        la v = sti_delar[i]
        hvis builtin.starts_with(p, "{") og builtin.ends_with(p, "}") {
            la innvendig = builtin.slice(p, 1, lengde(p) - 1)
            la kolon = builtin.index_of(innvendig, ":")
            hvis kolon < 0 {
                returner {}
            }
            la namn = builtin.slice(innvendig, 0, kolon)
            la type_tekst = builtin.slice(innvendig, kolon + 1, lengde(innvendig))
            hvis type_tekst == "int" {
                hvis is_int_text(v) {
                    params[namn] = v
                } ellers {
                    returner {}
                }
            } ellers {
                params[namn] = v
            }
        } ellers hvis p != v {
            returner {}
        }
        i = i + 1
    }
    params["__path_match__"] = sann
    returner params
}

funksjon parse_query(raw_query: tekst) -> ordbok<tekst, tekst> {
    la query: ordbok<tekst, tekst> = {}
    hvis raw_query == "" {
        returner query
    }

    la delar = builtin.split(raw_query, "&")
    la i = 0
    mens i < lengde(delar) {
        la p = builtin.trim(delar[i])
        hvis p != "" {
            la eq = builtin.index_of(p, "=")
            hvis eq == -1 {
                query[p] = ""
            } ellers {
                query[builtin.trim(builtin.slice(p, 0, eq))] = builtin.trim(builtin.slice(p, eq + 1, lengde(p)))
            }
        }
        i = i + 1
    }
    returner query
}

funksjon parse_http_request(raw: tekst) -> ordbok<tekst, tekst> {
    // Del hovud og kropp før headernormalisering. Dette bevarer CR- og
    // linjeskiftbyte i multipartfiler og andre binære request-kroppar.
    la header_end = builtin.index_of(raw, "\r\n\r\n")
    la separator_bytes = 4
    hvis header_end < 0 {
        header_end = builtin.index_of(raw, "\n\n")
        separator_bytes = 2
    }
    la header_raw = raw
    la body = ""
    hvis header_end >= 0 {
        header_raw = builtin.slice(raw, 0, header_end)
        body = builtin.slice(raw, header_end + separator_bytes, lengde(raw))
    }
    la normalisert = builtin.replace(header_raw, "\r", "")
    la lines = builtin.split(normalisert, "\n")
    hvis lengde(lines) == 0 {
        returner {
            "method": "GET",
            "path": "/",
            "query": {},
            "headers": {},
            "body": ""
        }
    }

    la first = builtin.trim(lines[0])
    hvis first == "" {
        returner {
            "method": "GET",
            "path": "/",
            "query": {},
            "headers": {},
            "body": ""
        }
    }

    la deler = builtin.split(first, " ")
    la method = "GET"
    la path = "/"
    hvis lengde(deler) > 0 { method = builtin.trim(deler[0]) }
    hvis lengde(deler) > 1 { path = builtin.trim(deler[1]) }

    la qi = builtin.index_of(path, "?")
    la q = ""
    hvis qi >= 0 {
        q = builtin.slice(path, qi + 1, lengde(path))
        path = builtin.slice(path, 0, qi)
    }

    la headers: ordbok<tekst, tekst> = {}
    la i = 1
    mens i < lengde(lines) {
        la line = builtin.trim(lines[i])
        la colon = builtin.index_of(line, ":")
        hvis colon > 0 {
            la key = builtin.trim(builtin.slice(line, 0, colon))
            la value = builtin.trim(builtin.slice(line, colon + 1, lengde(line)))
            headers[key] = value
        }
        i = i + 1
    }

    returner {
        "method": method,
        "path": path,
        "query": parse_query(q),
        "headers": headers,
        "body": body
    }
}

funksjon serve_request_content_length(raw: tekst) -> heiltall {
    la header_end = builtin.index_of(raw, "\r\n\r\n")
    hvis header_end < 0 { header_end = builtin.index_of(raw, "\n\n") }
    hvis header_end < 0 { returner -1 }
    la header_raw = builtin.replace(builtin.slice(raw, 0, header_end), "\r", "")
    la lines = builtin.split(header_raw, "\n")
    la i: heiltall = 1
    mens i < lengde(lines) {
        la line = lines[i]
        la colon = builtin.index_of(line, ":")
        hvis colon > 0 {
            la key = builtin.lower(builtin.trim(builtin.slice(line, 0, colon)))
            hvis key == "content-length" {
                la value = builtin.trim(builtin.slice(line, colon + 1, lengde(line)))
                hvis is_int_text(value) { returner heiltall_fra_tekst(value) }
                returner -2
            }
        }
        i = i + 1
    }
    returner 0
}

funksjon serve_request_total_length(raw: tekst, content_length: heiltall) -> heiltall {
    la header_end = builtin.index_of(raw, "\r\n\r\n")
    la separator_bytes = 4
    hvis header_end < 0 {
        header_end = builtin.index_of(raw, "\n\n")
        separator_bytes = 2
    }
    hvis header_end < 0 { returner -1 }
    returner header_end + separator_bytes + content_length
}

funksjon serve_max_request_bytes() -> heiltall {
    // Standardgrensa rommar ein 20 MiB fil og multipart-headerar.
    la configured = miljo_hent("NC_SERVE_MAX_REQUEST_BYTES")
    hvis configured != "" og is_int_text(configured) {
        la value = heiltall_fra_tekst(configured)
        hvis value >= 65536 { returner value }
    }
    returner 22020096
}

funksjon serve_receive_request(conn) -> ordbok<tekst, tekst> {
    la max_bytes = serve_max_request_bytes()
    la raw = sok.motta(conn, 65536)
    hvis lengde(raw) == 0 {
        returner {"ok": usann, "status": 400, "raw": "", "error": "Tom request"}
    }

    la content_length = serve_request_content_length(raw)
    hvis content_length == -2 {
        returner {"ok": usann, "status": 400, "raw": "", "error": "Ugyldig Content-Length"}
    }
    hvis content_length < 0 {
        returner {"ok": usann, "status": 400, "raw": "", "error": "Ufullstendig HTTP-header"}
    }
    la total_length = serve_request_total_length(raw, content_length)
    hvis total_length < 0 {
        returner {"ok": usann, "status": 400, "raw": "", "error": "Ufullstendig HTTP-header"}
    }
    hvis total_length > max_bytes {
        returner {"ok": usann, "status": 413, "raw": "", "error": "Request er for stor"}
    }

    mens lengde(raw) < total_length {
        la remaining = total_length - lengde(raw)
        la chunk_size = 65536
        hvis remaining < chunk_size { chunk_size = remaining }
        la chunk = sok.motta(conn, chunk_size)
        hvis lengde(chunk) == 0 {
            returner {"ok": usann, "status": 400, "raw": "", "error": "Ufullstendig request-kropp"}
        }
        raw = raw + chunk
    }
    returner {"ok": sann, "status": 200, "raw": raw, "error": ""}
}

funksjon serve_receive_error(status: heiltall, message: tekst) -> tekst {
    la status_text = "Bad Request"
    hvis status == 413 { status_text = "Content Too Large" }
    la body = message
    returner "HTTP/1.1 " + tekst_fra_heltall(status) + " " + status_text +
        "\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: " +
        tekst_fra_heltall(lengde(body)) + "\r\nConnection: close\r\n\r\n" + body
}

funksjon response_to_http(res) -> tekst {
    returner http_response.response_to_http(res)
}


funksjon køyre_ncb_funksjon(funksjonsnavn: tekst, fn_args: liste, functions: ordbok<tekst, tekst>) -> tekst {
    hvis fn_args == null {
        fn_args = []
    }
    hvis ikke (functions != null) {
        returner 0
    }
    la svar = køyr_funksjon(funksjonsnavn, fn_args, functions, 0)
    returner svar
}

funksjon standard_helse_respons() -> ordbok<tekst, tekst> {
    returner {
        "status": 200,
        "content_type": "application/json; charset=utf-8",
        "cache_control": "no-store",
        "body": "{\"ok\":true,\"status\":\"ready\"}"
    }
}

funksjon standard_server_logg(ctx: ordbok<tekst, tekst>, status: heltall) -> ordbok<tekst, tekst> {
    la logg: ordbok<tekst, tekst> = {}
    la metode = ""
    la sti = ""
    la request_id = ""
    hvis ctx != null {
        hvis har_nokkel(ctx, "__method__") {
            metode = tekst(ctx["__method__"])
        }
        hvis har_nokkel(ctx, "__path__") {
            sti = tekst(ctx["__path__"])
        }
        hvis har_nokkel(ctx, "__request_id__") {
            request_id = tekst(ctx["__request_id__"])
        }
    }
    logg["request_id"] = request_id
    logg["method"] = builtin.upper(metode)
    logg["path"] = sti
    logg["status"] = tekst_fra_heltall(status)
    hvis status >= 200 og status < 400 {
        logg["ok"] = sann
    } ellers {
        logg["ok"] = usann
    }
    returner logg
}

funksjon bygg_trace(verdiar: liste<tekst>) -> liste<tekst> {
    la trace = []
    la i = 0
    mens i < lengde(verdiar) {
        legg_til(trace, verdiar[i])
        i = i + 1
    }
    returner trace
}

funksjon bygg_allow_liste(allowed_methods: ordbok<tekst, sann>) -> tekst {
    la allow_list = ""
    la am = nøkler(allowed_methods)
    la ai = 0
    la har_get = usann
    mens ai < lengde(am) {
        la m = builtin.upper(am[ai])
        hvis m == "GET" {
            har_get = sann
        }
        hvis allow_list != "" {
            allow_list = allow_list + ", "
        }
        allow_list = allow_list + m
        ai = ai + 1
    }
    hvis har_get og ikkje builtin.contains(allow_list, "HEAD") {
        hvis allow_list != "" {
            allow_list = allow_list + ", "
        }
        allow_list = allow_list + "HEAD"
    }
    hvis allow_list == "" {
        allow_list = "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
    }
    returner allow_list
}

funksjon bygg_feil_respons(status: heiltall, body: tekst) -> ordbok<tekst, tekst> {
    returner {"status": status, "body": body}
}

funksjon hent_header_tekst(headers: ordbok<tekst, tekst>, nøkkel_a: tekst, nøkkel_b: tekst) -> tekst {
    hvis headers == null {
        returner ""
    }
    hvis har_nokkel(headers, nøkkel_a) {
        returner tekst(headers[nøkkel_a])
    }
    hvis har_nokkel(headers, nøkkel_b) {
        returner tekst(headers[nøkkel_b])
    }
    returner ""
}

funksjon er_helse_rute(sti: tekst) -> boolsk {
    returner sti == "/helse" eller sti == "/health"
}

funksjon bygg_standard_helse_respons(ctx: ordbok<tekst, tekst>, req_method: tekst, ncb: ordbok<tekst, tekst>) -> ordbok<tekst, tekst> {
    la helse = standard_helse_respons()
    hvis req_method == "head" {
        helse["__head__"] = sann
    }
    la helselogg = standard_server_logg(ctx, 200)
    helse["__headers__"] = {"X-Server-Logg": json_skriv(helselogg)}
    helse = anvend_response_middlewares(ncb, helse)
    returner helse
}

funksjon avgjer_standard_handler_respons(ncb: ordbok<tekst, tekst>, parsed: ordbok<tekst, tekst>, svar, head_fallback: boolsk, request_if_modified_since: tekst, request_if_match: tekst) -> ordbok<tekst, tekst> {
    hvis head_fallback {
        returner response_to_http({"status": 200, "__head__": sann, "body": tekst(svar)})
    }
    la request_etag = hent_header_tekst(parsed["headers"], "If-None-Match", "if-none-match")
    hvis request_etag != "" og har_nokkel(svar, "etag") {
        la response_etag = tekst(svar["etag"])
        hvis response_etag != "" og response_etag == request_etag {
            returner response_to_http({"status": 304, "etag": response_etag, "body": ""})
        }
    }
    hvis request_if_modified_since != "" og har_nokkel(svar, "last_modified") {
        la response_last_modified = tekst(svar["last_modified"])
        hvis response_last_modified != "" og response_last_modified == request_if_modified_since {
            returner response_to_http({"status": 304, "last_modified": response_last_modified, "body": ""})
        }
    }
    hvis request_if_match != "" og har_nokkel(svar, "etag") {
        la response_etag = tekst(svar["etag"])
        hvis response_etag != "" og response_etag != request_if_match {
            la feil = bygg_feil_respons(412, "")
            feil["status_text"] = "Precondition Failed"
            feil = anvend_error_middlewares(ncb, feil)
            returner response_to_http(feil)
        }
    }
    hvis svar == null {
        returner response_to_http({"status": 204, "body": ""})
    }
    hvis har_nokkel(svar, "status") eller har_nokkel(svar, "__status__") eller har_nokkel(svar, "body") eller har_nokkel(svar, "__body__") eller har_nokkel(svar, "headers") eller har_nokkel(svar, "__headers__") eller har_nokkel(svar, "content_type") eller har_nokkel(svar, "__content_type__") eller har_nokkel(svar, "__head__") {
        returner response_to_http(svar)
    }
    hvis tekst(svar) == "" {
        returner response_to_http({"status": 204, "body": ""})
    }
    returner response_to_http({"status": 200, "body": tekst(svar)})
}

funksjon avgjer_route_respons(ncb: ordbok<tekst, tekst>, parsed: ordbok<tekst, tekst>, route_handlers: liste<ordbok<tekst, tekst>>, req_method: tekst, req_path: tekst) -> ordbok<tekst, tekst> {
    la found_path = usann
    la allowed_methods = {}
    la head_fallback = usann
    la request_if_modified_since = hent_header_tekst(parsed["headers"], "If-Modified-Since", "if-modified-since")
    la request_if_match = hent_header_tekst(parsed["headers"], "If-Match", "if-match")
    la i = 0
    mens i < lengde(route_handlers) {
        la item = route_handlers[i]
        la spec = item["spec"]
        la deler = builtin.split(spec, " ")
        hvis lengde(deler) >= 2 {
            la item_method = builtin.lower(deler[0])
            la item_path = deler[1]
            la params = path_match(item_path, req_path)
            hvis har_nokkel(params, "__path_match__") {
                found_path = sann
                hvis ikkje har_nokkel(allowed_methods, item_method) {
                    allowed_methods[item_method] = sann
                }
                hvis item_method == req_method eller (req_method == "head" og item_method == "get") {
                    hvis req_method == "head" og item_method == "get" {
                        head_fallback = sann
                    }
                    la ctx = {}
                    la qn = nøkler(parsed)
                    la qi = 0
                    mens qi < lengde(qn) {
                        la k = qn[qi]
                        la v = parsed[k]
                        hvis k == "query" {
                            ctx["__query__"] = v
                        } ellers hvis k == "headers" {
                            ctx["__headers__"] = v
                        } ellers hvis k == "body" {
                            ctx["__body__"] = v
                        } ellers hvis k == "path" {
                            ctx["__path__"] = v
                        } ellers {
                            ctx[k] = v
                        }
                        qi = qi + 1
                    }
                    ctx["__method__"] = req_method
                    ctx["__params__"] = params
                    la guards = item["guards"]
                    hvis guards != null {
                        la gi = 0
                        mens gi < lengde(guards) {
                            la guard_namn = guards[gi]
                            la guard_fn = guard_namn
                            hvis ikkje builtin.contains(guard_namn, ".") {
                                guard_fn = "__main__." + guard_namn
                            }
                    la guard_args: liste = [ctx]
                            la guard_result = køyre_ncb_funksjon(guard_fn, guard_args, ncb["functions"])
                            hvis ikkje guard_result {
                                la feil = bygg_feil_respons(403, "Forbidden")
                                feil = anvend_error_middlewares(ncb, feil)
                                returner response_to_http(feil)
                            }
                            gi = gi + 1
                        }
                    }
                    la handler = item["function"]
                    hvis ikkje builtin.contains(handler, ".") {
                        handler = "__main__." + handler
                    }
                    la handler_args: liste = [ctx]
                    la svar = null
                    prøv {
                        svar = køyre_ncb_funksjon(handler, handler_args, ncb["functions"])
                    } fang (e) {
                        la feil = bygg_feil_respons(500, tekst(e))
                        feil = anvend_error_middlewares(ncb, feil)
                        returner response_to_http(feil)
                    }
                    returner avgjer_standard_handler_respons(ncb, parsed, svar, head_fallback, request_if_modified_since, request_if_match)
                }
            }
        }
        i = i + 1
    }

    hvis req_method == "options" {
        la allow_list = bygg_allow_liste(allowed_methods)
        returner response_to_http({"status": 204, "body": "", "__headers__": {"Allow": allow_list}})
    }

    hvis found_path {
        la allow_list = bygg_allow_liste(allowed_methods)
        la feil = {"status": 405, "body": "Method Not Allowed", "__headers__": {"Allow": allow_list}}
        feil = anvend_error_middlewares(ncb, feil)
        returner response_to_http(feil)
    }

    la feil = bygg_feil_respons(404, "Ikkje funne: " + req_method + " " + req_path)
    feil = anvend_error_middlewares(ncb, feil)
    returner response_to_http(feil)
}

funksjon anvend_response_middlewares(ncb: ordbok<tekst, tekst>, response: ordbok<tekst, tekst>) -> ordbok<tekst, tekst> {
    hvis ncb == null eller response == null {
        returner response
    }
    la middlewares = ncb["response_middlewares"]
    hvis middlewares == null {
        returner response
    }
    la current = response
    la trace = bygg_trace(middlewares)
    la i = 0
    mens i < lengde(trace) {
        la mw_namn = tekst(trace[i])
        hvis mw_namn != "" {
            la mw_fn = mw_namn
            hvis ikkje builtin.contains(mw_namn, ".") {
                mw_fn = "__main__." + mw_namn
            }
            la mw_args: liste = [current]
            la mw_result = køyre_ncb_funksjon(mw_fn, mw_args, ncb["functions"])
            hvis har_nokkel(mw_result, "status") eller har_nokkel(mw_result, "__status__") eller har_nokkel(mw_result, "body") eller har_nokkel(mw_result, "__body__") eller har_nokkel(mw_result, "headers") eller har_nokkel(mw_result, "__headers__") {
                current = mw_result
            }
        }
        i = i + 1
    }
    returner current
}

funksjon anvend_request_middlewares(ncb: ordbok<tekst, tekst>, ctx: ordbok<tekst, tekst>) -> ordbok<tekst, tekst> {
    hvis ncb == null eller ctx == null {
        returner ctx
    }
    la middlewares = ncb["request_middlewares"]
    hvis middlewares == null {
        returner ctx
    }
    la current = ctx
    la trace = bygg_trace(middlewares)
    la i = 0
    mens i < lengde(trace) {
        la mw_namn = tekst(trace[i])
        hvis mw_namn != "" {
            la mw_fn = mw_namn
            hvis ikkje builtin.contains(mw_namn, ".") {
                mw_fn = "__main__." + mw_namn
            }
            la mw_args: liste = [current]
            la mw_result = køyre_ncb_funksjon(mw_fn, mw_args, ncb["functions"])
            hvis har_nokkel(mw_result, "__method__") eller har_nokkel(mw_result, "__path__") eller har_nokkel(mw_result, "__headers__") eller har_nokkel(mw_result, "__query__") eller har_nokkel(mw_result, "__body__") eller har_nokkel(mw_result, "__params__") {
                current = mw_result
            }
        }
        i = i + 1
    }
    returner current
}

funksjon anvend_error_middlewares(ncb: ordbok<tekst, tekst>, response: ordbok<tekst, tekst>) -> ordbok<tekst, tekst> {
    hvis ncb == null eller response == null {
        returner response
    }
    la middlewares = ncb["error_middlewares"]
    hvis middlewares == null {
        returner response
    }
    la current = response
    la trace = bygg_trace(middlewares)
    la i = 0
    mens i < lengde(trace) {
        la mw_namn = tekst(trace[i])
        hvis mw_namn != "" {
            la mw_fn = mw_namn
            hvis ikkje builtin.contains(mw_namn, ".") {
                mw_fn = "__main__." + mw_namn
            }
            la mw_args: liste = [current]
            la mw_result = køyre_ncb_funksjon(mw_fn, mw_args, ncb["functions"])
            hvis har_nokkel(mw_result, "status") eller har_nokkel(mw_result, "__status__") eller har_nokkel(mw_result, "body") eller har_nokkel(mw_result, "__body__") eller har_nokkel(mw_result, "headers") eller har_nokkel(mw_result, "__headers__") {
                current = mw_result
            }
        }
        i = i + 1
    }
    returner current
}

funksjon køyre_livssyklus_hooks(ncb: ordbok<tekst, tekst>, hook_nøkkel: tekst) -> heiltall {
    hvis ncb == null eller hook_nøkkel == "" {
        returner 0
    }
    la hooks = ncb[hook_nøkkel]
    hvis hooks == null {
        returner 0
    }
    la køyrde = 0
    la trace = bygg_trace(hooks)
    la i = 0
    mens i < lengde(trace) {
        la hook_namn = tekst(trace[i])
        hvis hook_namn != "" {
            la hook_fn = hook_namn
            hvis ikkje builtin.contains(hook_namn, ".") {
                hook_fn = "__main__." + hook_namn
            }
            la hook_args: liste = []
            køyre_ncb_funksjon(hook_fn, hook_args, ncb["functions"])
            køyrde = køyrde + 1
        }
        i = i + 1
    }
    returner køyrde
}

funksjon køyre_livssyklus_hooks_trygt(ncb: ordbok<tekst, tekst>, hook_nøkkel: tekst) -> ordbok<tekst, tekst> {
    prøv {
        la tal = køyre_livssyklus_hooks(ncb, hook_nøkkel)
        returner {
            "ok": sann,
            "hook": hook_nøkkel,
            "count": tal,
            "error": ""
        }
    } fang (e) {
        returner {
            "ok": usann,
            "hook": hook_nøkkel,
            "count": 0,
            "error": tekst(e)
        }
    }
}

funksjon serve_handle_one(ncb: ordbok<tekst, tekst>, rå: tekst) -> tekst {
    la parsed = parse_http_request(rå)
    la ctx: ordbok<tekst, tekst> = {
        "__method__": builtin.lower(parsed["method"]),
        "__path__": parsed["path"],
        "__query__": parsed["query"],
        "__headers__": parsed["headers"],
        "__body__": parsed["body"],
        "__params__": {}
    }
    ctx = anvend_request_middlewares(ncb, ctx)

    la route_handlers = ncb["route_handlers"]
    hvis route_handlers == null {
        la feil = bygg_feil_respons(404, "Ingen route_handlers definert")
        feil = anvend_error_middlewares(ncb, feil)
        returner response_to_http(feil)
    }

    la req_method = builtin.lower(parsed["method"])
    la req_path = parsed["path"]
    hvis er_helse_rute(req_path) {
        hvis req_method == "get" eller req_method == "head" {
            la helse = bygg_standard_helse_respons(ctx, req_method, ncb)
            returner response_to_http(helse)
        }
    }
    returner avgjer_route_respons(ncb, parsed, route_handlers, req_method, req_path)
}

funksjon nc_serve(src_sti: tekst) -> heltall {
    la modul = miljo_hent("NORSCODE_MODULE")
    hvis modul == "" {
        modul = "__main__"
    }

    la host = miljo_hent("NC_SERVE_HOST")
    hvis host == "" { host = "127.0.0.1" }

    la port = miljo_hent("NC_SERVE_PORT")
    hvis port == "" { port = "4173" }
    la port_nr = heltall_fra_tekst(port)

    la rå_request = miljo_hent("NORSCODE_FAKE_HTTP_REQUEST")
    la rås = miljo_hent("NORSCODE_FAKE_HTTP_REQUESTS")
    la srv = -1
    hvis rå_request == "" og rås == "" {
        la sokkel = sok.ny_tcp()
        hvis sok.er_feil(sokkel) {
            skriv("Feil: kunne ikkje opprette sokkel for " + host + ":" + port + "\n")
            returner 1
        }
        hvis ikkje sok.bind(sokkel, host, port_nr) {
            skriv("Feil: kunne ikkje binde sokkel på " + host + ":" + port + "\n")
            returner 1
        }
        hvis ikkje sok.lytt(sokkel, 16) {
            skriv("Feil: kunne ikkje lytte på " + host + ":" + port + "\n")
            returner 1
        }
        srv = sok.fil_deskriptor(sokkel)
        hvis tekst(srv) == "" eller srv == null eller srv == usann eller srv < 0 {
            skriv("Feil: kunne ikkje lytte på " + host + ":" + port + "\n")
            returner 1
        }
    }

    la reload_status = nc_reload_bundle(src_sti, modul)
    hvis ikkje reload_status["ok"] {
        skriv("Feil: reload/bundle feila: " + tekst(reload_status["error"]) + "\n")
        hvis srv >= 0 {
            la close_args = builtin.split(tekst(srv) + " 0 1 0", " ")
            sok.lukk(close_args)
        }
        returner 1
    }
    la ncb_json = tekst(reload_status["ncb_json"])
    fil_skriv("/tmp/nc_serve_bundle.json", ncb_json)

    la ncb = json_parse_raw(ncb_json)
    hvis ncb == null {
        skriv("Feil: ugyldig NCB-json ved serve\n")
        hvis srv >= 0 {
            la close_args = builtin.split(tekst(srv) + " 0 1 0", " ")
            sok.lukk(close_args)
        }
        returner 1
    }
    la startup_status = køyre_livssyklus_hooks_trygt(ncb, "startup_hooks")
    hvis ikkje startup_status["ok"] {
        skriv("Feil: startup_hooks feila: " + tekst(startup_status["error"]) + "\n")
        hvis srv >= 0 {
            la close_args = builtin.split(tekst(srv) + " 0 1 0", " ")
            sok.lukk(close_args)
        }
        returner 1
    }
    skriv("[serve] Klar for NCB-app på " + host + ":" + port + ".\n")
    hvis rå_request != "" {
        skriv(serve_handle_one(ncb, rå_request))
        la shutdown_status = køyre_livssyklus_hooks_trygt(ncb, "shutdown_hooks")
        hvis ikkje shutdown_status["ok"] {
            skriv("Feil: shutdown_hooks feila: " + tekst(shutdown_status["error"]) + "\n")
            returner 1
        }
        returner 0
    }

    hvis rås != "" {
        la rå_liste = builtin.split(rås, "\\n")
        la i: heiltall = 0
        mens i < lengde(rå_liste) {
            la e = builtin.trim(rå_liste[i])
            hvis e != "" {
                skriv(serve_handle_one(ncb, e))
                skriv("\n")
            }
            i = i + 1
        }
        la shutdown_status = køyre_livssyklus_hooks_trygt(ncb, "shutdown_hooks")
        hvis ikkje shutdown_status["ok"] {
            skriv("Feil: shutdown_hooks feila: " + tekst(shutdown_status["error"]) + "\n")
            returner 1
        }
        returner 0
    }

    skriv("[serve] Socket-lytting aktiv. Trykk Ctrl+C for å stoppe.\n")
    la running: boolsk = sann
    la sockel_ref = [srv, 0, 1, 0]
    mens running {
        la conn = sok.aksepter(sockel_ref)
        hvis conn < 0 {
            skriv("[serve] Accept-feil, stoppar.\n")
            running = usann
        } ellers {
            la received = serve_receive_request(conn)
            la resp: tekst = ""
            hvis received["ok"] {
                resp = serve_handle_one(ncb, received["raw"])
            } ellers {
                resp = serve_receive_error(received["status"], received["error"])
            }
            sok.send(conn, resp)
            sok.lukk(conn)
        }
    }

    sok.lukk(sockel_ref)
    la shutdown_status = køyre_livssyklus_hooks_trygt(ncb, "shutdown_hooks")
    hvis ikkje shutdown_status["ok"] {
        skriv("Feil: shutdown_hooks feila: " + tekst(shutdown_status["error"]) + "\n")
        returner 1
    }
    returner 0
}

funksjon nc_reload_bundle(src_sti: tekst, modul: tekst) -> ordbok<tekst, tekst> {
    prøv {
        la kjelde = fil_les(src_sti)
        la imports = finn_bruk_imports(kjelde)
        la ncb_json = ""
        la bundled = usann
        hvis lengde(imports) > 0 {
            ncb_json = nc_bundle_ncb(src_sti, modul, imports)
            bundled = sann
        } ellers {
            ncb_json = komp.kompiler_fil(kjelde, modul)
        }
        returner {
            "ok": sann,
            "src": src_sti,
            "modul": modul,
            "bundled": bundled,
            "ncb_json": ncb_json,
            "error": ""
        }
    } fang (e) {
        returner {
            "ok": usann,
            "src": src_sti,
            "modul": modul,
            "bundled": usann,
            "ncb_json": "",
            "error": tekst(e)
        }
    }
}

// ─── Scan kjelde for bruk-imports ────────────────────────────────────────────
// Returnerer liste av "alias=sti/til/fil.no" for kvar bruk-linje som ikkje er selfhost.*

funksjon _dirname(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    hvis lengde(delar) <= 1 {
        returner "."
    }
    fjern(delar, lengde(delar) - 1)
    returner builtin.join(delar, "/")
}

funksjon _finn_import_base(src_sti: tekst) -> tekst {
    la idx = builtin.index_of(src_sti, "/frontend/")
    hvis idx >= 0 {
        returner builtin.slice(src_sti, 0, idx)
    }
    returner _dirname(src_sti)
}

funksjon _resolve_import_sti(base_fil: tekst, import_fil: tekst) -> tekst {
    hvis builtin.starts_with(import_fil, "std/") eller
       builtin.starts_with(import_fil, "selfhost/") eller
       builtin.starts_with(import_fil, "bootstrap/") eller
       builtin.starts_with(import_fil, "tools/") eller
       builtin.starts_with(import_fil, "tests/") eller
       builtin.starts_with(import_fil, "examples/") eller
       builtin.starts_with(import_fil, "compiler/") eller
       builtin.starts_with(import_fil, "packages/") eller
       builtin.starts_with(import_fil, "prosjekter/") {
        la root = miljo_hent("NORSCODE_ROOT")
        hvis root != "" {
            returner root + "/" + import_fil
        }
    }
    hvis builtin.starts_with(import_fil, "frontend/") {
        hvis builtin.starts_with(base_fil, "/") {
            la idx = builtin.index_of(base_fil, "/frontend/")
            hvis idx >= 0 {
                la prosjekt_rot = builtin.slice(base_fil, 0, idx)
                returner prosjekt_rot + "/" + import_fil
            }
        }
        returner import_fil
    }
    la base_dir = _dirname(base_fil)
    hvis base_dir == "." {
        returner import_fil
    }
    returner base_dir + "/" + import_fil
}

funksjon _modul_filsti_fra_namn(namn: tekst) -> tekst {
    la basis = builtin.replace(namn, ".", "/")

    // Prioriter .nors, men støtt eldre .no for bakoverkompatibilitet.
    la nors_filsti = basis + ".nors"
    la no_filsti = basis + ".no"
    hvis fil_finnes(nors_filsti) {
        returner nors_filsti
    }
    hvis fil_finnes(no_filsti) {
        returner no_filsti
    }
    returner nors_filsti
}

funksjon finn_bruk_imports(kjelde: tekst) -> liste<tekst> {
    la imports_str = ""
    la linjer = builtin.split(kjelde, "\n")
    la bruk_prekompilert_selfhost = miljo_hent("NORSCODE_USE_PRECOMPILED_SELFHOST")
    hvis bruk_prekompilert_selfhost == "" {
        bruk_prekompilert_selfhost = "1"
    }
    la i: heltall = 0
    mens i < lengde(linjer) {
        la linje = builtin.trim(linjer[i])
        la har_bruk = builtin.starts_with(linje, "bruk ") eller builtin.starts_with(linje, "importer ")
        hvis har_bruk {
            la rest = builtin.trim(builtin.slice(linje, 5, lengde(linje)))
            hvis builtin.starts_with(linje, "importer ") {
                rest = builtin.trim(builtin.slice(linje, 9, lengde(linje)))
            }
            // Fjern avsluttande semikolon
            hvis builtin.ends_with(rest, ";") {
                rest = builtin.slice(rest, 0, lengde(rest) - 1)
            }
            // Sjekk etter "som alias"
            la alias = ""
            la modul = rest
            la som_idx = builtin.index_of(rest, " som ")
            hvis som_idx >= 0 {
                modul = builtin.trim(builtin.slice(rest, 0, som_idx))
                alias = builtin.trim(builtin.slice(rest, som_idx + 5, lengde(rest)))
            } ellers {
                // Alias = siste segment av modul-sti
                la segs = builtin.split(modul, ".")
                alias = segs[lengde(segs) - 1]
            }
            la fil = _modul_filsti_fra_namn(modul)
            hvis lengde(imports_str) > 0 {
                imports_str = imports_str + "\n"
            }
            imports_str = imports_str + alias + "=" + fil
        }
        i = i + 1
    }
    hvis lengde(imports_str) == 0 {
        returner json_parse_raw("[]")
    }
    returner builtin.split(imports_str, "\n")
}

funksjon fjern_bruk_linjer(kjelde: tekst) -> tekst {
    la linjer = builtin.split(kjelde, "\n")
    la ut = ""
    la i: heiltall = 0
    la første = sann
    mens i < lengde(linjer) {
        la linje = linjer[i]
        la trimma = builtin.trim(linje)
        hvis ikkje (builtin.starts_with(trimma, "bruk ") eller builtin.starts_with(trimma, "importer ")) {
            hvis ikkje første {
                ut = ut + "\n"
            }
            ut = ut + linje
            første = usann
        }
        i = i + 1
    }
    returner ut
}

// ─── Bundle fleire modular til NCB utan diskskriving ─────────────────────────

funksjon nc_bundle_fremdrift(fase: tekst) -> heiltall {
    la sti = builtin.trim(miljo_hent("NORSCODE_BUNDLE_PROGRESS_FILE"))
    hvis sti != "" {
        prøv { fil_skriv(sti, fase + "\n") } fang (e) { la ignorert = e }
    }
    returner 0
}

funksjon modulnamn_fra_importfil(import_fil: tekst) -> tekst {
    la sti = builtin.replace(import_fil, "\\", "/")
    mens builtin.starts_with(sti, "./") {
        sti = builtin.slice(sti, 2, lengde(sti))
    }
    hvis builtin.ends_with(sti, ".nors") {
        sti = builtin.slice(sti, 0, lengde(sti) - 5)
    } ellers hvis builtin.ends_with(sti, ".no") {
        sti = builtin.slice(sti, 0, lengde(sti) - 3)
    }
    returner builtin.replace(sti, "/", ".")
}

funksjon normaliser_importalias_kall(ncb_json: tekst, imports: liste<tekst>) -> tekst {
    la ut = ncb_json
    la i: heiltall = 0
    mens i < lengde(imports) {
        la arg = imports[i]
        la eq = builtin.index_of(arg, "=")
        hvis eq > 0 {
            la alias = builtin.slice(arg, 0, eq)
            la import_fil = builtin.slice(arg, eq + 1, lengde(arg))
            la kanonisk_modul = modulnamn_fra_importfil(import_fil)
            // Kompilatoren kan skrive modulalias som anten builtin.<alias> eller
            // berre <alias>. Begge må peike på same kanoniske funksjonsnamn i
            // bundle-tabellen. Dette er særleg viktig for transitive importar,
            // der to modular ofte bruker same korte funksjonsnamn.
            ut = tekst_erstatt(ut, "\"builtin." + alias + ".", "\"" + kanonisk_modul + ".")
            ut = tekst_erstatt(ut, "\"" + alias + ".", "\"" + kanonisk_modul + ".")
        }
        i = i + 1
    }
    returner ut
}

funksjon normaliser_json_kontrollteikn(data: tekst) -> tekst {
    // Compiler-NCB kan innehalde rå kontrollteikn i strengoperandar. Gjer
    // berre desse byteverdiane JSON-lovlege før den strenge råparseren;
    // eksisterande escapes og whitespace utanfor streng blir urørte.
    la heks = "0123456789abcdef"
    // Ein listepost per teikn pressa AOT-heapen hardt sjølv for mellomstore
    // verktøybundle. Bygg avgrensa tekstblokker og materialiser berre nokre
    // få blokker til slutt. Den tomme fyrste posten gjer lista stabil også i
    // eldre runtime-generasjonar som er sårbare for legg_til på [].
    la delar: liste<tekst> = [""]
    la bit = ""
    la i: heiltall = 0
    la i_streng = usann
    la escape = usann
    mens i < lengde(data) {
        la c = data[i]
        hvis i_streng {
            hvis escape {
                bit = bit + c
                escape = usann
            } ellers hvis c == "\\" {
                bit = bit + c
                escape = sann
            } ellers hvis c == "\"" {
                bit = bit + c
                i_streng = usann
            } ellers {
                la kode = builtin.char_code(c)
                hvis kode >= 0 og kode < 32 {
                    hvis kode == 10 { bit = bit + "\\n" }
                    ellers hvis kode == 13 { bit = bit + "\\r" }
                    ellers hvis kode == 9 { bit = bit + "\\t" }
                    ellers hvis kode == 8 { bit = bit + "\\b" }
                    ellers hvis kode == 12 { bit = bit + "\\f" }
                    ellers {
                        la høg = 0
                        la låg = kode
                        hvis kode >= 16 { høg = 1 låg = kode - 16 }
                        bit = bit + "\\u00" + builtin.slice(heks, høg, høg + 1) +
                            builtin.slice(heks, låg, låg + 1)
                    }
                } ellers { bit = bit + c }
            }
        } ellers {
            bit = bit + c
            hvis c == "\"" { i_streng = sann }
        }
        hvis lengde(bit) >= 4096 {
            legg_til(delar, bit)
            bit = ""
        }
        i = i + 1
    }
    hvis bit != "" { legg_til(delar, bit) }
    returner builtin.join(delar, "")
}

funksjon nc_stdlib_cache_abi() -> tekst {
    returner "norscode-stdlib-source-cache-v1|ncb-v1|module-globals-v1"
}

funksjon nc_stdlib_cache_aktiv() -> boolsk {
    la eksplisitt = builtin.trim(miljo_hent("NORSCODE_USE_PRECOMPILED_STDLIB"))
    hvis eksplisitt != "" {
        returner eksplisitt != "0" og eksplisitt != "off" og eksplisitt != "false"
    }
    // Bootstrap source-only skal aldri kunne bli maskert av stdlib-fragment.
    returner builtin.trim(miljo_hent("NORSCODE_USE_PRECOMPILED_SELFHOST")) != "0"
}

funksjon nc_stdlib_cache_trace(melding: tekst) -> heiltall {
    hvis builtin.trim(miljo_hent("NORSCODE_STDLIB_CACHE_TRACE")) == "1" {
        skriv("[stdlib-cache] " + melding + "\n")
    }
    returner 0
}

// Returner berre eit fragment når ABI, modulnamn, kjeldehash og artefakthash
// alle samsvarer med den committed manifesten. Alle avvik fell trygt attende
// til levande kjeldekompilering.
funksjon nc_stdlib_fragment(src_sti: tekst, modul: tekst, root: tekst) -> tekst {
    hvis ikkje nc_stdlib_cache_aktiv() { returner "" }
    la relativ_kjelde = nc_verktøy_relativ_sti(src_sti, root)
    hvis ikkje builtin.starts_with(relativ_kjelde, "std/") { returner "" }
    la manifest_sti = root + "/bootstrap/stdlib/manifest.json"
    hvis ikkje builtin.fil_finnes(manifest_sti) { returner "" }
    prøv {
        la manifest = json_parse_raw(fil_les(manifest_sti))
        hvis tekst(manifest["schema"]) != nc_stdlib_cache_abi() { returner "" }
        la modular = manifest["modules"]
        hvis modular == null eller ikkje finnes_nøkkel(modular, relativ_kjelde) { returner "" }
        la post = modular[relativ_kjelde]
        hvis tekst(post["module"]) != modul { returner "" }
        la kjelde_hash = builtin.sha256_bytes(builtin.fil_les_binær(src_sti))
        hvis kjelde_hash != tekst(post["source_sha256"]) {
            nc_stdlib_cache_trace("source-miss " + relativ_kjelde)
            returner ""
        }
        la artefakt_relativ = tekst(post["artifact"])
        hvis ikkje builtin.starts_with(artefakt_relativ, "bootstrap/stdlib/") { returner "" }
        la artefakt_sti = root + "/" + artefakt_relativ
        hvis ikkje builtin.fil_finnes(artefakt_sti) { returner "" }
        la artefakt_hash = builtin.sha256_bytes(builtin.fil_les_binær(artefakt_sti))
        hvis artefakt_hash != tekst(post["artifact_sha256"]) {
            nc_stdlib_cache_trace("artifact-miss " + relativ_kjelde)
            returner ""
        }
        la ncb_json = fil_les(artefakt_sti)
        la ncb = json_parse_raw(ncb_json)
        hvis ncb == null eller ncb["functions"] == null eller
           lengde(nøkler(ncb["functions"])) == 0 { returner "" }
        nc_stdlib_cache_trace("hit " + relativ_kjelde)
        returner ncb_json
    } fang (e) {
        nc_stdlib_cache_trace("invalid " + relativ_kjelde + ": " + tekst(e))
        returner ""
    }
    returner ""
}

funksjon nc_sikre_modulmetadata(alle_initializers, alle_global_names, ncb, modul: tekst) -> heiltall {
    bundler.slå_saman_modulmetadata(alle_initializers, alle_global_names, ncb)
    la fns = ncb["functions"]
    hvis fns == null { returner 0 }
    la init_namn = modul + ".__module_init__"
    hvis ikkje finnes_nøkkel(fns, init_namn) { returner 0 }

    la har_init = usann
    la ii: heiltall = 0
    mens ii < lengde(alle_initializers) {
        hvis alle_initializers[ii] == init_namn { har_init = sann }
        ii = ii + 1
    }
    hvis ikkje har_init { legg_til(alle_initializers, init_namn) }
    hvis ikkje finnes_nøkkel(alle_global_names, modul) { alle_global_names[modul] = [] }

    // STORE_GLOBAL er den kanoniske kjelda når eldre cache-/JSON-transport har
    // mista metadatafelta, men framleis bevart levande initialisatorkode.
    la mål = alle_global_names[modul]
    la kode = fns[init_namn]["code"]
    la i: heiltall = 0
    mens i < lengde(kode) {
        la instr = kode[i]
        hvis lengde(instr) >= 2 og instr[0] == "STORE_GLOBAL" {
            la namn = tekst(instr[1])
            la finst = usann
            la j: heiltall = 0
            mens j < lengde(mål) {
                hvis mål[j] == namn { finst = sann }
                j = j + 1
            }
            hvis ikkje finst { legg_til(mål, namn) }
        }
        i = i + 1
    }
    returner 0
}

funksjon nc_bundle_ncb(src_sti: tekst, modul: tekst, imports: liste<tekst>) -> tekst {
    la import_base = builtin.trim(miljo_hent("NORSCODE_IMPORT_BASE"))
    hvis import_base == "" {
        import_base = _finn_import_base(src_sti)
    }
    miljo_sett("NORSCODE_IMPORT_BASE", import_base)
    la cache_root = miljo_hent("NORSCODE_ROOT")
    hvis cache_root == "" { cache_root = import_base }
    la alle_fns: ordbok<tekst, tekst> = {}
    la alle_initializers = []
    la alle_global_names = {}
    la alle_rh_json = ""  // Samla route_handlers frå alle importerte modular
    // BFS-kø for transitive imports.
    // Unngå [] + legg_til(...) som initial materialisering, sidan aktiv compile-path
    // framleis er sårbar der.
    la kø_str = ""
    la besøkt: ordbok<tekst, boolsk> = {}

    la j: heltall = 0
    mens j < lengde(imports) {
        la arg0 = imports[j]
        la eq0 = builtin.index_of(arg0, "=")
        la fil0 = builtin.slice(arg0, eq0 + 1, lengde(arg0))
        la modul0 = modulnamn_fra_importfil(fil0)
        hvis lengde(kø_str) > 0 {
            kø_str = kø_str + "\n"
        }
        kø_str = kø_str + modul0 + "=" + _resolve_import_sti(src_sti, fil0)
        j = j + 1
    }
    // Native split av tom tekst gir éin tom del. Ei importlaus fil må ha ei
    // verkeleg tom kø; elles prøver bundlebana å handsame "" som modulsti og
    // sender ein nullverdi vidare til native strengkonkatenering.
    la kø = json_parse_raw("[]")
    hvis kø_str != "" { kø = builtin.split(kø_str, "\n") }
    la kø_i: heiltall = 0

    // Konsumer køa med indeks i staden for fjern(kø, 0). Det unngår
    // O(n)-flytting og held VM-stakken balansert i generert selfhost-kode.
    mens kø_i < lengde(kø) {
        la arg: tekst = kø[kø_i]
        kø_i = kø_i + 1

        la eq = builtin.index_of(arg, "=")
        la alias = builtin.slice(arg, 0, eq)
        la fil = builtin.slice(arg, eq + 1, lengde(arg))

        // Hopp over allereie prosesserte filer
        hvis finnes_nøkkel(besøkt, fil) { fortsett }
        besøkt[fil] = sann

        prøv {
            la kjelde = fil_les(fil)
            la trans = finn_bruk_imports(kjelde)
            la ncb_json = nc_stdlib_fragment(fil, alias, cache_root)
            hvis ncb_json == "" {
                // Behald bruk-linjene også for importerte modular. Då kan
                // kompilatoren binde transitive alias direkte til kanoniske
                // CALL-mål, utan ei ustabil fulltekst-omskriving etterpå.
                ncb_json = komp.kompiler_fil(kjelde, alias)
            } ellers {
                // Eldre cachefragment kan framleis ha korte importalias.
                // Berre cache-kompatibilitetsbana får tekstnormalisering.
                ncb_json = normaliser_importalias_kall(ncb_json, trans)
            }
            nc_bundle_fremdrift("bundle-import-compiled " + alias)
            // Eldre cacheartefaktar kan framleis vere __main__-namngitte.
            // Berre dei går gjennom kompatibilitetsomskrivinga; kjeldebana
            // over er allereie modulnamngitt og tek fastvegen.
            la fiksa_json = ncb_json
            hvis builtin.contains(ncb_json, "\"__main__.") {
                fiksa_json = tekst_erstatt(ncb_json, "\"__main__.", "\"" + alias + ".")
            }
            nc_bundle_fremdrift("bundle-import-normalized " + alias)
            fiksa_json = normaliser_json_kontrollteikn(fiksa_json)
            la parsed_mod_ncb = json_parse_raw(fiksa_json)
            nc_bundle_fremdrift("bundle-import-parsed " + alias)
            la mod_ncb = bundler.omdøyp_ncb_objekt(parsed_mod_ncb, alias)
            nc_bundle_fremdrift("bundle-import-renamed " + alias)
            hvis builtin.contains(alias, ".") {
                la alias_deler = builtin.split(alias, ".")
                la kort_alias = alias_deler[lengde(alias_deler) - 1]
                la mod_fns = mod_ncb["functions"]
                hvis mod_fns != null {
                    la fn_keys = nøkler(mod_fns)
                    la fni: heltall = 0
                    mens fni < lengde(fn_keys) {
                        la fn_key = tekst(fn_keys[fni])
                        hvis builtin.starts_with(fn_key, kort_alias + ".") {
                            la suffix = builtin.slice(fn_key, lengde(kort_alias), lengde(fn_key))
                            la full_key = alias + suffix
                            hvis ikkje har_nokkel(mod_fns, full_key) {
                                mod_fns[full_key] = mod_fns[fn_key]
                            }
                        }
                        fni = fni + 1
                    }
                    mod_ncb["functions"] = mod_fns
                }
            }
            slå_saman_funksjonar(alle_fns, mod_ncb["functions"])
            nc_sikre_modulmetadata(alle_initializers, alle_global_names, mod_ncb, alias)
            nc_bundle_fremdrift("bundle-import-merged " + alias)
            // Samle route_handlers frå importerte modular — fix opp function-namn til alias
            la mod_rh_raw_ncb = json_parse_raw(fiksa_json)
            la mod_rh_raw = mod_rh_raw_ncb["route_handlers"]
            hvis mod_rh_raw != null {
                la ri: heltall = 0
                mens ri < lengde(mod_rh_raw) {
                    la rh_item = mod_rh_raw[ri]
                    // Rename __main__.X → alias.X i function-feltet
                    la fn_nam: tekst = tekst(rh_item["function"])
                    la new_fn: tekst = tekst_erstatt(fn_nam, "__main__.", alias + ".")
                    rh_item["function"] = new_fn
                    hvis lengde(alle_rh_json) > 0 {
                        alle_rh_json = alle_rh_json + "\n---RH---\n"
                    }
                    alle_rh_json = alle_rh_json + json_skriv(rh_item)
                    ri = ri + 1
                }
            }

            // Scan denne fila for transitive imports og legg til i kø
            la ti: heltall = 0
            mens ti < lengde(trans) {
                la t_arg = trans[ti]
                la t_eq = builtin.index_of(t_arg, "=")
                la t_fil = builtin.slice(t_arg, t_eq + 1, lengde(t_arg))
                la t_modul = modulnamn_fra_importfil(t_fil)
                la t_resolved = _resolve_import_sti(fil, t_fil)
                hvis ikkje finnes_nøkkel(besøkt, t_resolved) {
                    legg_til(kø, t_modul + "=" + t_resolved)
                }
                ti = ti + 1
            }
        } fang (e) {
            // Manglande valfri import kan hoppast over, men direkte bundlerfeil
            // må kunne sporast utan å endre normal CLI-utdata.
            hvis builtin.trim(miljo_hent("NORSCODE_BUNDLE_TRACE")) == "1" {
                skriv("[bundle] hoppar over " + fil + ": " + tekst(e) + "\n")
            }
        }
    }

    // Kompiler hovudfila som __main__
    la hoved_kjelde = fil_les(src_sti)
    // Behald bruk-linjene slik at IR-kompilatoren registrerer importalias og
    // skriv kanoniske CALL-mål direkte. Då treng ikkje heile NCB-teksten ein
    // ustabil alias-replace etter kompilering.
    la hoved_ncb_json = komp.kompiler_fil(hoved_kjelde, modul)
    nc_bundle_fremdrift("bundle-main-compiled")
    hoved_ncb_json = normaliser_json_kontrollteikn(hoved_ncb_json)
    nc_bundle_fremdrift("bundle-main-normalized")
    la hoved_ncb = json_parse_raw(hoved_ncb_json)
    nc_bundle_fremdrift("bundle-main-parsed")
    slå_saman_funksjonar(alle_fns, hoved_ncb["functions"])
    nc_sikre_modulmetadata(alle_initializers, alle_global_names, hoved_ncb, modul)
    nc_bundle_fremdrift("bundle-main-merged")

    // Bygg bundle-NCB med riktig entry
    la bundle: ordbok<tekst, tekst> = {}
    bundle["format"] = "ncb-v1"
    bundle["entry"] = modul + ".start"
    bundle["imports"] = []
    bundle["functions"] = alle_fns
    // Slå saman route_handlers frå importerte modular + hovudfila
    la rh = hoved_ncb["route_handlers"]
    la alle_rh_merged_json = alle_rh_json
    // Legg til route_handlers frå hovudfila
    hvis rh != null {
        la ri2: heltall = 0
        mens ri2 < lengde(rh) {
            hvis lengde(alle_rh_merged_json) > 0 {
                alle_rh_merged_json = alle_rh_merged_json + "\n---RH---\n"
            }
            alle_rh_merged_json = alle_rh_merged_json + json_skriv(rh[ri2])
            ri2 = ri2 + 1
        }
    }
    la alle_rh_merged = json_parse_raw("[]")
    hvis lengde(alle_rh_merged_json) > 0 {
        la rh_parts = builtin.split(alle_rh_merged_json, "\n---RH---\n")
        la ai: heiltall = 0
        mens ai < lengde(rh_parts) {
            la rh_part = builtin.trim(rh_parts[ai])
            hvis lengde(rh_part) > 0 {
                legg_til(alle_rh_merged, json_parse_raw(rh_part))
            }
            ai = ai + 1
        }
    }
    hvis lengde(alle_rh_merged) > 0 { bundle["route_handlers"] = alle_rh_merged }
    ellers hvis rh != null { bundle["route_handlers"] = rh }
    la tests_v = hoved_ncb["tests"]
    hvis tests_v != null { bundle["tests"] = tests_v }
    la metadata_keys = ["request_middlewares", "response_middlewares", "error_middlewares", "startup_hooks", "shutdown_hooks", "guard_providers", "dependency_providers"]
    la mi: heltall = 0
    mens mi < lengde(metadata_keys) {
        la mk: tekst = metadata_keys[mi]
        la mv = hoved_ncb[mk]
        hvis mv != null { bundle[mk] = mv }
        mi = mi + 1
    }
    // Bygg dei djupe metadatafelta separat. Den eldre bootstrap-JSON-skrivaren
    // kan miste nøsta module_initializers/global_names når heile bundle-objektet
    // blir serialisert i eitt pass, sjølv om funksjonane er med. Då finst
    // __module_init__ i NCB-en utan at runtimen veit at han skal køyrast.
    la initializers_json = json_skriv(alle_initializers)
    la global_names_json = json_skriv(alle_global_names)
    // Bygg bundle-JSON manuelt: legg metadata og route_handlers som siste felt
    // for å bevare dei gjennom både stage0- og kandidattransporten.
    la rh_json = json_skriv(alle_rh_merged)
    nc_bundle_fremdrift("bundle-routes-serialized")
    la bundle_json_inner = json_skriv(bundle)
    nc_bundle_fremdrift("bundle-object-serialized")
    // Fjern avsluttande } og legg til dei separat serialiserte metadatafelta.
    la bundle_len = lengde(bundle_json_inner)
    la bundle_without_end = builtin.slice(bundle_json_inner, 0, bundle_len - 1)
    la bundle_json_final = bundle_without_end + ",\"module_initializers\":" + initializers_json + ",\"global_names\":" + global_names_json + ",\"route_handlers\":" + rh_json + "}"
    nc_bundle_fremdrift("bundle-finalized")
    la debug_bundle = builtin.trim(miljo_hent("NORSCODE_DEBUG_BUNDLE_OUTPUT"))
    hvis debug_bundle != "" {
        fil_skriv(debug_bundle, bundle_json_final)
    }
    returner bundle_json_final
}

// ─── NORSCODE_CMD=run ────────────────────────────────────────────────────────

funksjon nc_run_policy() -> heiltall {
    la caps = miljo_hent("NORSCODE_VM_TARGET_CAPABILITIES")
    hvis caps == "" { caps = miljo_hent("NORSCODE_VM_CAPABILITIES") }
    hvis caps == "" {
        caps = "env.read,env.write,process.exec,thread.spawn,net.tcp,net.http,net.dns,disk.read,disk.write,jit.execute"
    }
    miljo_sett("NORSCODE_VM_TARGET_CAPABILITIES", caps)

    la disk = miljo_hent("NORSCODE_VM_TARGET_DISK_ROOT")
    hvis disk == "" { disk = miljo_hent("NORSCODE_VM_DISK_ROOT") }
    hvis disk == "" {
        la root = miljo_hent("NORSCODE_ROOT")
        hvis root == "" { root = "." }
        disk = root + ",.,/tmp,/private/tmp"
    }
    miljo_sett("NORSCODE_VM_TARGET_DISK_ROOT", disk)
    returner 0
}

funksjon nc_verktøy_cache_abi() -> tekst {
    returner "norscode-native-tool-cache-v4|ncb-v1|module-globals-v1|control-json-v1|selfhost-l5-20260802"
}

funksjon nc_verktøy_cache_aktiv() -> boolsk {
    la verdi = builtin.trim(miljo_hent("NORSCODE_NATIVE_TOOL_CACHE"))
    returner verdi != builtin.chr(48) og verdi != "off" og verdi != "false"
}

funksjon nc_verktøy_cache_trace(melding: tekst) -> heiltall {
    hvis builtin.trim(miljo_hent("NORSCODE_NATIVE_TOOL_CACHE_TRACE")) == "on" {
        skriv("[native-tool-cache] " + melding + "\n")
    }
    returner 0
}

# Fingeravtrykket blir bygd frå den faktiske, transitive importgrafen i stabil
# BFS-rekkefølgje. Både løyst filsti og kjeldebyte er med; ABI-strengen bind
# resultatet til NCB-formatet og den innebygde selfhost-kompilatoren.
funksjon nc_verktøy_relativ_sti(sti: tekst, root: tekst) -> tekst {
    hvis root == "." og builtin.starts_with(sti, "./") {
        returner builtin.slice(sti, 2, lengde(sti))
    }
    la prefiks = root + "/"
    hvis builtin.starts_with(sti, prefiks) {
        returner builtin.slice(sti, lengde(prefiks), lengde(sti))
    }
    returner sti
}

funksjon nc_verktøy_fingeravtrykk(src_sti: tekst, root: tekst, modul: tekst) -> tekst {
    la kø: liste<tekst> = []
    legg_til(kø, src_sti)
    la besøkt: ordbok<tekst, boolsk> = {}
    la materiale = nc_verktøy_cache_abi() + "\nMODULE " + modul + "\n"
    la indeks: heiltall = 0
    mens indeks < lengde(kø) {
        la fil = tekst(kø[indeks])
        indeks = indeks + 1
        hvis finnes_nøkkel(besøkt, fil) { fortsett }
        besøkt[fil] = sann
        la kjelde = fil_les(fil)
        la nøkkelsti = nc_verktøy_relativ_sti(fil, root)
        // Hash kvar fil separat. Å leggje heile den transitive kjelda til éin
        // stadig større tekst gav kvadratisk kopiering og gjorde sjølve
        // cacheoppslaget dyrare enn verktøykøyringa.
        la kjelde_hash = builtin.sha256_bytes(builtin.fil_les_binær(fil))
        materiale = materiale + "FILE " + nøkkelsti + " " +
                    tekst_fra_heltall(lengde(kjelde)) + " " + kjelde_hash + "\n"
        la imports = finn_bruk_imports(kjelde)
        la i: heiltall = 0
        mens i < lengde(imports) {
            la arg = tekst(imports[i])
            la eq = builtin.index_of(arg, "=")
            hvis eq > 0 {
                la import_fil = builtin.slice(arg, eq + 1, lengde(arg))
                la løyst = _resolve_import_sti(fil, import_fil)
                hvis ikkje finnes_nøkkel(besøkt, løyst) { legg_til(kø, løyst) }
            }
            i = i + 1
        }
    }
    returner builtin.sha256(materiale)
}

funksjon nc_verktøy_cache_gyldig(ncb_json: tekst) -> boolsk {
    hvis ncb_json == "" { nc_verktøy_cache_trace("cache ugyldig: tom NCB") returner usann }
    hvis ikkje builtin.contains(ncb_json, "ncb-v1") { nc_verktøy_cache_trace("cache ugyldig: manglar format") returner usann }
    hvis ikkje builtin.contains(ncb_json, "module_initializers") { nc_verktøy_cache_trace("cache ugyldig: manglar initializers") returner usann }
    hvis ikkje builtin.contains(ncb_json, "global_names") { nc_verktøy_cache_trace("cache ugyldig: manglar global_names") returner usann }
    prøv {
        la ncb = json_parse_raw(ncb_json)
        hvis ncb == null { nc_verktøy_cache_trace("cache ugyldig: JSON null") returner usann }
        hvis ncb["entry"] == null { nc_verktøy_cache_trace("cache ugyldig: entry null") returner usann }
        hvis ncb["functions"] == null { nc_verktøy_cache_trace("cache ugyldig: functions null") returner usann }
        returner lengde(nøkler(ncb["functions"])) > 0
    } fang (e) {
        nc_verktøy_cache_trace("cache ugyldig: parse=" + tekst(e))
        returner usann
    }
}

funksjon nc_verktøy_cache_skriv(root: tekst, relativ: tekst, data: tekst) -> boolsk {
    la mappe = _dirname(relativ)
    la laga = native_fs.native_lag_mappe(root, mappe)
    hvis laga["status"] != "ok" {
        nc_verktøy_cache_trace("mkdir feila: " + tekst(laga["error"]))
        returner usann
    }
    la tmp = mappe + "/.tmp-" + builtin.random_hex(16) + ".ncb.json"
    la ut = native_fs.opne_native(root, tmp, "write")
    hvis ut["status"] != "open" {
        nc_verktøy_cache_trace("open feila: " + tekst(ut["error"]))
        returner usann
    }
    la offset: heiltall = 0
    la feil = ""
    mens offset < lengde(data) og feil == "" {
        la slutt = offset + 262144
        hvis slutt > lengde(data) { slutt = lengde(data) }
        la del = builtin.slice(data, offset, slutt)
        la skreve = native_fs.native_skriv(ut, del)
        hvis skreve["status"] != "ok" eller
           heltall_fra_tekst(tekst(skreve["value"])) != lengde(del) {
            feil = "ufullstendig cacheskriving"
        } ellers {
            offset = slutt
        }
    }
    hvis feil == "" og native_fs.native_flush(ut)["status"] != "ok" {
        feil = "cache-flush feila"
    }
    la lukka = native_fs.native_lukk(ut)
    hvis feil == "" og lukka["status"] != "closed" { feil = "cache-close feila" }
    hvis feil != "" {
        nc_verktøy_cache_trace(feil)
        native_fs.native_slett(root, tmp)
        returner usann
    }
    la publisert = native_fs.native_erstatt_fil_atomisk(root, tmp, relativ)
    hvis publisert["status"] != "replaced" {
        nc_verktøy_cache_trace("atomisk publisering feila: " + tekst(publisert["error"]))
        native_fs.native_slett(root, tmp)
        returner usann
    }
    nc_verktøy_cache_trace("publisert " + relativ)
    returner sann
}

funksjon nc_verktøy_ncb_cached(src_sti: tekst, root: tekst, modul: tekst) -> tekst {
    hvis ikkje nc_verktøy_cache_aktiv() {
        la kjelde_utan_cache = fil_les(src_sti)
        la imports_utan_cache = finn_bruk_imports(kjelde_utan_cache)
        hvis lengde(imports_utan_cache) > 0 {
            returner nc_bundle_ncb(src_sti, modul, imports_utan_cache)
        }
        returner komp.kompiler_fil(kjelde_utan_cache, modul)
    }
    la nøkkel = ""
    // Materialiser CALL-resultatet før konkatenering. Native AOT må ikkje
    // halde den ytre strengoperanden over eit nøsta dynamisk CALL; den gamle
    // expression-stackbana kunne då sende null vidare til RT_CONCAT.
    la trace_relativ = nc_verktøy_relativ_sti(src_sti, root)
    nc_verktøy_cache_trace("fingerprint start " + trace_relativ)
    prøv {
        nøkkel = nc_verktøy_fingeravtrykk(src_sti, root, modul)
    } fang (e) {
        nc_verktøy_cache_trace("fingerprint feila: " + tekst(e))
        nøkkel = ""
    }
    hvis nøkkel == "" {
        la kjelde_utan_nøkkel = fil_les(src_sti)
        la imports_utan_nøkkel = finn_bruk_imports(kjelde_utan_nøkkel)
        hvis lengde(imports_utan_nøkkel) > 0 {
            returner nc_bundle_ncb(src_sti, modul, imports_utan_nøkkel)
        }
        returner komp.kompiler_fil(kjelde_utan_nøkkel, modul)
    }
    la relativ = "build/cache/nc/native-tools/" + nøkkel + ".ncb.json"
    la full = root + "/" + relativ
    la cache_fs_root = root
    la cache_fs_relativ = relativ
    hvis builtin.starts_with(root, "/") {
        cache_fs_root = "/"
        cache_fs_relativ = builtin.slice(root, 1, lengde(root)) + "/" + relativ
    }
    hvis builtin.fil_finnes(full) {
        prøv {
            la cache_data = fil_les(full)
            hvis nc_verktøy_cache_gyldig(cache_data) {
                nc_verktøy_cache_trace("treff " + relativ)
                returner cache_data
            }
            nc_verktøy_cache_trace("forkastar ugyldig treff " + relativ)
            native_fs.native_slett(cache_fs_root, cache_fs_relativ)
        } fang (e) {
            prøv { native_fs.native_slett(cache_fs_root, cache_fs_relativ) } fang (ign) { }
        }
    }
    la kjelde = fil_les(src_sti)
    nc_verktøy_cache_trace("bom " + relativ)
    la imports = finn_bruk_imports(kjelde)
    la ncb_json = ""
    hvis lengde(imports) > 0 { ncb_json = nc_bundle_ncb(src_sti, modul, imports) }
    ellers { ncb_json = komp.kompiler_fil(kjelde, modul) }
    hvis nc_verktøy_cache_gyldig(ncb_json) {
        prøv { nc_verktøy_cache_skriv(cache_fs_root, cache_fs_relativ, ncb_json) } fang (e) { }
    }
    returner ncb_json
}

funksjon nc_run(src_sti: tekst) -> heltall {
    nc_run_policy()
    la modul = miljo_hent("NORSCODE_MODULE")
    hvis modul == "" { modul = "__main__" }
    la kjelde = fil_les(src_sti)
    la imports = finn_bruk_imports(kjelde)
    la ncb_json = ""
    hvis lengde(imports) > 0 {
        ncb_json = nc_bundle_ncb(src_sti, modul, imports)
    } ellers {
        ncb_json = komp.kompiler_fil(kjelde, modul)
    }
    returner nc_køyr_ncb_json(ncb_json)
}

funksjon nc_run_ncb_pure(sti: tekst) -> heiltall {
    nc_run_policy()
    prøv { returner nc_køyr_ncb_json(fil_les(sti)) }
    fang (e) {
        skriv("nc run-ncb-pure: " + tekst(e) + "\n")
        returner 1
    }
}

// ─── NORSCODE_CMD=compile ────────────────────────────────────────────────────

funksjon nc_compile(src_sti: tekst, ut_sti: tekst) -> heltall {
    la modul = miljo_hent("NORSCODE_MODULE")
    hvis modul == "" { modul = "__main__" }
    skriv("Kompilerer " + src_sti + "...\n")
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la ncb_json = normaliser_json_kontrollteikn(
        nc_verktøy_ncb_cached(src_sti, root, modul)
    )
    la faktisk_ut = ut_sti
    hvis faktisk_ut == "" {
        faktisk_ut = src_sti
        hvis builtin.ends_with(faktisk_ut, ".no") {
            faktisk_ut = builtin.slice(faktisk_ut, 0, lengde(faktisk_ut) - 3) + ".ncb.json"
        } ellers {
            faktisk_ut = faktisk_ut + ".ncb.json"
        }
    }
    fil_skriv(faktisk_ut, ncb_json)
    skriv("NCB skrive til " + faktisk_ut + " (" + tekst_fra_heltall(lengde(ncb_json)) + " bytes)\n")
    returner 0
}

// ─── Native, shellfri bygg-native-dispatch ─────────────────────────────────

funksjon nc_slett_fil_trygt(sti: tekst) -> heiltall {
    hvis sti == "" { returner 0 }
    prøv {
        la rot = nc_dirname(sti)
        la relativ = nc_basename(sti)
        hvis builtin.starts_with(sti, "/") {
            rot = "/"
            relativ = builtin.slice(sti, 1, lengde(sti))
        }
        native_fs.native_slett(rot, relativ)
    } fang (e) { }
    returner 0
}

funksjon nc_bygg_native_bruk() -> heiltall {
    skriv("bruk: nc bygg-native --target macos-arm64 [--ncb] fil ut\n")
    skriv("bruk: nc bygg-native --target linux-x86_64 [--ncb] fil ut\n")
    skriv("bruk: nc bygg-native --target linux-arm64 [--ncb] fil ut\n")
    returner 0
}

funksjon nc_bygg_native_ncb_fra_kjelde(src_sti: tekst) -> tekst {
    la kjelde = fil_les(src_sti)
    la imports = finn_bruk_imports(kjelde)
    la ncb_json = ""
    hvis lengde(imports) > 0 { ncb_json = nc_bundle_ncb(src_sti, "__main__", imports) }
    ellers { ncb_json = komp.kompiler_fil(kjelde, "__main__") }
    returner normaliser_json_kontrollteikn(ncb_json)
}

funksjon nc_bygg_native_køyr_codegen(src_sti: tekst) -> heiltall {
    la kjelde = fil_les(src_sti)
    la imports = finn_bruk_imports(kjelde)
    la ncb_json = ""
    hvis lengde(imports) > 0 { ncb_json = nc_bundle_ncb(src_sti, "__main__", imports) }
    ellers { ncb_json = komp.kompiler_fil(kjelde, "__main__") }
    returner host_exec_ncb_json(normaliser_json_kontrollteikn(ncb_json))
}

funksjon nc_bygg_native_cli(argv: liste_tekst) -> heiltall {
    hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
        returner nc_bygg_native_bruk()
    }
    hvis lengde(argv) < 6 eller tekst(argv[2]) != "--target" {
        nc_bygg_native_bruk()
        returner 2
    }
    la target = tekst(argv[3])
    hvis target != "macos-arm64" og target != "linux-x86_64" og target != "linux-arm64" {
        nc_bygg_native_bruk()
        returner 2
    }
    la er_ncb = tekst(argv[4]) == "--ncb"
    la input = ""
    la output = ""
    hvis er_ncb {
        hvis lengde(argv) != 7 { nc_bygg_native_bruk()  returner 2 }
        input = tekst(argv[5])
        output = tekst(argv[6])
    } ellers {
        hvis lengde(argv) != 6 { nc_bygg_native_bruk()  returner 2 }
        input = tekst(argv[4])
        output = tekst(argv[5])
    }
    hvis ikkje builtin.fil_finnes(input) {
        skriv("nc bygg-native: finn ikkje fil " + input + "\n")
        returner 2
    }

    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la faktisk_ncb = input
    la mellombels = ""
    hvis ikkje er_ncb {
        mellombels = "/tmp/norscode_bygg_native_" + builtin.random_hex(16) + ".ncb.json"
        prøv { fil_skriv(mellombels, nc_bygg_native_ncb_fra_kjelde(input)) }
        fang (e) {
            nc_slett_fil_trygt(mellombels)
            skriv("nc bygg-native: kompilering feila: " + tekst(e) + "\n")
            returner 1
        }
        faktisk_ncb = mellombels
    }

    miljo_sett("NC_INPUT", faktisk_ncb)
    miljo_sett("NC_OUTPUT", output)
    la codegen = root + "/selfhost/native_execution/native_codegen_v2.no"
    hvis target == "macos-arm64" { codegen = root + "/selfhost/native_execution/macho_arm64_codegen.no" }
    hvis target == "linux-arm64" { codegen = root + "/selfhost/native_execution/elf_arm64_codegen.no" }
    // Codegen køyrer som Norscode-NCB direkte i native host. Det bevarer
    // etikett-/funksjonsidentiteten og unngår eit feilaktig VM-i-VM-lag.
    la status = nc_bygg_native_køyr_codegen(codegen)
    hvis mellombels != "" { nc_slett_fil_trygt(mellombels) }
    hvis status != 0 { returner status }
    la modus = native_fs.native_sett_modus_sti(output, 493)
    hvis modus["status"] != "ok" {
        skriv("nc bygg-native: filmodus-ABI feila for " + output + "\n")
        returner 1
    }
    returner 0
}

funksjon nc_check(src_sti: tekst) -> heiltall {
    la modul = miljo_hent("NORSCODE_MODULE")
    hvis modul == "" { modul = "__main__" }
    prøv {
        nc_kompiler_fil(src_sti, modul)
        skriv(src_sti + ": OK\n")
        returner 0
    } fang (e) {
        skriv("nc check: " + tekst(e) + "\n")
        returner 1
    }
}

funksjon nc_bundle_fleire_direkte(filer: liste_tekst, ut: tekst) -> heiltall {
    la alle_fns: ordbok<tekst, tekst> = {}
    la første_modul = ""
    la i: heiltall = 0
    mens i < lengde(filer) {
        la spesifikasjon = filer[i]
        la eq = builtin.index_of(spesifikasjon, "=")
        la modul = ""
        la sti = spesifikasjon
        hvis eq > 0 {
            modul = builtin.slice(spesifikasjon, 0, eq)
            sti = builtin.slice(spesifikasjon, eq + 1, lengde(spesifikasjon))
        } ellers {
            modul = builtin.replace(sti, "/", ".")
            hvis builtin.ends_with(modul, ".no") {
                modul = builtin.slice(modul, 0, lengde(modul) - 3)
            }
        }
        hvis første_modul == "" { første_modul = modul }
        la ncb = json_parse_raw(nc_kompiler_fil(sti, modul))
        slå_saman_funksjonar(alle_fns, ncb["functions"])
        i = i + 1
    }
    la bundle: ordbok<tekst, tekst> = {}
    bundle["format"] = "norscode-bytecode-v1"
    bundle["entry"] = første_modul + ".start"
    bundle["imports"] = []
    bundle["functions"] = alle_fns
    bundle["tests"] = []
    fil_skriv(ut, json_skriv(bundle))
    skriv("Bundle: " + ut + " (" + tekst_fra_heltall(lengde(alle_fns)) + " funksjonar)\n")
    returner 0
}

funksjon nc_bundle_cli(argv: liste_tekst) -> heiltall {
    la ut = "bootstrap/kompiler.ncb.json"
    la modular = ""
    la filer: liste_tekst = []
    la i: heiltall = 2
    mens i < lengde(argv) {
        la arg = tekst(argv[i])
        hvis arg == "--output" {
            hvis i + 1 >= lengde(argv) {
                skriv("bruk: nc bundle [--output utdata.ncb.json] [fil.no ...]\n")
                returner 2
            }
            ut = tekst(argv[i + 1])
            i = i + 2
        } ellers hvis builtin.starts_with(arg, "--") {
            skriv("bruk: nc bundle [--output utdata.ncb.json] [fil.no ...]\n")
            returner 2
        } ellers {
            hvis modular != "" { modular = modular + " " }
            modular = modular + arg
            legg_til(filer, arg)
            i = i + 1
        }
    }
    // Éin modul er semantisk identisk med compile. Bruk den allereie
    // materialiserte native compilerbanen direkte og unngå VM-i-VM.
    hvis lengde(filer) == 1 {
        returner nc_compile(filer[0], ut)
    }
    hvis lengde(filer) > 1 {
        returner nc_bundle_fleire_direkte(filer, ut)
    }
    miljo_sett("NORSCODE_BUNDLE_ARGS", modular)
    miljo_sett("NORSCODE_BUNDLE_OUTPUT", ut)
    returner nc_køyr_verktøy("selfhost/bundler.no")
}

funksjon nc_format_lint_cli(cmd: tekst, argv: liste_tekst) -> heiltall {
    hvis lengde(argv) < 3 eller lengde(argv) > 4 {
        hvis cmd == "format" { skriv("bruk: nc format <kilde.no> [--write|--check]\n") }
        ellers { skriv("bruk: nc lint <kilde.no> [--check]\n") }
        returner 2
    }
    la src = tekst(argv[2])
    hvis ikkje builtin.fil_finnes(src) {
        skriv("nc " + cmd + ": finn ikkje fil " + src + "\n")
        returner 2
    }
    la flagg = ""
    hvis lengde(argv) == 4 { flagg = tekst(argv[3]) }
    hvis cmd == "format" {
        hvis flagg != "" og flagg != "--write" og flagg != "--check" {
            skriv("bruk: nc format <kilde.no> [--write|--check]\n")
            returner 2
        }
        miljo_sett("NC_FORMAT_FILE", nc_root_sti(src, src))
        hvis flagg == "--write" { miljo_sett("NC_FORMAT_WRITE", "1") }
        ellers { miljo_sett("NC_FORMAT_WRITE", "") }
        hvis flagg == "--check" { miljo_sett("NC_FORMAT_CHECK", "1") }
        ellers { miljo_sett("NC_FORMAT_CHECK", "") }
        returner nc_køyr_verktøy("selfhost/formatter.no")
    }
    hvis flagg != "" og flagg != "--check" {
        skriv("bruk: nc lint <kilde.no> [--check]\n")
        returner 2
    }
    miljo_sett("NC_LINT_FILE", nc_root_sti(src, src))
    hvis flagg == "--check" { miljo_sett("NC_LINT_CHECK", "1") }
    ellers { miljo_sett("NC_LINT_CHECK", "") }
    returner nc_køyr_verktøy("selfhost/linter.no")
}

// ─── NORSCODE_CMD=l5b-gen2 ──────────────────────────────────────────────────
// Køyr Gen1-NCB sin bygg_bundle via selfhost/vm (utan host-FFI).
// Tilsvarar l5b steg 2 via ./bin/nc selfcompile-l5b.

funksjon nc_l5b_gen2() -> heltall {
    la v1 = miljo_hent("NORSCODE_L5B_V1")
    la v2 = miljo_hent("NORSCODE_L5B_V2")
    la args_str = miljo_hent("NORSCODE_BUNDLE_ARGS")
    hvis v1 == "" eller v2 == "" {
        skriv("Feil: NORSCODE_L5B_V1/V2 ikkje sett\n")
        returner 1
    }
    la ncb_json = fil_les(v1)
    la deler = builtin.split(args_str, " ")
    la modular_str = ""
    la i: heltall = 0
    mens i < lengde(deler) {
        la del = builtin.trim(deler[i])
        hvis del != "" {
            hvis lengde(modular_str) > 0 {
                modular_str = modular_str + "\n"
            }
            modular_str = modular_str + del
        }
        i = i + 1
    }
    la modular = json_parse_raw("[]")
    hvis lengde(modular_str) > 0 {
        modular = builtin.split(modular_str, "\n")
    }
    skriv("[L5b-2] Bundle via Gen1-bytekode (bygg_bundle i NCB) → " + v2 + "\n")
    skriv("[L5b-2] Leser Gen1-NCB...\n")
    la ncb = json_parse_raw(ncb_json)
    hvis ncb == null {
        skriv("Feil: ugyldig v1 NCB\n")
        returner 1
    }

    la fns = ncb["functions"]
    hvis fns == null {
        skriv("Feil: manglar functions i v1 NCB\n")
        returner 1
    }
    // Gen1-bundleren køyrer som ein eksplisitt vedlikehaldsjobb og skal arve
    // dei avgrensa capability-/disk-scope-verdiane frå CLI-prosessen.
    skriv("[L5b-2] Initialiserer VM...\n")
    fns["__vm_inherit_env__"] = "sann"
    vm_runtime_init(fns, sann)

    la args: liste = json_parse_raw("[]")
    legg_til(args, modular)
    legg_til(args, v2)
    skriv("[L5b-2] Kaller selfhost.bundler.bygg_bundle...\n")
    prøv {
        køyr_funksjon("selfhost.bundler.bygg_bundle", args, fns, 0)
        skriv("[L5b-2] bygg_bundle returnerte.\n")
    } fang melding {
        skriv("Feil i l5b-gen2: " + melding + "\n")
        returner 1
    }
    returner 0
}

// ─── Inngangspunkt ───────────────────────────────────────────────────────────

funksjon native_argv() -> liste_tekst {
    // Native AOT har ei smal direkte listeflate. Eldre VM-/stage0-backendar
    // kjenner ikkje builtinen og går kontrollert vidare til argv_operation.
    prøv { returner builtin.argv_list_v1() } fang (e) { }
    prøv {
        la svar = builtin.argv_operation({
            "abi": "norscode-argv-v1",
            "operation": "get"
        })
        // AOT-backenden eig denne versjonerte operasjonen og returnerer alltid
        // argv-feltet ved eit vellukka kall. Returner feltet direkte; manglande
        // eller ugyldig resultat går framleis gjennom den fail-closed catch-en.
        returner svar["argv"]
    } fang (e) { }
    returner []
}

funksjon nc_hjelp() -> heiltall {
    skriv("Norscode native kommandoflate\n")
    skriv("  nc run <fil.no>\n")
    skriv("  nc run-pure <fil.no>\n")
    skriv("  nc run-ncb-pure <fil.ncb.json>\n")
    skriv("  nc compile <fil.no> [-o ut.ncb.json]\n")
    skriv("  nc build <fil.no> <ut.ncb.json>\n")
    skriv("  nc bygg-native --target <plattform> [--ncb] <fil> <ut>\n")
    skriv("  nc check <fil.no>\n")
    skriv("  nc bundle [--output ut.ncb.json] [fil.no ...]\n")
    skriv("  nc format <fil.no> [--write|--check]\n")
    skriv("  nc lint <fil.no> [--check]\n")
    skriv("  nc serve <fil.no>\n")
    skriv("  nc test [--slow]\n")
    skriv("  nc test-parallel\n")
    skriv("  nc benchmark [--quick|--full]\n")
    skriv("  nc active-surface\n")
    skriv("  nc surface-ownership\n")
    skriv("  nc phase0-verify\n")
    skriv("  nc python-audit\n")
    skriv("  nc selftest\n")
    returner 0
}

funksjon nc_køyr_verktøy(sti: tekst) -> heiltall {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" {
        root = "."
        miljo_sett("NORSCODE_ROOT", root)
    }
    nc_run_policy()
    // CLI-verktøy treng sikkerheit og korrekt VM-semantikk, men ikkje eit
    // profilerings-/debugsnapshot for kvar instruksjon. Verktøy som startar
    // eigne testprogram set eksplisitt NORSCODE_VM_FAST=0 for målprogrammet.
    returner nc_køyr_ncb_json_modus(nc_verktøy_ncb_cached(root + "/" + sti, root, "__main__"), sann)
}

funksjon nc_direkte_verktøysti(cmd: tekst) -> tekst {
    hvis cmd == "doctor" { returner "selfhost/doctor.no" }
    hvis cmd == "repl" { returner "tools/nc_repl.no" }
    hvis cmd == "release-preflight" { returner "tools/release_preflight.no" }
    hvis cmd == "package-release" eller cmd == "release-package" { returner "tools/package_release.no" }
    hvis cmd == "install-release" eller cmd == "release-install" { returner "tools/install_release.no" }
    hvis cmd == "local-green" eller cmd == "gronnliste" { returner "tools/local_green.no" }
    hvis cmd == "benchmark" eller cmd == "performance-benchmark" { returner "tools/performance_benchmark.no" }
    hvis cmd == "regen-bootstrap" eller cmd == "bootstrap-regen" { returner "tools/nc_regen_bootstrap.no" }
    hvis cmd == "selfhost-bootstrap-gate" { returner "selfhost/bootstrap_gate.no" }
    hvis cmd == "bootstrap-self" { returner "selfhost/bootstrap_self_pure.no" }
    hvis cmd == "selfcompile-l5" eller cmd == "l5" { returner "tools/selfcompile_l5.no" }
    hvis cmd == "selfcompile-l5b" eller cmd == "l5b" { returner "tools/selfcompile_l5b.no" }
    hvis cmd == "selfcompile-l5b-mini" eller cmd == "l5b-mini" { returner "tools/selfcompile_l5b_mini.no" }
    hvis cmd == "test-parallel" { returner "tools/nc_test_parallel.no" }
    hvis cmd == "selfcompile-native-elf" eller cmd == "native-elf-selfcompile" { returner "tools/selfcompile_native_elf.no" }
    hvis cmd == "selfcompile-stage0-elf" eller cmd == "stage0-elf-selfcompile" { returner "tools/selfcompile_stage0_elf.no" }
    hvis cmd == "verify-omgang6b" eller cmd == "omgang6b" { returner "tools/verify_omgang6b.no" }
    hvis cmd == "build-omgang6b-ncb" { returner "tools/build_omgang6b_compiler_ncb.no" }
    hvis cmd == "verify-selvstendighet" eller cmd == "selvstendighet" { returner "tools/verify_selvstendighet.no" }
    hvis cmd == "verify-omgang6" eller cmd == "omgang6" { returner "tools/verify_omgang6.no" }
    hvis cmd == "stage0-release-assets" eller cmd == "build-stage0-release-assets" { returner "tools/build_stage0_release_assets.no" }
    hvis cmd == "verify-seed" eller cmd == "seed-only" { returner "tools/verify_seed_only.no" }
    hvis cmd == "fetch-stage0-seed" { returner "tools/fetch_stage0_seed.no" }
    hvis cmd == "ncb-to-elf" { returner "tools/ncb_to_elf.no" }
    hvis cmd == "package-linux-app" { returner "tools/package-linux-app.no" }
    hvis cmd == "docker-build-linux" { returner "tools/docker-build-linux.no" }
    hvis cmd == "build-linux-stage0-docker" { returner "tools/build_linux_x86_64_stage0_docker_v3601.no" }
    hvis cmd == "package-windows-app" { returner "tools/package-windows-app.no" }
    hvis cmd == "build-windows-app-layout" { returner "tools/build-windows-app-layout.no" }
    hvis cmd == "verify-macos-app" { returner "tools/verify-macos-app.no" }
    hvis cmd == "build-macos-app" { returner "tools/build-macos-app.no" }
    hvis cmd == "build-macos-window-host" { returner "tools/build-macos-window-host.no" }
    hvis cmd == "package-macos-app" { returner "tools/package-macos-app.no" }
    hvis cmd == "sign-macos-app" { returner "tools/sign-macos-app.no" }
    hvis cmd == "notarize-macos-app" { returner "tools/notarize-macos-app.no" }
    hvis cmd == "install-linux-appdir" { returner "tools/install-linux-appdir.no" }
    hvis cmd == "install-linux-desktop-entry" { returner "tools/install-linux-desktop-entry.no" }
    hvis cmd == "install-macos-app" { returner "tools/install-macos-app.no" }
    hvis cmd == "install-macos-file-icons" { returner "tools/install-macos-file-icons.no" }
    hvis cmd == "regen-fraser" { returner "scripts/regen_fraser.no" }
    hvis cmd == "feature-check" eller cmd == "feature" { returner "tools/norscode_feature_gate.no" }
    hvis cmd == "startproject" eller cmd == "scaffold-api" { returner "tools/startproject.no" }
    hvis cmd == "startapp" { returner "tools/startapp.no" }
    hvis cmd == "platform-readiness" { returner "tools/platform_readiness_v3600.no" }
    hvis cmd == "ci" { returner "selfhost/phase2_ci.no" }
    hvis cmd == "identity" eller cmd == "release" eller cmd == "release-targets" { returner "selfhost/main.no" }
    returner ""
}

funksjon nc_argv_har(argv: liste_tekst, flagg: tekst) -> boolsk {
    la i = 2
    mens i < lengde(argv) {
        hvis tekst(argv[i]) == flagg { returner sann }
        i = i + 1
    }
    returner usann
}

funksjon nc_native_plattform() -> tekst {
    prøv {
        la info = builtin.system_info()
        la system = tekst(info["system"])
        la maskin = tekst(info["machine"])
        hvis system == "Darwin" og maskin == "arm64" { returner "macos-arm64" }
        hvis system == "Darwin" og maskin == "x86_64" { returner "macos-x86_64" }
        hvis system == "Linux" og maskin == "x86_64" { returner "linux-x86_64" }
        hvis system == "Linux" og (maskin == "aarch64" eller maskin == "arm64") { returner "linux-arm64" }
        hvis system == "Windows" og maskin == "x86_64" { returner "windows-x86_64" }
    } fang (e) { }
    returner ""
}

funksjon nc_root_sti(sti: tekst, standard: tekst) -> tekst {
    hvis sti == "" { sti = standard }
    hvis builtin.starts_with(sti, "/") { returner sti }
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" eller root == "." { returner sti }
    returner root + "/" + sti
}

funksjon nc_home_sti(relativ: tekst) -> tekst {
    la home = miljo_hent("HOME")
    hvis home == "" { returner relativ }
    returner home + "/" + relativ
}

funksjon nc_basename(sti: tekst) -> tekst {
    la delar = builtin.split(sti, "/")
    la i = lengde(delar) - 1
    mens i >= 0 {
        hvis delar[i] != "" { returner tekst(delar[i]) }
        i = i - 1
    }
    returner sti
}

funksjon nc_dirname(sti: tekst) -> tekst {
    la normal = builtin.replace(sti, "\\", "/")
    mens lengde(normal) > 1 og builtin.ends_with(normal, "/") {
        normal = builtin.slice(normal, 0, lengde(normal) - 1)
    }
    la delar = builtin.split(normal, "/")
    hvis lengde(delar) <= 1 { returner "." }
    la ut = ""
    la i: heiltall = 0
    hvis builtin.starts_with(normal, "/") { ut = "/"  i = 1 }
    mens i < lengde(delar) - 1 {
        hvis delar[i] != "" {
            hvis ut != "" og ut != "/" { ut = ut + "/" }
            ut = ut + tekst(delar[i])
        }
        i = i + 1
    }
    hvis ut == "" { returner "." }
    returner ut
}

funksjon nc_absolutt_normalisert_sti(sti: tekst, cwd: tekst) -> tekst {
    la normal = builtin.replace(sti, "\\", "/")
    hvis ikkje builtin.starts_with(normal, "/") {
        hvis cwd == "" { returner "" }
        normal = builtin.replace(cwd, "\\", "/") + "/" + normal
    }
    la inn = builtin.split(normal, "/")
    la ut: liste_tekst = []
    la i: heiltall = 0
    mens i < lengde(inn) {
        la del = inn[i]
        hvis del == ".." {
            hvis lengde(ut) > 0 { fjern(ut, lengde(ut) - 1) }
        } ellers hvis del != "" og del != "." {
            legg_til(ut, del)
        }
        i = i + 1
    }
    la resultat = "/"
    i = 0
    mens i < lengde(ut) {
        hvis i > 0 { resultat = resultat + "/" }
        resultat = resultat + tekst(ut[i])
        i = i + 1
    }
    returner resultat
}

funksjon nc_repo_root_fra_executable(executable_sti: tekst, cwd: tekst) -> tekst {
    hvis executable_sti != "" {
        la absolutt = nc_absolutt_normalisert_sti(executable_sti, cwd)
        la kandidat = nc_dirname(nc_dirname(absolutt))
        prøv {
            hvis builtin.fil_finnes(kandidat + "/selfhost/nc_main.no") og
               builtin.fil_finnes(kandidat + "/tools/nc_test.no") {
                returner kandidat
            }
        } fang (e) { }
    }
    hvis cwd != "" { returner cwd }
    returner "."
}

funksjon nc_finn_køyrbar(namn: tekst) -> tekst {
    prøv {
        la svar = builtin.system_operation({
            "abi": "norscode-system-v1",
            "operation": "resolve_executable",
            "name": namn
        })
        hvis svar["status"] == "ok" { returner tekst(svar["path"]) }
    } fang (e) { }
    returner ""
}

funksjon nc_config_verdi(sti: tekst, namn: tekst, standard: tekst) -> tekst {
    hvis sti == "" { returner standard }
    la data = ""
    prøv { data = fil_les(sti) } fang (e) { returner standard }
    la lines = builtin.split(data, "\n")
    la i = 0
    mens i < lengde(lines) {
        la line = builtin.trim(lines[i])
        hvis builtin.starts_with(line, namn + "=") {
            la verdi = builtin.trim(builtin.slice(line, lengde(namn) + 1, lengde(line)))
            hvis lengde(verdi) >= 2 {
                la første = builtin.slice(verdi, 0, 1)
                la siste = builtin.slice(verdi, lengde(verdi) - 1, lengde(verdi))
                hvis (første == "\"" og siste == "\"") eller (første == "'" og siste == "'") {
                    verdi = builtin.slice(verdi, 1, lengde(verdi) - 1)
                }
            }
            returner verdi
        }
        i = i + 1
    }
    returner standard
}

funksjon nc_versjon() -> tekst {
    la root = miljo_hent("NORSCODE_ROOT")
    hvis root == "" { root = "." }
    la sti = root + "/norcode.toml"
    hvis ikkje builtin.fil_finnes(sti) { returner "ukjent" }
    prøv {
        la lines = builtin.split(fil_les(sti), "\n")
        la i: heiltall = 0
        mens i < lengde(lines) {
            la line = builtin.trim(lines[i])
            hvis builtin.starts_with(line, "version") {
                la eq = builtin.index_of(line, "=")
                hvis eq >= 0 {
                    la verdi = builtin.trim(builtin.slice(line, eq + 1, lengde(line)))
                    hvis lengde(verdi) >= 2 og builtin.starts_with(verdi, "\"") og builtin.ends_with(verdi, "\"") {
                        verdi = builtin.slice(verdi, 1, lengde(verdi) - 1)
                    }
                    hvis verdi != "" { returner verdi }
                }
            }
            i = i + 1
        }
    } fang (e) { }
    returner "ukjent"
}

funksjon nc_direkte_bruk(cmd: tekst) -> tekst {
    hvis cmd == "release-preflight" { returner "bruk: nc release-preflight [--strict]" }
    hvis cmd == "package-release" eller cmd == "release-package" { returner "bruk: nc package-release <versjon>" }
    hvis cmd == "install-release" eller cmd == "release-install" { returner "bruk: nc install-release <release.tar.gz> [--prefix <mappe>]" }
    hvis cmd == "local-green" eller cmd == "gronnliste" { returner "bruk: nc local-green [--strict] [--list|-l]" }
    hvis cmd == "benchmark" eller cmd == "performance-benchmark" { returner "bruk: nc benchmark [--quick|--full] [--output <fil>]" }
    hvis cmd == "regen-bootstrap" eller cmd == "bootstrap-regen" { returner "bruk: nc regen-bootstrap [--full]" }
    hvis cmd == "verify-selvstendighet" eller cmd == "selvstendighet" { returner "bruk: nc selvstendighet [--strict]" }
    hvis cmd == "verify-omgang6" eller cmd == "omgang6" { returner "bruk: nc verify-omgang6 [modus]" }
    hvis cmd == "build-omgang6b-ncb" { returner "bruk: nc build-omgang6b-ncb [utdata.ncb.json]" }
    hvis cmd == "stage0-release-assets" eller cmd == "build-stage0-release-assets" { returner "bruk: nc stage0-release-assets [--platform <namn>] [--out-dir <mappe>]" }
    hvis cmd == "fetch-stage0-seed" { returner "bruk: nc fetch-stage0-seed [plattform]" }
    hvis cmd == "ncb-to-elf" { returner "bruk: nc ncb-to-elf fil.ncb.json ut.elf" }
    hvis cmd == "package-linux-app" { returner "bruk: nc package-linux-app [--version VER] [--format appdir|tarball|all|appimage-adapter]" }
    hvis cmd == "docker-build-linux" { returner "bruk: nc docker-build-linux [--output FIL]" }
    hvis cmd == "build-linux-stage0-docker" { returner "bruk: nc build-linux-stage0-docker" }
    hvis cmd == "package-windows-app" { returner "bruk: nc package-windows-app [--version VER] <EXE_PATH>" }
    hvis cmd == "build-windows-app-layout" { returner "bruk: nc build-windows-app-layout [--out DIR] [--name NAMN] <EXE_PATH>" }
    hvis cmd == "verify-macos-app" { returner "bruk: nc verify-macos-app [APP_PATH]" }
    hvis cmd == "build-macos-app" { returner "bruk: nc build-macos-app [--config FIL] [--mode gui|terminal] [--name NAMN] [--out DIR] [--bundle-id ID] [--version VER]" }
    hvis cmd == "build-macos-window-host" { returner "bruk: nc build-macos-window-host [--out DIR] [--name NAMN] [--bundle-id ID] [--version VER]" }
    hvis cmd == "package-macos-app" { returner "bruk: nc package-macos-app [--version VER] [--format dmg|zip|pkg|all] [APP_PATH]" }
    hvis cmd == "sign-macos-app" { returner "bruk: nc sign-macos-app [APP_PATH] [--identity NAME] [--entitlements FILE] [--verify]" }
    hvis cmd == "notarize-macos-app" { returner "bruk: nc notarize-macos-app <artefakt.zip|artefakt.dmg|artefakt.pkg>" }
    hvis cmd == "install-linux-appdir" { returner "bruk: nc install-linux-appdir <Norscode-linux-*-AppDir.tar.gz> [--prefix DIR]" }
    hvis cmd == "install-linux-desktop-entry" { returner "bruk: nc install-linux-desktop-entry [APPDIR] [--prefix DIR]" }
    hvis cmd == "install-macos-app" { returner "bruk: nc install-macos-app [APP_PATH] [--dest DIR] [--name NAMN]" }
    hvis cmd == "install-macos-file-icons" { returner "bruk: nc install-macos-file-icons [--bundle-dir DIR] [--skip-register]" }
    hvis cmd == "regen-fraser" { returner "bruk: nc regen-fraser" }
    hvis cmd == "feature-check" eller cmd == "feature" { returner "bruk: nc feature-check [fil.no ...]" }
    hvis cmd == "startproject" eller cmd == "scaffold-api" { returner "bruk: nc startproject <målmappe> [--name <prosjektnamn>] [--path <sti>] [--db <db-fil>]" }
    hvis cmd == "startapp" { returner "bruk: nc startapp <app_namn> [--path <prosjektrot>]" }
    returner "bruk: nc " + cmd
}

funksjon nc_forbered_direkte_miljø(cmd: tekst, argv: liste_tekst) -> boolsk {
    hvis lengde(argv) <= 1 { returner sann }
    la tal = lengde(argv)
    hvis cmd == "release-preflight" {
        hvis tal == 2 {
            miljo_sett("NORSCODE_RELEASE_PREFLIGHT_STRICT_GIT", "0")
            returner sann
        }
        hvis tal == 3 og tekst(argv[2]) == "--strict" {
            miljo_sett("NORSCODE_RELEASE_PREFLIGHT_STRICT_GIT", "1")
            returner sann
        }
        returner usann
    }
    hvis cmd == "package-release" eller cmd == "release-package" {
        hvis tal != 3 { returner usann }
        miljo_sett("NORSCODE_RELEASE_VERSION", tekst(argv[2]))
        returner sann
    }
    hvis cmd == "install-release" eller cmd == "release-install" {
        hvis tal != 3 og tal != 5 { returner usann }
        miljo_sett("NORSCODE_INSTALL_ARCHIVE", tekst(argv[2]))
        hvis tal == 5 {
            hvis tekst(argv[3]) != "--prefix" { returner usann }
            miljo_sett("NORSCODE_INSTALL_PREFIX", tekst(argv[4]))
        }
        returner sann
    }
    hvis cmd == "local-green" eller cmd == "gronnliste" {
        miljo_sett("NORSCODE_LOCAL_GREEN_STRICT", "0")
        miljo_sett("NORSCODE_LOCAL_GREEN_LIST", "0")
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--strict" { miljo_sett("NORSCODE_LOCAL_GREEN_STRICT", "1") }
            ellers hvis arg == "--list" eller arg == "-l" { miljo_sett("NORSCODE_LOCAL_GREEN_LIST", "1") }
            ellers { returner usann }
            i = i + 1
        }
        returner sann
    }
    hvis cmd == "benchmark" eller cmd == "performance-benchmark" {
        miljo_sett("NORSCODE_BENCHMARK_SCOPE", "full")
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--quick" { miljo_sett("NORSCODE_BENCHMARK_SCOPE", "quick") i = i + 1 }
            ellers hvis arg == "--full" { miljo_sett("NORSCODE_BENCHMARK_SCOPE", "full") i = i + 1 }
            ellers hvis arg == "--output" og i + 1 < tal {
                miljo_sett("NORSCODE_BENCHMARK_OUTPUT", nc_root_sti(tekst(argv[i + 1]), "build/benchmarks/current.json"))
                i = i + 2
            } ellers { returner usann }
        }
        returner sann
    }
    hvis cmd == "regen-bootstrap" eller cmd == "bootstrap-regen" {
        hvis tal == 2 {
            miljo_sett("NORSCODE_REGEN_BOOTSTRAP_FULL", "0")
            returner sann
        }
        hvis tal == 3 og tekst(argv[2]) == "--full" {
            miljo_sett("NORSCODE_REGEN_BOOTSTRAP_FULL", "1")
            returner sann
        }
        returner usann
    }
    hvis cmd == "verify-selvstendighet" eller cmd == "selvstendighet" {
        hvis tal == 2 {
            miljo_sett("NORSCODE_SELVSTENDIGHET_STRICT", "0")
            returner sann
        }
        hvis tal == 3 og tekst(argv[2]) == "--strict" {
            miljo_sett("NORSCODE_SELVSTENDIGHET_STRICT", "1")
            returner sann
        }
        returner usann
    }
    hvis cmd == "verify-omgang6" eller cmd == "omgang6" {
        hvis tal > 3 { returner usann }
        hvis tal == 3 { miljo_sett("NC_OM6_MODE", tekst(argv[2])) }
        ellers { miljo_sett("NC_OM6_MODE", "all") }
        returner sann
    }
    hvis cmd == "build-omgang6b-ncb" {
        hvis tal == 2 { returner sann }
        hvis tal == 3 {
            miljo_sett("NORSCODE_OMGANG6B_NCB_OUT", nc_root_sti(tekst(argv[2]), "build/6b/compiler_stage0.ncb.json"))
            returner sann
        }
        returner usann
    }
    hvis cmd == "stage0-release-assets" eller cmd == "build-stage0-release-assets" {
        la platform = nc_native_plattform()
        la out_dir = ""
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--platform" eller arg == "--out-dir") og i + 1 < tal {
                hvis arg == "--platform" { platform = tekst(argv[i + 1]) }
                ellers { out_dir = tekst(argv[i + 1]) }
                i = i + 2
            } ellers { returner usann }
        }
        miljo_sett("NORSCODE_STAGE0_PLATFORM", platform)
        miljo_sett("NORSCODE_RELEASE_ARTIFACT_DIR", out_dir)
        returner platform != ""
    }
    hvis cmd == "fetch-stage0-seed" {
        hvis tal > 3 { returner usann }
        la platform = nc_native_plattform()
        hvis tal == 3 { platform = tekst(argv[2]) }
        hvis platform == "" { returner usann }
        miljo_sett("NORSCODE_STAGE0_PLATFORM", platform)
        returner sann
    }
    hvis cmd == "ncb-to-elf" {
        hvis tal != 4 { returner usann }
        miljo_sett("NORSCODE_NCB_TO_ELF_INPUT", tekst(argv[2]))
        miljo_sett("NORSCODE_NCB_TO_ELF_OUTPUT", tekst(argv[3]))
        returner sann
    }
    hvis cmd == "package-linux-app" {
        la format = "all"
        la version = ""
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--version" eller arg == "--format") og i + 1 < tal {
                hvis arg == "--version" { version = tekst(argv[i + 1]) }
                ellers { format = tekst(argv[i + 1]) }
                i = i + 2
            } ellers { returner usann }
        }
        hvis format != "appdir" og format != "tarball" og format != "all" og format != "appimage-adapter" { returner usann }
        miljo_sett("NORSCODE_LINUX_PACKAGE_FORMAT", format)
        miljo_sett("NORSCODE_LINUX_PACKAGE_VERSION", version)
        returner sann
    }
    hvis cmd == "docker-build-linux" {
        la output = "dist/norscode-linux-x86_64"
        hvis tal == 3 { output = tekst(argv[2]) }
        ellers hvis tal == 4 og tekst(argv[2]) == "--output" { output = tekst(argv[3]) }
        ellers hvis tal != 2 { returner usann }
        miljo_sett("NORSCODE_DOCKER_BUILD_LINUX_OUTPUT", nc_root_sti(output, "dist/norscode-linux-x86_64"))
        returner sann
    }
    hvis cmd == "build-linux-stage0-docker" { returner tal == 2 }
    hvis cmd == "package-windows-app" {
        la version = ""
        la exe = ""
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--version" og i + 1 < tal {
                version = tekst(argv[i + 1])
                i = i + 2
            } ellers hvis builtin.starts_with(arg, "--") eller exe != "" { returner usann }
            ellers { exe = arg  i = i + 1 }
        }
        hvis exe == "" { returner usann }
        miljo_sett("NORSCODE_WINDOWS_PACKAGE_VERSION", version)
        miljo_sett("NORSCODE_WINDOWS_PACKAGE_EXE", nc_root_sti(exe, ""))
        returner sann
    }
    hvis cmd == "build-windows-app-layout" {
        la output = "build/windows-app"
        la namn = "Norscode"
        la exe = ""
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--out" eller arg == "--name") og i + 1 < tal {
                hvis arg == "--out" { output = tekst(argv[i + 1]) }
                ellers { namn = tekst(argv[i + 1]) }
                i = i + 2
            } ellers hvis builtin.starts_with(arg, "--") eller exe != "" { returner usann }
            ellers { exe = arg  i = i + 1 }
        }
        hvis exe == "" { returner usann }
        miljo_sett("NORSCODE_WINDOWS_LAYOUT_OUT", nc_root_sti(output, "build/windows-app"))
        miljo_sett("NORSCODE_WINDOWS_LAYOUT_NAME", namn)
        miljo_sett("NORSCODE_WINDOWS_EXE_PATH", nc_root_sti(exe, ""))
        returner sann
    }
    hvis cmd == "verify-macos-app" {
        hvis tal > 3 { returner usann }
        la app = "build/macos-app/Norscode.app"
        hvis tal == 3 { app = tekst(argv[2]) }
        miljo_sett("NORSCODE_MACOS_VERIFY_APP", nc_root_sti(app, "build/macos-app/Norscode.app"))
        returner sann
    }
    hvis cmd == "build-macos-app" {
        la config = ""
        la i = 2
        mens i < tal {
            hvis tekst(argv[i]) == "--config" {
                hvis i + 1 >= tal { returner usann }
                config = nc_root_sti(tekst(argv[i + 1]), "")
                i = i + 2
            } ellers { i = i + 1 }
        }
        hvis config != "" og ikkje builtin.fil_finnes(config) { returner usann }
        la namn = nc_config_verdi(config, "APP_NAME", "Norscode")
        la output = nc_config_verdi(config, "OUT_DIR", nc_root_sti("build/macos-app", "build/macos-app"))
        la bundle_id = nc_config_verdi(config, "BUNDLE_ID", "dev.norscode.app")
        la version = nc_config_verdi(config, "APP_VERSION", "")
        la icon = nc_config_verdi(config, "ICON_PATH", nc_root_sti("frontend/assets/icons/norscode.icns", "frontend/assets/icons/norscode.icns"))
        la mode = nc_config_verdi(config, "APP_MODE", "gui")
        la doc_source = nc_config_verdi(config, "DOC_TYPE_SOURCE_NAME", "Norscode Source")
        la doc_utility = nc_config_verdi(config, "DOC_TYPE_UTILITY_NAME", "Norscode Utility Source")
        la doc_bytecode = nc_config_verdi(config, "DOC_TYPE_BYTECODE_NAME", "Norscode Bytecode JSON")
        la welcome_title = nc_config_verdi(config, "WELCOME_TITLE", "Norscode macOS app-bundle")
        la welcome_message = nc_config_verdi(config, "WELCOME_MESSAGE", "Velkomen til Norscode på macOS.")
        i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--config" { i = i + 2 }
            ellers hvis (arg == "--mode" eller arg == "--name" eller arg == "--out" eller arg == "--bundle-id" eller arg == "--version") og i + 1 < tal {
                hvis arg == "--mode" { mode = tekst(argv[i + 1]) }
                ellers hvis arg == "--name" { namn = tekst(argv[i + 1]) }
                ellers hvis arg == "--out" { output = tekst(argv[i + 1]) }
                ellers hvis arg == "--bundle-id" { bundle_id = tekst(argv[i + 1]) }
                ellers { version = tekst(argv[i + 1]) }
                i = i + 2
            } ellers { returner usann }
        }
        miljo_sett("NORSCODE_HOST_OS", tekst(builtin.system_info()["system"]))
        miljo_sett("NORSCODE_SWIFTC", nc_finn_køyrbar("swiftc"))
        miljo_sett("NORSCODE_MACOS_APP_NAME", namn)
        miljo_sett("NORSCODE_MACOS_APP_OUT", output)
        miljo_sett("NORSCODE_MACOS_APP_BUNDLE_ID", bundle_id)
        miljo_sett("NORSCODE_MACOS_APP_VERSION", version)
        miljo_sett("NORSCODE_MACOS_APP_ICON", icon)
        miljo_sett("NORSCODE_MACOS_APP_MODE", mode)
        miljo_sett("NORSCODE_MACOS_DOC_SOURCE_NAME", doc_source)
        miljo_sett("NORSCODE_MACOS_DOC_UTILITY_NAME", doc_utility)
        miljo_sett("NORSCODE_MACOS_DOC_BYTECODE_NAME", doc_bytecode)
        miljo_sett("NORSCODE_MACOS_WELCOME_TITLE", welcome_title)
        miljo_sett("NORSCODE_MACOS_WELCOME_MESSAGE", welcome_message)
        returner sann
    }
    hvis cmd == "build-macos-window-host" {
        la output = nc_root_sti("build/macos-window-host", "build/macos-window-host")
        la namn = "NorscodeWindowHost"
        la bundle_id = "dev.norscode.window-host"
        la version = "1.0"
        la template = nc_root_sti("platform/macos/window-host/app.no", "")
        la nc = nc_root_sti("bin/nc", "")
        la initial_path = "/"
        la query = ""
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--out" eller arg == "--name" eller arg == "--bundle-id" eller arg == "--version" eller arg == "--app-file" eller arg == "--nc" eller arg == "--path" eller arg == "--query") og i + 1 < tal {
                hvis arg == "--out" { output = tekst(argv[i + 1]) }
                ellers hvis arg == "--name" { namn = tekst(argv[i + 1]) }
                ellers hvis arg == "--bundle-id" { bundle_id = tekst(argv[i + 1]) }
                ellers hvis arg == "--version" { version = tekst(argv[i + 1]) }
                ellers hvis arg == "--app-file" { template = tekst(argv[i + 1]) }
                ellers hvis arg == "--nc" { nc = tekst(argv[i + 1]) }
                ellers hvis arg == "--path" { initial_path = tekst(argv[i + 1]) }
                ellers { query = tekst(argv[i + 1]) }
                i = i + 2
            } ellers { returner usann }
        }
        miljo_sett("NORSCODE_HOST_OS", tekst(builtin.system_info()["system"]))
        miljo_sett("NORSCODE_SWIFTC", nc_finn_køyrbar("swiftc"))
        miljo_sett("NORSCODE_MACOS_WINDOW_OUT", output)
        miljo_sett("NORSCODE_MACOS_WINDOW_NAME", namn)
        miljo_sett("NORSCODE_MACOS_WINDOW_BUNDLE_ID", bundle_id)
        miljo_sett("NORSCODE_MACOS_WINDOW_VERSION", version)
        miljo_sett("NORSCODE_MACOS_WINDOW_ICON", nc_root_sti("frontend/assets/icons/norscode.icns", ""))
        miljo_sett("NORSCODE_MACOS_WINDOW_SOURCE", nc_root_sti("platform/macos/window-host/Main.swift", ""))
        miljo_sett("NORSCODE_MACOS_WINDOW_TEMPLATE", template)
        miljo_sett("NORSCODE_MACOS_WINDOW_NC", nc)
        miljo_sett("NORSCODE_MACOS_WINDOW_PATH", initial_path)
        miljo_sett("NORSCODE_MACOS_WINDOW_QUERY", query)
        returner sann
    }
    hvis cmd == "package-macos-app" {
        la app = "build/macos-app/Norscode.app"
        la format = "all"
        la version = ""
        la app_set = usann
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--version" eller arg == "--format") og i + 1 < tal {
                hvis arg == "--version" { version = tekst(argv[i + 1]) }
                ellers { format = tekst(argv[i + 1]) }
                i = i + 2
            } ellers hvis builtin.starts_with(arg, "--") eller app_set { returner usann }
            ellers { app = arg  app_set = sann  i = i + 1 }
        }
        miljo_sett("NORSCODE_HOST_OS", tekst(builtin.system_info()["system"]))
        miljo_sett("NORSCODE_MACOS_PACKAGE_APP", nc_root_sti(app, "build/macos-app/Norscode.app"))
        miljo_sett("NORSCODE_MACOS_PACKAGE_FORMAT", format)
        miljo_sett("NORSCODE_MACOS_PACKAGE_VERSION", version)
        hvis miljo_hent("NORSCODE_MACOS_PACKAGE_RELEASE_DIR") == "" {
            miljo_sett("NORSCODE_MACOS_PACKAGE_RELEASE_DIR", nc_root_sti("release-artifacts", "release-artifacts"))
        }
        returner sann
    }
    hvis cmd == "sign-macos-app" {
        la app = "build/macos-app/Norscode.app"
        la identity = "-"
        la entitlements = "tools/macos-app.entitlements"
        la verify = "0"
        la app_set = usann
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--identity" eller arg == "--entitlements") og i + 1 < tal {
                hvis arg == "--identity" { identity = tekst(argv[i + 1]) }
                ellers { entitlements = tekst(argv[i + 1]) }
                i = i + 2
            } ellers hvis arg == "--verify" { verify = "1"  i = i + 1 }
            ellers hvis builtin.starts_with(arg, "--") eller app_set { returner usann }
            ellers { app = arg  app_set = sann  i = i + 1 }
        }
        miljo_sett("NORSCODE_MACOS_SIGN_APP", nc_root_sti(app, "build/macos-app/Norscode.app"))
        miljo_sett("NORSCODE_MACOS_SIGN_IDENTITY", identity)
        miljo_sett("NORSCODE_MACOS_SIGN_ENTITLEMENTS", nc_root_sti(entitlements, "tools/macos-app.entitlements"))
        miljo_sett("NORSCODE_MACOS_SIGN_VERIFY", verify)
        returner sann
    }
    hvis cmd == "notarize-macos-app" {
        hvis tal != 3 { returner usann }
        miljo_sett("NORSCODE_MACOS_NOTARIZE_ARTIFACT", nc_root_sti(tekst(argv[2]), ""))
        returner sann
    }
    hvis cmd == "install-linux-appdir" {
        hvis tal < 3 { returner usann }
        la archive = tekst(argv[2])
        la prefix = nc_home_sti(".local/opt/norscode-app")
        hvis tal == 5 og tekst(argv[3]) == "--prefix" { prefix = tekst(argv[4]) }
        ellers hvis tal != 3 { returner usann }
        miljo_sett("NORSCODE_LINUX_APPDIR_ARCHIVE", archive)
        miljo_sett("NORSCODE_LINUX_APPDIR_PREFIX", prefix)
        returner sann
    }
    hvis cmd == "install-linux-desktop-entry" {
        la appdir = nc_root_sti("build/linux-app/Norscode.AppDir", "")
        la prefix = nc_home_sti(".local/share")
        la app_set = usann
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--prefix" og i + 1 < tal { prefix = tekst(argv[i + 1])  i = i + 2 }
            ellers hvis builtin.starts_with(arg, "--") eller app_set { returner usann }
            ellers { appdir = arg  app_set = sann  i = i + 1 }
        }
        miljo_sett("NORSCODE_LINUX_DESKTOP_APPDIR", appdir)
        miljo_sett("NORSCODE_LINUX_DESKTOP_PREFIX", prefix)
        returner sann
    }
    hvis cmd == "install-macos-app" {
        la app = "build/macos-app/Norscode.app"
        la dest = nc_home_sti("Applications")
        la namn = "Norscode.app"
        la app_set = usann
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--dest" eller arg == "--name") og i + 1 < tal {
                hvis arg == "--dest" { dest = tekst(argv[i + 1]) }
                ellers {
                    namn = tekst(argv[i + 1])
                    hvis ikkje builtin.ends_with(namn, ".app") { namn = namn + ".app" }
                }
                i = i + 2
            } ellers hvis builtin.starts_with(arg, "--") eller app_set { returner usann }
            ellers { app = arg  app_set = sann  i = i + 1 }
        }
        miljo_sett("NORSCODE_MACOS_INSTALL_APP", nc_root_sti(app, "build/macos-app/Norscode.app"))
        miljo_sett("NORSCODE_MACOS_INSTALL_DEST", nc_root_sti(dest, nc_home_sti("Applications")))
        miljo_sett("NORSCODE_MACOS_INSTALL_NAME", namn)
        returner sann
    }
    hvis cmd == "install-macos-file-icons" {
        la bundle_dir = nc_home_sti("Applications/Norscode File Types.app")
        la skip_register = "usann"
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--bundle-dir" og i + 1 < tal { bundle_dir = tekst(argv[i + 1])  i = i + 2 }
            ellers hvis arg == "--skip-register" { skip_register = "sann"  i = i + 1 }
            ellers { returner usann }
        }
        miljo_sett("NORSCODE_FILE_ICONS_BUNDLE_DIR", bundle_dir)
        miljo_sett("NORSCODE_FILE_ICONS_SKIP_REGISTER", skip_register)
        returner sann
    }
    hvis cmd == "repl" {
        la line = ""
        la i = 2
        mens i < tal {
            hvis line != "" { line = line + " " }
            line = line + tekst(argv[i])
            i = i + 1
        }
        miljo_sett("NORSCODE_REPL_LINE", line)
        hvis miljo_hent("NORSCODE_REPL_TMP_PREFIX") == "" { miljo_sett("NORSCODE_REPL_TMP_PREFIX", "/tmp/norscode_repl_native") }
        returner sann
    }
    hvis cmd == "regen-fraser" { returner tal == 2 }
    hvis cmd == "feature-check" eller cmd == "feature" {
        la filer = ""
        la i = 2
        mens i < tal {
            filer = filer + tekst(argv[i]) + "\n"
            i = i + 1
        }
        miljo_sett("NORSCODE_FEATURE_FILES", filer)
        returner sann
    }
    hvis cmd == "startproject" eller cmd == "scaffold-api" {
        la project_dir = ""
        la output_dir = ""
        la project_name = ""
        la db = "app.db"
        la with_auth = "usann"
        la with_admin = "usann"
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis (arg == "--name" eller arg == "--path" eller arg == "--db") og i + 1 < tal {
                hvis arg == "--name" { project_name = tekst(argv[i + 1]) }
                ellers hvis arg == "--path" { output_dir = tekst(argv[i + 1]) }
                ellers { db = tekst(argv[i + 1]) }
                i = i + 2
            } ellers hvis arg == "--with-auth" { with_auth = "sann"  i = i + 1 }
            ellers hvis arg == "--without-auth" { with_auth = "usann"  i = i + 1 }
            ellers hvis arg == "--with-admin" { with_admin = "sann"  i = i + 1 }
            ellers hvis arg == "--without-admin" { with_admin = "usann"  i = i + 1 }
            ellers hvis builtin.starts_with(arg, "--") { returner usann }
            ellers hvis project_dir == "" { project_dir = arg  i = i + 1 }
            ellers hvis project_name == "" { project_name = arg  i = i + 1 }
            ellers { returner usann }
        }
        hvis project_dir == "" { returner usann }
        hvis output_dir == "" { output_dir = project_dir }
        hvis project_name == "" { project_name = nc_basename(project_dir) }
        miljo_sett("NORSCODE_STARTPROJECT_DIR", project_dir)
        miljo_sett("NORSCODE_STARTPROJECT_OUTPUT_DIR", output_dir)
        miljo_sett("NORSCODE_STARTPROJECT_NAME", project_name)
        miljo_sett("NORSCODE_STARTPROJECT_DB", db)
        miljo_sett("NORSCODE_STARTPROJECT_WITH_AUTH", with_auth)
        miljo_sett("NORSCODE_STARTPROJECT_WITH_ADMIN", with_admin)
        returner sann
    }
    hvis cmd == "startapp" {
        la app = ""
        la project_root = "."
        la i = 2
        mens i < tal {
            la arg = tekst(argv[i])
            hvis arg == "--path" og i + 1 < tal { project_root = tekst(argv[i + 1])  i = i + 2 }
            ellers hvis builtin.starts_with(arg, "--") eller app != "" { returner usann }
            ellers { app = arg  i = i + 1 }
        }
        hvis app == "" { returner usann }
        miljo_sett("NORSCODE_STARTAPP_NAME", app)
        miljo_sett("NORSCODE_STARTAPP_PROJECT_ROOT", project_root)
        returner sann
    }
    returner tal == 2
}

funksjon start() -> heltall {
    la cmd = miljo_hent("NORSCODE_CMD")
    la src = miljo_hent("NORSCODE_FILE")
    la ut = miljo_hent("NORSCODE_OUTPUT")
    la run_cmd = miljo_hent("NORSCODE_RUN_CMD")
    la run_src = miljo_hent("NORSCODE_RUN_FILE")
    la argv = native_argv()
    la direkte_invokasjon = cmd == "" og lengde(argv) > 1
    la native_utan_arg = cmd == "" og lengde(argv) == 1

    // Verktøy som startast frå den native dispatchen (mellom anna testløparen)
    // skal bruke same verifiserte kandidat, ikkje falle tilbake til committed
    // dist-runtime. Dette held kandidat- og aktiv-runtime-resultat åtskilde.
    hvis direkte_invokasjon og lengde(argv) > 0 og miljo_hent("NC_NATIVE") == "" {
        miljo_sett("NC_NATIVE", tekst(argv[0]))
    }
    hvis direkte_invokasjon og miljo_hent("NORSCODE_ROOT") == "" {
        prøv {
            la system = builtin.system_info()
            hvis system["status"] == "ok" {
                miljo_sett("NORSCODE_ROOT", nc_repo_root_fra_executable(
                    tekst(system["executable"]), tekst(system["cwd"])))
            }
        } fang (e) { }
    }

    hvis run_cmd != "" {
        cmd = run_cmd
    }
    hvis run_src != "" {
        src = run_src
    }

    # Direkte native invokasjon brukar OS-argv. Miljøkontrakten blir bevart
    # som bootstrap-/embed-kompatibilitet, men er ikkje lenger einaste veg inn.
    hvis direkte_invokasjon {
        cmd = tekst(argv[1])
        hvis lengde(argv) > 2 { src = tekst(argv[2]) }
        hvis cmd == "compile" {
            hvis lengde(argv) == 4 { ut = tekst(argv[3]) }
            ellers hvis lengde(argv) == 5 og tekst(argv[3]) == "-o" { ut = tekst(argv[4]) }
        }
    }

    hvis native_utan_arg {
        skriv("Norscode " + nc_versjon() + "  —  køyr: nc help\n")
        returner 0
    }
    hvis cmd == "" { cmd = "selftest" }
    hvis cmd == "version" eller cmd == "--version" eller cmd == "-V" {
        skriv("Norscode " + nc_versjon() + "\n")
        returner 0
    }
    hvis cmd == "help" eller cmd == "--help" eller cmd == "-h" {
        returner nc_hjelp()
    }
    hvis cmd == "run" {
        hvis direkte_invokasjon og lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            skriv("bruk: nc run <fil.no>\n")
            returner 0
        }
        hvis direkte_invokasjon og src == "" { src = "app.no" }
        hvis src == "" eller ikkje builtin.fil_finnes(src) {
            skriv("nc run: finn ikkje fil " + src + "\n")
            returner 2
        }
        returner nc_run(src)
    }

    hvis cmd == "run-pure" {
        hvis lengde(argv) != 3 eller ikkje builtin.fil_finnes(src) {
            skriv("bruk: nc run-pure <fil.no>\n")
            returner 2
        }
        returner nc_run(src)
    }

    hvis cmd == "run-ncb-pure" eller cmd == "run-ncb" {
        hvis lengde(argv) != 3 eller ikkje builtin.fil_finnes(src) {
            skriv("bruk: nc run-ncb-pure <fil.ncb.json>\n")
            returner 2
        }
        returner nc_run_ncb_pure(src)
    }

    hvis cmd == "compile" eller cmd == "build" {
        hvis direkte_invokasjon {
            hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
                hvis cmd == "build" { skriv("bruk: nc build <kilde.no> <utdata.ncb.json>\n") }
                ellers { skriv("bruk: nc compile <kilde.no> [utdata.ncb.json]\n") }
                returner 0
            }
            hvis cmd == "build" og lengde(argv) != 4 {
                skriv("bruk: nc build <kilde.no> <utdata.ncb.json>\n")
                returner 2
            }
            hvis cmd == "compile" og lengde(argv) != 3 og lengde(argv) != 4 og lengde(argv) != 5 {
                skriv("bruk: nc compile <kilde.no> [utdata.ncb.json]\n")
                returner 2
            }
            hvis cmd == "compile" og lengde(argv) == 5 og tekst(argv[3]) != "-o" {
                skriv("bruk: nc compile <kilde.no> [utdata.ncb.json]\n")
                returner 2
            }
            hvis cmd == "build" { ut = tekst(argv[3]) }
        }
        hvis src == "" eller ikkje builtin.fil_finnes(src) {
            skriv("nc " + cmd + ": finn ikkje fil " + src + "\n")
            returner 2
        }
        returner nc_compile(src, ut)
    }

    hvis cmd == "bygg-native" eller cmd == "bygg-native-v2" {
        returner nc_bygg_native_cli(argv)
    }

    hvis cmd == "check" {
        hvis lengde(argv) != 3 {
            skriv("bruk: nc check <kilde.no>\n")
            returner 2
        }
        hvis ikkje builtin.fil_finnes(src) {
            skriv("nc check: finn ikkje fil " + src + "\n")
            returner 2
        }
        returner nc_check(src)
    }

    hvis cmd == "bundle" {
        hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            skriv("bruk: nc bundle [--output utdata.ncb.json] [fil.no ...]\n")
            returner 0
        }
        returner nc_bundle_cli(argv)
    }

    hvis cmd == "format" eller cmd == "lint" {
        hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            hvis cmd == "format" { skriv("bruk: nc format <kilde.no> [--write|--check]\n") }
            ellers { skriv("bruk: nc lint <kilde.no> [--check]\n") }
            returner 0
        }
        returner nc_format_lint_cli(cmd, argv)
    }

    hvis cmd == "selftest" {
        skriv("=== nc_main.no selftest ===\n")
        la ncb = komp.kompiler_fil("funksjon start() { skriv(\"test OK\\n\") }\n", "__main__")
        la d = json_parse_raw(ncb)
        la fns = d["functions"]
        skriv("✓ Kompilering: " + tekst_fra_heltall(lengde(nøkler(fns))) + " funksjonar\n")
        returner nc_køyr_ncb_json(ncb)
    }

    hvis cmd == "l5b-gen2" {
        returner nc_l5b_gen2()
    }

    hvis cmd == "serve" {
        hvis direkte_invokasjon {
            src = "app.no"
            la port = "8000"
            la workers = "4"
            la host = "127.0.0.1"
            la i: heiltall = 2
            mens i < lengde(argv) {
                la arg = tekst(argv[i])
                hvis arg == "--help" eller arg == "-h" {
                    skriv("bruk: nc serve <kilde.no> [--port <port>] [--workers <n>] [--host <host>]\n")
                    returner 0
                }
                hvis arg == "--port" eller arg == "-p" eller arg == "--workers" eller arg == "-w" eller arg == "--host" eller arg == "-H" {
                    hvis i + 1 >= lengde(argv) {
                        skriv("bruk: nc serve <kilde.no> [--port <port>] [--workers <n>] [--host <host>]\n")
                        returner 2
                    }
                    hvis arg == "--port" eller arg == "-p" { port = tekst(argv[i + 1]) }
                    ellers hvis arg == "--workers" eller arg == "-w" { workers = tekst(argv[i + 1]) }
                    ellers { host = tekst(argv[i + 1]) }
                    i = i + 2
                } ellers hvis builtin.starts_with(arg, "--") {
                    skriv("ukjend serve-opsjon: " + arg + "\n")
                    returner 2
                } ellers {
                    src = arg
                    i = i + 1
                }
            }
            miljo_sett("NC_SERVE_PORT", port)
            miljo_sett("NORSCODE_WORKERS", workers)
            miljo_sett("NC_SERVE_HOST", host)
        }
        hvis src == "" eller ikkje builtin.fil_finnes(src) {
            skriv("nc serve: finn ikkje fil " + src + "\n")
            returner 2
        }
        returner nc_serve(src)
    }

    hvis cmd == "migrate" {
        hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            skriv("bruk: nc migrate <fil.no> [db-fil] [kommando]\n")
            returner 0
        }
        hvis lengde(argv) > 5 {
            skriv("bruk: nc migrate <fil.no> [db-fil] [kommando]\n")
            returner 2
        }
        la mig_fil = "app.no"
        la mig_db = "app.db"
        la mig_cmd = "køyr"
        hvis lengde(argv) > 2 { mig_fil = tekst(argv[2]) }
        hvis lengde(argv) > 3 { mig_db = tekst(argv[3]) }
        hvis lengde(argv) > 4 { mig_cmd = tekst(argv[4]) }
        hvis ikkje builtin.fil_finnes(mig_fil) {
            skriv("nc migrate: finn ikkje fil " + mig_fil + "\n")
            returner 2
        }
        miljo_sett("NC_MIGRATE_DB", mig_db)
        miljo_sett("NC_MIGRATE_CMD", mig_cmd)
        returner nc_run(mig_fil)
    }

    hvis cmd == "maintenance" {
        hvis lengde(argv) > 3 {
            skriv("bruk: nc maintenance [oppgåve]\n")
            returner 2
        }
        hvis lengde(argv) == 3 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            skriv("bruk: nc maintenance [oppgåve]\n")
            returner 0
        }
        la oppgåve = "status"
        hvis lengde(argv) == 3 { oppgåve = tekst(argv[2]) }
        miljo_sett("NORSCODE_TASK", oppgåve)
        returner nc_run("selfhost/maintenance.no")
    }

    # Native direktekommandoar utan shellmellomlag. Verktøya eig sjølve
    # portlogikken; nc_main eig berre den stabile argv-til-eigar-dispatchen.
    hvis cmd == "test" eller cmd == "selfcheck" {
        hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            skriv("bruk: nc test [fil.no ...]\n")
            returner 0
        }
        la testfiler = ""
        la testtal: heiltall = 0
        la ti: heiltall = 2
        mens ti < lengde(argv) {
            la testarg = tekst(argv[ti])
            hvis builtin.ends_with(testarg, ".no") og builtin.fil_finnes(testarg) {
                testfiler = testfiler + testarg + "\n"
                testtal = testtal + 1
            }
            ti = ti + 1
        }
        hvis testtal == 1 {
            miljo_sett("NC_TEST_FILE", builtin.trim(testfiler))
            miljo_sett("NC_TEST_FILES", "")
        } ellers hvis testtal > 1 {
            miljo_sett("NC_TEST_FILE", "")
            miljo_sett("NC_TEST_FILES", testfiler)
        }
        returner nc_køyr_verktøy("tools/nc_test.no")
    }
    hvis cmd == "active-surface" eller cmd == "aktiv-flate" {
        returner nc_køyr_verktøy("tools/no_c_python_active_surface.no")
    }
    hvis cmd == "surface-ownership" eller cmd == "flate-eigar" {
        returner nc_køyr_verktøy("tools/verify_norscode_surface_ownership.no")
    }
    hvis cmd == "phase0-verify" eller cmd == "fase0-verify" {
        returner nc_køyr_verktøy("tools/selfhost_phase0_verify.no")
    }
    hvis cmd == "selfhost-drift-guard" eller cmd == "drift-guard" {
        returner nc_køyr_verktøy("tools/selfhost_drift_guard.no")
    }
    hvis cmd == "python-audit" {
        returner nc_køyr_verktøy("tools/python_dependency_audit.no")
    }
    hvis cmd == "no-legacy-cvm" eller cmd == "legacy-cvm-check" {
        returner nc_køyr_verktøy("tools/no_legacy_cvm.no")
    }
    hvis cmd == "selfhost-maintenance-verify" eller cmd == "maintenance-verify" {
        returner nc_køyr_verktøy("tools/selfhost_maintenance_verify.no")
    }
    hvis cmd == "lsp" {
        returner nc_køyr_verktøy("selfhost/lsp/server.no")
    }

    la direkte_verktøy = nc_direkte_verktøysti(cmd)
    hvis direkte_verktøy != "" {
        hvis lengde(argv) > 2 og (tekst(argv[2]) == "--help" eller tekst(argv[2]) == "-h") {
            skriv(nc_direkte_bruk(cmd) + "\n")
            returner 0
        }
        hvis ikkje nc_forbered_direkte_miljø(cmd, argv) {
            skriv(nc_direkte_bruk(cmd) + "\n")
            returner 2
        }
        returner nc_køyr_verktøy(direkte_verktøy)
    }

    skriv("Ukjend NORSCODE_CMD: " + cmd + "\n")
    returner 1
}
