// selfhost/vm_executor.no — Pure-Norscode NCB Executor
//
// Steg C: Load NCB JSON bytecode og kjør via selfhost/vm.no
// Fullstendig self-contained, unngår C-host runtime-compilation
//
// Bruk:
//   1. Kompilér program til NCB: ./bin/nc compile program.no > program.ncb.json
//   2. Kjør NCB via executor:
//      NORSCODE_CMD=run NORSCODE_FILE=selfhost/vm_executor.no NORSCODE_NCB_FILE=program.ncb.json ./dist/norscode_native
//
// Eller lag ein wrapper i bin/ for lettar bruk:
//   ./bin/nc run-ncb program.ncb.json

bruk selfhost.json
bruk selfhost.kompiler
bruk selfhost.vm

// ─── Hjelpar-funksjonar ──────────────────────────────────────────────────────

funksjon stille() -> boolsk
    returner miljo_hent("NORSCODE_VM_QUIET") == builtin.chr(49)
slutt

funksjon logg(melding: tekst)
    hvis ikkje stille()
        skriv(melding)
    slutt
slutt

funksjon les_ncb_fil(fil: tekst) -> ordbok<tekst, tekst>
    logg("[VM Executor] Les NCB-fil: " + fil + "\n")
    la json_tekst = fil_les(fil)
    skriv("  Lest NCB-json\n")
    returner json_parse_raw(json_tekst)
slutt

funksjon verifiser_ncb(ncb: ordbok<tekst, tekst>) -> boolsk
    logg("[VM Executor] Verifiserer NCB...\n")

    la entry = ncb["entry"]
    la fns = ncb["functions"]

    hvis entry == null eller entry == ""
        skriv("ERROR: Manglar entry-point\n")
        returner usann
    slutt

    hvis fns == null
        skriv("ERROR: Manglar functions\n")
        returner usann
    slutt

    returner sann
slutt

funksjon les_vm_ncb() -> ordbok<tekst, tekst>
    la vm_sti = miljo_hent("NORSCODE_VM_NCB")
    hvis vm_sti == ""
        vm_sti = "bootstrap/precompiled/vm.ncb.json"
    slutt
    logg("[VM Executor] Les Norscode-VM: " + vm_sti + "\n")
    returner builtin.json_parse_raw(fil_les(vm_sti))
slutt

// Build key indexes while still in the native executor.  The isolated VM has
// no host map-key primitive, so carrying these indexes into every decoded map
// keeps later pure execution deterministic and non-recursive.
funksjon json_funksjonsnøkler(raw: tekst) -> liste_tekst
    la ut: liste_tekst = []
    la marker = builtin.index_of(raw, "\"functions\":{")
    hvis marker < 0 { returner ut }
    la i = marker + lengde("\"functions\":{")
    mens i < lengde(raw) {
        mens i < lengde(raw) og (builtin.slice(raw, i, i + 1) == " " eller builtin.slice(raw, i, i + 1) == ",") { i = i + 1 }
        hvis i >= lengde(raw) eller builtin.slice(raw, i, i + 1) == "}" { bryt }
        hvis builtin.slice(raw, i, i + 1) != "\"" { bryt }
        la start = i + 1
        i = start
        la escaped = usann
        mens i < lengde(raw) {
            la ch = builtin.slice(raw, i, i + 1)
            hvis ch == "\"" og ikkje escaped { bryt }
            hvis ch == "\\" og ikkje escaped { escaped = sann } ellers { escaped = usann }
            i = i + 1
        }
        hvis i >= lengde(raw) { bryt }
        legg_til(ut, builtin.slice(raw, start, i))
        i = i + 1
        mens i < lengde(raw) og builtin.slice(raw, i, i + 1) != ":" { i = i + 1 }
        hvis i >= lengde(raw) { bryt }
        i = i + 1
        la depth = 0
        la in_string = usann
        la esc2 = usann
        mens i < lengde(raw) {
            la ch2 = builtin.slice(raw, i, i + 1)
            hvis in_string {
                hvis ch2 == "\"" og ikkje esc2 { in_string = usann }
                hvis ch2 == "\\" og ikkje esc2 { esc2 = sann } ellers { esc2 = usann }
            } ellers {
                hvis ch2 == "\"" { in_string = sann }
                ellers hvis ch2 == "{" eller ch2 == "[" { depth = depth + 1 }
                ellers hvis ch2 == "}" eller ch2 == "]" {
                    hvis depth == 0 { bryt }
                    depth = depth - 1
                }
                ellers hvis ch2 == "," og depth == 0 { bryt }
            }
            i = i + 1
        }
        hvis i < lengde(raw) og builtin.slice(raw, i, i + 1) == "," { i = i + 1 }
    }
    returner ut
slutt

// Materialiser imported selfhost.vm names in the target function table before
// Steg-C starts. The embedded VM bundle is compiled under __main__, while
// consumer bytecode keeps its qualified module names.
funksjon legg_til_vm_aliasar(ncb: ordbok<tekst, tekst>) -> ordbok<tekst, tekst>
    la vm_ncb = les_vm_ncb()
    la mål_funksjonar = ncb["functions"]
    la vm_funksjonar = vm_ncb["functions"]
    la vm_sti = miljo_hent("NORSCODE_VM_NCB")
    hvis vm_sti == "" { vm_sti = "bootstrap/precompiled/vm.ncb.json" }
    la namn = json_funksjonsnøkler(fil_les(vm_sti))
    la mål_namn: liste_tekst = []
    la mål_sti = miljo_hent("NORSCODE_NCB_FILE")
    hvis mål_sti != "" { mål_namn = json_funksjonsnøkler(fil_les(mål_sti)) }
    la i = 0
    mens i < lengde(namn) {
        la namnverdi = namn[i]
        hvis builtin.starts_with(namnverdi, "__main__.") {
            la kortnamn = builtin.slice(namnverdi, 9, lengde(namnverdi))
            // Keep the consumer's entry point and any same-named program
            // functions authoritative; aliases are the compatibility path.
            hvis namnverdi != "__main__.start" {
                mål_funksjonar[namnverdi] = vm_funksjonar[namnverdi]
            }
            mål_funksjonar["selfhost.vm." + kortnamn] = vm_funksjonar[namnverdi]
        } ellers {
            mål_funksjonar[namnverdi] = vm_funksjonar[namnverdi]
        }
        i = i + 1
    }
    mål_funksjonar["selfhost.json.json_skriv"] = mål_funksjonar["__main__.json_skriv"]
    mål_funksjonar["selfhost.json.json_les"] = mål_funksjonar["__main__.json_les"]
    la vi = 0
    mens vi < lengde(namn) {
        hvis namn[vi] != "__main__.start" { legg_til(mål_namn, namn[vi]) }
        hvis builtin.starts_with(namn[vi], "__main__.") {
            legg_til(mål_namn, "selfhost.vm." + builtin.slice(namn[vi], 9, lengde(namn[vi])))
        }
        vi = vi + 1
    }
    legg_til(mål_namn, "selfhost.json.json_skriv")
    legg_til(mål_namn, "selfhost.json.json_les")
    mål_funksjonar["__vm_key_list__"] = mål_namn
    returner ncb
slutt

funksjon json_skriv(verdi)
    returner builtin.json_stringify(verdi)
slutt

funksjon json_les(verdi: tekst)
    returner builtin.json_parse_raw(verdi)
slutt

funksjon normaliser_null_loads(ncb: ordbok<tekst, tekst>) -> ordbok<tekst, tekst>
    la fns = ncb["functions"]
    la fn_namn = fns["__vm_key_list__"]
    la fi = 0
    mens fi < lengde(fn_namn) {
        la fn = fns[fn_namn[fi]]
        la code = fn["code"]
        la ci = 0
        mens ci < lengde(code) {
            la instr = code[ci]
            hvis instr[0] == "LOAD_NAME" {
                hvis instr[1] == "null" eller instr[1] == "ingenting" {
                    instr[0] = "PUSH_CONST"
                    instr[1] = 0
                } ellers hvis instr[1] == "true" eller instr[1] == "sann" {
                    instr[0] = "PUSH_CONST"
                    instr[1] = sann
                } ellers hvis instr[1] == "false" eller instr[1] == "usann" {
                    instr[0] = "PUSH_CONST"
                    instr[1] = usann
                }
            }
            ci = ci + 1
        }
        fi = fi + 1
    }
    returner ncb
slutt

funksjon aktiver_målpolicy() -> heltall
    hvis miljo_hent("NORSCODE_VM_REQUESTED_POLICY") != builtin.chr(49)
        returner 0
    slutt
    la caps = miljo_hent("NORSCODE_VM_REQUESTED_CAPABILITIES")
    la disk_root = miljo_hent("NORSCODE_VM_REQUESTED_DISK_ROOT")
    la net_scope = miljo_hent("NORSCODE_VM_REQUESTED_NET_SCOPE")
    la process_scope = miljo_hent("NORSCODE_VM_REQUESTED_PROCESS_SCOPE")
    miljo_sett("NORSCODE_VM_TARGET_CAPABILITIES", caps)
    miljo_sett("NORSCODE_VM_TARGET_DISK_ROOT", disk_root)
    miljo_sett("NORSCODE_VM_TARGET_NET_SCOPE", net_scope)
    miljo_sett("NORSCODE_VM_TARGET_PROCESS_SCOPE", process_scope)
    returner 0
slutt

funksjon kjør_ncb(ncb: ordbok<tekst, tekst>) -> heltall
    logg("[VM Executor] Kjører bytekode...\n")

    prøv {
        // selfhost.vm er allereie importert i denne executoren. Køyr målet
        // direkte i den VM-en; eit ekstra VM-i-VM-lag kan returnere før
        // mål-entryen blir kalla på eldre stage-0-runtime-ar.
        aktiver_målpolicy()
        la med_aliasar = legg_til_vm_aliasar(ncb)
        la normalisert = normaliser_null_loads(med_aliasar)
        returner køyr_ncb(normalisert)
    } fang melding {
        skriv("ERROR: " + melding + "\n")
        returner 1
    }
slutt

// ─── Hovud-executor ──────────────────────────────────────────────────────────

funksjon start() -> heltall
    logg("=== Norscode Pure-VM Executor (Steg C) ===\n\n")

    // Les NCB-fil frå miljø-variabel
    la ncb_fil = miljo_hent("NORSCODE_NCB_FILE")
    hvis ncb_fil == ""
        skriv("ERROR: NORSCODE_NCB_FILE ikkje sett\n")
        skriv("Bruk: NORSCODE_NCB_FILE=program.ncb.json NORSCODE_CMD=run NORSCODE_FILE=selfhost/vm_executor.no ./dist/norscode_native\n")
        returner 1
    slutt

    // Les og parse NCB
    prøv {
        la ncb = les_ncb_fil(ncb_fil)

        returner kjør_ncb(ncb)
    } fang melding {
        skriv("FATAL ERROR: " + melding + "\n")
        returner 1
    }
slutt
