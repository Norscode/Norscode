// ncb_host_run_entry.no — harness-køyresteg: last ein test-NCB (JSON ELLER binær) og
// køyr han i verts-VM-en via host_exec_ncb_json.
//
// KRITISK (2026-09-05): les som TEKST (fil_les er byte-eksakt, sjå ncb_serde). Den førre
// versjonen las fil_les_binary + serde.er_binaer (→ bytes_to_list av HEILE fila) og
// bytes_to_text: på committed seed kosta det 4,3 GB / 111 s for ein 433 KB NCB → kvart
// test-køyresteg åt titals GB for tunge testar → slow-lanene OOM-drap runneren (143).
bruk selfhost.ncb_serde som serde

funksjon start() -> heiltall {
    la vert_ncb_fil = miljo_hent("NORSCODE_HOST_NCB_FILE")
    hvis vert_ncb_fil == "" { vert_ncb_fil = miljo_hent("NORSCODE_NCB_FILE") }
    hvis vert_ncb_fil == ""
        skriv("ERROR: NORSCODE_NCB_FILE ikkje sett\n")
        returner 1
    slutt
    la t = builtin.fil_les(vert_ncb_fil)
    hvis serde.er_binaer_tekst(t) {
        // Binær-NCB (magic 0x93): dekod → JSON-tekst for verts-VM-en. Treg på committed
        // seed (per-teikn), men ingen normal-sti produserer binær før seed-promotering.
        returner host_exec_ncb_json(json_skriv(serde.deserialiser_tekst(t)))
    }
    returner host_exec_ncb_json(t)
}
