bruk selfhost.ncb_serde som serde
funksjon start() -> heiltall {
    la vert_ncb_fil = miljo_hent("NORSCODE_HOST_NCB_FILE")
    hvis vert_ncb_fil == "" {
        vert_ncb_fil = miljo_hent("NORSCODE_NCB_FILE")
    }
    hvis vert_ncb_fil == ""
        skriv("ERROR: NORSCODE_NCB_FILE ikkje sett\n")
        returner 1
    slutt
    // Dual-format NCB: les som byte. Binær (magic 0x93) → dekod og skriv som JSON-tekst,
    // sidan host_exec_ncb_json (vert-VM-builtin) krev tekst. Elles rein JSON-tekst som før.
    // (Tekst-greina er uendra for gammal seed; binær-greina går via kjelde-serde.)
    la raa = builtin.fil_les_binary(vert_ncb_fil)
    la ncb_json = ""
    hvis serde.er_binaer(raa) {
        ncb_json = json_skriv(serde.deserialiser(raa))
    } ellers {
        ncb_json = builtin.bytes_to_text(raa)
    }
    returner host_exec_ncb_json(ncb_json)
}
