// Bounded import linter for large selfhost sources.

funksjon start() {
    la sti = miljo_hent("NC_LINT_FILE")
    la check_mode = miljo_hent("NC_LINT_CHECK")
    hvis lengde(sti) == 0 { skriv("Bruk: NC_LINT_FILE=fil.no linter_fast.no") returner }
    la kilde = fil_les(sti)
    la funn = []
    la seen = {}
    la i = 0
    la line_no = 1
    la rå = ""
    mens i <= lengde(kilde) {
        hvis i == lengde(kilde) eller kilde[i] == "\n" {
            rå = builtin.trim(rå)
        hvis builtin.starts_with(rå, "bruk ") eller builtin.starts_with(rå, "importer ") {
            la rest = builtin.trim(builtin.slice(rå, 5, lengde(rå)))
            la delar = builtin.split(rest, " ")
            la modul = delar[0]
            la alias = ""
            la eksplisitt = usann
            hvis lengde(delar) >= 3 og delar[1] == "som" {
                alias = delar[2]
                eksplisitt = sann
            }
            ellers {
                la mdelar = builtin.split(modul, ".")
                hvis lengde(mdelar) > 0 { alias = mdelar[lengde(mdelar) - 1] }
            }
            hvis alias != "" {
                hvis builtin.nøkkel_finnes(seen, alias) {
                    la d = {"severity": "warning", "code": "duplicate-import", "linje": line_no, "melding": "Duplikat import: " + alias}
                    legg_til(funn, d)
                } ellers { seen[alias] = i + 1 }
                // Usage checks require rescanning the complete source and are
                // intentionally left to the full linter fallback.
            }
        }
            rå = ""
            line_no = line_no + 1
        } ellers {
            rå = rå + kilde[i]
        }
        i = i + 1
    }
    hvis lengde(funn) == 0 { skriv("OK: " + sti + " (0 funn)") returner }
    skriv("FEIL: " + sti + " (" + tekst_fra_heiltall(lengde(funn)) + " funn)")
    la fi = 0
    mens fi < lengde(funn) {
        la f = funn[fi]
        skriv("  - " + f["severity"] + " " + f["code"] + ": " + f["melding"] + " (linje " + tekst_fra_heiltall(f["linje"]) + ")")
        fi = fi + 1
    }
    hvis check_mode == "1" { stopp(1) }
}
