// ncb_serde.no — format-dispatch for NCB-serialisering under JSON→binær-migreringa.
//
// Målet (masterplan "alt av json skal vekk"): NCB-utvekslinga skal vere byte-
// deterministisk binær, ikkje JSON. Men bootstrap-kjeda kan ikkje snu formatet i
// eitt hogg — den gamle seeden les JSON, den nye les binært. Difor dette laget:
//
//   * serialiser(ncb)   → byte  (BINÆR: magic + versjon + ncb_bin.ncb_encode)
//   * deserialiser(data)→ ncb   (les BEGGE: magic → binær; elles → JSON via
//                                json_parse_raw). data kan vere byteliste ELLER tekst.
//   * er_binaer(data)   → boolsk (magic-sjekk, som ncb_stream.er_stream_fil)
//
// Migrering: (1) alle LESARAR går via deserialiser (bakoverkompatibel, disk er
// framleis JSON) → bygg seed. (2) alle SKRIVARAR går via serialiser (disk blir
// binær) → bygg seed. (3) fjern dei native JSON-rutinene frå codegen. Kvart steg
// held systemet køyrande.
//
// Magic: 0x93 'N' 'C' 'B' — 0x93 er aldri gyldig start på JSON/UTF-8-tekst («{»=
// 0x7B, whitespace, «[»=0x5B), so byte 0 skil formata utvetydig. Versjon følgjer.

bruk selfhost.ncb_bin som bin

funksjon _magic() -> liste_heiltall { returner [147, 78, 67, 66] }   // 0x93 N C B
funksjon _versjon() -> heiltall { returner 1 }

// _som_liste(data): normaliser til ei tal-liste. fil_les_binary gjev typen "bytes"
// (ein eigen native type) — builtin.slice på "bytes" gjev feilaktig tekst, so vi
// MÅ konvertere til "liste" med bytes_to_list før dekoding. Lister går rett gjennom.
funksjon _som_liste(data) -> liste_heiltall {
    hvis builtin.type(data) == "bytes" { returner builtin.bytes_to_list(data) }
    returner data
}

// er_binaer(data): data er byteliste ELLER bytes. Sann når dei fyrste 4 bytane er magic.
funksjon er_binaer(data) -> boolsk {
    la t = builtin.type(data)
    hvis t != "liste" og t != "bytes" { returner usann }
    la b = _som_liste(data)
    hvis lengde(b) < 5 { returner usann }
    la m = _magic()
    la i = 0
    mens i < 4 {
        hvis (b[i] & 255) != m[i] { returner usann }
        i = i + 1
    }
    returner sann
}

// serialiser(ncb) → byteliste: magic + versjon + ncb_encode (strippar debug-metadata).
funksjon serialiser(ncb) -> liste_heiltall {
    la ut: liste_heiltall = []
    la m = _magic()
    for b i m { legg_til(ut, b) }
    legg_til(ut, _versjon())
    la kropp = bin.ncb_encode(ncb)
    for b i kropp { legg_til(ut, b) }
    returner ut
}

// _byte_til_tekst(byteliste) → tekst (for JSON-fallback når input er binær-lagra JSON).
funksjon _byte_til_tekst(data: liste_heiltall) -> tekst {
    la s = ""
    for b i data { s = s + builtin.chr(b & 255) }
    returner s
}

// deserialiser(data) → ncb. data: byteliste (binær ELLER JSON-byte) ELLER tekst (JSON).
// Utvetydig: byteliste med magic → binær; alt anna → JSON via json_parse_raw.
funksjon deserialiser(data) {
    hvis builtin.type(data) == "tekst" {
        returner builtin.json_parse_raw(data)          // rein JSON-tekst
    }
    la b = _som_liste(data)                            // bytes → liste (slice-trygt)
    hvis er_binaer(b) {
        // dropp 4 magic + 1 versjon
        returner bin.ncb_decode(builtin.slice(b, 5, lengde(b)))
    }
    // byteliste utan magic → JSON lagra som byte
    returner builtin.json_parse_raw(_byte_til_tekst(b))
}

// les_fil(sti) → NCB-objekt. Les fila som BYTE og lat deserialiser avgjere format:
// magic 0x93 → binær (ncb_decode), elles JSON-tekst. Felles dual-format-inngang for
// alle NCB-lesarar (bundler, vm_executor, l5b, run-entry) — same objekt uansett format.
funksjon les_fil(sti: tekst) {
    returner deserialiser(builtin.fil_les_binary(sti))
}
