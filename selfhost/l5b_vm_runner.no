// Avgrensa AOT-host for L5b. Sjølve kompilatoren blir lasta som NCB og
// tolka av selfhost.vm; full nc_main/compiler/bundler-flate blir ikkje halde
// i den ytre prosessheapen.

bruk selfhost.vm som vm
bruk selfhost.ncb_stream som ncb_stream

funksjon start() -> heiltall {
    la ncb_sti = ""
    prøv { ncb_sti = miljo_hent("NORSCODE_NCB_FILE") } fang (e) { ncb_sti = "" }
    hvis ncb_sti == "" {
        skriv("[FAIL] NORSCODE_NCB_FILE manglar\n")
        returner 2
    }
    la ncb = null
    hvis ncb_stream.er_stream_fil(ncb_sti) {
        ncb = ncb_stream.les_fil_lazy(ncb_sti, 262144)
    } ellers {
        ncb = builtin.json_parse_raw(fil_les(ncb_sti))
    }
    la functions = ncb["functions"]
    hvis functions == null {
        skriv("[FAIL] L5b VM-runner manglar functions\n")
        returner 1
    }
    la entry = tekst(ncb["entry"])
    la overstyrt_entry = ""
    prøv { overstyrt_entry = miljo_hent("NORSCODE_NCB_ENTRY") } fang (e) { overstyrt_entry = "" }
    hvis overstyrt_entry != "" { entry = overstyrt_entry }
    hvis entry == "" {
        skriv("[FAIL] L5b VM-runner manglar entry\n")
        returner 1
    }
    functions["__vm_inherit_env__"] = "sann"
    vm.vm_runtime_init(functions, sann)
    la args: liste = []
    la resultat = vm.køyr_funksjon(entry, args, functions, 0)
    hvis builtin.type(resultat) == "heltall" { returner resultat }
    returner 0
}
