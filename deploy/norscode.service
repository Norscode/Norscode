[Unit]
Description=Norscode backend service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/norscode/current
EnvironmentFile=-/etc/norscode/norscode.env
Environment=NORSCODE_VM_FAST=1
ExecStart=/srv/norscode/current/bin/nc serve app.no --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/norscode /var/lib/norscode /var/log/norscode

[Install]
WantedBy=multi-user.target
