# examples/wasm_teljar/app.no — serve-app for teljar-demoen (W0 i WASM-sporet).
#
# Klientlogikken (examples/wasm_teljar/klient.no) er Norscode kompilert til WebAssembly.
# Denne appen leverer sida, lastaren og modulen:
#
#   GET /                    sida med knappen; CSP med 'wasm-unsafe-eval' (berre her)
#   GET /om                  vanleg side utan WASM; standard-CSP
#   GET /kontroll/streng-csp same side som /, men med standard-CSP (negativ kontroll:
#                            nettlesaren skal nekte å kompilere modulen)
#   GET /_nc/nc.js?v=…       lastaren (generert frå Norscode-data av std/wasm_js.no)
#   GET /_nc/app.wasm?v=…    modulen, application/wasm, byte-identisk med app.wasm
#
# Versjonane (v) er sha256 over bytane (modulen) og over lastarteksten. Rett v gjev
# `immutable`-cache i eitt år; feil eller manglande v gjev `no-cache`.
#
# Bygg og køyr (frå rota i repoet):
#   ./bin/nc compile examples/wasm_teljar/klient.no -o build/wasm/wasm_teljar/klient.ncb.json
#   NC_WASM_NCB=build/wasm/wasm_teljar/klient.ncb.json NC_WASM_UT=build/wasm/wasm_teljar \
#       ./bin/nc run tools/nc_wasm.no
#   ./bin/nc serve examples/wasm_teljar/app.no --port 8080
#
# `klient_data` er generert under build/ (nc serve har ingen disk-kapabilitet, så bytane
# blir bygde inn som hex i ein Norscode-modul). Nettlesarkrav: WasmGC (Chrome 119+,
# Firefox 120+, Safari 18.2+). Eldre nettlesarar får sida utan klientlogikk.

bruk std.web som web
bruk build.wasm.wasm_teljar.klient_data som klient

funksjon csp_standard() -> tekst {
    returner "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
}

# Som csp_standard, men med 'wasm-unsafe-eval' i script-src. Opnar IKKJE for eval eller
# new Function i JS, berre for kompilering av WebAssembly.
funksjon csp_wasm() -> tekst {
    returner "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
}

funksjon cache_versjonert(ctx: ordbok_tekst, rett: tekst) -> tekst {
    hvis web.request_query_param(ctx, "v") == rett {
        returner "public, max-age=31536000, immutable"
    }
    returner "no-cache"
}

funksjon svar(ct: tekst, body: tekst, csp: tekst, cache: tekst) -> ordbok_tekst {
    la h = {}
    h["content-security-policy"] = csp
    h["x-content-type-options"] = "nosniff"
    h["cache-control"] = cache
    h["referrer-policy"] = "no-referrer"
    returner {"status": 200, "content_type": ct, "body": body, "headers": h}
}

funksjon hex_til_rå(h: tekst) -> tekst {
    la hs = "0123456789abcdef"
    la ut = ""
    la i = 0
    mens i + 1 < lengde(h) {
        ut = ut + builtin.chr(builtin.index_of(hs, builtin.slice(h, i, i + 1)) * 16 + builtin.index_of(hs, builtin.slice(h, i + 1, i + 2)))
        i = i + 2
    }
    returner ut
}

funksjon side_html() -> tekst {
    returner "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" +
        "<title>Teljar i WebAssembly</title>" +
        "<script src=\"/_nc/nc.js?v=" + klient.lastar_versjon() + "\" defer></script></head>" +
        "<body><main><h1>Teljar</h1>" +
        "<p>Klientlogikken er Norscode kompilert til WebAssembly.</p>" +
        "<button id=\"knapp\" type=\"button\">+1</button> " +
        "<output id=\"ut\">0</output>" +
        "<p id=\"sum\"></p>" +
        "<p><a href=\"/om\">Om</a></p></main></body></html>"
}

funksjon side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /")
    returner svar("text/html; charset=utf-8", side_html(), csp_wasm(), "no-cache")
}

funksjon om(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /om")
    returner svar("text/html; charset=utf-8",
        "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>Om</title></head>" +
        "<body><p>Ei vanleg side utan WebAssembly.</p><p><a href=\"/\">Til teljaren</a></p></body></html>",
        csp_standard(), "no-cache")
}

funksjon kontroll_streng_csp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /kontroll/streng-csp")
    returner svar("text/html; charset=utf-8", side_html(), csp_standard(), "no-cache")
}

funksjon lastar(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /_nc/nc.js")
    returner svar("text/javascript; charset=utf-8", klient.lastar(), csp_standard(),
        cache_versjonert(ctx, klient.lastar_versjon()))
}

funksjon modul(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /_nc/app.wasm")
    returner svar("application/wasm", hex_til_rå(klient.wasm_hex()), csp_standard(),
        cache_versjonert(ctx, klient.wasm_versjon()))
}

funksjon start() -> heltall {
    returner 0
}
