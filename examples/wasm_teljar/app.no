# examples/wasm_teljar/app.no — serve-app for teljar-demoen (W0 i WASM-sporet, W4-integrasjon).
#
# Klientlogikken (examples/wasm_teljar/klient.no) er Norscode kompilert til WebAssembly.
# Appen importerer ingenting under build/: rutene for modulen og lastaren kjem frå den
# genererte inngangen build/wasm/wasm_teljar/serve.no (tools/nc_wasm.no med NC_WASM_APP),
# som importerer denne appen. Utan bygg kan appen framleis serverast; sida verkar då
# utan klientlogikk.
#
#   GET /                    sida med knappen; CSP med 'wasm-unsafe-eval' (berre her)
#   GET /om                  vanleg side utan WASM; standard-CSP
#   GET /kontroll/streng-csp same side som /, men med standard-CSP (negativ kontroll:
#                            nettlesaren skal nekte å kompilere modulen)
#   GET /_nc/nc.js           lastaren (frå serve.no), ETag; ?v=<versjon> gjev immutable
#   GET /_nc/app.wasm?v=…    modulen (frå serve.no), application/wasm, immutable ved rett v
#
# Bygg og køyr (frå rota i repoet):
#   NC_WASM_KJELDE=examples/wasm_teljar/klient.no NC_WASM_APP=examples/wasm_teljar/app.no \
#       NC_WASM_UT=build/wasm/wasm_teljar ./bin/nc run tools/nc_wasm.no
#   ./bin/nc serve build/wasm/wasm_teljar/serve.no --port 8080
#
# Nettlesarkrav: WasmGC (Chrome 119+, Firefox 120+, Safari 18.2+). Eldre nettlesarar får
# sida utan klientlogikk.

bruk std.web som web
bruk std.wasm_serve som ws

funksjon side_html() -> tekst {
    returner "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" +
        "<title>Teljar i WebAssembly</title>" + ws.script_tag() + "</head>" +
        "<body><main><h1>Teljar</h1>" +
        "<p>Klientlogikken er Norscode kompilert til WebAssembly.</p>" +
        "<button id=\"knapp\" type=\"button\">+1</button> " +
        "<output id=\"ut\">0</output>" +
        "<p id=\"sum\"></p>" +
        "<p><a href=\"/om\">Om</a></p></main></body></html>"
}

funksjon side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /")
    returner ws.side(side_html())
}

funksjon om(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /om")
    returner ws.vanleg_side(
        "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>Om</title></head>" +
        "<body><p>Ei vanleg side utan WebAssembly.</p><p><a href=\"/\">Til teljaren</a></p></body></html>")
}

funksjon kontroll_streng_csp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /kontroll/streng-csp")
    returner ws.vanleg_side(side_html())
}

funksjon start() -> heltall {
    returner 0
}
