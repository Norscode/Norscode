# examples/wasm_teljar/klient.no — klientlogikk i Norscode, kompilert til WebAssembly.
#
# Bygg (sjå README-kommentaren i app.no):
#   ./bin/nc compile examples/wasm_teljar/klient.no -o build/wasm/wasm_teljar/klient.ncb.json
#   NC_WASM_NCB=build/wasm/wasm_teljar/klient.ncb.json NC_WASM_UT=build/wasm/wasm_teljar \
#       ./bin/nc run tools/nc_wasm.no
#
# Modulen brukar berre W0-subsettet: heiltal, lokale variablar, modulglobalar, hvis/mens,
# kall og vertsfunksjonane i std.wasm_vert. Tekst finst berre som konstantar til
# vertsfunksjonane (selektorar, HTML-malar og funksjonsnamn).

bruk std.wasm_vert som vert

la teljar: heltall = 0
la ut_h: heltall = 0
la sum_h: heltall = 0

# Trekanttalet 1 + 2 + … + n, rekna med ei mens-lykkje.
funksjon sum_til(n: heltall) -> heltall {
    la s = 0
    la i = 1
    mens i <= n {
        s = s + i
        i = i + 1
    }
    returner s
}

funksjon vis() -> heltall {
    vert.sett_tekst(ut_h, teljar)
    hvis teljar % 2 == 0 {
        vert.sett_html(sum_h, "Sum 1..n = <b>{}</b> (partal)", sum_til(teljar))
    } ellers {
        vert.sett_html(sum_h, "Sum 1..n = <b>{}</b> (oddetal)", sum_til(teljar))
    }
    returner teljar
}

# Kalla av lastaren ved klikk på knappen (registrert i start()).
funksjon klikk() -> heltall {
    teljar = teljar + 1
    returner vis()
}

funksjon start() -> heltall {
    ut_h = vert.finn("#ut")
    sum_h = vert.finn("#sum")
    vert.lytt_klikk(vert.finn("#knapp"), "klikk")
    returner vis()
}
