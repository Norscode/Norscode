# examples/wasm_skjema/app.no — serve-app for skjema-demoen (W4 i WASM-sporet).
#
# Klientlogikken (examples/wasm_skjema/klient.no) er Norscode kompilert til WebAssembly:
# live validering av eit skjema, ei liste som blir filtrert medan ein skriv, og legg til /
# fjern. Appen importerer ingenting under build/; modulen og lastaren blir leverte av den
# genererte inngangen build/wasm/wasm_skjema/serve.no.
#
#   GET /                    sida; CSP med 'wasm-unsafe-eval' (berre her). ?q=… fyller filteret.
#   GET /om                  vanleg side utan WASM; standard-CSP
#   GET /kontroll/streng-csp same side som /, men med standard-CSP (negativ kontroll)
#   GET /stil.css            stilark (inline-stil er ikkje lov under CSP-en)
#
# Bygg og køyr (frå rota i repoet):
#   NC_WASM_KJELDE=examples/wasm_skjema/klient.no NC_WASM_APP=examples/wasm_skjema/app.no \
#       NC_WASM_UT=build/wasm/wasm_skjema ./bin/nc run tools/nc_wasm.no
#   ./bin/nc serve build/wasm/wasm_skjema/serve.no --port 8080
#
# Utan WebAssembly (eldre nettlesar, eller CSP som nektar) viser sida skjemaet og ei tom
# liste; ingenting er avhengig av JavaScript som er skrive for hand.

bruk std.web som web
bruk std.wasm_serve som ws

# Sida. `ekstra` kjem sist i <body> (testappen legg inn <pre id="nc-logg">).
funksjon side_html(ekstra: tekst) -> tekst {
    returner "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\">" +
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" +
        "<title>Skjema og liste i WebAssembly</title>" +
        "<link rel=\"stylesheet\" href=\"/stil.css\">" + ws.script_tag() + "</head>" +
        "<body><main>" +
        "<h1>Deltakarar</h1>" +
        "<form id=\"skjema\" novalidate>" +
        "<p><label for=\"namn\">Namn</label> <input id=\"namn\" name=\"namn\" autocomplete=\"name\"> " +
        "<span id=\"namn-feil\" class=\"feil\" aria-live=\"polite\"></span></p>" +
        "<p><label for=\"epost\">E-post</label> <input id=\"epost\" name=\"epost\" type=\"email\" autocomplete=\"email\"> " +
        "<span id=\"epost-feil\" class=\"feil\" aria-live=\"polite\"></span></p>" +
        "<p><button id=\"lagre\" type=\"submit\">Legg til</button> <span id=\"status\" role=\"status\"></span></p>" +
        "</form>" +
        "<p><label for=\"filter\">Filter</label> <input id=\"filter\" type=\"search\" placeholder=\"Skriv for å filtrere\"> " +
        "<output id=\"nc-resultat\">–</output></p>" +
        "<ul id=\"liste\"></ul>" +
        "<p><a href=\"/om\">Om demoen</a></p>" +
        "</main>" + ekstra + "</body></html>"
}

funksjon side(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /")
    returner ws.side(side_html(""))
}

funksjon om(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /om")
    returner ws.vanleg_side(
        "<!doctype html><html lang=\"nn\"><head><meta charset=\"utf-8\"><title>Om</title></head>" +
        "<body><p>Klientlogikken på framsida er skriven i Norscode og kompilert til WebAssembly. " +
        "Denne sida brukar ikkje WebAssembly og har standard-CSP.</p><p><a href=\"/\">Tilbake</a></p></body></html>")
}

funksjon kontroll_streng_csp(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /kontroll/streng-csp")
    returner ws.vanleg_side(side_html(""))
}

funksjon stil(ctx: ordbok_tekst) -> ordbok_tekst {
    web.route("GET /stil.css")
    returner ws.svar("text/css; charset=utf-8",
        "body{font-family:system-ui,sans-serif;max-width:40rem;margin:2rem auto;padding:0 1rem}" +
        ".feil{color:#b00020}.ugyldig{border-color:#b00020;outline:1px solid #b00020}" +
        "#liste li{margin:.25rem 0}#liste small{color:#555}button[disabled]{opacity:.5}",
        ws.csp_standard(), "no-cache")
}

funksjon start() -> heltall {
    returner 0
}
