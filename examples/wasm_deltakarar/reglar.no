# examples/wasm_deltakarar/reglar.no — reglane for deltakarlista (W6-demoen), delte mellom
# klienten (WebAssembly i nettlesaren) og tenaren (nc serve). Same kode validerer skjemaet
# medan brukaren skriv og lista når ho kjem til tenaren, og same JSON-kode (std/wasm_rt.no)
# les og skriv lista på begge sider.
#
# Reine funksjonar utan modulglobalar: dei køyrer likt i VM-en og i WASM, og testane
# samanliknar dei (tests/test_wasm_w6.no).
bruk std.wasm_rt som rt

funksjon maks_deltakarar() -> heltall {
    returner 60
}

funksjon gyldig_namn(namn: tekst) -> tekst {
    la t = builtin.trim(namn)
    hvis lengde(t) == 0 { returner "Skriv inn namnet." }
    hvis lengde(t) < 2 { returner "Namnet må ha minst 2 teikn." }
    hvis lengde(t) > 60 { returner "Namnet kan ha høgst 60 teikn." }
    returner ""
}

funksjon gyldig_epost(epost: tekst) -> tekst {
    la t = builtin.trim(epost)
    hvis lengde(t) == 0 { returner "Skriv inn e-postadressa." }
    la kr = builtin.index_of(t, "@")
    hvis kr < 1 { returner "E-postadressa manglar namn før @." }
    la domene = builtin.slice(t, kr + 1, lengde(t))
    la pkt = builtin.index_of(domene, ".")
    hvis pkt < 1 eller pkt == lengde(domene) - 1 { returner "E-postadressa manglar eit domene som eksempel.no." }
    hvis builtin.contains(t, " ") { returner "E-postadressa kan ikkje ha mellomrom." }
    returner ""
}

# Feila i ei deltakarliste slik ho kjem frå klienten (JSON-verdien), som tekstar. Tom liste
# av feil = gyldig.
funksjon valider_liste(v) -> liste {
    la feil = []
    hvis builtin.type(v) != "liste" {
        legg_til(feil, "Deltakarane må vere ei liste.")
        returner feil
    }
    hvis lengde(v) > maks_deltakarar() {
        legg_til(feil, "Høgst " + tekst(maks_deltakarar()) + " deltakarar (fekk " + tekst(lengde(v)) + ").")
        returner feil
    }
    la i = 0
    mens i < lengde(v) {
        la d = v[i]
        la nr = "Deltakar " + tekst(i + 1) + ": "
        hvis builtin.type(d) != "ordbok" eller builtin.type(d["namn"]) != "tekst" eller builtin.type(d["epost"]) != "tekst" {
            legg_til(feil, nr + "manglar namn eller e-post.")
        } ellers {
            la fn = gyldig_namn(d["namn"])
            hvis fn != "" { legg_til(feil, nr + fn) }
            la fe = gyldig_epost(d["epost"])
            hvis fe != "" { legg_til(feil, nr + fe) }
        }
        i = i + 1
    }
    returner feil
}

# Berre namn og e-post (trimma) går vidare, så lista som blir lagra har ei fast form.
funksjon rydd_liste(v: liste) -> liste {
    la ut = []
    la i = 0
    mens i < lengde(v) {
        legg_til(ut, {"namn": builtin.trim(v[i]["namn"]), "epost": builtin.trim(v[i]["epost"])})
        i = i + 1
    }
    returner ut
}

funksjon standardliste() -> liste {
    la namn = ["Aksel", "Berit", "Bjørn", "Dina", "Eirik", "Frida", "Guro", "Håkon", "Idun", "Åse"]
    la ut = []
    la i = 0
    mens i < lengde(namn) {
        legg_til(ut, {"namn": namn[i], "epost": tekst_til_liten(namn[i]) + "@eksempel.no"})
        i = i + 1
    }
    returner ut
}

# ─── Lagring i ein informasjonskapsel (tenaren) ──────────────────────────────
# nc serve har korkje disk eller minne mellom førespurnader, så demoen lagrar lista i ein
# HttpOnly-informasjonskapsel per nettlesar: JSON-en, prosentkoda (berre A–Z, a–z, 0–9 og
# - _ . ~ står urørte).

funksjon _hex() -> tekst {
    returner "0123456789ABCDEF"
}

funksjon prosent_kod(s: tekst) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(s) {
        la c = builtin.slice(s, i, i + 1)
        la k = builtin.char_code(c)
        hvis (k >= 65 og k <= 90) eller (k >= 97 og k <= 122) eller (k >= 48 og k <= 57) eller k == 45 eller k == 95 eller k == 46 eller k == 126 {
            ut = ut + c
        } ellers {
            ut = ut + "%" + builtin.slice(_hex(), k / 16, k / 16 + 1) + builtin.slice(_hex(), k % 16, k % 16 + 1)
        }
        i = i + 1
    }
    returner ut
}

funksjon _hexverdi(c: tekst) -> heltall {
    la k = builtin.char_code(c)
    hvis k >= 48 og k <= 57 { returner k - 48 }
    hvis k >= 65 og k <= 70 { returner k - 55 }
    hvis k >= 97 og k <= 102 { returner k - 87 }
    returner -1
}

# Gjev "" når teksten ikkje er gyldig prosentkoda.
funksjon prosent_dekod(s: tekst) -> tekst {
    la ut = ""
    la i = 0
    mens i < lengde(s) {
        la c = builtin.slice(s, i, i + 1)
        hvis c == "%" {
            hvis i + 2 >= lengde(s) { returner "" }
            la a = _hexverdi(builtin.slice(s, i + 1, i + 2))
            la b = _hexverdi(builtin.slice(s, i + 2, i + 3))
            hvis a < 0 eller b < 0 { returner "" }
            ut = ut + builtin.chr(a * 16 + b)
            i = i + 3
        } ellers {
            ut = ut + c
            i = i + 1
        }
    }
    returner ut
}

# Lista frå informasjonskapselen, eller standardlista når han manglar eller er øydelagd.
funksjon liste_frå_kapsel(verdi: tekst) -> liste {
    hvis verdi == "" { returner standardliste() }
    la json = prosent_dekod(verdi)
    hvis json == "" { returner standardliste() }
    la v = null
    prøv {
        v = rt.json_parse(json)
    } fang (e) {
        returner standardliste()
    }
    hvis lengde(valider_liste(v)) > 0 { returner standardliste() }
    returner rydd_liste(v)
}

funksjon kapsel_for(liste: liste) -> tekst {
    returner prosent_kod(builtin.json_stringify(liste))
}
